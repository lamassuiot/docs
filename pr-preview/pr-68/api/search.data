":59460,"_41068":59463,"_41070":59466,"_41072":59469,"_41074":59472,"_41076":59475,"_41078":59478,"_41081":59481,"_41084":59484,"_41086":59487,"_41088":59490,"_41090":59493,"_41092":59496,"_41094":59499,"_41096":59502,"_41098":59505,"_41100":59508,"_41102":59511,"_41104":59514,"_41106":59517,"_41108":59520,"_41110":59523,"_41112":59526,"_41114":59529,"_41116":59532,"_41118":59535,"_41120":59538,"_41122":59541,"_41124":59544,"_41126":59547,"_41128":59550,"_41130":59553,"_41132":59556,"_41134":59559,"_41136":59562,"_41138":59565,"_41140":59568,"_41142":59571,"_41144":59574,"_41147":59577,"_41149":59580,"_41151":59583,"_41153":59586,"_41155":59589,"_41157":59592,"_41159":59595,"_41161":59598,"_41163":59601,"_41165":59604,"_41167":59607,"_41169":59610,"_41171":59613,"_41173":59616,"_41176":59619,"_41178":59622,"_41180":59625,"_41182":59628,"_41184":59631,"_41186":59634,"_41188":59637,"_41190":59640,"_41192":59643,"_41194":59646,"_41196":59649,"_41198":59652,"_41200":59655,"_41202":59658,"_41204":59661,"_41206":59664,"_41208":59667,"_41210":59670,"_41212":59673,"_41214":59676,"_41216":59679,"_41218":59682,"_41220":59685,"_41222":59688,"_41224":59691,"_41226":59694,"_41228":59697,"_41230":59700,"_41232":59703,"_41234":59706,"_41236":59709,"_41238":59712,"_41241":59715,"_41243":59718,"_41245":59721,"_41247":59724},{"_3572":15,"_30844":15,"_5":14996,"_3027":50347,"_31202":50348,"_21377":50352,"_28040":15},"Deploy from AWS Marketplace",[50349,50350,50351],"Docs","Deployment","Other models",[],{"_3572":16,"_30844":15,"_21377":50354,"_5":14632,"_28040":15,"_3027":50355},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3572":17,"_30844":15,"_5":31199,"_21377":50357,"_28040":50358,"_3027":50359},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3572":18,"_30844":15,"_5":31199,"_21377":50361,"_28040":50362,"_3027":50363},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3572":19,"_30844":15,"_5":31199,"_21377":50365,"_28040":50366,"_3027":50367},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3572":20,"_30844":15,"_5":31199,"_21377":50369,"_28040":50370,"_3027":50371},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3572":21,"_30844":15,"_5":31199,"_21377":50373,"_28040":50374,"_3027":50375},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3572":22,"_30844":15,"_5":31199,"_21377":50377,"_28040":50378,"_3027":50379},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3572":23,"_30844":15,"_5":31199,"_21377":50381,"_28040":50382,"_3027":50383},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#next-step","Next step",{"_3572":24,"_30844":15,"_21377":50385,"_5":14632,"_28040":15,"_3027":50386},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3572":25,"_30844":15,"_21377":50388,"_5":14632,"_28040":50358,"_3027":50389},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3572":26,"_30844":15,"_21377":50391,"_5":14632,"_28040":50358,"_3027":50392},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3572":27,"_30844":15,"_21377":50394,"_5":14632,"_28040":50358,"_3027":50395},[],"A security group allowing the necessary endpoints.",{"_3572":28,"_30844":15,"_21377":50397,"_5":14632,"_28040":50362,"_3027":50398},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3572":29,"_30844":15,"_21377":50400,"_5":14632,"_28040":50362,"_3027":50401},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3572":30,"_30844":15,"_21377":50403,"_5":14632,"_28040":50362,"_3027":50404},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3572":31,"_30844":15,"_21377":50406,"_5":14632,"_28040":50366,"_3027":50407},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3572":32,"_30844":15,"_21377":50409,"_5":14632,"_28040":50370,"_3027":50410},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3572":33,"_30844":15,"_21377":50412,"_5":14632,"_28040":50374,"_3027":50413},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3572":34,"_30844":15,"_21377":50415,"_5":14632,"_28040":50378,"_3027":50416},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3572":35,"_30844":15,"_21377":50418,"_5":14632,"_28040":50382,"_3027":50419},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3572":36,"_30844":36,"_5":14996,"_3027":50421,"_31202":50422,"_21377":50423,"_28040":36},"Deploy Lamassu",[50349,50350],[],{"_3572":37,"_30844":36,"_21377":50425,"_5":14632,"_28040":36,"_3027":50426},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3572":38,"_30844":36,"_5":31199,"_21377":50428,"_28040":50429,"_3027":50430},[],"/docs/pr-preview/pr-68/deployment/overview#choose-a-model","Choose a model",{"_3572":39,"_30844":36,"_5":31199,"_21377":50432,"_28040":50433,"_3027":50434},[],"/docs/pr-preview/pr-68/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3572":40,"_30844":36,"_5":31199,"_21377":50436,"_28040":50437,"_3027":50438},[],"/docs/pr-preview/pr-68/deployment/overview#after-deployment","After deployment",{"_3572":41,"_30844":36,"_21377":50440,"_5":14632,"_28040":36,"_3027":50441},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3572":42,"_30844":36,"_21377":50443,"_5":14632,"_28040":50429,"_3027":50444},[],"Model",{"_3572":43,"_30844":36,"_21377":50446,"_5":14632,"_28040":50429,"_3027":50447},[],"Recommended for",{"_3572":44,"_30844":36,"_21377":50449,"_5":14632,"_28040":50429,"_3027":50450},[],"Who operates the infrastructure",{"_3572":45,"_30844":36,"_21377":50452,"_5":14632,"_28040":50429,"_3027":50453},[],"Starting point",{"_3572":46,"_30844":36,"_21377":50455,"_5":14632,"_28040":50429,"_3027":50456},[],"Kubernetes self-managed",{"_3572":47,"_30844":36,"_21377":50458,"_5":14632,"_28040":50429,"_3027":50459},[],"Production, regulated environments and custom deployments",{"_3572":48,"_30844":36,"_21377":50461,"_5":14632,"_28040":50429,"_3027":50462},[],"Your team",{"_3572":49,"_30844":36,"_21377":50464,"_5":14632,"_28040":50429,"_3027":50465},[],"Helm or Fastlane",{"_3572":50,"_30844":36,"_21377":50467,"_5":14632,"_28040":50429,"_3027":50468},[],"AWS Marketplace",{"_3572":51,"_30844":36,"_21377":50470,"_5":14632,"_28040":50429,"_3027":50471},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3572":52,"_30844":36,"_21377":50473,"_5":14632,"_28040":50429,"_3027":50462},[],{"_3572":53,"_30844":36,"_21377":50475,"_5":14632,"_28040":50429,"_3027":50476},[],"Preconfigured image on EC2",{"_3572":54,"_30844":36,"_21377":50478,"_5":14632,"_28040":50429,"_3027":50479},[],"SaaS",{"_3572":55,"_30844":36,"_21377":50481,"_5":14632,"_28040":50429,"_3027":50482},[],"Teams that want to use the platform without operating it",{"_3572":56,"_30844":36,"_21377":50484,"_5":14632,"_28040":50429,"_3027":50485},[],"Lamassu",{"_3572":57,"_30844":36,"_21377":50487,"_5":14632,"_28040":50429,"_3027":50488},[],"Managed subscription",{"_3572":58,"_30844":36,"_21377":50490,"_5":14632,"_28040":50429,"_3027":50491},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3572":59,"_30844":36,"_21377":50493,"_5":14632,"_28040":50429,"_3027":50494},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3572":60,"_30844":36,"_21377":50496,"_5":14632,"_28040":50429,"_3027":50497},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3572":61,"_30844":36,"_21377":50499,"_5":14632,"_28040":50433,"_3027":50500},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3572":62,"_30844":36,"_21377":50502,"_5":14632,"_28040":50437,"_3027":50503},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3572":63,"_30844":63,"_5":14996,"_3027":50505,"_31202":50506,"_21377":50507,"_28040":63},"Use Lamassu as SaaS",[50349,50350,50351],[],{"_3572":64,"_30844":63,"_21377":50509,"_5":14632,"_28040":63,"_3027":50510},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3572":65,"_30844":63,"_5":31199,"_21377":50512,"_28040":50513,"_3027":50514},[],"/docs/pr-preview/pr-68/deployment/saas#what-the-service-manages","What the service manages",{"_3572":66,"_30844":63,"_5":31199,"_21377":50516,"_28040":50517,"_3027":50518},[],"/docs/pr-preview/pr-68/deployment/saas#plans","Plans",{"_3572":67,"_30844":63,"_5":31199,"_21377":50520,"_28040":50521,"_3027":50522},[],"/docs/pr-preview/pr-68/deployment/saas#request-access","Request access",{"_3572":68,"_30844":63,"_21377":50524,"_5":14632,"_28040":63,"_3027":50525},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3572":69,"_30844":63,"_21377":50527,"_5":14632,"_28040":50513,"_3027":50528},[],"Platform availability and maintenance.",{"_3572":70,"_30844":63,"_21377":50530,"_5":14632,"_28040":50513,"_3027":50531},[],"Automatic backups.",{"_3572":71,"_30844":63,"_21377":50533,"_5":14632,"_28040":50513,"_3027":50534},[],"Version upgrades.",{"_3572":72,"_30844":63,"_21377":50536,"_5":14632,"_28040":50513,"_3027":50537},[],"Technical support and SLA according to your plan.",{"_3572":73,"_30844":63,"_21377":50539,"_5":14632,"_28040":50517,"_3027":50540},[],"Plan",{"_3572":74,"_30844":63,"_21377":50542,"_5":14632,"_28040":50517,"_3027":50543},[],"Devices",{"_3572":75,"_30844":63,"_21377":50545,"_5":14632,"_28040":50517,"_3027":50546},[],"Support",{"_3572":76,"_30844":63,"_21377":50548,"_5":14632,"_28040":50517,"_3027":50549},[],"SLA",{"_3572":77,"_30844":63,"_21377":50551,"_5":14632,"_28040":50517,"_3027":50552},[],"Starter",{"_3572":78,"_30844":63,"_21377":50554,"_5":14632,"_28040":50517,"_3027":50555},[],"Up to 1,000",{"_3572":79,"_30844":63,"_21377":50557,"_5":14632,"_28040":50517,"_3027":50558},[],"Email",{"_3572":80,"_30844":63,"_21377":50560,"_5":14632,"_28040":50517,"_3027":50561},[],"99.5 %",{"_3572":81,"_30844":63,"_21377":50563,"_5":14632,"_28040":50517,"_3027":50564},[],"Professional",{"_3572":82,"_30844":63,"_21377":50566,"_5":14632,"_28040":50517,"_3027":50567},[],"Up to 10,000",{"_3572":83,"_30844":63,"_21377":50569,"_5":14632,"_28040":50517,"_3027":50570},[],"Email and chat",{"_3572":84,"_30844":63,"_21377":50572,"_5":14632,"_28040":50517,"_3027":50573},[],"99.9 %",{"_3572":85,"_30844":63,"_21377":50575,"_5":14632,"_28040":50517,"_3027":50576},[],"Enterprise",{"_3572":86,"_30844":63,"_21377":50578,"_5":14632,"_28040":50517,"_3027":50579},[],"Unlimited",{"_3572":87,"_30844":63,"_21377":50581,"_5":14632,"_28040":50517,"_3027":50582},[],"Dedicated",{"_3572":88,"_30844":63,"_21377":50584,"_5":14632,"_28040":50517,"_3027":50585},[],"99.99 %",{"_3572":89,"_30844":63,"_21377":50587,"_5":14632,"_28040":50521,"_3027":50588},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3572":90,"_30844":63,"_21377":50590,"_5":14632,"_28040":50521,"_3027":50591},[],"When you receive your instance's credentials, continue with Get started.",{"_3572":91,"_30844":91,"_5":14996,"_3027":50593,"_31202":50594,"_21377":50595,"_28040":91},"Fastlane",[50349,50350,50456],[],{"_3572":92,"_30844":91,"_21377":50597,"_5":14632,"_28040":91,"_3027":50598},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3572":93,"_30844":91,"_5":31199,"_21377":50600,"_28040":50601,"_3027":50602},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3572":94,"_30844":91,"_5":31199,"_21377":50604,"_28040":50605,"_3027":50606},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3572":95,"_30844":91,"_5":31199,"_21377":50608,"_28040":50609,"_3027":50359},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#before-you-begin",{"_3572":96,"_30844":91,"_5":31199,"_21377":50611,"_28040":50612,"_3027":50613},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3572":97,"_30844":91,"_5":31199,"_21377":50615,"_28040":50616,"_3027":50617},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3572":98,"_30844":91,"_5":31199,"_21377":50619,"_28040":50620,"_3027":50621},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3572":99,"_30844":91,"_5":31199,"_21377":50623,"_28040":50624,"_3027":50625},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3572":100,"_30844":91,"_5":31199,"_21377":50627,"_28040":50628,"_3027":50629},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3572":101,"_30844":91,"_5":31199,"_21377":50631,"_28040":50632,"_3027":50633},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3572":102,"_30844":91,"_5":31199,"_21377":50635,"_28040":50636,"_3027":50637},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3572":103,"_30844":91,"_5":31199,"_21377":50639,"_28040":50640,"_3027":50641},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3572":104,"_30844":91,"_21377":50643,"_5":14632,"_28040":50601,"_3027":50644},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3572":105,"_30844":91,"_21377":50646,"_5":14632,"_28040":50601,"_3027":50647},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3572":106,"_30844":91,"_21377":50649,"_5":14632,"_28040":50605,"_3027":50650},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3572":107,"_30844":91,"_21377":50652,"_5":14632,"_28040":50605,"_3027":50653},[],"Fastlane installs or configures",{"_3572":108,"_30844":91,"_21377":50655,"_5":14632,"_28040":50605,"_3027":50656},[],"You still provide",{"_3572":109,"_30844":91,"_21377":50658,"_5":14632,"_28040":50605,"_3027":50659},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3572":110,"_30844":91,"_21377":50661,"_5":14632,"_28040":50605,"_3027":50662},[],"The Kubernetes cluster, nodes and persistent storage",{"_3572":111,"_30844":91,"_21377":50664,"_5":14632,"_28040":50605,"_3027":50665},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3572":112,"_30844":91,"_21377":50667,"_5":14632,"_28040":50605,"_3027":50668},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3572":113,"_30844":91,"_21377":50670,"_5":14632,"_28040":50605,"_3027":50671},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3572":114,"_30844":91,"_21377":50673,"_5":14632,"_28040":50605,"_3027":50674},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3572":115,"_30844":91,"_21377":50676,"_5":14632,"_28040":50605,"_3027":50677},[],"Optional observability and lab HSM components",{"_3572":116,"_30844":91,"_21377":50679,"_5":14632,"_28040":50605,"_3027":50680},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3572":117,"_30844":91,"_21377":50682,"_5":14632,"_28040":50605,"_3027":50683},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3572":118,"_30844":91,"_21377":50685,"_5":14632,"_28040":50609,"_3027":50686},[],"You need:",{"_3572":119,"_30844":91,"_21377":50688,"_5":14632,"_28040":50609,"_3027":50689},[],"an existing Kubernetes cluster",{"_3572":120,"_30844":91,"_21377":50691,"_5":14632,"_28040":50609,"_3027":50692},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3572":121,"_30844":91,"_21377":50694,"_5":14632,"_28040":50609,"_3027":50695},[],"`yq`",{"_3572":122,"_30844":91,"_21377":50697,"_5":14632,"_28040":50609,"_3027":24146},[],{"_3572":123,"_30844":91,"_21377":50699,"_5":14632,"_28040":50609,"_3027":50700},[],"`jq` only when using `--sample-data` or `--development`",{"_3572":124,"_30844":91,"_21377":50702,"_5":14632,"_28040":50609,"_3027":50703},[],"`ssh-keygen` only when using `--with-hsm`",{"_3572":125,"_30844":91,"_21377":50705,"_5":14632,"_28040":50609,"_3027":50706},[],"free external ports 80 and 443 on a single-node K3s host",{"_3572":126,"_30844":91,"_21377":50708,"_5":14632,"_28040":50609,"_3027":50709},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3572":127,"_30844":91,"_21377":50711,"_5":14632,"_28040":50609,"_3027":50712},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3572":128,"_30844":91,"_21377":50714,"_5":14632,"_28040":50612,"_3027":50715},[],"Run the script from a clone of the Helm repository:",{"_3572":129,"_30844":91,"_21377":50717,"_5":14632,"_28040":50612,"_3027":50718},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3572":130,"_30844":91,"_21377":50720,"_5":14632,"_28040":50616,"_3027":50721},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3572":131,"_30844":91,"_21377":50723,"_5":14632,"_28040":50616,"_3027":50724},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3572":132,"_30844":91,"_21377":50726,"_5":14632,"_28040":50616,"_3027":50727},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3572":133,"_30844":91,"_21377":50729,"_5":14632,"_28040":50616,"_3027":50730},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3572":134,"_30844":91,"_21377":50732,"_5":14632,"_28040":50620,"_3027":50733},[],"Option",{"_3572":135,"_30844":91,"_21377":50735,"_5":14632,"_28040":50620,"_3027":50736},[],"Default",{"_3572":136,"_30844":91,"_21377":50738,"_5":14632,"_28040":50620,"_3027":50739},[],"Purpose",{"_3572":137,"_30844":91,"_21377":50741,"_5":14632,"_28040":50620,"_3027":50742},[],"`-h`, `--help`",{"_3572":138,"_30844":91,"_21377":50744,"_5":14632,"_28040":50620,"_3027":50745},[],"—",{"_3572":139,"_30844":91,"_21377":50747,"_5":14632,"_28040":50620,"_3027":50748},[],"Show help",{"_3572":140,"_30844":91,"_21377":50750,"_5":14632,"_28040":50620,"_3027":50751},[],"`-c`, `--context`",{"_3572":141,"_30844":91,"_21377":50753,"_5":14632,"_28040":50620,"_3027":50754},[],"current context",{"_3572":142,"_30844":91,"_21377":50756,"_5":14632,"_28040":50620,"_3027":50757},[],"Select the kubeconfig context for kubectl and Helm",{"_3572":143,"_30844":91,"_21377":50759,"_5":14632,"_28040":50620,"_3027":50760},[],"`-n`, `--non-interactive`",{"_3572":144,"_30844":91,"_21377":50762,"_5":14632,"_28040":50620,"_3027":6708},[],{"_3572":145,"_30844":91,"_21377":50764,"_5":14632,"_28040":50620,"_3027":50765},[],"Skip prompts and generate dependency credentials",{"_3572":146,"_30844":91,"_21377":50767,"_5":14632,"_28040":50620,"_3027":50768},[],"`-ns`, `--namespace`",{"_3572":147,"_30844":91,"_21377":50770,"_5":14632,"_28040":50620,"_3027":50771},[],"`lamassu-dev`",{"_3572":148,"_30844":91,"_21377":50773,"_5":14632,"_28040":50620,"_3027":50774},[],"Namespace for the installation",{"_3572":149,"_30844":91,"_21377":50776,"_5":14632,"_28040":50620,"_3027":50777},[],"`-d`, `--domain`",{"_3572":150,"_30844":91,"_21377":50779,"_5":14632,"_28040":50620,"_3027":50780},[],"`dev.lamassu.io`",{"_3572":151,"_30844":91,"_21377":50782,"_5":14632,"_28040":50620,"_3027":50783},[],"Domain used by the UI, OIDC and certificate",{"_3572":152,"_30844":91,"_21377":50785,"_5":14632,"_28040":50620,"_3027":50786},[],"`-v`, `--version`",{"_3572":153,"_30844":91,"_21377":50788,"_5":14632,"_28040":50620,"_3027":15433},[],{"_3572":154,"_30844":91,"_21377":50790,"_5":14632,"_28040":50620,"_3027":50791},[],"Lamassu chart version",{"_3572":155,"_30844":91,"_21377":50793,"_5":14632,"_28040":50620,"_3027":50794},[],"`--https-port`",{"_3572":156,"_30844":91,"_21377":50796,"_5":14632,"_28040":50620,"_3027":50797},[],"`443`",{"_3572":157,"_30844":91,"_21377":50799,"_5":14632,"_28040":50620,"_3027":50800},[],"Gateway HTTPS listener port",{"_3572":158,"_30844":91,"_21377":50802,"_5":14632,"_28040":50620,"_3027":50803},[],"`--http-port`",{"_3572":159,"_30844":91,"_21377":50805,"_5":14632,"_28040":50620,"_3027":50806},[],"`80`",{"_3572":160,"_30844":91,"_21377":50808,"_5":14632,"_28040":50620,"_3027":50809},[],"Gateway HTTP listener port",{"_3572":161,"_30844":91,"_21377":50811,"_5":14632,"_28040":50620,"_3027":50812},[],"`--tls-crt`",{"_3572":162,"_30844":91,"_21377":50814,"_5":14632,"_28040":50620,"_3027":50745},[],{"_3572":163,"_30844":91,"_21377":50816,"_5":14632,"_28040":50620,"_3027":50817},[],"PEM certificate for downstream TLS",{"_3572":164,"_30844":91,"_21377":50819,"_5":14632,"_28040":50620,"_3027":50820},[],"`--tls-key`",{"_3572":165,"_30844":91,"_21377":50822,"_5":14632,"_28040":50620,"_3027":50745},[],{"_3572":166,"_30844":91,"_21377":50824,"_5":14632,"_28040":50620,"_3027":50825},[],"PEM private key for downstream TLS",{"_3572":167,"_30844":91,"_21377":50827,"_5":14632,"_28040":50620,"_3027":50828},[],"`-l`, `--local-chart-path`",{"_3572":168,"_30844":91,"_21377":50830,"_5":14632,"_28040":50620,"_3027":50831},[],"repository chart",{"_3572":169,"_30844":91,"_21377":50833,"_5":14632,"_28040":50620,"_3027":50834},[],"Use an unpacked local Lamassu chart",{"_3572":170,"_30844":91,"_21377":50836,"_5":14632,"_28040":50620,"_3027":50837},[],"`-ip`, `--gateway-ip`",{"_3572":171,"_30844":91,"_21377":50839,"_5":14632,"_28040":50620,"_3027":8942},[],{"_3572":172,"_30844":91,"_21377":50841,"_5":14632,"_28040":50620,"_3027":50842},[],"Override the address written to `gateway.addresses`",{"_3572":173,"_30844":91,"_21377":50844,"_5":14632,"_28040":50620,"_3027":50845},[],"`--otel`",{"_3572":174,"_30844":91,"_21377":50847,"_5":14632,"_28040":50620,"_3027":6708},[],{"_3572":175,"_30844":91,"_21377":50849,"_5":14632,"_28040":50620,"_3027":50850},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3572":176,"_30844":91,"_21377":50852,"_5":14632,"_28040":50620,"_3027":50853},[],"`--development`",{"_3572":177,"_30844":91,"_21377":50855,"_5":14632,"_28040":50620,"_3027":6708},[],{"_3572":178,"_30844":91,"_21377":50857,"_5":14632,"_28040":50620,"_3027":50858},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3572":179,"_30844":91,"_21377":50860,"_5":14632,"_28040":50620,"_3027":50861},[],"`--sample-data`",{"_3572":180,"_30844":91,"_21377":50863,"_5":14632,"_28040":50620,"_3027":6708},[],{"_3572":181,"_30844":91,"_21377":50865,"_5":14632,"_28040":50620,"_3027":50866},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3572":182,"_30844":91,"_21377":50868,"_5":14632,"_28040":50620,"_3027":50869},[],"`--with-hsm`",{"_3572":183,"_30844":91,"_21377":50871,"_5":14632,"_28040":50620,"_3027":6708},[],{"_3572":184,"_30844":91,"_21377":50873,"_5":14632,"_28040":50620,"_3027":50874},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3572":185,"_30844":91,"_21377":50876,"_5":14632,"_28040":50620,"_3027":50877},[],"`--softhsm-chart-path`",{"_3572":186,"_30844":91,"_21377":50879,"_5":14632,"_28040":50620,"_3027":50880},[],"`./charts/softhsm`",{"_3572":187,"_30844":91,"_21377":50882,"_5":14632,"_28040":50620,"_3027":50883},[],"Use a different local SoftHSM chart",{"_3572":188,"_30844":91,"_21377":50885,"_5":14632,"_28040":50620,"_3027":50886},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3572":189,"_30844":91,"_21377":50888,"_5":14632,"_28040":50624,"_3027":50889},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3572":190,"_30844":91,"_21377":50891,"_5":14632,"_28040":50624,"_3027":50892},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3572":191,"_30844":91,"_21377":50894,"_5":14632,"_28040":50624,"_3027":50895},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3572":192,"_30844":91,"_21377":50897,"_5":14632,"_28040":50624,"_3027":50898},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3572":193,"_30844":91,"_21377":50900,"_5":14632,"_28040":50624,"_3027":50901},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3572":194,"_30844":91,"_21377":50903,"_5":14632,"_28040":50624,"_3027":50904},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3572":195,"_30844":91,"_21377":50906,"_5":14632,"_28040":50628,"_3027":50907},[],"Fastlane:",{"_3572":196,"_30844":91,"_21377":50909,"_5":14632,"_28040":50628,"_3027":50910},[],"validates local tools and the selected cluster",{"_3572":197,"_30844":91,"_21377":50912,"_5":14632,"_28040":50628,"_3027":50913},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3572":198,"_30844":91,"_21377":50915,"_5":14632,"_28040":50628,"_3027":50916},[],"creates the namespace",{"_3572":199,"_30844":91,"_21377":50918,"_5":14632,"_28040":50628,"_3027":50919},[],"installs PostgreSQL and creates the required databases",{"_3572":200,"_30844":91,"_21377":50921,"_5":14632,"_28040":50628,"_3027":50922},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3572":201,"_30844":91,"_21377":50924,"_5":14632,"_28040":50628,"_3027":50925},[],"installs RabbitMQ",{"_3572":202,"_30844":91,"_21377":50927,"_5":14632,"_28040":50628,"_3027":50928},[],"optionally installs observability and lab HSM components",{"_3572":203,"_30844":91,"_21377":50930,"_5":14632,"_28040":50628,"_3027":50931},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3572":204,"_30844":91,"_21377":50933,"_5":14632,"_28040":50628,"_3027":50934},[],"optionally loads sample data",{"_3572":205,"_30844":91,"_21377":50936,"_5":14632,"_28040":50628,"_3027":50937},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3572":206,"_30844":91,"_21377":50939,"_5":14632,"_28040":50632,"_3027":50940},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3572":207,"_30844":91,"_21377":50942,"_5":14632,"_28040":50632,"_3027":50943},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3572":208,"_30844":91,"_21377":50945,"_5":14632,"_28040":50636,"_3027":50946},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3572":209,"_30844":91,"_21377":50948,"_5":14632,"_28040":50636,"_3027":50949},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3572":210,"_30844":91,"_21377":50951,"_5":14632,"_28040":50636,"_3027":50952},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3572":211,"_30844":91,"_21377":50954,"_5":14632,"_28040":50640,"_3027":50955},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3572":212,"_30844":212,"_5":14996,"_3027":50957,"_31202":50958,"_21377":50959,"_28040":212},"Install with Helm",[50349,50350,50456],[],{"_3572":213,"_30844":212,"_21377":50961,"_5":14632,"_28040":212,"_3027":50962},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3572":214,"_30844":212,"_5":31199,"_21377":50964,"_28040":50965,"_3027":50966},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3572":215,"_30844":212,"_5":31199,"_21377":50968,"_28040":50969,"_3027":50359},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#before-you-begin",{"_3572":216,"_30844":212,"_5":31199,"_21377":50971,"_28040":50972,"_3027":50973},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3572":217,"_30844":212,"_5":31199,"_21377":50975,"_28040":50976,"_3027":50977},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3572":218,"_30844":212,"_5":31199,"_21377":50979,"_28040":50980,"_3027":50981},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3572":219,"_30844":212,"_5":31199,"_21377":50983,"_28040":50984,"_3027":50985},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3572":220,"_30844":212,"_5":31199,"_21377":50987,"_28040":50988,"_3027":50989},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#credential-environment-variables","Credential environment variables",{"_3572":221,"_30844":212,"_5":31199,"_21377":50991,"_28040":50992,"_3027":50993},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3572":222,"_30844":212,"_5":31199,"_21377":50995,"_28040":50996,"_3027":50997},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3572":223,"_30844":212,"_5":31199,"_21377":50999,"_28040":51000,"_3027":51001},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3572":224,"_30844":212,"_5":31199,"_21377":51003,"_28040":51004,"_3027":51005},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3572":225,"_30844":212,"_5":31199,"_21377":51007,"_28040":51008,"_3027":51009},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3572":226,"_30844":212,"_21377":51011,"_5":14632,"_28040":50965,"_3027":51012},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3572":227,"_30844":212,"_21377":51014,"_5":14632,"_28040":50969,"_3027":51015},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3572":228,"_30844":212,"_21377":51017,"_5":14632,"_28040":50969,"_3027":51018},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3572":229,"_30844":212,"_21377":51020,"_5":14632,"_28040":50969,"_3027":51021},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3572":230,"_30844":212,"_21377":51023,"_5":14632,"_28040":50969,"_3027":51024},[],"a reachable RabbitMQ broker and credentials",{"_3572":231,"_30844":212,"_21377":51026,"_5":14632,"_28040":50969,"_3027":51027},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3572":232,"_30844":212,"_21377":51029,"_5":14632,"_28040":50969,"_3027":51030},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3572":233,"_30844":212,"_21377":51032,"_5":14632,"_28040":50969,"_3027":51033},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3572":234,"_30844":212,"_21377":51035,"_5":14632,"_28040":50969,"_3027":51036},[],"a StorageClass and an external traffic design",{"_3572":235,"_30844":212,"_21377":51038,"_5":14632,"_28040":50969,"_3027":51039},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3572":236,"_30844":212,"_21377":51041,"_5":14632,"_28040":50969,"_3027":51042},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3572":237,"_30844":212,"_21377":51044,"_5":14632,"_28040":50969,"_3027":51045},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3572":238,"_30844":212,"_21377":51047,"_5":14632,"_28040":50972,"_3027":51048},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3572":239,"_30844":212,"_21377":51050,"_5":14632,"_28040":50972,"_3027":51051},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3572":240,"_30844":212,"_21377":51053,"_5":14632,"_28040":50972,"_3027":51054},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3572":241,"_30844":212,"_21377":51056,"_5":14632,"_28040":50976,"_3027":51057},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3572":242,"_30844":212,"_21377":51059,"_5":14632,"_28040":50976,"_3027":51060},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3572":243,"_30844":212,"_21377":51062,"_5":14632,"_28040":50976,"_3027":51063},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3572":244,"_30844":212,"_21377":51065,"_5":14632,"_28040":50976,"_3027":51066},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3572":245,"_30844":212,"_21377":51068,"_5":14632,"_28040":50980,"_3027":51069},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3572":246,"_30844":212,"_21377":51071,"_5":14632,"_28040":50984,"_3027":51072},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3572":247,"_30844":212,"_21377":51074,"_5":14632,"_28040":50984,"_3027":51075},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3572":248,"_30844":212,"_21377":51077,"_5":14632,"_28040":50984,"_3027":51078},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3572":249,"_30844":212,"_21377":51080,"_5":14632,"_28040":50984,"_3027":51081},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3572":250,"_30844":212,"_21377":51083,"_5":14632,"_28040":50984,"_3027":51084},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3572":251,"_30844":212,"_21377":51086,"_5":14632,"_28040":50984,"_3027":51087},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3572":252,"_30844":212,"_21377":51089,"_5":14632,"_28040":50984,"_3027":51090},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3572":253,"_30844":212,"_21377":51092,"_5":14632,"_28040":50988,"_3027":51093},[],"The services read an explicit catalog of credential environment variables when they load their configuration at startup. A set, non-empty variable overrides the corresponding YAML value; an unset variable leaves the YAML value in place, so a deployment configured only through YAML keeps working unchanged. A variable can also supply a credential the values file does not define. Variables outside this catalog are ignored — other `LAMASSU_*` variables are not picked up automatically.",{"_3572":254,"_30844":212,"_21377":51095,"_5":14632,"_28040":50988,"_3027":51096},[],"Variables",{"_3572":255,"_30844":212,"_21377":51098,"_5":14632,"_28040":50988,"_3027":51099},[],"Configures",{"_3572":256,"_30844":212,"_21377":51101,"_5":14632,"_28040":50988,"_3027":51102},[],"`LAMASSU_POSTGRES_USERNAME`, `LAMASSU_POSTGRES_PASSWORD`",{"_3572":257,"_30844":212,"_21377":51104,"_5":14632,"_28040":50988,"_3027":51105},[],"PostgreSQL storage credentials",{"_3572":258,"_30844":212,"_21377":51107,"_5":14632,"_28040":50988,"_3027":51108},[],"`LAMASSU_AUTHZ_DB_USERNAME`, `LAMASSU_AUTHZ_DB_PASSWORD`",{"_3572":259,"_30844":212,"_21377":51110,"_5":14632,"_28040":50988,"_3027":51111},[],"the authz service's own database credentials",{"_3572":260,"_30844":212,"_21377":51113,"_5":14632,"_28040":50988,"_3027":51114},[],"`LAMASSU_AMQP_USERNAME`, `LAMASSU_AMQP_PASSWORD`",{"_3572":261,"_30844":212,"_21377":51116,"_5":14632,"_28040":50988,"_3027":51117},[],"one pair applied to every event-bus connection: publisher, subscriber and dead-letter queues. There is no per-queue split.",{"_3572":262,"_30844":212,"_21377":51119,"_5":14632,"_28040":50988,"_3027":51120},[],"`LAMASSU_SMTP_USERNAME`, `LAMASSU_SMTP_PASSWORD`",{"_3572":263,"_30844":212,"_21377":51122,"_5":14632,"_28040":50988,"_3027":51123},[],"SMTP credentials used by alert email delivery",{"_3572":264,"_30844":212,"_21377":51125,"_5":14632,"_28040":50988,"_3027":51126},[],"`LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_USERNAME`, `LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_PASSWORD`",{"_3572":265,"_30844":212,"_21377":51128,"_5":14632,"_28040":50988,"_3027":51129},[],"one pair per schema defined in the `services.authz.credentials` map",{"_3572":266,"_30844":212,"_21377":51131,"_5":14632,"_28040":50988,"_3027":51132},[],"Setting a catalog variable to the empty string never overrides anything. If the YAML (or default) value is non-empty, the service fails at startup with an error that names the variable and the configuration key, such as `LAMASSU_POSTGRES_PASSWORD is set but empty`. An empty variable combined with an empty or absent YAML value is allowed.",{"_3572":267,"_30844":212,"_21377":51134,"_5":14632,"_28040":50988,"_3027":51135},[],"For the authz schemas, `<SCHEMA>` is the YAML schema name uppercased with every non-alphanumeric character replaced by `_`: `pki` maps to `PKI`, and both `pki-v2` and `pki.v2` map to `PKI_V2`. Bindings exist only for schemas present in the YAML credentials map, so variables for schemas that are not listed are ignored. Two schemas that normalize to the same name (`pki-v2` and `pki.v2`) conflict: if a variable of either pair is set, the service fails at startup; if the variables are unset, a warning is logged and the YAML values are used.",{"_3572":268,"_30844":212,"_21377":51137,"_5":14632,"_28040":50988,"_3027":51138},[],"These variables are designed to be sourced from Kubernetes Secrets, so credentials no longer need to be written into the rendered YAML. For example, inject a pair into a service pod with the standard Kubernetes `secretKeyRef` mechanism:",{"_3572":269,"_30844":212,"_21377":51140,"_5":14632,"_28040":50988,"_3027":51141},[],"Because the variables are read when the service loads its configuration at startup, changing the underlying Secret requires restarting the consuming pods for the new values to take effect.",{"_3572":270,"_30844":212,"_21377":51143,"_5":14632,"_28040":50992,"_3027":51144},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3572":271,"_30844":212,"_21377":51146,"_5":14632,"_28040":50992,"_3027":51147},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3572":272,"_30844":212,"_21377":51149,"_5":14632,"_28040":50992,"_3027":51150},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3572":273,"_30844":212,"_21377":51152,"_5":14632,"_28040":50992,"_3027":51153},[],"See Access control for the principal and policy model.",{"_3572":274,"_30844":212,"_21377":51155,"_5":14632,"_28040":50996,"_3027":51156},[],"To install a local checkout instead:",{"_3572":275,"_30844":212,"_21377":51158,"_5":14632,"_28040":51000,"_3027":51159},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3572":276,"_30844":212,"_21377":51161,"_5":14632,"_28040":51000,"_3027":51162},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3572":277,"_30844":212,"_21377":51164,"_5":14632,"_28040":51004,"_3027":51165},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3572":278,"_30844":212,"_21377":51167,"_5":14632,"_28040":51004,"_3027":51168},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3572":279,"_30844":212,"_21377":51170,"_5":14632,"_28040":51004,"_3027":51171},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3572":280,"_30844":212,"_21377":51173,"_5":14632,"_28040":51004,"_3027":51174},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3572":281,"_30844":212,"_21377":51176,"_5":14632,"_28040":51004,"_3027":51177},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3572":282,"_30844":212,"_21377":51179,"_5":14632,"_28040":51008,"_3027":51180},[],"Before going live, review:",{"_3572":283,"_30844":212,"_21377":51182,"_5":14632,"_28040":51008,"_3027":51183},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3572":284,"_30844":212,"_21377":51185,"_5":14632,"_28040":51008,"_3027":51186},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3572":285,"_30844":212,"_21377":51188,"_5":14632,"_28040":51008,"_3027":51189},[],"shared VA storage before increasing VA replicas",{"_3572":286,"_30844":212,"_21377":51191,"_5":14632,"_28040":51008,"_3027":51192},[],"managed OIDC roles and removal of evaluation credentials",{"_3572":287,"_30844":212,"_21377":51194,"_5":14632,"_28040":51008,"_3027":51195},[],"a trusted TLS issuer or externally managed certificate",{"_3572":288,"_30844":212,"_21377":51197,"_5":14632,"_28040":51008,"_3027":51198},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3572":289,"_30844":212,"_21377":51200,"_5":14632,"_28040":51008,"_3027":51201},[],"SMTP, observability and alert delivery",{"_3572":290,"_30844":212,"_21377":51203,"_5":14632,"_28040":51008,"_3027":51204},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3572":291,"_30844":212,"_21377":51206,"_5":14632,"_28040":51008,"_3027":51207},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3572":292,"_30844":292,"_5":14996,"_3027":51209,"_31202":51210,"_21377":51211,"_28040":292},"Expose the Gateway",[50349,50350,50456],[],{"_3572":293,"_30844":292,"_21377":51213,"_5":14632,"_28040":292,"_3027":51214},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3572":294,"_30844":292,"_5":31199,"_21377":51216,"_28040":51217,"_3027":51218},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3572":295,"_30844":292,"_5":31199,"_21377":51220,"_28040":51221,"_3027":51222},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3572":296,"_30844":292,"_5":31199,"_21377":51224,"_28040":51225,"_3027":51226},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3572":297,"_30844":292,"_5":31199,"_21377":51228,"_28040":51229,"_3027":51230},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#k3s","K3s",{"_3572":298,"_30844":292,"_5":31199,"_21377":51232,"_28040":51233,"_3027":51234},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3572":299,"_30844":292,"_5":31199,"_21377":51236,"_28040":51237,"_3027":51238},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3572":300,"_30844":292,"_5":31199,"_21377":51240,"_28040":51241,"_3027":51242},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3572":301,"_30844":292,"_5":31199,"_21377":51244,"_28040":51245,"_3027":51246},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3572":302,"_30844":292,"_5":31199,"_21377":51248,"_28040":51249,"_3027":51250},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3572":303,"_30844":292,"_5":31199,"_21377":51252,"_28040":51253,"_3027":51254},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3572":304,"_30844":292,"_5":31199,"_21377":51256,"_28040":51257,"_3027":51258},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3572":305,"_30844":292,"_21377":51260,"_5":14632,"_28040":51217,"_3027":51261},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3572":306,"_30844":292,"_21377":51263,"_5":14632,"_28040":51217,"_3027":51264},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3572":307,"_30844":292,"_21377":51266,"_5":14632,"_28040":51221,"_3027":51267},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3572":308,"_30844":292,"_21377":51269,"_5":14632,"_28040":51221,"_3027":51270},[],"Set it only when:",{"_3572":309,"_30844":292,"_21377":51272,"_5":14632,"_28040":51221,"_3027":51273},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3572":310,"_30844":292,"_21377":51275,"_5":14632,"_28040":51221,"_3027":51276},[],"that address is allocated to this Gateway",{"_3572":311,"_30844":292,"_21377":51278,"_5":14632,"_28040":51221,"_3027":51279},[],"the surrounding network already routes traffic for it to the cluster",{"_3572":312,"_30844":292,"_21377":51281,"_5":14632,"_28040":51221,"_3027":51282},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3572":313,"_30844":292,"_21377":51284,"_5":14632,"_28040":51221,"_3027":51285},[],"Keep these two settings separate:",{"_3572":314,"_30844":292,"_21377":51287,"_5":14632,"_28040":51221,"_3027":51288},[],"`gateway.addresses` requests an address for the Gateway.",{"_3572":315,"_30844":292,"_21377":51290,"_5":14632,"_28040":51221,"_3027":51291},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3572":316,"_30844":292,"_21377":51293,"_5":14632,"_28040":51221,"_3027":51294},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3572":317,"_30844":292,"_21377":51296,"_5":14632,"_28040":51225,"_3027":51297},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3572":318,"_30844":292,"_21377":51299,"_5":14632,"_28040":51225,"_3027":51300},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3572":319,"_30844":292,"_21377":51302,"_5":14632,"_28040":51229,"_3027":51303},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3572":320,"_30844":292,"_21377":51305,"_5":14632,"_28040":51229,"_3027":51306},[],"For the recommended design:",{"_3572":321,"_30844":292,"_21377":51308,"_5":14632,"_28040":51229,"_3027":51309},[],"Use only one externally exposed Lamassu Gateway.",{"_3572":322,"_30844":292,"_21377":51311,"_5":14632,"_28040":51229,"_3027":51312},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3572":323,"_30844":292,"_21377":51314,"_5":14632,"_28040":51229,"_3027":51315},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3572":324,"_30844":292,"_21377":51317,"_5":14632,"_28040":51229,"_3027":51318},[],"Point DNS at the VM's reachable address.",{"_3572":325,"_30844":292,"_21377":51320,"_5":14632,"_28040":51229,"_3027":51321},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3572":326,"_30844":292,"_21377":51323,"_5":14632,"_28040":51233,"_3027":51324},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3572":327,"_30844":292,"_21377":51326,"_5":14632,"_28040":51237,"_3027":51327},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3572":328,"_30844":292,"_21377":51329,"_5":14632,"_28040":51237,"_3027":51330},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3572":329,"_30844":292,"_21377":51332,"_5":14632,"_28040":51241,"_3027":51333},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3572":330,"_30844":292,"_21377":51335,"_5":14632,"_28040":51241,"_3027":51336},[],"Requirement",{"_3572":331,"_30844":292,"_21377":51338,"_5":14632,"_28040":51241,"_3027":51339},[],"Recommended design",{"_3572":332,"_30844":292,"_21377":51341,"_5":14632,"_28040":51241,"_3027":51342},[],"Consequence",{"_3572":333,"_30844":292,"_21377":51344,"_5":14632,"_28040":51241,"_3027":51345},[],"Several Lamassu URLs or services",{"_3572":334,"_30844":292,"_21377":51347,"_5":14632,"_28040":51241,"_3027":51348},[],"One Gateway with multiple routes",{"_3572":335,"_30844":292,"_21377":51350,"_5":14632,"_28040":51241,"_3027":51351},[],"One IP and one proxy fleet; this is the chart default",{"_3572":336,"_30844":292,"_21377":51353,"_5":14632,"_28040":51241,"_3027":51354},[],"Independent Gateways and separate external IPs",{"_3572":337,"_30844":292,"_21377":51356,"_5":14632,"_28040":51241,"_3027":51357},[],"One VIP per Gateway",{"_3572":338,"_30844":292,"_21377":51359,"_5":14632,"_28040":51241,"_3027":51360},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3572":339,"_30844":292,"_21377":51362,"_5":14632,"_28040":51241,"_3027":51363},[],"Independent Gateways on one node and one IP",{"_3572":340,"_30844":292,"_21377":51365,"_5":14632,"_28040":51241,"_3027":51366},[],"Use different external ports",{"_3572":341,"_30844":292,"_21377":51368,"_5":14632,"_28040":51241,"_3027":51369},[],"Clients must include non-standard ports",{"_3572":342,"_30844":292,"_21377":51371,"_5":14632,"_28040":51241,"_3027":51372},[],"Separate TLS/mTLS termination behind one IP",{"_3572":343,"_30844":292,"_21377":51374,"_5":14632,"_28040":51241,"_3027":51375},[],"Front-door SNI routing to internal Gateways",{"_3572":344,"_30844":292,"_21377":51377,"_5":14632,"_28040":51241,"_3027":51378},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3572":345,"_30844":292,"_21377":51380,"_5":14632,"_28040":51241,"_3027":51381},[],"Separate Gateway resources but shared proxy infrastructure",{"_3572":346,"_30844":292,"_21377":51383,"_5":14632,"_28040":51241,"_3027":51384},[],"Envoy merged-Gateway mode",{"_3572":347,"_30844":292,"_21377":51386,"_5":14632,"_28040":51241,"_3027":51387},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3572":348,"_30844":292,"_21377":51389,"_5":14632,"_28040":51241,"_3027":51390},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3572":349,"_30844":292,"_21377":51392,"_5":14632,"_28040":51241,"_3027":51393},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3572":350,"_30844":292,"_21377":51395,"_5":14632,"_28040":51241,"_3027":51396},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3572":351,"_30844":292,"_21377":51398,"_5":14632,"_28040":51241,"_3027":51399},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3572":352,"_30844":292,"_21377":51401,"_5":14632,"_28040":51245,"_3027":51402},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3572":353,"_30844":292,"_21377":51404,"_5":14632,"_28040":51249,"_3027":51405},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3572":354,"_30844":292,"_21377":51407,"_5":14632,"_28040":51249,"_3027":51408},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3572":355,"_30844":292,"_21377":51410,"_5":14632,"_28040":51249,"_3027":51411},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3572":356,"_30844":292,"_21377":51413,"_5":14632,"_28040":51249,"_3027":51414},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3572":357,"_30844":292,"_21377":51416,"_5":14632,"_28040":51249,"_3027":51417},[],"If none of those are possible, use different external ports or change the external network design.",{"_3572":358,"_30844":292,"_21377":51419,"_5":14632,"_28040":51253,"_3027":51420},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3572":359,"_30844":292,"_21377":51422,"_5":14632,"_28040":51253,"_3027":51423},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3572":360,"_30844":292,"_21377":51425,"_5":14632,"_28040":51257,"_3027":51426},[],"Check, in order:",{"_3572":361,"_30844":292,"_21377":51428,"_5":14632,"_28040":51257,"_3027":51429},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3572":362,"_30844":292,"_21377":51431,"_5":14632,"_28040":51257,"_3027":51432},[],"Its status contains the expected address.",{"_3572":363,"_30844":292,"_21377":51434,"_5":14632,"_28040":51257,"_3027":51435},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3572":364,"_30844":292,"_21377":51437,"_5":14632,"_28040":51257,"_3027":51438},[],"Port 443 reaches that address from the client network.",{"_3572":365,"_30844":292,"_21377":51440,"_5":14632,"_28040":51257,"_3027":51441},[],"DNS resolves to the externally reachable endpoint.",{"_3572":366,"_30844":292,"_21377":51443,"_5":14632,"_28040":51257,"_3027":51444},[],"The certificate contains the DNS name or IP used by the client.",{"_3572":367,"_30844":292,"_21377":51446,"_5":14632,"_28040":51257,"_3027":51447},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3572":368,"_30844":368,"_5":14996,"_3027":50456,"_31202":51449,"_21377":51450,"_28040":368},[50349,50350,50456],[],{"_3572":369,"_30844":368,"_21377":51452,"_5":14632,"_28040":368,"_3027":51453},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3572":370,"_30844":368,"_5":31199,"_21377":51455,"_28040":51456,"_3027":51457},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3572":371,"_30844":368,"_5":31199,"_21377":51459,"_28040":51460,"_3027":51461},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3572":372,"_30844":368,"_5":31199,"_21377":51463,"_28040":51464,"_3027":51465},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3572":373,"_30844":368,"_5":31199,"_21377":51467,"_28040":51468,"_3027":51469},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3572":374,"_30844":368,"_5":31199,"_21377":51471,"_28040":51472,"_3027":51473},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3572":375,"_30844":368,"_5":31199,"_21377":51475,"_28040":51476,"_3027":51477},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3572":376,"_30844":368,"_21377":51479,"_5":14632,"_28040":51456,"_3027":51480},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3572":377,"_30844":368,"_21377":51482,"_5":14632,"_28040":51460,"_3027":51483},[],"Workflow",{"_3572":378,"_30844":368,"_21377":51485,"_5":14632,"_28040":51460,"_3027":51486},[],"Use it for",{"_3572":379,"_30844":368,"_21377":51488,"_5":14632,"_28040":51460,"_3027":51489},[],"What it installs",{"_3572":380,"_30844":368,"_21377":51491,"_5":14632,"_28040":51460,"_3027":51492},[],"Helm",{"_3572":381,"_30844":368,"_21377":51494,"_5":14632,"_28040":51460,"_3027":51495},[],"Production and controlled environments",{"_3572":382,"_30844":368,"_21377":51497,"_5":14632,"_28040":51460,"_3027":51498},[],"Lamassu services and Gateway API resources",{"_3572":383,"_30844":368,"_21377":51500,"_5":14632,"_28040":51460,"_3027":50593},[],{"_3572":384,"_30844":368,"_21377":51502,"_5":14632,"_28040":51460,"_3027":51503},[],"Evaluation, demos, CI and small lab clusters",{"_3572":385,"_30844":368,"_21377":51505,"_5":14632,"_28040":51460,"_3027":51506},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3572":386,"_30844":368,"_21377":51508,"_5":14632,"_28040":51464,"_3027":51509},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3572":387,"_30844":368,"_21377":51511,"_5":14632,"_28040":51464,"_3027":51512},[],"Area",{"_3572":388,"_30844":368,"_21377":51514,"_5":14632,"_28040":51464,"_3027":51515},[],"The Lamassu chart provides",{"_3572":389,"_30844":368,"_21377":51517,"_5":14632,"_28040":51464,"_3027":51518},[],"You provide",{"_3572":390,"_30844":368,"_21377":51520,"_5":14632,"_28040":51464,"_3027":51521},[],"Lamassu applications",{"_3572":391,"_30844":368,"_21377":51523,"_5":14632,"_28040":51464,"_3027":51524},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3572":392,"_30844":368,"_21377":51526,"_5":14632,"_28040":51464,"_3027":51527},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3572":393,"_30844":368,"_21377":51529,"_5":14632,"_28040":51464,"_3027":51530},[],"PostgreSQL data",{"_3572":394,"_30844":368,"_21377":51532,"_5":14632,"_28040":51464,"_3027":51533},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3572":395,"_30844":368,"_21377":51535,"_5":14632,"_28040":51464,"_3027":51536},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3572":396,"_30844":368,"_21377":51538,"_5":14632,"_28040":51464,"_3027":51539},[],"Messaging",{"_3572":397,"_30844":368,"_21377":51541,"_5":14632,"_28040":51464,"_3027":51542},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3572":398,"_30844":368,"_21377":51544,"_5":14632,"_28040":51464,"_3027":51545},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3572":399,"_30844":368,"_21377":51547,"_5":14632,"_28040":51464,"_3027":51548},[],"Identity",{"_3572":400,"_30844":368,"_21377":51550,"_5":14632,"_28040":51464,"_3027":51551},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3572":401,"_30844":368,"_21377":51553,"_5":14632,"_28040":51464,"_3027":51554},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3572":402,"_30844":368,"_21377":51556,"_5":14632,"_28040":51464,"_3027":51557},[],"External routing",{"_3572":403,"_30844":368,"_21377":51559,"_5":14632,"_28040":51464,"_3027":51560},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3572":404,"_30844":368,"_21377":51562,"_5":14632,"_28040":51464,"_3027":51563},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3572":405,"_30844":368,"_21377":51565,"_5":14632,"_28040":51464,"_3027":51566},[],"TLS",{"_3572":406,"_30844":368,"_21377":51568,"_5":14632,"_28040":51464,"_3027":51569},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3572":407,"_30844":368,"_21377":51571,"_5":14632,"_28040":51464,"_3027":51572},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3572":408,"_30844":368,"_21377":51574,"_5":14632,"_28040":51464,"_3027":51575},[],"Persistent application data",{"_3572":409,"_30844":368,"_21377":51577,"_5":14632,"_28040":51464,"_3027":51578},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3572":410,"_30844":368,"_21377":51580,"_5":14632,"_28040":51464,"_3027":51581},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3572":411,"_30844":368,"_21377":51583,"_5":14632,"_28040":51464,"_3027":51584},[],"Optional integrations",{"_3572":412,"_30844":368,"_21377":51586,"_5":14632,"_28040":51464,"_3027":51587},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3572":413,"_30844":368,"_21377":51589,"_5":14632,"_28040":51464,"_3027":51590},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3572":414,"_30844":368,"_21377":51592,"_5":14632,"_28040":51464,"_3027":51593},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3572":415,"_30844":368,"_21377":51595,"_5":14632,"_28040":51464,"_3027":51596},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3572":416,"_30844":368,"_21377":51598,"_5":14632,"_28040":51468,"_3027":51599},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3572":417,"_30844":368,"_21377":51601,"_5":14632,"_28040":51468,"_3027":51602},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3572":418,"_30844":368,"_21377":51604,"_5":14632,"_28040":51472,"_3027":51605},[],"Kubernetes 1.24 or newer",{"_3572":419,"_30844":368,"_21377":51607,"_5":14632,"_28040":51472,"_3027":51608},[],"Helm 3.2 or newer",{"_3572":420,"_30844":368,"_21377":51610,"_5":14632,"_28040":51472,"_3027":51611},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3572":421,"_30844":368,"_21377":51613,"_5":14632,"_28040":51472,"_3027":51614},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3572":422,"_30844":368,"_21377":51616,"_5":14632,"_28040":51472,"_3027":51617},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3572":423,"_30844":368,"_21377":51619,"_5":14632,"_28040":51472,"_3027":51620},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3572":424,"_30844":368,"_21377":51622,"_5":14632,"_28040":51472,"_3027":51623},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3572":425,"_30844":368,"_21377":51625,"_5":14632,"_28040":51476,"_3027":51626},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3572":426,"_30844":368,"_21377":51628,"_5":14632,"_28040":51476,"_3027":51629},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3572":427,"_30844":368,"_21377":51631,"_5":14632,"_28040":51476,"_3027":51632},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3572":428,"_30844":368,"_21377":51634,"_5":14632,"_28040":51476,"_3027":51635},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3572":429,"_30844":429,"_5":14996,"_3027":51637,"_31202":51638,"_21377":51640,"_28040":429},"Deployment troubleshooting",[50349,50350,51639],"Operations",[],{"_3572":430,"_30844":429,"_21377":51642,"_5":14632,"_28040":429,"_3027":51643},[],"Diagnose access, service health and infrastructure dependencies.",{"_3572":431,"_30844":429,"_5":31199,"_21377":51645,"_28040":51646,"_3027":51647},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3572":432,"_30844":429,"_5":31199,"_21377":51649,"_28040":51650,"_3027":51651},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3572":433,"_30844":429,"_5":31199,"_21377":51653,"_28040":51654,"_3027":51655},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3572":434,"_30844":429,"_5":31199,"_21377":51657,"_28040":51658,"_3027":51659},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3572":435,"_30844":429,"_5":31199,"_21377":51661,"_28040":51662,"_3027":51663},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3572":436,"_30844":429,"_5":31199,"_21377":51665,"_28040":51666,"_3027":51667},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3572":437,"_30844":429,"_5":31199,"_21377":51669,"_28040":51670,"_3027":51671},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3572":438,"_30844":429,"_5":31199,"_21377":51673,"_28040":51674,"_3027":51675},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3572":439,"_30844":429,"_5":31199,"_21377":51677,"_28040":51678,"_3027":51679},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3572":440,"_30844":429,"_5":31199,"_21377":51681,"_28040":51682,"_3027":51683},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3572":441,"_30844":429,"_5":31199,"_21377":51685,"_28040":51686,"_3027":51687},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3572":442,"_30844":429,"_5":31199,"_21377":51689,"_28040":51690,"_3027":51691},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3572":443,"_30844":429,"_5":31199,"_21377":51693,"_28040":51694,"_3027":51695},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#observability","Observability",{"_3572":444,"_30844":429,"_21377":51697,"_5":14632,"_28040":429,"_3027":51698},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3572":445,"_30844":429,"_21377":51700,"_5":14632,"_28040":51650,"_3027":51701},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3572":446,"_30844":429,"_21377":51703,"_5":14632,"_28040":51654,"_3027":51704},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3572":447,"_30844":429,"_21377":51706,"_5":14632,"_28040":51658,"_3027":51707},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3572":448,"_30844":429,"_21377":51709,"_5":14632,"_28040":51662,"_3027":51710},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3572":449,"_30844":429,"_21377":51712,"_5":14632,"_28040":51666,"_3027":51713},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3572":450,"_30844":429,"_21377":51715,"_5":14632,"_28040":51670,"_3027":51716},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3572":451,"_30844":429,"_21377":51718,"_5":14632,"_28040":51670,"_3027":51719},[],"Also run the chart's connectivity test:",{"_3572":452,"_30844":429,"_21377":51721,"_5":14632,"_28040":51670,"_3027":51722},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3572":453,"_30844":429,"_21377":51724,"_5":14632,"_28040":51670,"_3027":51725},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3572":454,"_30844":429,"_21377":51727,"_5":14632,"_28040":51674,"_3027":51728},[],"If you receive a 401:",{"_3572":455,"_30844":429,"_21377":51730,"_5":14632,"_28040":51674,"_3027":51731},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3572":456,"_30844":429,"_21377":51733,"_5":14632,"_28040":51674,"_3027":51734},[],"verify issuer, audience and expiration of the token;",{"_3572":457,"_30844":429,"_21377":51736,"_5":14632,"_28040":51674,"_3027":51737},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3572":458,"_30844":429,"_21377":51739,"_5":14632,"_28040":51674,"_3027":51740},[],"check that the provider's public and internal routes point to the same realm.",{"_3572":459,"_30844":429,"_21377":51742,"_5":14632,"_28040":51674,"_3027":51743},[],"If login succeeds but the APIs return 403:",{"_3572":460,"_30844":429,"_21377":51745,"_5":14632,"_28040":51674,"_3027":51746},[],"inspect the token's real claims;",{"_3572":461,"_30844":429,"_21377":51748,"_5":14632,"_28040":51674,"_3027":51749},[],"confirm they match an active principal;",{"_3572":462,"_30844":429,"_21377":51751,"_5":14632,"_28040":51674,"_3027":51752},[],"review the policies granted to that principal;",{"_3572":463,"_30844":429,"_21377":51754,"_5":14632,"_28040":51674,"_3027":51755},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3572":464,"_30844":429,"_21377":51757,"_5":14632,"_28040":51674,"_3027":51758},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3572":465,"_30844":429,"_21377":51760,"_5":14632,"_28040":51678,"_3027":51761},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3572":466,"_30844":429,"_21377":51763,"_5":14632,"_28040":51678,"_3027":51764},[],"Locate the authz pod and Service.",{"_3572":467,"_30844":429,"_21377":51766,"_5":14632,"_28040":51678,"_3027":51767},[],"Check /health, logs and its database connection.",{"_3572":468,"_30844":429,"_21377":51769,"_5":14632,"_28040":51678,"_3027":51770},[],"Verify the DNS and port configured in externalAuthorization.",{"_3572":469,"_30844":429,"_21377":51772,"_5":14632,"_28040":51678,"_3027":51773},[],"Check the check route is /v1/ext\\_authz/check.",{"_3572":470,"_30844":429,"_21377":51775,"_5":14632,"_28040":51678,"_3027":51776},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3572":471,"_30844":429,"_21377":51778,"_5":14632,"_28040":51682,"_3027":51779},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3572":472,"_30844":429,"_21377":51781,"_5":14632,"_28040":51686,"_3027":51782},[],"Review kubectl describe pod first. Common causes are:",{"_3572":473,"_30844":429,"_21377":51784,"_5":14632,"_28040":51686,"_3027":51785},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3572":474,"_30844":429,"_21377":51787,"_5":14632,"_28040":51686,"_3027":51788},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3572":475,"_30844":429,"_21377":51790,"_5":14632,"_28040":51686,"_3027":51791},[],"a credential environment variable set to the empty string while its YAML value is non-empty: the service fails at startup and names the variable and the configuration key, e.g. `LAMASSU_POSTGRES_PASSWORD is set but empty`;",{"_3572":476,"_30844":429,"_21377":51793,"_5":14632,"_28040":51686,"_3027":51794},[],"for authz, two schemas in the credentials map that normalize to the same environment-variable name (for example `pki-v2` and `pki.v2`): startup fails when a credential variable for either schema is set; with the variables unset the service logs a warning and uses the YAML values.",{"_3572":477,"_30844":429,"_21377":51796,"_5":14632,"_28040":51686,"_3027":51797},[],"unbound persistent volume;",{"_3572":478,"_30844":429,"_21377":51799,"_5":14632,"_28040":51686,"_3027":51800},[],"inaccessible image or incorrect pull policy;",{"_3572":479,"_30844":429,"_21377":51802,"_5":14632,"_28040":51686,"_3027":51803},[],"invalid cryptographic engine configuration;",{"_3572":480,"_30844":429,"_21377":51805,"_5":14632,"_28040":51686,"_3027":51806},[],"CPU or memory limits set too low;",{"_3572":481,"_30844":429,"_21377":51808,"_5":14632,"_28040":51686,"_3027":51809},[],"an incomplete prior migration.",{"_3572":482,"_30844":429,"_21377":51811,"_5":14632,"_28040":51686,"_3027":51812},[],"These startup failures come from the credential environment variables described in Credential environment variables.",{"_3572":483,"_30844":429,"_21377":51814,"_5":14632,"_28040":51686,"_3027":51815},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3572":484,"_30844":429,"_21377":51817,"_5":14632,"_28040":51686,"_3027":51818},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3572":485,"_30844":429,"_21377":51820,"_5":14632,"_28040":51686,"_3027":51821},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3572":486,"_30844":429,"_21377":51823,"_5":14632,"_28040":51690,"_3027":51824},[],"Domain and audit events depend on the bus publisher:",{"_3572":487,"_30844":429,"_21377":51826,"_5":14632,"_28040":51690,"_3027":51827},[],"verify it is enabled in the emitting service;",{"_3572":488,"_30844":429,"_21377":51829,"_5":14632,"_28040":51690,"_3027":51830},[],"check AMQP connectivity and credentials;",{"_3572":489,"_30844":429,"_21377":51832,"_5":14632,"_28040":51690,"_3027":51833},[],"review exchange, routing key, queues and consumers;",{"_3572":490,"_30844":429,"_21377":51835,"_5":14632,"_28040":51690,"_3027":51836},[],"inspect dead-letter queues;",{"_3572":491,"_30844":429,"_21377":51838,"_5":14632,"_28040":51690,"_3027":51839},[],"alert on orphan durable queues and backlog growth.",{"_3572":492,"_30844":429,"_21377":51841,"_5":14632,"_28040":51690,"_3027":51842},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3572":493,"_30844":429,"_21377":51844,"_5":14632,"_28040":51690,"_3027":51845},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3572":494,"_30844":429,"_21377":51847,"_5":14632,"_28040":51690,"_3027":51848},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3572":495,"_30844":429,"_21377":51850,"_5":14632,"_28040":51690,"_3027":51851},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3572":496,"_30844":429,"_21377":51853,"_5":14632,"_28040":51690,"_3027":51854},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3572":497,"_30844":429,"_21377":51856,"_5":14632,"_28040":51690,"_3027":51857},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3572":498,"_30844":429,"_21377":51859,"_5":14632,"_28040":51690,"_3027":51860},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3572":499,"_30844":429,"_21377":51862,"_5":14632,"_28040":51694,"_3027":51863},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3572":500,"_30844":429,"_21377":51865,"_5":14632,"_28040":51694,"_3027":51866},[],"Before closing an incident, record:",{"_3572":501,"_30844":429,"_21377":51868,"_5":14632,"_28040":51694,"_3027":51869},[],"the confirmed cause;",{"_3572":502,"_30844":429,"_21377":51871,"_5":14632,"_28040":51694,"_3027":51872},[],"the time scope and affected resources;",{"_3572":503,"_30844":429,"_21377":51874,"_5":14632,"_28040":51694,"_3027":51875},[],"the commands or queries used;",{"_3572":504,"_30844":429,"_21377":51877,"_5":14632,"_28040":51694,"_3027":51878},[],"the applied change and how to revert it;",{"_3572":505,"_30844":429,"_21377":51880,"_5":14632,"_28040":51694,"_3027":51881},[],"validation from a consumer;",{"_3572":506,"_30844":429,"_21377":51883,"_5":14632,"_28040":51694,"_3027":51884},[],"the preventive action and its owner.",{"_3572":507,"_30844":507,"_5":14996,"_3027":51886,"_31202":51887,"_21377":51891,"_28040":507},"Data model",[50349,51888,51889,51890],"Platform","Administration","Access control",[],{"_3572":508,"_30844":507,"_21377":51893,"_5":14632,"_28040":507,"_3027":51894},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3572":509,"_30844":507,"_5":31199,"_21377":51896,"_28040":51897,"_3027":51898},[],"/docs/pr-preview/pr-68/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3572":510,"_30844":507,"_5":31199,"_21377":51900,"_28040":51901,"_3027":51902},[],"/docs/pr-preview/pr-68/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3572":511,"_30844":507,"_21377":51904,"_5":14632,"_28040":507,"_3027":51905},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3572":512,"_30844":507,"_21377":51907,"_5":14632,"_28040":51897,"_3027":51908},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3572":513,"_30844":507,"_21377":51910,"_5":14632,"_28040":51897,"_3027":51911},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3572":514,"_30844":507,"_21377":51913,"_5":14632,"_28040":51897,"_3027":51914},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3572":515,"_30844":507,"_21377":51916,"_5":14632,"_28040":51901,"_3027":51917},[],"Entity (`schema_name.entity_type`)",{"_3572":516,"_30844":507,"_21377":51919,"_5":14632,"_28040":51901,"_3027":51920},[],"Table (`table_name`)",{"_3572":517,"_30844":507,"_21377":51922,"_5":14632,"_28040":51901,"_3027":51923},[],"Key (`primary_key`)",{"_3572":518,"_30844":507,"_21377":51925,"_5":14632,"_28040":51901,"_3027":51926},[],"`alerts.event`",{"_3572":519,"_30844":507,"_21377":51928,"_5":14632,"_28040":51901,"_3027":51929},[],"`events`",{"_3572":520,"_30844":507,"_21377":51931,"_5":14632,"_28040":51901,"_3027":51932},[],"`event_type`",{"_3572":521,"_30844":507,"_21377":51934,"_5":14632,"_28040":51901,"_3027":51935},[],"`alerts.subscription`",{"_3572":522,"_30844":507,"_21377":51937,"_5":14632,"_28040":51901,"_3027":51938},[],"`subscriptions`",{"_3572":523,"_30844":507,"_21377":51940,"_5":14632,"_28040":51901,"_3027":51941},[],"`id`",{"_3572":524,"_30844":507,"_21377":51943,"_5":14632,"_28040":51901,"_3027":51944},[],"`ca.ca_certificate`",{"_3572":525,"_30844":507,"_21377":51946,"_5":14632,"_28040":51901,"_3027":51947},[],"`ca_certificates`",{"_3572":526,"_30844":507,"_21377":51949,"_5":14632,"_28040":51901,"_3027":51941},[],{"_3572":527,"_30844":507,"_21377":51951,"_5":14632,"_28040":51901,"_3027":51952},[],"`ca.certificate`",{"_3572":528,"_30844":507,"_21377":51954,"_5":14632,"_28040":51901,"_3027":51955},[],"`certificates`",{"_3572":529,"_30844":507,"_21377":51957,"_5":14632,"_28040":51901,"_3027":51958},[],"`serial_number`",{"_3572":530,"_30844":507,"_21377":51960,"_5":14632,"_28040":51901,"_3027":51961},[],"`ca.issuance_profile`",{"_3572":531,"_30844":507,"_21377":51963,"_5":14632,"_28040":51901,"_3027":51964},[],"`issuance_profiles`",{"_3572":532,"_30844":507,"_21377":51966,"_5":14632,"_28040":51901,"_3027":51941},[],{"_3572":533,"_30844":507,"_21377":51968,"_5":14632,"_28040":51901,"_3027":51969},[],"`devicemanager.device_group`",{"_3572":534,"_30844":507,"_21377":51971,"_5":14632,"_28040":51901,"_3027":51972},[],"`device_groups`",{"_3572":535,"_30844":507,"_21377":51974,"_5":14632,"_28040":51901,"_3027":51941},[],{"_3572":536,"_30844":507,"_21377":51976,"_5":14632,"_28040":51901,"_3027":51977},[],"`devicemanager.device`",{"_3572":537,"_30844":507,"_21377":51979,"_5":14632,"_28040":51901,"_3027":51980},[],"`devices`",{"_3572":538,"_30844":507,"_21377":51982,"_5":14632,"_28040":51901,"_3027":51941},[],{"_3572":539,"_30844":507,"_21377":51984,"_5":14632,"_28040":51901,"_3027":51985},[],"`dmsmanager.dms`",{"_3572":540,"_30844":507,"_21377":51987,"_5":14632,"_28040":51901,"_3027":51988},[],"`dms`",{"_3572":541,"_30844":507,"_21377":51990,"_5":14632,"_28040":51901,"_3027":51941},[],{"_3572":542,"_30844":507,"_21377":51992,"_5":14632,"_28040":51901,"_3027":51993},[],"`kms.kms_key`",{"_3572":543,"_30844":507,"_21377":51995,"_5":14632,"_28040":51901,"_3027":51996},[],"`kms_keys`",{"_3572":544,"_30844":507,"_21377":51998,"_5":14632,"_28040":51901,"_3027":51999},[],"`key_id`, `engine_id`",{"_3572":545,"_30844":507,"_21377":52001,"_5":14632,"_28040":51901,"_3027":52002},[],"`va.crl_settings`",{"_3572":546,"_30844":507,"_21377":52004,"_5":14632,"_28040":51901,"_3027":52005},[],"`crl_settings`",{"_3572":547,"_30844":507,"_21377":52007,"_5":14632,"_28040":51901,"_3027":52008},[],"`ca_id`",{"_3572":548,"_30844":507,"_21377":52010,"_5":14632,"_28040":51901,"_3027":52011},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3572":549,"_30844":507,"_21377":52013,"_5":14632,"_28040":51901,"_3027":52014},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3572":550,"_30844":507,"_21377":52016,"_5":14632,"_28040":51901,"_3027":52017},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3572":551,"_30844":551,"_5":14996,"_3027":52019,"_31202":52020,"_21377":52021,"_28040":551},"Access control overview",[50349,51888,51889,51890],[],{"_3572":552,"_30844":551,"_21377":52023,"_5":14632,"_28040":551,"_3027":52024},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3572":553,"_30844":551,"_5":31199,"_21377":52026,"_28040":52027,"_3027":52028},[],"/docs/pr-preview/pr-68/platform/administration/access-control#essential-concepts","Essential concepts",{"_3572":554,"_30844":551,"_5":31199,"_21377":52030,"_28040":52031,"_3027":52032},[],"/docs/pr-preview/pr-68/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3572":555,"_30844":551,"_5":31199,"_21377":52034,"_28040":52035,"_3027":52036},[],"/docs/pr-preview/pr-68/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3572":556,"_30844":551,"_5":31199,"_21377":52038,"_28040":52039,"_3027":52040},[],"/docs/pr-preview/pr-68/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3572":557,"_30844":551,"_5":31199,"_21377":52042,"_28040":52043,"_3027":52044},[],"/docs/pr-preview/pr-68/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3572":558,"_30844":551,"_5":31199,"_21377":52046,"_28040":52047,"_3027":52048},[],"/docs/pr-preview/pr-68/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3572":559,"_30844":551,"_5":31199,"_21377":52050,"_28040":52051,"_3027":52052},[],"/docs/pr-preview/pr-68/platform/administration/access-control#oidc-principals","OIDC principals",{"_3572":560,"_30844":551,"_5":31199,"_21377":52054,"_28040":52055,"_3027":52056},[],"/docs/pr-preview/pr-68/platform/administration/access-control#x509-principals","X.509 principals",{"_3572":561,"_30844":551,"_5":31199,"_21377":52058,"_28040":52059,"_3027":52060},[],"/docs/pr-preview/pr-68/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3572":562,"_30844":551,"_5":31199,"_21377":52062,"_28040":52063,"_3027":52064},[],"/docs/pr-preview/pr-68/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3572":563,"_30844":551,"_5":31199,"_21377":52066,"_28040":52067,"_3027":52068},[],"/docs/pr-preview/pr-68/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3572":564,"_30844":551,"_5":31199,"_21377":52070,"_28040":52071,"_3027":52072},[],"/docs/pr-preview/pr-68/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3572":565,"_30844":551,"_5":31199,"_21377":52074,"_28040":52075,"_3027":52076},[],"/docs/pr-preview/pr-68/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3572":566,"_30844":551,"_5":31199,"_21377":52078,"_28040":52079,"_3027":52080},[],"/docs/pr-preview/pr-68/platform/administration/access-control#http-rules","HTTP rules",{"_3572":567,"_30844":551,"_5":31199,"_21377":52082,"_28040":52083,"_3027":52084},[],"/docs/pr-preview/pr-68/platform/administration/access-control#included-policies","Included policies",{"_3572":568,"_30844":551,"_5":31199,"_21377":52086,"_28040":52087,"_3027":50993},[],"/docs/pr-preview/pr-68/platform/administration/access-control#provision-the-first-administrator",{"_3572":569,"_30844":551,"_5":31199,"_21377":52089,"_28040":52090,"_3027":52091},[],"/docs/pr-preview/pr-68/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3572":570,"_30844":551,"_5":31199,"_21377":52093,"_28040":52094,"_3027":52095},[],"/docs/pr-preview/pr-68/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3572":571,"_30844":551,"_5":31199,"_21377":52097,"_28040":52098,"_3027":52099},[],"/docs/pr-preview/pr-68/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3572":572,"_30844":551,"_5":31199,"_21377":52101,"_28040":52102,"_3027":52103},[],"/docs/pr-preview/pr-68/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3572":573,"_30844":551,"_5":31199,"_21377":52105,"_28040":52106,"_3027":52107},[],"/docs/pr-preview/pr-68/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3572":574,"_30844":551,"_5":31199,"_21377":52109,"_28040":52110,"_3027":52111},[],"/docs/pr-preview/pr-68/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3572":575,"_30844":551,"_5":31199,"_21377":52113,"_28040":52114,"_3027":52115},[],"/docs/pr-preview/pr-68/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3572":576,"_30844":551,"_5":31199,"_21377":52117,"_28040":52118,"_3027":52119},[],"/docs/pr-preview/pr-68/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3572":577,"_30844":551,"_5":31199,"_21377":52121,"_28040":52122,"_3027":52123},[],"/docs/pr-preview/pr-68/platform/administration/access-control#operational-checklist","Operational checklist",{"_3572":578,"_30844":551,"_5":31199,"_21377":52125,"_28040":52126,"_3027":52127},[],"/docs/pr-preview/pr-68/platform/administration/access-control#diagnostics","Diagnostics",{"_3572":579,"_30844":551,"_5":31199,"_21377":52129,"_28040":52130,"_3027":52131},[],"/docs/pr-preview/pr-68/platform/administration/access-control#the-response-is-401","The response is 401",{"_3572":580,"_30844":551,"_5":31199,"_21377":52133,"_28040":52134,"_3027":52135},[],"/docs/pr-preview/pr-68/platform/administration/access-control#the-response-is-403","The response is 403",{"_3572":581,"_30844":551,"_5":31199,"_21377":52137,"_28040":52138,"_3027":52139},[],"/docs/pr-preview/pr-68/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3572":582,"_30844":551,"_5":31199,"_21377":52141,"_28040":52142,"_3027":52143},[],"/docs/pr-preview/pr-68/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3572":583,"_30844":551,"_5":31199,"_21377":52145,"_28040":52146,"_3027":52147},[],"/docs/pr-preview/pr-68/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3572":584,"_30844":551,"_21377":52149,"_5":14632,"_28040":551,"_3027":52150},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3572":585,"_30844":551,"_21377":52152,"_5":14632,"_28040":551,"_3027":52153},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3572":586,"_30844":551,"_21377":52155,"_5":14632,"_28040":551,"_3027":52156},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3572":587,"_30844":551,"_21377":52158,"_5":14632,"_28040":52027,"_3027":52159},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3572":588,"_30844":551,"_21377":52161,"_5":14632,"_28040":52027,"_3027":52162},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3572":589,"_30844":551,"_21377":52164,"_5":14632,"_28040":52027,"_3027":52165},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3572":590,"_30844":551,"_21377":52167,"_5":14632,"_28040":52027,"_3027":52168},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3572":591,"_30844":551,"_21377":52170,"_5":14632,"_28040":52027,"_3027":52171},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3572":592,"_30844":551,"_21377":52173,"_5":14632,"_28040":52027,"_3027":52174},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3572":593,"_30844":551,"_21377":52176,"_5":14632,"_28040":52031,"_3027":52177},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3572":594,"_30844":551,"_21377":52179,"_5":14632,"_28040":52031,"_3027":52180},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3572":595,"_30844":551,"_21377":52182,"_5":14632,"_28040":52035,"_3027":52183},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3572":596,"_30844":551,"_21377":52185,"_5":14632,"_28040":52035,"_3027":52186},[],"The decision is made **before forwarding the request to the service**:",{"_3572":597,"_30844":551,"_21377":52188,"_5":14632,"_28040":52035,"_3027":52189},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3572":598,"_30844":551,"_21377":52191,"_5":14632,"_28040":52035,"_3027":52192},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3572":599,"_30844":551,"_21377":52194,"_5":14632,"_28040":52035,"_3027":52195},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3572":600,"_30844":551,"_21377":52197,"_5":14632,"_28040":52035,"_3027":52198},[],"It separately loads the policies granted to each principal.",{"_3572":601,"_30844":551,"_21377":52200,"_5":14632,"_28040":52035,"_3027":52201},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3572":602,"_30844":551,"_21377":52203,"_5":14632,"_28040":52035,"_3027":52204},[],"`authz` looks for an HTTP rule granting that action.",{"_3572":603,"_30844":551,"_21377":52206,"_5":14632,"_28040":52035,"_3027":52207},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3572":604,"_30844":551,"_21377":52209,"_5":14632,"_28040":52035,"_3027":52210},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3572":605,"_30844":551,"_21377":52212,"_5":14632,"_28040":52035,"_3027":52213},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3572":606,"_30844":551,"_21377":52215,"_5":14632,"_28040":52035,"_3027":52216},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3572":607,"_30844":551,"_21377":52218,"_5":14632,"_28040":52039,"_3027":52219},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3572":608,"_30844":551,"_21377":52221,"_5":14632,"_28040":52039,"_3027":52222},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3572":609,"_30844":551,"_21377":52224,"_5":14632,"_28040":52039,"_3027":52225},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3572":610,"_30844":551,"_21377":52227,"_5":14632,"_28040":52039,"_3027":52228},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3572":611,"_30844":551,"_21377":52230,"_5":14632,"_28040":52039,"_3027":52231},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3572":612,"_30844":551,"_21377":52233,"_5":14632,"_28040":52039,"_3027":52234},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3572":613,"_30844":551,"_21377":52236,"_5":14632,"_28040":52039,"_3027":52237},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3572":614,"_30844":551,"_21377":52239,"_5":14632,"_28040":52039,"_3027":52240},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3572":615,"_30844":551,"_21377":52242,"_5":14632,"_28040":52043,"_3027":52243},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3572":616,"_30844":551,"_21377":52245,"_5":14632,"_28040":52043,"_3027":52246},[],"The decision is made with the domain operation context:",{"_3572":617,"_30844":551,"_21377":52248,"_5":14632,"_28040":52043,"_3027":52249},[],"The middleware extracts the credential and resolves the matching principals.",{"_3572":618,"_30844":551,"_21377":52251,"_5":14632,"_28040":52043,"_3027":52252},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3572":619,"_30844":551,"_21377":52254,"_5":14632,"_28040":52043,"_3027":52255},[],"`authz` gathers the entity rules of the granted policies.",{"_3572":620,"_30844":551,"_21377":52257,"_5":14632,"_28040":52043,"_3027":52258},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3572":621,"_30844":551,"_21377":52260,"_5":14632,"_28040":52043,"_3027":52261},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3572":622,"_30844":551,"_21377":52263,"_5":14632,"_28040":52043,"_3027":52264},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3572":623,"_30844":551,"_21377":52266,"_5":14632,"_28040":52043,"_3027":52267},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3572":624,"_30844":551,"_21377":52269,"_5":14632,"_28040":52043,"_3027":52270},[],"Actions fall into two groups:",{"_3572":625,"_30844":551,"_21377":52272,"_5":14632,"_28040":52043,"_3027":52273},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3572":626,"_30844":551,"_21377":52275,"_5":14632,"_28040":52043,"_3027":52276},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3572":627,"_30844":551,"_21377":52278,"_5":14632,"_28040":52043,"_3027":52279},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3572":628,"_30844":551,"_21377":52281,"_5":14632,"_28040":52047,"_3027":52282},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3572":629,"_30844":551,"_21377":52284,"_5":14632,"_28040":52047,"_3027":52285},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3572":630,"_30844":551,"_21377":52287,"_5":14632,"_28040":52047,"_3027":52288},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3572":631,"_30844":551,"_21377":52290,"_5":14632,"_28040":52051,"_3027":52291},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3572":632,"_30844":551,"_21377":52293,"_5":14632,"_28040":52051,"_3027":52294},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3572":633,"_30844":551,"_21377":52296,"_5":14632,"_28040":52051,"_3027":52297},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3572":634,"_30844":551,"_21377":52299,"_5":14632,"_28040":52051,"_3027":52300},[],"The implemented operators are:",{"_3572":635,"_30844":551,"_21377":52302,"_5":14632,"_28040":52051,"_3027":52303},[],"`equals`, for exact equality;",{"_3572":636,"_30844":551,"_21377":52305,"_5":14632,"_28040":52051,"_3027":52306},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3572":637,"_30844":551,"_21377":52308,"_5":14632,"_28040":52051,"_3027":52309},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3572":638,"_30844":551,"_21377":52311,"_5":14632,"_28040":52051,"_3027":52312},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3572":639,"_30844":551,"_21377":52314,"_5":14632,"_28040":52055,"_3027":52315},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3572":640,"_30844":551,"_21377":52317,"_5":14632,"_28040":52055,"_3027":52318},[],"The available modes are:",{"_3572":641,"_30844":551,"_21377":52320,"_5":14632,"_28040":52055,"_3027":52321},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3572":642,"_30844":551,"_21377":52323,"_5":14632,"_28040":52055,"_3027":52324},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3572":643,"_30844":551,"_21377":52326,"_5":14632,"_28040":52055,"_3027":52327},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3572":644,"_30844":551,"_21377":52329,"_5":14632,"_28040":52055,"_3027":52330},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3572":645,"_30844":551,"_21377":52332,"_5":14632,"_28040":52055,"_3027":52333},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3572":646,"_30844":551,"_21377":52335,"_5":14632,"_28040":52055,"_3027":52336},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3572":647,"_30844":551,"_21377":52338,"_5":14632,"_28040":52059,"_3027":52339},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3572":648,"_30844":551,"_21377":52341,"_5":14632,"_28040":52059,"_3027":52342},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3572":649,"_30844":551,"_21377":52344,"_5":14632,"_28040":52059,"_3027":52345},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3572":650,"_30844":551,"_21377":52347,"_5":14632,"_28040":52059,"_3027":52348},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3572":651,"_30844":551,"_21377":52350,"_5":14632,"_28040":52067,"_3027":52351},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3572":652,"_30844":551,"_21377":52353,"_5":14632,"_28040":52067,"_3027":52354},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3572":653,"_30844":551,"_21377":52356,"_5":14632,"_28040":52071,"_3027":52357},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3572":654,"_30844":551,"_21377":52359,"_5":14632,"_28040":52071,"_3027":52360},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3572":655,"_30844":551,"_21377":52362,"_5":14632,"_28040":52071,"_3027":52363},[],"The data model shows how the resources used in entity rules are connected.",{"_3572":656,"_30844":551,"_21377":52365,"_5":14632,"_28040":52071,"_3027":52366},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3572":657,"_30844":551,"_21377":52368,"_5":14632,"_28040":52071,"_3027":52369},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3572":658,"_30844":551,"_21377":52371,"_5":14632,"_28040":52075,"_3027":52372},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3572":659,"_30844":551,"_21377":52374,"_5":14632,"_28040":52075,"_3027":52375},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3572":660,"_30844":551,"_21377":52377,"_5":14632,"_28040":52075,"_3027":52378},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3572":661,"_30844":551,"_21377":52380,"_5":14632,"_28040":52079,"_3027":52381},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3572":662,"_30844":551,"_21377":52383,"_5":14632,"_28040":52079,"_3027":52384},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3572":663,"_30844":551,"_21377":52386,"_5":14632,"_28040":52079,"_3027":52387},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3572":664,"_30844":551,"_21377":52389,"_5":14632,"_28040":52079,"_3027":52390},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3572":665,"_30844":551,"_21377":52392,"_5":14632,"_28040":52079,"_3027":52393},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3572":666,"_30844":551,"_21377":52395,"_5":14632,"_28040":52079,"_3027":52396},[],"Note that:",{"_3572":667,"_30844":551,"_21377":52398,"_5":14632,"_28040":52079,"_3027":52399},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3572":668,"_30844":551,"_21377":52401,"_5":14632,"_28040":52079,"_3027":52402},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3572":669,"_30844":551,"_21377":52404,"_5":14632,"_28040":52079,"_3027":52405},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3572":670,"_30844":551,"_21377":52407,"_5":14632,"_28040":52083,"_3027":52408},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3572":671,"_30844":551,"_21377":52410,"_5":14632,"_28040":52083,"_3027":52411},[],"full and read-only access to certificates and authorities;",{"_3572":672,"_30844":551,"_21377":52413,"_5":14632,"_28040":52083,"_3027":52414},[],"full and read-only access to the KMS;",{"_3572":673,"_30844":551,"_21377":52416,"_5":14632,"_28040":52083,"_3027":52417},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3572":674,"_30844":551,"_21377":52419,"_5":14632,"_28040":52083,"_3027":52420},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3572":675,"_30844":551,"_21377":52422,"_5":14632,"_28040":52083,"_3027":52423},[],"console access;",{"_3572":676,"_30844":551,"_21377":52425,"_5":14632,"_28040":52083,"_3027":52426},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3572":677,"_30844":551,"_21377":52428,"_5":14632,"_28040":52083,"_3027":52429},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3572":678,"_30844":551,"_21377":52431,"_5":14632,"_28040":52083,"_3027":52432},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3572":679,"_30844":551,"_21377":52434,"_5":14632,"_28040":52087,"_3027":52435},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3572":680,"_30844":551,"_21377":52437,"_5":14632,"_28040":52087,"_3027":52438},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3572":681,"_30844":551,"_21377":52440,"_5":14632,"_28040":52087,"_3027":52441},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3572":682,"_30844":551,"_21377":52443,"_5":14632,"_28040":52090,"_3027":52444},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3572":683,"_30844":551,"_21377":52446,"_5":14632,"_28040":52094,"_3027":52447},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3572":684,"_30844":551,"_21377":52449,"_5":14632,"_28040":52094,"_3027":52450},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3572":685,"_30844":551,"_21377":52452,"_5":14632,"_28040":52098,"_3027":52453},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3572":686,"_30844":551,"_21377":52455,"_5":14632,"_28040":52102,"_3027":52456},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3572":687,"_30844":551,"_21377":52458,"_5":14632,"_28040":52106,"_3027":52459},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3572":688,"_30844":551,"_21377":52461,"_5":14632,"_28040":52110,"_3027":52462},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3572":689,"_30844":551,"_21377":52464,"_5":14632,"_28040":52110,"_3027":52465},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3572":690,"_30844":551,"_21377":52467,"_5":14632,"_28040":52114,"_3027":52468},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3572":691,"_30844":551,"_21377":52470,"_5":14632,"_28040":52114,"_3027":52471},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3572":692,"_30844":551,"_21377":52473,"_5":14632,"_28040":52114,"_3027":52474},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3572":693,"_30844":551,"_21377":52476,"_5":14632,"_28040":52114,"_3027":52477},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3572":694,"_30844":551,"_21377":52479,"_5":14632,"_28040":52114,"_3027":52480},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3572":695,"_30844":551,"_21377":52482,"_5":14632,"_28040":52114,"_3027":52483},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3572":696,"_30844":551,"_21377":52485,"_5":14632,"_28040":52114,"_3027":52486},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3572":697,"_30844":551,"_21377":52488,"_5":14632,"_28040":52114,"_3027":52489},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3572":698,"_30844":551,"_21377":52491,"_5":14632,"_28040":52118,"_3027":52492},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3572":699,"_30844":551,"_21377":52494,"_5":14632,"_28040":52118,"_3027":52495},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3572":700,"_30844":551,"_21377":52497,"_5":14632,"_28040":52118,"_3027":52498},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3572":701,"_30844":551,"_21377":52500,"_5":14632,"_28040":52122,"_3027":52501},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3572":702,"_30844":551,"_21377":52503,"_5":14632,"_28040":52122,"_3027":52504},[],"Use groups or stable roles for people and independent identities for automations.",{"_3572":703,"_30844":551,"_21377":52506,"_5":14632,"_28040":52122,"_3027":52507},[],"Keep at least two recovery administrators and test their access periodically.",{"_3572":704,"_30844":551,"_21377":52509,"_5":14632,"_28040":52122,"_3027":52510},[],"Review active principals, their matches and their grants after IdP changes.",{"_3572":705,"_30844":551,"_21377":52512,"_5":14632,"_28040":52122,"_3027":52513},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3572":706,"_30844":551,"_21377":52515,"_5":14632,"_28040":52122,"_3027":52516},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3572":707,"_30844":551,"_21377":52518,"_5":14632,"_28040":52122,"_3027":52519},[],"Always test one allowed and one denied operation for each role.",{"_3572":708,"_30844":551,"_21377":52521,"_5":14632,"_28040":52122,"_3027":52522},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3572":709,"_30844":551,"_21377":52524,"_5":14632,"_28040":52130,"_3027":52525},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3572":710,"_30844":551,"_21377":52527,"_5":14632,"_28040":52134,"_3027":52528},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3572":711,"_30844":551,"_21377":52530,"_5":14632,"_28040":52134,"_3027":52531},[],"that an active principal of the correct type exists;",{"_3572":712,"_30844":551,"_21377":52533,"_5":14632,"_28040":52134,"_3027":52534},[],"that the claim paths and values match the real token exactly;",{"_3572":713,"_30844":551,"_21377":52536,"_5":14632,"_28040":52134,"_3027":52537},[],"that all of the principal's conditions hold;",{"_3572":714,"_30844":551,"_21377":52539,"_5":14632,"_28040":52134,"_3027":52540},[],"that the principal has the expected policy granted;",{"_3572":715,"_30844":551,"_21377":52542,"_5":14632,"_28040":52134,"_3027":52543},[],"that the policy includes the action and the requested resource type or route;",{"_3572":716,"_30844":551,"_21377":52545,"_5":14632,"_28040":52134,"_3027":52546},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3572":717,"_30844":551,"_21377":52548,"_5":14632,"_28040":52134,"_3027":52549},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3572":718,"_30844":551,"_21377":52551,"_5":14632,"_28040":52134,"_3027":52552},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3572":719,"_30844":551,"_21377":52554,"_5":14632,"_28040":52138,"_3027":52555},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3572":720,"_30844":551,"_21377":52557,"_5":14632,"_28040":52142,"_3027":52558},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3572":721,"_30844":551,"_21377":52560,"_5":14632,"_28040":52146,"_3027":52561},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3572":722,"_30844":551,"_21377":52563,"_5":14632,"_28040":52146,"_3027":52564},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3572":723,"_30844":723,"_5":14996,"_3027":52566,"_31202":52567,"_21377":52568,"_28040":723},"Alerts and subscriptions",[50349,51888,51889],[],{"_3572":724,"_30844":723,"_21377":52570,"_5":14632,"_28040":723,"_3027":52571},[],"Send PKI events to people and external systems.",{"_3572":725,"_30844":723,"_5":31199,"_21377":52573,"_28040":52574,"_3027":52575},[],"/docs/pr-preview/pr-68/platform/administration/alerts#how-it-works","How it works",{"_3572":726,"_30844":723,"_5":31199,"_21377":52577,"_28040":52578,"_3027":52579},[],"/docs/pr-preview/pr-68/platform/administration/alerts#available-channels","Available channels",{"_3572":727,"_30844":723,"_5":31199,"_21377":52581,"_28040":52582,"_3027":52583},[],"/docs/pr-preview/pr-68/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3572":728,"_30844":723,"_5":31199,"_21377":52585,"_28040":52586,"_3027":52587},[],"/docs/pr-preview/pr-68/platform/administration/alerts#choose-the-event","Choose the event",{"_3572":729,"_30844":723,"_5":31199,"_21377":52589,"_28040":52590,"_3027":52591},[],"/docs/pr-preview/pr-68/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3572":730,"_30844":723,"_5":31199,"_21377":52593,"_28040":52594,"_3027":52595},[],"/docs/pr-preview/pr-68/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3572":731,"_30844":723,"_5":31199,"_21377":52597,"_28040":52598,"_3027":52599},[],"/docs/pr-preview/pr-68/platform/administration/alerts#review-and-activate","Review and activate",{"_3572":732,"_30844":723,"_5":31199,"_21377":52601,"_28040":52602,"_3027":52603},[],"/docs/pr-preview/pr-68/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3572":733,"_30844":723,"_5":31199,"_21377":52605,"_28040":52606,"_3027":52607},[],"/docs/pr-preview/pr-68/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3572":734,"_30844":723,"_5":31199,"_21377":52609,"_28040":52610,"_3027":52611},[],"/docs/pr-preview/pr-68/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3572":735,"_30844":723,"_5":31199,"_21377":52613,"_28040":52614,"_3027":52615},[],"/docs/pr-preview/pr-68/platform/administration/alerts#event-families","Event families",{"_3572":736,"_30844":723,"_21377":52617,"_5":14632,"_28040":723,"_3027":52618},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3572":737,"_30844":723,"_21377":52620,"_5":14632,"_28040":52574,"_3027":52621},[],"A service publishes a domain event.",{"_3572":738,"_30844":723,"_21377":52623,"_5":14632,"_28040":52574,"_3027":52624},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3572":739,"_30844":723,"_21377":52626,"_5":14632,"_28040":52574,"_3027":52627},[],"Each subscription's filter decides whether it should be notified.",{"_3572":740,"_30844":723,"_21377":52629,"_5":14632,"_28040":52574,"_3027":52630},[],"Lamassu delivers the event to the configured channel.",{"_3572":741,"_30844":723,"_21377":52632,"_5":14632,"_28040":52574,"_3027":52633},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3572":742,"_30844":723,"_21377":52635,"_5":14632,"_28040":52578,"_3027":52636},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3572":743,"_30844":723,"_21377":52638,"_5":14632,"_28040":52578,"_3027":52639},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3572":744,"_30844":723,"_21377":52641,"_5":14632,"_28040":52578,"_3027":52642},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3572":745,"_30844":723,"_21377":52644,"_5":14632,"_28040":52578,"_3027":52645},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3572":746,"_30844":723,"_21377":52647,"_5":14632,"_28040":52578,"_3027":52648},[],"`apikey_options` requires `header` and `key`.",{"_3572":747,"_30844":723,"_21377":52650,"_5":14632,"_28040":52578,"_3027":52651},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3572":748,"_30844":723,"_21377":52653,"_5":14632,"_28040":52578,"_3027":52654},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3572":749,"_30844":723,"_21377":52656,"_5":14632,"_28040":52578,"_3027":52657},[],"The alerts API reference documents the full `http_client` schema.",{"_3572":750,"_30844":723,"_21377":52659,"_5":14632,"_28040":52586,"_3027":52660},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3572":751,"_30844":723,"_21377":52662,"_5":14632,"_28040":52590,"_3027":52663},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3572":752,"_30844":723,"_21377":52665,"_5":14632,"_28040":52594,"_3027":52666},[],"Add a filter if you don't want to receive every instance of the event.",{"_3572":753,"_30844":723,"_21377":52668,"_5":14632,"_28040":52594,"_3027":52669},[],"**None** notifies all instances of the event.",{"_3572":754,"_30844":723,"_21377":52671,"_5":14632,"_28040":52594,"_3027":52672},[],"**JSON Path** evaluates one or more specific fields.",{"_3572":755,"_30844":723,"_21377":52674,"_5":14632,"_28040":52594,"_3027":52675},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3572":756,"_30844":723,"_21377":52677,"_5":14632,"_28040":52594,"_3027":52678},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3572":757,"_30844":723,"_21377":52680,"_5":14632,"_28040":52594,"_3027":52681},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3572":758,"_30844":723,"_21377":52683,"_5":14632,"_28040":52594,"_3027":52684},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3572":759,"_30844":723,"_21377":52686,"_5":14632,"_28040":52598,"_3027":52687},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3572":760,"_30844":723,"_21377":52689,"_5":14632,"_28040":52602,"_3027":52690},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3572":761,"_30844":723,"_21377":52692,"_5":14632,"_28040":52602,"_3027":52693},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3572":762,"_30844":723,"_21377":52695,"_5":14632,"_28040":52602,"_3027":52696},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3572":763,"_30844":723,"_21377":52698,"_5":14632,"_28040":52602,"_3027":52699},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3572":764,"_30844":723,"_21377":52701,"_5":14632,"_28040":52602,"_3027":52702},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3572":765,"_30844":723,"_21377":52704,"_5":14632,"_28040":52602,"_3027":52705},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3572":766,"_30844":723,"_21377":52707,"_5":14632,"_28040":52602,"_3027":52708},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3572":767,"_30844":723,"_21377":52710,"_5":14632,"_28040":52602,"_3027":52711},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3572":768,"_30844":723,"_21377":52713,"_5":14632,"_28040":52606,"_3027":52714},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3572":769,"_30844":723,"_21377":52716,"_5":14632,"_28040":52606,"_3027":52717},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3572":770,"_30844":723,"_21377":52719,"_5":14632,"_28040":52606,"_3027":52720},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3572":771,"_30844":723,"_21377":52722,"_5":14632,"_28040":52606,"_3027":52723},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3572":772,"_30844":723,"_21377":52725,"_5":14632,"_28040":52606,"_3027":52726},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3572":773,"_30844":723,"_21377":52728,"_5":14632,"_28040":52606,"_3027":52729},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3572":774,"_30844":723,"_21377":52731,"_5":14632,"_28040":52606,"_3027":52732},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3572":775,"_30844":723,"_21377":52734,"_5":14632,"_28040":52606,"_3027":52735},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3572":776,"_30844":723,"_21377":52737,"_5":14632,"_28040":52610,"_3027":52738},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3572":777,"_30844":723,"_21377":52740,"_5":14632,"_28040":52610,"_3027":52741},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3572":778,"_30844":723,"_21377":52743,"_5":14632,"_28040":52614,"_3027":52744},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3572":779,"_30844":723,"_21377":52746,"_5":14632,"_28040":52614,"_3027":52747},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3572":780,"_30844":723,"_21377":52749,"_5":14632,"_28040":52614,"_3027":52750},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3572":781,"_30844":723,"_21377":52752,"_5":14632,"_28040":52614,"_3027":52753},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3572":782,"_30844":723,"_21377":52755,"_5":14632,"_28040":52614,"_3027":52756},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3572":783,"_30844":723,"_21377":52758,"_5":14632,"_28040":52614,"_3027":52759},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3572":784,"_30844":723,"_21377":52761,"_5":14632,"_28040":52614,"_3027":52762},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3572":785,"_30844":723,"_21377":52764,"_5":14632,"_28040":52614,"_3027":52765},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3572":786,"_30844":723,"_21377":52767,"_5":14632,"_28040":52614,"_3027":52768},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3572":787,"_30844":723,"_21377":52770,"_5":14632,"_28040":52614,"_3027":52771},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3572":788,"_30844":788,"_5":14996,"_3027":52773,"_31202":52774,"_21377":52775,"_28040":788},"Audit logs",[50349,51888,51889],[],{"_3572":789,"_30844":788,"_21377":52777,"_5":14632,"_28040":788,"_3027":52778},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3572":790,"_30844":788,"_5":31199,"_21377":52780,"_28040":52781,"_3027":52782},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3572":791,"_30844":788,"_5":31199,"_21377":52784,"_28040":52785,"_3027":52786},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#coverage","Coverage",{"_3572":792,"_30844":788,"_5":31199,"_21377":52788,"_28040":52789,"_3027":52790},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3572":793,"_30844":788,"_5":31199,"_21377":52792,"_28040":52793,"_3027":52794},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3572":794,"_30844":788,"_5":31199,"_21377":52796,"_28040":52797,"_3027":52798},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3572":795,"_30844":788,"_5":31199,"_21377":52800,"_28040":52801,"_3027":52802},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3572":796,"_30844":788,"_5":31199,"_21377":52804,"_28040":52805,"_3027":52806},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3572":797,"_30844":788,"_5":31199,"_21377":52808,"_28040":52809,"_3027":52810},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3572":798,"_30844":788,"_5":31199,"_21377":52812,"_28040":52813,"_3027":52814},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3572":799,"_30844":788,"_5":31199,"_21377":52816,"_28040":52817,"_3027":52818},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3572":800,"_30844":788,"_5":31199,"_21377":52820,"_28040":52821,"_3027":52822},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3572":801,"_30844":788,"_21377":52824,"_5":14632,"_28040":788,"_3027":52825},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3572":802,"_30844":788,"_21377":52827,"_5":14632,"_28040":52781,"_3027":52828},[],"The audit body includes:",{"_3572":803,"_30844":788,"_21377":52830,"_5":14632,"_28040":52781,"_3027":52831},[],"input: data received by the operation;",{"_3572":804,"_30844":788,"_21377":52833,"_5":14632,"_28040":52781,"_3027":52834},[],"has\\_error: whether the service returned an error;",{"_3572":805,"_30844":788,"_21377":52836,"_5":14632,"_28040":52781,"_3027":52837},[],"output: produced result or error message;",{"_3572":806,"_30844":788,"_21377":52839,"_5":14632,"_28040":52781,"_3027":52840},[],"principals: identifiers of the principals that matched the request.",{"_3572":807,"_30844":788,"_21377":52842,"_5":14632,"_28040":52781,"_3027":52843},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3572":808,"_30844":788,"_21377":52845,"_5":14632,"_28040":52781,"_3027":52846},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3572":809,"_30844":788,"_21377":52848,"_5":14632,"_28040":52785,"_3027":52849},[],"The backend applies auditing to mutations of:",{"_3572":810,"_30844":788,"_21377":52851,"_5":14632,"_28040":52785,"_3027":52852},[],"authorities, certificates and issuance profiles;",{"_3572":811,"_30844":788,"_21377":52854,"_5":14632,"_28040":52785,"_3027":52855},[],"keys and KMS engines;",{"_3572":812,"_30844":788,"_21377":52857,"_5":14632,"_28040":52785,"_3027":52858},[],"devices and identities;",{"_3572":813,"_30844":788,"_21377":52860,"_5":14632,"_28040":52785,"_3027":52861},[],"DMSs and enrollment operations;",{"_3572":814,"_30844":788,"_21377":52863,"_5":14632,"_28040":52785,"_3027":52864},[],"validation functions and CRL;",{"_3572":815,"_30844":788,"_21377":52866,"_5":14632,"_28040":52785,"_3027":52867},[],"principals, policies and authorization grants.",{"_3572":816,"_30844":788,"_21377":52869,"_5":14632,"_28040":52785,"_3027":52870},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3572":817,"_30844":788,"_21377":52872,"_5":14632,"_28040":52789,"_3027":52873},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3572":818,"_30844":788,"_21377":52875,"_5":14632,"_28040":52789,"_3027":52876},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3572":819,"_30844":788,"_21377":52878,"_5":14632,"_28040":52789,"_3027":52879},[],"Design the consumer to:",{"_3572":820,"_30844":788,"_21377":52881,"_5":14632,"_28040":52789,"_3027":52882},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3572":821,"_30844":788,"_21377":52884,"_5":14632,"_28040":52789,"_3027":52885},[],"keep the complete CloudEvent unmodified;",{"_3572":822,"_30844":788,"_21377":52887,"_5":14632,"_28040":52789,"_3027":52888},[],"record the ingestion time and detect duplicates by ID;",{"_3572":823,"_30844":788,"_21377":52890,"_5":14632,"_28040":52789,"_3027":52891},[],"encrypt in transit and at rest;",{"_3572":824,"_30844":788,"_21377":52893,"_5":14632,"_28040":52789,"_3027":52894},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3572":825,"_30844":788,"_21377":52896,"_5":14632,"_28040":52789,"_3027":52897},[],"apply an explicit retention and legal hold policy;",{"_3572":826,"_30844":788,"_21377":52899,"_5":14632,"_28040":52789,"_3027":52900},[],"alert if it stops consuming or the pending queue grows.",{"_3572":827,"_30844":788,"_21377":52902,"_5":14632,"_28040":52793,"_3027":52903},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3572":828,"_30844":788,"_21377":52905,"_5":14632,"_28040":52793,"_3027":52906},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3572":829,"_30844":788,"_21377":52908,"_5":14632,"_28040":52801,"_3027":52909},[],"Start from the reported time and normalize every source to UTC.",{"_3572":830,"_30844":788,"_21377":52911,"_5":14632,"_28040":52805,"_3027":52912},[],"Filter by event type, service source and resource identifier.",{"_3572":831,"_30844":788,"_21377":52914,"_5":14632,"_28040":52809,"_3027":52915},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3572":832,"_30844":788,"_21377":52917,"_5":14632,"_28040":52813,"_3027":52918},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3572":833,"_30844":788,"_21377":52920,"_5":14632,"_28040":52817,"_3027":52921},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3572":834,"_30844":788,"_21377":52923,"_5":14632,"_28040":52821,"_3027":52924},[],"Generate a controlled mutation in a test environment and check that:",{"_3572":835,"_30844":788,"_21377":52926,"_5":14632,"_28040":52821,"_3027":52927},[],"a successful audit event appears;",{"_3572":836,"_30844":788,"_21377":52929,"_5":14632,"_28040":52821,"_3027":52930},[],"the principal matches the identity used;",{"_3572":837,"_30844":788,"_21377":52932,"_5":14632,"_28040":52821,"_3027":52933},[],"the consumer persists it exactly once;",{"_3572":838,"_30844":788,"_21377":52935,"_5":14632,"_28040":52821,"_3027":52936},[],"it can be retrieved by resource, actor and period;",{"_3572":839,"_30844":788,"_21377":52938,"_5":14632,"_28040":52821,"_3027":52939},[],"a consumer outage raises an alert.",{"_3572":840,"_30844":788,"_21377":52941,"_5":14632,"_28040":52821,"_3027":52942},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3572":841,"_30844":841,"_5":14996,"_3027":52944,"_31202":52945,"_21377":52946,"_28040":841},"Platform architecture",[50349,51888],[],{"_3572":842,"_30844":841,"_21377":52948,"_5":14632,"_28040":841,"_3027":52949},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3572":843,"_30844":841,"_5":31199,"_21377":52951,"_28040":52952,"_3027":52953},[],"/docs/pr-preview/pr-68/platform/concepts/architecture#control-plane","Control plane",{"_3572":844,"_30844":841,"_5":31199,"_21377":52955,"_28040":52956,"_3027":52957},[],"/docs/pr-preview/pr-68/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3572":845,"_30844":841,"_5":31199,"_21377":52959,"_28040":52960,"_3027":52961},[],"/docs/pr-preview/pr-68/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3572":846,"_30844":841,"_5":31199,"_21377":52963,"_28040":52964,"_3027":52965},[],"/docs/pr-preview/pr-68/platform/concepts/architecture#status-and-validation","Status and validation",{"_3572":847,"_30844":841,"_5":31199,"_21377":52967,"_28040":52968,"_3027":52969},[],"/docs/pr-preview/pr-68/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3572":848,"_30844":841,"_21377":52971,"_5":14632,"_28040":841,"_3027":52972},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3572":849,"_30844":841,"_21377":52974,"_5":14632,"_28040":841,"_3027":52975},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3572":850,"_30844":841,"_21377":52977,"_5":14632,"_28040":52952,"_3027":52978},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3572":851,"_30844":841,"_21377":52980,"_5":14632,"_28040":52956,"_3027":52981},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3572":852,"_30844":841,"_21377":52983,"_5":14632,"_28040":52960,"_3027":52984},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3572":853,"_30844":841,"_21377":52986,"_5":14632,"_28040":52964,"_3027":52987},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3572":854,"_30844":841,"_21377":52989,"_5":14632,"_28040":52968,"_3027":52990},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3572":855,"_30844":855,"_5":14996,"_3027":52992,"_31202":52993,"_21377":52994,"_28040":855},"How Lamassu works",[50349,51888],[],{"_3572":856,"_30844":855,"_21377":52996,"_5":14632,"_28040":855,"_3027":52997},[],"The mental model of trust, keys, certificates and devices.",{"_3572":857,"_30844":855,"_5":31199,"_21377":52999,"_28040":53000,"_3027":53001},[],"/docs/pr-preview/pr-68/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3572":858,"_30844":855,"_5":31199,"_21377":53003,"_28040":53004,"_3027":53005},[],"/docs/pr-preview/pr-68/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3572":859,"_30844":855,"_21377":53007,"_5":14632,"_28040":855,"_3027":53008},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3572":860,"_30844":855,"_21377":53010,"_5":14632,"_28040":53000,"_3027":53011},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3572":861,"_30844":855,"_21377":53013,"_5":14632,"_28040":53000,"_3027":53014},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3572":862,"_30844":855,"_21377":53016,"_5":14632,"_28040":53000,"_3027":53017},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3572":863,"_30844":855,"_21377":53019,"_5":14632,"_28040":53000,"_3027":53020},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3572":864,"_30844":855,"_21377":53022,"_5":14632,"_28040":53000,"_3027":53023},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3572":865,"_30844":855,"_21377":53025,"_5":14632,"_28040":53004,"_3027":53026},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3572":866,"_30844":855,"_21377":53028,"_5":14632,"_28040":53004,"_3027":53029},[],"A DMS relates that CA to an enrollment policy.",{"_3572":867,"_30844":855,"_21377":53031,"_5":14632,"_28040":53004,"_3027":53032},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3572":868,"_30844":855,"_21377":53034,"_5":14632,"_28040":53004,"_3027":53035},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3572":869,"_30844":855,"_21377":53037,"_5":14632,"_28040":53004,"_3027":53038},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3572":870,"_30844":855,"_21377":53040,"_5":14632,"_28040":53004,"_3027":53041},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3572":871,"_30844":855,"_21377":53043,"_5":14632,"_28040":53004,"_3027":53044},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3572":872,"_30844":872,"_5":14996,"_3027":53046,"_31202":53047,"_21377":53049,"_28040":872},"Devices and identities",[50349,51888,53048,53046],"IoT Fleets",[],{"_3572":873,"_30844":872,"_21377":53051,"_5":14632,"_28040":872,"_3027":53052},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3572":874,"_30844":872,"_5":31199,"_21377":53054,"_28040":53055,"_3027":53056},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#device-states","Device states",{"_3572":875,"_30844":872,"_5":31199,"_21377":53058,"_28040":53059,"_3027":53060},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3572":876,"_30844":872,"_5":31199,"_21377":53062,"_28040":53063,"_3027":53064},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3572":877,"_30844":872,"_5":31199,"_21377":53066,"_28040":53067,"_3027":53068},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3572":878,"_30844":872,"_5":31199,"_21377":53070,"_28040":53071,"_3027":53072},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3572":879,"_30844":872,"_5":31199,"_21377":53074,"_28040":53075,"_3027":53076},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3572":880,"_30844":872,"_5":31199,"_21377":53078,"_28040":53079,"_3027":53080},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3572":881,"_30844":872,"_5":31199,"_21377":53082,"_28040":53083,"_3027":53084},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3572":882,"_30844":872,"_5":31199,"_21377":53086,"_28040":53087,"_3027":53088},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3572":883,"_30844":872,"_5":31199,"_21377":53090,"_28040":53091,"_3027":53092},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3572":884,"_30844":872,"_5":31199,"_21377":53094,"_28040":53095,"_3027":53096},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3572":885,"_30844":872,"_21377":53098,"_5":14632,"_28040":872,"_3027":53099},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3572":886,"_30844":872,"_21377":53101,"_5":14632,"_28040":872,"_3027":53102},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3572":887,"_30844":872,"_21377":53104,"_5":14632,"_28040":53055,"_3027":53105},[],"Operational view",{"_3572":888,"_30844":872,"_21377":53107,"_5":14632,"_28040":53055,"_3027":53108},[],"Meaning",{"_3572":889,"_30844":872,"_21377":53110,"_5":14632,"_28040":53055,"_3027":53111},[],"**No Identity**",{"_3572":890,"_30844":872,"_21377":53113,"_5":14632,"_28040":53055,"_3027":53114},[],"A record exists without an associated identity.",{"_3572":891,"_30844":872,"_21377":53116,"_5":14632,"_28040":53055,"_3027":53117},[],"**Active**",{"_3572":892,"_30844":872,"_21377":53119,"_5":14632,"_28040":53055,"_3027":53120},[],"The slot is active; also check certificate dates, status and usages.",{"_3572":893,"_30844":872,"_21377":53122,"_5":14632,"_28040":53055,"_3027":53123},[],"**Renewal Pending**",{"_3572":894,"_30844":872,"_21377":53125,"_5":14632,"_28040":53055,"_3027":53126},[],"The identity is in the operational renewal window.",{"_3572":895,"_30844":872,"_21377":53128,"_5":14632,"_28040":53055,"_3027":53129},[],"**Expiring Soon**",{"_3572":896,"_30844":872,"_21377":53131,"_5":14632,"_28040":53055,"_3027":53132},[],"Expiration is approaching according to configured thresholds.",{"_3572":897,"_30844":872,"_21377":53134,"_5":14632,"_28040":53055,"_3027":53135},[],"**Expired**",{"_3572":898,"_30844":872,"_21377":53137,"_5":14632,"_28040":53055,"_3027":53138},[],"The identity has expired.",{"_3572":899,"_30844":872,"_21377":53140,"_5":14632,"_28040":53055,"_3027":53141},[],"**Revoked**",{"_3572":900,"_30844":872,"_21377":53143,"_5":14632,"_28040":53055,"_3027":53144},[],"The identity is marked revoked.",{"_3572":901,"_30844":872,"_21377":53146,"_5":14632,"_28040":53055,"_3027":53147},[],"**Decommissioned**",{"_3572":902,"_30844":872,"_21377":53149,"_5":14632,"_28040":53055,"_3027":53150},[],"The record is retired and ordinary updates do not restore operation.",{"_3572":903,"_30844":872,"_21377":53152,"_5":14632,"_28040":53055,"_3027":53153},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3572":904,"_30844":872,"_21377":53155,"_5":14632,"_28040":53059,"_3027":53156},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3572":905,"_30844":872,"_21377":53158,"_5":14632,"_28040":53059,"_3027":53159},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3572":906,"_30844":872,"_21377":53161,"_5":14632,"_28040":53059,"_3027":53162},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3572":907,"_30844":872,"_21377":53164,"_5":14632,"_28040":53059,"_3027":53165},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3572":908,"_30844":872,"_21377":53167,"_5":14632,"_28040":53063,"_3027":53168},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3572":909,"_30844":872,"_21377":53170,"_5":14632,"_28040":53067,"_3027":53171},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3572":910,"_30844":872,"_21377":53173,"_5":14632,"_28040":53071,"_3027":53174},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3572":911,"_30844":872,"_21377":53176,"_5":14632,"_28040":53075,"_3027":53177},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3572":912,"_30844":872,"_21377":53179,"_5":14632,"_28040":53079,"_3027":53180},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3572":913,"_30844":872,"_21377":53182,"_5":14632,"_28040":53079,"_3027":53183},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3572":914,"_30844":872,"_21377":53185,"_5":14632,"_28040":53083,"_3027":53186},[],"From **No Identity**, use **Assign Identity**:",{"_3572":915,"_30844":872,"_21377":53188,"_5":14632,"_28040":53083,"_3027":53189},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3572":916,"_30844":872,"_21377":53191,"_5":14632,"_28040":53083,"_3027":53192},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3572":917,"_30844":872,"_21377":53194,"_5":14632,"_28040":53083,"_3027":53195},[],"Confirm and read the serial, active version and history again.",{"_3572":918,"_30844":872,"_21377":53197,"_5":14632,"_28040":53083,"_3027":53198},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3572":919,"_30844":872,"_21377":53200,"_5":14632,"_28040":53083,"_3027":53201},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3572":920,"_30844":872,"_21377":53203,"_5":14632,"_28040":53087,"_3027":53204},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3572":921,"_30844":872,"_21377":53206,"_5":14632,"_28040":53087,"_3027":53207},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3572":922,"_30844":872,"_21377":53209,"_5":14632,"_28040":53091,"_3027":53210},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3572":923,"_30844":872,"_21377":53212,"_5":14632,"_28040":53091,"_3027":53213},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3572":924,"_30844":872,"_21377":53215,"_5":14632,"_28040":53091,"_3027":53216},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3572":925,"_30844":872,"_21377":53218,"_5":14632,"_28040":53091,"_3027":53219},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3572":926,"_30844":872,"_21377":53221,"_5":14632,"_28040":53095,"_3027":53222},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3572":927,"_30844":872,"_21377":53224,"_5":14632,"_28040":53095,"_3027":53225},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3572":928,"_30844":928,"_5":14996,"_3027":53227,"_31202":53228,"_21377":53230,"_28040":928},"Bootstrap identity and authentication",[50349,51888,53048,53046,53229],"Enrollment with PKI",[],{"_3572":929,"_30844":928,"_21377":53232,"_5":14632,"_28040":928,"_3027":53233},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3572":930,"_30844":928,"_5":31199,"_21377":53235,"_28040":53236,"_3027":53237},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3572":931,"_30844":928,"_5":31199,"_21377":53239,"_28040":53240,"_3027":53241},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3572":932,"_30844":928,"_5":31199,"_21377":53243,"_28040":53244,"_3027":53245},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3572":933,"_30844":928,"_5":31199,"_21377":53247,"_28040":53248,"_3027":53249},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3572":934,"_30844":928,"_5":31199,"_21377":53251,"_28040":53252,"_3027":53253},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3572":935,"_30844":928,"_21377":53255,"_5":14632,"_28040":928,"_3027":53256},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3572":936,"_30844":928,"_21377":53258,"_5":14632,"_28040":53236,"_3027":53259},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3572":937,"_30844":928,"_21377":53261,"_5":14632,"_28040":53236,"_3027":53262},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3572":938,"_30844":928,"_21377":53264,"_5":14632,"_28040":53240,"_3027":53265},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3572":939,"_30844":928,"_21377":53267,"_5":14632,"_28040":53240,"_3027":53268},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3572":940,"_30844":928,"_21377":53270,"_5":14632,"_28040":53240,"_3027":53271},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3572":941,"_30844":928,"_21377":53273,"_5":14632,"_28040":53244,"_3027":53274},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3572":942,"_30844":928,"_21377":53276,"_5":14632,"_28040":53244,"_3027":53277},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3572":943,"_30844":928,"_21377":53279,"_5":14632,"_28040":53248,"_3027":53280},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3572":944,"_30844":928,"_21377":53282,"_5":14632,"_28040":53248,"_3027":53283},[],"Example body:",{"_3572":945,"_30844":928,"_21377":53285,"_5":14632,"_28040":53248,"_3027":53286},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3572":946,"_30844":928,"_21377":53288,"_5":14632,"_28040":53248,"_3027":53289},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3572":947,"_30844":928,"_21377":53291,"_5":14632,"_28040":53248,"_3027":53292},[],"Continuation requires a successful HTTP response and JSON:",{"_3572":948,"_30844":928,"_21377":53294,"_5":14632,"_28040":53248,"_3027":53295},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3572":949,"_30844":928,"_21377":53297,"_5":14632,"_28040":53252,"_3027":53298},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3572":950,"_30844":928,"_21377":53300,"_5":14632,"_28040":53252,"_3027":53301},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3572":951,"_30844":951,"_5":14996,"_3027":53303,"_31202":53304,"_21377":53305,"_28040":951},"Configure and operate the DMS",[50349,51888,53048,53046,53229],[],{"_3572":952,"_30844":951,"_21377":53307,"_5":14632,"_28040":951,"_3027":53308},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3572":953,"_30844":951,"_5":31199,"_21377":53310,"_28040":53311,"_3027":50359},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3572":954,"_30844":951,"_5":31199,"_21377":53313,"_28040":53314,"_3027":53315},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3572":955,"_30844":951,"_5":31199,"_21377":53317,"_28040":53318,"_3027":53319},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3572":956,"_30844":951,"_5":31199,"_21377":53321,"_28040":53322,"_3027":53323},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3572":957,"_30844":951,"_5":31199,"_21377":53325,"_28040":53326,"_3027":53327},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3572":958,"_30844":951,"_5":31199,"_21377":53329,"_28040":53330,"_3027":53331},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3572":959,"_30844":951,"_5":31199,"_21377":53333,"_28040":53334,"_3027":53335},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3572":960,"_30844":951,"_5":31199,"_21377":53337,"_28040":53338,"_3027":53339},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3572":961,"_30844":951,"_5":31199,"_21377":53341,"_28040":53342,"_3027":53343},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3572":962,"_30844":951,"_5":31199,"_21377":53345,"_28040":53346,"_3027":53347},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3572":963,"_30844":951,"_5":31199,"_21377":53349,"_28040":53350,"_3027":53351},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3572":964,"_30844":951,"_5":31199,"_21377":53353,"_28040":53354,"_3027":53355},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3572":965,"_30844":951,"_5":31199,"_21377":53357,"_28040":53358,"_3027":53359},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3572":966,"_30844":951,"_5":31199,"_21377":53361,"_28040":53362,"_3027":53363},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3572":967,"_30844":951,"_5":31199,"_21377":53365,"_28040":53366,"_3027":53367},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3572":968,"_30844":951,"_5":31199,"_21377":53369,"_28040":53370,"_3027":53371},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3572":969,"_30844":951,"_5":31199,"_21377":53373,"_28040":53374,"_3027":53375},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3572":970,"_30844":951,"_5":31199,"_21377":53377,"_28040":53378,"_3027":53379},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3572":971,"_30844":951,"_21377":53381,"_5":14632,"_28040":951,"_3027":53382},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3572":972,"_30844":951,"_21377":53384,"_5":14632,"_28040":53311,"_3027":53385},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3572":973,"_30844":951,"_21377":53387,"_5":14632,"_28040":53311,"_3027":53388},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3572":974,"_30844":951,"_21377":53390,"_5":14632,"_28040":53318,"_3027":53391},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3572":975,"_30844":951,"_21377":53393,"_5":14632,"_28040":53322,"_3027":53394},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3572":976,"_30844":951,"_21377":53396,"_5":14632,"_28040":53326,"_3027":53397},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3572":977,"_30844":951,"_21377":53399,"_5":14632,"_28040":53330,"_3027":53400},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3572":978,"_30844":951,"_21377":53402,"_5":14632,"_28040":53334,"_3027":53403},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3572":979,"_30844":951,"_21377":53405,"_5":14632,"_28040":53342,"_3027":53406},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3572":980,"_30844":951,"_21377":53408,"_5":14632,"_28040":53342,"_3027":53409},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3572":981,"_30844":951,"_21377":53411,"_5":14632,"_28040":53346,"_3027":53412},[],"`settings.enrollment_settings` field",{"_3572":982,"_30844":951,"_21377":53414,"_5":14632,"_28040":53346,"_3027":53415},[],"Decision",{"_3572":983,"_30844":951,"_21377":53417,"_5":14632,"_28040":53346,"_3027":53418},[],"`protocol`",{"_3572":984,"_30844":951,"_21377":53420,"_5":14632,"_28040":53346,"_3027":53421},[],"`EST_RFC7030` for these operations.",{"_3572":985,"_30844":951,"_21377":53423,"_5":14632,"_28040":53346,"_3027":53424},[],"`enrollment_ca`",{"_3572":986,"_30844":951,"_21377":53426,"_5":14632,"_28040":53346,"_3027":53427},[],"ID of the signing CA.",{"_3572":987,"_30844":951,"_21377":53429,"_5":14632,"_28040":53346,"_3027":53430},[],"`verify_csr_signature`",{"_3572":988,"_30844":951,"_21377":53432,"_5":14632,"_28040":53346,"_3027":53433},[],"Keep `true` to verify CSR key possession.",{"_3572":989,"_30844":951,"_21377":53435,"_5":14632,"_28040":53346,"_3027":53436},[],"`enable_replaceable_enrollment`",{"_3572":990,"_30844":951,"_21377":53438,"_5":14632,"_28040":53346,"_3027":53439},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3572":991,"_30844":951,"_21377":53441,"_5":14632,"_28040":53346,"_3027":53442},[],"`est_rfc7030_settings.auth_mode`",{"_3572":992,"_30844":951,"_21377":53444,"_5":14632,"_28040":53346,"_3027":53445},[],"One of the four authentication modes.",{"_3572":993,"_30844":951,"_21377":53447,"_5":14632,"_28040":53346,"_3027":53448},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3572":994,"_30844":951,"_21377":53450,"_5":14632,"_28040":53350,"_3027":53451},[],"The blocks are independent:",{"_3572":995,"_30844":951,"_21377":53453,"_5":14632,"_28040":53350,"_3027":53454},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3572":996,"_30844":951,"_21377":53456,"_5":14632,"_28040":53350,"_3027":53457},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3572":997,"_30844":951,"_21377":53459,"_5":14632,"_28040":53350,"_3027":53460},[],"`auth_mode`",{"_3572":998,"_30844":951,"_21377":53462,"_5":14632,"_28040":53350,"_3027":53463},[],"Control applied in the configured operation",{"_3572":999,"_30844":951,"_21377":53465,"_5":14632,"_28040":53350,"_3027":53466},[],"`CLIENT_CERTIFICATE`",{"_3572":1000,"_30844":951,"_21377":53468,"_5":14632,"_28040":53350,"_3027":53469},[],"Presented certificate validation.",{"_3572":1001,"_30844":951,"_21377":53471,"_5":14632,"_28040":53350,"_3027":53472},[],"`EXTERNAL_WEBHOOK`",{"_3572":1002,"_30844":951,"_21377":53474,"_5":14632,"_28040":53350,"_3027":53475},[],"Configured webhook authorization.",{"_3572":1003,"_30844":951,"_21377":53477,"_5":14632,"_28040":53350,"_3027":53478},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3572":1004,"_30844":951,"_21377":53480,"_5":14632,"_28040":53350,"_3027":53481},[],"Certificate validation followed by webhook approval.",{"_3572":1005,"_30844":951,"_21377":53483,"_5":14632,"_28040":53350,"_3027":53484},[],"`NO_AUTH`",{"_3572":1006,"_30844":951,"_21377":53486,"_5":14632,"_28040":53350,"_3027":53487},[],"No DMS requester authentication.",{"_3572":1007,"_30844":951,"_21377":53489,"_5":14632,"_28040":53350,"_3027":53490},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3572":1008,"_30844":951,"_21377":53492,"_5":14632,"_28040":53350,"_3027":53493},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3572":1009,"_30844":951,"_21377":53495,"_5":14632,"_28040":53350,"_3027":53496},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3572":1010,"_30844":951,"_21377":53498,"_5":14632,"_28040":53350,"_3027":53499},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3572":1011,"_30844":951,"_21377":53501,"_5":14632,"_28040":53354,"_3027":53502},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3572":1012,"_30844":951,"_21377":53504,"_5":14632,"_28040":53354,"_3027":53505},[],"`external_webhook_settings` field",{"_3572":1013,"_30844":951,"_21377":53507,"_5":14632,"_28040":53354,"_3027":53415},[],{"_3572":1014,"_30844":951,"_21377":53509,"_5":14632,"_28040":53354,"_3027":53510},[],"`url`",{"_3572":1015,"_30844":951,"_21377":53512,"_5":14632,"_28040":53354,"_3027":53513},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3572":1016,"_30844":951,"_21377":53515,"_5":14632,"_28040":53354,"_3027":53516},[],"`method`",{"_3572":1017,"_30844":951,"_21377":53518,"_5":14632,"_28040":53354,"_3027":53519},[],"`POST` or `PUT`; `POST` by default.",{"_3572":1018,"_30844":951,"_21377":53521,"_5":14632,"_28040":53354,"_3027":53522},[],"`name`",{"_3572":1019,"_30844":951,"_21377":53524,"_5":14632,"_28040":53354,"_3027":53525},[],"Label used in service logs.",{"_3572":1020,"_30844":951,"_21377":53527,"_5":14632,"_28040":53354,"_3027":53528},[],"`config.auth_mode`",{"_3572":1021,"_30844":951,"_21377":53530,"_5":14632,"_28040":53354,"_3027":53531},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3572":1022,"_30844":951,"_21377":53533,"_5":14632,"_28040":53354,"_3027":53534},[],"`config.log_level`",{"_3572":1023,"_30844":951,"_21377":53536,"_5":14632,"_28040":53354,"_3027":53537},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3572":1024,"_30844":951,"_21377":53539,"_5":14632,"_28040":53354,"_3027":53540},[],"`config.apikey_options`",{"_3572":1025,"_30844":951,"_21377":53542,"_5":14632,"_28040":53354,"_3027":53543},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3572":1026,"_30844":951,"_21377":53545,"_5":14632,"_28040":53354,"_3027":53546},[],"`config.jwt_options`",{"_3572":1027,"_30844":951,"_21377":53548,"_5":14632,"_28040":53354,"_3027":53549},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3572":1028,"_30844":951,"_21377":53551,"_5":14632,"_28040":53354,"_3027":53552},[],"`config.mtls_options`",{"_3572":1029,"_30844":951,"_21377":53554,"_5":14632,"_28040":53354,"_3027":53555},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3572":1030,"_30844":951,"_21377":53557,"_5":14632,"_28040":53354,"_3027":53558},[],"`config.insecure_skip_verify`",{"_3572":1031,"_30844":951,"_21377":53560,"_5":14632,"_28040":53354,"_3027":53561},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3572":1032,"_30844":951,"_21377":53563,"_5":14632,"_28040":53354,"_3027":53564},[],"`config.call_timeout`",{"_3572":1033,"_30844":951,"_21377":53566,"_5":14632,"_28040":53354,"_3027":53567},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3572":1034,"_30844":951,"_21377":53569,"_5":14632,"_28040":53354,"_3027":53570},[],"Rules for that configuration:",{"_3572":1035,"_30844":951,"_21377":53572,"_5":14632,"_28040":53354,"_3027":53573},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3572":1036,"_30844":951,"_21377":53575,"_5":14632,"_28040":53354,"_3027":53576},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3572":1037,"_30844":951,"_21377":53578,"_5":14632,"_28040":53354,"_3027":53579},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3572":1038,"_30844":951,"_21377":53581,"_5":14632,"_28040":53354,"_3027":53582},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3572":1039,"_30844":951,"_21377":53584,"_5":14632,"_28040":53354,"_3027":53585},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3572":1040,"_30844":951,"_21377":53587,"_5":14632,"_28040":53354,"_3027":53588},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3572":1041,"_30844":951,"_21377":53590,"_5":14632,"_28040":53354,"_3027":53591},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3572":1042,"_30844":951,"_21377":53593,"_5":14632,"_28040":53354,"_3027":53594},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3572":1043,"_30844":951,"_21377":53596,"_5":14632,"_28040":53354,"_3027":53597},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3572":1044,"_30844":951,"_21377":53599,"_5":14632,"_28040":53358,"_3027":53600},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3572":1045,"_30844":951,"_21377":53602,"_5":14632,"_28040":53362,"_3027":53603},[],"`settings.reenrollment_settings` field",{"_3572":1046,"_30844":951,"_21377":53605,"_5":14632,"_28040":53362,"_3027":50739},[],{"_3572":1047,"_30844":951,"_21377":53607,"_5":14632,"_28040":53362,"_3027":53608},[],"`reenrollment_delta`",{"_3572":1048,"_30844":951,"_21377":53610,"_5":14632,"_28040":53362,"_3027":53611},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3572":1049,"_30844":951,"_21377":53613,"_5":14632,"_28040":53362,"_3027":53614},[],"`preventive_delta`",{"_3572":1050,"_30844":951,"_21377":53616,"_5":14632,"_28040":53362,"_3027":53617},[],"Preventive operational monitoring threshold.",{"_3572":1051,"_30844":951,"_21377":53619,"_5":14632,"_28040":53362,"_3027":53620},[],"`critical_delta`",{"_3572":1052,"_30844":951,"_21377":53622,"_5":14632,"_28040":53362,"_3027":53623},[],"Critical operational monitoring threshold.",{"_3572":1053,"_30844":951,"_21377":53625,"_5":14632,"_28040":53362,"_3027":53626},[],"`enable_expired_renewal`",{"_3572":1054,"_30844":951,"_21377":53628,"_5":14632,"_28040":53362,"_3027":53629},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3572":1055,"_30844":951,"_21377":53631,"_5":14632,"_28040":53362,"_3027":53632},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3572":1056,"_30844":951,"_21377":53634,"_5":14632,"_28040":53362,"_3027":53635},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3572":1057,"_30844":951,"_21377":53637,"_5":14632,"_28040":53362,"_3027":53638},[],"`revoke_on_reenrollment`",{"_3572":1058,"_30844":951,"_21377":53640,"_5":14632,"_28040":53362,"_3027":53641},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3572":1059,"_30844":951,"_21377":53643,"_5":14632,"_28040":53362,"_3027":53644},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3572":1060,"_30844":951,"_21377":53646,"_5":14632,"_28040":53366,"_3027":53647},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3572":1061,"_30844":951,"_21377":53649,"_5":14632,"_28040":53370,"_3027":50733},[],{"_3572":1062,"_30844":951,"_21377":53651,"_5":14632,"_28040":53370,"_3027":53652},[],"Published material",{"_3572":1063,"_30844":951,"_21377":53654,"_5":14632,"_28040":53370,"_3027":53655},[],"**Include Lamassu System CA**",{"_3572":1064,"_30844":951,"_21377":53657,"_5":14632,"_28040":53370,"_3027":53658},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3572":1065,"_30844":951,"_21377":53660,"_5":14632,"_28040":53370,"_3027":53661},[],"**Include Enrollment CA**",{"_3572":1066,"_30844":951,"_21377":53663,"_5":14632,"_28040":53370,"_3027":53664},[],"Selected issuing CA certificate.",{"_3572":1067,"_30844":951,"_21377":53666,"_5":14632,"_28040":53370,"_3027":53667},[],"**Managed CAs**",{"_3572":1068,"_30844":951,"_21377":53669,"_5":14632,"_28040":53370,"_3027":53670},[],"Explicitly selected CA certificates.",{"_3572":1069,"_30844":951,"_21377":53672,"_5":14632,"_28040":53370,"_3027":53673},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3572":1070,"_30844":951,"_21377":53675,"_5":14632,"_28040":53374,"_3027":53676},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3572":1071,"_30844":951,"_21377":53678,"_5":14632,"_28040":53374,"_3027":53679},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3572":1072,"_30844":951,"_21377":53681,"_5":14632,"_28040":53374,"_3027":53682},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3572":1073,"_30844":951,"_21377":53684,"_5":14632,"_28040":53378,"_3027":53685},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3572":1074,"_30844":1074,"_5":14996,"_3027":53687,"_31202":53688,"_21377":53689,"_28040":1074},"Integrate the EST client",[50349,51888,53048,53046,53229],[],{"_3572":1075,"_30844":1074,"_21377":53691,"_5":14632,"_28040":1074,"_3027":53692},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3572":1076,"_30844":1074,"_5":31199,"_21377":53694,"_28040":53695,"_3027":50359},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3572":1077,"_30844":1074,"_5":31199,"_21377":53697,"_28040":53698,"_3027":53699},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3572":1078,"_30844":1074,"_5":31199,"_21377":53701,"_28040":53702,"_3027":53703},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3572":1079,"_30844":1074,"_5":31199,"_21377":53705,"_28040":53706,"_3027":53707},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3572":1080,"_30844":1074,"_5":31199,"_21377":53709,"_28040":53710,"_3027":53711},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3572":1081,"_30844":1074,"_5":31199,"_21377":53713,"_28040":53714,"_3027":53715},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3572":1082,"_30844":1074,"_21377":53717,"_5":14632,"_28040":1074,"_3027":53718},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3572":1083,"_30844":1074,"_21377":53720,"_5":14632,"_28040":53695,"_3027":53721},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3572":1084,"_30844":1074,"_21377":53723,"_5":14632,"_28040":53695,"_3027":53724},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3572":1085,"_30844":1074,"_21377":53726,"_5":14632,"_28040":53695,"_3027":53727},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3572":1086,"_30844":1074,"_21377":53729,"_5":14632,"_28040":53698,"_3027":53730},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3572":1087,"_30844":1074,"_21377":53732,"_5":14632,"_28040":53698,"_3027":53733},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3572":1088,"_30844":1074,"_21377":53735,"_5":14632,"_28040":53702,"_3027":53736},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3572":1089,"_30844":1074,"_21377":53738,"_5":14632,"_28040":53702,"_3027":53739},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3572":1090,"_30844":1074,"_21377":53741,"_5":14632,"_28040":53706,"_3027":53742},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3572":1091,"_30844":1074,"_21377":53744,"_5":14632,"_28040":53706,"_3027":53745},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3572":1092,"_30844":1074,"_21377":53747,"_5":14632,"_28040":53710,"_3027":53748},[],"For a root that issues directly:",{"_3572":1093,"_30844":1074,"_21377":53750,"_5":14632,"_28040":53710,"_3027":53751},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3572":1094,"_30844":1074,"_21377":53753,"_5":14632,"_28040":53710,"_3027":53754},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3572":1095,"_30844":1074,"_21377":53756,"_5":14632,"_28040":53714,"_3027":53757},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3572":1096,"_30844":1096,"_5":14996,"_3027":53759,"_31202":53760,"_21377":53761,"_28040":1096},"EST reference",[50349,51888,53048,53046,53229],[],{"_3572":1097,"_30844":1096,"_21377":53763,"_5":14632,"_28040":1096,"_3027":53764},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3572":1098,"_30844":1096,"_5":31199,"_21377":53766,"_28040":53767,"_3027":53768},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3572":1099,"_30844":1096,"_5":31199,"_21377":53770,"_28040":53771,"_3027":23158},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3572":1100,"_30844":1096,"_5":31199,"_21377":53773,"_28040":53774,"_3027":26602},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3572":1101,"_30844":1096,"_5":31199,"_21377":53776,"_28040":53777,"_3027":26609},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3572":1102,"_30844":1096,"_5":31199,"_21377":53779,"_28040":53780,"_3027":25890},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3572":1103,"_30844":1096,"_5":31199,"_21377":53782,"_28040":53783,"_3027":53784},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3572":1104,"_30844":1096,"_5":31199,"_21377":53786,"_28040":53787,"_3027":53788},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3572":1105,"_30844":1096,"_5":31199,"_21377":53790,"_28040":53791,"_3027":53792},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3572":1106,"_30844":1096,"_21377":53794,"_5":14632,"_28040":1096,"_3027":53795},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3572":1107,"_30844":1096,"_21377":53797,"_5":14632,"_28040":53767,"_3027":53798},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3572":1108,"_30844":1096,"_21377":53800,"_5":14632,"_28040":53767,"_3027":53801},[],"Operation",{"_3572":1109,"_30844":1096,"_21377":53803,"_5":14632,"_28040":53767,"_3027":53804},[],"Method",{"_3572":1110,"_30844":1096,"_21377":53806,"_5":14632,"_28040":53767,"_3027":53807},[],"Authentication and condition",{"_3572":1111,"_30844":1096,"_21377":53809,"_5":14632,"_28040":53767,"_3027":53810},[],"`/cacerts`",{"_3572":1112,"_30844":1096,"_21377":53812,"_5":14632,"_28040":53767,"_3027":53813},[],"GET",{"_3572":1113,"_30844":1096,"_21377":53815,"_5":14632,"_28040":53767,"_3027":53816},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3572":1114,"_30844":1096,"_21377":53818,"_5":14632,"_28040":53767,"_3027":53819},[],"`/simpleenroll`",{"_3572":1115,"_30844":1096,"_21377":53821,"_5":14632,"_28040":53767,"_3027":53822},[],"POST",{"_3572":1116,"_30844":1096,"_21377":53824,"_5":14632,"_28040":53767,"_3027":53825},[],"Initial authentication and DMS registration/replacement policy.",{"_3572":1117,"_30844":1096,"_21377":53827,"_5":14632,"_28040":53767,"_3027":53828},[],"`/simplereenroll`",{"_3572":1118,"_30844":1096,"_21377":53830,"_5":14632,"_28040":53767,"_3027":53822},[],{"_3572":1119,"_30844":1096,"_21377":53832,"_5":14632,"_28040":53767,"_3027":53833},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3572":1120,"_30844":1096,"_21377":53835,"_5":14632,"_28040":53767,"_3027":53836},[],"`/serverkeygen`",{"_3572":1121,"_30844":1096,"_21377":53838,"_5":14632,"_28040":53767,"_3027":53822},[],{"_3572":1122,"_30844":1096,"_21377":53840,"_5":14632,"_28040":53767,"_3027":53841},[],"Initial authentication and admission; server generation enabled.",{"_3572":1123,"_30844":1096,"_21377":53843,"_5":14632,"_28040":53767,"_3027":53844},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3572":1124,"_30844":1096,"_21377":53846,"_5":14632,"_28040":53771,"_3027":53847},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3572":1125,"_30844":1096,"_21377":53849,"_5":14632,"_28040":53771,"_3027":53850},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3572":1126,"_30844":1096,"_21377":53852,"_5":14632,"_28040":53774,"_3027":53853},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3572":1127,"_30844":1096,"_21377":53855,"_5":14632,"_28040":53774,"_3027":53856},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3572":1128,"_30844":1096,"_21377":53858,"_5":14632,"_28040":53777,"_3027":53859},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3572":1129,"_30844":1096,"_21377":53861,"_5":14632,"_28040":53777,"_3027":53862},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3572":1130,"_30844":1096,"_21377":53864,"_5":14632,"_28040":53780,"_3027":53865},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3572":1131,"_30844":1096,"_21377":53867,"_5":14632,"_28040":53780,"_3027":53868},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3572":1132,"_30844":1096,"_21377":53870,"_5":14632,"_28040":53783,"_3027":53871},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3572":1133,"_30844":1096,"_21377":53873,"_5":14632,"_28040":53783,"_3027":53874},[],"Part",{"_3572":1134,"_30844":1096,"_21377":53876,"_5":14632,"_28040":53783,"_3027":53877},[],"Content after decoding its Base64",{"_3572":1135,"_30844":1096,"_21377":53879,"_5":14632,"_28040":53783,"_3027":53880},[],"`application/pkcs8`",{"_3572":1136,"_30844":1096,"_21377":53882,"_5":14632,"_28040":53783,"_3027":53883},[],"Unencrypted DER PKCS#8 private key.",{"_3572":1137,"_30844":1096,"_21377":53885,"_5":14632,"_28040":53783,"_3027":53886},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3572":1138,"_30844":1096,"_21377":53888,"_5":14632,"_28040":53783,"_3027":53889},[],"DER PKCS#7 containing the issued certificate.",{"_3572":1139,"_30844":1096,"_21377":53891,"_5":14632,"_28040":53783,"_3027":53892},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3572":1140,"_30844":1096,"_21377":53894,"_5":14632,"_28040":53787,"_3027":53895},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3572":1141,"_30844":1096,"_21377":53897,"_5":14632,"_28040":53787,"_3027":53898},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3572":1142,"_30844":1096,"_21377":53900,"_5":14632,"_28040":53787,"_3027":53901},[],"Convert and check the result:",{"_3572":1143,"_30844":1096,"_21377":53903,"_5":14632,"_28040":53787,"_3027":53904},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3572":1144,"_30844":1096,"_21377":53906,"_5":14632,"_28040":53791,"_3027":53907},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3572":1145,"_30844":1096,"_21377":53909,"_5":14632,"_28040":53791,"_3027":53910},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3572":1146,"_30844":1146,"_5":14996,"_3027":53229,"_31202":53912,"_21377":53913,"_28040":1146},[50349,51888,53048,53046,53229],[],{"_3572":1147,"_30844":1146,"_21377":53915,"_5":14632,"_28040":1146,"_3027":53916},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3572":1148,"_30844":1146,"_5":31199,"_21377":53918,"_28040":53919,"_3027":53920},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3572":1149,"_30844":1146,"_5":31199,"_21377":53922,"_28040":53923,"_3027":53924},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3572":1150,"_30844":1146,"_5":31199,"_21377":53926,"_28040":53927,"_3027":53928},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3572":1151,"_30844":1146,"_5":31199,"_21377":53930,"_28040":53931,"_3027":53932},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3572":1152,"_30844":1146,"_21377":53934,"_5":14632,"_28040":1146,"_3027":53935},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3572":1153,"_30844":1146,"_21377":53937,"_5":14632,"_28040":53919,"_3027":53938},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3572":1154,"_30844":1146,"_21377":53940,"_5":14632,"_28040":53919,"_3027":53941},[],"The integrator installs initial EST server trust and an admission credential.",{"_3572":1155,"_30844":1146,"_21377":53943,"_5":14632,"_28040":53919,"_3027":53944},[],"The client requests an identity for its `Device ID` through EST.",{"_3572":1156,"_30844":1146,"_21377":53946,"_5":14632,"_28040":53919,"_3027":53947},[],"Certificate, device binding and key/certificate installation are checked.",{"_3572":1157,"_30844":1146,"_21377":53949,"_5":14632,"_28040":53919,"_3027":53950},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3572":1158,"_30844":1146,"_21377":53952,"_5":14632,"_28040":53919,"_3027":53953},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3572":1159,"_30844":1146,"_21377":53955,"_5":14632,"_28040":53923,"_3027":53956},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3572":1160,"_30844":1146,"_21377":53958,"_5":14632,"_28040":53923,"_3027":53959},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3572":1161,"_30844":1146,"_21377":53961,"_5":14632,"_28040":53923,"_3027":53962},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3572":1162,"_30844":1146,"_21377":53964,"_5":14632,"_28040":53923,"_3027":53965},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3572":1163,"_30844":1146,"_21377":53967,"_5":14632,"_28040":53927,"_3027":53968},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3572":1164,"_30844":1146,"_21377":53970,"_5":14632,"_28040":53927,"_3027":53971},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3572":1165,"_30844":1146,"_21377":53973,"_5":14632,"_28040":53927,"_3027":53974},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3572":1166,"_30844":1146,"_21377":53976,"_5":14632,"_28040":53927,"_3027":53977},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3572":1167,"_30844":1146,"_21377":53979,"_5":14632,"_28040":53931,"_3027":53980},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3572":1168,"_30844":1146,"_21377":53982,"_5":14632,"_28040":53931,"_3027":53983},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3572":1169,"_30844":1169,"_5":14996,"_3027":53985,"_31202":53986,"_21377":53987,"_28040":1169},"Provisioning strategies",[50349,51888,53048,53046,53229],[],{"_3572":1170,"_30844":1169,"_21377":53989,"_5":14632,"_28040":1169,"_3027":53990},[],"Choose device registration, identity authorization and key generation.",{"_3572":1171,"_30844":1169,"_5":31199,"_21377":53992,"_28040":53993,"_3027":53994},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3572":1172,"_30844":1169,"_5":31199,"_21377":53996,"_28040":53997,"_3027":53998},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3572":1173,"_30844":1169,"_5":31199,"_21377":54000,"_28040":54001,"_3027":54002},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3572":1174,"_30844":1169,"_5":31199,"_21377":54004,"_28040":54005,"_3027":54006},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3572":1175,"_30844":1169,"_5":31199,"_21377":54008,"_28040":54009,"_3027":54010},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3572":1176,"_30844":1169,"_21377":54012,"_5":14632,"_28040":1169,"_3027":54013},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3572":1177,"_30844":1169,"_21377":54015,"_5":14632,"_28040":53993,"_3027":54016},[],"Path",{"_3572":1178,"_30844":1169,"_21377":54018,"_5":14632,"_28040":53993,"_3027":54019},[],"When the device exists",{"_3572":1179,"_30844":1169,"_21377":54021,"_5":14632,"_28040":53993,"_3027":54022},[],"What to check",{"_3572":1180,"_30844":1169,"_21377":54024,"_5":14632,"_28040":53993,"_3027":54025},[],"Manual assignment",{"_3572":1181,"_30844":1169,"_21377":54027,"_5":14632,"_28040":53993,"_3027":54028},[],"An operator creates it before associating a certificate.",{"_3572":1182,"_30844":1169,"_21377":54030,"_5":14632,"_28040":53993,"_3027":54031},[],"ID, owning DMS, certificate CN and bound serial.",{"_3572":1183,"_30844":1169,"_21377":54033,"_5":14632,"_28040":53993,"_3027":54034},[],"EST with `JITP`",{"_3572":1184,"_30844":1169,"_21377":54036,"_5":14632,"_28040":53993,"_3027":54037},[],"Created for an unknown CN during `/simpleenroll`.",{"_3572":1185,"_30844":1169,"_21377":54039,"_5":14632,"_28040":53993,"_3027":54040},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3572":1186,"_30844":1169,"_21377":54042,"_5":14632,"_28040":53993,"_3027":54043},[],"EST with `PRE_REGISTRATION`",{"_3572":1187,"_30844":1169,"_21377":54045,"_5":14632,"_28040":53993,"_3027":54046},[],"Must exist before `/simpleenroll`.",{"_3572":1188,"_30844":1169,"_21377":54048,"_5":14632,"_28040":53993,"_3027":54049},[],"Approved record, same DMS and replacement conditions for your version.",{"_3572":1189,"_30844":1169,"_21377":54051,"_5":14632,"_28040":53993,"_3027":54052},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3572":1190,"_30844":1169,"_21377":54054,"_5":14632,"_28040":53993,"_3027":54055},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3572":1191,"_30844":1169,"_21377":54057,"_5":14632,"_28040":53997,"_3027":54058},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3572":1192,"_30844":1169,"_21377":54060,"_5":14632,"_28040":53997,"_3027":54061},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3572":1193,"_30844":1169,"_21377":54063,"_5":14632,"_28040":53997,"_3027":54064},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3572":1194,"_30844":1169,"_21377":54066,"_5":14632,"_28040":54001,"_3027":54067},[],"Decide initial enrollment and re-enrollment separately:",{"_3572":1195,"_30844":1169,"_21377":54069,"_5":14632,"_28040":54001,"_3027":54070},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3572":1196,"_30844":1169,"_21377":54072,"_5":14632,"_28040":54001,"_3027":54073},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3572":1197,"_30844":1169,"_21377":54075,"_5":14632,"_28040":54001,"_3027":54076},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3572":1198,"_30844":1169,"_21377":54078,"_5":14632,"_28040":54001,"_3027":54079},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3572":1199,"_30844":1169,"_21377":54081,"_5":14632,"_28040":54001,"_3027":54082},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3572":1200,"_30844":1169,"_21377":54084,"_5":14632,"_28040":54005,"_3027":50733},[],{"_3572":1201,"_30844":1169,"_21377":54086,"_5":14632,"_28040":54005,"_3027":54087},[],"Material crossing EST",{"_3572":1202,"_30844":1169,"_21377":54089,"_5":14632,"_28040":54005,"_3027":54090},[],"Device-generated key",{"_3572":1203,"_30844":1169,"_21377":54092,"_5":14632,"_28040":54005,"_3027":54093},[],"Public CSR and certificate; the key stays on the client.",{"_3572":1204,"_30844":1169,"_21377":54095,"_5":14632,"_28040":54005,"_3027":54096},[],"Existing device key",{"_3572":1205,"_30844":1169,"_21377":54098,"_5":14632,"_28040":54005,"_3027":54099},[],"CSR signed with that key and a new certificate.",{"_3572":1206,"_30844":1169,"_21377":54101,"_5":14632,"_28040":54005,"_3027":53367},[],{"_3572":1207,"_30844":1169,"_21377":54103,"_5":14632,"_28040":54005,"_3027":54104},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3572":1208,"_30844":1169,"_21377":54106,"_5":14632,"_28040":54005,"_3027":54107},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3572":1209,"_30844":1169,"_21377":54109,"_5":14632,"_28040":54009,"_3027":54110},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3572":1210,"_30844":1210,"_5":14996,"_3027":54112,"_31202":54113,"_21377":54114,"_28040":1210},"Renewal and recovery",[50349,51888,53048,53046,53229],[],{"_3572":1211,"_30844":1210,"_21377":54116,"_5":14632,"_28040":1210,"_3027":54117},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3572":1212,"_30844":1210,"_5":31199,"_21377":54119,"_28040":54120,"_3027":54121},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3572":1213,"_30844":1210,"_5":31199,"_21377":54123,"_28040":54124,"_3027":54125},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3572":1214,"_30844":1210,"_5":31199,"_21377":54127,"_28040":54128,"_3027":54129},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3572":1215,"_30844":1210,"_5":31199,"_21377":54131,"_28040":54132,"_3027":54133},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3572":1216,"_30844":1210,"_5":31199,"_21377":54135,"_28040":54136,"_3027":54137},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3572":1217,"_30844":1210,"_21377":54139,"_5":14632,"_28040":1210,"_3027":54140},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3572":1218,"_30844":1210,"_21377":54142,"_5":14632,"_28040":54120,"_3027":54143},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3572":1219,"_30844":1210,"_21377":54145,"_5":14632,"_28040":54120,"_3027":54146},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3572":1220,"_30844":1210,"_21377":54148,"_5":14632,"_28040":54120,"_3027":54149},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3572":1221,"_30844":1210,"_21377":54151,"_5":14632,"_28040":54120,"_3027":54152},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3572":1222,"_30844":1210,"_21377":54154,"_5":14632,"_28040":54124,"_3027":54155},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3572":1223,"_30844":1210,"_21377":54157,"_5":14632,"_28040":54124,"_3027":54158},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3572":1224,"_30844":1210,"_21377":54160,"_5":14632,"_28040":54128,"_3027":54161},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3572":1225,"_30844":1210,"_21377":54163,"_5":14632,"_28040":54128,"_3027":54164},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3572":1226,"_30844":1210,"_21377":54166,"_5":14632,"_28040":54128,"_3027":54167},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3572":1227,"_30844":1210,"_21377":54169,"_5":14632,"_28040":54132,"_3027":54170},[],"Situation",{"_3572":1228,"_30844":1210,"_21377":54172,"_5":14632,"_28040":54132,"_3027":54173},[],"Procedure",{"_3572":1229,"_30844":1210,"_21377":54175,"_5":14632,"_28040":54132,"_3027":54176},[],"Valid certificate, outside the window",{"_3572":1230,"_30844":1210,"_21377":54178,"_5":14632,"_28040":54132,"_3027":54179},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3572":1231,"_30844":1210,"_21377":54181,"_5":14632,"_28040":54132,"_3027":54182},[],"Expired certificate, key available",{"_3572":1232,"_30844":1210,"_21377":54184,"_5":14632,"_28040":54132,"_3027":54185},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3572":1233,"_30844":1210,"_21377":54187,"_5":14632,"_28040":54132,"_3027":54188},[],"Renewal through webhook or `NO_AUTH`",{"_3572":1234,"_30844":1210,"_21377":54190,"_5":14632,"_28040":54132,"_3027":54191},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3572":1235,"_30844":1210,"_21377":54193,"_5":14632,"_28040":54132,"_3027":54194},[],"Lost or inaccessible key",{"_3572":1236,"_30844":1210,"_21377":54196,"_5":14632,"_28040":54132,"_3027":54197},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3572":1237,"_30844":1210,"_21377":54199,"_5":14632,"_28040":54132,"_3027":54200},[],"Current identity revoked",{"_3572":1238,"_30844":1210,"_21377":54202,"_5":14632,"_28040":54132,"_3027":54203},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3572":1239,"_30844":1210,"_21377":54205,"_5":14632,"_28040":54132,"_3027":54206},[],"Device without an identity",{"_3572":1240,"_30844":1210,"_21377":54208,"_5":14632,"_28040":54132,"_3027":54209},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3572":1241,"_30844":1210,"_21377":54211,"_5":14632,"_28040":54132,"_3027":54212},[],"Retired device",{"_3572":1242,"_30844":1210,"_21377":54214,"_5":14632,"_28040":54132,"_3027":54215},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3572":1243,"_30844":1210,"_21377":54217,"_5":14632,"_28040":54132,"_3027":54218},[],"Timeout, HTTP 500 or installation failure",{"_3572":1244,"_30844":1210,"_21377":54220,"_5":14632,"_28040":54132,"_3027":54221},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3572":1245,"_30844":1210,"_21377":54223,"_5":14632,"_28040":54136,"_3027":54224},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3572":1246,"_30844":1210,"_21377":54226,"_5":14632,"_28040":54136,"_3027":54227},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3572":1247,"_30844":1247,"_5":14996,"_3027":54229,"_31202":54230,"_21377":54231,"_28040":1247},"Enrollment troubleshooting",[50349,51888,53048,53046,53229],[],{"_3572":1248,"_30844":1247,"_21377":54233,"_5":14632,"_28040":1247,"_3027":54234},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3572":1249,"_30844":1247,"_5":31199,"_21377":54236,"_28040":54237,"_3027":54238},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3572":1250,"_30844":1247,"_5":31199,"_21377":54240,"_28040":54241,"_3027":54242},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3572":1251,"_30844":1247,"_5":31199,"_21377":54244,"_28040":54245,"_3027":53792},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3572":1252,"_30844":1247,"_5":31199,"_21377":54247,"_28040":54248,"_3027":54249},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3572":1253,"_30844":1247,"_21377":54251,"_5":14632,"_28040":1247,"_3027":54252},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3572":1254,"_30844":1247,"_21377":54254,"_5":14632,"_28040":54241,"_3027":54255},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3572":1255,"_30844":1247,"_21377":54257,"_5":14632,"_28040":54241,"_3027":54258},[],"Symptom or message",{"_3572":1256,"_30844":1247,"_21377":54260,"_5":14632,"_28040":54241,"_3027":54022},[],{"_3572":1257,"_30844":1247,"_21377":54262,"_5":14632,"_28040":54241,"_3027":54263},[],"curl rejects TLS, name or issuer",{"_3572":1258,"_30844":1247,"_21377":54265,"_5":14632,"_28040":54241,"_3027":54266},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3572":1259,"_30844":1247,"_21377":54268,"_5":14632,"_28040":54241,"_3027":54269},[],"404 or missing APS",{"_3572":1260,"_30844":1247,"_21377":54271,"_5":14632,"_28040":54241,"_3027":54272},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3572":1261,"_30844":1247,"_21377":54274,"_5":14632,"_28040":54241,"_3027":54275},[],"400, CSR or format error",{"_3572":1262,"_30844":1247,"_21377":54277,"_5":14632,"_28040":54241,"_3027":54278},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3572":1263,"_30844":1247,"_21377":54280,"_5":14632,"_28040":54241,"_3027":54281},[],"Missing credential or invalid certificate",{"_3572":1264,"_30844":1247,"_21377":54283,"_5":14632,"_28040":54241,"_3027":54284},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3572":1265,"_30844":1247,"_21377":54286,"_5":14632,"_28040":54241,"_3027":54287},[],"Webhook denies, times out or responds without authorization",{"_3572":1266,"_30844":1247,"_21377":54289,"_5":14632,"_28040":54241,"_3027":54290},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3572":1267,"_30844":1247,"_21377":54292,"_5":14632,"_28040":54241,"_3027":54293},[],"`unexpected status code: <n>: redirects are not followed`",{"_3572":1268,"_30844":1247,"_21377":54295,"_5":14632,"_28040":54241,"_3027":54296},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3572":1269,"_30844":1247,"_21377":54298,"_5":14632,"_28040":54241,"_3027":54299},[],"`webhook response exceeds 1048576 bytes`",{"_3572":1270,"_30844":1247,"_21377":54301,"_5":14632,"_28040":54241,"_3027":54302},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3572":1271,"_30844":1247,"_21377":54304,"_5":14632,"_28040":54241,"_3027":54305},[],"`webhook config must not reference files`",{"_3572":1272,"_30844":1247,"_21377":54307,"_5":14632,"_28040":54241,"_3027":54308},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3572":1273,"_30844":1247,"_21377":54310,"_5":14632,"_28040":54241,"_3027":54311},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3572":1274,"_30844":1247,"_21377":54313,"_5":14632,"_28040":54241,"_3027":54314},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3572":1275,"_30844":1247,"_21377":54316,"_5":14632,"_28040":54241,"_3027":54317},[],"`webhook mTLS certificate and key are invalid: …`",{"_3572":1276,"_30844":1247,"_21377":54319,"_5":14632,"_28040":54241,"_3027":54320},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3572":1277,"_30844":1247,"_21377":54322,"_5":14632,"_28040":54241,"_3027":54323},[],"400 `struct validation error` creating or updating a DMS",{"_3572":1278,"_30844":1247,"_21377":54325,"_5":14632,"_28040":54241,"_3027":54326},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3572":1279,"_30844":1247,"_21377":54328,"_5":14632,"_28040":54241,"_3027":54329},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3572":1280,"_30844":1247,"_21377":54331,"_5":14632,"_28040":54241,"_3027":54332},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3572":1281,"_30844":1247,"_21377":54334,"_5":14632,"_28040":54241,"_3027":54335},[],"`device not preregistered`",{"_3572":1282,"_30844":1247,"_21377":54337,"_5":14632,"_28040":54241,"_3027":54338},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3572":1283,"_30844":1247,"_21377":54340,"_5":14632,"_28040":54241,"_3027":54341},[],"`forbiddenNewEnrollment`",{"_3572":1284,"_30844":1247,"_21377":54343,"_5":14632,"_28040":54241,"_3027":54344},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3572":1285,"_30844":1247,"_21377":54346,"_5":14632,"_28040":54241,"_3027":54347},[],"Different owning DMS",{"_3572":1286,"_30844":1247,"_21377":54349,"_5":14632,"_28040":54241,"_3027":54350},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3572":1287,"_30844":1247,"_21377":54352,"_5":14632,"_28040":54241,"_3027":54353},[],"`invalid RawSubject bytes`",{"_3572":1288,"_30844":1247,"_21377":54355,"_5":14632,"_28040":54241,"_3027":54356},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3572":1289,"_30844":1247,"_21377":54358,"_5":14632,"_28040":54241,"_3027":54359},[],"`invalid reenroll window`",{"_3572":1290,"_30844":1247,"_21377":54361,"_5":14632,"_28040":54241,"_3027":54362},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3572":1291,"_30844":1247,"_21377":54364,"_5":14632,"_28040":54241,"_3027":54365},[],"Current certificate revoked",{"_3572":1292,"_30844":1247,"_21377":54367,"_5":14632,"_28040":54241,"_3027":54368},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3572":1293,"_30844":1247,"_21377":54370,"_5":14632,"_28040":54241,"_3027":54371},[],"CA, profile or signing error",{"_3572":1294,"_30844":1247,"_21377":54373,"_5":14632,"_28040":54241,"_3027":54374},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3572":1295,"_30844":1247,"_21377":54376,"_5":14632,"_28040":54241,"_3027":54377},[],"HTTP 200 without a device connection",{"_3572":1296,"_30844":1247,"_21377":54379,"_5":14632,"_28040":54241,"_3027":54380},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3572":1297,"_30844":1247,"_21377":54382,"_5":14632,"_28040":54241,"_3027":54383},[],"Timeout or error after issuance",{"_3572":1298,"_30844":1247,"_21377":54385,"_5":14632,"_28040":54241,"_3027":54386},[],"New certificates, current slot and previous identity's state before retrying.",{"_3572":1299,"_30844":1247,"_21377":54388,"_5":14632,"_28040":54245,"_3027":54389},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3572":1300,"_30844":1247,"_21377":54391,"_5":14632,"_28040":54245,"_3027":54392},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3572":1301,"_30844":1247,"_21377":54394,"_5":14632,"_28040":54248,"_3027":54395},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3572":1302,"_30844":1247,"_21377":54397,"_5":14632,"_28040":54248,"_3027":54398},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3572":1303,"_30844":1247,"_21377":54400,"_5":14632,"_28040":54248,"_3027":54401},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3572":1304,"_30844":1247,"_21377":54403,"_5":14632,"_28040":54248,"_3027":54404},[],"Make one request, save headers/body and query the device and certificates.",{"_3572":1305,"_30844":1247,"_21377":54406,"_5":14632,"_28040":54248,"_3027":54407},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3572":1306,"_30844":1247,"_21377":54409,"_5":14632,"_28040":54248,"_3027":54410},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3572":1307,"_30844":1247,"_21377":54412,"_5":14632,"_28040":54248,"_3027":54413},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3572":1308,"_30844":1308,"_5":14996,"_3027":54415,"_31202":54416,"_21377":54417,"_28040":1308},"Trust distribution and updates",[50349,51888,53048,53046,53229],[],{"_3572":1309,"_30844":1308,"_21377":54419,"_5":14632,"_28040":1308,"_3027":54420},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3572":1310,"_30844":1308,"_5":31199,"_21377":54422,"_28040":54423,"_3027":54424},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3572":1311,"_30844":1308,"_5":31199,"_21377":54426,"_28040":54427,"_3027":54428},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3572":1312,"_30844":1308,"_5":31199,"_21377":54430,"_28040":54431,"_3027":54432},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3572":1313,"_30844":1308,"_5":31199,"_21377":54434,"_28040":54435,"_3027":54436},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3572":1314,"_30844":1308,"_5":31199,"_21377":54438,"_28040":54439,"_3027":54440},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3572":1315,"_30844":1308,"_21377":54442,"_5":14632,"_28040":1308,"_3027":54443},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3572":1316,"_30844":1308,"_21377":54445,"_5":14632,"_28040":54423,"_3027":54446},[],"Relationship",{"_3572":1317,"_30844":1308,"_21377":54448,"_5":14632,"_28040":54423,"_3027":54449},[],"Material prepared by its owner",{"_3572":1318,"_30844":1308,"_21377":54451,"_5":14632,"_28040":54423,"_3027":54452},[],"Device → EST server",{"_3572":1319,"_30844":1308,"_21377":54454,"_5":14632,"_28040":54423,"_3027":54455},[],"Previously verified server root, chain or pin and TLS name.",{"_3572":1320,"_30844":1308,"_21377":54457,"_5":14632,"_28040":54423,"_3027":54458},[],"DMS → requester",{"_3572":1321,"_30844":1308,"_21377":54460,"_5":14632,"_28040":54423,"_3027":54461},[],"CAs and rules authorizing initial or renewal credentials.",{"_3572":1322,"_30844":1308,"_21377":54463,"_5":14632,"_28040":54423,"_3027":54464},[],"Consumer → device",{"_3572":1323,"_30844":1308,"_21377":54466,"_5":14632,"_28040":54423,"_3027":54467},[],"Operational identity roots, intermediates, validation and permissions.",{"_3572":1324,"_30844":1308,"_21377":54469,"_5":14632,"_28040":54423,"_3027":54470},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3572":1325,"_30844":1308,"_21377":54472,"_5":14632,"_28040":54427,"_3027":54473},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3572":1326,"_30844":1308,"_21377":54475,"_5":14632,"_28040":54427,"_3027":54476},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3572":1327,"_30844":1308,"_21377":54478,"_5":14632,"_28040":54431,"_3027":54479},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3572":1328,"_30844":1308,"_21377":54481,"_5":14632,"_28040":54431,"_3027":54482},[],"Select policy-approved roots as anchors.",{"_3572":1329,"_30844":1308,"_21377":54484,"_5":14632,"_28040":54431,"_3027":54485},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3572":1330,"_30844":1308,"_21377":54487,"_5":14632,"_28040":54431,"_3027":54488},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3572":1331,"_30844":1308,"_21377":54490,"_5":14632,"_28040":54431,"_3027":54491},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3572":1332,"_30844":1308,"_21377":54493,"_5":14632,"_28040":54431,"_3027":54494},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3572":1333,"_30844":1308,"_21377":54496,"_5":14632,"_28040":54435,"_3027":54497},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3572":1334,"_30844":1308,"_21377":54499,"_5":14632,"_28040":54435,"_3027":54500},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3572":1335,"_30844":1308,"_21377":54502,"_5":14632,"_28040":54435,"_3027":54503},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3572":1336,"_30844":1308,"_21377":54505,"_5":14632,"_28040":54439,"_3027":54506},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3572":1337,"_30844":1337,"_5":14996,"_3027":54508,"_31202":54509,"_21377":54511,"_28040":1337},"AWS IoT Core",[50349,51888,53048,53046,54510],"Integrations",[],{"_3572":1338,"_30844":1337,"_21377":54513,"_5":14632,"_28040":1337,"_3027":54514},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3572":1339,"_30844":1337,"_5":31199,"_21377":54516,"_28040":54517,"_3027":54518},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3572":1340,"_30844":1337,"_5":31199,"_21377":54520,"_28040":54521,"_3027":54522},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3572":1341,"_30844":1337,"_5":31199,"_21377":54524,"_28040":54525,"_3027":54526},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3572":1342,"_30844":1337,"_5":31199,"_21377":54528,"_28040":54529,"_3027":54530},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3572":1343,"_30844":1337,"_5":31199,"_21377":54532,"_28040":54533,"_3027":54534},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3572":1344,"_30844":1337,"_5":31199,"_21377":54536,"_28040":54537,"_3027":54538},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3572":1345,"_30844":1337,"_5":31199,"_21377":54540,"_28040":54541,"_3027":54542},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3572":1346,"_30844":1337,"_5":31199,"_21377":54544,"_28040":54545,"_3027":54546},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3572":1347,"_30844":1337,"_5":31199,"_21377":54548,"_28040":54549,"_3027":54550},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3572":1348,"_30844":1337,"_5":31199,"_21377":54552,"_28040":54553,"_3027":54554},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3572":1349,"_30844":1337,"_5":31199,"_21377":54556,"_28040":54557,"_3027":54558},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3572":1350,"_30844":1337,"_5":31199,"_21377":54560,"_28040":54561,"_3027":54562},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3572":1351,"_30844":1337,"_5":31199,"_21377":54564,"_28040":54565,"_3027":54566},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3572":1352,"_30844":1337,"_5":31199,"_21377":54568,"_28040":54569,"_3027":54570},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3572":1353,"_30844":1337,"_5":31199,"_21377":54572,"_28040":54573,"_3027":54574},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3572":1354,"_30844":1337,"_5":31199,"_21377":54576,"_28040":54577,"_3027":54578},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3572":1355,"_30844":1337,"_5":31199,"_21377":54580,"_28040":54581,"_3027":54582},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3572":1356,"_30844":1337,"_5":31199,"_21377":54584,"_28040":54585,"_3027":54586},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3572":1357,"_30844":1337,"_5":31199,"_21377":54588,"_28040":54589,"_3027":54590},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3572":1358,"_30844":1337,"_5":31199,"_21377":54592,"_28040":54593,"_3027":54594},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3572":1359,"_30844":1337,"_5":31199,"_21377":54596,"_28040":54597,"_3027":54598},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3572":1360,"_30844":1337,"_5":31199,"_21377":54600,"_28040":54601,"_3027":54602},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3572":1361,"_30844":1337,"_5":31199,"_21377":54604,"_28040":54605,"_3027":54606},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3572":1362,"_30844":1337,"_5":31199,"_21377":54608,"_28040":54609,"_3027":54610},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3572":1363,"_30844":1337,"_5":31199,"_21377":54612,"_28040":54613,"_3027":54614},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3572":1364,"_30844":1337,"_21377":54616,"_5":14632,"_28040":1337,"_3027":54617},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3572":1365,"_30844":1337,"_21377":54619,"_5":14632,"_28040":1337,"_3027":54620},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3572":1366,"_30844":1337,"_21377":54622,"_5":14632,"_28040":1337,"_3027":54623},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3572":1367,"_30844":1337,"_21377":54625,"_5":14632,"_28040":54517,"_3027":54626},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3572":1368,"_30844":1337,"_21377":54628,"_5":14632,"_28040":54517,"_3027":54629},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3572":1369,"_30844":1337,"_21377":54631,"_5":14632,"_28040":54517,"_3027":54632},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3572":1370,"_30844":1337,"_21377":54634,"_5":14632,"_28040":54517,"_3027":54635},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3572":1371,"_30844":1337,"_21377":54637,"_5":14632,"_28040":54521,"_3027":54638},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3572":1372,"_30844":1337,"_21377":54640,"_5":14632,"_28040":54525,"_3027":54641},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3572":1373,"_30844":1337,"_21377":54643,"_5":14632,"_28040":54525,"_3027":54644},[],"IAM action",{"_3572":1374,"_30844":1337,"_21377":54646,"_5":14632,"_28040":54525,"_3027":50739},[],{"_3572":1375,"_30844":1337,"_21377":54648,"_5":14632,"_28040":54525,"_3027":54649},[],"`iot:GetRegistrationCode`",{"_3572":1376,"_30844":1337,"_21377":54651,"_5":14632,"_28040":54525,"_3027":54652},[],"Obtain the verification code for CA registration in the Primary Account",{"_3572":1377,"_30844":1337,"_21377":54654,"_5":14632,"_28040":54525,"_3027":54655},[],"`iot:RegisterCACertificate`",{"_3572":1378,"_30844":1337,"_21377":54657,"_5":14632,"_28040":54525,"_3027":54658},[],"Register the CA in AWS IoT",{"_3572":1379,"_30844":1337,"_21377":54660,"_5":14632,"_28040":54525,"_3027":54661},[],"`iot:DescribeCACertificate`",{"_3572":1380,"_30844":1337,"_21377":54663,"_5":14632,"_28040":54525,"_3027":54664},[],"Check the CA registration status",{"_3572":1381,"_30844":1337,"_21377":54666,"_5":14632,"_28040":54525,"_3027":54667},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3572":1382,"_30844":1337,"_21377":54669,"_5":14632,"_28040":54525,"_3027":54670},[],"Create or update Things in IoT Core",{"_3572":1383,"_30844":1337,"_21377":54672,"_5":14632,"_28040":54525,"_3027":54673},[],"`iot:RegisterThing`",{"_3572":1384,"_30844":1337,"_21377":54675,"_5":14632,"_28040":54525,"_3027":54676},[],"Provision Things through a template",{"_3572":1385,"_30844":1337,"_21377":54678,"_5":14632,"_28040":54525,"_3027":54679},[],"`iot:RegisterCertificate`",{"_3572":1386,"_30844":1337,"_21377":54681,"_5":14632,"_28040":54525,"_3027":54682},[],"Register device certificates",{"_3572":1387,"_30844":1337,"_21377":54684,"_5":14632,"_28040":54525,"_3027":54685},[],"`iot:UpdateCertificate`",{"_3572":1388,"_30844":1337,"_21377":54687,"_5":14632,"_28040":54525,"_3027":54688},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3572":1389,"_30844":1337,"_21377":54690,"_5":14632,"_28040":54525,"_3027":54691},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3572":1390,"_30844":1337,"_21377":54693,"_5":14632,"_28040":54525,"_3027":54694},[],"Create and attach IoT policies",{"_3572":1391,"_30844":1337,"_21377":54696,"_5":14632,"_28040":54525,"_3027":54697},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3572":1392,"_30844":1337,"_21377":54699,"_5":14632,"_28040":54525,"_3027":54700},[],"Manage Thing groups",{"_3572":1393,"_30844":1337,"_21377":54702,"_5":14632,"_28040":54525,"_3027":54703},[],"`iot:CreateProvisioningTemplate`",{"_3572":1394,"_30844":1337,"_21377":54705,"_5":14632,"_28040":54525,"_3027":54706},[],"Create JITP templates",{"_3572":1395,"_30844":1337,"_21377":54708,"_5":14632,"_28040":54525,"_3027":54709},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3572":1396,"_30844":1337,"_21377":54711,"_5":14632,"_28040":54525,"_3027":54712},[],"Read and write the Device Shadow",{"_3572":1397,"_30844":1337,"_21377":54714,"_5":14632,"_28040":54525,"_3027":54715},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3572":1398,"_30844":1337,"_21377":54717,"_5":14632,"_28040":54529,"_3027":54718},[],"Parameter",{"_3572":1399,"_30844":1337,"_21377":54720,"_5":14632,"_28040":54529,"_3027":54721},[],"Type",{"_3572":1400,"_30844":1337,"_21377":54723,"_5":14632,"_28040":54529,"_3027":54724},[],"Required",{"_3572":1401,"_30844":1337,"_21377":54726,"_5":14632,"_28040":54529,"_3027":54727},[],"Description",{"_3572":1402,"_30844":1337,"_21377":54729,"_5":14632,"_28040":54529,"_3027":54730},[],"`connector_id`",{"_3572":1403,"_30844":1337,"_21377":54732,"_5":14632,"_28040":54529,"_3027":25498},[],{"_3572":1404,"_30844":1337,"_21377":54734,"_5":14632,"_28040":54529,"_3027":54735},[],"Yes",{"_3572":1405,"_30844":1337,"_21377":54737,"_5":14632,"_28040":54529,"_3027":54738},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3572":1406,"_30844":1337,"_21377":54740,"_5":14632,"_28040":54529,"_3027":54741},[],"`aws_config.region`",{"_3572":1407,"_30844":1337,"_21377":54743,"_5":14632,"_28040":54529,"_3027":25498},[],{"_3572":1408,"_30844":1337,"_21377":54745,"_5":14632,"_28040":54529,"_3027":54735},[],{"_3572":1409,"_30844":1337,"_21377":54747,"_5":14632,"_28040":54529,"_3027":54748},[],"AWS region where the connector operates.",{"_3572":1410,"_30844":1337,"_21377":54750,"_5":14632,"_28040":54529,"_3027":54751},[],"`aws_config.auth_method`",{"_3572":1411,"_30844":1337,"_21377":54753,"_5":14632,"_28040":54529,"_3027":25498},[],{"_3572":1412,"_30844":1337,"_21377":54755,"_5":14632,"_28040":54529,"_3027":54735},[],{"_3572":1413,"_30844":1337,"_21377":54757,"_5":14632,"_28040":54529,"_3027":54758},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3572":1414,"_30844":1337,"_21377":54760,"_5":14632,"_28040":54529,"_3027":54761},[],"`aws_config.access_key_id`",{"_3572":1415,"_30844":1337,"_21377":54763,"_5":14632,"_28040":54529,"_3027":25498},[],{"_3572":1416,"_30844":1337,"_21377":54765,"_5":14632,"_28040":54529,"_3027":54766},[],"Only with `auth_method=static`",{"_3572":1417,"_30844":1337,"_21377":54768,"_5":14632,"_28040":54529,"_3027":54769},[],"AWS access key.",{"_3572":1418,"_30844":1337,"_21377":54771,"_5":14632,"_28040":54529,"_3027":54772},[],"`aws_config.secret_access_key`",{"_3572":1419,"_30844":1337,"_21377":54774,"_5":14632,"_28040":54529,"_3027":25498},[],{"_3572":1420,"_30844":1337,"_21377":54776,"_5":14632,"_28040":54529,"_3027":54766},[],{"_3572":1421,"_30844":1337,"_21377":54778,"_5":14632,"_28040":54529,"_3027":54779},[],"AWS secret key.",{"_3572":1422,"_30844":1337,"_21377":54781,"_5":14632,"_28040":54529,"_3027":54782},[],"`aws_config.session_token`",{"_3572":1423,"_30844":1337,"_21377":54784,"_5":14632,"_28040":54529,"_3027":25498},[],{"_3572":1424,"_30844":1337,"_21377":54786,"_5":14632,"_28040":54529,"_3027":54787},[],"No",{"_3572":1425,"_30844":1337,"_21377":54789,"_5":14632,"_28040":54529,"_3027":54790},[],"Session token (with `auth_method=static`).",{"_3572":1426,"_30844":1337,"_21377":54792,"_5":14632,"_28040":54529,"_3027":54793},[],"`aws_config.role_arn`",{"_3572":1427,"_30844":1337,"_21377":54795,"_5":14632,"_28040":54529,"_3027":25498},[],{"_3572":1428,"_30844":1337,"_21377":54797,"_5":14632,"_28040":54529,"_3027":54798},[],"Only with `auth_method=role`",{"_3572":1429,"_30844":1337,"_21377":54800,"_5":14632,"_28040":54529,"_3027":54801},[],"ARN of the role to assume.",{"_3572":1430,"_30844":1337,"_21377":54803,"_5":14632,"_28040":54529,"_3027":54804},[],"`aws_config.endpoint_url`",{"_3572":1431,"_30844":1337,"_21377":54806,"_5":14632,"_28040":54529,"_3027":25498},[],{"_3572":1432,"_30844":1337,"_21377":54808,"_5":14632,"_28040":54529,"_3027":54787},[],{"_3572":1433,"_30844":1337,"_21377":54810,"_5":14632,"_28040":54529,"_3027":54811},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3572":1434,"_30844":1337,"_21377":54813,"_5":14632,"_28040":54529,"_3027":54814},[],"`subscriber_event_bus`",{"_3572":1435,"_30844":1337,"_21377":54816,"_5":14632,"_28040":54529,"_3027":18012},[],{"_3572":1436,"_30844":1337,"_21377":54818,"_5":14632,"_28040":54529,"_3027":54735},[],{"_3572":1437,"_30844":1337,"_21377":54820,"_5":14632,"_28040":54529,"_3027":54821},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3572":1438,"_30844":1337,"_21377":54823,"_5":14632,"_28040":54529,"_3027":54824},[],"`dms_manager_client`",{"_3572":1439,"_30844":1337,"_21377":54826,"_5":14632,"_28040":54529,"_3027":25498},[],{"_3572":1440,"_30844":1337,"_21377":54828,"_5":14632,"_28040":54529,"_3027":54735},[],{"_3572":1441,"_30844":1337,"_21377":54830,"_5":14632,"_28040":54529,"_3027":54831},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3572":1442,"_30844":1337,"_21377":54833,"_5":14632,"_28040":54529,"_3027":54834},[],"`device_manager_client`",{"_3572":1443,"_30844":1337,"_21377":54836,"_5":14632,"_28040":54529,"_3027":25498},[],{"_3572":1444,"_30844":1337,"_21377":54838,"_5":14632,"_28040":54529,"_3027":54735},[],{"_3572":1445,"_30844":1337,"_21377":54840,"_5":14632,"_28040":54529,"_3027":54841},[],"HTTP URL of Lamassu's Device Manager.",{"_3572":1446,"_30844":1337,"_21377":54843,"_5":14632,"_28040":54529,"_3027":54844},[],"`ca_client`",{"_3572":1447,"_30844":1337,"_21377":54846,"_5":14632,"_28040":54529,"_3027":25498},[],{"_3572":1448,"_30844":1337,"_21377":54848,"_5":14632,"_28040":54529,"_3027":54735},[],{"_3572":1449,"_30844":1337,"_21377":54850,"_5":14632,"_28040":54529,"_3027":54851},[],"HTTP URL of Lamassu's CA service.",{"_3572":1450,"_30844":1337,"_21377":54853,"_5":14632,"_28040":54533,"_3027":54854},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3572":1451,"_30844":1337,"_21377":54856,"_5":14632,"_28040":54533,"_3027":54857},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3572":1452,"_30844":1337,"_21377":54859,"_5":14632,"_28040":54533,"_3027":54860},[],"CloudEvent type",{"_3572":1453,"_30844":1337,"_21377":54862,"_5":14632,"_28040":54533,"_3027":54863},[],"Lamassu resource",{"_3572":1454,"_30844":1337,"_21377":54865,"_5":14632,"_28040":54533,"_3027":54866},[],"AWS Resource",{"_3572":1455,"_30844":1337,"_21377":54868,"_5":14632,"_28040":54533,"_3027":54869},[],"IAM actions",{"_3572":1456,"_30844":1337,"_21377":54871,"_5":14632,"_28040":54533,"_3027":54872},[],"AWS calls and effect",{"_3572":1457,"_30844":1337,"_21377":54874,"_5":14632,"_28040":54533,"_3027":54875},[],"Where in this page",{"_3572":1458,"_30844":1337,"_21377":54877,"_5":14632,"_28040":54533,"_3027":54878},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3572":1459,"_30844":1337,"_21377":54880,"_5":14632,"_28040":54533,"_3027":54881},[],"CA",{"_3572":1460,"_30844":1337,"_21377":54883,"_5":14632,"_28040":54533,"_3027":54884},[],"`IoTCore/CACertificate`",{"_3572":1461,"_30844":1337,"_21377":54886,"_5":14632,"_28040":54533,"_3027":54887},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3572":1462,"_30844":1337,"_21377":54889,"_5":14632,"_28040":54533,"_3027":54890},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3572":1463,"_30844":1337,"_21377":54892,"_5":14632,"_28040":54533,"_3027":54546},[],{"_3572":1464,"_30844":1337,"_21377":54894,"_5":14632,"_28040":54533,"_3027":54895},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3572":1465,"_30844":1337,"_21377":54897,"_5":14632,"_28040":54533,"_3027":54898},[],"DMS",{"_3572":1466,"_30844":1337,"_21377":54900,"_5":14632,"_28040":54533,"_3027":54901},[],"`IoTCore/ProvisioningTemplate`",{"_3572":1467,"_30844":1337,"_21377":54903,"_5":14632,"_28040":54533,"_3027":54904},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3572":1468,"_30844":1337,"_21377":54906,"_5":14632,"_28040":54533,"_3027":54907},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3572":1469,"_30844":1337,"_21377":54909,"_5":14632,"_28040":54533,"_3027":54574},[],{"_3572":1470,"_30844":1337,"_21377":54911,"_5":14632,"_28040":54533,"_3027":54912},[],"`EventBindDeviceIdentityKey`",{"_3572":1471,"_30844":1337,"_21377":54914,"_5":14632,"_28040":54533,"_3027":54915},[],"Device",{"_3572":1472,"_30844":1337,"_21377":54917,"_5":14632,"_28040":54533,"_3027":54918},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3572":1473,"_30844":1337,"_21377":54920,"_5":14632,"_28040":54533,"_3027":54921},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3572":1474,"_30844":1337,"_21377":54923,"_5":14632,"_28040":54533,"_3027":54924},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3572":1475,"_30844":1337,"_21377":54926,"_5":14632,"_28040":54533,"_3027":54582},[],{"_3572":1476,"_30844":1337,"_21377":54928,"_5":14632,"_28040":54533,"_3027":54929},[],"`EventUpdateCertificateStatusKey`",{"_3572":1477,"_30844":1337,"_21377":54931,"_5":14632,"_28040":54533,"_3027":54932},[],"Certificate",{"_3572":1478,"_30844":1337,"_21377":54934,"_5":14632,"_28040":54533,"_3027":54935},[],"`IoTCore/Certificate`",{"_3572":1479,"_30844":1337,"_21377":54937,"_5":14632,"_28040":54533,"_3027":54938},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3572":1480,"_30844":1337,"_21377":54940,"_5":14632,"_28040":54533,"_3027":54941},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3572":1481,"_30844":1337,"_21377":54943,"_5":14632,"_28040":54533,"_3027":54594},[],{"_3572":1482,"_30844":1337,"_21377":54945,"_5":14632,"_28040":54533,"_3027":54946},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3572":1483,"_30844":1337,"_21377":54948,"_5":14632,"_28040":54533,"_3027":54949},[],"Certificate / Device",{"_3572":1484,"_30844":1337,"_21377":54951,"_5":14632,"_28040":54533,"_3027":54952},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3572":1485,"_30844":1337,"_21377":54954,"_5":14632,"_28040":54533,"_3027":50745},[],{"_3572":1486,"_30844":1337,"_21377":54956,"_5":14632,"_28040":54533,"_3027":54957},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3572":1487,"_30844":1337,"_21377":54959,"_5":14632,"_28040":54533,"_3027":54602},[],{"_3572":1488,"_30844":1337,"_21377":54961,"_5":14632,"_28040":54537,"_3027":54962},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3572":1489,"_30844":1337,"_21377":54964,"_5":14632,"_28040":54541,"_3027":54965},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3572":1490,"_30844":1337,"_21377":54967,"_5":14632,"_28040":54541,"_3027":54968},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3572":1491,"_30844":1337,"_21377":54970,"_5":14632,"_28040":54545,"_3027":54971},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3572":1492,"_30844":1337,"_21377":54973,"_5":14632,"_28040":54545,"_3027":54974},[],"Transition",{"_3572":1493,"_30844":1337,"_21377":54976,"_5":14632,"_28040":54545,"_3027":54977},[],"AWS calls",{"_3572":1494,"_30844":1337,"_21377":54979,"_5":14632,"_28040":54545,"_3027":54980},[],"`NotRegistered` → `Requested`",{"_3572":1495,"_30844":1337,"_21377":54982,"_5":14632,"_28040":54545,"_3027":54983},[],"none (metadata write only)",{"_3572":1496,"_30844":1337,"_21377":54985,"_5":14632,"_28040":54545,"_3027":54986},[],"`Requested` → `Registering`",{"_3572":1497,"_30844":1337,"_21377":54988,"_5":14632,"_28040":54545,"_3027":54989},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3572":1498,"_30844":1337,"_21377":54991,"_5":14632,"_28040":54545,"_3027":54992},[],"`Registering` → `Succeeded`",{"_3572":1499,"_30844":1337,"_21377":54994,"_5":14632,"_28040":54545,"_3027":54995},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3572":1500,"_30844":1337,"_21377":54997,"_5":14632,"_28040":54545,"_3027":54998},[],"`Registering` → `Failed`",{"_3572":1501,"_30844":1337,"_21377":55000,"_5":14632,"_28040":54545,"_3027":55001},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3572":1502,"_30844":1337,"_21377":55003,"_5":14632,"_28040":54545,"_3027":55004},[],"`Failed` / `Succeeded` → `Requested`",{"_3572":1503,"_30844":1337,"_21377":55006,"_5":14632,"_28040":54545,"_3027":55007},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3572":1504,"_30844":1337,"_21377":55009,"_5":14632,"_28040":54549,"_3027":55010},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3572":1505,"_30844":1337,"_21377":55012,"_5":14632,"_28040":54549,"_3027":55013},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3572":1506,"_30844":1337,"_21377":55015,"_5":14632,"_28040":54549,"_3027":55016},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3572":1507,"_30844":1337,"_21377":55018,"_5":14632,"_28040":54549,"_3027":55019},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3572":1508,"_30844":1337,"_21377":55021,"_5":14632,"_28040":54549,"_3027":55022},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3572":1509,"_30844":1337,"_21377":55024,"_5":14632,"_28040":54549,"_3027":55025},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3572":1510,"_30844":1337,"_21377":55027,"_5":14632,"_28040":54553,"_3027":55028},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3572":1511,"_30844":1337,"_21377":55030,"_5":14632,"_28040":54557,"_3027":55031},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3572":1512,"_30844":1337,"_21377":55033,"_5":14632,"_28040":54557,"_3027":55034},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3572":1513,"_30844":1337,"_21377":55036,"_5":14632,"_28040":54561,"_3027":55037},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3572":1514,"_30844":1337,"_21377":55039,"_5":14632,"_28040":54565,"_3027":55040},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3572":1515,"_30844":1337,"_21377":55042,"_5":14632,"_28040":54565,"_3027":55043},[],"Creates or updates the IoT policies configured in the DMS.",{"_3572":1516,"_30844":1337,"_21377":55045,"_5":14632,"_28040":54565,"_3027":55046},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3572":1517,"_30844":1337,"_21377":55048,"_5":14632,"_28040":54565,"_3027":55049},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3572":1518,"_30844":1337,"_21377":55051,"_5":14632,"_28040":54565,"_3027":55052},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3572":1519,"_30844":1337,"_21377":55054,"_5":14632,"_28040":54565,"_3027":55055},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3572":1520,"_30844":1337,"_21377":55057,"_5":14632,"_28040":54565,"_3027":55058},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3572":1521,"_30844":1337,"_21377":55060,"_5":14632,"_28040":54569,"_3027":55061},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3572":1522,"_30844":1337,"_21377":55063,"_5":14632,"_28040":54569,"_3027":55064},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3572":1523,"_30844":1337,"_21377":55066,"_5":14632,"_28040":54569,"_3027":55067},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3572":1524,"_30844":1337,"_21377":55069,"_5":14632,"_28040":54569,"_3027":55070},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3572":1525,"_30844":1337,"_21377":55072,"_5":14632,"_28040":54569,"_3027":55073},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3572":1526,"_30844":1337,"_21377":55075,"_5":14632,"_28040":54573,"_3027":55076},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3572":1527,"_30844":1337,"_21377":55078,"_5":14632,"_28040":54573,"_3027":54974},[],{"_3572":1528,"_30844":1337,"_21377":55080,"_5":14632,"_28040":54573,"_3027":54977},[],{"_3572":1529,"_30844":1337,"_21377":55082,"_5":14632,"_28040":54573,"_3027":55083},[],"`Unconfigured` → `None` / `Auto`",{"_3572":1530,"_30844":1337,"_21377":55085,"_5":14632,"_28040":54573,"_3027":55086},[],"none (configuration only)",{"_3572":1531,"_30844":1337,"_21377":55088,"_5":14632,"_28040":54573,"_3027":55089},[],"`None` ↔ `Auto`",{"_3572":1532,"_30844":1337,"_21377":55091,"_5":14632,"_28040":54573,"_3027":55086},[],{"_3572":1533,"_30844":1337,"_21377":55093,"_5":14632,"_28040":54573,"_3027":55094},[],"Any → `Jitp`",{"_3572":1534,"_30844":1337,"_21377":55096,"_5":14632,"_28040":54573,"_3027":55097},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3572":1535,"_30844":1337,"_21377":55099,"_5":14632,"_28040":54573,"_3027":55100},[],"`Jitp` → `None` / `Auto`",{"_3572":1536,"_30844":1337,"_21377":55102,"_5":14632,"_28040":54573,"_3027":55103},[],"none (the template stays in the AWS account)",{"_3572":1537,"_30844":1337,"_21377":55105,"_5":14632,"_28040":54577,"_3027":55106},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3572":1538,"_30844":1337,"_21377":55108,"_5":14632,"_28040":54577,"_3027":55109},[],"The full flow from the device's perspective is:",{"_3572":1539,"_30844":1337,"_21377":55111,"_5":14632,"_28040":54577,"_3027":55112},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3572":1540,"_30844":1337,"_21377":55114,"_5":14632,"_28040":54581,"_3027":55115},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3572":1541,"_30844":1337,"_21377":55117,"_5":14632,"_28040":54581,"_3027":54974},[],{"_3572":1542,"_30844":1337,"_21377":55119,"_5":14632,"_28040":54581,"_3027":54977},[],{"_3572":1543,"_30844":1337,"_21377":55121,"_5":14632,"_28040":54581,"_3027":55122},[],"`Absent` → `Provisioned`",{"_3572":1544,"_30844":1337,"_21377":55124,"_5":14632,"_28040":54581,"_3027":55125},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3572":1545,"_30844":1337,"_21377":55127,"_5":14632,"_28040":54581,"_3027":55128},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3572":1546,"_30844":1337,"_21377":55130,"_5":14632,"_28040":54581,"_3027":55131},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3572":1547,"_30844":1337,"_21377":55133,"_5":14632,"_28040":54581,"_3027":55134},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3572":1548,"_30844":1337,"_21377":55136,"_5":14632,"_28040":54585,"_3027":55137},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3572":1549,"_30844":1337,"_21377":55139,"_5":14632,"_28040":54585,"_3027":55140},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3572":1550,"_30844":1337,"_21377":55142,"_5":14632,"_28040":54585,"_3027":55143},[],"For the JITP flow to work correctly:",{"_3572":1551,"_30844":1337,"_21377":55145,"_5":14632,"_28040":54585,"_3027":55146},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3572":1552,"_30844":1337,"_21377":55148,"_5":14632,"_28040":54585,"_3027":55149},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3572":1553,"_30844":1337,"_21377":55151,"_5":14632,"_28040":54585,"_3027":55152},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3572":1554,"_30844":1337,"_21377":55154,"_5":14632,"_28040":54585,"_3027":55155},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3572":1555,"_30844":1337,"_21377":55157,"_5":14632,"_28040":54589,"_3027":55158},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3572":1556,"_30844":1337,"_21377":55160,"_5":14632,"_28040":54589,"_3027":55161},[],"Status in Lamassu",{"_3572":1557,"_30844":1337,"_21377":55163,"_5":14632,"_28040":54589,"_3027":55164},[],"Revocation reason",{"_3572":1558,"_30844":1337,"_21377":55166,"_5":14632,"_28040":54589,"_3027":55167},[],"Status in AWS IoT Core",{"_3572":1559,"_30844":1337,"_21377":55169,"_5":14632,"_28040":54589,"_3027":55170},[],"`Active`",{"_3572":1560,"_30844":1337,"_21377":55172,"_5":14632,"_28040":54589,"_3027":55173},[],"None",{"_3572":1561,"_30844":1337,"_21377":55175,"_5":14632,"_28040":54589,"_3027":55176},[],"`ACTIVE`",{"_3572":1562,"_30844":1337,"_21377":55178,"_5":14632,"_28040":54589,"_3027":55179},[],"`Revoked`",{"_3572":1563,"_30844":1337,"_21377":55181,"_5":14632,"_28040":54589,"_3027":55182},[],"`certificateHold`",{"_3572":1564,"_30844":1337,"_21377":55184,"_5":14632,"_28040":54589,"_3027":55185},[],"`INACTIVE`",{"_3572":1565,"_30844":1337,"_21377":55187,"_5":14632,"_28040":54589,"_3027":55179},[],{"_3572":1566,"_30844":1337,"_21377":55189,"_5":14632,"_28040":54589,"_3027":55190},[],"Any other reason",{"_3572":1567,"_30844":1337,"_21377":55192,"_5":14632,"_28040":54589,"_3027":55193},[],"`REVOKED`",{"_3572":1568,"_30844":1337,"_21377":55195,"_5":14632,"_28040":54589,"_3027":55196},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3572":1569,"_30844":1337,"_21377":55198,"_5":14632,"_28040":54593,"_3027":55199},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3572":1570,"_30844":1337,"_21377":55201,"_5":14632,"_28040":54593,"_3027":54974},[],{"_3572":1571,"_30844":1337,"_21377":55203,"_5":14632,"_28040":54593,"_3027":54977},[],{"_3572":1572,"_30844":1337,"_21377":55205,"_5":14632,"_28040":54593,"_3027":55206},[],"`NotSynced` → `Active`",{"_3572":1573,"_30844":1337,"_21377":55208,"_5":14632,"_28040":54593,"_3027":54685},[],{"_3572":1574,"_30844":1337,"_21377":55210,"_5":14632,"_28040":54593,"_3027":55211},[],"`Active` → `Inactive`",{"_3572":1575,"_30844":1337,"_21377":55213,"_5":14632,"_28040":54593,"_3027":55214},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3572":1576,"_30844":1337,"_21377":55216,"_5":14632,"_28040":54593,"_3027":55217},[],"`Active` → `Revoked`",{"_3572":1577,"_30844":1337,"_21377":55219,"_5":14632,"_28040":54593,"_3027":55214},[],{"_3572":1578,"_30844":1337,"_21377":55221,"_5":14632,"_28040":54593,"_3027":55222},[],"`Inactive` / `Revoked` → `Active`",{"_3572":1579,"_30844":1337,"_21377":55224,"_5":14632,"_28040":54593,"_3027":54685},[],{"_3572":1580,"_30844":1337,"_21377":55226,"_5":14632,"_28040":54593,"_3027":55227},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3572":1581,"_30844":1337,"_21377":55229,"_5":14632,"_28040":54593,"_3027":55230},[],"none (these states are not synced to AWS)",{"_3572":1582,"_30844":1337,"_21377":55232,"_5":14632,"_28040":54597,"_3027":55233},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3572":1583,"_30844":1337,"_21377":55235,"_5":14632,"_28040":54597,"_3027":55236},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3572":1584,"_30844":1337,"_21377":55238,"_5":14632,"_28040":54597,"_3027":55239},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3572":1585,"_30844":1337,"_21377":55241,"_5":14632,"_28040":54601,"_3027":55242},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3572":1586,"_30844":1337,"_21377":55244,"_5":14632,"_28040":54601,"_3027":55245},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3572":1587,"_30844":1337,"_21377":55247,"_5":14632,"_28040":54605,"_3027":55248},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3572":1588,"_30844":1337,"_21377":55250,"_5":14632,"_28040":54605,"_3027":55251},[],"There are two action types:",{"_3572":1589,"_30844":1337,"_21377":55253,"_5":14632,"_28040":54605,"_3027":55254},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3572":1590,"_30844":1337,"_21377":55256,"_5":14632,"_28040":54605,"_3027":55257},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3572":1591,"_30844":1337,"_21377":55259,"_5":14632,"_28040":54605,"_3027":55260},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3572":1592,"_30844":1337,"_21377":55262,"_5":14632,"_28040":54609,"_3027":55263},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3572":1593,"_30844":1337,"_21377":55265,"_5":14632,"_28040":54609,"_3027":55266},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3572":1594,"_30844":1337,"_21377":55268,"_5":14632,"_28040":54609,"_3027":55269},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3572":1595,"_30844":1337,"_21377":55271,"_5":14632,"_28040":54613,"_3027":55272},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3572":1596,"_30844":1337,"_21377":55274,"_5":14632,"_28040":54613,"_3027":55275},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3572":1597,"_30844":1337,"_21377":55277,"_5":14632,"_28040":54613,"_3027":55278},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3572":1598,"_30844":1337,"_21377":55280,"_5":14632,"_28040":54613,"_3027":55281},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3572":1599,"_30844":1337,"_21377":55283,"_5":14632,"_28040":54613,"_3027":55284},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3572":1600,"_30844":1337,"_21377":55286,"_5":14632,"_28040":54613,"_3027":55287},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3572":1601,"_30844":1337,"_21377":55289,"_5":14632,"_28040":54613,"_3027":55290},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3572":1602,"_30844":1337,"_21377":55292,"_5":14632,"_28040":54613,"_3027":55293},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3572":1603,"_30844":1337,"_21377":55295,"_5":14632,"_28040":54613,"_3027":55296},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3572":1604,"_30844":1337,"_21377":55298,"_5":14632,"_28040":54613,"_3027":55299},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3572":1605,"_30844":1337,"_21377":55301,"_5":14632,"_28040":54613,"_3027":55302},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3572":1606,"_30844":1337,"_21377":55304,"_5":14632,"_28040":54613,"_3027":55305},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3572":1607,"_30844":1337,"_21377":55307,"_5":14632,"_28040":54613,"_3027":55308},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3572":1608,"_30844":1337,"_21377":55310,"_5":14632,"_28040":54613,"_3027":55311},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3572":1609,"_30844":1337,"_21377":55313,"_5":14632,"_28040":54613,"_3027":55314},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3572":1610,"_30844":1337,"_21377":55316,"_5":14632,"_28040":54613,"_3027":55317},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3572":1611,"_30844":1337,"_21377":55319,"_5":14632,"_28040":54613,"_3027":55320},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3572":1612,"_30844":1337,"_21377":55322,"_5":14632,"_28040":54613,"_3027":55323},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3572":1613,"_30844":1337,"_21377":55325,"_5":14632,"_28040":54613,"_3027":55326},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3572":1614,"_30844":1337,"_21377":55328,"_5":14632,"_28040":54613,"_3027":55329},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3572":1615,"_30844":1337,"_21377":55331,"_5":14632,"_28040":54613,"_3027":55332},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3572":1616,"_30844":1337,"_21377":55334,"_5":14632,"_28040":54613,"_3027":55335},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3572":1617,"_30844":1337,"_21377":55337,"_5":14632,"_28040":54613,"_3027":55338},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3572":1618,"_30844":1337,"_21377":55340,"_5":14632,"_28040":54613,"_3027":55341},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3572":1619,"_30844":1619,"_5":14996,"_3027":53048,"_31202":55343,"_21377":55344,"_28040":1619},[50349,51888,53048],[],{"_3572":1620,"_30844":1619,"_21377":55346,"_5":14632,"_28040":1619,"_3027":55347},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3572":1621,"_30844":1619,"_5":31199,"_21377":55349,"_28040":55350,"_3027":55351},[],"/docs/pr-preview/pr-68/platform/iot-fleets/overview#start-here","Start here",{"_3572":1622,"_30844":1619,"_5":31199,"_21377":55353,"_28040":55354,"_3027":53046},[],"/docs/pr-preview/pr-68/platform/iot-fleets/overview#devices-and-identities",{"_3572":1623,"_30844":1619,"_5":31199,"_21377":55356,"_28040":55357,"_3027":53229},[],"/docs/pr-preview/pr-68/platform/iot-fleets/overview#enrollment-with-pki",{"_3572":1624,"_30844":1619,"_5":31199,"_21377":55359,"_28040":55360,"_3027":54510},[],"/docs/pr-preview/pr-68/platform/iot-fleets/overview#integrations",{"_3572":1625,"_30844":1619,"_5":31199,"_21377":55362,"_28040":55363,"_3027":55364},[],"/docs/pr-preview/pr-68/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3572":1626,"_30844":1619,"_21377":55366,"_5":14632,"_28040":1619,"_3027":55367},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3572":1627,"_30844":1619,"_21377":55369,"_5":14632,"_28040":55350,"_3027":55370},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3572":1628,"_30844":1619,"_21377":55372,"_5":14632,"_28040":55350,"_3027":55373},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3572":1629,"_30844":1619,"_21377":55375,"_5":14632,"_28040":55354,"_3027":55376},[],"Resource",{"_3572":1630,"_30844":1619,"_21377":55378,"_5":14632,"_28040":55354,"_3027":55379},[],"What it represents",{"_3572":1631,"_30844":1619,"_21377":55381,"_5":14632,"_28040":55354,"_3027":55382},[],"**Device**",{"_3572":1632,"_30844":1619,"_21377":55384,"_5":14632,"_28040":55354,"_3027":55385},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3572":1633,"_30844":1619,"_21377":55387,"_5":14632,"_28040":55354,"_3027":55388},[],"**Identity**",{"_3572":1634,"_30844":1619,"_21377":55390,"_5":14632,"_28040":55354,"_3027":55391},[],"The device's association with its certificates: an active version and a history.",{"_3572":1635,"_30844":1619,"_21377":55393,"_5":14632,"_28040":55354,"_3027":55394},[],"**DMS**",{"_3572":1636,"_30844":1619,"_21377":55396,"_5":14632,"_28040":55354,"_3027":55397},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3572":1637,"_30844":1619,"_21377":55399,"_5":14632,"_28040":55354,"_3027":55400},[],"**Fleet**",{"_3572":1638,"_30844":1619,"_21377":55402,"_5":14632,"_28040":55354,"_3027":55403},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3572":1639,"_30844":1619,"_21377":55405,"_5":14632,"_28040":55354,"_3027":55406},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3572":1640,"_30844":1619,"_21377":55408,"_5":14632,"_28040":55354,"_3027":55409},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3572":1641,"_30844":1619,"_21377":55411,"_5":14632,"_28040":55357,"_3027":55412},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3572":1642,"_30844":1619,"_21377":55414,"_5":14632,"_28040":55357,"_3027":55415},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3572":1643,"_30844":1619,"_21377":55417,"_5":14632,"_28040":55357,"_3027":55418},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3572":1644,"_30844":1619,"_21377":55420,"_5":14632,"_28040":55357,"_3027":55421},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3572":1645,"_30844":1619,"_21377":55423,"_5":14632,"_28040":55357,"_3027":55424},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3572":1646,"_30844":1619,"_21377":55426,"_5":14632,"_28040":55357,"_3027":55427},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3572":1647,"_30844":1619,"_21377":55429,"_5":14632,"_28040":55357,"_3027":55430},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3572":1648,"_30844":1619,"_21377":55432,"_5":14632,"_28040":55357,"_3027":55433},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3572":1649,"_30844":1619,"_21377":55435,"_5":14632,"_28040":55360,"_3027":55436},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3572":1650,"_30844":1619,"_21377":55438,"_5":14632,"_28040":55360,"_3027":55439},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3572":1651,"_30844":1619,"_21377":55441,"_5":14632,"_28040":55363,"_3027":55442},[],"Participant",{"_3572":1652,"_30844":1619,"_21377":55444,"_5":14632,"_28040":55363,"_3027":55445},[],"Responsibility",{"_3572":1653,"_30844":1619,"_21377":55447,"_5":14632,"_28040":55363,"_3027":55448},[],"PKI administrator",{"_3572":1654,"_30844":1619,"_21377":55450,"_5":14632,"_28040":55363,"_3027":55451},[],"CA, issuance profile, chain and revocation publication.",{"_3572":1655,"_30844":1619,"_21377":55453,"_5":14632,"_28040":55363,"_3027":55454},[],"Provisioning administrator",{"_3572":1656,"_30844":1619,"_21377":55456,"_5":14632,"_28040":55363,"_3027":55457},[],"DMS, admission, authentication per operation and inventory.",{"_3572":1657,"_30844":1619,"_21377":55459,"_5":14632,"_28040":55363,"_3027":55460},[],"Device integrator",{"_3572":1658,"_30844":1619,"_21377":55462,"_5":14632,"_28040":55363,"_3027":55463},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3572":1659,"_30844":1619,"_21377":55465,"_5":14632,"_28040":55363,"_3027":55466},[],"Consumer integrator",{"_3572":1660,"_30844":1619,"_21377":55468,"_5":14632,"_28040":55363,"_3027":55469},[],"Trusted issuers, validation and device permissions in the destination.",{"_3572":1661,"_30844":1619,"_21377":55471,"_5":14632,"_28040":55363,"_3027":55472},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3572":1662,"_30844":1662,"_5":14996,"_3027":55474,"_31202":55475,"_21377":55477,"_28040":1662},"Enroll and connect your first device",[50349,51888,53048,55476],"Getting started",[],{"_3572":1663,"_30844":1662,"_21377":55479,"_5":14632,"_28040":1662,"_3027":55480},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3572":1664,"_30844":1662,"_5":31199,"_21377":55482,"_28040":55483,"_3027":50359},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3572":1665,"_30844":1662,"_5":31199,"_21377":55485,"_28040":55486,"_3027":55487},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3572":1666,"_30844":1662,"_5":31199,"_21377":55489,"_28040":55490,"_3027":55491},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3572":1667,"_30844":1662,"_5":31199,"_21377":55493,"_28040":55494,"_3027":55495},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3572":1668,"_30844":1662,"_5":31199,"_21377":55497,"_28040":55498,"_3027":55499},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3572":1669,"_30844":1662,"_5":31199,"_21377":55501,"_28040":55502,"_3027":55503},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3572":1670,"_30844":1662,"_5":31199,"_21377":55505,"_28040":55506,"_3027":55507},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3572":1671,"_30844":1662,"_5":31199,"_21377":55509,"_28040":55510,"_3027":55511},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3572":1672,"_30844":1662,"_21377":55513,"_5":14632,"_28040":1662,"_3027":55514},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3572":1673,"_30844":1662,"_21377":55516,"_5":14632,"_28040":55483,"_3027":55517},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3572":1674,"_30844":1662,"_21377":55519,"_5":14632,"_28040":55483,"_3027":55520},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3572":1675,"_30844":1662,"_21377":55522,"_5":14632,"_28040":55483,"_3027":55523},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3572":1676,"_30844":1662,"_21377":55525,"_5":14632,"_28040":55483,"_3027":55526},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3572":1677,"_30844":1662,"_21377":55528,"_5":14632,"_28040":55483,"_3027":55529},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3572":1678,"_30844":1662,"_21377":55531,"_5":14632,"_28040":55486,"_3027":55532},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3572":1679,"_30844":1662,"_21377":55534,"_5":14632,"_28040":55486,"_3027":55535},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3572":1680,"_30844":1662,"_21377":55537,"_5":14632,"_28040":55490,"_3027":55538},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3572":1681,"_30844":1662,"_21377":55540,"_5":14632,"_28040":55490,"_3027":55541},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3572":1682,"_30844":1662,"_21377":55543,"_5":14632,"_28040":55490,"_3027":55544},[],"Setting",{"_3572":1683,"_30844":1662,"_21377":55546,"_5":14632,"_28040":55490,"_3027":55547},[],"Evaluation value",{"_3572":1684,"_30844":1662,"_21377":55549,"_5":14632,"_28040":55490,"_3027":55550},[],"Enrollment CA",{"_3572":1685,"_30844":1662,"_21377":55552,"_5":14632,"_28040":55490,"_3027":55553},[],"Issuing root from `device-root.pem`.",{"_3572":1686,"_30844":1662,"_21377":55555,"_5":14632,"_28040":55490,"_3027":53359},[],{"_3572":1687,"_30844":1662,"_21377":55557,"_5":14632,"_28040":55490,"_3027":55558},[],"The 1-hour leaf profile you just prepared.",{"_3572":1688,"_30844":1662,"_21377":55560,"_5":14632,"_28040":55490,"_3027":55561},[],"Protocol / Registration Mode",{"_3572":1689,"_30844":1662,"_21377":55563,"_5":14632,"_28040":55490,"_3027":55564},[],"`EST_RFC7030` / `JITP`.",{"_3572":1690,"_30844":1662,"_21377":55566,"_5":14632,"_28040":55490,"_3027":55567},[],"Verify CSR Signature",{"_3572":1691,"_30844":1662,"_21377":55569,"_5":14632,"_28040":55490,"_3027":55570},[],"Enabled.",{"_3572":1692,"_30844":1662,"_21377":55572,"_5":14632,"_28040":55490,"_3027":55573},[],"Enable Replaceable Enrollment",{"_3572":1693,"_30844":1662,"_21377":55575,"_5":14632,"_28040":55490,"_3027":55576},[],"Disabled; the ID must be new.",{"_3572":1694,"_30844":1662,"_21377":55578,"_5":14632,"_28040":55490,"_3027":55579},[],"Initial authentication",{"_3572":1695,"_30844":1662,"_21377":55581,"_5":14632,"_28040":55490,"_3027":55582},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3572":1696,"_30844":1662,"_21377":55584,"_5":14632,"_28040":55490,"_3027":55585},[],"Renewal authentication",{"_3572":1697,"_30844":1662,"_21377":55587,"_5":14632,"_28040":55490,"_3027":55588},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3572":1698,"_30844":1662,"_21377":55590,"_5":14632,"_28040":55490,"_3027":55591},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3572":1699,"_30844":1662,"_21377":55593,"_5":14632,"_28040":55490,"_3027":55594},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3572":1700,"_30844":1662,"_21377":55596,"_5":14632,"_28040":55490,"_3027":55597},[],"Re-enrollment Delta",{"_3572":1701,"_30844":1662,"_21377":55599,"_5":14632,"_28040":55490,"_3027":55600},[],"1 hour.",{"_3572":1702,"_30844":1662,"_21377":55602,"_5":14632,"_28040":55490,"_3027":55603},[],"Preventive / Critical Delta",{"_3572":1703,"_30844":1662,"_21377":55605,"_5":14632,"_28040":55490,"_3027":55606},[],"30 minutes / 10 minutes.",{"_3572":1704,"_30844":1662,"_21377":55608,"_5":14632,"_28040":55490,"_3027":55609},[],"Revoke on Re-enrollment",{"_3572":1705,"_30844":1662,"_21377":55611,"_5":14632,"_28040":55490,"_3027":55612},[],"Disabled to test the successor before retiring the previous identity.",{"_3572":1706,"_30844":1662,"_21377":55614,"_5":14632,"_28040":55490,"_3027":53367},[],{"_3572":1707,"_30844":1662,"_21377":55616,"_5":14632,"_28040":55490,"_3027":55617},[],"Disabled; the operational key is generated in the client.",{"_3572":1708,"_30844":1662,"_21377":55619,"_5":14632,"_28040":55490,"_3027":55620},[],"CA Distribution",{"_3572":1709,"_30844":1662,"_21377":55622,"_5":14632,"_28040":55490,"_3027":55623},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3572":1710,"_30844":1662,"_21377":55625,"_5":14632,"_28040":55490,"_3027":55626},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3572":1711,"_30844":1662,"_21377":55628,"_5":14632,"_28040":55494,"_3027":55629},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3572":1712,"_30844":1662,"_21377":55631,"_5":14632,"_28040":55494,"_3027":55632},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3572":1713,"_30844":1662,"_21377":55634,"_5":14632,"_28040":55498,"_3027":55635},[],"Generate a new key and CSR with the selected identifier:",{"_3572":1714,"_30844":1662,"_21377":55637,"_5":14632,"_28040":55498,"_3027":55638},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3572":1715,"_30844":1662,"_21377":55640,"_5":14632,"_28040":55498,"_3027":55641},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3572":1716,"_30844":1662,"_21377":55643,"_5":14632,"_28040":55502,"_3027":55644},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3572":1717,"_30844":1662,"_21377":55646,"_5":14632,"_28040":55502,"_3027":55647},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3572":1718,"_30844":1662,"_21377":55649,"_5":14632,"_28040":55506,"_3027":55650},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3572":1719,"_30844":1662,"_21377":55652,"_5":14632,"_28040":55506,"_3027":55653},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3572":1720,"_30844":1662,"_21377":55655,"_5":14632,"_28040":55506,"_3027":55656},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3572":1721,"_30844":1662,"_21377":55658,"_5":14632,"_28040":55506,"_3027":55659},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3572":1722,"_30844":1662,"_21377":55661,"_5":14632,"_28040":55506,"_3027":55662},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3572":1723,"_30844":1662,"_21377":55664,"_5":14632,"_28040":55510,"_3027":55665},[],"Check",{"_3572":1724,"_30844":1662,"_21377":55667,"_5":14632,"_28040":55510,"_3027":55668},[],"Expected result",{"_3572":1725,"_30844":1662,"_21377":55670,"_5":14632,"_28040":55510,"_3027":55671},[],"Registration",{"_3572":1726,"_30844":1662,"_21377":55673,"_5":14632,"_28040":55510,"_3027":55674},[],"ID created automatically and correct DMS.",{"_3572":1727,"_30844":1662,"_21377":55676,"_5":14632,"_28040":55510,"_3027":54932},[],{"_3572":1728,"_30844":1662,"_21377":55678,"_5":14632,"_28040":55510,"_3027":55679},[],"CN, profile, serial and key verified.",{"_3572":1729,"_30844":1662,"_21377":55681,"_5":14632,"_28040":55510,"_3027":55682},[],"Inventory",{"_3572":1730,"_30844":1662,"_21377":55684,"_5":14632,"_28040":55510,"_3027":55685},[],"Received serial visible as the current identity and in history.",{"_3572":1731,"_30844":1662,"_21377":55687,"_5":14632,"_28040":55510,"_3027":55688},[],"Consumer",{"_3572":1732,"_30844":1662,"_21377":55690,"_5":14632,"_28040":55510,"_3027":55691},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3572":1733,"_30844":1662,"_21377":55693,"_5":14632,"_28040":55510,"_3027":55694},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3572":1734,"_30844":1662,"_21377":55696,"_5":14632,"_28040":55510,"_3027":55697},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3572":1735,"_30844":1735,"_5":14996,"_3027":53064,"_31202":55699,"_21377":55700,"_28040":1735},[50349,51888,53048,55476],[],{"_3572":1736,"_30844":1735,"_21377":55702,"_5":14632,"_28040":1735,"_3027":55703},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3572":1737,"_30844":1735,"_5":31199,"_21377":55705,"_28040":55706,"_3027":50359},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3572":1738,"_30844":1735,"_5":31199,"_21377":55708,"_28040":55709,"_3027":55710},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3572":1739,"_30844":1735,"_5":31199,"_21377":55712,"_28040":55713,"_3027":55714},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3572":1740,"_30844":1735,"_5":31199,"_21377":55716,"_28040":55717,"_3027":55718},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3572":1741,"_30844":1735,"_5":31199,"_21377":55720,"_28040":55721,"_3027":55722},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3572":1742,"_30844":1735,"_5":31199,"_21377":55724,"_28040":55725,"_3027":55726},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3572":1743,"_30844":1735,"_5":31199,"_21377":55728,"_28040":55729,"_3027":55668},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3572":1744,"_30844":1735,"_5":31199,"_21377":55731,"_28040":55732,"_3027":55733},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3572":1745,"_30844":1735,"_5":31199,"_21377":55735,"_28040":55736,"_3027":55737},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3572":1746,"_30844":1735,"_21377":55739,"_5":14632,"_28040":1735,"_3027":55740},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3572":1747,"_30844":1735,"_21377":55742,"_5":14632,"_28040":1735,"_3027":55743},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3572":1748,"_30844":1735,"_21377":55745,"_5":14632,"_28040":55706,"_3027":55746},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3572":1749,"_30844":1735,"_21377":55748,"_5":14632,"_28040":55706,"_3027":55749},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3572":1750,"_30844":1735,"_21377":55751,"_5":14632,"_28040":55706,"_3027":55752},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3572":1751,"_30844":1735,"_21377":55754,"_5":14632,"_28040":55706,"_3027":55755},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3572":1752,"_30844":1735,"_21377":55757,"_5":14632,"_28040":55709,"_3027":55758},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3572":1753,"_30844":1735,"_21377":55760,"_5":14632,"_28040":55709,"_3027":55761},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3572":1754,"_30844":1735,"_21377":55763,"_5":14632,"_28040":55709,"_3027":55764},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3572":1755,"_30844":1735,"_21377":55766,"_5":14632,"_28040":55709,"_3027":55767},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3572":1756,"_30844":1735,"_21377":55769,"_5":14632,"_28040":55709,"_3027":55770},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3572":1757,"_30844":1735,"_21377":55772,"_5":14632,"_28040":55709,"_3027":55773},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3572":1758,"_30844":1735,"_21377":55775,"_5":14632,"_28040":55709,"_3027":55776},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3572":1759,"_30844":1735,"_21377":55778,"_5":14632,"_28040":55709,"_3027":55779},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3572":1760,"_30844":1735,"_21377":55781,"_5":14632,"_28040":55713,"_3027":55782},[],"Open **Managed Devices** and the registration action. Complete:",{"_3572":1761,"_30844":1735,"_21377":55784,"_5":14632,"_28040":55713,"_3027":55785},[],"**Device ID**: `device-001`.",{"_3572":1762,"_30844":1735,"_21377":55787,"_5":14632,"_28040":55713,"_3027":55788},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3572":1763,"_30844":1735,"_21377":55790,"_5":14632,"_28040":55713,"_3027":55791},[],"**Icon** and **Tags**: optional classification.",{"_3572":1764,"_30844":1735,"_21377":55793,"_5":14632,"_28040":55713,"_3027":55794},[],"Confirm registration.",{"_3572":1765,"_30844":1735,"_21377":55796,"_5":14632,"_28040":55717,"_3027":55797},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3572":1766,"_30844":1735,"_21377":55799,"_5":14632,"_28040":55717,"_3027":55800},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3572":1767,"_30844":1735,"_21377":55802,"_5":14632,"_28040":55721,"_3027":55803},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3572":1768,"_30844":1735,"_21377":55805,"_5":14632,"_28040":55721,"_3027":55806},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3572":1769,"_30844":1735,"_21377":55808,"_5":14632,"_28040":55725,"_3027":55809},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3572":1770,"_30844":1735,"_21377":55811,"_5":14632,"_28040":55725,"_3027":55812},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3572":1771,"_30844":1735,"_21377":55814,"_5":14632,"_28040":55729,"_3027":55665},[],{"_3572":1772,"_30844":1735,"_21377":55816,"_5":14632,"_28040":55729,"_3027":55817},[],"Result",{"_3572":1773,"_30844":1735,"_21377":55819,"_5":14632,"_28040":55729,"_3027":54915},[],{"_3572":1774,"_30844":1735,"_21377":55821,"_5":14632,"_28040":55729,"_3027":55822},[],"`device-001` appears in inventory with the expected DMS.",{"_3572":1775,"_30844":1735,"_21377":55824,"_5":14632,"_28040":55729,"_3027":55825},[],"Current identity",{"_3572":1776,"_30844":1735,"_21377":55827,"_5":14632,"_28040":55729,"_3027":55828},[],"The associated certificate matches the one you verified in PKI.",{"_3572":1777,"_30844":1735,"_21377":55830,"_5":14632,"_28040":55729,"_3027":55831},[],"History",{"_3572":1778,"_30844":1735,"_21377":55833,"_5":14632,"_28040":55729,"_3027":55834},[],"The associated issuance appears with its serial number and dates.",{"_3572":1779,"_30844":1735,"_21377":55836,"_5":14632,"_28040":55729,"_3027":55837},[],"Key and certificate",{"_3572":1780,"_30844":1735,"_21377":55839,"_5":14632,"_28040":55729,"_3027":55840},[],"You have the verified pair ready to install on the device.",{"_3572":1781,"_30844":1735,"_21377":55842,"_5":14632,"_28040":55732,"_3027":55843},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3572":1782,"_30844":1735,"_21377":55845,"_5":14632,"_28040":55732,"_3027":55846},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3572":1783,"_30844":1735,"_21377":55848,"_5":14632,"_28040":55732,"_3027":55849},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3572":1784,"_30844":1735,"_21377":55851,"_5":14632,"_28040":55732,"_3027":55852},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3572":1785,"_30844":1735,"_21377":55854,"_5":14632,"_28040":55736,"_3027":55855},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3572":1786,"_30844":1735,"_21377":55857,"_5":14632,"_28040":55736,"_3027":55858},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3572":1787,"_30844":1735,"_21377":55860,"_5":14632,"_28040":55736,"_3027":55861},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3572":1788,"_30844":1788,"_5":14996,"_3027":55863,"_31202":55864,"_21377":55865,"_28040":1788},"Lamassu IoT Platform",[50349,51888],[],{"_3572":1789,"_30844":1788,"_21377":55867,"_5":14632,"_28040":1788,"_3027":55868},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3572":1790,"_30844":1788,"_5":31199,"_21377":55870,"_28040":55871,"_3027":55351},[],"/docs/pr-preview/pr-68/platform/overview#start-here",{"_3572":1791,"_30844":1788,"_5":31199,"_21377":55873,"_28040":55874,"_3027":55875},[],"/docs/pr-preview/pr-68/platform/overview#choose-your-path","Choose your path",{"_3572":1792,"_30844":1788,"_5":31199,"_21377":55877,"_28040":55878,"_3027":55879},[],"/docs/pr-preview/pr-68/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3572":1793,"_30844":1788,"_5":31199,"_21377":55881,"_28040":55882,"_3027":55883},[],"/docs/pr-preview/pr-68/platform/overview#core-capabilities","Core capabilities",{"_3572":1794,"_30844":1788,"_5":31199,"_21377":55885,"_28040":55886,"_3027":55887},[],"/docs/pr-preview/pr-68/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3572":1795,"_30844":1788,"_5":31199,"_21377":55889,"_28040":55890,"_3027":55891},[],"/docs/pr-preview/pr-68/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3572":1796,"_30844":1788,"_5":31199,"_21377":55893,"_28040":55894,"_3027":55895},[],"/docs/pr-preview/pr-68/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3572":1797,"_30844":1788,"_5":31199,"_21377":55897,"_28040":55898,"_3027":55899},[],"/docs/pr-preview/pr-68/platform/overview#automate-device-identities","Automate device identities",{"_3572":1798,"_30844":1788,"_5":31199,"_21377":55901,"_28040":55902,"_3027":55903},[],"/docs/pr-preview/pr-68/platform/overview#publish-validation-status","Publish validation status",{"_3572":1799,"_30844":1788,"_5":31199,"_21377":55905,"_28040":55906,"_3027":55907},[],"/docs/pr-preview/pr-68/platform/overview#react-to-events","React to events",{"_3572":1800,"_30844":1788,"_5":31199,"_21377":55909,"_28040":55910,"_3027":55911},[],"/docs/pr-preview/pr-68/platform/overview#operational-reference","Operational reference",{"_3572":1801,"_30844":1788,"_21377":55913,"_5":14632,"_28040":1788,"_3027":55914},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3572":1802,"_30844":1788,"_21377":55916,"_5":14632,"_28040":55871,"_3027":55917},[],"Choose the result you need:",{"_3572":1803,"_30844":1788,"_21377":55919,"_5":14632,"_28040":55871,"_3027":55920},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3572":1804,"_30844":1788,"_21377":55922,"_5":14632,"_28040":55871,"_3027":55923},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3572":1805,"_30844":1788,"_21377":55925,"_5":14632,"_28040":55871,"_3027":55926},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3572":1806,"_30844":1788,"_21377":55928,"_5":14632,"_28040":55874,"_3027":55929},[],"Section",{"_3572":1807,"_30844":1788,"_21377":55931,"_5":14632,"_28040":55874,"_3027":55932},[],"What you manage",{"_3572":1808,"_30844":1788,"_21377":55934,"_5":14632,"_28040":55874,"_3027":55935},[],"Entry point",{"_3572":1809,"_30844":1788,"_21377":55937,"_5":14632,"_28040":55874,"_3027":55938},[],"**PKI**",{"_3572":1810,"_30844":1788,"_21377":55940,"_5":14632,"_28040":55874,"_3027":55941},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3572":1811,"_30844":1788,"_21377":55943,"_5":14632,"_28040":55874,"_3027":55944},[],"PKI overview",{"_3572":1812,"_30844":1788,"_21377":55946,"_5":14632,"_28040":55874,"_3027":55947},[],"**IoT Fleets**",{"_3572":1813,"_30844":1788,"_21377":55949,"_5":14632,"_28040":55874,"_3027":55950},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3572":1814,"_30844":1788,"_21377":55952,"_5":14632,"_28040":55874,"_3027":55953},[],"IoT Fleets overview",{"_3572":1815,"_30844":1788,"_21377":55955,"_5":14632,"_28040":55874,"_3027":55956},[],"**Administration**",{"_3572":1816,"_30844":1788,"_21377":55958,"_5":14632,"_28040":55874,"_3027":55959},[],"Operator permissions, audit and event subscriptions.",{"_3572":1817,"_30844":1788,"_21377":55961,"_5":14632,"_28040":55874,"_3027":51890},[],{"_3572":1818,"_30844":1788,"_21377":55963,"_5":14632,"_28040":55874,"_3027":55964},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3572":1819,"_30844":1788,"_21377":55966,"_5":14632,"_28040":55878,"_3027":55967},[],"An identity's journey connects four responsibilities:",{"_3572":1820,"_30844":1788,"_21377":55969,"_5":14632,"_28040":55878,"_3027":55970},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3572":1821,"_30844":1788,"_21377":55972,"_5":14632,"_28040":55878,"_3027":55973},[],"The provisioning administrator configures the DMS and initial trust.",{"_3572":1822,"_30844":1788,"_21377":55975,"_5":14632,"_28040":55878,"_3027":55976},[],"The device client requests a certificate and installs it with the matching key.",{"_3572":1823,"_30844":1788,"_21377":55978,"_5":14632,"_28040":55878,"_3027":55979},[],"The consumer validates the identity and applies its access permissions.",{"_3572":1824,"_30844":1788,"_21377":55981,"_5":14632,"_28040":55878,"_3027":55982},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3572":1825,"_30844":1788,"_21377":55984,"_5":14632,"_28040":55886,"_3027":55985},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3572":1826,"_30844":1788,"_21377":55987,"_5":14632,"_28040":55890,"_3027":55988},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3572":1827,"_30844":1788,"_21377":55990,"_5":14632,"_28040":55894,"_3027":55991},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3572":1828,"_30844":1788,"_21377":55993,"_5":14632,"_28040":55898,"_3027":55994},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3572":1829,"_30844":1788,"_21377":55996,"_5":14632,"_28040":55902,"_3027":55997},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3572":1830,"_30844":1788,"_21377":55999,"_5":14632,"_28040":55906,"_3027":56000},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3572":1831,"_30844":1788,"_21377":56002,"_5":14632,"_28040":55910,"_3027":55445},[],{"_3572":1832,"_30844":1788,"_21377":56004,"_5":14632,"_28040":55910,"_3027":56005},[],"What it prepares or checks",{"_3572":1833,"_30844":1788,"_21377":56007,"_5":14632,"_28040":55910,"_3027":55448},[],{"_3572":1834,"_30844":1788,"_21377":56009,"_5":14632,"_28040":55910,"_3027":56010},[],"Key custody, CA hierarchy, profiles and validation.",{"_3572":1835,"_30844":1788,"_21377":56012,"_5":14632,"_28040":55910,"_3027":56013},[],"Fleet administrator",{"_3572":1836,"_30844":1788,"_21377":56015,"_5":14632,"_28040":55910,"_3027":56016},[],"DMS, device admission, renewal policy and inventory.",{"_3572":1837,"_30844":1788,"_21377":56018,"_5":14632,"_28040":55910,"_3027":55460},[],{"_3572":1838,"_30844":1788,"_21377":56020,"_5":14632,"_28040":55910,"_3027":56021},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3572":1839,"_30844":1788,"_21377":56023,"_5":14632,"_28040":55910,"_3027":55466},[],{"_3572":1840,"_30844":1788,"_21377":56025,"_5":14632,"_28040":55910,"_3027":56026},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3572":1841,"_30844":1788,"_21377":56028,"_5":14632,"_28040":55910,"_3027":56029},[],"Infrastructure operator",{"_3572":1842,"_30844":1788,"_21377":56031,"_5":14632,"_28040":55910,"_3027":56032},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3572":1843,"_30844":1788,"_21377":56034,"_5":14632,"_28040":55910,"_3027":56035},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3572":1844,"_30844":1844,"_5":14996,"_3027":56037,"_31202":56038,"_21377":56041,"_28040":1844},"CA hierarchy and rotation",[50349,51888,56039,56040],"PKI","Keys, authorities and certificates",[],{"_3572":1845,"_30844":1844,"_21377":56043,"_5":14632,"_28040":1844,"_3027":56044},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3572":1846,"_30844":1844,"_5":31199,"_21377":56046,"_28040":56047,"_3027":56048},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3572":1847,"_30844":1844,"_5":31199,"_21377":56050,"_28040":56051,"_3027":56052},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3572":1848,"_30844":1844,"_5":31199,"_21377":56054,"_28040":56055,"_3027":56056},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3572":1849,"_30844":1844,"_5":31199,"_21377":56058,"_28040":56059,"_3027":56060},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3572":1850,"_30844":1844,"_5":31199,"_21377":56062,"_28040":56063,"_3027":56064},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3572":1851,"_30844":1844,"_5":31199,"_21377":56066,"_28040":56067,"_3027":56068},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3572":1852,"_30844":1844,"_5":31199,"_21377":56070,"_28040":56071,"_3027":56072},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3572":1853,"_30844":1844,"_5":31199,"_21377":56074,"_28040":56075,"_3027":56076},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3572":1854,"_30844":1844,"_5":31199,"_21377":56078,"_28040":56079,"_3027":56080},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3572":1855,"_30844":1844,"_5":31199,"_21377":56082,"_28040":56083,"_3027":56084},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3572":1856,"_30844":1844,"_5":31199,"_21377":56086,"_28040":56087,"_3027":56088},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3572":1857,"_30844":1844,"_5":31199,"_21377":56090,"_28040":56091,"_3027":56092},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3572":1858,"_30844":1844,"_21377":56094,"_5":14632,"_28040":1844,"_3027":56095},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3572":1859,"_30844":1844,"_21377":56097,"_5":14632,"_28040":1844,"_3027":56098},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3572":1860,"_30844":1844,"_21377":56100,"_5":14632,"_28040":56047,"_3027":56101},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3572":1861,"_30844":1844,"_21377":56103,"_5":14632,"_28040":56047,"_3027":56104},[],"environment, such as production and preproduction;",{"_3572":1862,"_30844":1844,"_21377":56106,"_5":14632,"_28040":56047,"_3027":56107},[],"owner or operating team;",{"_3572":1863,"_30844":1844,"_21377":56109,"_5":14632,"_28040":56047,"_3027":56110},[],"device family or manufacturing process;",{"_3572":1864,"_30844":1844,"_21377":56112,"_5":14632,"_28040":56047,"_3027":56113},[],"region or regulatory requirement;",{"_3572":1865,"_30844":1844,"_21377":56115,"_5":14632,"_28040":56047,"_3027":56116},[],"cryptographic engine or key policy;",{"_3572":1866,"_30844":1844,"_21377":56118,"_5":14632,"_28040":56047,"_3027":56119},[],"maintenance window and renewal cadence.",{"_3572":1867,"_30844":1844,"_21377":56121,"_5":14632,"_28040":56047,"_3027":56122},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3572":1868,"_30844":1844,"_21377":56124,"_5":14632,"_28040":56047,"_3027":56125},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3572":1869,"_30844":1844,"_21377":56127,"_5":14632,"_28040":56051,"_3027":56128},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3572":1870,"_30844":1844,"_21377":56130,"_5":14632,"_28040":56051,"_3027":56131},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3572":1871,"_30844":1844,"_21377":56133,"_5":14632,"_28040":56051,"_3027":56134},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3572":1872,"_30844":1844,"_21377":56136,"_5":14632,"_28040":56051,"_3027":56137},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3572":1873,"_30844":1844,"_21377":56139,"_5":14632,"_28040":56055,"_3027":56140},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3572":1874,"_30844":1844,"_21377":56142,"_5":14632,"_28040":56055,"_3027":56143},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3572":1875,"_30844":1844,"_21377":56145,"_5":14632,"_28040":56055,"_3027":56146},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3572":1876,"_30844":1844,"_21377":56148,"_5":14632,"_28040":56055,"_3027":56149},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3572":1877,"_30844":1844,"_21377":56151,"_5":14632,"_28040":56063,"_3027":56152},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3572":1878,"_30844":1844,"_21377":56154,"_5":14632,"_28040":56067,"_3027":56155},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3572":1879,"_30844":1844,"_21377":56157,"_5":14632,"_28040":56071,"_3027":56158},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3572":1880,"_30844":1844,"_21377":56160,"_5":14632,"_28040":56075,"_3027":56161},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3572":1881,"_30844":1844,"_21377":56163,"_5":14632,"_28040":56079,"_3027":56164},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3572":1882,"_30844":1844,"_21377":56166,"_5":14632,"_28040":56083,"_3027":56167},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3572":1883,"_30844":1844,"_21377":56169,"_5":14632,"_28040":56087,"_3027":56170},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3572":1884,"_30844":1844,"_21377":56172,"_5":14632,"_28040":56087,"_3027":56173},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3572":1885,"_30844":1844,"_21377":56175,"_5":14632,"_28040":56087,"_3027":56176},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3572":1886,"_30844":1844,"_21377":56178,"_5":14632,"_28040":56087,"_3027":56179},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3572":1887,"_30844":1844,"_21377":56181,"_5":14632,"_28040":56091,"_3027":56182},[],"The new chain ends in an anchor installed by the consumer.",{"_3572":1888,"_30844":1844,"_21377":56184,"_5":14632,"_28040":56091,"_3027":56185},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3572":1889,"_30844":1844,"_21377":56187,"_5":14632,"_28040":56091,"_3027":56188},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3572":1890,"_30844":1844,"_21377":56190,"_5":14632,"_28040":56091,"_3027":56191},[],"Re-enrollment accepts the old identity during the planned period.",{"_3572":1891,"_30844":1844,"_21377":56193,"_5":14632,"_28040":56091,"_3027":56194},[],"OCSP and CRL respond for the authorities that remain active.",{"_3572":1892,"_30844":1844,"_21377":56196,"_5":14632,"_28040":56091,"_3027":56197},[],"No DMS is left accidentally issuing from the old CA.",{"_3572":1893,"_30844":1844,"_21377":56199,"_5":14632,"_28040":56091,"_3027":56200},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3572":1894,"_30844":1894,"_5":14996,"_3027":56202,"_31202":56203,"_21377":56204,"_28040":1894},"Certification authorities",[50349,51888,56039,56040],[],{"_3572":1895,"_30844":1894,"_21377":56206,"_5":14632,"_28040":1894,"_3027":56207},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3572":1896,"_30844":1894,"_5":31199,"_21377":56209,"_28040":56210,"_3027":56211},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3572":1897,"_30844":1894,"_5":31199,"_21377":56213,"_28040":56214,"_3027":56215},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3572":1898,"_30844":1894,"_5":31199,"_21377":56217,"_28040":56218,"_3027":50359},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#before-you-begin",{"_3572":1899,"_30844":1894,"_5":31199,"_21377":56220,"_28040":56221,"_3027":56222},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3572":1900,"_30844":1894,"_5":31199,"_21377":56224,"_28040":56225,"_3027":56226},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3572":1901,"_30844":1894,"_5":31199,"_21377":56228,"_28040":56229,"_3027":56230},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3572":1902,"_30844":1894,"_5":31199,"_21377":56232,"_28040":56233,"_3027":56234},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3572":1903,"_30844":1894,"_5":31199,"_21377":56236,"_28040":56237,"_3027":56238},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3572":1904,"_30844":1894,"_5":31199,"_21377":56240,"_28040":56241,"_3027":56242},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3572":1905,"_30844":1894,"_5":31199,"_21377":56244,"_28040":56245,"_3027":56246},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3572":1906,"_30844":1894,"_5":31199,"_21377":56248,"_28040":56249,"_3027":56250},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3572":1907,"_30844":1894,"_5":31199,"_21377":56252,"_28040":56253,"_3027":56254},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3572":1908,"_30844":1894,"_5":31199,"_21377":56256,"_28040":56257,"_3027":56258},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3572":1909,"_30844":1894,"_5":31199,"_21377":56260,"_28040":56261,"_3027":56262},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3572":1910,"_30844":1894,"_5":31199,"_21377":56264,"_28040":56265,"_3027":56266},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3572":1911,"_30844":1894,"_5":31199,"_21377":56268,"_28040":56269,"_3027":56270},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3572":1912,"_30844":1894,"_5":31199,"_21377":56272,"_28040":56273,"_3027":56274},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3572":1913,"_30844":1894,"_5":31199,"_21377":56276,"_28040":56277,"_3027":56278},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3572":1914,"_30844":1894,"_5":31199,"_21377":56280,"_28040":56281,"_3027":56282},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3572":1915,"_30844":1894,"_5":31199,"_21377":56284,"_28040":56285,"_3027":56286},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3572":1916,"_30844":1894,"_5":31199,"_21377":56288,"_28040":56289,"_3027":56290},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3572":1917,"_30844":1894,"_5":31199,"_21377":56292,"_28040":56293,"_3027":56294},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3572":1918,"_30844":1894,"_5":31199,"_21377":56296,"_28040":56297,"_3027":56298},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3572":1919,"_30844":1894,"_21377":56300,"_5":14632,"_28040":1894,"_3027":56301},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3572":1920,"_30844":1894,"_21377":56303,"_5":14632,"_28040":1894,"_3027":56304},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3572":1921,"_30844":1894,"_21377":56306,"_5":14632,"_28040":1894,"_3027":56307},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3572":1922,"_30844":1894,"_21377":56309,"_5":14632,"_28040":56210,"_3027":56310},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3572":1923,"_30844":1894,"_21377":56312,"_5":14632,"_28040":56210,"_3027":56313},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3572":1924,"_30844":1894,"_21377":56315,"_5":14632,"_28040":56210,"_3027":56316},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3572":1925,"_30844":1894,"_21377":56318,"_5":14632,"_28040":56210,"_3027":56319},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3572":1926,"_30844":1894,"_21377":56321,"_5":14632,"_28040":56210,"_3027":56322},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3572":1927,"_30844":1894,"_21377":56324,"_5":14632,"_28040":56218,"_3027":56325},[],"Decide whether the CA will be a root or an intermediate.",{"_3572":1928,"_30844":1894,"_21377":56327,"_5":14632,"_28040":56218,"_3027":56328},[],"Choose the engine that will keep the key.",{"_3572":1929,"_30844":1894,"_21377":56330,"_5":14632,"_28040":56218,"_3027":56331},[],"Define a validity longer than that of the certificates it will issue.",{"_3572":1930,"_30844":1894,"_21377":56333,"_5":14632,"_28040":56218,"_3027":56334},[],"For an intermediate CA, make sure the parent CA is active.",{"_3572":1931,"_30844":1894,"_21377":56336,"_5":14632,"_28040":56221,"_3027":56337},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3572":1932,"_30844":1894,"_21377":56339,"_5":14632,"_28040":56225,"_3027":56340},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3572":1933,"_30844":1894,"_21377":56342,"_5":14632,"_28040":56225,"_3027":56343},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3572":1934,"_30844":1894,"_21377":56345,"_5":14632,"_28040":56229,"_3027":56346},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3572":1935,"_30844":1894,"_21377":56348,"_5":14632,"_28040":56233,"_3027":56349},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3572":1936,"_30844":1894,"_21377":56351,"_5":14632,"_28040":56233,"_3027":56352},[],"`C`: two-letter ISO 3166-1 country code.",{"_3572":1937,"_30844":1894,"_21377":56354,"_5":14632,"_28040":56233,"_3027":56355},[],"`ST`: state or province.",{"_3572":1938,"_30844":1894,"_21377":56357,"_5":14632,"_28040":56233,"_3027":56358},[],"`L`: locality.",{"_3572":1939,"_30844":1894,"_21377":56360,"_5":14632,"_28040":56233,"_3027":56361},[],"`O`: organization.",{"_3572":1940,"_30844":1894,"_21377":56363,"_5":14632,"_28040":56233,"_3027":56364},[],"`OU`: organizational unit.",{"_3572":1941,"_30844":1894,"_21377":56366,"_5":14632,"_28040":56233,"_3027":56367},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3572":1942,"_30844":1894,"_21377":56369,"_5":14632,"_28040":56237,"_3027":56370},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3572":1943,"_30844":1894,"_21377":56372,"_5":14632,"_28040":56237,"_3027":56373},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3572":1944,"_30844":1894,"_21377":56375,"_5":14632,"_28040":56241,"_3027":56376},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3572":1945,"_30844":1894,"_21377":56378,"_5":14632,"_28040":56241,"_3027":56379},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3572":1946,"_30844":1894,"_21377":56381,"_5":14632,"_28040":56245,"_3027":56382},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3572":1947,"_30844":1894,"_21377":56384,"_5":14632,"_28040":56245,"_3027":56385},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3572":1948,"_30844":1894,"_21377":56387,"_5":14632,"_28040":56249,"_3027":56388},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3572":1949,"_30844":1894,"_21377":56390,"_5":14632,"_28040":56249,"_3027":56391},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3572":1950,"_30844":1894,"_21377":56393,"_5":14632,"_28040":56249,"_3027":56394},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3572":1951,"_30844":1894,"_21377":56396,"_5":14632,"_28040":56253,"_3027":56397},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3572":1952,"_30844":1894,"_21377":56399,"_5":14632,"_28040":56257,"_3027":56400},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3572":1953,"_30844":1894,"_21377":56402,"_5":14632,"_28040":56257,"_3027":56403},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3572":1954,"_30844":1894,"_21377":56405,"_5":14632,"_28040":56261,"_3027":56406},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3572":1955,"_30844":1894,"_21377":56408,"_5":14632,"_28040":56265,"_3027":56409},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3572":1956,"_30844":1894,"_21377":56411,"_5":14632,"_28040":56265,"_3027":56412},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3572":1957,"_30844":1894,"_21377":56414,"_5":14632,"_28040":56269,"_3027":56415},[],"Open a CA from the inventory to review:",{"_3572":1958,"_30844":1894,"_21377":56417,"_5":14632,"_28040":56269,"_3027":56418},[],"Status and validity period.",{"_3572":1959,"_30844":1894,"_21377":56420,"_5":14632,"_28040":56269,"_3027":56421},[],"Certificate and chain in PEM format.",{"_3572":1960,"_30844":1894,"_21377":56423,"_5":14632,"_28040":56269,"_3027":56424},[],"Number of active, expired and revoked certificates.",{"_3572":1961,"_30844":1894,"_21377":56426,"_5":14632,"_28040":56269,"_3027":56427},[],"Certificates issued in **Issued Certificates**.",{"_3572":1962,"_30844":1894,"_21377":56429,"_5":14632,"_28040":56269,"_3027":56430},[],"The CRL linked to the authority.",{"_3572":1963,"_30844":1894,"_21377":56432,"_5":14632,"_28040":56269,"_3027":56433},[],"Metadata and the associated cryptographic engine.",{"_3572":1964,"_30844":1894,"_21377":56435,"_5":14632,"_28040":56269,"_3027":56436},[],"You can filter the inventory by name, status and CA type.",{"_3572":1965,"_30844":1894,"_21377":56438,"_5":14632,"_28040":56273,"_3027":56439},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3572":1966,"_30844":1894,"_21377":56441,"_5":14632,"_28040":56273,"_3027":56442},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3572":1967,"_30844":1894,"_21377":56444,"_5":14632,"_28040":56273,"_3027":56445},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3572":1968,"_30844":1894,"_21377":56447,"_5":14632,"_28040":56273,"_3027":56448},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3572":1969,"_30844":1894,"_21377":56450,"_5":14632,"_28040":56277,"_3027":56451},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3572":1970,"_30844":1894,"_21377":56453,"_5":14632,"_28040":56281,"_3027":56454},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3572":1971,"_30844":1894,"_21377":56456,"_5":14632,"_28040":56285,"_3027":56457},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3572":1972,"_30844":1894,"_21377":56459,"_5":14632,"_28040":56289,"_3027":56460},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3572":1973,"_30844":1894,"_21377":56462,"_5":14632,"_28040":56293,"_3027":56463},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3572":1974,"_30844":1894,"_21377":56465,"_5":14632,"_28040":56297,"_3027":56466},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3572":1975,"_30844":1894,"_21377":56468,"_5":14632,"_28040":56297,"_3027":56469},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3572":1976,"_30844":1894,"_21377":56471,"_5":14632,"_28040":56297,"_3027":56472},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3572":1977,"_30844":1894,"_21377":56474,"_5":14632,"_28040":56297,"_3027":56475},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3572":1978,"_30844":1978,"_5":14996,"_3027":56477,"_31202":56478,"_21377":56479,"_28040":1978},"Certificate profiles",[50349,51888,56039,56040],[],{"_3572":1979,"_30844":1978,"_21377":56481,"_5":14632,"_28040":1978,"_3027":56482},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3572":1980,"_30844":1978,"_5":31199,"_21377":56484,"_28040":56485,"_3027":56486},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3572":1981,"_30844":1978,"_5":31199,"_21377":56488,"_28040":56489,"_3027":56490},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#validity","Validity",{"_3572":1982,"_30844":1978,"_5":31199,"_21377":56492,"_28040":56493,"_3027":56494},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3572":1983,"_30844":1978,"_5":31199,"_21377":56496,"_28040":56497,"_3027":56498},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3572":1984,"_30844":1978,"_5":31199,"_21377":56500,"_28040":56501,"_3027":56502},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#subject","Subject",{"_3572":1985,"_30844":1978,"_5":31199,"_21377":56504,"_28040":56505,"_3027":56506},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3572":1986,"_30844":1978,"_5":31199,"_21377":56508,"_28040":56509,"_3027":56510},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3572":1987,"_30844":1978,"_5":31199,"_21377":56512,"_28040":56513,"_3027":56514},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3572":1988,"_30844":1978,"_5":31199,"_21377":56516,"_28040":56517,"_3027":56518},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3572":1989,"_30844":1978,"_5":31199,"_21377":56520,"_28040":56521,"_3027":56522},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3572":1990,"_30844":1978,"_5":31199,"_21377":56524,"_28040":56525,"_3027":56526},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3572":1991,"_30844":1978,"_5":31199,"_21377":56528,"_28040":56529,"_3027":56530},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3572":1992,"_30844":1978,"_5":31199,"_21377":56532,"_28040":56533,"_3027":56534},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3572":1993,"_30844":1978,"_5":31199,"_21377":56536,"_28040":56537,"_3027":56538},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3572":1994,"_30844":1978,"_5":31199,"_21377":56540,"_28040":56541,"_3027":56542},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#design-examples","Design examples",{"_3572":1995,"_30844":1978,"_5":31199,"_21377":56544,"_28040":56545,"_3027":56546},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3572":1996,"_30844":1978,"_21377":56548,"_5":14632,"_28040":1978,"_3027":56549},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3572":1997,"_30844":1978,"_21377":56551,"_5":14632,"_28040":1978,"_3027":56552},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3572":1998,"_30844":1978,"_21377":56554,"_5":14632,"_28040":56489,"_3027":56555},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3572":1999,"_30844":1978,"_21377":56557,"_5":14632,"_28040":56489,"_3027":56558},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3572":2000,"_30844":1978,"_21377":56560,"_5":14632,"_28040":56493,"_3027":56561},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3572":2001,"_30844":1978,"_21377":56563,"_5":14632,"_28040":56497,"_3027":56564},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3572":2002,"_30844":1978,"_21377":56566,"_5":14632,"_28040":56497,"_3027":56567},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3572":2003,"_30844":1978,"_21377":56569,"_5":14632,"_28040":56497,"_3027":56570},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3572":2004,"_30844":1978,"_21377":56572,"_5":14632,"_28040":56501,"_3027":56573},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3572":2005,"_30844":1978,"_21377":56575,"_5":14632,"_28040":56505,"_3027":56576},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3572":2006,"_30844":1978,"_21377":56578,"_5":14632,"_28040":56505,"_3027":56579},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3572":2007,"_30844":1978,"_21377":56581,"_5":14632,"_28040":56509,"_3027":56582},[],"The cryptographic enforcement can:",{"_3572":2008,"_30844":1978,"_21377":56584,"_5":14632,"_28040":56509,"_3027":56585},[],"allow or block RSA keys;",{"_3572":2009,"_30844":1978,"_21377":56587,"_5":14632,"_28040":56509,"_3027":56588},[],"limit the supported RSA sizes;",{"_3572":2010,"_30844":1978,"_21377":56590,"_5":14632,"_28040":56509,"_3027":56591},[],"allow or block ECDSA keys;",{"_3572":2011,"_30844":1978,"_21377":56593,"_5":14632,"_28040":56509,"_3027":56594},[],"limit the supported ECDSA sizes or curves.",{"_3572":2012,"_30844":1978,"_21377":56596,"_5":14632,"_28040":56509,"_3027":56597},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3572":2013,"_30844":1978,"_21377":56599,"_5":14632,"_28040":56513,"_3027":56600},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3572":2014,"_30844":1978,"_21377":56602,"_5":14632,"_28040":56513,"_3027":53801},[],{"_3572":2015,"_30844":1978,"_21377":56604,"_5":14632,"_28040":56513,"_3027":56605},[],"First choice",{"_3572":2016,"_30844":1978,"_21377":56607,"_5":14632,"_28040":56513,"_3027":56608},[],"Second choice",{"_3572":2017,"_30844":1978,"_21377":56610,"_5":14632,"_28040":56513,"_3027":56611},[],"If neither is supplied",{"_3572":2018,"_30844":1978,"_21377":56613,"_5":14632,"_28040":56513,"_3027":56614},[],"Direct signing with a CA",{"_3572":2019,"_30844":1978,"_21377":56616,"_5":14632,"_28040":56513,"_3027":56617},[],"`issuance_profile` embedded in the request",{"_3572":2020,"_30844":1978,"_21377":56619,"_5":14632,"_28040":56513,"_3027":56620},[],"Request `issuance_profile_id`",{"_3572":2021,"_30844":1978,"_21377":56622,"_5":14632,"_28040":56513,"_3027":56623},[],"CA default profile (`profile_id`).",{"_3572":2022,"_30844":1978,"_21377":56625,"_5":14632,"_28040":56513,"_3027":56626},[],"Issuance through a DMS",{"_3572":2023,"_30844":1978,"_21377":56628,"_5":14632,"_28040":56513,"_3027":56629},[],"`settings.issuance_profile_id`",{"_3572":2024,"_30844":1978,"_21377":56631,"_5":14632,"_28040":56513,"_3027":56632},[],"`settings.issuance_profile` embedded in the DMS",{"_3572":2025,"_30844":1978,"_21377":56634,"_5":14632,"_28040":56513,"_3027":56635},[],"Enrollment CA default profile.",{"_3572":2026,"_30844":1978,"_21377":56637,"_5":14632,"_28040":56513,"_3027":56638},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3572":2027,"_30844":1978,"_21377":56640,"_5":14632,"_28040":56513,"_3027":56641},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3572":2028,"_30844":1978,"_21377":56643,"_5":14632,"_28040":56521,"_3027":56644},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3572":2029,"_30844":1978,"_21377":56646,"_5":14632,"_28040":56525,"_3027":56647},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3572":2030,"_30844":1978,"_21377":56649,"_5":14632,"_28040":56529,"_3027":56650},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3572":2031,"_30844":1978,"_21377":56652,"_5":14632,"_28040":56533,"_3027":56653},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3572":2032,"_30844":1978,"_21377":56655,"_5":14632,"_28040":56537,"_3027":56656},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3572":2033,"_30844":1978,"_21377":56658,"_5":14632,"_28040":56537,"_3027":56659},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3572":2034,"_30844":1978,"_21377":56661,"_5":14632,"_28040":56541,"_3027":56662},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3572":2035,"_30844":1978,"_21377":56664,"_5":14632,"_28040":56541,"_3027":56665},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3572":2036,"_30844":1978,"_21377":56667,"_5":14632,"_28040":56541,"_3027":56668},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3572":2037,"_30844":1978,"_21377":56670,"_5":14632,"_28040":56541,"_3027":56671},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3572":2038,"_30844":1978,"_21377":56673,"_5":14632,"_28040":56545,"_3027":56674},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3572":2039,"_30844":1978,"_21377":56676,"_5":14632,"_28040":56545,"_3027":56677},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3572":2040,"_30844":2040,"_5":14996,"_3027":56679,"_31202":56680,"_21377":56682,"_28040":2040},"Certificate validation",[50349,51888,56039,56681],"Validation",[],{"_3572":2041,"_30844":2040,"_21377":56684,"_5":14632,"_28040":2040,"_3027":56685},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3572":2042,"_30844":2040,"_5":31199,"_21377":56687,"_28040":56688,"_3027":56689},[],"/docs/pr-preview/pr-68/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3572":2043,"_30844":2040,"_5":31199,"_21377":56691,"_28040":56692,"_3027":56693},[],"/docs/pr-preview/pr-68/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3572":2044,"_30844":2040,"_5":31199,"_21377":56695,"_28040":56696,"_3027":56697},[],"/docs/pr-preview/pr-68/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3572":2045,"_30844":2040,"_21377":56699,"_5":14632,"_28040":2040,"_3027":56700},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3572":2046,"_30844":2040,"_21377":56702,"_5":14632,"_28040":56688,"_3027":56703},[],"Verify these criteria together:",{"_3572":2047,"_30844":2040,"_21377":56705,"_5":14632,"_28040":56688,"_3027":55665},[],{"_3572":2048,"_30844":2040,"_21377":56707,"_5":14632,"_28040":56688,"_3027":56708},[],"Required result",{"_3572":2049,"_30844":2040,"_21377":56710,"_5":14632,"_28040":56688,"_3027":56711},[],"Chain and signature",{"_3572":2050,"_30844":2040,"_21377":56713,"_5":14632,"_28040":56688,"_3027":56714},[],"Valid chain to a root deliberately installed in the consumer.",{"_3572":2051,"_30844":2040,"_21377":56716,"_5":14632,"_28040":56688,"_3027":56717},[],"Dates",{"_3572":2052,"_30844":2040,"_21377":56719,"_5":14632,"_28040":56688,"_3027":56720},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3572":2053,"_30844":2040,"_21377":56722,"_5":14632,"_28040":56688,"_3027":51548},[],{"_3572":2054,"_30844":2040,"_21377":56724,"_5":14632,"_28040":56688,"_3027":56725},[],"Name, SAN or identifier matches the expected peer.",{"_3572":2055,"_30844":2040,"_21377":56727,"_5":14632,"_28040":56688,"_3027":50739},[],{"_3572":2056,"_30844":2040,"_21377":56729,"_5":14632,"_28040":56688,"_3027":56730},[],"KU, EKU and constraints permit the specific operation.",{"_3572":2057,"_30844":2040,"_21377":56732,"_5":14632,"_28040":56688,"_3027":56733},[],"Revocation",{"_3572":2058,"_30844":2040,"_21377":56735,"_5":14632,"_28040":56688,"_3027":56736},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3572":2059,"_30844":2040,"_21377":56738,"_5":14632,"_28040":56688,"_3027":56739},[],"Authorization",{"_3572":2060,"_30844":2040,"_21377":56741,"_5":14632,"_28040":56688,"_3027":56742},[],"The application permits that identity to perform the action.",{"_3572":2061,"_30844":2040,"_21377":56744,"_5":14632,"_28040":56688,"_3027":56745},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3572":2062,"_30844":2040,"_21377":56747,"_5":14632,"_28040":56692,"_3027":56748},[],"Mechanism",{"_3572":2063,"_30844":2040,"_21377":56750,"_5":14632,"_28040":56692,"_3027":56751},[],"When to use it",{"_3572":2064,"_30844":2040,"_21377":56753,"_5":14632,"_28040":56692,"_3027":56754},[],"What you must maintain",{"_3572":2065,"_30844":2040,"_21377":56756,"_5":14632,"_28040":56692,"_3027":56757},[],"OCSP",{"_3572":2066,"_30844":2040,"_21377":56759,"_5":14632,"_28040":56692,"_3027":56760},[],"Status query for a specific certificate.",{"_3572":2067,"_30844":2040,"_21377":56762,"_5":14632,"_28040":56692,"_3027":56763},[],"Responder access, signature verification and cache/freshness policy.",{"_3572":2068,"_30844":2040,"_21377":56765,"_5":14632,"_28040":56692,"_3027":56766},[],"CRL",{"_3572":2069,"_30844":2040,"_21377":56768,"_5":14632,"_28040":56692,"_3027":56769},[],"Local checks for many certificates or offline operation.",{"_3572":2070,"_30844":2040,"_21377":56771,"_5":14632,"_28040":56692,"_3027":56772},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3572":2071,"_30844":2040,"_21377":56774,"_5":14632,"_28040":56692,"_3027":56775},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3572":2072,"_30844":2040,"_21377":56777,"_5":14632,"_28040":56692,"_3027":56778},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3572":2073,"_30844":2040,"_21377":56780,"_5":14632,"_28040":56696,"_3027":56781},[],"Accept a current, authorized certificate with a known chain.",{"_3572":2074,"_30844":2040,"_21377":56783,"_5":14632,"_28040":56696,"_3027":56784},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3572":2075,"_30844":2040,"_21377":56786,"_5":14632,"_28040":56696,"_3027":56787},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3572":2076,"_30844":2040,"_21377":56789,"_5":14632,"_28040":56696,"_3027":56790},[],"Check that a new connection with that identity is rejected.",{"_3572":2077,"_30844":2040,"_21377":56792,"_5":14632,"_28040":56696,"_3027":56793},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3572":2078,"_30844":2040,"_21377":56795,"_5":14632,"_28040":56696,"_3027":56796},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3572":2079,"_30844":2040,"_21377":56798,"_5":14632,"_28040":56696,"_3027":56799},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3572":2080,"_30844":2040,"_21377":56801,"_5":14632,"_28040":56696,"_3027":56802},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3572":2081,"_30844":2040,"_21377":56804,"_5":14632,"_28040":56696,"_3027":56805},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3572":2082,"_30844":2082,"_5":14996,"_3027":56807,"_31202":56808,"_21377":56809,"_28040":2082},"Certificates",[50349,51888,56039,56040],[],{"_3572":2083,"_30844":2082,"_21377":56811,"_5":14632,"_28040":2082,"_3027":56812},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3572":2084,"_30844":2082,"_5":31199,"_21377":56814,"_28040":56815,"_3027":56816},[],"/docs/pr-preview/pr-68/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3572":2085,"_30844":2082,"_5":31199,"_21377":56818,"_28040":56819,"_3027":56820},[],"/docs/pr-preview/pr-68/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3572":2086,"_30844":2082,"_5":31199,"_21377":56822,"_28040":56823,"_3027":56824},[],"/docs/pr-preview/pr-68/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3572":2087,"_30844":2082,"_5":31199,"_21377":56826,"_28040":56827,"_3027":56828},[],"/docs/pr-preview/pr-68/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3572":2088,"_30844":2082,"_5":31199,"_21377":56830,"_28040":56831,"_3027":56832},[],"/docs/pr-preview/pr-68/platform/pki/certificates#open-the-action","Open the action",{"_3572":2089,"_30844":2082,"_5":31199,"_21377":56834,"_28040":56835,"_3027":56836},[],"/docs/pr-preview/pr-68/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3572":2090,"_30844":2082,"_5":31199,"_21377":56838,"_28040":56839,"_3027":56840},[],"/docs/pr-preview/pr-68/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3572":2091,"_30844":2082,"_5":31199,"_21377":56842,"_28040":56843,"_3027":56844},[],"/docs/pr-preview/pr-68/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3572":2092,"_30844":2082,"_5":31199,"_21377":56846,"_28040":56847,"_3027":56848},[],"/docs/pr-preview/pr-68/platform/pki/certificates#continue","Continue",{"_3572":2093,"_30844":2082,"_21377":56850,"_5":14632,"_28040":2082,"_3027":56851},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3572":2094,"_30844":2082,"_21377":56853,"_5":14632,"_28040":56815,"_3027":56854},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3572":2095,"_30844":2082,"_21377":56856,"_5":14632,"_28040":56815,"_3027":56857},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3572":2096,"_30844":2082,"_21377":56859,"_5":14632,"_28040":56815,"_3027":56860},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3572":2097,"_30844":2082,"_21377":56862,"_5":14632,"_28040":56815,"_3027":56863},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3572":2098,"_30844":2082,"_21377":56865,"_5":14632,"_28040":56815,"_3027":56866},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3572":2099,"_30844":2082,"_21377":56868,"_5":14632,"_28040":56815,"_3027":56869},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3572":2100,"_30844":2082,"_21377":56871,"_5":14632,"_28040":56815,"_3027":56872},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3572":2101,"_30844":2082,"_21377":56874,"_5":14632,"_28040":56819,"_3027":56875},[],"Download the PEM and inspect it:",{"_3572":2102,"_30844":2082,"_21377":56877,"_5":14632,"_28040":56819,"_3027":56878},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3572":2103,"_30844":2082,"_21377":56880,"_5":14632,"_28040":56823,"_3027":56881},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3572":2104,"_30844":2082,"_21377":56883,"_5":14632,"_28040":56823,"_3027":56884},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3572":2105,"_30844":2082,"_21377":56886,"_5":14632,"_28040":56823,"_3027":56887},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3572":2106,"_30844":2082,"_21377":56889,"_5":14632,"_28040":56823,"_3027":56890},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3572":2107,"_30844":2082,"_21377":56892,"_5":14632,"_28040":56823,"_3027":56893},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3572":2108,"_30844":2082,"_21377":56895,"_5":14632,"_28040":56823,"_3027":56896},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3572":2109,"_30844":2082,"_21377":56898,"_5":14632,"_28040":56823,"_3027":56899},[],"For browser key generation, follow Issue your first certificate.",{"_3572":2110,"_30844":2082,"_21377":56901,"_5":14632,"_28040":56827,"_3027":56902},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3572":2111,"_30844":2082,"_21377":56904,"_5":14632,"_28040":56831,"_3027":56905},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3572":2112,"_30844":2082,"_21377":56907,"_5":14632,"_28040":56835,"_3027":56908},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3572":2113,"_30844":2082,"_21377":56910,"_5":14632,"_28040":56839,"_3027":56911},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3572":2114,"_30844":2082,"_21377":56913,"_5":14632,"_28040":56839,"_3027":56914},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3572":2115,"_30844":2082,"_21377":56916,"_5":14632,"_28040":56839,"_3027":56917},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3572":2116,"_30844":2082,"_21377":56919,"_5":14632,"_28040":56843,"_3027":56920},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3572":2117,"_30844":2082,"_21377":56922,"_5":14632,"_28040":56843,"_3027":56923},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3572":2118,"_30844":2082,"_21377":56925,"_5":14632,"_28040":56843,"_3027":56926},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3572":2119,"_30844":2082,"_21377":56928,"_5":14632,"_28040":56847,"_3027":56929},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3572":2120,"_30844":2082,"_21377":56931,"_5":14632,"_28040":56847,"_3027":56932},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3572":2121,"_30844":2121,"_5":14996,"_3027":56934,"_31202":56935,"_21377":56937,"_28040":2121},"Certificate lifecycle",[50349,51888,56039,56936],"Concepts",[],{"_3572":2122,"_30844":2121,"_21377":56939,"_5":14632,"_28040":2121,"_3027":56940},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3572":2123,"_30844":2121,"_5":31199,"_21377":56942,"_28040":56943,"_3027":56944},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3572":2124,"_30844":2121,"_5":31199,"_21377":56946,"_28040":56947,"_3027":56948},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3572":2125,"_30844":2121,"_5":31199,"_21377":56950,"_28040":56951,"_3027":56952},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3572":2126,"_30844":2121,"_5":31199,"_21377":56954,"_28040":56955,"_3027":56956},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3572":2127,"_30844":2121,"_5":31199,"_21377":56958,"_28040":56959,"_3027":56960},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3572":2128,"_30844":2121,"_5":31199,"_21377":56962,"_28040":56963,"_3027":56964},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3572":2129,"_30844":2121,"_5":31199,"_21377":56966,"_28040":56967,"_3027":56968},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3572":2130,"_30844":2121,"_5":31199,"_21377":56970,"_28040":56971,"_3027":56972},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3572":2131,"_30844":2121,"_5":31199,"_21377":56974,"_28040":56975,"_3027":56976},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3572":2132,"_30844":2121,"_5":31199,"_21377":56978,"_28040":56979,"_3027":56980},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3572":2133,"_30844":2121,"_21377":56982,"_5":14632,"_28040":2121,"_3027":56983},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3572":2134,"_30844":2121,"_21377":56985,"_5":14632,"_28040":56947,"_3027":56986},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3572":2135,"_30844":2121,"_21377":56988,"_5":14632,"_28040":56951,"_3027":56989},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3572":2136,"_30844":2121,"_21377":56991,"_5":14632,"_28040":56955,"_3027":56992},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3572":2137,"_30844":2121,"_21377":56994,"_5":14632,"_28040":56959,"_3027":56995},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3572":2138,"_30844":2121,"_21377":56997,"_5":14632,"_28040":56963,"_3027":56998},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3572":2139,"_30844":2121,"_21377":57000,"_5":14632,"_28040":56967,"_3027":57001},[],"Lamassu persists four X.509 states:",{"_3572":2140,"_30844":2121,"_21377":57003,"_5":14632,"_28040":56967,"_3027":57004},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3572":2141,"_30844":2121,"_21377":57006,"_5":14632,"_28040":56967,"_3027":57007},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3572":2142,"_30844":2121,"_21377":57009,"_5":14632,"_28040":56967,"_3027":57010},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3572":2143,"_30844":2121,"_21377":57012,"_5":14632,"_28040":56967,"_3027":57013},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3572":2144,"_30844":2121,"_21377":57015,"_5":14632,"_28040":56967,"_3027":57016},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3572":2145,"_30844":2121,"_21377":57018,"_5":14632,"_28040":56971,"_3027":57019},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3572":2146,"_30844":2121,"_21377":57021,"_5":14632,"_28040":56971,"_3027":57022},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3572":2147,"_30844":2121,"_21377":57024,"_5":14632,"_28040":56971,"_3027":57025},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3572":2148,"_30844":2121,"_21377":57027,"_5":14632,"_28040":56975,"_3027":57028},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3572":2149,"_30844":2121,"_21377":57030,"_5":14632,"_28040":56975,"_3027":57031},[],"Before confirming:",{"_3572":2150,"_30844":2121,"_21377":57033,"_5":14632,"_28040":56975,"_3027":57034},[],"Identify DMSs, devices and services that trust that chain.",{"_3572":2151,"_30844":2121,"_21377":57036,"_5":14632,"_28040":56975,"_3027":57037},[],"Distribute the new chain of trust.",{"_3572":2152,"_30844":2121,"_21377":57039,"_5":14632,"_28040":56975,"_3027":57040},[],"Reissue the necessary identities.",{"_3572":2153,"_30844":2121,"_21377":57042,"_5":14632,"_28040":56975,"_3027":57043},[],"Check OCSP and CRL from a real consumer.",{"_3572":2154,"_30844":2121,"_21377":57045,"_5":14632,"_28040":56975,"_3027":57046},[],"Revoke the old CA once no legitimate traffic remains.",{"_3572":2155,"_30844":2121,"_21377":57048,"_5":14632,"_28040":56975,"_3027":57049},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3572":2156,"_30844":2121,"_21377":57051,"_5":14632,"_28040":56979,"_3027":57052},[],"Certificates entering the preventive or critical renewal window.",{"_3572":2157,"_30844":2121,"_21377":57054,"_5":14632,"_28040":56979,"_3027":57055},[],"Repeated enrollment or re-enrollment failures.",{"_3572":2158,"_30844":2121,"_21377":57057,"_5":14632,"_28040":56979,"_3027":57058},[],"Status changes and revocation reasons.",{"_3572":2159,"_30844":2121,"_21377":57060,"_5":14632,"_28040":56979,"_3027":57061},[],"OCSP and CRL publication and validity.",{"_3572":2160,"_30844":2121,"_21377":57063,"_5":14632,"_28040":56979,"_3027":57064},[],"Dependencies still presenting a replaced certificate.",{"_3572":2161,"_30844":2121,"_21377":57066,"_5":14632,"_28040":56979,"_3027":57067},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3572":2162,"_30844":2162,"_5":14996,"_3027":57069,"_31202":57070,"_21377":57071,"_28040":2162},"Trust model",[50349,51888,56039,56936],[],{"_3572":2163,"_30844":2162,"_21377":57073,"_5":14632,"_28040":2162,"_3027":57074},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3572":2164,"_30844":2162,"_5":31199,"_21377":57076,"_28040":57077,"_3027":57078},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3572":2165,"_30844":2162,"_5":31199,"_21377":57080,"_28040":57081,"_3027":57082},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3572":2166,"_30844":2162,"_5":31199,"_21377":57084,"_28040":57085,"_3027":57086},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3572":2167,"_30844":2162,"_5":31199,"_21377":57088,"_28040":57089,"_3027":57090},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3572":2168,"_30844":2162,"_5":31199,"_21377":57092,"_28040":57093,"_3027":57094},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3572":2169,"_30844":2162,"_5":31199,"_21377":57096,"_28040":57097,"_3027":57098},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3572":2170,"_30844":2162,"_5":31199,"_21377":57100,"_28040":57101,"_3027":57102},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3572":2171,"_30844":2162,"_5":31199,"_21377":57104,"_28040":57105,"_3027":57106},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3572":2172,"_30844":2162,"_5":31199,"_21377":57108,"_28040":57109,"_3027":57110},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3572":2173,"_30844":2162,"_5":31199,"_21377":57112,"_28040":57113,"_3027":57114},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3572":2174,"_30844":2162,"_21377":57116,"_5":14632,"_28040":2162,"_3027":57117},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3572":2175,"_30844":2162,"_21377":57119,"_5":14632,"_28040":57081,"_3027":57120},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3572":2176,"_30844":2162,"_21377":57122,"_5":14632,"_28040":57085,"_3027":57123},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3572":2177,"_30844":2162,"_21377":57125,"_5":14632,"_28040":57089,"_3027":57126},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3572":2178,"_30844":2162,"_21377":57128,"_5":14632,"_28040":57093,"_3027":57129},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3572":2179,"_30844":2162,"_21377":57131,"_5":14632,"_28040":57097,"_3027":57132},[],"The device proves it can enroll according to the DMS policy.",{"_3572":2180,"_30844":2162,"_21377":57134,"_5":14632,"_28040":57097,"_3027":57135},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3572":2181,"_30844":2162,"_21377":57137,"_5":14632,"_28040":57097,"_3027":57138},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3572":2182,"_30844":2162,"_21377":57140,"_5":14632,"_28040":57097,"_3027":57141},[],"The device installs the certificate and the chain it needs.",{"_3572":2183,"_30844":2162,"_21377":57143,"_5":14632,"_28040":57097,"_3027":57144},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3572":2184,"_30844":2162,"_21377":57146,"_5":14632,"_28040":57097,"_3027":57147},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3572":2185,"_30844":2162,"_21377":57149,"_5":14632,"_28040":57101,"_3027":57150},[],"A DMS relates three sets that are worth designing separately:",{"_3572":2186,"_30844":2162,"_21377":57152,"_5":14632,"_28040":57101,"_3027":57153},[],"**Enrollment CA:** signs the new identities.",{"_3572":2187,"_30844":2162,"_21377":57155,"_5":14632,"_28040":57101,"_3027":57156},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3572":2188,"_30844":2162,"_21377":57158,"_5":14632,"_28040":57101,"_3027":57159},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3572":2189,"_30844":2162,"_21377":57161,"_5":14632,"_28040":57101,"_3027":57162},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3572":2190,"_30844":2162,"_21377":57164,"_5":14632,"_28040":57105,"_3027":57165},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3572":2191,"_30844":2162,"_21377":57167,"_5":14632,"_28040":57105,"_3027":57168},[],"that the current date is between `Not Before` and `Not After`;",{"_3572":2192,"_30844":2162,"_21377":57170,"_5":14632,"_28040":57105,"_3027":57171},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3572":2193,"_30844":2162,"_21377":57173,"_5":14632,"_28040":57105,"_3027":57174},[],"that names, SANs and subject match the expected identity;",{"_3572":2194,"_30844":2162,"_21377":57176,"_5":14632,"_28040":57105,"_3027":57177},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3572":2195,"_30844":2162,"_21377":57179,"_5":14632,"_28040":57105,"_3027":57180},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3572":2196,"_30844":2162,"_21377":57182,"_5":14632,"_28040":57105,"_3027":57183},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3572":2197,"_30844":2162,"_21377":57185,"_5":14632,"_28040":57109,"_3027":57186},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3572":2198,"_30844":2162,"_21377":57188,"_5":14632,"_28040":57113,"_3027":57189},[],"Keep the root out of daily operations, or with very restricted access.",{"_3572":2199,"_30844":2162,"_21377":57191,"_5":14632,"_28040":57113,"_3027":57192},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3572":2200,"_30844":2162,"_21377":57194,"_5":14632,"_28040":57113,"_3027":57195},[],"Assign explicit profiles to every use case.",{"_3572":2201,"_30844":2162,"_21377":57197,"_5":14632,"_28040":57113,"_3027":57198},[],"Distribute the new trust before starting a rotation.",{"_3572":2202,"_30844":2162,"_21377":57200,"_5":14632,"_28040":57113,"_3027":57201},[],"Keep enough overlap to renew a disconnected fleet.",{"_3572":2203,"_30844":2162,"_21377":57203,"_5":14632,"_28040":57113,"_3027":57204},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3572":2204,"_30844":2162,"_21377":57206,"_5":14632,"_28040":57113,"_3027":57207},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3572":2205,"_30844":2205,"_5":14996,"_3027":57209,"_31202":57210,"_21377":57211,"_28040":2205},"Revocation lists (CRL)",[50349,51888,56039,56681],[],{"_3572":2206,"_30844":2205,"_21377":57213,"_5":14632,"_28040":2205,"_3027":57214},[],"Generate and distribute signed lists to validate certificates offline.",{"_3572":2207,"_30844":2205,"_5":31199,"_21377":57216,"_28040":57217,"_3027":57218},[],"/docs/pr-preview/pr-68/platform/pki/crl#crl-settings","CRL settings",{"_3572":2208,"_30844":2205,"_5":31199,"_21377":57220,"_28040":57221,"_3027":57222},[],"/docs/pr-preview/pr-68/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3572":2209,"_30844":2205,"_5":31199,"_21377":57224,"_28040":57225,"_3027":57226},[],"/docs/pr-preview/pr-68/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3572":2210,"_30844":2205,"_5":31199,"_21377":57228,"_28040":57229,"_3027":57230},[],"/docs/pr-preview/pr-68/platform/pki/crl#crl-contents","CRL contents",{"_3572":2211,"_30844":2205,"_5":31199,"_21377":57232,"_28040":57233,"_3027":57234},[],"/docs/pr-preview/pr-68/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3572":2212,"_30844":2205,"_5":31199,"_21377":57236,"_28040":57237,"_3027":57238},[],"/docs/pr-preview/pr-68/platform/pki/crl#crl-settings-api","CRL settings API",{"_3572":2213,"_30844":2205,"_5":31199,"_21377":57240,"_28040":57241,"_3027":57242},[],"/docs/pr-preview/pr-68/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3572":2214,"_30844":2205,"_5":31199,"_21377":57244,"_28040":57245,"_3027":57246},[],"/docs/pr-preview/pr-68/platform/pki/crl#references","References",{"_3572":2215,"_30844":2205,"_21377":57248,"_5":14632,"_28040":2205,"_3027":57249},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3572":2216,"_30844":2205,"_21377":57251,"_5":14632,"_28040":57217,"_3027":57252},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3572":2217,"_30844":2205,"_21377":57254,"_5":14632,"_28040":57217,"_3027":57255},[],"Field",{"_3572":2218,"_30844":2205,"_21377":57257,"_5":14632,"_28040":57217,"_3027":50739},[],{"_3572":2219,"_30844":2205,"_21377":57259,"_5":14632,"_28040":57217,"_3027":52008},[],{"_3572":2220,"_30844":2205,"_21377":57261,"_5":14632,"_28040":57217,"_3027":57262},[],"ID of the CA the settings belong to.",{"_3572":2221,"_30844":2205,"_21377":57264,"_5":14632,"_28040":57217,"_3027":57265},[],"`status`",{"_3572":2222,"_30844":2205,"_21377":57267,"_5":14632,"_28040":57217,"_3027":57268},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3572":2223,"_30844":2205,"_21377":57270,"_5":14632,"_28040":57217,"_3027":57271},[],"`legacy_ski`",{"_3572":2224,"_30844":2205,"_21377":57273,"_5":14632,"_28040":57217,"_3027":57274},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3572":2225,"_30844":2205,"_21377":57276,"_5":14632,"_28040":57217,"_3027":57277},[],"`latest_crl`",{"_3572":2226,"_30844":2205,"_21377":57279,"_5":14632,"_28040":57217,"_3027":57280},[],"Version, validity start and end of the last published list. Read-only.",{"_3572":2227,"_30844":2205,"_21377":57282,"_5":14632,"_28040":57217,"_3027":57283},[],"`crl_options` field",{"_3572":2228,"_30844":2205,"_21377":57285,"_5":14632,"_28040":57217,"_3027":50739},[],{"_3572":2229,"_30844":2205,"_21377":57287,"_5":14632,"_28040":57217,"_3027":57288},[],"Initial value",{"_3572":2230,"_30844":2205,"_21377":57290,"_5":14632,"_28040":57217,"_3027":57291},[],"`validity`",{"_3572":2231,"_30844":2205,"_21377":57293,"_5":14632,"_28040":57217,"_3027":57294},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3572":2232,"_30844":2205,"_21377":57296,"_5":14632,"_28040":57217,"_3027":57297},[],"7 days.",{"_3572":2233,"_30844":2205,"_21377":57299,"_5":14632,"_28040":57217,"_3027":57300},[],"`refresh_interval`",{"_3572":2234,"_30844":2205,"_21377":57302,"_5":14632,"_28040":57217,"_3027":57303},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3572":2235,"_30844":2205,"_21377":57305,"_5":14632,"_28040":57217,"_3027":57306},[],"6 days and 23 hours.",{"_3572":2236,"_30844":2205,"_21377":57308,"_5":14632,"_28040":57217,"_3027":57309},[],"`regenerate_on_revoke`",{"_3572":2237,"_30844":2205,"_21377":57311,"_5":14632,"_28040":57217,"_3027":57312},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3572":2238,"_30844":2205,"_21377":57314,"_5":14632,"_28040":57217,"_3027":57315},[],"`true`.",{"_3572":2239,"_30844":2205,"_21377":57317,"_5":14632,"_28040":57217,"_3027":57318},[],"`signer_serial_number`",{"_3572":2240,"_30844":2205,"_21377":57320,"_5":14632,"_28040":57217,"_3027":57321},[],"Serial number of the existing certificate that signs the CRL.",{"_3572":2241,"_30844":2205,"_21377":57323,"_5":14632,"_28040":57217,"_3027":57324},[],"Serial number of the CA’s current certificate.",{"_3572":2242,"_30844":2205,"_21377":57326,"_5":14632,"_28040":57217,"_3027":57327},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3572":2243,"_30844":2205,"_21377":57329,"_5":14632,"_28040":57217,"_3027":57330},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3572":2244,"_30844":2205,"_21377":57332,"_5":14632,"_28040":57217,"_3027":57333},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3572":2245,"_30844":2205,"_21377":57335,"_5":14632,"_28040":57217,"_3027":57336},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3572":2246,"_30844":2205,"_21377":57338,"_5":14632,"_28040":57217,"_3027":57339},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3572":2247,"_30844":2205,"_21377":57341,"_5":14632,"_28040":57217,"_3027":57342},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3572":2248,"_30844":2205,"_21377":57344,"_5":14632,"_28040":57217,"_3027":57345},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3572":2249,"_30844":2205,"_21377":57347,"_5":14632,"_28040":57217,"_3027":57348},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3572":2250,"_30844":2205,"_21377":57350,"_5":14632,"_28040":57217,"_3027":57351},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3572":2251,"_30844":2205,"_21377":57353,"_5":14632,"_28040":57217,"_3027":57354},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3572":2252,"_30844":2205,"_21377":57356,"_5":14632,"_28040":57217,"_3027":57357},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3572":2253,"_30844":2205,"_21377":57359,"_5":14632,"_28040":57221,"_3027":57360},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3572":2254,"_30844":2205,"_21377":57362,"_5":14632,"_28040":57221,"_3027":57363},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3572":2255,"_30844":2205,"_21377":57365,"_5":14632,"_28040":57221,"_3027":57366},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3572":2256,"_30844":2205,"_21377":57368,"_5":14632,"_28040":57221,"_3027":57369},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3572":2257,"_30844":2205,"_21377":57371,"_5":14632,"_28040":57225,"_3027":57372},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3572":2258,"_30844":2205,"_21377":57374,"_5":14632,"_28040":57225,"_3027":57375},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3572":2259,"_30844":2205,"_21377":57377,"_5":14632,"_28040":57225,"_3027":57378},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3572":2260,"_30844":2205,"_21377":57380,"_5":14632,"_28040":57225,"_3027":57381},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3572":2261,"_30844":2205,"_21377":57383,"_5":14632,"_28040":57225,"_3027":57384},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3572":2262,"_30844":2205,"_21377":57386,"_5":14632,"_28040":57225,"_3027":57387},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3572":2263,"_30844":2205,"_21377":57389,"_5":14632,"_28040":57225,"_3027":57390},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3572":2264,"_30844":2205,"_21377":57392,"_5":14632,"_28040":57225,"_3027":57393},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3572":2265,"_30844":2205,"_21377":57395,"_5":14632,"_28040":57225,"_3027":57396},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3572":2266,"_30844":2205,"_21377":57398,"_5":14632,"_28040":57229,"_3027":57399},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3572":2267,"_30844":2205,"_21377":57401,"_5":14632,"_28040":57229,"_3027":57402},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3572":2268,"_30844":2205,"_21377":57404,"_5":14632,"_28040":57233,"_3027":57405},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3572":2269,"_30844":2205,"_21377":57407,"_5":14632,"_28040":57233,"_3027":57408},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3572":2270,"_30844":2205,"_21377":57410,"_5":14632,"_28040":57233,"_3027":57411},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3572":2271,"_30844":2205,"_21377":57413,"_5":14632,"_28040":57233,"_3027":57414},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3572":2272,"_30844":2205,"_21377":57416,"_5":14632,"_28040":57233,"_3027":57417},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3572":2273,"_30844":2205,"_21377":57419,"_5":14632,"_28040":57237,"_3027":57420},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3572":2274,"_30844":2205,"_21377":57422,"_5":14632,"_28040":57237,"_3027":53804},[],{"_3572":2275,"_30844":2205,"_21377":57424,"_5":14632,"_28040":57237,"_3027":57425},[],"Relative path",{"_3572":2276,"_30844":2205,"_21377":57427,"_5":14632,"_28040":57237,"_3027":53801},[],{"_3572":2277,"_30844":2205,"_21377":57429,"_5":14632,"_28040":57237,"_3027":57430},[],"`GET`",{"_3572":2278,"_30844":2205,"_21377":57432,"_5":14632,"_28040":57237,"_3027":57433},[],"`/v1/crl-settings`",{"_3572":2279,"_30844":2205,"_21377":57435,"_5":14632,"_28040":57237,"_3027":57436},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3572":2280,"_30844":2205,"_21377":57438,"_5":14632,"_28040":57237,"_3027":57430},[],{"_3572":2281,"_30844":2205,"_21377":57440,"_5":14632,"_28040":57237,"_3027":57441},[],"`/v1/crl-settings/{ca-id}`",{"_3572":2282,"_30844":2205,"_21377":57443,"_5":14632,"_28040":57237,"_3027":57444},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3572":2283,"_30844":2205,"_21377":57446,"_5":14632,"_28040":57237,"_3027":57447},[],"`PUT`",{"_3572":2284,"_30844":2205,"_21377":57449,"_5":14632,"_28040":57237,"_3027":57441},[],{"_3572":2285,"_30844":2205,"_21377":57451,"_5":14632,"_28040":57237,"_3027":57452},[],"Replace the CRL configuration of a CA.",{"_3572":2286,"_30844":2205,"_21377":57454,"_5":14632,"_28040":57237,"_3027":57455},[],"`DELETE`",{"_3572":2287,"_30844":2205,"_21377":57457,"_5":14632,"_28040":57237,"_3027":57441},[],{"_3572":2288,"_30844":2205,"_21377":57459,"_5":14632,"_28040":57237,"_3027":57460},[],"Remove the archived CRL settings of a CA.",{"_3572":2289,"_30844":2205,"_21377":57462,"_5":14632,"_28040":57237,"_3027":57463},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3572":2290,"_30844":2205,"_21377":57465,"_5":14632,"_28040":57237,"_3027":57466},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3572":2291,"_30844":2205,"_21377":57468,"_5":14632,"_28040":57237,"_3027":57469},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3572":2292,"_30844":2205,"_21377":57471,"_5":14632,"_28040":57241,"_3027":57472},[],"Symptom",{"_3572":2293,"_30844":2205,"_21377":57474,"_5":14632,"_28040":57241,"_3027":57475},[],"Cause",{"_3572":2294,"_30844":2205,"_21377":57477,"_5":14632,"_28040":57241,"_3027":57478},[],"Action",{"_3572":2295,"_30844":2205,"_21377":57480,"_5":14632,"_28040":57241,"_3027":57481},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3572":2296,"_30844":2205,"_21377":57483,"_5":14632,"_28040":57241,"_3027":57484},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3572":2297,"_30844":2205,"_21377":57486,"_5":14632,"_28040":57241,"_3027":57487},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3572":2298,"_30844":2205,"_21377":57489,"_5":14632,"_28040":57241,"_3027":57490},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3572":2299,"_30844":2205,"_21377":57492,"_5":14632,"_28040":57241,"_3027":57493},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3572":2300,"_30844":2205,"_21377":57495,"_5":14632,"_28040":57241,"_3027":57496},[],"Delete the CA first; deleting it archives its settings.",{"_3572":2301,"_30844":2205,"_21377":57498,"_5":14632,"_28040":57241,"_3027":57499},[],"`PUT` returns 400.",{"_3572":2302,"_30844":2205,"_21377":57501,"_5":14632,"_28040":57241,"_3027":57502},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3572":2303,"_30844":2205,"_21377":57504,"_5":14632,"_28040":57241,"_3027":57505},[],"Set the serial number of a valid certificate of that CA.",{"_3572":2304,"_30844":2205,"_21377":57507,"_5":14632,"_28040":57241,"_3027":57508},[],"`PUT` returns 404.",{"_3572":2305,"_30844":2205,"_21377":57510,"_5":14632,"_28040":57241,"_3027":57511},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3572":2306,"_30844":2205,"_21377":57513,"_5":14632,"_28040":57241,"_3027":57514},[],"Check the CA ID and the signer serial number.",{"_3572":2307,"_30844":2205,"_21377":57516,"_5":14632,"_28040":57241,"_3027":57517},[],"`PUT` returns 400 from a 3.x client.",{"_3572":2308,"_30844":2205,"_21377":57519,"_5":14632,"_28040":57241,"_3027":57520},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3572":2309,"_30844":2205,"_21377":57522,"_5":14632,"_28040":57241,"_3027":57523},[],"Update the client to send the new field.",{"_3572":2310,"_30844":2205,"_21377":57525,"_5":14632,"_28040":57241,"_3027":57526},[],"The CRL does not change after revoking a certificate.",{"_3572":2311,"_30844":2205,"_21377":57528,"_5":14632,"_28040":57241,"_3027":57529},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3572":2312,"_30844":2205,"_21377":57531,"_5":14632,"_28040":57241,"_3027":57532},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3572":2313,"_30844":2205,"_21377":57534,"_5":14632,"_28040":57241,"_3027":57535},[],"A verifier rejects the CRL because of the issuer.",{"_3572":2314,"_30844":2205,"_21377":57537,"_5":14632,"_28040":57241,"_3027":57538},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3572":2315,"_30844":2205,"_21377":57540,"_5":14632,"_28040":57241,"_3027":57541},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3572":2316,"_30844":2205,"_21377":57543,"_5":14632,"_28040":57245,"_3027":57544},[],"RFC 5280: X.509 and CRL profile.",{"_3572":2317,"_30844":2205,"_21377":57546,"_5":14632,"_28040":57245,"_3027":57547},[],"OpenSSL: openssl-crl.",{"_3572":2318,"_30844":2205,"_21377":57549,"_5":14632,"_28040":57245,"_3027":57550},[],"OpenSSL: openssl-verify.",{"_3572":2319,"_30844":2205,"_21377":57552,"_5":14632,"_28040":57245,"_3027":57553},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3572":2320,"_30844":2205,"_21377":57555,"_5":14632,"_28040":57245,"_3027":57556},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3572":2321,"_30844":2321,"_5":14996,"_3027":57558,"_31202":57559,"_21377":57560,"_28040":2321},"Keys and cryptographic engines",[50349,51888,56039,56040],[],{"_3572":2322,"_30844":2321,"_21377":57562,"_5":14632,"_28040":2321,"_3027":57563},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3572":2323,"_30844":2321,"_5":31199,"_21377":57565,"_28040":57566,"_3027":57567},[],"/docs/pr-preview/pr-68/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3572":2324,"_30844":2321,"_5":31199,"_21377":57569,"_28040":57570,"_3027":57571},[],"/docs/pr-preview/pr-68/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3572":2325,"_30844":2321,"_5":31199,"_21377":57573,"_28040":57574,"_3027":57575},[],"/docs/pr-preview/pr-68/platform/pki/key-management#file-system","File System",{"_3572":2326,"_30844":2321,"_5":31199,"_21377":57577,"_28040":57578,"_3027":57579},[],"/docs/pr-preview/pr-68/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3572":2327,"_30844":2321,"_5":31199,"_21377":57581,"_28040":57582,"_3027":57583},[],"/docs/pr-preview/pr-68/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3572":2328,"_30844":2321,"_5":31199,"_21377":57585,"_28040":57586,"_3027":57587},[],"/docs/pr-preview/pr-68/platform/pki/key-management#aws-kms","AWS KMS",{"_3572":2329,"_30844":2321,"_5":31199,"_21377":57589,"_28040":57590,"_3027":57591},[],"/docs/pr-preview/pr-68/platform/pki/key-management#pkcs11","PKCS#11",{"_3572":2330,"_30844":2321,"_5":31199,"_21377":57593,"_28040":57594,"_3027":57595},[],"/docs/pr-preview/pr-68/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3572":2331,"_30844":2321,"_5":31199,"_21377":57597,"_28040":57598,"_3027":57599},[],"/docs/pr-preview/pr-68/platform/pki/key-management#key-inventory","Key inventory",{"_3572":2332,"_30844":2321,"_5":31199,"_21377":57601,"_28040":57602,"_3027":57603},[],"/docs/pr-preview/pr-68/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3572":2333,"_30844":2321,"_5":31199,"_21377":57605,"_28040":57606,"_3027":57607},[],"/docs/pr-preview/pr-68/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3572":2334,"_30844":2321,"_5":31199,"_21377":57609,"_28040":57610,"_3027":57611},[],"/docs/pr-preview/pr-68/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3572":2335,"_30844":2321,"_5":31199,"_21377":57613,"_28040":57614,"_3027":57615},[],"/docs/pr-preview/pr-68/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3572":2336,"_30844":2321,"_5":31199,"_21377":57617,"_28040":57618,"_3027":57619},[],"/docs/pr-preview/pr-68/platform/pki/key-management#view-details","View details",{"_3572":2337,"_30844":2321,"_5":31199,"_21377":57621,"_28040":57622,"_3027":57623},[],"/docs/pr-preview/pr-68/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3572":2338,"_30844":2321,"_5":31199,"_21377":57625,"_28040":57626,"_3027":57627},[],"/docs/pr-preview/pr-68/platform/pki/key-management#sign","Sign",{"_3572":2339,"_30844":2321,"_5":31199,"_21377":57629,"_28040":57630,"_3027":57631},[],"/docs/pr-preview/pr-68/platform/pki/key-management#verify","Verify",{"_3572":2340,"_30844":2321,"_5":31199,"_21377":57633,"_28040":57634,"_3027":57635},[],"/docs/pr-preview/pr-68/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3572":2341,"_30844":2321,"_5":31199,"_21377":57637,"_28040":57638,"_3027":57639},[],"/docs/pr-preview/pr-68/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3572":2342,"_30844":2321,"_5":31199,"_21377":57641,"_28040":57642,"_3027":57643},[],"/docs/pr-preview/pr-68/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3572":2343,"_30844":2321,"_21377":57645,"_5":14632,"_28040":2321,"_3027":57646},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3572":2344,"_30844":2321,"_21377":57648,"_5":14632,"_28040":2321,"_3027":57649},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3572":2345,"_30844":2321,"_21377":57651,"_5":14632,"_28040":57566,"_3027":57652},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3572":2346,"_30844":2321,"_21377":57654,"_5":14632,"_28040":57566,"_3027":57655},[],"In practice, it lets you:",{"_3572":2347,"_30844":2321,"_21377":57657,"_5":14632,"_28040":57566,"_3027":57658},[],"Generate new key pairs from Lamassu IoT.",{"_3572":2348,"_30844":2321,"_21377":57660,"_5":14632,"_28040":57566,"_3027":57661},[],"Import keys created externally.",{"_3572":2349,"_30844":2321,"_21377":57663,"_5":14632,"_28040":57566,"_3027":57664},[],"Delegate custody and cryptographic operations to external engines.",{"_3572":2350,"_30844":2321,"_21377":57666,"_5":14632,"_28040":57566,"_3027":57667},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3572":2351,"_30844":2321,"_21377":57669,"_5":14632,"_28040":57570,"_3027":57670},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3572":2352,"_30844":2321,"_21377":57672,"_5":14632,"_28040":57570,"_3027":57673},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3572":2353,"_30844":2321,"_21377":57675,"_5":14632,"_28040":57570,"_3027":57676},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3572":2354,"_30844":2321,"_21377":57678,"_5":14632,"_28040":57574,"_3027":57679},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3572":2355,"_30844":2321,"_21377":57681,"_5":14632,"_28040":57578,"_3027":57682},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3572":2356,"_30844":2321,"_21377":57684,"_5":14632,"_28040":57578,"_3027":57685},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3572":2357,"_30844":2321,"_21377":57687,"_5":14632,"_28040":57582,"_3027":57688},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3572":2358,"_30844":2321,"_21377":57690,"_5":14632,"_28040":57586,"_3027":57691},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3572":2359,"_30844":2321,"_21377":57693,"_5":14632,"_28040":57590,"_3027":57694},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3572":2360,"_30844":2321,"_21377":57696,"_5":14632,"_28040":57594,"_3027":57697},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3572":2361,"_30844":2321,"_21377":57699,"_5":14632,"_28040":57594,"_3027":57700},[],"Lamassu shows the enabled engines in the console.",{"_3572":2362,"_30844":2321,"_21377":57702,"_5":14632,"_28040":57594,"_3027":57703},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3572":2363,"_30844":2321,"_21377":57705,"_5":14632,"_28040":57594,"_3027":57706},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3572":2364,"_30844":2321,"_21377":57708,"_5":14632,"_28040":57598,"_3027":57709},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3572":2365,"_30844":2321,"_21377":57711,"_5":14632,"_28040":57598,"_3027":57712},[],"The table includes the following fields:",{"_3572":2366,"_30844":2321,"_21377":57714,"_5":14632,"_28040":57598,"_3027":57715},[],"**Name**: descriptive name of the key.",{"_3572":2367,"_30844":2321,"_21377":57717,"_5":14632,"_28040":57598,"_3027":57718},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3572":2368,"_30844":2321,"_21377":57720,"_5":14632,"_28040":57598,"_3027":57721},[],"**Strength**: visual indicator of cryptographic strength.",{"_3572":2369,"_30844":2321,"_21377":57723,"_5":14632,"_28040":57598,"_3027":57724},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3572":2370,"_30844":2321,"_21377":57726,"_5":14632,"_28040":57598,"_3027":57727},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3572":2371,"_30844":2321,"_21377":57729,"_5":14632,"_28040":57598,"_3027":57730},[],"**Aliases**: alternative names associated with the key.",{"_3572":2372,"_30844":2321,"_21377":57732,"_5":14632,"_28040":57598,"_3027":57733},[],"**Tags**: labels for classification and search.",{"_3572":2373,"_30844":2321,"_21377":57735,"_5":14632,"_28040":57598,"_3027":57736},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3572":2374,"_30844":2321,"_21377":57738,"_5":14632,"_28040":57598,"_3027":57739},[],"From this view you also reach the most common actions:",{"_3572":2375,"_30844":2321,"_21377":57741,"_5":14632,"_28040":57598,"_3027":57742},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3572":2376,"_30844":2321,"_21377":57744,"_5":14632,"_28040":57598,"_3027":57745},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3572":2377,"_30844":2321,"_21377":57747,"_5":14632,"_28040":57598,"_3027":57748},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3572":2378,"_30844":2321,"_21377":57750,"_5":14632,"_28040":57598,"_3027":57751},[],"**Delete Key** to remove the key from the system.",{"_3572":2379,"_30844":2321,"_21377":57753,"_5":14632,"_28040":57602,"_3027":57754},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3572":2380,"_30844":2321,"_21377":57756,"_5":14632,"_28040":57606,"_3027":57757},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3572":2381,"_30844":2321,"_21377":57759,"_5":14632,"_28040":57606,"_3027":57760},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3572":2382,"_30844":2321,"_21377":57762,"_5":14632,"_28040":57606,"_3027":57763},[],"**Key Name**: unique and descriptive name.",{"_3572":2383,"_30844":2321,"_21377":57765,"_5":14632,"_28040":57606,"_3027":57766},[],"**Crypto Engine**: engine that will keep the key.",{"_3572":2384,"_30844":2321,"_21377":57768,"_5":14632,"_28040":57606,"_3027":57769},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3572":2385,"_30844":2321,"_21377":57771,"_5":14632,"_28040":57606,"_3027":57772},[],"**Tags**: metadata to classify the key.",{"_3572":2386,"_30844":2321,"_21377":57774,"_5":14632,"_28040":57606,"_3027":57775},[],"**Metadata**: additional information for advanced uses.",{"_3572":2387,"_30844":2321,"_21377":57777,"_5":14632,"_28040":57610,"_3027":57778},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3572":2388,"_30844":2321,"_21377":57780,"_5":14632,"_28040":57610,"_3027":57781},[],"When you have an exportable private key and the destination engine supports import.",{"_3572":2389,"_30844":2321,"_21377":57783,"_5":14632,"_28040":57610,"_3027":57784},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3572":2390,"_30844":2321,"_21377":57786,"_5":14632,"_28040":57610,"_3027":57787},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3572":2391,"_30844":2321,"_21377":57789,"_5":14632,"_28040":57610,"_3027":57790},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3572":2392,"_30844":2321,"_21377":57792,"_5":14632,"_28040":57610,"_3027":57793},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3572":2393,"_30844":2321,"_21377":57795,"_5":14632,"_28040":57610,"_3027":57796},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3572":2394,"_30844":2321,"_21377":57798,"_5":14632,"_28040":57610,"_3027":57799},[],"**Tags**: labels for organization and search.",{"_3572":2395,"_30844":2321,"_21377":57801,"_5":14632,"_28040":57610,"_3027":57802},[],"**Metadata**: additional optional information.",{"_3572":2396,"_30844":2321,"_21377":57804,"_5":14632,"_28040":57610,"_3027":57805},[],"**Private Key (PEM)**: private key in PEM format.",{"_3572":2397,"_30844":2321,"_21377":57807,"_5":14632,"_28040":57610,"_3027":57808},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3572":2398,"_30844":2321,"_21377":57810,"_5":14632,"_28040":57614,"_3027":57811},[],"Each registered key has a detail view and several operational actions.",{"_3572":2399,"_30844":2321,"_21377":57813,"_5":14632,"_28040":57618,"_3027":57814},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3572":2400,"_30844":2321,"_21377":57816,"_5":14632,"_28040":57618,"_3027":57817},[],"The **Overview** tab shows, among others, these fields:",{"_3572":2401,"_30844":2321,"_21377":57819,"_5":14632,"_28040":57618,"_3027":57820},[],"**Key Name**: descriptive name.",{"_3572":2402,"_30844":2321,"_21377":57822,"_5":14632,"_28040":57618,"_3027":57823},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3572":2403,"_30844":2321,"_21377":57825,"_5":14632,"_28040":57618,"_3027":57826},[],"**Tags**: associated labels.",{"_3572":2404,"_30844":2321,"_21377":57828,"_5":14632,"_28040":57618,"_3027":57829},[],"**Aliases**: alternative names.",{"_3572":2405,"_30844":2321,"_21377":57831,"_5":14632,"_28040":57618,"_3027":57832},[],"**Crypto Engine**: engine where the key resides.",{"_3572":2406,"_30844":2321,"_21377":57834,"_5":14632,"_28040":57618,"_3027":57835},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3572":2407,"_30844":2321,"_21377":57837,"_5":14632,"_28040":57618,"_3027":57838},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3572":2408,"_30844":2321,"_21377":57840,"_5":14632,"_28040":57618,"_3027":57841},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3572":2409,"_30844":2321,"_21377":57843,"_5":14632,"_28040":57622,"_3027":57844},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3572":2410,"_30844":2321,"_21377":57846,"_5":14632,"_28040":57622,"_3027":57847},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3572":2411,"_30844":2321,"_21377":57849,"_5":14632,"_28040":57622,"_3027":57850},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3572":2412,"_30844":2321,"_21377":57852,"_5":14632,"_28040":57626,"_3027":57853},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3572":2413,"_30844":2321,"_21377":57855,"_5":14632,"_28040":57626,"_3027":57856},[],"Main fields:",{"_3572":2414,"_30844":2321,"_21377":57858,"_5":14632,"_28040":57626,"_3027":57859},[],"**Algorithm**: signing algorithm available for the key type.",{"_3572":2415,"_30844":2321,"_21377":57861,"_5":14632,"_28040":57626,"_3027":57862},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3572":2416,"_30844":2321,"_21377":57864,"_5":14632,"_28040":57626,"_3027":57865},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3572":2417,"_30844":2321,"_21377":57867,"_5":14632,"_28040":57626,"_3027":57868},[],"**Message**: content to sign.",{"_3572":2418,"_30844":2321,"_21377":57870,"_5":14632,"_28040":57626,"_3027":57871},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3572":2419,"_30844":2321,"_21377":57873,"_5":14632,"_28040":57630,"_3027":57874},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3572":2420,"_30844":2321,"_21377":57876,"_5":14632,"_28040":57630,"_3027":57856},[],{"_3572":2421,"_30844":2321,"_21377":57878,"_5":14632,"_28040":57630,"_3027":57879},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3572":2422,"_30844":2321,"_21377":57881,"_5":14632,"_28040":57630,"_3027":57882},[],"**Message Type**: `Raw` or `Digest`.",{"_3572":2423,"_30844":2321,"_21377":57884,"_5":14632,"_28040":57630,"_3027":57885},[],"**Payload Encoding**: encoding of the message.",{"_3572":2424,"_30844":2321,"_21377":57887,"_5":14632,"_28040":57630,"_3027":57888},[],"**Message**: original message or hash.",{"_3572":2425,"_30844":2321,"_21377":57890,"_5":14632,"_28040":57630,"_3027":57891},[],"**Signature**: signature to check.",{"_3572":2426,"_30844":2321,"_21377":57893,"_5":14632,"_28040":57630,"_3027":57894},[],"**Result**: indicator of the validation result.",{"_3572":2427,"_30844":2321,"_21377":57896,"_5":14632,"_28040":57634,"_3027":57897},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3572":2428,"_30844":2321,"_21377":57899,"_5":14632,"_28040":57634,"_3027":57900},[],"This flow is useful for:",{"_3572":2429,"_30844":2321,"_21377":57902,"_5":14632,"_28040":57634,"_3027":57903},[],"Requesting certificates from an external CA.",{"_3572":2430,"_30844":2321,"_21377":57905,"_5":14632,"_28040":57634,"_3027":57906},[],"Renewing an identity while keeping the same key.",{"_3572":2431,"_30844":2321,"_21377":57908,"_5":14632,"_28040":57634,"_3027":57909},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3572":2432,"_30844":2321,"_21377":57911,"_5":14632,"_28040":57634,"_3027":57912},[],"**Common Name (CN)**: main name of the identity.",{"_3572":2433,"_30844":2321,"_21377":57914,"_5":14632,"_28040":57634,"_3027":57915},[],"**Organization (O)**: organization or company.",{"_3572":2434,"_30844":2321,"_21377":57917,"_5":14632,"_28040":57634,"_3027":57918},[],"**Organizational Unit (OU)**: department or unit.",{"_3572":2435,"_30844":2321,"_21377":57920,"_5":14632,"_28040":57634,"_3027":57921},[],"**Country (C)**: two-letter country code.",{"_3572":2436,"_30844":2321,"_21377":57923,"_5":14632,"_28040":57634,"_3027":57924},[],"**State / Province (ST)**: state or province.",{"_3572":2437,"_30844":2321,"_21377":57926,"_5":14632,"_28040":57634,"_3027":57927},[],"**Locality (L)**: city or locality.",{"_3572":2438,"_30844":2321,"_21377":57929,"_5":14632,"_28040":57634,"_3027":57930},[],"**Email Address**: contact email.",{"_3572":2439,"_30844":2321,"_21377":57932,"_5":14632,"_28040":57634,"_3027":57933},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3572":2440,"_30844":2321,"_21377":57935,"_5":14632,"_28040":57634,"_3027":57936},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3572":2441,"_30844":2321,"_21377":57938,"_5":14632,"_28040":57638,"_3027":57939},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3572":2442,"_30844":2321,"_21377":57941,"_5":14632,"_28040":57638,"_3027":57942},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3572":2443,"_30844":2321,"_21377":57944,"_5":14632,"_28040":57642,"_3027":57945},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3572":2444,"_30844":2321,"_21377":57947,"_5":14632,"_28040":57642,"_3027":57948},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3572":2445,"_30844":2445,"_5":14996,"_3027":57950,"_31202":57951,"_21377":57952,"_28040":2445},"Online validation with OCSP",[50349,51888,56039,56681],[],{"_3572":2446,"_30844":2445,"_21377":57954,"_5":14632,"_28040":2445,"_3027":57955},[],"Query signed status and verify the responder’s response.",{"_3572":2447,"_30844":2445,"_5":31199,"_21377":57957,"_28040":57958,"_3027":57959},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3572":2448,"_30844":2445,"_5":31199,"_21377":57961,"_28040":57962,"_3027":57963},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3572":2449,"_30844":2445,"_5":31199,"_21377":57965,"_28040":57966,"_3027":57967},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3572":2450,"_30844":2445,"_5":31199,"_21377":57969,"_28040":57970,"_3027":57971},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3572":2451,"_30844":2445,"_5":31199,"_21377":57973,"_28040":57974,"_3027":57975},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3572":2452,"_30844":2445,"_5":31199,"_21377":57977,"_28040":57978,"_3027":57246},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#references",{"_3572":2453,"_30844":2445,"_21377":57980,"_5":14632,"_28040":2445,"_3027":57981},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3572":2454,"_30844":2445,"_21377":57983,"_5":14632,"_28040":57958,"_3027":57984},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3572":2455,"_30844":2445,"_21377":57986,"_5":14632,"_28040":57958,"_3027":57987},[],"Record status",{"_3572":2456,"_30844":2445,"_21377":57989,"_5":14632,"_28040":57958,"_3027":57990},[],"Signed response",{"_3572":2457,"_30844":2445,"_21377":57992,"_5":14632,"_28040":57958,"_3027":55176},[],{"_3572":2458,"_30844":2445,"_21377":57994,"_5":14632,"_28040":57958,"_3027":57995},[],"`Good`.",{"_3572":2459,"_30844":2445,"_21377":57997,"_5":14632,"_28040":57958,"_3027":55193},[],{"_3572":2460,"_30844":2445,"_21377":57999,"_5":14632,"_28040":57958,"_3027":58000},[],"`Revoked`, with revocation reason and timestamp.",{"_3572":2461,"_30844":2445,"_21377":58002,"_5":14632,"_28040":57958,"_3027":58003},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3572":2462,"_30844":2445,"_21377":58005,"_5":14632,"_28040":57958,"_3027":58006},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3572":2463,"_30844":2445,"_21377":58008,"_5":14632,"_28040":57958,"_3027":58009},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3572":2464,"_30844":2445,"_21377":58011,"_5":14632,"_28040":57958,"_3027":58012},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3572":2465,"_30844":2445,"_21377":58014,"_5":14632,"_28040":57958,"_3027":58015},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3572":2466,"_30844":2445,"_21377":58017,"_5":14632,"_28040":57962,"_3027":58018},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3572":2467,"_30844":2445,"_21377":58020,"_5":14632,"_28040":57962,"_3027":58021},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3572":2468,"_30844":2445,"_21377":58023,"_5":14632,"_28040":57966,"_3027":58024},[],"The service accepts:",{"_3572":2469,"_30844":2445,"_21377":58026,"_5":14632,"_28040":57966,"_3027":53804},[],{"_3572":2470,"_30844":2445,"_21377":58028,"_5":14632,"_28040":57966,"_3027":58029},[],"VA service path",{"_3572":2471,"_30844":2445,"_21377":58031,"_5":14632,"_28040":57966,"_3027":58032},[],"Format",{"_3572":2472,"_30844":2445,"_21377":58034,"_5":14632,"_28040":57966,"_3027":58035},[],"`POST`",{"_3572":2473,"_30844":2445,"_21377":58037,"_5":14632,"_28040":57966,"_3027":58038},[],"`/ocsp`",{"_3572":2474,"_30844":2445,"_21377":58040,"_5":14632,"_28040":57966,"_3027":58041},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3572":2475,"_30844":2445,"_21377":58043,"_5":14632,"_28040":57966,"_3027":57430},[],{"_3572":2476,"_30844":2445,"_21377":58045,"_5":14632,"_28040":57966,"_3027":58046},[],"`/ocsp/{ocsp_request}`",{"_3572":2477,"_30844":2445,"_21377":58048,"_5":14632,"_28040":57966,"_3027":58049},[],"DER request encoded using padded URL Base64.",{"_3572":2478,"_30844":2445,"_21377":58051,"_5":14632,"_28040":57966,"_3027":58052},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3572":2479,"_30844":2445,"_21377":58054,"_5":14632,"_28040":57970,"_3027":58055},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3572":2480,"_30844":2445,"_21377":58057,"_5":14632,"_28040":57970,"_3027":58058},[],"Generate the request:",{"_3572":2481,"_30844":2445,"_21377":58060,"_5":14632,"_28040":57970,"_3027":58061},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3572":2482,"_30844":2445,"_21377":58063,"_5":14632,"_28040":57970,"_3027":58064},[],"Replace the example URL with the inspected endpoint:",{"_3572":2483,"_30844":2445,"_21377":58066,"_5":14632,"_28040":57970,"_3027":58067},[],"Verify the returned DER:",{"_3572":2484,"_30844":2445,"_21377":58069,"_5":14632,"_28040":57970,"_3027":58070},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3572":2485,"_30844":2445,"_21377":58072,"_5":14632,"_28040":57974,"_3027":58073},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3572":2486,"_30844":2445,"_21377":58075,"_5":14632,"_28040":57974,"_3027":58076},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3572":2487,"_30844":2445,"_21377":58078,"_5":14632,"_28040":57978,"_3027":58079},[],"RFC 6960: OCSP.",{"_3572":2488,"_30844":2445,"_21377":58081,"_5":14632,"_28040":57978,"_3027":58082},[],"OpenSSL: openssl-ocsp.",{"_3572":2489,"_30844":2445,"_21377":58084,"_5":14632,"_28040":57978,"_3027":58085},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3572":2490,"_30844":2445,"_21377":58087,"_5":14632,"_28040":57978,"_3027":57556},[],{"_3572":2491,"_30844":2491,"_5":14996,"_3027":56039,"_31202":58089,"_21377":58090,"_28040":2491},[50349,51888,56039],[],{"_3572":2492,"_30844":2491,"_21377":58092,"_5":14632,"_28040":2491,"_3027":58093},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3572":2493,"_30844":2491,"_5":31199,"_21377":58095,"_28040":58096,"_3027":55351},[],"/docs/pr-preview/pr-68/platform/pki/overview#start-here",{"_3572":2494,"_30844":2491,"_5":31199,"_21377":58098,"_28040":58099,"_3027":58100},[],"/docs/pr-preview/pr-68/platform/pki/overview#what-you-need","What you need",{"_3572":2495,"_30844":2491,"_5":31199,"_21377":58102,"_28040":58103,"_3027":55883},[],"/docs/pr-preview/pr-68/platform/pki/overview#core-capabilities",{"_3572":2496,"_30844":2491,"_5":31199,"_21377":58105,"_28040":58106,"_3027":55887},[],"/docs/pr-preview/pr-68/platform/pki/overview#build-your-trust-hierarchy",{"_3572":2497,"_30844":2491,"_5":31199,"_21377":58108,"_28040":58109,"_3027":55891},[],"/docs/pr-preview/pr-68/platform/pki/overview#protect-cryptographic-keys",{"_3572":2498,"_30844":2491,"_5":31199,"_21377":58111,"_28040":58112,"_3027":55895},[],"/docs/pr-preview/pr-68/platform/pki/overview#issue-and-control-certificates",{"_3572":2499,"_30844":2491,"_5":31199,"_21377":58114,"_28040":58115,"_3027":55903},[],"/docs/pr-preview/pr-68/platform/pki/overview#publish-validation-status",{"_3572":2500,"_30844":2491,"_5":31199,"_21377":58117,"_28040":58118,"_3027":58119},[],"/docs/pr-preview/pr-68/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3572":2501,"_30844":2491,"_5":31199,"_21377":58121,"_28040":58122,"_3027":56848},[],"/docs/pr-preview/pr-68/platform/pki/overview#continue",{"_3572":2502,"_30844":2491,"_21377":58124,"_5":14632,"_28040":2491,"_3027":58125},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3572":2503,"_30844":2491,"_21377":58127,"_5":14632,"_28040":58096,"_3027":58128},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3572":2504,"_30844":2491,"_21377":58130,"_5":14632,"_28040":58096,"_3027":58131},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3572":2505,"_30844":2491,"_21377":58133,"_5":14632,"_28040":58099,"_3027":58134},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3572":2506,"_30844":2491,"_21377":58136,"_5":14632,"_28040":58099,"_3027":58137},[],"An available cryptographic engine to keep the authority's key.",{"_3572":2507,"_30844":2491,"_21377":58139,"_5":14632,"_28040":58099,"_3027":58140},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3572":2508,"_30844":2491,"_21377":58142,"_5":14632,"_28040":58099,"_3027":58143},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3572":2509,"_30844":2491,"_21377":58145,"_5":14632,"_28040":58099,"_3027":58146},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3572":2510,"_30844":2491,"_21377":58148,"_5":14632,"_28040":58106,"_3027":58149},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3572":2511,"_30844":2491,"_21377":58151,"_5":14632,"_28040":58109,"_3027":58152},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3572":2512,"_30844":2491,"_21377":58154,"_5":14632,"_28040":58112,"_3027":58155},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3572":2513,"_30844":2491,"_21377":58157,"_5":14632,"_28040":58115,"_3027":58158},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3572":2514,"_30844":2491,"_21377":58160,"_5":14632,"_28040":58118,"_3027":58161},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3572":2515,"_30844":2491,"_21377":58163,"_5":14632,"_28040":58118,"_3027":58164},[],"its subject and extensions identify the expected client;",{"_3572":2516,"_30844":2491,"_21377":58166,"_5":14632,"_28040":58118,"_3027":58167},[],"its public key matches the client's private key;",{"_3572":2517,"_30844":2491,"_21377":58169,"_5":14632,"_28040":58118,"_3027":58170},[],"its chain reaches a root trusted by the consumer;",{"_3572":2518,"_30844":2491,"_21377":58172,"_5":14632,"_28040":58118,"_3027":58173},[],"its dates and usages allow the operation;",{"_3572":2519,"_30844":2491,"_21377":58175,"_5":14632,"_28040":58118,"_3027":58176},[],"the consumer applies revocation checks and authorization.",{"_3572":2520,"_30844":2491,"_21377":58178,"_5":14632,"_28040":58118,"_3027":58179},[],"The issuance path includes the first independent checks.",{"_3572":2521,"_30844":2491,"_21377":58181,"_5":14632,"_28040":58122,"_3027":58182},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3572":2522,"_30844":2491,"_21377":58184,"_5":14632,"_28040":58122,"_3027":58185},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3572":2523,"_30844":2491,"_21377":58187,"_5":14632,"_28040":58122,"_3027":58188},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3572":2524,"_30844":2524,"_5":14996,"_3027":58190,"_31202":58191,"_21377":58192,"_28040":2524},"Create your first CA",[50349,51888,56039,55476],[],{"_3572":2525,"_30844":2524,"_21377":58194,"_5":14632,"_28040":2524,"_3027":58195},[],"Create an evaluation root and check its certificate before issuing.",{"_3572":2526,"_30844":2524,"_5":31199,"_21377":58197,"_28040":58198,"_3027":50359},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3572":2527,"_30844":2524,"_5":31199,"_21377":58200,"_28040":58201,"_3027":58202},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3572":2528,"_30844":2524,"_5":31199,"_21377":58204,"_28040":58205,"_3027":58206},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3572":2529,"_30844":2524,"_5":31199,"_21377":58208,"_28040":58209,"_3027":58210},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3572":2530,"_30844":2524,"_5":31199,"_21377":58212,"_28040":58213,"_3027":58214},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3572":2531,"_30844":2524,"_5":31199,"_21377":58216,"_28040":58217,"_3027":58218},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3572":2532,"_30844":2524,"_5":31199,"_21377":58220,"_28040":58221,"_3027":58222},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3572":2533,"_30844":2524,"_5":31199,"_21377":58224,"_28040":58225,"_3027":55733},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3572":2534,"_30844":2524,"_5":31199,"_21377":58227,"_28040":58228,"_3027":50383},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3572":2535,"_30844":2524,"_21377":58230,"_5":14632,"_28040":2524,"_3027":58231},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3572":2536,"_30844":2524,"_21377":58233,"_5":14632,"_28040":58198,"_3027":58234},[],"Console access and permission to create keys and authorities.",{"_3572":2537,"_30844":2524,"_21377":58236,"_5":14632,"_28040":58198,"_3027":58237},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3572":2538,"_30844":2524,"_21377":58239,"_5":14632,"_28040":58198,"_3027":58240},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3572":2539,"_30844":2524,"_21377":58242,"_5":14632,"_28040":58198,"_3027":58243},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3572":2540,"_30844":2524,"_21377":58245,"_5":14632,"_28040":58201,"_3027":58246},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3572":2541,"_30844":2524,"_21377":58248,"_5":14632,"_28040":58201,"_3027":58249},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3572":2542,"_30844":2524,"_21377":58251,"_5":14632,"_28040":58205,"_3027":58252},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3572":2543,"_30844":2524,"_21377":58254,"_5":14632,"_28040":58205,"_3027":58255},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3572":2544,"_30844":2524,"_21377":58257,"_5":14632,"_28040":58209,"_3027":58258},[],"Select **Root CA** and complete:",{"_3572":2545,"_30844":2524,"_21377":58260,"_5":14632,"_28040":58209,"_3027":58261},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3572":2546,"_30844":2524,"_21377":58263,"_5":14632,"_28040":58209,"_3027":58264},[],"**Subject**: organization and country details for your evaluation.",{"_3572":2547,"_30844":2524,"_21377":58266,"_5":14632,"_28040":58209,"_3027":58267},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3572":2548,"_30844":2524,"_21377":58269,"_5":14632,"_28040":58209,"_3027":58270},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3572":2549,"_30844":2524,"_21377":58272,"_5":14632,"_28040":58209,"_3027":58273},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3572":2550,"_30844":2524,"_21377":58275,"_5":14632,"_28040":58213,"_3027":58276},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3572":2551,"_30844":2524,"_21377":58278,"_5":14632,"_28040":58217,"_3027":58279},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3572":2552,"_30844":2524,"_21377":58281,"_5":14632,"_28040":58217,"_3027":58282},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3572":2553,"_30844":2524,"_21377":58284,"_5":14632,"_28040":58221,"_3027":58285},[],"Run from the directory where you saved `ca.pem`:",{"_3572":2554,"_30844":2524,"_21377":58287,"_5":14632,"_28040":58221,"_3027":58288},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3572":2555,"_30844":2524,"_21377":58290,"_5":14632,"_28040":58221,"_3027":58291},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3572":2556,"_30844":2524,"_21377":58293,"_5":14632,"_28040":58225,"_3027":58294},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3572":2557,"_30844":2524,"_21377":58296,"_5":14632,"_28040":58225,"_3027":58297},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3572":2558,"_30844":2524,"_21377":58299,"_5":14632,"_28040":58225,"_3027":58300},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3572":2559,"_30844":2524,"_21377":58302,"_5":14632,"_28040":58225,"_3027":58303},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3572":2560,"_30844":2524,"_21377":58305,"_5":14632,"_28040":58228,"_3027":58306},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3572":2561,"_30844":2561,"_5":14996,"_3027":58308,"_31202":58309,"_21377":58310,"_28040":2561},"Issue and verify a certificate",[50349,51888,56039,55476],[],{"_3572":2562,"_30844":2561,"_21377":58312,"_5":14632,"_28040":2561,"_3027":58313},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3572":2563,"_30844":2561,"_5":31199,"_21377":58315,"_28040":58316,"_3027":50359},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3572":2564,"_30844":2561,"_5":31199,"_21377":58318,"_28040":58319,"_3027":58320},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3572":2565,"_30844":2561,"_5":31199,"_21377":58322,"_28040":58323,"_3027":58324},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3572":2566,"_30844":2561,"_5":31199,"_21377":58326,"_28040":58327,"_3027":58328},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3572":2567,"_30844":2561,"_5":31199,"_21377":58330,"_28040":58331,"_3027":58332},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3572":2568,"_30844":2561,"_5":31199,"_21377":58334,"_28040":58335,"_3027":58336},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3572":2569,"_30844":2561,"_5":31199,"_21377":58338,"_28040":58339,"_3027":58340},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3572":2570,"_30844":2561,"_5":31199,"_21377":58342,"_28040":58343,"_3027":58344},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3572":2571,"_30844":2561,"_5":31199,"_21377":58346,"_28040":58347,"_3027":58348},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3572":2572,"_30844":2561,"_5":31199,"_21377":58350,"_28040":58351,"_3027":58352},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3572":2573,"_30844":2561,"_5":31199,"_21377":58354,"_28040":58355,"_3027":55733},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3572":2574,"_30844":2561,"_5":31199,"_21377":58357,"_28040":58358,"_3027":50383},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#next-step",{"_3572":2575,"_30844":2561,"_21377":58360,"_5":14632,"_28040":2561,"_3027":58361},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3572":2576,"_30844":2561,"_21377":58363,"_5":14632,"_28040":58316,"_3027":58364},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3572":2577,"_30844":2561,"_21377":58366,"_5":14632,"_28040":58316,"_3027":58367},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3572":2578,"_30844":2561,"_21377":58369,"_5":14632,"_28040":58316,"_3027":58370},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3572":2579,"_30844":2561,"_21377":58372,"_5":14632,"_28040":58316,"_3027":58373},[],"A client identifier: here we use `device-001`.",{"_3572":2580,"_30844":2561,"_21377":58375,"_5":14632,"_28040":58316,"_3027":58376},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3572":2581,"_30844":2561,"_21377":58378,"_5":14632,"_28040":58319,"_3027":58379},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3572":2582,"_30844":2561,"_21377":58381,"_5":14632,"_28040":58323,"_3027":58382},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3572":2583,"_30844":2561,"_21377":58384,"_5":14632,"_28040":58323,"_3027":58385},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3572":2584,"_30844":2561,"_21377":58387,"_5":14632,"_28040":58327,"_3027":58388},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3572":2585,"_30844":2561,"_21377":58390,"_5":14632,"_28040":58327,"_3027":58391},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3572":2586,"_30844":2561,"_21377":58393,"_5":14632,"_28040":58331,"_3027":58394},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3572":2587,"_30844":2561,"_21377":58396,"_5":14632,"_28040":58331,"_3027":58397},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3572":2588,"_30844":2561,"_21377":58399,"_5":14632,"_28040":58335,"_3027":58400},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3572":2589,"_30844":2561,"_21377":58402,"_5":14632,"_28040":58339,"_3027":58403},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3572":2590,"_30844":2561,"_21377":58405,"_5":14632,"_28040":58343,"_3027":58406},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3572":2591,"_30844":2561,"_21377":58408,"_5":14632,"_28040":58347,"_3027":58409},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3572":2592,"_30844":2561,"_21377":58411,"_5":14632,"_28040":58347,"_3027":58412},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3572":2593,"_30844":2561,"_21377":58414,"_5":14632,"_28040":58347,"_3027":58415},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3572":2594,"_30844":2561,"_21377":58417,"_5":14632,"_28040":58351,"_3027":58418},[],"In Bash, compare the two public-key digests:",{"_3572":2595,"_30844":2561,"_21377":58420,"_5":14632,"_28040":58351,"_3027":58421},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3572":2596,"_30844":2561,"_21377":58423,"_5":14632,"_28040":58351,"_3027":58424},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3572":2597,"_30844":2561,"_21377":58426,"_5":14632,"_28040":58355,"_3027":55817},[],{"_3572":2598,"_30844":2561,"_21377":58428,"_5":14632,"_28040":58355,"_3027":58429},[],"What to review",{"_3572":2599,"_30844":2561,"_21377":58431,"_5":14632,"_28040":58355,"_3027":58432},[],"The CA rejects issuance",{"_3572":2600,"_30844":2561,"_21377":58434,"_5":14632,"_28040":58355,"_3027":58435},[],"Permissions, CA state and key, algorithm and profile.",{"_3572":2601,"_30844":2561,"_21377":58437,"_5":14632,"_28040":58355,"_3027":58438},[],"Different subject or usages",{"_3572":2602,"_30844":2561,"_21377":58440,"_5":14632,"_28040":58355,"_3027":58441},[],"Applied profile and requested values.",{"_3572":2603,"_30844":2561,"_21377":58443,"_5":14632,"_28040":58355,"_3027":58444},[],"Issuer cannot be found",{"_3572":2604,"_30844":2561,"_21377":58446,"_5":14632,"_28040":58355,"_3027":58447},[],"Downloaded CA and required intermediate chain.",{"_3572":2605,"_30844":2561,"_21377":58449,"_5":14632,"_28040":58355,"_3027":58450},[],"Validity fails",{"_3572":2606,"_30844":2561,"_21377":58452,"_5":14632,"_28040":58355,"_3027":58453},[],"Certificate and CA dates, and the computer's clock.",{"_3572":2607,"_30844":2561,"_21377":58455,"_5":14632,"_28040":58355,"_3027":58456},[],"Public-key digests differ",{"_3572":2608,"_30844":2561,"_21377":58458,"_5":14632,"_28040":58355,"_3027":58459},[],"Certificate and key files from the same issuance.",{"_3572":2609,"_30844":2561,"_21377":58461,"_5":14632,"_28040":58355,"_3027":58462},[],"See PKI diagnostics to narrow an issuance failure.",{"_3572":2610,"_30844":2561,"_21377":58464,"_5":14632,"_28040":58358,"_3027":58465},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3572":2611,"_30844":2561,"_21377":58467,"_5":14632,"_28040":58358,"_3027":58468},[],"Manage certificates for inspection, status and revocation.",{"_3572":2612,"_30844":2561,"_21377":58470,"_5":14632,"_28040":58358,"_3027":58471},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3572":2613,"_30844":2561,"_21377":58473,"_5":14632,"_28040":58358,"_3027":58474},[],"Prepare EST for the device to request its next identities.",{"_3572":2614,"_30844":2561,"_21377":58476,"_5":14632,"_28040":58358,"_3027":58477},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3572":2615,"_30844":2615,"_5":14996,"_3027":58479,"_31202":58480,"_21377":58481,"_28040":2615},"PKI getting started",[50349,51888,56039,55476],[],{"_3572":2616,"_30844":2615,"_21377":58483,"_5":14632,"_28040":2615,"_3027":58484},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3572":2617,"_30844":2615,"_5":31199,"_21377":58486,"_28040":58487,"_3027":50359},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#before-you-begin",{"_3572":2618,"_30844":2615,"_5":31199,"_21377":58489,"_28040":58490,"_3027":58491},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3572":2619,"_30844":2615,"_5":31199,"_21377":58493,"_28040":58494,"_3027":55668},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#expected-result",{"_3572":2620,"_30844":2615,"_5":31199,"_21377":58496,"_28040":58497,"_3027":58498},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3572":2621,"_30844":2615,"_21377":58500,"_5":14632,"_28040":2615,"_3027":58501},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3572":2622,"_30844":2615,"_21377":58503,"_5":14632,"_28040":58487,"_3027":58504},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3572":2623,"_30844":2615,"_21377":58506,"_5":14632,"_28040":58487,"_3027":58507},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3572":2624,"_30844":2615,"_21377":58509,"_5":14632,"_28040":58487,"_3027":58510},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3572":2625,"_30844":2615,"_21377":58512,"_5":14632,"_28040":58487,"_3027":58513},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3572":2626,"_30844":2615,"_21377":58515,"_5":14632,"_28040":58487,"_3027":58516},[],"A working directory with restricted access for the downloaded key.",{"_3572":2627,"_30844":2615,"_21377":58518,"_5":14632,"_28040":58490,"_3027":58519},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3572":2628,"_30844":2615,"_21377":58521,"_5":14632,"_28040":58490,"_3027":58522},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3572":2629,"_30844":2615,"_21377":58524,"_5":14632,"_28040":58490,"_3027":58525},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3572":2630,"_30844":2615,"_21377":58527,"_5":14632,"_28040":58490,"_3027":58528},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3572":2631,"_30844":2615,"_21377":58530,"_5":14632,"_28040":58494,"_3027":58531},[],"File or resource",{"_3572":2632,"_30844":2615,"_21377":58533,"_5":14632,"_28040":58494,"_3027":55665},[],{"_3572":2633,"_30844":2615,"_21377":58535,"_5":14632,"_28040":58494,"_3027":58536},[],"Active root CA and `ca.pem`",{"_3572":2634,"_30844":2615,"_21377":58538,"_5":14632,"_28040":58494,"_3027":58539},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3572":2635,"_30844":2615,"_21377":58541,"_5":14632,"_28040":58494,"_3027":58542},[],"End-entity certificate and `device.crt`",{"_3572":2636,"_30844":2615,"_21377":58544,"_5":14632,"_28040":58494,"_3027":58545},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3572":2637,"_30844":2615,"_21377":58547,"_5":14632,"_28040":58494,"_3027":58548},[],"Private key `device.key`",{"_3572":2638,"_30844":2615,"_21377":58550,"_5":14632,"_28040":58494,"_3027":58551},[],"Its public key matches the one included in `device.crt`.",{"_3572":2639,"_30844":2615,"_21377":58553,"_5":14632,"_28040":58494,"_3027":58554},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3572":2640,"_30844":2615,"_21377":58556,"_5":14632,"_28040":58497,"_3027":58557},[],"To operate certificates, continue with Certificates and Validation.",{"_3572":2641,"_30844":2615,"_21377":58559,"_5":14632,"_28040":58497,"_3027":58560},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3572":2642,"_30844":2615,"_21377":58562,"_5":14632,"_28040":58497,"_3027":58563},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3572":2643,"_30844":2643,"_5":14996,"_3027":58565,"_31202":58566,"_21377":58567,"_28040":2643},"PKI troubleshooting",[50349,51888,56039,54614],[],{"_3572":2644,"_30844":2643,"_21377":58569,"_5":14632,"_28040":2643,"_3027":58570},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3572":2645,"_30844":2643,"_5":31199,"_21377":58572,"_28040":58573,"_3027":58574},[],"/docs/pr-preview/pr-68/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3572":2646,"_30844":2643,"_5":31199,"_21377":58576,"_28040":58577,"_3027":58578},[],"/docs/pr-preview/pr-68/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3572":2647,"_30844":2643,"_5":31199,"_21377":58580,"_28040":58581,"_3027":58582},[],"/docs/pr-preview/pr-68/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3572":2648,"_30844":2643,"_21377":58584,"_5":14632,"_28040":2643,"_3027":58585},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3572":2649,"_30844":2643,"_21377":58587,"_5":14632,"_28040":2643,"_3027":58588},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3572":2650,"_30844":2643,"_21377":58590,"_5":14632,"_28040":58573,"_3027":55665},[],{"_3572":2651,"_30844":2643,"_21377":58592,"_5":14632,"_28040":58573,"_3027":58593},[],"What to inspect",{"_3572":2652,"_30844":2643,"_21377":58595,"_5":14632,"_28040":58573,"_3027":50383},[],{"_3572":2653,"_30844":2643,"_21377":58597,"_5":14632,"_28040":58573,"_3027":54881},[],{"_3572":2654,"_30844":2643,"_21377":58599,"_5":14632,"_28040":58573,"_3027":58600},[],"Exists, is active and has usable dates.",{"_3572":2655,"_30844":2643,"_21377":58602,"_5":14632,"_28040":58573,"_3027":58603},[],"Authorities.",{"_3572":2656,"_30844":2643,"_21377":58605,"_5":14632,"_28040":58573,"_3027":58606},[],"Key",{"_3572":2657,"_30844":2643,"_21377":58608,"_5":14632,"_28040":58573,"_3027":58609},[],"The record has a usable private key and the engine can sign.",{"_3572":2658,"_30844":2643,"_21377":58611,"_5":14632,"_28040":58573,"_3027":58612},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3572":2659,"_30844":2643,"_21377":58614,"_5":14632,"_28040":58573,"_3027":58615},[],"CSR",{"_3572":2660,"_30844":2643,"_21377":58617,"_5":14632,"_28040":58573,"_3027":58618},[],"Correct PEM and verifiable signature.",{"_3572":2661,"_30844":2643,"_21377":58620,"_5":14632,"_28040":58573,"_3027":58621},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3572":2662,"_30844":2643,"_21377":58623,"_5":14632,"_28040":58573,"_3027":58624},[],"Profile",{"_3572":2663,"_30844":2643,"_21377":58626,"_5":14632,"_28040":58573,"_3027":58627},[],"Selected source, existing ID, allowed algorithm and size.",{"_3572":2664,"_30844":2643,"_21377":58629,"_5":14632,"_28040":58573,"_3027":58630},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3572":2665,"_30844":2643,"_21377":58632,"_5":14632,"_28040":58573,"_3027":55817},[],{"_3572":2666,"_30844":2643,"_21377":58634,"_5":14632,"_28040":58573,"_3027":58635},[],"Appropriate subject, SAN, usages and dates.",{"_3572":2667,"_30844":2643,"_21377":58637,"_5":14632,"_28040":58573,"_3027":58638},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3572":2668,"_30844":2643,"_21377":58640,"_5":14632,"_28040":58573,"_3027":58641},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3572":2669,"_30844":2643,"_21377":58643,"_5":14632,"_28040":58573,"_3027":58644},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3572":2670,"_30844":2643,"_21377":58646,"_5":14632,"_28040":58577,"_3027":58647},[],"Check each boundary independently:",{"_3572":2671,"_30844":2643,"_21377":58649,"_5":14632,"_28040":58577,"_3027":58650},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3572":2672,"_30844":2643,"_21377":58652,"_5":14632,"_28040":58577,"_3027":58653},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3572":2673,"_30844":2643,"_21377":58655,"_5":14632,"_28040":58577,"_3027":58656},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3572":2674,"_30844":2643,"_21377":58658,"_5":14632,"_28040":58577,"_3027":58659},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3572":2675,"_30844":2643,"_21377":58661,"_5":14632,"_28040":58577,"_3027":58662},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3572":2676,"_30844":2643,"_21377":58664,"_5":14632,"_28040":58577,"_3027":58665},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3572":2677,"_30844":2643,"_21377":58667,"_5":14632,"_28040":58581,"_3027":58668},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3572":2678,"_30844":2643,"_21377":58670,"_5":14632,"_28040":58581,"_3027":58671},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3572":2679,"_30844":2679,"_5":14996,"_3027":58673,"_31202":58674,"_21377":58675,"_28040":2679},"Security",[50349],[],{"_3572":2680,"_30844":2679,"_21377":58677,"_5":14632,"_28040":2679,"_3027":58678},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3572":2681,"_30844":2679,"_5":31199,"_21377":58680,"_28040":58681,"_3027":58682},[],"/docs/pr-preview/pr-68/security#report-a-vulnerability","Report a vulnerability",{"_3572":2682,"_30844":2679,"_5":31199,"_21377":58684,"_28040":58685,"_3027":58686},[],"/docs/pr-preview/pr-68/security#what-to-include-in-a-report","What to include in a report",{"_3572":2683,"_30844":2679,"_5":31199,"_21377":58688,"_28040":58689,"_3027":58690},[],"/docs/pr-preview/pr-68/security#supported-versions","Supported versions",{"_3572":2684,"_30844":2679,"_5":31199,"_21377":58692,"_28040":58693,"_3027":58694},[],"/docs/pr-preview/pr-68/security#responsible-disclosure","Responsible disclosure",{"_3572":2685,"_30844":2679,"_21377":58696,"_5":14632,"_28040":2679,"_3027":58697},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3572":2686,"_30844":2679,"_21377":58699,"_5":14632,"_28040":58681,"_3027":58700},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3572":2687,"_30844":2679,"_21377":58702,"_5":14632,"_28040":58681,"_3027":58703},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3572":2688,"_30844":2679,"_21377":58705,"_5":14632,"_28040":58681,"_3027":15366},[],{"_3572":2689,"_30844":2679,"_21377":58707,"_5":14632,"_28040":58681,"_3027":15208},[],{"_3572":2690,"_30844":2679,"_21377":58709,"_5":14632,"_28040":58681,"_3027":15255},[],{"_3572":2691,"_30844":2679,"_21377":58711,"_5":14632,"_28040":58681,"_3027":58712},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3572":2692,"_30844":2679,"_21377":58714,"_5":14632,"_28040":58681,"_3027":58715},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3572":2693,"_30844":2679,"_21377":58717,"_5":14632,"_28040":58685,"_3027":58718},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3572":2694,"_30844":2679,"_21377":58720,"_5":14632,"_28040":58685,"_3027":58721},[],"Do not include in the report:",{"_3572":2695,"_30844":2679,"_21377":58723,"_5":14632,"_28040":58685,"_3027":58724},[],"Credentials, tokens, or private keys",{"_3572":2696,"_30844":2679,"_21377":58726,"_5":14632,"_28040":58685,"_3027":58727},[],"Customer data or customer-identifiable information",{"_3572":2697,"_30844":2679,"_21377":58729,"_5":14632,"_28040":58685,"_3027":58730},[],"Confidential architecture or internal infrastructure details",{"_3572":2698,"_30844":2679,"_21377":58732,"_5":14632,"_28040":58689,"_3027":58733},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3572":2699,"_30844":2679,"_21377":58735,"_5":14632,"_28040":58689,"_3027":58736},[],"For upgrade guidance, see Upgrades.",{"_3572":2700,"_30844":2679,"_21377":58738,"_5":14632,"_28040":58693,"_3027":58739},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3572":2701,"_30844":2679,"_21377":58741,"_5":14632,"_28040":58693,"_3027":58742},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3572":2702,"_30844":2679,"_21377":58744,"_5":14632,"_28040":58693,"_3027":58745},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3572":2703,"_30844":2679,"_21377":58747,"_5":14632,"_28040":58693,"_3027":58748},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3572":2704,"_30844":2679,"_21377":58750,"_5":14632,"_28040":58693,"_3027":58751},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3572":2705,"_30844":2705,"_5":14996,"_3027":58753,"_31202":58754,"_21377":58756,"_28040":2705},"3.8.0 to 4.0.0",[50349,58755],"Upgrades",[],{"_3572":2706,"_30844":2705,"_21377":58758,"_5":14632,"_28040":2705,"_3027":58759},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3572":2707,"_30844":2705,"_5":31199,"_21377":58761,"_28040":58762,"_3027":58763},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3572":2708,"_30844":2705,"_5":31199,"_21377":58765,"_28040":58766,"_3027":58767},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3572":2709,"_30844":2705,"_5":31199,"_21377":58769,"_28040":58770,"_3027":58771},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3572":2710,"_30844":2705,"_5":31199,"_21377":58773,"_28040":58774,"_3027":58775},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3572":2711,"_30844":2705,"_5":31199,"_21377":58777,"_28040":58778,"_3027":58779},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3572":2712,"_30844":2705,"_5":31199,"_21377":58781,"_28040":58782,"_3027":58783},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3572":2713,"_30844":2705,"_5":31199,"_21377":58785,"_28040":58786,"_3027":58787},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3572":2714,"_30844":2705,"_5":31199,"_21377":58789,"_28040":58790,"_3027":58791},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3572":2715,"_30844":2705,"_5":31199,"_21377":58793,"_28040":58794,"_3027":58795},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3572":2716,"_30844":2705,"_5":31199,"_21377":58797,"_28040":58798,"_3027":58799},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3572":2717,"_30844":2705,"_5":31199,"_21377":58801,"_28040":58802,"_3027":58803},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3572":2718,"_30844":2705,"_5":31199,"_21377":58805,"_28040":58806,"_3027":58807},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3572":2719,"_30844":2705,"_5":31199,"_21377":58809,"_28040":58810,"_3027":58811},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3572":2720,"_30844":2705,"_5":31199,"_21377":58813,"_28040":58814,"_3027":58815},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3572":2721,"_30844":2705,"_5":31199,"_21377":58817,"_28040":58818,"_3027":58819},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3572":2722,"_30844":2705,"_5":31199,"_21377":58821,"_28040":58822,"_3027":58823},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3572":2723,"_30844":2705,"_5":31199,"_21377":58825,"_28040":58826,"_3027":58827},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3572":2724,"_30844":2705,"_5":31199,"_21377":58829,"_28040":58830,"_3027":58831},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3572":2725,"_30844":2705,"_5":31199,"_21377":58833,"_28040":58834,"_3027":58835},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3572":2726,"_30844":2705,"_5":31199,"_21377":58837,"_28040":58838,"_3027":58839},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3572":2727,"_30844":2705,"_5":31199,"_21377":58841,"_28040":58842,"_3027":58843},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3572":2728,"_30844":2705,"_5":31199,"_21377":58845,"_28040":58846,"_3027":58847},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3572":2729,"_30844":2705,"_5":31199,"_21377":58849,"_28040":58850,"_3027":58851},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3572":2730,"_30844":2705,"_5":31199,"_21377":58853,"_28040":58854,"_3027":58855},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3572":2731,"_30844":2705,"_5":31199,"_21377":58857,"_28040":58858,"_3027":58859},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3572":2732,"_30844":2705,"_5":31199,"_21377":58861,"_28040":58862,"_3027":58863},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3572":2733,"_30844":2705,"_5":31199,"_21377":58865,"_28040":58866,"_3027":58867},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3572":2734,"_30844":2705,"_5":31199,"_21377":58869,"_28040":58870,"_3027":58871},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3572":2735,"_30844":2705,"_5":31199,"_21377":58873,"_28040":58874,"_3027":58875},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3572":2736,"_30844":2705,"_5":31199,"_21377":58877,"_28040":58878,"_3027":58879},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3572":2737,"_30844":2705,"_5":31199,"_21377":58881,"_28040":58882,"_3027":58883},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3572":2738,"_30844":2705,"_5":31199,"_21377":58885,"_28040":58886,"_3027":58887},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3572":2739,"_30844":2705,"_5":31199,"_21377":58889,"_28040":58890,"_3027":58891},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3572":2740,"_30844":2705,"_5":31199,"_21377":58893,"_28040":58894,"_3027":58895},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3572":2741,"_30844":2705,"_5":31199,"_21377":58897,"_28040":58898,"_3027":58899},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3572":2742,"_30844":2705,"_5":31199,"_21377":58901,"_28040":58902,"_3027":58903},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3572":2743,"_30844":2705,"_5":31199,"_21377":58905,"_28040":58906,"_3027":58907},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3572":2744,"_30844":2705,"_5":31199,"_21377":58909,"_28040":58910,"_3027":58911},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3572":2745,"_30844":2705,"_5":31199,"_21377":58913,"_28040":58914,"_3027":58915},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3572":2746,"_30844":2705,"_5":31199,"_21377":58917,"_28040":58918,"_3027":58919},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3572":2747,"_30844":2705,"_5":31199,"_21377":58921,"_28040":58922,"_3027":54614},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3572":2748,"_30844":2705,"_5":31199,"_21377":58924,"_28040":58925,"_3027":58926},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3572":2749,"_30844":2705,"_5":31199,"_21377":58928,"_28040":58929,"_3027":58930},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3572":2750,"_30844":2705,"_21377":58932,"_5":14632,"_28040":2705,"_3027":58933},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3572":2751,"_30844":2705,"_21377":58935,"_5":14632,"_28040":2705,"_3027":58936},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3572":2752,"_30844":2705,"_21377":58938,"_5":14632,"_28040":2705,"_3027":58939},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3572":2753,"_30844":2705,"_21377":58941,"_5":14632,"_28040":2705,"_3027":58942},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3572":2754,"_30844":2705,"_21377":58944,"_5":14632,"_28040":2705,"_3027":58945},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3572":2755,"_30844":2705,"_21377":58947,"_5":14632,"_28040":2705,"_3027":58948},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3572":2756,"_30844":2705,"_21377":58950,"_5":14632,"_28040":2705,"_3027":58951},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3572":2757,"_30844":2705,"_21377":58953,"_5":14632,"_28040":58766,"_3027":58954},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3572":2758,"_30844":2705,"_21377":58956,"_5":14632,"_28040":58766,"_3027":58957},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3572":2759,"_30844":2705,"_21377":58959,"_5":14632,"_28040":58770,"_3027":58960},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3572":2760,"_30844":2705,"_21377":58962,"_5":14632,"_28040":58770,"_3027":58963},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3572":2761,"_30844":2705,"_21377":58965,"_5":14632,"_28040":58774,"_3027":58966},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3572":2762,"_30844":2705,"_21377":58968,"_5":14632,"_28040":58778,"_3027":58969},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3572":2763,"_30844":2705,"_21377":58971,"_5":14632,"_28040":58778,"_3027":58972},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3572":2764,"_30844":2705,"_21377":58974,"_5":14632,"_28040":58778,"_3027":58975},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3572":2765,"_30844":2705,"_21377":58977,"_5":14632,"_28040":58778,"_3027":58978},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3572":2766,"_30844":2705,"_21377":58980,"_5":14632,"_28040":58778,"_3027":58981},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3572":2767,"_30844":2705,"_21377":58983,"_5":14632,"_28040":58782,"_3027":58984},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3572":2768,"_30844":2705,"_21377":58986,"_5":14632,"_28040":58782,"_3027":58987},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3572":2769,"_30844":2705,"_21377":58989,"_5":14632,"_28040":58782,"_3027":58990},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3572":2770,"_30844":2705,"_21377":58992,"_5":14632,"_28040":58782,"_3027":58993},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3572":2771,"_30844":2705,"_21377":58995,"_5":14632,"_28040":58782,"_3027":58996},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3572":2772,"_30844":2705,"_21377":58998,"_5":14632,"_28040":58782,"_3027":58999},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3572":2773,"_30844":2705,"_21377":59001,"_5":14632,"_28040":58786,"_3027":59002},[],"Change",{"_3572":2774,"_30844":2705,"_21377":59004,"_5":14632,"_28040":58786,"_3027":59005},[],"Who is affected",{"_3572":2775,"_30844":2705,"_21377":59007,"_5":14632,"_28040":58786,"_3027":59008},[],"Severity",{"_3572":2776,"_30844":2705,"_21377":59010,"_5":14632,"_28040":58786,"_3027":57478},[],{"_3572":2777,"_30844":2705,"_21377":59012,"_5":14632,"_28040":58786,"_3027":58795},[],{"_3572":2778,"_30844":2705,"_21377":59014,"_5":14632,"_28040":58786,"_3027":59015},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3572":2779,"_30844":2705,"_21377":59017,"_5":14632,"_28040":58786,"_3027":59018},[],"High: KMS and VA start on empty volumes",{"_3572":2780,"_30844":2705,"_21377":59020,"_5":14632,"_28040":58786,"_3027":59021},[],"Copy the data into the new volumes",{"_3572":2781,"_30844":2705,"_21377":59023,"_5":14632,"_28040":58786,"_3027":58799},[],{"_3572":2782,"_30844":2705,"_21377":59025,"_5":14632,"_28040":58786,"_3027":59026},[],"Every Helm release",{"_3572":2783,"_30844":2705,"_21377":59028,"_5":14632,"_28040":58786,"_3027":59029},[],"High: `helm upgrade` fails",{"_3572":2784,"_30844":2705,"_21377":59031,"_5":14632,"_28040":58786,"_3027":59032},[],"Remove or rename legacy keys",{"_3572":2785,"_30844":2705,"_21377":59034,"_5":14632,"_28040":58786,"_3027":58803},[],{"_3572":2786,"_30844":2705,"_21377":59036,"_5":14632,"_28040":58786,"_3027":59037},[],"Every deployment",{"_3572":2787,"_30844":2705,"_21377":59039,"_5":14632,"_28040":58786,"_3027":59040},[],"High: without a bootstrap principal there is no administrator",{"_3572":2788,"_30844":2705,"_21377":59042,"_5":14632,"_28040":58786,"_3027":59043},[],"Configure `services.authz`",{"_3572":2789,"_30844":2705,"_21377":59045,"_5":14632,"_28040":58786,"_3027":58807},[],{"_3572":2790,"_30844":2705,"_21377":59047,"_5":14632,"_28040":58786,"_3027":59026},[],{"_3572":2791,"_30844":2705,"_21377":59049,"_5":14632,"_28040":58786,"_3027":59050},[],"High: `helm upgrade` fails on the old keys",{"_3572":2792,"_30844":2705,"_21377":59052,"_5":14632,"_28040":58786,"_3027":59053},[],"Move JWKS and roles into `services.authz`",{"_3572":2793,"_30844":2705,"_21377":59055,"_5":14632,"_28040":58786,"_3027":58827},[],{"_3572":2794,"_30844":2705,"_21377":59057,"_5":14632,"_28040":58786,"_3027":59058},[],"3.8.0 deployments with per-service databases",{"_3572":2795,"_30844":2705,"_21377":59060,"_5":14632,"_28040":58786,"_3027":59061},[],"High: services find no data, or a migration aborts",{"_3572":2796,"_30844":2705,"_21377":59063,"_5":14632,"_28040":58786,"_3027":59064},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3572":2797,"_30844":2705,"_21377":59066,"_5":14632,"_28040":58786,"_3027":58831},[],{"_3572":2798,"_30844":2705,"_21377":59068,"_5":14632,"_28040":58786,"_3027":59069},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3572":2799,"_30844":2705,"_21377":59071,"_5":14632,"_28040":58786,"_3027":59072},[],"High: the backend no longer starts with them",{"_3572":2800,"_30844":2705,"_21377":59074,"_5":14632,"_28040":58786,"_3027":59075},[],"Move to PostgreSQL before upgrading",{"_3572":2801,"_30844":2705,"_21377":59077,"_5":14632,"_28040":58786,"_3027":58875},[],{"_3572":2802,"_30844":2705,"_21377":59079,"_5":14632,"_28040":58786,"_3027":59080},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3572":2803,"_30844":2705,"_21377":59082,"_5":14632,"_28040":58786,"_3027":59083},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3572":2804,"_30844":2705,"_21377":59085,"_5":14632,"_28040":58786,"_3027":59086},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3572":2805,"_30844":2705,"_21377":59088,"_5":14632,"_28040":58786,"_3027":59089},[],"Webhooks with file references",{"_3572":2806,"_30844":2705,"_21377":59091,"_5":14632,"_28040":58786,"_3027":59092},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3572":2807,"_30844":2705,"_21377":59094,"_5":14632,"_28040":58786,"_3027":59095},[],"High: enrollments calling the webhook fail",{"_3572":2808,"_30844":2705,"_21377":59097,"_5":14632,"_28040":58786,"_3027":59098},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3572":2809,"_30844":2705,"_21377":59100,"_5":14632,"_28040":58786,"_3027":58811},[],{"_3572":2810,"_30844":2705,"_21377":59102,"_5":14632,"_28040":58786,"_3027":59103},[],"Releases with per-service identity overrides or mounted key material",{"_3572":2811,"_30844":2705,"_21377":59105,"_5":14632,"_28040":58786,"_3027":59106},[],"Medium: services cannot read their files",{"_3572":2812,"_30844":2705,"_21377":59108,"_5":14632,"_28040":58786,"_3027":59109},[],"Remove the overrides and fix volume ownership",{"_3572":2813,"_30844":2705,"_21377":59111,"_5":14632,"_28040":58786,"_3027":58815},[],{"_3572":2814,"_30844":2705,"_21377":59113,"_5":14632,"_28040":58786,"_3027":59114},[],"Releases that set `amqp.tls`",{"_3572":2815,"_30844":2705,"_21377":59116,"_5":14632,"_28040":58786,"_3027":59117},[],"Medium: clients connect to the wrong port",{"_3572":2816,"_30844":2705,"_21377":59119,"_5":14632,"_28040":58786,"_3027":59120},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3572":2817,"_30844":2705,"_21377":59122,"_5":14632,"_28040":58786,"_3027":58835},[],{"_3572":2818,"_30844":2705,"_21377":59124,"_5":14632,"_28040":58786,"_3027":59125},[],"Installations whose CA keys predate the KMS",{"_3572":2819,"_30844":2705,"_21377":59127,"_5":14632,"_28040":58786,"_3027":59128},[],"Medium: CA keys stay unmanaged",{"_3572":2820,"_30844":2705,"_21377":59130,"_5":14632,"_28040":58786,"_3027":59131},[],"Run the CA-to-KMS migration",{"_3572":2821,"_30844":2705,"_21377":59133,"_5":14632,"_28040":58786,"_3027":59134},[],"Receiver certificate verification",{"_3572":2822,"_30844":2705,"_21377":59136,"_5":14632,"_28040":58786,"_3027":59137},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3572":2823,"_30844":2705,"_21377":59139,"_5":14632,"_28040":58786,"_3027":59140},[],"Medium: credentials go to an unverified receiver",{"_3572":2824,"_30844":2705,"_21377":59142,"_5":14632,"_28040":58786,"_3027":59143},[],"Set `insecure_skip_verify` to `false`",{"_3572":2825,"_30844":2705,"_21377":59145,"_5":14632,"_28040":58786,"_3027":58851},[],{"_3572":2826,"_30844":2705,"_21377":59147,"_5":14632,"_28040":58786,"_3027":59148},[],"Scripts and consoles that edit DMSs through the API",{"_3572":2827,"_30844":2705,"_21377":59150,"_5":14632,"_28040":58786,"_3027":59151},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3572":2828,"_30844":2705,"_21377":59153,"_5":14632,"_28040":58786,"_3027":59154},[],"Read the DMS before editing and use the new field",{"_3572":2829,"_30844":2705,"_21377":59156,"_5":14632,"_28040":58786,"_3027":58871},[],{"_3572":2830,"_30844":2705,"_21377":59158,"_5":14632,"_28040":58786,"_3027":59159},[],"Clients that create or update CRL settings through the API",{"_3572":2831,"_30844":2705,"_21377":59161,"_5":14632,"_28040":58786,"_3027":59162},[],"Medium: requests with the old field return an error",{"_3572":2832,"_30844":2705,"_21377":59164,"_5":14632,"_28040":58786,"_3027":59165},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3572":2833,"_30844":2705,"_21377":59167,"_5":14632,"_28040":58786,"_3027":58879},[],{"_3572":2834,"_30844":2705,"_21377":59169,"_5":14632,"_28040":58786,"_3027":59170},[],"Alert subscriptions and consumers of the VA events",{"_3572":2835,"_30844":2705,"_21377":59172,"_5":14632,"_28040":58786,"_3027":59173},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3572":2836,"_30844":2705,"_21377":59175,"_5":14632,"_28040":58786,"_3027":59176},[],"Review conditions filtering on the old event payload or subject",{"_3572":2837,"_30844":2705,"_21377":59178,"_5":14632,"_28040":58786,"_3027":58867},[],{"_3572":2838,"_30844":2705,"_21377":59180,"_5":14632,"_28040":58786,"_3027":59181},[],"Consumers that read the device `events` field",{"_3572":2839,"_30844":2705,"_21377":59183,"_5":14632,"_28040":58786,"_3027":59184},[],"Medium: the field disappears",{"_3572":2840,"_30844":2705,"_21377":59186,"_5":14632,"_28040":58786,"_3027":59187},[],"Use the new event endpoints",{"_3572":2841,"_30844":2705,"_21377":59189,"_5":14632,"_28040":58786,"_3027":58887},[],{"_3572":2842,"_30844":2705,"_21377":59191,"_5":14632,"_28040":58786,"_3027":59192},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3572":2843,"_30844":2705,"_21377":59194,"_5":14632,"_28040":58786,"_3027":59195},[],"Medium: the VA migration aborts",{"_3572":2844,"_30844":2705,"_21377":59197,"_5":14632,"_28040":58786,"_3027":59198},[],"Fix the affected roles before upgrading",{"_3572":2845,"_30844":2705,"_21377":59200,"_5":14632,"_28040":58786,"_3027":58819},[],{"_3572":2846,"_30844":2705,"_21377":59202,"_5":14632,"_28040":58786,"_3027":59203},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3572":2847,"_30844":2705,"_21377":59205,"_5":14632,"_28040":58786,"_3027":59206},[],"Low to medium: validation errors or changed defaults",{"_3572":2848,"_30844":2705,"_21377":59208,"_5":14632,"_28040":58786,"_3027":59209},[],"Update the values file",{"_3572":2849,"_30844":2705,"_21377":59211,"_5":14632,"_28040":58786,"_3027":58859},[],{"_3572":2850,"_30844":2705,"_21377":59213,"_5":14632,"_28040":58786,"_3027":59214},[],"Clients that send the DMS ID in the update body",{"_3572":2851,"_30844":2705,"_21377":59216,"_5":14632,"_28040":58786,"_3027":59217},[],"Low: the ID in the URL wins",{"_3572":2852,"_30844":2705,"_21377":59219,"_5":14632,"_28040":58786,"_3027":59220},[],"Send the ID in the URL",{"_3572":2853,"_30844":2705,"_21377":59222,"_5":14632,"_28040":58786,"_3027":58883},[],{"_3572":2854,"_30844":2705,"_21377":59224,"_5":14632,"_28040":58786,"_3027":59225},[],"Clients that send an `id` when creating or importing CAs",{"_3572":2855,"_30844":2705,"_21377":59227,"_5":14632,"_28040":58786,"_3027":59228},[],"Low: the ID in the body is ignored, and the field is removed",{"_3572":2856,"_30844":2705,"_21377":59230,"_5":14632,"_28040":58786,"_3027":59231},[],"Let the backend assign the ID and use the returned one",{"_3572":2857,"_30844":2705,"_21377":59233,"_5":14632,"_28040":58786,"_3027":58863},[],{"_3572":2858,"_30844":2705,"_21377":59235,"_5":14632,"_28040":58786,"_3027":59236},[],"Consumers that match on certificate `type`",{"_3572":2859,"_30844":2705,"_21377":59238,"_5":14632,"_28040":58786,"_3027":59239},[],"Low: two values are renamed",{"_3572":2860,"_30844":2705,"_21377":59241,"_5":14632,"_28040":58786,"_3027":59242},[],"Adapt consumers",{"_3572":2861,"_30844":2705,"_21377":59244,"_5":14632,"_28040":58786,"_3027":58855},[],{"_3572":2862,"_30844":2705,"_21377":59246,"_5":14632,"_28040":58786,"_3027":59247},[],"Any DMS",{"_3572":2863,"_30844":2705,"_21377":59249,"_5":14632,"_28040":58786,"_3027":59250},[],"Low: informational",{"_3572":2864,"_30844":2705,"_21377":59252,"_5":14632,"_28040":58786,"_3027":59253},[],"Read both blocks before editing",{"_3572":2865,"_30844":2705,"_21377":59255,"_5":14632,"_28040":58794,"_3027":59256},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3572":2866,"_30844":2705,"_21377":59258,"_5":14632,"_28040":58794,"_3027":59259},[],"Step 4 of the migration guide copies the data.",{"_3572":2867,"_30844":2705,"_21377":59261,"_5":14632,"_28040":58798,"_3027":59262},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3572":2868,"_30844":2705,"_21377":59264,"_5":14632,"_28040":58802,"_3027":59265},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3572":2869,"_30844":2705,"_21377":59267,"_5":14632,"_28040":58806,"_3027":59268},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3572":2870,"_30844":2705,"_21377":59270,"_5":14632,"_28040":58810,"_3027":59271},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3572":2871,"_30844":2705,"_21377":59273,"_5":14632,"_28040":58810,"_3027":59274},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3572":2872,"_30844":2705,"_21377":59276,"_5":14632,"_28040":58814,"_3027":59277},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3572":2873,"_30844":2705,"_21377":59279,"_5":14632,"_28040":58818,"_3027":59280},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3572":2874,"_30844":2705,"_21377":59282,"_5":14632,"_28040":58818,"_3027":59283},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3572":2875,"_30844":2705,"_21377":59285,"_5":14632,"_28040":58818,"_3027":59286},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3572":2876,"_30844":2705,"_21377":59288,"_5":14632,"_28040":58818,"_3027":59289},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3572":2877,"_30844":2705,"_21377":59291,"_5":14632,"_28040":58818,"_3027":59292},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3572":2878,"_30844":2705,"_21377":59294,"_5":14632,"_28040":58818,"_3027":59295},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3572":2879,"_30844":2705,"_21377":59297,"_5":14632,"_28040":58826,"_3027":59298},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3572":2880,"_30844":2705,"_21377":59300,"_5":14632,"_28040":58826,"_3027":59301},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3572":2881,"_30844":2705,"_21377":59303,"_5":14632,"_28040":58826,"_3027":59304},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3572":2882,"_30844":2705,"_21377":59306,"_5":14632,"_28040":58826,"_3027":59307},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3572":2883,"_30844":2705,"_21377":59309,"_5":14632,"_28040":58826,"_3027":59310},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3572":2884,"_30844":2705,"_21377":59312,"_5":14632,"_28040":58830,"_3027":59313},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3572":2885,"_30844":2705,"_21377":59315,"_5":14632,"_28040":58834,"_3027":59316},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3572":2886,"_30844":2705,"_21377":59318,"_5":14632,"_28040":58834,"_3027":59319},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3572":2887,"_30844":2705,"_21377":59321,"_5":14632,"_28040":58834,"_3027":59322},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3572":2888,"_30844":2705,"_21377":59324,"_5":14632,"_28040":58834,"_3027":59325},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3572":2889,"_30844":2705,"_21377":59327,"_5":14632,"_28040":58834,"_3027":59328},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3572":2890,"_30844":2705,"_21377":59330,"_5":14632,"_28040":58834,"_3027":59331},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3572":2891,"_30844":2705,"_21377":59333,"_5":14632,"_28040":58834,"_3027":59334},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3572":2892,"_30844":2705,"_21377":59336,"_5":14632,"_28040":58834,"_3027":59337},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3572":2893,"_30844":2705,"_21377":59339,"_5":14632,"_28040":58838,"_3027":59340},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3572":2894,"_30844":2705,"_21377":59342,"_5":14632,"_28040":58846,"_3027":59343},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3572":2895,"_30844":2705,"_21377":59345,"_5":14632,"_28040":58846,"_3027":59346},[],"Field in 3.8.0",{"_3572":2896,"_30844":2705,"_21377":59348,"_5":14632,"_28040":58846,"_3027":59349},[],"Field in 4.0.0",{"_3572":2897,"_30844":2705,"_21377":59351,"_5":14632,"_28040":58846,"_3027":59352},[],"`validate_server_cert`",{"_3572":2898,"_30844":2705,"_21377":59354,"_5":14632,"_28040":58846,"_3027":59355},[],"`insecure_skip_verify` (value negated)",{"_3572":2899,"_30844":2705,"_21377":59357,"_5":14632,"_28040":58846,"_3027":59358},[],"`oidc`",{"_3572":2900,"_30844":2705,"_21377":59360,"_5":14632,"_28040":58846,"_3027":59361},[],"`jwt_options`",{"_3572":2901,"_30844":2705,"_21377":59363,"_5":14632,"_28040":58846,"_3027":59364},[],"`apikey`",{"_3572":2902,"_30844":2705,"_21377":59366,"_5":14632,"_28040":58846,"_3027":59367},[],"`apikey_options`",{"_3572":2903,"_30844":2705,"_21377":59369,"_5":14632,"_28040":58846,"_3027":59370},[],"`mtls`",{"_3572":2904,"_30844":2705,"_21377":59372,"_5":14632,"_28040":58846,"_3027":59373},[],"`mtls_options`",{"_3572":2905,"_30844":2705,"_21377":59375,"_5":14632,"_28040":58846,"_3027":59376},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3572":2906,"_30844":2705,"_21377":59378,"_5":14632,"_28040":58846,"_3027":59379},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3572":2907,"_30844":2705,"_21377":59381,"_5":14632,"_28040":58846,"_3027":59382},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3572":2908,"_30844":2705,"_21377":59384,"_5":14632,"_28040":58850,"_3027":59385},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3572":2909,"_30844":2705,"_21377":59387,"_5":14632,"_28040":58850,"_3027":59388},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3572":2910,"_30844":2705,"_21377":59390,"_5":14632,"_28040":58850,"_3027":59391},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3572":2911,"_30844":2705,"_21377":59393,"_5":14632,"_28040":58854,"_3027":59394},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3572":2912,"_30844":2705,"_21377":59396,"_5":14632,"_28040":58858,"_3027":59397},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3572":2913,"_30844":2705,"_21377":59399,"_5":14632,"_28040":58862,"_3027":59400},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3572":2914,"_30844":2705,"_21377":59402,"_5":14632,"_28040":58866,"_3027":59403},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3572":2915,"_30844":2705,"_21377":59405,"_5":14632,"_28040":58866,"_3027":59406},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3572":2916,"_30844":2705,"_21377":59408,"_5":14632,"_28040":58866,"_3027":59409},[],"`POST /v1/devices/:id/events` creates an event.",{"_3572":2917,"_30844":2705,"_21377":59411,"_5":14632,"_28040":58866,"_3027":59412},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3572":2918,"_30844":2705,"_21377":59414,"_5":14632,"_28040":58870,"_3027":59415},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3572":2919,"_30844":2705,"_21377":59417,"_5":14632,"_28040":58874,"_3027":59418},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3572":2920,"_30844":2705,"_21377":59420,"_5":14632,"_28040":58874,"_3027":59421},[],"Route",{"_3572":2921,"_30844":2705,"_21377":59423,"_5":14632,"_28040":58874,"_3027":53801},[],{"_3572":2922,"_30844":2705,"_21377":59425,"_5":14632,"_28040":58874,"_3027":59426},[],"`GET /v1/crl-settings`",{"_3572":2923,"_30844":2705,"_21377":59428,"_5":14632,"_28040":58874,"_3027":59429},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3572":2924,"_30844":2705,"_21377":59431,"_5":14632,"_28040":58874,"_3027":59432},[],"`GET /v1/crl-settings/{ca-id}`",{"_3572":2925,"_30844":2705,"_21377":59434,"_5":14632,"_28040":58874,"_3027":59435},[],"Reads the settings of a CA.",{"_3572":2926,"_30844":2705,"_21377":59437,"_5":14632,"_28040":58874,"_3027":59438},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3572":2927,"_30844":2705,"_21377":59440,"_5":14632,"_28040":58874,"_3027":59441},[],"Replaces `crl_options`.",{"_3572":2928,"_30844":2705,"_21377":59443,"_5":14632,"_28040":58874,"_3027":59444},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3572":2929,"_30844":2705,"_21377":59446,"_5":14632,"_28040":58874,"_3027":59447},[],"Removes the archived settings of a CA.",{"_3572":2930,"_30844":2705,"_21377":59449,"_5":14632,"_28040":58874,"_3027":59450},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3572":2931,"_30844":2705,"_21377":59452,"_5":14632,"_28040":58874,"_3027":59453},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3572":2932,"_30844":2705,"_21377":59455,"_5":14632,"_28040":58874,"_3027":59456},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3572":2933,"_30844":2705,"_21377":59458,"_5":14632,"_28040":58874,"_3027":59459},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3572":2934,"_30844":2705,"_21377":59461,"_5":14632,"_28040":58874,"_3027":59462},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3572":2935,"_30844":2705,"_21377":59464,"_5":14632,"_28040":58874,"_3027":59465},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3572":2936,"_30844":2705,"_21377":59467,"_5":14632,"_28040":58874,"_3027":59468},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3572":2937,"_30844":2705,"_21377":59470,"_5":14632,"_28040":58874,"_3027":59471},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3572":2938,"_30844":2705,"_21377":59473,"_5":14632,"_28040":58874,"_3027":59474},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3572":2939,"_30844":2705,"_21377":59476,"_5":14632,"_28040":58874,"_3027":59477},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3572":2940,"_30844":2705,"_21377":59479,"_5":14632,"_28040":58874,"_3027":59480},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3572":2941,"_30844":2705,"_21377":59482,"_5":14632,"_28040":58878,"_3027":59483},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3572":2942,"_30844":2705,"_21377":59485,"_5":14632,"_28040":58882,"_3027":59486},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3572":2943,"_30844":2705,"_21377":59488,"_5":14632,"_28040":58886,"_3027":59489},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3572":2944,"_30844":2705,"_21377":59491,"_5":14632,"_28040":58890,"_3027":59492},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3572":2945,"_30844":2705,"_21377":59494,"_5":14632,"_28040":58894,"_3027":59495},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3572":2946,"_30844":2705,"_21377":59497,"_5":14632,"_28040":58894,"_3027":59498},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3572":2947,"_30844":2705,"_21377":59500,"_5":14632,"_28040":58894,"_3027":59501},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3572":2948,"_30844":2705,"_21377":59503,"_5":14632,"_28040":58894,"_3027":59504},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3572":2949,"_30844":2705,"_21377":59506,"_5":14632,"_28040":58894,"_3027":59507},[],"Record the names of your local-storage PVCs:",{"_3572":2950,"_30844":2705,"_21377":59509,"_5":14632,"_28040":58894,"_3027":59510},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3572":2951,"_30844":2705,"_21377":59512,"_5":14632,"_28040":58898,"_3027":59513},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3572":2952,"_30844":2705,"_21377":59515,"_5":14632,"_28040":58898,"_3027":59516},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3572":2953,"_30844":2705,"_21377":59518,"_5":14632,"_28040":58898,"_3027":59519},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3572":2954,"_30844":2705,"_21377":59521,"_5":14632,"_28040":58898,"_3027":59522},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3572":2955,"_30844":2705,"_21377":59524,"_5":14632,"_28040":58898,"_3027":59525},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3572":2956,"_30844":2705,"_21377":59527,"_5":14632,"_28040":58902,"_3027":59528},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3572":2957,"_30844":2705,"_21377":59530,"_5":14632,"_28040":58902,"_3027":59531},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3572":2958,"_30844":2705,"_21377":59533,"_5":14632,"_28040":58902,"_3027":59534},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values. Each schema can also supply its own username and password through the `LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_USERNAME` and `LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_PASSWORD` environment variables, which when set override the username and password that the global `postgres.username` and `postgres.password` values contribute to that schema's rendered connection. See Credential environment variables.",{"_3572":2959,"_30844":2705,"_21377":59536,"_5":14632,"_28040":58902,"_3027":59537},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3572":2960,"_30844":2705,"_21377":59539,"_5":14632,"_28040":58902,"_3027":59540},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3572":2961,"_30844":2705,"_21377":59542,"_5":14632,"_28040":58902,"_3027":59543},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3572":2962,"_30844":2705,"_21377":59545,"_5":14632,"_28040":58902,"_3027":59546},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3572":2963,"_30844":2705,"_21377":59548,"_5":14632,"_28040":58902,"_3027":59549},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3572":2964,"_30844":2705,"_21377":59551,"_5":14632,"_28040":58902,"_3027":59552},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3572":2965,"_30844":2705,"_21377":59554,"_5":14632,"_28040":58902,"_3027":59555},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3572":2966,"_30844":2705,"_21377":59557,"_5":14632,"_28040":58902,"_3027":59558},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3572":2967,"_30844":2705,"_21377":59560,"_5":14632,"_28040":58902,"_3027":59561},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3572":2968,"_30844":2705,"_21377":59563,"_5":14632,"_28040":58906,"_3027":59564},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3572":2969,"_30844":2705,"_21377":59566,"_5":14632,"_28040":58906,"_3027":59567},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3572":2970,"_30844":2705,"_21377":59569,"_5":14632,"_28040":58910,"_3027":59570},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3572":2971,"_30844":2705,"_21377":59572,"_5":14632,"_28040":58910,"_3027":59573},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3572":2972,"_30844":2705,"_21377":59575,"_5":14632,"_28040":58910,"_3027":59576},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3572":2973,"_30844":2705,"_21377":59578,"_5":14632,"_28040":58910,"_3027":59579},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3572":2974,"_30844":2705,"_21377":59581,"_5":14632,"_28040":58910,"_3027":59582},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3572":2975,"_30844":2705,"_21377":59584,"_5":14632,"_28040":58910,"_3027":59585},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3572":2976,"_30844":2705,"_21377":59587,"_5":14632,"_28040":58910,"_3027":59588},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3572":2977,"_30844":2705,"_21377":59590,"_5":14632,"_28040":58910,"_3027":59591},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3572":2978,"_30844":2705,"_21377":59593,"_5":14632,"_28040":58910,"_3027":59594},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3572":2979,"_30844":2705,"_21377":59596,"_5":14632,"_28040":58910,"_3027":59597},[],"**Remove the helper and restore the recorded replica counts:**",{"_3572":2980,"_30844":2705,"_21377":59599,"_5":14632,"_28040":58910,"_3027":59600},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3572":2981,"_30844":2705,"_21377":59602,"_5":14632,"_28040":58914,"_3027":59603},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3572":2982,"_30844":2705,"_21377":59605,"_5":14632,"_28040":58914,"_3027":59606},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3572":2983,"_30844":2705,"_21377":59608,"_5":14632,"_28040":58918,"_3027":59609},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3572":2984,"_30844":2705,"_21377":59611,"_5":14632,"_28040":58918,"_3027":59612},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3572":2985,"_30844":2705,"_21377":59614,"_5":14632,"_28040":58918,"_3027":59615},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3572":2986,"_30844":2705,"_21377":59617,"_5":14632,"_28040":58918,"_3027":59618},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3572":2987,"_30844":2705,"_21377":59620,"_5":14632,"_28040":58918,"_3027":59621},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3572":2988,"_30844":2705,"_21377":59623,"_5":14632,"_28040":58918,"_3027":59624},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3572":2989,"_30844":2705,"_21377":59626,"_5":14632,"_28040":58918,"_3027":59627},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3572":2990,"_30844":2705,"_21377":59629,"_5":14632,"_28040":58918,"_3027":59630},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3572":2991,"_30844":2705,"_21377":59632,"_5":14632,"_28040":58922,"_3027":59633},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3572":2992,"_30844":2705,"_21377":59635,"_5":14632,"_28040":58922,"_3027":59636},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3572":2993,"_30844":2705,"_21377":59638,"_5":14632,"_28040":58922,"_3027":59639},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3572":2994,"_30844":2705,"_21377":59641,"_5":14632,"_28040":58922,"_3027":59642},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3572":2995,"_30844":2705,"_21377":59644,"_5":14632,"_28040":58922,"_3027":59645},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3572":2996,"_30844":2705,"_21377":59647,"_5":14632,"_28040":58922,"_3027":59648},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3572":2997,"_30844":2705,"_21377":59650,"_5":14632,"_28040":58922,"_3027":59651},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3572":2998,"_30844":2705,"_21377":59653,"_5":14632,"_28040":58922,"_3027":59654},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3572":2999,"_30844":2705,"_21377":59656,"_5":14632,"_28040":58922,"_3027":59657},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3572":3000,"_30844":2705,"_21377":59659,"_5":14632,"_28040":58922,"_3027":59660},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3572":3001,"_30844":2705,"_21377":59662,"_5":14632,"_28040":58922,"_3027":59663},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3572":3002,"_30844":2705,"_21377":59665,"_5":14632,"_28040":58925,"_3027":59666},[],"After the upgrade, check in this order:",{"_3572":3003,"_30844":2705,"_21377":59668,"_5":14632,"_28040":58925,"_3027":59669},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3572":3004,"_30844":2705,"_21377":59671,"_5":14632,"_28040":58925,"_3027":59672},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3572":3005,"_30844":2705,"_21377":59674,"_5":14632,"_28040":58925,"_3027":59675},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3572":3006,"_30844":2705,"_21377":59677,"_5":14632,"_28040":58925,"_3027":59678},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3572":3007,"_30844":2705,"_21377":59680,"_5":14632,"_28040":58925,"_3027":59681},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3572":3008,"_30844":2705,"_21377":59683,"_5":14632,"_28040":58925,"_3027":59684},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3572":3009,"_30844":2705,"_21377":59686,"_5":14632,"_28040":58925,"_3027":59687},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3572":3010,"_30844":2705,"_21377":59689,"_5":14632,"_28040":58925,"_3027":59690},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3572":3011,"_30844":2705,"_21377":59692,"_5":14632,"_28040":58925,"_3027":59693},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3572":3012,"_30844":2705,"_21377":59695,"_5":14632,"_28040":58925,"_3027":59696},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3572":3013,"_30844":2705,"_21377":59698,"_5":14632,"_28040":58925,"_3027":59699},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3572":3014,"_30844":2705,"_21377":59701,"_5":14632,"_28040":58925,"_3027":59702},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3572":3015,"_30844":2705,"_21377":59704,"_5":14632,"_28040":58925,"_3027":59705},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3572":3016,"_30844":2705,"_21377":59707,"_5":14632,"_28040":58925,"_3027":59708},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3572":3017,"_30844":2705,"_21377":59710,"_5":14632,"_28040":58925,"_3027":59711},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3572":3018,"_30844":2705,"_21377":59713,"_5":14632,"_28040":58929,"_3027":59714},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3572":3019,"_30844":2705,"_21377":59716,"_5":14632,"_28040":58929,"_3027":59717},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3572":3020,"_30844":2705,"_21377":59719,"_5":14632,"_28040":58929,"_3027":59720},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3572":3021,"_30844":2705,"_21377":59722,"_5":14632,"_28040":58929,"_3027":59723},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3572":3022,"_30844":2705,"_21377":59725,"_5":14632,"_28040":58929,"_3027":59726},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_59729":59730,"_59731":59732,"_59733":59734,"_59735":59736,"_18548":3062,"_71782":3062},"language","english","sortableProperties",[3027,30844,5,28040],"sortablePropertiesWithTypes",{"_3027":25498,"_30844":25498,"_5":25498,"_28040":25498},"sorts",{"_3027":59737,"_30844":62749,"_5":65760,"_28040":68771},{"_4772":59738,"_59739":59740,"_5":25498},{"_14720":3331,"_15100":17619,"_15119":7737,"_29838":11235,"_15106":4116,"_20290":4102,"_14741":7135,"_14748":3431,"_29780":3441,"_30188":6167,"_30209":20600,"_29814":3280,"_35236":9051,"_29917":7690,"_30253":5064,"_35243":4915,"_35246":18916,"_35249":6649,"_35252":15409,"_30660":6664,"_35257":4729,"_35259":11816,"_30690":3318,"_15115":18627,"_35263":5282,"_35266":7099,"_35268":6356,"_30237":5546,"_30655":6956,"_30703":5117,"_35273":3200,"_35275":3517,"_35277":6147,"_29934":3128,"_35280":16174,"_35282":3800,"_35284":4855,"_35286":3753,"_35288":3445,"_29851":14564,"_35291":6165,"_35293":3633,"_29845":3105,"_30274":3687,"_35297":17215,"_35299":12561,"_35302":9403,"_29891":4115,"_35306":4143,"_29771":4431,"_35309":14565,"_29819":18694,"_35312":4888,"_35314":3426,"_35317":13054,"_15109":3159,"_35320":30056,"_35322":3114,"_35325":4186,"_35327":12310,"_35329":9687,"_35331":4513,"_35333":6220,"_20293":6717,"_35336":6792,"_35338":3495,"_29792":6052,"_30231":12702,"_35342":3346,"_35344":4291,"_35346":4741,"_30720":7678,"_35349":20594,"_35351":6093,"_35353":23650,"_30824":12274,"