844":71789,"_5":31199,"_21377":118816,"_28040":118817,"_3027":118818},[],"/docs/pr-preview/pr-68/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3572":71796,"_30844":71789,"_5":31199,"_21377":118820,"_28040":118821,"_3027":118822},[],"/docs/pr-preview/pr-68/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3572":71797,"_30844":71789,"_5":31199,"_21377":118824,"_28040":118825,"_3027":118826},[],"/docs/pr-preview/pr-68/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3572":71798,"_30844":71789,"_21377":118828,"_5":14632,"_28040":71789,"_3027":118829},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3572":71799,"_30844":71789,"_21377":118831,"_5":14632,"_28040":118801,"_3027":118832},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3572":71800,"_30844":71789,"_21377":118834,"_5":14632,"_28040":118801,"_3027":118835},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3572":71801,"_30844":71789,"_21377":118837,"_5":14632,"_28040":118801,"_3027":118838},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3572":71802,"_30844":71789,"_21377":118840,"_5":14632,"_28040":118805,"_3027":118841},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3572":71803,"_30844":71789,"_21377":118843,"_5":14632,"_28040":118805,"_3027":118844},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3572":71804,"_30844":71789,"_21377":118846,"_5":14632,"_28040":118805,"_3027":118847},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3572":71805,"_30844":71789,"_21377":118849,"_5":14632,"_28040":118809,"_3027":118850},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3572":71806,"_30844":71789,"_21377":118852,"_5":14632,"_28040":118813,"_3027":118853},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3572":71807,"_30844":71789,"_21377":118855,"_5":14632,"_28040":118817,"_3027":118856},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3572":71808,"_30844":71789,"_21377":118858,"_5":14632,"_28040":118821,"_3027":118859},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3572":71809,"_30844":71789,"_21377":118861,"_5":14632,"_28040":118825,"_3027":118862},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3572":71810,"_30844":71810,"_5":14996,"_3027":118864,"_31202":118865,"_21377":118866,"_28040":71810},"Despliega Lamassu",[50349,118793],[],{"_3572":71811,"_30844":71810,"_21377":118868,"_5":14632,"_28040":71810,"_3027":118869},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3572":71812,"_30844":71810,"_5":31199,"_21377":118871,"_28040":118872,"_3027":118873},[],"/docs/pr-preview/pr-68/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3572":71813,"_30844":71810,"_5":31199,"_21377":118875,"_28040":118876,"_3027":118877},[],"/docs/pr-preview/pr-68/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3572":71814,"_30844":71810,"_5":31199,"_21377":118879,"_28040":118880,"_3027":118881},[],"/docs/pr-preview/pr-68/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3572":71815,"_30844":71810,"_21377":118883,"_5":14632,"_28040":71810,"_3027":118884},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3572":71816,"_30844":71810,"_21377":118886,"_5":14632,"_28040":118872,"_3027":118887},[],"Modelo",{"_3572":71817,"_30844":71810,"_21377":118889,"_5":14632,"_28040":118872,"_3027":118890},[],"Recomendado para",{"_3572":71818,"_30844":71810,"_21377":118892,"_5":14632,"_28040":118872,"_3027":118893},[],"Quién opera la infraestructura",{"_3572":71819,"_30844":71810,"_21377":118895,"_5":14632,"_28040":118872,"_3027":118896},[],"Punto de partida",{"_3572":71820,"_30844":71810,"_21377":118898,"_5":14632,"_28040":118872,"_3027":50456},[],{"_3572":71821,"_30844":71810,"_21377":118900,"_5":14632,"_28040":118872,"_3027":118901},[],"Producción, entornos regulados y despliegues personalizados",{"_3572":71822,"_30844":71810,"_21377":118903,"_5":14632,"_28040":118872,"_3027":118904},[],"Tu equipo",{"_3572":71823,"_30844":71810,"_21377":118906,"_5":14632,"_28040":118872,"_3027":118907},[],"Helm o Fastlane",{"_3572":71824,"_30844":71810,"_21377":118909,"_5":14632,"_28040":118872,"_3027":50468},[],{"_3572":71825,"_30844":71810,"_21377":118911,"_5":14632,"_28040":118872,"_3027":118912},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3572":71826,"_30844":71810,"_21377":118914,"_5":14632,"_28040":118872,"_3027":118904},[],{"_3572":71827,"_30844":71810,"_21377":118916,"_5":14632,"_28040":118872,"_3027":118917},[],"Imagen preconfigurada en EC2",{"_3572":71828,"_30844":71810,"_21377":118919,"_5":14632,"_28040":118872,"_3027":50479},[],{"_3572":71829,"_30844":71810,"_21377":118921,"_5":14632,"_28040":118872,"_3027":118922},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3572":71830,"_30844":71810,"_21377":118924,"_5":14632,"_28040":118872,"_3027":50485},[],{"_3572":71831,"_30844":71810,"_21377":118926,"_5":14632,"_28040":118872,"_3027":118927},[],"Suscripción gestionada",{"_3572":71832,"_30844":71810,"_21377":118929,"_5":14632,"_28040":118872,"_3027":118930},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3572":71833,"_30844":71810,"_21377":118932,"_5":14632,"_28040":118872,"_3027":118933},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3572":71834,"_30844":71810,"_21377":118935,"_5":14632,"_28040":118872,"_3027":118936},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3572":71835,"_30844":71810,"_21377":118938,"_5":14632,"_28040":118876,"_3027":118939},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3572":71836,"_30844":71810,"_21377":118941,"_5":14632,"_28040":118880,"_3027":118942},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3572":71837,"_30844":71837,"_5":14996,"_3027":118944,"_31202":118945,"_21377":118946,"_28040":71837},"Utiliza Lamassu como SaaS",[50349,118793,118794],[],{"_3572":71838,"_30844":71837,"_21377":118948,"_5":14632,"_28040":71837,"_3027":118949},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3572":71839,"_30844":71837,"_5":31199,"_21377":118951,"_28040":118952,"_3027":118953},[],"/docs/pr-preview/pr-68/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3572":71840,"_30844":71837,"_5":31199,"_21377":118955,"_28040":118956,"_3027":118957},[],"/docs/pr-preview/pr-68/es/deployment/saas#planes","Planes",{"_3572":71841,"_30844":71837,"_5":31199,"_21377":118959,"_28040":118960,"_3027":118961},[],"/docs/pr-preview/pr-68/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3572":71842,"_30844":71837,"_21377":118963,"_5":14632,"_28040":71837,"_3027":118964},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3572":71843,"_30844":71837,"_21377":118966,"_5":14632,"_28040":118952,"_3027":118967},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3572":71844,"_30844":71837,"_21377":118969,"_5":14632,"_28040":118952,"_3027":118970},[],"Copias de seguridad automáticas.",{"_3572":71845,"_30844":71837,"_21377":118972,"_5":14632,"_28040":118952,"_3027":118973},[],"Actualizaciones de versión.",{"_3572":71846,"_30844":71837,"_21377":118975,"_5":14632,"_28040":118952,"_3027":118976},[],"Soporte técnico y SLA según el plan contratado.",{"_3572":71847,"_30844":71837,"_21377":118978,"_5":14632,"_28040":118956,"_3027":50540},[],{"_3572":71848,"_30844":71837,"_21377":118980,"_5":14632,"_28040":118956,"_3027":118981},[],"Dispositivos",{"_3572":71849,"_30844":71837,"_21377":118983,"_5":14632,"_28040":118956,"_3027":118984},[],"Soporte",{"_3572":71850,"_30844":71837,"_21377":118986,"_5":14632,"_28040":118956,"_3027":50549},[],{"_3572":71851,"_30844":71837,"_21377":118988,"_5":14632,"_28040":118956,"_3027":50552},[],{"_3572":71852,"_30844":71837,"_21377":118990,"_5":14632,"_28040":118956,"_3027":118991},[],"Hasta 1.000",{"_3572":71853,"_30844":71837,"_21377":118993,"_5":14632,"_28040":118956,"_3027":50558},[],{"_3572":71854,"_30844":71837,"_21377":118995,"_5":14632,"_28040":118956,"_3027":118996},[],"99,5 %",{"_3572":71855,"_30844":71837,"_21377":118998,"_5":14632,"_28040":118956,"_3027":50564},[],{"_3572":71856,"_30844":71837,"_21377":119000,"_5":14632,"_28040":118956,"_3027":119001},[],"Hasta 10.000",{"_3572":71857,"_30844":71837,"_21377":119003,"_5":14632,"_28040":118956,"_3027":119004},[],"Email y chat",{"_3572":71858,"_30844":71837,"_21377":119006,"_5":14632,"_28040":118956,"_3027":119007},[],"99,9 %",{"_3572":71859,"_30844":71837,"_21377":119009,"_5":14632,"_28040":118956,"_3027":50576},[],{"_3572":71860,"_30844":71837,"_21377":119011,"_5":14632,"_28040":118956,"_3027":119012},[],"Ilimitados",{"_3572":71861,"_30844":71837,"_21377":119014,"_5":14632,"_28040":118956,"_3027":119015},[],"Dedicado",{"_3572":71862,"_30844":71837,"_21377":119017,"_5":14632,"_28040":118956,"_3027":119018},[],"99,99 %",{"_3572":71863,"_30844":71837,"_21377":119020,"_5":14632,"_28040":118960,"_3027":119021},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3572":71864,"_30844":71837,"_21377":119023,"_5":14632,"_28040":118960,"_3027":119024},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3572":71865,"_30844":71865,"_5":14996,"_3027":50593,"_31202":119026,"_21377":119028,"_28040":71865},[50349,118793,119027],"Kubernetes autogestionado",[],{"_3572":71866,"_30844":71865,"_21377":119030,"_5":14632,"_28040":71865,"_3027":119031},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3572":71867,"_30844":71865,"_5":31199,"_21377":119033,"_28040":119034,"_3027":119035},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3572":71868,"_30844":71865,"_5":31199,"_21377":119037,"_28040":119038,"_3027":119039},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3572":71869,"_30844":71865,"_5":31199,"_21377":119041,"_28040":119042,"_3027":119043},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3572":71870,"_30844":71865,"_5":31199,"_21377":119045,"_28040":119046,"_3027":119047},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3572":71871,"_30844":71865,"_5":31199,"_21377":119049,"_28040":119050,"_3027":119051},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3572":71872,"_30844":71865,"_5":31199,"_21377":119053,"_28040":119054,"_3027":119055},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3572":71873,"_30844":71865,"_5":31199,"_21377":119057,"_28040":119058,"_3027":119059},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3572":71874,"_30844":71865,"_5":31199,"_21377":119061,"_28040":119062,"_3027":119063},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3572":71875,"_30844":71865,"_5":31199,"_21377":119065,"_28040":119066,"_3027":119067},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3572":71876,"_30844":71865,"_5":31199,"_21377":119069,"_28040":119070,"_3027":119071},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3572":71877,"_30844":71865,"_5":31199,"_21377":119073,"_28040":119074,"_3027":119075},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3572":71878,"_30844":71865,"_21377":119077,"_5":14632,"_28040":119034,"_3027":119078},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3572":71879,"_30844":71865,"_21377":119080,"_5":14632,"_28040":119034,"_3027":119081},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3572":71880,"_30844":71865,"_21377":119083,"_5":14632,"_28040":119038,"_3027":119084},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3572":71881,"_30844":71865,"_21377":119086,"_5":14632,"_28040":119038,"_3027":119087},[],"Fastlane instala o configura",{"_3572":71882,"_30844":71865,"_21377":119089,"_5":14632,"_28040":119038,"_3027":119090},[],"Tú sigues proporcionando",{"_3572":71883,"_30844":71865,"_21377":119092,"_5":14632,"_28040":119038,"_3027":119093},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3572":71884,"_30844":71865,"_21377":119095,"_5":14632,"_28040":119038,"_3027":119096},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3572":71885,"_30844":71865,"_21377":119098,"_5":14632,"_28040":119038,"_3027":119099},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3572":71886,"_30844":71865,"_21377":119101,"_5":14632,"_28040":119038,"_3027":119102},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3572":71887,"_30844":71865,"_21377":119104,"_5":14632,"_28040":119038,"_3027":119105},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3572":71888,"_30844":71865,"_21377":119107,"_5":14632,"_28040":119038,"_3027":119108},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3572":71889,"_30844":71865,"_21377":119110,"_5":14632,"_28040":119038,"_3027":119111},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3572":71890,"_30844":71865,"_21377":119113,"_5":14632,"_28040":119038,"_3027":119114},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3572":71891,"_30844":71865,"_21377":119116,"_5":14632,"_28040":119038,"_3027":119117},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3572":71892,"_30844":71865,"_21377":119119,"_5":14632,"_28040":119042,"_3027":119120},[],"Necesitas:",{"_3572":71893,"_30844":71865,"_21377":119122,"_5":14632,"_28040":119042,"_3027":119123},[],"un clúster Kubernetes existente",{"_3572":71894,"_30844":71865,"_21377":119125,"_5":14632,"_28040":119042,"_3027":119126},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3572":71895,"_30844":71865,"_21377":119128,"_5":14632,"_28040":119042,"_3027":50695},[],{"_3572":71896,"_30844":71865,"_21377":119130,"_5":14632,"_28040":119042,"_3027":24146},[],{"_3572":71897,"_30844":71865,"_21377":119132,"_5":14632,"_28040":119042,"_3027":119133},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3572":71898,"_30844":71865,"_21377":119135,"_5":14632,"_28040":119042,"_3027":119136},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3572":71899,"_30844":71865,"_21377":119138,"_5":14632,"_28040":119042,"_3027":119139},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3572":71900,"_30844":71865,"_21377":119141,"_5":14632,"_28040":119042,"_3027":119142},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3572":71901,"_30844":71865,"_21377":119144,"_5":14632,"_28040":119042,"_3027":119145},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3572":71902,"_30844":71865,"_21377":119147,"_5":14632,"_28040":119046,"_3027":119148},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3572":71903,"_30844":71865,"_21377":119150,"_5":14632,"_28040":119046,"_3027":119151},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3572":71904,"_30844":71865,"_21377":119153,"_5":14632,"_28040":119050,"_3027":119154},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3572":71905,"_30844":71865,"_21377":119156,"_5":14632,"_28040":119050,"_3027":119157},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3572":71906,"_30844":71865,"_21377":119159,"_5":14632,"_28040":119050,"_3027":119160},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3572":71907,"_30844":71865,"_21377":119162,"_5":14632,"_28040":119050,"_3027":119163},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3572":71908,"_30844":71865,"_21377":119165,"_5":14632,"_28040":119054,"_3027":119166},[],"Opción",{"_3572":71909,"_30844":71865,"_21377":119168,"_5":14632,"_28040":119054,"_3027":119169},[],"Valor predeterminado",{"_3572":71910,"_30844":71865,"_21377":119171,"_5":14632,"_28040":119054,"_3027":119172},[],"Propósito",{"_3572":71911,"_30844":71865,"_21377":119174,"_5":14632,"_28040":119054,"_3027":50742},[],{"_3572":71912,"_30844":71865,"_21377":119176,"_5":14632,"_28040":119054,"_3027":50745},[],{"_3572":71913,"_30844":71865,"_21377":119178,"_5":14632,"_28040":119054,"_3027":119179},[],"Muestra la ayuda",{"_3572":71914,"_30844":71865,"_21377":119181,"_5":14632,"_28040":119054,"_3027":50751},[],{"_3572":71915,"_30844":71865,"_21377":119183,"_5":14632,"_28040":119054,"_3027":119184},[],"contexto actual",{"_3572":71916,"_30844":71865,"_21377":119186,"_5":14632,"_28040":119054,"_3027":119187},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3572":71917,"_30844":71865,"_21377":119189,"_5":14632,"_28040":119054,"_3027":50760},[],{"_3572":71918,"_30844":71865,"_21377":119191,"_5":14632,"_28040":119054,"_3027":6708},[],{"_3572":71919,"_30844":71865,"_21377":119193,"_5":14632,"_28040":119054,"_3027":119194},[],"Omite prompts y genera credenciales para las dependencias",{"_3572":71920,"_30844":71865,"_21377":119196,"_5":14632,"_28040":119054,"_3027":50768},[],{"_3572":71921,"_30844":71865,"_21377":119198,"_5":14632,"_28040":119054,"_3027":50771},[],{"_3572":71922,"_30844":71865,"_21377":119200,"_5":14632,"_28040":119054,"_3027":119201},[],"Namespace de la instalación",{"_3572":71923,"_30844":71865,"_21377":119203,"_5":14632,"_28040":119054,"_3027":50777},[],{"_3572":71924,"_30844":71865,"_21377":119205,"_5":14632,"_28040":119054,"_3027":50780},[],{"_3572":71925,"_30844":71865,"_21377":119207,"_5":14632,"_28040":119054,"_3027":119208},[],"Dominio usado por la UI, OIDC y el certificado",{"_3572":71926,"_30844":71865,"_21377":119210,"_5":14632,"_28040":119054,"_3027":50786},[],{"_3572":71927,"_30844":71865,"_21377":119212,"_5":14632,"_28040":119054,"_3027":15433},[],{"_3572":71928,"_30844":71865,"_21377":119214,"_5":14632,"_28040":119054,"_3027":119215},[],"Versión del chart de Lamassu",{"_3572":71929,"_30844":71865,"_21377":119217,"_5":14632,"_28040":119054,"_3027":50794},[],{"_3572":71930,"_30844":71865,"_21377":119219,"_5":14632,"_28040":119054,"_3027":50797},[],{"_3572":71931,"_30844":71865,"_21377":119221,"_5":14632,"_28040":119054,"_3027":119222},[],"Puerto del listener HTTPS",{"_3572":71932,"_30844":71865,"_21377":119224,"_5":14632,"_28040":119054,"_3027":50803},[],{"_3572":71933,"_30844":71865,"_21377":119226,"_5":14632,"_28040":119054,"_3027":50806},[],{"_3572":71934,"_30844":71865,"_21377":119228,"_5":14632,"_28040":119054,"_3027":119229},[],"Puerto del listener HTTP",{"_3572":71935,"_30844":71865,"_21377":119231,"_5":14632,"_28040":119054,"_3027":50812},[],{"_3572":71936,"_30844":71865,"_21377":119233,"_5":14632,"_28040":119054,"_3027":50745},[],{"_3572":71937,"_30844":71865,"_21377":119235,"_5":14632,"_28040":119054,"_3027":119236},[],"Certificado PEM para TLS downstream",{"_3572":71938,"_30844":71865,"_21377":119238,"_5":14632,"_28040":119054,"_3027":50820},[],{"_3572":71939,"_30844":71865,"_21377":119240,"_5":14632,"_28040":119054,"_3027":50745},[],{"_3572":71940,"_30844":71865,"_21377":119242,"_5":14632,"_28040":119054,"_3027":119243},[],"Clave privada PEM para TLS downstream",{"_3572":71941,"_30844":71865,"_21377":119245,"_5":14632,"_28040":119054,"_3027":50828},[],{"_3572":71942,"_30844":71865,"_21377":119247,"_5":14632,"_28040":119054,"_3027":119248},[],"chart del repositorio",{"_3572":71943,"_30844":71865,"_21377":119250,"_5":14632,"_28040":119054,"_3027":119251},[],"Usa un chart local de Lamassu sin empaquetar",{"_3572":71944,"_30844":71865,"_21377":119253,"_5":14632,"_28040":119054,"_3027":50837},[],{"_3572":71945,"_30844":71865,"_21377":119255,"_5":14632,"_28040":119054,"_3027":119256},[],"detección automática",{"_3572":71946,"_30844":71865,"_21377":119258,"_5":14632,"_28040":119054,"_3027":119259},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3572":71947,"_30844":71865,"_21377":119261,"_5":14632,"_28040":119054,"_3027":50845},[],{"_3572":71948,"_30844":71865,"_21377":119263,"_5":14632,"_28040":119054,"_3027":6708},[],{"_3572":71949,"_30844":71865,"_21377":119265,"_5":14632,"_28040":119054,"_3027":119266},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3572":71950,"_30844":71865,"_21377":119268,"_5":14632,"_28040":119054,"_3027":50853},[],{"_3572":71951,"_30844":71865,"_21377":119270,"_5":14632,"_28040":119054,"_3027":6708},[],{"_3572":71952,"_30844":71865,"_21377":119272,"_5":14632,"_28040":119054,"_3027":119273},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3572":71953,"_30844":71865,"_21377":119275,"_5":14632,"_28040":119054,"_3027":50861},[],{"_3572":71954,"_30844":71865,"_21377":119277,"_5":14632,"_28040":119054,"_3027":6708},[],{"_3572":71955,"_30844":71865,"_21377":119279,"_5":14632,"_28040":119054,"_3027":119280},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3572":71956,"_30844":71865,"_21377":119282,"_5":14632,"_28040":119054,"_3027":50869},[],{"_3572":71957,"_30844":71865,"_21377":119284,"_5":14632,"_28040":119054,"_3027":6708},[],{"_3572":71958,"_30844":71865,"_21377":119286,"_5":14632,"_28040":119054,"_3027":119287},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3572":71959,"_30844":71865,"_21377":119289,"_5":14632,"_28040":119054,"_3027":50877},[],{"_3572":71960,"_30844":71865,"_21377":119291,"_5":14632,"_28040":119054,"_3027":50880},[],{"_3572":71961,"_30844":71865,"_21377":119293,"_5":14632,"_28040":119054,"_3027":119294},[],"Usa otro chart local de SoftHSM",{"_3572":71962,"_30844":71865,"_21377":119296,"_5":14632,"_28040":119054,"_3027":119297},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3572":71963,"_30844":71865,"_21377":119299,"_5":14632,"_28040":119058,"_3027":119300},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3572":71964,"_30844":71865,"_21377":119302,"_5":14632,"_28040":119058,"_3027":119303},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3572":71965,"_30844":71865,"_21377":119305,"_5":14632,"_28040":119058,"_3027":119306},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3572":71966,"_30844":71865,"_21377":119308,"_5":14632,"_28040":119058,"_3027":119309},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3572":71967,"_30844":71865,"_21377":119311,"_5":14632,"_28040":119058,"_3027":119312},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3572":71968,"_30844":71865,"_21377":119314,"_5":14632,"_28040":119058,"_3027":119315},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3572":71969,"_30844":71865,"_21377":119317,"_5":14632,"_28040":119062,"_3027":50907},[],{"_3572":71970,"_30844":71865,"_21377":119319,"_5":14632,"_28040":119062,"_3027":119320},[],"valida las herramientas locales y el clúster seleccionado",{"_3572":71971,"_30844":71865,"_21377":119322,"_5":14632,"_28040":119062,"_3027":119323},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3572":71972,"_30844":71865,"_21377":119325,"_5":14632,"_28040":119062,"_3027":119326},[],"crea el namespace",{"_3572":71973,"_30844":71865,"_21377":119328,"_5":14632,"_28040":119062,"_3027":119329},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3572":71974,"_30844":71865,"_21377":119331,"_5":14632,"_28040":119062,"_3027":119332},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3572":71975,"_30844":71865,"_21377":119334,"_5":14632,"_28040":119062,"_3027":119335},[],"instala RabbitMQ",{"_3572":71976,"_30844":71865,"_21377":119337,"_5":14632,"_28040":119062,"_3027":119338},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3572":71977,"_30844":71865,"_21377":119340,"_5":14632,"_28040":119062,"_3027":119341},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3572":71978,"_30844":71865,"_21377":119343,"_5":14632,"_28040":119062,"_3027":119344},[],"carga datos de ejemplo opcionalmente",{"_3572":71979,"_30844":71865,"_21377":119346,"_5":14632,"_28040":119062,"_3027":119347},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3572":71980,"_30844":71865,"_21377":119349,"_5":14632,"_28040":119066,"_3027":119350},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3572":71981,"_30844":71865,"_21377":119352,"_5":14632,"_28040":119066,"_3027":119353},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3572":71982,"_30844":71865,"_21377":119355,"_5":14632,"_28040":119070,"_3027":119356},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3572":71983,"_30844":71865,"_21377":119358,"_5":14632,"_28040":119070,"_3027":119359},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3572":71984,"_30844":71865,"_21377":119361,"_5":14632,"_28040":119070,"_3027":119362},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3572":71985,"_30844":71865,"_21377":119364,"_5":14632,"_28040":119074,"_3027":119365},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3572":71986,"_30844":71986,"_5":14996,"_3027":119367,"_31202":119368,"_21377":119369,"_28040":71986},"Instala con Helm",[50349,118793,119027],[],{"_3572":71987,"_30844":71986,"_21377":119371,"_5":14632,"_28040":71986,"_3027":119372},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3572":71988,"_30844":71986,"_5":31199,"_21377":119374,"_28040":119375,"_3027":119376},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3572":71989,"_30844":71986,"_5":31199,"_21377":119378,"_28040":119379,"_3027":119043},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3572":71990,"_30844":71986,"_5":31199,"_21377":119381,"_28040":119382,"_3027":119383},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3572":71991,"_30844":71986,"_5":31199,"_21377":119385,"_28040":119386,"_3027":119387},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3572":71992,"_30844":71986,"_5":31199,"_21377":119389,"_28040":119390,"_3027":119391},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3572":71993,"_30844":71986,"_5":31199,"_21377":119393,"_28040":119394,"_3027":119395},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3572":71994,"_30844":71986,"_5":31199,"_21377":119397,"_28040":119398,"_3027":119399},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#variables-de-entorno-para-credenciales","Variables de entorno para credenciales",{"_3572":71995,"_30844":71986,"_5":31199,"_21377":119401,"_28040":119402,"_3027":119403},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3572":71996,"_30844":71986,"_5":31199,"_21377":119405,"_28040":119406,"_3027":119407},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3572":71997,"_30844":71986,"_5":31199,"_21377":119409,"_28040":119410,"_3027":119411},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3572":71998,"_30844":71986,"_5":31199,"_21377":119413,"_28040":119414,"_3027":119415},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3572":71999,"_30844":71986,"_5":31199,"_21377":119417,"_28040":119418,"_3027":119419},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3572":72000,"_30844":71986,"_21377":119421,"_5":14632,"_28040":119375,"_3027":119422},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3572":72001,"_30844":71986,"_21377":119424,"_5":14632,"_28040":119379,"_3027":119425},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3572":72002,"_30844":71986,"_21377":119427,"_5":14632,"_28040":119379,"_3027":119428},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3572":72003,"_30844":71986,"_21377":119430,"_5":14632,"_28040":119379,"_3027":119431},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3572":72004,"_30844":71986,"_21377":119433,"_5":14632,"_28040":119379,"_3027":119434},[],"un broker RabbitMQ accesible y sus credenciales",{"_3572":72005,"_30844":71986,"_21377":119436,"_5":14632,"_28040":119379,"_3027":119437},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3572":72006,"_30844":71986,"_21377":119439,"_5":14632,"_28040":119379,"_3027":119440},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3572":72007,"_30844":71986,"_21377":119442,"_5":14632,"_28040":119379,"_3027":119443},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3572":72008,"_30844":71986,"_21377":119445,"_5":14632,"_28040":119379,"_3027":119446},[],"una StorageClass y un diseño de tráfico externo",{"_3572":72009,"_30844":71986,"_21377":119448,"_5":14632,"_28040":119379,"_3027":119449},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3572":72010,"_30844":71986,"_21377":119451,"_5":14632,"_28040":119379,"_3027":119452},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3572":72011,"_30844":71986,"_21377":119454,"_5":14632,"_28040":119379,"_3027":119455},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3572":72012,"_30844":71986,"_21377":119457,"_5":14632,"_28040":119382,"_3027":119458},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3572":72013,"_30844":71986,"_21377":119460,"_5":14632,"_28040":119382,"_3027":119461},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3572":72014,"_30844":71986,"_21377":119463,"_5":14632,"_28040":119382,"_3027":119464},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3572":72015,"_30844":71986,"_21377":119466,"_5":14632,"_28040":119386,"_3027":119467},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3572":72016,"_30844":71986,"_21377":119469,"_5":14632,"_28040":119386,"_3027":119470},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3572":72017,"_30844":71986,"_21377":119472,"_5":14632,"_28040":119386,"_3027":119473},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3572":72018,"_30844":71986,"_21377":119475,"_5":14632,"_28040":119386,"_3027":119476},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3572":72019,"_30844":71986,"_21377":119478,"_5":14632,"_28040":119390,"_3027":119479},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3572":72020,"_30844":71986,"_21377":119481,"_5":14632,"_28040":119394,"_3027":119482},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3572":72021,"_30844":71986,"_21377":119484,"_5":14632,"_28040":119394,"_3027":119485},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3572":72022,"_30844":71986,"_21377":119487,"_5":14632,"_28040":119394,"_3027":119488},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3572":72023,"_30844":71986,"_21377":119490,"_5":14632,"_28040":119394,"_3027":119491},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3572":72024,"_30844":71986,"_21377":119493,"_5":14632,"_28040":119394,"_3027":119494},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3572":72025,"_30844":71986,"_21377":119496,"_5":14632,"_28040":119394,"_3027":119497},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3572":72026,"_30844":71986,"_21377":119499,"_5":14632,"_28040":119394,"_3027":119500},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3572":72027,"_30844":71986,"_21377":119502,"_5":14632,"_28040":119398,"_3027":119503},[],"Los servicios leen un catálogo explícito de variables de entorno para credenciales cuando cargan su configuración al arrancar. Una variable definida y no vacía sobrescribe el valor correspondiente del YAML; una variable sin definir deja el valor del YAML intacto, así que un despliegue configurado solo mediante YAML sigue funcionando igual. Una variable también puede aportar una credencial que el archivo de valores no define. Las variables fuera de este catálogo se ignoran — otras variables `LAMASSU_*` no se recogen automáticamente.",{"_3572":72028,"_30844":71986,"_21377":119505,"_5":14632,"_28040":119398,"_3027":51096},[],{"_3572":72029,"_30844":71986,"_21377":119507,"_5":14632,"_28040":119398,"_3027":119508},[],"Configura",{"_3572":72030,"_30844":71986,"_21377":119510,"_5":14632,"_28040":119398,"_3027":51102},[],{"_3572":72031,"_30844":71986,"_21377":119512,"_5":14632,"_28040":119398,"_3027":119513},[],"credenciales del almacenamiento PostgreSQL",{"_3572":72032,"_30844":71986,"_21377":119515,"_5":14632,"_28040":119398,"_3027":51108},[],{"_3572":72033,"_30844":71986,"_21377":119517,"_5":14632,"_28040":119398,"_3027":119518},[],"credenciales de la base de datos propia del servicio authz",{"_3572":72034,"_30844":71986,"_21377":119520,"_5":14632,"_28040":119398,"_3027":51114},[],{"_3572":72035,"_30844":71986,"_21377":119522,"_5":14632,"_28040":119398,"_3027":119523},[],"un único par aplicado a todas las conexiones del bus de eventos: publisher, suscriptores y dead-letter queues. No hay división por cola.",{"_3572":72036,"_30844":71986,"_21377":119525,"_5":14632,"_28040":119398,"_3027":51120},[],{"_3572":72037,"_30844":71986,"_21377":119527,"_5":14632,"_28040":119398,"_3027":119528},[],"credenciales SMTP usadas por el envío de emails de alerta",{"_3572":72038,"_30844":71986,"_21377":119530,"_5":14632,"_28040":119398,"_3027":51126},[],{"_3572":72039,"_30844":71986,"_21377":119532,"_5":14632,"_28040":119398,"_3027":119533},[],"un par por cada schema definido en el mapa `services.authz.credentials`",{"_3572":72040,"_30844":71986,"_21377":119535,"_5":14632,"_28040":119398,"_3027":119536},[],"Definir una variable del catálogo con la cadena vacía nunca sobrescribe nada. Si el valor del YAML (o el predeterminado) no está vacío, el servicio falla al arrancar con un error que nombra la variable y la clave de configuración, por ejemplo `LAMASSU_POSTGRES_PASSWORD is set but empty`. Combinar una variable vacía con un valor de YAML vacío o ausente está permitido.",{"_3572":72041,"_30844":71986,"_21377":119538,"_5":14632,"_28040":119398,"_3027":119539},[],"Para los schemas de authz, `<SCHEMA>` es el nombre del schema del YAML en mayúsculas y con cada carácter no alfanumérico sustituido por `_`: `pki` se corresponde con `PKI`, y tanto `pki-v2` como `pki.v2` se corresponden con `PKI_V2`. Los bindings existen solo para los schemas presentes en el mapa de credenciales del YAML, así que las variables de schemas no listados se ignoran. Dos schemas que se reducen al mismo nombre (`pki-v2` y `pki.v2`) entran en conflicto: si se define una variable de cualquiera de los dos pares, el servicio falla al arrancar; si las variables no están definidas, se registra un warning y se usan los valores del YAML.",{"_3572":72042,"_30844":71986,"_21377":119541,"_5":14632,"_28040":119398,"_3027":119542},[],"Estas variables están pensadas para alimentarse desde Secrets de Kubernetes, de modo que las credenciales ya no tienen que escribirse en el YAML renderizado. Por ejemplo, inyecta un par en el pod de un servicio con el mecanismo estándar `secretKeyRef` de Kubernetes:",{"_3572":72043,"_30844":71986,"_21377":119544,"_5":14632,"_28040":119398,"_3027":119545},[],"Como las variables se leen cuando el servicio carga su configuración al arrancar, cambiar el Secret subyacente exige reiniciar los pods consumidores para que los nuevos valores surtan efecto.",{"_3572":72044,"_30844":71986,"_21377":119547,"_5":14632,"_28040":119402,"_3027":119548},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3572":72045,"_30844":71986,"_21377":119550,"_5":14632,"_28040":119402,"_3027":119551},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3572":72046,"_30844":71986,"_21377":119553,"_5":14632,"_28040":119402,"_3027":119554},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3572":72047,"_30844":71986,"_21377":119556,"_5":14632,"_28040":119402,"_3027":119557},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3572":72048,"_30844":71986,"_21377":119559,"_5":14632,"_28040":119406,"_3027":119560},[],"Para instalar un checkout local:",{"_3572":72049,"_30844":71986,"_21377":119562,"_5":14632,"_28040":119410,"_3027":119563},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3572":72050,"_30844":71986,"_21377":119565,"_5":14632,"_28040":119410,"_3027":119566},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3572":72051,"_30844":71986,"_21377":119568,"_5":14632,"_28040":119414,"_3027":119569},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3572":72052,"_30844":71986,"_21377":119571,"_5":14632,"_28040":119414,"_3027":119572},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3572":72053,"_30844":71986,"_21377":119574,"_5":14632,"_28040":119414,"_3027":119575},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3572":72054,"_30844":71986,"_21377":119577,"_5":14632,"_28040":119414,"_3027":119578},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3572":72055,"_30844":71986,"_21377":119580,"_5":14632,"_28040":119414,"_3027":119581},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3572":72056,"_30844":71986,"_21377":119583,"_5":14632,"_28040":119418,"_3027":119584},[],"Antes de pasar a producción, revisa:",{"_3572":72057,"_30844":71986,"_21377":119586,"_5":14632,"_28040":119418,"_3027":119587},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3572":72058,"_30844":71986,"_21377":119589,"_5":14632,"_28040":119418,"_3027":119590},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3572":72059,"_30844":71986,"_21377":119592,"_5":14632,"_28040":119418,"_3027":119593},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3572":72060,"_30844":71986,"_21377":119595,"_5":14632,"_28040":119418,"_3027":119596},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3572":72061,"_30844":71986,"_21377":119598,"_5":14632,"_28040":119418,"_3027":119599},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3572":72062,"_30844":71986,"_21377":119601,"_5":14632,"_28040":119418,"_3027":119602},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3572":72063,"_30844":71986,"_21377":119604,"_5":14632,"_28040":119418,"_3027":119605},[],"SMTP, observabilidad y entrega de alertas",{"_3572":72064,"_30844":71986,"_21377":119607,"_5":14632,"_28040":119418,"_3027":119608},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3572":72065,"_30844":71986,"_21377":119610,"_5":14632,"_28040":119418,"_3027":119611},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3572":72066,"_30844":72066,"_5":14996,"_3027":119613,"_31202":119614,"_21377":119615,"_28040":72066},"Expón el Gateway",[50349,118793,119027],[],{"_3572":72067,"_30844":72066,"_21377":119617,"_5":14632,"_28040":72066,"_3027":119618},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3572":72068,"_30844":72066,"_5":31199,"_21377":119620,"_28040":119621,"_3027":119622},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3572":72069,"_30844":72066,"_5":31199,"_21377":119624,"_28040":119625,"_3027":119626},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3572":72070,"_30844":72066,"_5":31199,"_21377":119628,"_28040":119629,"_3027":119630},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3572":72071,"_30844":72066,"_5":31199,"_21377":119632,"_28040":119633,"_3027":51230},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#k3s",{"_3572":72072,"_30844":72066,"_5":31199,"_21377":119635,"_28040":119636,"_3027":119637},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3572":72073,"_30844":72066,"_5":31199,"_21377":119639,"_28040":119640,"_3027":119641},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3572":72074,"_30844":72066,"_5":31199,"_21377":119643,"_28040":119644,"_3027":119645},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3572":72075,"_30844":72066,"_5":31199,"_21377":119647,"_28040":119648,"_3027":119649},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3572":72076,"_30844":72066,"_5":31199,"_21377":119651,"_28040":119652,"_3027":119653},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3572":72077,"_30844":72066,"_5":31199,"_21377":119655,"_28040":119656,"_3027":119657},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3572":72078,"_30844":72066,"_5":31199,"_21377":119659,"_28040":119660,"_3027":119661},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3572":72079,"_30844":72066,"_21377":119663,"_5":14632,"_28040":119621,"_3027":119664},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3572":72080,"_30844":72066,"_21377":119666,"_5":14632,"_28040":119621,"_3027":119667},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3572":72081,"_30844":72066,"_21377":119669,"_5":14632,"_28040":119625,"_3027":119670},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3572":72082,"_30844":72066,"_21377":119672,"_5":14632,"_28040":119625,"_3027":119673},[],"Defínelo únicamente cuando:",{"_3572":72083,"_30844":72066,"_21377":119675,"_5":14632,"_28040":119625,"_3027":119676},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3572":72084,"_30844":72066,"_21377":119678,"_5":14632,"_28040":119625,"_3027":119679},[],"esa dirección está asignada a este Gateway",{"_3572":72085,"_30844":72066,"_21377":119681,"_5":14632,"_28040":119625,"_3027":119682},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3572":72086,"_30844":72066,"_21377":119684,"_5":14632,"_28040":119625,"_3027":119685},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3572":72087,"_30844":72066,"_21377":119687,"_5":14632,"_28040":119625,"_3027":119688},[],"No confundas estos valores:",{"_3572":72088,"_30844":72066,"_21377":119690,"_5":14632,"_28040":119625,"_3027":119691},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3572":72089,"_30844":72066,"_21377":119693,"_5":14632,"_28040":119625,"_3027":119694},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3572":72090,"_30844":72066,"_21377":119696,"_5":14632,"_28040":119625,"_3027":119697},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3572":72091,"_30844":72066,"_21377":119699,"_5":14632,"_28040":119629,"_3027":119700},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3572":72092,"_30844":72066,"_21377":119702,"_5":14632,"_28040":119629,"_3027":119703},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3572":72093,"_30844":72066,"_21377":119705,"_5":14632,"_28040":119633,"_3027":119706},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3572":72094,"_30844":72066,"_21377":119708,"_5":14632,"_28040":119633,"_3027":119709},[],"Para el diseño recomendado:",{"_3572":72095,"_30844":72066,"_21377":119711,"_5":14632,"_28040":119633,"_3027":119712},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3572":72096,"_30844":72066,"_21377":119714,"_5":14632,"_28040":119633,"_3027":119715},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3572":72097,"_30844":72066,"_21377":119717,"_5":14632,"_28040":119633,"_3027":119718},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3572":72098,"_30844":72066,"_21377":119720,"_5":14632,"_28040":119633,"_3027":119721},[],"Apunta DNS a la dirección accesible de la VM.",{"_3572":72099,"_30844":72066,"_21377":119723,"_5":14632,"_28040":119633,"_3027":119724},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3572":72100,"_30844":72066,"_21377":119726,"_5":14632,"_28040":119636,"_3027":119727},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3572":72101,"_30844":72066,"_21377":119729,"_5":14632,"_28040":119640,"_3027":119730},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3572":72102,"_30844":72066,"_21377":119732,"_5":14632,"_28040":119640,"_3027":119733},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3572":72103,"_30844":72066,"_21377":119735,"_5":14632,"_28040":119644,"_3027":119736},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3572":72104,"_30844":72066,"_21377":119738,"_5":14632,"_28040":119644,"_3027":119739},[],"Requisito",{"_3572":72105,"_30844":72066,"_21377":119741,"_5":14632,"_28040":119644,"_3027":119742},[],"Diseño recomendado",{"_3572":72106,"_30844":72066,"_21377":119744,"_5":14632,"_28040":119644,"_3027":119745},[],"Consecuencia",{"_3572":72107,"_30844":72066,"_21377":119747,"_5":14632,"_28040":119644,"_3027":119748},[],"Varias URL o servicios de Lamassu",{"_3572":72108,"_30844":72066,"_21377":119750,"_5":14632,"_28040":119644,"_3027":119751},[],"Un Gateway con varias rutas",{"_3572":72109,"_30844":72066,"_21377":119753,"_5":14632,"_28040":119644,"_3027":119754},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3572":72110,"_30844":72066,"_21377":119756,"_5":14632,"_28040":119644,"_3027":119757},[],"Gateways independientes e IP externas distintas",{"_3572":72111,"_30844":72066,"_21377":119759,"_5":14632,"_28040":119644,"_3027":119760},[],"Una VIP por Gateway",{"_3572":72112,"_30844":72066,"_21377":119762,"_5":14632,"_28040":119644,"_3027":119763},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3572":72113,"_30844":72066,"_21377":119765,"_5":14632,"_28040":119644,"_3027":119766},[],"Gateways independientes, un nodo y una IP",{"_3572":72114,"_30844":72066,"_21377":119768,"_5":14632,"_28040":119644,"_3027":119769},[],"Puertos externos diferentes",{"_3572":72115,"_30844":72066,"_21377":119771,"_5":14632,"_28040":119644,"_3027":119772},[],"Los clientes deben indicar puertos no estándar",{"_3572":72116,"_30844":72066,"_21377":119774,"_5":14632,"_28040":119644,"_3027":119775},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3572":72117,"_30844":72066,"_21377":119777,"_5":14632,"_28040":119644,"_3027":119778},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3572":72118,"_30844":72066,"_21377":119780,"_5":14632,"_28040":119644,"_3027":119781},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3572":72119,"_30844":72066,"_21377":119783,"_5":14632,"_28040":119644,"_3027":119784},[],"Recursos Gateway separados pero proxy compartido",{"_3572":72120,"_30844":72066,"_21377":119786,"_5":14632,"_28040":119644,"_3027":119787},[],"Modo merged Gateway de Envoy",{"_3572":72121,"_30844":72066,"_21377":119789,"_5":14632,"_28040":119644,"_3027":119790},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3572":72122,"_30844":72066,"_21377":119792,"_5":14632,"_28040":119644,"_3027":119793},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3572":72123,"_30844":72066,"_21377":119795,"_5":14632,"_28040":119644,"_3027":119796},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3572":72124,"_30844":72066,"_21377":119798,"_5":14632,"_28040":119644,"_3027":119799},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3572":72125,"_30844":72066,"_21377":119801,"_5":14632,"_28040":119644,"_3027":119802},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3572":72126,"_30844":72066,"_21377":119804,"_5":14632,"_28040":119648,"_3027":119805},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3572":72127,"_30844":72066,"_21377":119807,"_5":14632,"_28040":119652,"_3027":119808},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3572":72128,"_30844":72066,"_21377":119810,"_5":14632,"_28040":119652,"_3027":119811},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3572":72129,"_30844":72066,"_21377":119813,"_5":14632,"_28040":119652,"_3027":119814},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3572":72130,"_30844":72066,"_21377":119816,"_5":14632,"_28040":119652,"_3027":119817},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3572":72131,"_30844":72066,"_21377":119819,"_5":14632,"_28040":119652,"_3027":119820},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3572":72132,"_30844":72066,"_21377":119822,"_5":14632,"_28040":119656,"_3027":119823},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3572":72133,"_30844":72066,"_21377":119825,"_5":14632,"_28040":119656,"_3027":119826},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3572":72134,"_30844":72066,"_21377":119828,"_5":14632,"_28040":119660,"_3027":119829},[],"Comprueba, en orden:",{"_3572":72135,"_30844":72066,"_21377":119831,"_5":14632,"_28040":119660,"_3027":119832},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3572":72136,"_30844":72066,"_21377":119834,"_5":14632,"_28040":119660,"_3027":119835},[],"Su estado contiene la dirección esperada.",{"_3572":72137,"_30844":72066,"_21377":119837,"_5":14632,"_28040":119660,"_3027":119838},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3572":72138,"_30844":72066,"_21377":119840,"_5":14632,"_28040":119660,"_3027":119841},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3572":72139,"_30844":72066,"_21377":119843,"_5":14632,"_28040":119660,"_3027":119844},[],"DNS resuelve al endpoint accesible externamente.",{"_3572":72140,"_30844":72066,"_21377":119846,"_5":14632,"_28040":119660,"_3027":119847},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3572":72141,"_30844":72066,"_21377":119849,"_5":14632,"_28040":119660,"_3027":119850},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3572":72142,"_30844":72142,"_5":14996,"_3027":50456,"_31202":119852,"_21377":119853,"_28040":72142},[50349,118793,119027],[],{"_3572":72143,"_30844":72142,"_21377":119855,"_5":14632,"_28040":72142,"_3027":119856},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3572":72144,"_30844":72142,"_5":31199,"_21377":119858,"_28040":119859,"_3027":119860},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3572":72145,"_30844":72142,"_5":31199,"_21377":119862,"_28040":119863,"_3027":119864},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3572":72146,"_30844":72142,"_5":31199,"_21377":119866,"_28040":119867,"_3027":119868},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3572":72147,"_30844":72142,"_5":31199,"_21377":119870,"_28040":119871,"_3027":119872},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3572":72148,"_30844":72142,"_5":31199,"_21377":119874,"_28040":119875,"_3027":119876},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3572":72149,"_30844":72142,"_5":31199,"_21377":119878,"_28040":119879,"_3027":119880},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3572":72150,"_30844":72142,"_21377":119882,"_5":14632,"_28040":119859,"_3027":119883},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3572":72151,"_30844":72142,"_21377":119885,"_5":14632,"_28040":119863,"_3027":119886},[],"Flujo",{"_3572":72152,"_30844":72142,"_21377":119888,"_5":14632,"_28040":119863,"_3027":119889},[],"Úsalo para",{"_3572":72153,"_30844":72142,"_21377":119891,"_5":14632,"_28040":119863,"_3027":119892},[],"Qué instala",{"_3572":72154,"_30844":72142,"_21377":119894,"_5":14632,"_28040":119863,"_3027":51492},[],{"_3572":72155,"_30844":72142,"_21377":119896,"_5":14632,"_28040":119863,"_3027":119897},[],"Producción y entornos controlados",{"_3572":72156,"_30844":72142,"_21377":119899,"_5":14632,"_28040":119863,"_3027":119900},[],"Servicios de Lamassu y recursos de Gateway API",{"_3572":72157,"_30844":72142,"_21377":119902,"_5":14632,"_28040":119863,"_3027":50593},[],{"_3572":72158,"_30844":72142,"_21377":119904,"_5":14632,"_28040":119863,"_3027":119905},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3572":72159,"_30844":72142,"_21377":119907,"_5":14632,"_28040":119863,"_3027":119908},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3572":72160,"_30844":72142,"_21377":119910,"_5":14632,"_28040":119867,"_3027":119911},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3572":72161,"_30844":72142,"_21377":119913,"_5":14632,"_28040":119867,"_3027":119914},[],"Área",{"_3572":72162,"_30844":72142,"_21377":119916,"_5":14632,"_28040":119867,"_3027":119917},[],"El chart de Lamassu proporciona",{"_3572":72163,"_30844":72142,"_21377":119919,"_5":14632,"_28040":119867,"_3027":119920},[],"Tú proporcionas",{"_3572":72164,"_30844":72142,"_21377":119922,"_5":14632,"_28040":119867,"_3027":119923},[],"Aplicaciones Lamassu",{"_3572":72165,"_30844":72142,"_21377":119925,"_5":14632,"_28040":119867,"_3027":119926},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3572":72166,"_30844":72142,"_21377":119928,"_5":14632,"_28040":119867,"_3027":119929},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3572":72167,"_30844":72142,"_21377":119931,"_5":14632,"_28040":119867,"_3027":119932},[],"Datos PostgreSQL",{"_3572":72168,"_30844":72142,"_21377":119934,"_5":14632,"_28040":119867,"_3027":119935},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3572":72169,"_30844":72142,"_21377":119937,"_5":14632,"_28040":119867,"_3027":119938},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3572":72170,"_30844":72142,"_21377":119940,"_5":14632,"_28040":119867,"_3027":119941},[],"Mensajería",{"_3572":72171,"_30844":72142,"_21377":119943,"_5":14632,"_28040":119867,"_3027":119944},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3572":72172,"_30844":72142,"_21377":119946,"_5":14632,"_28040":119867,"_3027":119947},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3572":72173,"_30844":72142,"_21377":119949,"_5":14632,"_28040":119867,"_3027":119950},[],"Identidad",{"_3572":72174,"_30844":72142,"_21377":119952,"_5":14632,"_28040":119867,"_3027":119953},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3572":72175,"_30844":72142,"_21377":119955,"_5":14632,"_28040":119867,"_3027":119956},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3572":72176,"_30844":72142,"_21377":119958,"_5":14632,"_28040":119867,"_3027":119959},[],"Enrutamiento externo",{"_3572":72177,"_30844":72142,"_21377":119961,"_5":14632,"_28040":119867,"_3027":119962},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3572":72178,"_30844":72142,"_21377":119964,"_5":14632,"_28040":119867,"_3027":119965},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3572":72179,"_30844":72142,"_21377":119967,"_5":14632,"_28040":119867,"_3027":51566},[],{"_3572":72180,"_30844":72142,"_21377":119969,"_5":14632,"_28040":119867,"_3027":119970},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3572":72181,"_30844":72142,"_21377":119972,"_5":14632,"_28040":119867,"_3027":119973},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3572":72182,"_30844":72142,"_21377":119975,"_5":14632,"_28040":119867,"_3027":119976},[],"Datos persistentes de la aplicación",{"_3572":72183,"_30844":72142,"_21377":119978,"_5":14632,"_28040":119867,"_3027":119979},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3572":72184,"_30844":72142,"_21377":119981,"_5":14632,"_28040":119867,"_3027":119982},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3572":72185,"_30844":72142,"_21377":119984,"_5":14632,"_28040":119867,"_3027":119985},[],"Integraciones opcionales",{"_3572":72186,"_30844":72142,"_21377":119987,"_5":14632,"_28040":119867,"_3027":119988},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3572":72187,"_30844":72142,"_21377":119990,"_5":14632,"_28040":119867,"_3027":119991},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3572":72188,"_30844":72142,"_21377":119993,"_5":14632,"_28040":119867,"_3027":119994},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3572":72189,"_30844":72142,"_21377":119996,"_5":14632,"_28040":119867,"_3027":119997},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3572":72190,"_30844":72142,"_21377":119999,"_5":14632,"_28040":119871,"_3027":120000},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3572":72191,"_30844":72142,"_21377":120002,"_5":14632,"_28040":119871,"_3027":120003},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3572":72192,"_30844":72142,"_21377":120005,"_5":14632,"_28040":119875,"_3027":120006},[],"Kubernetes 1.24 o posterior",{"_3572":72193,"_30844":72142,"_21377":120008,"_5":14632,"_28040":119875,"_3027":120009},[],"Helm 3.2 o posterior",{"_3572":72194,"_30844":72142,"_21377":120011,"_5":14632,"_28040":119875,"_3027":120012},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3572":72195,"_30844":72142,"_21377":120014,"_5":14632,"_28040":119875,"_3027":120015},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3572":72196,"_30844":72142,"_21377":120017,"_5":14632,"_28040":119875,"_3027":120018},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3572":72197,"_30844":72142,"_21377":120020,"_5":14632,"_28040":119875,"_3027":120021},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3572":72198,"_30844":72142,"_21377":120023,"_5":14632,"_28040":119875,"_3027":120024},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3572":72199,"_30844":72142,"_21377":120026,"_5":14632,"_28040":119879,"_3027":120027},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3572":72200,"_30844":72142,"_21377":120029,"_5":14632,"_28040":119879,"_3027":120030},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3572":72201,"_30844":72142,"_21377":120032,"_5":14632,"_28040":119879,"_3027":120033},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3572":72202,"_30844":72142,"_21377":120035,"_5":14632,"_28040":119879,"_3027":120036},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3572":72203,"_30844":72203,"_5":14996,"_3027":120038,"_31202":120039,"_21377":120041,"_28040":72203},"Resolución de problemas de despliegue",[50349,118793,120040],"Operación",[],{"_3572":72204,"_30844":72203,"_21377":120043,"_5":14632,"_28040":72203,"_3027":120044},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3572":72205,"_30844":72203,"_5":31199,"_21377":120046,"_28040":120047,"_3027":120048},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3572":72206,"_30844":72203,"_5":31199,"_21377":120050,"_28040":120051,"_3027":120052},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3572":72207,"_30844":72203,"_5":31199,"_21377":120054,"_28040":120055,"_3027":120056},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3572":72208,"_30844":72203,"_5":31199,"_21377":120058,"_28040":120059,"_3027":120060},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3572":72209,"_30844":72203,"_5":31199,"_21377":120062,"_28040":120063,"_3027":120064},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3572":72210,"_30844":72203,"_5":31199,"_21377":120066,"_28040":120067,"_3027":120068},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3572":72211,"_30844":72203,"_5":31199,"_21377":120070,"_28040":120071,"_3027":120072},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3572":72212,"_30844":72203,"_5":31199,"_21377":120074,"_28040":120075,"_3027":120076},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3572":72213,"_30844":72203,"_5":31199,"_21377":120078,"_28040":120079,"_3027":120080},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3572":72214,"_30844":72203,"_5":31199,"_21377":120082,"_28040":120083,"_3027":120084},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3572":72215,"_30844":72203,"_5":31199,"_21377":120086,"_28040":120087,"_3027":120088},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3572":72216,"_30844":72203,"_5":31199,"_21377":120090,"_28040":120091,"_3027":120092},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3572":72217,"_30844":72203,"_5":31199,"_21377":120094,"_28040":120095,"_3027":120096},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3572":72218,"_30844":72203,"_21377":120098,"_5":14632,"_28040":72203,"_3027":120099},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3572":72219,"_30844":72203,"_21377":120101,"_5":14632,"_28040":120051,"_3027":120102},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3572":72220,"_30844":72203,"_21377":120104,"_5":14632,"_28040":120055,"_3027":120105},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3572":72221,"_30844":72203,"_21377":120107,"_5":14632,"_28040":120059,"_3027":120108},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3572":72222,"_30844":72203,"_21377":120110,"_5":14632,"_28040":120063,"_3027":120111},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3572":72223,"_30844":72203,"_21377":120113,"_5":14632,"_28040":120067,"_3027":120114},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3572":72224,"_30844":72203,"_21377":120116,"_5":14632,"_28040":120071,"_3027":120117},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3572":72225,"_30844":72203,"_21377":120119,"_5":14632,"_28040":120071,"_3027":120120},[],"Ejecuta también la prueba de conectividad del chart:",{"_3572":72226,"_30844":72203,"_21377":120122,"_5":14632,"_28040":120071,"_3027":120123},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3572":72227,"_30844":72203,"_21377":120125,"_5":14632,"_28040":120071,"_3027":120126},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3572":72228,"_30844":72203,"_21377":120128,"_5":14632,"_28040":120075,"_3027":120129},[],"Si recibes un 401:",{"_3572":72229,"_30844":72203,"_21377":120131,"_5":14632,"_28040":120075,"_3027":120132},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3572":72230,"_30844":72203,"_21377":120134,"_5":14632,"_28040":120075,"_3027":120135},[],"verifica emisor, audiencia y expiración del token;",{"_3572":72231,"_30844":72203,"_21377":120137,"_5":14632,"_28040":120075,"_3027":120138},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3572":72232,"_30844":72203,"_21377":120140,"_5":14632,"_28040":120075,"_3027":120141},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3572":72233,"_30844":72203,"_21377":120143,"_5":14632,"_28040":120075,"_3027":120144},[],"Si el login termina pero las APIs devuelven 403:",{"_3572":72234,"_30844":72203,"_21377":120146,"_5":14632,"_28040":120075,"_3027":120147},[],"inspecciona los claims reales del token;",{"_3572":72235,"_30844":72203,"_21377":120149,"_5":14632,"_28040":120075,"_3027":120150},[],"confirma que coinciden con un principal activo;",{"_3572":72236,"_30844":72203,"_21377":120152,"_5":14632,"_28040":120075,"_3027":120153},[],"revisa las políticas concedidas al principal;",{"_3572":72237,"_30844":72203,"_21377":120155,"_5":14632,"_28040":120075,"_3027":120156},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3572":72238,"_30844":72203,"_21377":120158,"_5":14632,"_28040":120075,"_3027":120159},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3572":72239,"_30844":72203,"_21377":120161,"_5":14632,"_28040":120079,"_3027":120162},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3572":72240,"_30844":72203,"_21377":120164,"_5":14632,"_28040":120079,"_3027":120165},[],"Localiza el pod y Service de authz.",{"_3572":72241,"_30844":72203,"_21377":120167,"_5":14632,"_28040":120079,"_3027":120168},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3572":72242,"_30844":72203,"_21377":120170,"_5":14632,"_28040":120079,"_3027":120171},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3572":72243,"_30844":72203,"_21377":120173,"_5":14632,"_28040":120079,"_3027":120174},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3572":72244,"_30844":72203,"_21377":120176,"_5":14632,"_28040":120079,"_3027":120177},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3572":72245,"_30844":72203,"_21377":120179,"_5":14632,"_28040":120083,"_3027":120180},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3572":72246,"_30844":72203,"_21377":120182,"_5":14632,"_28040":120087,"_3027":120183},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3572":72247,"_30844":72203,"_21377":120185,"_5":14632,"_28040":120087,"_3027":120186},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3572":72248,"_30844":72203,"_21377":120188,"_5":14632,"_28040":120087,"_3027":120189},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3572":72249,"_30844":72203,"_21377":120191,"_5":14632,"_28040":120087,"_3027":120192},[],"una variable de entorno de credenciales definida con la cadena vacía mientras el valor correspondiente del YAML no está vacío: el servicio falla al arrancar y nombra la variable y la clave de configuración, por ejemplo `LAMASSU_POSTGRES_PASSWORD is set but empty`;",{"_3572":72250,"_30844":72203,"_21377":120194,"_5":14632,"_28040":120087,"_3027":120195},[],"para authz, dos schemas del mapa de credenciales que se reducen al mismo nombre de variable de entorno (por ejemplo `pki-v2` y `pki.v2`): el arranque falla cuando hay una variable de credenciales definida para cualquiera de los dos; si las variables no están definidas, el servicio registra un warning y usa los valores del YAML.",{"_3572":72251,"_30844":72203,"_21377":120197,"_5":14632,"_28040":120087,"_3027":120198},[],"volumen persistente sin enlazar;",{"_3572":72252,"_30844":72203,"_21377":120200,"_5":14632,"_28040":120087,"_3027":120201},[],"imagen inaccesible o política de pull incorrecta;",{"_3572":72253,"_30844":72203,"_21377":120203,"_5":14632,"_28040":120087,"_3027":120204},[],"configuración inválida del motor criptográfico;",{"_3572":72254,"_30844":72203,"_21377":120206,"_5":14632,"_28040":120087,"_3027":120207},[],"límites de CPU o memoria demasiado bajos;",{"_3572":72255,"_30844":72203,"_21377":120209,"_5":14632,"_28040":120087,"_3027":120210},[],"migración previa incompleta.",{"_3572":72256,"_30844":72203,"_21377":120212,"_5":14632,"_28040":120087,"_3027":120213},[],"Estos fallos de arranque provienen de las variables de entorno para credenciales descritas en Variables de entorno para credenciales.",{"_3572":72257,"_30844":72203,"_21377":120215,"_5":14632,"_28040":120087,"_3027":120216},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3572":72258,"_30844":72203,"_21377":120218,"_5":14632,"_28040":120087,"_3027":120219},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3572":72259,"_30844":72203,"_21377":120221,"_5":14632,"_28040":120087,"_3027":120222},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3572":72260,"_30844":72203,"_21377":120224,"_5":14632,"_28040":120091,"_3027":120225},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3572":72261,"_30844":72203,"_21377":120227,"_5":14632,"_28040":120091,"_3027":120228},[],"verifica que esté habilitado en el servicio emisor;",{"_3572":72262,"_30844":72203,"_21377":120230,"_5":14632,"_28040":120091,"_3027":120231},[],"comprueba conectividad y credenciales AMQP;",{"_3572":72263,"_30844":72203,"_21377":120233,"_5":14632,"_28040":120091,"_3027":120234},[],"revisa exchange, routing key, colas y consumidores;",{"_3572":72264,"_30844":72203,"_21377":120236,"_5":14632,"_28040":120091,"_3027":120237},[],"inspecciona dead-letter queues;",{"_3572":72265,"_30844":72203,"_21377":120239,"_5":14632,"_28040":120091,"_3027":120240},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3572":72266,"_30844":72203,"_21377":120242,"_5":14632,"_28040":120091,"_3027":120243},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3572":72267,"_30844":72203,"_21377":120245,"_5":14632,"_28040":120091,"_3027":120246},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3572":72268,"_30844":72203,"_21377":120248,"_5":14632,"_28040":120091,"_3027":120249},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3572":72269,"_30844":72203,"_21377":120251,"_5":14632,"_28040":120091,"_3027":120252},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3572":72270,"_30844":72203,"_21377":120254,"_5":14632,"_28040":120091,"_3027":120255},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3572":72271,"_30844":72203,"_21377":120257,"_5":14632,"_28040":120091,"_3027":120258},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3572":72272,"_30844":72203,"_21377":120260,"_5":14632,"_28040":120091,"_3027":120261},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3572":72273,"_30844":72203,"_21377":120263,"_5":14632,"_28040":120095,"_3027":120264},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3572":72274,"_30844":72203,"_21377":120266,"_5":14632,"_28040":120095,"_3027":120267},[],"Antes de cerrar una incidencia, guarda:",{"_3572":72275,"_30844":72203,"_21377":120269,"_5":14632,"_28040":120095,"_3027":120270},[],"causa confirmada;",{"_3572":72276,"_30844":72203,"_21377":120272,"_5":14632,"_28040":120095,"_3027":120273},[],"alcance temporal y recursos afectados;",{"_3572":72277,"_30844":72203,"_21377":120275,"_5":14632,"_28040":120095,"_3027":120276},[],"comandos o consultas utilizados;",{"_3572":72278,"_30844":72203,"_21377":120278,"_5":14632,"_28040":120095,"_3027":120279},[],"cambio aplicado y forma de revertirlo;",{"_3572":72279,"_30844":72203,"_21377":120281,"_5":14632,"_28040":120095,"_3027":120282},[],"validación desde un consumidor;",{"_3572":72280,"_30844":72203,"_21377":120284,"_5":14632,"_28040":120095,"_3027":120285},[],"acción preventiva y propietario.",{"_3572":72281,"_30844":72281,"_5":14996,"_3027":120287,"_31202":120288,"_21377":120292,"_28040":72281},"Modelo de datos",[50349,120289,120290,120291],"Plataforma","Administración","Control de acceso",[],{"_3572":72282,"_30844":72281,"_21377":120294,"_5":14632,"_28040":72281,"_3027":120295},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3572":72283,"_30844":72281,"_5":31199,"_21377":120297,"_28040":120298,"_3027":120299},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3572":72284,"_30844":72281,"_5":31199,"_21377":120301,"_28040":120302,"_3027":120303},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3572":72285,"_30844":72281,"_21377":120305,"_5":14632,"_28040":72281,"_3027":120306},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3572":72286,"_30844":72281,"_21377":120308,"_5":14632,"_28040":120298,"_3027":120309},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3572":72287,"_30844":72281,"_21377":120311,"_5":14632,"_28040":120298,"_3027":120312},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3572":72288,"_30844":72281,"_21377":120314,"_5":14632,"_28040":120298,"_3027":120315},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3572":72289,"_30844":72281,"_21377":120317,"_5":14632,"_28040":120302,"_3027":120318},[],"Entidad (`schema_name.entity_type`)",{"_3572":72290,"_30844":72281,"_21377":120320,"_5":14632,"_28040":120302,"_3027":120321},[],"Tabla (`table_name`)",{"_3572":72291,"_30844":72281,"_21377":120323,"_5":14632,"_28040":120302,"_3027":120324},[],"Clave (`primary_key`)",{"_3572":72292,"_30844":72281,"_21377":120326,"_5":14632,"_28040":120302,"_3027":51926},[],{"_3572":72293,"_30844":72281,"_21377":120328,"_5":14632,"_28040":120302,"_3027":51929},[],{"_3572":72294,"_30844":72281,"_21377":120330,"_5":14632,"_28040":120302,"_3027":51932},[],{"_3572":72295,"_30844":72281,"_21377":120332,"_5":14632,"_28040":120302,"_3027":51935},[],{"_3572":72296,"_30844":72281,"_21377":120334,"_5":14632,"_28040":120302,"_3027":51938},[],{"_3572":72297,"_30844":72281,"_21377":120336,"_5":14632,"_28040":120302,"_3027":51941},[],{"_3572":72298,"_30844":72281,"_21377":120338,"_5":14632,"_28040":120302,"_3027":51944},[],{"_3572":72299,"_30844":72281,"_21377":120340,"_5":14632,"_28040":120302,"_3027":51947},[],{"_3572":72300,"_30844":72281,"_21377":120342,"_5":14632,"_28040":120302,"_3027":51941},[],{"_3572":72301,"_30844":72281,"_21377":120344,"_5":14632,"_28040":120302,"_3027":51952},[],{"_3572":72302,"_30844":72281,"_21377":120346,"_5":14632,"_28040":120302,"_3027":51955},[],{"_3572":72303,"_30844":72281,"_21377":120348,"_5":14632,"_28040":120302,"_3027":51958},[],{"_3572":72304,"_30844":72281,"_21377":120350,"_5":14632,"_28040":120302,"_3027":51961},[],{"_3572":72305,"_30844":72281,"_21377":120352,"_5":14632,"_28040":120302,"_3027":51964},[],{"_3572":72306,"_30844":72281,"_21377":120354,"_5":14632,"_28040":120302,"_3027":51941},[],{"_3572":72307,"_30844":72281,"_21377":120356,"_5":14632,"_28040":120302,"_3027":51969},[],{"_3572":72308,"_30844":72281,"_21377":120358,"_5":14632,"_28040":120302,"_3027":51972},[],{"_3572":72309,"_30844":72281,"_21377":120360,"_5":14632,"_28040":120302,"_3027":51941},[],{"_3572":72310,"_30844":72281,"_21377":120362,"_5":14632,"_28040":120302,"_3027":51977},[],{"_3572":72311,"_30844":72281,"_21377":120364,"_5":14632,"_28040":120302,"_3027":51980},[],{"_3572":72312,"_30844":72281,"_21377":120366,"_5":14632,"_28040":120302,"_3027":51941},[],{"_3572":72313,"_30844":72281,"_21377":120368,"_5":14632,"_28040":120302,"_3027":51985},[],{"_3572":72314,"_30844":72281,"_21377":120370,"_5":14632,"_28040":120302,"_3027":51988},[],{"_3572":72315,"_30844":72281,"_21377":120372,"_5":14632,"_28040":120302,"_3027":51941},[],{"_3572":72316,"_30844":72281,"_21377":120374,"_5":14632,"_28040":120302,"_3027":51993},[],{"_3572":72317,"_30844":72281,"_21377":120376,"_5":14632,"_28040":120302,"_3027":51996},[],{"_3572":72318,"_30844":72281,"_21377":120378,"_5":14632,"_28040":120302,"_3027":51999},[],{"_3572":72319,"_30844":72281,"_21377":120380,"_5":14632,"_28040":120302,"_3027":52002},[],{"_3572":72320,"_30844":72281,"_21377":120382,"_5":14632,"_28040":120302,"_3027":52005},[],{"_3572":72321,"_30844":72281,"_21377":120384,"_5":14632,"_28040":120302,"_3027":52008},[],{"_3572":72322,"_30844":72281,"_21377":120386,"_5":14632,"_28040":120302,"_3027":120387},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3572":72323,"_30844":72281,"_21377":120389,"_5":14632,"_28040":120302,"_3027":120390},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3572":72324,"_30844":72281,"_21377":120392,"_5":14632,"_28040":120302,"_3027":120393},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3572":72325,"_30844":72325,"_5":14996,"_3027":120395,"_31202":120396,"_21377":120397,"_28040":72325},"Visión general del control de acceso",[50349,120289,120290,120291],[],{"_3572":72326,"_30844":72325,"_21377":120399,"_5":14632,"_28040":72325,"_3027":120400},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3572":72327,"_30844":72325,"_5":31199,"_21377":120402,"_28040":120403,"_3027":120404},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3572":72328,"_30844":72325,"_5":31199,"_21377":120406,"_28040":120407,"_3027":120408},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3572":72329,"_30844":72325,"_5":31199,"_21377":120410,"_28040":120411,"_3027":120412},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3572":72330,"_30844":72325,"_5":31199,"_21377":120414,"_28040":120415,"_3027":120416},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3572":72331,"_30844":72325,"_5":31199,"_21377":120418,"_28040":120419,"_3027":120420},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3572":72332,"_30844":72325,"_5":31199,"_21377":120422,"_28040":120423,"_3027":120424},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3572":72333,"_30844":72325,"_5":31199,"_21377":120426,"_28040":120427,"_3027":120428},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3572":72334,"_30844":72325,"_5":31199,"_21377":120430,"_28040":120431,"_3027":120432},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3572":72335,"_30844":72325,"_5":31199,"_21377":120434,"_28040":120435,"_3027":120436},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3572":72336,"_30844":72325,"_5":31199,"_21377":120438,"_28040":120439,"_3027":120440},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3572":72337,"_30844":72325,"_5":31199,"_21377":120442,"_28040":120443,"_3027":120444},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3572":72338,"_30844":72325,"_5":31199,"_21377":120446,"_28040":120447,"_3027":120448},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3572":72339,"_30844":72325,"_5":31199,"_21377":120450,"_28040":120451,"_3027":120452},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3572":72340,"_30844":72325,"_5":31199,"_21377":120454,"_28040":120455,"_3027":120456},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3572":72341,"_30844":72325,"_5":31199,"_21377":120458,"_28040":120459,"_3027":120460},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3572":72342,"_30844":72325,"_5":31199,"_21377":120462,"_28040":120463,"_3027":119403},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3572":72343,"_30844":72325,"_5":31199,"_21377":120465,"_28040":120466,"_3027":120467},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3572":72344,"_30844":72325,"_5":31199,"_21377":120469,"_28040":120470,"_3027":120471},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3572":72345,"_30844":72325,"_5":31199,"_21377":120473,"_28040":120474,"_3027":120475},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3572":72346,"_30844":72325,"_5":31199,"_21377":120477,"_28040":120478,"_3027":120479},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3572":72347,"_30844":72325,"_5":31199,"_21377":120481,"_28040":120482,"_3027":120483},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3572":72348,"_30844":72325,"_5":31199,"_21377":120485,"_28040":120486,"_3027":120487},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3572":72349,"_30844":72325,"_5":31199,"_21377":120489,"_28040":120490,"_3027":120491},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3572":72350,"_30844":72325,"_5":31199,"_21377":120493,"_28040":120494,"_3027":120495},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3572":72351,"_30844":72325,"_5":31199,"_21377":120497,"_28040":120498,"_3027":120499},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3572":72352,"_30844":72325,"_5":31199,"_21377":120501,"_28040":120502,"_3027":120503},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3572":72353,"_30844":72325,"_5":31199,"_21377":120505,"_28040":120506,"_3027":120507},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3572":72354,"_30844":72325,"_5":31199,"_21377":120509,"_28040":120510,"_3027":120511},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3572":72355,"_30844":72325,"_5":31199,"_21377":120513,"_28040":120514,"_3027":120515},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3572":72356,"_30844":72325,"_5":31199,"_21377":120517,"_28040":120518,"_3027":120519},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3572":72357,"_30844":72325,"_5":31199,"_21377":120521,"_28040":120522,"_3027":120523},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3572":72358,"_30844":72325,"_21377":120525,"_5":14632,"_28040":72325,"_3027":120526},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3572":72359,"_30844":72325,"_21377":120528,"_5":14632,"_28040":72325,"_3027":120529},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3572":72360,"_30844":72325,"_21377":120531,"_5":14632,"_28040":72325,"_3027":120532},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3572":72361,"_30844":72325,"_21377":120534,"_5":14632,"_28040":120403,"_3027":120535},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3572":72362,"_30844":72325,"_21377":120537,"_5":14632,"_28040":120403,"_3027":120538},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3572":72363,"_30844":72325,"_21377":120540,"_5":14632,"_28040":120403,"_3027":120541},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3572":72364,"_30844":72325,"_21377":120543,"_5":14632,"_28040":120403,"_3027":120544},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3572":72365,"_30844":72325,"_21377":120546,"_5":14632,"_28040":120403,"_3027":120547},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3572":72366,"_30844":72325,"_21377":120549,"_5":14632,"_28040":120403,"_3027":120550},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3572":72367,"_30844":72325,"_21377":120552,"_5":14632,"_28040":120407,"_3027":120553},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3572":72368,"_30844":72325,"_21377":120555,"_5":14632,"_28040":120407,"_3027":120556},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3572":72369,"_30844":72325,"_21377":120558,"_5":14632,"_28040":120411,"_3027":120559},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3572":72370,"_30844":72325,"_21377":120561,"_5":14632,"_28040":120411,"_3027":120562},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3572":72371,"_30844":72325,"_21377":120564,"_5":14632,"_28040":120411,"_3027":120565},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3572":72372,"_30844":72325,"_21377":120567,"_5":14632,"_28040":120411,"_3027":120568},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3572":72373,"_30844":72325,"_21377":120570,"_5":14632,"_28040":120411,"_3027":120571},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3572":72374,"_30844":72325,"_21377":120573,"_5":14632,"_28040":120411,"_3027":120574},[],"Carga por separado las políticas concedidas a cada principal.",{"_3572":72375,"_30844":72325,"_21377":120576,"_5":14632,"_28040":120411,"_3027":120577},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3572":72376,"_30844":72325,"_21377":120579,"_5":14632,"_28040":120411,"_3027":120580},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3572":72377,"_30844":72325,"_21377":120582,"_5":14632,"_28040":120411,"_3027":120583},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3572":72378,"_30844":72325,"_21377":120585,"_5":14632,"_28040":120411,"_3027":120586},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3572":72379,"_30844":72325,"_21377":120588,"_5":14632,"_28040":120411,"_3027":120589},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3572":72380,"_30844":72325,"_21377":120591,"_5":14632,"_28040":120411,"_3027":120592},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3572":72381,"_30844":72325,"_21377":120594,"_5":14632,"_28040":120415,"_3027":120595},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3572":72382,"_30844":72325,"_21377":120597,"_5":14632,"_28040":120415,"_3027":120598},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3572":72383,"_30844":72325,"_21377":120600,"_5":14632,"_28040":120415,"_3027":120601},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3572":72384,"_30844":72325,"_21377":120603,"_5":14632,"_28040":120415,"_3027":120604},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3572":72385,"_30844":72325,"_21377":120606,"_5":14632,"_28040":120415,"_3027":120607},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3572":72386,"_30844":72325,"_21377":120609,"_5":14632,"_28040":120415,"_3027":120610},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3572":72387,"_30844":72325,"_21377":120612,"_5":14632,"_28040":120415,"_3027":120613},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3572":72388,"_30844":72325,"_21377":120615,"_5":14632,"_28040":120415,"_3027":120616},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3572":72389,"_30844":72325,"_21377":120618,"_5":14632,"_28040":120419,"_3027":120619},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3572":72390,"_30844":72325,"_21377":120621,"_5":14632,"_28040":120419,"_3027":120622},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3572":72391,"_30844":72325,"_21377":120624,"_5":14632,"_28040":120419,"_3027":120625},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3572":72392,"_30844":72325,"_21377":120627,"_5":14632,"_28040":120419,"_3027":120628},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3572":72393,"_30844":72325,"_21377":120630,"_5":14632,"_28040":120419,"_3027":120631},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3572":72394,"_30844":72325,"_21377":120633,"_5":14632,"_28040":120419,"_3027":120634},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3572":72395,"_30844":72325,"_21377":120636,"_5":14632,"_28040":120419,"_3027":120637},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3572":72396,"_30844":72325,"_21377":120639,"_5":14632,"_28040":120419,"_3027":120640},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3572":72397,"_30844":72325,"_21377":120642,"_5":14632,"_28040":120419,"_3027":120643},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3572":72398,"_30844":72325,"_21377":120645,"_5":14632,"_28040":120419,"_3027":120646},[],"Las acciones se dividen en dos grupos:",{"_3572":72399,"_30844":72325,"_21377":120648,"_5":14632,"_28040":120419,"_3027":120649},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3572":72400,"_30844":72325,"_21377":120651,"_5":14632,"_28040":120419,"_3027":120652},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3572":72401,"_30844":72325,"_21377":120654,"_5":14632,"_28040":120419,"_3027":120655},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3572":72402,"_30844":72325,"_21377":120657,"_5":14632,"_28040":120423,"_3027":120658},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3572":72403,"_30844":72325,"_21377":120660,"_5":14632,"_28040":120423,"_3027":120661},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3572":72404,"_30844":72325,"_21377":120663,"_5":14632,"_28040":120423,"_3027":120664},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3572":72405,"_30844":72325,"_21377":120666,"_5":14632,"_28040":120427,"_3027":120667},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3572":72406,"_30844":72325,"_21377":120669,"_5":14632,"_28040":120427,"_3027":120670},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3572":72407,"_30844":72325,"_21377":120672,"_5":14632,"_28040":120427,"_3027":120673},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3572":72408,"_30844":72325,"_21377":120675,"_5":14632,"_28040":120427,"_3027":120676},[],"Los operadores implementados son:",{"_3572":72409,"_30844":72325,"_21377":120678,"_5":14632,"_28040":120427,"_3027":120679},[],"`equals`, para igualdad exacta;",{"_3572":72410,"_30844":72325,"_21377":120681,"_5":14632,"_28040":120427,"_3027":120682},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3572":72411,"_30844":72325,"_21377":120684,"_5":14632,"_28040":120427,"_3027":120685},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3572":72412,"_30844":72325,"_21377":120687,"_5":14632,"_28040":120427,"_3027":120688},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3572":72413,"_30844":72325,"_21377":120690,"_5":14632,"_28040":120431,"_3027":120691},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3572":72414,"_30844":72325,"_21377":120693,"_5":14632,"_28040":120431,"_3027":120694},[],"Los modos disponibles son:",{"_3572":72415,"_30844":72325,"_21377":120696,"_5":14632,"_28040":120431,"_3027":120697},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3572":72416,"_30844":72325,"_21377":120699,"_5":14632,"_28040":120431,"_3027":120700},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3572":72417,"_30844":72325,"_21377":120702,"_5":14632,"_28040":120431,"_3027":120703},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3572":72418,"_30844":72325,"_21377":120705,"_5":14632,"_28040":120431,"_3027":120706},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3572":72419,"_30844":72325,"_21377":120708,"_5":14632,"_28040":120431,"_3027":120709},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3572":72420,"_30844":72325,"_21377":120711,"_5":14632,"_28040":120431,"_3027":120712},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3572":72421,"_30844":72325,"_21377":120714,"_5":14632,"_28040":120435,"_3027":120715},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3572":72422,"_30844":72325,"_21377":120717,"_5":14632,"_28040":120435,"_3027":120718},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3572":72423,"_30844":72325,"_21377":120720,"_5":14632,"_28040":120435,"_3027":120721},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3572":72424,"_30844":72325,"_21377":120723,"_5":14632,"_28040":120435,"_3027":120724},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3572":72425,"_30844":72325,"_21377":120726,"_5":14632,"_28040":120443,"_3027":120727},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3572":72426,"_30844":72325,"_21377":120729,"_5":14632,"_28040":120443,"_3027":120730},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3572":72427,"_30844":72325,"_21377":120732,"_5":14632,"_28040":120447,"_3027":120733},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3572":72428,"_30844":72325,"_21377":120735,"_5":14632,"_28040":120447,"_3027":120736},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3572":72429,"_30844":72325,"_21377":120738,"_5":14632,"_28040":120447,"_3027":120739},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3572":72430,"_30844":72325,"_21377":120741,"_5":14632,"_28040":120447,"_3027":120742},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3572":72431,"_30844":72325,"_21377":120744,"_5":14632,"_28040":120447,"_3027":120745},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3572":72432,"_30844":72325,"_21377":120747,"_5":14632,"_28040":120451,"_3027":120748},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3572":72433,"_30844":72325,"_21377":120750,"_5":14632,"_28040":120451,"_3027":120751},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3572":72434,"_30844":72325,"_21377":120753,"_5":14632,"_28040":120451,"_3027":120754},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3572":72435,"_30844":72325,"_21377":120756,"_5":14632,"_28040":120455,"_3027":120757},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3572":72436,"_30844":72325,"_21377":120759,"_5":14632,"_28040":120455,"_3027":120760},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3572":72437,"_30844":72325,"_21377":120762,"_5":14632,"_28040":120455,"_3027":120763},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3572":72438,"_30844":72325,"_21377":120765,"_5":14632,"_28040":120455,"_3027":120766},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3572":72439,"_30844":72325,"_21377":120768,"_5":14632,"_28040":120455,"_3027":120769},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3572":72440,"_30844":72325,"_21377":120771,"_5":14632,"_28040":120455,"_3027":120772},[],"Ten en cuenta que:",{"_3572":72441,"_30844":72325,"_21377":120774,"_5":14632,"_28040":120455,"_3027":120775},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3572":72442,"_30844":72325,"_21377":120777,"_5":14632,"_28040":120455,"_3027":120778},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3572":72443,"_30844":72325,"_21377":120780,"_5":14632,"_28040":120455,"_3027":120781},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3572":72444,"_30844":72325,"_21377":120783,"_5":14632,"_28040":120459,"_3027":120784},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3572":72445,"_30844":72325,"_21377":120786,"_5":14632,"_28040":120459,"_3027":120787},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3572":72446,"_30844":72325,"_21377":120789,"_5":14632,"_28040":120459,"_3027":120790},[],"acceso completo y de solo lectura a KMS;",{"_3572":72447,"_30844":72325,"_21377":120792,"_5":14632,"_28040":120459,"_3027":120793},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3572":72448,"_30844":72325,"_21377":120795,"_5":14632,"_28040":120459,"_3027":120796},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3572":72449,"_30844":72325,"_21377":120798,"_5":14632,"_28040":120459,"_3027":120799},[],"acceso a la interfaz;",{"_3572":72450,"_30844":72325,"_21377":120801,"_5":14632,"_28040":120459,"_3027":120802},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3572":72451,"_30844":72325,"_21377":120804,"_5":14632,"_28040":120459,"_3027":120805},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3572":72452,"_30844":72325,"_21377":120807,"_5":14632,"_28040":120459,"_3027":120808},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3572":72453,"_30844":72325,"_21377":120810,"_5":14632,"_28040":120463,"_3027":120811},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3572":72454,"_30844":72325,"_21377":120813,"_5":14632,"_28040":120463,"_3027":120814},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3572":72455,"_30844":72325,"_21377":120816,"_5":14632,"_28040":120463,"_3027":120817},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3572":72456,"_30844":72325,"_21377":120819,"_5":14632,"_28040":120466,"_3027":120820},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3572":72457,"_30844":72325,"_21377":120822,"_5":14632,"_28040":120470,"_3027":120823},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3572":72458,"_30844":72325,"_21377":120825,"_5":14632,"_28040":120470,"_3027":120826},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3572":72459,"_30844":72325,"_21377":120828,"_5":14632,"_28040":120474,"_3027":120829},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3572":72460,"_30844":72325,"_21377":120831,"_5":14632,"_28040":120478,"_3027":120832},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3572":72461,"_30844":72325,"_21377":120834,"_5":14632,"_28040":120482,"_3027":120835},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3572":72462,"_30844":72325,"_21377":120837,"_5":14632,"_28040":120486,"_3027":120838},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3572":72463,"_30844":72325,"_21377":120840,"_5":14632,"_28040":120486,"_3027":120841},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3572":72464,"_30844":72325,"_21377":120843,"_5":14632,"_28040":120490,"_3027":120844},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3572":72465,"_30844":72325,"_21377":120846,"_5":14632,"_28040":120490,"_3027":120847},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3572":72466,"_30844":72325,"_21377":120849,"_5":14632,"_28040":120490,"_3027":120850},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3572":72467,"_30844":72325,"_21377":120852,"_5":14632,"_28040":120490,"_3027":120853},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3572":72468,"_30844":72325,"_21377":120855,"_5":14632,"_28040":120490,"_3027":120856},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3572":72469,"_30844":72325,"_21377":120858,"_5":14632,"_28040":120490,"_3027":120859},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3572":72470,"_30844":72325,"_21377":120861,"_5":14632,"_28040":120490,"_3027":120862},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3572":72471,"_30844":72325,"_21377":120864,"_5":14632,"_28040":120490,"_3027":120865},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3572":72472,"_30844":72325,"_21377":120867,"_5":14632,"_28040":120494,"_3027":120868},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3572":72473,"_30844":72325,"_21377":120870,"_5":14632,"_28040":120494,"_3027":120871},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3572":72474,"_30844":72325,"_21377":120873,"_5":14632,"_28040":120494,"_3027":120874},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3572":72475,"_30844":72325,"_21377":120876,"_5":14632,"_28040":120498,"_3027":120877},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3572":72476,"_30844":72325,"_21377":120879,"_5":14632,"_28040":120498,"_3027":120880},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3572":72477,"_30844":72325,"_21377":120882,"_5":14632,"_28040":120498,"_3027":120883},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3572":72478,"_30844":72325,"_21377":120885,"_5":14632,"_28040":120498,"_3027":120886},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3572":72479,"_30844":72325,"_21377":120888,"_5":14632,"_28040":120498,"_3027":120889},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3572":72480,"_30844":72325,"_21377":120891,"_5":14632,"_28040":120498,"_3027":120892},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3572":72481,"_30844":72325,"_21377":120894,"_5":14632,"_28040":120498,"_3027":120895},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3572":72482,"_30844":72325,"_21377":120897,"_5":14632,"_28040":120498,"_3027":120898},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3572":72483,"_30844":72325,"_21377":120900,"_5":14632,"_28040":120506,"_3027":120901},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3572":72484,"_30844":72325,"_21377":120903,"_5":14632,"_28040":120510,"_3027":120904},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3572":72485,"_30844":72325,"_21377":120906,"_5":14632,"_28040":120510,"_3027":120907},[],"que exista un principal activo del tipo correcto;",{"_3572":72486,"_30844":72325,"_21377":120909,"_5":14632,"_28040":120510,"_3027":120910},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3572":72487,"_30844":72325,"_21377":120912,"_5":14632,"_28040":120510,"_3027":120913},[],"que todas las condiciones del principal se cumplan;",{"_3572":72488,"_30844":72325,"_21377":120915,"_5":14632,"_28040":120510,"_3027":120916},[],"que el principal tenga concedida la política esperada;",{"_3572":72489,"_30844":72325,"_21377":120918,"_5":14632,"_28040":120510,"_3027":120919},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3572":72490,"_30844":72325,"_21377":120921,"_5":14632,"_28040":120510,"_3027":120922},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3572":72491,"_30844":72325,"_21377":120924,"_5":14632,"_28040":120510,"_3027":120925},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3572":72492,"_30844":72325,"_21377":120927,"_5":14632,"_28040":120510,"_3027":120928},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3572":72493,"_30844":72325,"_21377":120930,"_5":14632,"_28040":120514,"_3027":120931},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3572":72494,"_30844":72325,"_21377":120933,"_5":14632,"_28040":120518,"_3027":120934},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3572":72495,"_30844":72325,"_21377":120936,"_5":14632,"_28040":120522,"_3027":120937},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3572":72496,"_30844":72325,"_21377":120939,"_5":14632,"_28040":120522,"_3027":120940},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3572":72497,"_30844":72497,"_5":14996,"_3027":120942,"_31202":120943,"_21377":120944,"_28040":72497},"Alertas y suscripciones",[50349,120289,120290],[],{"_3572":72498,"_30844":72497,"_21377":120946,"_5":14632,"_28040":72497,"_3027":120947},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3572":72499,"_30844":72497,"_5":31199,"_21377":120949,"_28040":120950,"_3027":120951},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3572":72500,"_30844":72497,"_5":31199,"_21377":120953,"_28040":120954,"_3027":120955},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3572":72501,"_30844":72497,"_5":31199,"_21377":120957,"_28040":120958,"_3027":120959},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3572":72502,"_30844":72497,"_5":31199,"_21377":120961,"_28040":120962,"_3027":120963},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3572":72503,"_30844":72497,"_5":31199,"_21377":120965,"_28040":120966,"_3027":120967},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3572":72504,"_30844":72497,"_5":31199,"_21377":120969,"_28040":120970,"_3027":120971},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3572":72505,"_30844":72497,"_5":31199,"_21377":120973,"_28040":120974,"_3027":120975},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3572":72506,"_30844":72497,"_5":31199,"_21377":120977,"_28040":120978,"_3027":120979},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3572":72507,"_30844":72497,"_5":31199,"_21377":120981,"_28040":120982,"_3027":120983},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3572":72508,"_30844":72497,"_5":31199,"_21377":120985,"_28040":120986,"_3027":120987},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3572":72509,"_30844":72497,"_5":31199,"_21377":120989,"_28040":120990,"_3027":120991},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3572":72510,"_30844":72497,"_21377":120993,"_5":14632,"_28040":72497,"_3027":120994},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3572":72511,"_30844":72497,"_21377":120996,"_5":14632,"_28040":120950,"_3027":120997},[],"Un servicio publica un evento de dominio.",{"_3572":72512,"_30844":72497,"_21377":120999,"_5":14632,"_28040":120950,"_3027":121000},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3572":72513,"_30844":72497,"_21377":121002,"_5":14632,"_28040":120950,"_3027":121003},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3572":72514,"_30844":72497,"_21377":121005,"_5":14632,"_28040":120950,"_3027":121006},[],"Lamassu entrega el evento al canal configurado.",{"_3572":72515,"_30844":72497,"_21377":121008,"_5":14632,"_28040":120950,"_3027":121009},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3572":72516,"_30844":72497,"_21377":121011,"_5":14632,"_28040":120954,"_3027":121012},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3572":72517,"_30844":72497,"_21377":121014,"_5":14632,"_28040":120954,"_3027":121015},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3572":72518,"_30844":72497,"_21377":121017,"_5":14632,"_28040":120954,"_3027":121018},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3572":72519,"_30844":72497,"_21377":121020,"_5":14632,"_28040":120954,"_3027":121021},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3572":72520,"_30844":72497,"_21377":121023,"_5":14632,"_28040":120954,"_3027":121024},[],"`apikey_options` necesita `header` y `key`.",{"_3572":72521,"_30844":72497,"_21377":121026,"_5":14632,"_28040":120954,"_3027":121027},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3572":72522,"_30844":72497,"_21377":121029,"_5":14632,"_28040":120954,"_3027":121030},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3572":72523,"_30844":72497,"_21377":121032,"_5":14632,"_28040":120954,"_3027":121033},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3572":72524,"_30844":72497,"_21377":121035,"_5":14632,"_28040":120962,"_3027":121036},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3572":72525,"_30844":72497,"_21377":121038,"_5":14632,"_28040":120966,"_3027":121039},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3572":72526,"_30844":72497,"_21377":121041,"_5":14632,"_28040":120970,"_3027":121042},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3572":72527,"_30844":72497,"_21377":121044,"_5":14632,"_28040":120970,"_3027":121045},[],"**None** notifica todas las instancias del evento.",{"_3572":72528,"_30844":72497,"_21377":121047,"_5":14632,"_28040":120970,"_3027":121048},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3572":72529,"_30844":72497,"_21377":121050,"_5":14632,"_28040":120970,"_3027":121051},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3572":72530,"_30844":72497,"_21377":121053,"_5":14632,"_28040":120970,"_3027":121054},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3572":72531,"_30844":72497,"_21377":121056,"_5":14632,"_28040":120970,"_3027":121057},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3572":72532,"_30844":72497,"_21377":121059,"_5":14632,"_28040":120970,"_3027":121060},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3572":72533,"_30844":72497,"_21377":121062,"_5":14632,"_28040":120974,"_3027":121063},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3572":72534,"_30844":72497,"_21377":121065,"_5":14632,"_28040":120978,"_3027":121066},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3572":72535,"_30844":72497,"_21377":121068,"_5":14632,"_28040":120978,"_3027":121069},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3572":72536,"_30844":72497,"_21377":121071,"_5":14632,"_28040":120978,"_3027":121072},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3572":72537,"_30844":72497,"_21377":121074,"_5":14632,"_28040":120978,"_3027":121075},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3572":72538,"_30844":72497,"_21377":121077,"_5":14632,"_28040":120978,"_3027":121078},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3572":72539,"_30844":72497,"_21377":121080,"_5":14632,"_28040":120978,"_3027":121081},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3572":72540,"_30844":72497,"_21377":121083,"_5":14632,"_28040":120978,"_3027":121084},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3572":72541,"_30844":72497,"_21377":121086,"_5":14632,"_28040":120978,"_3027":121087},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3572":72542,"_30844":72497,"_21377":121089,"_5":14632,"_28040":120982,"_3027":121090},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3572":72543,"_30844":72497,"_21377":121092,"_5":14632,"_28040":120982,"_3027":121093},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3572":72544,"_30844":72497,"_21377":121095,"_5":14632,"_28040":120982,"_3027":121096},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3572":72545,"_30844":72497,"_21377":121098,"_5":14632,"_28040":120982,"_3027":121099},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3572":72546,"_30844":72497,"_21377":121101,"_5":14632,"_28040":120982,"_3027":121102},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3572":72547,"_30844":72497,"_21377":121104,"_5":14632,"_28040":120982,"_3027":121105},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3572":72548,"_30844":72497,"_21377":121107,"_5":14632,"_28040":120982,"_3027":121108},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3572":72549,"_30844":72497,"_21377":121110,"_5":14632,"_28040":120982,"_3027":121111},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3572":72550,"_30844":72497,"_21377":121113,"_5":14632,"_28040":120986,"_3027":121114},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3572":72551,"_30844":72497,"_21377":121116,"_5":14632,"_28040":120986,"_3027":121117},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3572":72552,"_30844":72497,"_21377":121119,"_5":14632,"_28040":120990,"_3027":121120},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3572":72553,"_30844":72497,"_21377":121122,"_5":14632,"_28040":120990,"_3027":121123},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3572":72554,"_30844":72497,"_21377":121125,"_5":14632,"_28040":120990,"_3027":121126},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3572":72555,"_30844":72497,"_21377":121128,"_5":14632,"_28040":120990,"_3027":121129},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3572":72556,"_30844":72497,"_21377":121131,"_5":14632,"_28040":120990,"_3027":121132},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3572":72557,"_30844":72497,"_21377":121134,"_5":14632,"_28040":120990,"_3027":121135},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3572":72558,"_30844":72497,"_21377":121137,"_5":14632,"_28040":120990,"_3027":121138},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3572":72559,"_30844":72497,"_21377":121140,"_5":14632,"_28040":120990,"_3027":121141},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3572":72560,"_30844":72497,"_21377":121143,"_5":14632,"_28040":120990,"_3027":121144},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3572":72561,"_30844":72497,"_21377":121146,"_5":14632,"_28040":120990,"_3027":121147},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3572":72562,"_30844":72562,"_5":14996,"_3027":121149,"_31202":121150,"_21377":121151,"_28040":72562},"Registros de auditoría",[50349,120289,120290],[],{"_3572":72563,"_30844":72562,"_21377":121153,"_5":14632,"_28040":72562,"_3027":121154},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3572":72564,"_30844":72562,"_5":31199,"_21377":121156,"_28040":121157,"_3027":121158},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3572":72565,"_30844":72562,"_5":31199,"_21377":121160,"_28040":121161,"_3027":121162},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3572":72566,"_30844":72562,"_5":31199,"_21377":121164,"_28040":121165,"_3027":121166},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3572":72567,"_30844":72562,"_5":31199,"_21377":121168,"_28040":121169,"_3027":121170},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3572":72568,"_30844":72562,"_5":31199,"_21377":121172,"_28040":121173,"_3027":121174},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3572":72569,"_30844":72562,"_5":31199,"_21377":121176,"_28040":121177,"_3027":121178},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3572":72570,"_30844":72562,"_5":31199,"_21377":121180,"_28040":121181,"_3027":121182},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3572":72571,"_30844":72562,"_5":31199,"_21377":121184,"_28040":121185,"_3027":121186},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3572":72572,"_30844":72562,"_5":31199,"_21377":121188,"_28040":121189,"_3027":121190},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3572":72573,"_30844":72562,"_5":31199,"_21377":121192,"_28040":121193,"_3027":121194},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3572":72574,"_30844":72562,"_5":31199,"_21377":121196,"_28040":121197,"_3027":121198},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3572":72575,"_30844":72562,"_21377":121200,"_5":14632,"_28040":72562,"_3027":121201},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3572":72576,"_30844":72562,"_21377":121203,"_5":14632,"_28040":121157,"_3027":121204},[],"El cuerpo de auditoría incluye:",{"_3572":72577,"_30844":72562,"_21377":121206,"_5":14632,"_28040":121157,"_3027":121207},[],"input: datos recibidos por la operación;",{"_3572":72578,"_30844":72562,"_21377":121209,"_5":14632,"_28040":121157,"_3027":121210},[],"has\\_error: indica si el servicio devolvió un error;",{"_3572":72579,"_30844":72562,"_21377":121212,"_5":14632,"_28040":121157,"_3027":121213},[],"output: resultado producido o mensaje de error;",{"_3572":72580,"_30844":72562,"_21377":121215,"_5":14632,"_28040":121157,"_3027":121216},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3572":72581,"_30844":72562,"_21377":121218,"_5":14632,"_28040":121157,"_3027":121219},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3572":72582,"_30844":72562,"_21377":121221,"_5":14632,"_28040":121157,"_3027":121222},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3572":72583,"_30844":72562,"_21377":121224,"_5":14632,"_28040":121161,"_3027":121225},[],"El backend aplica auditoría a mutaciones de:",{"_3572":72584,"_30844":72562,"_21377":121227,"_5":14632,"_28040":121161,"_3027":121228},[],"autoridades, certificados y perfiles de emisión;",{"_3572":72585,"_30844":72562,"_21377":121230,"_5":14632,"_28040":121161,"_3027":121231},[],"claves y motores KMS;",{"_3572":72586,"_30844":72562,"_21377":121233,"_5":14632,"_28040":121161,"_3027":121234},[],"dispositivos e identidades;",{"_3572":72587,"_30844":72562,"_21377":121236,"_5":14632,"_28040":121161,"_3027":121237},[],"DMS y operaciones de enrolamiento;",{"_3572":72588,"_30844":72562,"_21377":121239,"_5":14632,"_28040":121161,"_3027":121240},[],"funciones de validación y CRL;",{"_3572":72589,"_30844":72562,"_21377":121242,"_5":14632,"_28040":121161,"_3027":121243},[],"principales, políticas y concesiones de autorización.",{"_3572":72590,"_30844":72562,"_21377":121245,"_5":14632,"_28040":121161,"_3027":121246},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3572":72591,"_30844":72562,"_21377":121248,"_5":14632,"_28040":121165,"_3027":121249},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3572":72592,"_30844":72562,"_21377":121251,"_5":14632,"_28040":121165,"_3027":121252},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3572":72593,"_30844":72562,"_21377":121254,"_5":14632,"_28040":121165,"_3027":121255},[],"Diseña el consumidor para:",{"_3572":72594,"_30844":72562,"_21377":121257,"_5":14632,"_28040":121165,"_3027":121258},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3572":72595,"_30844":72562,"_21377":121260,"_5":14632,"_28040":121165,"_3027":121261},[],"conservar el CloudEvent completo sin modificar;",{"_3572":72596,"_30844":72562,"_21377":121263,"_5":14632,"_28040":121165,"_3027":121264},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3572":72597,"_30844":72562,"_21377":121266,"_5":14632,"_28040":121165,"_3027":121267},[],"cifrar en tránsito y en reposo;",{"_3572":72598,"_30844":72562,"_21377":121269,"_5":14632,"_28040":121165,"_3027":121270},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3572":72599,"_30844":72562,"_21377":121272,"_5":14632,"_28040":121165,"_3027":121273},[],"aplicar una política explícita de retención y legal hold;",{"_3572":72600,"_30844":72562,"_21377":121275,"_5":14632,"_28040":121165,"_3027":121276},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3572":72601,"_30844":72562,"_21377":121278,"_5":14632,"_28040":121169,"_3027":121279},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3572":72602,"_30844":72562,"_21377":121281,"_5":14632,"_28040":121169,"_3027":121282},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3572":72603,"_30844":72562,"_21377":121284,"_5":14632,"_28040":121177,"_3027":121285},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3572":72604,"_30844":72562,"_21377":121287,"_5":14632,"_28040":121181,"_3027":121288},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3572":72605,"_30844":72562,"_21377":121290,"_5":14632,"_28040":121185,"_3027":121291},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3572":72606,"_30844":72562,"_21377":121293,"_5":14632,"_28040":121189,"_3027":121294},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3572":72607,"_30844":72562,"_21377":121296,"_5":14632,"_28040":121193,"_3027":121297},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3572":72608,"_30844":72562,"_21377":121299,"_5":14632,"_28040":121197,"_3027":121300},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3572":72609,"_30844":72562,"_21377":121302,"_5":14632,"_28040":121197,"_3027":121303},[],"aparece un evento de auditoría correcto;",{"_3572":72610,"_30844":72562,"_21377":121305,"_5":14632,"_28040":121197,"_3027":121306},[],"el principal coincide con la identidad utilizada;",{"_3572":72611,"_30844":72562,"_21377":121308,"_5":14632,"_28040":121197,"_3027":121309},[],"el consumidor lo persiste una sola vez;",{"_3572":72612,"_30844":72562,"_21377":121311,"_5":14632,"_28040":121197,"_3027":121312},[],"puede recuperarse por recurso, actor y periodo;",{"_3572":72613,"_30844":72562,"_21377":121314,"_5":14632,"_28040":121197,"_3027":121315},[],"una interrupción del consumidor produce una alerta.",{"_3572":72614,"_30844":72562,"_21377":121317,"_5":14632,"_28040":121197,"_3027":121318},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3572":72615,"_30844":72615,"_5":14996,"_3027":121320,"_31202":121321,"_21377":121322,"_28040":72615},"Arquitectura de la plataforma",[50349,120289],[],{"_3572":72616,"_30844":72615,"_21377":121324,"_5":14632,"_28040":72615,"_3027":121325},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3572":72617,"_30844":72615,"_5":31199,"_21377":121327,"_28040":121328,"_3027":121329},[],"/docs/pr-preview/pr-68/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3572":72618,"_30844":72615,"_5":31199,"_21377":121331,"_28040":121332,"_3027":121333},[],"/docs/pr-preview/pr-68/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3572":72619,"_30844":72615,"_5":31199,"_21377":121335,"_28040":121336,"_3027":121337},[],"/docs/pr-preview/pr-68/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3572":72620,"_30844":72615,"_5":31199,"_21377":121339,"_28040":121340,"_3027":121341},[],"/docs/pr-preview/pr-68/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3572":72621,"_30844":72615,"_5":31199,"_21377":121343,"_28040":121344,"_3027":121345},[],"/docs/pr-preview/pr-68/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3572":72622,"_30844":72615,"_21377":121347,"_5":14632,"_28040":72615,"_3027":121348},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3572":72623,"_30844":72615,"_21377":121350,"_5":14632,"_28040":72615,"_3027":121351},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3572":72624,"_30844":72615,"_21377":121353,"_5":14632,"_28040":121328,"_3027":121354},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3572":72625,"_30844":72615,"_21377":121356,"_5":14632,"_28040":121332,"_3027":121357},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3572":72626,"_30844":72615,"_21377":121359,"_5":14632,"_28040":121336,"_3027":121360},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3572":72627,"_30844":72615,"_21377":121362,"_5":14632,"_28040":121340,"_3027":121363},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3572":72628,"_30844":72615,"_21377":121365,"_5":14632,"_28040":121344,"_3027":121366},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3572":72629,"_30844":72629,"_5":14996,"_3027":121368,"_31202":121369,"_21377":121370,"_28040":72629},"Cómo funciona Lamassu",[50349,120289],[],{"_3572":72630,"_30844":72629,"_21377":121372,"_5":14632,"_28040":72629,"_3027":121373},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3572":72631,"_30844":72629,"_5":31199,"_21377":121375,"_28040":121376,"_3027":121377},[],"/docs/pr-preview/pr-68/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3572":72632,"_30844":72629,"_5":31199,"_21377":121379,"_28040":121380,"_3027":121381},[],"/docs/pr-preview/pr-68/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3572":72633,"_30844":72629,"_21377":121383,"_5":14632,"_28040":72629,"_3027":121384},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3572":72634,"_30844":72629,"_21377":121386,"_5":14632,"_28040":121376,"_3027":121387},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3572":72635,"_30844":72629,"_21377":121389,"_5":14632,"_28040":121376,"_3027":121390},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3572":72636,"_30844":72629,"_21377":121392,"_5":14632,"_28040":121376,"_3027":121393},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3572":72637,"_30844":72629,"_21377":121395,"_5":14632,"_28040":121376,"_3027":121396},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3572":72638,"_30844":72629,"_21377":121398,"_5":14632,"_28040":121376,"_3027":121399},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3572":72639,"_30844":72629,"_21377":121401,"_5":14632,"_28040":121380,"_3027":121402},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3572":72640,"_30844":72629,"_21377":121404,"_5":14632,"_28040":121380,"_3027":121405},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3572":72641,"_30844":72629,"_21377":121407,"_5":14632,"_28040":121380,"_3027":121408},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3572":72642,"_30844":72629,"_21377":121410,"_5":14632,"_28040":121380,"_3027":121411},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3572":72643,"_30844":72629,"_21377":121413,"_5":14632,"_28040":121380,"_3027":121414},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3572":72644,"_30844":72629,"_21377":121416,"_5":14632,"_28040":121380,"_3027":121417},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3572":72645,"_30844":72629,"_21377":121419,"_5":14632,"_28040":121380,"_3027":121420},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3572":72646,"_30844":72646,"_5":14996,"_3027":121422,"_31202":121423,"_21377":121424,"_28040":72646},"Dispositivos e identidades",[50349,120289,53048,121422],[],{"_3572":72647,"_30844":72646,"_21377":121426,"_5":14632,"_28040":72646,"_3027":121427},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3572":72648,"_30844":72646,"_5":31199,"_21377":121429,"_28040":121430,"_3027":121431},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3572":72649,"_30844":72646,"_5":31199,"_21377":121433,"_28040":121434,"_3027":121435},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3572":72650,"_30844":72646,"_5":31199,"_21377":121437,"_28040":121438,"_3027":121439},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3572":72651,"_30844":72646,"_5":31199,"_21377":121441,"_28040":121442,"_3027":121443},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3572":72652,"_30844":72646,"_5":31199,"_21377":121445,"_28040":121446,"_3027":121447},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3572":72653,"_30844":72646,"_5":31199,"_21377":121449,"_28040":121450,"_3027":121451},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3572":72654,"_30844":72646,"_5":31199,"_21377":121453,"_28040":121454,"_3027":121455},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3572":72655,"_30844":72646,"_5":31199,"_21377":121457,"_28040":121458,"_3027":121459},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3572":72656,"_30844":72646,"_5":31199,"_21377":121461,"_28040":121462,"_3027":121463},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3572":72657,"_30844":72646,"_5":31199,"_21377":121465,"_28040":121466,"_3027":121467},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3572":72658,"_30844":72646,"_5":31199,"_21377":121469,"_28040":121470,"_3027":121471},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3572":72659,"_30844":72646,"_21377":121473,"_5":14632,"_28040":72646,"_3027":121474},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3572":72660,"_30844":72646,"_21377":121476,"_5":14632,"_28040":72646,"_3027":121477},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3572":72661,"_30844":72646,"_21377":121479,"_5":14632,"_28040":121430,"_3027":121480},[],"Vista operativa",{"_3572":72662,"_30844":72646,"_21377":121482,"_5":14632,"_28040":121430,"_3027":121483},[],"Interpretación",{"_3572":72663,"_30844":72646,"_21377":121485,"_5":14632,"_28040":121430,"_3027":53111},[],{"_3572":72664,"_30844":72646,"_21377":121487,"_5":14632,"_28040":121430,"_3027":121488},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3572":72665,"_30844":72646,"_21377":121490,"_5":14632,"_28040":121430,"_3027":53117},[],{"_3572":72666,"_30844":72646,"_21377":121492,"_5":14632,"_28040":121430,"_3027":121493},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3572":72667,"_30844":72646,"_21377":121495,"_5":14632,"_28040":121430,"_3027":53123},[],{"_3572":72668,"_30844":72646,"_21377":121497,"_5":14632,"_28040":121430,"_3027":121498},[],"La identidad está en la ventana operativa de renovación.",{"_3572":72669,"_30844":72646,"_21377":121500,"_5":14632,"_28040":121430,"_3027":53129},[],{"_3572":72670,"_30844":72646,"_21377":121502,"_5":14632,"_28040":121430,"_3027":121503},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3572":72671,"_30844":72646,"_21377":121505,"_5":14632,"_28040":121430,"_3027":53135},[],{"_3572":72672,"_30844":72646,"_21377":121507,"_5":14632,"_28040":121430,"_3027":121508},[],"La identidad ha vencido.",{"_3572":72673,"_30844":72646,"_21377":121510,"_5":14632,"_28040":121430,"_3027":53141},[],{"_3572":72674,"_30844":72646,"_21377":121512,"_5":14632,"_28040":121430,"_3027":121513},[],"La identidad está marcada como revocada.",{"_3572":72675,"_30844":72646,"_21377":121515,"_5":14632,"_28040":121430,"_3027":53147},[],{"_3572":72676,"_30844":72646,"_21377":121517,"_5":14632,"_28040":121430,"_3027":121518},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3572":72677,"_30844":72646,"_21377":121520,"_5":14632,"_28040":121430,"_3027":121521},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3572":72678,"_30844":72646,"_21377":121523,"_5":14632,"_28040":121434,"_3027":121524},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3572":72679,"_30844":72646,"_21377":121526,"_5":14632,"_28040":121434,"_3027":121527},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3572":72680,"_30844":72646,"_21377":121529,"_5":14632,"_28040":121434,"_3027":121530},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3572":72681,"_30844":72646,"_21377":121532,"_5":14632,"_28040":121434,"_3027":121533},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3572":72682,"_30844":72646,"_21377":121535,"_5":14632,"_28040":121438,"_3027":121536},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3572":72683,"_30844":72646,"_21377":121538,"_5":14632,"_28040":121442,"_3027":121539},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3572":72684,"_30844":72646,"_21377":121541,"_5":14632,"_28040":121446,"_3027":121542},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3572":72685,"_30844":72646,"_21377":121544,"_5":14632,"_28040":121450,"_3027":121545},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3572":72686,"_30844":72646,"_21377":121547,"_5":14632,"_28040":121454,"_3027":121548},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3572":72687,"_30844":72646,"_21377":121550,"_5":14632,"_28040":121454,"_3027":121551},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3572":72688,"_30844":72646,"_21377":121553,"_5":14632,"_28040":121458,"_3027":121554},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3572":72689,"_30844":72646,"_21377":121556,"_5":14632,"_28040":121458,"_3027":121557},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3572":72690,"_30844":72646,"_21377":121559,"_5":14632,"_28040":121458,"_3027":121560},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3572":72691,"_30844":72646,"_21377":121562,"_5":14632,"_28040":121458,"_3027":121563},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3572":72692,"_30844":72646,"_21377":121565,"_5":14632,"_28040":121458,"_3027":121566},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3572":72693,"_30844":72646,"_21377":121568,"_5":14632,"_28040":121458,"_3027":121569},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3572":72694,"_30844":72646,"_21377":121571,"_5":14632,"_28040":121462,"_3027":121572},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3572":72695,"_30844":72646,"_21377":121574,"_5":14632,"_28040":121462,"_3027":121575},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3572":72696,"_30844":72646,"_21377":121577,"_5":14632,"_28040":121466,"_3027":121578},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3572":72697,"_30844":72646,"_21377":121580,"_5":14632,"_28040":121466,"_3027":121581},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3572":72698,"_30844":72646,"_21377":121583,"_5":14632,"_28040":121466,"_3027":121584},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3572":72699,"_30844":72646,"_21377":121586,"_5":14632,"_28040":121466,"_3027":121587},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3572":72700,"_30844":72646,"_21377":121589,"_5":14632,"_28040":121470,"_3027":121590},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3572":72701,"_30844":72646,"_21377":121592,"_5":14632,"_28040":121470,"_3027":121593},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3572":72702,"_30844":72702,"_5":14996,"_3027":121595,"_31202":121596,"_21377":121598,"_28040":72702},"Identidad inicial y autenticación",[50349,120289,53048,121422,121597],"Enrolamiento con PKI",[],{"_3572":72703,"_30844":72702,"_21377":121600,"_5":14632,"_28040":72702,"_3027":121601},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3572":72704,"_30844":72702,"_5":31199,"_21377":121603,"_28040":121604,"_3027":121605},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3572":72705,"_30844":72702,"_5":31199,"_21377":121607,"_28040":121608,"_3027":121609},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3572":72706,"_30844":72702,"_5":31199,"_21377":121611,"_28040":121612,"_3027":121613},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3572":72707,"_30844":72702,"_5":31199,"_21377":121615,"_28040":121616,"_3027":121617},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3572":72708,"_30844":72702,"_5":31199,"_21377":121619,"_28040":121620,"_3027":121621},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3572":72709,"_30844":72702,"_21377":121623,"_5":14632,"_28040":72702,"_3027":121624},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3572":72710,"_30844":72702,"_21377":121626,"_5":14632,"_28040":121604,"_3027":121627},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3572":72711,"_30844":72702,"_21377":121629,"_5":14632,"_28040":121604,"_3027":121630},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3572":72712,"_30844":72702,"_21377":121632,"_5":14632,"_28040":121608,"_3027":121633},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3572":72713,"_30844":72702,"_21377":121635,"_5":14632,"_28040":121608,"_3027":121636},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3572":72714,"_30844":72702,"_21377":121638,"_5":14632,"_28040":121608,"_3027":121639},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3572":72715,"_30844":72702,"_21377":121641,"_5":14632,"_28040":121612,"_3027":121642},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3572":72716,"_30844":72702,"_21377":121644,"_5":14632,"_28040":121612,"_3027":121645},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3572":72717,"_30844":72702,"_21377":121647,"_5":14632,"_28040":121616,"_3027":121648},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3572":72718,"_30844":72702,"_21377":121650,"_5":14632,"_28040":121616,"_3027":121651},[],"Ejemplo de cuerpo:",{"_3572":72719,"_30844":72702,"_21377":121653,"_5":14632,"_28040":121616,"_3027":121654},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3572":72720,"_30844":72702,"_21377":121656,"_5":14632,"_28040":121616,"_3027":121657},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3572":72721,"_30844":72702,"_21377":121659,"_5":14632,"_28040":121616,"_3027":121660},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3572":72722,"_30844":72702,"_21377":121662,"_5":14632,"_28040":121616,"_3027":121663},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3572":72723,"_30844":72702,"_21377":121665,"_5":14632,"_28040":121620,"_3027":121666},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3572":72724,"_30844":72702,"_21377":121668,"_5":14632,"_28040":121620,"_3027":121669},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3572":72725,"_30844":72725,"_5":14996,"_3027":121671,"_31202":121672,"_21377":121673,"_28040":72725},"Configura y opera el DMS",[50349,120289,53048,121422,121597],[],{"_3572":72726,"_30844":72725,"_21377":121675,"_5":14632,"_28040":72725,"_3027":121676},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3572":72727,"_30844":72725,"_5":31199,"_21377":121678,"_28040":121679,"_3027":118802},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3572":72728,"_30844":72725,"_5":31199,"_21377":121681,"_28040":121682,"_3027":121683},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3572":72729,"_30844":72725,"_5":31199,"_21377":121685,"_28040":121686,"_3027":121687},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3572":72730,"_30844":72725,"_5":31199,"_21377":121689,"_28040":121690,"_3027":121691},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3572":72731,"_30844":72725,"_5":31199,"_21377":121693,"_28040":121694,"_3027":121695},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3572":72732,"_30844":72725,"_5":31199,"_21377":121697,"_28040":121698,"_3027":121699},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3572":72733,"_30844":72725,"_5":31199,"_21377":121701,"_28040":121702,"_3027":121703},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3572":72734,"_30844":72725,"_5":31199,"_21377":121705,"_28040":121706,"_3027":121707},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3572":72735,"_30844":72725,"_5":31199,"_21377":121709,"_28040":121710,"_3027":53343},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3572":72736,"_30844":72725,"_5":31199,"_21377":121712,"_28040":121713,"_3027":53347},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3572":72737,"_30844":72725,"_5":31199,"_21377":121715,"_28040":121716,"_3027":121717},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3572":72738,"_30844":72725,"_5":31199,"_21377":121719,"_28040":121720,"_3027":121721},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3572":72739,"_30844":72725,"_5":31199,"_21377":121723,"_28040":121724,"_3027":121725},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3572":72740,"_30844":72725,"_5":31199,"_21377":121727,"_28040":121728,"_3027":121729},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3572":72741,"_30844":72725,"_5":31199,"_21377":121731,"_28040":121732,"_3027":53367},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3572":72742,"_30844":72725,"_5":31199,"_21377":121734,"_28040":121735,"_3027":121736},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3572":72743,"_30844":72725,"_5":31199,"_21377":121738,"_28040":121739,"_3027":121740},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3572":72744,"_30844":72725,"_5":31199,"_21377":121742,"_28040":121743,"_3027":121744},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3572":72745,"_30844":72725,"_21377":121746,"_5":14632,"_28040":72725,"_3027":121747},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3572":72746,"_30844":72725,"_21377":121749,"_5":14632,"_28040":121679,"_3027":121750},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3572":72747,"_30844":72725,"_21377":121752,"_5":14632,"_28040":121679,"_3027":121753},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3572":72748,"_30844":72725,"_21377":121755,"_5":14632,"_28040":121686,"_3027":121756},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3572":72749,"_30844":72725,"_21377":121758,"_5":14632,"_28040":121690,"_3027":121759},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3572":72750,"_30844":72725,"_21377":121761,"_5":14632,"_28040":121694,"_3027":121762},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3572":72751,"_30844":72725,"_21377":121764,"_5":14632,"_28040":121698,"_3027":121765},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3572":72752,"_30844":72725,"_21377":121767,"_5":14632,"_28040":121702,"_3027":121768},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3572":72753,"_30844":72725,"_21377":121770,"_5":14632,"_28040":121710,"_3027":121771},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3572":72754,"_30844":72725,"_21377":121773,"_5":14632,"_28040":121710,"_3027":121774},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3572":72755,"_30844":72725,"_21377":121776,"_5":14632,"_28040":121713,"_3027":121777},[],"Campo de `settings.enrollment_settings`",{"_3572":72756,"_30844":72725,"_21377":121779,"_5":14632,"_28040":121713,"_3027":121780},[],"Decisión",{"_3572":72757,"_30844":72725,"_21377":121782,"_5":14632,"_28040":121713,"_3027":53418},[],{"_3572":72758,"_30844":72725,"_21377":121784,"_5":14632,"_28040":121713,"_3027":121785},[],"`EST_RFC7030` para estas operaciones.",{"_3572":72759,"_30844":72725,"_21377":121787,"_5":14632,"_28040":121713,"_3027":53424},[],{"_3572":72760,"_30844":72725,"_21377":121789,"_5":14632,"_28040":121713,"_3027":121790},[],"ID de la CA que firmará.",{"_3572":72761,"_30844":72725,"_21377":121792,"_5":14632,"_28040":121713,"_3027":53430},[],{"_3572":72762,"_30844":72725,"_21377":121794,"_5":14632,"_28040":121713,"_3027":121795},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3572":72763,"_30844":72725,"_21377":121797,"_5":14632,"_28040":121713,"_3027":53436},[],{"_3572":72764,"_30844":72725,"_21377":121799,"_5":14632,"_28040":121713,"_3027":121800},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3572":72765,"_30844":72725,"_21377":121802,"_5":14632,"_28040":121713,"_3027":53442},[],{"_3572":72766,"_30844":72725,"_21377":121804,"_5":14632,"_28040":121713,"_3027":121805},[],"Uno de los cuatro modos de autenticación.",{"_3572":72767,"_30844":72725,"_21377":121807,"_5":14632,"_28040":121713,"_3027":121808},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3572":72768,"_30844":72725,"_21377":121810,"_5":14632,"_28040":121716,"_3027":121811},[],"Los bloques son independientes:",{"_3572":72769,"_30844":72725,"_21377":121813,"_5":14632,"_28040":121716,"_3027":121814},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3572":72770,"_30844":72725,"_21377":121816,"_5":14632,"_28040":121716,"_3027":121817},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3572":72771,"_30844":72725,"_21377":121819,"_5":14632,"_28040":121716,"_3027":53460},[],{"_3572":72772,"_30844":72725,"_21377":121821,"_5":14632,"_28040":121716,"_3027":121822},[],"Control aplicado en la operación configurada",{"_3572":72773,"_30844":72725,"_21377":121824,"_5":14632,"_28040":121716,"_3027":53466},[],{"_3572":72774,"_30844":72725,"_21377":121826,"_5":14632,"_28040":121716,"_3027":121827},[],"Validación del certificado presentado.",{"_3572":72775,"_30844":72725,"_21377":121829,"_5":14632,"_28040":121716,"_3027":53472},[],{"_3572":72776,"_30844":72725,"_21377":121831,"_5":14632,"_28040":121716,"_3027":121832},[],"Autorización del webhook configurado.",{"_3572":72777,"_30844":72725,"_21377":121834,"_5":14632,"_28040":121716,"_3027":53478},[],{"_3572":72778,"_30844":72725,"_21377":121836,"_5":14632,"_28040":121716,"_3027":121837},[],"Validación del certificado y, después, aprobación del webhook.",{"_3572":72779,"_30844":72725,"_21377":121839,"_5":14632,"_28040":121716,"_3027":53484},[],{"_3572":72780,"_30844":72725,"_21377":121841,"_5":14632,"_28040":121716,"_3027":121842},[],"Sin autenticación del solicitante por el DMS.",{"_3572":72781,"_30844":72725,"_21377":121844,"_5":14632,"_28040":121716,"_3027":121845},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3572":72782,"_30844":72725,"_21377":121847,"_5":14632,"_28040":121716,"_3027":121848},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3572":72783,"_30844":72725,"_21377":121850,"_5":14632,"_28040":121716,"_3027":121851},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3572":72784,"_30844":72725,"_21377":121853,"_5":14632,"_28040":121716,"_3027":121854},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3572":72785,"_30844":72725,"_21377":121856,"_5":14632,"_28040":121720,"_3027":121857},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3572":72786,"_30844":72725,"_21377":121859,"_5":14632,"_28040":121720,"_3027":121860},[],"Campo de `external_webhook_settings`",{"_3572":72787,"_30844":72725,"_21377":121862,"_5":14632,"_28040":121720,"_3027":121780},[],{"_3572":72788,"_30844":72725,"_21377":121864,"_5":14632,"_28040":121720,"_3027":53510},[],{"_3572":72789,"_30844":72725,"_21377":121866,"_5":14632,"_28040":121720,"_3027":121867},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3572":72790,"_30844":72725,"_21377":121869,"_5":14632,"_28040":121720,"_3027":53516},[],{"_3572":72791,"_30844":72725,"_21377":121871,"_5":14632,"_28040":121720,"_3027":121872},[],"`POST` o `PUT`; `POST` por defecto.",{"_3572":72792,"_30844":72725,"_21377":121874,"_5":14632,"_28040":121720,"_3027":53522},[],{"_3572":72793,"_30844":72725,"_21377":121876,"_5":14632,"_28040":121720,"_3027":121877},[],"Etiqueta usada en los logs del servicio.",{"_3572":72794,"_30844":72725,"_21377":121879,"_5":14632,"_28040":121720,"_3027":53528},[],{"_3572":72795,"_30844":72725,"_21377":121881,"_5":14632,"_28040":121720,"_3027":121882},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3572":72796,"_30844":72725,"_21377":121884,"_5":14632,"_28040":121720,"_3027":53534},[],{"_3572":72797,"_30844":72725,"_21377":121886,"_5":14632,"_28040":121720,"_3027":121887},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3572":72798,"_30844":72725,"_21377":121889,"_5":14632,"_28040":121720,"_3027":53540},[],{"_3572":72799,"_30844":72725,"_21377":121891,"_5":14632,"_28040":121720,"_3027":121892},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3572":72800,"_30844":72725,"_21377":121894,"_5":14632,"_28040":121720,"_3027":53546},[],{"_3572":72801,"_30844":72725,"_21377":121896,"_5":14632,"_28040":121720,"_3027":121897},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3572":72802,"_30844":72725,"_21377":121899,"_5":14632,"_28040":121720,"_3027":53552},[],{"_3572":72803,"_30844":72725,"_21377":121901,"_5":14632,"_28040":121720,"_3027":121902},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3572":72804,"_30844":72725,"_21377":121904,"_5":14632,"_28040":121720,"_3027":53558},[],{"_3572":72805,"_30844":72725,"_21377":121906,"_5":14632,"_28040":121720,"_3027":121907},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3572":72806,"_30844":72725,"_21377":121909,"_5":14632,"_28040":121720,"_3027":53564},[],{"_3572":72807,"_30844":72725,"_21377":121911,"_5":14632,"_28040":121720,"_3027":121912},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3572":72808,"_30844":72725,"_21377":121914,"_5":14632,"_28040":121720,"_3027":121915},[],"Reglas de esa configuración:",{"_3572":72809,"_30844":72725,"_21377":121917,"_5":14632,"_28040":121720,"_3027":121918},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3572":72810,"_30844":72725,"_21377":121920,"_5":14632,"_28040":121720,"_3027":121921},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3572":72811,"_30844":72725,"_21377":121923,"_5":14632,"_28040":121720,"_3027":121924},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3572":72812,"_30844":72725,"_21377":121926,"_5":14632,"_28040":121720,"_3027":121927},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3572":72813,"_30844":72725,"_21377":121929,"_5":14632,"_28040":121720,"_3027":121930},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3572":72814,"_30844":72725,"_21377":121932,"_5":14632,"_28040":121720,"_3027":121933},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3572":72815,"_30844":72725,"_21377":121935,"_5":14632,"_28040":121720,"_3027":121936},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3572":72816,"_30844":72725,"_21377":121938,"_5":14632,"_28040":121720,"_3027":121939},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3572":72817,"_30844":72725,"_21377":121941,"_5":14632,"_28040":121720,"_3027":121942},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3572":72818,"_30844":72725,"_21377":121944,"_5":14632,"_28040":121724,"_3027":121945},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3572":72819,"_30844":72725,"_21377":121947,"_5":14632,"_28040":121728,"_3027":121948},[],"Campo de `settings.reenrollment_settings`",{"_3572":72820,"_30844":72725,"_21377":121950,"_5":14632,"_28040":121728,"_3027":121951},[],"Función",{"_3572":72821,"_30844":72725,"_21377":121953,"_5":14632,"_28040":121728,"_3027":53608},[],{"_3572":72822,"_30844":72725,"_21377":121955,"_5":14632,"_28040":121728,"_3027":121956},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3572":72823,"_30844":72725,"_21377":121958,"_5":14632,"_28040":121728,"_3027":53614},[],{"_3572":72824,"_30844":72725,"_21377":121960,"_5":14632,"_28040":121728,"_3027":121961},[],"Umbral operativo preventivo de monitorización.",{"_3572":72825,"_30844":72725,"_21377":121963,"_5":14632,"_28040":121728,"_3027":53620},[],{"_3572":72826,"_30844":72725,"_21377":121965,"_5":14632,"_28040":121728,"_3027":121966},[],"Umbral operativo crítico de monitorización.",{"_3572":72827,"_30844":72725,"_21377":121968,"_5":14632,"_28040":121728,"_3027":53626},[],{"_3572":72828,"_30844":72725,"_21377":121970,"_5":14632,"_28040":121728,"_3027":121971},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3572":72829,"_30844":72725,"_21377":121973,"_5":14632,"_28040":121728,"_3027":53632},[],{"_3572":72830,"_30844":72725,"_21377":121975,"_5":14632,"_28040":121728,"_3027":121976},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3572":72831,"_30844":72725,"_21377":121978,"_5":14632,"_28040":121728,"_3027":53638},[],{"_3572":72832,"_30844":72725,"_21377":121980,"_5":14632,"_28040":121728,"_3027":121981},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3572":72833,"_30844":72725,"_21377":121983,"_5":14632,"_28040":121728,"_3027":121984},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3572":72834,"_30844":72725,"_21377":121986,"_5":14632,"_28040":121732,"_3027":121987},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3572":72835,"_30844":72725,"_21377":121989,"_5":14632,"_28040":121735,"_3027":119166},[],{"_3572":72836,"_30844":72725,"_21377":121991,"_5":14632,"_28040":121735,"_3027":121992},[],"Qué publica",{"_3572":72837,"_30844":72725,"_21377":121994,"_5":14632,"_28040":121735,"_3027":53655},[],{"_3572":72838,"_30844":72725,"_21377":121996,"_5":14632,"_28040":121735,"_3027":121997},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3572":72839,"_30844":72725,"_21377":121999,"_5":14632,"_28040":121735,"_3027":53661},[],{"_3572":72840,"_30844":72725,"_21377":122001,"_5":14632,"_28040":121735,"_3027":122002},[],"Certificado de la CA emisora seleccionada.",{"_3572":72841,"_30844":72725,"_21377":122004,"_5":14632,"_28040":121735,"_3027":53667},[],{"_3572":72842,"_30844":72725,"_21377":122006,"_5":14632,"_28040":121735,"_3027":122007},[],"Certificados de las CAs elegidas explícitamente.",{"_3572":72843,"_30844":72725,"_21377":122009,"_5":14632,"_28040":121735,"_3027":122010},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3572":72844,"_30844":72725,"_21377":122012,"_5":14632,"_28040":121739,"_3027":122013},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3572":72845,"_30844":72725,"_21377":122015,"_5":14632,"_28040":121739,"_3027":122016},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3572":72846,"_30844":72725,"_21377":122018,"_5":14632,"_28040":121739,"_3027":122019},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3572":72847,"_30844":72725,"_21377":122021,"_5":14632,"_28040":121743,"_3027":122022},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3572":72848,"_30844":72848,"_5":14996,"_3027":122024,"_31202":122025,"_21377":122026,"_28040":72848},"Integra el cliente EST",[50349,120289,53048,121422,121597],[],{"_3572":72849,"_30844":72848,"_21377":122028,"_5":14632,"_28040":72848,"_3027":122029},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3572":72850,"_30844":72848,"_5":31199,"_21377":122031,"_28040":122032,"_3027":118802},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3572":72851,"_30844":72848,"_5":31199,"_21377":122034,"_28040":122035,"_3027":122036},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3572":72852,"_30844":72848,"_5":31199,"_21377":122038,"_28040":122039,"_3027":122040},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3572":72853,"_30844":72848,"_5":31199,"_21377":122042,"_28040":122043,"_3027":122044},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3572":72854,"_30844":72848,"_5":31199,"_21377":122046,"_28040":122047,"_3027":122048},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3572":72855,"_30844":72848,"_5":31199,"_21377":122050,"_28040":122051,"_3027":122052},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3572":72856,"_30844":72848,"_21377":122054,"_5":14632,"_28040":72848,"_3027":122055},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3572":72857,"_30844":72848,"_21377":122057,"_5":14632,"_28040":122032,"_3027":122058},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3572":72858,"_30844":72848,"_21377":122060,"_5":14632,"_28040":122032,"_3027":122061},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3572":72859,"_30844":72848,"_21377":122063,"_5":14632,"_28040":122032,"_3027":122064},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3572":72860,"_30844":72848,"_21377":122066,"_5":14632,"_28040":122035,"_3027":122067},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3572":72861,"_30844":72848,"_21377":122069,"_5":14632,"_28040":122035,"_3027":122070},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3572":72862,"_30844":72848,"_21377":122072,"_5":14632,"_28040":122039,"_3027":122073},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3572":72863,"_30844":72848,"_21377":122075,"_5":14632,"_28040":122039,"_3027":122076},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3572":72864,"_30844":72848,"_21377":122078,"_5":14632,"_28040":122043,"_3027":122079},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3572":72865,"_30844":72848,"_21377":122081,"_5":14632,"_28040":122043,"_3027":122082},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3572":72866,"_30844":72848,"_21377":122084,"_5":14632,"_28040":122047,"_3027":122085},[],"Para el caso de una raíz que emite directamente:",{"_3572":72867,"_30844":72848,"_21377":122087,"_5":14632,"_28040":122047,"_3027":122088},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3572":72868,"_30844":72848,"_21377":122090,"_5":14632,"_28040":122047,"_3027":122091},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3572":72869,"_30844":72848,"_21377":122093,"_5":14632,"_28040":122051,"_3027":122094},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3572":72870,"_30844":72870,"_5":14996,"_3027":122096,"_31202":122097,"_21377":122098,"_28040":72870},"Referencia EST",[50349,120289,53048,121422,121597],[],{"_3572":72871,"_30844":72870,"_21377":122100,"_5":14632,"_28040":72870,"_3027":122101},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3572":72872,"_30844":72870,"_5":31199,"_21377":122103,"_28040":122104,"_3027":122105},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3572":72873,"_30844":72870,"_5":31199,"_21377":122107,"_28040":122108,"_3027":23158},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3572":72874,"_30844":72870,"_5":31199,"_21377":122110,"_28040":122111,"_3027":26602},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3572":72875,"_30844":72870,"_5":31199,"_21377":122113,"_28040":122114,"_3027":26609},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3572":72876,"_30844":72870,"_5":31199,"_21377":122116,"_28040":122117,"_3027":25890},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3572":72877,"_30844":72870,"_5":31199,"_21377":122119,"_28040":122120,"_3027":122121},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3572":72878,"_30844":72870,"_5":31199,"_21377":122123,"_28040":122124,"_3027":122125},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3572":72879,"_30844":72870,"_5":31199,"_21377":122127,"_28040":122128,"_3027":122129},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3572":72880,"_30844":72870,"_21377":122131,"_5":14632,"_28040":72870,"_3027":122132},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3572":72881,"_30844":72870,"_21377":122134,"_5":14632,"_28040":122104,"_3027":122135},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3572":72882,"_30844":72870,"_21377":122137,"_5":14632,"_28040":122104,"_3027":120040},[],{"_3572":72883,"_30844":72870,"_21377":122139,"_5":14632,"_28040":122104,"_3027":122140},[],"Método",{"_3572":72884,"_30844":72870,"_21377":122142,"_5":14632,"_28040":122104,"_3027":122143},[],"Autenticación y condición",{"_3572":72885,"_30844":72870,"_21377":122145,"_5":14632,"_28040":122104,"_3027":53810},[],{"_3572":72886,"_30844":72870,"_21377":122147,"_5":14632,"_28040":122104,"_3027":53813},[],{"_3572":72887,"_30844":72870,"_21377":122149,"_5":14632,"_28040":122104,"_3027":122150},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3572":72888,"_30844":72870,"_21377":122152,"_5":14632,"_28040":122104,"_3027":53819},[],{"_3572":72889,"_30844":72870,"_21377":122154,"_5":14632,"_28040":122104,"_3027":53822},[],{"_3572":72890,"_30844":72870,"_21377":122156,"_5":14632,"_28040":122104,"_3027":122157},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3572":72891,"_30844":72870,"_21377":122159,"_5":14632,"_28040":122104,"_3027":53828},[],{"_3572":72892,"_30844":72870,"_21377":122161,"_5":14632,"_28040":122104,"_3027":53822},[],{"_3572":72893,"_30844":72870,"_21377":122163,"_5":14632,"_28040":122104,"_3027":122164},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3572":72894,"_30844":72870,"_21377":122166,"_5":14632,"_28040":122104,"_3027":53836},[],{"_3572":72895,"_30844":72870,"_21377":122168,"_5":14632,"_28040":122104,"_3027":53822},[],{"_3572":72896,"_30844":72870,"_21377":122170,"_5":14632,"_28040":122104,"_3027":122171},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3572":72897,"_30844":72870,"_21377":122173,"_5":14632,"_28040":122104,"_3027":122174},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3572":72898,"_30844":72870,"_21377":122176,"_5":14632,"_28040":122108,"_3027":122177},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3572":72899,"_30844":72870,"_21377":122179,"_5":14632,"_28040":122108,"_3027":122180},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3572":72900,"_30844":72870,"_21377":122182,"_5":14632,"_28040":122111,"_3027":122183},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3572":72901,"_30844":72870,"_21377":122185,"_5":14632,"_28040":122111,"_3027":122186},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3572":72902,"_30844":72870,"_21377":122188,"_5":14632,"_28040":122114,"_3027":122189},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3572":72903,"_30844":72870,"_21377":122191,"_5":14632,"_28040":122114,"_3027":122192},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3572":72904,"_30844":72870,"_21377":122194,"_5":14632,"_28040":122117,"_3027":122195},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3572":72905,"_30844":72870,"_21377":122197,"_5":14632,"_28040":122117,"_3027":122198},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3572":72906,"_30844":72870,"_21377":122200,"_5":14632,"_28040":122120,"_3027":122201},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3572":72907,"_30844":72870,"_21377":122203,"_5":14632,"_28040":122120,"_3027":122204},[],"Parte",{"_3572":72908,"_30844":72870,"_21377":122206,"_5":14632,"_28040":122120,"_3027":122207},[],"Contenido tras decodificar su Base64",{"_3572":72909,"_30844":72870,"_21377":122209,"_5":14632,"_28040":122120,"_3027":53880},[],{"_3572":72910,"_30844":72870,"_21377":122211,"_5":14632,"_28040":122120,"_3027":122212},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3572":72911,"_30844":72870,"_21377":122214,"_5":14632,"_28040":122120,"_3027":53886},[],{"_3572":72912,"_30844":72870,"_21377":122216,"_5":14632,"_28040":122120,"_3027":122217},[],"PKCS#7 DER con el certificado emitido.",{"_3572":72913,"_30844":72870,"_21377":122219,"_5":14632,"_28040":122120,"_3027":122220},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3572":72914,"_30844":72870,"_21377":122222,"_5":14632,"_28040":122124,"_3027":122223},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3572":72915,"_30844":72870,"_21377":122225,"_5":14632,"_28040":122124,"_3027":122226},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3572":72916,"_30844":72870,"_21377":122228,"_5":14632,"_28040":122124,"_3027":122229},[],"Convierte y comprueba el resultado:",{"_3572":72917,"_30844":72870,"_21377":122231,"_5":14632,"_28040":122124,"_3027":122232},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3572":72918,"_30844":72870,"_21377":122234,"_5":14632,"_28040":122128,"_3027":122235},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3572":72919,"_30844":72870,"_21377":122237,"_5":14632,"_28040":122128,"_3027":122238},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3572":72920,"_30844":72920,"_5":14996,"_3027":121597,"_31202":122240,"_21377":122241,"_28040":72920},[50349,120289,53048,121422,121597],[],{"_3572":72921,"_30844":72920,"_21377":122243,"_5":14632,"_28040":72920,"_3027":122244},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3572":72922,"_30844":72920,"_5":31199,"_21377":122246,"_28040":122247,"_3027":122248},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3572":72923,"_30844":72920,"_5":31199,"_21377":122250,"_28040":122251,"_3027":122252},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3572":72924,"_30844":72920,"_5":31199,"_21377":122254,"_28040":122255,"_3027":122256},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3572":72925,"_30844":72920,"_5":31199,"_21377":122258,"_28040":122259,"_3027":122260},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3572":72926,"_30844":72920,"_21377":122262,"_5":14632,"_28040":72920,"_3027":122263},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3572":72927,"_30844":72920,"_21377":122265,"_5":14632,"_28040":122247,"_3027":122266},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3572":72928,"_30844":72920,"_21377":122268,"_5":14632,"_28040":122247,"_3027":122269},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3572":72929,"_30844":72920,"_21377":122271,"_5":14632,"_28040":122247,"_3027":122272},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3572":72930,"_30844":72920,"_21377":122274,"_5":14632,"_28040":122247,"_3027":122275},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3572":72931,"_30844":72920,"_21377":122277,"_5":14632,"_28040":122247,"_3027":122278},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3572":72932,"_30844":72920,"_21377":122280,"_5":14632,"_28040":122247,"_3027":122281},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3572":72933,"_30844":72920,"_21377":122283,"_5":14632,"_28040":122251,"_3027":122284},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3572":72934,"_30844":72920,"_21377":122286,"_5":14632,"_28040":122251,"_3027":122287},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3572":72935,"_30844":72920,"_21377":122289,"_5":14632,"_28040":122251,"_3027":122290},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3572":72936,"_30844":72920,"_21377":122292,"_5":14632,"_28040":122251,"_3027":122293},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3572":72937,"_30844":72920,"_21377":122295,"_5":14632,"_28040":122255,"_3027":122296},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3572":72938,"_30844":72920,"_21377":122298,"_5":14632,"_28040":122255,"_3027":122299},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3572":72939,"_30844":72920,"_21377":122301,"_5":14632,"_28040":122255,"_3027":122302},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3572":72940,"_30844":72920,"_21377":122304,"_5":14632,"_28040":122255,"_3027":122305},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3572":72941,"_30844":72920,"_21377":122307,"_5":14632,"_28040":122259,"_3027":122308},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3572":72942,"_30844":72920,"_21377":122310,"_5":14632,"_28040":122259,"_3027":122311},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3572":72943,"_30844":72943,"_5":14996,"_3027":122313,"_31202":122314,"_21377":122315,"_28040":72943},"Estrategias de aprovisionamiento",[50349,120289,53048,121422,121597],[],{"_3572":72944,"_30844":72943,"_21377":122317,"_5":14632,"_28040":72943,"_3027":122318},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3572":72945,"_30844":72943,"_5":31199,"_21377":122320,"_28040":122321,"_3027":122322},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3572":72946,"_30844":72943,"_5":31199,"_21377":122324,"_28040":122325,"_3027":122326},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3572":72947,"_30844":72943,"_5":31199,"_21377":122328,"_28040":122329,"_3027":122330},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3572":72948,"_30844":72943,"_5":31199,"_21377":122332,"_28040":122333,"_3027":122334},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3572":72949,"_30844":72943,"_5":31199,"_21377":122336,"_28040":122337,"_3027":122338},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3572":72950,"_30844":72943,"_21377":122340,"_5":14632,"_28040":72943,"_3027":122341},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3572":72951,"_30844":72943,"_21377":122343,"_5":14632,"_28040":122321,"_3027":122344},[],"Recorrido",{"_3572":72952,"_30844":72943,"_21377":122346,"_5":14632,"_28040":122321,"_3027":122347},[],"Cuándo existe el dispositivo",{"_3572":72953,"_30844":72943,"_21377":122349,"_5":14632,"_28040":122321,"_3027":122350},[],"Qué compruebas",{"_3572":72954,"_30844":72943,"_21377":122352,"_5":14632,"_28040":122321,"_3027":122353},[],"Asignación manual",{"_3572":72955,"_30844":72943,"_21377":122355,"_5":14632,"_28040":122321,"_3027":122356},[],"El operador lo crea antes de asociar un certificado.",{"_3572":72956,"_30844":72943,"_21377":122358,"_5":14632,"_28040":122321,"_3027":122359},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3572":72957,"_30844":72943,"_21377":122361,"_5":14632,"_28040":122321,"_3027":122362},[],"EST con `JITP`",{"_3572":72958,"_30844":72943,"_21377":122364,"_5":14632,"_28040":122321,"_3027":122365},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3572":72959,"_30844":72943,"_21377":122367,"_5":14632,"_28040":122321,"_3027":122368},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3572":72960,"_30844":72943,"_21377":122370,"_5":14632,"_28040":122321,"_3027":122371},[],"EST con `PRE_REGISTRATION`",{"_3572":72961,"_30844":72943,"_21377":122373,"_5":14632,"_28040":122321,"_3027":122374},[],"Debe existir antes de `/simpleenroll`.",{"_3572":72962,"_30844":72943,"_21377":122376,"_5":14632,"_28040":122321,"_3027":122377},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3572":72963,"_30844":72943,"_21377":122379,"_5":14632,"_28040":122321,"_3027":122380},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3572":72964,"_30844":72943,"_21377":122382,"_5":14632,"_28040":122321,"_3027":122383},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3572":72965,"_30844":72943,"_21377":122385,"_5":14632,"_28040":122325,"_3027":122386},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3572":72966,"_30844":72943,"_21377":122388,"_5":14632,"_28040":122325,"_3027":122389},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3572":72967,"_30844":72943,"_21377":122391,"_5":14632,"_28040":122325,"_3027":122392},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3572":72968,"_30844":72943,"_21377":122394,"_5":14632,"_28040":122329,"_3027":122395},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3572":72969,"_30844":72943,"_21377":122397,"_5":14632,"_28040":122329,"_3027":122398},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3572":72970,"_30844":72943,"_21377":122400,"_5":14632,"_28040":122329,"_3027":122401},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3572":72971,"_30844":72943,"_21377":122403,"_5":14632,"_28040":122329,"_3027":122404},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3572":72972,"_30844":72943,"_21377":122406,"_5":14632,"_28040":122329,"_3027":122407},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3572":72973,"_30844":72943,"_21377":122409,"_5":14632,"_28040":122329,"_3027":122410},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3572":72974,"_30844":72943,"_21377":122412,"_5":14632,"_28040":122333,"_3027":119166},[],{"_3572":72975,"_30844":72943,"_21377":122414,"_5":14632,"_28040":122333,"_3027":122415},[],"Material que atraviesa EST",{"_3572":72976,"_30844":72943,"_21377":122417,"_5":14632,"_28040":122333,"_3027":122418},[],"Clave generada por el dispositivo",{"_3572":72977,"_30844":72943,"_21377":122420,"_5":14632,"_28040":122333,"_3027":122421},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3572":72978,"_30844":72943,"_21377":122423,"_5":14632,"_28040":122333,"_3027":122424},[],"Clave ya disponible en el dispositivo",{"_3572":72979,"_30844":72943,"_21377":122426,"_5":14632,"_28040":122333,"_3027":122427},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3572":72980,"_30844":72943,"_21377":122429,"_5":14632,"_28040":122333,"_3027":53367},[],{"_3572":72981,"_30844":72943,"_21377":122431,"_5":14632,"_28040":122333,"_3027":122432},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3572":72982,"_30844":72943,"_21377":122434,"_5":14632,"_28040":122333,"_3027":122435},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3572":72983,"_30844":72943,"_21377":122437,"_5":14632,"_28040":122337,"_3027":122438},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3572":72984,"_30844":72984,"_5":14996,"_3027":122440,"_31202":122441,"_21377":122442,"_28040":72984},"Renovación y recuperación",[50349,120289,53048,121422,121597],[],{"_3572":72985,"_30844":72984,"_21377":122444,"_5":14632,"_28040":72984,"_3027":122445},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3572":72986,"_30844":72984,"_5":31199,"_21377":122447,"_28040":122448,"_3027":122449},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3572":72987,"_30844":72984,"_5":31199,"_21377":122451,"_28040":122452,"_3027":122453},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3572":72988,"_30844":72984,"_5":31199,"_21377":122455,"_28040":122456,"_3027":122457},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3572":72989,"_30844":72984,"_5":31199,"_21377":122459,"_28040":122460,"_3027":122461},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3572":72990,"_30844":72984,"_5":31199,"_21377":122463,"_28040":122464,"_3027":122465},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3572":72991,"_30844":72984,"_21377":122467,"_5":14632,"_28040":72984,"_3027":122468},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3572":72992,"_30844":72984,"_21377":122470,"_5":14632,"_28040":122448,"_3027":122471},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3572":72993,"_30844":72984,"_21377":122473,"_5":14632,"_28040":122448,"_3027":122474},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3572":72994,"_30844":72984,"_21377":122476,"_5":14632,"_28040":122448,"_3027":122477},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3572":72995,"_30844":72984,"_21377":122479,"_5":14632,"_28040":122448,"_3027":122480},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3572":72996,"_30844":72984,"_21377":122482,"_5":14632,"_28040":122452,"_3027":122483},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3572":72997,"_30844":72984,"_21377":122485,"_5":14632,"_28040":122452,"_3027":122486},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3572":72998,"_30844":72984,"_21377":122488,"_5":14632,"_28040":122456,"_3027":122489},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3572":72999,"_30844":72984,"_21377":122491,"_5":14632,"_28040":122456,"_3027":122492},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3572":73000,"_30844":72984,"_21377":122494,"_5":14632,"_28040":122456,"_3027":122495},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3572":73001,"_30844":72984,"_21377":122497,"_5":14632,"_28040":122460,"_3027":122498},[],"Situación",{"_3572":73002,"_30844":72984,"_21377":122500,"_5":14632,"_28040":122460,"_3027":122501},[],"Procedimiento",{"_3572":73003,"_30844":72984,"_21377":122503,"_5":14632,"_28040":122460,"_3027":122504},[],"Certificado vigente, fuera de ventana",{"_3572":73004,"_30844":72984,"_21377":122506,"_5":14632,"_28040":122460,"_3027":122507},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3572":73005,"_30844":72984,"_21377":122509,"_5":14632,"_28040":122460,"_3027":122510},[],"Certificado vencido, clave disponible",{"_3572":73006,"_30844":72984,"_21377":122512,"_5":14632,"_28040":122460,"_3027":122513},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3572":73007,"_30844":72984,"_21377":122515,"_5":14632,"_28040":122460,"_3027":122516},[],"Renovación por webhook o `NO_AUTH`",{"_3572":73008,"_30844":72984,"_21377":122518,"_5":14632,"_28040":122460,"_3027":122519},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3572":73009,"_30844":72984,"_21377":122521,"_5":14632,"_28040":122460,"_3027":122522},[],"Clave perdida o inaccesible",{"_3572":73010,"_30844":72984,"_21377":122524,"_5":14632,"_28040":122460,"_3027":122525},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3572":73011,"_30844":72984,"_21377":122527,"_5":14632,"_28040":122460,"_3027":122528},[],"Identidad actual revocada",{"_3572":73012,"_30844":72984,"_21377":122530,"_5":14632,"_28040":122460,"_3027":122531},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3572":73013,"_30844":72984,"_21377":122533,"_5":14632,"_28040":122460,"_3027":122534},[],"Dispositivo sin identidad",{"_3572":73014,"_30844":72984,"_21377":122536,"_5":14632,"_28040":122460,"_3027":122537},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3572":73015,"_30844":72984,"_21377":122539,"_5":14632,"_28040":122460,"_3027":122540},[],"Dispositivo retirado",{"_3572":73016,"_30844":72984,"_21377":122542,"_5":14632,"_28040":122460,"_3027":122543},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3572":73017,"_30844":72984,"_21377":122545,"_5":14632,"_28040":122460,"_3027":122546},[],"Timeout, HTTP 500 o fallo de instalación",{"_3572":73018,"_30844":72984,"_21377":122548,"_5":14632,"_28040":122460,"_3027":122549},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3572":73019,"_30844":72984,"_21377":122551,"_5":14632,"_28040":122464,"_3027":122552},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3572":73020,"_30844":72984,"_21377":122554,"_5":14632,"_28040":122464,"_3027":122555},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3572":73021,"_30844":73021,"_5":14996,"_3027":122557,"_31202":122558,"_21377":122559,"_28040":73021},"Diagnóstico de enrolamiento",[50349,120289,53048,121422,121597],[],{"_3572":73022,"_30844":73021,"_21377":122561,"_5":14632,"_28040":73021,"_3027":122562},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3572":73023,"_30844":73021,"_5":31199,"_21377":122564,"_28040":122565,"_3027":122566},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3572":73024,"_30844":73021,"_5":31199,"_21377":122568,"_28040":122569,"_3027":122570},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3572":73025,"_30844":73021,"_5":31199,"_21377":122572,"_28040":122573,"_3027":122129},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3572":73026,"_30844":73021,"_5":31199,"_21377":122575,"_28040":122576,"_3027":122577},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3572":73027,"_30844":73021,"_21377":122579,"_5":14632,"_28040":73021,"_3027":122580},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3572":73028,"_30844":73021,"_21377":122582,"_5":14632,"_28040":122569,"_3027":122583},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3572":73029,"_30844":73021,"_21377":122585,"_5":14632,"_28040":122569,"_3027":122586},[],"Síntoma o mensaje",{"_3572":73030,"_30844":73021,"_21377":122588,"_5":14632,"_28040":122569,"_3027":122589},[],"Qué revisar",{"_3572":73031,"_30844":73021,"_21377":122591,"_5":14632,"_28040":122569,"_3027":122592},[],"curl rechaza TLS, nombre o emisor",{"_3572":73032,"_30844":73021,"_21377":122594,"_5":14632,"_28040":122569,"_3027":122595},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3572":73033,"_30844":73021,"_21377":122597,"_5":14632,"_28040":122569,"_3027":122598},[],"404 o APS ausente",{"_3572":73034,"_30844":73021,"_21377":122600,"_5":14632,"_28040":122569,"_3027":122601},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3572":73035,"_30844":73021,"_21377":122603,"_5":14632,"_28040":122569,"_3027":122604},[],"400, error de CSR o formato",{"_3572":73036,"_30844":73021,"_21377":122606,"_5":14632,"_28040":122569,"_3027":122607},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3572":73037,"_30844":73021,"_21377":122609,"_5":14632,"_28040":122569,"_3027":122610},[],"Credencial ausente o certificado no válido",{"_3572":73038,"_30844":73021,"_21377":122612,"_5":14632,"_28040":122569,"_3027":122613},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3572":73039,"_30844":73021,"_21377":122615,"_5":14632,"_28040":122569,"_3027":122616},[],"Webhook deniega, expira o responde sin autorización",{"_3572":73040,"_30844":73021,"_21377":122618,"_5":14632,"_28040":122569,"_3027":122619},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3572":73041,"_30844":73021,"_21377":122621,"_5":14632,"_28040":122569,"_3027":54293},[],{"_3572":73042,"_30844":73021,"_21377":122623,"_5":14632,"_28040":122569,"_3027":122624},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3572":73043,"_30844":73021,"_21377":122626,"_5":14632,"_28040":122569,"_3027":54299},[],{"_3572":73044,"_30844":73021,"_21377":122628,"_5":14632,"_28040":122569,"_3027":122629},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3572":73045,"_30844":73021,"_21377":122631,"_5":14632,"_28040":122569,"_3027":54305},[],{"_3572":73046,"_30844":73021,"_21377":122633,"_5":14632,"_28040":122569,"_3027":122634},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3572":73047,"_30844":73021,"_21377":122636,"_5":14632,"_28040":122569,"_3027":54311},[],{"_3572":73048,"_30844":73021,"_21377":122638,"_5":14632,"_28040":122569,"_3027":122639},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3572":73049,"_30844":73021,"_21377":122641,"_5":14632,"_28040":122569,"_3027":54317},[],{"_3572":73050,"_30844":73021,"_21377":122643,"_5":14632,"_28040":122569,"_3027":122644},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3572":73051,"_30844":73021,"_21377":122646,"_5":14632,"_28040":122569,"_3027":122647},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3572":73052,"_30844":73021,"_21377":122649,"_5":14632,"_28040":122569,"_3027":122650},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3572":73053,"_30844":73021,"_21377":122652,"_5":14632,"_28040":122569,"_3027":122653},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3572":73054,"_30844":73021,"_21377":122655,"_5":14632,"_28040":122569,"_3027":122656},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3572":73055,"_30844":73021,"_21377":122658,"_5":14632,"_28040":122569,"_3027":54335},[],{"_3572":73056,"_30844":73021,"_21377":122660,"_5":14632,"_28040":122569,"_3027":122661},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3572":73057,"_30844":73021,"_21377":122663,"_5":14632,"_28040":122569,"_3027":54341},[],{"_3572":73058,"_30844":73021,"_21377":122665,"_5":14632,"_28040":122569,"_3027":122666},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3572":73059,"_30844":73021,"_21377":122668,"_5":14632,"_28040":122569,"_3027":122669},[],"DMS propietario distinto",{"_3572":73060,"_30844":73021,"_21377":122671,"_5":14632,"_28040":122569,"_3027":122672},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3572":73061,"_30844":73021,"_21377":122674,"_5":14632,"_28040":122569,"_3027":54353},[],{"_3572":73062,"_30844":73021,"_21377":122676,"_5":14632,"_28040":122569,"_3027":122677},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3572":73063,"_30844":73021,"_21377":122679,"_5":14632,"_28040":122569,"_3027":54359},[],{"_3572":73064,"_30844":73021,"_21377":122681,"_5":14632,"_28040":122569,"_3027":122682},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3572":73065,"_30844":73021,"_21377":122684,"_5":14632,"_28040":122569,"_3027":122685},[],"Certificado actual revocado",{"_3572":73066,"_30844":73021,"_21377":122687,"_5":14632,"_28040":122569,"_3027":122688},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3572":73067,"_30844":73021,"_21377":122690,"_5":14632,"_28040":122569,"_3027":122691},[],"Error de CA, perfil o firma",{"_3572":73068,"_30844":73021,"_21377":122693,"_5":14632,"_28040":122569,"_3027":122694},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3572":73069,"_30844":73021,"_21377":122696,"_5":14632,"_28040":122569,"_3027":122697},[],"HTTP 200 sin conexión del dispositivo",{"_3572":73070,"_30844":73021,"_21377":122699,"_5":14632,"_28040":122569,"_3027":122700},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3572":73071,"_30844":73021,"_21377":122702,"_5":14632,"_28040":122569,"_3027":122703},[],"Timeout o error después de emitir",{"_3572":73072,"_30844":73021,"_21377":122705,"_5":14632,"_28040":122569,"_3027":122706},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3572":73073,"_30844":73021,"_21377":122708,"_5":14632,"_28040":122573,"_3027":122709},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3572":73074,"_30844":73021,"_21377":122711,"_5":14632,"_28040":122573,"_3027":122712},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3572":73075,"_30844":73021,"_21377":122714,"_5":14632,"_28040":122576,"_3027":122715},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3572":73076,"_30844":73021,"_21377":122717,"_5":14632,"_28040":122576,"_3027":122718},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3572":73077,"_30844":73021,"_21377":122720,"_5":14632,"_28040":122576,"_3027":122721},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3572":73078,"_30844":73021,"_21377":122723,"_5":14632,"_28040":122576,"_3027":122724},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3572":73079,"_30844":73021,"_21377":122726,"_5":14632,"_28040":122576,"_3027":122727},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3572":73080,"_30844":73021,"_21377":122729,"_5":14632,"_28040":122576,"_3027":122730},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3572":73081,"_30844":73021,"_21377":122732,"_5":14632,"_28040":122576,"_3027":122733},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3572":73082,"_30844":73082,"_5":14996,"_3027":122735,"_31202":122736,"_21377":122737,"_28040":73082},"Distribución y actualización de confianza",[50349,120289,53048,121422,121597],[],{"_3572":73083,"_30844":73082,"_21377":122739,"_5":14632,"_28040":73082,"_3027":122740},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3572":73084,"_30844":73082,"_5":31199,"_21377":122742,"_28040":122743,"_3027":122744},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3572":73085,"_30844":73082,"_5":31199,"_21377":122746,"_28040":122747,"_3027":122748},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3572":73086,"_30844":73082,"_5":31199,"_21377":122750,"_28040":122751,"_3027":122752},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3572":73087,"_30844":73082,"_5":31199,"_21377":122754,"_28040":122755,"_3027":122756},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3572":73088,"_30844":73082,"_5":31199,"_21377":122758,"_28040":122759,"_3027":122760},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3572":73089,"_30844":73082,"_21377":122762,"_5":14632,"_28040":73082,"_3027":122763},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3572":73090,"_30844":73082,"_21377":122765,"_5":14632,"_28040":122743,"_3027":122766},[],"Relación",{"_3572":73091,"_30844":73082,"_21377":122768,"_5":14632,"_28040":122743,"_3027":122769},[],"Material que prepara el responsable",{"_3572":73092,"_30844":73082,"_21377":122771,"_5":14632,"_28040":122743,"_3027":122772},[],"Dispositivo → servidor EST",{"_3572":73093,"_30844":73082,"_21377":122774,"_5":14632,"_28040":122743,"_3027":122775},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3572":73094,"_30844":73082,"_21377":122777,"_5":14632,"_28040":122743,"_3027":122778},[],"DMS → solicitante",{"_3572":73095,"_30844":73082,"_21377":122780,"_5":14632,"_28040":122743,"_3027":122781},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3572":73096,"_30844":73082,"_21377":122783,"_5":14632,"_28040":122743,"_3027":122784},[],"Consumidor → dispositivo",{"_3572":73097,"_30844":73082,"_21377":122786,"_5":14632,"_28040":122743,"_3027":122787},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3572":73098,"_30844":73082,"_21377":122789,"_5":14632,"_28040":122743,"_3027":122790},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3572":73099,"_30844":73082,"_21377":122792,"_5":14632,"_28040":122747,"_3027":122793},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3572":73100,"_30844":73082,"_21377":122795,"_5":14632,"_28040":122747,"_3027":122796},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3572":73101,"_30844":73082,"_21377":122798,"_5":14632,"_28040":122751,"_3027":122799},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3572":73102,"_30844":73082,"_21377":122801,"_5":14632,"_28040":122751,"_3027":122802},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3572":73103,"_30844":73082,"_21377":122804,"_5":14632,"_28040":122751,"_3027":122805},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3572":73104,"_30844":73082,"_21377":122807,"_5":14632,"_28040":122751,"_3027":122808},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3572":73105,"_30844":73082,"_21377":122810,"_5":14632,"_28040":122751,"_3027":122811},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3572":73106,"_30844":73082,"_21377":122813,"_5":14632,"_28040":122751,"_3027":122814},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3572":73107,"_30844":73082,"_21377":122816,"_5":14632,"_28040":122755,"_3027":122817},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3572":73108,"_30844":73082,"_21377":122819,"_5":14632,"_28040":122755,"_3027":122820},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3572":73109,"_30844":73082,"_21377":122822,"_5":14632,"_28040":122755,"_3027":122823},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3572":73110,"_30844":73082,"_21377":122825,"_5":14632,"_28040":122759,"_3027":122826},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3572":73111,"_30844":73111,"_5":14996,"_3027":54508,"_31202":122828,"_21377":122830,"_28040":73111},[50349,120289,53048,121422,122829],"Integraciones",[],{"_3572":73112,"_30844":73111,"_21377":122832,"_5":14632,"_28040":73111,"_3027":122833},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3572":73113,"_30844":73111,"_5":31199,"_21377":122835,"_28040":122836,"_3027":122837},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3572":73114,"_30844":73111,"_5":31199,"_21377":122839,"_28040":122840,"_3027":122841},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3572":73115,"_30844":73111,"_5":31199,"_21377":122843,"_28040":122844,"_3027":122845},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3572":73116,"_30844":73111,"_5":31199,"_21377":122847,"_28040":122848,"_3027":122849},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3572":73117,"_30844":73111,"_5":31199,"_21377":122851,"_28040":122852,"_3027":122853},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3572":73118,"_30844":73111,"_5":31199,"_21377":122855,"_28040":122856,"_3027":122857},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3572":73119,"_30844":73111,"_5":31199,"_21377":122859,"_28040":122860,"_3027":122861},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3572":73120,"_30844":73111,"_5":31199,"_21377":122863,"_28040":122864,"_3027":122865},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3572":73121,"_30844":73111,"_5":31199,"_21377":122867,"_28040":122868,"_3027":54550},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3572":73122,"_30844":73111,"_5":31199,"_21377":122870,"_28040":122871,"_3027":54554},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3572":73123,"_30844":73111,"_5":31199,"_21377":122873,"_28040":122874,"_3027":122875},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3572":73124,"_30844":73111,"_5":31199,"_21377":122877,"_28040":122878,"_3027":122879},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3572":73125,"_30844":73111,"_5":31199,"_21377":122881,"_28040":122882,"_3027":122883},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3572":73126,"_30844":73111,"_5":31199,"_21377":122885,"_28040":122886,"_3027":122887},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3572":73127,"_30844":73111,"_5":31199,"_21377":122889,"_28040":122890,"_3027":122891},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3572":73128,"_30844":73111,"_5":31199,"_21377":122893,"_28040":122894,"_3027":122895},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3572":73129,"_30844":73111,"_5":31199,"_21377":122897,"_28040":122898,"_3027":122899},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3572":73130,"_30844":73111,"_5":31199,"_21377":122901,"_28040":122902,"_3027":122903},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3572":73131,"_30844":73111,"_5":31199,"_21377":122905,"_28040":122906,"_3027":122907},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3572":73132,"_30844":73111,"_5":31199,"_21377":122909,"_28040":122910,"_3027":122911},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3572":73133,"_30844":73111,"_5":31199,"_21377":122913,"_28040":122914,"_3027":122915},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3572":73134,"_30844":73111,"_5":31199,"_21377":122917,"_28040":122918,"_3027":122919},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3572":73135,"_30844":73111,"_5":31199,"_21377":122921,"_28040":122922,"_3027":122923},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3572":73136,"_30844":73111,"_5":31199,"_21377":122925,"_28040":122926,"_3027":122927},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3572":73137,"_30844":73111,"_5":31199,"_21377":122929,"_28040":122930,"_3027":122931},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3572":73138,"_30844":73111,"_21377":122933,"_5":14632,"_28040":73111,"_3027":122934},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3572":73139,"_30844":73111,"_21377":122936,"_5":14632,"_28040":73111,"_3027":122937},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3572":73140,"_30844":73111,"_21377":122939,"_5":14632,"_28040":73111,"_3027":122940},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3572":73141,"_30844":73111,"_21377":122942,"_5":14632,"_28040":122836,"_3027":122943},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3572":73142,"_30844":73111,"_21377":122945,"_5":14632,"_28040":122836,"_3027":122946},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3572":73143,"_30844":73111,"_21377":122948,"_5":14632,"_28040":122836,"_3027":122949},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3572":73144,"_30844":73111,"_21377":122951,"_5":14632,"_28040":122836,"_3027":122952},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3572":73145,"_30844":73111,"_21377":122954,"_5":14632,"_28040":122840,"_3027":122955},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3572":73146,"_30844":73111,"_21377":122957,"_5":14632,"_28040":122844,"_3027":122958},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3572":73147,"_30844":73111,"_21377":122960,"_5":14632,"_28040":122844,"_3027":122961},[],"Acción IAM",{"_3572":73148,"_30844":73111,"_21377":122963,"_5":14632,"_28040":122844,"_3027":119172},[],{"_3572":73149,"_30844":73111,"_21377":122965,"_5":14632,"_28040":122844,"_3027":54649},[],{"_3572":73150,"_30844":73111,"_21377":122967,"_5":14632,"_28040":122844,"_3027":122968},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3572":73151,"_30844":73111,"_21377":122970,"_5":14632,"_28040":122844,"_3027":54655},[],{"_3572":73152,"_30844":73111,"_21377":122972,"_5":14632,"_28040":122844,"_3027":122973},[],"Registrar la CA en AWS IoT",{"_3572":73153,"_30844":73111,"_21377":122975,"_5":14632,"_28040":122844,"_3027":54661},[],{"_3572":73154,"_30844":73111,"_21377":122977,"_5":14632,"_28040":122844,"_3027":122978},[],"Consultar el estado del registro de la CA",{"_3572":73155,"_30844":73111,"_21377":122980,"_5":14632,"_28040":122844,"_3027":54667},[],{"_3572":73156,"_30844":73111,"_21377":122982,"_5":14632,"_28040":122844,"_3027":122983},[],"Crear o actualizar Things en IoT Core",{"_3572":73157,"_30844":73111,"_21377":122985,"_5":14632,"_28040":122844,"_3027":54673},[],{"_3572":73158,"_30844":73111,"_21377":122987,"_5":14632,"_28040":122844,"_3027":122988},[],"Aprovisionar Things mediante plantilla",{"_3572":73159,"_30844":73111,"_21377":122990,"_5":14632,"_28040":122844,"_3027":54679},[],{"_3572":73160,"_30844":73111,"_21377":122992,"_5":14632,"_28040":122844,"_3027":122993},[],"Registrar certificados de dispositivo",{"_3572":73161,"_30844":73111,"_21377":122995,"_5":14632,"_28040":122844,"_3027":54685},[],{"_3572":73162,"_30844":73111,"_21377":122997,"_5":14632,"_28040":122844,"_3027":122998},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3572":73163,"_30844":73111,"_21377":123000,"_5":14632,"_28040":122844,"_3027":54691},[],{"_3572":73164,"_30844":73111,"_21377":123002,"_5":14632,"_28040":122844,"_3027":123003},[],"Crear y adjuntar políticas IoT",{"_3572":73165,"_30844":73111,"_21377":123005,"_5":14632,"_28040":122844,"_3027":54697},[],{"_3572":73166,"_30844":73111,"_21377":123007,"_5":14632,"_28040":122844,"_3027":123008},[],"Gestionar grupos de Things",{"_3572":73167,"_30844":73111,"_21377":123010,"_5":14632,"_28040":122844,"_3027":54703},[],{"_3572":73168,"_30844":73111,"_21377":123012,"_5":14632,"_28040":122844,"_3027":123013},[],"Crear plantillas JITP",{"_3572":73169,"_30844":73111,"_21377":123015,"_5":14632,"_28040":122844,"_3027":54709},[],{"_3572":73170,"_30844":73111,"_21377":123017,"_5":14632,"_28040":122844,"_3027":123018},[],"Leer y escribir el Device Shadow",{"_3572":73171,"_30844":73111,"_21377":123020,"_5":14632,"_28040":122844,"_3027":123021},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3572":73172,"_30844":73111,"_21377":123023,"_5":14632,"_28040":122848,"_3027":123024},[],"Parámetro",{"_3572":73173,"_30844":73111,"_21377":123026,"_5":14632,"_28040":122848,"_3027":123027},[],"Tipo",{"_3572":73174,"_30844":73111,"_21377":123029,"_5":14632,"_28040":122848,"_3027":123030},[],"Requerido",{"_3572":73175,"_30844":73111,"_21377":123032,"_5":14632,"_28040":122848,"_3027":123033},[],"Descripción",{"_3572":73176,"_30844":73111,"_21377":123035,"_5":14632,"_28040":122848,"_3027":54730},[],{"_3572":73177,"_30844":73111,"_21377":123037,"_5":14632,"_28040":122848,"_3027":25498},[],{"_3572":73178,"_30844":73111,"_21377":123039,"_5":14632,"_28040":122848,"_3027":123040},[],"Sí",{"_3572":73179,"_30844":73111,"_21377":123042,"_5":14632,"_28040":122848,"_3027":123043},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3572":73180,"_30844":73111,"_21377":123045,"_5":14632,"_28040":122848,"_3027":54741},[],{"_3572":73181,"_30844":73111,"_21377":123047,"_5":14632,"_28040":122848,"_3027":25498},[],{"_3572":73182,"_30844":73111,"_21377":123049,"_5":14632,"_28040":122848,"_3027":123040},[],{"_3572":73183,"_30844":73111,"_21377":123051,"_5":14632,"_28040":122848,"_3027":123052},[],"Región AWS donde opera el conector.",{"_3572":73184,"_30844":73111,"_21377":123054,"_5":14632,"_28040":122848,"_3027":54751},[],{"_3572":73185,"_30844":73111,"_21377":123056,"_5":14632,"_28040":122848,"_3027":25498},[],{"_3572":73186,"_30844":73111,"_21377":123058,"_5":14632,"_28040":122848,"_3027":123040},[],{"_3572":73187,"_30844":73111,"_21377":123060,"_5":14632,"_28040":122848,"_3027":123061},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3572":73188,"_30844":73111,"_21377":123063,"_5":14632,"_28040":122848,"_3027":54761},[],{"_3572":73189,"_30844":73111,"_21377":123065,"_5":14632,"_28040":122848,"_3027":25498},[],{"_3572":73190,"_30844":73111,"_21377":123067,"_5":14632,"_28040":122848,"_3027":123068},[],"Solo con `auth_method=static`",{"_3572":73191,"_30844":73111,"_21377":123070,"_5":14632,"_28040":122848,"_3027":123071},[],"Clave de acceso AWS.",{"_3572":73192,"_30844":73111,"_21377":123073,"_5":14632,"_28040":122848,"_3027":54772},[],{"_3572":73193,"_30844":73111,"_21377":123075,"_5":14632,"_28040":122848,"_3027":25498},[],{"_3572":73194,"_30844":73111,"_21377":123077,"_5":14632,"_28040":122848,"_3027":123068},[],{"_3572":73195,"_30844":73111,"_21377":123079,"_5":14632,"_28040":122848,"_3027":123080},[],"Clave secreta AWS.",{"_3572":73196,"_30844":73111,"_21377":123082,"_5":14632,"_28040":122848,"_3027":54782},[],{"_3572":73197,"_30844":73111,"_21377":123084,"_5":14632,"_28040":122848,"_3027":25498},[],{"_3572":73198,"_30844":73111,"_21377":123086,"_5":14632,"_28040":122848,"_3027":54787},[],{"_3572":73199,"_30844":73111,"_21377":123088,"_5":14632,"_28040":122848,"_3027":123089},[],"Token de sesión (con `auth_method=static`).",{"_3572":73200,"_30844":73111,"_21377":123091,"_5":14632,"_28040":122848,"_3027":54793},[],{"_3572":73201,"_30844":73111,"_21377":123093,"_5":14632,"_28040":122848,"_3027":25498},[],{"_3572":73202,"_30844":73111,"_21377":123095,"_5":14632,"_28040":122848,"_3027":123096},[],"Solo con `auth_method=role`",{"_3572":73203,"_30844":73111,"_21377":123098,"_5":14632,"_28040":122848,"_3027":123099},[],"ARN del rol a asumir.",{"_3572":73204,"_30844":73111,"_21377":123101,"_5":14632,"_28040":122848,"_3027":54804},[],{"_3572":73205,"_30844":73111,"_21377":123103,"_5":14632,"_28040":122848,"_3027":25498},[],{"_3572":73206,"_30844":73111,"_21377":123105,"_5":14632,"_28040":122848,"_3027":54787},[],{"_3572":73207,"_30844":73111,"_21377":123107,"_5":14632,"_28040":122848,"_3027":123108},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3572":73208,"_30844":73111,"_21377":123110,"_5":14632,"_28040":122848,"_3027":54814},[],{"_3572":73209,"_30844":73111,"_21377":123112,"_5":14632,"_28040":122848,"_3027":91747},[],{"_3572":73210,"_30844":73111,"_21377":123114,"_5":14632,"_28040":122848,"_3027":123040},[],{"_3572":73211,"_30844":73111,"_21377":123116,"_5":14632,"_28040":122848,"_3027":123117},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3572":73212,"_30844":73111,"_21377":123119,"_5":14632,"_28040":122848,"_3027":54824},[],{"_3572":73213,"_30844":73111,"_21377":123121,"_5":14632,"_28040":122848,"_3027":25498},[],{"_3572":73214,"_30844":73111,"_21377":123123,"_5":14632,"_28040":122848,"_3027":123040},[],{"_3572":73215,"_30844":73111,"_21377":123125,"_5":14632,"_28040":122848,"_3027":123126},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3572":73216,"_30844":73111,"_21377":123128,"_5":14632,"_28040":122848,"_3027":54834},[],{"_3572":73217,"_30844":73111,"_21377":123130,"_5":14632,"_28040":122848,"_3027":25498},[],{"_3572":73218,"_30844":73111,"_21377":123132,"_5":14632,"_28040":122848,"_3027":123040},[],{"_3572":73219,"_30844":73111,"_21377":123134,"_5":14632,"_28040":122848,"_3027":123135},[],"URL HTTP del Device Manager de Lamassu.",{"_3572":73220,"_30844":73111,"_21377":123137,"_5":14632,"_28040":122848,"_3027":54844},[],{"_3572":73221,"_30844":73111,"_21377":123139,"_5":14632,"_28040":122848,"_3027":25498},[],{"_3572":73222,"_30844":73111,"_21377":123141,"_5":14632,"_28040":122848,"_3027":123040},[],{"_3572":73223,"_30844":73111,"_21377":123143,"_5":14632,"_28040":122848,"_3027":123144},[],"URL HTTP del servicio de CA de Lamassu.",{"_3572":73224,"_30844":73111,"_21377":123146,"_5":14632,"_28040":122852,"_3027":123147},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3572":73225,"_30844":73111,"_21377":123149,"_5":14632,"_28040":122852,"_3027":123150},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3572":73226,"_30844":73111,"_21377":123152,"_5":14632,"_28040":122852,"_3027":123153},[],"Tipo de CloudEvent",{"_3572":73227,"_30844":73111,"_21377":123155,"_5":14632,"_28040":122852,"_3027":123156},[],"Recurso en Lamassu",{"_3572":73228,"_30844":73111,"_21377":123158,"_5":14632,"_28040":122852,"_3027":123159},[],"Recurso AWS",{"_3572":73229,"_30844":73111,"_21377":123161,"_5":14632,"_28040":122852,"_3027":123162},[],"Acciones IAM",{"_3572":73230,"_30844":73111,"_21377":123164,"_5":14632,"_28040":122852,"_3027":123165},[],"Llamadas AWS y efecto",{"_3572":73231,"_30844":73111,"_21377":123167,"_5":14632,"_28040":122852,"_3027":123168},[],"Dónde en esta página",{"_3572":73232,"_30844":73111,"_21377":123170,"_5":14632,"_28040":122852,"_3027":54878},[],{"_3572":73233,"_30844":73111,"_21377":123172,"_5":14632,"_28040":122852,"_3027":54881},[],{"_3572":73234,"_30844":73111,"_21377":123174,"_5":14632,"_28040":122852,"_3027":54884},[],{"_3572":73235,"_30844":73111,"_21377":123176,"_5":14632,"_28040":122852,"_3027":54887},[],{"_3572":73236,"_30844":73111,"_21377":123178,"_5":14632,"_28040":122852,"_3027":123179},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3572":73237,"_30844":73111,"_21377":123181,"_5":14632,"_28040":122852,"_3027":122865},[],{"_3572":73238,"_30844":73111,"_21377":123183,"_5":14632,"_28040":122852,"_3027":54895},[],{"_3572":73239,"_30844":73111,"_21377":123185,"_5":14632,"_28040":122852,"_3027":54898},[],{"_3572":73240,"_30844":73111,"_21377":123187,"_5":14632,"_28040":122852,"_3027":54901},[],{"_3572":73241,"_30844":73111,"_21377":123189,"_5":14632,"_28040":122852,"_3027":54904},[],{"_3572":73242,"_30844":73111,"_21377":123191,"_5":14632,"_28040":122852,"_3027":123192},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3572":73243,"_30844":73111,"_21377":123194,"_5":14632,"_28040":122852,"_3027":122891},[],{"_3572":73244,"_30844":73111,"_21377":123196,"_5":14632,"_28040":122852,"_3027":54912},[],{"_3572":73245,"_30844":73111,"_21377":123198,"_5":14632,"_28040":122852,"_3027":123199},[],"Dispositivo",{"_3572":73246,"_30844":73111,"_21377":123201,"_5":14632,"_28040":122852,"_3027":54918},[],{"_3572":73247,"_30844":73111,"_21377":123203,"_5":14632,"_28040":122852,"_3027":54921},[],{"_3572":73248,"_30844":73111,"_21377":123205,"_5":14632,"_28040":122852,"_3027":123206},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3572":73249,"_30844":73111,"_21377":123208,"_5":14632,"_28040":122852,"_3027":122899},[],{"_3572":73250,"_30844":73111,"_21377":123210,"_5":14632,"_28040":122852,"_3027":54929},[],{"_3572":73251,"_30844":73111,"_21377":123212,"_5":14632,"_28040":122852,"_3027":123213},[],"Certificado",{"_3572":73252,"_30844":73111,"_21377":123215,"_5":14632,"_28040":122852,"_3027":54935},[],{"_3572":73253,"_30844":73111,"_21377":123217,"_5":14632,"_28040":122852,"_3027":123218},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3572":73254,"_30844":73111,"_21377":123220,"_5":14632,"_28040":122852,"_3027":123221},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3572":73255,"_30844":73111,"_21377":123223,"_5":14632,"_28040":122852,"_3027":122911},[],{"_3572":73256,"_30844":73111,"_21377":123225,"_5":14632,"_28040":122852,"_3027":54946},[],{"_3572":73257,"_30844":73111,"_21377":123227,"_5":14632,"_28040":122852,"_3027":123228},[],"Certificado / Dispositivo",{"_3572":73258,"_30844":73111,"_21377":123230,"_5":14632,"_28040":122852,"_3027":54952},[],{"_3572":73259,"_30844":73111,"_21377":123232,"_5":14632,"_28040":122852,"_3027":50745},[],{"_3572":73260,"_30844":73111,"_21377":123234,"_5":14632,"_28040":122852,"_3027":123235},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3572":73261,"_30844":73111,"_21377":123237,"_5":14632,"_28040":122852,"_3027":122919},[],{"_3572":73262,"_30844":73111,"_21377":123239,"_5":14632,"_28040":122856,"_3027":123240},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3572":73263,"_30844":73111,"_21377":123242,"_5":14632,"_28040":122860,"_3027":123243},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3572":73264,"_30844":73111,"_21377":123245,"_5":14632,"_28040":122860,"_3027":123246},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3572":73265,"_30844":73111,"_21377":123248,"_5":14632,"_28040":122864,"_3027":123249},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3572":73266,"_30844":73111,"_21377":123251,"_5":14632,"_28040":122864,"_3027":123252},[],"Transición",{"_3572":73267,"_30844":73111,"_21377":123254,"_5":14632,"_28040":122864,"_3027":123255},[],"Llamadas AWS",{"_3572":73268,"_30844":73111,"_21377":123257,"_5":14632,"_28040":122864,"_3027":123258},[],"`NoRegistrada` → `Solicitada`",{"_3572":73269,"_30844":73111,"_21377":123260,"_5":14632,"_28040":122864,"_3027":123261},[],"ninguna (solo escritura de metadatos)",{"_3572":73270,"_30844":73111,"_21377":123263,"_5":14632,"_28040":122864,"_3027":123264},[],"`Solicitada` → `Registrando`",{"_3572":73271,"_30844":73111,"_21377":123266,"_5":14632,"_28040":122864,"_3027":123267},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3572":73272,"_30844":73111,"_21377":123269,"_5":14632,"_28040":122864,"_3027":123270},[],"`Registrando` → `Completada`",{"_3572":73273,"_30844":73111,"_21377":123272,"_5":14632,"_28040":122864,"_3027":123273},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3572":73274,"_30844":73111,"_21377":123275,"_5":14632,"_28040":122864,"_3027":123276},[],"`Registrando` → `Fallida`",{"_3572":73275,"_30844":73111,"_21377":123278,"_5":14632,"_28040":122864,"_3027":123279},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3572":73276,"_30844":73111,"_21377":123281,"_5":14632,"_28040":122864,"_3027":123282},[],"`Fallida` / `Completada` → `Solicitada`",{"_3572":73277,"_30844":73111,"_21377":123284,"_5":14632,"_28040":122864,"_3027":123285},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3572":73278,"_30844":73111,"_21377":123287,"_5":14632,"_28040":122868,"_3027":123288},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3572":73279,"_30844":73111,"_21377":123290,"_5":14632,"_28040":122868,"_3027":123291},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3572":73280,"_30844":73111,"_21377":123293,"_5":14632,"_28040":122868,"_3027":123294},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3572":73281,"_30844":73111,"_21377":123296,"_5":14632,"_28040":122868,"_3027":123297},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3572":73282,"_30844":73111,"_21377":123299,"_5":14632,"_28040":122868,"_3027":123300},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3572":73283,"_30844":73111,"_21377":123302,"_5":14632,"_28040":122868,"_3027":123303},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3572":73284,"_30844":73111,"_21377":123305,"_5":14632,"_28040":122871,"_3027":123306},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3572":73285,"_30844":73111,"_21377":123308,"_5":14632,"_28040":122874,"_3027":123309},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3572":73286,"_30844":73111,"_21377":123311,"_5":14632,"_28040":122874,"_3027":123312},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3572":73287,"_30844":73111,"_21377":123314,"_5":14632,"_28040":122878,"_3027":123315},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3572":73288,"_30844":73111,"_21377":123317,"_5":14632,"_28040":122882,"_3027":123318},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3572":73289,"_30844":73111,"_21377":123320,"_5":14632,"_28040":122882,"_3027":123321},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3572":73290,"_30844":73111,"_21377":123323,"_5":14632,"_28040":122882,"_3027":123324},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3572":73291,"_30844":73111,"_21377":123326,"_5":14632,"_28040":122882,"_3027":123327},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3572":73292,"_30844":73111,"_21377":123329,"_5":14632,"_28040":122882,"_3027":123330},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3572":73293,"_30844":73111,"_21377":123332,"_5":14632,"_28040":122882,"_3027":123333},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3572":73294,"_30844":73111,"_21377":123335,"_5":14632,"_28040":122886,"_3027":123336},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3572":73295,"_30844":73111,"_21377":123338,"_5":14632,"_28040":122886,"_3027":123339},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3572":73296,"_30844":73111,"_21377":123341,"_5":14632,"_28040":122886,"_3027":123342},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3572":73297,"_30844":73111,"_21377":123344,"_5":14632,"_28040":122886,"_3027":123345},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3572":73298,"_30844":73111,"_21377":123347,"_5":14632,"_28040":122886,"_3027":123348},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3572":73299,"_30844":73111,"_21377":123350,"_5":14632,"_28040":122890,"_3027":123351},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3572":73300,"_30844":73111,"_21377":123353,"_5":14632,"_28040":122890,"_3027":123252},[],{"_3572":73301,"_30844":73111,"_21377":123355,"_5":14632,"_28040":122890,"_3027":123255},[],{"_3572":73302,"_30844":73111,"_21377":123357,"_5":14632,"_28040":122890,"_3027":123358},[],"`SinConfigurar` → `None` / `Auto`",{"_3572":73303,"_30844":73111,"_21377":123360,"_5":14632,"_28040":122890,"_3027":123361},[],"ninguna (solo configuración)",{"_3572":73304,"_30844":73111,"_21377":123363,"_5":14632,"_28040":122890,"_3027":55089},[],{"_3572":73305,"_30844":73111,"_21377":123365,"_5":14632,"_28040":122890,"_3027":123361},[],{"_3572":73306,"_30844":73111,"_21377":123367,"_5":14632,"_28040":122890,"_3027":123368},[],"Cualquiera → `Jitp`",{"_3572":73307,"_30844":73111,"_21377":123370,"_5":14632,"_28040":122890,"_3027":123371},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3572":73308,"_30844":73111,"_21377":123373,"_5":14632,"_28040":122890,"_3027":55100},[],{"_3572":73309,"_30844":73111,"_21377":123375,"_5":14632,"_28040":122890,"_3027":123376},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3572":73310,"_30844":73111,"_21377":123378,"_5":14632,"_28040":122894,"_3027":123379},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3572":73311,"_30844":73111,"_21377":123381,"_5":14632,"_28040":122894,"_3027":123382},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3572":73312,"_30844":73111,"_21377":123384,"_5":14632,"_28040":122894,"_3027":123385},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3572":73313,"_30844":73111,"_21377":123387,"_5":14632,"_28040":122898,"_3027":123388},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3572":73314,"_30844":73111,"_21377":123390,"_5":14632,"_28040":122898,"_3027":123252},[],{"_3572":73315,"_30844":73111,"_21377":123392,"_5":14632,"_28040":122898,"_3027":123255},[],{"_3572":73316,"_30844":73111,"_21377":123394,"_5":14632,"_28040":122898,"_3027":123395},[],"`Ausente` → `Aprovisionado`",{"_3572":73317,"_30844":73111,"_21377":123397,"_5":14632,"_28040":122898,"_3027":123398},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3572":73318,"_30844":73111,"_21377":123400,"_5":14632,"_28040":122898,"_3027":123401},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3572":73319,"_30844":73111,"_21377":123403,"_5":14632,"_28040":122898,"_3027":123404},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3572":73320,"_30844":73111,"_21377":123406,"_5":14632,"_28040":122898,"_3027":123407},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3572":73321,"_30844":73111,"_21377":123409,"_5":14632,"_28040":122902,"_3027":123410},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3572":73322,"_30844":73111,"_21377":123412,"_5":14632,"_28040":122902,"_3027":123413},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3572":73323,"_30844":73111,"_21377":123415,"_5":14632,"_28040":122902,"_3027":123416},[],"Para que el flujo JITP funcione correctamente:",{"_3572":73324,"_30844":73111,"_21377":123418,"_5":14632,"_28040":122902,"_3027":123419},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3572":73325,"_30844":73111,"_21377":123421,"_5":14632,"_28040":122902,"_3027":123422},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3572":73326,"_30844":73111,"_21377":123424,"_5":14632,"_28040":122902,"_3027":123425},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3572":73327,"_30844":73111,"_21377":123427,"_5":14632,"_28040":122902,"_3027":123428},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3572":73328,"_30844":73111,"_21377":123430,"_5":14632,"_28040":122906,"_3027":123431},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3572":73329,"_30844":73111,"_21377":123433,"_5":14632,"_28040":122906,"_3027":123434},[],"Estado en Lamassu",{"_3572":73330,"_30844":73111,"_21377":123436,"_5":14632,"_28040":122906,"_3027":123437},[],"Razón de revocación",{"_3572":73331,"_30844":73111,"_21377":123439,"_5":14632,"_28040":122906,"_3027":123440},[],"Estado en AWS IoT Core",{"_3572":73332,"_30844":73111,"_21377":123442,"_5":14632,"_28040":122906,"_3027":55170},[],{"_3572":73333,"_30844":73111,"_21377":123444,"_5":14632,"_28040":122906,"_3027":123445},[],"Ninguna",{"_3572":73334,"_30844":73111,"_21377":123447,"_5":14632,"_28040":122906,"_3027":55176},[],{"_3572":73335,"_30844":73111,"_21377":123449,"_5":14632,"_28040":122906,"_3027":55179},[],{"_3572":73336,"_30844":73111,"_21377":123451,"_5":14632,"_28040":122906,"_3027":55182},[],{"_3572":73337,"_30844":73111,"_21377":123453,"_5":14632,"_28040":122906,"_3027":55185},[],{"_3572":73338,"_30844":73111,"_21377":123455,"_5":14632,"_28040":122906,"_3027":55179},[],{"_3572":73339,"_30844":73111,"_21377":123457,"_5":14632,"_28040":122906,"_3027":123458},[],"Cualquier otra razón",{"_3572":73340,"_30844":73111,"_21377":123460,"_5":14632,"_28040":122906,"_3027":55193},[],{"_3572":73341,"_30844":73111,"_21377":123462,"_5":14632,"_28040":122906,"_3027":123463},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3572":73342,"_30844":73111,"_21377":123465,"_5":14632,"_28040":122910,"_3027":123466},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3572":73343,"_30844":73111,"_21377":123468,"_5":14632,"_28040":122910,"_3027":123252},[],{"_3572":73344,"_30844":73111,"_21377":123470,"_5":14632,"_28040":122910,"_3027":123255},[],{"_3572":73345,"_30844":73111,"_21377":123472,"_5":14632,"_28040":122910,"_3027":123473},[],"`NoSincronizado` → `Active`",{"_3572":73346,"_30844":73111,"_21377":123475,"_5":14632,"_28040":122910,"_3027":54685},[],{"_3572":73347,"_30844":73111,"_21377":123477,"_5":14632,"_28040":122910,"_3027":55211},[],{"_3572":73348,"_30844":73111,"_21377":123479,"_5":14632,"_28040":122910,"_3027":123480},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3572":73349,"_30844":73111,"_21377":123482,"_5":14632,"_28040":122910,"_3027":55217},[],{"_3572":73350,"_30844":73111,"_21377":123484,"_5":14632,"_28040":122910,"_3027":123480},[],{"_3572":73351,"_30844":73111,"_21377":123486,"_5":14632,"_28040":122910,"_3027":55222},[],{"_3572":73352,"_30844":73111,"_21377":123488,"_5":14632,"_28040":122910,"_3027":54685},[],{"_3572":73353,"_30844":73111,"_21377":123490,"_5":14632,"_28040":122910,"_3027":55227},[],{"_3572":73354,"_30844":73111,"_21377":123492,"_5":14632,"_28040":122910,"_3027":123493},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3572":73355,"_30844":73111,"_21377":123495,"_5":14632,"_28040":122914,"_3027":123496},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3572":73356,"_30844":73111,"_21377":123498,"_5":14632,"_28040":122914,"_3027":123499},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3572":73357,"_30844":73111,"_21377":123501,"_5":14632,"_28040":122914,"_3027":123502},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3572":73358,"_30844":73111,"_21377":123504,"_5":14632,"_28040":122918,"_3027":123505},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3572":73359,"_30844":73111,"_21377":123507,"_5":14632,"_28040":122918,"_3027":123508},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3572":73360,"_30844":73111,"_21377":123510,"_5":14632,"_28040":122922,"_3027":123511},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3572":73361,"_30844":73111,"_21377":123513,"_5":14632,"_28040":122922,"_3027":123514},[],"Existen dos tipos de acciones:",{"_3572":73362,"_30844":73111,"_21377":123516,"_5":14632,"_28040":122922,"_3027":123517},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3572":73363,"_30844":73111,"_21377":123519,"_5":14632,"_28040":122922,"_3027":123520},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3572":73364,"_30844":73111,"_21377":123522,"_5":14632,"_28040":122922,"_3027":123523},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3572":73365,"_30844":73111,"_21377":123525,"_5":14632,"_28040":122926,"_3027":123526},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3572":73366,"_30844":73111,"_21377":123528,"_5":14632,"_28040":122926,"_3027":123529},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3572":73367,"_30844":73111,"_21377":123531,"_5":14632,"_28040":122926,"_3027":123532},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3572":73368,"_30844":73111,"_21377":123534,"_5":14632,"_28040":122930,"_3027":123535},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3572":73369,"_30844":73111,"_21377":123537,"_5":14632,"_28040":122930,"_3027":123538},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3572":73370,"_30844":73111,"_21377":123540,"_5":14632,"_28040":122930,"_3027":123541},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3572":73371,"_30844":73111,"_21377":123543,"_5":14632,"_28040":122930,"_3027":123544},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3572":73372,"_30844":73111,"_21377":123546,"_5":14632,"_28040":122930,"_3027":123547},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3572":73373,"_30844":73111,"_21377":123549,"_5":14632,"_28040":122930,"_3027":123550},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3572":73374,"_30844":73111,"_21377":123552,"_5":14632,"_28040":122930,"_3027":123553},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3572":73375,"_30844":73111,"_21377":123555,"_5":14632,"_28040":122930,"_3027":123556},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3572":73376,"_30844":73111,"_21377":123558,"_5":14632,"_28040":122930,"_3027":123559},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3572":73377,"_30844":73111,"_21377":123561,"_5":14632,"_28040":122930,"_3027":123562},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3572":73378,"_30844":73111,"_21377":123564,"_5":14632,"_28040":122930,"_3027":123565},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3572":73379,"_30844":73111,"_21377":123567,"_5":14632,"_28040":122930,"_3027":123568},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3572":73380,"_30844":73111,"_21377":123570,"_5":14632,"_28040":122930,"_3027":123571},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3572":73381,"_30844":73111,"_21377":123573,"_5":14632,"_28040":122930,"_3027":123574},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3572":73382,"_30844":73111,"_21377":123576,"_5":14632,"_28040":122930,"_3027":123577},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3572":73383,"_30844":73111,"_21377":123579,"_5":14632,"_28040":122930,"_3027":123580},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3572":73384,"_30844":73111,"_21377":123582,"_5":14632,"_28040":122930,"_3027":123583},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3572":73385,"_30844":73111,"_21377":123585,"_5":14632,"_28040":122930,"_3027":123586},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3572":73386,"_30844":73111,"_21377":123588,"_5":14632,"_28040":122930,"_3027":123589},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3572":73387,"_30844":73111,"_21377":123591,"_5":14632,"_28040":122930,"_3027":123592},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3572":73388,"_30844":73111,"_21377":123594,"_5":14632,"_28040":122930,"_3027":123595},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3572":73389,"_30844":73111,"_21377":123597,"_5":14632,"_28040":122930,"_3027":123598},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3572":73390,"_30844":73111,"_21377":123600,"_5":14632,"_28040":122930,"_3027":123601},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3572":73391,"_30844":73111,"_21377":123603,"_5":14632,"_28040":122930,"_3027":123604},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3572":73392,"_30844":73392,"_5":14996,"_3027":53048,"_31202":123606,"_21377":123607,"_28040":73392},[50349,120289,53048],[],{"_3572":73393,"_30844":73392,"_21377":123609,"_5":14632,"_28040":73392,"_3027":123610},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3572":73394,"_30844":73392,"_5":31199,"_21377":123612,"_28040":123613,"_3027":123614},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3572":73395,"_30844":73392,"_5":31199,"_21377":123616,"_28040":123617,"_3027":121422},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3572":73396,"_30844":73392,"_5":31199,"_21377":123619,"_28040":123620,"_3027":121597},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3572":73397,"_30844":73392,"_5":31199,"_21377":123622,"_28040":123623,"_3027":122829},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/overview#integraciones",{"_3572":73398,"_30844":73392,"_5":31199,"_21377":123625,"_28040":123626,"_3027":123627},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3572":73399,"_30844":73392,"_21377":123629,"_5":14632,"_28040":73392,"_3027":123630},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3572":73400,"_30844":73392,"_21377":123632,"_5":14632,"_28040":123613,"_3027":123633},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3572":73401,"_30844":73392,"_21377":123635,"_5":14632,"_28040":123613,"_3027":123636},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3572":73402,"_30844":73392,"_21377":123638,"_5":14632,"_28040":123617,"_3027":123639},[],"Recurso",{"_3572":73403,"_30844":73392,"_21377":123641,"_5":14632,"_28040":123617,"_3027":123642},[],"Qué representa",{"_3572":73404,"_30844":73392,"_21377":123644,"_5":14632,"_28040":123617,"_3027":123645},[],"**Dispositivo**",{"_3572":73405,"_30844":73392,"_21377":123647,"_5":14632,"_28040":123617,"_3027":123648},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3572":73406,"_30844":73392,"_21377":123650,"_5":14632,"_28040":123617,"_3027":123651},[],"**Identidad**",{"_3572":73407,"_30844":73392,"_21377":123653,"_5":14632,"_28040":123617,"_3027":123654},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3572":73408,"_30844":73392,"_21377":123656,"_5":14632,"_28040":123617,"_3027":55394},[],{"_3572":73409,"_30844":73392,"_21377":123658,"_5":14632,"_28040":123617,"_3027":123659},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3572":73410,"_30844":73392,"_21377":123661,"_5":14632,"_28040":123617,"_3027":123662},[],"**Flota**",{"_3572":73411,"_30844":73392,"_21377":123664,"_5":14632,"_28040":123617,"_3027":123665},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3572":73412,"_30844":73392,"_21377":123667,"_5":14632,"_28040":123617,"_3027":123668},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3572":73413,"_30844":73392,"_21377":123670,"_5":14632,"_28040":123617,"_3027":123671},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3572":73414,"_30844":73392,"_21377":123673,"_5":14632,"_28040":123620,"_3027":123674},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3572":73415,"_30844":73392,"_21377":123676,"_5":14632,"_28040":123620,"_3027":123677},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3572":73416,"_30844":73392,"_21377":123679,"_5":14632,"_28040":123620,"_3027":123680},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3572":73417,"_30844":73392,"_21377":123682,"_5":14632,"_28040":123620,"_3027":123683},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3572":73418,"_30844":73392,"_21377":123685,"_5":14632,"_28040":123620,"_3027":123686},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3572":73419,"_30844":73392,"_21377":123688,"_5":14632,"_28040":123620,"_3027":123689},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3572":73420,"_30844":73392,"_21377":123691,"_5":14632,"_28040":123620,"_3027":123692},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3572":73421,"_30844":73392,"_21377":123694,"_5":14632,"_28040":123620,"_3027":123695},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3572":73422,"_30844":73392,"_21377":123697,"_5":14632,"_28040":123623,"_3027":123698},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3572":73423,"_30844":73392,"_21377":123700,"_5":14632,"_28040":123623,"_3027":123701},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3572":73424,"_30844":73392,"_21377":123703,"_5":14632,"_28040":123626,"_3027":123704},[],"Participante",{"_3572":73425,"_30844":73392,"_21377":123706,"_5":14632,"_28040":123626,"_3027":123707},[],"Responsabilidad",{"_3572":73426,"_30844":73392,"_21377":123709,"_5":14632,"_28040":123626,"_3027":123710},[],"Administrador PKI",{"_3572":73427,"_30844":73392,"_21377":123712,"_5":14632,"_28040":123626,"_3027":123713},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3572":73428,"_30844":73392,"_21377":123715,"_5":14632,"_28040":123626,"_3027":123716},[],"Administrador del aprovisionamiento",{"_3572":73429,"_30844":73392,"_21377":123718,"_5":14632,"_28040":123626,"_3027":123719},[],"DMS, admisión, autenticación por operación e inventario.",{"_3572":73430,"_30844":73392,"_21377":123721,"_5":14632,"_28040":123626,"_3027":123722},[],"Integrador del dispositivo",{"_3572":73431,"_30844":73392,"_21377":123724,"_5":14632,"_28040":123626,"_3027":123725},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3572":73432,"_30844":73392,"_21377":123727,"_5":14632,"_28040":123626,"_3027":123728},[],"Integrador del consumidor",{"_3572":73433,"_30844":73392,"_21377":123730,"_5":14632,"_28040":123626,"_3027":123731},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3572":73434,"_30844":73392,"_21377":123733,"_5":14632,"_28040":123626,"_3027":123734},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3572":73435,"_30844":73435,"_5":14996,"_3027":123736,"_31202":123737,"_21377":123739,"_28040":73435},"Enrola y conecta tu primer dispositivo",[50349,120289,53048,123738],"Primeros pasos",[],{"_3572":73436,"_30844":73435,"_21377":123741,"_5":14632,"_28040":73435,"_3027":123742},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3572":73437,"_30844":73435,"_5":31199,"_21377":123744,"_28040":123745,"_3027":118802},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3572":73438,"_30844":73435,"_5":31199,"_21377":123747,"_28040":123748,"_3027":123749},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3572":73439,"_30844":73435,"_5":31199,"_21377":123751,"_28040":123752,"_3027":123753},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3572":73440,"_30844":73435,"_5":31199,"_21377":123755,"_28040":123756,"_3027":123757},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3572":73441,"_30844":73435,"_5":31199,"_21377":123759,"_28040":123760,"_3027":123761},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3572":73442,"_30844":73435,"_5":31199,"_21377":123763,"_28040":123764,"_3027":123765},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3572":73443,"_30844":73435,"_5":31199,"_21377":123767,"_28040":123768,"_3027":123769},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3572":73444,"_30844":73435,"_5":31199,"_21377":123771,"_28040":123772,"_3027":123773},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3572":73445,"_30844":73435,"_21377":123775,"_5":14632,"_28040":73435,"_3027":123776},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3572":73446,"_30844":73435,"_21377":123778,"_5":14632,"_28040":123745,"_3027":123779},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3572":73447,"_30844":73435,"_21377":123781,"_5":14632,"_28040":123745,"_3027":123782},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3572":73448,"_30844":73435,"_21377":123784,"_5":14632,"_28040":123745,"_3027":123785},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3572":73449,"_30844":73435,"_21377":123787,"_5":14632,"_28040":123745,"_3027":123788},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3572":73450,"_30844":73435,"_21377":123790,"_5":14632,"_28040":123745,"_3027":123791},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3572":73451,"_30844":73435,"_21377":123793,"_5":14632,"_28040":123748,"_3027":123794},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3572":73452,"_30844":73435,"_21377":123796,"_5":14632,"_28040":123748,"_3027":123797},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3572":73453,"_30844":73435,"_21377":123799,"_5":14632,"_28040":123752,"_3027":123800},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3572":73454,"_30844":73435,"_21377":123802,"_5":14632,"_28040":123752,"_3027":123803},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3572":73455,"_30844":73435,"_21377":123805,"_5":14632,"_28040":123752,"_3027":123806},[],"Ajuste",{"_3572":73456,"_30844":73435,"_21377":123808,"_5":14632,"_28040":123752,"_3027":123809},[],"Valor de evaluación",{"_3572":73457,"_30844":73435,"_21377":123811,"_5":14632,"_28040":123752,"_3027":55550},[],{"_3572":73458,"_30844":73435,"_21377":123813,"_5":14632,"_28040":123752,"_3027":123814},[],"Raíz emisora de `device-root.pem`.",{"_3572":73459,"_30844":73435,"_21377":123816,"_5":14632,"_28040":123752,"_3027":121725},[],{"_3572":73460,"_30844":73435,"_21377":123818,"_5":14632,"_28040":123752,"_3027":123819},[],"Perfil final de 1 hora que acabas de preparar.",{"_3572":73461,"_30844":73435,"_21377":123821,"_5":14632,"_28040":123752,"_3027":55561},[],{"_3572":73462,"_30844":73435,"_21377":123823,"_5":14632,"_28040":123752,"_3027":55564},[],{"_3572":73463,"_30844":73435,"_21377":123825,"_5":14632,"_28040":123752,"_3027":55567},[],{"_3572":73464,"_30844":73435,"_21377":123827,"_5":14632,"_28040":123752,"_3027":123828},[],"Habilitado.",{"_3572":73465,"_30844":73435,"_21377":123830,"_5":14632,"_28040":123752,"_3027":55573},[],{"_3572":73466,"_30844":73435,"_21377":123832,"_5":14632,"_28040":123752,"_3027":123833},[],"Deshabilitado; el ID debe ser nuevo.",{"_3572":73467,"_30844":73435,"_21377":123835,"_5":14632,"_28040":123752,"_3027":123836},[],"Autenticación inicial",{"_3572":73468,"_30844":73435,"_21377":123838,"_5":14632,"_28040":123752,"_3027":123839},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3572":73469,"_30844":73435,"_21377":123841,"_5":14632,"_28040":123752,"_3027":123842},[],"Autenticación de renovación",{"_3572":73470,"_30844":73435,"_21377":123844,"_5":14632,"_28040":123752,"_3027":123845},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3572":73471,"_30844":73435,"_21377":123847,"_5":14632,"_28040":123752,"_3027":55591},[],{"_3572":73472,"_30844":73435,"_21377":123849,"_5":14632,"_28040":123752,"_3027":123850},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3572":73473,"_30844":73435,"_21377":123852,"_5":14632,"_28040":123752,"_3027":55597},[],{"_3572":73474,"_30844":73435,"_21377":123854,"_5":14632,"_28040":123752,"_3027":123855},[],"1 hora.",{"_3572":73475,"_30844":73435,"_21377":123857,"_5":14632,"_28040":123752,"_3027":55603},[],{"_3572":73476,"_30844":73435,"_21377":123859,"_5":14632,"_28040":123752,"_3027":123860},[],"30 minutos / 10 minutos.",{"_3572":73477,"_30844":73435,"_21377":123862,"_5":14632,"_28040":123752,"_3027":55609},[],{"_3572":73478,"_30844":73435,"_21377":123864,"_5":14632,"_28040":123752,"_3027":123865},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3572":73479,"_30844":73435,"_21377":123867,"_5":14632,"_28040":123752,"_3027":53367},[],{"_3572":73480,"_30844":73435,"_21377":123869,"_5":14632,"_28040":123752,"_3027":123870},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3572":73481,"_30844":73435,"_21377":123872,"_5":14632,"_28040":123752,"_3027":55620},[],{"_3572":73482,"_30844":73435,"_21377":123874,"_5":14632,"_28040":123752,"_3027":123875},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3572":73483,"_30844":73435,"_21377":123877,"_5":14632,"_28040":123752,"_3027":123878},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3572":73484,"_30844":73435,"_21377":123880,"_5":14632,"_28040":123756,"_3027":123881},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3572":73485,"_30844":73435,"_21377":123883,"_5":14632,"_28040":123756,"_3027":123884},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3572":73486,"_30844":73435,"_21377":123886,"_5":14632,"_28040":123760,"_3027":123887},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3572":73487,"_30844":73435,"_21377":123889,"_5":14632,"_28040":123760,"_3027":123890},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3572":73488,"_30844":73435,"_21377":123892,"_5":14632,"_28040":123760,"_3027":123893},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3572":73489,"_30844":73435,"_21377":123895,"_5":14632,"_28040":123764,"_3027":123896},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3572":73490,"_30844":73435,"_21377":123898,"_5":14632,"_28040":123764,"_3027":123899},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3572":73491,"_30844":73435,"_21377":123901,"_5":14632,"_28040":123768,"_3027":123902},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3572":73492,"_30844":73435,"_21377":123904,"_5":14632,"_28040":123768,"_3027":123905},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3572":73493,"_30844":73435,"_21377":123907,"_5":14632,"_28040":123768,"_3027":123908},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3572":73494,"_30844":73435,"_21377":123910,"_5":14632,"_28040":123768,"_3027":123911},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3572":73495,"_30844":73435,"_21377":123913,"_5":14632,"_28040":123768,"_3027":123914},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3572":73496,"_30844":73435,"_21377":123916,"_5":14632,"_28040":123772,"_3027":123917},[],"Comprobación",{"_3572":73497,"_30844":73435,"_21377":123919,"_5":14632,"_28040":123772,"_3027":123920},[],"Resultado esperado",{"_3572":73498,"_30844":73435,"_21377":123922,"_5":14632,"_28040":123772,"_3027":123923},[],"Registro",{"_3572":73499,"_30844":73435,"_21377":123925,"_5":14632,"_28040":123772,"_3027":123926},[],"ID creado automáticamente y DMS correcto.",{"_3572":73500,"_30844":73435,"_21377":123928,"_5":14632,"_28040":123772,"_3027":123213},[],{"_3572":73501,"_30844":73435,"_21377":123930,"_5":14632,"_28040":123772,"_3027":123931},[],"CN, perfil, serie y clave verificados.",{"_3572":73502,"_30844":73435,"_21377":123933,"_5":14632,"_28040":123772,"_3027":123934},[],"Inventario",{"_3572":73503,"_30844":73435,"_21377":123936,"_5":14632,"_28040":123772,"_3027":123937},[],"Serie recibida visible como identidad actual y en el historial.",{"_3572":73504,"_30844":73435,"_21377":123939,"_5":14632,"_28040":123772,"_3027":123940},[],"Consumidor",{"_3572":73505,"_30844":73435,"_21377":123942,"_5":14632,"_28040":123772,"_3027":123943},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3572":73506,"_30844":73435,"_21377":123945,"_5":14632,"_28040":123772,"_3027":123946},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3572":73507,"_30844":73435,"_21377":123948,"_5":14632,"_28040":123772,"_3027":123949},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3572":73508,"_30844":73508,"_5":14996,"_3027":121439,"_31202":123951,"_21377":123952,"_28040":73508},[50349,120289,53048,123738],[],{"_3572":73509,"_30844":73508,"_21377":123954,"_5":14632,"_28040":73508,"_3027":123955},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3572":73510,"_30844":73508,"_5":31199,"_21377":123957,"_28040":123958,"_3027":118802},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3572":73511,"_30844":73508,"_5":31199,"_21377":123960,"_28040":123961,"_3027":123962},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3572":73512,"_30844":73508,"_5":31199,"_21377":123964,"_28040":123965,"_3027":123966},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3572":73513,"_30844":73508,"_5":31199,"_21377":123968,"_28040":123969,"_3027":123970},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3572":73514,"_30844":73508,"_5":31199,"_21377":123972,"_28040":123973,"_3027":123974},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3572":73515,"_30844":73508,"_5":31199,"_21377":123976,"_28040":123977,"_3027":123978},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3572":73516,"_30844":73508,"_5":31199,"_21377":123980,"_28040":123981,"_3027":123920},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3572":73517,"_30844":73508,"_5":31199,"_21377":123983,"_28040":123984,"_3027":123985},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3572":73518,"_30844":73508,"_5":31199,"_21377":123987,"_28040":123988,"_3027":123989},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3572":73519,"_30844":73508,"_21377":123991,"_5":14632,"_28040":73508,"_3027":123992},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3572":73520,"_30844":73508,"_21377":123994,"_5":14632,"_28040":73508,"_3027":123995},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3572":73521,"_30844":73508,"_21377":123997,"_5":14632,"_28040":123958,"_3027":123998},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3572":73522,"_30844":73508,"_21377":124000,"_5":14632,"_28040":123958,"_3027":124001},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3572":73523,"_30844":73508,"_21377":124003,"_5":14632,"_28040":123958,"_3027":124004},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3572":73524,"_30844":73508,"_21377":124006,"_5":14632,"_28040":123958,"_3027":124007},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3572":73525,"_30844":73508,"_21377":124009,"_5":14632,"_28040":123961,"_3027":124010},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3572":73526,"_30844":73508,"_21377":124012,"_5":14632,"_28040":123961,"_3027":124013},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3572":73527,"_30844":73508,"_21377":124015,"_5":14632,"_28040":123961,"_3027":124016},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3572":73528,"_30844":73508,"_21377":124018,"_5":14632,"_28040":123961,"_3027":124019},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3572":73529,"_30844":73508,"_21377":124021,"_5":14632,"_28040":123961,"_3027":124022},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3572":73530,"_30844":73508,"_21377":124024,"_5":14632,"_28040":123961,"_3027":124025},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3572":73531,"_30844":73508,"_21377":124027,"_5":14632,"_28040":123961,"_3027":124028},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3572":73532,"_30844":73508,"_21377":124030,"_5":14632,"_28040":123961,"_3027":124031},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3572":73533,"_30844":73508,"_21377":124033,"_5":14632,"_28040":123965,"_3027":124034},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3572":73534,"_30844":73508,"_21377":124036,"_5":14632,"_28040":123965,"_3027":55785},[],{"_3572":73535,"_30844":73508,"_21377":124038,"_5":14632,"_28040":123965,"_3027":124039},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3572":73536,"_30844":73508,"_21377":124041,"_5":14632,"_28040":123965,"_3027":124042},[],"**Icon** y **Tags**: clasificación opcional.",{"_3572":73537,"_30844":73508,"_21377":124044,"_5":14632,"_28040":123965,"_3027":124045},[],"Confirma el registro.",{"_3572":73538,"_30844":73508,"_21377":124047,"_5":14632,"_28040":123969,"_3027":124048},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3572":73539,"_30844":73508,"_21377":124050,"_5":14632,"_28040":123969,"_3027":124051},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3572":73540,"_30844":73508,"_21377":124053,"_5":14632,"_28040":123973,"_3027":124054},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3572":73541,"_30844":73508,"_21377":124056,"_5":14632,"_28040":123973,"_3027":124057},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3572":73542,"_30844":73508,"_21377":124059,"_5":14632,"_28040":123977,"_3027":124060},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3572":73543,"_30844":73508,"_21377":124062,"_5":14632,"_28040":123977,"_3027":124063},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3572":73544,"_30844":73508,"_21377":124065,"_5":14632,"_28040":123981,"_3027":123917},[],{"_3572":73545,"_30844":73508,"_21377":124067,"_5":14632,"_28040":123981,"_3027":124068},[],"Resultado",{"_3572":73546,"_30844":73508,"_21377":124070,"_5":14632,"_28040":123981,"_3027":123199},[],{"_3572":73547,"_30844":73508,"_21377":124072,"_5":14632,"_28040":123981,"_3027":124073},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3572":73548,"_30844":73508,"_21377":124075,"_5":14632,"_28040":123981,"_3027":124076},[],"Identidad actual",{"_3572":73549,"_30844":73508,"_21377":124078,"_5":14632,"_28040":123981,"_3027":124079},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3572":73550,"_30844":73508,"_21377":124081,"_5":14632,"_28040":123981,"_3027":124082},[],"Historial",{"_3572":73551,"_30844":73508,"_21377":124084,"_5":14632,"_28040":123981,"_3027":124085},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3572":73552,"_30844":73508,"_21377":124087,"_5":14632,"_28040":123981,"_3027":124088},[],"Clave y certificado",{"_3572":73553,"_30844":73508,"_21377":124090,"_5":14632,"_28040":123981,"_3027":124091},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3572":73554,"_30844":73508,"_21377":124093,"_5":14632,"_28040":123984,"_3027":124094},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3572":73555,"_30844":73508,"_21377":124096,"_5":14632,"_28040":123984,"_3027":124097},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3572":73556,"_30844":73508,"_21377":124099,"_5":14632,"_28040":123984,"_3027":124100},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3572":73557,"_30844":73508,"_21377":124102,"_5":14632,"_28040":123984,"_3027":124103},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3572":73558,"_30844":73508,"_21377":124105,"_5":14632,"_28040":123988,"_3027":124106},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3572":73559,"_30844":73508,"_21377":124108,"_5":14632,"_28040":123988,"_3027":124109},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3572":73560,"_30844":73508,"_21377":124111,"_5":14632,"_28040":123988,"_3027":124112},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3572":73561,"_30844":73561,"_5":14996,"_3027":124114,"_31202":124115,"_21377":124116,"_28040":73561},"Plataforma Lamassu IoT",[50349,120289],[],{"_3572":73562,"_30844":73561,"_21377":124118,"_5":14632,"_28040":73561,"_3027":124119},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3572":73563,"_30844":73561,"_5":31199,"_21377":124121,"_28040":124122,"_3027":123614},[],"/docs/pr-preview/pr-68/es/platform/overview#empieza-aquí",{"_3572":73564,"_30844":73561,"_5":31199,"_21377":124124,"_28040":124125,"_3027":124126},[],"/docs/pr-preview/pr-68/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3572":73565,"_30844":73561,"_5":31199,"_21377":124128,"_28040":124129,"_3027":124130},[],"/docs/pr-preview/pr-68/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3572":73566,"_30844":73561,"_5":31199,"_21377":124132,"_28040":124133,"_3027":124134},[],"/docs/pr-preview/pr-68/es/platform/overview#capacidades-principales","Capacidades principales",{"_3572":73567,"_30844":73561,"_5":31199,"_21377":124136,"_28040":124137,"_3027":124138},[],"/docs/pr-preview/pr-68/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3572":73568,"_30844":73561,"_5":31199,"_21377":124140,"_28040":124141,"_3027":124142},[],"/docs/pr-preview/pr-68/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3572":73569,"_30844":73561,"_5":31199,"_21377":124144,"_28040":124145,"_3027":124146},[],"/docs/pr-preview/pr-68/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3572":73570,"_30844":73561,"_5":31199,"_21377":124148,"_28040":124149,"_3027":124150},[],"/docs/pr-preview/pr-68/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3572":73571,"_30844":73561,"_5":31199,"_21377":124152,"_28040":124153,"_3027":124154},[],"/docs/pr-preview/pr-68/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3572":73572,"_30844":73561,"_5":31199,"_21377":124156,"_28040":124157,"_3027":124158},[],"/docs/pr-preview/pr-68/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3572":73573,"_30844":73561,"_5":31199,"_21377":124160,"_28040":124161,"_3027":124162},[],"/docs/pr-preview/pr-68/es/platform/overview#referencia-operativa","Referencia operativa",{"_3572":73574,"_30844":73561,"_21377":124164,"_5":14632,"_28040":73561,"_3027":124165},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3572":73575,"_30844":73561,"_21377":124167,"_5":14632,"_28040":124122,"_3027":124168},[],"Elige el resultado que necesitas obtener:",{"_3572":73576,"_30844":73561,"_21377":124170,"_5":14632,"_28040":124122,"_3027":124171},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3572":73577,"_30844":73561,"_21377":124173,"_5":14632,"_28040":124122,"_3027":124174},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3572":73578,"_30844":73561,"_21377":124176,"_5":14632,"_28040":124122,"_3027":124177},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3572":73579,"_30844":73561,"_21377":124179,"_5":14632,"_28040":124125,"_3027":124180},[],"Bloque",{"_3572":73580,"_30844":73561,"_21377":124182,"_5":14632,"_28040":124125,"_3027":124183},[],"Qué gestionas",{"_3572":73581,"_30844":73561,"_21377":124185,"_5":14632,"_28040":124125,"_3027":124186},[],"Punto de entrada",{"_3572":73582,"_30844":73561,"_21377":124188,"_5":14632,"_28040":124125,"_3027":55938},[],{"_3572":73583,"_30844":73561,"_21377":124190,"_5":14632,"_28040":124125,"_3027":124191},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3572":73584,"_30844":73561,"_21377":124193,"_5":14632,"_28040":124125,"_3027":124194},[],"Visión general de PKI",{"_3572":73585,"_30844":73561,"_21377":124196,"_5":14632,"_28040":124125,"_3027":55947},[],{"_3572":73586,"_30844":73561,"_21377":124198,"_5":14632,"_28040":124125,"_3027":124199},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3572":73587,"_30844":73561,"_21377":124201,"_5":14632,"_28040":124125,"_3027":124202},[],"Visión general de IoT Fleets",{"_3572":73588,"_30844":73561,"_21377":124204,"_5":14632,"_28040":124125,"_3027":124205},[],"**Administración**",{"_3572":73589,"_30844":73561,"_21377":124207,"_5":14632,"_28040":124125,"_3027":124208},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3572":73590,"_30844":73561,"_21377":124210,"_5":14632,"_28040":124125,"_3027":120291},[],{"_3572":73591,"_30844":73561,"_21377":124212,"_5":14632,"_28040":124125,"_3027":124213},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3572":73592,"_30844":73561,"_21377":124215,"_5":14632,"_28040":124129,"_3027":124216},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3572":73593,"_30844":73561,"_21377":124218,"_5":14632,"_28040":124129,"_3027":124219},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3572":73594,"_30844":73561,"_21377":124221,"_5":14632,"_28040":124129,"_3027":124222},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3572":73595,"_30844":73561,"_21377":124224,"_5":14632,"_28040":124129,"_3027":124225},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3572":73596,"_30844":73561,"_21377":124227,"_5":14632,"_28040":124129,"_3027":124228},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3572":73597,"_30844":73561,"_21377":124230,"_5":14632,"_28040":124129,"_3027":124231},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3572":73598,"_30844":73561,"_21377":124233,"_5":14632,"_28040":124137,"_3027":124234},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3572":73599,"_30844":73561,"_21377":124236,"_5":14632,"_28040":124141,"_3027":124237},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3572":73600,"_30844":73561,"_21377":124239,"_5":14632,"_28040":124145,"_3027":124240},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3572":73601,"_30844":73561,"_21377":124242,"_5":14632,"_28040":124149,"_3027":124243},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3572":73602,"_30844":73561,"_21377":124245,"_5":14632,"_28040":124153,"_3027":124246},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3572":73603,"_30844":73561,"_21377":124248,"_5":14632,"_28040":124157,"_3027":124249},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3572":73604,"_30844":73561,"_21377":124251,"_5":14632,"_28040":124161,"_3027":123707},[],{"_3572":73605,"_30844":73561,"_21377":124253,"_5":14632,"_28040":124161,"_3027":124254},[],"Qué prepara o comprueba",{"_3572":73606,"_30844":73561,"_21377":124256,"_5":14632,"_28040":124161,"_3027":123710},[],{"_3572":73607,"_30844":73561,"_21377":124258,"_5":14632,"_28040":124161,"_3027":124259},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3572":73608,"_30844":73561,"_21377":124261,"_5":14632,"_28040":124161,"_3027":124262},[],"Administrador de la flota",{"_3572":73609,"_30844":73561,"_21377":124264,"_5":14632,"_28040":124161,"_3027":124265},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3572":73610,"_30844":73561,"_21377":124267,"_5":14632,"_28040":124161,"_3027":123722},[],{"_3572":73611,"_30844":73561,"_21377":124269,"_5":14632,"_28040":124161,"_3027":124270},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3572":73612,"_30844":73561,"_21377":124272,"_5":14632,"_28040":124161,"_3027":123728},[],{"_3572":73613,"_30844":73561,"_21377":124274,"_5":14632,"_28040":124161,"_3027":124275},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3572":73614,"_30844":73561,"_21377":124277,"_5":14632,"_28040":124161,"_3027":124278},[],"Operador de infraestructura",{"_3572":73615,"_30844":73561,"_21377":124280,"_5":14632,"_28040":124161,"_3027":124281},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3572":73616,"_30844":73561,"_21377":124283,"_5":14632,"_28040":124161,"_3027":124284},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3572":73617,"_30844":73617,"_5":14996,"_3027":124286,"_31202":124287,"_21377":124289,"_28040":73617},"Jerarquía y rotación de CAs",[50349,120289,56039,124288],"Claves, autoridades y certificados",[],{"_3572":73618,"_30844":73617,"_21377":124291,"_5":14632,"_28040":73617,"_3027":124292},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3572":73619,"_30844":73617,"_5":31199,"_21377":124294,"_28040":124295,"_3027":124296},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3572":73620,"_30844":73617,"_5":31199,"_21377":124298,"_28040":124299,"_3027":124300},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3572":73621,"_30844":73617,"_5":31199,"_21377":124302,"_28040":124303,"_3027":124304},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3572":73622,"_30844":73617,"_5":31199,"_21377":124306,"_28040":124307,"_3027":124308},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3572":73623,"_30844":73617,"_5":31199,"_21377":124310,"_28040":124311,"_3027":124312},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3572":73624,"_30844":73617,"_5":31199,"_21377":124314,"_28040":124315,"_3027":124316},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3572":73625,"_30844":73617,"_5":31199,"_21377":124318,"_28040":124319,"_3027":124320},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3572":73626,"_30844":73617,"_5":31199,"_21377":124322,"_28040":124323,"_3027":124324},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3572":73627,"_30844":73617,"_5":31199,"_21377":124326,"_28040":124327,"_3027":124328},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3572":73628,"_30844":73617,"_5":31199,"_21377":124330,"_28040":124331,"_3027":124332},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3572":73629,"_30844":73617,"_5":31199,"_21377":124334,"_28040":124335,"_3027":124336},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3572":73630,"_30844":73617,"_5":31199,"_21377":124338,"_28040":124339,"_3027":124340},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3572":73631,"_30844":73617,"_21377":124342,"_5":14632,"_28040":73617,"_3027":124343},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3572":73632,"_30844":73617,"_21377":124345,"_5":14632,"_28040":73617,"_3027":124346},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3572":73633,"_30844":73617,"_21377":124348,"_5":14632,"_28040":124295,"_3027":124349},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3572":73634,"_30844":73617,"_21377":124351,"_5":14632,"_28040":124295,"_3027":124352},[],"entorno, como producción y preproducción;",{"_3572":73635,"_30844":73617,"_21377":124354,"_5":14632,"_28040":124295,"_3027":124355},[],"propietario o equipo operador;",{"_3572":73636,"_30844":73617,"_21377":124357,"_5":14632,"_28040":124295,"_3027":124358},[],"familia de dispositivos o proceso de fabricación;",{"_3572":73637,"_30844":73617,"_21377":124360,"_5":14632,"_28040":124295,"_3027":124361},[],"región o requisito regulatorio;",{"_3572":73638,"_30844":73617,"_21377":124363,"_5":14632,"_28040":124295,"_3027":124364},[],"motor criptográfico o política de clave;",{"_3572":73639,"_30844":73617,"_21377":124366,"_5":14632,"_28040":124295,"_3027":124367},[],"ventana de mantenimiento y ritmo de renovación.",{"_3572":73640,"_30844":73617,"_21377":124369,"_5":14632,"_28040":124295,"_3027":124370},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3572":73641,"_30844":73617,"_21377":124372,"_5":14632,"_28040":124295,"_3027":124373},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3572":73642,"_30844":73617,"_21377":124375,"_5":14632,"_28040":124299,"_3027":124376},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3572":73643,"_30844":73617,"_21377":124378,"_5":14632,"_28040":124299,"_3027":124379},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3572":73644,"_30844":73617,"_21377":124381,"_5":14632,"_28040":124299,"_3027":124382},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3572":73645,"_30844":73617,"_21377":124384,"_5":14632,"_28040":124299,"_3027":124385},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3572":73646,"_30844":73617,"_21377":124387,"_5":14632,"_28040":124303,"_3027":124388},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3572":73647,"_30844":73617,"_21377":124390,"_5":14632,"_28040":124303,"_3027":124391},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3572":73648,"_30844":73617,"_21377":124393,"_5":14632,"_28040":124303,"_3027":124394},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3572":73649,"_30844":73617,"_21377":124396,"_5":14632,"_28040":124303,"_3027":124397},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3572":73650,"_30844":73617,"_21377":124399,"_5":14632,"_28040":124311,"_3027":124400},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3572":73651,"_30844":73617,"_21377":124402,"_5":14632,"_28040":124315,"_3027":124403},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3572":73652,"_30844":73617,"_21377":124405,"_5":14632,"_28040":124319,"_3027":124406},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3572":73653,"_30844":73617,"_21377":124408,"_5":14632,"_28040":124323,"_3027":124409},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3572":73654,"_30844":73617,"_21377":124411,"_5":14632,"_28040":124327,"_3027":124412},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3572":73655,"_30844":73617,"_21377":124414,"_5":14632,"_28040":124331,"_3027":124415},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3572":73656,"_30844":73617,"_21377":124417,"_5":14632,"_28040":124335,"_3027":124418},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3572":73657,"_30844":73617,"_21377":124420,"_5":14632,"_28040":124335,"_3027":124421},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3572":73658,"_30844":73617,"_21377":124423,"_5":14632,"_28040":124335,"_3027":124424},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3572":73659,"_30844":73617,"_21377":124426,"_5":14632,"_28040":124335,"_3027":124427},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3572":73660,"_30844":73617,"_21377":124429,"_5":14632,"_28040":124339,"_3027":124430},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3572":73661,"_30844":73617,"_21377":124432,"_5":14632,"_28040":124339,"_3027":124433},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3572":73662,"_30844":73617,"_21377":124435,"_5":14632,"_28040":124339,"_3027":124436},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3572":73663,"_30844":73617,"_21377":124438,"_5":14632,"_28040":124339,"_3027":124439},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3572":73664,"_30844":73617,"_21377":124441,"_5":14632,"_28040":124339,"_3027":124442},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3572":73665,"_30844":73617,"_21377":124444,"_5":14632,"_28040":124339,"_3027":124445},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3572":73666,"_30844":73617,"_21377":124447,"_5":14632,"_28040":124339,"_3027":124448},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3572":73667,"_30844":73667,"_5":14996,"_3027":124450,"_31202":124451,"_21377":124452,"_28040":73667},"Autoridades de certificación",[50349,120289,56039,124288],[],{"_3572":73668,"_30844":73667,"_21377":124454,"_5":14632,"_28040":73667,"_3027":124455},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3572":73669,"_30844":73667,"_5":31199,"_21377":124457,"_28040":124458,"_3027":124459},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3572":73670,"_30844":73667,"_5":31199,"_21377":124461,"_28040":124462,"_3027":124463},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3572":73671,"_30844":73667,"_5":31199,"_21377":124465,"_28040":124466,"_3027":118802},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3572":73672,"_30844":73667,"_5":31199,"_21377":124468,"_28040":124469,"_3027":124470},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3572":73673,"_30844":73667,"_5":31199,"_21377":124472,"_28040":124473,"_3027":124474},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3572":73674,"_30844":73667,"_5":31199,"_21377":124476,"_28040":124477,"_3027":124478},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3572":73675,"_30844":73667,"_5":31199,"_21377":124480,"_28040":124481,"_3027":124482},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3572":73676,"_30844":73667,"_5":31199,"_21377":124484,"_28040":124485,"_3027":124486},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3572":73677,"_30844":73667,"_5":31199,"_21377":124488,"_28040":124489,"_3027":124490},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3572":73678,"_30844":73667,"_5":31199,"_21377":124492,"_28040":124493,"_3027":124494},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3572":73679,"_30844":73667,"_5":31199,"_21377":124496,"_28040":124497,"_3027":124498},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3572":73680,"_30844":73667,"_5":31199,"_21377":124500,"_28040":124501,"_3027":124502},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3572":73681,"_30844":73667,"_5":31199,"_21377":124504,"_28040":124505,"_3027":124506},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3572":73682,"_30844":73667,"_5":31199,"_21377":124508,"_28040":124509,"_3027":124510},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3572":73683,"_30844":73667,"_5":31199,"_21377":124512,"_28040":124513,"_3027":124514},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3572":73684,"_30844":73667,"_5":31199,"_21377":124516,"_28040":124517,"_3027":124518},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3572":73685,"_30844":73667,"_5":31199,"_21377":124520,"_28040":124521,"_3027":124522},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3572":73686,"_30844":73667,"_5":31199,"_21377":124524,"_28040":124525,"_3027":124526},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3572":73687,"_30844":73667,"_5":31199,"_21377":124528,"_28040":124529,"_3027":124530},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3572":73688,"_30844":73667,"_5":31199,"_21377":124532,"_28040":124533,"_3027":124534},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3572":73689,"_30844":73667,"_5":31199,"_21377":124536,"_28040":124537,"_3027":124538},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3572":73690,"_30844":73667,"_5":31199,"_21377":124540,"_28040":124541,"_3027":124542},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3572":73691,"_30844":73667,"_5":31199,"_21377":124544,"_28040":124545,"_3027":124546},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3572":73692,"_30844":73667,"_21377":124548,"_5":14632,"_28040":73667,"_3027":124549},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3572":73693,"_30844":73667,"_21377":124551,"_5":14632,"_28040":73667,"_3027":124552},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3572":73694,"_30844":73667,"_21377":124554,"_5":14632,"_28040":73667,"_3027":124555},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3572":73695,"_30844":73667,"_21377":124557,"_5":14632,"_28040":124458,"_3027":124558},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3572":73696,"_30844":73667,"_21377":124560,"_5":14632,"_28040":124458,"_3027":124561},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3572":73697,"_30844":73667,"_21377":124563,"_5":14632,"_28040":124458,"_3027":124564},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3572":73698,"_30844":73667,"_21377":124566,"_5":14632,"_28040":124458,"_3027":124567},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3572":73699,"_30844":73667,"_21377":124569,"_5":14632,"_28040":124458,"_3027":124570},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3572":73700,"_30844":73667,"_21377":124572,"_5":14632,"_28040":124466,"_3027":124573},[],"Decide si la CA será raíz o intermedia.",{"_3572":73701,"_30844":73667,"_21377":124575,"_5":14632,"_28040":124466,"_3027":124576},[],"Elige el motor que custodiará la clave.",{"_3572":73702,"_30844":73667,"_21377":124578,"_5":14632,"_28040":124466,"_3027":124579},[],"Define una validez superior a la de los certificados que emitirá.",{"_3572":73703,"_30844":73667,"_21377":124581,"_5":14632,"_28040":124466,"_3027":124582},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3572":73704,"_30844":73667,"_21377":124584,"_5":14632,"_28040":124469,"_3027":124585},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3572":73705,"_30844":73667,"_21377":124587,"_5":14632,"_28040":124473,"_3027":124588},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3572":73706,"_30844":73667,"_21377":124590,"_5":14632,"_28040":124473,"_3027":124591},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3572":73707,"_30844":73667,"_21377":124593,"_5":14632,"_28040":124477,"_3027":124594},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3572":73708,"_30844":73667,"_21377":124596,"_5":14632,"_28040":124481,"_3027":124597},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3572":73709,"_30844":73667,"_21377":124599,"_5":14632,"_28040":124481,"_3027":124600},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3572":73710,"_30844":73667,"_21377":124602,"_5":14632,"_28040":124481,"_3027":124603},[],"`ST`: estado o provincia.",{"_3572":73711,"_30844":73667,"_21377":124605,"_5":14632,"_28040":124481,"_3027":124606},[],"`L`: localidad.",{"_3572":73712,"_30844":73667,"_21377":124608,"_5":14632,"_28040":124481,"_3027":124609},[],"`O`: organización.",{"_3572":73713,"_30844":73667,"_21377":124611,"_5":14632,"_28040":124481,"_3027":124612},[],"`OU`: unidad organizativa.",{"_3572":73714,"_30844":73667,"_21377":124614,"_5":14632,"_28040":124481,"_3027":124615},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3572":73715,"_30844":73667,"_21377":124617,"_5":14632,"_28040":124485,"_3027":124618},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3572":73716,"_30844":73667,"_21377":124620,"_5":14632,"_28040":124485,"_3027":124621},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3572":73717,"_30844":73667,"_21377":124623,"_5":14632,"_28040":124489,"_3027":124624},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3572":73718,"_30844":73667,"_21377":124626,"_5":14632,"_28040":124489,"_3027":124627},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3572":73719,"_30844":73667,"_21377":124629,"_5":14632,"_28040":124493,"_3027":124630},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3572":73720,"_30844":73667,"_21377":124632,"_5":14632,"_28040":124493,"_3027":124633},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3572":73721,"_30844":73667,"_21377":124635,"_5":14632,"_28040":124497,"_3027":124636},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3572":73722,"_30844":73667,"_21377":124638,"_5":14632,"_28040":124497,"_3027":124639},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3572":73723,"_30844":73667,"_21377":124641,"_5":14632,"_28040":124497,"_3027":124642},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3572":73724,"_30844":73667,"_21377":124644,"_5":14632,"_28040":124501,"_3027":124645},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3572":73725,"_30844":73667,"_21377":124647,"_5":14632,"_28040":124505,"_3027":124648},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3572":73726,"_30844":73667,"_21377":124650,"_5":14632,"_28040":124505,"_3027":124651},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3572":73727,"_30844":73667,"_21377":124653,"_5":14632,"_28040":124509,"_3027":124654},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3572":73728,"_30844":73667,"_21377":124656,"_5":14632,"_28040":124513,"_3027":124657},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3572":73729,"_30844":73667,"_21377":124659,"_5":14632,"_28040":124513,"_3027":124660},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3572":73730,"_30844":73667,"_21377":124662,"_5":14632,"_28040":124517,"_3027":124663},[],"Abre una CA desde el inventario para consultar:",{"_3572":73731,"_30844":73667,"_21377":124665,"_5":14632,"_28040":124517,"_3027":124666},[],"Estado y periodo de validez.",{"_3572":73732,"_30844":73667,"_21377":124668,"_5":14632,"_28040":124517,"_3027":124669},[],"Certificado y cadena en formato PEM.",{"_3572":73733,"_30844":73667,"_21377":124671,"_5":14632,"_28040":124517,"_3027":124672},[],"Número de certificados activos, expirados y revocados.",{"_3572":73734,"_30844":73667,"_21377":124674,"_5":14632,"_28040":124517,"_3027":124675},[],"Certificados emitidos en **Issued Certificates**.",{"_3572":73735,"_30844":73667,"_21377":124677,"_5":14632,"_28040":124517,"_3027":124678},[],"CRL vinculada a la autoridad.",{"_3572":73736,"_30844":73667,"_21377":124680,"_5":14632,"_28040":124517,"_3027":124681},[],"Metadatos y motor criptográfico asociado.",{"_3572":73737,"_30844":73667,"_21377":124683,"_5":14632,"_28040":124517,"_3027":124684},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3572":73738,"_30844":73667,"_21377":124686,"_5":14632,"_28040":124521,"_3027":124687},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3572":73739,"_30844":73667,"_21377":124689,"_5":14632,"_28040":124521,"_3027":124690},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3572":73740,"_30844":73667,"_21377":124692,"_5":14632,"_28040":124521,"_3027":124693},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3572":73741,"_30844":73667,"_21377":124695,"_5":14632,"_28040":124521,"_3027":124696},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3572":73742,"_30844":73667,"_21377":124698,"_5":14632,"_28040":124525,"_3027":124699},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3572":73743,"_30844":73667,"_21377":124701,"_5":14632,"_28040":124529,"_3027":124702},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3572":73744,"_30844":73667,"_21377":124704,"_5":14632,"_28040":124533,"_3027":124705},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3572":73745,"_30844":73667,"_21377":124707,"_5":14632,"_28040":124537,"_3027":124708},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3572":73746,"_30844":73667,"_21377":124710,"_5":14632,"_28040":124541,"_3027":124711},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3572":73747,"_30844":73667,"_21377":124713,"_5":14632,"_28040":124545,"_3027":124714},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3572":73748,"_30844":73667,"_21377":124716,"_5":14632,"_28040":124545,"_3027":124717},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3572":73749,"_30844":73667,"_21377":124719,"_5":14632,"_28040":124545,"_3027":124720},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3572":73750,"_30844":73667,"_21377":124722,"_5":14632,"_28040":124545,"_3027":124723},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3572":73751,"_30844":73751,"_5":14996,"_3027":124725,"_31202":124726,"_21377":124727,"_28040":73751},"Perfiles de certificado",[50349,120289,56039,124288],[],{"_3572":73752,"_30844":73751,"_21377":124729,"_5":14632,"_28040":73751,"_3027":124730},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3572":73753,"_30844":73751,"_5":31199,"_21377":124732,"_28040":124733,"_3027":124734},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3572":73754,"_30844":73751,"_5":31199,"_21377":124736,"_28040":124737,"_3027":124738},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#validez","Validez",{"_3572":73755,"_30844":73751,"_5":31199,"_21377":124740,"_28040":124741,"_3027":124742},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3572":73756,"_30844":73751,"_5":31199,"_21377":124744,"_28040":124745,"_3027":124746},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3572":73757,"_30844":73751,"_5":31199,"_21377":124748,"_28040":124749,"_3027":124750},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3572":73758,"_30844":73751,"_5":31199,"_21377":124752,"_28040":124753,"_3027":124754},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3572":73759,"_30844":73751,"_5":31199,"_21377":124756,"_28040":124757,"_3027":124758},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3572":73760,"_30844":73751,"_5":31199,"_21377":124760,"_28040":124761,"_3027":124762},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3572":73761,"_30844":73751,"_5":31199,"_21377":124764,"_28040":124765,"_3027":124766},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3572":73762,"_30844":73751,"_5":31199,"_21377":124768,"_28040":124769,"_3027":124770},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3572":73763,"_30844":73751,"_5":31199,"_21377":124772,"_28040":124773,"_3027":124774},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3572":73764,"_30844":73751,"_5":31199,"_21377":124776,"_28040":124777,"_3027":124778},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3572":73765,"_30844":73751,"_5":31199,"_21377":124780,"_28040":124781,"_3027":124782},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3572":73766,"_30844":73751,"_5":31199,"_21377":124784,"_28040":124785,"_3027":124786},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3572":73767,"_30844":73751,"_5":31199,"_21377":124788,"_28040":124789,"_3027":124790},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3572":73768,"_30844":73751,"_5":31199,"_21377":124792,"_28040":124793,"_3027":124794},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3572":73769,"_30844":73751,"_21377":124796,"_5":14632,"_28040":73751,"_3027":124797},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3572":73770,"_30844":73751,"_21377":124799,"_5":14632,"_28040":73751,"_3027":124800},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3572":73771,"_30844":73751,"_21377":124802,"_5":14632,"_28040":124737,"_3027":124803},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3572":73772,"_30844":73751,"_21377":124805,"_5":14632,"_28040":124737,"_3027":124806},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3572":73773,"_30844":73751,"_21377":124808,"_5":14632,"_28040":124741,"_3027":124809},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3572":73774,"_30844":73751,"_21377":124811,"_5":14632,"_28040":124745,"_3027":124812},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3572":73775,"_30844":73751,"_21377":124814,"_5":14632,"_28040":124745,"_3027":124815},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3572":73776,"_30844":73751,"_21377":124817,"_5":14632,"_28040":124745,"_3027":124818},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3572":73777,"_30844":73751,"_21377":124820,"_5":14632,"_28040":124749,"_3027":124821},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3572":73778,"_30844":73751,"_21377":124823,"_5":14632,"_28040":124753,"_3027":124824},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3572":73779,"_30844":73751,"_21377":124826,"_5":14632,"_28040":124753,"_3027":124827},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3572":73780,"_30844":73751,"_21377":124829,"_5":14632,"_28040":124757,"_3027":124830},[],"La aplicación criptográfica puede:",{"_3572":73781,"_30844":73751,"_21377":124832,"_5":14632,"_28040":124757,"_3027":124833},[],"permitir o bloquear claves RSA;",{"_3572":73782,"_30844":73751,"_21377":124835,"_5":14632,"_28040":124757,"_3027":124836},[],"limitar los tamaños RSA admitidos;",{"_3572":73783,"_30844":73751,"_21377":124838,"_5":14632,"_28040":124757,"_3027":124839},[],"permitir o bloquear claves ECDSA;",{"_3572":73784,"_30844":73751,"_21377":124841,"_5":14632,"_28040":124757,"_3027":124842},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3572":73785,"_30844":73751,"_21377":124844,"_5":14632,"_28040":124757,"_3027":124845},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3572":73786,"_30844":73751,"_21377":124847,"_5":14632,"_28040":124761,"_3027":124848},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3572":73787,"_30844":73751,"_21377":124850,"_5":14632,"_28040":124761,"_3027":120040},[],{"_3572":73788,"_30844":73751,"_21377":124852,"_5":14632,"_28040":124761,"_3027":124853},[],"Primera opción",{"_3572":73789,"_30844":73751,"_21377":124855,"_5":14632,"_28040":124761,"_3027":124856},[],"Segunda opción",{"_3572":73790,"_30844":73751,"_21377":124858,"_5":14632,"_28040":124761,"_3027":124859},[],"Si no hay ninguna",{"_3572":73791,"_30844":73751,"_21377":124861,"_5":14632,"_28040":124761,"_3027":124862},[],"Firma directa con una CA",{"_3572":73792,"_30844":73751,"_21377":124864,"_5":14632,"_28040":124761,"_3027":124865},[],"`issuance_profile` incluido en la solicitud",{"_3572":73793,"_30844":73751,"_21377":124867,"_5":14632,"_28040":124761,"_3027":124868},[],"`issuance_profile_id` de la solicitud",{"_3572":73794,"_30844":73751,"_21377":124870,"_5":14632,"_28040":124761,"_3027":124871},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3572":73795,"_30844":73751,"_21377":124873,"_5":14632,"_28040":124761,"_3027":124874},[],"Emisión mediante DMS",{"_3572":73796,"_30844":73751,"_21377":124876,"_5":14632,"_28040":124761,"_3027":56629},[],{"_3572":73797,"_30844":73751,"_21377":124878,"_5":14632,"_28040":124761,"_3027":124879},[],"`settings.issuance_profile` incluido en el DMS",{"_3572":73798,"_30844":73751,"_21377":124881,"_5":14632,"_28040":124761,"_3027":124882},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3572":73799,"_30844":73751,"_21377":124884,"_5":14632,"_28040":124761,"_3027":124885},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3572":73800,"_30844":73751,"_21377":124887,"_5":14632,"_28040":124761,"_3027":124888},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3572":73801,"_30844":73751,"_21377":124890,"_5":14632,"_28040":124769,"_3027":124891},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3572":73802,"_30844":73751,"_21377":124893,"_5":14632,"_28040":124773,"_3027":124894},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3572":73803,"_30844":73751,"_21377":124896,"_5":14632,"_28040":124777,"_3027":124897},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3572":73804,"_30844":73751,"_21377":124899,"_5":14632,"_28040":124781,"_3027":124900},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3572":73805,"_30844":73751,"_21377":124902,"_5":14632,"_28040":124785,"_3027":124903},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3572":73806,"_30844":73751,"_21377":124905,"_5":14632,"_28040":124785,"_3027":124906},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3572":73807,"_30844":73751,"_21377":124908,"_5":14632,"_28040":124789,"_3027":124909},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3572":73808,"_30844":73751,"_21377":124911,"_5":14632,"_28040":124789,"_3027":124912},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3572":73809,"_30844":73751,"_21377":124914,"_5":14632,"_28040":124789,"_3027":124915},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3572":73810,"_30844":73751,"_21377":124917,"_5":14632,"_28040":124789,"_3027":124918},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3572":73811,"_30844":73751,"_21377":124920,"_5":14632,"_28040":124793,"_3027":124921},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3572":73812,"_30844":73751,"_21377":124923,"_5":14632,"_28040":124793,"_3027":124924},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3572":73813,"_30844":73813,"_5":14996,"_3027":124926,"_31202":124927,"_21377":124929,"_28040":73813},"Validación de certificados",[50349,120289,56039,124928],"Validación",[],{"_3572":73814,"_30844":73813,"_21377":124931,"_5":14632,"_28040":73813,"_3027":124932},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3572":73815,"_30844":73813,"_5":31199,"_21377":124934,"_28040":124935,"_3027":124936},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3572":73816,"_30844":73813,"_5":31199,"_21377":124938,"_28040":124939,"_3027":124940},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3572":73817,"_30844":73813,"_5":31199,"_21377":124942,"_28040":124943,"_3027":124944},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3572":73818,"_30844":73813,"_21377":124946,"_5":14632,"_28040":73813,"_3027":124947},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3572":73819,"_30844":73813,"_21377":124949,"_5":14632,"_28040":124935,"_3027":124950},[],"Verifica estos criterios juntos:",{"_3572":73820,"_30844":73813,"_21377":124952,"_5":14632,"_28040":124935,"_3027":123917},[],{"_3572":73821,"_30844":73813,"_21377":124954,"_5":14632,"_28040":124935,"_3027":124955},[],"Resultado necesario",{"_3572":73822,"_30844":73813,"_21377":124957,"_5":14632,"_28040":124935,"_3027":124958},[],"Cadena y firma",{"_3572":73823,"_30844":73813,"_21377":124960,"_5":14632,"_28040":124935,"_3027":124961},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3572":73824,"_30844":73813,"_21377":124963,"_5":14632,"_28040":124935,"_3027":124964},[],"Fechas",{"_3572":73825,"_30844":73813,"_21377":124966,"_5":14632,"_28040":124935,"_3027":124967},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3572":73826,"_30844":73813,"_21377":124969,"_5":14632,"_28040":124935,"_3027":119950},[],{"_3572":73827,"_30844":73813,"_21377":124971,"_5":14632,"_28040":124935,"_3027":124972},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3572":73828,"_30844":73813,"_21377":124974,"_5":14632,"_28040":124935,"_3027":124975},[],"Uso",{"_3572":73829,"_30844":73813,"_21377":124977,"_5":14632,"_28040":124935,"_3027":124978},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3572":73830,"_30844":73813,"_21377":124980,"_5":14632,"_28040":124935,"_3027":124981},[],"Revocación",{"_3572":73831,"_30844":73813,"_21377":124983,"_5":14632,"_28040":124935,"_3027":124984},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3572":73832,"_30844":73813,"_21377":124986,"_5":14632,"_28040":124935,"_3027":124987},[],"Autorización",{"_3572":73833,"_30844":73813,"_21377":124989,"_5":14632,"_28040":124935,"_3027":124990},[],"La aplicación permite la acción a esa identidad.",{"_3572":73834,"_30844":73813,"_21377":124992,"_5":14632,"_28040":124935,"_3027":124993},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3572":73835,"_30844":73813,"_21377":124995,"_5":14632,"_28040":124939,"_3027":124996},[],"Mecanismo",{"_3572":73836,"_30844":73813,"_21377":124998,"_5":14632,"_28040":124939,"_3027":124999},[],"Cuándo utilizarlo",{"_3572":73837,"_30844":73813,"_21377":125001,"_5":14632,"_28040":124939,"_3027":125002},[],"Qué debes mantener",{"_3572":73838,"_30844":73813,"_21377":125004,"_5":14632,"_28040":124939,"_3027":56757},[],{"_3572":73839,"_30844":73813,"_21377":125006,"_5":14632,"_28040":124939,"_3027":125007},[],"Consulta del estado de un certificado concreto.",{"_3572":73840,"_30844":73813,"_21377":125009,"_5":14632,"_28040":124939,"_3027":125010},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3572":73841,"_30844":73813,"_21377":125012,"_5":14632,"_28040":124939,"_3027":56766},[],{"_3572":73842,"_30844":73813,"_21377":125014,"_5":14632,"_28040":124939,"_3027":125015},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3572":73843,"_30844":73813,"_21377":125017,"_5":14632,"_28040":124939,"_3027":125018},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3572":73844,"_30844":73813,"_21377":125020,"_5":14632,"_28040":124939,"_3027":125021},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3572":73845,"_30844":73813,"_21377":125023,"_5":14632,"_28040":124939,"_3027":125024},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3572":73846,"_30844":73813,"_21377":125026,"_5":14632,"_28040":124943,"_3027":125027},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3572":73847,"_30844":73813,"_21377":125029,"_5":14632,"_28040":124943,"_3027":125030},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3572":73848,"_30844":73813,"_21377":125032,"_5":14632,"_28040":124943,"_3027":125033},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3572":73849,"_30844":73813,"_21377":125035,"_5":14632,"_28040":124943,"_3027":125036},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3572":73850,"_30844":73813,"_21377":125038,"_5":14632,"_28040":124943,"_3027":125039},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3572":73851,"_30844":73813,"_21377":125041,"_5":14632,"_28040":124943,"_3027":125042},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3572":73852,"_30844":73813,"_21377":125044,"_5":14632,"_28040":124943,"_3027":125045},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3572":73853,"_30844":73813,"_21377":125047,"_5":14632,"_28040":124943,"_3027":125048},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3572":73854,"_30844":73813,"_21377":125050,"_5":14632,"_28040":124943,"_3027":125051},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3572":73855,"_30844":73855,"_5":14996,"_3027":125053,"_31202":125054,"_21377":125055,"_28040":73855},"Certificados",[50349,120289,56039,124288],[],{"_3572":73856,"_30844":73855,"_21377":125057,"_5":14632,"_28040":73855,"_3027":125058},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3572":73857,"_30844":73855,"_5":31199,"_21377":125060,"_28040":125061,"_3027":125062},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3572":73858,"_30844":73855,"_5":31199,"_21377":125064,"_28040":125065,"_3027":125066},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3572":73859,"_30844":73855,"_5":31199,"_21377":125068,"_28040":125069,"_3027":125070},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3572":73860,"_30844":73855,"_5":31199,"_21377":125072,"_28040":125073,"_3027":125074},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3572":73861,"_30844":73855,"_5":31199,"_21377":125076,"_28040":125077,"_3027":125078},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3572":73862,"_30844":73855,"_5":31199,"_21377":125080,"_28040":125081,"_3027":125082},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3572":73863,"_30844":73855,"_5":31199,"_21377":125084,"_28040":125085,"_3027":125086},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3572":73864,"_30844":73855,"_5":31199,"_21377":125088,"_28040":125089,"_3027":125090},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3572":73865,"_30844":73855,"_5":31199,"_21377":125092,"_28040":125093,"_3027":125094},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#continúa","Continúa",{"_3572":73866,"_30844":73855,"_21377":125096,"_5":14632,"_28040":73855,"_3027":125097},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3572":73867,"_30844":73855,"_21377":125099,"_5":14632,"_28040":125061,"_3027":125100},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3572":73868,"_30844":73855,"_21377":125102,"_5":14632,"_28040":125061,"_3027":125103},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3572":73869,"_30844":73855,"_21377":125105,"_5":14632,"_28040":125061,"_3027":125106},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3572":73870,"_30844":73855,"_21377":125108,"_5":14632,"_28040":125061,"_3027":125109},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3572":73871,"_30844":73855,"_21377":125111,"_5":14632,"_28040":125061,"_3027":125112},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3572":73872,"_30844":73855,"_21377":125114,"_5":14632,"_28040":125061,"_3027":125115},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3572":73873,"_30844":73855,"_21377":125117,"_5":14632,"_28040":125061,"_3027":125118},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3572":73874,"_30844":73855,"_21377":125120,"_5":14632,"_28040":125065,"_3027":125121},[],"Descarga el PEM e inspecciónalo:",{"_3572":73875,"_30844":73855,"_21377":125123,"_5":14632,"_28040":125065,"_3027":125124},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3572":73876,"_30844":73855,"_21377":125126,"_5":14632,"_28040":125069,"_3027":125127},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3572":73877,"_30844":73855,"_21377":125129,"_5":14632,"_28040":125069,"_3027":125130},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3572":73878,"_30844":73855,"_21377":125132,"_5":14632,"_28040":125069,"_3027":125133},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3572":73879,"_30844":73855,"_21377":125135,"_5":14632,"_28040":125069,"_3027":125136},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3572":73880,"_30844":73855,"_21377":125138,"_5":14632,"_28040":125069,"_3027":125139},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3572":73881,"_30844":73855,"_21377":125141,"_5":14632,"_28040":125069,"_3027":125142},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3572":73882,"_30844":73855,"_21377":125144,"_5":14632,"_28040":125069,"_3027":125145},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3572":73883,"_30844":73855,"_21377":125147,"_5":14632,"_28040":125073,"_3027":125148},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3572":73884,"_30844":73855,"_21377":125150,"_5":14632,"_28040":125077,"_3027":125151},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3572":73885,"_30844":73855,"_21377":125153,"_5":14632,"_28040":125081,"_3027":125154},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3572":73886,"_30844":73855,"_21377":125156,"_5":14632,"_28040":125085,"_3027":125157},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3572":73887,"_30844":73855,"_21377":125159,"_5":14632,"_28040":125085,"_3027":125160},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3572":73888,"_30844":73855,"_21377":125162,"_5":14632,"_28040":125085,"_3027":125163},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3572":73889,"_30844":73855,"_21377":125165,"_5":14632,"_28040":125089,"_3027":125166},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3572":73890,"_30844":73855,"_21377":125168,"_5":14632,"_28040":125089,"_3027":125169},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3572":73891,"_30844":73855,"_21377":125171,"_5":14632,"_28040":125089,"_3027":125172},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3572":73892,"_30844":73855,"_21377":125174,"_5":14632,"_28040":125093,"_3027":125175},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3572":73893,"_30844":73855,"_21377":125177,"_5":14632,"_28040":125093,"_3027":125178},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3572":73894,"_30844":73894,"_5":14996,"_3027":125180,"_31202":125181,"_21377":125183,"_28040":73894},"Ciclo de vida de un certificado",[50349,120289,56039,125182],"Conceptos",[],{"_3572":73895,"_30844":73894,"_21377":125185,"_5":14632,"_28040":73894,"_3027":125186},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3572":73896,"_30844":73894,"_5":31199,"_21377":125188,"_28040":125189,"_3027":125190},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3572":73897,"_30844":73894,"_5":31199,"_21377":125192,"_28040":125193,"_3027":125194},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3572":73898,"_30844":73894,"_5":31199,"_21377":125196,"_28040":125197,"_3027":125198},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3572":73899,"_30844":73894,"_5":31199,"_21377":125200,"_28040":125201,"_3027":125202},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3572":73900,"_30844":73894,"_5":31199,"_21377":125204,"_28040":125205,"_3027":125206},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3572":73901,"_30844":73894,"_5":31199,"_21377":125208,"_28040":125209,"_3027":125210},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3572":73902,"_30844":73894,"_5":31199,"_21377":125212,"_28040":125213,"_3027":122911},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3572":73903,"_30844":73894,"_5":31199,"_21377":125215,"_28040":125216,"_3027":125217},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3572":73904,"_30844":73894,"_5":31199,"_21377":125219,"_28040":125220,"_3027":125221},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3572":73905,"_30844":73894,"_5":31199,"_21377":125223,"_28040":125224,"_3027":125225},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3572":73906,"_30844":73894,"_21377":125227,"_5":14632,"_28040":73894,"_3027":125228},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3572":73907,"_30844":73894,"_21377":125230,"_5":14632,"_28040":125193,"_3027":125231},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3572":73908,"_30844":73894,"_21377":125233,"_5":14632,"_28040":125197,"_3027":125234},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3572":73909,"_30844":73894,"_21377":125236,"_5":14632,"_28040":125201,"_3027":125237},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3572":73910,"_30844":73894,"_21377":125239,"_5":14632,"_28040":125205,"_3027":125240},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3572":73911,"_30844":73894,"_21377":125242,"_5":14632,"_28040":125209,"_3027":125243},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3572":73912,"_30844":73894,"_21377":125245,"_5":14632,"_28040":125213,"_3027":125246},[],"Lamassu persiste cuatro estados X.509:",{"_3572":73913,"_30844":73894,"_21377":125248,"_5":14632,"_28040":125213,"_3027":125249},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3572":73914,"_30844":73894,"_21377":125251,"_5":14632,"_28040":125213,"_3027":125252},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3572":73915,"_30844":73894,"_21377":125254,"_5":14632,"_28040":125213,"_3027":125255},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3572":73916,"_30844":73894,"_21377":125257,"_5":14632,"_28040":125213,"_3027":125258},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3572":73917,"_30844":73894,"_21377":125260,"_5":14632,"_28040":125213,"_3027":125261},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3572":73918,"_30844":73894,"_21377":125263,"_5":14632,"_28040":125216,"_3027":125264},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3572":73919,"_30844":73894,"_21377":125266,"_5":14632,"_28040":125216,"_3027":125267},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3572":73920,"_30844":73894,"_21377":125269,"_5":14632,"_28040":125216,"_3027":125270},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3572":73921,"_30844":73894,"_21377":125272,"_5":14632,"_28040":125220,"_3027":125273},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3572":73922,"_30844":73894,"_21377":125275,"_5":14632,"_28040":125220,"_3027":125276},[],"Antes de confirmar:",{"_3572":73923,"_30844":73894,"_21377":125278,"_5":14632,"_28040":125220,"_3027":125279},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3572":73924,"_30844":73894,"_21377":125281,"_5":14632,"_28040":125220,"_3027":125282},[],"Distribuye la nueva cadena de confianza.",{"_3572":73925,"_30844":73894,"_21377":125284,"_5":14632,"_28040":125220,"_3027":125285},[],"Reemite las identidades necesarias.",{"_3572":73926,"_30844":73894,"_21377":125287,"_5":14632,"_28040":125220,"_3027":125288},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3572":73927,"_30844":73894,"_21377":125290,"_5":14632,"_28040":125220,"_3027":125291},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3572":73928,"_30844":73894,"_21377":125293,"_5":14632,"_28040":125220,"_3027":125294},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3572":73929,"_30844":73894,"_21377":125296,"_5":14632,"_28040":125224,"_3027":125297},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3572":73930,"_30844":73894,"_21377":125299,"_5":14632,"_28040":125224,"_3027":125300},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3572":73931,"_30844":73894,"_21377":125302,"_5":14632,"_28040":125224,"_3027":125303},[],"Cambios de estado y razones de revocación.",{"_3572":73932,"_30844":73894,"_21377":125305,"_5":14632,"_28040":125224,"_3027":125306},[],"Publicación y vigencia de OCSP y CRLs.",{"_3572":73933,"_30844":73894,"_21377":125308,"_5":14632,"_28040":125224,"_3027":125309},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3572":73934,"_30844":73894,"_21377":125311,"_5":14632,"_28040":125224,"_3027":125312},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3572":73935,"_30844":73935,"_5":14996,"_3027":125314,"_31202":125315,"_21377":125316,"_28040":73935},"Modelo de confianza",[50349,120289,56039,125182],[],{"_3572":73936,"_30844":73935,"_21377":125318,"_5":14632,"_28040":73935,"_3027":125319},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3572":73937,"_30844":73935,"_5":31199,"_21377":125321,"_28040":125322,"_3027":125323},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3572":73938,"_30844":73935,"_5":31199,"_21377":125325,"_28040":125326,"_3027":125327},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3572":73939,"_30844":73935,"_5":31199,"_21377":125329,"_28040":125330,"_3027":125331},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3572":73940,"_30844":73935,"_5":31199,"_21377":125333,"_28040":125334,"_3027":125335},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3572":73941,"_30844":73935,"_5":31199,"_21377":125337,"_28040":125338,"_3027":125339},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3572":73942,"_30844":73935,"_5":31199,"_21377":125341,"_28040":125342,"_3027":125343},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3572":73943,"_30844":73935,"_5":31199,"_21377":125345,"_28040":125346,"_3027":125347},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3572":73944,"_30844":73935,"_5":31199,"_21377":125349,"_28040":125350,"_3027":125351},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3572":73945,"_30844":73935,"_5":31199,"_21377":125353,"_28040":125354,"_3027":125355},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3572":73946,"_30844":73935,"_5":31199,"_21377":125357,"_28040":125358,"_3027":125359},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3572":73947,"_30844":73935,"_21377":125361,"_5":14632,"_28040":73935,"_3027":125362},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3572":73948,"_30844":73935,"_21377":125364,"_5":14632,"_28040":125326,"_3027":125365},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3572":73949,"_30844":73935,"_21377":125367,"_5":14632,"_28040":125330,"_3027":125368},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3572":73950,"_30844":73935,"_21377":125370,"_5":14632,"_28040":125334,"_3027":125371},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3572":73951,"_30844":73935,"_21377":125373,"_5":14632,"_28040":125338,"_3027":125374},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3572":73952,"_30844":73935,"_21377":125376,"_5":14632,"_28040":125342,"_3027":125377},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3572":73953,"_30844":73935,"_21377":125379,"_5":14632,"_28040":125342,"_3027":125380},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3572":73954,"_30844":73935,"_21377":125382,"_5":14632,"_28040":125342,"_3027":125383},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3572":73955,"_30844":73935,"_21377":125385,"_5":14632,"_28040":125342,"_3027":125386},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3572":73956,"_30844":73935,"_21377":125388,"_5":14632,"_28040":125342,"_3027":125389},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3572":73957,"_30844":73935,"_21377":125391,"_5":14632,"_28040":125342,"_3027":125392},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3572":73958,"_30844":73935,"_21377":125394,"_5":14632,"_28040":125346,"_3027":125395},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3572":73959,"_30844":73935,"_21377":125397,"_5":14632,"_28040":125346,"_3027":125398},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3572":73960,"_30844":73935,"_21377":125400,"_5":14632,"_28040":125346,"_3027":125401},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3572":73961,"_30844":73935,"_21377":125403,"_5":14632,"_28040":125346,"_3027":125404},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3572":73962,"_30844":73935,"_21377":125406,"_5":14632,"_28040":125346,"_3027":125407},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3572":73963,"_30844":73935,"_21377":125409,"_5":14632,"_28040":125350,"_3027":125410},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3572":73964,"_30844":73935,"_21377":125412,"_5":14632,"_28040":125350,"_3027":125413},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3572":73965,"_30844":73935,"_21377":125415,"_5":14632,"_28040":125350,"_3027":125416},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3572":73966,"_30844":73935,"_21377":125418,"_5":14632,"_28040":125350,"_3027":125419},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3572":73967,"_30844":73935,"_21377":125421,"_5":14632,"_28040":125350,"_3027":125422},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3572":73968,"_30844":73935,"_21377":125424,"_5":14632,"_28040":125350,"_3027":125425},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3572":73969,"_30844":73935,"_21377":125427,"_5":14632,"_28040":125350,"_3027":125428},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3572":73970,"_30844":73935,"_21377":125430,"_5":14632,"_28040":125354,"_3027":125431},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3572":73971,"_30844":73935,"_21377":125433,"_5":14632,"_28040":125358,"_3027":125434},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3572":73972,"_30844":73935,"_21377":125436,"_5":14632,"_28040":125358,"_3027":125437},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3572":73973,"_30844":73935,"_21377":125439,"_5":14632,"_28040":125358,"_3027":125440},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3572":73974,"_30844":73935,"_21377":125442,"_5":14632,"_28040":125358,"_3027":125443},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3572":73975,"_30844":73935,"_21377":125445,"_5":14632,"_28040":125358,"_3027":125446},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3572":73976,"_30844":73935,"_21377":125448,"_5":14632,"_28040":125358,"_3027":125449},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3572":73977,"_30844":73935,"_21377":125451,"_5":14632,"_28040":125358,"_3027":125452},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3572":73978,"_30844":73978,"_5":14996,"_3027":125454,"_31202":125455,"_21377":125456,"_28040":73978},"Listas de revocación (CRL)",[50349,120289,56039,124928],[],{"_3572":73979,"_30844":73978,"_21377":125458,"_5":14632,"_28040":73978,"_3027":125459},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3572":73980,"_30844":73978,"_5":31199,"_21377":125461,"_28040":125462,"_3027":125463},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3572":73981,"_30844":73978,"_5":31199,"_21377":125465,"_28040":125466,"_3027":125467},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3572":73982,"_30844":73978,"_5":31199,"_21377":125469,"_28040":125470,"_3027":125471},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3572":73983,"_30844":73978,"_5":31199,"_21377":125473,"_28040":125474,"_3027":125475},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3572":73984,"_30844":73978,"_5":31199,"_21377":125477,"_28040":125478,"_3027":125479},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3572":73985,"_30844":73978,"_5":31199,"_21377":125481,"_28040":125482,"_3027":125483},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3572":73986,"_30844":73978,"_5":31199,"_21377":125485,"_28040":125486,"_3027":125487},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3572":73987,"_30844":73978,"_5":31199,"_21377":125489,"_28040":125490,"_3027":125491},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#referencias","Referencias",{"_3572":73988,"_30844":73978,"_21377":125493,"_5":14632,"_28040":73978,"_3027":125494},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3572":73989,"_30844":73978,"_21377":125496,"_5":14632,"_28040":125462,"_3027":125497},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3572":73990,"_30844":73978,"_21377":125499,"_5":14632,"_28040":125462,"_3027":125500},[],"Campo",{"_3572":73991,"_30844":73978,"_21377":125502,"_5":14632,"_28040":125462,"_3027":121951},[],{"_3572":73992,"_30844":73978,"_21377":125504,"_5":14632,"_28040":125462,"_3027":52008},[],{"_3572":73993,"_30844":73978,"_21377":125506,"_5":14632,"_28040":125462,"_3027":125507},[],"ID de la CA a la que pertenecen los ajustes.",{"_3572":73994,"_30844":73978,"_21377":125509,"_5":14632,"_28040":125462,"_3027":57265},[],{"_3572":73995,"_30844":73978,"_21377":125511,"_5":14632,"_28040":125462,"_3027":125512},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3572":73996,"_30844":73978,"_21377":125514,"_5":14632,"_28040":125462,"_3027":57271},[],{"_3572":73997,"_30844":73978,"_21377":125516,"_5":14632,"_28040":125462,"_3027":125517},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3572":73998,"_30844":73978,"_21377":125519,"_5":14632,"_28040":125462,"_3027":57277},[],{"_3572":73999,"_30844":73978,"_21377":125521,"_5":14632,"_28040":125462,"_3027":125522},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3572":74000,"_30844":73978,"_21377":125524,"_5":14632,"_28040":125462,"_3027":125525},[],"Campo de `crl_options`",{"_3572":74001,"_30844":73978,"_21377":125527,"_5":14632,"_28040":125462,"_3027":121951},[],{"_3572":74002,"_30844":73978,"_21377":125529,"_5":14632,"_28040":125462,"_3027":125530},[],"Valor inicial",{"_3572":74003,"_30844":73978,"_21377":125532,"_5":14632,"_28040":125462,"_3027":57291},[],{"_3572":74004,"_30844":73978,"_21377":125534,"_5":14632,"_28040":125462,"_3027":125535},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3572":74005,"_30844":73978,"_21377":125537,"_5":14632,"_28040":125462,"_3027":125538},[],"7 días.",{"_3572":74006,"_30844":73978,"_21377":125540,"_5":14632,"_28040":125462,"_3027":57300},[],{"_3572":74007,"_30844":73978,"_21377":125542,"_5":14632,"_28040":125462,"_3027":125543},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3572":74008,"_30844":73978,"_21377":125545,"_5":14632,"_28040":125462,"_3027":125546},[],"6 días y 23 horas.",{"_3572":74009,"_30844":73978,"_21377":125548,"_5":14632,"_28040":125462,"_3027":57309},[],{"_3572":74010,"_30844":73978,"_21377":125550,"_5":14632,"_28040":125462,"_3027":125551},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3572":74011,"_30844":73978,"_21377":125553,"_5":14632,"_28040":125462,"_3027":57315},[],{"_3572":74012,"_30844":73978,"_21377":125555,"_5":14632,"_28040":125462,"_3027":57318},[],{"_3572":74013,"_30844":73978,"_21377":125557,"_5":14632,"_28040":125462,"_3027":125558},[],"Número de serie del certificado existente que firma la CRL.",{"_3572":74014,"_30844":73978,"_21377":125560,"_5":14632,"_28040":125462,"_3027":125561},[],"Número de serie del certificado actual de la CA.",{"_3572":74015,"_30844":73978,"_21377":125563,"_5":14632,"_28040":125462,"_3027":125564},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3572":74016,"_30844":73978,"_21377":125566,"_5":14632,"_28040":125462,"_3027":125567},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3572":74017,"_30844":73978,"_21377":125569,"_5":14632,"_28040":125462,"_3027":125570},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3572":74018,"_30844":73978,"_21377":125572,"_5":14632,"_28040":125462,"_3027":125573},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3572":74019,"_30844":73978,"_21377":125575,"_5":14632,"_28040":125462,"_3027":125576},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3572":74020,"_30844":73978,"_21377":125578,"_5":14632,"_28040":125462,"_3027":125579},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3572":74021,"_30844":73978,"_21377":125581,"_5":14632,"_28040":125462,"_3027":125582},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3572":74022,"_30844":73978,"_21377":125584,"_5":14632,"_28040":125462,"_3027":125585},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3572":74023,"_30844":73978,"_21377":125587,"_5":14632,"_28040":125462,"_3027":125588},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3572":74024,"_30844":73978,"_21377":125590,"_5":14632,"_28040":125462,"_3027":125591},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3572":74025,"_30844":73978,"_21377":125593,"_5":14632,"_28040":125462,"_3027":125594},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3572":74026,"_30844":73978,"_21377":125596,"_5":14632,"_28040":125466,"_3027":125597},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3572":74027,"_30844":73978,"_21377":125599,"_5":14632,"_28040":125466,"_3027":125600},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3572":74028,"_30844":73978,"_21377":125602,"_5":14632,"_28040":125466,"_3027":125603},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3572":74029,"_30844":73978,"_21377":125605,"_5":14632,"_28040":125466,"_3027":125606},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3572":74030,"_30844":73978,"_21377":125608,"_5":14632,"_28040":125470,"_3027":125609},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3572":74031,"_30844":73978,"_21377":125611,"_5":14632,"_28040":125470,"_3027":125612},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3572":74032,"_30844":73978,"_21377":125614,"_5":14632,"_28040":125470,"_3027":125615},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3572":74033,"_30844":73978,"_21377":125617,"_5":14632,"_28040":125470,"_3027":125618},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3572":74034,"_30844":73978,"_21377":125620,"_5":14632,"_28040":125470,"_3027":125621},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3572":74035,"_30844":73978,"_21377":125623,"_5":14632,"_28040":125470,"_3027":125624},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3572":74036,"_30844":73978,"_21377":125626,"_5":14632,"_28040":125470,"_3027":125627},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3572":74037,"_30844":73978,"_21377":125629,"_5":14632,"_28040":125470,"_3027":125630},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3572":74038,"_30844":73978,"_21377":125632,"_5":14632,"_28040":125470,"_3027":125633},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3572":74039,"_30844":73978,"_21377":125635,"_5":14632,"_28040":125474,"_3027":125636},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3572":74040,"_30844":73978,"_21377":125638,"_5":14632,"_28040":125474,"_3027":125639},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3572":74041,"_30844":73978,"_21377":125641,"_5":14632,"_28040":125478,"_3027":125642},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3572":74042,"_30844":73978,"_21377":125644,"_5":14632,"_28040":125478,"_3027":125645},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3572":74043,"_30844":73978,"_21377":125647,"_5":14632,"_28040":125478,"_3027":125648},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3572":74044,"_30844":73978,"_21377":125650,"_5":14632,"_28040":125478,"_3027":125651},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3572":74045,"_30844":73978,"_21377":125653,"_5":14632,"_28040":125478,"_3027":125654},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3572":74046,"_30844":73978,"_21377":125656,"_5":14632,"_28040":125482,"_3027":125657},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3572":74047,"_30844":73978,"_21377":125659,"_5":14632,"_28040":125482,"_3027":122140},[],{"_3572":74048,"_30844":73978,"_21377":125661,"_5":14632,"_28040":125482,"_3027":125662},[],"Path relativo",{"_3572":74049,"_30844":73978,"_21377":125664,"_5":14632,"_28040":125482,"_3027":120040},[],{"_3572":74050,"_30844":73978,"_21377":125666,"_5":14632,"_28040":125482,"_3027":57430},[],{"_3572":74051,"_30844":73978,"_21377":125668,"_5":14632,"_28040":125482,"_3027":57433},[],{"_3572":74052,"_30844":73978,"_21377":125670,"_5":14632,"_28040":125482,"_3027":125671},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3572":74053,"_30844":73978,"_21377":125673,"_5":14632,"_28040":125482,"_3027":57430},[],{"_3572":74054,"_30844":73978,"_21377":125675,"_5":14632,"_28040":125482,"_3027":57441},[],{"_3572":74055,"_30844":73978,"_21377":125677,"_5":14632,"_28040":125482,"_3027":125678},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3572":74056,"_30844":73978,"_21377":125680,"_5":14632,"_28040":125482,"_3027":57447},[],{"_3572":74057,"_30844":73978,"_21377":125682,"_5":14632,"_28040":125482,"_3027":57441},[],{"_3572":74058,"_30844":73978,"_21377":125684,"_5":14632,"_28040":125482,"_3027":125685},[],"Sustituir la configuración de CRL de una CA.",{"_3572":74059,"_30844":73978,"_21377":125687,"_5":14632,"_28040":125482,"_3027":57455},[],{"_3572":74060,"_30844":73978,"_21377":125689,"_5":14632,"_28040":125482,"_3027":57441},[],{"_3572":74061,"_30844":73978,"_21377":125691,"_5":14632,"_28040":125482,"_3027":125692},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3572":74062,"_30844":73978,"_21377":125694,"_5":14632,"_28040":125482,"_3027":125695},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3572":74063,"_30844":73978,"_21377":125697,"_5":14632,"_28040":125482,"_3027":125698},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3572":74064,"_30844":73978,"_21377":125700,"_5":14632,"_28040":125482,"_3027":125701},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3572":74065,"_30844":73978,"_21377":125703,"_5":14632,"_28040":125486,"_3027":125704},[],"Síntoma",{"_3572":74066,"_30844":73978,"_21377":125706,"_5":14632,"_28040":125486,"_3027":125707},[],"Causa",{"_3572":74067,"_30844":73978,"_21377":125709,"_5":14632,"_28040":125486,"_3027":125710},[],"Acción",{"_3572":74068,"_30844":73978,"_21377":125712,"_5":14632,"_28040":125486,"_3027":125713},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3572":74069,"_30844":73978,"_21377":125715,"_5":14632,"_28040":125486,"_3027":125716},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3572":74070,"_30844":73978,"_21377":125718,"_5":14632,"_28040":125486,"_3027":125719},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3572":74071,"_30844":73978,"_21377":125721,"_5":14632,"_28040":125486,"_3027":125722},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3572":74072,"_30844":73978,"_21377":125724,"_5":14632,"_28040":125486,"_3027":125725},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3572":74073,"_30844":73978,"_21377":125727,"_5":14632,"_28040":125486,"_3027":125728},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3572":74074,"_30844":73978,"_21377":125730,"_5":14632,"_28040":125486,"_3027":125731},[],"`PUT` devuelve 400.",{"_3572":74075,"_30844":73978,"_21377":125733,"_5":14632,"_28040":125486,"_3027":125734},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3572":74076,"_30844":73978,"_21377":125736,"_5":14632,"_28040":125486,"_3027":125737},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3572":74077,"_30844":73978,"_21377":125739,"_5":14632,"_28040":125486,"_3027":125740},[],"`PUT` devuelve 404.",{"_3572":74078,"_30844":73978,"_21377":125742,"_5":14632,"_28040":125486,"_3027":125743},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3572":74079,"_30844":73978,"_21377":125745,"_5":14632,"_28040":125486,"_3027":125746},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3572":74080,"_30844":73978,"_21377":125748,"_5":14632,"_28040":125486,"_3027":125749},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3572":74081,"_30844":73978,"_21377":125751,"_5":14632,"_28040":125486,"_3027":125752},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3572":74082,"_30844":73978,"_21377":125754,"_5":14632,"_28040":125486,"_3027":125755},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3572":74083,"_30844":73978,"_21377":125757,"_5":14632,"_28040":125486,"_3027":125758},[],"La CRL no cambia tras revocar un certificado.",{"_3572":74084,"_30844":73978,"_21377":125760,"_5":14632,"_28040":125486,"_3027":125761},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3572":74085,"_30844":73978,"_21377":125763,"_5":14632,"_28040":125486,"_3027":125764},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3572":74086,"_30844":73978,"_21377":125766,"_5":14632,"_28040":125486,"_3027":125767},[],"Un verificador rechaza la CRL por el emisor.",{"_3572":74087,"_30844":73978,"_21377":125769,"_5":14632,"_28040":125486,"_3027":125770},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3572":74088,"_30844":73978,"_21377":125772,"_5":14632,"_28040":125486,"_3027":125773},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3572":74089,"_30844":73978,"_21377":125775,"_5":14632,"_28040":125490,"_3027":125776},[],"RFC 5280: perfil X.509 y CRL.",{"_3572":74090,"_30844":73978,"_21377":125778,"_5":14632,"_28040":125490,"_3027":57547},[],{"_3572":74091,"_30844":73978,"_21377":125780,"_5":14632,"_28040":125490,"_3027":57550},[],{"_3572":74092,"_30844":73978,"_21377":125782,"_5":14632,"_28040":125490,"_3027":125783},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3572":74093,"_30844":73978,"_21377":125785,"_5":14632,"_28040":125490,"_3027":125786},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3572":74094,"_30844":74094,"_5":14996,"_3027":125788,"_31202":125789,"_21377":125790,"_28040":74094},"Claves y motores criptográficos",[50349,120289,56039,124288],[],{"_3572":74095,"_30844":74094,"_21377":125792,"_5":14632,"_28040":74094,"_3027":125793},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3572":74096,"_30844":74094,"_5":31199,"_21377":125795,"_28040":125796,"_3027":125797},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3572":74097,"_30844":74094,"_5":31199,"_21377":125799,"_28040":125800,"_3027":125801},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3572":74098,"_30844":74094,"_5":31199,"_21377":125803,"_28040":125804,"_3027":57575},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#file-system",{"_3572":74099,"_30844":74094,"_5":31199,"_21377":125806,"_28040":125807,"_3027":57579},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#hashicorp-vault",{"_3572":74100,"_30844":74094,"_5":31199,"_21377":125809,"_28040":125810,"_3027":57583},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#aws-secrets-manager",{"_3572":74101,"_30844":74094,"_5":31199,"_21377":125812,"_28040":125813,"_3027":57587},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#aws-kms",{"_3572":74102,"_30844":74094,"_5":31199,"_21377":125815,"_28040":125816,"_3027":57591},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#pkcs11",{"_3572":74103,"_30844":74094,"_5":31199,"_21377":125818,"_28040":125819,"_3027":57595},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#azure-key-vault",{"_3572":74104,"_30844":74094,"_5":31199,"_21377":125821,"_28040":125822,"_3027":125823},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3572":74105,"_30844":74094,"_5":31199,"_21377":125825,"_28040":125826,"_3027":125827},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3572":74106,"_30844":74094,"_5":31199,"_21377":125829,"_28040":125830,"_3027":125831},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3572":74107,"_30844":74094,"_5":31199,"_21377":125833,"_28040":125834,"_3027":125835},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3572":74108,"_30844":74094,"_5":31199,"_21377":125837,"_28040":125838,"_3027":125839},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3572":74109,"_30844":74094,"_5":31199,"_21377":125841,"_28040":125842,"_3027":125843},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3572":74110,"_30844":74094,"_5":31199,"_21377":125845,"_28040":125846,"_3027":125847},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3572":74111,"_30844":74094,"_5":31199,"_21377":125849,"_28040":125850,"_3027":57627},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#sign",{"_3572":74112,"_30844":74094,"_5":31199,"_21377":125852,"_28040":125853,"_3027":57631},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#verify",{"_3572":74113,"_30844":74094,"_5":31199,"_21377":125855,"_28040":125856,"_3027":125857},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3572":74114,"_30844":74094,"_5":31199,"_21377":125859,"_28040":125860,"_3027":125861},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3572":74115,"_30844":74094,"_5":31199,"_21377":125863,"_28040":125864,"_3027":125865},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3572":74116,"_30844":74094,"_21377":125867,"_5":14632,"_28040":74094,"_3027":125868},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3572":74117,"_30844":74094,"_21377":125870,"_5":14632,"_28040":74094,"_3027":125871},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3572":74118,"_30844":74094,"_21377":125873,"_5":14632,"_28040":125796,"_3027":125874},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3572":74119,"_30844":74094,"_21377":125876,"_5":14632,"_28040":125796,"_3027":125877},[],"En la práctica, permite:",{"_3572":74120,"_30844":74094,"_21377":125879,"_5":14632,"_28040":125796,"_3027":125880},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3572":74121,"_30844":74094,"_21377":125882,"_5":14632,"_28040":125796,"_3027":125883},[],"Importar claves creadas externamente.",{"_3572":74122,"_30844":74094,"_21377":125885,"_5":14632,"_28040":125796,"_3027":125886},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3572":74123,"_30844":74094,"_21377":125888,"_5":14632,"_28040":125796,"_3027":125889},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3572":74124,"_30844":74094,"_21377":125891,"_5":14632,"_28040":125800,"_3027":125892},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3572":74125,"_30844":74094,"_21377":125894,"_5":14632,"_28040":125800,"_3027":125895},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3572":74126,"_30844":74094,"_21377":125897,"_5":14632,"_28040":125800,"_3027":125898},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3572":74127,"_30844":74094,"_21377":125900,"_5":14632,"_28040":125804,"_3027":125901},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3572":74128,"_30844":74094,"_21377":125903,"_5":14632,"_28040":125807,"_3027":125904},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3572":74129,"_30844":74094,"_21377":125906,"_5":14632,"_28040":125807,"_3027":125907},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3572":74130,"_30844":74094,"_21377":125909,"_5":14632,"_28040":125810,"_3027":125910},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3572":74131,"_30844":74094,"_21377":125912,"_5":14632,"_28040":125813,"_3027":125913},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3572":74132,"_30844":74094,"_21377":125915,"_5":14632,"_28040":125816,"_3027":125916},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3572":74133,"_30844":74094,"_21377":125918,"_5":14632,"_28040":125819,"_3027":125919},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3572":74134,"_30844":74094,"_21377":125921,"_5":14632,"_28040":125819,"_3027":125922},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3572":74135,"_30844":74094,"_21377":125924,"_5":14632,"_28040":125819,"_3027":125925},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3572":74136,"_30844":74094,"_21377":125927,"_5":14632,"_28040":125819,"_3027":125928},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3572":74137,"_30844":74094,"_21377":125930,"_5":14632,"_28040":125822,"_3027":125931},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3572":74138,"_30844":74094,"_21377":125933,"_5":14632,"_28040":125822,"_3027":125934},[],"La tabla incluye los siguientes campos:",{"_3572":74139,"_30844":74094,"_21377":125936,"_5":14632,"_28040":125822,"_3027":125937},[],"**Name**: nombre descriptivo de la clave.",{"_3572":74140,"_30844":74094,"_21377":125939,"_5":14632,"_28040":125822,"_3027":125940},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3572":74141,"_30844":74094,"_21377":125942,"_5":14632,"_28040":125822,"_3027":125943},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3572":74142,"_30844":74094,"_21377":125945,"_5":14632,"_28040":125822,"_3027":125946},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3572":74143,"_30844":74094,"_21377":125948,"_5":14632,"_28040":125822,"_3027":125949},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3572":74144,"_30844":74094,"_21377":125951,"_5":14632,"_28040":125822,"_3027":125952},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3572":74145,"_30844":74094,"_21377":125954,"_5":14632,"_28040":125822,"_3027":125955},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3572":74146,"_30844":74094,"_21377":125957,"_5":14632,"_28040":125822,"_3027":125958},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3572":74147,"_30844":74094,"_21377":125960,"_5":14632,"_28040":125822,"_3027":125961},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3572":74148,"_30844":74094,"_21377":125963,"_5":14632,"_28040":125822,"_3027":125964},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3572":74149,"_30844":74094,"_21377":125966,"_5":14632,"_28040":125822,"_3027":125967},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3572":74150,"_30844":74094,"_21377":125969,"_5":14632,"_28040":125822,"_3027":125970},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3572":74151,"_30844":74094,"_21377":125972,"_5":14632,"_28040":125822,"_3027":125973},[],"**Delete Key** para eliminar la clave del sistema.",{"_3572":74152,"_30844":74094,"_21377":125975,"_5":14632,"_28040":125826,"_3027":125976},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3572":74153,"_30844":74094,"_21377":125978,"_5":14632,"_28040":125830,"_3027":125979},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3572":74154,"_30844":74094,"_21377":125981,"_5":14632,"_28040":125830,"_3027":125982},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3572":74155,"_30844":74094,"_21377":125984,"_5":14632,"_28040":125830,"_3027":125985},[],"**Key Name**: nombre único y descriptivo.",{"_3572":74156,"_30844":74094,"_21377":125987,"_5":14632,"_28040":125830,"_3027":125988},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3572":74157,"_30844":74094,"_21377":125990,"_5":14632,"_28040":125830,"_3027":125991},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3572":74158,"_30844":74094,"_21377":125993,"_5":14632,"_28040":125830,"_3027":125994},[],"**Tags**: metadatos para clasificar la clave.",{"_3572":74159,"_30844":74094,"_21377":125996,"_5":14632,"_28040":125830,"_3027":125997},[],"**Metadata**: información adicional para usos avanzados.",{"_3572":74160,"_30844":74094,"_21377":125999,"_5":14632,"_28040":125834,"_3027":126000},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3572":74161,"_30844":74094,"_21377":126002,"_5":14632,"_28040":125834,"_3027":126003},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3572":74162,"_30844":74094,"_21377":126005,"_5":14632,"_28040":125834,"_3027":126006},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3572":74163,"_30844":74094,"_21377":126008,"_5":14632,"_28040":125834,"_3027":126009},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3572":74164,"_30844":74094,"_21377":126011,"_5":14632,"_28040":125834,"_3027":126012},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3572":74165,"_30844":74094,"_21377":126014,"_5":14632,"_28040":125834,"_3027":126015},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3572":74166,"_30844":74094,"_21377":126017,"_5":14632,"_28040":125834,"_3027":126018},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3572":74167,"_30844":74094,"_21377":126020,"_5":14632,"_28040":125834,"_3027":126021},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3572":74168,"_30844":74094,"_21377":126023,"_5":14632,"_28040":125834,"_3027":126024},[],"**Metadata**: información adicional opcional.",{"_3572":74169,"_30844":74094,"_21377":126026,"_5":14632,"_28040":125834,"_3027":126027},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3572":74170,"_30844":74094,"_21377":126029,"_5":14632,"_28040":125834,"_3027":126030},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3572":74171,"_30844":74094,"_21377":126032,"_5":14632,"_28040":125838,"_3027":126033},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3572":74172,"_30844":74094,"_21377":126035,"_5":14632,"_28040":125842,"_3027":126036},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3572":74173,"_30844":74094,"_21377":126038,"_5":14632,"_28040":125842,"_3027":126039},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3572":74174,"_30844":74094,"_21377":126041,"_5":14632,"_28040":125842,"_3027":126042},[],"**Key Name**: nombre descriptivo.",{"_3572":74175,"_30844":74094,"_21377":126044,"_5":14632,"_28040":125842,"_3027":126045},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3572":74176,"_30844":74094,"_21377":126047,"_5":14632,"_28040":125842,"_3027":126048},[],"**Tags**: etiquetas asociadas.",{"_3572":74177,"_30844":74094,"_21377":126050,"_5":14632,"_28040":125842,"_3027":126051},[],"**Aliases**: nombres alternativos.",{"_3572":74178,"_30844":74094,"_21377":126053,"_5":14632,"_28040":125842,"_3027":126054},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3572":74179,"_30844":74094,"_21377":126056,"_5":14632,"_28040":125842,"_3027":126057},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3572":74180,"_30844":74094,"_21377":126059,"_5":14632,"_28040":125842,"_3027":126060},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3572":74181,"_30844":74094,"_21377":126062,"_5":14632,"_28040":125842,"_3027":126063},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3572":74182,"_30844":74094,"_21377":126065,"_5":14632,"_28040":125846,"_3027":126066},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3572":74183,"_30844":74094,"_21377":126068,"_5":14632,"_28040":125846,"_3027":126069},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3572":74184,"_30844":74094,"_21377":126071,"_5":14632,"_28040":125846,"_3027":126072},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3572":74185,"_30844":74094,"_21377":126074,"_5":14632,"_28040":125850,"_3027":126075},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3572":74186,"_30844":74094,"_21377":126077,"_5":14632,"_28040":125850,"_3027":126078},[],"Campos principales:",{"_3572":74187,"_30844":74094,"_21377":126080,"_5":14632,"_28040":125850,"_3027":126081},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3572":74188,"_30844":74094,"_21377":126083,"_5":14632,"_28040":125850,"_3027":126084},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3572":74189,"_30844":74094,"_21377":126086,"_5":14632,"_28040":125850,"_3027":126087},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3572":74190,"_30844":74094,"_21377":126089,"_5":14632,"_28040":125850,"_3027":126090},[],"**Message**: contenido que se va a firmar.",{"_3572":74191,"_30844":74094,"_21377":126092,"_5":14632,"_28040":125850,"_3027":126093},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3572":74192,"_30844":74094,"_21377":126095,"_5":14632,"_28040":125853,"_3027":126096},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3572":74193,"_30844":74094,"_21377":126098,"_5":14632,"_28040":125853,"_3027":126078},[],{"_3572":74194,"_30844":74094,"_21377":126100,"_5":14632,"_28040":125853,"_3027":126101},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3572":74195,"_30844":74094,"_21377":126103,"_5":14632,"_28040":125853,"_3027":126104},[],"**Message Type**: `Raw` o `Digest`.",{"_3572":74196,"_30844":74094,"_21377":126106,"_5":14632,"_28040":125853,"_3027":126107},[],"**Payload Encoding**: codificación del mensaje.",{"_3572":74197,"_30844":74094,"_21377":126109,"_5":14632,"_28040":125853,"_3027":126110},[],"**Message**: mensaje original o hash.",{"_3572":74198,"_30844":74094,"_21377":126112,"_5":14632,"_28040":125853,"_3027":126113},[],"**Signature**: firma que se desea comprobar.",{"_3572":74199,"_30844":74094,"_21377":126115,"_5":14632,"_28040":125853,"_3027":126116},[],"**Result**: indicador del resultado de la validación.",{"_3572":74200,"_30844":74094,"_21377":126118,"_5":14632,"_28040":125856,"_3027":126119},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3572":74201,"_30844":74094,"_21377":126121,"_5":14632,"_28040":125856,"_3027":126122},[],"Este flujo es útil para:",{"_3572":74202,"_30844":74094,"_21377":126124,"_5":14632,"_28040":125856,"_3027":126125},[],"Solicitar certificados a una CA externa.",{"_3572":74203,"_30844":74094,"_21377":126127,"_5":14632,"_28040":125856,"_3027":126128},[],"Renovar una identidad manteniendo la misma clave.",{"_3572":74204,"_30844":74094,"_21377":126130,"_5":14632,"_28040":125856,"_3027":126131},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3572":74205,"_30844":74094,"_21377":126133,"_5":14632,"_28040":125856,"_3027":126134},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3572":74206,"_30844":74094,"_21377":126136,"_5":14632,"_28040":125856,"_3027":126137},[],"**Organization (O)**: organización o empresa.",{"_3572":74207,"_30844":74094,"_21377":126139,"_5":14632,"_28040":125856,"_3027":126140},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3572":74208,"_30844":74094,"_21377":126142,"_5":14632,"_28040":125856,"_3027":126143},[],"**Country (C)**: código de país de dos letras.",{"_3572":74209,"_30844":74094,"_21377":126145,"_5":14632,"_28040":125856,"_3027":126146},[],"**State / Province (ST)**: estado o provincia.",{"_3572":74210,"_30844":74094,"_21377":126148,"_5":14632,"_28040":125856,"_3027":126149},[],"**Locality (L)**: ciudad o localidad.",{"_3572":74211,"_30844":74094,"_21377":126151,"_5":14632,"_28040":125856,"_3027":126152},[],"**Email Address**: correo de contacto.",{"_3572":74212,"_30844":74094,"_21377":126154,"_5":14632,"_28040":125856,"_3027":126155},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3572":74213,"_30844":74094,"_21377":126157,"_5":14632,"_28040":125856,"_3027":126158},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3572":74214,"_30844":74094,"_21377":126160,"_5":14632,"_28040":125860,"_3027":126161},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3572":74215,"_30844":74094,"_21377":126163,"_5":14632,"_28040":125860,"_3027":126164},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3572":74216,"_30844":74094,"_21377":126166,"_5":14632,"_28040":125864,"_3027":126167},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3572":74217,"_30844":74094,"_21377":126169,"_5":14632,"_28040":125864,"_3027":126170},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3572":74218,"_30844":74218,"_5":14996,"_3027":126172,"_31202":126173,"_21377":126174,"_28040":74218},"Validación online con OCSP",[50349,120289,56039,124928],[],{"_3572":74219,"_30844":74218,"_21377":126176,"_5":14632,"_28040":74218,"_3027":126177},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3572":74220,"_30844":74218,"_5":31199,"_21377":126179,"_28040":126180,"_3027":126181},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3572":74221,"_30844":74218,"_5":31199,"_21377":126183,"_28040":126184,"_3027":126185},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3572":74222,"_30844":74218,"_5":31199,"_21377":126187,"_28040":126188,"_3027":126189},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3572":74223,"_30844":74218,"_5":31199,"_21377":126191,"_28040":126192,"_3027":126193},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3572":74224,"_30844":74218,"_5":31199,"_21377":126195,"_28040":126196,"_3027":126197},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3572":74225,"_30844":74218,"_5":31199,"_21377":126199,"_28040":126200,"_3027":125491},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#referencias",{"_3572":74226,"_30844":74218,"_21377":126202,"_5":14632,"_28040":74218,"_3027":126203},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3572":74227,"_30844":74218,"_21377":126205,"_5":14632,"_28040":126180,"_3027":126206},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3572":74228,"_30844":74218,"_21377":126208,"_5":14632,"_28040":126180,"_3027":126209},[],"Estado del registro",{"_3572":74229,"_30844":74218,"_21377":126211,"_5":14632,"_28040":126180,"_3027":126212},[],"Respuesta firmada",{"_3572":74230,"_30844":74218,"_21377":126214,"_5":14632,"_28040":126180,"_3027":55176},[],{"_3572":74231,"_30844":74218,"_21377":126216,"_5":14632,"_28040":126180,"_3027":57995},[],{"_3572":74232,"_30844":74218,"_21377":126218,"_5":14632,"_28040":126180,"_3027":55193},[],{"_3572":74233,"_30844":74218,"_21377":126220,"_5":14632,"_28040":126180,"_3027":126221},[],"`Revoked`, con razón y fecha de revocación.",{"_3572":74234,"_30844":74218,"_21377":126223,"_5":14632,"_28040":126180,"_3027":126224},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3572":74235,"_30844":74218,"_21377":126226,"_5":14632,"_28040":126180,"_3027":126227},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3572":74236,"_30844":74218,"_21377":126229,"_5":14632,"_28040":126180,"_3027":126230},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3572":74237,"_30844":74218,"_21377":126232,"_5":14632,"_28040":126180,"_3027":126233},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3572":74238,"_30844":74218,"_21377":126235,"_5":14632,"_28040":126180,"_3027":126236},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3572":74239,"_30844":74218,"_21377":126238,"_5":14632,"_28040":126184,"_3027":126239},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3572":74240,"_30844":74218,"_21377":126241,"_5":14632,"_28040":126184,"_3027":126242},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3572":74241,"_30844":74218,"_21377":126244,"_5":14632,"_28040":126188,"_3027":126245},[],"El servicio acepta:",{"_3572":74242,"_30844":74218,"_21377":126247,"_5":14632,"_28040":126188,"_3027":122140},[],{"_3572":74243,"_30844":74218,"_21377":126249,"_5":14632,"_28040":126188,"_3027":126250},[],"Ruta del servicio VA",{"_3572":74244,"_30844":74218,"_21377":126252,"_5":14632,"_28040":126188,"_3027":126253},[],"Formato",{"_3572":74245,"_30844":74218,"_21377":126255,"_5":14632,"_28040":126188,"_3027":58035},[],{"_3572":74246,"_30844":74218,"_21377":126257,"_5":14632,"_28040":126188,"_3027":58038},[],{"_3572":74247,"_30844":74218,"_21377":126259,"_5":14632,"_28040":126188,"_3027":126260},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3572":74248,"_30844":74218,"_21377":126262,"_5":14632,"_28040":126188,"_3027":57430},[],{"_3572":74249,"_30844":74218,"_21377":126264,"_5":14632,"_28040":126188,"_3027":58046},[],{"_3572":74250,"_30844":74218,"_21377":126266,"_5":14632,"_28040":126188,"_3027":126267},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3572":74251,"_30844":74218,"_21377":126269,"_5":14632,"_28040":126188,"_3027":126270},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3572":74252,"_30844":74218,"_21377":126272,"_5":14632,"_28040":126192,"_3027":126273},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3572":74253,"_30844":74218,"_21377":126275,"_5":14632,"_28040":126192,"_3027":126276},[],"Genera la solicitud:",{"_3572":74254,"_30844":74218,"_21377":126278,"_5":14632,"_28040":126192,"_3027":126279},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3572":74255,"_30844":74218,"_21377":126281,"_5":14632,"_28040":126192,"_3027":126282},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3572":74256,"_30844":74218,"_21377":126284,"_5":14632,"_28040":126192,"_3027":126285},[],"Verifica el DER recibido:",{"_3572":74257,"_30844":74218,"_21377":126287,"_5":14632,"_28040":126192,"_3027":126288},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3572":74258,"_30844":74218,"_21377":126290,"_5":14632,"_28040":126196,"_3027":126291},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3572":74259,"_30844":74218,"_21377":126293,"_5":14632,"_28040":126196,"_3027":126294},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3572":74260,"_30844":74218,"_21377":126296,"_5":14632,"_28040":126200,"_3027":58079},[],{"_3572":74261,"_30844":74218,"_21377":126298,"_5":14632,"_28040":126200,"_3027":58082},[],{"_3572":74262,"_30844":74218,"_21377":126300,"_5":14632,"_28040":126200,"_3027":126301},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3572":74263,"_30844":74218,"_21377":126303,"_5":14632,"_28040":126200,"_3027":125786},[],{"_3572":74264,"_30844":74264,"_5":14996,"_3027":56039,"_31202":126305,"_21377":126306,"_28040":74264},[50349,120289,56039],[],{"_3572":74265,"_30844":74264,"_21377":126308,"_5":14632,"_28040":74264,"_3027":126309},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3572":74266,"_30844":74264,"_5":31199,"_21377":126311,"_28040":126312,"_3027":123614},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#empieza-aquí",{"_3572":74267,"_30844":74264,"_5":31199,"_21377":126314,"_28040":126315,"_3027":126316},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3572":74268,"_30844":74264,"_5":31199,"_21377":126318,"_28040":126319,"_3027":124134},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#capacidades-principales",{"_3572":74269,"_30844":74264,"_5":31199,"_21377":126321,"_28040":126322,"_3027":124138},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3572":74270,"_30844":74264,"_5":31199,"_21377":126324,"_28040":126325,"_3027":124142},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3572":74271,"_30844":74264,"_5":31199,"_21377":126327,"_28040":126328,"_3027":124146},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#emite-y-controla-certificados",{"_3572":74272,"_30844":74264,"_5":31199,"_21377":126330,"_28040":126331,"_3027":124154},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#publica-el-estado-de-validación",{"_3572":74273,"_30844":74264,"_5":31199,"_21377":126333,"_28040":126334,"_3027":126335},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3572":74274,"_30844":74264,"_5":31199,"_21377":126337,"_28040":126338,"_3027":125094},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#continúa",{"_3572":74275,"_30844":74264,"_21377":126340,"_5":14632,"_28040":74264,"_3027":126341},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3572":74276,"_30844":74264,"_21377":126343,"_5":14632,"_28040":126312,"_3027":126344},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3572":74277,"_30844":74264,"_21377":126346,"_5":14632,"_28040":126312,"_3027":126347},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3572":74278,"_30844":74264,"_21377":126349,"_5":14632,"_28040":126315,"_3027":126350},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3572":74279,"_30844":74264,"_21377":126352,"_5":14632,"_28040":126315,"_3027":126353},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3572":74280,"_30844":74264,"_21377":126355,"_5":14632,"_28040":126315,"_3027":126356},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3572":74281,"_30844":74264,"_21377":126358,"_5":14632,"_28040":126315,"_3027":126359},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3572":74282,"_30844":74264,"_21377":126361,"_5":14632,"_28040":126315,"_3027":126362},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3572":74283,"_30844":74264,"_21377":126364,"_5":14632,"_28040":126322,"_3027":126365},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3572":74284,"_30844":74264,"_21377":126367,"_5":14632,"_28040":126325,"_3027":126368},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3572":74285,"_30844":74264,"_21377":126370,"_5":14632,"_28040":126328,"_3027":126371},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3572":74286,"_30844":74264,"_21377":126373,"_5":14632,"_28040":126331,"_3027":126374},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3572":74287,"_30844":74264,"_21377":126376,"_5":14632,"_28040":126334,"_3027":126377},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3572":74288,"_30844":74264,"_21377":126379,"_5":14632,"_28040":126334,"_3027":126380},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3572":74289,"_30844":74264,"_21377":126382,"_5":14632,"_28040":126334,"_3027":126383},[],"su clave pública corresponda a la clave privada del cliente;",{"_3572":74290,"_30844":74264,"_21377":126385,"_5":14632,"_28040":126334,"_3027":126386},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3572":74291,"_30844":74264,"_21377":126388,"_5":14632,"_28040":126334,"_3027":126389},[],"sus fechas y usos permitan la operación;",{"_3572":74292,"_30844":74264,"_21377":126391,"_5":14632,"_28040":126334,"_3027":126392},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3572":74293,"_30844":74264,"_21377":126394,"_5":14632,"_28040":126334,"_3027":126395},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3572":74294,"_30844":74264,"_21377":126397,"_5":14632,"_28040":126338,"_3027":126398},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3572":74295,"_30844":74264,"_21377":126400,"_5":14632,"_28040":126338,"_3027":126401},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3572":74296,"_30844":74264,"_21377":126403,"_5":14632,"_28040":126338,"_3027":126404},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3572":74297,"_30844":74297,"_5":14996,"_3027":126406,"_31202":126407,"_21377":126408,"_28040":74297},"Crea tu primera CA",[50349,120289,56039,123738],[],{"_3572":74298,"_30844":74297,"_21377":126410,"_5":14632,"_28040":74297,"_3027":126411},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3572":74299,"_30844":74297,"_5":31199,"_21377":126413,"_28040":126414,"_3027":118802},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3572":74300,"_30844":74297,"_5":31199,"_21377":126416,"_28040":126417,"_3027":126418},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3572":74301,"_30844":74297,"_5":31199,"_21377":126420,"_28040":126421,"_3027":126422},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3572":74302,"_30844":74297,"_5":31199,"_21377":126424,"_28040":126425,"_3027":126426},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3572":74303,"_30844":74297,"_5":31199,"_21377":126428,"_28040":126429,"_3027":126430},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3572":74304,"_30844":74297,"_5":31199,"_21377":126432,"_28040":126433,"_3027":126434},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3572":74305,"_30844":74297,"_5":31199,"_21377":126436,"_28040":126437,"_3027":126438},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3572":74306,"_30844":74297,"_5":31199,"_21377":126440,"_28040":126441,"_3027":123985},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3572":74307,"_30844":74297,"_5":31199,"_21377":126443,"_28040":126444,"_3027":118826},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3572":74308,"_30844":74297,"_21377":126446,"_5":14632,"_28040":74297,"_3027":126447},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3572":74309,"_30844":74297,"_21377":126449,"_5":14632,"_28040":126414,"_3027":126450},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3572":74310,"_30844":74297,"_21377":126452,"_5":14632,"_28040":126414,"_3027":126453},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3572":74311,"_30844":74297,"_21377":126455,"_5":14632,"_28040":126414,"_3027":126456},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3572":74312,"_30844":74297,"_21377":126458,"_5":14632,"_28040":126414,"_3027":126459},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3572":74313,"_30844":74297,"_21377":126461,"_5":14632,"_28040":126417,"_3027":126462},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3572":74314,"_30844":74297,"_21377":126464,"_5":14632,"_28040":126417,"_3027":126465},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3572":74315,"_30844":74297,"_21377":126467,"_5":14632,"_28040":126421,"_3027":126468},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3572":74316,"_30844":74297,"_21377":126470,"_5":14632,"_28040":126421,"_3027":126471},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3572":74317,"_30844":74297,"_21377":126473,"_5":14632,"_28040":126425,"_3027":126474},[],"Selecciona **Root CA** y completa:",{"_3572":74318,"_30844":74297,"_21377":126476,"_5":14632,"_28040":126425,"_3027":58261},[],{"_3572":74319,"_30844":74297,"_21377":126478,"_5":14632,"_28040":126425,"_3027":126479},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3572":74320,"_30844":74297,"_21377":126481,"_5":14632,"_28040":126425,"_3027":126482},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3572":74321,"_30844":74297,"_21377":126484,"_5":14632,"_28040":126425,"_3027":126485},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3572":74322,"_30844":74297,"_21377":126487,"_5":14632,"_28040":126425,"_3027":126488},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3572":74323,"_30844":74297,"_21377":126490,"_5":14632,"_28040":126429,"_3027":126491},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3572":74324,"_30844":74297,"_21377":126493,"_5":14632,"_28040":126433,"_3027":126494},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3572":74325,"_30844":74297,"_21377":126496,"_5":14632,"_28040":126433,"_3027":126497},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3572":74326,"_30844":74297,"_21377":126499,"_5":14632,"_28040":126437,"_3027":126500},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3572":74327,"_30844":74297,"_21377":126502,"_5":14632,"_28040":126437,"_3027":126503},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3572":74328,"_30844":74297,"_21377":126505,"_5":14632,"_28040":126437,"_3027":126506},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3572":74329,"_30844":74297,"_21377":126508,"_5":14632,"_28040":126441,"_3027":126509},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3572":74330,"_30844":74297,"_21377":126511,"_5":14632,"_28040":126441,"_3027":126512},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3572":74331,"_30844":74297,"_21377":126514,"_5":14632,"_28040":126441,"_3027":126515},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3572":74332,"_30844":74297,"_21377":126517,"_5":14632,"_28040":126441,"_3027":126518},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3572":74333,"_30844":74297,"_21377":126520,"_5":14632,"_28040":126444,"_3027":126521},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3572":74334,"_30844":74334,"_5":14996,"_3027":126523,"_31202":126524,"_21377":126525,"_28040":74334},"Emite y verifica un certificado",[50349,120289,56039,123738],[],{"_3572":74335,"_30844":74334,"_21377":126527,"_5":14632,"_28040":74334,"_3027":126528},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3572":74336,"_30844":74334,"_5":31199,"_21377":126530,"_28040":126531,"_3027":118802},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3572":74337,"_30844":74334,"_5":31199,"_21377":126533,"_28040":126534,"_3027":126535},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3572":74338,"_30844":74334,"_5":31199,"_21377":126537,"_28040":126538,"_3027":126539},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3572":74339,"_30844":74334,"_5":31199,"_21377":126541,"_28040":126542,"_3027":126543},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3572":74340,"_30844":74334,"_5":31199,"_21377":126545,"_28040":126546,"_3027":126547},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3572":74341,"_30844":74334,"_5":31199,"_21377":126549,"_28040":126550,"_3027":126551},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3572":74342,"_30844":74334,"_5":31199,"_21377":126553,"_28040":126554,"_3027":126555},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3572":74343,"_30844":74334,"_5":31199,"_21377":126557,"_28040":126558,"_3027":126559},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3572":74344,"_30844":74334,"_5":31199,"_21377":126561,"_28040":126562,"_3027":126563},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3572":74345,"_30844":74334,"_5":31199,"_21377":126565,"_28040":126566,"_3027":126567},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3572":74346,"_30844":74334,"_5":31199,"_21377":126569,"_28040":126570,"_3027":123985},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3572":74347,"_30844":74334,"_5":31199,"_21377":126572,"_28040":126573,"_3027":118826},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3572":74348,"_30844":74334,"_21377":126575,"_5":14632,"_28040":74334,"_3027":126576},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3572":74349,"_30844":74334,"_21377":126578,"_5":14632,"_28040":126531,"_3027":126579},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3572":74350,"_30844":74334,"_21377":126581,"_5":14632,"_28040":126531,"_3027":126582},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3572":74351,"_30844":74334,"_21377":126584,"_5":14632,"_28040":126531,"_3027":126585},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3572":74352,"_30844":74334,"_21377":126587,"_5":14632,"_28040":126531,"_3027":126588},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3572":74353,"_30844":74334,"_21377":126590,"_5":14632,"_28040":126531,"_3027":126591},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3572":74354,"_30844":74334,"_21377":126593,"_5":14632,"_28040":126534,"_3027":126594},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3572":74355,"_30844":74334,"_21377":126596,"_5":14632,"_28040":126538,"_3027":126597},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3572":74356,"_30844":74334,"_21377":126599,"_5":14632,"_28040":126538,"_3027":126600},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3572":74357,"_30844":74334,"_21377":126602,"_5":14632,"_28040":126542,"_3027":126603},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3572":74358,"_30844":74334,"_21377":126605,"_5":14632,"_28040":126542,"_3027":126606},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3572":74359,"_30844":74334,"_21377":126608,"_5":14632,"_28040":126546,"_3027":126609},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3572":74360,"_30844":74334,"_21377":126611,"_5":14632,"_28040":126546,"_3027":126612},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3572":74361,"_30844":74334,"_21377":126614,"_5":14632,"_28040":126550,"_3027":126615},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3572":74362,"_30844":74334,"_21377":126617,"_5":14632,"_28040":126554,"_3027":126618},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3572":74363,"_30844":74334,"_21377":126620,"_5":14632,"_28040":126558,"_3027":126621},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3572":74364,"_30844":74334,"_21377":126623,"_5":14632,"_28040":126562,"_3027":126624},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3572":74365,"_30844":74334,"_21377":126626,"_5":14632,"_28040":126562,"_3027":126627},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3572":74366,"_30844":74334,"_21377":126629,"_5":14632,"_28040":126562,"_3027":126630},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3572":74367,"_30844":74334,"_21377":126632,"_5":14632,"_28040":126566,"_3027":126633},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3572":74368,"_30844":74334,"_21377":126635,"_5":14632,"_28040":126566,"_3027":126636},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3572":74369,"_30844":74334,"_21377":126638,"_5":14632,"_28040":126566,"_3027":126639},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3572":74370,"_30844":74334,"_21377":126641,"_5":14632,"_28040":126570,"_3027":124068},[],{"_3572":74371,"_30844":74334,"_21377":126643,"_5":14632,"_28040":126570,"_3027":122589},[],{"_3572":74372,"_30844":74334,"_21377":126645,"_5":14632,"_28040":126570,"_3027":126646},[],"La CA rechaza la emisión",{"_3572":74373,"_30844":74334,"_21377":126648,"_5":14632,"_28040":126570,"_3027":126649},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3572":74374,"_30844":74334,"_21377":126651,"_5":14632,"_28040":126570,"_3027":126652},[],"Sujeto o usos diferentes",{"_3572":74375,"_30844":74334,"_21377":126654,"_5":14632,"_28040":126570,"_3027":126655},[],"Perfil aplicado y valores solicitados.",{"_3572":74376,"_30844":74334,"_21377":126657,"_5":14632,"_28040":126570,"_3027":126658},[],"No se encuentra el emisor",{"_3572":74377,"_30844":74334,"_21377":126660,"_5":14632,"_28040":126570,"_3027":126661},[],"CA descargada y cadena intermedia necesaria.",{"_3572":74378,"_30844":74334,"_21377":126663,"_5":14632,"_28040":126570,"_3027":126664},[],"Falla la vigencia",{"_3572":74379,"_30844":74334,"_21377":126666,"_5":14632,"_28040":126570,"_3027":126667},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3572":74380,"_30844":74334,"_21377":126669,"_5":14632,"_28040":126570,"_3027":126670},[],"Los resúmenes de clave difieren",{"_3572":74381,"_30844":74334,"_21377":126672,"_5":14632,"_28040":126570,"_3027":126673},[],"Archivos de certificado y clave de la misma emisión.",{"_3572":74382,"_30844":74334,"_21377":126675,"_5":14632,"_28040":126570,"_3027":126676},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3572":74383,"_30844":74334,"_21377":126678,"_5":14632,"_28040":126573,"_3027":126679},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3572":74384,"_30844":74334,"_21377":126681,"_5":14632,"_28040":126573,"_3027":126682},[],"Gestionar certificados para inspección, estado y revocación.",{"_3572":74385,"_30844":74334,"_21377":126684,"_5":14632,"_28040":126573,"_3027":126685},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3572":74386,"_30844":74334,"_21377":126687,"_5":14632,"_28040":126573,"_3027":126688},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3572":74387,"_30844":74334,"_21377":126690,"_5":14632,"_28040":126573,"_3027":126691},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3572":74388,"_30844":74388,"_5":14996,"_3027":126693,"_31202":126694,"_21377":126695,"_28040":74388},"Primeros pasos de PKI",[50349,120289,56039,123738],[],{"_3572":74389,"_30844":74388,"_21377":126697,"_5":14632,"_28040":74388,"_3027":126698},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3572":74390,"_30844":74388,"_5":31199,"_21377":126700,"_28040":126701,"_3027":118802},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3572":74391,"_30844":74388,"_5":31199,"_21377":126703,"_28040":126704,"_3027":126705},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3572":74392,"_30844":74388,"_5":31199,"_21377":126707,"_28040":126708,"_3027":123920},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3572":74393,"_30844":74388,"_5":31199,"_21377":126710,"_28040":126711,"_3027":126712},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3572":74394,"_30844":74388,"_21377":126714,"_5":14632,"_28040":74388,"_3027":126715},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3572":74395,"_30844":74388,"_21377":126717,"_5":14632,"_28040":126701,"_3027":126718},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3572":74396,"_30844":74388,"_21377":126720,"_5":14632,"_28040":126701,"_3027":126721},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3572":74397,"_30844":74388,"_21377":126723,"_5":14632,"_28040":126701,"_3027":126724},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3572":74398,"_30844":74388,"_21377":126726,"_5":14632,"_28040":126701,"_3027":126727},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3572":74399,"_30844":74388,"_21377":126729,"_5":14632,"_28040":126701,"_3027":126730},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3572":74400,"_30844":74388,"_21377":126732,"_5":14632,"_28040":126704,"_3027":126733},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3572":74401,"_30844":74388,"_21377":126735,"_5":14632,"_28040":126704,"_3027":126736},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3572":74402,"_30844":74388,"_21377":126738,"_5":14632,"_28040":126704,"_3027":126739},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3572":74403,"_30844":74388,"_21377":126741,"_5":14632,"_28040":126704,"_3027":126742},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3572":74404,"_30844":74388,"_21377":126744,"_5":14632,"_28040":126708,"_3027":126745},[],"Archivo o recurso",{"_3572":74405,"_30844":74388,"_21377":126747,"_5":14632,"_28040":126708,"_3027":123917},[],{"_3572":74406,"_30844":74388,"_21377":126749,"_5":14632,"_28040":126708,"_3027":126750},[],"CA raíz activa y `ca.pem`",{"_3572":74407,"_30844":74388,"_21377":126752,"_5":14632,"_28040":126708,"_3027":126753},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3572":74408,"_30844":74388,"_21377":126755,"_5":14632,"_28040":126708,"_3027":126756},[],"Certificado final y `device.crt`",{"_3572":74409,"_30844":74388,"_21377":126758,"_5":14632,"_28040":126708,"_3027":126759},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3572":74410,"_30844":74388,"_21377":126761,"_5":14632,"_28040":126708,"_3027":126762},[],"Clave privada `device.key`",{"_3572":74411,"_30844":74388,"_21377":126764,"_5":14632,"_28040":126708,"_3027":126765},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3572":74412,"_30844":74388,"_21377":126767,"_5":14632,"_28040":126708,"_3027":126768},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3572":74413,"_30844":74388,"_21377":126770,"_5":14632,"_28040":126711,"_3027":126771},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3572":74414,"_30844":74388,"_21377":126773,"_5":14632,"_28040":126711,"_3027":126774},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3572":74415,"_30844":74388,"_21377":126776,"_5":14632,"_28040":126711,"_3027":126777},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3572":74416,"_30844":74416,"_5":14996,"_3027":126779,"_31202":126780,"_21377":126782,"_28040":74416},"Resolución de problemas PKI",[50349,120289,56039,126781],"Resolución de problemas",[],{"_3572":74417,"_30844":74416,"_21377":126784,"_5":14632,"_28040":74416,"_3027":126785},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3572":74418,"_30844":74416,"_5":31199,"_21377":126787,"_28040":126788,"_3027":126789},[],"/docs/pr-preview/pr-68/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3572":74419,"_30844":74416,"_5":31199,"_21377":126791,"_28040":126792,"_3027":126793},[],"/docs/pr-preview/pr-68/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3572":74420,"_30844":74416,"_5":31199,"_21377":126795,"_28040":126796,"_3027":126797},[],"/docs/pr-preview/pr-68/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3572":74421,"_30844":74416,"_21377":126799,"_5":14632,"_28040":74416,"_3027":126800},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3572":74422,"_30844":74416,"_21377":126802,"_5":14632,"_28040":74416,"_3027":126803},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3572":74423,"_30844":74416,"_21377":126805,"_5":14632,"_28040":126788,"_3027":123917},[],{"_3572":74424,"_30844":74416,"_21377":126807,"_5":14632,"_28040":126788,"_3027":122589},[],{"_3572":74425,"_30844":74416,"_21377":126809,"_5":14632,"_28040":126788,"_3027":118826},[],{"_3572":74426,"_30844":74416,"_21377":126811,"_5":14632,"_28040":126788,"_3027":54881},[],{"_3572":74427,"_30844":74416,"_21377":126813,"_5":14632,"_28040":126788,"_3027":126814},[],"Existe, está activa y sus fechas son utilizables.",{"_3572":74428,"_30844":74416,"_21377":126816,"_5":14632,"_28040":126788,"_3027":126817},[],"Autoridades.",{"_3572":74429,"_30844":74416,"_21377":126819,"_5":14632,"_28040":126788,"_3027":126820},[],"Clave",{"_3572":74430,"_30844":74416,"_21377":126822,"_5":14632,"_28040":126788,"_3027":126823},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3572":74431,"_30844":74416,"_21377":126825,"_5":14632,"_28040":126788,"_3027":126826},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3572":74432,"_30844":74416,"_21377":126828,"_5":14632,"_28040":126788,"_3027":58615},[],{"_3572":74433,"_30844":74416,"_21377":126830,"_5":14632,"_28040":126788,"_3027":126831},[],"PEM correcto y firma verificable.",{"_3572":74434,"_30844":74416,"_21377":126833,"_5":14632,"_28040":126788,"_3027":58621},[],{"_3572":74435,"_30844":74416,"_21377":126835,"_5":14632,"_28040":126788,"_3027":126836},[],"Perfil",{"_3572":74436,"_30844":74416,"_21377":126838,"_5":14632,"_28040":126788,"_3027":126839},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3572":74437,"_30844":74416,"_21377":126841,"_5":14632,"_28040":126788,"_3027":126842},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3572":74438,"_30844":74416,"_21377":126844,"_5":14632,"_28040":126788,"_3027":124068},[],{"_3572":74439,"_30844":74416,"_21377":126846,"_5":14632,"_28040":126788,"_3027":126847},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3572":74440,"_30844":74416,"_21377":126849,"_5":14632,"_28040":126788,"_3027":126850},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3572":74441,"_30844":74416,"_21377":126852,"_5":14632,"_28040":126788,"_3027":126853},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3572":74442,"_30844":74416,"_21377":126855,"_5":14632,"_28040":126788,"_3027":126856},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3572":74443,"_30844":74416,"_21377":126858,"_5":14632,"_28040":126792,"_3027":126859},[],"Revisa cada frontera por separado:",{"_3572":74444,"_30844":74416,"_21377":126861,"_5":14632,"_28040":126792,"_3027":126862},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3572":74445,"_30844":74416,"_21377":126864,"_5":14632,"_28040":126792,"_3027":126865},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3572":74446,"_30844":74416,"_21377":126867,"_5":14632,"_28040":126792,"_3027":126868},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3572":74447,"_30844":74416,"_21377":126870,"_5":14632,"_28040":126792,"_3027":126871},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3572":74448,"_30844":74416,"_21377":126873,"_5":14632,"_28040":126792,"_3027":126874},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3572":74449,"_30844":74416,"_21377":126876,"_5":14632,"_28040":126792,"_3027":126877},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3572":74450,"_30844":74416,"_21377":126879,"_5":14632,"_28040":126796,"_3027":126880},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3572":74451,"_30844":74416,"_21377":126882,"_5":14632,"_28040":126796,"_3027":126883},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3572":74452,"_30844":74452,"_5":14996,"_3027":126885,"_31202":126886,"_21377":126887,"_28040":74452},"Seguridad",[50349],[],{"_3572":74453,"_30844":74452,"_21377":126889,"_5":14632,"_28040":74452,"_3027":126890},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3572":74454,"_30844":74452,"_5":31199,"_21377":126892,"_28040":126893,"_3027":126894},[],"/docs/pr-preview/pr-68/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3572":74455,"_30844":74452,"_5":31199,"_21377":126896,"_28040":126897,"_3027":126898},[],"/docs/pr-preview/pr-68/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3572":74456,"_30844":74452,"_5":31199,"_21377":126900,"_28040":126901,"_3027":126902},[],"/docs/pr-preview/pr-68/es/security#versiones-soportadas","Versiones soportadas",{"_3572":74457,"_30844":74452,"_5":31199,"_21377":126904,"_28040":126905,"_3027":126906},[],"/docs/pr-preview/pr-68/es/security#divulgación-responsable","Divulgación responsable",{"_3572":74458,"_30844":74452,"_21377":126908,"_5":14632,"_28040":74452,"_3027":126909},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3572":74459,"_30844":74452,"_21377":126911,"_5":14632,"_28040":126893,"_3027":126912},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3572":74460,"_30844":74452,"_21377":126914,"_5":14632,"_28040":126893,"_3027":126915},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3572":74461,"_30844":74452,"_21377":126917,"_5":14632,"_28040":126893,"_3027":15366},[],{"_3572":74462,"_30844":74452,"_21377":126919,"_5":14632,"_28040":126893,"_3027":15208},[],{"_3572":74463,"_30844":74452,"_21377":126921,"_5":14632,"_28040":126893,"_3027":15255},[],{"_3572":74464,"_30844":74452,"_21377":126923,"_5":14632,"_28040":126893,"_3027":126924},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3572":74465,"_30844":74452,"_21377":126926,"_5":14632,"_28040":126893,"_3027":126927},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3572":74466,"_30844":74452,"_21377":126929,"_5":14632,"_28040":126897,"_3027":126930},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3572":74467,"_30844":74452,"_21377":126932,"_5":14632,"_28040":126897,"_3027":126933},[],"No incluyas en el reporte:",{"_3572":74468,"_30844":74452,"_21377":126935,"_5":14632,"_28040":126897,"_3027":126936},[],"Credenciales, tokens o claves privadas",{"_3572":74469,"_30844":74452,"_21377":126938,"_5":14632,"_28040":126897,"_3027":126939},[],"Datos de clientes o información identificable de clientes",{"_3572":74470,"_30844":74452,"_21377":126941,"_5":14632,"_28040":126897,"_3027":126942},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3572":74471,"_30844":74452,"_21377":126944,"_5":14632,"_28040":126901,"_3027":126945},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3572":74472,"_30844":74452,"_21377":126947,"_5":14632,"_28040":126901,"_3027":126948},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3572":74473,"_30844":74452,"_21377":126950,"_5":14632,"_28040":126905,"_3027":126951},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3572":74474,"_30844":74452,"_21377":126953,"_5":14632,"_28040":126905,"_3027":126954},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3572":74475,"_30844":74452,"_21377":126956,"_5":14632,"_28040":126905,"_3027":126957},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3572":74476,"_30844":74452,"_21377":126959,"_5":14632,"_28040":126905,"_3027":126960},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3572":74477,"_30844":74452,"_21377":126962,"_5":14632,"_28040":126905,"_3027":126963},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3572":74478,"_30844":74478,"_5":14996,"_3027":126965,"_31202":126966,"_21377":126968,"_28040":74478},"3.8.0 a 4.0.0",[50349,126967],"Actualizaciones",[],{"_3572":74479,"_30844":74478,"_21377":126970,"_5":14632,"_28040":74478,"_3027":126971},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3572":74480,"_30844":74478,"_5":31199,"_21377":126973,"_28040":126974,"_3027":126975},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3572":74481,"_30844":74478,"_5":31199,"_21377":126977,"_28040":126978,"_3027":126979},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3572":74482,"_30844":74478,"_5":31199,"_21377":126981,"_28040":126982,"_3027":126983},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3572":74483,"_30844":74478,"_5":31199,"_21377":126985,"_28040":126986,"_3027":126987},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3572":74484,"_30844":74478,"_5":31199,"_21377":126989,"_28040":126990,"_3027":126991},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3572":74485,"_30844":74478,"_5":31199,"_21377":126993,"_28040":126994,"_3027":126995},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3572":74486,"_30844":74478,"_5":31199,"_21377":126997,"_28040":126998,"_3027":58787},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3572":74487,"_30844":74478,"_5":31199,"_21377":127000,"_28040":127001,"_3027":127002},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3572":74488,"_30844":74478,"_5":31199,"_21377":127004,"_28040":127005,"_3027":127006},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3572":74489,"_30844":74478,"_5":31199,"_21377":127008,"_28040":127009,"_3027":127010},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3572":74490,"_30844":74478,"_5":31199,"_21377":127012,"_28040":127013,"_3027":127014},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3572":74491,"_30844":74478,"_5":31199,"_21377":127016,"_28040":127017,"_3027":127018},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3572":74492,"_30844":74478,"_5":31199,"_21377":127020,"_28040":127021,"_3027":127022},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3572":74493,"_30844":74478,"_5":31199,"_21377":127024,"_28040":127025,"_3027":127026},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3572":74494,"_30844":74478,"_5":31199,"_21377":127028,"_28040":127029,"_3027":127030},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3572":74495,"_30844":74478,"_5":31199,"_21377":127032,"_28040":127033,"_3027":127034},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3572":74496,"_30844":74478,"_5":31199,"_21377":127036,"_28040":127037,"_3027":127038},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3572":74497,"_30844":74478,"_5":31199,"_21377":127040,"_28040":127041,"_3027":127042},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3572":74498,"_30844":74478,"_5":31199,"_21377":127044,"_28040":127045,"_3027":127046},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3572":74499,"_30844":74478,"_5":31199,"_21377":127048,"_28040":127049,"_3027":127050},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3572":74500,"_30844":74478,"_5":31199,"_21377":127052,"_28040":127053,"_3027":127054},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3572":74501,"_30844":74478,"_5":31199,"_21377":127056,"_28040":127057,"_3027":127058},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3572":74502,"_30844":74478,"_5":31199,"_21377":127060,"_28040":127061,"_3027":127062},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3572":74503,"_30844":74478,"_5":31199,"_21377":127064,"_28040":127065,"_3027":127066},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3572":74504,"_30844":74478,"_5":31199,"_21377":127068,"_28040":127069,"_3027":127070},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3572":74505,"_30844":74478,"_5":31199,"_21377":127072,"_28040":127073,"_3027":127074},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3572":74506,"_30844":74478,"_5":31199,"_21377":127076,"_28040":127077,"_3027":127078},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3572":74507,"_30844":74478,"_5":31199,"_21377":127080,"_28040":127081,"_3027":127082},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3572":74508,"_30844":74478,"_5":31199,"_21377":127084,"_28040":127085,"_3027":127086},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3572":74509,"_30844":74478,"_5":31199,"_21377":127088,"_28040":127089,"_3027":127090},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3572":74510,"_30844":74478,"_5":31199,"_21377":127092,"_28040":127093,"_3027":127094},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3572":74511,"_30844":74478,"_5":31199,"_21377":127096,"_28040":127097,"_3027":127098},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3572":74512,"_30844":74478,"_5":31199,"_21377":127100,"_28040":127101,"_3027":127102},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3572":74513,"_30844":74478,"_5":31199,"_21377":127104,"_28040":127105,"_3027":127106},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3572":74514,"_30844":74478,"_5":31199,"_21377":127108,"_28040":127109,"_3027":127110},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3572":74515,"_30844":74478,"_5":31199,"_21377":127112,"_28040":127113,"_3027":127114},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3572":74516,"_30844":74478,"_5":31199,"_21377":127116,"_28040":127117,"_3027":127118},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3572":74517,"_30844":74478,"_5":31199,"_21377":127120,"_28040":127121,"_3027":127122},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3572":74518,"_30844":74478,"_5":31199,"_21377":127124,"_28040":127125,"_3027":127126},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3572":74519,"_30844":74478,"_5":31199,"_21377":127128,"_28040":127129,"_3027":127130},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3572":74520,"_30844":74478,"_5":31199,"_21377":127132,"_28040":127133,"_3027":122931},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3572":74521,"_30844":74478,"_5":31199,"_21377":127135,"_28040":127136,"_3027":127137},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3572":74522,"_30844":74478,"_5":31199,"_21377":127139,"_28040":127140,"_3027":127141},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3572":74523,"_30844":74478,"_21377":127143,"_5":14632,"_28040":74478,"_3027":127144},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3572":74524,"_30844":74478,"_21377":127146,"_5":14632,"_28040":74478,"_3027":127147},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3572":74525,"_30844":74478,"_21377":127149,"_5":14632,"_28040":74478,"_3027":127150},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3572":74526,"_30844":74478,"_21377":127152,"_5":14632,"_28040":74478,"_3027":127153},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3572":74527,"_30844":74478,"_21377":127155,"_5":14632,"_28040":74478,"_3027":127156},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3572":74528,"_30844":74478,"_21377":127158,"_5":14632,"_28040":74478,"_3027":127159},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3572":74529,"_30844":74478,"_21377":127161,"_5":14632,"_28040":74478,"_3027":127162},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3572":74530,"_30844":74478,"_21377":127164,"_5":14632,"_28040":126978,"_3027":127165},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3572":74531,"_30844":74478,"_21377":127167,"_5":14632,"_28040":126978,"_3027":127168},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3572":74532,"_30844":74478,"_21377":127170,"_5":14632,"_28040":126982,"_3027":127171},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3572":74533,"_30844":74478,"_21377":127173,"_5":14632,"_28040":126982,"_3027":127174},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3572":74534,"_30844":74478,"_21377":127176,"_5":14632,"_28040":126986,"_3027":127177},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3572":74535,"_30844":74478,"_21377":127179,"_5":14632,"_28040":126990,"_3027":127180},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3572":74536,"_30844":74478,"_21377":127182,"_5":14632,"_28040":126990,"_3027":127183},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3572":74537,"_30844":74478,"_21377":127185,"_5":14632,"_28040":126990,"_3027":127186},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3572":74538,"_30844":74478,"_21377":127188,"_5":14632,"_28040":126990,"_3027":127189},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3572":74539,"_30844":74478,"_21377":127191,"_5":14632,"_28040":126990,"_3027":127192},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3572":74540,"_30844":74478,"_21377":127194,"_5":14632,"_28040":126994,"_3027":127195},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3572":74541,"_30844":74478,"_21377":127197,"_5":14632,"_28040":126994,"_3027":127198},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3572":74542,"_30844":74478,"_21377":127200,"_5":14632,"_28040":126994,"_3027":127201},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3572":74543,"_30844":74478,"_21377":127203,"_5":14632,"_28040":126994,"_3027":127204},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3572":74544,"_30844":74478,"_21377":127206,"_5":14632,"_28040":126994,"_3027":127207},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3572":74545,"_30844":74478,"_21377":127209,"_5":14632,"_28040":126994,"_3027":127210},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3572":74546,"_30844":74478,"_21377":127212,"_5":14632,"_28040":126998,"_3027":127213},[],"Cambio",{"_3572":74547,"_30844":74478,"_21377":127215,"_5":14632,"_28040":126998,"_3027":127216},[],"A quién afecta",{"_3572":74548,"_30844":74478,"_21377":127218,"_5":14632,"_28040":126998,"_3027":127219},[],"Gravedad",{"_3572":74549,"_30844":74478,"_21377":127221,"_5":14632,"_28040":126998,"_3027":125710},[],{"_3572":74550,"_30844":74478,"_21377":127223,"_5":14632,"_28040":126998,"_3027":127006},[],{"_3572":74551,"_30844":74478,"_21377":127225,"_5":14632,"_28040":126998,"_3027":127226},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3572":74552,"_30844":74478,"_21377":127228,"_5":14632,"_28040":126998,"_3027":127229},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3572":74553,"_30844":74478,"_21377":127231,"_5":14632,"_28040":126998,"_3027":127232},[],"Copiar los datos a los volúmenes nuevos",{"_3572":74554,"_30844":74478,"_21377":127234,"_5":14632,"_28040":126998,"_3027":127010},[],{"_3572":74555,"_30844":74478,"_21377":127236,"_5":14632,"_28040":126998,"_3027":127237},[],"Todas las releases de Helm",{"_3572":74556,"_30844":74478,"_21377":127239,"_5":14632,"_28040":126998,"_3027":127240},[],"Alta: `helm upgrade` falla",{"_3572":74557,"_30844":74478,"_21377":127242,"_5":14632,"_28040":126998,"_3027":127243},[],"Eliminar o renombrar las claves heredadas",{"_3572":74558,"_30844":74478,"_21377":127245,"_5":14632,"_28040":126998,"_3027":127014},[],{"_3572":74559,"_30844":74478,"_21377":127247,"_5":14632,"_28040":126998,"_3027":127248},[],"Todos los despliegues",{"_3572":74560,"_30844":74478,"_21377":127250,"_5":14632,"_28040":126998,"_3027":127251},[],"Alta: sin principal de bootstrap no hay administrador",{"_3572":74561,"_30844":74478,"_21377":127253,"_5":14632,"_28040":126998,"_3027":127254},[],"Configurar `services.authz`",{"_3572":74562,"_30844":74478,"_21377":127256,"_5":14632,"_28040":126998,"_3027":127018},[],{"_3572":74563,"_30844":74478,"_21377":127258,"_5":14632,"_28040":126998,"_3027":127237},[],{"_3572":74564,"_30844":74478,"_21377":127260,"_5":14632,"_28040":126998,"_3027":127261},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3572":74565,"_30844":74478,"_21377":127263,"_5":14632,"_28040":126998,"_3027":127264},[],"Mover JWKS y roles a `services.authz`",{"_3572":74566,"_30844":74478,"_21377":127266,"_5":14632,"_28040":126998,"_3027":127038},[],{"_3572":74567,"_30844":74478,"_21377":127268,"_5":14632,"_28040":126998,"_3027":127269},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3572":74568,"_30844":74478,"_21377":127271,"_5":14632,"_28040":126998,"_3027":127272},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3572":74569,"_30844":74478,"_21377":127274,"_5":14632,"_28040":126998,"_3027":127275},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3572":74570,"_30844":74478,"_21377":127277,"_5":14632,"_28040":126998,"_3027":127042},[],{"_3572":74571,"_30844":74478,"_21377":127279,"_5":14632,"_28040":126998,"_3027":127280},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3572":74572,"_30844":74478,"_21377":127282,"_5":14632,"_28040":126998,"_3027":127283},[],"Alta: el backend ya no arranca con ellos",{"_3572":74573,"_30844":74478,"_21377":127285,"_5":14632,"_28040":126998,"_3027":127286},[],"Pasar a PostgreSQL antes de actualizar",{"_3572":74574,"_30844":74478,"_21377":127288,"_5":14632,"_28040":126998,"_3027":127086},[],{"_3572":74575,"_30844":74478,"_21377":127290,"_5":14632,"_28040":126998,"_3027":127291},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3572":74576,"_30844":74478,"_21377":127293,"_5":14632,"_28040":126998,"_3027":127294},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3572":74577,"_30844":74478,"_21377":127296,"_5":14632,"_28040":126998,"_3027":127297},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3572":74578,"_30844":74478,"_21377":127299,"_5":14632,"_28040":126998,"_3027":127300},[],"Webhooks con referencias a archivos",{"_3572":74579,"_30844":74478,"_21377":127302,"_5":14632,"_28040":126998,"_3027":127303},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3572":74580,"_30844":74478,"_21377":127305,"_5":14632,"_28040":126998,"_3027":127306},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3572":74581,"_30844":74478,"_21377":127308,"_5":14632,"_28040":126998,"_3027":127309},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3572":74582,"_30844":74478,"_21377":127311,"_5":14632,"_28040":126998,"_3027":127022},[],{"_3572":74583,"_30844":74478,"_21377":127313,"_5":14632,"_28040":126998,"_3027":127314},[],"Releases con identidades por servicio o material de claves montado",{"_3572":74584,"_30844":74478,"_21377":127316,"_5":14632,"_28040":126998,"_3027":127317},[],"Media: los servicios no pueden leer sus archivos",{"_3572":74585,"_30844":74478,"_21377":127319,"_5":14632,"_28040":126998,"_3027":127320},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3572":74586,"_30844":74478,"_21377":127322,"_5":14632,"_28040":126998,"_3027":127026},[],{"_3572":74587,"_30844":74478,"_21377":127324,"_5":14632,"_28040":126998,"_3027":127325},[],"Releases que definen `amqp.tls`",{"_3572":74588,"_30844":74478,"_21377":127327,"_5":14632,"_28040":126998,"_3027":127328},[],"Media: los clientes se conectan al puerto equivocado",{"_3572":74589,"_30844":74478,"_21377":127330,"_5":14632,"_28040":126998,"_3027":127331},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3572":74590,"_30844":74478,"_21377":127333,"_5":14632,"_28040":126998,"_3027":127046},[],{"_3572":74591,"_30844":74478,"_21377":127335,"_5":14632,"_28040":126998,"_3027":127336},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3572":74592,"_30844":74478,"_21377":127338,"_5":14632,"_28040":126998,"_3027":127339},[],"Media: las claves de CA quedan sin gestionar",{"_3572":74593,"_30844":74478,"_21377":127341,"_5":14632,"_28040":126998,"_3027":127342},[],"Ejecutar la migración de CA a KMS",{"_3572":74594,"_30844":74478,"_21377":127344,"_5":14632,"_28040":126998,"_3027":127345},[],"Verificación del certificado del receptor",{"_3572":74595,"_30844":74478,"_21377":127347,"_5":14632,"_28040":126998,"_3027":127348},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3572":74596,"_30844":74478,"_21377":127350,"_5":14632,"_28040":126998,"_3027":127351},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3572":74597,"_30844":74478,"_21377":127353,"_5":14632,"_28040":126998,"_3027":127354},[],"Poner `insecure_skip_verify` a `false`",{"_3572":74598,"_30844":74478,"_21377":127356,"_5":14632,"_28040":126998,"_3027":127062},[],{"_3572":74599,"_30844":74478,"_21377":127358,"_5":14632,"_28040":126998,"_3027":127359},[],"Scripts y consolas que editan DMS por API",{"_3572":74600,"_30844":74478,"_21377":127361,"_5":14632,"_28040":126998,"_3027":127362},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3572":74601,"_30844":74478,"_21377":127364,"_5":14632,"_28040":126998,"_3027":127365},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3572":74602,"_30844":74478,"_21377":127367,"_5":14632,"_28040":126998,"_3027":127082},[],{"_3572":74603,"_30844":74478,"_21377":127369,"_5":14632,"_28040":126998,"_3027":127370},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3572":74604,"_30844":74478,"_21377":127372,"_5":14632,"_28040":126998,"_3027":127373},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3572":74605,"_30844":74478,"_21377":127375,"_5":14632,"_28040":126998,"_3027":127376},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3572":74606,"_30844":74478,"_21377":127378,"_5":14632,"_28040":126998,"_3027":127090},[],{"_3572":74607,"_30844":74478,"_21377":127380,"_5":14632,"_28040":126998,"_3027":127381},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3572":74608,"_30844":74478,"_21377":127383,"_5":14632,"_28040":126998,"_3027":127384},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3572":74609,"_30844":74478,"_21377":127386,"_5":14632,"_28040":126998,"_3027":127387},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3572":74610,"_30844":74478,"_21377":127389,"_5":14632,"_28040":126998,"_3027":127078},[],{"_3572":74611,"_30844":74478,"_21377":127391,"_5":14632,"_28040":126998,"_3027":127392},[],"Consumidores que leen el campo `events` del dispositivo",{"_3572":74612,"_30844":74478,"_21377":127394,"_5":14632,"_28040":126998,"_3027":127395},[],"Media: el campo desaparece",{"_3572":74613,"_30844":74478,"_21377":127397,"_5":14632,"_28040":126998,"_3027":127398},[],"Usar los nuevos endpoints de eventos",{"_3572":74614,"_30844":74478,"_21377":127400,"_5":14632,"_28040":126998,"_3027":127098},[],{"_3572":74615,"_30844":74478,"_21377":127402,"_5":14632,"_28040":126998,"_3027":127403},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3572":74616,"_30844":74478,"_21377":127405,"_5":14632,"_28040":126998,"_3027":127406},[],"Media: la migración de la VA aborta",{"_3572":74617,"_30844":74478,"_21377":127408,"_5":14632,"_28040":126998,"_3027":127409},[],"Corregir los roles afectados antes de actualizar",{"_3572":74618,"_30844":74478,"_21377":127411,"_5":14632,"_28040":126998,"_3027":127030},[],{"_3572":74619,"_30844":74478,"_21377":127413,"_5":14632,"_28040":126998,"_3027":127414},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3572":74620,"_30844":74478,"_21377":127416,"_5":14632,"_28040":126998,"_3027":127417},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3572":74621,"_30844":74478,"_21377":127419,"_5":14632,"_28040":126998,"_3027":127420},[],"Actualizar el archivo de values",{"_3572":74622,"_30844":74478,"_21377":127422,"_5":14632,"_28040":126998,"_3027":127070},[],{"_3572":74623,"_30844":74478,"_21377":127424,"_5":14632,"_28040":126998,"_3027":127425},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3572":74624,"_30844":74478,"_21377":127427,"_5":14632,"_28040":126998,"_3027":127428},[],"Baja: prevalece el ID de la URL",{"_3572":74625,"_30844":74478,"_21377":127430,"_5":14632,"_28040":126998,"_3027":127431},[],"Enviar el ID en la URL",{"_3572":74626,"_30844":74478,"_21377":127433,"_5":14632,"_28040":126998,"_3027":127094},[],{"_3572":74627,"_30844":74478,"_21377":127435,"_5":14632,"_28040":126998,"_3027":127436},[],"Clientes que envían un `id` al crear o importar CAs",{"_3572":74628,"_30844":74478,"_21377":127438,"_5":14632,"_28040":126998,"_3027":127439},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3572":74629,"_30844":74478,"_21377":127441,"_5":14632,"_28040":126998,"_3027":127442},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3572":74630,"_30844":74478,"_21377":127444,"_5":14632,"_28040":126998,"_3027":127074},[],{"_3572":74631,"_30844":74478,"_21377":127446,"_5":14632,"_28040":126998,"_3027":127447},[],"Consumidores que comparan el `type` del certificado",{"_3572":74632,"_30844":74478,"_21377":127449,"_5":14632,"_28040":126998,"_3027":127450},[],"Baja: dos valores cambian de nombre",{"_3572":74633,"_30844":74478,"_21377":127452,"_5":14632,"_28040":126998,"_3027":127453},[],"Adaptar los consumidores",{"_3572":74634,"_30844":74478,"_21377":127455,"_5":14632,"_28040":126998,"_3027":127066},[],{"_3572":74635,"_30844":74478,"_21377":127457,"_5":14632,"_28040":126998,"_3027":127458},[],"Cualquier DMS",{"_3572":74636,"_30844":74478,"_21377":127460,"_5":14632,"_28040":126998,"_3027":127461},[],"Baja: solo informativo",{"_3572":74637,"_30844":74478,"_21377":127463,"_5":14632,"_28040":126998,"_3027":127464},[],"Revisar ambos bloques antes de editar",{"_3572":74638,"_30844":74478,"_21377":127466,"_5":14632,"_28040":127005,"_3027":127467},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3572":74639,"_30844":74478,"_21377":127469,"_5":14632,"_28040":127005,"_3027":127470},[],"El paso 4 de la guía de migración copia los datos.",{"_3572":74640,"_30844":74478,"_21377":127472,"_5":14632,"_28040":127009,"_3027":127473},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3572":74641,"_30844":74478,"_21377":127475,"_5":14632,"_28040":127013,"_3027":127476},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3572":74642,"_30844":74478,"_21377":127478,"_5":14632,"_28040":127017,"_3027":127479},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3572":74643,"_30844":74478,"_21377":127481,"_5":14632,"_28040":127021,"_3027":127482},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3572":74644,"_30844":74478,"_21377":127484,"_5":14632,"_28040":127021,"_3027":127485},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3572":74645,"_30844":74478,"_21377":127487,"_5":14632,"_28040":127025,"_3027":127488},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3572":74646,"_30844":74478,"_21377":127490,"_5":14632,"_28040":127029,"_3027":127491},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3572":74647,"_30844":74478,"_21377":127493,"_5":14632,"_28040":127029,"_3027":127494},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3572":74648,"_30844":74478,"_21377":127496,"_5":14632,"_28040":127029,"_3027":127497},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3572":74649,"_30844":74478,"_21377":127499,"_5":14632,"_28040":127029,"_3027":127500},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3572":74650,"_30844":74478,"_21377":127502,"_5":14632,"_28040":127029,"_3027":127503},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3572":74651,"_30844":74478,"_21377":127505,"_5":14632,"_28040":127029,"_3027":127506},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3572":74652,"_30844":74478,"_21377":127508,"_5":14632,"_28040":127037,"_3027":127509},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3572":74653,"_30844":74478,"_21377":127511,"_5":14632,"_28040":127037,"_3027":127512},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3572":74654,"_30844":74478,"_21377":127514,"_5":14632,"_28040":127037,"_3027":127515},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3572":74655,"_30844":74478,"_21377":127517,"_5":14632,"_28040":127037,"_3027":127518},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3572":74656,"_30844":74478,"_21377":127520,"_5":14632,"_28040":127037,"_3027":127521},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3572":74657,"_30844":74478,"_21377":127523,"_5":14632,"_28040":127041,"_3027":127524},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3572":74658,"_30844":74478,"_21377":127526,"_5":14632,"_28040":127045,"_3027":127527},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3572":74659,"_30844":74478,"_21377":127529,"_5":14632,"_28040":127045,"_3027":127530},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3572":74660,"_30844":74478,"_21377":127532,"_5":14632,"_28040":127045,"_3027":127533},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3572":74661,"_30844":74478,"_21377":127535,"_5":14632,"_28040":127045,"_3027":127536},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3572":74662,"_30844":74478,"_21377":127538,"_5":14632,"_28040":127045,"_3027":127539},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3572":74663,"_30844":74478,"_21377":127541,"_5":14632,"_28040":127045,"_3027":127542},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3572":74664,"_30844":74478,"_21377":127544,"_5":14632,"_28040":127045,"_3027":127545},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3572":74665,"_30844":74478,"_21377":127547,"_5":14632,"_28040":127045,"_3027":127548},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3572":74666,"_30844":74478,"_21377":127550,"_5":14632,"_28040":127049,"_3027":127551},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3572":74667,"_30844":74478,"_21377":127553,"_5":14632,"_28040":127057,"_3027":127554},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3572":74668,"_30844":74478,"_21377":127556,"_5":14632,"_28040":127057,"_3027":127557},[],"Campo en 3.8.0",{"_3572":74669,"_30844":74478,"_21377":127559,"_5":14632,"_28040":127057,"_3027":127560},[],"Campo en 4.0.0",{"_3572":74670,"_30844":74478,"_21377":127562,"_5":14632,"_28040":127057,"_3027":59352},[],{"_3572":74671,"_30844":74478,"_21377":127564,"_5":14632,"_28040":127057,"_3027":127565},[],"`insecure_skip_verify` (con el valor negado)",{"_3572":74672,"_30844":74478,"_21377":127567,"_5":14632,"_28040":127057,"_3027":59358},[],{"_3572":74673,"_30844":74478,"_21377":127569,"_5":14632,"_28040":127057,"_3027":59361},[],{"_3572":74674,"_30844":74478,"_21377":127571,"_5":14632,"_28040":127057,"_3027":59364},[],{"_3572":74675,"_30844":74478,"_21377":127573,"_5":14632,"_28040":127057,"_3027":59367},[],{"_3572":74676,"_30844":74478,"_21377":127575,"_5":14632,"_28040":127057,"_3027":59370},[],{"_3572":74677,"_30844":74478,"_21377":127577,"_5":14632,"_28040":127057,"_3027":59373},[],{"_3572":74678,"_30844":74478,"_21377":127579,"_5":14632,"_28040":127057,"_3027":127580},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3572":74679,"_30844":74478,"_21377":127582,"_5":14632,"_28040":127057,"_3027":127583},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3572":74680,"_30844":74478,"_21377":127585,"_5":14632,"_28040":127057,"_3027":127586},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3572":74681,"_30844":74478,"_21377":127588,"_5":14632,"_28040":127061,"_3027":127589},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3572":74682,"_30844":74478,"_21377":127591,"_5":14632,"_28040":127061,"_3027":127592},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3572":74683,"_30844":74478,"_21377":127594,"_5":14632,"_28040":127061,"_3027":127595},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3572":74684,"_30844":74478,"_21377":127597,"_5":14632,"_28040":127065,"_3027":127598},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3572":74685,"_30844":74478,"_21377":127600,"_5":14632,"_28040":127069,"_3027":127601},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3572":74686,"_30844":74478,"_21377":127603,"_5":14632,"_28040":127073,"_3027":127604},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3572":74687,"_30844":74478,"_21377":127606,"_5":14632,"_28040":127077,"_3027":127607},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3572":74688,"_30844":74478,"_21377":127609,"_5":14632,"_28040":127077,"_3027":127610},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3572":74689,"_30844":74478,"_21377":127612,"_5":14632,"_28040":127077,"_3027":127613},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3572":74690,"_30844":74478,"_21377":127615,"_5":14632,"_28040":127077,"_3027":127616},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3572":74691,"_30844":74478,"_21377":127618,"_5":14632,"_28040":127081,"_3027":127619},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3572":74692,"_30844":74478,"_21377":127621,"_5":14632,"_28040":127085,"_3027":127622},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3572":74693,"_30844":74478,"_21377":127624,"_5":14632,"_28040":127085,"_3027":127625},[],"Ruta",{"_3572":74694,"_30844":74478,"_21377":127627,"_5":14632,"_28040":127085,"_3027":120040},[],{"_3572":74695,"_30844":74478,"_21377":127629,"_5":14632,"_28040":127085,"_3027":59426},[],{"_3572":74696,"_30844":74478,"_21377":127631,"_5":14632,"_28040":127085,"_3027":127632},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3572":74697,"_30844":74478,"_21377":127634,"_5":14632,"_28040":127085,"_3027":59432},[],{"_3572":74698,"_30844":74478,"_21377":127636,"_5":14632,"_28040":127085,"_3027":127637},[],"Lee los ajustes de una CA.",{"_3572":74699,"_30844":74478,"_21377":127639,"_5":14632,"_28040":127085,"_3027":59438},[],{"_3572":74700,"_30844":74478,"_21377":127641,"_5":14632,"_28040":127085,"_3027":127642},[],"Sustituye los `crl_options`.",{"_3572":74701,"_30844":74478,"_21377":127644,"_5":14632,"_28040":127085,"_3027":59444},[],{"_3572":74702,"_30844":74478,"_21377":127646,"_5":14632,"_28040":127085,"_3027":127647},[],"Elimina los ajustes archivados de una CA.",{"_3572":74703,"_30844":74478,"_21377":127649,"_5":14632,"_28040":127085,"_3027":127650},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3572":74704,"_30844":74478,"_21377":127652,"_5":14632,"_28040":127085,"_3027":127653},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3572":74705,"_30844":74478,"_21377":127655,"_5":14632,"_28040":127085,"_3027":127656},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3572":74706,"_30844":74478,"_21377":127658,"_5":14632,"_28040":127085,"_3027":127659},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3572":74707,"_30844":74478,"_21377":127661,"_5":14632,"_28040":127085,"_3027":127662},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3572":74708,"_30844":74478,"_21377":127664,"_5":14632,"_28040":127085,"_3027":127665},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3572":74709,"_30844":74478,"_21377":127667,"_5":14632,"_28040":127085,"_3027":127668},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3572":74710,"_30844":74478,"_21377":127670,"_5":14632,"_28040":127085,"_3027":127671},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3572":74711,"_30844":74478,"_21377":127673,"_5":14632,"_28040":127085,"_3027":127674},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3572":74712,"_30844":74478,"_21377":127676,"_5":14632,"_28040":127085,"_3027":127677},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3572":74713,"_30844":74478,"_21377":127679,"_5":14632,"_28040":127085,"_3027":127680},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3572":74714,"_30844":74478,"_21377":127682,"_5":14632,"_28040":127089,"_3027":127683},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3572":74715,"_30844":74478,"_21377":127685,"_5":14632,"_28040":127093,"_3027":127686},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3572":74716,"_30844":74478,"_21377":127688,"_5":14632,"_28040":127097,"_3027":127689},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3572":74717,"_30844":74478,"_21377":127691,"_5":14632,"_28040":127101,"_3027":127692},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3572":74718,"_30844":74478,"_21377":127694,"_5":14632,"_28040":127105,"_3027":127695},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3572":74719,"_30844":74478,"_21377":127697,"_5":14632,"_28040":127105,"_3027":127698},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3572":74720,"_30844":74478,"_21377":127700,"_5":14632,"_28040":127105,"_3027":127701},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3572":74721,"_30844":74478,"_21377":127703,"_5":14632,"_28040":127105,"_3027":127704},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3572":74722,"_30844":74478,"_21377":127706,"_5":14632,"_28040":127105,"_3027":127707},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3572":74723,"_30844":74478,"_21377":127709,"_5":14632,"_28040":127105,"_3027":127710},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3572":74724,"_30844":74478,"_21377":127712,"_5":14632,"_28040":127109,"_3027":127713},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3572":74725,"_30844":74478,"_21377":127715,"_5":14632,"_28040":127109,"_3027":127716},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3572":74726,"_30844":74478,"_21377":127718,"_5":14632,"_28040":127109,"_3027":127719},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3572":74727,"_30844":74478,"_21377":127721,"_5":14632,"_28040":127109,"_3027":127722},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3572":74728,"_30844":74478,"_21377":127724,"_5":14632,"_28040":127109,"_3027":127725},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3572":74729,"_30844":74478,"_21377":127727,"_5":14632,"_28040":127113,"_3027":127728},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3572":74730,"_30844":74478,"_21377":127730,"_5":14632,"_28040":127113,"_3027":127731},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3572":74731,"_30844":74478,"_21377":127733,"_5":14632,"_28040":127113,"_3027":127734},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`. Cada schema puede además definir su propio usuario y contraseña mediante las variables de entorno `LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_USERNAME` y `LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_PASSWORD`, que, cuando están definidas, tienen prioridad sobre el usuario y la contraseña que los values globales `postgres.username` y `postgres.password` aportan a la conexión renderizada de ese schema. Consulta Variables de entorno para credenciales.",{"_3572":74732,"_30844":74478,"_21377":127736,"_5":14632,"_28040":127113,"_3027":127737},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3572":74733,"_30844":74478,"_21377":127739,"_5":14632,"_28040":127113,"_3027":127740},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3572":74734,"_30844":74478,"_21377":127742,"_5":14632,"_28040":127113,"_3027":127743},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3572":74735,"_30844":74478,"_21377":127745,"_5":14632,"_28040":127113,"_3027":127746},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3572":74736,"_30844":74478,"_21377":127748,"_5":14632,"_28040":127113,"_3027":127749},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3572":74737,"_30844":74478,"_21377":127751,"_5":14632,"_28040":127113,"_3027":127752},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3572":74738,"_30844":74478,"_21377":127754,"_5":14632,"_28040":127113,"_3027":127755},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3572":74739,"_30844":74478,"_21377":127757,"_5":14632,"_28040":127113,"_3027":127758},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3572":74740,"_30844":74478,"_21377":127760,"_5":14632,"_28040":127113,"_3027":127761},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3572":74741,"_30844":74478,"_21377":127763,"_5":14632,"_28040":127117,"_3027":127764},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3572":74742,"_30844":74478,"_21377":127766,"_5":14632,"_28040":127117,"_3027":127767},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3572":74743,"_30844":74478,"_21377":127769,"_5":14632,"_28040":127121,"_3027":127770},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3572":74744,"_30844":74478,"_21377":127772,"_5":14632,"_28040":127121,"_3027":127773},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3572":74745,"_30844":74478,"_21377":127775,"_5":14632,"_28040":127121,"_3027":127776},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3572":74746,"_30844":74478,"_21377":127778,"_5":14632,"_28040":127121,"_3027":127779},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3572":74747,"_30844":74478,"_21377":127781,"_5":14632,"_28040":127121,"_3027":127782},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3572":74748,"_30844":74478,"_21377":127784,"_5":14632,"_28040":127121,"_3027":127785},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3572":74749,"_30844":74478,"_21377":127787,"_5":14632,"_28040":127121,"_3027":127788},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3572":74750,"_30844":74478,"_21377":127790,"_5":14632,"_28040":127121,"_3027":127791},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3572":74751,"_30844":74478,"_21377":127793,"_5":14632,"_28040":127121,"_3027":127794},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3572":74752,"_30844":74478,"_21377":127796,"_5":14632,"_28040":127121,"_3027":127797},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3572":74753,"_30844":74478,"_21377":127799,"_5":14632,"_28040":127121,"_3027":127800},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3572":74754,"_30844":74478,"_21377":127802,"_5":14632,"_28040":127125,"_3027":127803},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3572":74755,"_30844":74478,"_21377":127805,"_5":14632,"_28040":127125,"_3027":127806},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3572":74756,"_30844":74478,"_21377":127808,"_5":14632,"_28040":127129,"_3027":127809},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3572":74757,"_30844":74478,"_21377":127811,"_5":14632,"_28040":127129,"_3027":127812},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3572":74758,"_30844":74478,"_21377":127814,"_5":14632,"_28040":127129,"_3027":127815},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3572":74759,"_30844":74478,"_21377":127817,"_5":14632,"_28040":127129,"_3027":127818},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3572":74760,"_30844":74478,"_21377":127820,"_5":14632,"_28040":127129,"_3027":127821},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3572":74761,"_30844":74478,"_21377":127823,"_5":14632,"_28040":127129,"_3027":127824},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3572":74762,"_30844":74478,"_21377":127826,"_5":14632,"_28040":127129,"_3027":127827},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3572":74763,"_30844":74478,"_21377":127829,"_5":14632,"_28040":127129,"_3027":127830},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3572":74764,"_30844":74478,"_21377":127832,"_5":14632,"_28040":127133,"_3027":127833},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3572":74765,"_30844":74478,"_21377":127835,"_5":14632,"_28040":127133,"_3027":127836},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3572":74766,"_30844":74478,"_21377":127838,"_5":14632,"_28040":127133,"_3027":127839},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3572":74767,"_30844":74478,"_21377":127841,"_5":14632,"_28040":127133,"_3027":127842},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3572":74768,"_30844":74478,"_21377":127844,"_5":14632,"_28040":127133,"_3027":127845},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3572":74769,"_30844":74478,"_21377":127847,"_5":14632,"_28040":127133,"_3027":127848},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3572":74770,"_30844":74478,"_21377":127850,"_5":14632,"_28040":127133,"_3027":127851},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3572":74771,"_30844":74478,"_21377":127853,"_5":14632,"_28040":127133,"_3027":127854},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3572":74772,"_30844":74478,"_21377":127856,"_5":14632,"_28040":127133,"_3027":127857},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3572":74773,"_30844":74478,"_21377":127859,"_5":14632,"_28040":127133,"_3027":127860},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3572":74774,"_30844":74478,"_21377":127862,"_5":14632,"_28040":127133,"_3027":127863},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3572":74775,"_30844":74478,"_21377":127865,"_5":14632,"_28040":127136,"_3027":127866},[],"Tras la actualización, comprueba en este orden:",{"_3572":74776,"_30844":74478,"_21377":127868,"_5":14632,"_28040":127136,"_3027":127869},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3572":74777,"_30844":74478,"_21377":127871,"_5":14632,"_28040":127136,"_3027":127872},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3572":74778,"_30844":74478,"_21377":127874,"_5":14632,"_28040":127136,"_3027":127875},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3572":74779,"_30844":74478,"_21377":127877,"_5":14632,"_28040":127136,"_3027":127878},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3572":74780,"_30844":74478,"_21377":127880,"_5":14632,"_28040":127136,"_3027":127881},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3572":74781,"_30844":74478,"_21377":127883,"_5":14632,"_28040":127136,"_3027":127884},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3572":74782,"_30844":74478,"_21377":127886,"_5":14632,"_28040":127136,"_3027":127887},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3572":74783,"_30844":74478,"_21377":127889,"_5":14632,"_28040":127136,"_3027":127890},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3572":74784,"_30844":74478,"_21377":127892,"_5":14632,"_28040":127136,"_3027":127893},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3572":74785,"_30844":74478,"_21377":127895,"_5":14632,"_28040":127136,"_3027":127896},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3572":74786,"_30844":74478,"_21377":127898,"_5":14632,"_28040":127136,"_3027":127899},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3572":74787,"_30844":74478,"_21377":127901,"_5":14632,"_28040":127136,"_3027":127902},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3572":74788,"_30844":74478,"_21377":127904,"_5":14632,"_28040":127136,"_3027":127905},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3572":74789,"_30844":74478,"_21377":127907,"_5":14632,"_28040":127136,"_3027":127908},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3572":74790,"_30844":74478,"_21377":127910,"_5":14632,"_28040":127136,"_3027":127911},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3572":74791,"_30844":74478,"_21377":127913,"_5":14632,"_28040":127140,"_3027":127914},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3572":74792,"_30844":74478,"_21377":127916,"_5":14632,"_28040":127140,"_3027":127917},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3572":74793,"_30844":74478,"_21377":127919,"_5":14632,"_28040":127140,"_3027":127920},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3572":74794,"_30844":74478,"_21377":127922,"_5":14632,"_28040":127140,"_3027":127923},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3572":74795,"_30844":74478,"_21377":127925,"_5":14632,"_28040":127140,"_3027":127926},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_59729":127928,"_59731":127929,"_59733":127930,"_59735":127931,"_18548":3062,"_71782":3062},"spanish",[3027,30844,5,28040],{"_3027":25498,"_30844":25498,"_5":25498,"_28040":25498},{"_3027":127932,"_30844":130942,"_5":133952,"_28040":136962},{"_4772":127933,"_59739":127934,"_5":25498},{"_14720":3334,"_15100":6324,"_15119":7373,"_29838":7836,"_15106":7094,"_20290":12698,"_14741":5810,"_14748":5975,"_29780":6175,"_30188":5971,"_30209":4492,"_29814":7202,"_35236":23546,"_29917":20775,"_30253":10081,"_35243":23315,"_35246":13937,"_35249":5193,"_35252":8732,"_30660":17253,"_35257":4106,"_35259":3335,"_30690":20564,"_15115":11819,"_35263":7687,"_35266":4407,"_35268":6220,"_30237":7811,"_30655":11310,"_30703":3114,"_35273":8332,"_35275":8012,"_35277":3762,"_29934":6745,"_35280":7662,"_35282":4446,"_35284":3400,"_35286":6450,"_35288":3423,"_29851":3466,"_35291":21011,"_35293":4116,"_29845":7197,"_30274":19700,"_35297":17109,"_35299":4263,"_35302":4128,"_29891":7752,"_35306":5095,"_29771":6121,"_35309":6163,"_29819":6528,"_35312":8777,"_35314":5974,"_35317":5968,"_15109":19655,"_35320":6097,"_35322":6448,"_35325":6716,"_35327":13843,"_35329":13231,"_35331":7851,"_35333":10568,"_20293":3516,"_35336":15633,"_35338":7092,"_29792":6158,"_30231":3413,"_35342":18916,"_35344":6753,"_35346":3787,"_30720":7780,"_35349":20594,"_35351":4299,"_35353":21601,"_30824":3786,"_30290":5280,"_35357":7531,"_35359":3917,"_29829":3173,"_35362":4617,"_35364":5183,"_35366":7843,"_30736":21922,"_29911":11097,"_29296":4896,"_35371":19108,"_35373":23160,"_35375":4907,"_29960":3984,"_35379":4008,"_30225":3408,"_35383":3409,"_35385":6462,"_35387":9594,"_35389":10992,"_35391":7881,"_35393":4007,"_29949":5682,"_30193":6910,"_35397":7475,"_35399":11202,"_35401":3614,"_35404":6153,"_35406":6651,"_35408":9021,"_35410":17212,"_35412":7109,"_35414":3089,"_35416":7722,"_35419":4878,"_35421":17252,"_35423":5702,"_35425":9998,"_35427":16640,"_35430":20602,"_35432":3377,"_35435":6132,"_35438":15409,"_35440":11517,"_35442":5117,"_35444