:58774,"_40657":58777,"_40659":58780,"_40661":58783,"_40663":58786,"_40665":58789,"_40667":58792,"_40669":58795,"_40671":58798,"_40673":58801,"_40675":58804,"_40677":58807,"_40679":58810,"_40681":58813,"_40683":58816,"_40686":58819,"_40688":58822,"_40690":58825,"_40692":58828},{"_3487":15,"_30445":15,"_5":14788,"_2970":49620,"_30797":49621,"_21099":49625,"_27663":15},"Deploy from AWS Marketplace",[49622,49623,49624],"Docs","Deployment","Other models",[],{"_3487":16,"_30445":15,"_21099":49627,"_5":14424,"_27663":15,"_2970":49628},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3487":17,"_30445":15,"_5":30794,"_21099":49630,"_27663":49631,"_2970":49632},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3487":18,"_30445":15,"_5":30794,"_21099":49634,"_27663":49635,"_2970":49636},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3487":19,"_30445":15,"_5":30794,"_21099":49638,"_27663":49639,"_2970":49640},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3487":20,"_30445":15,"_5":30794,"_21099":49642,"_27663":49643,"_2970":49644},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3487":21,"_30445":15,"_5":30794,"_21099":49646,"_27663":49647,"_2970":49648},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3487":22,"_30445":15,"_5":30794,"_21099":49650,"_27663":49651,"_2970":49652},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3487":23,"_30445":15,"_5":30794,"_21099":49654,"_27663":49655,"_2970":49656},[],"/docs/pr-preview/pr-68/deployment/aws-marketplace#next-step","Next step",{"_3487":24,"_30445":15,"_21099":49658,"_5":14424,"_27663":15,"_2970":49659},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3487":25,"_30445":15,"_21099":49661,"_5":14424,"_27663":49631,"_2970":49662},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3487":26,"_30445":15,"_21099":49664,"_5":14424,"_27663":49631,"_2970":49665},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3487":27,"_30445":15,"_21099":49667,"_5":14424,"_27663":49631,"_2970":49668},[],"A security group allowing the necessary endpoints.",{"_3487":28,"_30445":15,"_21099":49670,"_5":14424,"_27663":49635,"_2970":49671},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3487":29,"_30445":15,"_21099":49673,"_5":14424,"_27663":49635,"_2970":49674},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3487":30,"_30445":15,"_21099":49676,"_5":14424,"_27663":49635,"_2970":49677},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3487":31,"_30445":15,"_21099":49679,"_5":14424,"_27663":49639,"_2970":49680},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3487":32,"_30445":15,"_21099":49682,"_5":14424,"_27663":49643,"_2970":49683},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3487":33,"_30445":15,"_21099":49685,"_5":14424,"_27663":49647,"_2970":49686},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3487":34,"_30445":15,"_21099":49688,"_5":14424,"_27663":49651,"_2970":49689},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3487":35,"_30445":15,"_21099":49691,"_5":14424,"_27663":49655,"_2970":49692},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3487":36,"_30445":36,"_5":14788,"_2970":49694,"_30797":49695,"_21099":49696,"_27663":36},"Deploy Lamassu",[49622,49623],[],{"_3487":37,"_30445":36,"_21099":49698,"_5":14424,"_27663":36,"_2970":49699},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3487":38,"_30445":36,"_5":30794,"_21099":49701,"_27663":49702,"_2970":49703},[],"/docs/pr-preview/pr-68/deployment/overview#choose-a-model","Choose a model",{"_3487":39,"_30445":36,"_5":30794,"_21099":49705,"_27663":49706,"_2970":49707},[],"/docs/pr-preview/pr-68/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3487":40,"_30445":36,"_5":30794,"_21099":49709,"_27663":49710,"_2970":49711},[],"/docs/pr-preview/pr-68/deployment/overview#after-deployment","After deployment",{"_3487":41,"_30445":36,"_21099":49713,"_5":14424,"_27663":36,"_2970":49714},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3487":42,"_30445":36,"_21099":49716,"_5":14424,"_27663":49702,"_2970":49717},[],"Model",{"_3487":43,"_30445":36,"_21099":49719,"_5":14424,"_27663":49702,"_2970":49720},[],"Recommended for",{"_3487":44,"_30445":36,"_21099":49722,"_5":14424,"_27663":49702,"_2970":49723},[],"Who operates the infrastructure",{"_3487":45,"_30445":36,"_21099":49725,"_5":14424,"_27663":49702,"_2970":49726},[],"Starting point",{"_3487":46,"_30445":36,"_21099":49728,"_5":14424,"_27663":49702,"_2970":49729},[],"Kubernetes self-managed",{"_3487":47,"_30445":36,"_21099":49731,"_5":14424,"_27663":49702,"_2970":49732},[],"Production, regulated environments and custom deployments",{"_3487":48,"_30445":36,"_21099":49734,"_5":14424,"_27663":49702,"_2970":49735},[],"Your team",{"_3487":49,"_30445":36,"_21099":49737,"_5":14424,"_27663":49702,"_2970":49738},[],"Helm or Fastlane",{"_3487":50,"_30445":36,"_21099":49740,"_5":14424,"_27663":49702,"_2970":49741},[],"AWS Marketplace",{"_3487":51,"_30445":36,"_21099":49743,"_5":14424,"_27663":49702,"_2970":49744},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3487":52,"_30445":36,"_21099":49746,"_5":14424,"_27663":49702,"_2970":49735},[],{"_3487":53,"_30445":36,"_21099":49748,"_5":14424,"_27663":49702,"_2970":49749},[],"Preconfigured image on EC2",{"_3487":54,"_30445":36,"_21099":49751,"_5":14424,"_27663":49702,"_2970":49752},[],"SaaS",{"_3487":55,"_30445":36,"_21099":49754,"_5":14424,"_27663":49702,"_2970":49755},[],"Teams that want to use the platform without operating it",{"_3487":56,"_30445":36,"_21099":49757,"_5":14424,"_27663":49702,"_2970":49758},[],"Lamassu",{"_3487":57,"_30445":36,"_21099":49760,"_5":14424,"_27663":49702,"_2970":49761},[],"Managed subscription",{"_3487":58,"_30445":36,"_21099":49763,"_5":14424,"_27663":49702,"_2970":49764},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3487":59,"_30445":36,"_21099":49766,"_5":14424,"_27663":49702,"_2970":49767},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3487":60,"_30445":36,"_21099":49769,"_5":14424,"_27663":49702,"_2970":49770},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3487":61,"_30445":36,"_21099":49772,"_5":14424,"_27663":49706,"_2970":49773},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3487":62,"_30445":36,"_21099":49775,"_5":14424,"_27663":49710,"_2970":49776},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3487":63,"_30445":63,"_5":14788,"_2970":49778,"_30797":49779,"_21099":49780,"_27663":63},"Use Lamassu as SaaS",[49622,49623,49624],[],{"_3487":64,"_30445":63,"_21099":49782,"_5":14424,"_27663":63,"_2970":49783},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3487":65,"_30445":63,"_5":30794,"_21099":49785,"_27663":49786,"_2970":49787},[],"/docs/pr-preview/pr-68/deployment/saas#what-the-service-manages","What the service manages",{"_3487":66,"_30445":63,"_5":30794,"_21099":49789,"_27663":49790,"_2970":49791},[],"/docs/pr-preview/pr-68/deployment/saas#plans","Plans",{"_3487":67,"_30445":63,"_5":30794,"_21099":49793,"_27663":49794,"_2970":49795},[],"/docs/pr-preview/pr-68/deployment/saas#request-access","Request access",{"_3487":68,"_30445":63,"_21099":49797,"_5":14424,"_27663":63,"_2970":49798},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3487":69,"_30445":63,"_21099":49800,"_5":14424,"_27663":49786,"_2970":49801},[],"Platform availability and maintenance.",{"_3487":70,"_30445":63,"_21099":49803,"_5":14424,"_27663":49786,"_2970":49804},[],"Automatic backups.",{"_3487":71,"_30445":63,"_21099":49806,"_5":14424,"_27663":49786,"_2970":49807},[],"Version upgrades.",{"_3487":72,"_30445":63,"_21099":49809,"_5":14424,"_27663":49786,"_2970":49810},[],"Technical support and SLA according to your plan.",{"_3487":73,"_30445":63,"_21099":49812,"_5":14424,"_27663":49790,"_2970":49813},[],"Plan",{"_3487":74,"_30445":63,"_21099":49815,"_5":14424,"_27663":49790,"_2970":49816},[],"Devices",{"_3487":75,"_30445":63,"_21099":49818,"_5":14424,"_27663":49790,"_2970":49819},[],"Support",{"_3487":76,"_30445":63,"_21099":49821,"_5":14424,"_27663":49790,"_2970":49822},[],"SLA",{"_3487":77,"_30445":63,"_21099":49824,"_5":14424,"_27663":49790,"_2970":49825},[],"Starter",{"_3487":78,"_30445":63,"_21099":49827,"_5":14424,"_27663":49790,"_2970":49828},[],"Up to 1,000",{"_3487":79,"_30445":63,"_21099":49830,"_5":14424,"_27663":49790,"_2970":49831},[],"Email",{"_3487":80,"_30445":63,"_21099":49833,"_5":14424,"_27663":49790,"_2970":49834},[],"99.5 %",{"_3487":81,"_30445":63,"_21099":49836,"_5":14424,"_27663":49790,"_2970":49837},[],"Professional",{"_3487":82,"_30445":63,"_21099":49839,"_5":14424,"_27663":49790,"_2970":49840},[],"Up to 10,000",{"_3487":83,"_30445":63,"_21099":49842,"_5":14424,"_27663":49790,"_2970":49843},[],"Email and chat",{"_3487":84,"_30445":63,"_21099":49845,"_5":14424,"_27663":49790,"_2970":49846},[],"99.9 %",{"_3487":85,"_30445":63,"_21099":49848,"_5":14424,"_27663":49790,"_2970":49849},[],"Enterprise",{"_3487":86,"_30445":63,"_21099":49851,"_5":14424,"_27663":49790,"_2970":49852},[],"Unlimited",{"_3487":87,"_30445":63,"_21099":49854,"_5":14424,"_27663":49790,"_2970":49855},[],"Dedicated",{"_3487":88,"_30445":63,"_21099":49857,"_5":14424,"_27663":49790,"_2970":49858},[],"99.99 %",{"_3487":89,"_30445":63,"_21099":49860,"_5":14424,"_27663":49794,"_2970":49861},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3487":90,"_30445":63,"_21099":49863,"_5":14424,"_27663":49794,"_2970":49864},[],"When you receive your instance's credentials, continue with Get started.",{"_3487":91,"_30445":91,"_5":14788,"_2970":49866,"_30797":49867,"_21099":49868,"_27663":91},"Fastlane",[49622,49623,49729],[],{"_3487":92,"_30445":91,"_21099":49870,"_5":14424,"_27663":91,"_2970":49871},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3487":93,"_30445":91,"_5":30794,"_21099":49873,"_27663":49874,"_2970":49875},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3487":94,"_30445":91,"_5":30794,"_21099":49877,"_27663":49878,"_2970":49879},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3487":95,"_30445":91,"_5":30794,"_21099":49881,"_27663":49882,"_2970":49632},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#before-you-begin",{"_3487":96,"_30445":91,"_5":30794,"_21099":49884,"_27663":49885,"_2970":49886},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3487":97,"_30445":91,"_5":30794,"_21099":49888,"_27663":49889,"_2970":49890},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3487":98,"_30445":91,"_5":30794,"_21099":49892,"_27663":49893,"_2970":49894},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3487":99,"_30445":91,"_5":30794,"_21099":49896,"_27663":49897,"_2970":49898},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3487":100,"_30445":91,"_5":30794,"_21099":49900,"_27663":49901,"_2970":49902},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3487":101,"_30445":91,"_5":30794,"_21099":49904,"_27663":49905,"_2970":49906},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3487":102,"_30445":91,"_5":30794,"_21099":49908,"_27663":49909,"_2970":49910},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3487":103,"_30445":91,"_5":30794,"_21099":49912,"_27663":49913,"_2970":49914},[],"/docs/pr-preview/pr-68/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3487":104,"_30445":91,"_21099":49916,"_5":14424,"_27663":49874,"_2970":49917},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3487":105,"_30445":91,"_21099":49919,"_5":14424,"_27663":49874,"_2970":49920},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3487":106,"_30445":91,"_21099":49922,"_5":14424,"_27663":49878,"_2970":49923},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3487":107,"_30445":91,"_21099":49925,"_5":14424,"_27663":49878,"_2970":49926},[],"Fastlane installs or configures",{"_3487":108,"_30445":91,"_21099":49928,"_5":14424,"_27663":49878,"_2970":49929},[],"You still provide",{"_3487":109,"_30445":91,"_21099":49931,"_5":14424,"_27663":49878,"_2970":49932},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3487":110,"_30445":91,"_21099":49934,"_5":14424,"_27663":49878,"_2970":49935},[],"The Kubernetes cluster, nodes and persistent storage",{"_3487":111,"_30445":91,"_21099":49937,"_5":14424,"_27663":49878,"_2970":49938},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3487":112,"_30445":91,"_21099":49940,"_5":14424,"_27663":49878,"_2970":49941},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3487":113,"_30445":91,"_21099":49943,"_5":14424,"_27663":49878,"_2970":49944},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3487":114,"_30445":91,"_21099":49946,"_5":14424,"_27663":49878,"_2970":49947},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3487":115,"_30445":91,"_21099":49949,"_5":14424,"_27663":49878,"_2970":49950},[],"Optional observability and lab HSM components",{"_3487":116,"_30445":91,"_21099":49952,"_5":14424,"_27663":49878,"_2970":49953},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3487":117,"_30445":91,"_21099":49955,"_5":14424,"_27663":49878,"_2970":49956},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3487":118,"_30445":91,"_21099":49958,"_5":14424,"_27663":49882,"_2970":49959},[],"You need:",{"_3487":119,"_30445":91,"_21099":49961,"_5":14424,"_27663":49882,"_2970":49962},[],"an existing Kubernetes cluster",{"_3487":120,"_30445":91,"_21099":49964,"_5":14424,"_27663":49882,"_2970":49965},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3487":121,"_30445":91,"_21099":49967,"_5":14424,"_27663":49882,"_2970":49968},[],"`yq`",{"_3487":122,"_30445":91,"_21099":49970,"_5":14424,"_27663":49882,"_2970":23849},[],{"_3487":123,"_30445":91,"_21099":49972,"_5":14424,"_27663":49882,"_2970":49973},[],"`jq` only when using `--sample-data` or `--development`",{"_3487":124,"_30445":91,"_21099":49975,"_5":14424,"_27663":49882,"_2970":49976},[],"`ssh-keygen` only when using `--with-hsm`",{"_3487":125,"_30445":91,"_21099":49978,"_5":14424,"_27663":49882,"_2970":49979},[],"free external ports 80 and 443 on a single-node K3s host",{"_3487":126,"_30445":91,"_21099":49981,"_5":14424,"_27663":49882,"_2970":49982},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3487":127,"_30445":91,"_21099":49984,"_5":14424,"_27663":49882,"_2970":49985},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3487":128,"_30445":91,"_21099":49987,"_5":14424,"_27663":49885,"_2970":49988},[],"Run the script from a clone of the Helm repository:",{"_3487":129,"_30445":91,"_21099":49990,"_5":14424,"_27663":49885,"_2970":49991},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3487":130,"_30445":91,"_21099":49993,"_5":14424,"_27663":49889,"_2970":49994},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3487":131,"_30445":91,"_21099":49996,"_5":14424,"_27663":49889,"_2970":49997},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3487":132,"_30445":91,"_21099":49999,"_5":14424,"_27663":49889,"_2970":50000},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3487":133,"_30445":91,"_21099":50002,"_5":14424,"_27663":49889,"_2970":50003},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3487":134,"_30445":91,"_21099":50005,"_5":14424,"_27663":49893,"_2970":50006},[],"Option",{"_3487":135,"_30445":91,"_21099":50008,"_5":14424,"_27663":49893,"_2970":50009},[],"Default",{"_3487":136,"_30445":91,"_21099":50011,"_5":14424,"_27663":49893,"_2970":50012},[],"Purpose",{"_3487":137,"_30445":91,"_21099":50014,"_5":14424,"_27663":49893,"_2970":50015},[],"`-h`, `--help`",{"_3487":138,"_30445":91,"_21099":50017,"_5":14424,"_27663":49893,"_2970":50018},[],"—",{"_3487":139,"_30445":91,"_21099":50020,"_5":14424,"_27663":49893,"_2970":50021},[],"Show help",{"_3487":140,"_30445":91,"_21099":50023,"_5":14424,"_27663":49893,"_2970":50024},[],"`-c`, `--context`",{"_3487":141,"_30445":91,"_21099":50026,"_5":14424,"_27663":49893,"_2970":50027},[],"current context",{"_3487":142,"_30445":91,"_21099":50029,"_5":14424,"_27663":49893,"_2970":50030},[],"Select the kubeconfig context for kubectl and Helm",{"_3487":143,"_30445":91,"_21099":50032,"_5":14424,"_27663":49893,"_2970":50033},[],"`-n`, `--non-interactive`",{"_3487":144,"_30445":91,"_21099":50035,"_5":14424,"_27663":49893,"_2970":6574},[],{"_3487":145,"_30445":91,"_21099":50037,"_5":14424,"_27663":49893,"_2970":50038},[],"Skip prompts and generate dependency credentials",{"_3487":146,"_30445":91,"_21099":50040,"_5":14424,"_27663":49893,"_2970":50041},[],"`-ns`, `--namespace`",{"_3487":147,"_30445":91,"_21099":50043,"_5":14424,"_27663":49893,"_2970":50044},[],"`lamassu-dev`",{"_3487":148,"_30445":91,"_21099":50046,"_5":14424,"_27663":49893,"_2970":50047},[],"Namespace for the installation",{"_3487":149,"_30445":91,"_21099":50049,"_5":14424,"_27663":49893,"_2970":50050},[],"`-d`, `--domain`",{"_3487":150,"_30445":91,"_21099":50052,"_5":14424,"_27663":49893,"_2970":50053},[],"`dev.lamassu.io`",{"_3487":151,"_30445":91,"_21099":50055,"_5":14424,"_27663":49893,"_2970":50056},[],"Domain used by the UI, OIDC and certificate",{"_3487":152,"_30445":91,"_21099":50058,"_5":14424,"_27663":49893,"_2970":50059},[],"`-v`, `--version`",{"_3487":153,"_30445":91,"_21099":50061,"_5":14424,"_27663":49893,"_2970":15225},[],{"_3487":154,"_30445":91,"_21099":50063,"_5":14424,"_27663":49893,"_2970":50064},[],"Lamassu chart version",{"_3487":155,"_30445":91,"_21099":50066,"_5":14424,"_27663":49893,"_2970":50067},[],"`--https-port`",{"_3487":156,"_30445":91,"_21099":50069,"_5":14424,"_27663":49893,"_2970":50070},[],"`443`",{"_3487":157,"_30445":91,"_21099":50072,"_5":14424,"_27663":49893,"_2970":50073},[],"Gateway HTTPS listener port",{"_3487":158,"_30445":91,"_21099":50075,"_5":14424,"_27663":49893,"_2970":50076},[],"`--http-port`",{"_3487":159,"_30445":91,"_21099":50078,"_5":14424,"_27663":49893,"_2970":50079},[],"`80`",{"_3487":160,"_30445":91,"_21099":50081,"_5":14424,"_27663":49893,"_2970":50082},[],"Gateway HTTP listener port",{"_3487":161,"_30445":91,"_21099":50084,"_5":14424,"_27663":49893,"_2970":50085},[],"`--tls-crt`",{"_3487":162,"_30445":91,"_21099":50087,"_5":14424,"_27663":49893,"_2970":50018},[],{"_3487":163,"_30445":91,"_21099":50089,"_5":14424,"_27663":49893,"_2970":50090},[],"PEM certificate for downstream TLS",{"_3487":164,"_30445":91,"_21099":50092,"_5":14424,"_27663":49893,"_2970":50093},[],"`--tls-key`",{"_3487":165,"_30445":91,"_21099":50095,"_5":14424,"_27663":49893,"_2970":50018},[],{"_3487":166,"_30445":91,"_21099":50097,"_5":14424,"_27663":49893,"_2970":50098},[],"PEM private key for downstream TLS",{"_3487":167,"_30445":91,"_21099":50100,"_5":14424,"_27663":49893,"_2970":50101},[],"`-l`, `--local-chart-path`",{"_3487":168,"_30445":91,"_21099":50103,"_5":14424,"_27663":49893,"_2970":50104},[],"repository chart",{"_3487":169,"_30445":91,"_21099":50106,"_5":14424,"_27663":49893,"_2970":50107},[],"Use an unpacked local Lamassu chart",{"_3487":170,"_30445":91,"_21099":50109,"_5":14424,"_27663":49893,"_2970":50110},[],"`-ip`, `--gateway-ip`",{"_3487":171,"_30445":91,"_21099":50112,"_5":14424,"_27663":49893,"_2970":8774},[],{"_3487":172,"_30445":91,"_21099":50114,"_5":14424,"_27663":49893,"_2970":50115},[],"Override the address written to `gateway.addresses`",{"_3487":173,"_30445":91,"_21099":50117,"_5":14424,"_27663":49893,"_2970":50118},[],"`--otel`",{"_3487":174,"_30445":91,"_21099":50120,"_5":14424,"_27663":49893,"_2970":6574},[],{"_3487":175,"_30445":91,"_21099":50122,"_5":14424,"_27663":49893,"_2970":50123},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3487":176,"_30445":91,"_21099":50125,"_5":14424,"_27663":49893,"_2970":50126},[],"`--development`",{"_3487":177,"_30445":91,"_21099":50128,"_5":14424,"_27663":49893,"_2970":6574},[],{"_3487":178,"_30445":91,"_21099":50130,"_5":14424,"_27663":49893,"_2970":50131},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3487":179,"_30445":91,"_21099":50133,"_5":14424,"_27663":49893,"_2970":50134},[],"`--sample-data`",{"_3487":180,"_30445":91,"_21099":50136,"_5":14424,"_27663":49893,"_2970":6574},[],{"_3487":181,"_30445":91,"_21099":50138,"_5":14424,"_27663":49893,"_2970":50139},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3487":182,"_30445":91,"_21099":50141,"_5":14424,"_27663":49893,"_2970":50142},[],"`--with-hsm`",{"_3487":183,"_30445":91,"_21099":50144,"_5":14424,"_27663":49893,"_2970":6574},[],{"_3487":184,"_30445":91,"_21099":50146,"_5":14424,"_27663":49893,"_2970":50147},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3487":185,"_30445":91,"_21099":50149,"_5":14424,"_27663":49893,"_2970":50150},[],"`--softhsm-chart-path`",{"_3487":186,"_30445":91,"_21099":50152,"_5":14424,"_27663":49893,"_2970":50153},[],"`./charts/softhsm`",{"_3487":187,"_30445":91,"_21099":50155,"_5":14424,"_27663":49893,"_2970":50156},[],"Use a different local SoftHSM chart",{"_3487":188,"_30445":91,"_21099":50158,"_5":14424,"_27663":49893,"_2970":50159},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3487":189,"_30445":91,"_21099":50161,"_5":14424,"_27663":49897,"_2970":50162},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3487":190,"_30445":91,"_21099":50164,"_5":14424,"_27663":49897,"_2970":50165},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3487":191,"_30445":91,"_21099":50167,"_5":14424,"_27663":49897,"_2970":50168},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3487":192,"_30445":91,"_21099":50170,"_5":14424,"_27663":49897,"_2970":50171},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3487":193,"_30445":91,"_21099":50173,"_5":14424,"_27663":49897,"_2970":50174},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3487":194,"_30445":91,"_21099":50176,"_5":14424,"_27663":49897,"_2970":50177},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3487":195,"_30445":91,"_21099":50179,"_5":14424,"_27663":49901,"_2970":50180},[],"Fastlane:",{"_3487":196,"_30445":91,"_21099":50182,"_5":14424,"_27663":49901,"_2970":50183},[],"validates local tools and the selected cluster",{"_3487":197,"_30445":91,"_21099":50185,"_5":14424,"_27663":49901,"_2970":50186},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3487":198,"_30445":91,"_21099":50188,"_5":14424,"_27663":49901,"_2970":50189},[],"creates the namespace",{"_3487":199,"_30445":91,"_21099":50191,"_5":14424,"_27663":49901,"_2970":50192},[],"installs PostgreSQL and creates the required databases",{"_3487":200,"_30445":91,"_21099":50194,"_5":14424,"_27663":49901,"_2970":50195},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3487":201,"_30445":91,"_21099":50197,"_5":14424,"_27663":49901,"_2970":50198},[],"installs RabbitMQ",{"_3487":202,"_30445":91,"_21099":50200,"_5":14424,"_27663":49901,"_2970":50201},[],"optionally installs observability and lab HSM components",{"_3487":203,"_30445":91,"_21099":50203,"_5":14424,"_27663":49901,"_2970":50204},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3487":204,"_30445":91,"_21099":50206,"_5":14424,"_27663":49901,"_2970":50207},[],"optionally loads sample data",{"_3487":205,"_30445":91,"_21099":50209,"_5":14424,"_27663":49901,"_2970":50210},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3487":206,"_30445":91,"_21099":50212,"_5":14424,"_27663":49905,"_2970":50213},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3487":207,"_30445":91,"_21099":50215,"_5":14424,"_27663":49905,"_2970":50216},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3487":208,"_30445":91,"_21099":50218,"_5":14424,"_27663":49909,"_2970":50219},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3487":209,"_30445":91,"_21099":50221,"_5":14424,"_27663":49909,"_2970":50222},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3487":210,"_30445":91,"_21099":50224,"_5":14424,"_27663":49909,"_2970":50225},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3487":211,"_30445":91,"_21099":50227,"_5":14424,"_27663":49913,"_2970":50228},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3487":212,"_30445":212,"_5":14788,"_2970":50230,"_30797":50231,"_21099":50232,"_27663":212},"Install with Helm",[49622,49623,49729],[],{"_3487":213,"_30445":212,"_21099":50234,"_5":14424,"_27663":212,"_2970":50235},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3487":214,"_30445":212,"_5":30794,"_21099":50237,"_27663":50238,"_2970":50239},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3487":215,"_30445":212,"_5":30794,"_21099":50241,"_27663":50242,"_2970":49632},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#before-you-begin",{"_3487":216,"_30445":212,"_5":30794,"_21099":50244,"_27663":50245,"_2970":50246},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3487":217,"_30445":212,"_5":30794,"_21099":50248,"_27663":50249,"_2970":50250},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3487":218,"_30445":212,"_5":30794,"_21099":50252,"_27663":50253,"_2970":50254},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3487":219,"_30445":212,"_5":30794,"_21099":50256,"_27663":50257,"_2970":50258},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3487":220,"_30445":212,"_5":30794,"_21099":50260,"_27663":50261,"_2970":50262},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#credential-environment-variables","Credential environment variables",{"_3487":221,"_30445":212,"_5":30794,"_21099":50264,"_27663":50265,"_2970":50266},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3487":222,"_30445":212,"_5":30794,"_21099":50268,"_27663":50269,"_2970":50270},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3487":223,"_30445":212,"_5":30794,"_21099":50272,"_27663":50273,"_2970":50274},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3487":224,"_30445":212,"_5":30794,"_21099":50276,"_27663":50277,"_2970":50278},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3487":225,"_30445":212,"_5":30794,"_21099":50280,"_27663":50281,"_2970":50282},[],"/docs/pr-preview/pr-68/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3487":226,"_30445":212,"_21099":50284,"_5":14424,"_27663":50238,"_2970":50285},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3487":227,"_30445":212,"_21099":50287,"_5":14424,"_27663":50242,"_2970":50288},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3487":228,"_30445":212,"_21099":50290,"_5":14424,"_27663":50242,"_2970":50291},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3487":229,"_30445":212,"_21099":50293,"_5":14424,"_27663":50242,"_2970":50294},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3487":230,"_30445":212,"_21099":50296,"_5":14424,"_27663":50242,"_2970":50297},[],"a reachable RabbitMQ broker and credentials",{"_3487":231,"_30445":212,"_21099":50299,"_5":14424,"_27663":50242,"_2970":50300},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3487":232,"_30445":212,"_21099":50302,"_5":14424,"_27663":50242,"_2970":50303},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3487":233,"_30445":212,"_21099":50305,"_5":14424,"_27663":50242,"_2970":50306},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3487":234,"_30445":212,"_21099":50308,"_5":14424,"_27663":50242,"_2970":50309},[],"a StorageClass and an external traffic design",{"_3487":235,"_30445":212,"_21099":50311,"_5":14424,"_27663":50242,"_2970":50312},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3487":236,"_30445":212,"_21099":50314,"_5":14424,"_27663":50242,"_2970":50315},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3487":237,"_30445":212,"_21099":50317,"_5":14424,"_27663":50242,"_2970":50318},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3487":238,"_30445":212,"_21099":50320,"_5":14424,"_27663":50245,"_2970":50321},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3487":239,"_30445":212,"_21099":50323,"_5":14424,"_27663":50245,"_2970":50324},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3487":240,"_30445":212,"_21099":50326,"_5":14424,"_27663":50245,"_2970":50327},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3487":241,"_30445":212,"_21099":50329,"_5":14424,"_27663":50249,"_2970":50330},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3487":242,"_30445":212,"_21099":50332,"_5":14424,"_27663":50249,"_2970":50333},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3487":243,"_30445":212,"_21099":50335,"_5":14424,"_27663":50249,"_2970":50336},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3487":244,"_30445":212,"_21099":50338,"_5":14424,"_27663":50249,"_2970":50339},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3487":245,"_30445":212,"_21099":50341,"_5":14424,"_27663":50253,"_2970":50342},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3487":246,"_30445":212,"_21099":50344,"_5":14424,"_27663":50257,"_2970":50345},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3487":247,"_30445":212,"_21099":50347,"_5":14424,"_27663":50257,"_2970":50348},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3487":248,"_30445":212,"_21099":50350,"_5":14424,"_27663":50257,"_2970":50351},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3487":249,"_30445":212,"_21099":50353,"_5":14424,"_27663":50257,"_2970":50354},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3487":250,"_30445":212,"_21099":50356,"_5":14424,"_27663":50257,"_2970":50357},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3487":251,"_30445":212,"_21099":50359,"_5":14424,"_27663":50257,"_2970":50360},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3487":252,"_30445":212,"_21099":50362,"_5":14424,"_27663":50257,"_2970":50363},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3487":253,"_30445":212,"_21099":50365,"_5":14424,"_27663":50261,"_2970":50366},[],"The services read an explicit catalog of credential environment variables when they load their configuration at startup. A set, non-empty variable overrides the corresponding YAML value; an unset variable leaves the YAML value in place, so a deployment configured only through YAML keeps working unchanged. A variable can also supply a credential the values file does not define. Variables outside this catalog are ignored — other `LAMASSU_*` variables are not picked up automatically.",{"_3487":254,"_30445":212,"_21099":50368,"_5":14424,"_27663":50261,"_2970":50369},[],"Variables",{"_3487":255,"_30445":212,"_21099":50371,"_5":14424,"_27663":50261,"_2970":50372},[],"Configures",{"_3487":256,"_30445":212,"_21099":50374,"_5":14424,"_27663":50261,"_2970":50375},[],"`LAMASSU_POSTGRES_USERNAME`, `LAMASSU_POSTGRES_PASSWORD`",{"_3487":257,"_30445":212,"_21099":50377,"_5":14424,"_27663":50261,"_2970":50378},[],"PostgreSQL storage credentials",{"_3487":258,"_30445":212,"_21099":50380,"_5":14424,"_27663":50261,"_2970":50381},[],"`LAMASSU_AUTHZ_DB_USERNAME`, `LAMASSU_AUTHZ_DB_PASSWORD`",{"_3487":259,"_30445":212,"_21099":50383,"_5":14424,"_27663":50261,"_2970":50384},[],"the authz service's own database credentials",{"_3487":260,"_30445":212,"_21099":50386,"_5":14424,"_27663":50261,"_2970":50387},[],"`LAMASSU_AMQP_USERNAME`, `LAMASSU_AMQP_PASSWORD`",{"_3487":261,"_30445":212,"_21099":50389,"_5":14424,"_27663":50261,"_2970":50390},[],"one pair applied to every event-bus connection: publisher, subscriber and dead-letter queues. There is no per-queue split.",{"_3487":262,"_30445":212,"_21099":50392,"_5":14424,"_27663":50261,"_2970":50393},[],"`LAMASSU_SMTP_USERNAME`, `LAMASSU_SMTP_PASSWORD`",{"_3487":263,"_30445":212,"_21099":50395,"_5":14424,"_27663":50261,"_2970":50396},[],"SMTP credentials used by alert email delivery",{"_3487":264,"_30445":212,"_21099":50398,"_5":14424,"_27663":50261,"_2970":50399},[],"`LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_USERNAME`, `LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_PASSWORD`",{"_3487":265,"_30445":212,"_21099":50401,"_5":14424,"_27663":50261,"_2970":50402},[],"one pair per schema defined in the `services.authz.credentials` map",{"_3487":266,"_30445":212,"_21099":50404,"_5":14424,"_27663":50261,"_2970":50405},[],"Setting a catalog variable to the empty string never overrides anything. If the YAML (or default) value is non-empty, the service fails at startup with an error that names the variable and the configuration key, such as `LAMASSU_POSTGRES_PASSWORD is set but empty`. An empty variable combined with an empty or absent YAML value is allowed.",{"_3487":267,"_30445":212,"_21099":50407,"_5":14424,"_27663":50261,"_2970":50408},[],"For the authz schemas, `<SCHEMA>` is the YAML schema name uppercased with every non-alphanumeric character replaced by `_`: `pki` maps to `PKI`, and both `pki-v2` and `pki.v2` map to `PKI_V2`. Bindings exist only for schemas present in the YAML credentials map, so variables for schemas that are not listed are ignored. Two schemas that normalize to the same name (`pki-v2` and `pki.v2`) conflict: if a variable of either pair is set, the service fails at startup; if the variables are unset, a warning is logged and the YAML values are used.",{"_3487":268,"_30445":212,"_21099":50410,"_5":14424,"_27663":50261,"_2970":50411},[],"These variables are designed to be sourced from Kubernetes Secrets, so credentials no longer need to be written into the rendered YAML. For example, inject a pair into a service pod with the standard Kubernetes `secretKeyRef` mechanism:",{"_3487":269,"_30445":212,"_21099":50413,"_5":14424,"_27663":50261,"_2970":50414},[],"Because the variables are read when the service loads its configuration at startup, changing the underlying Secret requires restarting the consuming pods for the new values to take effect.",{"_3487":270,"_30445":212,"_21099":50416,"_5":14424,"_27663":50265,"_2970":50417},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3487":271,"_30445":212,"_21099":50419,"_5":14424,"_27663":50265,"_2970":50420},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3487":272,"_30445":212,"_21099":50422,"_5":14424,"_27663":50265,"_2970":50423},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3487":273,"_30445":212,"_21099":50425,"_5":14424,"_27663":50265,"_2970":50426},[],"See Access control for the principal and policy model.",{"_3487":274,"_30445":212,"_21099":50428,"_5":14424,"_27663":50269,"_2970":50429},[],"To install a local checkout instead:",{"_3487":275,"_30445":212,"_21099":50431,"_5":14424,"_27663":50273,"_2970":50432},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3487":276,"_30445":212,"_21099":50434,"_5":14424,"_27663":50273,"_2970":50435},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3487":277,"_30445":212,"_21099":50437,"_5":14424,"_27663":50277,"_2970":50438},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3487":278,"_30445":212,"_21099":50440,"_5":14424,"_27663":50277,"_2970":50441},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3487":279,"_30445":212,"_21099":50443,"_5":14424,"_27663":50277,"_2970":50444},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3487":280,"_30445":212,"_21099":50446,"_5":14424,"_27663":50277,"_2970":50447},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3487":281,"_30445":212,"_21099":50449,"_5":14424,"_27663":50277,"_2970":50450},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3487":282,"_30445":212,"_21099":50452,"_5":14424,"_27663":50281,"_2970":50453},[],"Before going live, review:",{"_3487":283,"_30445":212,"_21099":50455,"_5":14424,"_27663":50281,"_2970":50456},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3487":284,"_30445":212,"_21099":50458,"_5":14424,"_27663":50281,"_2970":50459},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3487":285,"_30445":212,"_21099":50461,"_5":14424,"_27663":50281,"_2970":50462},[],"shared VA storage before increasing VA replicas",{"_3487":286,"_30445":212,"_21099":50464,"_5":14424,"_27663":50281,"_2970":50465},[],"managed OIDC roles and removal of evaluation credentials",{"_3487":287,"_30445":212,"_21099":50467,"_5":14424,"_27663":50281,"_2970":50468},[],"a trusted TLS issuer or externally managed certificate",{"_3487":288,"_30445":212,"_21099":50470,"_5":14424,"_27663":50281,"_2970":50471},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3487":289,"_30445":212,"_21099":50473,"_5":14424,"_27663":50281,"_2970":50474},[],"SMTP, observability and alert delivery",{"_3487":290,"_30445":212,"_21099":50476,"_5":14424,"_27663":50281,"_2970":50477},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3487":291,"_30445":212,"_21099":50479,"_5":14424,"_27663":50281,"_2970":50480},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3487":292,"_30445":292,"_5":14788,"_2970":50482,"_30797":50483,"_21099":50484,"_27663":292},"Expose the Gateway",[49622,49623,49729],[],{"_3487":293,"_30445":292,"_21099":50486,"_5":14424,"_27663":292,"_2970":50487},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3487":294,"_30445":292,"_5":30794,"_21099":50489,"_27663":50490,"_2970":50491},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3487":295,"_30445":292,"_5":30794,"_21099":50493,"_27663":50494,"_2970":50495},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3487":296,"_30445":292,"_5":30794,"_21099":50497,"_27663":50498,"_2970":50499},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3487":297,"_30445":292,"_5":30794,"_21099":50501,"_27663":50502,"_2970":50503},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#k3s","K3s",{"_3487":298,"_30445":292,"_5":30794,"_21099":50505,"_27663":50506,"_2970":50507},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3487":299,"_30445":292,"_5":30794,"_21099":50509,"_27663":50510,"_2970":50511},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3487":300,"_30445":292,"_5":30794,"_21099":50513,"_27663":50514,"_2970":50515},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3487":301,"_30445":292,"_5":30794,"_21099":50517,"_27663":50518,"_2970":50519},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3487":302,"_30445":292,"_5":30794,"_21099":50521,"_27663":50522,"_2970":50523},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3487":303,"_30445":292,"_5":30794,"_21099":50525,"_27663":50526,"_2970":50527},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3487":304,"_30445":292,"_5":30794,"_21099":50529,"_27663":50530,"_2970":50531},[],"/docs/pr-preview/pr-68/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3487":305,"_30445":292,"_21099":50533,"_5":14424,"_27663":50490,"_2970":50534},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3487":306,"_30445":292,"_21099":50536,"_5":14424,"_27663":50490,"_2970":50537},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3487":307,"_30445":292,"_21099":50539,"_5":14424,"_27663":50494,"_2970":50540},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3487":308,"_30445":292,"_21099":50542,"_5":14424,"_27663":50494,"_2970":50543},[],"Set it only when:",{"_3487":309,"_30445":292,"_21099":50545,"_5":14424,"_27663":50494,"_2970":50546},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3487":310,"_30445":292,"_21099":50548,"_5":14424,"_27663":50494,"_2970":50549},[],"that address is allocated to this Gateway",{"_3487":311,"_30445":292,"_21099":50551,"_5":14424,"_27663":50494,"_2970":50552},[],"the surrounding network already routes traffic for it to the cluster",{"_3487":312,"_30445":292,"_21099":50554,"_5":14424,"_27663":50494,"_2970":50555},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3487":313,"_30445":292,"_21099":50557,"_5":14424,"_27663":50494,"_2970":50558},[],"Keep these two settings separate:",{"_3487":314,"_30445":292,"_21099":50560,"_5":14424,"_27663":50494,"_2970":50561},[],"`gateway.addresses` requests an address for the Gateway.",{"_3487":315,"_30445":292,"_21099":50563,"_5":14424,"_27663":50494,"_2970":50564},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3487":316,"_30445":292,"_21099":50566,"_5":14424,"_27663":50494,"_2970":50567},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3487":317,"_30445":292,"_21099":50569,"_5":14424,"_27663":50498,"_2970":50570},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3487":318,"_30445":292,"_21099":50572,"_5":14424,"_27663":50498,"_2970":50573},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3487":319,"_30445":292,"_21099":50575,"_5":14424,"_27663":50502,"_2970":50576},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3487":320,"_30445":292,"_21099":50578,"_5":14424,"_27663":50502,"_2970":50579},[],"For the recommended design:",{"_3487":321,"_30445":292,"_21099":50581,"_5":14424,"_27663":50502,"_2970":50582},[],"Use only one externally exposed Lamassu Gateway.",{"_3487":322,"_30445":292,"_21099":50584,"_5":14424,"_27663":50502,"_2970":50585},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3487":323,"_30445":292,"_21099":50587,"_5":14424,"_27663":50502,"_2970":50588},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3487":324,"_30445":292,"_21099":50590,"_5":14424,"_27663":50502,"_2970":50591},[],"Point DNS at the VM's reachable address.",{"_3487":325,"_30445":292,"_21099":50593,"_5":14424,"_27663":50502,"_2970":50594},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3487":326,"_30445":292,"_21099":50596,"_5":14424,"_27663":50506,"_2970":50597},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3487":327,"_30445":292,"_21099":50599,"_5":14424,"_27663":50510,"_2970":50600},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3487":328,"_30445":292,"_21099":50602,"_5":14424,"_27663":50510,"_2970":50603},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3487":329,"_30445":292,"_21099":50605,"_5":14424,"_27663":50514,"_2970":50606},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3487":330,"_30445":292,"_21099":50608,"_5":14424,"_27663":50514,"_2970":50609},[],"Requirement",{"_3487":331,"_30445":292,"_21099":50611,"_5":14424,"_27663":50514,"_2970":50612},[],"Recommended design",{"_3487":332,"_30445":292,"_21099":50614,"_5":14424,"_27663":50514,"_2970":50615},[],"Consequence",{"_3487":333,"_30445":292,"_21099":50617,"_5":14424,"_27663":50514,"_2970":50618},[],"Several Lamassu URLs or services",{"_3487":334,"_30445":292,"_21099":50620,"_5":14424,"_27663":50514,"_2970":50621},[],"One Gateway with multiple routes",{"_3487":335,"_30445":292,"_21099":50623,"_5":14424,"_27663":50514,"_2970":50624},[],"One IP and one proxy fleet; this is the chart default",{"_3487":336,"_30445":292,"_21099":50626,"_5":14424,"_27663":50514,"_2970":50627},[],"Independent Gateways and separate external IPs",{"_3487":337,"_30445":292,"_21099":50629,"_5":14424,"_27663":50514,"_2970":50630},[],"One VIP per Gateway",{"_3487":338,"_30445":292,"_21099":50632,"_5":14424,"_27663":50514,"_2970":50633},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3487":339,"_30445":292,"_21099":50635,"_5":14424,"_27663":50514,"_2970":50636},[],"Independent Gateways on one node and one IP",{"_3487":340,"_30445":292,"_21099":50638,"_5":14424,"_27663":50514,"_2970":50639},[],"Use different external ports",{"_3487":341,"_30445":292,"_21099":50641,"_5":14424,"_27663":50514,"_2970":50642},[],"Clients must include non-standard ports",{"_3487":342,"_30445":292,"_21099":50644,"_5":14424,"_27663":50514,"_2970":50645},[],"Separate TLS/mTLS termination behind one IP",{"_3487":343,"_30445":292,"_21099":50647,"_5":14424,"_27663":50514,"_2970":50648},[],"Front-door SNI routing to internal Gateways",{"_3487":344,"_30445":292,"_21099":50650,"_5":14424,"_27663":50514,"_2970":50651},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3487":345,"_30445":292,"_21099":50653,"_5":14424,"_27663":50514,"_2970":50654},[],"Separate Gateway resources but shared proxy infrastructure",{"_3487":346,"_30445":292,"_21099":50656,"_5":14424,"_27663":50514,"_2970":50657},[],"Envoy merged-Gateway mode",{"_3487":347,"_30445":292,"_21099":50659,"_5":14424,"_27663":50514,"_2970":50660},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3487":348,"_30445":292,"_21099":50662,"_5":14424,"_27663":50514,"_2970":50663},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3487":349,"_30445":292,"_21099":50665,"_5":14424,"_27663":50514,"_2970":50666},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3487":350,"_30445":292,"_21099":50668,"_5":14424,"_27663":50514,"_2970":50669},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3487":351,"_30445":292,"_21099":50671,"_5":14424,"_27663":50514,"_2970":50672},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3487":352,"_30445":292,"_21099":50674,"_5":14424,"_27663":50518,"_2970":50675},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3487":353,"_30445":292,"_21099":50677,"_5":14424,"_27663":50522,"_2970":50678},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3487":354,"_30445":292,"_21099":50680,"_5":14424,"_27663":50522,"_2970":50681},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3487":355,"_30445":292,"_21099":50683,"_5":14424,"_27663":50522,"_2970":50684},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3487":356,"_30445":292,"_21099":50686,"_5":14424,"_27663":50522,"_2970":50687},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3487":357,"_30445":292,"_21099":50689,"_5":14424,"_27663":50522,"_2970":50690},[],"If none of those are possible, use different external ports or change the external network design.",{"_3487":358,"_30445":292,"_21099":50692,"_5":14424,"_27663":50526,"_2970":50693},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3487":359,"_30445":292,"_21099":50695,"_5":14424,"_27663":50526,"_2970":50696},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3487":360,"_30445":292,"_21099":50698,"_5":14424,"_27663":50530,"_2970":50699},[],"Check, in order:",{"_3487":361,"_30445":292,"_21099":50701,"_5":14424,"_27663":50530,"_2970":50702},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3487":362,"_30445":292,"_21099":50704,"_5":14424,"_27663":50530,"_2970":50705},[],"Its status contains the expected address.",{"_3487":363,"_30445":292,"_21099":50707,"_5":14424,"_27663":50530,"_2970":50708},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3487":364,"_30445":292,"_21099":50710,"_5":14424,"_27663":50530,"_2970":50711},[],"Port 443 reaches that address from the client network.",{"_3487":365,"_30445":292,"_21099":50713,"_5":14424,"_27663":50530,"_2970":50714},[],"DNS resolves to the externally reachable endpoint.",{"_3487":366,"_30445":292,"_21099":50716,"_5":14424,"_27663":50530,"_2970":50717},[],"The certificate contains the DNS name or IP used by the client.",{"_3487":367,"_30445":292,"_21099":50719,"_5":14424,"_27663":50530,"_2970":50720},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3487":368,"_30445":368,"_5":14788,"_2970":49729,"_30797":50722,"_21099":50723,"_27663":368},[49622,49623,49729],[],{"_3487":369,"_30445":368,"_21099":50725,"_5":14424,"_27663":368,"_2970":50726},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3487":370,"_30445":368,"_5":30794,"_21099":50728,"_27663":50729,"_2970":50730},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3487":371,"_30445":368,"_5":30794,"_21099":50732,"_27663":50733,"_2970":50734},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3487":372,"_30445":368,"_5":30794,"_21099":50736,"_27663":50737,"_2970":50738},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3487":373,"_30445":368,"_5":30794,"_21099":50740,"_27663":50741,"_2970":50742},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3487":374,"_30445":368,"_5":30794,"_21099":50744,"_27663":50745,"_2970":50746},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3487":375,"_30445":368,"_5":30794,"_21099":50748,"_27663":50749,"_2970":50750},[],"/docs/pr-preview/pr-68/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3487":376,"_30445":368,"_21099":50752,"_5":14424,"_27663":50729,"_2970":50753},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3487":377,"_30445":368,"_21099":50755,"_5":14424,"_27663":50733,"_2970":50756},[],"Workflow",{"_3487":378,"_30445":368,"_21099":50758,"_5":14424,"_27663":50733,"_2970":50759},[],"Use it for",{"_3487":379,"_30445":368,"_21099":50761,"_5":14424,"_27663":50733,"_2970":50762},[],"What it installs",{"_3487":380,"_30445":368,"_21099":50764,"_5":14424,"_27663":50733,"_2970":50765},[],"Helm",{"_3487":381,"_30445":368,"_21099":50767,"_5":14424,"_27663":50733,"_2970":50768},[],"Production and controlled environments",{"_3487":382,"_30445":368,"_21099":50770,"_5":14424,"_27663":50733,"_2970":50771},[],"Lamassu services and Gateway API resources",{"_3487":383,"_30445":368,"_21099":50773,"_5":14424,"_27663":50733,"_2970":49866},[],{"_3487":384,"_30445":368,"_21099":50775,"_5":14424,"_27663":50733,"_2970":50776},[],"Evaluation, demos, CI and small lab clusters",{"_3487":385,"_30445":368,"_21099":50778,"_5":14424,"_27663":50733,"_2970":50779},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3487":386,"_30445":368,"_21099":50781,"_5":14424,"_27663":50737,"_2970":50782},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3487":387,"_30445":368,"_21099":50784,"_5":14424,"_27663":50737,"_2970":50785},[],"Area",{"_3487":388,"_30445":368,"_21099":50787,"_5":14424,"_27663":50737,"_2970":50788},[],"The Lamassu chart provides",{"_3487":389,"_30445":368,"_21099":50790,"_5":14424,"_27663":50737,"_2970":50791},[],"You provide",{"_3487":390,"_30445":368,"_21099":50793,"_5":14424,"_27663":50737,"_2970":50794},[],"Lamassu applications",{"_3487":391,"_30445":368,"_21099":50796,"_5":14424,"_27663":50737,"_2970":50797},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3487":392,"_30445":368,"_21099":50799,"_5":14424,"_27663":50737,"_2970":50800},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3487":393,"_30445":368,"_21099":50802,"_5":14424,"_27663":50737,"_2970":50803},[],"PostgreSQL data",{"_3487":394,"_30445":368,"_21099":50805,"_5":14424,"_27663":50737,"_2970":50806},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3487":395,"_30445":368,"_21099":50808,"_5":14424,"_27663":50737,"_2970":50809},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3487":396,"_30445":368,"_21099":50811,"_5":14424,"_27663":50737,"_2970":50812},[],"Messaging",{"_3487":397,"_30445":368,"_21099":50814,"_5":14424,"_27663":50737,"_2970":50815},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3487":398,"_30445":368,"_21099":50817,"_5":14424,"_27663":50737,"_2970":50818},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3487":399,"_30445":368,"_21099":50820,"_5":14424,"_27663":50737,"_2970":50821},[],"Identity",{"_3487":400,"_30445":368,"_21099":50823,"_5":14424,"_27663":50737,"_2970":50824},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3487":401,"_30445":368,"_21099":50826,"_5":14424,"_27663":50737,"_2970":50827},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3487":402,"_30445":368,"_21099":50829,"_5":14424,"_27663":50737,"_2970":50830},[],"External routing",{"_3487":403,"_30445":368,"_21099":50832,"_5":14424,"_27663":50737,"_2970":50833},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3487":404,"_30445":368,"_21099":50835,"_5":14424,"_27663":50737,"_2970":50836},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3487":405,"_30445":368,"_21099":50838,"_5":14424,"_27663":50737,"_2970":50839},[],"TLS",{"_3487":406,"_30445":368,"_21099":50841,"_5":14424,"_27663":50737,"_2970":50842},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3487":407,"_30445":368,"_21099":50844,"_5":14424,"_27663":50737,"_2970":50845},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3487":408,"_30445":368,"_21099":50847,"_5":14424,"_27663":50737,"_2970":50848},[],"Persistent application data",{"_3487":409,"_30445":368,"_21099":50850,"_5":14424,"_27663":50737,"_2970":50851},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3487":410,"_30445":368,"_21099":50853,"_5":14424,"_27663":50737,"_2970":50854},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3487":411,"_30445":368,"_21099":50856,"_5":14424,"_27663":50737,"_2970":50857},[],"Optional integrations",{"_3487":412,"_30445":368,"_21099":50859,"_5":14424,"_27663":50737,"_2970":50860},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3487":413,"_30445":368,"_21099":50862,"_5":14424,"_27663":50737,"_2970":50863},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3487":414,"_30445":368,"_21099":50865,"_5":14424,"_27663":50737,"_2970":50866},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3487":415,"_30445":368,"_21099":50868,"_5":14424,"_27663":50737,"_2970":50869},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3487":416,"_30445":368,"_21099":50871,"_5":14424,"_27663":50741,"_2970":50872},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3487":417,"_30445":368,"_21099":50874,"_5":14424,"_27663":50741,"_2970":50875},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3487":418,"_30445":368,"_21099":50877,"_5":14424,"_27663":50745,"_2970":50878},[],"Kubernetes 1.24 or newer",{"_3487":419,"_30445":368,"_21099":50880,"_5":14424,"_27663":50745,"_2970":50881},[],"Helm 3.2 or newer",{"_3487":420,"_30445":368,"_21099":50883,"_5":14424,"_27663":50745,"_2970":50884},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3487":421,"_30445":368,"_21099":50886,"_5":14424,"_27663":50745,"_2970":50887},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3487":422,"_30445":368,"_21099":50889,"_5":14424,"_27663":50745,"_2970":50890},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3487":423,"_30445":368,"_21099":50892,"_5":14424,"_27663":50745,"_2970":50893},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3487":424,"_30445":368,"_21099":50895,"_5":14424,"_27663":50745,"_2970":50896},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3487":425,"_30445":368,"_21099":50898,"_5":14424,"_27663":50749,"_2970":50899},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3487":426,"_30445":368,"_21099":50901,"_5":14424,"_27663":50749,"_2970":50902},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3487":427,"_30445":368,"_21099":50904,"_5":14424,"_27663":50749,"_2970":50905},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3487":428,"_30445":368,"_21099":50907,"_5":14424,"_27663":50749,"_2970":50908},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3487":429,"_30445":429,"_5":14788,"_2970":50910,"_30797":50911,"_21099":50913,"_27663":429},"Deployment troubleshooting",[49622,49623,50912],"Operations",[],{"_3487":430,"_30445":429,"_21099":50915,"_5":14424,"_27663":429,"_2970":50916},[],"Diagnose access, service health and infrastructure dependencies.",{"_3487":431,"_30445":429,"_5":30794,"_21099":50918,"_27663":50919,"_2970":50920},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3487":432,"_30445":429,"_5":30794,"_21099":50922,"_27663":50923,"_2970":50924},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3487":433,"_30445":429,"_5":30794,"_21099":50926,"_27663":50927,"_2970":50928},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3487":434,"_30445":429,"_5":30794,"_21099":50930,"_27663":50931,"_2970":50932},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3487":435,"_30445":429,"_5":30794,"_21099":50934,"_27663":50935,"_2970":50936},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3487":436,"_30445":429,"_5":30794,"_21099":50938,"_27663":50939,"_2970":50940},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3487":437,"_30445":429,"_5":30794,"_21099":50942,"_27663":50943,"_2970":50944},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3487":438,"_30445":429,"_5":30794,"_21099":50946,"_27663":50947,"_2970":50948},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3487":439,"_30445":429,"_5":30794,"_21099":50950,"_27663":50951,"_2970":50952},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3487":440,"_30445":429,"_5":30794,"_21099":50954,"_27663":50955,"_2970":50956},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3487":441,"_30445":429,"_5":30794,"_21099":50958,"_27663":50959,"_2970":50960},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3487":442,"_30445":429,"_5":30794,"_21099":50962,"_27663":50963,"_2970":50964},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3487":443,"_30445":429,"_5":30794,"_21099":50966,"_27663":50967,"_2970":50968},[],"/docs/pr-preview/pr-68/deployment/troubleshooting#observability","Observability",{"_3487":444,"_30445":429,"_21099":50970,"_5":14424,"_27663":429,"_2970":50971},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3487":445,"_30445":429,"_21099":50973,"_5":14424,"_27663":50923,"_2970":50974},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3487":446,"_30445":429,"_21099":50976,"_5":14424,"_27663":50927,"_2970":50977},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3487":447,"_30445":429,"_21099":50979,"_5":14424,"_27663":50931,"_2970":50980},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3487":448,"_30445":429,"_21099":50982,"_5":14424,"_27663":50935,"_2970":50983},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3487":449,"_30445":429,"_21099":50985,"_5":14424,"_27663":50939,"_2970":50986},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3487":450,"_30445":429,"_21099":50988,"_5":14424,"_27663":50943,"_2970":50989},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3487":451,"_30445":429,"_21099":50991,"_5":14424,"_27663":50943,"_2970":50992},[],"Also run the chart's connectivity test:",{"_3487":452,"_30445":429,"_21099":50994,"_5":14424,"_27663":50943,"_2970":50995},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3487":453,"_30445":429,"_21099":50997,"_5":14424,"_27663":50943,"_2970":50998},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3487":454,"_30445":429,"_21099":51000,"_5":14424,"_27663":50947,"_2970":51001},[],"If you receive a 401:",{"_3487":455,"_30445":429,"_21099":51003,"_5":14424,"_27663":50947,"_2970":51004},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3487":456,"_30445":429,"_21099":51006,"_5":14424,"_27663":50947,"_2970":51007},[],"verify issuer, audience and expiration of the token;",{"_3487":457,"_30445":429,"_21099":51009,"_5":14424,"_27663":50947,"_2970":51010},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3487":458,"_30445":429,"_21099":51012,"_5":14424,"_27663":50947,"_2970":51013},[],"check that the provider's public and internal routes point to the same realm.",{"_3487":459,"_30445":429,"_21099":51015,"_5":14424,"_27663":50947,"_2970":51016},[],"If login succeeds but the APIs return 403:",{"_3487":460,"_30445":429,"_21099":51018,"_5":14424,"_27663":50947,"_2970":51019},[],"inspect the token's real claims;",{"_3487":461,"_30445":429,"_21099":51021,"_5":14424,"_27663":50947,"_2970":51022},[],"confirm they match an active principal;",{"_3487":462,"_30445":429,"_21099":51024,"_5":14424,"_27663":50947,"_2970":51025},[],"review the policies granted to that principal;",{"_3487":463,"_30445":429,"_21099":51027,"_5":14424,"_27663":50947,"_2970":51028},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3487":464,"_30445":429,"_21099":51030,"_5":14424,"_27663":50947,"_2970":51031},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3487":465,"_30445":429,"_21099":51033,"_5":14424,"_27663":50951,"_2970":51034},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3487":466,"_30445":429,"_21099":51036,"_5":14424,"_27663":50951,"_2970":51037},[],"Locate the authz pod and Service.",{"_3487":467,"_30445":429,"_21099":51039,"_5":14424,"_27663":50951,"_2970":51040},[],"Check /health, logs and its database connection.",{"_3487":468,"_30445":429,"_21099":51042,"_5":14424,"_27663":50951,"_2970":51043},[],"Verify the DNS and port configured in externalAuthorization.",{"_3487":469,"_30445":429,"_21099":51045,"_5":14424,"_27663":50951,"_2970":51046},[],"Check the check route is /v1/ext\\_authz/check.",{"_3487":470,"_30445":429,"_21099":51048,"_5":14424,"_27663":50951,"_2970":51049},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3487":471,"_30445":429,"_21099":51051,"_5":14424,"_27663":50955,"_2970":51052},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3487":472,"_30445":429,"_21099":51054,"_5":14424,"_27663":50959,"_2970":51055},[],"Review kubectl describe pod first. Common causes are:",{"_3487":473,"_30445":429,"_21099":51057,"_5":14424,"_27663":50959,"_2970":51058},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3487":474,"_30445":429,"_21099":51060,"_5":14424,"_27663":50959,"_2970":51061},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3487":475,"_30445":429,"_21099":51063,"_5":14424,"_27663":50959,"_2970":51064},[],"a credential environment variable set to the empty string while its YAML value is non-empty: the service fails at startup and names the variable and the configuration key, e.g. `LAMASSU_POSTGRES_PASSWORD is set but empty`;",{"_3487":476,"_30445":429,"_21099":51066,"_5":14424,"_27663":50959,"_2970":51067},[],"for authz, two schemas in the credentials map that normalize to the same environment-variable name (for example `pki-v2` and `pki.v2`): startup fails when a credential variable for either schema is set; with the variables unset the service logs a warning and uses the YAML values.",{"_3487":477,"_30445":429,"_21099":51069,"_5":14424,"_27663":50959,"_2970":51070},[],"unbound persistent volume;",{"_3487":478,"_30445":429,"_21099":51072,"_5":14424,"_27663":50959,"_2970":51073},[],"inaccessible image or incorrect pull policy;",{"_3487":479,"_30445":429,"_21099":51075,"_5":14424,"_27663":50959,"_2970":51076},[],"invalid cryptographic engine configuration;",{"_3487":480,"_30445":429,"_21099":51078,"_5":14424,"_27663":50959,"_2970":51079},[],"CPU or memory limits set too low;",{"_3487":481,"_30445":429,"_21099":51081,"_5":14424,"_27663":50959,"_2970":51082},[],"an incomplete prior migration.",{"_3487":482,"_30445":429,"_21099":51084,"_5":14424,"_27663":50959,"_2970":51085},[],"These startup failures come from the credential environment variables described in Credential environment variables.",{"_3487":483,"_30445":429,"_21099":51087,"_5":14424,"_27663":50959,"_2970":51088},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3487":484,"_30445":429,"_21099":51090,"_5":14424,"_27663":50959,"_2970":51091},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3487":485,"_30445":429,"_21099":51093,"_5":14424,"_27663":50959,"_2970":51094},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3487":486,"_30445":429,"_21099":51096,"_5":14424,"_27663":50963,"_2970":51097},[],"Domain and audit events depend on the bus publisher:",{"_3487":487,"_30445":429,"_21099":51099,"_5":14424,"_27663":50963,"_2970":51100},[],"verify it is enabled in the emitting service;",{"_3487":488,"_30445":429,"_21099":51102,"_5":14424,"_27663":50963,"_2970":51103},[],"check AMQP connectivity and credentials;",{"_3487":489,"_30445":429,"_21099":51105,"_5":14424,"_27663":50963,"_2970":51106},[],"review exchange, routing key, queues and consumers;",{"_3487":490,"_30445":429,"_21099":51108,"_5":14424,"_27663":50963,"_2970":51109},[],"inspect dead-letter queues;",{"_3487":491,"_30445":429,"_21099":51111,"_5":14424,"_27663":50963,"_2970":51112},[],"alert on orphan durable queues and backlog growth.",{"_3487":492,"_30445":429,"_21099":51114,"_5":14424,"_27663":50963,"_2970":51115},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3487":493,"_30445":429,"_21099":51117,"_5":14424,"_27663":50963,"_2970":51118},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3487":494,"_30445":429,"_21099":51120,"_5":14424,"_27663":50963,"_2970":51121},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3487":495,"_30445":429,"_21099":51123,"_5":14424,"_27663":50963,"_2970":51124},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3487":496,"_30445":429,"_21099":51126,"_5":14424,"_27663":50963,"_2970":51127},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3487":497,"_30445":429,"_21099":51129,"_5":14424,"_27663":50963,"_2970":51130},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3487":498,"_30445":429,"_21099":51132,"_5":14424,"_27663":50963,"_2970":51133},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3487":499,"_30445":429,"_21099":51135,"_5":14424,"_27663":50967,"_2970":51136},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3487":500,"_30445":429,"_21099":51138,"_5":14424,"_27663":50967,"_2970":51139},[],"Before closing an incident, record:",{"_3487":501,"_30445":429,"_21099":51141,"_5":14424,"_27663":50967,"_2970":51142},[],"the confirmed cause;",{"_3487":502,"_30445":429,"_21099":51144,"_5":14424,"_27663":50967,"_2970":51145},[],"the time scope and affected resources;",{"_3487":503,"_30445":429,"_21099":51147,"_5":14424,"_27663":50967,"_2970":51148},[],"the commands or queries used;",{"_3487":504,"_30445":429,"_21099":51150,"_5":14424,"_27663":50967,"_2970":51151},[],"the applied change and how to revert it;",{"_3487":505,"_30445":429,"_21099":51153,"_5":14424,"_27663":50967,"_2970":51154},[],"validation from a consumer;",{"_3487":506,"_30445":429,"_21099":51156,"_5":14424,"_27663":50967,"_2970":51157},[],"the preventive action and its owner.",{"_3487":507,"_30445":507,"_5":14788,"_2970":51159,"_30797":51160,"_21099":51163,"_27663":507},"Access control",[49622,51161,51162],"Platform","Administration",[],{"_3487":508,"_30445":507,"_21099":51165,"_5":14424,"_27663":507,"_2970":51166},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3487":509,"_30445":507,"_5":30794,"_21099":51168,"_27663":51169,"_2970":51170},[],"/docs/pr-preview/pr-68/platform/administration/access-control#essential-concepts","Essential concepts",{"_3487":510,"_30445":507,"_5":30794,"_21099":51172,"_27663":51173,"_2970":51174},[],"/docs/pr-preview/pr-68/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3487":511,"_30445":507,"_5":30794,"_21099":51176,"_27663":51177,"_2970":51178},[],"/docs/pr-preview/pr-68/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3487":512,"_30445":507,"_5":30794,"_21099":51180,"_27663":51181,"_2970":51182},[],"/docs/pr-preview/pr-68/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3487":513,"_30445":507,"_5":30794,"_21099":51184,"_27663":51185,"_2970":51186},[],"/docs/pr-preview/pr-68/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3487":514,"_30445":507,"_5":30794,"_21099":51188,"_27663":51189,"_2970":51190},[],"/docs/pr-preview/pr-68/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3487":515,"_30445":507,"_5":30794,"_21099":51192,"_27663":51193,"_2970":51194},[],"/docs/pr-preview/pr-68/platform/administration/access-control#oidc-principals","OIDC principals",{"_3487":516,"_30445":507,"_5":30794,"_21099":51196,"_27663":51197,"_2970":51198},[],"/docs/pr-preview/pr-68/platform/administration/access-control#x509-principals","X.509 principals",{"_3487":517,"_30445":507,"_5":30794,"_21099":51200,"_27663":51201,"_2970":51202},[],"/docs/pr-preview/pr-68/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3487":518,"_30445":507,"_5":30794,"_21099":51204,"_27663":51205,"_2970":51206},[],"/docs/pr-preview/pr-68/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3487":519,"_30445":507,"_5":30794,"_21099":51208,"_27663":51209,"_2970":51210},[],"/docs/pr-preview/pr-68/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3487":520,"_30445":507,"_5":30794,"_21099":51212,"_27663":51213,"_2970":51214},[],"/docs/pr-preview/pr-68/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3487":521,"_30445":507,"_5":30794,"_21099":51216,"_27663":51217,"_2970":51218},[],"/docs/pr-preview/pr-68/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3487":522,"_30445":507,"_5":30794,"_21099":51220,"_27663":51221,"_2970":51222},[],"/docs/pr-preview/pr-68/platform/administration/access-control#http-rules","HTTP rules",{"_3487":523,"_30445":507,"_5":30794,"_21099":51224,"_27663":51225,"_2970":51226},[],"/docs/pr-preview/pr-68/platform/administration/access-control#included-policies","Included policies",{"_3487":524,"_30445":507,"_5":30794,"_21099":51228,"_27663":51229,"_2970":50266},[],"/docs/pr-preview/pr-68/platform/administration/access-control#provision-the-first-administrator",{"_3487":525,"_30445":507,"_5":30794,"_21099":51231,"_27663":51232,"_2970":51233},[],"/docs/pr-preview/pr-68/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3487":526,"_30445":507,"_5":30794,"_21099":51235,"_27663":51236,"_2970":51237},[],"/docs/pr-preview/pr-68/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3487":527,"_30445":507,"_5":30794,"_21099":51239,"_27663":51240,"_2970":51241},[],"/docs/pr-preview/pr-68/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3487":528,"_30445":507,"_5":30794,"_21099":51243,"_27663":51244,"_2970":51245},[],"/docs/pr-preview/pr-68/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3487":529,"_30445":507,"_5":30794,"_21099":51247,"_27663":51248,"_2970":51249},[],"/docs/pr-preview/pr-68/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3487":530,"_30445":507,"_5":30794,"_21099":51251,"_27663":51252,"_2970":51253},[],"/docs/pr-preview/pr-68/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3487":531,"_30445":507,"_5":30794,"_21099":51255,"_27663":51256,"_2970":51257},[],"/docs/pr-preview/pr-68/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3487":532,"_30445":507,"_5":30794,"_21099":51259,"_27663":51260,"_2970":51261},[],"/docs/pr-preview/pr-68/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3487":533,"_30445":507,"_5":30794,"_21099":51263,"_27663":51264,"_2970":51265},[],"/docs/pr-preview/pr-68/platform/administration/access-control#operational-checklist","Operational checklist",{"_3487":534,"_30445":507,"_5":30794,"_21099":51267,"_27663":51268,"_2970":51269},[],"/docs/pr-preview/pr-68/platform/administration/access-control#diagnostics","Diagnostics",{"_3487":535,"_30445":507,"_5":30794,"_21099":51271,"_27663":51272,"_2970":51273},[],"/docs/pr-preview/pr-68/platform/administration/access-control#the-response-is-401","The response is 401",{"_3487":536,"_30445":507,"_5":30794,"_21099":51275,"_27663":51276,"_2970":51277},[],"/docs/pr-preview/pr-68/platform/administration/access-control#the-response-is-403","The response is 403",{"_3487":537,"_30445":507,"_5":30794,"_21099":51279,"_27663":51280,"_2970":51281},[],"/docs/pr-preview/pr-68/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3487":538,"_30445":507,"_5":30794,"_21099":51283,"_27663":51284,"_2970":51285},[],"/docs/pr-preview/pr-68/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3487":539,"_30445":507,"_5":30794,"_21099":51287,"_27663":51288,"_2970":51289},[],"/docs/pr-preview/pr-68/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3487":540,"_30445":507,"_21099":51291,"_5":14424,"_27663":507,"_2970":51292},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3487":541,"_30445":507,"_21099":51294,"_5":14424,"_27663":507,"_2970":51295},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3487":542,"_30445":507,"_21099":51297,"_5":14424,"_27663":507,"_2970":51298},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3487":543,"_30445":507,"_21099":51300,"_5":14424,"_27663":51169,"_2970":51301},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3487":544,"_30445":507,"_21099":51303,"_5":14424,"_27663":51169,"_2970":51304},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3487":545,"_30445":507,"_21099":51306,"_5":14424,"_27663":51169,"_2970":51307},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3487":546,"_30445":507,"_21099":51309,"_5":14424,"_27663":51169,"_2970":51310},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3487":547,"_30445":507,"_21099":51312,"_5":14424,"_27663":51169,"_2970":51313},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3487":548,"_30445":507,"_21099":51315,"_5":14424,"_27663":51169,"_2970":51316},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3487":549,"_30445":507,"_21099":51318,"_5":14424,"_27663":51173,"_2970":51319},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3487":550,"_30445":507,"_21099":51321,"_5":14424,"_27663":51173,"_2970":51322},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3487":551,"_30445":507,"_21099":51324,"_5":14424,"_27663":51177,"_2970":51325},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3487":552,"_30445":507,"_21099":51327,"_5":14424,"_27663":51177,"_2970":51328},[],"The decision is made **before forwarding the request to the service**:",{"_3487":553,"_30445":507,"_21099":51330,"_5":14424,"_27663":51177,"_2970":51331},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3487":554,"_30445":507,"_21099":51333,"_5":14424,"_27663":51177,"_2970":51334},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3487":555,"_30445":507,"_21099":51336,"_5":14424,"_27663":51177,"_2970":51337},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3487":556,"_30445":507,"_21099":51339,"_5":14424,"_27663":51177,"_2970":51340},[],"It separately loads the policies granted to each principal.",{"_3487":557,"_30445":507,"_21099":51342,"_5":14424,"_27663":51177,"_2970":51343},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3487":558,"_30445":507,"_21099":51345,"_5":14424,"_27663":51177,"_2970":51346},[],"`authz` looks for an HTTP rule granting that action.",{"_3487":559,"_30445":507,"_21099":51348,"_5":14424,"_27663":51177,"_2970":51349},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3487":560,"_30445":507,"_21099":51351,"_5":14424,"_27663":51177,"_2970":51352},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3487":561,"_30445":507,"_21099":51354,"_5":14424,"_27663":51177,"_2970":51355},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3487":562,"_30445":507,"_21099":51357,"_5":14424,"_27663":51177,"_2970":51358},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3487":563,"_30445":507,"_21099":51360,"_5":14424,"_27663":51181,"_2970":51361},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3487":564,"_30445":507,"_21099":51363,"_5":14424,"_27663":51181,"_2970":51364},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3487":565,"_30445":507,"_21099":51366,"_5":14424,"_27663":51181,"_2970":51367},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3487":566,"_30445":507,"_21099":51369,"_5":14424,"_27663":51181,"_2970":51370},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3487":567,"_30445":507,"_21099":51372,"_5":14424,"_27663":51181,"_2970":51373},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3487":568,"_30445":507,"_21099":51375,"_5":14424,"_27663":51181,"_2970":51376},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3487":569,"_30445":507,"_21099":51378,"_5":14424,"_27663":51181,"_2970":51379},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3487":570,"_30445":507,"_21099":51381,"_5":14424,"_27663":51181,"_2970":51382},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3487":571,"_30445":507,"_21099":51384,"_5":14424,"_27663":51185,"_2970":51385},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3487":572,"_30445":507,"_21099":51387,"_5":14424,"_27663":51185,"_2970":51388},[],"The decision is made with the domain operation context:",{"_3487":573,"_30445":507,"_21099":51390,"_5":14424,"_27663":51185,"_2970":51391},[],"The middleware extracts the credential and resolves the matching principals.",{"_3487":574,"_30445":507,"_21099":51393,"_5":14424,"_27663":51185,"_2970":51394},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3487":575,"_30445":507,"_21099":51396,"_5":14424,"_27663":51185,"_2970":51397},[],"`authz` gathers the entity rules of the granted policies.",{"_3487":576,"_30445":507,"_21099":51399,"_5":14424,"_27663":51185,"_2970":51400},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3487":577,"_30445":507,"_21099":51402,"_5":14424,"_27663":51185,"_2970":51403},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3487":578,"_30445":507,"_21099":51405,"_5":14424,"_27663":51185,"_2970":51406},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3487":579,"_30445":507,"_21099":51408,"_5":14424,"_27663":51185,"_2970":51409},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3487":580,"_30445":507,"_21099":51411,"_5":14424,"_27663":51185,"_2970":51412},[],"Actions fall into two groups:",{"_3487":581,"_30445":507,"_21099":51414,"_5":14424,"_27663":51185,"_2970":51415},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3487":582,"_30445":507,"_21099":51417,"_5":14424,"_27663":51185,"_2970":51418},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3487":583,"_30445":507,"_21099":51420,"_5":14424,"_27663":51185,"_2970":51421},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3487":584,"_30445":507,"_21099":51423,"_5":14424,"_27663":51189,"_2970":51424},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3487":585,"_30445":507,"_21099":51426,"_5":14424,"_27663":51189,"_2970":51427},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3487":586,"_30445":507,"_21099":51429,"_5":14424,"_27663":51189,"_2970":51430},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3487":587,"_30445":507,"_21099":51432,"_5":14424,"_27663":51193,"_2970":51433},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3487":588,"_30445":507,"_21099":51435,"_5":14424,"_27663":51193,"_2970":51436},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3487":589,"_30445":507,"_21099":51438,"_5":14424,"_27663":51193,"_2970":51439},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3487":590,"_30445":507,"_21099":51441,"_5":14424,"_27663":51193,"_2970":51442},[],"The implemented operators are:",{"_3487":591,"_30445":507,"_21099":51444,"_5":14424,"_27663":51193,"_2970":51445},[],"`equals`, for exact equality;",{"_3487":592,"_30445":507,"_21099":51447,"_5":14424,"_27663":51193,"_2970":51448},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3487":593,"_30445":507,"_21099":51450,"_5":14424,"_27663":51193,"_2970":51451},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3487":594,"_30445":507,"_21099":51453,"_5":14424,"_27663":51193,"_2970":51454},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3487":595,"_30445":507,"_21099":51456,"_5":14424,"_27663":51197,"_2970":51457},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3487":596,"_30445":507,"_21099":51459,"_5":14424,"_27663":51197,"_2970":51460},[],"The available modes are:",{"_3487":597,"_30445":507,"_21099":51462,"_5":14424,"_27663":51197,"_2970":51463},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3487":598,"_30445":507,"_21099":51465,"_5":14424,"_27663":51197,"_2970":51466},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3487":599,"_30445":507,"_21099":51468,"_5":14424,"_27663":51197,"_2970":51469},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3487":600,"_30445":507,"_21099":51471,"_5":14424,"_27663":51197,"_2970":51472},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3487":601,"_30445":507,"_21099":51474,"_5":14424,"_27663":51197,"_2970":51475},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3487":602,"_30445":507,"_21099":51477,"_5":14424,"_27663":51197,"_2970":51478},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3487":603,"_30445":507,"_21099":51480,"_5":14424,"_27663":51201,"_2970":51481},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3487":604,"_30445":507,"_21099":51483,"_5":14424,"_27663":51201,"_2970":51484},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3487":605,"_30445":507,"_21099":51486,"_5":14424,"_27663":51201,"_2970":51487},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3487":606,"_30445":507,"_21099":51489,"_5":14424,"_27663":51201,"_2970":51490},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3487":607,"_30445":507,"_21099":51492,"_5":14424,"_27663":51209,"_2970":51493},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3487":608,"_30445":507,"_21099":51495,"_5":14424,"_27663":51209,"_2970":51496},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3487":609,"_30445":507,"_21099":51498,"_5":14424,"_27663":51213,"_2970":51499},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3487":610,"_30445":507,"_21099":51501,"_5":14424,"_27663":51213,"_2970":51502},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3487":611,"_30445":507,"_21099":51504,"_5":14424,"_27663":51217,"_2970":51505},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3487":612,"_30445":507,"_21099":51507,"_5":14424,"_27663":51217,"_2970":51508},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3487":613,"_30445":507,"_21099":51510,"_5":14424,"_27663":51217,"_2970":51511},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3487":614,"_30445":507,"_21099":51513,"_5":14424,"_27663":51221,"_2970":51514},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3487":615,"_30445":507,"_21099":51516,"_5":14424,"_27663":51221,"_2970":51517},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3487":616,"_30445":507,"_21099":51519,"_5":14424,"_27663":51221,"_2970":51520},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3487":617,"_30445":507,"_21099":51522,"_5":14424,"_27663":51221,"_2970":51523},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3487":618,"_30445":507,"_21099":51525,"_5":14424,"_27663":51221,"_2970":51526},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3487":619,"_30445":507,"_21099":51528,"_5":14424,"_27663":51221,"_2970":51529},[],"Note that:",{"_3487":620,"_30445":507,"_21099":51531,"_5":14424,"_27663":51221,"_2970":51532},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3487":621,"_30445":507,"_21099":51534,"_5":14424,"_27663":51221,"_2970":51535},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3487":622,"_30445":507,"_21099":51537,"_5":14424,"_27663":51221,"_2970":51538},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3487":623,"_30445":507,"_21099":51540,"_5":14424,"_27663":51225,"_2970":51541},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3487":624,"_30445":507,"_21099":51543,"_5":14424,"_27663":51225,"_2970":51544},[],"full and read-only access to certificates and authorities;",{"_3487":625,"_30445":507,"_21099":51546,"_5":14424,"_27663":51225,"_2970":51547},[],"full and read-only access to the KMS;",{"_3487":626,"_30445":507,"_21099":51549,"_5":14424,"_27663":51225,"_2970":51550},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3487":627,"_30445":507,"_21099":51552,"_5":14424,"_27663":51225,"_2970":51553},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3487":628,"_30445":507,"_21099":51555,"_5":14424,"_27663":51225,"_2970":51556},[],"console access;",{"_3487":629,"_30445":507,"_21099":51558,"_5":14424,"_27663":51225,"_2970":51559},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3487":630,"_30445":507,"_21099":51561,"_5":14424,"_27663":51225,"_2970":51562},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3487":631,"_30445":507,"_21099":51564,"_5":14424,"_27663":51225,"_2970":51565},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3487":632,"_30445":507,"_21099":51567,"_5":14424,"_27663":51229,"_2970":51568},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3487":633,"_30445":507,"_21099":51570,"_5":14424,"_27663":51229,"_2970":51571},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3487":634,"_30445":507,"_21099":51573,"_5":14424,"_27663":51229,"_2970":51574},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3487":635,"_30445":507,"_21099":51576,"_5":14424,"_27663":51232,"_2970":51577},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3487":636,"_30445":507,"_21099":51579,"_5":14424,"_27663":51236,"_2970":51580},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3487":637,"_30445":507,"_21099":51582,"_5":14424,"_27663":51236,"_2970":51583},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3487":638,"_30445":507,"_21099":51585,"_5":14424,"_27663":51240,"_2970":51586},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3487":639,"_30445":507,"_21099":51588,"_5":14424,"_27663":51244,"_2970":51589},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3487":640,"_30445":507,"_21099":51591,"_5":14424,"_27663":51248,"_2970":51592},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3487":641,"_30445":507,"_21099":51594,"_5":14424,"_27663":51252,"_2970":51595},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3487":642,"_30445":507,"_21099":51597,"_5":14424,"_27663":51252,"_2970":51598},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3487":643,"_30445":507,"_21099":51600,"_5":14424,"_27663":51256,"_2970":51601},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3487":644,"_30445":507,"_21099":51603,"_5":14424,"_27663":51256,"_2970":51604},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3487":645,"_30445":507,"_21099":51606,"_5":14424,"_27663":51256,"_2970":51607},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3487":646,"_30445":507,"_21099":51609,"_5":14424,"_27663":51256,"_2970":51610},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3487":647,"_30445":507,"_21099":51612,"_5":14424,"_27663":51256,"_2970":51613},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3487":648,"_30445":507,"_21099":51615,"_5":14424,"_27663":51256,"_2970":51616},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3487":649,"_30445":507,"_21099":51618,"_5":14424,"_27663":51256,"_2970":51619},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3487":650,"_30445":507,"_21099":51621,"_5":14424,"_27663":51256,"_2970":51622},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3487":651,"_30445":507,"_21099":51624,"_5":14424,"_27663":51260,"_2970":51625},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3487":652,"_30445":507,"_21099":51627,"_5":14424,"_27663":51260,"_2970":51628},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3487":653,"_30445":507,"_21099":51630,"_5":14424,"_27663":51260,"_2970":51631},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3487":654,"_30445":507,"_21099":51633,"_5":14424,"_27663":51264,"_2970":51634},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3487":655,"_30445":507,"_21099":51636,"_5":14424,"_27663":51264,"_2970":51637},[],"Use groups or stable roles for people and independent identities for automations.",{"_3487":656,"_30445":507,"_21099":51639,"_5":14424,"_27663":51264,"_2970":51640},[],"Keep at least two recovery administrators and test their access periodically.",{"_3487":657,"_30445":507,"_21099":51642,"_5":14424,"_27663":51264,"_2970":51643},[],"Review active principals, their matches and their grants after IdP changes.",{"_3487":658,"_30445":507,"_21099":51645,"_5":14424,"_27663":51264,"_2970":51646},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3487":659,"_30445":507,"_21099":51648,"_5":14424,"_27663":51264,"_2970":51649},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3487":660,"_30445":507,"_21099":51651,"_5":14424,"_27663":51264,"_2970":51652},[],"Always test one allowed and one denied operation for each role.",{"_3487":661,"_30445":507,"_21099":51654,"_5":14424,"_27663":51264,"_2970":51655},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3487":662,"_30445":507,"_21099":51657,"_5":14424,"_27663":51272,"_2970":51658},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3487":663,"_30445":507,"_21099":51660,"_5":14424,"_27663":51276,"_2970":51661},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3487":664,"_30445":507,"_21099":51663,"_5":14424,"_27663":51276,"_2970":51664},[],"that an active principal of the correct type exists;",{"_3487":665,"_30445":507,"_21099":51666,"_5":14424,"_27663":51276,"_2970":51667},[],"that the claim paths and values match the real token exactly;",{"_3487":666,"_30445":507,"_21099":51669,"_5":14424,"_27663":51276,"_2970":51670},[],"that all of the principal's conditions hold;",{"_3487":667,"_30445":507,"_21099":51672,"_5":14424,"_27663":51276,"_2970":51673},[],"that the principal has the expected policy granted;",{"_3487":668,"_30445":507,"_21099":51675,"_5":14424,"_27663":51276,"_2970":51676},[],"that the policy includes the action and the requested resource type or route;",{"_3487":669,"_30445":507,"_21099":51678,"_5":14424,"_27663":51276,"_2970":51679},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3487":670,"_30445":507,"_21099":51681,"_5":14424,"_27663":51276,"_2970":51682},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3487":671,"_30445":507,"_21099":51684,"_5":14424,"_27663":51280,"_2970":51685},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3487":672,"_30445":507,"_21099":51687,"_5":14424,"_27663":51284,"_2970":51688},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3487":673,"_30445":507,"_21099":51690,"_5":14424,"_27663":51288,"_2970":51691},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3487":674,"_30445":507,"_21099":51693,"_5":14424,"_27663":51288,"_2970":51694},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3487":675,"_30445":675,"_5":14788,"_2970":51696,"_30797":51697,"_21099":51698,"_27663":675},"Alerts and subscriptions",[49622,51161,51162],[],{"_3487":676,"_30445":675,"_21099":51700,"_5":14424,"_27663":675,"_2970":51701},[],"Send PKI events to people and external systems.",{"_3487":677,"_30445":675,"_5":30794,"_21099":51703,"_27663":51704,"_2970":51705},[],"/docs/pr-preview/pr-68/platform/administration/alerts#how-it-works","How it works",{"_3487":678,"_30445":675,"_5":30794,"_21099":51707,"_27663":51708,"_2970":51709},[],"/docs/pr-preview/pr-68/platform/administration/alerts#available-channels","Available channels",{"_3487":679,"_30445":675,"_5":30794,"_21099":51711,"_27663":51712,"_2970":51713},[],"/docs/pr-preview/pr-68/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3487":680,"_30445":675,"_5":30794,"_21099":51715,"_27663":51716,"_2970":51717},[],"/docs/pr-preview/pr-68/platform/administration/alerts#choose-the-event","Choose the event",{"_3487":681,"_30445":675,"_5":30794,"_21099":51719,"_27663":51720,"_2970":51721},[],"/docs/pr-preview/pr-68/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3487":682,"_30445":675,"_5":30794,"_21099":51723,"_27663":51724,"_2970":51725},[],"/docs/pr-preview/pr-68/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3487":683,"_30445":675,"_5":30794,"_21099":51727,"_27663":51728,"_2970":51729},[],"/docs/pr-preview/pr-68/platform/administration/alerts#review-and-activate","Review and activate",{"_3487":684,"_30445":675,"_5":30794,"_21099":51731,"_27663":51732,"_2970":51733},[],"/docs/pr-preview/pr-68/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3487":685,"_30445":675,"_5":30794,"_21099":51735,"_27663":51736,"_2970":51737},[],"/docs/pr-preview/pr-68/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3487":686,"_30445":675,"_5":30794,"_21099":51739,"_27663":51740,"_2970":51741},[],"/docs/pr-preview/pr-68/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3487":687,"_30445":675,"_5":30794,"_21099":51743,"_27663":51744,"_2970":51745},[],"/docs/pr-preview/pr-68/platform/administration/alerts#event-families","Event families",{"_3487":688,"_30445":675,"_21099":51747,"_5":14424,"_27663":675,"_2970":51748},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3487":689,"_30445":675,"_21099":51750,"_5":14424,"_27663":51704,"_2970":51751},[],"A service publishes a domain event.",{"_3487":690,"_30445":675,"_21099":51753,"_5":14424,"_27663":51704,"_2970":51754},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3487":691,"_30445":675,"_21099":51756,"_5":14424,"_27663":51704,"_2970":51757},[],"Each subscription's filter decides whether it should be notified.",{"_3487":692,"_30445":675,"_21099":51759,"_5":14424,"_27663":51704,"_2970":51760},[],"Lamassu delivers the event to the configured channel.",{"_3487":693,"_30445":675,"_21099":51762,"_5":14424,"_27663":51704,"_2970":51763},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3487":694,"_30445":675,"_21099":51765,"_5":14424,"_27663":51708,"_2970":51766},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3487":695,"_30445":675,"_21099":51768,"_5":14424,"_27663":51708,"_2970":51769},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3487":696,"_30445":675,"_21099":51771,"_5":14424,"_27663":51708,"_2970":51772},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3487":697,"_30445":675,"_21099":51774,"_5":14424,"_27663":51708,"_2970":51775},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3487":698,"_30445":675,"_21099":51777,"_5":14424,"_27663":51708,"_2970":51778},[],"`apikey_options` requires `header` and `key`.",{"_3487":699,"_30445":675,"_21099":51780,"_5":14424,"_27663":51708,"_2970":51781},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3487":700,"_30445":675,"_21099":51783,"_5":14424,"_27663":51708,"_2970":51784},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3487":701,"_30445":675,"_21099":51786,"_5":14424,"_27663":51708,"_2970":51787},[],"The alerts API reference documents the full `http_client` schema.",{"_3487":702,"_30445":675,"_21099":51789,"_5":14424,"_27663":51716,"_2970":51790},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3487":703,"_30445":675,"_21099":51792,"_5":14424,"_27663":51720,"_2970":51793},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3487":704,"_30445":675,"_21099":51795,"_5":14424,"_27663":51724,"_2970":51796},[],"Add a filter if you don't want to receive every instance of the event.",{"_3487":705,"_30445":675,"_21099":51798,"_5":14424,"_27663":51724,"_2970":51799},[],"**None** notifies all instances of the event.",{"_3487":706,"_30445":675,"_21099":51801,"_5":14424,"_27663":51724,"_2970":51802},[],"**JSON Path** evaluates one or more specific fields.",{"_3487":707,"_30445":675,"_21099":51804,"_5":14424,"_27663":51724,"_2970":51805},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3487":708,"_30445":675,"_21099":51807,"_5":14424,"_27663":51724,"_2970":51808},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3487":709,"_30445":675,"_21099":51810,"_5":14424,"_27663":51724,"_2970":51811},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3487":710,"_30445":675,"_21099":51813,"_5":14424,"_27663":51724,"_2970":51814},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3487":711,"_30445":675,"_21099":51816,"_5":14424,"_27663":51728,"_2970":51817},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3487":712,"_30445":675,"_21099":51819,"_5":14424,"_27663":51732,"_2970":51820},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3487":713,"_30445":675,"_21099":51822,"_5":14424,"_27663":51732,"_2970":51823},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3487":714,"_30445":675,"_21099":51825,"_5":14424,"_27663":51732,"_2970":51826},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3487":715,"_30445":675,"_21099":51828,"_5":14424,"_27663":51732,"_2970":51829},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3487":716,"_30445":675,"_21099":51831,"_5":14424,"_27663":51732,"_2970":51832},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3487":717,"_30445":675,"_21099":51834,"_5":14424,"_27663":51732,"_2970":51835},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3487":718,"_30445":675,"_21099":51837,"_5":14424,"_27663":51732,"_2970":51838},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3487":719,"_30445":675,"_21099":51840,"_5":14424,"_27663":51732,"_2970":51841},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3487":720,"_30445":675,"_21099":51843,"_5":14424,"_27663":51736,"_2970":51844},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3487":721,"_30445":675,"_21099":51846,"_5":14424,"_27663":51736,"_2970":51847},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3487":722,"_30445":675,"_21099":51849,"_5":14424,"_27663":51736,"_2970":51850},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3487":723,"_30445":675,"_21099":51852,"_5":14424,"_27663":51736,"_2970":51853},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3487":724,"_30445":675,"_21099":51855,"_5":14424,"_27663":51736,"_2970":51856},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3487":725,"_30445":675,"_21099":51858,"_5":14424,"_27663":51736,"_2970":51859},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3487":726,"_30445":675,"_21099":51861,"_5":14424,"_27663":51736,"_2970":51862},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3487":727,"_30445":675,"_21099":51864,"_5":14424,"_27663":51736,"_2970":51865},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3487":728,"_30445":675,"_21099":51867,"_5":14424,"_27663":51740,"_2970":51868},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3487":729,"_30445":675,"_21099":51870,"_5":14424,"_27663":51740,"_2970":51871},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3487":730,"_30445":675,"_21099":51873,"_5":14424,"_27663":51744,"_2970":51874},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3487":731,"_30445":675,"_21099":51876,"_5":14424,"_27663":51744,"_2970":51877},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3487":732,"_30445":675,"_21099":51879,"_5":14424,"_27663":51744,"_2970":51880},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3487":733,"_30445":675,"_21099":51882,"_5":14424,"_27663":51744,"_2970":51883},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3487":734,"_30445":675,"_21099":51885,"_5":14424,"_27663":51744,"_2970":51886},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3487":735,"_30445":675,"_21099":51888,"_5":14424,"_27663":51744,"_2970":51889},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3487":736,"_30445":675,"_21099":51891,"_5":14424,"_27663":51744,"_2970":51892},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3487":737,"_30445":675,"_21099":51894,"_5":14424,"_27663":51744,"_2970":51895},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3487":738,"_30445":675,"_21099":51897,"_5":14424,"_27663":51744,"_2970":51898},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3487":739,"_30445":739,"_5":14788,"_2970":51900,"_30797":51901,"_21099":51902,"_27663":739},"Audit logs",[49622,51161,51162],[],{"_3487":740,"_30445":739,"_21099":51904,"_5":14424,"_27663":739,"_2970":51905},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3487":741,"_30445":739,"_5":30794,"_21099":51907,"_27663":51908,"_2970":51909},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3487":742,"_30445":739,"_5":30794,"_21099":51911,"_27663":51912,"_2970":51913},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#coverage","Coverage",{"_3487":743,"_30445":739,"_5":30794,"_21099":51915,"_27663":51916,"_2970":51917},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3487":744,"_30445":739,"_5":30794,"_21099":51919,"_27663":51920,"_2970":51921},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3487":745,"_30445":739,"_5":30794,"_21099":51923,"_27663":51924,"_2970":51925},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3487":746,"_30445":739,"_5":30794,"_21099":51927,"_27663":51928,"_2970":51929},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3487":747,"_30445":739,"_5":30794,"_21099":51931,"_27663":51932,"_2970":51933},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3487":748,"_30445":739,"_5":30794,"_21099":51935,"_27663":51936,"_2970":51937},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3487":749,"_30445":739,"_5":30794,"_21099":51939,"_27663":51940,"_2970":51941},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3487":750,"_30445":739,"_5":30794,"_21099":51943,"_27663":51944,"_2970":51945},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3487":751,"_30445":739,"_5":30794,"_21099":51947,"_27663":51948,"_2970":51949},[],"/docs/pr-preview/pr-68/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3487":752,"_30445":739,"_21099":51951,"_5":14424,"_27663":739,"_2970":51952},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3487":753,"_30445":739,"_21099":51954,"_5":14424,"_27663":51908,"_2970":51955},[],"The audit body includes:",{"_3487":754,"_30445":739,"_21099":51957,"_5":14424,"_27663":51908,"_2970":51958},[],"input: data received by the operation;",{"_3487":755,"_30445":739,"_21099":51960,"_5":14424,"_27663":51908,"_2970":51961},[],"has\\_error: whether the service returned an error;",{"_3487":756,"_30445":739,"_21099":51963,"_5":14424,"_27663":51908,"_2970":51964},[],"output: produced result or error message;",{"_3487":757,"_30445":739,"_21099":51966,"_5":14424,"_27663":51908,"_2970":51967},[],"principals: identifiers of the principals that matched the request.",{"_3487":758,"_30445":739,"_21099":51969,"_5":14424,"_27663":51908,"_2970":51970},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3487":759,"_30445":739,"_21099":51972,"_5":14424,"_27663":51908,"_2970":51973},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3487":760,"_30445":739,"_21099":51975,"_5":14424,"_27663":51912,"_2970":51976},[],"The backend applies auditing to mutations of:",{"_3487":761,"_30445":739,"_21099":51978,"_5":14424,"_27663":51912,"_2970":51979},[],"authorities, certificates and issuance profiles;",{"_3487":762,"_30445":739,"_21099":51981,"_5":14424,"_27663":51912,"_2970":51982},[],"keys and KMS engines;",{"_3487":763,"_30445":739,"_21099":51984,"_5":14424,"_27663":51912,"_2970":51985},[],"devices and identities;",{"_3487":764,"_30445":739,"_21099":51987,"_5":14424,"_27663":51912,"_2970":51988},[],"DMSs and enrollment operations;",{"_3487":765,"_30445":739,"_21099":51990,"_5":14424,"_27663":51912,"_2970":51991},[],"validation functions and CRL;",{"_3487":766,"_30445":739,"_21099":51993,"_5":14424,"_27663":51912,"_2970":51994},[],"principals, policies and authorization grants.",{"_3487":767,"_30445":739,"_21099":51996,"_5":14424,"_27663":51912,"_2970":51997},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3487":768,"_30445":739,"_21099":51999,"_5":14424,"_27663":51916,"_2970":52000},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3487":769,"_30445":739,"_21099":52002,"_5":14424,"_27663":51916,"_2970":52003},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3487":770,"_30445":739,"_21099":52005,"_5":14424,"_27663":51916,"_2970":52006},[],"Design the consumer to:",{"_3487":771,"_30445":739,"_21099":52008,"_5":14424,"_27663":51916,"_2970":52009},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3487":772,"_30445":739,"_21099":52011,"_5":14424,"_27663":51916,"_2970":52012},[],"keep the complete CloudEvent unmodified;",{"_3487":773,"_30445":739,"_21099":52014,"_5":14424,"_27663":51916,"_2970":52015},[],"record the ingestion time and detect duplicates by ID;",{"_3487":774,"_30445":739,"_21099":52017,"_5":14424,"_27663":51916,"_2970":52018},[],"encrypt in transit and at rest;",{"_3487":775,"_30445":739,"_21099":52020,"_5":14424,"_27663":51916,"_2970":52021},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3487":776,"_30445":739,"_21099":52023,"_5":14424,"_27663":51916,"_2970":52024},[],"apply an explicit retention and legal hold policy;",{"_3487":777,"_30445":739,"_21099":52026,"_5":14424,"_27663":51916,"_2970":52027},[],"alert if it stops consuming or the pending queue grows.",{"_3487":778,"_30445":739,"_21099":52029,"_5":14424,"_27663":51920,"_2970":52030},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3487":779,"_30445":739,"_21099":52032,"_5":14424,"_27663":51920,"_2970":52033},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3487":780,"_30445":739,"_21099":52035,"_5":14424,"_27663":51928,"_2970":52036},[],"Start from the reported time and normalize every source to UTC.",{"_3487":781,"_30445":739,"_21099":52038,"_5":14424,"_27663":51932,"_2970":52039},[],"Filter by event type, service source and resource identifier.",{"_3487":782,"_30445":739,"_21099":52041,"_5":14424,"_27663":51936,"_2970":52042},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3487":783,"_30445":739,"_21099":52044,"_5":14424,"_27663":51940,"_2970":52045},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3487":784,"_30445":739,"_21099":52047,"_5":14424,"_27663":51944,"_2970":52048},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3487":785,"_30445":739,"_21099":52050,"_5":14424,"_27663":51948,"_2970":52051},[],"Generate a controlled mutation in a test environment and check that:",{"_3487":786,"_30445":739,"_21099":52053,"_5":14424,"_27663":51948,"_2970":52054},[],"a successful audit event appears;",{"_3487":787,"_30445":739,"_21099":52056,"_5":14424,"_27663":51948,"_2970":52057},[],"the principal matches the identity used;",{"_3487":788,"_30445":739,"_21099":52059,"_5":14424,"_27663":51948,"_2970":52060},[],"the consumer persists it exactly once;",{"_3487":789,"_30445":739,"_21099":52062,"_5":14424,"_27663":51948,"_2970":52063},[],"it can be retrieved by resource, actor and period;",{"_3487":790,"_30445":739,"_21099":52065,"_5":14424,"_27663":51948,"_2970":52066},[],"a consumer outage raises an alert.",{"_3487":791,"_30445":739,"_21099":52068,"_5":14424,"_27663":51948,"_2970":52069},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3487":792,"_30445":792,"_5":14788,"_2970":52071,"_30797":52072,"_21099":52073,"_27663":792},"Platform architecture",[49622,51161],[],{"_3487":793,"_30445":792,"_21099":52075,"_5":14424,"_27663":792,"_2970":52076},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3487":794,"_30445":792,"_5":30794,"_21099":52078,"_27663":52079,"_2970":52080},[],"/docs/pr-preview/pr-68/platform/concepts/architecture#control-plane","Control plane",{"_3487":795,"_30445":792,"_5":30794,"_21099":52082,"_27663":52083,"_2970":52084},[],"/docs/pr-preview/pr-68/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3487":796,"_30445":792,"_5":30794,"_21099":52086,"_27663":52087,"_2970":52088},[],"/docs/pr-preview/pr-68/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3487":797,"_30445":792,"_5":30794,"_21099":52090,"_27663":52091,"_2970":52092},[],"/docs/pr-preview/pr-68/platform/concepts/architecture#status-and-validation","Status and validation",{"_3487":798,"_30445":792,"_5":30794,"_21099":52094,"_27663":52095,"_2970":52096},[],"/docs/pr-preview/pr-68/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3487":799,"_30445":792,"_21099":52098,"_5":14424,"_27663":792,"_2970":52099},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3487":800,"_30445":792,"_21099":52101,"_5":14424,"_27663":792,"_2970":52102},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3487":801,"_30445":792,"_21099":52104,"_5":14424,"_27663":52079,"_2970":52105},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3487":802,"_30445":792,"_21099":52107,"_5":14424,"_27663":52083,"_2970":52108},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3487":803,"_30445":792,"_21099":52110,"_5":14424,"_27663":52087,"_2970":52111},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3487":804,"_30445":792,"_21099":52113,"_5":14424,"_27663":52091,"_2970":52114},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3487":805,"_30445":792,"_21099":52116,"_5":14424,"_27663":52095,"_2970":52117},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3487":806,"_30445":806,"_5":14788,"_2970":52119,"_30797":52120,"_21099":52121,"_27663":806},"How Lamassu works",[49622,51161],[],{"_3487":807,"_30445":806,"_21099":52123,"_5":14424,"_27663":806,"_2970":52124},[],"The mental model of trust, keys, certificates and devices.",{"_3487":808,"_30445":806,"_5":30794,"_21099":52126,"_27663":52127,"_2970":52128},[],"/docs/pr-preview/pr-68/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3487":809,"_30445":806,"_5":30794,"_21099":52130,"_27663":52131,"_2970":52132},[],"/docs/pr-preview/pr-68/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3487":810,"_30445":806,"_21099":52134,"_5":14424,"_27663":806,"_2970":52135},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3487":811,"_30445":806,"_21099":52137,"_5":14424,"_27663":52127,"_2970":52138},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3487":812,"_30445":806,"_21099":52140,"_5":14424,"_27663":52127,"_2970":52141},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3487":813,"_30445":806,"_21099":52143,"_5":14424,"_27663":52127,"_2970":52144},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3487":814,"_30445":806,"_21099":52146,"_5":14424,"_27663":52127,"_2970":52147},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3487":815,"_30445":806,"_21099":52149,"_5":14424,"_27663":52127,"_2970":52150},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3487":816,"_30445":806,"_21099":52152,"_5":14424,"_27663":52131,"_2970":52153},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3487":817,"_30445":806,"_21099":52155,"_5":14424,"_27663":52131,"_2970":52156},[],"A DMS relates that CA to an enrollment policy.",{"_3487":818,"_30445":806,"_21099":52158,"_5":14424,"_27663":52131,"_2970":52159},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3487":819,"_30445":806,"_21099":52161,"_5":14424,"_27663":52131,"_2970":52162},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3487":820,"_30445":806,"_21099":52164,"_5":14424,"_27663":52131,"_2970":52165},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3487":821,"_30445":806,"_21099":52167,"_5":14424,"_27663":52131,"_2970":52168},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3487":822,"_30445":806,"_21099":52170,"_5":14424,"_27663":52131,"_2970":52171},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3487":823,"_30445":823,"_5":14788,"_2970":52173,"_30797":52174,"_21099":52176,"_27663":823},"Devices and identities",[49622,51161,52175,52173],"IoT Fleets",[],{"_3487":824,"_30445":823,"_21099":52178,"_5":14424,"_27663":823,"_2970":52179},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3487":825,"_30445":823,"_5":30794,"_21099":52181,"_27663":52182,"_2970":52183},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#device-states","Device states",{"_3487":826,"_30445":823,"_5":30794,"_21099":52185,"_27663":52186,"_2970":52187},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3487":827,"_30445":823,"_5":30794,"_21099":52189,"_27663":52190,"_2970":52191},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3487":828,"_30445":823,"_5":30794,"_21099":52193,"_27663":52194,"_2970":52195},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3487":829,"_30445":823,"_5":30794,"_21099":52197,"_27663":52198,"_2970":52199},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3487":830,"_30445":823,"_5":30794,"_21099":52201,"_27663":52202,"_2970":52203},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3487":831,"_30445":823,"_5":30794,"_21099":52205,"_27663":52206,"_2970":52207},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3487":832,"_30445":823,"_5":30794,"_21099":52209,"_27663":52210,"_2970":52211},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3487":833,"_30445":823,"_5":30794,"_21099":52213,"_27663":52214,"_2970":52215},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3487":834,"_30445":823,"_5":30794,"_21099":52217,"_27663":52218,"_2970":52219},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3487":835,"_30445":823,"_5":30794,"_21099":52221,"_27663":52222,"_2970":52223},[],"/docs/pr-preview/pr-68/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3487":836,"_30445":823,"_21099":52225,"_5":14424,"_27663":823,"_2970":52226},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3487":837,"_30445":823,"_21099":52228,"_5":14424,"_27663":823,"_2970":52229},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3487":838,"_30445":823,"_21099":52231,"_5":14424,"_27663":52182,"_2970":52232},[],"Operational view",{"_3487":839,"_30445":823,"_21099":52234,"_5":14424,"_27663":52182,"_2970":52235},[],"Meaning",{"_3487":840,"_30445":823,"_21099":52237,"_5":14424,"_27663":52182,"_2970":52238},[],"**No Identity**",{"_3487":841,"_30445":823,"_21099":52240,"_5":14424,"_27663":52182,"_2970":52241},[],"A record exists without an associated identity.",{"_3487":842,"_30445":823,"_21099":52243,"_5":14424,"_27663":52182,"_2970":52244},[],"**Active**",{"_3487":843,"_30445":823,"_21099":52246,"_5":14424,"_27663":52182,"_2970":52247},[],"The slot is active; also check certificate dates, status and usages.",{"_3487":844,"_30445":823,"_21099":52249,"_5":14424,"_27663":52182,"_2970":52250},[],"**Renewal Pending**",{"_3487":845,"_30445":823,"_21099":52252,"_5":14424,"_27663":52182,"_2970":52253},[],"The identity is in the operational renewal window.",{"_3487":846,"_30445":823,"_21099":52255,"_5":14424,"_27663":52182,"_2970":52256},[],"**Expiring Soon**",{"_3487":847,"_30445":823,"_21099":52258,"_5":14424,"_27663":52182,"_2970":52259},[],"Expiration is approaching according to configured thresholds.",{"_3487":848,"_30445":823,"_21099":52261,"_5":14424,"_27663":52182,"_2970":52262},[],"**Expired**",{"_3487":849,"_30445":823,"_21099":52264,"_5":14424,"_27663":52182,"_2970":52265},[],"The identity has expired.",{"_3487":850,"_30445":823,"_21099":52267,"_5":14424,"_27663":52182,"_2970":52268},[],"**Revoked**",{"_3487":851,"_30445":823,"_21099":52270,"_5":14424,"_27663":52182,"_2970":52271},[],"The identity is marked revoked.",{"_3487":852,"_30445":823,"_21099":52273,"_5":14424,"_27663":52182,"_2970":52274},[],"**Decommissioned**",{"_3487":853,"_30445":823,"_21099":52276,"_5":14424,"_27663":52182,"_2970":52277},[],"The record is retired and ordinary updates do not restore operation.",{"_3487":854,"_30445":823,"_21099":52279,"_5":14424,"_27663":52182,"_2970":52280},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3487":855,"_30445":823,"_21099":52282,"_5":14424,"_27663":52186,"_2970":52283},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3487":856,"_30445":823,"_21099":52285,"_5":14424,"_27663":52186,"_2970":52286},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3487":857,"_30445":823,"_21099":52288,"_5":14424,"_27663":52186,"_2970":52289},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3487":858,"_30445":823,"_21099":52291,"_5":14424,"_27663":52186,"_2970":52292},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3487":859,"_30445":823,"_21099":52294,"_5":14424,"_27663":52190,"_2970":52295},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3487":860,"_30445":823,"_21099":52297,"_5":14424,"_27663":52194,"_2970":52298},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3487":861,"_30445":823,"_21099":52300,"_5":14424,"_27663":52198,"_2970":52301},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3487":862,"_30445":823,"_21099":52303,"_5":14424,"_27663":52202,"_2970":52304},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3487":863,"_30445":823,"_21099":52306,"_5":14424,"_27663":52206,"_2970":52307},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3487":864,"_30445":823,"_21099":52309,"_5":14424,"_27663":52206,"_2970":52310},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3487":865,"_30445":823,"_21099":52312,"_5":14424,"_27663":52210,"_2970":52313},[],"From **No Identity**, use **Assign Identity**:",{"_3487":866,"_30445":823,"_21099":52315,"_5":14424,"_27663":52210,"_2970":52316},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3487":867,"_30445":823,"_21099":52318,"_5":14424,"_27663":52210,"_2970":52319},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3487":868,"_30445":823,"_21099":52321,"_5":14424,"_27663":52210,"_2970":52322},[],"Confirm and read the serial, active version and history again.",{"_3487":869,"_30445":823,"_21099":52324,"_5":14424,"_27663":52210,"_2970":52325},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3487":870,"_30445":823,"_21099":52327,"_5":14424,"_27663":52210,"_2970":52328},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3487":871,"_30445":823,"_21099":52330,"_5":14424,"_27663":52214,"_2970":52331},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3487":872,"_30445":823,"_21099":52333,"_5":14424,"_27663":52214,"_2970":52334},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3487":873,"_30445":823,"_21099":52336,"_5":14424,"_27663":52218,"_2970":52337},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3487":874,"_30445":823,"_21099":52339,"_5":14424,"_27663":52218,"_2970":52340},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3487":875,"_30445":823,"_21099":52342,"_5":14424,"_27663":52218,"_2970":52343},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3487":876,"_30445":823,"_21099":52345,"_5":14424,"_27663":52218,"_2970":52346},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3487":877,"_30445":823,"_21099":52348,"_5":14424,"_27663":52222,"_2970":52349},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3487":878,"_30445":823,"_21099":52351,"_5":14424,"_27663":52222,"_2970":52352},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3487":879,"_30445":879,"_5":14788,"_2970":52354,"_30797":52355,"_21099":52357,"_27663":879},"Bootstrap identity and authentication",[49622,51161,52175,52173,52356],"Enrollment with PKI",[],{"_3487":880,"_30445":879,"_21099":52359,"_5":14424,"_27663":879,"_2970":52360},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3487":881,"_30445":879,"_5":30794,"_21099":52362,"_27663":52363,"_2970":52364},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3487":882,"_30445":879,"_5":30794,"_21099":52366,"_27663":52367,"_2970":52368},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3487":883,"_30445":879,"_5":30794,"_21099":52370,"_27663":52371,"_2970":52372},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3487":884,"_30445":879,"_5":30794,"_21099":52374,"_27663":52375,"_2970":52376},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3487":885,"_30445":879,"_5":30794,"_21099":52378,"_27663":52379,"_2970":52380},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3487":886,"_30445":879,"_21099":52382,"_5":14424,"_27663":879,"_2970":52383},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3487":887,"_30445":879,"_21099":52385,"_5":14424,"_27663":52363,"_2970":52386},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3487":888,"_30445":879,"_21099":52388,"_5":14424,"_27663":52363,"_2970":52389},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3487":889,"_30445":879,"_21099":52391,"_5":14424,"_27663":52367,"_2970":52392},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3487":890,"_30445":879,"_21099":52394,"_5":14424,"_27663":52367,"_2970":52395},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3487":891,"_30445":879,"_21099":52397,"_5":14424,"_27663":52367,"_2970":52398},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3487":892,"_30445":879,"_21099":52400,"_5":14424,"_27663":52371,"_2970":52401},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3487":893,"_30445":879,"_21099":52403,"_5":14424,"_27663":52371,"_2970":52404},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3487":894,"_30445":879,"_21099":52406,"_5":14424,"_27663":52375,"_2970":52407},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3487":895,"_30445":879,"_21099":52409,"_5":14424,"_27663":52375,"_2970":52410},[],"Example body:",{"_3487":896,"_30445":879,"_21099":52412,"_5":14424,"_27663":52375,"_2970":52413},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3487":897,"_30445":879,"_21099":52415,"_5":14424,"_27663":52375,"_2970":52416},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3487":898,"_30445":879,"_21099":52418,"_5":14424,"_27663":52375,"_2970":52419},[],"Continuation requires a successful HTTP response and JSON:",{"_3487":899,"_30445":879,"_21099":52421,"_5":14424,"_27663":52375,"_2970":52422},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3487":900,"_30445":879,"_21099":52424,"_5":14424,"_27663":52379,"_2970":52425},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3487":901,"_30445":879,"_21099":52427,"_5":14424,"_27663":52379,"_2970":52428},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3487":902,"_30445":902,"_5":14788,"_2970":52430,"_30797":52431,"_21099":52432,"_27663":902},"Configure and operate the DMS",[49622,51161,52175,52173,52356],[],{"_3487":903,"_30445":902,"_21099":52434,"_5":14424,"_27663":902,"_2970":52435},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3487":904,"_30445":902,"_5":30794,"_21099":52437,"_27663":52438,"_2970":49632},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3487":905,"_30445":902,"_5":30794,"_21099":52440,"_27663":52441,"_2970":52442},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3487":906,"_30445":902,"_5":30794,"_21099":52444,"_27663":52445,"_2970":52446},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3487":907,"_30445":902,"_5":30794,"_21099":52448,"_27663":52449,"_2970":52450},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3487":908,"_30445":902,"_5":30794,"_21099":52452,"_27663":52453,"_2970":52454},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3487":909,"_30445":902,"_5":30794,"_21099":52456,"_27663":52457,"_2970":52458},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3487":910,"_30445":902,"_5":30794,"_21099":52460,"_27663":52461,"_2970":52462},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3487":911,"_30445":902,"_5":30794,"_21099":52464,"_27663":52465,"_2970":52466},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3487":912,"_30445":902,"_5":30794,"_21099":52468,"_27663":52469,"_2970":52470},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3487":913,"_30445":902,"_5":30794,"_21099":52472,"_27663":52473,"_2970":52474},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3487":914,"_30445":902,"_5":30794,"_21099":52476,"_27663":52477,"_2970":52478},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3487":915,"_30445":902,"_5":30794,"_21099":52480,"_27663":52481,"_2970":52482},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3487":916,"_30445":902,"_5":30794,"_21099":52484,"_27663":52485,"_2970":52486},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3487":917,"_30445":902,"_5":30794,"_21099":52488,"_27663":52489,"_2970":52490},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3487":918,"_30445":902,"_5":30794,"_21099":52492,"_27663":52493,"_2970":52494},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3487":919,"_30445":902,"_5":30794,"_21099":52496,"_27663":52497,"_2970":52498},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3487":920,"_30445":902,"_5":30794,"_21099":52500,"_27663":52501,"_2970":52502},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3487":921,"_30445":902,"_5":30794,"_21099":52504,"_27663":52505,"_2970":52506},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3487":922,"_30445":902,"_21099":52508,"_5":14424,"_27663":902,"_2970":52509},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3487":923,"_30445":902,"_21099":52511,"_5":14424,"_27663":52438,"_2970":52512},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3487":924,"_30445":902,"_21099":52514,"_5":14424,"_27663":52438,"_2970":52515},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3487":925,"_30445":902,"_21099":52517,"_5":14424,"_27663":52445,"_2970":52518},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3487":926,"_30445":902,"_21099":52520,"_5":14424,"_27663":52449,"_2970":52521},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3487":927,"_30445":902,"_21099":52523,"_5":14424,"_27663":52453,"_2970":52524},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3487":928,"_30445":902,"_21099":52526,"_5":14424,"_27663":52457,"_2970":52527},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3487":929,"_30445":902,"_21099":52529,"_5":14424,"_27663":52461,"_2970":52530},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3487":930,"_30445":902,"_21099":52532,"_5":14424,"_27663":52469,"_2970":52533},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3487":931,"_30445":902,"_21099":52535,"_5":14424,"_27663":52469,"_2970":52536},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3487":932,"_30445":902,"_21099":52538,"_5":14424,"_27663":52473,"_2970":52539},[],"`settings.enrollment_settings` field",{"_3487":933,"_30445":902,"_21099":52541,"_5":14424,"_27663":52473,"_2970":52542},[],"Decision",{"_3487":934,"_30445":902,"_21099":52544,"_5":14424,"_27663":52473,"_2970":52545},[],"`protocol`",{"_3487":935,"_30445":902,"_21099":52547,"_5":14424,"_27663":52473,"_2970":52548},[],"`EST_RFC7030` for these operations.",{"_3487":936,"_30445":902,"_21099":52550,"_5":14424,"_27663":52473,"_2970":52551},[],"`enrollment_ca`",{"_3487":937,"_30445":902,"_21099":52553,"_5":14424,"_27663":52473,"_2970":52554},[],"ID of the signing CA.",{"_3487":938,"_30445":902,"_21099":52556,"_5":14424,"_27663":52473,"_2970":52557},[],"`verify_csr_signature`",{"_3487":939,"_30445":902,"_21099":52559,"_5":14424,"_27663":52473,"_2970":52560},[],"Keep `true` to verify CSR key possession.",{"_3487":940,"_30445":902,"_21099":52562,"_5":14424,"_27663":52473,"_2970":52563},[],"`enable_replaceable_enrollment`",{"_3487":941,"_30445":902,"_21099":52565,"_5":14424,"_27663":52473,"_2970":52566},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3487":942,"_30445":902,"_21099":52568,"_5":14424,"_27663":52473,"_2970":52569},[],"`est_rfc7030_settings.auth_mode`",{"_3487":943,"_30445":902,"_21099":52571,"_5":14424,"_27663":52473,"_2970":52572},[],"One of the four authentication modes.",{"_3487":944,"_30445":902,"_21099":52574,"_5":14424,"_27663":52473,"_2970":52575},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3487":945,"_30445":902,"_21099":52577,"_5":14424,"_27663":52477,"_2970":52578},[],"The blocks are independent:",{"_3487":946,"_30445":902,"_21099":52580,"_5":14424,"_27663":52477,"_2970":52581},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3487":947,"_30445":902,"_21099":52583,"_5":14424,"_27663":52477,"_2970":52584},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3487":948,"_30445":902,"_21099":52586,"_5":14424,"_27663":52477,"_2970":52587},[],"`auth_mode`",{"_3487":949,"_30445":902,"_21099":52589,"_5":14424,"_27663":52477,"_2970":52590},[],"Control applied in the configured operation",{"_3487":950,"_30445":902,"_21099":52592,"_5":14424,"_27663":52477,"_2970":52593},[],"`CLIENT_CERTIFICATE`",{"_3487":951,"_30445":902,"_21099":52595,"_5":14424,"_27663":52477,"_2970":52596},[],"Presented certificate validation.",{"_3487":952,"_30445":902,"_21099":52598,"_5":14424,"_27663":52477,"_2970":52599},[],"`EXTERNAL_WEBHOOK`",{"_3487":953,"_30445":902,"_21099":52601,"_5":14424,"_27663":52477,"_2970":52602},[],"Configured webhook authorization.",{"_3487":954,"_30445":902,"_21099":52604,"_5":14424,"_27663":52477,"_2970":52605},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3487":955,"_30445":902,"_21099":52607,"_5":14424,"_27663":52477,"_2970":52608},[],"Certificate validation followed by webhook approval.",{"_3487":956,"_30445":902,"_21099":52610,"_5":14424,"_27663":52477,"_2970":52611},[],"`NO_AUTH`",{"_3487":957,"_30445":902,"_21099":52613,"_5":14424,"_27663":52477,"_2970":52614},[],"No DMS requester authentication.",{"_3487":958,"_30445":902,"_21099":52616,"_5":14424,"_27663":52477,"_2970":52617},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3487":959,"_30445":902,"_21099":52619,"_5":14424,"_27663":52477,"_2970":52620},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3487":960,"_30445":902,"_21099":52622,"_5":14424,"_27663":52477,"_2970":52623},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3487":961,"_30445":902,"_21099":52625,"_5":14424,"_27663":52477,"_2970":52626},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3487":962,"_30445":902,"_21099":52628,"_5":14424,"_27663":52481,"_2970":52629},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3487":963,"_30445":902,"_21099":52631,"_5":14424,"_27663":52481,"_2970":52632},[],"`external_webhook_settings` field",{"_3487":964,"_30445":902,"_21099":52634,"_5":14424,"_27663":52481,"_2970":52542},[],{"_3487":965,"_30445":902,"_21099":52636,"_5":14424,"_27663":52481,"_2970":52637},[],"`url`",{"_3487":966,"_30445":902,"_21099":52639,"_5":14424,"_27663":52481,"_2970":52640},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3487":967,"_30445":902,"_21099":52642,"_5":14424,"_27663":52481,"_2970":52643},[],"`method`",{"_3487":968,"_30445":902,"_21099":52645,"_5":14424,"_27663":52481,"_2970":52646},[],"`POST` or `PUT`; `POST` by default.",{"_3487":969,"_30445":902,"_21099":52648,"_5":14424,"_27663":52481,"_2970":52649},[],"`name`",{"_3487":970,"_30445":902,"_21099":52651,"_5":14424,"_27663":52481,"_2970":52652},[],"Label used in service logs.",{"_3487":971,"_30445":902,"_21099":52654,"_5":14424,"_27663":52481,"_2970":52655},[],"`config.auth_mode`",{"_3487":972,"_30445":902,"_21099":52657,"_5":14424,"_27663":52481,"_2970":52658},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3487":973,"_30445":902,"_21099":52660,"_5":14424,"_27663":52481,"_2970":52661},[],"`config.log_level`",{"_3487":974,"_30445":902,"_21099":52663,"_5":14424,"_27663":52481,"_2970":52664},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3487":975,"_30445":902,"_21099":52666,"_5":14424,"_27663":52481,"_2970":52667},[],"`config.apikey_options`",{"_3487":976,"_30445":902,"_21099":52669,"_5":14424,"_27663":52481,"_2970":52670},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3487":977,"_30445":902,"_21099":52672,"_5":14424,"_27663":52481,"_2970":52673},[],"`config.jwt_options`",{"_3487":978,"_30445":902,"_21099":52675,"_5":14424,"_27663":52481,"_2970":52676},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3487":979,"_30445":902,"_21099":52678,"_5":14424,"_27663":52481,"_2970":52679},[],"`config.mtls_options`",{"_3487":980,"_30445":902,"_21099":52681,"_5":14424,"_27663":52481,"_2970":52682},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3487":981,"_30445":902,"_21099":52684,"_5":14424,"_27663":52481,"_2970":52685},[],"`config.insecure_skip_verify`",{"_3487":982,"_30445":902,"_21099":52687,"_5":14424,"_27663":52481,"_2970":52688},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3487":983,"_30445":902,"_21099":52690,"_5":14424,"_27663":52481,"_2970":52691},[],"`config.call_timeout`",{"_3487":984,"_30445":902,"_21099":52693,"_5":14424,"_27663":52481,"_2970":52694},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3487":985,"_30445":902,"_21099":52696,"_5":14424,"_27663":52481,"_2970":52697},[],"Rules for that configuration:",{"_3487":986,"_30445":902,"_21099":52699,"_5":14424,"_27663":52481,"_2970":52700},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3487":987,"_30445":902,"_21099":52702,"_5":14424,"_27663":52481,"_2970":52703},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3487":988,"_30445":902,"_21099":52705,"_5":14424,"_27663":52481,"_2970":52706},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3487":989,"_30445":902,"_21099":52708,"_5":14424,"_27663":52481,"_2970":52709},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3487":990,"_30445":902,"_21099":52711,"_5":14424,"_27663":52481,"_2970":52712},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3487":991,"_30445":902,"_21099":52714,"_5":14424,"_27663":52481,"_2970":52715},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3487":992,"_30445":902,"_21099":52717,"_5":14424,"_27663":52481,"_2970":52718},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3487":993,"_30445":902,"_21099":52720,"_5":14424,"_27663":52481,"_2970":52721},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3487":994,"_30445":902,"_21099":52723,"_5":14424,"_27663":52481,"_2970":52724},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3487":995,"_30445":902,"_21099":52726,"_5":14424,"_27663":52485,"_2970":52727},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3487":996,"_30445":902,"_21099":52729,"_5":14424,"_27663":52489,"_2970":52730},[],"`settings.reenrollment_settings` field",{"_3487":997,"_30445":902,"_21099":52732,"_5":14424,"_27663":52489,"_2970":50012},[],{"_3487":998,"_30445":902,"_21099":52734,"_5":14424,"_27663":52489,"_2970":52735},[],"`reenrollment_delta`",{"_3487":999,"_30445":902,"_21099":52737,"_5":14424,"_27663":52489,"_2970":52738},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3487":1000,"_30445":902,"_21099":52740,"_5":14424,"_27663":52489,"_2970":52741},[],"`preventive_delta`",{"_3487":1001,"_30445":902,"_21099":52743,"_5":14424,"_27663":52489,"_2970":52744},[],"Preventive operational monitoring threshold.",{"_3487":1002,"_30445":902,"_21099":52746,"_5":14424,"_27663":52489,"_2970":52747},[],"`critical_delta`",{"_3487":1003,"_30445":902,"_21099":52749,"_5":14424,"_27663":52489,"_2970":52750},[],"Critical operational monitoring threshold.",{"_3487":1004,"_30445":902,"_21099":52752,"_5":14424,"_27663":52489,"_2970":52753},[],"`enable_expired_renewal`",{"_3487":1005,"_30445":902,"_21099":52755,"_5":14424,"_27663":52489,"_2970":52756},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3487":1006,"_30445":902,"_21099":52758,"_5":14424,"_27663":52489,"_2970":52759},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3487":1007,"_30445":902,"_21099":52761,"_5":14424,"_27663":52489,"_2970":52762},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3487":1008,"_30445":902,"_21099":52764,"_5":14424,"_27663":52489,"_2970":52765},[],"`revoke_on_reenrollment`",{"_3487":1009,"_30445":902,"_21099":52767,"_5":14424,"_27663":52489,"_2970":52768},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3487":1010,"_30445":902,"_21099":52770,"_5":14424,"_27663":52489,"_2970":52771},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3487":1011,"_30445":902,"_21099":52773,"_5":14424,"_27663":52493,"_2970":52774},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3487":1012,"_30445":902,"_21099":52776,"_5":14424,"_27663":52497,"_2970":50006},[],{"_3487":1013,"_30445":902,"_21099":52778,"_5":14424,"_27663":52497,"_2970":52779},[],"Published material",{"_3487":1014,"_30445":902,"_21099":52781,"_5":14424,"_27663":52497,"_2970":52782},[],"**Include Lamassu System CA**",{"_3487":1015,"_30445":902,"_21099":52784,"_5":14424,"_27663":52497,"_2970":52785},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3487":1016,"_30445":902,"_21099":52787,"_5":14424,"_27663":52497,"_2970":52788},[],"**Include Enrollment CA**",{"_3487":1017,"_30445":902,"_21099":52790,"_5":14424,"_27663":52497,"_2970":52791},[],"Selected issuing CA certificate.",{"_3487":1018,"_30445":902,"_21099":52793,"_5":14424,"_27663":52497,"_2970":52794},[],"**Managed CAs**",{"_3487":1019,"_30445":902,"_21099":52796,"_5":14424,"_27663":52497,"_2970":52797},[],"Explicitly selected CA certificates.",{"_3487":1020,"_30445":902,"_21099":52799,"_5":14424,"_27663":52497,"_2970":52800},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3487":1021,"_30445":902,"_21099":52802,"_5":14424,"_27663":52501,"_2970":52803},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3487":1022,"_30445":902,"_21099":52805,"_5":14424,"_27663":52501,"_2970":52806},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3487":1023,"_30445":902,"_21099":52808,"_5":14424,"_27663":52501,"_2970":52809},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3487":1024,"_30445":902,"_21099":52811,"_5":14424,"_27663":52505,"_2970":52812},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3487":1025,"_30445":1025,"_5":14788,"_2970":52814,"_30797":52815,"_21099":52816,"_27663":1025},"Integrate the EST client",[49622,51161,52175,52173,52356],[],{"_3487":1026,"_30445":1025,"_21099":52818,"_5":14424,"_27663":1025,"_2970":52819},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3487":1027,"_30445":1025,"_5":30794,"_21099":52821,"_27663":52822,"_2970":49632},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3487":1028,"_30445":1025,"_5":30794,"_21099":52824,"_27663":52825,"_2970":52826},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3487":1029,"_30445":1025,"_5":30794,"_21099":52828,"_27663":52829,"_2970":52830},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3487":1030,"_30445":1025,"_5":30794,"_21099":52832,"_27663":52833,"_2970":52834},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3487":1031,"_30445":1025,"_5":30794,"_21099":52836,"_27663":52837,"_2970":52838},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3487":1032,"_30445":1025,"_5":30794,"_21099":52840,"_27663":52841,"_2970":52842},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3487":1033,"_30445":1025,"_21099":52844,"_5":14424,"_27663":1025,"_2970":52845},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3487":1034,"_30445":1025,"_21099":52847,"_5":14424,"_27663":52822,"_2970":52848},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3487":1035,"_30445":1025,"_21099":52850,"_5":14424,"_27663":52822,"_2970":52851},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3487":1036,"_30445":1025,"_21099":52853,"_5":14424,"_27663":52822,"_2970":52854},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3487":1037,"_30445":1025,"_21099":52856,"_5":14424,"_27663":52825,"_2970":52857},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3487":1038,"_30445":1025,"_21099":52859,"_5":14424,"_27663":52825,"_2970":52860},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3487":1039,"_30445":1025,"_21099":52862,"_5":14424,"_27663":52829,"_2970":52863},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3487":1040,"_30445":1025,"_21099":52865,"_5":14424,"_27663":52829,"_2970":52866},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3487":1041,"_30445":1025,"_21099":52868,"_5":14424,"_27663":52833,"_2970":52869},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3487":1042,"_30445":1025,"_21099":52871,"_5":14424,"_27663":52833,"_2970":52872},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3487":1043,"_30445":1025,"_21099":52874,"_5":14424,"_27663":52837,"_2970":52875},[],"For a root that issues directly:",{"_3487":1044,"_30445":1025,"_21099":52877,"_5":14424,"_27663":52837,"_2970":52878},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3487":1045,"_30445":1025,"_21099":52880,"_5":14424,"_27663":52837,"_2970":52881},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3487":1046,"_30445":1025,"_21099":52883,"_5":14424,"_27663":52841,"_2970":52884},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3487":1047,"_30445":1047,"_5":14788,"_2970":52886,"_30797":52887,"_21099":52888,"_27663":1047},"EST reference",[49622,51161,52175,52173,52356],[],{"_3487":1048,"_30445":1047,"_21099":52890,"_5":14424,"_27663":1047,"_2970":52891},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3487":1049,"_30445":1047,"_5":30794,"_21099":52893,"_27663":52894,"_2970":52895},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3487":1050,"_30445":1047,"_5":30794,"_21099":52897,"_27663":52898,"_2970":22862},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3487":1051,"_30445":1047,"_5":30794,"_21099":52900,"_27663":52901,"_2970":26256},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3487":1052,"_30445":1047,"_5":30794,"_21099":52903,"_27663":52904,"_2970":26263},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3487":1053,"_30445":1047,"_5":30794,"_21099":52906,"_27663":52907,"_2970":25577},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3487":1054,"_30445":1047,"_5":30794,"_21099":52909,"_27663":52910,"_2970":52911},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3487":1055,"_30445":1047,"_5":30794,"_21099":52913,"_27663":52914,"_2970":52915},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3487":1056,"_30445":1047,"_5":30794,"_21099":52917,"_27663":52918,"_2970":52919},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3487":1057,"_30445":1047,"_21099":52921,"_5":14424,"_27663":1047,"_2970":52922},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3487":1058,"_30445":1047,"_21099":52924,"_5":14424,"_27663":52894,"_2970":52925},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3487":1059,"_30445":1047,"_21099":52927,"_5":14424,"_27663":52894,"_2970":52928},[],"Operation",{"_3487":1060,"_30445":1047,"_21099":52930,"_5":14424,"_27663":52894,"_2970":52931},[],"Method",{"_3487":1061,"_30445":1047,"_21099":52933,"_5":14424,"_27663":52894,"_2970":52934},[],"Authentication and condition",{"_3487":1062,"_30445":1047,"_21099":52936,"_5":14424,"_27663":52894,"_2970":52937},[],"`/cacerts`",{"_3487":1063,"_30445":1047,"_21099":52939,"_5":14424,"_27663":52894,"_2970":52940},[],"GET",{"_3487":1064,"_30445":1047,"_21099":52942,"_5":14424,"_27663":52894,"_2970":52943},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3487":1065,"_30445":1047,"_21099":52945,"_5":14424,"_27663":52894,"_2970":52946},[],"`/simpleenroll`",{"_3487":1066,"_30445":1047,"_21099":52948,"_5":14424,"_27663":52894,"_2970":52949},[],"POST",{"_3487":1067,"_30445":1047,"_21099":52951,"_5":14424,"_27663":52894,"_2970":52952},[],"Initial authentication and DMS registration/replacement policy.",{"_3487":1068,"_30445":1047,"_21099":52954,"_5":14424,"_27663":52894,"_2970":52955},[],"`/simplereenroll`",{"_3487":1069,"_30445":1047,"_21099":52957,"_5":14424,"_27663":52894,"_2970":52949},[],{"_3487":1070,"_30445":1047,"_21099":52959,"_5":14424,"_27663":52894,"_2970":52960},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3487":1071,"_30445":1047,"_21099":52962,"_5":14424,"_27663":52894,"_2970":52963},[],"`/serverkeygen`",{"_3487":1072,"_30445":1047,"_21099":52965,"_5":14424,"_27663":52894,"_2970":52949},[],{"_3487":1073,"_30445":1047,"_21099":52967,"_5":14424,"_27663":52894,"_2970":52968},[],"Initial authentication and admission; server generation enabled.",{"_3487":1074,"_30445":1047,"_21099":52970,"_5":14424,"_27663":52894,"_2970":52971},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3487":1075,"_30445":1047,"_21099":52973,"_5":14424,"_27663":52898,"_2970":52974},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3487":1076,"_30445":1047,"_21099":52976,"_5":14424,"_27663":52898,"_2970":52977},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3487":1077,"_30445":1047,"_21099":52979,"_5":14424,"_27663":52901,"_2970":52980},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3487":1078,"_30445":1047,"_21099":52982,"_5":14424,"_27663":52901,"_2970":52983},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3487":1079,"_30445":1047,"_21099":52985,"_5":14424,"_27663":52904,"_2970":52986},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3487":1080,"_30445":1047,"_21099":52988,"_5":14424,"_27663":52904,"_2970":52989},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3487":1081,"_30445":1047,"_21099":52991,"_5":14424,"_27663":52907,"_2970":52992},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3487":1082,"_30445":1047,"_21099":52994,"_5":14424,"_27663":52907,"_2970":52995},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3487":1083,"_30445":1047,"_21099":52997,"_5":14424,"_27663":52910,"_2970":52998},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3487":1084,"_30445":1047,"_21099":53000,"_5":14424,"_27663":52910,"_2970":53001},[],"Part",{"_3487":1085,"_30445":1047,"_21099":53003,"_5":14424,"_27663":52910,"_2970":53004},[],"Content after decoding its Base64",{"_3487":1086,"_30445":1047,"_21099":53006,"_5":14424,"_27663":52910,"_2970":53007},[],"`application/pkcs8`",{"_3487":1087,"_30445":1047,"_21099":53009,"_5":14424,"_27663":52910,"_2970":53010},[],"Unencrypted DER PKCS#8 private key.",{"_3487":1088,"_30445":1047,"_21099":53012,"_5":14424,"_27663":52910,"_2970":53013},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3487":1089,"_30445":1047,"_21099":53015,"_5":14424,"_27663":52910,"_2970":53016},[],"DER PKCS#7 containing the issued certificate.",{"_3487":1090,"_30445":1047,"_21099":53018,"_5":14424,"_27663":52910,"_2970":53019},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3487":1091,"_30445":1047,"_21099":53021,"_5":14424,"_27663":52914,"_2970":53022},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3487":1092,"_30445":1047,"_21099":53024,"_5":14424,"_27663":52914,"_2970":53025},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3487":1093,"_30445":1047,"_21099":53027,"_5":14424,"_27663":52914,"_2970":53028},[],"Convert and check the result:",{"_3487":1094,"_30445":1047,"_21099":53030,"_5":14424,"_27663":52914,"_2970":53031},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3487":1095,"_30445":1047,"_21099":53033,"_5":14424,"_27663":52918,"_2970":53034},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3487":1096,"_30445":1047,"_21099":53036,"_5":14424,"_27663":52918,"_2970":53037},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3487":1097,"_30445":1097,"_5":14788,"_2970":52356,"_30797":53039,"_21099":53040,"_27663":1097},[49622,51161,52175,52173,52356],[],{"_3487":1098,"_30445":1097,"_21099":53042,"_5":14424,"_27663":1097,"_2970":53043},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3487":1099,"_30445":1097,"_5":30794,"_21099":53045,"_27663":53046,"_2970":53047},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3487":1100,"_30445":1097,"_5":30794,"_21099":53049,"_27663":53050,"_2970":53051},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3487":1101,"_30445":1097,"_5":30794,"_21099":53053,"_27663":53054,"_2970":53055},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3487":1102,"_30445":1097,"_5":30794,"_21099":53057,"_27663":53058,"_2970":53059},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3487":1103,"_30445":1097,"_21099":53061,"_5":14424,"_27663":1097,"_2970":53062},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3487":1104,"_30445":1097,"_21099":53064,"_5":14424,"_27663":53046,"_2970":53065},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3487":1105,"_30445":1097,"_21099":53067,"_5":14424,"_27663":53046,"_2970":53068},[],"The integrator installs initial EST server trust and an admission credential.",{"_3487":1106,"_30445":1097,"_21099":53070,"_5":14424,"_27663":53046,"_2970":53071},[],"The client requests an identity for its `Device ID` through EST.",{"_3487":1107,"_30445":1097,"_21099":53073,"_5":14424,"_27663":53046,"_2970":53074},[],"Certificate, device binding and key/certificate installation are checked.",{"_3487":1108,"_30445":1097,"_21099":53076,"_5":14424,"_27663":53046,"_2970":53077},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3487":1109,"_30445":1097,"_21099":53079,"_5":14424,"_27663":53046,"_2970":53080},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3487":1110,"_30445":1097,"_21099":53082,"_5":14424,"_27663":53050,"_2970":53083},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3487":1111,"_30445":1097,"_21099":53085,"_5":14424,"_27663":53050,"_2970":53086},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3487":1112,"_30445":1097,"_21099":53088,"_5":14424,"_27663":53050,"_2970":53089},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3487":1113,"_30445":1097,"_21099":53091,"_5":14424,"_27663":53050,"_2970":53092},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3487":1114,"_30445":1097,"_21099":53094,"_5":14424,"_27663":53054,"_2970":53095},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3487":1115,"_30445":1097,"_21099":53097,"_5":14424,"_27663":53054,"_2970":53098},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3487":1116,"_30445":1097,"_21099":53100,"_5":14424,"_27663":53054,"_2970":53101},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3487":1117,"_30445":1097,"_21099":53103,"_5":14424,"_27663":53054,"_2970":53104},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3487":1118,"_30445":1097,"_21099":53106,"_5":14424,"_27663":53058,"_2970":53107},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3487":1119,"_30445":1097,"_21099":53109,"_5":14424,"_27663":53058,"_2970":53110},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3487":1120,"_30445":1120,"_5":14788,"_2970":53112,"_30797":53113,"_21099":53114,"_27663":1120},"Provisioning strategies",[49622,51161,52175,52173,52356],[],{"_3487":1121,"_30445":1120,"_21099":53116,"_5":14424,"_27663":1120,"_2970":53117},[],"Choose device registration, identity authorization and key generation.",{"_3487":1122,"_30445":1120,"_5":30794,"_21099":53119,"_27663":53120,"_2970":53121},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3487":1123,"_30445":1120,"_5":30794,"_21099":53123,"_27663":53124,"_2970":53125},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3487":1124,"_30445":1120,"_5":30794,"_21099":53127,"_27663":53128,"_2970":53129},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3487":1125,"_30445":1120,"_5":30794,"_21099":53131,"_27663":53132,"_2970":53133},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3487":1126,"_30445":1120,"_5":30794,"_21099":53135,"_27663":53136,"_2970":53137},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3487":1127,"_30445":1120,"_21099":53139,"_5":14424,"_27663":1120,"_2970":53140},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3487":1128,"_30445":1120,"_21099":53142,"_5":14424,"_27663":53120,"_2970":53143},[],"Path",{"_3487":1129,"_30445":1120,"_21099":53145,"_5":14424,"_27663":53120,"_2970":53146},[],"When the device exists",{"_3487":1130,"_30445":1120,"_21099":53148,"_5":14424,"_27663":53120,"_2970":53149},[],"What to check",{"_3487":1131,"_30445":1120,"_21099":53151,"_5":14424,"_27663":53120,"_2970":53152},[],"Manual assignment",{"_3487":1132,"_30445":1120,"_21099":53154,"_5":14424,"_27663":53120,"_2970":53155},[],"An operator creates it before associating a certificate.",{"_3487":1133,"_30445":1120,"_21099":53157,"_5":14424,"_27663":53120,"_2970":53158},[],"ID, owning DMS, certificate CN and bound serial.",{"_3487":1134,"_30445":1120,"_21099":53160,"_5":14424,"_27663":53120,"_2970":53161},[],"EST with `JITP`",{"_3487":1135,"_30445":1120,"_21099":53163,"_5":14424,"_27663":53120,"_2970":53164},[],"Created for an unknown CN during `/simpleenroll`.",{"_3487":1136,"_30445":1120,"_21099":53166,"_5":14424,"_27663":53120,"_2970":53167},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3487":1137,"_30445":1120,"_21099":53169,"_5":14424,"_27663":53120,"_2970":53170},[],"EST with `PRE_REGISTRATION`",{"_3487":1138,"_30445":1120,"_21099":53172,"_5":14424,"_27663":53120,"_2970":53173},[],"Must exist before `/simpleenroll`.",{"_3487":1139,"_30445":1120,"_21099":53175,"_5":14424,"_27663":53120,"_2970":53176},[],"Approved record, same DMS and replacement conditions for your version.",{"_3487":1140,"_30445":1120,"_21099":53178,"_5":14424,"_27663":53120,"_2970":53179},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3487":1141,"_30445":1120,"_21099":53181,"_5":14424,"_27663":53120,"_2970":53182},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3487":1142,"_30445":1120,"_21099":53184,"_5":14424,"_27663":53124,"_2970":53185},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3487":1143,"_30445":1120,"_21099":53187,"_5":14424,"_27663":53124,"_2970":53188},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3487":1144,"_30445":1120,"_21099":53190,"_5":14424,"_27663":53124,"_2970":53191},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3487":1145,"_30445":1120,"_21099":53193,"_5":14424,"_27663":53128,"_2970":53194},[],"Decide initial enrollment and re-enrollment separately:",{"_3487":1146,"_30445":1120,"_21099":53196,"_5":14424,"_27663":53128,"_2970":53197},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3487":1147,"_30445":1120,"_21099":53199,"_5":14424,"_27663":53128,"_2970":53200},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3487":1148,"_30445":1120,"_21099":53202,"_5":14424,"_27663":53128,"_2970":53203},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3487":1149,"_30445":1120,"_21099":53205,"_5":14424,"_27663":53128,"_2970":53206},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3487":1150,"_30445":1120,"_21099":53208,"_5":14424,"_27663":53128,"_2970":53209},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3487":1151,"_30445":1120,"_21099":53211,"_5":14424,"_27663":53132,"_2970":50006},[],{"_3487":1152,"_30445":1120,"_21099":53213,"_5":14424,"_27663":53132,"_2970":53214},[],"Material crossing EST",{"_3487":1153,"_30445":1120,"_21099":53216,"_5":14424,"_27663":53132,"_2970":53217},[],"Device-generated key",{"_3487":1154,"_30445":1120,"_21099":53219,"_5":14424,"_27663":53132,"_2970":53220},[],"Public CSR and certificate; the key stays on the client.",{"_3487":1155,"_30445":1120,"_21099":53222,"_5":14424,"_27663":53132,"_2970":53223},[],"Existing device key",{"_3487":1156,"_30445":1120,"_21099":53225,"_5":14424,"_27663":53132,"_2970":53226},[],"CSR signed with that key and a new certificate.",{"_3487":1157,"_30445":1120,"_21099":53228,"_5":14424,"_27663":53132,"_2970":52494},[],{"_3487":1158,"_30445":1120,"_21099":53230,"_5":14424,"_27663":53132,"_2970":53231},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3487":1159,"_30445":1120,"_21099":53233,"_5":14424,"_27663":53132,"_2970":53234},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3487":1160,"_30445":1120,"_21099":53236,"_5":14424,"_27663":53136,"_2970":53237},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3487":1161,"_30445":1161,"_5":14788,"_2970":53239,"_30797":53240,"_21099":53241,"_27663":1161},"Renewal and recovery",[49622,51161,52175,52173,52356],[],{"_3487":1162,"_30445":1161,"_21099":53243,"_5":14424,"_27663":1161,"_2970":53244},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3487":1163,"_30445":1161,"_5":30794,"_21099":53246,"_27663":53247,"_2970":53248},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3487":1164,"_30445":1161,"_5":30794,"_21099":53250,"_27663":53251,"_2970":53252},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3487":1165,"_30445":1161,"_5":30794,"_21099":53254,"_27663":53255,"_2970":53256},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3487":1166,"_30445":1161,"_5":30794,"_21099":53258,"_27663":53259,"_2970":53260},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3487":1167,"_30445":1161,"_5":30794,"_21099":53262,"_27663":53263,"_2970":53264},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3487":1168,"_30445":1161,"_21099":53266,"_5":14424,"_27663":1161,"_2970":53267},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3487":1169,"_30445":1161,"_21099":53269,"_5":14424,"_27663":53247,"_2970":53270},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3487":1170,"_30445":1161,"_21099":53272,"_5":14424,"_27663":53247,"_2970":53273},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3487":1171,"_30445":1161,"_21099":53275,"_5":14424,"_27663":53247,"_2970":53276},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3487":1172,"_30445":1161,"_21099":53278,"_5":14424,"_27663":53247,"_2970":53279},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3487":1173,"_30445":1161,"_21099":53281,"_5":14424,"_27663":53251,"_2970":53282},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3487":1174,"_30445":1161,"_21099":53284,"_5":14424,"_27663":53251,"_2970":53285},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3487":1175,"_30445":1161,"_21099":53287,"_5":14424,"_27663":53255,"_2970":53288},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3487":1176,"_30445":1161,"_21099":53290,"_5":14424,"_27663":53255,"_2970":53291},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3487":1177,"_30445":1161,"_21099":53293,"_5":14424,"_27663":53255,"_2970":53294},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3487":1178,"_30445":1161,"_21099":53296,"_5":14424,"_27663":53259,"_2970":53297},[],"Situation",{"_3487":1179,"_30445":1161,"_21099":53299,"_5":14424,"_27663":53259,"_2970":53300},[],"Procedure",{"_3487":1180,"_30445":1161,"_21099":53302,"_5":14424,"_27663":53259,"_2970":53303},[],"Valid certificate, outside the window",{"_3487":1181,"_30445":1161,"_21099":53305,"_5":14424,"_27663":53259,"_2970":53306},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3487":1182,"_30445":1161,"_21099":53308,"_5":14424,"_27663":53259,"_2970":53309},[],"Expired certificate, key available",{"_3487":1183,"_30445":1161,"_21099":53311,"_5":14424,"_27663":53259,"_2970":53312},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3487":1184,"_30445":1161,"_21099":53314,"_5":14424,"_27663":53259,"_2970":53315},[],"Renewal through webhook or `NO_AUTH`",{"_3487":1185,"_30445":1161,"_21099":53317,"_5":14424,"_27663":53259,"_2970":53318},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3487":1186,"_30445":1161,"_21099":53320,"_5":14424,"_27663":53259,"_2970":53321},[],"Lost or inaccessible key",{"_3487":1187,"_30445":1161,"_21099":53323,"_5":14424,"_27663":53259,"_2970":53324},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3487":1188,"_30445":1161,"_21099":53326,"_5":14424,"_27663":53259,"_2970":53327},[],"Current identity revoked",{"_3487":1189,"_30445":1161,"_21099":53329,"_5":14424,"_27663":53259,"_2970":53330},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3487":1190,"_30445":1161,"_21099":53332,"_5":14424,"_27663":53259,"_2970":53333},[],"Device without an identity",{"_3487":1191,"_30445":1161,"_21099":53335,"_5":14424,"_27663":53259,"_2970":53336},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3487":1192,"_30445":1161,"_21099":53338,"_5":14424,"_27663":53259,"_2970":53339},[],"Retired device",{"_3487":1193,"_30445":1161,"_21099":53341,"_5":14424,"_27663":53259,"_2970":53342},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3487":1194,"_30445":1161,"_21099":53344,"_5":14424,"_27663":53259,"_2970":53345},[],"Timeout, HTTP 500 or installation failure",{"_3487":1195,"_30445":1161,"_21099":53347,"_5":14424,"_27663":53259,"_2970":53348},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3487":1196,"_30445":1161,"_21099":53350,"_5":14424,"_27663":53263,"_2970":53351},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3487":1197,"_30445":1161,"_21099":53353,"_5":14424,"_27663":53263,"_2970":53354},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3487":1198,"_30445":1198,"_5":14788,"_2970":53356,"_30797":53357,"_21099":53358,"_27663":1198},"Enrollment troubleshooting",[49622,51161,52175,52173,52356],[],{"_3487":1199,"_30445":1198,"_21099":53360,"_5":14424,"_27663":1198,"_2970":53361},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3487":1200,"_30445":1198,"_5":30794,"_21099":53363,"_27663":53364,"_2970":53365},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3487":1201,"_30445":1198,"_5":30794,"_21099":53367,"_27663":53368,"_2970":53369},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3487":1202,"_30445":1198,"_5":30794,"_21099":53371,"_27663":53372,"_2970":52919},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3487":1203,"_30445":1198,"_5":30794,"_21099":53374,"_27663":53375,"_2970":53376},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3487":1204,"_30445":1198,"_21099":53378,"_5":14424,"_27663":1198,"_2970":53379},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3487":1205,"_30445":1198,"_21099":53381,"_5":14424,"_27663":53368,"_2970":53382},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3487":1206,"_30445":1198,"_21099":53384,"_5":14424,"_27663":53368,"_2970":53385},[],"Symptom or message",{"_3487":1207,"_30445":1198,"_21099":53387,"_5":14424,"_27663":53368,"_2970":53149},[],{"_3487":1208,"_30445":1198,"_21099":53389,"_5":14424,"_27663":53368,"_2970":53390},[],"curl rejects TLS, name or issuer",{"_3487":1209,"_30445":1198,"_21099":53392,"_5":14424,"_27663":53368,"_2970":53393},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3487":1210,"_30445":1198,"_21099":53395,"_5":14424,"_27663":53368,"_2970":53396},[],"404 or missing APS",{"_3487":1211,"_30445":1198,"_21099":53398,"_5":14424,"_27663":53368,"_2970":53399},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3487":1212,"_30445":1198,"_21099":53401,"_5":14424,"_27663":53368,"_2970":53402},[],"400, CSR or format error",{"_3487":1213,"_30445":1198,"_21099":53404,"_5":14424,"_27663":53368,"_2970":53405},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3487":1214,"_30445":1198,"_21099":53407,"_5":14424,"_27663":53368,"_2970":53408},[],"Missing credential or invalid certificate",{"_3487":1215,"_30445":1198,"_21099":53410,"_5":14424,"_27663":53368,"_2970":53411},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3487":1216,"_30445":1198,"_21099":53413,"_5":14424,"_27663":53368,"_2970":53414},[],"Webhook denies, times out or responds without authorization",{"_3487":1217,"_30445":1198,"_21099":53416,"_5":14424,"_27663":53368,"_2970":53417},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3487":1218,"_30445":1198,"_21099":53419,"_5":14424,"_27663":53368,"_2970":53420},[],"`unexpected status code: <n>: redirects are not followed`",{"_3487":1219,"_30445":1198,"_21099":53422,"_5":14424,"_27663":53368,"_2970":53423},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3487":1220,"_30445":1198,"_21099":53425,"_5":14424,"_27663":53368,"_2970":53426},[],"`webhook response exceeds 1048576 bytes`",{"_3487":1221,"_30445":1198,"_21099":53428,"_5":14424,"_27663":53368,"_2970":53429},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3487":1222,"_30445":1198,"_21099":53431,"_5":14424,"_27663":53368,"_2970":53432},[],"`webhook config must not reference files`",{"_3487":1223,"_30445":1198,"_21099":53434,"_5":14424,"_27663":53368,"_2970":53435},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3487":1224,"_30445":1198,"_21099":53437,"_5":14424,"_27663":53368,"_2970":53438},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3487":1225,"_30445":1198,"_21099":53440,"_5":14424,"_27663":53368,"_2970":53441},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3487":1226,"_30445":1198,"_21099":53443,"_5":14424,"_27663":53368,"_2970":53444},[],"`webhook mTLS certificate and key are invalid: …`",{"_3487":1227,"_30445":1198,"_21099":53446,"_5":14424,"_27663":53368,"_2970":53447},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3487":1228,"_30445":1198,"_21099":53449,"_5":14424,"_27663":53368,"_2970":53450},[],"400 `struct validation error` creating or updating a DMS",{"_3487":1229,"_30445":1198,"_21099":53452,"_5":14424,"_27663":53368,"_2970":53453},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3487":1230,"_30445":1198,"_21099":53455,"_5":14424,"_27663":53368,"_2970":53456},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3487":1231,"_30445":1198,"_21099":53458,"_5":14424,"_27663":53368,"_2970":53459},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3487":1232,"_30445":1198,"_21099":53461,"_5":14424,"_27663":53368,"_2970":53462},[],"`device not preregistered`",{"_3487":1233,"_30445":1198,"_21099":53464,"_5":14424,"_27663":53368,"_2970":53465},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3487":1234,"_30445":1198,"_21099":53467,"_5":14424,"_27663":53368,"_2970":53468},[],"`forbiddenNewEnrollment`",{"_3487":1235,"_30445":1198,"_21099":53470,"_5":14424,"_27663":53368,"_2970":53471},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3487":1236,"_30445":1198,"_21099":53473,"_5":14424,"_27663":53368,"_2970":53474},[],"Different owning DMS",{"_3487":1237,"_30445":1198,"_21099":53476,"_5":14424,"_27663":53368,"_2970":53477},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3487":1238,"_30445":1198,"_21099":53479,"_5":14424,"_27663":53368,"_2970":53480},[],"`invalid RawSubject bytes`",{"_3487":1239,"_30445":1198,"_21099":53482,"_5":14424,"_27663":53368,"_2970":53483},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3487":1240,"_30445":1198,"_21099":53485,"_5":14424,"_27663":53368,"_2970":53486},[],"`invalid reenroll window`",{"_3487":1241,"_30445":1198,"_21099":53488,"_5":14424,"_27663":53368,"_2970":53489},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3487":1242,"_30445":1198,"_21099":53491,"_5":14424,"_27663":53368,"_2970":53492},[],"Current certificate revoked",{"_3487":1243,"_30445":1198,"_21099":53494,"_5":14424,"_27663":53368,"_2970":53495},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3487":1244,"_30445":1198,"_21099":53497,"_5":14424,"_27663":53368,"_2970":53498},[],"CA, profile or signing error",{"_3487":1245,"_30445":1198,"_21099":53500,"_5":14424,"_27663":53368,"_2970":53501},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3487":1246,"_30445":1198,"_21099":53503,"_5":14424,"_27663":53368,"_2970":53504},[],"HTTP 200 without a device connection",{"_3487":1247,"_30445":1198,"_21099":53506,"_5":14424,"_27663":53368,"_2970":53507},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3487":1248,"_30445":1198,"_21099":53509,"_5":14424,"_27663":53368,"_2970":53510},[],"Timeout or error after issuance",{"_3487":1249,"_30445":1198,"_21099":53512,"_5":14424,"_27663":53368,"_2970":53513},[],"New certificates, current slot and previous identity's state before retrying.",{"_3487":1250,"_30445":1198,"_21099":53515,"_5":14424,"_27663":53372,"_2970":53516},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3487":1251,"_30445":1198,"_21099":53518,"_5":14424,"_27663":53372,"_2970":53519},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3487":1252,"_30445":1198,"_21099":53521,"_5":14424,"_27663":53375,"_2970":53522},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3487":1253,"_30445":1198,"_21099":53524,"_5":14424,"_27663":53375,"_2970":53525},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3487":1254,"_30445":1198,"_21099":53527,"_5":14424,"_27663":53375,"_2970":53528},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3487":1255,"_30445":1198,"_21099":53530,"_5":14424,"_27663":53375,"_2970":53531},[],"Make one request, save headers/body and query the device and certificates.",{"_3487":1256,"_30445":1198,"_21099":53533,"_5":14424,"_27663":53375,"_2970":53534},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3487":1257,"_30445":1198,"_21099":53536,"_5":14424,"_27663":53375,"_2970":53537},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3487":1258,"_30445":1198,"_21099":53539,"_5":14424,"_27663":53375,"_2970":53540},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3487":1259,"_30445":1259,"_5":14788,"_2970":53542,"_30797":53543,"_21099":53544,"_27663":1259},"Trust distribution and updates",[49622,51161,52175,52173,52356],[],{"_3487":1260,"_30445":1259,"_21099":53546,"_5":14424,"_27663":1259,"_2970":53547},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3487":1261,"_30445":1259,"_5":30794,"_21099":53549,"_27663":53550,"_2970":53551},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3487":1262,"_30445":1259,"_5":30794,"_21099":53553,"_27663":53554,"_2970":53555},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3487":1263,"_30445":1259,"_5":30794,"_21099":53557,"_27663":53558,"_2970":53559},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3487":1264,"_30445":1259,"_5":30794,"_21099":53561,"_27663":53562,"_2970":53563},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3487":1265,"_30445":1259,"_5":30794,"_21099":53565,"_27663":53566,"_2970":53567},[],"/docs/pr-preview/pr-68/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3487":1266,"_30445":1259,"_21099":53569,"_5":14424,"_27663":1259,"_2970":53570},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3487":1267,"_30445":1259,"_21099":53572,"_5":14424,"_27663":53550,"_2970":53573},[],"Relationship",{"_3487":1268,"_30445":1259,"_21099":53575,"_5":14424,"_27663":53550,"_2970":53576},[],"Material prepared by its owner",{"_3487":1269,"_30445":1259,"_21099":53578,"_5":14424,"_27663":53550,"_2970":53579},[],"Device → EST server",{"_3487":1270,"_30445":1259,"_21099":53581,"_5":14424,"_27663":53550,"_2970":53582},[],"Previously verified server root, chain or pin and TLS name.",{"_3487":1271,"_30445":1259,"_21099":53584,"_5":14424,"_27663":53550,"_2970":53585},[],"DMS → requester",{"_3487":1272,"_30445":1259,"_21099":53587,"_5":14424,"_27663":53550,"_2970":53588},[],"CAs and rules authorizing initial or renewal credentials.",{"_3487":1273,"_30445":1259,"_21099":53590,"_5":14424,"_27663":53550,"_2970":53591},[],"Consumer → device",{"_3487":1274,"_30445":1259,"_21099":53593,"_5":14424,"_27663":53550,"_2970":53594},[],"Operational identity roots, intermediates, validation and permissions.",{"_3487":1275,"_30445":1259,"_21099":53596,"_5":14424,"_27663":53550,"_2970":53597},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3487":1276,"_30445":1259,"_21099":53599,"_5":14424,"_27663":53554,"_2970":53600},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3487":1277,"_30445":1259,"_21099":53602,"_5":14424,"_27663":53554,"_2970":53603},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3487":1278,"_30445":1259,"_21099":53605,"_5":14424,"_27663":53558,"_2970":53606},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3487":1279,"_30445":1259,"_21099":53608,"_5":14424,"_27663":53558,"_2970":53609},[],"Select policy-approved roots as anchors.",{"_3487":1280,"_30445":1259,"_21099":53611,"_5":14424,"_27663":53558,"_2970":53612},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3487":1281,"_30445":1259,"_21099":53614,"_5":14424,"_27663":53558,"_2970":53615},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3487":1282,"_30445":1259,"_21099":53617,"_5":14424,"_27663":53558,"_2970":53618},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3487":1283,"_30445":1259,"_21099":53620,"_5":14424,"_27663":53558,"_2970":53621},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3487":1284,"_30445":1259,"_21099":53623,"_5":14424,"_27663":53562,"_2970":53624},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3487":1285,"_30445":1259,"_21099":53626,"_5":14424,"_27663":53562,"_2970":53627},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3487":1286,"_30445":1259,"_21099":53629,"_5":14424,"_27663":53562,"_2970":53630},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3487":1287,"_30445":1259,"_21099":53632,"_5":14424,"_27663":53566,"_2970":53633},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3487":1288,"_30445":1288,"_5":14788,"_2970":53635,"_30797":53636,"_21099":53638,"_27663":1288},"AWS IoT Core",[49622,51161,52175,52173,53637],"Integrations",[],{"_3487":1289,"_30445":1288,"_21099":53640,"_5":14424,"_27663":1288,"_2970":53641},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3487":1290,"_30445":1288,"_5":30794,"_21099":53643,"_27663":53644,"_2970":53645},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3487":1291,"_30445":1288,"_5":30794,"_21099":53647,"_27663":53648,"_2970":53649},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3487":1292,"_30445":1288,"_5":30794,"_21099":53651,"_27663":53652,"_2970":53653},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3487":1293,"_30445":1288,"_5":30794,"_21099":53655,"_27663":53656,"_2970":53657},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3487":1294,"_30445":1288,"_5":30794,"_21099":53659,"_27663":53660,"_2970":53661},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3487":1295,"_30445":1288,"_5":30794,"_21099":53663,"_27663":53664,"_2970":53665},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3487":1296,"_30445":1288,"_5":30794,"_21099":53667,"_27663":53668,"_2970":53669},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3487":1297,"_30445":1288,"_5":30794,"_21099":53671,"_27663":53672,"_2970":53673},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3487":1298,"_30445":1288,"_5":30794,"_21099":53675,"_27663":53676,"_2970":53677},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3487":1299,"_30445":1288,"_5":30794,"_21099":53679,"_27663":53680,"_2970":53681},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3487":1300,"_30445":1288,"_5":30794,"_21099":53683,"_27663":53684,"_2970":53685},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3487":1301,"_30445":1288,"_5":30794,"_21099":53687,"_27663":53688,"_2970":53689},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3487":1302,"_30445":1288,"_5":30794,"_21099":53691,"_27663":53692,"_2970":53693},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3487":1303,"_30445":1288,"_5":30794,"_21099":53695,"_27663":53696,"_2970":53697},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3487":1304,"_30445":1288,"_5":30794,"_21099":53699,"_27663":53700,"_2970":53701},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3487":1305,"_30445":1288,"_5":30794,"_21099":53703,"_27663":53704,"_2970":53705},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3487":1306,"_30445":1288,"_5":30794,"_21099":53707,"_27663":53708,"_2970":53709},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3487":1307,"_30445":1288,"_5":30794,"_21099":53711,"_27663":53712,"_2970":53713},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3487":1308,"_30445":1288,"_5":30794,"_21099":53715,"_27663":53716,"_2970":53717},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3487":1309,"_30445":1288,"_5":30794,"_21099":53719,"_27663":53720,"_2970":53721},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3487":1310,"_30445":1288,"_5":30794,"_21099":53723,"_27663":53724,"_2970":53725},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3487":1311,"_30445":1288,"_5":30794,"_21099":53727,"_27663":53728,"_2970":53729},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3487":1312,"_30445":1288,"_5":30794,"_21099":53731,"_27663":53732,"_2970":53733},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3487":1313,"_30445":1288,"_5":30794,"_21099":53735,"_27663":53736,"_2970":53737},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3487":1314,"_30445":1288,"_5":30794,"_21099":53739,"_27663":53740,"_2970":53741},[],"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3487":1315,"_30445":1288,"_21099":53743,"_5":14424,"_27663":1288,"_2970":53744},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3487":1316,"_30445":1288,"_21099":53746,"_5":14424,"_27663":1288,"_2970":53747},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3487":1317,"_30445":1288,"_21099":53749,"_5":14424,"_27663":1288,"_2970":53750},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3487":1318,"_30445":1288,"_21099":53752,"_5":14424,"_27663":53644,"_2970":53753},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3487":1319,"_30445":1288,"_21099":53755,"_5":14424,"_27663":53644,"_2970":53756},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3487":1320,"_30445":1288,"_21099":53758,"_5":14424,"_27663":53644,"_2970":53759},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3487":1321,"_30445":1288,"_21099":53761,"_5":14424,"_27663":53644,"_2970":53762},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3487":1322,"_30445":1288,"_21099":53764,"_5":14424,"_27663":53648,"_2970":53765},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3487":1323,"_30445":1288,"_21099":53767,"_5":14424,"_27663":53652,"_2970":53768},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3487":1324,"_30445":1288,"_21099":53770,"_5":14424,"_27663":53652,"_2970":53771},[],"IAM action",{"_3487":1325,"_30445":1288,"_21099":53773,"_5":14424,"_27663":53652,"_2970":50012},[],{"_3487":1326,"_30445":1288,"_21099":53775,"_5":14424,"_27663":53652,"_2970":53776},[],"`iot:GetRegistrationCode`",{"_3487":1327,"_30445":1288,"_21099":53778,"_5":14424,"_27663":53652,"_2970":53779},[],"Obtain the verification code for CA registration in the Primary Account",{"_3487":1328,"_30445":1288,"_21099":53781,"_5":14424,"_27663":53652,"_2970":53782},[],"`iot:RegisterCACertificate`",{"_3487":1329,"_30445":1288,"_21099":53784,"_5":14424,"_27663":53652,"_2970":53785},[],"Register the CA in AWS IoT",{"_3487":1330,"_30445":1288,"_21099":53787,"_5":14424,"_27663":53652,"_2970":53788},[],"`iot:DescribeCACertificate`",{"_3487":1331,"_30445":1288,"_21099":53790,"_5":14424,"_27663":53652,"_2970":53791},[],"Check the CA registration status",{"_3487":1332,"_30445":1288,"_21099":53793,"_5":14424,"_27663":53652,"_2970":53794},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3487":1333,"_30445":1288,"_21099":53796,"_5":14424,"_27663":53652,"_2970":53797},[],"Create or update Things in IoT Core",{"_3487":1334,"_30445":1288,"_21099":53799,"_5":14424,"_27663":53652,"_2970":53800},[],"`iot:RegisterThing`",{"_3487":1335,"_30445":1288,"_21099":53802,"_5":14424,"_27663":53652,"_2970":53803},[],"Provision Things through a template",{"_3487":1336,"_30445":1288,"_21099":53805,"_5":14424,"_27663":53652,"_2970":53806},[],"`iot:RegisterCertificate`",{"_3487":1337,"_30445":1288,"_21099":53808,"_5":14424,"_27663":53652,"_2970":53809},[],"Register device certificates",{"_3487":1338,"_30445":1288,"_21099":53811,"_5":14424,"_27663":53652,"_2970":53812},[],"`iot:UpdateCertificate`",{"_3487":1339,"_30445":1288,"_21099":53814,"_5":14424,"_27663":53652,"_2970":53815},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3487":1340,"_30445":1288,"_21099":53817,"_5":14424,"_27663":53652,"_2970":53818},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3487":1341,"_30445":1288,"_21099":53820,"_5":14424,"_27663":53652,"_2970":53821},[],"Create and attach IoT policies",{"_3487":1342,"_30445":1288,"_21099":53823,"_5":14424,"_27663":53652,"_2970":53824},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3487":1343,"_30445":1288,"_21099":53826,"_5":14424,"_27663":53652,"_2970":53827},[],"Manage Thing groups",{"_3487":1344,"_30445":1288,"_21099":53829,"_5":14424,"_27663":53652,"_2970":53830},[],"`iot:CreateProvisioningTemplate`",{"_3487":1345,"_30445":1288,"_21099":53832,"_5":14424,"_27663":53652,"_2970":53833},[],"Create JITP templates",{"_3487":1346,"_30445":1288,"_21099":53835,"_5":14424,"_27663":53652,"_2970":53836},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3487":1347,"_30445":1288,"_21099":53838,"_5":14424,"_27663":53652,"_2970":53839},[],"Read and write the Device Shadow",{"_3487":1348,"_30445":1288,"_21099":53841,"_5":14424,"_27663":53652,"_2970":53842},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3487":1349,"_30445":1288,"_21099":53844,"_5":14424,"_27663":53656,"_2970":53845},[],"Parameter",{"_3487":1350,"_30445":1288,"_21099":53847,"_5":14424,"_27663":53656,"_2970":53848},[],"Type",{"_3487":1351,"_30445":1288,"_21099":53850,"_5":14424,"_27663":53656,"_2970":53851},[],"Required",{"_3487":1352,"_30445":1288,"_21099":53853,"_5":14424,"_27663":53656,"_2970":53854},[],"Description",{"_3487":1353,"_30445":1288,"_21099":53856,"_5":14424,"_27663":53656,"_2970":53857},[],"`connector_id`",{"_3487":1354,"_30445":1288,"_21099":53859,"_5":14424,"_27663":53656,"_2970":25195},[],{"_3487":1355,"_30445":1288,"_21099":53861,"_5":14424,"_27663":53656,"_2970":53862},[],"Yes",{"_3487":1356,"_30445":1288,"_21099":53864,"_5":14424,"_27663":53656,"_2970":53865},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3487":1357,"_30445":1288,"_21099":53867,"_5":14424,"_27663":53656,"_2970":53868},[],"`aws_config.region`",{"_3487":1358,"_30445":1288,"_21099":53870,"_5":14424,"_27663":53656,"_2970":25195},[],{"_3487":1359,"_30445":1288,"_21099":53872,"_5":14424,"_27663":53656,"_2970":53862},[],{"_3487":1360,"_30445":1288,"_21099":53874,"_5":14424,"_27663":53656,"_2970":53875},[],"AWS region where the connector operates.",{"_3487":1361,"_30445":1288,"_21099":53877,"_5":14424,"_27663":53656,"_2970":53878},[],"`aws_config.auth_method`",{"_3487":1362,"_30445":1288,"_21099":53880,"_5":14424,"_27663":53656,"_2970":25195},[],{"_3487":1363,"_30445":1288,"_21099":53882,"_5":14424,"_27663":53656,"_2970":53862},[],{"_3487":1364,"_30445":1288,"_21099":53884,"_5":14424,"_27663":53656,"_2970":53885},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3487":1365,"_30445":1288,"_21099":53887,"_5":14424,"_27663":53656,"_2970":53888},[],"`aws_config.access_key_id`",{"_3487":1366,"_30445":1288,"_21099":53890,"_5":14424,"_27663":53656,"_2970":25195},[],{"_3487":1367,"_30445":1288,"_21099":53892,"_5":14424,"_27663":53656,"_2970":53893},[],"Only with `auth_method=static`",{"_3487":1368,"_30445":1288,"_21099":53895,"_5":14424,"_27663":53656,"_2970":53896},[],"AWS access key.",{"_3487":1369,"_30445":1288,"_21099":53898,"_5":14424,"_27663":53656,"_2970":53899},[],"`aws_config.secret_access_key`",{"_3487":1370,"_30445":1288,"_21099":53901,"_5":14424,"_27663":53656,"_2970":25195},[],{"_3487":1371,"_30445":1288,"_21099":53903,"_5":14424,"_27663":53656,"_2970":53893},[],{"_3487":1372,"_30445":1288,"_21099":53905,"_5":14424,"_27663":53656,"_2970":53906},[],"AWS secret key.",{"_3487":1373,"_30445":1288,"_21099":53908,"_5":14424,"_27663":53656,"_2970":53909},[],"`aws_config.session_token`",{"_3487":1374,"_30445":1288,"_21099":53911,"_5":14424,"_27663":53656,"_2970":25195},[],{"_3487":1375,"_30445":1288,"_21099":53913,"_5":14424,"_27663":53656,"_2970":53914},[],"No",{"_3487":1376,"_30445":1288,"_21099":53916,"_5":14424,"_27663":53656,"_2970":53917},[],"Session token (with `auth_method=static`).",{"_3487":1377,"_30445":1288,"_21099":53919,"_5":14424,"_27663":53656,"_2970":53920},[],"`aws_config.role_arn`",{"_3487":1378,"_30445":1288,"_21099":53922,"_5":14424,"_27663":53656,"_2970":25195},[],{"_3487":1379,"_30445":1288,"_21099":53924,"_5":14424,"_27663":53656,"_2970":53925},[],"Only with `auth_method=role`",{"_3487":1380,"_30445":1288,"_21099":53927,"_5":14424,"_27663":53656,"_2970":53928},[],"ARN of the role to assume.",{"_3487":1381,"_30445":1288,"_21099":53930,"_5":14424,"_27663":53656,"_2970":53931},[],"`aws_config.endpoint_url`",{"_3487":1382,"_30445":1288,"_21099":53933,"_5":14424,"_27663":53656,"_2970":25195},[],{"_3487":1383,"_30445":1288,"_21099":53935,"_5":14424,"_27663":53656,"_2970":53914},[],{"_3487":1384,"_30445":1288,"_21099":53937,"_5":14424,"_27663":53656,"_2970":53938},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3487":1385,"_30445":1288,"_21099":53940,"_5":14424,"_27663":53656,"_2970":53941},[],"`subscriber_event_bus`",{"_3487":1386,"_30445":1288,"_21099":53943,"_5":14424,"_27663":53656,"_2970":17766},[],{"_3487":1387,"_30445":1288,"_21099":53945,"_5":14424,"_27663":53656,"_2970":53862},[],{"_3487":1388,"_30445":1288,"_21099":53947,"_5":14424,"_27663":53656,"_2970":53948},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3487":1389,"_30445":1288,"_21099":53950,"_5":14424,"_27663":53656,"_2970":53951},[],"`dms_manager_client`",{"_3487":1390,"_30445":1288,"_21099":53953,"_5":14424,"_27663":53656,"_2970":25195},[],{"_3487":1391,"_30445":1288,"_21099":53955,"_5":14424,"_27663":53656,"_2970":53862},[],{"_3487":1392,"_30445":1288,"_21099":53957,"_5":14424,"_27663":53656,"_2970":53958},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3487":1393,"_30445":1288,"_21099":53960,"_5":14424,"_27663":53656,"_2970":53961},[],"`device_manager_client`",{"_3487":1394,"_30445":1288,"_21099":53963,"_5":14424,"_27663":53656,"_2970":25195},[],{"_3487":1395,"_30445":1288,"_21099":53965,"_5":14424,"_27663":53656,"_2970":53862},[],{"_3487":1396,"_30445":1288,"_21099":53967,"_5":14424,"_27663":53656,"_2970":53968},[],"HTTP URL of Lamassu's Device Manager.",{"_3487":1397,"_30445":1288,"_21099":53970,"_5":14424,"_27663":53656,"_2970":53971},[],"`ca_client`",{"_3487":1398,"_30445":1288,"_21099":53973,"_5":14424,"_27663":53656,"_2970":25195},[],{"_3487":1399,"_30445":1288,"_21099":53975,"_5":14424,"_27663":53656,"_2970":53862},[],{"_3487":1400,"_30445":1288,"_21099":53977,"_5":14424,"_27663":53656,"_2970":53978},[],"HTTP URL of Lamassu's CA service.",{"_3487":1401,"_30445":1288,"_21099":53980,"_5":14424,"_27663":53660,"_2970":53981},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3487":1402,"_30445":1288,"_21099":53983,"_5":14424,"_27663":53660,"_2970":53984},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3487":1403,"_30445":1288,"_21099":53986,"_5":14424,"_27663":53660,"_2970":53987},[],"CloudEvent type",{"_3487":1404,"_30445":1288,"_21099":53989,"_5":14424,"_27663":53660,"_2970":53990},[],"Lamassu resource",{"_3487":1405,"_30445":1288,"_21099":53992,"_5":14424,"_27663":53660,"_2970":53993},[],"AWS Resource",{"_3487":1406,"_30445":1288,"_21099":53995,"_5":14424,"_27663":53660,"_2970":53996},[],"IAM actions",{"_3487":1407,"_30445":1288,"_21099":53998,"_5":14424,"_27663":53660,"_2970":53999},[],"AWS calls and effect",{"_3487":1408,"_30445":1288,"_21099":54001,"_5":14424,"_27663":53660,"_2970":54002},[],"Where in this page",{"_3487":1409,"_30445":1288,"_21099":54004,"_5":14424,"_27663":53660,"_2970":54005},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3487":1410,"_30445":1288,"_21099":54007,"_5":14424,"_27663":53660,"_2970":54008},[],"CA",{"_3487":1411,"_30445":1288,"_21099":54010,"_5":14424,"_27663":53660,"_2970":54011},[],"`IoTCore/CACertificate`",{"_3487":1412,"_30445":1288,"_21099":54013,"_5":14424,"_27663":53660,"_2970":54014},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3487":1413,"_30445":1288,"_21099":54016,"_5":14424,"_27663":53660,"_2970":54017},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3487":1414,"_30445":1288,"_21099":54019,"_5":14424,"_27663":53660,"_2970":53673},[],{"_3487":1415,"_30445":1288,"_21099":54021,"_5":14424,"_27663":53660,"_2970":54022},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3487":1416,"_30445":1288,"_21099":54024,"_5":14424,"_27663":53660,"_2970":54025},[],"DMS",{"_3487":1417,"_30445":1288,"_21099":54027,"_5":14424,"_27663":53660,"_2970":54028},[],"`IoTCore/ProvisioningTemplate`",{"_3487":1418,"_30445":1288,"_21099":54030,"_5":14424,"_27663":53660,"_2970":54031},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3487":1419,"_30445":1288,"_21099":54033,"_5":14424,"_27663":53660,"_2970":54034},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3487":1420,"_30445":1288,"_21099":54036,"_5":14424,"_27663":53660,"_2970":53701},[],{"_3487":1421,"_30445":1288,"_21099":54038,"_5":14424,"_27663":53660,"_2970":54039},[],"`EventBindDeviceIdentityKey`",{"_3487":1422,"_30445":1288,"_21099":54041,"_5":14424,"_27663":53660,"_2970":54042},[],"Device",{"_3487":1423,"_30445":1288,"_21099":54044,"_5":14424,"_27663":53660,"_2970":54045},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3487":1424,"_30445":1288,"_21099":54047,"_5":14424,"_27663":53660,"_2970":54048},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3487":1425,"_30445":1288,"_21099":54050,"_5":14424,"_27663":53660,"_2970":54051},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3487":1426,"_30445":1288,"_21099":54053,"_5":14424,"_27663":53660,"_2970":53709},[],{"_3487":1427,"_30445":1288,"_21099":54055,"_5":14424,"_27663":53660,"_2970":54056},[],"`EventUpdateCertificateStatusKey`",{"_3487":1428,"_30445":1288,"_21099":54058,"_5":14424,"_27663":53660,"_2970":54059},[],"Certificate",{"_3487":1429,"_30445":1288,"_21099":54061,"_5":14424,"_27663":53660,"_2970":54062},[],"`IoTCore/Certificate`",{"_3487":1430,"_30445":1288,"_21099":54064,"_5":14424,"_27663":53660,"_2970":54065},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3487":1431,"_30445":1288,"_21099":54067,"_5":14424,"_27663":53660,"_2970":54068},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3487":1432,"_30445":1288,"_21099":54070,"_5":14424,"_27663":53660,"_2970":53721},[],{"_3487":1433,"_30445":1288,"_21099":54072,"_5":14424,"_27663":53660,"_2970":54073},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3487":1434,"_30445":1288,"_21099":54075,"_5":14424,"_27663":53660,"_2970":54076},[],"Certificate / Device",{"_3487":1435,"_30445":1288,"_21099":54078,"_5":14424,"_27663":53660,"_2970":54079},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3487":1436,"_30445":1288,"_21099":54081,"_5":14424,"_27663":53660,"_2970":50018},[],{"_3487":1437,"_30445":1288,"_21099":54083,"_5":14424,"_27663":53660,"_2970":54084},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3487":1438,"_30445":1288,"_21099":54086,"_5":14424,"_27663":53660,"_2970":53729},[],{"_3487":1439,"_30445":1288,"_21099":54088,"_5":14424,"_27663":53664,"_2970":54089},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3487":1440,"_30445":1288,"_21099":54091,"_5":14424,"_27663":53668,"_2970":54092},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3487":1441,"_30445":1288,"_21099":54094,"_5":14424,"_27663":53668,"_2970":54095},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3487":1442,"_30445":1288,"_21099":54097,"_5":14424,"_27663":53672,"_2970":54098},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3487":1443,"_30445":1288,"_21099":54100,"_5":14424,"_27663":53672,"_2970":54101},[],"Transition",{"_3487":1444,"_30445":1288,"_21099":54103,"_5":14424,"_27663":53672,"_2970":54104},[],"AWS calls",{"_3487":1445,"_30445":1288,"_21099":54106,"_5":14424,"_27663":53672,"_2970":54107},[],"`NotRegistered` → `Requested`",{"_3487":1446,"_30445":1288,"_21099":54109,"_5":14424,"_27663":53672,"_2970":54110},[],"none (metadata write only)",{"_3487":1447,"_30445":1288,"_21099":54112,"_5":14424,"_27663":53672,"_2970":54113},[],"`Requested` → `Registering`",{"_3487":1448,"_30445":1288,"_21099":54115,"_5":14424,"_27663":53672,"_2970":54116},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3487":1449,"_30445":1288,"_21099":54118,"_5":14424,"_27663":53672,"_2970":54119},[],"`Registering` → `Succeeded`",{"_3487":1450,"_30445":1288,"_21099":54121,"_5":14424,"_27663":53672,"_2970":54122},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3487":1451,"_30445":1288,"_21099":54124,"_5":14424,"_27663":53672,"_2970":54125},[],"`Registering` → `Failed`",{"_3487":1452,"_30445":1288,"_21099":54127,"_5":14424,"_27663":53672,"_2970":54128},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3487":1453,"_30445":1288,"_21099":54130,"_5":14424,"_27663":53672,"_2970":54131},[],"`Failed` / `Succeeded` → `Requested`",{"_3487":1454,"_30445":1288,"_21099":54133,"_5":14424,"_27663":53672,"_2970":54134},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3487":1455,"_30445":1288,"_21099":54136,"_5":14424,"_27663":53676,"_2970":54137},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3487":1456,"_30445":1288,"_21099":54139,"_5":14424,"_27663":53676,"_2970":54140},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3487":1457,"_30445":1288,"_21099":54142,"_5":14424,"_27663":53676,"_2970":54143},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3487":1458,"_30445":1288,"_21099":54145,"_5":14424,"_27663":53676,"_2970":54146},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3487":1459,"_30445":1288,"_21099":54148,"_5":14424,"_27663":53676,"_2970":54149},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3487":1460,"_30445":1288,"_21099":54151,"_5":14424,"_27663":53676,"_2970":54152},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3487":1461,"_30445":1288,"_21099":54154,"_5":14424,"_27663":53680,"_2970":54155},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3487":1462,"_30445":1288,"_21099":54157,"_5":14424,"_27663":53684,"_2970":54158},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3487":1463,"_30445":1288,"_21099":54160,"_5":14424,"_27663":53684,"_2970":54161},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3487":1464,"_30445":1288,"_21099":54163,"_5":14424,"_27663":53688,"_2970":54164},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3487":1465,"_30445":1288,"_21099":54166,"_5":14424,"_27663":53692,"_2970":54167},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3487":1466,"_30445":1288,"_21099":54169,"_5":14424,"_27663":53692,"_2970":54170},[],"Creates or updates the IoT policies configured in the DMS.",{"_3487":1467,"_30445":1288,"_21099":54172,"_5":14424,"_27663":53692,"_2970":54173},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3487":1468,"_30445":1288,"_21099":54175,"_5":14424,"_27663":53692,"_2970":54176},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3487":1469,"_30445":1288,"_21099":54178,"_5":14424,"_27663":53692,"_2970":54179},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3487":1470,"_30445":1288,"_21099":54181,"_5":14424,"_27663":53692,"_2970":54182},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3487":1471,"_30445":1288,"_21099":54184,"_5":14424,"_27663":53692,"_2970":54185},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3487":1472,"_30445":1288,"_21099":54187,"_5":14424,"_27663":53696,"_2970":54188},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3487":1473,"_30445":1288,"_21099":54190,"_5":14424,"_27663":53696,"_2970":54191},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3487":1474,"_30445":1288,"_21099":54193,"_5":14424,"_27663":53696,"_2970":54194},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3487":1475,"_30445":1288,"_21099":54196,"_5":14424,"_27663":53696,"_2970":54197},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3487":1476,"_30445":1288,"_21099":54199,"_5":14424,"_27663":53696,"_2970":54200},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3487":1477,"_30445":1288,"_21099":54202,"_5":14424,"_27663":53700,"_2970":54203},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3487":1478,"_30445":1288,"_21099":54205,"_5":14424,"_27663":53700,"_2970":54101},[],{"_3487":1479,"_30445":1288,"_21099":54207,"_5":14424,"_27663":53700,"_2970":54104},[],{"_3487":1480,"_30445":1288,"_21099":54209,"_5":14424,"_27663":53700,"_2970":54210},[],"`Unconfigured` → `None` / `Auto`",{"_3487":1481,"_30445":1288,"_21099":54212,"_5":14424,"_27663":53700,"_2970":54213},[],"none (configuration only)",{"_3487":1482,"_30445":1288,"_21099":54215,"_5":14424,"_27663":53700,"_2970":54216},[],"`None` ↔ `Auto`",{"_3487":1483,"_30445":1288,"_21099":54218,"_5":14424,"_27663":53700,"_2970":54213},[],{"_3487":1484,"_30445":1288,"_21099":54220,"_5":14424,"_27663":53700,"_2970":54221},[],"Any → `Jitp`",{"_3487":1485,"_30445":1288,"_21099":54223,"_5":14424,"_27663":53700,"_2970":54224},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3487":1486,"_30445":1288,"_21099":54226,"_5":14424,"_27663":53700,"_2970":54227},[],"`Jitp` → `None` / `Auto`",{"_3487":1487,"_30445":1288,"_21099":54229,"_5":14424,"_27663":53700,"_2970":54230},[],"none (the template stays in the AWS account)",{"_3487":1488,"_30445":1288,"_21099":54232,"_5":14424,"_27663":53704,"_2970":54233},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3487":1489,"_30445":1288,"_21099":54235,"_5":14424,"_27663":53704,"_2970":54236},[],"The full flow from the device's perspective is:",{"_3487":1490,"_30445":1288,"_21099":54238,"_5":14424,"_27663":53704,"_2970":54239},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3487":1491,"_30445":1288,"_21099":54241,"_5":14424,"_27663":53708,"_2970":54242},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3487":1492,"_30445":1288,"_21099":54244,"_5":14424,"_27663":53708,"_2970":54101},[],{"_3487":1493,"_30445":1288,"_21099":54246,"_5":14424,"_27663":53708,"_2970":54104},[],{"_3487":1494,"_30445":1288,"_21099":54248,"_5":14424,"_27663":53708,"_2970":54249},[],"`Absent` → `Provisioned`",{"_3487":1495,"_30445":1288,"_21099":54251,"_5":14424,"_27663":53708,"_2970":54252},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3487":1496,"_30445":1288,"_21099":54254,"_5":14424,"_27663":53708,"_2970":54255},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3487":1497,"_30445":1288,"_21099":54257,"_5":14424,"_27663":53708,"_2970":54258},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3487":1498,"_30445":1288,"_21099":54260,"_5":14424,"_27663":53708,"_2970":54261},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3487":1499,"_30445":1288,"_21099":54263,"_5":14424,"_27663":53712,"_2970":54264},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3487":1500,"_30445":1288,"_21099":54266,"_5":14424,"_27663":53712,"_2970":54267},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3487":1501,"_30445":1288,"_21099":54269,"_5":14424,"_27663":53712,"_2970":54270},[],"For the JITP flow to work correctly:",{"_3487":1502,"_30445":1288,"_21099":54272,"_5":14424,"_27663":53712,"_2970":54273},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3487":1503,"_30445":1288,"_21099":54275,"_5":14424,"_27663":53712,"_2970":54276},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3487":1504,"_30445":1288,"_21099":54278,"_5":14424,"_27663":53712,"_2970":54279},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3487":1505,"_30445":1288,"_21099":54281,"_5":14424,"_27663":53712,"_2970":54282},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3487":1506,"_30445":1288,"_21099":54284,"_5":14424,"_27663":53716,"_2970":54285},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3487":1507,"_30445":1288,"_21099":54287,"_5":14424,"_27663":53716,"_2970":54288},[],"Status in Lamassu",{"_3487":1508,"_30445":1288,"_21099":54290,"_5":14424,"_27663":53716,"_2970":54291},[],"Revocation reason",{"_3487":1509,"_30445":1288,"_21099":54293,"_5":14424,"_27663":53716,"_2970":54294},[],"Status in AWS IoT Core",{"_3487":1510,"_30445":1288,"_21099":54296,"_5":14424,"_27663":53716,"_2970":54297},[],"`Active`",{"_3487":1511,"_30445":1288,"_21099":54299,"_5":14424,"_27663":53716,"_2970":54300},[],"None",{"_3487":1512,"_30445":1288,"_21099":54302,"_5":14424,"_27663":53716,"_2970":54303},[],"`ACTIVE`",{"_3487":1513,"_30445":1288,"_21099":54305,"_5":14424,"_27663":53716,"_2970":54306},[],"`Revoked`",{"_3487":1514,"_30445":1288,"_21099":54308,"_5":14424,"_27663":53716,"_2970":54309},[],"`certificateHold`",{"_3487":1515,"_30445":1288,"_21099":54311,"_5":14424,"_27663":53716,"_2970":54312},[],"`INACTIVE`",{"_3487":1516,"_30445":1288,"_21099":54314,"_5":14424,"_27663":53716,"_2970":54306},[],{"_3487":1517,"_30445":1288,"_21099":54316,"_5":14424,"_27663":53716,"_2970":54317},[],"Any other reason",{"_3487":1518,"_30445":1288,"_21099":54319,"_5":14424,"_27663":53716,"_2970":54320},[],"`REVOKED`",{"_3487":1519,"_30445":1288,"_21099":54322,"_5":14424,"_27663":53716,"_2970":54323},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3487":1520,"_30445":1288,"_21099":54325,"_5":14424,"_27663":53720,"_2970":54326},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3487":1521,"_30445":1288,"_21099":54328,"_5":14424,"_27663":53720,"_2970":54101},[],{"_3487":1522,"_30445":1288,"_21099":54330,"_5":14424,"_27663":53720,"_2970":54104},[],{"_3487":1523,"_30445":1288,"_21099":54332,"_5":14424,"_27663":53720,"_2970":54333},[],"`NotSynced` → `Active`",{"_3487":1524,"_30445":1288,"_21099":54335,"_5":14424,"_27663":53720,"_2970":53812},[],{"_3487":1525,"_30445":1288,"_21099":54337,"_5":14424,"_27663":53720,"_2970":54338},[],"`Active` → `Inactive`",{"_3487":1526,"_30445":1288,"_21099":54340,"_5":14424,"_27663":53720,"_2970":54341},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3487":1527,"_30445":1288,"_21099":54343,"_5":14424,"_27663":53720,"_2970":54344},[],"`Active` → `Revoked`",{"_3487":1528,"_30445":1288,"_21099":54346,"_5":14424,"_27663":53720,"_2970":54341},[],{"_3487":1529,"_30445":1288,"_21099":54348,"_5":14424,"_27663":53720,"_2970":54349},[],"`Inactive` / `Revoked` → `Active`",{"_3487":1530,"_30445":1288,"_21099":54351,"_5":14424,"_27663":53720,"_2970":53812},[],{"_3487":1531,"_30445":1288,"_21099":54353,"_5":14424,"_27663":53720,"_2970":54354},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3487":1532,"_30445":1288,"_21099":54356,"_5":14424,"_27663":53720,"_2970":54357},[],"none (these states are not synced to AWS)",{"_3487":1533,"_30445":1288,"_21099":54359,"_5":14424,"_27663":53724,"_2970":54360},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3487":1534,"_30445":1288,"_21099":54362,"_5":14424,"_27663":53724,"_2970":54363},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3487":1535,"_30445":1288,"_21099":54365,"_5":14424,"_27663":53724,"_2970":54366},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3487":1536,"_30445":1288,"_21099":54368,"_5":14424,"_27663":53728,"_2970":54369},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3487":1537,"_30445":1288,"_21099":54371,"_5":14424,"_27663":53728,"_2970":54372},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3487":1538,"_30445":1288,"_21099":54374,"_5":14424,"_27663":53732,"_2970":54375},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3487":1539,"_30445":1288,"_21099":54377,"_5":14424,"_27663":53732,"_2970":54378},[],"There are two action types:",{"_3487":1540,"_30445":1288,"_21099":54380,"_5":14424,"_27663":53732,"_2970":54381},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3487":1541,"_30445":1288,"_21099":54383,"_5":14424,"_27663":53732,"_2970":54384},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3487":1542,"_30445":1288,"_21099":54386,"_5":14424,"_27663":53732,"_2970":54387},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3487":1543,"_30445":1288,"_21099":54389,"_5":14424,"_27663":53736,"_2970":54390},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3487":1544,"_30445":1288,"_21099":54392,"_5":14424,"_27663":53736,"_2970":54393},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3487":1545,"_30445":1288,"_21099":54395,"_5":14424,"_27663":53736,"_2970":54396},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3487":1546,"_30445":1288,"_21099":54398,"_5":14424,"_27663":53740,"_2970":54399},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3487":1547,"_30445":1288,"_21099":54401,"_5":14424,"_27663":53740,"_2970":54402},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3487":1548,"_30445":1288,"_21099":54404,"_5":14424,"_27663":53740,"_2970":54405},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3487":1549,"_30445":1288,"_21099":54407,"_5":14424,"_27663":53740,"_2970":54408},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3487":1550,"_30445":1288,"_21099":54410,"_5":14424,"_27663":53740,"_2970":54411},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3487":1551,"_30445":1288,"_21099":54413,"_5":14424,"_27663":53740,"_2970":54414},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3487":1552,"_30445":1288,"_21099":54416,"_5":14424,"_27663":53740,"_2970":54417},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3487":1553,"_30445":1288,"_21099":54419,"_5":14424,"_27663":53740,"_2970":54420},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3487":1554,"_30445":1288,"_21099":54422,"_5":14424,"_27663":53740,"_2970":54423},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3487":1555,"_30445":1288,"_21099":54425,"_5":14424,"_27663":53740,"_2970":54426},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3487":1556,"_30445":1288,"_21099":54428,"_5":14424,"_27663":53740,"_2970":54429},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3487":1557,"_30445":1288,"_21099":54431,"_5":14424,"_27663":53740,"_2970":54432},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3487":1558,"_30445":1288,"_21099":54434,"_5":14424,"_27663":53740,"_2970":54435},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3487":1559,"_30445":1288,"_21099":54437,"_5":14424,"_27663":53740,"_2970":54438},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3487":1560,"_30445":1288,"_21099":54440,"_5":14424,"_27663":53740,"_2970":54441},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3487":1561,"_30445":1288,"_21099":54443,"_5":14424,"_27663":53740,"_2970":54444},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3487":1562,"_30445":1288,"_21099":54446,"_5":14424,"_27663":53740,"_2970":54447},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3487":1563,"_30445":1288,"_21099":54449,"_5":14424,"_27663":53740,"_2970":54450},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3487":1564,"_30445":1288,"_21099":54452,"_5":14424,"_27663":53740,"_2970":54453},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3487":1565,"_30445":1288,"_21099":54455,"_5":14424,"_27663":53740,"_2970":54456},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3487":1566,"_30445":1288,"_21099":54458,"_5":14424,"_27663":53740,"_2970":54459},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3487":1567,"_30445":1288,"_21099":54461,"_5":14424,"_27663":53740,"_2970":54462},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3487":1568,"_30445":1288,"_21099":54464,"_5":14424,"_27663":53740,"_2970":54465},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3487":1569,"_30445":1288,"_21099":54467,"_5":14424,"_27663":53740,"_2970":54468},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3487":1570,"_30445":1570,"_5":14788,"_2970":52175,"_30797":54470,"_21099":54471,"_27663":1570},[49622,51161,52175],[],{"_3487":1571,"_30445":1570,"_21099":54473,"_5":14424,"_27663":1570,"_2970":54474},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3487":1572,"_30445":1570,"_5":30794,"_21099":54476,"_27663":54477,"_2970":54478},[],"/docs/pr-preview/pr-68/platform/iot-fleets/overview#start-here","Start here",{"_3487":1573,"_30445":1570,"_5":30794,"_21099":54480,"_27663":54481,"_2970":52173},[],"/docs/pr-preview/pr-68/platform/iot-fleets/overview#devices-and-identities",{"_3487":1574,"_30445":1570,"_5":30794,"_21099":54483,"_27663":54484,"_2970":52356},[],"/docs/pr-preview/pr-68/platform/iot-fleets/overview#enrollment-with-pki",{"_3487":1575,"_30445":1570,"_5":30794,"_21099":54486,"_27663":54487,"_2970":53637},[],"/docs/pr-preview/pr-68/platform/iot-fleets/overview#integrations",{"_3487":1576,"_30445":1570,"_5":30794,"_21099":54489,"_27663":54490,"_2970":54491},[],"/docs/pr-preview/pr-68/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3487":1577,"_30445":1570,"_21099":54493,"_5":14424,"_27663":1570,"_2970":54494},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3487":1578,"_30445":1570,"_21099":54496,"_5":14424,"_27663":54477,"_2970":54497},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3487":1579,"_30445":1570,"_21099":54499,"_5":14424,"_27663":54477,"_2970":54500},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3487":1580,"_30445":1570,"_21099":54502,"_5":14424,"_27663":54481,"_2970":54503},[],"Resource",{"_3487":1581,"_30445":1570,"_21099":54505,"_5":14424,"_27663":54481,"_2970":54506},[],"What it represents",{"_3487":1582,"_30445":1570,"_21099":54508,"_5":14424,"_27663":54481,"_2970":54509},[],"**Device**",{"_3487":1583,"_30445":1570,"_21099":54511,"_5":14424,"_27663":54481,"_2970":54512},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3487":1584,"_30445":1570,"_21099":54514,"_5":14424,"_27663":54481,"_2970":54515},[],"**Identity**",{"_3487":1585,"_30445":1570,"_21099":54517,"_5":14424,"_27663":54481,"_2970":54518},[],"The device's association with its certificates: an active version and a history.",{"_3487":1586,"_30445":1570,"_21099":54520,"_5":14424,"_27663":54481,"_2970":54521},[],"**DMS**",{"_3487":1587,"_30445":1570,"_21099":54523,"_5":14424,"_27663":54481,"_2970":54524},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3487":1588,"_30445":1570,"_21099":54526,"_5":14424,"_27663":54481,"_2970":54527},[],"**Fleet**",{"_3487":1589,"_30445":1570,"_21099":54529,"_5":14424,"_27663":54481,"_2970":54530},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3487":1590,"_30445":1570,"_21099":54532,"_5":14424,"_27663":54481,"_2970":54533},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3487":1591,"_30445":1570,"_21099":54535,"_5":14424,"_27663":54481,"_2970":54536},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3487":1592,"_30445":1570,"_21099":54538,"_5":14424,"_27663":54484,"_2970":54539},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3487":1593,"_30445":1570,"_21099":54541,"_5":14424,"_27663":54484,"_2970":54542},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3487":1594,"_30445":1570,"_21099":54544,"_5":14424,"_27663":54484,"_2970":54545},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3487":1595,"_30445":1570,"_21099":54547,"_5":14424,"_27663":54484,"_2970":54548},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3487":1596,"_30445":1570,"_21099":54550,"_5":14424,"_27663":54484,"_2970":54551},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3487":1597,"_30445":1570,"_21099":54553,"_5":14424,"_27663":54484,"_2970":54554},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3487":1598,"_30445":1570,"_21099":54556,"_5":14424,"_27663":54484,"_2970":54557},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3487":1599,"_30445":1570,"_21099":54559,"_5":14424,"_27663":54484,"_2970":54560},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3487":1600,"_30445":1570,"_21099":54562,"_5":14424,"_27663":54487,"_2970":54563},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3487":1601,"_30445":1570,"_21099":54565,"_5":14424,"_27663":54487,"_2970":54566},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3487":1602,"_30445":1570,"_21099":54568,"_5":14424,"_27663":54490,"_2970":54569},[],"Participant",{"_3487":1603,"_30445":1570,"_21099":54571,"_5":14424,"_27663":54490,"_2970":54572},[],"Responsibility",{"_3487":1604,"_30445":1570,"_21099":54574,"_5":14424,"_27663":54490,"_2970":54575},[],"PKI administrator",{"_3487":1605,"_30445":1570,"_21099":54577,"_5":14424,"_27663":54490,"_2970":54578},[],"CA, issuance profile, chain and revocation publication.",{"_3487":1606,"_30445":1570,"_21099":54580,"_5":14424,"_27663":54490,"_2970":54581},[],"Provisioning administrator",{"_3487":1607,"_30445":1570,"_21099":54583,"_5":14424,"_27663":54490,"_2970":54584},[],"DMS, admission, authentication per operation and inventory.",{"_3487":1608,"_30445":1570,"_21099":54586,"_5":14424,"_27663":54490,"_2970":54587},[],"Device integrator",{"_3487":1609,"_30445":1570,"_21099":54589,"_5":14424,"_27663":54490,"_2970":54590},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3487":1610,"_30445":1570,"_21099":54592,"_5":14424,"_27663":54490,"_2970":54593},[],"Consumer integrator",{"_3487":1611,"_30445":1570,"_21099":54595,"_5":14424,"_27663":54490,"_2970":54596},[],"Trusted issuers, validation and device permissions in the destination.",{"_3487":1612,"_30445":1570,"_21099":54598,"_5":14424,"_27663":54490,"_2970":54599},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3487":1613,"_30445":1613,"_5":14788,"_2970":54601,"_30797":54602,"_21099":54604,"_27663":1613},"Enroll and connect your first device",[49622,51161,52175,54603],"Getting started",[],{"_3487":1614,"_30445":1613,"_21099":54606,"_5":14424,"_27663":1613,"_2970":54607},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3487":1615,"_30445":1613,"_5":30794,"_21099":54609,"_27663":54610,"_2970":49632},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3487":1616,"_30445":1613,"_5":30794,"_21099":54612,"_27663":54613,"_2970":54614},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3487":1617,"_30445":1613,"_5":30794,"_21099":54616,"_27663":54617,"_2970":54618},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3487":1618,"_30445":1613,"_5":30794,"_21099":54620,"_27663":54621,"_2970":54622},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3487":1619,"_30445":1613,"_5":30794,"_21099":54624,"_27663":54625,"_2970":54626},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3487":1620,"_30445":1613,"_5":30794,"_21099":54628,"_27663":54629,"_2970":54630},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3487":1621,"_30445":1613,"_5":30794,"_21099":54632,"_27663":54633,"_2970":54634},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3487":1622,"_30445":1613,"_5":30794,"_21099":54636,"_27663":54637,"_2970":54638},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3487":1623,"_30445":1613,"_21099":54640,"_5":14424,"_27663":1613,"_2970":54641},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3487":1624,"_30445":1613,"_21099":54643,"_5":14424,"_27663":54610,"_2970":54644},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3487":1625,"_30445":1613,"_21099":54646,"_5":14424,"_27663":54610,"_2970":54647},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3487":1626,"_30445":1613,"_21099":54649,"_5":14424,"_27663":54610,"_2970":54650},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3487":1627,"_30445":1613,"_21099":54652,"_5":14424,"_27663":54610,"_2970":54653},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3487":1628,"_30445":1613,"_21099":54655,"_5":14424,"_27663":54610,"_2970":54656},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3487":1629,"_30445":1613,"_21099":54658,"_5":14424,"_27663":54613,"_2970":54659},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3487":1630,"_30445":1613,"_21099":54661,"_5":14424,"_27663":54613,"_2970":54662},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3487":1631,"_30445":1613,"_21099":54664,"_5":14424,"_27663":54617,"_2970":54665},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3487":1632,"_30445":1613,"_21099":54667,"_5":14424,"_27663":54617,"_2970":54668},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3487":1633,"_30445":1613,"_21099":54670,"_5":14424,"_27663":54617,"_2970":54671},[],"Setting",{"_3487":1634,"_30445":1613,"_21099":54673,"_5":14424,"_27663":54617,"_2970":54674},[],"Evaluation value",{"_3487":1635,"_30445":1613,"_21099":54676,"_5":14424,"_27663":54617,"_2970":54677},[],"Enrollment CA",{"_3487":1636,"_30445":1613,"_21099":54679,"_5":14424,"_27663":54617,"_2970":54680},[],"Issuing root from `device-root.pem`.",{"_3487":1637,"_30445":1613,"_21099":54682,"_5":14424,"_27663":54617,"_2970":52486},[],{"_3487":1638,"_30445":1613,"_21099":54684,"_5":14424,"_27663":54617,"_2970":54685},[],"The 1-hour leaf profile you just prepared.",{"_3487":1639,"_30445":1613,"_21099":54687,"_5":14424,"_27663":54617,"_2970":54688},[],"Protocol / Registration Mode",{"_3487":1640,"_30445":1613,"_21099":54690,"_5":14424,"_27663":54617,"_2970":54691},[],"`EST_RFC7030` / `JITP`.",{"_3487":1641,"_30445":1613,"_21099":54693,"_5":14424,"_27663":54617,"_2970":54694},[],"Verify CSR Signature",{"_3487":1642,"_30445":1613,"_21099":54696,"_5":14424,"_27663":54617,"_2970":54697},[],"Enabled.",{"_3487":1643,"_30445":1613,"_21099":54699,"_5":14424,"_27663":54617,"_2970":54700},[],"Enable Replaceable Enrollment",{"_3487":1644,"_30445":1613,"_21099":54702,"_5":14424,"_27663":54617,"_2970":54703},[],"Disabled; the ID must be new.",{"_3487":1645,"_30445":1613,"_21099":54705,"_5":14424,"_27663":54617,"_2970":54706},[],"Initial authentication",{"_3487":1646,"_30445":1613,"_21099":54708,"_5":14424,"_27663":54617,"_2970":54709},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3487":1647,"_30445":1613,"_21099":54711,"_5":14424,"_27663":54617,"_2970":54712},[],"Renewal authentication",{"_3487":1648,"_30445":1613,"_21099":54714,"_5":14424,"_27663":54617,"_2970":54715},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3487":1649,"_30445":1613,"_21099":54717,"_5":14424,"_27663":54617,"_2970":54718},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3487":1650,"_30445":1613,"_21099":54720,"_5":14424,"_27663":54617,"_2970":54721},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3487":1651,"_30445":1613,"_21099":54723,"_5":14424,"_27663":54617,"_2970":54724},[],"Re-enrollment Delta",{"_3487":1652,"_30445":1613,"_21099":54726,"_5":14424,"_27663":54617,"_2970":54727},[],"1 hour.",{"_3487":1653,"_30445":1613,"_21099":54729,"_5":14424,"_27663":54617,"_2970":54730},[],"Preventive / Critical Delta",{"_3487":1654,"_30445":1613,"_21099":54732,"_5":14424,"_27663":54617,"_2970":54733},[],"30 minutes / 10 minutes.",{"_3487":1655,"_30445":1613,"_21099":54735,"_5":14424,"_27663":54617,"_2970":54736},[],"Revoke on Re-enrollment",{"_3487":1656,"_30445":1613,"_21099":54738,"_5":14424,"_27663":54617,"_2970":54739},[],"Disabled to test the successor before retiring the previous identity.",{"_3487":1657,"_30445":1613,"_21099":54741,"_5":14424,"_27663":54617,"_2970":52494},[],{"_3487":1658,"_30445":1613,"_21099":54743,"_5":14424,"_27663":54617,"_2970":54744},[],"Disabled; the operational key is generated in the client.",{"_3487":1659,"_30445":1613,"_21099":54746,"_5":14424,"_27663":54617,"_2970":54747},[],"CA Distribution",{"_3487":1660,"_30445":1613,"_21099":54749,"_5":14424,"_27663":54617,"_2970":54750},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3487":1661,"_30445":1613,"_21099":54752,"_5":14424,"_27663":54617,"_2970":54753},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3487":1662,"_30445":1613,"_21099":54755,"_5":14424,"_27663":54621,"_2970":54756},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3487":1663,"_30445":1613,"_21099":54758,"_5":14424,"_27663":54621,"_2970":54759},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3487":1664,"_30445":1613,"_21099":54761,"_5":14424,"_27663":54625,"_2970":54762},[],"Generate a new key and CSR with the selected identifier:",{"_3487":1665,"_30445":1613,"_21099":54764,"_5":14424,"_27663":54625,"_2970":54765},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3487":1666,"_30445":1613,"_21099":54767,"_5":14424,"_27663":54625,"_2970":54768},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3487":1667,"_30445":1613,"_21099":54770,"_5":14424,"_27663":54629,"_2970":54771},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3487":1668,"_30445":1613,"_21099":54773,"_5":14424,"_27663":54629,"_2970":54774},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3487":1669,"_30445":1613,"_21099":54776,"_5":14424,"_27663":54633,"_2970":54777},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3487":1670,"_30445":1613,"_21099":54779,"_5":14424,"_27663":54633,"_2970":54780},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3487":1671,"_30445":1613,"_21099":54782,"_5":14424,"_27663":54633,"_2970":54783},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3487":1672,"_30445":1613,"_21099":54785,"_5":14424,"_27663":54633,"_2970":54786},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3487":1673,"_30445":1613,"_21099":54788,"_5":14424,"_27663":54633,"_2970":54789},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3487":1674,"_30445":1613,"_21099":54791,"_5":14424,"_27663":54637,"_2970":54792},[],"Check",{"_3487":1675,"_30445":1613,"_21099":54794,"_5":14424,"_27663":54637,"_2970":54795},[],"Expected result",{"_3487":1676,"_30445":1613,"_21099":54797,"_5":14424,"_27663":54637,"_2970":54798},[],"Registration",{"_3487":1677,"_30445":1613,"_21099":54800,"_5":14424,"_27663":54637,"_2970":54801},[],"ID created automatically and correct DMS.",{"_3487":1678,"_30445":1613,"_21099":54803,"_5":14424,"_27663":54637,"_2970":54059},[],{"_3487":1679,"_30445":1613,"_21099":54805,"_5":14424,"_27663":54637,"_2970":54806},[],"CN, profile, serial and key verified.",{"_3487":1680,"_30445":1613,"_21099":54808,"_5":14424,"_27663":54637,"_2970":54809},[],"Inventory",{"_3487":1681,"_30445":1613,"_21099":54811,"_5":14424,"_27663":54637,"_2970":54812},[],"Received serial visible as the current identity and in history.",{"_3487":1682,"_30445":1613,"_21099":54814,"_5":14424,"_27663":54637,"_2970":54815},[],"Consumer",{"_3487":1683,"_30445":1613,"_21099":54817,"_5":14424,"_27663":54637,"_2970":54818},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3487":1684,"_30445":1613,"_21099":54820,"_5":14424,"_27663":54637,"_2970":54821},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3487":1685,"_30445":1613,"_21099":54823,"_5":14424,"_27663":54637,"_2970":54824},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3487":1686,"_30445":1686,"_5":14788,"_2970":52191,"_30797":54826,"_21099":54827,"_27663":1686},[49622,51161,52175,54603],[],{"_3487":1687,"_30445":1686,"_21099":54829,"_5":14424,"_27663":1686,"_2970":54830},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3487":1688,"_30445":1686,"_5":30794,"_21099":54832,"_27663":54833,"_2970":49632},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3487":1689,"_30445":1686,"_5":30794,"_21099":54835,"_27663":54836,"_2970":54837},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3487":1690,"_30445":1686,"_5":30794,"_21099":54839,"_27663":54840,"_2970":54841},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3487":1691,"_30445":1686,"_5":30794,"_21099":54843,"_27663":54844,"_2970":54845},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3487":1692,"_30445":1686,"_5":30794,"_21099":54847,"_27663":54848,"_2970":54849},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3487":1693,"_30445":1686,"_5":30794,"_21099":54851,"_27663":54852,"_2970":54853},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3487":1694,"_30445":1686,"_5":30794,"_21099":54855,"_27663":54856,"_2970":54795},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3487":1695,"_30445":1686,"_5":30794,"_21099":54858,"_27663":54859,"_2970":54860},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3487":1696,"_30445":1686,"_5":30794,"_21099":54862,"_27663":54863,"_2970":54864},[],"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3487":1697,"_30445":1686,"_21099":54866,"_5":14424,"_27663":1686,"_2970":54867},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3487":1698,"_30445":1686,"_21099":54869,"_5":14424,"_27663":1686,"_2970":54870},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3487":1699,"_30445":1686,"_21099":54872,"_5":14424,"_27663":54833,"_2970":54873},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3487":1700,"_30445":1686,"_21099":54875,"_5":14424,"_27663":54833,"_2970":54876},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3487":1701,"_30445":1686,"_21099":54878,"_5":14424,"_27663":54833,"_2970":54879},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3487":1702,"_30445":1686,"_21099":54881,"_5":14424,"_27663":54833,"_2970":54882},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3487":1703,"_30445":1686,"_21099":54884,"_5":14424,"_27663":54836,"_2970":54885},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3487":1704,"_30445":1686,"_21099":54887,"_5":14424,"_27663":54836,"_2970":54888},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3487":1705,"_30445":1686,"_21099":54890,"_5":14424,"_27663":54836,"_2970":54891},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3487":1706,"_30445":1686,"_21099":54893,"_5":14424,"_27663":54836,"_2970":54894},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3487":1707,"_30445":1686,"_21099":54896,"_5":14424,"_27663":54836,"_2970":54897},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3487":1708,"_30445":1686,"_21099":54899,"_5":14424,"_27663":54836,"_2970":54900},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3487":1709,"_30445":1686,"_21099":54902,"_5":14424,"_27663":54836,"_2970":54903},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3487":1710,"_30445":1686,"_21099":54905,"_5":14424,"_27663":54836,"_2970":54906},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3487":1711,"_30445":1686,"_21099":54908,"_5":14424,"_27663":54840,"_2970":54909},[],"Open **Managed Devices** and the registration action. Complete:",{"_3487":1712,"_30445":1686,"_21099":54911,"_5":14424,"_27663":54840,"_2970":54912},[],"**Device ID**: `device-001`.",{"_3487":1713,"_30445":1686,"_21099":54914,"_5":14424,"_27663":54840,"_2970":54915},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3487":1714,"_30445":1686,"_21099":54917,"_5":14424,"_27663":54840,"_2970":54918},[],"**Icon** and **Tags**: optional classification.",{"_3487":1715,"_30445":1686,"_21099":54920,"_5":14424,"_27663":54840,"_2970":54921},[],"Confirm registration.",{"_3487":1716,"_30445":1686,"_21099":54923,"_5":14424,"_27663":54844,"_2970":54924},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3487":1717,"_30445":1686,"_21099":54926,"_5":14424,"_27663":54844,"_2970":54927},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3487":1718,"_30445":1686,"_21099":54929,"_5":14424,"_27663":54848,"_2970":54930},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3487":1719,"_30445":1686,"_21099":54932,"_5":14424,"_27663":54848,"_2970":54933},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3487":1720,"_30445":1686,"_21099":54935,"_5":14424,"_27663":54852,"_2970":54936},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3487":1721,"_30445":1686,"_21099":54938,"_5":14424,"_27663":54852,"_2970":54939},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3487":1722,"_30445":1686,"_21099":54941,"_5":14424,"_27663":54856,"_2970":54792},[],{"_3487":1723,"_30445":1686,"_21099":54943,"_5":14424,"_27663":54856,"_2970":54944},[],"Result",{"_3487":1724,"_30445":1686,"_21099":54946,"_5":14424,"_27663":54856,"_2970":54042},[],{"_3487":1725,"_30445":1686,"_21099":54948,"_5":14424,"_27663":54856,"_2970":54949},[],"`device-001` appears in inventory with the expected DMS.",{"_3487":1726,"_30445":1686,"_21099":54951,"_5":14424,"_27663":54856,"_2970":54952},[],"Current identity",{"_3487":1727,"_30445":1686,"_21099":54954,"_5":14424,"_27663":54856,"_2970":54955},[],"The associated certificate matches the one you verified in PKI.",{"_3487":1728,"_30445":1686,"_21099":54957,"_5":14424,"_27663":54856,"_2970":54958},[],"History",{"_3487":1729,"_30445":1686,"_21099":54960,"_5":14424,"_27663":54856,"_2970":54961},[],"The associated issuance appears with its serial number and dates.",{"_3487":1730,"_30445":1686,"_21099":54963,"_5":14424,"_27663":54856,"_2970":54964},[],"Key and certificate",{"_3487":1731,"_30445":1686,"_21099":54966,"_5":14424,"_27663":54856,"_2970":54967},[],"You have the verified pair ready to install on the device.",{"_3487":1732,"_30445":1686,"_21099":54969,"_5":14424,"_27663":54859,"_2970":54970},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3487":1733,"_30445":1686,"_21099":54972,"_5":14424,"_27663":54859,"_2970":54973},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3487":1734,"_30445":1686,"_21099":54975,"_5":14424,"_27663":54859,"_2970":54976},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3487":1735,"_30445":1686,"_21099":54978,"_5":14424,"_27663":54859,"_2970":54979},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3487":1736,"_30445":1686,"_21099":54981,"_5":14424,"_27663":54863,"_2970":54982},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3487":1737,"_30445":1686,"_21099":54984,"_5":14424,"_27663":54863,"_2970":54985},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3487":1738,"_30445":1686,"_21099":54987,"_5":14424,"_27663":54863,"_2970":54988},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3487":1739,"_30445":1739,"_5":14788,"_2970":54990,"_30797":54991,"_21099":54992,"_27663":1739},"Lamassu IoT Platform",[49622,51161],[],{"_3487":1740,"_30445":1739,"_21099":54994,"_5":14424,"_27663":1739,"_2970":54995},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3487":1741,"_30445":1739,"_5":30794,"_21099":54997,"_27663":54998,"_2970":54478},[],"/docs/pr-preview/pr-68/platform/overview#start-here",{"_3487":1742,"_30445":1739,"_5":30794,"_21099":55000,"_27663":55001,"_2970":55002},[],"/docs/pr-preview/pr-68/platform/overview#choose-your-path","Choose your path",{"_3487":1743,"_30445":1739,"_5":30794,"_21099":55004,"_27663":55005,"_2970":55006},[],"/docs/pr-preview/pr-68/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3487":1744,"_30445":1739,"_5":30794,"_21099":55008,"_27663":55009,"_2970":55010},[],"/docs/pr-preview/pr-68/platform/overview#core-capabilities","Core capabilities",{"_3487":1745,"_30445":1739,"_5":30794,"_21099":55012,"_27663":55013,"_2970":55014},[],"/docs/pr-preview/pr-68/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3487":1746,"_30445":1739,"_5":30794,"_21099":55016,"_27663":55017,"_2970":55018},[],"/docs/pr-preview/pr-68/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3487":1747,"_30445":1739,"_5":30794,"_21099":55020,"_27663":55021,"_2970":55022},[],"/docs/pr-preview/pr-68/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3487":1748,"_30445":1739,"_5":30794,"_21099":55024,"_27663":55025,"_2970":55026},[],"/docs/pr-preview/pr-68/platform/overview#automate-device-identities","Automate device identities",{"_3487":1749,"_30445":1739,"_5":30794,"_21099":55028,"_27663":55029,"_2970":55030},[],"/docs/pr-preview/pr-68/platform/overview#publish-validation-status","Publish validation status",{"_3487":1750,"_30445":1739,"_5":30794,"_21099":55032,"_27663":55033,"_2970":55034},[],"/docs/pr-preview/pr-68/platform/overview#react-to-events","React to events",{"_3487":1751,"_30445":1739,"_5":30794,"_21099":55036,"_27663":55037,"_2970":55038},[],"/docs/pr-preview/pr-68/platform/overview#operational-reference","Operational reference",{"_3487":1752,"_30445":1739,"_21099":55040,"_5":14424,"_27663":1739,"_2970":55041},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3487":1753,"_30445":1739,"_21099":55043,"_5":14424,"_27663":54998,"_2970":55044},[],"Choose the result you need:",{"_3487":1754,"_30445":1739,"_21099":55046,"_5":14424,"_27663":54998,"_2970":55047},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3487":1755,"_30445":1739,"_21099":55049,"_5":14424,"_27663":54998,"_2970":55050},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3487":1756,"_30445":1739,"_21099":55052,"_5":14424,"_27663":54998,"_2970":55053},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3487":1757,"_30445":1739,"_21099":55055,"_5":14424,"_27663":55001,"_2970":55056},[],"Section",{"_3487":1758,"_30445":1739,"_21099":55058,"_5":14424,"_27663":55001,"_2970":55059},[],"What you manage",{"_3487":1759,"_30445":1739,"_21099":55061,"_5":14424,"_27663":55001,"_2970":55062},[],"Entry point",{"_3487":1760,"_30445":1739,"_21099":55064,"_5":14424,"_27663":55001,"_2970":55065},[],"**PKI**",{"_3487":1761,"_30445":1739,"_21099":55067,"_5":14424,"_27663":55001,"_2970":55068},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3487":1762,"_30445":1739,"_21099":55070,"_5":14424,"_27663":55001,"_2970":55071},[],"PKI overview",{"_3487":1763,"_30445":1739,"_21099":55073,"_5":14424,"_27663":55001,"_2970":55074},[],"**IoT Fleets**",{"_3487":1764,"_30445":1739,"_21099":55076,"_5":14424,"_27663":55001,"_2970":55077},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3487":1765,"_30445":1739,"_21099":55079,"_5":14424,"_27663":55001,"_2970":55080},[],"IoT Fleets overview",{"_3487":1766,"_30445":1739,"_21099":55082,"_5":14424,"_27663":55001,"_2970":55083},[],"**Administration**",{"_3487":1767,"_30445":1739,"_21099":55085,"_5":14424,"_27663":55001,"_2970":55086},[],"Operator permissions, audit and event subscriptions.",{"_3487":1768,"_30445":1739,"_21099":55088,"_5":14424,"_27663":55001,"_2970":51159},[],{"_3487":1769,"_30445":1739,"_21099":55090,"_5":14424,"_27663":55001,"_2970":55091},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3487":1770,"_30445":1739,"_21099":55093,"_5":14424,"_27663":55005,"_2970":55094},[],"An identity's journey connects four responsibilities:",{"_3487":1771,"_30445":1739,"_21099":55096,"_5":14424,"_27663":55005,"_2970":55097},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3487":1772,"_30445":1739,"_21099":55099,"_5":14424,"_27663":55005,"_2970":55100},[],"The provisioning administrator configures the DMS and initial trust.",{"_3487":1773,"_30445":1739,"_21099":55102,"_5":14424,"_27663":55005,"_2970":55103},[],"The device client requests a certificate and installs it with the matching key.",{"_3487":1774,"_30445":1739,"_21099":55105,"_5":14424,"_27663":55005,"_2970":55106},[],"The consumer validates the identity and applies its access permissions.",{"_3487":1775,"_30445":1739,"_21099":55108,"_5":14424,"_27663":55005,"_2970":55109},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3487":1776,"_30445":1739,"_21099":55111,"_5":14424,"_27663":55013,"_2970":55112},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3487":1777,"_30445":1739,"_21099":55114,"_5":14424,"_27663":55017,"_2970":55115},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3487":1778,"_30445":1739,"_21099":55117,"_5":14424,"_27663":55021,"_2970":55118},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3487":1779,"_30445":1739,"_21099":55120,"_5":14424,"_27663":55025,"_2970":55121},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3487":1780,"_30445":1739,"_21099":55123,"_5":14424,"_27663":55029,"_2970":55124},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3487":1781,"_30445":1739,"_21099":55126,"_5":14424,"_27663":55033,"_2970":55127},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3487":1782,"_30445":1739,"_21099":55129,"_5":14424,"_27663":55037,"_2970":54572},[],{"_3487":1783,"_30445":1739,"_21099":55131,"_5":14424,"_27663":55037,"_2970":55132},[],"What it prepares or checks",{"_3487":1784,"_30445":1739,"_21099":55134,"_5":14424,"_27663":55037,"_2970":54575},[],{"_3487":1785,"_30445":1739,"_21099":55136,"_5":14424,"_27663":55037,"_2970":55137},[],"Key custody, CA hierarchy, profiles and validation.",{"_3487":1786,"_30445":1739,"_21099":55139,"_5":14424,"_27663":55037,"_2970":55140},[],"Fleet administrator",{"_3487":1787,"_30445":1739,"_21099":55142,"_5":14424,"_27663":55037,"_2970":55143},[],"DMS, device admission, renewal policy and inventory.",{"_3487":1788,"_30445":1739,"_21099":55145,"_5":14424,"_27663":55037,"_2970":54587},[],{"_3487":1789,"_30445":1739,"_21099":55147,"_5":14424,"_27663":55037,"_2970":55148},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3487":1790,"_30445":1739,"_21099":55150,"_5":14424,"_27663":55037,"_2970":54593},[],{"_3487":1791,"_30445":1739,"_21099":55152,"_5":14424,"_27663":55037,"_2970":55153},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3487":1792,"_30445":1739,"_21099":55155,"_5":14424,"_27663":55037,"_2970":55156},[],"Infrastructure operator",{"_3487":1793,"_30445":1739,"_21099":55158,"_5":14424,"_27663":55037,"_2970":55159},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3487":1794,"_30445":1739,"_21099":55161,"_5":14424,"_27663":55037,"_2970":55162},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3487":1795,"_30445":1795,"_5":14788,"_2970":55164,"_30797":55165,"_21099":55168,"_27663":1795},"CA hierarchy and rotation",[49622,51161,55166,55167],"PKI","Keys, authorities and certificates",[],{"_3487":1796,"_30445":1795,"_21099":55170,"_5":14424,"_27663":1795,"_2970":55171},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3487":1797,"_30445":1795,"_5":30794,"_21099":55173,"_27663":55174,"_2970":55175},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3487":1798,"_30445":1795,"_5":30794,"_21099":55177,"_27663":55178,"_2970":55179},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3487":1799,"_30445":1795,"_5":30794,"_21099":55181,"_27663":55182,"_2970":55183},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3487":1800,"_30445":1795,"_5":30794,"_21099":55185,"_27663":55186,"_2970":55187},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3487":1801,"_30445":1795,"_5":30794,"_21099":55189,"_27663":55190,"_2970":55191},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3487":1802,"_30445":1795,"_5":30794,"_21099":55193,"_27663":55194,"_2970":55195},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3487":1803,"_30445":1795,"_5":30794,"_21099":55197,"_27663":55198,"_2970":55199},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3487":1804,"_30445":1795,"_5":30794,"_21099":55201,"_27663":55202,"_2970":55203},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3487":1805,"_30445":1795,"_5":30794,"_21099":55205,"_27663":55206,"_2970":55207},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3487":1806,"_30445":1795,"_5":30794,"_21099":55209,"_27663":55210,"_2970":55211},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3487":1807,"_30445":1795,"_5":30794,"_21099":55213,"_27663":55214,"_2970":55215},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3487":1808,"_30445":1795,"_5":30794,"_21099":55217,"_27663":55218,"_2970":55219},[],"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3487":1809,"_30445":1795,"_21099":55221,"_5":14424,"_27663":1795,"_2970":55222},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3487":1810,"_30445":1795,"_21099":55224,"_5":14424,"_27663":1795,"_2970":55225},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3487":1811,"_30445":1795,"_21099":55227,"_5":14424,"_27663":55174,"_2970":55228},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3487":1812,"_30445":1795,"_21099":55230,"_5":14424,"_27663":55174,"_2970":55231},[],"environment, such as production and preproduction;",{"_3487":1813,"_30445":1795,"_21099":55233,"_5":14424,"_27663":55174,"_2970":55234},[],"owner or operating team;",{"_3487":1814,"_30445":1795,"_21099":55236,"_5":14424,"_27663":55174,"_2970":55237},[],"device family or manufacturing process;",{"_3487":1815,"_30445":1795,"_21099":55239,"_5":14424,"_27663":55174,"_2970":55240},[],"region or regulatory requirement;",{"_3487":1816,"_30445":1795,"_21099":55242,"_5":14424,"_27663":55174,"_2970":55243},[],"cryptographic engine or key policy;",{"_3487":1817,"_30445":1795,"_21099":55245,"_5":14424,"_27663":55174,"_2970":55246},[],"maintenance window and renewal cadence.",{"_3487":1818,"_30445":1795,"_21099":55248,"_5":14424,"_27663":55174,"_2970":55249},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3487":1819,"_30445":1795,"_21099":55251,"_5":14424,"_27663":55174,"_2970":55252},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3487":1820,"_30445":1795,"_21099":55254,"_5":14424,"_27663":55178,"_2970":55255},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3487":1821,"_30445":1795,"_21099":55257,"_5":14424,"_27663":55178,"_2970":55258},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3487":1822,"_30445":1795,"_21099":55260,"_5":14424,"_27663":55178,"_2970":55261},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3487":1823,"_30445":1795,"_21099":55263,"_5":14424,"_27663":55178,"_2970":55264},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3487":1824,"_30445":1795,"_21099":55266,"_5":14424,"_27663":55182,"_2970":55267},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3487":1825,"_30445":1795,"_21099":55269,"_5":14424,"_27663":55182,"_2970":55270},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3487":1826,"_30445":1795,"_21099":55272,"_5":14424,"_27663":55182,"_2970":55273},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3487":1827,"_30445":1795,"_21099":55275,"_5":14424,"_27663":55182,"_2970":55276},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3487":1828,"_30445":1795,"_21099":55278,"_5":14424,"_27663":55190,"_2970":55279},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3487":1829,"_30445":1795,"_21099":55281,"_5":14424,"_27663":55194,"_2970":55282},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3487":1830,"_30445":1795,"_21099":55284,"_5":14424,"_27663":55198,"_2970":55285},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3487":1831,"_30445":1795,"_21099":55287,"_5":14424,"_27663":55202,"_2970":55288},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3487":1832,"_30445":1795,"_21099":55290,"_5":14424,"_27663":55206,"_2970":55291},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3487":1833,"_30445":1795,"_21099":55293,"_5":14424,"_27663":55210,"_2970":55294},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3487":1834,"_30445":1795,"_21099":55296,"_5":14424,"_27663":55214,"_2970":55297},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3487":1835,"_30445":1795,"_21099":55299,"_5":14424,"_27663":55214,"_2970":55300},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3487":1836,"_30445":1795,"_21099":55302,"_5":14424,"_27663":55214,"_2970":55303},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3487":1837,"_30445":1795,"_21099":55305,"_5":14424,"_27663":55214,"_2970":55306},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3487":1838,"_30445":1795,"_21099":55308,"_5":14424,"_27663":55218,"_2970":55309},[],"The new chain ends in an anchor installed by the consumer.",{"_3487":1839,"_30445":1795,"_21099":55311,"_5":14424,"_27663":55218,"_2970":55312},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3487":1840,"_30445":1795,"_21099":55314,"_5":14424,"_27663":55218,"_2970":55315},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3487":1841,"_30445":1795,"_21099":55317,"_5":14424,"_27663":55218,"_2970":55318},[],"Re-enrollment accepts the old identity during the planned period.",{"_3487":1842,"_30445":1795,"_21099":55320,"_5":14424,"_27663":55218,"_2970":55321},[],"OCSP and CRL respond for the authorities that remain active.",{"_3487":1843,"_30445":1795,"_21099":55323,"_5":14424,"_27663":55218,"_2970":55324},[],"No DMS is left accidentally issuing from the old CA.",{"_3487":1844,"_30445":1795,"_21099":55326,"_5":14424,"_27663":55218,"_2970":55327},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3487":1845,"_30445":1845,"_5":14788,"_2970":55329,"_30797":55330,"_21099":55331,"_27663":1845},"Certification authorities",[49622,51161,55166,55167],[],{"_3487":1846,"_30445":1845,"_21099":55333,"_5":14424,"_27663":1845,"_2970":55334},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3487":1847,"_30445":1845,"_5":30794,"_21099":55336,"_27663":55337,"_2970":55338},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3487":1848,"_30445":1845,"_5":30794,"_21099":55340,"_27663":55341,"_2970":55342},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3487":1849,"_30445":1845,"_5":30794,"_21099":55344,"_27663":55345,"_2970":49632},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#before-you-begin",{"_3487":1850,"_30445":1845,"_5":30794,"_21099":55347,"_27663":55348,"_2970":55349},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3487":1851,"_30445":1845,"_5":30794,"_21099":55351,"_27663":55352,"_2970":55353},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3487":1852,"_30445":1845,"_5":30794,"_21099":55355,"_27663":55356,"_2970":55357},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3487":1853,"_30445":1845,"_5":30794,"_21099":55359,"_27663":55360,"_2970":55361},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3487":1854,"_30445":1845,"_5":30794,"_21099":55363,"_27663":55364,"_2970":55365},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3487":1855,"_30445":1845,"_5":30794,"_21099":55367,"_27663":55368,"_2970":55369},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3487":1856,"_30445":1845,"_5":30794,"_21099":55371,"_27663":55372,"_2970":55373},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3487":1857,"_30445":1845,"_5":30794,"_21099":55375,"_27663":55376,"_2970":55377},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3487":1858,"_30445":1845,"_5":30794,"_21099":55379,"_27663":55380,"_2970":55381},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3487":1859,"_30445":1845,"_5":30794,"_21099":55383,"_27663":55384,"_2970":55385},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3487":1860,"_30445":1845,"_5":30794,"_21099":55387,"_27663":55388,"_2970":55389},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3487":1861,"_30445":1845,"_5":30794,"_21099":55391,"_27663":55392,"_2970":55393},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3487":1862,"_30445":1845,"_5":30794,"_21099":55395,"_27663":55396,"_2970":55397},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3487":1863,"_30445":1845,"_5":30794,"_21099":55399,"_27663":55400,"_2970":55401},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3487":1864,"_30445":1845,"_5":30794,"_21099":55403,"_27663":55404,"_2970":55405},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3487":1865,"_30445":1845,"_5":30794,"_21099":55407,"_27663":55408,"_2970":55409},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3487":1866,"_30445":1845,"_5":30794,"_21099":55411,"_27663":55412,"_2970":55413},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3487":1867,"_30445":1845,"_5":30794,"_21099":55415,"_27663":55416,"_2970":55417},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3487":1868,"_30445":1845,"_5":30794,"_21099":55419,"_27663":55420,"_2970":55421},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3487":1869,"_30445":1845,"_5":30794,"_21099":55423,"_27663":55424,"_2970":55425},[],"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3487":1870,"_30445":1845,"_21099":55427,"_5":14424,"_27663":1845,"_2970":55428},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3487":1871,"_30445":1845,"_21099":55430,"_5":14424,"_27663":1845,"_2970":55431},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3487":1872,"_30445":1845,"_21099":55433,"_5":14424,"_27663":1845,"_2970":55434},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3487":1873,"_30445":1845,"_21099":55436,"_5":14424,"_27663":55337,"_2970":55437},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3487":1874,"_30445":1845,"_21099":55439,"_5":14424,"_27663":55337,"_2970":55440},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3487":1875,"_30445":1845,"_21099":55442,"_5":14424,"_27663":55337,"_2970":55443},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3487":1876,"_30445":1845,"_21099":55445,"_5":14424,"_27663":55337,"_2970":55446},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3487":1877,"_30445":1845,"_21099":55448,"_5":14424,"_27663":55337,"_2970":55449},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3487":1878,"_30445":1845,"_21099":55451,"_5":14424,"_27663":55345,"_2970":55452},[],"Decide whether the CA will be a root or an intermediate.",{"_3487":1879,"_30445":1845,"_21099":55454,"_5":14424,"_27663":55345,"_2970":55455},[],"Choose the engine that will keep the key.",{"_3487":1880,"_30445":1845,"_21099":55457,"_5":14424,"_27663":55345,"_2970":55458},[],"Define a validity longer than that of the certificates it will issue.",{"_3487":1881,"_30445":1845,"_21099":55460,"_5":14424,"_27663":55345,"_2970":55461},[],"For an intermediate CA, make sure the parent CA is active.",{"_3487":1882,"_30445":1845,"_21099":55463,"_5":14424,"_27663":55348,"_2970":55464},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3487":1883,"_30445":1845,"_21099":55466,"_5":14424,"_27663":55352,"_2970":55467},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3487":1884,"_30445":1845,"_21099":55469,"_5":14424,"_27663":55352,"_2970":55470},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3487":1885,"_30445":1845,"_21099":55472,"_5":14424,"_27663":55356,"_2970":55473},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3487":1886,"_30445":1845,"_21099":55475,"_5":14424,"_27663":55360,"_2970":55476},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3487":1887,"_30445":1845,"_21099":55478,"_5":14424,"_27663":55360,"_2970":55479},[],"`C`: two-letter ISO 3166-1 country code.",{"_3487":1888,"_30445":1845,"_21099":55481,"_5":14424,"_27663":55360,"_2970":55482},[],"`ST`: state or province.",{"_3487":1889,"_30445":1845,"_21099":55484,"_5":14424,"_27663":55360,"_2970":55485},[],"`L`: locality.",{"_3487":1890,"_30445":1845,"_21099":55487,"_5":14424,"_27663":55360,"_2970":55488},[],"`O`: organization.",{"_3487":1891,"_30445":1845,"_21099":55490,"_5":14424,"_27663":55360,"_2970":55491},[],"`OU`: organizational unit.",{"_3487":1892,"_30445":1845,"_21099":55493,"_5":14424,"_27663":55360,"_2970":55494},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3487":1893,"_30445":1845,"_21099":55496,"_5":14424,"_27663":55364,"_2970":55497},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3487":1894,"_30445":1845,"_21099":55499,"_5":14424,"_27663":55364,"_2970":55500},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3487":1895,"_30445":1845,"_21099":55502,"_5":14424,"_27663":55368,"_2970":55503},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3487":1896,"_30445":1845,"_21099":55505,"_5":14424,"_27663":55368,"_2970":55506},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3487":1897,"_30445":1845,"_21099":55508,"_5":14424,"_27663":55372,"_2970":55509},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3487":1898,"_30445":1845,"_21099":55511,"_5":14424,"_27663":55372,"_2970":55512},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3487":1899,"_30445":1845,"_21099":55514,"_5":14424,"_27663":55376,"_2970":55515},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3487":1900,"_30445":1845,"_21099":55517,"_5":14424,"_27663":55376,"_2970":55518},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3487":1901,"_30445":1845,"_21099":55520,"_5":14424,"_27663":55376,"_2970":55521},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3487":1902,"_30445":1845,"_21099":55523,"_5":14424,"_27663":55380,"_2970":55524},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3487":1903,"_30445":1845,"_21099":55526,"_5":14424,"_27663":55384,"_2970":55527},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3487":1904,"_30445":1845,"_21099":55529,"_5":14424,"_27663":55384,"_2970":55530},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3487":1905,"_30445":1845,"_21099":55532,"_5":14424,"_27663":55388,"_2970":55533},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3487":1906,"_30445":1845,"_21099":55535,"_5":14424,"_27663":55392,"_2970":55536},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3487":1907,"_30445":1845,"_21099":55538,"_5":14424,"_27663":55392,"_2970":55539},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3487":1908,"_30445":1845,"_21099":55541,"_5":14424,"_27663":55396,"_2970":55542},[],"Open a CA from the inventory to review:",{"_3487":1909,"_30445":1845,"_21099":55544,"_5":14424,"_27663":55396,"_2970":55545},[],"Status and validity period.",{"_3487":1910,"_30445":1845,"_21099":55547,"_5":14424,"_27663":55396,"_2970":55548},[],"Certificate and chain in PEM format.",{"_3487":1911,"_30445":1845,"_21099":55550,"_5":14424,"_27663":55396,"_2970":55551},[],"Number of active, expired and revoked certificates.",{"_3487":1912,"_30445":1845,"_21099":55553,"_5":14424,"_27663":55396,"_2970":55554},[],"Certificates issued in **Issued Certificates**.",{"_3487":1913,"_30445":1845,"_21099":55556,"_5":14424,"_27663":55396,"_2970":55557},[],"The CRL linked to the authority.",{"_3487":1914,"_30445":1845,"_21099":55559,"_5":14424,"_27663":55396,"_2970":55560},[],"Metadata and the associated cryptographic engine.",{"_3487":1915,"_30445":1845,"_21099":55562,"_5":14424,"_27663":55396,"_2970":55563},[],"You can filter the inventory by name, status and CA type.",{"_3487":1916,"_30445":1845,"_21099":55565,"_5":14424,"_27663":55400,"_2970":55566},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3487":1917,"_30445":1845,"_21099":55568,"_5":14424,"_27663":55400,"_2970":55569},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3487":1918,"_30445":1845,"_21099":55571,"_5":14424,"_27663":55400,"_2970":55572},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3487":1919,"_30445":1845,"_21099":55574,"_5":14424,"_27663":55400,"_2970":55575},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3487":1920,"_30445":1845,"_21099":55577,"_5":14424,"_27663":55404,"_2970":55578},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3487":1921,"_30445":1845,"_21099":55580,"_5":14424,"_27663":55408,"_2970":55581},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3487":1922,"_30445":1845,"_21099":55583,"_5":14424,"_27663":55412,"_2970":55584},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3487":1923,"_30445":1845,"_21099":55586,"_5":14424,"_27663":55416,"_2970":55587},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3487":1924,"_30445":1845,"_21099":55589,"_5":14424,"_27663":55420,"_2970":55590},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3487":1925,"_30445":1845,"_21099":55592,"_5":14424,"_27663":55424,"_2970":55593},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3487":1926,"_30445":1845,"_21099":55595,"_5":14424,"_27663":55424,"_2970":55596},[],"The CA’s CRL settings are kept as `ARCHIVED`. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand. Archived settings can be deleted with `DELETE /v1/crl-settings/{ca-id}` or from the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone; see the warning in CRL. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3487":1927,"_30445":1845,"_21099":55598,"_5":14424,"_27663":55424,"_2970":55599},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, their last CRL keeps being served at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; archived settings can no longer be edited (see CRL).",{"_3487":1928,"_30445":1928,"_5":14788,"_2970":55601,"_30797":55602,"_21099":55603,"_27663":1928},"Certificate profiles",[49622,51161,55166,55167],[],{"_3487":1929,"_30445":1928,"_21099":55605,"_5":14424,"_27663":1928,"_2970":55606},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3487":1930,"_30445":1928,"_5":30794,"_21099":55608,"_27663":55609,"_2970":55610},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3487":1931,"_30445":1928,"_5":30794,"_21099":55612,"_27663":55613,"_2970":55614},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#validity","Validity",{"_3487":1932,"_30445":1928,"_5":30794,"_21099":55616,"_27663":55617,"_2970":55618},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3487":1933,"_30445":1928,"_5":30794,"_21099":55620,"_27663":55621,"_2970":55622},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3487":1934,"_30445":1928,"_5":30794,"_21099":55624,"_27663":55625,"_2970":55626},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#subject","Subject",{"_3487":1935,"_30445":1928,"_5":30794,"_21099":55628,"_27663":55629,"_2970":55630},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3487":1936,"_30445":1928,"_5":30794,"_21099":55632,"_27663":55633,"_2970":55634},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3487":1937,"_30445":1928,"_5":30794,"_21099":55636,"_27663":55637,"_2970":55638},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3487":1938,"_30445":1928,"_5":30794,"_21099":55640,"_27663":55641,"_2970":55642},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3487":1939,"_30445":1928,"_5":30794,"_21099":55644,"_27663":55645,"_2970":55646},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3487":1940,"_30445":1928,"_5":30794,"_21099":55648,"_27663":55649,"_2970":55650},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3487":1941,"_30445":1928,"_5":30794,"_21099":55652,"_27663":55653,"_2970":55654},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3487":1942,"_30445":1928,"_5":30794,"_21099":55656,"_27663":55657,"_2970":55658},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3487":1943,"_30445":1928,"_5":30794,"_21099":55660,"_27663":55661,"_2970":55662},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3487":1944,"_30445":1928,"_5":30794,"_21099":55664,"_27663":55665,"_2970":55666},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#design-examples","Design examples",{"_3487":1945,"_30445":1928,"_5":30794,"_21099":55668,"_27663":55669,"_2970":55670},[],"/docs/pr-preview/pr-68/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3487":1946,"_30445":1928,"_21099":55672,"_5":14424,"_27663":1928,"_2970":55673},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3487":1947,"_30445":1928,"_21099":55675,"_5":14424,"_27663":1928,"_2970":55676},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3487":1948,"_30445":1928,"_21099":55678,"_5":14424,"_27663":55613,"_2970":55679},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3487":1949,"_30445":1928,"_21099":55681,"_5":14424,"_27663":55613,"_2970":55682},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3487":1950,"_30445":1928,"_21099":55684,"_5":14424,"_27663":55617,"_2970":55685},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3487":1951,"_30445":1928,"_21099":55687,"_5":14424,"_27663":55621,"_2970":55688},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3487":1952,"_30445":1928,"_21099":55690,"_5":14424,"_27663":55621,"_2970":55691},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3487":1953,"_30445":1928,"_21099":55693,"_5":14424,"_27663":55621,"_2970":55694},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3487":1954,"_30445":1928,"_21099":55696,"_5":14424,"_27663":55625,"_2970":55697},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3487":1955,"_30445":1928,"_21099":55699,"_5":14424,"_27663":55629,"_2970":55700},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3487":1956,"_30445":1928,"_21099":55702,"_5":14424,"_27663":55629,"_2970":55703},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3487":1957,"_30445":1928,"_21099":55705,"_5":14424,"_27663":55633,"_2970":55706},[],"The cryptographic enforcement can:",{"_3487":1958,"_30445":1928,"_21099":55708,"_5":14424,"_27663":55633,"_2970":55709},[],"allow or block RSA keys;",{"_3487":1959,"_30445":1928,"_21099":55711,"_5":14424,"_27663":55633,"_2970":55712},[],"limit the supported RSA sizes;",{"_3487":1960,"_30445":1928,"_21099":55714,"_5":14424,"_27663":55633,"_2970":55715},[],"allow or block ECDSA keys;",{"_3487":1961,"_30445":1928,"_21099":55717,"_5":14424,"_27663":55633,"_2970":55718},[],"limit the supported ECDSA sizes or curves.",{"_3487":1962,"_30445":1928,"_21099":55720,"_5":14424,"_27663":55633,"_2970":55721},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3487":1963,"_30445":1928,"_21099":55723,"_5":14424,"_27663":55637,"_2970":55724},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3487":1964,"_30445":1928,"_21099":55726,"_5":14424,"_27663":55637,"_2970":52928},[],{"_3487":1965,"_30445":1928,"_21099":55728,"_5":14424,"_27663":55637,"_2970":55729},[],"First choice",{"_3487":1966,"_30445":1928,"_21099":55731,"_5":14424,"_27663":55637,"_2970":55732},[],"Second choice",{"_3487":1967,"_30445":1928,"_21099":55734,"_5":14424,"_27663":55637,"_2970":55735},[],"If neither is supplied",{"_3487":1968,"_30445":1928,"_21099":55737,"_5":14424,"_27663":55637,"_2970":55738},[],"Direct signing with a CA",{"_3487":1969,"_30445":1928,"_21099":55740,"_5":14424,"_27663":55637,"_2970":55741},[],"`issuance_profile` embedded in the request",{"_3487":1970,"_30445":1928,"_21099":55743,"_5":14424,"_27663":55637,"_2970":55744},[],"Request `issuance_profile_id`",{"_3487":1971,"_30445":1928,"_21099":55746,"_5":14424,"_27663":55637,"_2970":55747},[],"CA default profile (`profile_id`).",{"_3487":1972,"_30445":1928,"_21099":55749,"_5":14424,"_27663":55637,"_2970":55750},[],"Issuance through a DMS",{"_3487":1973,"_30445":1928,"_21099":55752,"_5":14424,"_27663":55637,"_2970":55753},[],"`settings.issuance_profile_id`",{"_3487":1974,"_30445":1928,"_21099":55755,"_5":14424,"_27663":55637,"_2970":55756},[],"`settings.issuance_profile` embedded in the DMS",{"_3487":1975,"_30445":1928,"_21099":55758,"_5":14424,"_27663":55637,"_2970":55759},[],"Enrollment CA default profile.",{"_3487":1976,"_30445":1928,"_21099":55761,"_5":14424,"_27663":55637,"_2970":55762},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3487":1977,"_30445":1928,"_21099":55764,"_5":14424,"_27663":55637,"_2970":55765},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3487":1978,"_30445":1928,"_21099":55767,"_5":14424,"_27663":55645,"_2970":55768},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3487":1979,"_30445":1928,"_21099":55770,"_5":14424,"_27663":55649,"_2970":55771},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3487":1980,"_30445":1928,"_21099":55773,"_5":14424,"_27663":55653,"_2970":55774},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3487":1981,"_30445":1928,"_21099":55776,"_5":14424,"_27663":55657,"_2970":55777},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3487":1982,"_30445":1928,"_21099":55779,"_5":14424,"_27663":55661,"_2970":55780},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3487":1983,"_30445":1928,"_21099":55782,"_5":14424,"_27663":55661,"_2970":55783},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3487":1984,"_30445":1928,"_21099":55785,"_5":14424,"_27663":55665,"_2970":55786},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3487":1985,"_30445":1928,"_21099":55788,"_5":14424,"_27663":55665,"_2970":55789},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3487":1986,"_30445":1928,"_21099":55791,"_5":14424,"_27663":55665,"_2970":55792},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3487":1987,"_30445":1928,"_21099":55794,"_5":14424,"_27663":55665,"_2970":55795},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3487":1988,"_30445":1928,"_21099":55797,"_5":14424,"_27663":55669,"_2970":55798},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3487":1989,"_30445":1928,"_21099":55800,"_5":14424,"_27663":55669,"_2970":55801},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3487":1990,"_30445":1990,"_5":14788,"_2970":55803,"_30797":55804,"_21099":55806,"_27663":1990},"Certificate validation",[49622,51161,55166,55805],"Validation",[],{"_3487":1991,"_30445":1990,"_21099":55808,"_5":14424,"_27663":1990,"_2970":55809},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3487":1992,"_30445":1990,"_5":30794,"_21099":55811,"_27663":55812,"_2970":55813},[],"/docs/pr-preview/pr-68/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3487":1993,"_30445":1990,"_5":30794,"_21099":55815,"_27663":55816,"_2970":55817},[],"/docs/pr-preview/pr-68/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3487":1994,"_30445":1990,"_5":30794,"_21099":55819,"_27663":55820,"_2970":55821},[],"/docs/pr-preview/pr-68/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3487":1995,"_30445":1990,"_21099":55823,"_5":14424,"_27663":1990,"_2970":55824},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3487":1996,"_30445":1990,"_21099":55826,"_5":14424,"_27663":55812,"_2970":55827},[],"Verify these criteria together:",{"_3487":1997,"_30445":1990,"_21099":55829,"_5":14424,"_27663":55812,"_2970":54792},[],{"_3487":1998,"_30445":1990,"_21099":55831,"_5":14424,"_27663":55812,"_2970":55832},[],"Required result",{"_3487":1999,"_30445":1990,"_21099":55834,"_5":14424,"_27663":55812,"_2970":55835},[],"Chain and signature",{"_3487":2000,"_30445":1990,"_21099":55837,"_5":14424,"_27663":55812,"_2970":55838},[],"Valid chain to a root deliberately installed in the consumer.",{"_3487":2001,"_30445":1990,"_21099":55840,"_5":14424,"_27663":55812,"_2970":55841},[],"Dates",{"_3487":2002,"_30445":1990,"_21099":55843,"_5":14424,"_27663":55812,"_2970":55844},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3487":2003,"_30445":1990,"_21099":55846,"_5":14424,"_27663":55812,"_2970":50821},[],{"_3487":2004,"_30445":1990,"_21099":55848,"_5":14424,"_27663":55812,"_2970":55849},[],"Name, SAN or identifier matches the expected peer.",{"_3487":2005,"_30445":1990,"_21099":55851,"_5":14424,"_27663":55812,"_2970":50012},[],{"_3487":2006,"_30445":1990,"_21099":55853,"_5":14424,"_27663":55812,"_2970":55854},[],"KU, EKU and constraints permit the specific operation.",{"_3487":2007,"_30445":1990,"_21099":55856,"_5":14424,"_27663":55812,"_2970":55857},[],"Revocation",{"_3487":2008,"_30445":1990,"_21099":55859,"_5":14424,"_27663":55812,"_2970":55860},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3487":2009,"_30445":1990,"_21099":55862,"_5":14424,"_27663":55812,"_2970":55863},[],"Authorization",{"_3487":2010,"_30445":1990,"_21099":55865,"_5":14424,"_27663":55812,"_2970":55866},[],"The application permits that identity to perform the action.",{"_3487":2011,"_30445":1990,"_21099":55868,"_5":14424,"_27663":55812,"_2970":55869},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3487":2012,"_30445":1990,"_21099":55871,"_5":14424,"_27663":55816,"_2970":55872},[],"Mechanism",{"_3487":2013,"_30445":1990,"_21099":55874,"_5":14424,"_27663":55816,"_2970":55875},[],"When to use it",{"_3487":2014,"_30445":1990,"_21099":55877,"_5":14424,"_27663":55816,"_2970":55878},[],"What you must maintain",{"_3487":2015,"_30445":1990,"_21099":55880,"_5":14424,"_27663":55816,"_2970":55881},[],"OCSP",{"_3487":2016,"_30445":1990,"_21099":55883,"_5":14424,"_27663":55816,"_2970":55884},[],"Status query for a specific certificate.",{"_3487":2017,"_30445":1990,"_21099":55886,"_5":14424,"_27663":55816,"_2970":55887},[],"Responder access, signature verification and cache/freshness policy.",{"_3487":2018,"_30445":1990,"_21099":55889,"_5":14424,"_27663":55816,"_2970":55890},[],"CRL",{"_3487":2019,"_30445":1990,"_21099":55892,"_5":14424,"_27663":55816,"_2970":55893},[],"Local checks for many certificates or offline operation.",{"_3487":2020,"_30445":1990,"_21099":55895,"_5":14424,"_27663":55816,"_2970":55896},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3487":2021,"_30445":1990,"_21099":55898,"_5":14424,"_27663":55816,"_2970":55899},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3487":2022,"_30445":1990,"_21099":55901,"_5":14424,"_27663":55816,"_2970":55902},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3487":2023,"_30445":1990,"_21099":55904,"_5":14424,"_27663":55820,"_2970":55905},[],"Accept a current, authorized certificate with a known chain.",{"_3487":2024,"_30445":1990,"_21099":55907,"_5":14424,"_27663":55820,"_2970":55908},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3487":2025,"_30445":1990,"_21099":55910,"_5":14424,"_27663":55820,"_2970":55911},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3487":2026,"_30445":1990,"_21099":55913,"_5":14424,"_27663":55820,"_2970":55914},[],"Check that a new connection with that identity is rejected.",{"_3487":2027,"_30445":1990,"_21099":55916,"_5":14424,"_27663":55820,"_2970":55917},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3487":2028,"_30445":1990,"_21099":55919,"_5":14424,"_27663":55820,"_2970":55920},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3487":2029,"_30445":1990,"_21099":55922,"_5":14424,"_27663":55820,"_2970":55923},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3487":2030,"_30445":1990,"_21099":55925,"_5":14424,"_27663":55820,"_2970":55926},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3487":2031,"_30445":1990,"_21099":55928,"_5":14424,"_27663":55820,"_2970":55929},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3487":2032,"_30445":2032,"_5":14788,"_2970":55931,"_30797":55932,"_21099":55933,"_27663":2032},"Certificates",[49622,51161,55166,55167],[],{"_3487":2033,"_30445":2032,"_21099":55935,"_5":14424,"_27663":2032,"_2970":55936},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3487":2034,"_30445":2032,"_5":30794,"_21099":55938,"_27663":55939,"_2970":55940},[],"/docs/pr-preview/pr-68/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3487":2035,"_30445":2032,"_5":30794,"_21099":55942,"_27663":55943,"_2970":55944},[],"/docs/pr-preview/pr-68/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3487":2036,"_30445":2032,"_5":30794,"_21099":55946,"_27663":55947,"_2970":55948},[],"/docs/pr-preview/pr-68/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3487":2037,"_30445":2032,"_5":30794,"_21099":55950,"_27663":55951,"_2970":55952},[],"/docs/pr-preview/pr-68/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3487":2038,"_30445":2032,"_5":30794,"_21099":55954,"_27663":55955,"_2970":55956},[],"/docs/pr-preview/pr-68/platform/pki/certificates#open-the-action","Open the action",{"_3487":2039,"_30445":2032,"_5":30794,"_21099":55958,"_27663":55959,"_2970":55960},[],"/docs/pr-preview/pr-68/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3487":2040,"_30445":2032,"_5":30794,"_21099":55962,"_27663":55963,"_2970":55964},[],"/docs/pr-preview/pr-68/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3487":2041,"_30445":2032,"_5":30794,"_21099":55966,"_27663":55967,"_2970":55968},[],"/docs/pr-preview/pr-68/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3487":2042,"_30445":2032,"_5":30794,"_21099":55970,"_27663":55971,"_2970":55972},[],"/docs/pr-preview/pr-68/platform/pki/certificates#continue","Continue",{"_3487":2043,"_30445":2032,"_21099":55974,"_5":14424,"_27663":2032,"_2970":55975},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3487":2044,"_30445":2032,"_21099":55977,"_5":14424,"_27663":55939,"_2970":55978},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3487":2045,"_30445":2032,"_21099":55980,"_5":14424,"_27663":55939,"_2970":55981},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3487":2046,"_30445":2032,"_21099":55983,"_5":14424,"_27663":55939,"_2970":55984},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3487":2047,"_30445":2032,"_21099":55986,"_5":14424,"_27663":55939,"_2970":55987},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3487":2048,"_30445":2032,"_21099":55989,"_5":14424,"_27663":55939,"_2970":55990},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3487":2049,"_30445":2032,"_21099":55992,"_5":14424,"_27663":55939,"_2970":55993},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3487":2050,"_30445":2032,"_21099":55995,"_5":14424,"_27663":55939,"_2970":55996},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3487":2051,"_30445":2032,"_21099":55998,"_5":14424,"_27663":55943,"_2970":55999},[],"Download the PEM and inspect it:",{"_3487":2052,"_30445":2032,"_21099":56001,"_5":14424,"_27663":55943,"_2970":56002},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3487":2053,"_30445":2032,"_21099":56004,"_5":14424,"_27663":55947,"_2970":56005},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3487":2054,"_30445":2032,"_21099":56007,"_5":14424,"_27663":55947,"_2970":56008},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3487":2055,"_30445":2032,"_21099":56010,"_5":14424,"_27663":55947,"_2970":56011},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3487":2056,"_30445":2032,"_21099":56013,"_5":14424,"_27663":55947,"_2970":56014},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3487":2057,"_30445":2032,"_21099":56016,"_5":14424,"_27663":55947,"_2970":56017},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3487":2058,"_30445":2032,"_21099":56019,"_5":14424,"_27663":55947,"_2970":56020},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3487":2059,"_30445":2032,"_21099":56022,"_5":14424,"_27663":55947,"_2970":56023},[],"For browser key generation, follow Issue your first certificate.",{"_3487":2060,"_30445":2032,"_21099":56025,"_5":14424,"_27663":55951,"_2970":56026},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3487":2061,"_30445":2032,"_21099":56028,"_5":14424,"_27663":55955,"_2970":56029},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3487":2062,"_30445":2032,"_21099":56031,"_5":14424,"_27663":55959,"_2970":56032},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3487":2063,"_30445":2032,"_21099":56034,"_5":14424,"_27663":55963,"_2970":56035},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3487":2064,"_30445":2032,"_21099":56037,"_5":14424,"_27663":55963,"_2970":56038},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3487":2065,"_30445":2032,"_21099":56040,"_5":14424,"_27663":55963,"_2970":56041},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3487":2066,"_30445":2032,"_21099":56043,"_5":14424,"_27663":55967,"_2970":56044},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3487":2067,"_30445":2032,"_21099":56046,"_5":14424,"_27663":55967,"_2970":56047},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3487":2068,"_30445":2032,"_21099":56049,"_5":14424,"_27663":55967,"_2970":56050},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3487":2069,"_30445":2032,"_21099":56052,"_5":14424,"_27663":55971,"_2970":56053},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3487":2070,"_30445":2032,"_21099":56055,"_5":14424,"_27663":55971,"_2970":56056},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3487":2071,"_30445":2071,"_5":14788,"_2970":56058,"_30797":56059,"_21099":56061,"_27663":2071},"Certificate lifecycle",[49622,51161,55166,56060],"Concepts",[],{"_3487":2072,"_30445":2071,"_21099":56063,"_5":14424,"_27663":2071,"_2970":56064},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3487":2073,"_30445":2071,"_5":30794,"_21099":56066,"_27663":56067,"_2970":56068},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3487":2074,"_30445":2071,"_5":30794,"_21099":56070,"_27663":56071,"_2970":56072},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3487":2075,"_30445":2071,"_5":30794,"_21099":56074,"_27663":56075,"_2970":56076},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3487":2076,"_30445":2071,"_5":30794,"_21099":56078,"_27663":56079,"_2970":56080},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3487":2077,"_30445":2071,"_5":30794,"_21099":56082,"_27663":56083,"_2970":56084},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3487":2078,"_30445":2071,"_5":30794,"_21099":56086,"_27663":56087,"_2970":56088},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3487":2079,"_30445":2071,"_5":30794,"_21099":56090,"_27663":56091,"_2970":56092},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3487":2080,"_30445":2071,"_5":30794,"_21099":56094,"_27663":56095,"_2970":56096},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3487":2081,"_30445":2071,"_5":30794,"_21099":56098,"_27663":56099,"_2970":56100},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3487":2082,"_30445":2071,"_5":30794,"_21099":56102,"_27663":56103,"_2970":56104},[],"/docs/pr-preview/pr-68/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3487":2083,"_30445":2071,"_21099":56106,"_5":14424,"_27663":2071,"_2970":56107},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3487":2084,"_30445":2071,"_21099":56109,"_5":14424,"_27663":56071,"_2970":56110},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3487":2085,"_30445":2071,"_21099":56112,"_5":14424,"_27663":56075,"_2970":56113},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3487":2086,"_30445":2071,"_21099":56115,"_5":14424,"_27663":56079,"_2970":56116},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3487":2087,"_30445":2071,"_21099":56118,"_5":14424,"_27663":56083,"_2970":56119},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3487":2088,"_30445":2071,"_21099":56121,"_5":14424,"_27663":56087,"_2970":56122},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3487":2089,"_30445":2071,"_21099":56124,"_5":14424,"_27663":56091,"_2970":56125},[],"Lamassu persists four X.509 states:",{"_3487":2090,"_30445":2071,"_21099":56127,"_5":14424,"_27663":56091,"_2970":56128},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3487":2091,"_30445":2071,"_21099":56130,"_5":14424,"_27663":56091,"_2970":56131},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3487":2092,"_30445":2071,"_21099":56133,"_5":14424,"_27663":56091,"_2970":56134},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3487":2093,"_30445":2071,"_21099":56136,"_5":14424,"_27663":56091,"_2970":56137},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3487":2094,"_30445":2071,"_21099":56139,"_5":14424,"_27663":56091,"_2970":56140},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3487":2095,"_30445":2071,"_21099":56142,"_5":14424,"_27663":56095,"_2970":56143},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3487":2096,"_30445":2071,"_21099":56145,"_5":14424,"_27663":56095,"_2970":56146},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3487":2097,"_30445":2071,"_21099":56148,"_5":14424,"_27663":56095,"_2970":56149},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3487":2098,"_30445":2071,"_21099":56151,"_5":14424,"_27663":56099,"_2970":56152},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3487":2099,"_30445":2071,"_21099":56154,"_5":14424,"_27663":56099,"_2970":56155},[],"Before confirming:",{"_3487":2100,"_30445":2071,"_21099":56157,"_5":14424,"_27663":56099,"_2970":56158},[],"Identify DMSs, devices and services that trust that chain.",{"_3487":2101,"_30445":2071,"_21099":56160,"_5":14424,"_27663":56099,"_2970":56161},[],"Distribute the new chain of trust.",{"_3487":2102,"_30445":2071,"_21099":56163,"_5":14424,"_27663":56099,"_2970":56164},[],"Reissue the necessary identities.",{"_3487":2103,"_30445":2071,"_21099":56166,"_5":14424,"_27663":56099,"_2970":56167},[],"Check OCSP and CRL from a real consumer.",{"_3487":2104,"_30445":2071,"_21099":56169,"_5":14424,"_27663":56099,"_2970":56170},[],"Revoke the old CA once no legitimate traffic remains.",{"_3487":2105,"_30445":2071,"_21099":56172,"_5":14424,"_27663":56099,"_2970":56173},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3487":2106,"_30445":2071,"_21099":56175,"_5":14424,"_27663":56103,"_2970":56176},[],"Certificates entering the preventive or critical renewal window.",{"_3487":2107,"_30445":2071,"_21099":56178,"_5":14424,"_27663":56103,"_2970":56179},[],"Repeated enrollment or re-enrollment failures.",{"_3487":2108,"_30445":2071,"_21099":56181,"_5":14424,"_27663":56103,"_2970":56182},[],"Status changes and revocation reasons.",{"_3487":2109,"_30445":2071,"_21099":56184,"_5":14424,"_27663":56103,"_2970":56185},[],"OCSP and CRL publication and validity.",{"_3487":2110,"_30445":2071,"_21099":56187,"_5":14424,"_27663":56103,"_2970":56188},[],"Dependencies still presenting a replaced certificate.",{"_3487":2111,"_30445":2071,"_21099":56190,"_5":14424,"_27663":56103,"_2970":56191},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3487":2112,"_30445":2112,"_5":14788,"_2970":56193,"_30797":56194,"_21099":56195,"_27663":2112},"Trust model",[49622,51161,55166,56060],[],{"_3487":2113,"_30445":2112,"_21099":56197,"_5":14424,"_27663":2112,"_2970":56198},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3487":2114,"_30445":2112,"_5":30794,"_21099":56200,"_27663":56201,"_2970":56202},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3487":2115,"_30445":2112,"_5":30794,"_21099":56204,"_27663":56205,"_2970":56206},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3487":2116,"_30445":2112,"_5":30794,"_21099":56208,"_27663":56209,"_2970":56210},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3487":2117,"_30445":2112,"_5":30794,"_21099":56212,"_27663":56213,"_2970":56214},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3487":2118,"_30445":2112,"_5":30794,"_21099":56216,"_27663":56217,"_2970":56218},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3487":2119,"_30445":2112,"_5":30794,"_21099":56220,"_27663":56221,"_2970":56222},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3487":2120,"_30445":2112,"_5":30794,"_21099":56224,"_27663":56225,"_2970":56226},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3487":2121,"_30445":2112,"_5":30794,"_21099":56228,"_27663":56229,"_2970":56230},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3487":2122,"_30445":2112,"_5":30794,"_21099":56232,"_27663":56233,"_2970":56234},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3487":2123,"_30445":2112,"_5":30794,"_21099":56236,"_27663":56237,"_2970":56238},[],"/docs/pr-preview/pr-68/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3487":2124,"_30445":2112,"_21099":56240,"_5":14424,"_27663":2112,"_2970":56241},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3487":2125,"_30445":2112,"_21099":56243,"_5":14424,"_27663":56205,"_2970":56244},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3487":2126,"_30445":2112,"_21099":56246,"_5":14424,"_27663":56209,"_2970":56247},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3487":2127,"_30445":2112,"_21099":56249,"_5":14424,"_27663":56213,"_2970":56250},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3487":2128,"_30445":2112,"_21099":56252,"_5":14424,"_27663":56217,"_2970":56253},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3487":2129,"_30445":2112,"_21099":56255,"_5":14424,"_27663":56221,"_2970":56256},[],"The device proves it can enroll according to the DMS policy.",{"_3487":2130,"_30445":2112,"_21099":56258,"_5":14424,"_27663":56221,"_2970":56259},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3487":2131,"_30445":2112,"_21099":56261,"_5":14424,"_27663":56221,"_2970":56262},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3487":2132,"_30445":2112,"_21099":56264,"_5":14424,"_27663":56221,"_2970":56265},[],"The device installs the certificate and the chain it needs.",{"_3487":2133,"_30445":2112,"_21099":56267,"_5":14424,"_27663":56221,"_2970":56268},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3487":2134,"_30445":2112,"_21099":56270,"_5":14424,"_27663":56221,"_2970":56271},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3487":2135,"_30445":2112,"_21099":56273,"_5":14424,"_27663":56225,"_2970":56274},[],"A DMS relates three sets that are worth designing separately:",{"_3487":2136,"_30445":2112,"_21099":56276,"_5":14424,"_27663":56225,"_2970":56277},[],"**Enrollment CA:** signs the new identities.",{"_3487":2137,"_30445":2112,"_21099":56279,"_5":14424,"_27663":56225,"_2970":56280},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3487":2138,"_30445":2112,"_21099":56282,"_5":14424,"_27663":56225,"_2970":56283},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3487":2139,"_30445":2112,"_21099":56285,"_5":14424,"_27663":56225,"_2970":56286},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3487":2140,"_30445":2112,"_21099":56288,"_5":14424,"_27663":56229,"_2970":56289},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3487":2141,"_30445":2112,"_21099":56291,"_5":14424,"_27663":56229,"_2970":56292},[],"that the current date is between `Not Before` and `Not After`;",{"_3487":2142,"_30445":2112,"_21099":56294,"_5":14424,"_27663":56229,"_2970":56295},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3487":2143,"_30445":2112,"_21099":56297,"_5":14424,"_27663":56229,"_2970":56298},[],"that names, SANs and subject match the expected identity;",{"_3487":2144,"_30445":2112,"_21099":56300,"_5":14424,"_27663":56229,"_2970":56301},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3487":2145,"_30445":2112,"_21099":56303,"_5":14424,"_27663":56229,"_2970":56304},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3487":2146,"_30445":2112,"_21099":56306,"_5":14424,"_27663":56229,"_2970":56307},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3487":2147,"_30445":2112,"_21099":56309,"_5":14424,"_27663":56233,"_2970":56310},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3487":2148,"_30445":2112,"_21099":56312,"_5":14424,"_27663":56237,"_2970":56313},[],"Keep the root out of daily operations, or with very restricted access.",{"_3487":2149,"_30445":2112,"_21099":56315,"_5":14424,"_27663":56237,"_2970":56316},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3487":2150,"_30445":2112,"_21099":56318,"_5":14424,"_27663":56237,"_2970":56319},[],"Assign explicit profiles to every use case.",{"_3487":2151,"_30445":2112,"_21099":56321,"_5":14424,"_27663":56237,"_2970":56322},[],"Distribute the new trust before starting a rotation.",{"_3487":2152,"_30445":2112,"_21099":56324,"_5":14424,"_27663":56237,"_2970":56325},[],"Keep enough overlap to renew a disconnected fleet.",{"_3487":2153,"_30445":2112,"_21099":56327,"_5":14424,"_27663":56237,"_2970":56328},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3487":2154,"_30445":2112,"_21099":56330,"_5":14424,"_27663":56237,"_2970":56331},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3487":2155,"_30445":2155,"_5":14788,"_2970":56333,"_30797":56334,"_21099":56335,"_27663":2155},"Revocation lists (CRL)",[49622,51161,55166,55805],[],{"_3487":2156,"_30445":2155,"_21099":56337,"_5":14424,"_27663":2155,"_2970":56338},[],"Generate and distribute signed lists to validate certificates offline.",{"_3487":2157,"_30445":2155,"_5":30794,"_21099":56340,"_27663":56341,"_2970":56342},[],"/docs/pr-preview/pr-68/platform/pki/crl#crl-settings","CRL settings",{"_3487":2158,"_30445":2155,"_5":30794,"_21099":56344,"_27663":56345,"_2970":56346},[],"/docs/pr-preview/pr-68/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3487":2159,"_30445":2155,"_5":30794,"_21099":56348,"_27663":56349,"_2970":56350},[],"/docs/pr-preview/pr-68/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3487":2160,"_30445":2155,"_5":30794,"_21099":56352,"_27663":56353,"_2970":56354},[],"/docs/pr-preview/pr-68/platform/pki/crl#crl-contents","CRL contents",{"_3487":2161,"_30445":2155,"_5":30794,"_21099":56356,"_27663":56357,"_2970":56358},[],"/docs/pr-preview/pr-68/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3487":2162,"_30445":2155,"_5":30794,"_21099":56360,"_27663":56361,"_2970":56362},[],"/docs/pr-preview/pr-68/platform/pki/crl#crl-settings-api","CRL settings API",{"_3487":2163,"_30445":2155,"_5":30794,"_21099":56364,"_27663":56365,"_2970":56366},[],"/docs/pr-preview/pr-68/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3487":2164,"_30445":2155,"_5":30794,"_21099":56368,"_27663":56369,"_2970":56370},[],"/docs/pr-preview/pr-68/platform/pki/crl#references","References",{"_3487":2165,"_30445":2155,"_21099":56372,"_5":14424,"_27663":2155,"_2970":56373},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3487":2166,"_30445":2155,"_21099":56375,"_5":14424,"_27663":56341,"_2970":56376},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3487":2167,"_30445":2155,"_21099":56378,"_5":14424,"_27663":56341,"_2970":56379},[],"Field",{"_3487":2168,"_30445":2155,"_21099":56381,"_5":14424,"_27663":56341,"_2970":50012},[],{"_3487":2169,"_30445":2155,"_21099":56383,"_5":14424,"_27663":56341,"_2970":56384},[],"`ca_id`",{"_3487":2170,"_30445":2155,"_21099":56386,"_5":14424,"_27663":56341,"_2970":56387},[],"ID of the CA the settings belong to.",{"_3487":2171,"_30445":2155,"_21099":56389,"_5":14424,"_27663":56341,"_2970":56390},[],"`status`",{"_3487":2172,"_30445":2155,"_21099":56392,"_5":14424,"_27663":56341,"_2970":56393},[],"`ACTIVE` settings generate CRLs. `FINAL` ones belong to a CA that was revoked or has expired: its final CRL, if any, is published and no new one is generated. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3487":2173,"_30445":2155,"_21099":56395,"_5":14424,"_27663":56341,"_2970":56396},[],"`legacy_ski`",{"_3487":2174,"_30445":2155,"_21099":56398,"_5":14424,"_27663":56341,"_2970":56399},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3487":2175,"_30445":2155,"_21099":56401,"_5":14424,"_27663":56341,"_2970":56402},[],"`latest_crl`",{"_3487":2176,"_30445":2155,"_21099":56404,"_5":14424,"_27663":56341,"_2970":56405},[],"Version, validity start and end of the last published list. Read-only.",{"_3487":2177,"_30445":2155,"_21099":56407,"_5":14424,"_27663":56341,"_2970":56408},[],"`crl_options` field",{"_3487":2178,"_30445":2155,"_21099":56410,"_5":14424,"_27663":56341,"_2970":50012},[],{"_3487":2179,"_30445":2155,"_21099":56412,"_5":14424,"_27663":56341,"_2970":56413},[],"Initial value",{"_3487":2180,"_30445":2155,"_21099":56415,"_5":14424,"_27663":56341,"_2970":56416},[],"`validity`",{"_3487":2181,"_30445":2155,"_21099":56418,"_5":14424,"_27663":56341,"_2970":56419},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3487":2182,"_30445":2155,"_21099":56421,"_5":14424,"_27663":56341,"_2970":56422},[],"7 days.",{"_3487":2183,"_30445":2155,"_21099":56424,"_5":14424,"_27663":56341,"_2970":56425},[],"`refresh_interval`",{"_3487":2184,"_30445":2155,"_21099":56427,"_5":14424,"_27663":56341,"_2970":56428},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3487":2185,"_30445":2155,"_21099":56430,"_5":14424,"_27663":56341,"_2970":56431},[],"6 days and 23 hours.",{"_3487":2186,"_30445":2155,"_21099":56433,"_5":14424,"_27663":56341,"_2970":56434},[],"`regenerate_on_revoke`",{"_3487":2187,"_30445":2155,"_21099":56436,"_5":14424,"_27663":56341,"_2970":56437},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3487":2188,"_30445":2155,"_21099":56439,"_5":14424,"_27663":56341,"_2970":56440},[],"`true`.",{"_3487":2189,"_30445":2155,"_21099":56442,"_5":14424,"_27663":56341,"_2970":56443},[],"`signer_serial_number`",{"_3487":2190,"_30445":2155,"_21099":56445,"_5":14424,"_27663":56341,"_2970":56446},[],"Serial number of the existing certificate that signs the CRL.",{"_3487":2191,"_30445":2155,"_21099":56448,"_5":14424,"_27663":56341,"_2970":56449},[],"Serial number of the CA’s current certificate.",{"_3487":2192,"_30445":2155,"_21099":56451,"_5":14424,"_27663":56341,"_2970":56452},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3487":2193,"_30445":2155,"_21099":56454,"_5":14424,"_27663":56341,"_2970":56455},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3487":2194,"_30445":2155,"_21099":56457,"_5":14424,"_27663":56341,"_2970":56458},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3487":2195,"_30445":2155,"_21099":56460,"_5":14424,"_27663":56341,"_2970":56461},[],"Settings whose `status` is `FINAL` or `ARCHIVED` are read-only: any `PUT` returns 409. Deleting a CA keeps its CRL settings:",{"_3487":2196,"_30445":2155,"_21099":56463,"_5":14424,"_27663":56341,"_2970":56464},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated.",{"_3487":2197,"_30445":2155,"_21099":56466,"_5":14424,"_27663":56341,"_2970":56467},[],"`ARCHIVED` settings of a deleted CA can be deleted, with `DELETE` or from the console's Verification Authorities page. That CRL stops being served — anyone checking its certificates against it will no longer find it — while the CRLs already published remain in the bucket. The action cannot be undone.",{"_3487":2198,"_30445":2155,"_21099":56469,"_5":14424,"_27663":56341,"_2970":56470},[],"Adjust validity and signer before deleting a CA.",{"_3487":2199,"_30445":2155,"_21099":56472,"_5":14424,"_27663":56341,"_2970":56473},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3487":2200,"_30445":2155,"_21099":56475,"_5":14424,"_27663":56341,"_2970":56476},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3487":2201,"_30445":2155,"_21099":56478,"_5":14424,"_27663":56341,"_2970":56479},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3487":2202,"_30445":2155,"_21099":56481,"_5":14424,"_27663":56345,"_2970":56482},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3487":2203,"_30445":2155,"_21099":56484,"_5":14424,"_27663":56345,"_2970":56485},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3487":2204,"_30445":2155,"_21099":56487,"_5":14424,"_27663":56345,"_2970":56488},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3487":2205,"_30445":2155,"_21099":56490,"_5":14424,"_27663":56345,"_2970":56491},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3487":2206,"_30445":2155,"_21099":56493,"_5":14424,"_27663":56349,"_2970":56494},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3487":2207,"_30445":2155,"_21099":56496,"_5":14424,"_27663":56349,"_2970":56497},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3487":2208,"_30445":2155,"_21099":56499,"_5":14424,"_27663":56349,"_2970":56500},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3487":2209,"_30445":2155,"_21099":56502,"_5":14424,"_27663":56349,"_2970":56503},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3487":2210,"_30445":2155,"_21099":56505,"_5":14424,"_27663":56349,"_2970":56506},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3487":2211,"_30445":2155,"_21099":56508,"_5":14424,"_27663":56349,"_2970":56509},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3487":2212,"_30445":2155,"_21099":56511,"_5":14424,"_27663":56349,"_2970":56512},[],"Settings whose `status` is `FINAL` or `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3487":2213,"_30445":2155,"_21099":56514,"_5":14424,"_27663":56349,"_2970":56515},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3487":2214,"_30445":2155,"_21099":56517,"_5":14424,"_27663":56349,"_2970":56518},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3487":2215,"_30445":2155,"_21099":56520,"_5":14424,"_27663":56353,"_2970":56521},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3487":2216,"_30445":2155,"_21099":56523,"_5":14424,"_27663":56353,"_2970":56524},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3487":2217,"_30445":2155,"_21099":56526,"_5":14424,"_27663":56357,"_2970":56527},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3487":2218,"_30445":2155,"_21099":56529,"_5":14424,"_27663":56357,"_2970":56530},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3487":2219,"_30445":2155,"_21099":56532,"_5":14424,"_27663":56357,"_2970":56533},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3487":2220,"_30445":2155,"_21099":56535,"_5":14424,"_27663":56357,"_2970":56536},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3487":2221,"_30445":2155,"_21099":56538,"_5":14424,"_27663":56357,"_2970":56539},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3487":2222,"_30445":2155,"_21099":56541,"_5":14424,"_27663":56361,"_2970":56542},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3487":2223,"_30445":2155,"_21099":56544,"_5":14424,"_27663":56361,"_2970":52931},[],{"_3487":2224,"_30445":2155,"_21099":56546,"_5":14424,"_27663":56361,"_2970":56547},[],"Relative path",{"_3487":2225,"_30445":2155,"_21099":56549,"_5":14424,"_27663":56361,"_2970":52928},[],{"_3487":2226,"_30445":2155,"_21099":56551,"_5":14424,"_27663":56361,"_2970":56552},[],"`GET`",{"_3487":2227,"_30445":2155,"_21099":56554,"_5":14424,"_27663":56361,"_2970":56555},[],"`/v1/crl-settings`",{"_3487":2228,"_30445":2155,"_21099":56557,"_5":14424,"_27663":56361,"_2970":56558},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3487":2229,"_30445":2155,"_21099":56560,"_5":14424,"_27663":56361,"_2970":56552},[],{"_3487":2230,"_30445":2155,"_21099":56562,"_5":14424,"_27663":56361,"_2970":56563},[],"`/v1/crl-settings/{ca-id}`",{"_3487":2231,"_30445":2155,"_21099":56565,"_5":14424,"_27663":56361,"_2970":56566},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3487":2232,"_30445":2155,"_21099":56568,"_5":14424,"_27663":56361,"_2970":56569},[],"`PUT`",{"_3487":2233,"_30445":2155,"_21099":56571,"_5":14424,"_27663":56361,"_2970":56563},[],{"_3487":2234,"_30445":2155,"_21099":56573,"_5":14424,"_27663":56361,"_2970":56574},[],"Replace the CRL configuration of a CA.",{"_3487":2235,"_30445":2155,"_21099":56576,"_5":14424,"_27663":56361,"_2970":56577},[],"`DELETE`",{"_3487":2236,"_30445":2155,"_21099":56579,"_5":14424,"_27663":56361,"_2970":56563},[],{"_3487":2237,"_30445":2155,"_21099":56581,"_5":14424,"_27663":56361,"_2970":56582},[],"Delete the settings of a CA whose settings are `ARCHIVED`; its published CRLs stay in the bucket but stop being served.",{"_3487":2238,"_30445":2155,"_21099":56584,"_5":14424,"_27663":56361,"_2970":56585},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation's API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL. A `DELETE` returns 409 unless the settings are `ARCHIVED`.",{"_3487":2239,"_30445":2155,"_21099":56587,"_5":14424,"_27663":56361,"_2970":56588},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3487":2240,"_30445":2155,"_21099":56590,"_5":14424,"_27663":56365,"_2970":56591},[],"Symptom",{"_3487":2241,"_30445":2155,"_21099":56593,"_5":14424,"_27663":56365,"_2970":56594},[],"Cause",{"_3487":2242,"_30445":2155,"_21099":56596,"_5":14424,"_27663":56365,"_2970":56597},[],"Action",{"_3487":2243,"_30445":2155,"_21099":56599,"_5":14424,"_27663":56365,"_2970":56600},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3487":2244,"_30445":2155,"_21099":56602,"_5":14424,"_27663":56365,"_2970":56603},[],"The settings are not `ACTIVE`: they are `FINAL` or `ARCHIVED` (see the `status` table in CRL settings).",{"_3487":2245,"_30445":2155,"_21099":56605,"_5":14424,"_27663":56365,"_2970":56606},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3487":2246,"_30445":2155,"_21099":56608,"_5":14424,"_27663":56365,"_2970":56609},[],"`PUT` returns 400.",{"_3487":2247,"_30445":2155,"_21099":56611,"_5":14424,"_27663":56365,"_2970":56612},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3487":2248,"_30445":2155,"_21099":56614,"_5":14424,"_27663":56365,"_2970":56615},[],"Set the serial number of a valid certificate of that CA.",{"_3487":2249,"_30445":2155,"_21099":56617,"_5":14424,"_27663":56365,"_2970":56618},[],"`PUT` returns 404.",{"_3487":2250,"_30445":2155,"_21099":56620,"_5":14424,"_27663":56365,"_2970":56621},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3487":2251,"_30445":2155,"_21099":56623,"_5":14424,"_27663":56365,"_2970":56624},[],"Check the CA ID and the signer serial number.",{"_3487":2252,"_30445":2155,"_21099":56626,"_5":14424,"_27663":56365,"_2970":56627},[],"`PUT` returns 400 from a 3.x client.",{"_3487":2253,"_30445":2155,"_21099":56629,"_5":14424,"_27663":56365,"_2970":56630},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3487":2254,"_30445":2155,"_21099":56632,"_5":14424,"_27663":56365,"_2970":56633},[],"Update the client to send the new field.",{"_3487":2255,"_30445":2155,"_21099":56635,"_5":14424,"_27663":56365,"_2970":56636},[],"The CRL does not change after revoking a certificate.",{"_3487":2256,"_30445":2155,"_21099":56638,"_5":14424,"_27663":56365,"_2970":56639},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3487":2257,"_30445":2155,"_21099":56641,"_5":14424,"_27663":56365,"_2970":56642},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3487":2258,"_30445":2155,"_21099":56644,"_5":14424,"_27663":56365,"_2970":56645},[],"A verifier rejects the CRL because of the issuer.",{"_3487":2259,"_30445":2155,"_21099":56647,"_5":14424,"_27663":56365,"_2970":56648},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3487":2260,"_30445":2155,"_21099":56650,"_5":14424,"_27663":56365,"_2970":56651},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3487":2261,"_30445":2155,"_21099":56653,"_5":14424,"_27663":56369,"_2970":56654},[],"RFC 5280: X.509 and CRL profile.",{"_3487":2262,"_30445":2155,"_21099":56656,"_5":14424,"_27663":56369,"_2970":56657},[],"OpenSSL: openssl-crl.",{"_3487":2263,"_30445":2155,"_21099":56659,"_5":14424,"_27663":56369,"_2970":56660},[],"OpenSSL: openssl-verify.",{"_3487":2264,"_30445":2155,"_21099":56662,"_5":14424,"_27663":56369,"_2970":56663},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3487":2265,"_30445":2155,"_21099":56665,"_5":14424,"_27663":56369,"_2970":56666},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3487":2266,"_30445":2266,"_5":14788,"_2970":56668,"_30797":56669,"_21099":56670,"_27663":2266},"Keys and cryptographic engines",[49622,51161,55166,55167],[],{"_3487":2267,"_30445":2266,"_21099":56672,"_5":14424,"_27663":2266,"_2970":56673},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3487":2268,"_30445":2266,"_5":30794,"_21099":56675,"_27663":56676,"_2970":56677},[],"/docs/pr-preview/pr-68/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3487":2269,"_30445":2266,"_5":30794,"_21099":56679,"_27663":56680,"_2970":56681},[],"/docs/pr-preview/pr-68/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3487":2270,"_30445":2266,"_5":30794,"_21099":56683,"_27663":56684,"_2970":56685},[],"/docs/pr-preview/pr-68/platform/pki/key-management#file-system","File System",{"_3487":2271,"_30445":2266,"_5":30794,"_21099":56687,"_27663":56688,"_2970":56689},[],"/docs/pr-preview/pr-68/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3487":2272,"_30445":2266,"_5":30794,"_21099":56691,"_27663":56692,"_2970":56693},[],"/docs/pr-preview/pr-68/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3487":2273,"_30445":2266,"_5":30794,"_21099":56695,"_27663":56696,"_2970":56697},[],"/docs/pr-preview/pr-68/platform/pki/key-management#aws-kms","AWS KMS",{"_3487":2274,"_30445":2266,"_5":30794,"_21099":56699,"_27663":56700,"_2970":56701},[],"/docs/pr-preview/pr-68/platform/pki/key-management#pkcs11","PKCS#11",{"_3487":2275,"_30445":2266,"_5":30794,"_21099":56703,"_27663":56704,"_2970":56705},[],"/docs/pr-preview/pr-68/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3487":2276,"_30445":2266,"_5":30794,"_21099":56707,"_27663":56708,"_2970":56709},[],"/docs/pr-preview/pr-68/platform/pki/key-management#key-inventory","Key inventory",{"_3487":2277,"_30445":2266,"_5":30794,"_21099":56711,"_27663":56712,"_2970":56713},[],"/docs/pr-preview/pr-68/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3487":2278,"_30445":2266,"_5":30794,"_21099":56715,"_27663":56716,"_2970":56717},[],"/docs/pr-preview/pr-68/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3487":2279,"_30445":2266,"_5":30794,"_21099":56719,"_27663":56720,"_2970":56721},[],"/docs/pr-preview/pr-68/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3487":2280,"_30445":2266,"_5":30794,"_21099":56723,"_27663":56724,"_2970":56725},[],"/docs/pr-preview/pr-68/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3487":2281,"_30445":2266,"_5":30794,"_21099":56727,"_27663":56728,"_2970":56729},[],"/docs/pr-preview/pr-68/platform/pki/key-management#view-details","View details",{"_3487":2282,"_30445":2266,"_5":30794,"_21099":56731,"_27663":56732,"_2970":56733},[],"/docs/pr-preview/pr-68/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3487":2283,"_30445":2266,"_5":30794,"_21099":56735,"_27663":56736,"_2970":56737},[],"/docs/pr-preview/pr-68/platform/pki/key-management#sign","Sign",{"_3487":2284,"_30445":2266,"_5":30794,"_21099":56739,"_27663":56740,"_2970":56741},[],"/docs/pr-preview/pr-68/platform/pki/key-management#verify","Verify",{"_3487":2285,"_30445":2266,"_5":30794,"_21099":56743,"_27663":56744,"_2970":56745},[],"/docs/pr-preview/pr-68/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3487":2286,"_30445":2266,"_5":30794,"_21099":56747,"_27663":56748,"_2970":56749},[],"/docs/pr-preview/pr-68/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3487":2287,"_30445":2266,"_5":30794,"_21099":56751,"_27663":56752,"_2970":56753},[],"/docs/pr-preview/pr-68/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3487":2288,"_30445":2266,"_21099":56755,"_5":14424,"_27663":2266,"_2970":56756},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3487":2289,"_30445":2266,"_21099":56758,"_5":14424,"_27663":2266,"_2970":56759},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3487":2290,"_30445":2266,"_21099":56761,"_5":14424,"_27663":56676,"_2970":56762},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3487":2291,"_30445":2266,"_21099":56764,"_5":14424,"_27663":56676,"_2970":56765},[],"In practice, it lets you:",{"_3487":2292,"_30445":2266,"_21099":56767,"_5":14424,"_27663":56676,"_2970":56768},[],"Generate new key pairs from Lamassu IoT.",{"_3487":2293,"_30445":2266,"_21099":56770,"_5":14424,"_27663":56676,"_2970":56771},[],"Import keys created externally.",{"_3487":2294,"_30445":2266,"_21099":56773,"_5":14424,"_27663":56676,"_2970":56774},[],"Delegate custody and cryptographic operations to external engines.",{"_3487":2295,"_30445":2266,"_21099":56776,"_5":14424,"_27663":56676,"_2970":56777},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3487":2296,"_30445":2266,"_21099":56779,"_5":14424,"_27663":56680,"_2970":56780},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3487":2297,"_30445":2266,"_21099":56782,"_5":14424,"_27663":56680,"_2970":56783},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3487":2298,"_30445":2266,"_21099":56785,"_5":14424,"_27663":56680,"_2970":56786},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3487":2299,"_30445":2266,"_21099":56788,"_5":14424,"_27663":56684,"_2970":56789},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3487":2300,"_30445":2266,"_21099":56791,"_5":14424,"_27663":56688,"_2970":56792},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3487":2301,"_30445":2266,"_21099":56794,"_5":14424,"_27663":56688,"_2970":56795},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3487":2302,"_30445":2266,"_21099":56797,"_5":14424,"_27663":56692,"_2970":56798},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3487":2303,"_30445":2266,"_21099":56800,"_5":14424,"_27663":56696,"_2970":56801},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3487":2304,"_30445":2266,"_21099":56803,"_5":14424,"_27663":56700,"_2970":56804},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3487":2305,"_30445":2266,"_21099":56806,"_5":14424,"_27663":56704,"_2970":56807},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3487":2306,"_30445":2266,"_21099":56809,"_5":14424,"_27663":56704,"_2970":56810},[],"Lamassu shows the enabled engines in the console.",{"_3487":2307,"_30445":2266,"_21099":56812,"_5":14424,"_27663":56704,"_2970":56813},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3487":2308,"_30445":2266,"_21099":56815,"_5":14424,"_27663":56704,"_2970":56816},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3487":2309,"_30445":2266,"_21099":56818,"_5":14424,"_27663":56708,"_2970":56819},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3487":2310,"_30445":2266,"_21099":56821,"_5":14424,"_27663":56708,"_2970":56822},[],"The table includes the following fields:",{"_3487":2311,"_30445":2266,"_21099":56824,"_5":14424,"_27663":56708,"_2970":56825},[],"**Name**: descriptive name of the key.",{"_3487":2312,"_30445":2266,"_21099":56827,"_5":14424,"_27663":56708,"_2970":56828},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3487":2313,"_30445":2266,"_21099":56830,"_5":14424,"_27663":56708,"_2970":56831},[],"**Strength**: visual indicator of cryptographic strength.",{"_3487":2314,"_30445":2266,"_21099":56833,"_5":14424,"_27663":56708,"_2970":56834},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3487":2315,"_30445":2266,"_21099":56836,"_5":14424,"_27663":56708,"_2970":56837},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3487":2316,"_30445":2266,"_21099":56839,"_5":14424,"_27663":56708,"_2970":56840},[],"**Aliases**: alternative names associated with the key.",{"_3487":2317,"_30445":2266,"_21099":56842,"_5":14424,"_27663":56708,"_2970":56843},[],"**Tags**: labels for classification and search.",{"_3487":2318,"_30445":2266,"_21099":56845,"_5":14424,"_27663":56708,"_2970":56846},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3487":2319,"_30445":2266,"_21099":56848,"_5":14424,"_27663":56708,"_2970":56849},[],"From this view you also reach the most common actions:",{"_3487":2320,"_30445":2266,"_21099":56851,"_5":14424,"_27663":56708,"_2970":56852},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3487":2321,"_30445":2266,"_21099":56854,"_5":14424,"_27663":56708,"_2970":56855},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3487":2322,"_30445":2266,"_21099":56857,"_5":14424,"_27663":56708,"_2970":56858},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3487":2323,"_30445":2266,"_21099":56860,"_5":14424,"_27663":56708,"_2970":56861},[],"**Delete Key** to remove the key from the system.",{"_3487":2324,"_30445":2266,"_21099":56863,"_5":14424,"_27663":56712,"_2970":56864},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3487":2325,"_30445":2266,"_21099":56866,"_5":14424,"_27663":56716,"_2970":56867},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3487":2326,"_30445":2266,"_21099":56869,"_5":14424,"_27663":56716,"_2970":56870},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3487":2327,"_30445":2266,"_21099":56872,"_5":14424,"_27663":56716,"_2970":56873},[],"**Key Name**: unique and descriptive name.",{"_3487":2328,"_30445":2266,"_21099":56875,"_5":14424,"_27663":56716,"_2970":56876},[],"**Crypto Engine**: engine that will keep the key.",{"_3487":2329,"_30445":2266,"_21099":56878,"_5":14424,"_27663":56716,"_2970":56879},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3487":2330,"_30445":2266,"_21099":56881,"_5":14424,"_27663":56716,"_2970":56882},[],"**Tags**: metadata to classify the key.",{"_3487":2331,"_30445":2266,"_21099":56884,"_5":14424,"_27663":56716,"_2970":56885},[],"**Metadata**: additional information for advanced uses.",{"_3487":2332,"_30445":2266,"_21099":56887,"_5":14424,"_27663":56720,"_2970":56888},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3487":2333,"_30445":2266,"_21099":56890,"_5":14424,"_27663":56720,"_2970":56891},[],"When you have an exportable private key and the destination engine supports import.",{"_3487":2334,"_30445":2266,"_21099":56893,"_5":14424,"_27663":56720,"_2970":56894},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3487":2335,"_30445":2266,"_21099":56896,"_5":14424,"_27663":56720,"_2970":56897},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3487":2336,"_30445":2266,"_21099":56899,"_5":14424,"_27663":56720,"_2970":56900},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3487":2337,"_30445":2266,"_21099":56902,"_5":14424,"_27663":56720,"_2970":56903},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3487":2338,"_30445":2266,"_21099":56905,"_5":14424,"_27663":56720,"_2970":56906},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3487":2339,"_30445":2266,"_21099":56908,"_5":14424,"_27663":56720,"_2970":56909},[],"**Tags**: labels for organization and search.",{"_3487":2340,"_30445":2266,"_21099":56911,"_5":14424,"_27663":56720,"_2970":56912},[],"**Metadata**: additional optional information.",{"_3487":2341,"_30445":2266,"_21099":56914,"_5":14424,"_27663":56720,"_2970":56915},[],"**Private Key (PEM)**: private key in PEM format.",{"_3487":2342,"_30445":2266,"_21099":56917,"_5":14424,"_27663":56720,"_2970":56918},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3487":2343,"_30445":2266,"_21099":56920,"_5":14424,"_27663":56724,"_2970":56921},[],"Each registered key has a detail view and several operational actions.",{"_3487":2344,"_30445":2266,"_21099":56923,"_5":14424,"_27663":56728,"_2970":56924},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3487":2345,"_30445":2266,"_21099":56926,"_5":14424,"_27663":56728,"_2970":56927},[],"The **Overview** tab shows, among others, these fields:",{"_3487":2346,"_30445":2266,"_21099":56929,"_5":14424,"_27663":56728,"_2970":56930},[],"**Key Name**: descriptive name.",{"_3487":2347,"_30445":2266,"_21099":56932,"_5":14424,"_27663":56728,"_2970":56933},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3487":2348,"_30445":2266,"_21099":56935,"_5":14424,"_27663":56728,"_2970":56936},[],"**Tags**: associated labels.",{"_3487":2349,"_30445":2266,"_21099":56938,"_5":14424,"_27663":56728,"_2970":56939},[],"**Aliases**: alternative names.",{"_3487":2350,"_30445":2266,"_21099":56941,"_5":14424,"_27663":56728,"_2970":56942},[],"**Crypto Engine**: engine where the key resides.",{"_3487":2351,"_30445":2266,"_21099":56944,"_5":14424,"_27663":56728,"_2970":56945},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3487":2352,"_30445":2266,"_21099":56947,"_5":14424,"_27663":56728,"_2970":56948},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3487":2353,"_30445":2266,"_21099":56950,"_5":14424,"_27663":56728,"_2970":56951},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3487":2354,"_30445":2266,"_21099":56953,"_5":14424,"_27663":56732,"_2970":56954},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3487":2355,"_30445":2266,"_21099":56956,"_5":14424,"_27663":56732,"_2970":56957},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3487":2356,"_30445":2266,"_21099":56959,"_5":14424,"_27663":56732,"_2970":56960},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3487":2357,"_30445":2266,"_21099":56962,"_5":14424,"_27663":56736,"_2970":56963},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3487":2358,"_30445":2266,"_21099":56965,"_5":14424,"_27663":56736,"_2970":56966},[],"Main fields:",{"_3487":2359,"_30445":2266,"_21099":56968,"_5":14424,"_27663":56736,"_2970":56969},[],"**Algorithm**: signing algorithm available for the key type.",{"_3487":2360,"_30445":2266,"_21099":56971,"_5":14424,"_27663":56736,"_2970":56972},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3487":2361,"_30445":2266,"_21099":56974,"_5":14424,"_27663":56736,"_2970":56975},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3487":2362,"_30445":2266,"_21099":56977,"_5":14424,"_27663":56736,"_2970":56978},[],"**Message**: content to sign.",{"_3487":2363,"_30445":2266,"_21099":56980,"_5":14424,"_27663":56736,"_2970":56981},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3487":2364,"_30445":2266,"_21099":56983,"_5":14424,"_27663":56740,"_2970":56984},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3487":2365,"_30445":2266,"_21099":56986,"_5":14424,"_27663":56740,"_2970":56966},[],{"_3487":2366,"_30445":2266,"_21099":56988,"_5":14424,"_27663":56740,"_2970":56989},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3487":2367,"_30445":2266,"_21099":56991,"_5":14424,"_27663":56740,"_2970":56992},[],"**Message Type**: `Raw` or `Digest`.",{"_3487":2368,"_30445":2266,"_21099":56994,"_5":14424,"_27663":56740,"_2970":56995},[],"**Payload Encoding**: encoding of the message.",{"_3487":2369,"_30445":2266,"_21099":56997,"_5":14424,"_27663":56740,"_2970":56998},[],"**Message**: original message or hash.",{"_3487":2370,"_30445":2266,"_21099":57000,"_5":14424,"_27663":56740,"_2970":57001},[],"**Signature**: signature to check.",{"_3487":2371,"_30445":2266,"_21099":57003,"_5":14424,"_27663":56740,"_2970":57004},[],"**Result**: indicator of the validation result.",{"_3487":2372,"_30445":2266,"_21099":57006,"_5":14424,"_27663":56744,"_2970":57007},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3487":2373,"_30445":2266,"_21099":57009,"_5":14424,"_27663":56744,"_2970":57010},[],"This flow is useful for:",{"_3487":2374,"_30445":2266,"_21099":57012,"_5":14424,"_27663":56744,"_2970":57013},[],"Requesting certificates from an external CA.",{"_3487":2375,"_30445":2266,"_21099":57015,"_5":14424,"_27663":56744,"_2970":57016},[],"Renewing an identity while keeping the same key.",{"_3487":2376,"_30445":2266,"_21099":57018,"_5":14424,"_27663":56744,"_2970":57019},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3487":2377,"_30445":2266,"_21099":57021,"_5":14424,"_27663":56744,"_2970":57022},[],"**Common Name (CN)**: main name of the identity.",{"_3487":2378,"_30445":2266,"_21099":57024,"_5":14424,"_27663":56744,"_2970":57025},[],"**Organization (O)**: organization or company.",{"_3487":2379,"_30445":2266,"_21099":57027,"_5":14424,"_27663":56744,"_2970":57028},[],"**Organizational Unit (OU)**: department or unit.",{"_3487":2380,"_30445":2266,"_21099":57030,"_5":14424,"_27663":56744,"_2970":57031},[],"**Country (C)**: two-letter country code.",{"_3487":2381,"_30445":2266,"_21099":57033,"_5":14424,"_27663":56744,"_2970":57034},[],"**State / Province (ST)**: state or province.",{"_3487":2382,"_30445":2266,"_21099":57036,"_5":14424,"_27663":56744,"_2970":57037},[],"**Locality (L)**: city or locality.",{"_3487":2383,"_30445":2266,"_21099":57039,"_5":14424,"_27663":56744,"_2970":57040},[],"**Email Address**: contact email.",{"_3487":2384,"_30445":2266,"_21099":57042,"_5":14424,"_27663":56744,"_2970":57043},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3487":2385,"_30445":2266,"_21099":57045,"_5":14424,"_27663":56744,"_2970":57046},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3487":2386,"_30445":2266,"_21099":57048,"_5":14424,"_27663":56748,"_2970":57049},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3487":2387,"_30445":2266,"_21099":57051,"_5":14424,"_27663":56748,"_2970":57052},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3487":2388,"_30445":2266,"_21099":57054,"_5":14424,"_27663":56752,"_2970":57055},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3487":2389,"_30445":2266,"_21099":57057,"_5":14424,"_27663":56752,"_2970":57058},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3487":2390,"_30445":2390,"_5":14788,"_2970":57060,"_30797":57061,"_21099":57062,"_27663":2390},"Online validation with OCSP",[49622,51161,55166,55805],[],{"_3487":2391,"_30445":2390,"_21099":57064,"_5":14424,"_27663":2390,"_2970":57065},[],"Query signed status and verify the responder’s response.",{"_3487":2392,"_30445":2390,"_5":30794,"_21099":57067,"_27663":57068,"_2970":57069},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3487":2393,"_30445":2390,"_5":30794,"_21099":57071,"_27663":57072,"_2970":57073},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3487":2394,"_30445":2390,"_5":30794,"_21099":57075,"_27663":57076,"_2970":57077},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3487":2395,"_30445":2390,"_5":30794,"_21099":57079,"_27663":57080,"_2970":57081},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3487":2396,"_30445":2390,"_5":30794,"_21099":57083,"_27663":57084,"_2970":57085},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3487":2397,"_30445":2390,"_5":30794,"_21099":57087,"_27663":57088,"_2970":56370},[],"/docs/pr-preview/pr-68/platform/pki/ocsp#references",{"_3487":2398,"_30445":2390,"_21099":57090,"_5":14424,"_27663":2390,"_2970":57091},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3487":2399,"_30445":2390,"_21099":57093,"_5":14424,"_27663":57068,"_2970":57094},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3487":2400,"_30445":2390,"_21099":57096,"_5":14424,"_27663":57068,"_2970":57097},[],"Record status",{"_3487":2401,"_30445":2390,"_21099":57099,"_5":14424,"_27663":57068,"_2970":57100},[],"Signed response",{"_3487":2402,"_30445":2390,"_21099":57102,"_5":14424,"_27663":57068,"_2970":54303},[],{"_3487":2403,"_30445":2390,"_21099":57104,"_5":14424,"_27663":57068,"_2970":57105},[],"`Good`.",{"_3487":2404,"_30445":2390,"_21099":57107,"_5":14424,"_27663":57068,"_2970":54320},[],{"_3487":2405,"_30445":2390,"_21099":57109,"_5":14424,"_27663":57068,"_2970":57110},[],"`Revoked`, with revocation reason and timestamp.",{"_3487":2406,"_30445":2390,"_21099":57112,"_5":14424,"_27663":57068,"_2970":57113},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3487":2407,"_30445":2390,"_21099":57115,"_5":14424,"_27663":57068,"_2970":57116},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3487":2408,"_30445":2390,"_21099":57118,"_5":14424,"_27663":57068,"_2970":57119},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3487":2409,"_30445":2390,"_21099":57121,"_5":14424,"_27663":57068,"_2970":57122},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3487":2410,"_30445":2390,"_21099":57124,"_5":14424,"_27663":57068,"_2970":57125},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3487":2411,"_30445":2390,"_21099":57127,"_5":14424,"_27663":57072,"_2970":57128},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3487":2412,"_30445":2390,"_21099":57130,"_5":14424,"_27663":57072,"_2970":57131},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3487":2413,"_30445":2390,"_21099":57133,"_5":14424,"_27663":57076,"_2970":57134},[],"The service accepts:",{"_3487":2414,"_30445":2390,"_21099":57136,"_5":14424,"_27663":57076,"_2970":52931},[],{"_3487":2415,"_30445":2390,"_21099":57138,"_5":14424,"_27663":57076,"_2970":57139},[],"VA service path",{"_3487":2416,"_30445":2390,"_21099":57141,"_5":14424,"_27663":57076,"_2970":57142},[],"Format",{"_3487":2417,"_30445":2390,"_21099":57144,"_5":14424,"_27663":57076,"_2970":57145},[],"`POST`",{"_3487":2418,"_30445":2390,"_21099":57147,"_5":14424,"_27663":57076,"_2970":57148},[],"`/ocsp`",{"_3487":2419,"_30445":2390,"_21099":57150,"_5":14424,"_27663":57076,"_2970":57151},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3487":2420,"_30445":2390,"_21099":57153,"_5":14424,"_27663":57076,"_2970":56552},[],{"_3487":2421,"_30445":2390,"_21099":57155,"_5":14424,"_27663":57076,"_2970":57156},[],"`/ocsp/{ocsp_request}`",{"_3487":2422,"_30445":2390,"_21099":57158,"_5":14424,"_27663":57076,"_2970":57159},[],"DER request encoded using padded URL Base64.",{"_3487":2423,"_30445":2390,"_21099":57161,"_5":14424,"_27663":57076,"_2970":57162},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3487":2424,"_30445":2390,"_21099":57164,"_5":14424,"_27663":57080,"_2970":57165},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3487":2425,"_30445":2390,"_21099":57167,"_5":14424,"_27663":57080,"_2970":57168},[],"Generate the request:",{"_3487":2426,"_30445":2390,"_21099":57170,"_5":14424,"_27663":57080,"_2970":57171},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3487":2427,"_30445":2390,"_21099":57173,"_5":14424,"_27663":57080,"_2970":57174},[],"Replace the example URL with the inspected endpoint:",{"_3487":2428,"_30445":2390,"_21099":57176,"_5":14424,"_27663":57080,"_2970":57177},[],"Verify the returned DER:",{"_3487":2429,"_30445":2390,"_21099":57179,"_5":14424,"_27663":57080,"_2970":57180},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3487":2430,"_30445":2390,"_21099":57182,"_5":14424,"_27663":57084,"_2970":57183},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3487":2431,"_30445":2390,"_21099":57185,"_5":14424,"_27663":57084,"_2970":57186},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3487":2432,"_30445":2390,"_21099":57188,"_5":14424,"_27663":57088,"_2970":57189},[],"RFC 6960: OCSP.",{"_3487":2433,"_30445":2390,"_21099":57191,"_5":14424,"_27663":57088,"_2970":57192},[],"OpenSSL: openssl-ocsp.",{"_3487":2434,"_30445":2390,"_21099":57194,"_5":14424,"_27663":57088,"_2970":57195},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3487":2435,"_30445":2390,"_21099":57197,"_5":14424,"_27663":57088,"_2970":56666},[],{"_3487":2436,"_30445":2436,"_5":14788,"_2970":55166,"_30797":57199,"_21099":57200,"_27663":2436},[49622,51161,55166],[],{"_3487":2437,"_30445":2436,"_21099":57202,"_5":14424,"_27663":2436,"_2970":57203},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3487":2438,"_30445":2436,"_5":30794,"_21099":57205,"_27663":57206,"_2970":54478},[],"/docs/pr-preview/pr-68/platform/pki/overview#start-here",{"_3487":2439,"_30445":2436,"_5":30794,"_21099":57208,"_27663":57209,"_2970":57210},[],"/docs/pr-preview/pr-68/platform/pki/overview#what-you-need","What you need",{"_3487":2440,"_30445":2436,"_5":30794,"_21099":57212,"_27663":57213,"_2970":55010},[],"/docs/pr-preview/pr-68/platform/pki/overview#core-capabilities",{"_3487":2441,"_30445":2436,"_5":30794,"_21099":57215,"_27663":57216,"_2970":55014},[],"/docs/pr-preview/pr-68/platform/pki/overview#build-your-trust-hierarchy",{"_3487":2442,"_30445":2436,"_5":30794,"_21099":57218,"_27663":57219,"_2970":55018},[],"/docs/pr-preview/pr-68/platform/pki/overview#protect-cryptographic-keys",{"_3487":2443,"_30445":2436,"_5":30794,"_21099":57221,"_27663":57222,"_2970":55022},[],"/docs/pr-preview/pr-68/platform/pki/overview#issue-and-control-certificates",{"_3487":2444,"_30445":2436,"_5":30794,"_21099":57224,"_27663":57225,"_2970":55030},[],"/docs/pr-preview/pr-68/platform/pki/overview#publish-validation-status",{"_3487":2445,"_30445":2436,"_5":30794,"_21099":57227,"_27663":57228,"_2970":57229},[],"/docs/pr-preview/pr-68/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3487":2446,"_30445":2436,"_5":30794,"_21099":57231,"_27663":57232,"_2970":55972},[],"/docs/pr-preview/pr-68/platform/pki/overview#continue",{"_3487":2447,"_30445":2436,"_21099":57234,"_5":14424,"_27663":2436,"_2970":57235},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3487":2448,"_30445":2436,"_21099":57237,"_5":14424,"_27663":57206,"_2970":57238},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3487":2449,"_30445":2436,"_21099":57240,"_5":14424,"_27663":57206,"_2970":57241},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3487":2450,"_30445":2436,"_21099":57243,"_5":14424,"_27663":57209,"_2970":57244},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3487":2451,"_30445":2436,"_21099":57246,"_5":14424,"_27663":57209,"_2970":57247},[],"An available cryptographic engine to keep the authority's key.",{"_3487":2452,"_30445":2436,"_21099":57249,"_5":14424,"_27663":57209,"_2970":57250},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3487":2453,"_30445":2436,"_21099":57252,"_5":14424,"_27663":57209,"_2970":57253},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3487":2454,"_30445":2436,"_21099":57255,"_5":14424,"_27663":57209,"_2970":57256},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3487":2455,"_30445":2436,"_21099":57258,"_5":14424,"_27663":57216,"_2970":57259},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3487":2456,"_30445":2436,"_21099":57261,"_5":14424,"_27663":57219,"_2970":57262},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3487":2457,"_30445":2436,"_21099":57264,"_5":14424,"_27663":57222,"_2970":57265},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3487":2458,"_30445":2436,"_21099":57267,"_5":14424,"_27663":57225,"_2970":57268},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3487":2459,"_30445":2436,"_21099":57270,"_5":14424,"_27663":57228,"_2970":57271},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3487":2460,"_30445":2436,"_21099":57273,"_5":14424,"_27663":57228,"_2970":57274},[],"its subject and extensions identify the expected client;",{"_3487":2461,"_30445":2436,"_21099":57276,"_5":14424,"_27663":57228,"_2970":57277},[],"its public key matches the client's private key;",{"_3487":2462,"_30445":2436,"_21099":57279,"_5":14424,"_27663":57228,"_2970":57280},[],"its chain reaches a root trusted by the consumer;",{"_3487":2463,"_30445":2436,"_21099":57282,"_5":14424,"_27663":57228,"_2970":57283},[],"its dates and usages allow the operation;",{"_3487":2464,"_30445":2436,"_21099":57285,"_5":14424,"_27663":57228,"_2970":57286},[],"the consumer applies revocation checks and authorization.",{"_3487":2465,"_30445":2436,"_21099":57288,"_5":14424,"_27663":57228,"_2970":57289},[],"The issuance path includes the first independent checks.",{"_3487":2466,"_30445":2436,"_21099":57291,"_5":14424,"_27663":57232,"_2970":57292},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3487":2467,"_30445":2436,"_21099":57294,"_5":14424,"_27663":57232,"_2970":57295},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3487":2468,"_30445":2436,"_21099":57297,"_5":14424,"_27663":57232,"_2970":57298},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3487":2469,"_30445":2469,"_5":14788,"_2970":57300,"_30797":57301,"_21099":57302,"_27663":2469},"Create your first CA",[49622,51161,55166,54603],[],{"_3487":2470,"_30445":2469,"_21099":57304,"_5":14424,"_27663":2469,"_2970":57305},[],"Create an evaluation root and check its certificate before issuing.",{"_3487":2471,"_30445":2469,"_5":30794,"_21099":57307,"_27663":57308,"_2970":49632},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3487":2472,"_30445":2469,"_5":30794,"_21099":57310,"_27663":57311,"_2970":57312},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3487":2473,"_30445":2469,"_5":30794,"_21099":57314,"_27663":57315,"_2970":57316},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3487":2474,"_30445":2469,"_5":30794,"_21099":57318,"_27663":57319,"_2970":57320},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3487":2475,"_30445":2469,"_5":30794,"_21099":57322,"_27663":57323,"_2970":57324},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3487":2476,"_30445":2469,"_5":30794,"_21099":57326,"_27663":57327,"_2970":57328},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3487":2477,"_30445":2469,"_5":30794,"_21099":57330,"_27663":57331,"_2970":57332},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3487":2478,"_30445":2469,"_5":30794,"_21099":57334,"_27663":57335,"_2970":54860},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3487":2479,"_30445":2469,"_5":30794,"_21099":57337,"_27663":57338,"_2970":49656},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3487":2480,"_30445":2469,"_21099":57340,"_5":14424,"_27663":2469,"_2970":57341},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3487":2481,"_30445":2469,"_21099":57343,"_5":14424,"_27663":57308,"_2970":57344},[],"Console access and permission to create keys and authorities.",{"_3487":2482,"_30445":2469,"_21099":57346,"_5":14424,"_27663":57308,"_2970":57347},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3487":2483,"_30445":2469,"_21099":57349,"_5":14424,"_27663":57308,"_2970":57350},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3487":2484,"_30445":2469,"_21099":57352,"_5":14424,"_27663":57308,"_2970":57353},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3487":2485,"_30445":2469,"_21099":57355,"_5":14424,"_27663":57311,"_2970":57356},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3487":2486,"_30445":2469,"_21099":57358,"_5":14424,"_27663":57311,"_2970":57359},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3487":2487,"_30445":2469,"_21099":57361,"_5":14424,"_27663":57315,"_2970":57362},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3487":2488,"_30445":2469,"_21099":57364,"_5":14424,"_27663":57315,"_2970":57365},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3487":2489,"_30445":2469,"_21099":57367,"_5":14424,"_27663":57319,"_2970":57368},[],"Select **Root CA** and complete:",{"_3487":2490,"_30445":2469,"_21099":57370,"_5":14424,"_27663":57319,"_2970":57371},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3487":2491,"_30445":2469,"_21099":57373,"_5":14424,"_27663":57319,"_2970":57374},[],"**Subject**: organization and country details for your evaluation.",{"_3487":2492,"_30445":2469,"_21099":57376,"_5":14424,"_27663":57319,"_2970":57377},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3487":2493,"_30445":2469,"_21099":57379,"_5":14424,"_27663":57319,"_2970":57380},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3487":2494,"_30445":2469,"_21099":57382,"_5":14424,"_27663":57319,"_2970":57383},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3487":2495,"_30445":2469,"_21099":57385,"_5":14424,"_27663":57323,"_2970":57386},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3487":2496,"_30445":2469,"_21099":57388,"_5":14424,"_27663":57327,"_2970":57389},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3487":2497,"_30445":2469,"_21099":57391,"_5":14424,"_27663":57327,"_2970":57392},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3487":2498,"_30445":2469,"_21099":57394,"_5":14424,"_27663":57331,"_2970":57395},[],"Run from the directory where you saved `ca.pem`:",{"_3487":2499,"_30445":2469,"_21099":57397,"_5":14424,"_27663":57331,"_2970":57398},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3487":2500,"_30445":2469,"_21099":57400,"_5":14424,"_27663":57331,"_2970":57401},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3487":2501,"_30445":2469,"_21099":57403,"_5":14424,"_27663":57335,"_2970":57404},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3487":2502,"_30445":2469,"_21099":57406,"_5":14424,"_27663":57335,"_2970":57407},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3487":2503,"_30445":2469,"_21099":57409,"_5":14424,"_27663":57335,"_2970":57410},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3487":2504,"_30445":2469,"_21099":57412,"_5":14424,"_27663":57335,"_2970":57413},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3487":2505,"_30445":2469,"_21099":57415,"_5":14424,"_27663":57338,"_2970":57416},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3487":2506,"_30445":2506,"_5":14788,"_2970":57418,"_30797":57419,"_21099":57420,"_27663":2506},"Issue and verify a certificate",[49622,51161,55166,54603],[],{"_3487":2507,"_30445":2506,"_21099":57422,"_5":14424,"_27663":2506,"_2970":57423},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3487":2508,"_30445":2506,"_5":30794,"_21099":57425,"_27663":57426,"_2970":49632},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3487":2509,"_30445":2506,"_5":30794,"_21099":57428,"_27663":57429,"_2970":57430},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3487":2510,"_30445":2506,"_5":30794,"_21099":57432,"_27663":57433,"_2970":57434},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3487":2511,"_30445":2506,"_5":30794,"_21099":57436,"_27663":57437,"_2970":57438},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3487":2512,"_30445":2506,"_5":30794,"_21099":57440,"_27663":57441,"_2970":57442},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3487":2513,"_30445":2506,"_5":30794,"_21099":57444,"_27663":57445,"_2970":57446},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3487":2514,"_30445":2506,"_5":30794,"_21099":57448,"_27663":57449,"_2970":57450},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3487":2515,"_30445":2506,"_5":30794,"_21099":57452,"_27663":57453,"_2970":57454},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3487":2516,"_30445":2506,"_5":30794,"_21099":57456,"_27663":57457,"_2970":57458},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3487":2517,"_30445":2506,"_5":30794,"_21099":57460,"_27663":57461,"_2970":57462},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3487":2518,"_30445":2506,"_5":30794,"_21099":57464,"_27663":57465,"_2970":54860},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3487":2519,"_30445":2506,"_5":30794,"_21099":57467,"_27663":57468,"_2970":49656},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/issue-certificate#next-step",{"_3487":2520,"_30445":2506,"_21099":57470,"_5":14424,"_27663":2506,"_2970":57471},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3487":2521,"_30445":2506,"_21099":57473,"_5":14424,"_27663":57426,"_2970":57474},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3487":2522,"_30445":2506,"_21099":57476,"_5":14424,"_27663":57426,"_2970":57477},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3487":2523,"_30445":2506,"_21099":57479,"_5":14424,"_27663":57426,"_2970":57480},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3487":2524,"_30445":2506,"_21099":57482,"_5":14424,"_27663":57426,"_2970":57483},[],"A client identifier: here we use `device-001`.",{"_3487":2525,"_30445":2506,"_21099":57485,"_5":14424,"_27663":57426,"_2970":57486},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3487":2526,"_30445":2506,"_21099":57488,"_5":14424,"_27663":57429,"_2970":57489},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3487":2527,"_30445":2506,"_21099":57491,"_5":14424,"_27663":57433,"_2970":57492},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3487":2528,"_30445":2506,"_21099":57494,"_5":14424,"_27663":57433,"_2970":57495},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3487":2529,"_30445":2506,"_21099":57497,"_5":14424,"_27663":57437,"_2970":57498},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3487":2530,"_30445":2506,"_21099":57500,"_5":14424,"_27663":57437,"_2970":57501},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3487":2531,"_30445":2506,"_21099":57503,"_5":14424,"_27663":57441,"_2970":57504},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3487":2532,"_30445":2506,"_21099":57506,"_5":14424,"_27663":57441,"_2970":57507},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3487":2533,"_30445":2506,"_21099":57509,"_5":14424,"_27663":57445,"_2970":57510},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3487":2534,"_30445":2506,"_21099":57512,"_5":14424,"_27663":57449,"_2970":57513},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3487":2535,"_30445":2506,"_21099":57515,"_5":14424,"_27663":57453,"_2970":57516},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3487":2536,"_30445":2506,"_21099":57518,"_5":14424,"_27663":57457,"_2970":57519},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3487":2537,"_30445":2506,"_21099":57521,"_5":14424,"_27663":57457,"_2970":57522},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3487":2538,"_30445":2506,"_21099":57524,"_5":14424,"_27663":57457,"_2970":57525},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3487":2539,"_30445":2506,"_21099":57527,"_5":14424,"_27663":57461,"_2970":57528},[],"In Bash, compare the two public-key digests:",{"_3487":2540,"_30445":2506,"_21099":57530,"_5":14424,"_27663":57461,"_2970":57531},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3487":2541,"_30445":2506,"_21099":57533,"_5":14424,"_27663":57461,"_2970":57534},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3487":2542,"_30445":2506,"_21099":57536,"_5":14424,"_27663":57465,"_2970":54944},[],{"_3487":2543,"_30445":2506,"_21099":57538,"_5":14424,"_27663":57465,"_2970":57539},[],"What to review",{"_3487":2544,"_30445":2506,"_21099":57541,"_5":14424,"_27663":57465,"_2970":57542},[],"The CA rejects issuance",{"_3487":2545,"_30445":2506,"_21099":57544,"_5":14424,"_27663":57465,"_2970":57545},[],"Permissions, CA state and key, algorithm and profile.",{"_3487":2546,"_30445":2506,"_21099":57547,"_5":14424,"_27663":57465,"_2970":57548},[],"Different subject or usages",{"_3487":2547,"_30445":2506,"_21099":57550,"_5":14424,"_27663":57465,"_2970":57551},[],"Applied profile and requested values.",{"_3487":2548,"_30445":2506,"_21099":57553,"_5":14424,"_27663":57465,"_2970":57554},[],"Issuer cannot be found",{"_3487":2549,"_30445":2506,"_21099":57556,"_5":14424,"_27663":57465,"_2970":57557},[],"Downloaded CA and required intermediate chain.",{"_3487":2550,"_30445":2506,"_21099":57559,"_5":14424,"_27663":57465,"_2970":57560},[],"Validity fails",{"_3487":2551,"_30445":2506,"_21099":57562,"_5":14424,"_27663":57465,"_2970":57563},[],"Certificate and CA dates, and the computer's clock.",{"_3487":2552,"_30445":2506,"_21099":57565,"_5":14424,"_27663":57465,"_2970":57566},[],"Public-key digests differ",{"_3487":2553,"_30445":2506,"_21099":57568,"_5":14424,"_27663":57465,"_2970":57569},[],"Certificate and key files from the same issuance.",{"_3487":2554,"_30445":2506,"_21099":57571,"_5":14424,"_27663":57465,"_2970":57572},[],"See PKI diagnostics to narrow an issuance failure.",{"_3487":2555,"_30445":2506,"_21099":57574,"_5":14424,"_27663":57468,"_2970":57575},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3487":2556,"_30445":2506,"_21099":57577,"_5":14424,"_27663":57468,"_2970":57578},[],"Manage certificates for inspection, status and revocation.",{"_3487":2557,"_30445":2506,"_21099":57580,"_5":14424,"_27663":57468,"_2970":57581},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3487":2558,"_30445":2506,"_21099":57583,"_5":14424,"_27663":57468,"_2970":57584},[],"Prepare EST for the device to request its next identities.",{"_3487":2559,"_30445":2506,"_21099":57586,"_5":14424,"_27663":57468,"_2970":57587},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3487":2560,"_30445":2560,"_5":14788,"_2970":57589,"_30797":57590,"_21099":57591,"_27663":2560},"PKI getting started",[49622,51161,55166,54603],[],{"_3487":2561,"_30445":2560,"_21099":57593,"_5":14424,"_27663":2560,"_2970":57594},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3487":2562,"_30445":2560,"_5":30794,"_21099":57596,"_27663":57597,"_2970":49632},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#before-you-begin",{"_3487":2563,"_30445":2560,"_5":30794,"_21099":57599,"_27663":57600,"_2970":57601},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3487":2564,"_30445":2560,"_5":30794,"_21099":57603,"_27663":57604,"_2970":54795},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#expected-result",{"_3487":2565,"_30445":2560,"_5":30794,"_21099":57606,"_27663":57607,"_2970":57608},[],"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3487":2566,"_30445":2560,"_21099":57610,"_5":14424,"_27663":2560,"_2970":57611},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3487":2567,"_30445":2560,"_21099":57613,"_5":14424,"_27663":57597,"_2970":57614},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3487":2568,"_30445":2560,"_21099":57616,"_5":14424,"_27663":57597,"_2970":57617},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3487":2569,"_30445":2560,"_21099":57619,"_5":14424,"_27663":57597,"_2970":57620},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3487":2570,"_30445":2560,"_21099":57622,"_5":14424,"_27663":57597,"_2970":57623},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3487":2571,"_30445":2560,"_21099":57625,"_5":14424,"_27663":57597,"_2970":57626},[],"A working directory with restricted access for the downloaded key.",{"_3487":2572,"_30445":2560,"_21099":57628,"_5":14424,"_27663":57600,"_2970":57629},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3487":2573,"_30445":2560,"_21099":57631,"_5":14424,"_27663":57600,"_2970":57632},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3487":2574,"_30445":2560,"_21099":57634,"_5":14424,"_27663":57600,"_2970":57635},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3487":2575,"_30445":2560,"_21099":57637,"_5":14424,"_27663":57600,"_2970":57638},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3487":2576,"_30445":2560,"_21099":57640,"_5":14424,"_27663":57604,"_2970":57641},[],"File or resource",{"_3487":2577,"_30445":2560,"_21099":57643,"_5":14424,"_27663":57604,"_2970":54792},[],{"_3487":2578,"_30445":2560,"_21099":57645,"_5":14424,"_27663":57604,"_2970":57646},[],"Active root CA and `ca.pem`",{"_3487":2579,"_30445":2560,"_21099":57648,"_5":14424,"_27663":57604,"_2970":57649},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3487":2580,"_30445":2560,"_21099":57651,"_5":14424,"_27663":57604,"_2970":57652},[],"End-entity certificate and `device.crt`",{"_3487":2581,"_30445":2560,"_21099":57654,"_5":14424,"_27663":57604,"_2970":57655},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3487":2582,"_30445":2560,"_21099":57657,"_5":14424,"_27663":57604,"_2970":57658},[],"Private key `device.key`",{"_3487":2583,"_30445":2560,"_21099":57660,"_5":14424,"_27663":57604,"_2970":57661},[],"Its public key matches the one included in `device.crt`.",{"_3487":2584,"_30445":2560,"_21099":57663,"_5":14424,"_27663":57604,"_2970":57664},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3487":2585,"_30445":2560,"_21099":57666,"_5":14424,"_27663":57607,"_2970":57667},[],"To operate certificates, continue with Certificates and Validation.",{"_3487":2586,"_30445":2560,"_21099":57669,"_5":14424,"_27663":57607,"_2970":57670},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3487":2587,"_30445":2560,"_21099":57672,"_5":14424,"_27663":57607,"_2970":57673},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3487":2588,"_30445":2588,"_5":14788,"_2970":57675,"_30797":57676,"_21099":57677,"_27663":2588},"PKI troubleshooting",[49622,51161,55166,53741],[],{"_3487":2589,"_30445":2588,"_21099":57679,"_5":14424,"_27663":2588,"_2970":57680},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3487":2590,"_30445":2588,"_5":30794,"_21099":57682,"_27663":57683,"_2970":57684},[],"/docs/pr-preview/pr-68/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3487":2591,"_30445":2588,"_5":30794,"_21099":57686,"_27663":57687,"_2970":57688},[],"/docs/pr-preview/pr-68/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3487":2592,"_30445":2588,"_5":30794,"_21099":57690,"_27663":57691,"_2970":57692},[],"/docs/pr-preview/pr-68/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3487":2593,"_30445":2588,"_21099":57694,"_5":14424,"_27663":2588,"_2970":57695},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3487":2594,"_30445":2588,"_21099":57697,"_5":14424,"_27663":2588,"_2970":57698},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3487":2595,"_30445":2588,"_21099":57700,"_5":14424,"_27663":57683,"_2970":54792},[],{"_3487":2596,"_30445":2588,"_21099":57702,"_5":14424,"_27663":57683,"_2970":57703},[],"What to inspect",{"_3487":2597,"_30445":2588,"_21099":57705,"_5":14424,"_27663":57683,"_2970":49656},[],{"_3487":2598,"_30445":2588,"_21099":57707,"_5":14424,"_27663":57683,"_2970":54008},[],{"_3487":2599,"_30445":2588,"_21099":57709,"_5":14424,"_27663":57683,"_2970":57710},[],"Exists, is active and has usable dates.",{"_3487":2600,"_30445":2588,"_21099":57712,"_5":14424,"_27663":57683,"_2970":57713},[],"Authorities.",{"_3487":2601,"_30445":2588,"_21099":57715,"_5":14424,"_27663":57683,"_2970":57716},[],"Key",{"_3487":2602,"_30445":2588,"_21099":57718,"_5":14424,"_27663":57683,"_2970":57719},[],"The record has a usable private key and the engine can sign.",{"_3487":2603,"_30445":2588,"_21099":57721,"_5":14424,"_27663":57683,"_2970":57722},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3487":2604,"_30445":2588,"_21099":57724,"_5":14424,"_27663":57683,"_2970":57725},[],"CSR",{"_3487":2605,"_30445":2588,"_21099":57727,"_5":14424,"_27663":57683,"_2970":57728},[],"Correct PEM and verifiable signature.",{"_3487":2606,"_30445":2588,"_21099":57730,"_5":14424,"_27663":57683,"_2970":57731},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3487":2607,"_30445":2588,"_21099":57733,"_5":14424,"_27663":57683,"_2970":57734},[],"Profile",{"_3487":2608,"_30445":2588,"_21099":57736,"_5":14424,"_27663":57683,"_2970":57737},[],"Selected source, existing ID, allowed algorithm and size.",{"_3487":2609,"_30445":2588,"_21099":57739,"_5":14424,"_27663":57683,"_2970":57740},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3487":2610,"_30445":2588,"_21099":57742,"_5":14424,"_27663":57683,"_2970":54944},[],{"_3487":2611,"_30445":2588,"_21099":57744,"_5":14424,"_27663":57683,"_2970":57745},[],"Appropriate subject, SAN, usages and dates.",{"_3487":2612,"_30445":2588,"_21099":57747,"_5":14424,"_27663":57683,"_2970":57748},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3487":2613,"_30445":2588,"_21099":57750,"_5":14424,"_27663":57683,"_2970":57751},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3487":2614,"_30445":2588,"_21099":57753,"_5":14424,"_27663":57683,"_2970":57754},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3487":2615,"_30445":2588,"_21099":57756,"_5":14424,"_27663":57687,"_2970":57757},[],"Check each boundary independently:",{"_3487":2616,"_30445":2588,"_21099":57759,"_5":14424,"_27663":57687,"_2970":57760},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3487":2617,"_30445":2588,"_21099":57762,"_5":14424,"_27663":57687,"_2970":57763},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3487":2618,"_30445":2588,"_21099":57765,"_5":14424,"_27663":57687,"_2970":57766},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3487":2619,"_30445":2588,"_21099":57768,"_5":14424,"_27663":57687,"_2970":57769},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3487":2620,"_30445":2588,"_21099":57771,"_5":14424,"_27663":57687,"_2970":57772},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3487":2621,"_30445":2588,"_21099":57774,"_5":14424,"_27663":57687,"_2970":57775},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3487":2622,"_30445":2588,"_21099":57777,"_5":14424,"_27663":57691,"_2970":57778},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3487":2623,"_30445":2588,"_21099":57780,"_5":14424,"_27663":57691,"_2970":57781},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3487":2624,"_30445":2624,"_5":14788,"_2970":57783,"_30797":57784,"_21099":57785,"_27663":2624},"Security",[49622],[],{"_3487":2625,"_30445":2624,"_21099":57787,"_5":14424,"_27663":2624,"_2970":57788},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3487":2626,"_30445":2624,"_5":30794,"_21099":57790,"_27663":57791,"_2970":57792},[],"/docs/pr-preview/pr-68/security#report-a-vulnerability","Report a vulnerability",{"_3487":2627,"_30445":2624,"_5":30794,"_21099":57794,"_27663":57795,"_2970":57796},[],"/docs/pr-preview/pr-68/security#what-to-include-in-a-report","What to include in a report",{"_3487":2628,"_30445":2624,"_5":30794,"_21099":57798,"_27663":57799,"_2970":57800},[],"/docs/pr-preview/pr-68/security#supported-versions","Supported versions",{"_3487":2629,"_30445":2624,"_5":30794,"_21099":57802,"_27663":57803,"_2970":57804},[],"/docs/pr-preview/pr-68/security#responsible-disclosure","Responsible disclosure",{"_3487":2630,"_30445":2624,"_21099":57806,"_5":14424,"_27663":2624,"_2970":57807},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3487":2631,"_30445":2624,"_21099":57809,"_5":14424,"_27663":57791,"_2970":57810},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3487":2632,"_30445":2624,"_21099":57812,"_5":14424,"_27663":57791,"_2970":57813},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3487":2633,"_30445":2624,"_21099":57815,"_5":14424,"_27663":57791,"_2970":15158},[],{"_3487":2634,"_30445":2624,"_21099":57817,"_5":14424,"_27663":57791,"_2970":15000},[],{"_3487":2635,"_30445":2624,"_21099":57819,"_5":14424,"_27663":57791,"_2970":15047},[],{"_3487":2636,"_30445":2624,"_21099":57821,"_5":14424,"_27663":57791,"_2970":57822},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3487":2637,"_30445":2624,"_21099":57824,"_5":14424,"_27663":57791,"_2970":57825},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3487":2638,"_30445":2624,"_21099":57827,"_5":14424,"_27663":57795,"_2970":57828},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3487":2639,"_30445":2624,"_21099":57830,"_5":14424,"_27663":57795,"_2970":57831},[],"Do not include in the report:",{"_3487":2640,"_30445":2624,"_21099":57833,"_5":14424,"_27663":57795,"_2970":57834},[],"Credentials, tokens, or private keys",{"_3487":2641,"_30445":2624,"_21099":57836,"_5":14424,"_27663":57795,"_2970":57837},[],"Customer data or customer-identifiable information",{"_3487":2642,"_30445":2624,"_21099":57839,"_5":14424,"_27663":57795,"_2970":57840},[],"Confidential architecture or internal infrastructure details",{"_3487":2643,"_30445":2624,"_21099":57842,"_5":14424,"_27663":57799,"_2970":57843},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3487":2644,"_30445":2624,"_21099":57845,"_5":14424,"_27663":57799,"_2970":57846},[],"For upgrade guidance, see Upgrades.",{"_3487":2645,"_30445":2624,"_21099":57848,"_5":14424,"_27663":57803,"_2970":57849},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3487":2646,"_30445":2624,"_21099":57851,"_5":14424,"_27663":57803,"_2970":57852},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3487":2647,"_30445":2624,"_21099":57854,"_5":14424,"_27663":57803,"_2970":57855},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3487":2648,"_30445":2624,"_21099":57857,"_5":14424,"_27663":57803,"_2970":57858},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3487":2649,"_30445":2624,"_21099":57860,"_5":14424,"_27663":57803,"_2970":57861},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3487":2650,"_30445":2650,"_5":14788,"_2970":57863,"_30797":57864,"_21099":57866,"_27663":2650},"3.8.0 to 4.0.0",[49622,57865],"Upgrades",[],{"_3487":2651,"_30445":2650,"_21099":57868,"_5":14424,"_27663":2650,"_2970":57869},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3487":2652,"_30445":2650,"_5":30794,"_21099":57871,"_27663":57872,"_2970":57873},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3487":2653,"_30445":2650,"_5":30794,"_21099":57875,"_27663":57876,"_2970":57877},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3487":2654,"_30445":2650,"_5":30794,"_21099":57879,"_27663":57880,"_2970":57881},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3487":2655,"_30445":2650,"_5":30794,"_21099":57883,"_27663":57884,"_2970":57885},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3487":2656,"_30445":2650,"_5":30794,"_21099":57887,"_27663":57888,"_2970":57889},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3487":2657,"_30445":2650,"_5":30794,"_21099":57891,"_27663":57892,"_2970":57893},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3487":2658,"_30445":2650,"_5":30794,"_21099":57895,"_27663":57896,"_2970":57897},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3487":2659,"_30445":2650,"_5":30794,"_21099":57899,"_27663":57900,"_2970":57901},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3487":2660,"_30445":2650,"_5":30794,"_21099":57903,"_27663":57904,"_2970":57905},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3487":2661,"_30445":2650,"_5":30794,"_21099":57907,"_27663":57908,"_2970":57909},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3487":2662,"_30445":2650,"_5":30794,"_21099":57911,"_27663":57912,"_2970":57913},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3487":2663,"_30445":2650,"_5":30794,"_21099":57915,"_27663":57916,"_2970":57917},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3487":2664,"_30445":2650,"_5":30794,"_21099":57919,"_27663":57920,"_2970":57921},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3487":2665,"_30445":2650,"_5":30794,"_21099":57923,"_27663":57924,"_2970":57925},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3487":2666,"_30445":2650,"_5":30794,"_21099":57927,"_27663":57928,"_2970":57929},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3487":2667,"_30445":2650,"_5":30794,"_21099":57931,"_27663":57932,"_2970":57933},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3487":2668,"_30445":2650,"_5":30794,"_21099":57935,"_27663":57936,"_2970":57937},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3487":2669,"_30445":2650,"_5":30794,"_21099":57939,"_27663":57940,"_2970":57941},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3487":2670,"_30445":2650,"_5":30794,"_21099":57943,"_27663":57944,"_2970":57945},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3487":2671,"_30445":2650,"_5":30794,"_21099":57947,"_27663":57948,"_2970":57949},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3487":2672,"_30445":2650,"_5":30794,"_21099":57951,"_27663":57952,"_2970":57953},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3487":2673,"_30445":2650,"_5":30794,"_21099":57955,"_27663":57956,"_2970":57957},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3487":2674,"_30445":2650,"_5":30794,"_21099":57959,"_27663":57960,"_2970":57961},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3487":2675,"_30445":2650,"_5":30794,"_21099":57963,"_27663":57964,"_2970":57965},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3487":2676,"_30445":2650,"_5":30794,"_21099":57967,"_27663":57968,"_2970":57969},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3487":2677,"_30445":2650,"_5":30794,"_21099":57971,"_27663":57972,"_2970":57973},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3487":2678,"_30445":2650,"_5":30794,"_21099":57975,"_27663":57976,"_2970":57977},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3487":2679,"_30445":2650,"_5":30794,"_21099":57979,"_27663":57980,"_2970":57981},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3487":2680,"_30445":2650,"_5":30794,"_21099":57983,"_27663":57984,"_2970":57985},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3487":2681,"_30445":2650,"_5":30794,"_21099":57987,"_27663":57988,"_2970":57989},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3487":2682,"_30445":2650,"_5":30794,"_21099":57991,"_27663":57992,"_2970":57993},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3487":2683,"_30445":2650,"_5":30794,"_21099":57995,"_27663":57996,"_2970":57997},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3487":2684,"_30445":2650,"_5":30794,"_21099":57999,"_27663":58000,"_2970":58001},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3487":2685,"_30445":2650,"_5":30794,"_21099":58003,"_27663":58004,"_2970":58005},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3487":2686,"_30445":2650,"_5":30794,"_21099":58007,"_27663":58008,"_2970":58009},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3487":2687,"_30445":2650,"_5":30794,"_21099":58011,"_27663":58012,"_2970":58013},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3487":2688,"_30445":2650,"_5":30794,"_21099":58015,"_27663":58016,"_2970":58017},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3487":2689,"_30445":2650,"_5":30794,"_21099":58019,"_27663":58020,"_2970":58021},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3487":2690,"_30445":2650,"_5":30794,"_21099":58023,"_27663":58024,"_2970":58025},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3487":2691,"_30445":2650,"_5":30794,"_21099":58027,"_27663":58028,"_2970":58029},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3487":2692,"_30445":2650,"_5":30794,"_21099":58031,"_27663":58032,"_2970":53741},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3487":2693,"_30445":2650,"_5":30794,"_21099":58034,"_27663":58035,"_2970":58036},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3487":2694,"_30445":2650,"_5":30794,"_21099":58038,"_27663":58039,"_2970":58040},[],"/docs/pr-preview/pr-68/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3487":2695,"_30445":2650,"_21099":58042,"_5":14424,"_27663":2650,"_2970":58043},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3487":2696,"_30445":2650,"_21099":58045,"_5":14424,"_27663":2650,"_2970":58046},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3487":2697,"_30445":2650,"_21099":58048,"_5":14424,"_27663":2650,"_2970":58049},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3487":2698,"_30445":2650,"_21099":58051,"_5":14424,"_27663":2650,"_2970":58052},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3487":2699,"_30445":2650,"_21099":58054,"_5":14424,"_27663":2650,"_2970":58055},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3487":2700,"_30445":2650,"_21099":58057,"_5":14424,"_27663":2650,"_2970":58058},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3487":2701,"_30445":2650,"_21099":58060,"_5":14424,"_27663":2650,"_2970":58061},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3487":2702,"_30445":2650,"_21099":58063,"_5":14424,"_27663":57876,"_2970":58064},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3487":2703,"_30445":2650,"_21099":58066,"_5":14424,"_27663":57876,"_2970":58067},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3487":2704,"_30445":2650,"_21099":58069,"_5":14424,"_27663":57880,"_2970":58070},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3487":2705,"_30445":2650,"_21099":58072,"_5":14424,"_27663":57880,"_2970":58073},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3487":2706,"_30445":2650,"_21099":58075,"_5":14424,"_27663":57884,"_2970":58076},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3487":2707,"_30445":2650,"_21099":58078,"_5":14424,"_27663":57888,"_2970":58079},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3487":2708,"_30445":2650,"_21099":58081,"_5":14424,"_27663":57888,"_2970":58082},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3487":2709,"_30445":2650,"_21099":58084,"_5":14424,"_27663":57888,"_2970":58085},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3487":2710,"_30445":2650,"_21099":58087,"_5":14424,"_27663":57888,"_2970":58088},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3487":2711,"_30445":2650,"_21099":58090,"_5":14424,"_27663":57888,"_2970":58091},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3487":2712,"_30445":2650,"_21099":58093,"_5":14424,"_27663":57892,"_2970":58094},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3487":2713,"_30445":2650,"_21099":58096,"_5":14424,"_27663":57892,"_2970":58097},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3487":2714,"_30445":2650,"_21099":58099,"_5":14424,"_27663":57892,"_2970":58100},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3487":2715,"_30445":2650,"_21099":58102,"_5":14424,"_27663":57892,"_2970":58103},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3487":2716,"_30445":2650,"_21099":58105,"_5":14424,"_27663":57892,"_2970":58106},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3487":2717,"_30445":2650,"_21099":58108,"_5":14424,"_27663":57892,"_2970":58109},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3487":2718,"_30445":2650,"_21099":58111,"_5":14424,"_27663":57896,"_2970":58112},[],"Change",{"_3487":2719,"_30445":2650,"_21099":58114,"_5":14424,"_27663":57896,"_2970":58115},[],"Who is affected",{"_3487":2720,"_30445":2650,"_21099":58117,"_5":14424,"_27663":57896,"_2970":58118},[],"Severity",{"_3487":2721,"_30445":2650,"_21099":58120,"_5":14424,"_27663":57896,"_2970":56597},[],{"_3487":2722,"_30445":2650,"_21099":58122,"_5":14424,"_27663":57896,"_2970":57905},[],{"_3487":2723,"_30445":2650,"_21099":58124,"_5":14424,"_27663":57896,"_2970":58125},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3487":2724,"_30445":2650,"_21099":58127,"_5":14424,"_27663":57896,"_2970":58128},[],"High: KMS and VA start on empty volumes",{"_3487":2725,"_30445":2650,"_21099":58130,"_5":14424,"_27663":57896,"_2970":58131},[],"Copy the data into the new volumes",{"_3487":2726,"_30445":2650,"_21099":58133,"_5":14424,"_27663":57896,"_2970":57909},[],{"_3487":2727,"_30445":2650,"_21099":58135,"_5":14424,"_27663":57896,"_2970":58136},[],"Every Helm release",{"_3487":2728,"_30445":2650,"_21099":58138,"_5":14424,"_27663":57896,"_2970":58139},[],"High: `helm upgrade` fails",{"_3487":2729,"_30445":2650,"_21099":58141,"_5":14424,"_27663":57896,"_2970":58142},[],"Remove or rename legacy keys",{"_3487":2730,"_30445":2650,"_21099":58144,"_5":14424,"_27663":57896,"_2970":57913},[],{"_3487":2731,"_30445":2650,"_21099":58146,"_5":14424,"_27663":57896,"_2970":58147},[],"Every deployment",{"_3487":2732,"_30445":2650,"_21099":58149,"_5":14424,"_27663":57896,"_2970":58150},[],"High: without a bootstrap principal there is no administrator",{"_3487":2733,"_30445":2650,"_21099":58152,"_5":14424,"_27663":57896,"_2970":58153},[],"Configure `services.authz`",{"_3487":2734,"_30445":2650,"_21099":58155,"_5":14424,"_27663":57896,"_2970":57917},[],{"_3487":2735,"_30445":2650,"_21099":58157,"_5":14424,"_27663":57896,"_2970":58136},[],{"_3487":2736,"_30445":2650,"_21099":58159,"_5":14424,"_27663":57896,"_2970":58160},[],"High: `helm upgrade` fails on the old keys",{"_3487":2737,"_30445":2650,"_21099":58162,"_5":14424,"_27663":57896,"_2970":58163},[],"Move JWKS and roles into `services.authz`",{"_3487":2738,"_30445":2650,"_21099":58165,"_5":14424,"_27663":57896,"_2970":57937},[],{"_3487":2739,"_30445":2650,"_21099":58167,"_5":14424,"_27663":57896,"_2970":58168},[],"3.8.0 deployments with per-service databases",{"_3487":2740,"_30445":2650,"_21099":58170,"_5":14424,"_27663":57896,"_2970":58171},[],"High: services find no data, or a migration aborts",{"_3487":2741,"_30445":2650,"_21099":58173,"_5":14424,"_27663":57896,"_2970":58174},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3487":2742,"_30445":2650,"_21099":58176,"_5":14424,"_27663":57896,"_2970":57941},[],{"_3487":2743,"_30445":2650,"_21099":58178,"_5":14424,"_27663":57896,"_2970":58179},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3487":2744,"_30445":2650,"_21099":58181,"_5":14424,"_27663":57896,"_2970":58182},[],"High: the backend no longer starts with them",{"_3487":2745,"_30445":2650,"_21099":58184,"_5":14424,"_27663":57896,"_2970":58185},[],"Move to PostgreSQL before upgrading",{"_3487":2746,"_30445":2650,"_21099":58187,"_5":14424,"_27663":57896,"_2970":57985},[],{"_3487":2747,"_30445":2650,"_21099":58189,"_5":14424,"_27663":57896,"_2970":58190},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3487":2748,"_30445":2650,"_21099":58192,"_5":14424,"_27663":57896,"_2970":58193},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3487":2749,"_30445":2650,"_21099":58195,"_5":14424,"_27663":57896,"_2970":58196},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3487":2750,"_30445":2650,"_21099":58198,"_5":14424,"_27663":57896,"_2970":58199},[],"Webhooks with file references",{"_3487":2751,"_30445":2650,"_21099":58201,"_5":14424,"_27663":57896,"_2970":58202},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3487":2752,"_30445":2650,"_21099":58204,"_5":14424,"_27663":57896,"_2970":58205},[],"High: enrollments calling the webhook fail",{"_3487":2753,"_30445":2650,"_21099":58207,"_5":14424,"_27663":57896,"_2970":58208},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3487":2754,"_30445":2650,"_21099":58210,"_5":14424,"_27663":57896,"_2970":57921},[],{"_3487":2755,"_30445":2650,"_21099":58212,"_5":14424,"_27663":57896,"_2970":58213},[],"Releases with per-service identity overrides or mounted key material",{"_3487":2756,"_30445":2650,"_21099":58215,"_5":14424,"_27663":57896,"_2970":58216},[],"Medium: services cannot read their files",{"_3487":2757,"_30445":2650,"_21099":58218,"_5":14424,"_27663":57896,"_2970":58219},[],"Remove the overrides and fix volume ownership",{"_3487":2758,"_30445":2650,"_21099":58221,"_5":14424,"_27663":57896,"_2970":57925},[],{"_3487":2759,"_30445":2650,"_21099":58223,"_5":14424,"_27663":57896,"_2970":58224},[],"Releases that set `amqp.tls`",{"_3487":2760,"_30445":2650,"_21099":58226,"_5":14424,"_27663":57896,"_2970":58227},[],"Medium: clients connect to the wrong port",{"_3487":2761,"_30445":2650,"_21099":58229,"_5":14424,"_27663":57896,"_2970":58230},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3487":2762,"_30445":2650,"_21099":58232,"_5":14424,"_27663":57896,"_2970":57945},[],{"_3487":2763,"_30445":2650,"_21099":58234,"_5":14424,"_27663":57896,"_2970":58235},[],"Installations whose CA keys predate the KMS",{"_3487":2764,"_30445":2650,"_21099":58237,"_5":14424,"_27663":57896,"_2970":58238},[],"Medium: CA keys stay unmanaged",{"_3487":2765,"_30445":2650,"_21099":58240,"_5":14424,"_27663":57896,"_2970":58241},[],"Run the CA-to-KMS migration",{"_3487":2766,"_30445":2650,"_21099":58243,"_5":14424,"_27663":57896,"_2970":58244},[],"Receiver certificate verification",{"_3487":2767,"_30445":2650,"_21099":58246,"_5":14424,"_27663":57896,"_2970":58247},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3487":2768,"_30445":2650,"_21099":58249,"_5":14424,"_27663":57896,"_2970":58250},[],"Medium: credentials go to an unverified receiver",{"_3487":2769,"_30445":2650,"_21099":58252,"_5":14424,"_27663":57896,"_2970":58253},[],"Set `insecure_skip_verify` to `false`",{"_3487":2770,"_30445":2650,"_21099":58255,"_5":14424,"_27663":57896,"_2970":57961},[],{"_3487":2771,"_30445":2650,"_21099":58257,"_5":14424,"_27663":57896,"_2970":58258},[],"Scripts and consoles that edit DMSs through the API",{"_3487":2772,"_30445":2650,"_21099":58260,"_5":14424,"_27663":57896,"_2970":58261},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3487":2773,"_30445":2650,"_21099":58263,"_5":14424,"_27663":57896,"_2970":58264},[],"Read the DMS before editing and use the new field",{"_3487":2774,"_30445":2650,"_21099":58266,"_5":14424,"_27663":57896,"_2970":57981},[],{"_3487":2775,"_30445":2650,"_21099":58268,"_5":14424,"_27663":57896,"_2970":58269},[],"Clients that create or update CRL settings through the API",{"_3487":2776,"_30445":2650,"_21099":58271,"_5":14424,"_27663":57896,"_2970":58272},[],"Medium: requests with the old field return an error",{"_3487":2777,"_30445":2650,"_21099":58274,"_5":14424,"_27663":57896,"_2970":58275},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3487":2778,"_30445":2650,"_21099":58277,"_5":14424,"_27663":57896,"_2970":57989},[],{"_3487":2779,"_30445":2650,"_21099":58279,"_5":14424,"_27663":57896,"_2970":58280},[],"Alert subscriptions and consumers of the VA events",{"_3487":2780,"_30445":2650,"_21099":58282,"_5":14424,"_27663":57896,"_2970":58283},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3487":2781,"_30445":2650,"_21099":58285,"_5":14424,"_27663":57896,"_2970":58286},[],"Review conditions filtering on the old event payload or subject",{"_3487":2782,"_30445":2650,"_21099":58288,"_5":14424,"_27663":57896,"_2970":57977},[],{"_3487":2783,"_30445":2650,"_21099":58290,"_5":14424,"_27663":57896,"_2970":58291},[],"Consumers that read the device `events` field",{"_3487":2784,"_30445":2650,"_21099":58293,"_5":14424,"_27663":57896,"_2970":58294},[],"Medium: the field disappears",{"_3487":2785,"_30445":2650,"_21099":58296,"_5":14424,"_27663":57896,"_2970":58297},[],"Use the new event endpoints",{"_3487":2786,"_30445":2650,"_21099":58299,"_5":14424,"_27663":57896,"_2970":57997},[],{"_3487":2787,"_30445":2650,"_21099":58301,"_5":14424,"_27663":57896,"_2970":58302},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3487":2788,"_30445":2650,"_21099":58304,"_5":14424,"_27663":57896,"_2970":58305},[],"Medium: the VA migration aborts",{"_3487":2789,"_30445":2650,"_21099":58307,"_5":14424,"_27663":57896,"_2970":58308},[],"Fix the affected roles before upgrading",{"_3487":2790,"_30445":2650,"_21099":58310,"_5":14424,"_27663":57896,"_2970":57929},[],{"_3487":2791,"_30445":2650,"_21099":58312,"_5":14424,"_27663":57896,"_2970":58313},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3487":2792,"_30445":2650,"_21099":58315,"_5":14424,"_27663":57896,"_2970":58316},[],"Low to medium: validation errors or changed defaults",{"_3487":2793,"_30445":2650,"_21099":58318,"_5":14424,"_27663":57896,"_2970":58319},[],"Update the values file",{"_3487":2794,"_30445":2650,"_21099":58321,"_5":14424,"_27663":57896,"_2970":57969},[],{"_3487":2795,"_30445":2650,"_21099":58323,"_5":14424,"_27663":57896,"_2970":58324},[],"Clients that send the DMS ID in the update body",{"_3487":2796,"_30445":2650,"_21099":58326,"_5":14424,"_27663":57896,"_2970":58327},[],"Low: the ID in the URL wins",{"_3487":2797,"_30445":2650,"_21099":58329,"_5":14424,"_27663":57896,"_2970":58330},[],"Send the ID in the URL",{"_3487":2798,"_30445":2650,"_21099":58332,"_5":14424,"_27663":57896,"_2970":57993},[],{"_3487":2799,"_30445":2650,"_21099":58334,"_5":14424,"_27663":57896,"_2970":58335},[],"Clients that send an `id` when creating or importing CAs",{"_3487":2800,"_30445":2650,"_21099":58337,"_5":14424,"_27663":57896,"_2970":58338},[],"Low: the ID in the body is ignored, and the field is removed",{"_3487":2801,"_30445":2650,"_21099":58340,"_5":14424,"_27663":57896,"_2970":58341},[],"Let the backend assign the ID and use the returned one",{"_3487":2802,"_30445":2650,"_21099":58343,"_5":14424,"_27663":57896,"_2970":57973},[],{"_3487":2803,"_30445":2650,"_21099":58345,"_5":14424,"_27663":57896,"_2970":58346},[],"Consumers that match on certificate `type`",{"_3487":2804,"_30445":2650,"_21099":58348,"_5":14424,"_27663":57896,"_2970":58349},[],"Low: two values are renamed",{"_3487":2805,"_30445":2650,"_21099":58351,"_5":14424,"_27663":57896,"_2970":58352},[],"Adapt consumers",{"_3487":2806,"_30445":2650,"_21099":58354,"_5":14424,"_27663":57896,"_2970":57965},[],{"_3487":2807,"_30445":2650,"_21099":58356,"_5":14424,"_27663":57896,"_2970":58357},[],"Any DMS",{"_3487":2808,"_30445":2650,"_21099":58359,"_5":14424,"_27663":57896,"_2970":58360},[],"Low: informational",{"_3487":2809,"_30445":2650,"_21099":58362,"_5":14424,"_27663":57896,"_2970":58363},[],"Read both blocks before editing",{"_3487":2810,"_30445":2650,"_21099":58365,"_5":14424,"_27663":57904,"_2970":58366},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3487":2811,"_30445":2650,"_21099":58368,"_5":14424,"_27663":57904,"_2970":58369},[],"Step 4 of the migration guide copies the data.",{"_3487":2812,"_30445":2650,"_21099":58371,"_5":14424,"_27663":57908,"_2970":58372},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3487":2813,"_30445":2650,"_21099":58374,"_5":14424,"_27663":57912,"_2970":58375},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3487":2814,"_30445":2650,"_21099":58377,"_5":14424,"_27663":57916,"_2970":58378},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3487":2815,"_30445":2650,"_21099":58380,"_5":14424,"_27663":57920,"_2970":58381},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3487":2816,"_30445":2650,"_21099":58383,"_5":14424,"_27663":57920,"_2970":58384},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3487":2817,"_30445":2650,"_21099":58386,"_5":14424,"_27663":57924,"_2970":58387},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3487":2818,"_30445":2650,"_21099":58389,"_5":14424,"_27663":57928,"_2970":58390},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3487":2819,"_30445":2650,"_21099":58392,"_5":14424,"_27663":57928,"_2970":58393},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3487":2820,"_30445":2650,"_21099":58395,"_5":14424,"_27663":57928,"_2970":58396},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3487":2821,"_30445":2650,"_21099":58398,"_5":14424,"_27663":57928,"_2970":58399},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3487":2822,"_30445":2650,"_21099":58401,"_5":14424,"_27663":57928,"_2970":58402},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3487":2823,"_30445":2650,"_21099":58404,"_5":14424,"_27663":57928,"_2970":58405},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3487":2824,"_30445":2650,"_21099":58407,"_5":14424,"_27663":57936,"_2970":58408},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3487":2825,"_30445":2650,"_21099":58410,"_5":14424,"_27663":57936,"_2970":58411},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3487":2826,"_30445":2650,"_21099":58413,"_5":14424,"_27663":57936,"_2970":58414},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3487":2827,"_30445":2650,"_21099":58416,"_5":14424,"_27663":57936,"_2970":58417},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3487":2828,"_30445":2650,"_21099":58419,"_5":14424,"_27663":57936,"_2970":58420},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3487":2829,"_30445":2650,"_21099":58422,"_5":14424,"_27663":57940,"_2970":58423},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3487":2830,"_30445":2650,"_21099":58425,"_5":14424,"_27663":57944,"_2970":58426},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3487":2831,"_30445":2650,"_21099":58428,"_5":14424,"_27663":57944,"_2970":58429},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3487":2832,"_30445":2650,"_21099":58431,"_5":14424,"_27663":57944,"_2970":58432},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3487":2833,"_30445":2650,"_21099":58434,"_5":14424,"_27663":57944,"_2970":58435},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3487":2834,"_30445":2650,"_21099":58437,"_5":14424,"_27663":57944,"_2970":58438},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3487":2835,"_30445":2650,"_21099":58440,"_5":14424,"_27663":57944,"_2970":58441},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3487":2836,"_30445":2650,"_21099":58443,"_5":14424,"_27663":57944,"_2970":58444},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3487":2837,"_30445":2650,"_21099":58446,"_5":14424,"_27663":57944,"_2970":58447},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3487":2838,"_30445":2650,"_21099":58449,"_5":14424,"_27663":57948,"_2970":58450},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3487":2839,"_30445":2650,"_21099":58452,"_5":14424,"_27663":57956,"_2970":58453},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3487":2840,"_30445":2650,"_21099":58455,"_5":14424,"_27663":57956,"_2970":58456},[],"Field in 3.8.0",{"_3487":2841,"_30445":2650,"_21099":58458,"_5":14424,"_27663":57956,"_2970":58459},[],"Field in 4.0.0",{"_3487":2842,"_30445":2650,"_21099":58461,"_5":14424,"_27663":57956,"_2970":58462},[],"`validate_server_cert`",{"_3487":2843,"_30445":2650,"_21099":58464,"_5":14424,"_27663":57956,"_2970":58465},[],"`insecure_skip_verify` (value negated)",{"_3487":2844,"_30445":2650,"_21099":58467,"_5":14424,"_27663":57956,"_2970":58468},[],"`oidc`",{"_3487":2845,"_30445":2650,"_21099":58470,"_5":14424,"_27663":57956,"_2970":58471},[],"`jwt_options`",{"_3487":2846,"_30445":2650,"_21099":58473,"_5":14424,"_27663":57956,"_2970":58474},[],"`apikey`",{"_3487":2847,"_30445":2650,"_21099":58476,"_5":14424,"_27663":57956,"_2970":58477},[],"`apikey_options`",{"_3487":2848,"_30445":2650,"_21099":58479,"_5":14424,"_27663":57956,"_2970":58480},[],"`mtls`",{"_3487":2849,"_30445":2650,"_21099":58482,"_5":14424,"_27663":57956,"_2970":58483},[],"`mtls_options`",{"_3487":2850,"_30445":2650,"_21099":58485,"_5":14424,"_27663":57956,"_2970":58486},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3487":2851,"_30445":2650,"_21099":58488,"_5":14424,"_27663":57956,"_2970":58489},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3487":2852,"_30445":2650,"_21099":58491,"_5":14424,"_27663":57956,"_2970":58492},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3487":2853,"_30445":2650,"_21099":58494,"_5":14424,"_27663":57960,"_2970":58495},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3487":2854,"_30445":2650,"_21099":58497,"_5":14424,"_27663":57960,"_2970":58498},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3487":2855,"_30445":2650,"_21099":58500,"_5":14424,"_27663":57960,"_2970":58501},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3487":2856,"_30445":2650,"_21099":58503,"_5":14424,"_27663":57964,"_2970":58504},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3487":2857,"_30445":2650,"_21099":58506,"_5":14424,"_27663":57968,"_2970":58507},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3487":2858,"_30445":2650,"_21099":58509,"_5":14424,"_27663":57972,"_2970":58510},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3487":2859,"_30445":2650,"_21099":58512,"_5":14424,"_27663":57976,"_2970":58513},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3487":2860,"_30445":2650,"_21099":58515,"_5":14424,"_27663":57976,"_2970":58516},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3487":2861,"_30445":2650,"_21099":58518,"_5":14424,"_27663":57976,"_2970":58519},[],"`POST /v1/devices/:id/events` creates an event.",{"_3487":2862,"_30445":2650,"_21099":58521,"_5":14424,"_27663":57976,"_2970":58522},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3487":2863,"_30445":2650,"_21099":58524,"_5":14424,"_27663":57980,"_2970":58525},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3487":2864,"_30445":2650,"_21099":58527,"_5":14424,"_27663":57984,"_2970":58528},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3487":2865,"_30445":2650,"_21099":58530,"_5":14424,"_27663":57984,"_2970":58531},[],"Route",{"_3487":2866,"_30445":2650,"_21099":58533,"_5":14424,"_27663":57984,"_2970":52928},[],{"_3487":2867,"_30445":2650,"_21099":58535,"_5":14424,"_27663":57984,"_2970":58536},[],"`GET /v1/crl-settings`",{"_3487":2868,"_30445":2650,"_21099":58538,"_5":14424,"_27663":57984,"_2970":58539},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3487":2869,"_30445":2650,"_21099":58541,"_5":14424,"_27663":57984,"_2970":58542},[],"`GET /v1/crl-settings/{ca-id}`",{"_3487":2870,"_30445":2650,"_21099":58544,"_5":14424,"_27663":57984,"_2970":58545},[],"Reads the settings of a CA.",{"_3487":2871,"_30445":2650,"_21099":58547,"_5":14424,"_27663":57984,"_2970":58548},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3487":2872,"_30445":2650,"_21099":58550,"_5":14424,"_27663":57984,"_2970":58551},[],"Replaces `crl_options`.",{"_3487":2873,"_30445":2650,"_21099":58553,"_5":14424,"_27663":57984,"_2970":58554},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3487":2874,"_30445":2650,"_21099":58556,"_5":14424,"_27663":57984,"_2970":58557},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3487":2875,"_30445":2650,"_21099":58559,"_5":14424,"_27663":57984,"_2970":58560},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3487":2876,"_30445":2650,"_21099":58562,"_5":14424,"_27663":57984,"_2970":58563},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3487":2877,"_30445":2650,"_21099":58565,"_5":14424,"_27663":57984,"_2970":58566},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3487":2878,"_30445":2650,"_21099":58568,"_5":14424,"_27663":57984,"_2970":58569},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3487":2879,"_30445":2650,"_21099":58571,"_5":14424,"_27663":57984,"_2970":58572},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3487":2880,"_30445":2650,"_21099":58574,"_5":14424,"_27663":57984,"_2970":58575},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3487":2881,"_30445":2650,"_21099":58577,"_5":14424,"_27663":57984,"_2970":58578},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3487":2882,"_30445":2650,"_21099":58580,"_5":14424,"_27663":57984,"_2970":58581},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3487":2883,"_30445":2650,"_21099":58583,"_5":14424,"_27663":57984,"_2970":58584},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3487":2884,"_30445":2650,"_21099":58586,"_5":14424,"_27663":57988,"_2970":58587},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3487":2885,"_30445":2650,"_21099":58589,"_5":14424,"_27663":57992,"_2970":58590},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3487":2886,"_30445":2650,"_21099":58592,"_5":14424,"_27663":57996,"_2970":58593},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3487":2887,"_30445":2650,"_21099":58595,"_5":14424,"_27663":58000,"_2970":58596},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3487":2888,"_30445":2650,"_21099":58598,"_5":14424,"_27663":58004,"_2970":58599},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3487":2889,"_30445":2650,"_21099":58601,"_5":14424,"_27663":58004,"_2970":58602},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3487":2890,"_30445":2650,"_21099":58604,"_5":14424,"_27663":58004,"_2970":58605},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3487":2891,"_30445":2650,"_21099":58607,"_5":14424,"_27663":58004,"_2970":58608},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3487":2892,"_30445":2650,"_21099":58610,"_5":14424,"_27663":58004,"_2970":58611},[],"Record the names of your local-storage PVCs:",{"_3487":2893,"_30445":2650,"_21099":58613,"_5":14424,"_27663":58004,"_2970":58614},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3487":2894,"_30445":2650,"_21099":58616,"_5":14424,"_27663":58008,"_2970":58617},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3487":2895,"_30445":2650,"_21099":58619,"_5":14424,"_27663":58008,"_2970":58620},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3487":2896,"_30445":2650,"_21099":58622,"_5":14424,"_27663":58008,"_2970":58623},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3487":2897,"_30445":2650,"_21099":58625,"_5":14424,"_27663":58008,"_2970":58626},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3487":2898,"_30445":2650,"_21099":58628,"_5":14424,"_27663":58008,"_2970":58629},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3487":2899,"_30445":2650,"_21099":58631,"_5":14424,"_27663":58012,"_2970":58632},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3487":2900,"_30445":2650,"_21099":58634,"_5":14424,"_27663":58012,"_2970":58635},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3487":2901,"_30445":2650,"_21099":58637,"_5":14424,"_27663":58012,"_2970":58638},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values. Each schema can also supply its own username and password through the `LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_USERNAME` and `LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_PASSWORD` environment variables, which take precedence over the global `postgres.username` and `postgres.password` values when set. See Credential environment variables.",{"_3487":2902,"_30445":2650,"_21099":58640,"_5":14424,"_27663":58012,"_2970":58641},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3487":2903,"_30445":2650,"_21099":58643,"_5":14424,"_27663":58012,"_2970":58644},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3487":2904,"_30445":2650,"_21099":58646,"_5":14424,"_27663":58012,"_2970":58647},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3487":2905,"_30445":2650,"_21099":58649,"_5":14424,"_27663":58012,"_2970":58650},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3487":2906,"_30445":2650,"_21099":58652,"_5":14424,"_27663":58012,"_2970":58653},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3487":2907,"_30445":2650,"_21099":58655,"_5":14424,"_27663":58012,"_2970":58656},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3487":2908,"_30445":2650,"_21099":58658,"_5":14424,"_27663":58012,"_2970":58659},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3487":2909,"_30445":2650,"_21099":58661,"_5":14424,"_27663":58012,"_2970":58662},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3487":2910,"_30445":2650,"_21099":58664,"_5":14424,"_27663":58012,"_2970":58665},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3487":2911,"_30445":2650,"_21099":58667,"_5":14424,"_27663":58016,"_2970":58668},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3487":2912,"_30445":2650,"_21099":58670,"_5":14424,"_27663":58016,"_2970":58671},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3487":2913,"_30445":2650,"_21099":58673,"_5":14424,"_27663":58020,"_2970":58674},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3487":2914,"_30445":2650,"_21099":58676,"_5":14424,"_27663":58020,"_2970":58677},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3487":2915,"_30445":2650,"_21099":58679,"_5":14424,"_27663":58020,"_2970":58680},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3487":2916,"_30445":2650,"_21099":58682,"_5":14424,"_27663":58020,"_2970":58683},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3487":2917,"_30445":2650,"_21099":58685,"_5":14424,"_27663":58020,"_2970":58686},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3487":2918,"_30445":2650,"_21099":58688,"_5":14424,"_27663":58020,"_2970":58689},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3487":2919,"_30445":2650,"_21099":58691,"_5":14424,"_27663":58020,"_2970":58692},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3487":2920,"_30445":2650,"_21099":58694,"_5":14424,"_27663":58020,"_2970":58695},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3487":2921,"_30445":2650,"_21099":58697,"_5":14424,"_27663":58020,"_2970":58698},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3487":2922,"_30445":2650,"_21099":58700,"_5":14424,"_27663":58020,"_2970":58701},[],"**Remove the helper and restore the recorded replica counts:**",{"_3487":2923,"_30445":2650,"_21099":58703,"_5":14424,"_27663":58020,"_2970":58704},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3487":2924,"_30445":2650,"_21099":58706,"_5":14424,"_27663":58024,"_2970":58707},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3487":2925,"_30445":2650,"_21099":58709,"_5":14424,"_27663":58024,"_2970":58710},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3487":2926,"_30445":2650,"_21099":58712,"_5":14424,"_27663":58028,"_2970":58713},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3487":2927,"_30445":2650,"_21099":58715,"_5":14424,"_27663":58028,"_2970":58716},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3487":2928,"_30445":2650,"_21099":58718,"_5":14424,"_27663":58028,"_2970":58719},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3487":2929,"_30445":2650,"_21099":58721,"_5":14424,"_27663":58028,"_2970":58722},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3487":2930,"_30445":2650,"_21099":58724,"_5":14424,"_27663":58028,"_2970":58725},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3487":2931,"_30445":2650,"_21099":58727,"_5":14424,"_27663":58028,"_2970":58728},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3487":2932,"_30445":2650,"_21099":58730,"_5":14424,"_27663":58028,"_2970":58731},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3487":2933,"_30445":2650,"_21099":58733,"_5":14424,"_27663":58028,"_2970":58734},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3487":2934,"_30445":2650,"_21099":58736,"_5":14424,"_27663":58032,"_2970":58737},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3487":2935,"_30445":2650,"_21099":58739,"_5":14424,"_27663":58032,"_2970":58740},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3487":2936,"_30445":2650,"_21099":58742,"_5":14424,"_27663":58032,"_2970":58743},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3487":2937,"_30445":2650,"_21099":58745,"_5":14424,"_27663":58032,"_2970":58746},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3487":2938,"_30445":2650,"_21099":58748,"_5":14424,"_27663":58032,"_2970":58749},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3487":2939,"_30445":2650,"_21099":58751,"_5":14424,"_27663":58032,"_2970":58752},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3487":2940,"_30445":2650,"_21099":58754,"_5":14424,"_27663":58032,"_2970":58755},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3487":2941,"_30445":2650,"_21099":58757,"_5":14424,"_27663":58032,"_2970":58758},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3487":2942,"_30445":2650,"_21099":58760,"_5":14424,"_27663":58032,"_2970":58761},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3487":2943,"_30445":2650,"_21099":58763,"_5":14424,"_27663":58032,"_2970":58764},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3487":2944,"_30445":2650,"_21099":58766,"_5":14424,"_27663":58032,"_2970":58767},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3487":2945,"_30445":2650,"_21099":58769,"_5":14424,"_27663":58035,"_2970":58770},[],"After the upgrade, check in this order:",{"_3487":2946,"_30445":2650,"_21099":58772,"_5":14424,"_27663":58035,"_2970":58773},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3487":2947,"_30445":2650,"_21099":58775,"_5":14424,"_27663":58035,"_2970":58776},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3487":2948,"_30445":2650,"_21099":58778,"_5":14424,"_27663":58035,"_2970":58779},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3487":2949,"_30445":2650,"_21099":58781,"_5":14424,"_27663":58035,"_2970":58782},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3487":2950,"_30445":2650,"_21099":58784,"_5":14424,"_27663":58035,"_2970":58785},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3487":2951,"_30445":2650,"_21099":58787,"_5":14424,"_27663":58035,"_2970":58788},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3487":2952,"_30445":2650,"_21099":58790,"_5":14424,"_27663":58035,"_2970":58791},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3487":2953,"_30445":2650,"_21099":58793,"_5":14424,"_27663":58035,"_2970":58794},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3487":2954,"_30445":2650,"_21099":58796,"_5":14424,"_27663":58035,"_2970":58797},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3487":2955,"_30445":2650,"_21099":58799,"_5":14424,"_27663":58035,"_2970":58800},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3487":2956,"_30445":2650,"_21099":58802,"_5":14424,"_27663":58035,"_2970":58803},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3487":2957,"_30445":2650,"_21099":58805,"_5":14424,"_27663":58035,"_2970":58806},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3487":2958,"_30445":2650,"_21099":58808,"_5":14424,"_27663":58035,"_2970":58809},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3487":2959,"_30445":2650,"_21099":58811,"_5":14424,"_27663":58035,"_2970":58812},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3487":2960,"_30445":2650,"_21099":58814,"_5":14424,"_27663":58035,"_2970":58815},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3487":2961,"_30445":2650,"_21099":58817,"_5":14424,"_27663":58039,"_2970":58818},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3487":2962,"_30445":2650,"_21099":58820,"_5":14424,"_27663":58039,"_2970":58821},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3487":2963,"_30445":2650,"_21099":58823,"_5":14424,"_27663":58039,"_2970":58824},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3487":2964,"_30445":2650,"_21099":58826,"_5":14424,"_27663":58039,"_2970":58827},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3487":2965,"_30445":2650,"_21099":58829,"_5":14424,"_27663":58039,"_2970":58830},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58833":58834,"_58835":58836,"_58837":58838,"_58839":58840,"_18300":3005,"_70658":3005},"language","english","sortableProperties",[2970,30445,5,27663],"sortablePropertiesWithTypes",{"_2970":25195,"_30445":25195,"_5":25195,"_27663":25195},"sorts",{"_2970":58841,"_30445":61796,"_5":64750,"_27663":67704},{"_4681":58842,"_58843":58844,"_5":25195},{"_14512":19356,"_14892":6400,"_14911":7454,"_29439":5475,"_14898":6740,"_20026":21318,"_14533":3371,"_14540":7001,"_29381":3165,"_29789":7527,"_29810":4108,"_29415":6964,"_34796":4824,"_29518":7543,"_29854":4972,"_34803":4823,"_34806":15961,"_34809":6911,"_34812":6015,"_30261":3143,"_34817":16421,"_34819":5772,"_30291":4635,"_14907":3255,"_34823":11013,"_34826":3222,"_34828":6236,"_29838":8829,"_30256":10915,"_30304":5023,"_34833":8456,"_34835":3359,"_34837":7014,"_29535":3071,"_34840":20744,"_34842":4631,"_34844":5166,"_34846":3677,"_34848":3794,"_29452":4422,"_34851":7685,"_34853":5190,"_29446":11157,"_29875":20529,"_34857":7576,"_34859":7235,"_34862":3084,"_29492":8483,"_34866":12307,"_29372":11371,"_34869":7069,"_29420":3184,"_34872":5109,"_34874":7635,"_34877":6262,"_14901":13996,"_34880":17783,"_34882":11178,"_34885":8087,"_34887":5568,"_34889":7942,"_34891":7682,"_34893":6121,"_20029":7531,"_34896":11360,"_34898":5986,"_29393":4110,"_29832":6583,"_34902":7331,"_34904":4241,"_34906":9634,"_30321":5217,"_34909":3662,"_34911":6080,"_34913":16941,"_30425":12092,"_29891":14347,"_34917":3139,"_34919":