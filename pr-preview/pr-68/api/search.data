25887,"_40552":125890,"_40554":125893,"_40556":125896,"_40558":125899,"_40560":125902,"_40562":125905,"_40564":125908,"_40566":125911,"_40568":125914,"_40570":125917,"_40572":125920,"_40574":125923,"_40576":125926,"_40578":125929,"_40580":125932,"_40582":125935,"_40584":125938,"_40586":125941,"_40588":125944,"_40590":125947,"_40593":125950,"_40595":125953,"_40597":125956,"_40599":125959,"_40601":125962,"_40603":125965,"_40605":125968,"_40607":125971,"_40609":125974,"_40611":125977,"_40613":125980,"_40615":125983,"_40617":125986,"_40619":125989,"_40621":125992,"_40623":125995,"_40625":125998,"_40627":126001,"_40629":126004,"_40631":126007,"_40633":126010,"_40635":126013,"_40637":126016,"_40639":126019,"_40641":126022,"_40643":126025,"_40645":126028,"_40647":126031,"_40649":126034,"_40651":126037,"_40653":126040,"_40655":126043,"_40657":126046,"_40659":126049,"_40661":126052,"_40663":126055,"_40665":126058,"_40667":126061,"_40669":126064,"_40671":126067,"_40673":126070,"_40675":126073,"_40677":126076,"_40679":126079,"_40681":126082,"_40683":126085,"_40686":126088,"_40688":126091,"_40690":126094},{"_3487":70665,"_30445":70665,"_5":14788,"_2970":117105,"_30797":117106,"_21099":117109,"_27663":70665},"Despliega desde AWS Marketplace",[49622,117107,117108],"Despliegue","Otros modelos",[],{"_3487":70666,"_30445":70665,"_21099":117111,"_5":14424,"_27663":70665,"_2970":117112},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3487":70667,"_30445":70665,"_5":30794,"_21099":117114,"_27663":117115,"_2970":117116},[],"/docs/pr-preview/pr-68/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3487":70668,"_30445":70665,"_5":30794,"_21099":117118,"_27663":117119,"_2970":117120},[],"/docs/pr-preview/pr-68/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3487":70669,"_30445":70665,"_5":30794,"_21099":117122,"_27663":117123,"_2970":117124},[],"/docs/pr-preview/pr-68/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3487":70670,"_30445":70665,"_5":30794,"_21099":117126,"_27663":117127,"_2970":117128},[],"/docs/pr-preview/pr-68/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3487":70671,"_30445":70665,"_5":30794,"_21099":117130,"_27663":117131,"_2970":117132},[],"/docs/pr-preview/pr-68/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3487":70672,"_30445":70665,"_5":30794,"_21099":117134,"_27663":117135,"_2970":117136},[],"/docs/pr-preview/pr-68/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3487":70673,"_30445":70665,"_5":30794,"_21099":117138,"_27663":117139,"_2970":117140},[],"/docs/pr-preview/pr-68/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3487":70674,"_30445":70665,"_21099":117142,"_5":14424,"_27663":70665,"_2970":117143},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3487":70675,"_30445":70665,"_21099":117145,"_5":14424,"_27663":117115,"_2970":117146},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3487":70676,"_30445":70665,"_21099":117148,"_5":14424,"_27663":117115,"_2970":117149},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3487":70677,"_30445":70665,"_21099":117151,"_5":14424,"_27663":117115,"_2970":117152},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3487":70678,"_30445":70665,"_21099":117154,"_5":14424,"_27663":117119,"_2970":117155},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3487":70679,"_30445":70665,"_21099":117157,"_5":14424,"_27663":117119,"_2970":117158},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3487":70680,"_30445":70665,"_21099":117160,"_5":14424,"_27663":117119,"_2970":117161},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3487":70681,"_30445":70665,"_21099":117163,"_5":14424,"_27663":117123,"_2970":117164},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3487":70682,"_30445":70665,"_21099":117166,"_5":14424,"_27663":117127,"_2970":117167},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3487":70683,"_30445":70665,"_21099":117169,"_5":14424,"_27663":117131,"_2970":117170},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3487":70684,"_30445":70665,"_21099":117172,"_5":14424,"_27663":117135,"_2970":117173},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3487":70685,"_30445":70665,"_21099":117175,"_5":14424,"_27663":117139,"_2970":117176},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3487":70686,"_30445":70686,"_5":14788,"_2970":117178,"_30797":117179,"_21099":117180,"_27663":70686},"Despliega Lamassu",[49622,117107],[],{"_3487":70687,"_30445":70686,"_21099":117182,"_5":14424,"_27663":70686,"_2970":117183},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3487":70688,"_30445":70686,"_5":30794,"_21099":117185,"_27663":117186,"_2970":117187},[],"/docs/pr-preview/pr-68/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3487":70689,"_30445":70686,"_5":30794,"_21099":117189,"_27663":117190,"_2970":117191},[],"/docs/pr-preview/pr-68/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3487":70690,"_30445":70686,"_5":30794,"_21099":117193,"_27663":117194,"_2970":117195},[],"/docs/pr-preview/pr-68/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3487":70691,"_30445":70686,"_21099":117197,"_5":14424,"_27663":70686,"_2970":117198},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3487":70692,"_30445":70686,"_21099":117200,"_5":14424,"_27663":117186,"_2970":117201},[],"Modelo",{"_3487":70693,"_30445":70686,"_21099":117203,"_5":14424,"_27663":117186,"_2970":117204},[],"Recomendado para",{"_3487":70694,"_30445":70686,"_21099":117206,"_5":14424,"_27663":117186,"_2970":117207},[],"Quién opera la infraestructura",{"_3487":70695,"_30445":70686,"_21099":117209,"_5":14424,"_27663":117186,"_2970":117210},[],"Punto de partida",{"_3487":70696,"_30445":70686,"_21099":117212,"_5":14424,"_27663":117186,"_2970":49729},[],{"_3487":70697,"_30445":70686,"_21099":117214,"_5":14424,"_27663":117186,"_2970":117215},[],"Producción, entornos regulados y despliegues personalizados",{"_3487":70698,"_30445":70686,"_21099":117217,"_5":14424,"_27663":117186,"_2970":117218},[],"Tu equipo",{"_3487":70699,"_30445":70686,"_21099":117220,"_5":14424,"_27663":117186,"_2970":117221},[],"Helm o Fastlane",{"_3487":70700,"_30445":70686,"_21099":117223,"_5":14424,"_27663":117186,"_2970":49741},[],{"_3487":70701,"_30445":70686,"_21099":117225,"_5":14424,"_27663":117186,"_2970":117226},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3487":70702,"_30445":70686,"_21099":117228,"_5":14424,"_27663":117186,"_2970":117218},[],{"_3487":70703,"_30445":70686,"_21099":117230,"_5":14424,"_27663":117186,"_2970":117231},[],"Imagen preconfigurada en EC2",{"_3487":70704,"_30445":70686,"_21099":117233,"_5":14424,"_27663":117186,"_2970":49752},[],{"_3487":70705,"_30445":70686,"_21099":117235,"_5":14424,"_27663":117186,"_2970":117236},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3487":70706,"_30445":70686,"_21099":117238,"_5":14424,"_27663":117186,"_2970":49758},[],{"_3487":70707,"_30445":70686,"_21099":117240,"_5":14424,"_27663":117186,"_2970":117241},[],"Suscripción gestionada",{"_3487":70708,"_30445":70686,"_21099":117243,"_5":14424,"_27663":117186,"_2970":117244},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3487":70709,"_30445":70686,"_21099":117246,"_5":14424,"_27663":117186,"_2970":117247},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3487":70710,"_30445":70686,"_21099":117249,"_5":14424,"_27663":117186,"_2970":117250},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3487":70711,"_30445":70686,"_21099":117252,"_5":14424,"_27663":117190,"_2970":117253},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3487":70712,"_30445":70686,"_21099":117255,"_5":14424,"_27663":117194,"_2970":117256},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3487":70713,"_30445":70713,"_5":14788,"_2970":117258,"_30797":117259,"_21099":117260,"_27663":70713},"Utiliza Lamassu como SaaS",[49622,117107,117108],[],{"_3487":70714,"_30445":70713,"_21099":117262,"_5":14424,"_27663":70713,"_2970":117263},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3487":70715,"_30445":70713,"_5":30794,"_21099":117265,"_27663":117266,"_2970":117267},[],"/docs/pr-preview/pr-68/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3487":70716,"_30445":70713,"_5":30794,"_21099":117269,"_27663":117270,"_2970":117271},[],"/docs/pr-preview/pr-68/es/deployment/saas#planes","Planes",{"_3487":70717,"_30445":70713,"_5":30794,"_21099":117273,"_27663":117274,"_2970":117275},[],"/docs/pr-preview/pr-68/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3487":70718,"_30445":70713,"_21099":117277,"_5":14424,"_27663":70713,"_2970":117278},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3487":70719,"_30445":70713,"_21099":117280,"_5":14424,"_27663":117266,"_2970":117281},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3487":70720,"_30445":70713,"_21099":117283,"_5":14424,"_27663":117266,"_2970":117284},[],"Copias de seguridad automáticas.",{"_3487":70721,"_30445":70713,"_21099":117286,"_5":14424,"_27663":117266,"_2970":117287},[],"Actualizaciones de versión.",{"_3487":70722,"_30445":70713,"_21099":117289,"_5":14424,"_27663":117266,"_2970":117290},[],"Soporte técnico y SLA según el plan contratado.",{"_3487":70723,"_30445":70713,"_21099":117292,"_5":14424,"_27663":117270,"_2970":49813},[],{"_3487":70724,"_30445":70713,"_21099":117294,"_5":14424,"_27663":117270,"_2970":117295},[],"Dispositivos",{"_3487":70725,"_30445":70713,"_21099":117297,"_5":14424,"_27663":117270,"_2970":117298},[],"Soporte",{"_3487":70726,"_30445":70713,"_21099":117300,"_5":14424,"_27663":117270,"_2970":49822},[],{"_3487":70727,"_30445":70713,"_21099":117302,"_5":14424,"_27663":117270,"_2970":49825},[],{"_3487":70728,"_30445":70713,"_21099":117304,"_5":14424,"_27663":117270,"_2970":117305},[],"Hasta 1.000",{"_3487":70729,"_30445":70713,"_21099":117307,"_5":14424,"_27663":117270,"_2970":49831},[],{"_3487":70730,"_30445":70713,"_21099":117309,"_5":14424,"_27663":117270,"_2970":117310},[],"99,5 %",{"_3487":70731,"_30445":70713,"_21099":117312,"_5":14424,"_27663":117270,"_2970":49837},[],{"_3487":70732,"_30445":70713,"_21099":117314,"_5":14424,"_27663":117270,"_2970":117315},[],"Hasta 10.000",{"_3487":70733,"_30445":70713,"_21099":117317,"_5":14424,"_27663":117270,"_2970":117318},[],"Email y chat",{"_3487":70734,"_30445":70713,"_21099":117320,"_5":14424,"_27663":117270,"_2970":117321},[],"99,9 %",{"_3487":70735,"_30445":70713,"_21099":117323,"_5":14424,"_27663":117270,"_2970":49849},[],{"_3487":70736,"_30445":70713,"_21099":117325,"_5":14424,"_27663":117270,"_2970":117326},[],"Ilimitados",{"_3487":70737,"_30445":70713,"_21099":117328,"_5":14424,"_27663":117270,"_2970":117329},[],"Dedicado",{"_3487":70738,"_30445":70713,"_21099":117331,"_5":14424,"_27663":117270,"_2970":117332},[],"99,99 %",{"_3487":70739,"_30445":70713,"_21099":117334,"_5":14424,"_27663":117274,"_2970":117335},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3487":70740,"_30445":70713,"_21099":117337,"_5":14424,"_27663":117274,"_2970":117338},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3487":70741,"_30445":70741,"_5":14788,"_2970":49866,"_30797":117340,"_21099":117342,"_27663":70741},[49622,117107,117341],"Kubernetes autogestionado",[],{"_3487":70742,"_30445":70741,"_21099":117344,"_5":14424,"_27663":70741,"_2970":117345},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3487":70743,"_30445":70741,"_5":30794,"_21099":117347,"_27663":117348,"_2970":117349},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3487":70744,"_30445":70741,"_5":30794,"_21099":117351,"_27663":117352,"_2970":117353},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3487":70745,"_30445":70741,"_5":30794,"_21099":117355,"_27663":117356,"_2970":117357},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3487":70746,"_30445":70741,"_5":30794,"_21099":117359,"_27663":117360,"_2970":117361},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3487":70747,"_30445":70741,"_5":30794,"_21099":117363,"_27663":117364,"_2970":117365},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3487":70748,"_30445":70741,"_5":30794,"_21099":117367,"_27663":117368,"_2970":117369},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3487":70749,"_30445":70741,"_5":30794,"_21099":117371,"_27663":117372,"_2970":117373},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3487":70750,"_30445":70741,"_5":30794,"_21099":117375,"_27663":117376,"_2970":117377},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3487":70751,"_30445":70741,"_5":30794,"_21099":117379,"_27663":117380,"_2970":117381},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3487":70752,"_30445":70741,"_5":30794,"_21099":117383,"_27663":117384,"_2970":117385},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3487":70753,"_30445":70741,"_5":30794,"_21099":117387,"_27663":117388,"_2970":117389},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3487":70754,"_30445":70741,"_21099":117391,"_5":14424,"_27663":117348,"_2970":117392},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3487":70755,"_30445":70741,"_21099":117394,"_5":14424,"_27663":117348,"_2970":117395},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3487":70756,"_30445":70741,"_21099":117397,"_5":14424,"_27663":117352,"_2970":117398},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3487":70757,"_30445":70741,"_21099":117400,"_5":14424,"_27663":117352,"_2970":117401},[],"Fastlane instala o configura",{"_3487":70758,"_30445":70741,"_21099":117403,"_5":14424,"_27663":117352,"_2970":117404},[],"Tú sigues proporcionando",{"_3487":70759,"_30445":70741,"_21099":117406,"_5":14424,"_27663":117352,"_2970":117407},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3487":70760,"_30445":70741,"_21099":117409,"_5":14424,"_27663":117352,"_2970":117410},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3487":70761,"_30445":70741,"_21099":117412,"_5":14424,"_27663":117352,"_2970":117413},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3487":70762,"_30445":70741,"_21099":117415,"_5":14424,"_27663":117352,"_2970":117416},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3487":70763,"_30445":70741,"_21099":117418,"_5":14424,"_27663":117352,"_2970":117419},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3487":70764,"_30445":70741,"_21099":117421,"_5":14424,"_27663":117352,"_2970":117422},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3487":70765,"_30445":70741,"_21099":117424,"_5":14424,"_27663":117352,"_2970":117425},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3487":70766,"_30445":70741,"_21099":117427,"_5":14424,"_27663":117352,"_2970":117428},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3487":70767,"_30445":70741,"_21099":117430,"_5":14424,"_27663":117352,"_2970":117431},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3487":70768,"_30445":70741,"_21099":117433,"_5":14424,"_27663":117356,"_2970":117434},[],"Necesitas:",{"_3487":70769,"_30445":70741,"_21099":117436,"_5":14424,"_27663":117356,"_2970":117437},[],"un clúster Kubernetes existente",{"_3487":70770,"_30445":70741,"_21099":117439,"_5":14424,"_27663":117356,"_2970":117440},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3487":70771,"_30445":70741,"_21099":117442,"_5":14424,"_27663":117356,"_2970":49968},[],{"_3487":70772,"_30445":70741,"_21099":117444,"_5":14424,"_27663":117356,"_2970":23849},[],{"_3487":70773,"_30445":70741,"_21099":117446,"_5":14424,"_27663":117356,"_2970":117447},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3487":70774,"_30445":70741,"_21099":117449,"_5":14424,"_27663":117356,"_2970":117450},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3487":70775,"_30445":70741,"_21099":117452,"_5":14424,"_27663":117356,"_2970":117453},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3487":70776,"_30445":70741,"_21099":117455,"_5":14424,"_27663":117356,"_2970":117456},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3487":70777,"_30445":70741,"_21099":117458,"_5":14424,"_27663":117356,"_2970":117459},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3487":70778,"_30445":70741,"_21099":117461,"_5":14424,"_27663":117360,"_2970":117462},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3487":70779,"_30445":70741,"_21099":117464,"_5":14424,"_27663":117360,"_2970":117465},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3487":70780,"_30445":70741,"_21099":117467,"_5":14424,"_27663":117364,"_2970":117468},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3487":70781,"_30445":70741,"_21099":117470,"_5":14424,"_27663":117364,"_2970":117471},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3487":70782,"_30445":70741,"_21099":117473,"_5":14424,"_27663":117364,"_2970":117474},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3487":70783,"_30445":70741,"_21099":117476,"_5":14424,"_27663":117364,"_2970":117477},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3487":70784,"_30445":70741,"_21099":117479,"_5":14424,"_27663":117368,"_2970":117480},[],"Opción",{"_3487":70785,"_30445":70741,"_21099":117482,"_5":14424,"_27663":117368,"_2970":117483},[],"Valor predeterminado",{"_3487":70786,"_30445":70741,"_21099":117485,"_5":14424,"_27663":117368,"_2970":117486},[],"Propósito",{"_3487":70787,"_30445":70741,"_21099":117488,"_5":14424,"_27663":117368,"_2970":50015},[],{"_3487":70788,"_30445":70741,"_21099":117490,"_5":14424,"_27663":117368,"_2970":50018},[],{"_3487":70789,"_30445":70741,"_21099":117492,"_5":14424,"_27663":117368,"_2970":117493},[],"Muestra la ayuda",{"_3487":70790,"_30445":70741,"_21099":117495,"_5":14424,"_27663":117368,"_2970":50024},[],{"_3487":70791,"_30445":70741,"_21099":117497,"_5":14424,"_27663":117368,"_2970":117498},[],"contexto actual",{"_3487":70792,"_30445":70741,"_21099":117500,"_5":14424,"_27663":117368,"_2970":117501},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3487":70793,"_30445":70741,"_21099":117503,"_5":14424,"_27663":117368,"_2970":50033},[],{"_3487":70794,"_30445":70741,"_21099":117505,"_5":14424,"_27663":117368,"_2970":6574},[],{"_3487":70795,"_30445":70741,"_21099":117507,"_5":14424,"_27663":117368,"_2970":117508},[],"Omite prompts y genera credenciales para las dependencias",{"_3487":70796,"_30445":70741,"_21099":117510,"_5":14424,"_27663":117368,"_2970":50041},[],{"_3487":70797,"_30445":70741,"_21099":117512,"_5":14424,"_27663":117368,"_2970":50044},[],{"_3487":70798,"_30445":70741,"_21099":117514,"_5":14424,"_27663":117368,"_2970":117515},[],"Namespace de la instalación",{"_3487":70799,"_30445":70741,"_21099":117517,"_5":14424,"_27663":117368,"_2970":50050},[],{"_3487":70800,"_30445":70741,"_21099":117519,"_5":14424,"_27663":117368,"_2970":50053},[],{"_3487":70801,"_30445":70741,"_21099":117521,"_5":14424,"_27663":117368,"_2970":117522},[],"Dominio usado por la UI, OIDC y el certificado",{"_3487":70802,"_30445":70741,"_21099":117524,"_5":14424,"_27663":117368,"_2970":50059},[],{"_3487":70803,"_30445":70741,"_21099":117526,"_5":14424,"_27663":117368,"_2970":15225},[],{"_3487":70804,"_30445":70741,"_21099":117528,"_5":14424,"_27663":117368,"_2970":117529},[],"Versión del chart de Lamassu",{"_3487":70805,"_30445":70741,"_21099":117531,"_5":14424,"_27663":117368,"_2970":50067},[],{"_3487":70806,"_30445":70741,"_21099":117533,"_5":14424,"_27663":117368,"_2970":50070},[],{"_3487":70807,"_30445":70741,"_21099":117535,"_5":14424,"_27663":117368,"_2970":117536},[],"Puerto del listener HTTPS",{"_3487":70808,"_30445":70741,"_21099":117538,"_5":14424,"_27663":117368,"_2970":50076},[],{"_3487":70809,"_30445":70741,"_21099":117540,"_5":14424,"_27663":117368,"_2970":50079},[],{"_3487":70810,"_30445":70741,"_21099":117542,"_5":14424,"_27663":117368,"_2970":117543},[],"Puerto del listener HTTP",{"_3487":70811,"_30445":70741,"_21099":117545,"_5":14424,"_27663":117368,"_2970":50085},[],{"_3487":70812,"_30445":70741,"_21099":117547,"_5":14424,"_27663":117368,"_2970":50018},[],{"_3487":70813,"_30445":70741,"_21099":117549,"_5":14424,"_27663":117368,"_2970":117550},[],"Certificado PEM para TLS downstream",{"_3487":70814,"_30445":70741,"_21099":117552,"_5":14424,"_27663":117368,"_2970":50093},[],{"_3487":70815,"_30445":70741,"_21099":117554,"_5":14424,"_27663":117368,"_2970":50018},[],{"_3487":70816,"_30445":70741,"_21099":117556,"_5":14424,"_27663":117368,"_2970":117557},[],"Clave privada PEM para TLS downstream",{"_3487":70817,"_30445":70741,"_21099":117559,"_5":14424,"_27663":117368,"_2970":50101},[],{"_3487":70818,"_30445":70741,"_21099":117561,"_5":14424,"_27663":117368,"_2970":117562},[],"chart del repositorio",{"_3487":70819,"_30445":70741,"_21099":117564,"_5":14424,"_27663":117368,"_2970":117565},[],"Usa un chart local de Lamassu sin empaquetar",{"_3487":70820,"_30445":70741,"_21099":117567,"_5":14424,"_27663":117368,"_2970":50110},[],{"_3487":70821,"_30445":70741,"_21099":117569,"_5":14424,"_27663":117368,"_2970":117570},[],"detección automática",{"_3487":70822,"_30445":70741,"_21099":117572,"_5":14424,"_27663":117368,"_2970":117573},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3487":70823,"_30445":70741,"_21099":117575,"_5":14424,"_27663":117368,"_2970":50118},[],{"_3487":70824,"_30445":70741,"_21099":117577,"_5":14424,"_27663":117368,"_2970":6574},[],{"_3487":70825,"_30445":70741,"_21099":117579,"_5":14424,"_27663":117368,"_2970":117580},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3487":70826,"_30445":70741,"_21099":117582,"_5":14424,"_27663":117368,"_2970":50126},[],{"_3487":70827,"_30445":70741,"_21099":117584,"_5":14424,"_27663":117368,"_2970":6574},[],{"_3487":70828,"_30445":70741,"_21099":117586,"_5":14424,"_27663":117368,"_2970":117587},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3487":70829,"_30445":70741,"_21099":117589,"_5":14424,"_27663":117368,"_2970":50134},[],{"_3487":70830,"_30445":70741,"_21099":117591,"_5":14424,"_27663":117368,"_2970":6574},[],{"_3487":70831,"_30445":70741,"_21099":117593,"_5":14424,"_27663":117368,"_2970":117594},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3487":70832,"_30445":70741,"_21099":117596,"_5":14424,"_27663":117368,"_2970":50142},[],{"_3487":70833,"_30445":70741,"_21099":117598,"_5":14424,"_27663":117368,"_2970":6574},[],{"_3487":70834,"_30445":70741,"_21099":117600,"_5":14424,"_27663":117368,"_2970":117601},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3487":70835,"_30445":70741,"_21099":117603,"_5":14424,"_27663":117368,"_2970":50150},[],{"_3487":70836,"_30445":70741,"_21099":117605,"_5":14424,"_27663":117368,"_2970":50153},[],{"_3487":70837,"_30445":70741,"_21099":117607,"_5":14424,"_27663":117368,"_2970":117608},[],"Usa otro chart local de SoftHSM",{"_3487":70838,"_30445":70741,"_21099":117610,"_5":14424,"_27663":117368,"_2970":117611},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3487":70839,"_30445":70741,"_21099":117613,"_5":14424,"_27663":117372,"_2970":117614},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3487":70840,"_30445":70741,"_21099":117616,"_5":14424,"_27663":117372,"_2970":117617},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3487":70841,"_30445":70741,"_21099":117619,"_5":14424,"_27663":117372,"_2970":117620},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3487":70842,"_30445":70741,"_21099":117622,"_5":14424,"_27663":117372,"_2970":117623},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3487":70843,"_30445":70741,"_21099":117625,"_5":14424,"_27663":117372,"_2970":117626},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3487":70844,"_30445":70741,"_21099":117628,"_5":14424,"_27663":117372,"_2970":117629},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3487":70845,"_30445":70741,"_21099":117631,"_5":14424,"_27663":117376,"_2970":50180},[],{"_3487":70846,"_30445":70741,"_21099":117633,"_5":14424,"_27663":117376,"_2970":117634},[],"valida las herramientas locales y el clúster seleccionado",{"_3487":70847,"_30445":70741,"_21099":117636,"_5":14424,"_27663":117376,"_2970":117637},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3487":70848,"_30445":70741,"_21099":117639,"_5":14424,"_27663":117376,"_2970":117640},[],"crea el namespace",{"_3487":70849,"_30445":70741,"_21099":117642,"_5":14424,"_27663":117376,"_2970":117643},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3487":70850,"_30445":70741,"_21099":117645,"_5":14424,"_27663":117376,"_2970":117646},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3487":70851,"_30445":70741,"_21099":117648,"_5":14424,"_27663":117376,"_2970":117649},[],"instala RabbitMQ",{"_3487":70852,"_30445":70741,"_21099":117651,"_5":14424,"_27663":117376,"_2970":117652},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3487":70853,"_30445":70741,"_21099":117654,"_5":14424,"_27663":117376,"_2970":117655},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3487":70854,"_30445":70741,"_21099":117657,"_5":14424,"_27663":117376,"_2970":117658},[],"carga datos de ejemplo opcionalmente",{"_3487":70855,"_30445":70741,"_21099":117660,"_5":14424,"_27663":117376,"_2970":117661},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3487":70856,"_30445":70741,"_21099":117663,"_5":14424,"_27663":117380,"_2970":117664},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3487":70857,"_30445":70741,"_21099":117666,"_5":14424,"_27663":117380,"_2970":117667},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3487":70858,"_30445":70741,"_21099":117669,"_5":14424,"_27663":117384,"_2970":117670},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3487":70859,"_30445":70741,"_21099":117672,"_5":14424,"_27663":117384,"_2970":117673},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3487":70860,"_30445":70741,"_21099":117675,"_5":14424,"_27663":117384,"_2970":117676},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3487":70861,"_30445":70741,"_21099":117678,"_5":14424,"_27663":117388,"_2970":117679},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3487":70862,"_30445":70862,"_5":14788,"_2970":117681,"_30797":117682,"_21099":117683,"_27663":70862},"Instala con Helm",[49622,117107,117341],[],{"_3487":70863,"_30445":70862,"_21099":117685,"_5":14424,"_27663":70862,"_2970":117686},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3487":70864,"_30445":70862,"_5":30794,"_21099":117688,"_27663":117689,"_2970":117690},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3487":70865,"_30445":70862,"_5":30794,"_21099":117692,"_27663":117693,"_2970":117357},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3487":70866,"_30445":70862,"_5":30794,"_21099":117695,"_27663":117696,"_2970":117697},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3487":70867,"_30445":70862,"_5":30794,"_21099":117699,"_27663":117700,"_2970":117701},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3487":70868,"_30445":70862,"_5":30794,"_21099":117703,"_27663":117704,"_2970":117705},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3487":70869,"_30445":70862,"_5":30794,"_21099":117707,"_27663":117708,"_2970":117709},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3487":70870,"_30445":70862,"_5":30794,"_21099":117711,"_27663":117712,"_2970":117713},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#variables-de-entorno-para-credenciales","Variables de entorno para credenciales",{"_3487":70871,"_30445":70862,"_5":30794,"_21099":117715,"_27663":117716,"_2970":117717},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3487":70872,"_30445":70862,"_5":30794,"_21099":117719,"_27663":117720,"_2970":117721},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3487":70873,"_30445":70862,"_5":30794,"_21099":117723,"_27663":117724,"_2970":117725},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3487":70874,"_30445":70862,"_5":30794,"_21099":117727,"_27663":117728,"_2970":117729},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3487":70875,"_30445":70862,"_5":30794,"_21099":117731,"_27663":117732,"_2970":117733},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3487":70876,"_30445":70862,"_21099":117735,"_5":14424,"_27663":117689,"_2970":117736},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3487":70877,"_30445":70862,"_21099":117738,"_5":14424,"_27663":117693,"_2970":117739},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3487":70878,"_30445":70862,"_21099":117741,"_5":14424,"_27663":117693,"_2970":117742},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3487":70879,"_30445":70862,"_21099":117744,"_5":14424,"_27663":117693,"_2970":117745},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3487":70880,"_30445":70862,"_21099":117747,"_5":14424,"_27663":117693,"_2970":117748},[],"un broker RabbitMQ accesible y sus credenciales",{"_3487":70881,"_30445":70862,"_21099":117750,"_5":14424,"_27663":117693,"_2970":117751},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3487":70882,"_30445":70862,"_21099":117753,"_5":14424,"_27663":117693,"_2970":117754},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3487":70883,"_30445":70862,"_21099":117756,"_5":14424,"_27663":117693,"_2970":117757},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3487":70884,"_30445":70862,"_21099":117759,"_5":14424,"_27663":117693,"_2970":117760},[],"una StorageClass y un diseño de tráfico externo",{"_3487":70885,"_30445":70862,"_21099":117762,"_5":14424,"_27663":117693,"_2970":117763},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3487":70886,"_30445":70862,"_21099":117765,"_5":14424,"_27663":117693,"_2970":117766},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3487":70887,"_30445":70862,"_21099":117768,"_5":14424,"_27663":117693,"_2970":117769},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3487":70888,"_30445":70862,"_21099":117771,"_5":14424,"_27663":117696,"_2970":117772},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3487":70889,"_30445":70862,"_21099":117774,"_5":14424,"_27663":117696,"_2970":117775},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3487":70890,"_30445":70862,"_21099":117777,"_5":14424,"_27663":117696,"_2970":117778},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3487":70891,"_30445":70862,"_21099":117780,"_5":14424,"_27663":117700,"_2970":117781},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3487":70892,"_30445":70862,"_21099":117783,"_5":14424,"_27663":117700,"_2970":117784},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3487":70893,"_30445":70862,"_21099":117786,"_5":14424,"_27663":117700,"_2970":117787},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3487":70894,"_30445":70862,"_21099":117789,"_5":14424,"_27663":117700,"_2970":117790},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3487":70895,"_30445":70862,"_21099":117792,"_5":14424,"_27663":117704,"_2970":117793},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3487":70896,"_30445":70862,"_21099":117795,"_5":14424,"_27663":117708,"_2970":117796},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3487":70897,"_30445":70862,"_21099":117798,"_5":14424,"_27663":117708,"_2970":117799},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3487":70898,"_30445":70862,"_21099":117801,"_5":14424,"_27663":117708,"_2970":117802},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3487":70899,"_30445":70862,"_21099":117804,"_5":14424,"_27663":117708,"_2970":117805},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3487":70900,"_30445":70862,"_21099":117807,"_5":14424,"_27663":117708,"_2970":117808},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3487":70901,"_30445":70862,"_21099":117810,"_5":14424,"_27663":117708,"_2970":117811},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3487":70902,"_30445":70862,"_21099":117813,"_5":14424,"_27663":117708,"_2970":117814},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3487":70903,"_30445":70862,"_21099":117816,"_5":14424,"_27663":117712,"_2970":117817},[],"Los servicios leen un catálogo explícito de variables de entorno para credenciales cuando cargan su configuración al arrancar. Una variable definida y no vacía sobrescribe el valor correspondiente del YAML; una variable sin definir deja el valor del YAML intacto, así que un despliegue configurado solo mediante YAML sigue funcionando igual. Una variable también puede aportar una credencial que el archivo de valores no define. Las variables fuera de este catálogo se ignoran — otras variables `LAMASSU_*` no se recogen automáticamente.",{"_3487":70904,"_30445":70862,"_21099":117819,"_5":14424,"_27663":117712,"_2970":50369},[],{"_3487":70905,"_30445":70862,"_21099":117821,"_5":14424,"_27663":117712,"_2970":117822},[],"Configura",{"_3487":70906,"_30445":70862,"_21099":117824,"_5":14424,"_27663":117712,"_2970":50375},[],{"_3487":70907,"_30445":70862,"_21099":117826,"_5":14424,"_27663":117712,"_2970":117827},[],"credenciales del almacenamiento PostgreSQL",{"_3487":70908,"_30445":70862,"_21099":117829,"_5":14424,"_27663":117712,"_2970":50381},[],{"_3487":70909,"_30445":70862,"_21099":117831,"_5":14424,"_27663":117712,"_2970":117832},[],"credenciales de la base de datos propia del servicio authz",{"_3487":70910,"_30445":70862,"_21099":117834,"_5":14424,"_27663":117712,"_2970":50387},[],{"_3487":70911,"_30445":70862,"_21099":117836,"_5":14424,"_27663":117712,"_2970":117837},[],"un único par aplicado a todas las conexiones del bus de eventos: publisher, suscriptores y dead-letter queues. No hay división por cola.",{"_3487":70912,"_30445":70862,"_21099":117839,"_5":14424,"_27663":117712,"_2970":50393},[],{"_3487":70913,"_30445":70862,"_21099":117841,"_5":14424,"_27663":117712,"_2970":117842},[],"credenciales SMTP usadas por el envío de emails de alerta",{"_3487":70914,"_30445":70862,"_21099":117844,"_5":14424,"_27663":117712,"_2970":50399},[],{"_3487":70915,"_30445":70862,"_21099":117846,"_5":14424,"_27663":117712,"_2970":117847},[],"un par por cada schema definido en el mapa `services.authz.credentials`",{"_3487":70916,"_30445":70862,"_21099":117849,"_5":14424,"_27663":117712,"_2970":117850},[],"Definir una variable del catálogo con la cadena vacía nunca sobrescribe nada. Si el valor del YAML (o el predeterminado) no está vacío, el servicio falla al arrancar con un error que nombra la variable y la clave de configuración, por ejemplo `LAMASSU_POSTGRES_PASSWORD is set but empty`. Combinar una variable vacía con un valor de YAML vacío o ausente está permitido.",{"_3487":70917,"_30445":70862,"_21099":117852,"_5":14424,"_27663":117712,"_2970":117853},[],"Para los schemas de authz, `<SCHEMA>` es el nombre del schema del YAML en mayúsculas y con cada carácter no alfanumérico sustituido por `_`: `pki` se corresponde con `PKI`, y tanto `pki-v2` como `pki.v2` se corresponden con `PKI_V2`. Los bindings existen solo para los schemas presentes en el mapa de credenciales del YAML, así que las variables de schemas no listados se ignoran. Dos schemas que se reducen al mismo nombre (`pki-v2` y `pki.v2`) entran en conflicto: si se define una variable de cualquiera de los dos pares, el servicio falla al arrancar; si las variables no están definidas, se registra un warning y se usan los valores del YAML.",{"_3487":70918,"_30445":70862,"_21099":117855,"_5":14424,"_27663":117712,"_2970":117856},[],"Estas variables están pensadas para alimentarse desde Secrets de Kubernetes, de modo que las credenciales ya no tienen que escribirse en el YAML renderizado. Por ejemplo, inyecta un par en el pod de un servicio con el mecanismo estándar `secretKeyRef` de Kubernetes:",{"_3487":70919,"_30445":70862,"_21099":117858,"_5":14424,"_27663":117712,"_2970":117859},[],"Como las variables se leen cuando el servicio carga su configuración al arrancar, cambiar el Secret subyacente exige reiniciar los pods consumidores para que los nuevos valores surtan efecto.",{"_3487":70920,"_30445":70862,"_21099":117861,"_5":14424,"_27663":117716,"_2970":117862},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3487":70921,"_30445":70862,"_21099":117864,"_5":14424,"_27663":117716,"_2970":117865},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3487":70922,"_30445":70862,"_21099":117867,"_5":14424,"_27663":117716,"_2970":117868},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3487":70923,"_30445":70862,"_21099":117870,"_5":14424,"_27663":117716,"_2970":117871},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3487":70924,"_30445":70862,"_21099":117873,"_5":14424,"_27663":117720,"_2970":117874},[],"Para instalar un checkout local:",{"_3487":70925,"_30445":70862,"_21099":117876,"_5":14424,"_27663":117724,"_2970":117877},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3487":70926,"_30445":70862,"_21099":117879,"_5":14424,"_27663":117724,"_2970":117880},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3487":70927,"_30445":70862,"_21099":117882,"_5":14424,"_27663":117728,"_2970":117883},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3487":70928,"_30445":70862,"_21099":117885,"_5":14424,"_27663":117728,"_2970":117886},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3487":70929,"_30445":70862,"_21099":117888,"_5":14424,"_27663":117728,"_2970":117889},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3487":70930,"_30445":70862,"_21099":117891,"_5":14424,"_27663":117728,"_2970":117892},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3487":70931,"_30445":70862,"_21099":117894,"_5":14424,"_27663":117728,"_2970":117895},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3487":70932,"_30445":70862,"_21099":117897,"_5":14424,"_27663":117732,"_2970":117898},[],"Antes de pasar a producción, revisa:",{"_3487":70933,"_30445":70862,"_21099":117900,"_5":14424,"_27663":117732,"_2970":117901},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3487":70934,"_30445":70862,"_21099":117903,"_5":14424,"_27663":117732,"_2970":117904},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3487":70935,"_30445":70862,"_21099":117906,"_5":14424,"_27663":117732,"_2970":117907},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3487":70936,"_30445":70862,"_21099":117909,"_5":14424,"_27663":117732,"_2970":117910},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3487":70937,"_30445":70862,"_21099":117912,"_5":14424,"_27663":117732,"_2970":117913},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3487":70938,"_30445":70862,"_21099":117915,"_5":14424,"_27663":117732,"_2970":117916},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3487":70939,"_30445":70862,"_21099":117918,"_5":14424,"_27663":117732,"_2970":117919},[],"SMTP, observabilidad y entrega de alertas",{"_3487":70940,"_30445":70862,"_21099":117921,"_5":14424,"_27663":117732,"_2970":117922},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3487":70941,"_30445":70862,"_21099":117924,"_5":14424,"_27663":117732,"_2970":117925},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3487":70942,"_30445":70942,"_5":14788,"_2970":117927,"_30797":117928,"_21099":117929,"_27663":70942},"Expón el Gateway",[49622,117107,117341],[],{"_3487":70943,"_30445":70942,"_21099":117931,"_5":14424,"_27663":70942,"_2970":117932},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3487":70944,"_30445":70942,"_5":30794,"_21099":117934,"_27663":117935,"_2970":117936},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3487":70945,"_30445":70942,"_5":30794,"_21099":117938,"_27663":117939,"_2970":117940},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3487":70946,"_30445":70942,"_5":30794,"_21099":117942,"_27663":117943,"_2970":117944},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3487":70947,"_30445":70942,"_5":30794,"_21099":117946,"_27663":117947,"_2970":50503},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#k3s",{"_3487":70948,"_30445":70942,"_5":30794,"_21099":117949,"_27663":117950,"_2970":117951},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3487":70949,"_30445":70942,"_5":30794,"_21099":117953,"_27663":117954,"_2970":117955},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3487":70950,"_30445":70942,"_5":30794,"_21099":117957,"_27663":117958,"_2970":117959},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3487":70951,"_30445":70942,"_5":30794,"_21099":117961,"_27663":117962,"_2970":117963},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3487":70952,"_30445":70942,"_5":30794,"_21099":117965,"_27663":117966,"_2970":117967},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3487":70953,"_30445":70942,"_5":30794,"_21099":117969,"_27663":117970,"_2970":117971},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3487":70954,"_30445":70942,"_5":30794,"_21099":117973,"_27663":117974,"_2970":117975},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3487":70955,"_30445":70942,"_21099":117977,"_5":14424,"_27663":117935,"_2970":117978},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3487":70956,"_30445":70942,"_21099":117980,"_5":14424,"_27663":117935,"_2970":117981},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3487":70957,"_30445":70942,"_21099":117983,"_5":14424,"_27663":117939,"_2970":117984},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3487":70958,"_30445":70942,"_21099":117986,"_5":14424,"_27663":117939,"_2970":117987},[],"Defínelo únicamente cuando:",{"_3487":70959,"_30445":70942,"_21099":117989,"_5":14424,"_27663":117939,"_2970":117990},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3487":70960,"_30445":70942,"_21099":117992,"_5":14424,"_27663":117939,"_2970":117993},[],"esa dirección está asignada a este Gateway",{"_3487":70961,"_30445":70942,"_21099":117995,"_5":14424,"_27663":117939,"_2970":117996},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3487":70962,"_30445":70942,"_21099":117998,"_5":14424,"_27663":117939,"_2970":117999},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3487":70963,"_30445":70942,"_21099":118001,"_5":14424,"_27663":117939,"_2970":118002},[],"No confundas estos valores:",{"_3487":70964,"_30445":70942,"_21099":118004,"_5":14424,"_27663":117939,"_2970":118005},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3487":70965,"_30445":70942,"_21099":118007,"_5":14424,"_27663":117939,"_2970":118008},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3487":70966,"_30445":70942,"_21099":118010,"_5":14424,"_27663":117939,"_2970":118011},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3487":70967,"_30445":70942,"_21099":118013,"_5":14424,"_27663":117943,"_2970":118014},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3487":70968,"_30445":70942,"_21099":118016,"_5":14424,"_27663":117943,"_2970":118017},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3487":70969,"_30445":70942,"_21099":118019,"_5":14424,"_27663":117947,"_2970":118020},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3487":70970,"_30445":70942,"_21099":118022,"_5":14424,"_27663":117947,"_2970":118023},[],"Para el diseño recomendado:",{"_3487":70971,"_30445":70942,"_21099":118025,"_5":14424,"_27663":117947,"_2970":118026},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3487":70972,"_30445":70942,"_21099":118028,"_5":14424,"_27663":117947,"_2970":118029},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3487":70973,"_30445":70942,"_21099":118031,"_5":14424,"_27663":117947,"_2970":118032},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3487":70974,"_30445":70942,"_21099":118034,"_5":14424,"_27663":117947,"_2970":118035},[],"Apunta DNS a la dirección accesible de la VM.",{"_3487":70975,"_30445":70942,"_21099":118037,"_5":14424,"_27663":117947,"_2970":118038},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3487":70976,"_30445":70942,"_21099":118040,"_5":14424,"_27663":117950,"_2970":118041},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3487":70977,"_30445":70942,"_21099":118043,"_5":14424,"_27663":117954,"_2970":118044},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3487":70978,"_30445":70942,"_21099":118046,"_5":14424,"_27663":117954,"_2970":118047},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3487":70979,"_30445":70942,"_21099":118049,"_5":14424,"_27663":117958,"_2970":118050},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3487":70980,"_30445":70942,"_21099":118052,"_5":14424,"_27663":117958,"_2970":118053},[],"Requisito",{"_3487":70981,"_30445":70942,"_21099":118055,"_5":14424,"_27663":117958,"_2970":118056},[],"Diseño recomendado",{"_3487":70982,"_30445":70942,"_21099":118058,"_5":14424,"_27663":117958,"_2970":118059},[],"Consecuencia",{"_3487":70983,"_30445":70942,"_21099":118061,"_5":14424,"_27663":117958,"_2970":118062},[],"Varias URL o servicios de Lamassu",{"_3487":70984,"_30445":70942,"_21099":118064,"_5":14424,"_27663":117958,"_2970":118065},[],"Un Gateway con varias rutas",{"_3487":70985,"_30445":70942,"_21099":118067,"_5":14424,"_27663":117958,"_2970":118068},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3487":70986,"_30445":70942,"_21099":118070,"_5":14424,"_27663":117958,"_2970":118071},[],"Gateways independientes e IP externas distintas",{"_3487":70987,"_30445":70942,"_21099":118073,"_5":14424,"_27663":117958,"_2970":118074},[],"Una VIP por Gateway",{"_3487":70988,"_30445":70942,"_21099":118076,"_5":14424,"_27663":117958,"_2970":118077},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3487":70989,"_30445":70942,"_21099":118079,"_5":14424,"_27663":117958,"_2970":118080},[],"Gateways independientes, un nodo y una IP",{"_3487":70990,"_30445":70942,"_21099":118082,"_5":14424,"_27663":117958,"_2970":118083},[],"Puertos externos diferentes",{"_3487":70991,"_30445":70942,"_21099":118085,"_5":14424,"_27663":117958,"_2970":118086},[],"Los clientes deben indicar puertos no estándar",{"_3487":70992,"_30445":70942,"_21099":118088,"_5":14424,"_27663":117958,"_2970":118089},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3487":70993,"_30445":70942,"_21099":118091,"_5":14424,"_27663":117958,"_2970":118092},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3487":70994,"_30445":70942,"_21099":118094,"_5":14424,"_27663":117958,"_2970":118095},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3487":70995,"_30445":70942,"_21099":118097,"_5":14424,"_27663":117958,"_2970":118098},[],"Recursos Gateway separados pero proxy compartido",{"_3487":70996,"_30445":70942,"_21099":118100,"_5":14424,"_27663":117958,"_2970":118101},[],"Modo merged Gateway de Envoy",{"_3487":70997,"_30445":70942,"_21099":118103,"_5":14424,"_27663":117958,"_2970":118104},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3487":70998,"_30445":70942,"_21099":118106,"_5":14424,"_27663":117958,"_2970":118107},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3487":70999,"_30445":70942,"_21099":118109,"_5":14424,"_27663":117958,"_2970":118110},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3487":71000,"_30445":70942,"_21099":118112,"_5":14424,"_27663":117958,"_2970":118113},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3487":71001,"_30445":70942,"_21099":118115,"_5":14424,"_27663":117958,"_2970":118116},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3487":71002,"_30445":70942,"_21099":118118,"_5":14424,"_27663":117962,"_2970":118119},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3487":71003,"_30445":70942,"_21099":118121,"_5":14424,"_27663":117966,"_2970":118122},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3487":71004,"_30445":70942,"_21099":118124,"_5":14424,"_27663":117966,"_2970":118125},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3487":71005,"_30445":70942,"_21099":118127,"_5":14424,"_27663":117966,"_2970":118128},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3487":71006,"_30445":70942,"_21099":118130,"_5":14424,"_27663":117966,"_2970":118131},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3487":71007,"_30445":70942,"_21099":118133,"_5":14424,"_27663":117966,"_2970":118134},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3487":71008,"_30445":70942,"_21099":118136,"_5":14424,"_27663":117970,"_2970":118137},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3487":71009,"_30445":70942,"_21099":118139,"_5":14424,"_27663":117970,"_2970":118140},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3487":71010,"_30445":70942,"_21099":118142,"_5":14424,"_27663":117974,"_2970":118143},[],"Comprueba, en orden:",{"_3487":71011,"_30445":70942,"_21099":118145,"_5":14424,"_27663":117974,"_2970":118146},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3487":71012,"_30445":70942,"_21099":118148,"_5":14424,"_27663":117974,"_2970":118149},[],"Su estado contiene la dirección esperada.",{"_3487":71013,"_30445":70942,"_21099":118151,"_5":14424,"_27663":117974,"_2970":118152},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3487":71014,"_30445":70942,"_21099":118154,"_5":14424,"_27663":117974,"_2970":118155},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3487":71015,"_30445":70942,"_21099":118157,"_5":14424,"_27663":117974,"_2970":118158},[],"DNS resuelve al endpoint accesible externamente.",{"_3487":71016,"_30445":70942,"_21099":118160,"_5":14424,"_27663":117974,"_2970":118161},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3487":71017,"_30445":70942,"_21099":118163,"_5":14424,"_27663":117974,"_2970":118164},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3487":71018,"_30445":71018,"_5":14788,"_2970":49729,"_30797":118166,"_21099":118167,"_27663":71018},[49622,117107,117341],[],{"_3487":71019,"_30445":71018,"_21099":118169,"_5":14424,"_27663":71018,"_2970":118170},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3487":71020,"_30445":71018,"_5":30794,"_21099":118172,"_27663":118173,"_2970":118174},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3487":71021,"_30445":71018,"_5":30794,"_21099":118176,"_27663":118177,"_2970":118178},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3487":71022,"_30445":71018,"_5":30794,"_21099":118180,"_27663":118181,"_2970":118182},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3487":71023,"_30445":71018,"_5":30794,"_21099":118184,"_27663":118185,"_2970":118186},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3487":71024,"_30445":71018,"_5":30794,"_21099":118188,"_27663":118189,"_2970":118190},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3487":71025,"_30445":71018,"_5":30794,"_21099":118192,"_27663":118193,"_2970":118194},[],"/docs/pr-preview/pr-68/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3487":71026,"_30445":71018,"_21099":118196,"_5":14424,"_27663":118173,"_2970":118197},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3487":71027,"_30445":71018,"_21099":118199,"_5":14424,"_27663":118177,"_2970":118200},[],"Flujo",{"_3487":71028,"_30445":71018,"_21099":118202,"_5":14424,"_27663":118177,"_2970":118203},[],"Úsalo para",{"_3487":71029,"_30445":71018,"_21099":118205,"_5":14424,"_27663":118177,"_2970":118206},[],"Qué instala",{"_3487":71030,"_30445":71018,"_21099":118208,"_5":14424,"_27663":118177,"_2970":50765},[],{"_3487":71031,"_30445":71018,"_21099":118210,"_5":14424,"_27663":118177,"_2970":118211},[],"Producción y entornos controlados",{"_3487":71032,"_30445":71018,"_21099":118213,"_5":14424,"_27663":118177,"_2970":118214},[],"Servicios de Lamassu y recursos de Gateway API",{"_3487":71033,"_30445":71018,"_21099":118216,"_5":14424,"_27663":118177,"_2970":49866},[],{"_3487":71034,"_30445":71018,"_21099":118218,"_5":14424,"_27663":118177,"_2970":118219},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3487":71035,"_30445":71018,"_21099":118221,"_5":14424,"_27663":118177,"_2970":118222},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3487":71036,"_30445":71018,"_21099":118224,"_5":14424,"_27663":118181,"_2970":118225},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3487":71037,"_30445":71018,"_21099":118227,"_5":14424,"_27663":118181,"_2970":118228},[],"Área",{"_3487":71038,"_30445":71018,"_21099":118230,"_5":14424,"_27663":118181,"_2970":118231},[],"El chart de Lamassu proporciona",{"_3487":71039,"_30445":71018,"_21099":118233,"_5":14424,"_27663":118181,"_2970":118234},[],"Tú proporcionas",{"_3487":71040,"_30445":71018,"_21099":118236,"_5":14424,"_27663":118181,"_2970":118237},[],"Aplicaciones Lamassu",{"_3487":71041,"_30445":71018,"_21099":118239,"_5":14424,"_27663":118181,"_2970":118240},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3487":71042,"_30445":71018,"_21099":118242,"_5":14424,"_27663":118181,"_2970":118243},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3487":71043,"_30445":71018,"_21099":118245,"_5":14424,"_27663":118181,"_2970":118246},[],"Datos PostgreSQL",{"_3487":71044,"_30445":71018,"_21099":118248,"_5":14424,"_27663":118181,"_2970":118249},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3487":71045,"_30445":71018,"_21099":118251,"_5":14424,"_27663":118181,"_2970":118252},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3487":71046,"_30445":71018,"_21099":118254,"_5":14424,"_27663":118181,"_2970":118255},[],"Mensajería",{"_3487":71047,"_30445":71018,"_21099":118257,"_5":14424,"_27663":118181,"_2970":118258},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3487":71048,"_30445":71018,"_21099":118260,"_5":14424,"_27663":118181,"_2970":118261},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3487":71049,"_30445":71018,"_21099":118263,"_5":14424,"_27663":118181,"_2970":118264},[],"Identidad",{"_3487":71050,"_30445":71018,"_21099":118266,"_5":14424,"_27663":118181,"_2970":118267},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3487":71051,"_30445":71018,"_21099":118269,"_5":14424,"_27663":118181,"_2970":118270},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3487":71052,"_30445":71018,"_21099":118272,"_5":14424,"_27663":118181,"_2970":118273},[],"Enrutamiento externo",{"_3487":71053,"_30445":71018,"_21099":118275,"_5":14424,"_27663":118181,"_2970":118276},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3487":71054,"_30445":71018,"_21099":118278,"_5":14424,"_27663":118181,"_2970":118279},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3487":71055,"_30445":71018,"_21099":118281,"_5":14424,"_27663":118181,"_2970":50839},[],{"_3487":71056,"_30445":71018,"_21099":118283,"_5":14424,"_27663":118181,"_2970":118284},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3487":71057,"_30445":71018,"_21099":118286,"_5":14424,"_27663":118181,"_2970":118287},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3487":71058,"_30445":71018,"_21099":118289,"_5":14424,"_27663":118181,"_2970":118290},[],"Datos persistentes de la aplicación",{"_3487":71059,"_30445":71018,"_21099":118292,"_5":14424,"_27663":118181,"_2970":118293},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3487":71060,"_30445":71018,"_21099":118295,"_5":14424,"_27663":118181,"_2970":118296},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3487":71061,"_30445":71018,"_21099":118298,"_5":14424,"_27663":118181,"_2970":118299},[],"Integraciones opcionales",{"_3487":71062,"_30445":71018,"_21099":118301,"_5":14424,"_27663":118181,"_2970":118302},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3487":71063,"_30445":71018,"_21099":118304,"_5":14424,"_27663":118181,"_2970":118305},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3487":71064,"_30445":71018,"_21099":118307,"_5":14424,"_27663":118181,"_2970":118308},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3487":71065,"_30445":71018,"_21099":118310,"_5":14424,"_27663":118181,"_2970":118311},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3487":71066,"_30445":71018,"_21099":118313,"_5":14424,"_27663":118185,"_2970":118314},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3487":71067,"_30445":71018,"_21099":118316,"_5":14424,"_27663":118185,"_2970":118317},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3487":71068,"_30445":71018,"_21099":118319,"_5":14424,"_27663":118189,"_2970":118320},[],"Kubernetes 1.24 o posterior",{"_3487":71069,"_30445":71018,"_21099":118322,"_5":14424,"_27663":118189,"_2970":118323},[],"Helm 3.2 o posterior",{"_3487":71070,"_30445":71018,"_21099":118325,"_5":14424,"_27663":118189,"_2970":118326},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3487":71071,"_30445":71018,"_21099":118328,"_5":14424,"_27663":118189,"_2970":118329},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3487":71072,"_30445":71018,"_21099":118331,"_5":14424,"_27663":118189,"_2970":118332},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3487":71073,"_30445":71018,"_21099":118334,"_5":14424,"_27663":118189,"_2970":118335},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3487":71074,"_30445":71018,"_21099":118337,"_5":14424,"_27663":118189,"_2970":118338},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3487":71075,"_30445":71018,"_21099":118340,"_5":14424,"_27663":118193,"_2970":118341},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3487":71076,"_30445":71018,"_21099":118343,"_5":14424,"_27663":118193,"_2970":118344},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3487":71077,"_30445":71018,"_21099":118346,"_5":14424,"_27663":118193,"_2970":118347},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3487":71078,"_30445":71018,"_21099":118349,"_5":14424,"_27663":118193,"_2970":118350},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3487":71079,"_30445":71079,"_5":14788,"_2970":118352,"_30797":118353,"_21099":118355,"_27663":71079},"Resolución de problemas de despliegue",[49622,117107,118354],"Operación",[],{"_3487":71080,"_30445":71079,"_21099":118357,"_5":14424,"_27663":71079,"_2970":118358},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3487":71081,"_30445":71079,"_5":30794,"_21099":118360,"_27663":118361,"_2970":118362},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3487":71082,"_30445":71079,"_5":30794,"_21099":118364,"_27663":118365,"_2970":118366},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3487":71083,"_30445":71079,"_5":30794,"_21099":118368,"_27663":118369,"_2970":118370},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3487":71084,"_30445":71079,"_5":30794,"_21099":118372,"_27663":118373,"_2970":118374},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3487":71085,"_30445":71079,"_5":30794,"_21099":118376,"_27663":118377,"_2970":118378},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3487":71086,"_30445":71079,"_5":30794,"_21099":118380,"_27663":118381,"_2970":118382},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3487":71087,"_30445":71079,"_5":30794,"_21099":118384,"_27663":118385,"_2970":118386},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3487":71088,"_30445":71079,"_5":30794,"_21099":118388,"_27663":118389,"_2970":118390},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3487":71089,"_30445":71079,"_5":30794,"_21099":118392,"_27663":118393,"_2970":118394},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3487":71090,"_30445":71079,"_5":30794,"_21099":118396,"_27663":118397,"_2970":118398},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3487":71091,"_30445":71079,"_5":30794,"_21099":118400,"_27663":118401,"_2970":118402},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3487":71092,"_30445":71079,"_5":30794,"_21099":118404,"_27663":118405,"_2970":118406},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3487":71093,"_30445":71079,"_5":30794,"_21099":118408,"_27663":118409,"_2970":118410},[],"/docs/pr-preview/pr-68/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3487":71094,"_30445":71079,"_21099":118412,"_5":14424,"_27663":71079,"_2970":118413},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3487":71095,"_30445":71079,"_21099":118415,"_5":14424,"_27663":118365,"_2970":118416},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3487":71096,"_30445":71079,"_21099":118418,"_5":14424,"_27663":118369,"_2970":118419},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3487":71097,"_30445":71079,"_21099":118421,"_5":14424,"_27663":118373,"_2970":118422},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3487":71098,"_30445":71079,"_21099":118424,"_5":14424,"_27663":118377,"_2970":118425},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3487":71099,"_30445":71079,"_21099":118427,"_5":14424,"_27663":118381,"_2970":118428},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3487":71100,"_30445":71079,"_21099":118430,"_5":14424,"_27663":118385,"_2970":118431},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3487":71101,"_30445":71079,"_21099":118433,"_5":14424,"_27663":118385,"_2970":118434},[],"Ejecuta también la prueba de conectividad del chart:",{"_3487":71102,"_30445":71079,"_21099":118436,"_5":14424,"_27663":118385,"_2970":118437},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3487":71103,"_30445":71079,"_21099":118439,"_5":14424,"_27663":118385,"_2970":118440},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3487":71104,"_30445":71079,"_21099":118442,"_5":14424,"_27663":118389,"_2970":118443},[],"Si recibes un 401:",{"_3487":71105,"_30445":71079,"_21099":118445,"_5":14424,"_27663":118389,"_2970":118446},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3487":71106,"_30445":71079,"_21099":118448,"_5":14424,"_27663":118389,"_2970":118449},[],"verifica emisor, audiencia y expiración del token;",{"_3487":71107,"_30445":71079,"_21099":118451,"_5":14424,"_27663":118389,"_2970":118452},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3487":71108,"_30445":71079,"_21099":118454,"_5":14424,"_27663":118389,"_2970":118455},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3487":71109,"_30445":71079,"_21099":118457,"_5":14424,"_27663":118389,"_2970":118458},[],"Si el login termina pero las APIs devuelven 403:",{"_3487":71110,"_30445":71079,"_21099":118460,"_5":14424,"_27663":118389,"_2970":118461},[],"inspecciona los claims reales del token;",{"_3487":71111,"_30445":71079,"_21099":118463,"_5":14424,"_27663":118389,"_2970":118464},[],"confirma que coinciden con un principal activo;",{"_3487":71112,"_30445":71079,"_21099":118466,"_5":14424,"_27663":118389,"_2970":118467},[],"revisa las políticas concedidas al principal;",{"_3487":71113,"_30445":71079,"_21099":118469,"_5":14424,"_27663":118389,"_2970":118470},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3487":71114,"_30445":71079,"_21099":118472,"_5":14424,"_27663":118389,"_2970":118473},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3487":71115,"_30445":71079,"_21099":118475,"_5":14424,"_27663":118393,"_2970":118476},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3487":71116,"_30445":71079,"_21099":118478,"_5":14424,"_27663":118393,"_2970":118479},[],"Localiza el pod y Service de authz.",{"_3487":71117,"_30445":71079,"_21099":118481,"_5":14424,"_27663":118393,"_2970":118482},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3487":71118,"_30445":71079,"_21099":118484,"_5":14424,"_27663":118393,"_2970":118485},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3487":71119,"_30445":71079,"_21099":118487,"_5":14424,"_27663":118393,"_2970":118488},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3487":71120,"_30445":71079,"_21099":118490,"_5":14424,"_27663":118393,"_2970":118491},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3487":71121,"_30445":71079,"_21099":118493,"_5":14424,"_27663":118397,"_2970":118494},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3487":71122,"_30445":71079,"_21099":118496,"_5":14424,"_27663":118401,"_2970":118497},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3487":71123,"_30445":71079,"_21099":118499,"_5":14424,"_27663":118401,"_2970":118500},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3487":71124,"_30445":71079,"_21099":118502,"_5":14424,"_27663":118401,"_2970":118503},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3487":71125,"_30445":71079,"_21099":118505,"_5":14424,"_27663":118401,"_2970":118506},[],"una variable de entorno de credenciales definida con la cadena vacía mientras el valor correspondiente del YAML no está vacío: el servicio falla al arrancar y nombra la variable y la clave de configuración, por ejemplo `LAMASSU_POSTGRES_PASSWORD is set but empty`;",{"_3487":71126,"_30445":71079,"_21099":118508,"_5":14424,"_27663":118401,"_2970":118509},[],"para authz, dos schemas del mapa de credenciales que se reducen al mismo nombre de variable de entorno (por ejemplo `pki-v2` y `pki.v2`): el arranque falla cuando hay una variable de credenciales definida para cualquiera de los dos; si las variables no están definidas, el servicio registra un warning y usa los valores del YAML.",{"_3487":71127,"_30445":71079,"_21099":118511,"_5":14424,"_27663":118401,"_2970":118512},[],"volumen persistente sin enlazar;",{"_3487":71128,"_30445":71079,"_21099":118514,"_5":14424,"_27663":118401,"_2970":118515},[],"imagen inaccesible o política de pull incorrecta;",{"_3487":71129,"_30445":71079,"_21099":118517,"_5":14424,"_27663":118401,"_2970":118518},[],"configuración inválida del motor criptográfico;",{"_3487":71130,"_30445":71079,"_21099":118520,"_5":14424,"_27663":118401,"_2970":118521},[],"límites de CPU o memoria demasiado bajos;",{"_3487":71131,"_30445":71079,"_21099":118523,"_5":14424,"_27663":118401,"_2970":118524},[],"migración previa incompleta.",{"_3487":71132,"_30445":71079,"_21099":118526,"_5":14424,"_27663":118401,"_2970":118527},[],"Estos fallos de arranque provienen de las variables de entorno para credenciales descritas en Variables de entorno para credenciales.",{"_3487":71133,"_30445":71079,"_21099":118529,"_5":14424,"_27663":118401,"_2970":118530},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3487":71134,"_30445":71079,"_21099":118532,"_5":14424,"_27663":118401,"_2970":118533},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3487":71135,"_30445":71079,"_21099":118535,"_5":14424,"_27663":118401,"_2970":118536},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3487":71136,"_30445":71079,"_21099":118538,"_5":14424,"_27663":118405,"_2970":118539},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3487":71137,"_30445":71079,"_21099":118541,"_5":14424,"_27663":118405,"_2970":118542},[],"verifica que esté habilitado en el servicio emisor;",{"_3487":71138,"_30445":71079,"_21099":118544,"_5":14424,"_27663":118405,"_2970":118545},[],"comprueba conectividad y credenciales AMQP;",{"_3487":71139,"_30445":71079,"_21099":118547,"_5":14424,"_27663":118405,"_2970":118548},[],"revisa exchange, routing key, colas y consumidores;",{"_3487":71140,"_30445":71079,"_21099":118550,"_5":14424,"_27663":118405,"_2970":118551},[],"inspecciona dead-letter queues;",{"_3487":71141,"_30445":71079,"_21099":118553,"_5":14424,"_27663":118405,"_2970":118554},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3487":71142,"_30445":71079,"_21099":118556,"_5":14424,"_27663":118405,"_2970":118557},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3487":71143,"_30445":71079,"_21099":118559,"_5":14424,"_27663":118405,"_2970":118560},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3487":71144,"_30445":71079,"_21099":118562,"_5":14424,"_27663":118405,"_2970":118563},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3487":71145,"_30445":71079,"_21099":118565,"_5":14424,"_27663":118405,"_2970":118566},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3487":71146,"_30445":71079,"_21099":118568,"_5":14424,"_27663":118405,"_2970":118569},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3487":71147,"_30445":71079,"_21099":118571,"_5":14424,"_27663":118405,"_2970":118572},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3487":71148,"_30445":71079,"_21099":118574,"_5":14424,"_27663":118405,"_2970":118575},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3487":71149,"_30445":71079,"_21099":118577,"_5":14424,"_27663":118409,"_2970":118578},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3487":71150,"_30445":71079,"_21099":118580,"_5":14424,"_27663":118409,"_2970":118581},[],"Antes de cerrar una incidencia, guarda:",{"_3487":71151,"_30445":71079,"_21099":118583,"_5":14424,"_27663":118409,"_2970":118584},[],"causa confirmada;",{"_3487":71152,"_30445":71079,"_21099":118586,"_5":14424,"_27663":118409,"_2970":118587},[],"alcance temporal y recursos afectados;",{"_3487":71153,"_30445":71079,"_21099":118589,"_5":14424,"_27663":118409,"_2970":118590},[],"comandos o consultas utilizados;",{"_3487":71154,"_30445":71079,"_21099":118592,"_5":14424,"_27663":118409,"_2970":118593},[],"cambio aplicado y forma de revertirlo;",{"_3487":71155,"_30445":71079,"_21099":118595,"_5":14424,"_27663":118409,"_2970":118596},[],"validación desde un consumidor;",{"_3487":71156,"_30445":71079,"_21099":118598,"_5":14424,"_27663":118409,"_2970":118599},[],"acción preventiva y propietario.",{"_3487":71157,"_30445":71157,"_5":14788,"_2970":118601,"_30797":118602,"_21099":118605,"_27663":71157},"Control de acceso",[49622,118603,118604],"Plataforma","Administración",[],{"_3487":71158,"_30445":71157,"_21099":118607,"_5":14424,"_27663":71157,"_2970":118608},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3487":71159,"_30445":71157,"_5":30794,"_21099":118610,"_27663":118611,"_2970":118612},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3487":71160,"_30445":71157,"_5":30794,"_21099":118614,"_27663":118615,"_2970":118616},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3487":71161,"_30445":71157,"_5":30794,"_21099":118618,"_27663":118619,"_2970":118620},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3487":71162,"_30445":71157,"_5":30794,"_21099":118622,"_27663":118623,"_2970":118624},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3487":71163,"_30445":71157,"_5":30794,"_21099":118626,"_27663":118627,"_2970":118628},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3487":71164,"_30445":71157,"_5":30794,"_21099":118630,"_27663":118631,"_2970":118632},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3487":71165,"_30445":71157,"_5":30794,"_21099":118634,"_27663":118635,"_2970":118636},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3487":71166,"_30445":71157,"_5":30794,"_21099":118638,"_27663":118639,"_2970":118640},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3487":71167,"_30445":71157,"_5":30794,"_21099":118642,"_27663":118643,"_2970":118644},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3487":71168,"_30445":71157,"_5":30794,"_21099":118646,"_27663":118647,"_2970":118648},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3487":71169,"_30445":71157,"_5":30794,"_21099":118650,"_27663":118651,"_2970":118652},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3487":71170,"_30445":71157,"_5":30794,"_21099":118654,"_27663":118655,"_2970":118656},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3487":71171,"_30445":71157,"_5":30794,"_21099":118658,"_27663":118659,"_2970":118660},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3487":71172,"_30445":71157,"_5":30794,"_21099":118662,"_27663":118663,"_2970":118664},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3487":71173,"_30445":71157,"_5":30794,"_21099":118666,"_27663":118667,"_2970":118668},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3487":71174,"_30445":71157,"_5":30794,"_21099":118670,"_27663":118671,"_2970":117717},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3487":71175,"_30445":71157,"_5":30794,"_21099":118673,"_27663":118674,"_2970":118675},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3487":71176,"_30445":71157,"_5":30794,"_21099":118677,"_27663":118678,"_2970":118679},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3487":71177,"_30445":71157,"_5":30794,"_21099":118681,"_27663":118682,"_2970":118683},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3487":71178,"_30445":71157,"_5":30794,"_21099":118685,"_27663":118686,"_2970":118687},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3487":71179,"_30445":71157,"_5":30794,"_21099":118689,"_27663":118690,"_2970":118691},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3487":71180,"_30445":71157,"_5":30794,"_21099":118693,"_27663":118694,"_2970":118695},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3487":71181,"_30445":71157,"_5":30794,"_21099":118697,"_27663":118698,"_2970":118699},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3487":71182,"_30445":71157,"_5":30794,"_21099":118701,"_27663":118702,"_2970":118703},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3487":71183,"_30445":71157,"_5":30794,"_21099":118705,"_27663":118706,"_2970":118707},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3487":71184,"_30445":71157,"_5":30794,"_21099":118709,"_27663":118710,"_2970":118711},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3487":71185,"_30445":71157,"_5":30794,"_21099":118713,"_27663":118714,"_2970":118715},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3487":71186,"_30445":71157,"_5":30794,"_21099":118717,"_27663":118718,"_2970":118719},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3487":71187,"_30445":71157,"_5":30794,"_21099":118721,"_27663":118722,"_2970":118723},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3487":71188,"_30445":71157,"_5":30794,"_21099":118725,"_27663":118726,"_2970":118727},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3487":71189,"_30445":71157,"_5":30794,"_21099":118729,"_27663":118730,"_2970":118731},[],"/docs/pr-preview/pr-68/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3487":71190,"_30445":71157,"_21099":118733,"_5":14424,"_27663":71157,"_2970":118734},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3487":71191,"_30445":71157,"_21099":118736,"_5":14424,"_27663":71157,"_2970":118737},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3487":71192,"_30445":71157,"_21099":118739,"_5":14424,"_27663":71157,"_2970":118740},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3487":71193,"_30445":71157,"_21099":118742,"_5":14424,"_27663":118611,"_2970":118743},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3487":71194,"_30445":71157,"_21099":118745,"_5":14424,"_27663":118611,"_2970":118746},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3487":71195,"_30445":71157,"_21099":118748,"_5":14424,"_27663":118611,"_2970":118749},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3487":71196,"_30445":71157,"_21099":118751,"_5":14424,"_27663":118611,"_2970":118752},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3487":71197,"_30445":71157,"_21099":118754,"_5":14424,"_27663":118611,"_2970":118755},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3487":71198,"_30445":71157,"_21099":118757,"_5":14424,"_27663":118611,"_2970":118758},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3487":71199,"_30445":71157,"_21099":118760,"_5":14424,"_27663":118615,"_2970":118761},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3487":71200,"_30445":71157,"_21099":118763,"_5":14424,"_27663":118615,"_2970":118764},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3487":71201,"_30445":71157,"_21099":118766,"_5":14424,"_27663":118619,"_2970":118767},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3487":71202,"_30445":71157,"_21099":118769,"_5":14424,"_27663":118619,"_2970":118770},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3487":71203,"_30445":71157,"_21099":118772,"_5":14424,"_27663":118619,"_2970":118773},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3487":71204,"_30445":71157,"_21099":118775,"_5":14424,"_27663":118619,"_2970":118776},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3487":71205,"_30445":71157,"_21099":118778,"_5":14424,"_27663":118619,"_2970":118779},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3487":71206,"_30445":71157,"_21099":118781,"_5":14424,"_27663":118619,"_2970":118782},[],"Carga por separado las políticas concedidas a cada principal.",{"_3487":71207,"_30445":71157,"_21099":118784,"_5":14424,"_27663":118619,"_2970":118785},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3487":71208,"_30445":71157,"_21099":118787,"_5":14424,"_27663":118619,"_2970":118788},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3487":71209,"_30445":71157,"_21099":118790,"_5":14424,"_27663":118619,"_2970":118791},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3487":71210,"_30445":71157,"_21099":118793,"_5":14424,"_27663":118619,"_2970":118794},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3487":71211,"_30445":71157,"_21099":118796,"_5":14424,"_27663":118619,"_2970":118797},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3487":71212,"_30445":71157,"_21099":118799,"_5":14424,"_27663":118619,"_2970":118800},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3487":71213,"_30445":71157,"_21099":118802,"_5":14424,"_27663":118623,"_2970":118803},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3487":71214,"_30445":71157,"_21099":118805,"_5":14424,"_27663":118623,"_2970":118806},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3487":71215,"_30445":71157,"_21099":118808,"_5":14424,"_27663":118623,"_2970":118809},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3487":71216,"_30445":71157,"_21099":118811,"_5":14424,"_27663":118623,"_2970":118812},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3487":71217,"_30445":71157,"_21099":118814,"_5":14424,"_27663":118623,"_2970":118815},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3487":71218,"_30445":71157,"_21099":118817,"_5":14424,"_27663":118623,"_2970":118818},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3487":71219,"_30445":71157,"_21099":118820,"_5":14424,"_27663":118623,"_2970":118821},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3487":71220,"_30445":71157,"_21099":118823,"_5":14424,"_27663":118623,"_2970":118824},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3487":71221,"_30445":71157,"_21099":118826,"_5":14424,"_27663":118627,"_2970":118827},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3487":71222,"_30445":71157,"_21099":118829,"_5":14424,"_27663":118627,"_2970":118830},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3487":71223,"_30445":71157,"_21099":118832,"_5":14424,"_27663":118627,"_2970":118833},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3487":71224,"_30445":71157,"_21099":118835,"_5":14424,"_27663":118627,"_2970":118836},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3487":71225,"_30445":71157,"_21099":118838,"_5":14424,"_27663":118627,"_2970":118839},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3487":71226,"_30445":71157,"_21099":118841,"_5":14424,"_27663":118627,"_2970":118842},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3487":71227,"_30445":71157,"_21099":118844,"_5":14424,"_27663":118627,"_2970":118845},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3487":71228,"_30445":71157,"_21099":118847,"_5":14424,"_27663":118627,"_2970":118848},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3487":71229,"_30445":71157,"_21099":118850,"_5":14424,"_27663":118627,"_2970":118851},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3487":71230,"_30445":71157,"_21099":118853,"_5":14424,"_27663":118627,"_2970":118854},[],"Las acciones se dividen en dos grupos:",{"_3487":71231,"_30445":71157,"_21099":118856,"_5":14424,"_27663":118627,"_2970":118857},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3487":71232,"_30445":71157,"_21099":118859,"_5":14424,"_27663":118627,"_2970":118860},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3487":71233,"_30445":71157,"_21099":118862,"_5":14424,"_27663":118627,"_2970":118863},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3487":71234,"_30445":71157,"_21099":118865,"_5":14424,"_27663":118631,"_2970":118866},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3487":71235,"_30445":71157,"_21099":118868,"_5":14424,"_27663":118631,"_2970":118869},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3487":71236,"_30445":71157,"_21099":118871,"_5":14424,"_27663":118631,"_2970":118872},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3487":71237,"_30445":71157,"_21099":118874,"_5":14424,"_27663":118635,"_2970":118875},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3487":71238,"_30445":71157,"_21099":118877,"_5":14424,"_27663":118635,"_2970":118878},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3487":71239,"_30445":71157,"_21099":118880,"_5":14424,"_27663":118635,"_2970":118881},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3487":71240,"_30445":71157,"_21099":118883,"_5":14424,"_27663":118635,"_2970":118884},[],"Los operadores implementados son:",{"_3487":71241,"_30445":71157,"_21099":118886,"_5":14424,"_27663":118635,"_2970":118887},[],"`equals`, para igualdad exacta;",{"_3487":71242,"_30445":71157,"_21099":118889,"_5":14424,"_27663":118635,"_2970":118890},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3487":71243,"_30445":71157,"_21099":118892,"_5":14424,"_27663":118635,"_2970":118893},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3487":71244,"_30445":71157,"_21099":118895,"_5":14424,"_27663":118635,"_2970":118896},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3487":71245,"_30445":71157,"_21099":118898,"_5":14424,"_27663":118639,"_2970":118899},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3487":71246,"_30445":71157,"_21099":118901,"_5":14424,"_27663":118639,"_2970":118902},[],"Los modos disponibles son:",{"_3487":71247,"_30445":71157,"_21099":118904,"_5":14424,"_27663":118639,"_2970":118905},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3487":71248,"_30445":71157,"_21099":118907,"_5":14424,"_27663":118639,"_2970":118908},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3487":71249,"_30445":71157,"_21099":118910,"_5":14424,"_27663":118639,"_2970":118911},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3487":71250,"_30445":71157,"_21099":118913,"_5":14424,"_27663":118639,"_2970":118914},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3487":71251,"_30445":71157,"_21099":118916,"_5":14424,"_27663":118639,"_2970":118917},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3487":71252,"_30445":71157,"_21099":118919,"_5":14424,"_27663":118639,"_2970":118920},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3487":71253,"_30445":71157,"_21099":118922,"_5":14424,"_27663":118643,"_2970":118923},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3487":71254,"_30445":71157,"_21099":118925,"_5":14424,"_27663":118643,"_2970":118926},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3487":71255,"_30445":71157,"_21099":118928,"_5":14424,"_27663":118643,"_2970":118929},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3487":71256,"_30445":71157,"_21099":118931,"_5":14424,"_27663":118643,"_2970":118932},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3487":71257,"_30445":71157,"_21099":118934,"_5":14424,"_27663":118651,"_2970":118935},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3487":71258,"_30445":71157,"_21099":118937,"_5":14424,"_27663":118651,"_2970":118938},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3487":71259,"_30445":71157,"_21099":118940,"_5":14424,"_27663":118655,"_2970":118941},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3487":71260,"_30445":71157,"_21099":118943,"_5":14424,"_27663":118655,"_2970":118944},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3487":71261,"_30445":71157,"_21099":118946,"_5":14424,"_27663":118659,"_2970":118947},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3487":71262,"_30445":71157,"_21099":118949,"_5":14424,"_27663":118659,"_2970":118950},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3487":71263,"_30445":71157,"_21099":118952,"_5":14424,"_27663":118659,"_2970":118953},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3487":71264,"_30445":71157,"_21099":118955,"_5":14424,"_27663":118663,"_2970":118956},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3487":71265,"_30445":71157,"_21099":118958,"_5":14424,"_27663":118663,"_2970":118959},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3487":71266,"_30445":71157,"_21099":118961,"_5":14424,"_27663":118663,"_2970":118962},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3487":71267,"_30445":71157,"_21099":118964,"_5":14424,"_27663":118663,"_2970":118965},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3487":71268,"_30445":71157,"_21099":118967,"_5":14424,"_27663":118663,"_2970":118968},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3487":71269,"_30445":71157,"_21099":118970,"_5":14424,"_27663":118663,"_2970":118971},[],"Ten en cuenta que:",{"_3487":71270,"_30445":71157,"_21099":118973,"_5":14424,"_27663":118663,"_2970":118974},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3487":71271,"_30445":71157,"_21099":118976,"_5":14424,"_27663":118663,"_2970":118977},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3487":71272,"_30445":71157,"_21099":118979,"_5":14424,"_27663":118663,"_2970":118980},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3487":71273,"_30445":71157,"_21099":118982,"_5":14424,"_27663":118667,"_2970":118983},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3487":71274,"_30445":71157,"_21099":118985,"_5":14424,"_27663":118667,"_2970":118986},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3487":71275,"_30445":71157,"_21099":118988,"_5":14424,"_27663":118667,"_2970":118989},[],"acceso completo y de solo lectura a KMS;",{"_3487":71276,"_30445":71157,"_21099":118991,"_5":14424,"_27663":118667,"_2970":118992},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3487":71277,"_30445":71157,"_21099":118994,"_5":14424,"_27663":118667,"_2970":118995},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3487":71278,"_30445":71157,"_21099":118997,"_5":14424,"_27663":118667,"_2970":118998},[],"acceso a la interfaz;",{"_3487":71279,"_30445":71157,"_21099":119000,"_5":14424,"_27663":118667,"_2970":119001},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3487":71280,"_30445":71157,"_21099":119003,"_5":14424,"_27663":118667,"_2970":119004},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3487":71281,"_30445":71157,"_21099":119006,"_5":14424,"_27663":118667,"_2970":119007},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3487":71282,"_30445":71157,"_21099":119009,"_5":14424,"_27663":118671,"_2970":119010},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3487":71283,"_30445":71157,"_21099":119012,"_5":14424,"_27663":118671,"_2970":119013},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3487":71284,"_30445":71157,"_21099":119015,"_5":14424,"_27663":118671,"_2970":119016},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3487":71285,"_30445":71157,"_21099":119018,"_5":14424,"_27663":118674,"_2970":119019},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3487":71286,"_30445":71157,"_21099":119021,"_5":14424,"_27663":118678,"_2970":119022},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3487":71287,"_30445":71157,"_21099":119024,"_5":14424,"_27663":118678,"_2970":119025},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3487":71288,"_30445":71157,"_21099":119027,"_5":14424,"_27663":118682,"_2970":119028},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3487":71289,"_30445":71157,"_21099":119030,"_5":14424,"_27663":118686,"_2970":119031},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3487":71290,"_30445":71157,"_21099":119033,"_5":14424,"_27663":118690,"_2970":119034},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3487":71291,"_30445":71157,"_21099":119036,"_5":14424,"_27663":118694,"_2970":119037},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3487":71292,"_30445":71157,"_21099":119039,"_5":14424,"_27663":118694,"_2970":119040},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3487":71293,"_30445":71157,"_21099":119042,"_5":14424,"_27663":118698,"_2970":119043},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3487":71294,"_30445":71157,"_21099":119045,"_5":14424,"_27663":118698,"_2970":119046},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3487":71295,"_30445":71157,"_21099":119048,"_5":14424,"_27663":118698,"_2970":119049},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3487":71296,"_30445":71157,"_21099":119051,"_5":14424,"_27663":118698,"_2970":119052},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3487":71297,"_30445":71157,"_21099":119054,"_5":14424,"_27663":118698,"_2970":119055},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3487":71298,"_30445":71157,"_21099":119057,"_5":14424,"_27663":118698,"_2970":119058},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3487":71299,"_30445":71157,"_21099":119060,"_5":14424,"_27663":118698,"_2970":119061},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3487":71300,"_30445":71157,"_21099":119063,"_5":14424,"_27663":118698,"_2970":119064},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3487":71301,"_30445":71157,"_21099":119066,"_5":14424,"_27663":118702,"_2970":119067},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3487":71302,"_30445":71157,"_21099":119069,"_5":14424,"_27663":118702,"_2970":119070},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3487":71303,"_30445":71157,"_21099":119072,"_5":14424,"_27663":118702,"_2970":119073},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3487":71304,"_30445":71157,"_21099":119075,"_5":14424,"_27663":118706,"_2970":119076},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3487":71305,"_30445":71157,"_21099":119078,"_5":14424,"_27663":118706,"_2970":119079},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3487":71306,"_30445":71157,"_21099":119081,"_5":14424,"_27663":118706,"_2970":119082},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3487":71307,"_30445":71157,"_21099":119084,"_5":14424,"_27663":118706,"_2970":119085},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3487":71308,"_30445":71157,"_21099":119087,"_5":14424,"_27663":118706,"_2970":119088},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3487":71309,"_30445":71157,"_21099":119090,"_5":14424,"_27663":118706,"_2970":119091},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3487":71310,"_30445":71157,"_21099":119093,"_5":14424,"_27663":118706,"_2970":119094},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3487":71311,"_30445":71157,"_21099":119096,"_5":14424,"_27663":118706,"_2970":119097},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3487":71312,"_30445":71157,"_21099":119099,"_5":14424,"_27663":118714,"_2970":119100},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3487":71313,"_30445":71157,"_21099":119102,"_5":14424,"_27663":118718,"_2970":119103},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3487":71314,"_30445":71157,"_21099":119105,"_5":14424,"_27663":118718,"_2970":119106},[],"que exista un principal activo del tipo correcto;",{"_3487":71315,"_30445":71157,"_21099":119108,"_5":14424,"_27663":118718,"_2970":119109},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3487":71316,"_30445":71157,"_21099":119111,"_5":14424,"_27663":118718,"_2970":119112},[],"que todas las condiciones del principal se cumplan;",{"_3487":71317,"_30445":71157,"_21099":119114,"_5":14424,"_27663":118718,"_2970":119115},[],"que el principal tenga concedida la política esperada;",{"_3487":71318,"_30445":71157,"_21099":119117,"_5":14424,"_27663":118718,"_2970":119118},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3487":71319,"_30445":71157,"_21099":119120,"_5":14424,"_27663":118718,"_2970":119121},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3487":71320,"_30445":71157,"_21099":119123,"_5":14424,"_27663":118718,"_2970":119124},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3487":71321,"_30445":71157,"_21099":119126,"_5":14424,"_27663":118722,"_2970":119127},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3487":71322,"_30445":71157,"_21099":119129,"_5":14424,"_27663":118726,"_2970":119130},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3487":71323,"_30445":71157,"_21099":119132,"_5":14424,"_27663":118730,"_2970":119133},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3487":71324,"_30445":71157,"_21099":119135,"_5":14424,"_27663":118730,"_2970":119136},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3487":71325,"_30445":71325,"_5":14788,"_2970":119138,"_30797":119139,"_21099":119140,"_27663":71325},"Alertas y suscripciones",[49622,118603,118604],[],{"_3487":71326,"_30445":71325,"_21099":119142,"_5":14424,"_27663":71325,"_2970":119143},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3487":71327,"_30445":71325,"_5":30794,"_21099":119145,"_27663":119146,"_2970":119147},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3487":71328,"_30445":71325,"_5":30794,"_21099":119149,"_27663":119150,"_2970":119151},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3487":71329,"_30445":71325,"_5":30794,"_21099":119153,"_27663":119154,"_2970":119155},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3487":71330,"_30445":71325,"_5":30794,"_21099":119157,"_27663":119158,"_2970":119159},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3487":71331,"_30445":71325,"_5":30794,"_21099":119161,"_27663":119162,"_2970":119163},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3487":71332,"_30445":71325,"_5":30794,"_21099":119165,"_27663":119166,"_2970":119167},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3487":71333,"_30445":71325,"_5":30794,"_21099":119169,"_27663":119170,"_2970":119171},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3487":71334,"_30445":71325,"_5":30794,"_21099":119173,"_27663":119174,"_2970":119175},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3487":71335,"_30445":71325,"_5":30794,"_21099":119177,"_27663":119178,"_2970":119179},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3487":71336,"_30445":71325,"_5":30794,"_21099":119181,"_27663":119182,"_2970":119183},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3487":71337,"_30445":71325,"_5":30794,"_21099":119185,"_27663":119186,"_2970":119187},[],"/docs/pr-preview/pr-68/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3487":71338,"_30445":71325,"_21099":119189,"_5":14424,"_27663":71325,"_2970":119190},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3487":71339,"_30445":71325,"_21099":119192,"_5":14424,"_27663":119146,"_2970":119193},[],"Un servicio publica un evento de dominio.",{"_3487":71340,"_30445":71325,"_21099":119195,"_5":14424,"_27663":119146,"_2970":119196},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3487":71341,"_30445":71325,"_21099":119198,"_5":14424,"_27663":119146,"_2970":119199},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3487":71342,"_30445":71325,"_21099":119201,"_5":14424,"_27663":119146,"_2970":119202},[],"Lamassu entrega el evento al canal configurado.",{"_3487":71343,"_30445":71325,"_21099":119204,"_5":14424,"_27663":119146,"_2970":119205},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3487":71344,"_30445":71325,"_21099":119207,"_5":14424,"_27663":119150,"_2970":119208},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3487":71345,"_30445":71325,"_21099":119210,"_5":14424,"_27663":119150,"_2970":119211},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3487":71346,"_30445":71325,"_21099":119213,"_5":14424,"_27663":119150,"_2970":119214},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3487":71347,"_30445":71325,"_21099":119216,"_5":14424,"_27663":119150,"_2970":119217},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3487":71348,"_30445":71325,"_21099":119219,"_5":14424,"_27663":119150,"_2970":119220},[],"`apikey_options` necesita `header` y `key`.",{"_3487":71349,"_30445":71325,"_21099":119222,"_5":14424,"_27663":119150,"_2970":119223},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3487":71350,"_30445":71325,"_21099":119225,"_5":14424,"_27663":119150,"_2970":119226},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3487":71351,"_30445":71325,"_21099":119228,"_5":14424,"_27663":119150,"_2970":119229},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3487":71352,"_30445":71325,"_21099":119231,"_5":14424,"_27663":119158,"_2970":119232},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3487":71353,"_30445":71325,"_21099":119234,"_5":14424,"_27663":119162,"_2970":119235},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3487":71354,"_30445":71325,"_21099":119237,"_5":14424,"_27663":119166,"_2970":119238},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3487":71355,"_30445":71325,"_21099":119240,"_5":14424,"_27663":119166,"_2970":119241},[],"**None** notifica todas las instancias del evento.",{"_3487":71356,"_30445":71325,"_21099":119243,"_5":14424,"_27663":119166,"_2970":119244},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3487":71357,"_30445":71325,"_21099":119246,"_5":14424,"_27663":119166,"_2970":119247},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3487":71358,"_30445":71325,"_21099":119249,"_5":14424,"_27663":119166,"_2970":119250},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3487":71359,"_30445":71325,"_21099":119252,"_5":14424,"_27663":119166,"_2970":119253},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3487":71360,"_30445":71325,"_21099":119255,"_5":14424,"_27663":119166,"_2970":119256},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3487":71361,"_30445":71325,"_21099":119258,"_5":14424,"_27663":119170,"_2970":119259},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3487":71362,"_30445":71325,"_21099":119261,"_5":14424,"_27663":119174,"_2970":119262},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3487":71363,"_30445":71325,"_21099":119264,"_5":14424,"_27663":119174,"_2970":119265},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3487":71364,"_30445":71325,"_21099":119267,"_5":14424,"_27663":119174,"_2970":119268},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3487":71365,"_30445":71325,"_21099":119270,"_5":14424,"_27663":119174,"_2970":119271},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3487":71366,"_30445":71325,"_21099":119273,"_5":14424,"_27663":119174,"_2970":119274},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3487":71367,"_30445":71325,"_21099":119276,"_5":14424,"_27663":119174,"_2970":119277},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3487":71368,"_30445":71325,"_21099":119279,"_5":14424,"_27663":119174,"_2970":119280},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3487":71369,"_30445":71325,"_21099":119282,"_5":14424,"_27663":119174,"_2970":119283},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3487":71370,"_30445":71325,"_21099":119285,"_5":14424,"_27663":119178,"_2970":119286},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3487":71371,"_30445":71325,"_21099":119288,"_5":14424,"_27663":119178,"_2970":119289},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3487":71372,"_30445":71325,"_21099":119291,"_5":14424,"_27663":119178,"_2970":119292},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3487":71373,"_30445":71325,"_21099":119294,"_5":14424,"_27663":119178,"_2970":119295},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3487":71374,"_30445":71325,"_21099":119297,"_5":14424,"_27663":119178,"_2970":119298},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3487":71375,"_30445":71325,"_21099":119300,"_5":14424,"_27663":119178,"_2970":119301},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3487":71376,"_30445":71325,"_21099":119303,"_5":14424,"_27663":119178,"_2970":119304},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3487":71377,"_30445":71325,"_21099":119306,"_5":14424,"_27663":119178,"_2970":119307},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3487":71378,"_30445":71325,"_21099":119309,"_5":14424,"_27663":119182,"_2970":119310},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3487":71379,"_30445":71325,"_21099":119312,"_5":14424,"_27663":119182,"_2970":119313},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3487":71380,"_30445":71325,"_21099":119315,"_5":14424,"_27663":119186,"_2970":119316},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3487":71381,"_30445":71325,"_21099":119318,"_5":14424,"_27663":119186,"_2970":119319},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3487":71382,"_30445":71325,"_21099":119321,"_5":14424,"_27663":119186,"_2970":119322},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3487":71383,"_30445":71325,"_21099":119324,"_5":14424,"_27663":119186,"_2970":119325},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3487":71384,"_30445":71325,"_21099":119327,"_5":14424,"_27663":119186,"_2970":119328},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3487":71385,"_30445":71325,"_21099":119330,"_5":14424,"_27663":119186,"_2970":119331},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3487":71386,"_30445":71325,"_21099":119333,"_5":14424,"_27663":119186,"_2970":119334},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3487":71387,"_30445":71325,"_21099":119336,"_5":14424,"_27663":119186,"_2970":119337},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3487":71388,"_30445":71325,"_21099":119339,"_5":14424,"_27663":119186,"_2970":119340},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3487":71389,"_30445":71389,"_5":14788,"_2970":119342,"_30797":119343,"_21099":119344,"_27663":71389},"Registros de auditoría",[49622,118603,118604],[],{"_3487":71390,"_30445":71389,"_21099":119346,"_5":14424,"_27663":71389,"_2970":119347},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3487":71391,"_30445":71389,"_5":30794,"_21099":119349,"_27663":119350,"_2970":119351},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3487":71392,"_30445":71389,"_5":30794,"_21099":119353,"_27663":119354,"_2970":119355},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3487":71393,"_30445":71389,"_5":30794,"_21099":119357,"_27663":119358,"_2970":119359},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3487":71394,"_30445":71389,"_5":30794,"_21099":119361,"_27663":119362,"_2970":119363},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3487":71395,"_30445":71389,"_5":30794,"_21099":119365,"_27663":119366,"_2970":119367},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3487":71396,"_30445":71389,"_5":30794,"_21099":119369,"_27663":119370,"_2970":119371},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3487":71397,"_30445":71389,"_5":30794,"_21099":119373,"_27663":119374,"_2970":119375},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3487":71398,"_30445":71389,"_5":30794,"_21099":119377,"_27663":119378,"_2970":119379},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3487":71399,"_30445":71389,"_5":30794,"_21099":119381,"_27663":119382,"_2970":119383},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3487":71400,"_30445":71389,"_5":30794,"_21099":119385,"_27663":119386,"_2970":119387},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3487":71401,"_30445":71389,"_5":30794,"_21099":119389,"_27663":119390,"_2970":119391},[],"/docs/pr-preview/pr-68/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3487":71402,"_30445":71389,"_21099":119393,"_5":14424,"_27663":71389,"_2970":119394},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3487":71403,"_30445":71389,"_21099":119396,"_5":14424,"_27663":119350,"_2970":119397},[],"El cuerpo de auditoría incluye:",{"_3487":71404,"_30445":71389,"_21099":119399,"_5":14424,"_27663":119350,"_2970":119400},[],"input: datos recibidos por la operación;",{"_3487":71405,"_30445":71389,"_21099":119402,"_5":14424,"_27663":119350,"_2970":119403},[],"has\\_error: indica si el servicio devolvió un error;",{"_3487":71406,"_30445":71389,"_21099":119405,"_5":14424,"_27663":119350,"_2970":119406},[],"output: resultado producido o mensaje de error;",{"_3487":71407,"_30445":71389,"_21099":119408,"_5":14424,"_27663":119350,"_2970":119409},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3487":71408,"_30445":71389,"_21099":119411,"_5":14424,"_27663":119350,"_2970":119412},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3487":71409,"_30445":71389,"_21099":119414,"_5":14424,"_27663":119350,"_2970":119415},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3487":71410,"_30445":71389,"_21099":119417,"_5":14424,"_27663":119354,"_2970":119418},[],"El backend aplica auditoría a mutaciones de:",{"_3487":71411,"_30445":71389,"_21099":119420,"_5":14424,"_27663":119354,"_2970":119421},[],"autoridades, certificados y perfiles de emisión;",{"_3487":71412,"_30445":71389,"_21099":119423,"_5":14424,"_27663":119354,"_2970":119424},[],"claves y motores KMS;",{"_3487":71413,"_30445":71389,"_21099":119426,"_5":14424,"_27663":119354,"_2970":119427},[],"dispositivos e identidades;",{"_3487":71414,"_30445":71389,"_21099":119429,"_5":14424,"_27663":119354,"_2970":119430},[],"DMS y operaciones de enrolamiento;",{"_3487":71415,"_30445":71389,"_21099":119432,"_5":14424,"_27663":119354,"_2970":119433},[],"funciones de validación y CRL;",{"_3487":71416,"_30445":71389,"_21099":119435,"_5":14424,"_27663":119354,"_2970":119436},[],"principales, políticas y concesiones de autorización.",{"_3487":71417,"_30445":71389,"_21099":119438,"_5":14424,"_27663":119354,"_2970":119439},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3487":71418,"_30445":71389,"_21099":119441,"_5":14424,"_27663":119358,"_2970":119442},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3487":71419,"_30445":71389,"_21099":119444,"_5":14424,"_27663":119358,"_2970":119445},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3487":71420,"_30445":71389,"_21099":119447,"_5":14424,"_27663":119358,"_2970":119448},[],"Diseña el consumidor para:",{"_3487":71421,"_30445":71389,"_21099":119450,"_5":14424,"_27663":119358,"_2970":119451},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3487":71422,"_30445":71389,"_21099":119453,"_5":14424,"_27663":119358,"_2970":119454},[],"conservar el CloudEvent completo sin modificar;",{"_3487":71423,"_30445":71389,"_21099":119456,"_5":14424,"_27663":119358,"_2970":119457},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3487":71424,"_30445":71389,"_21099":119459,"_5":14424,"_27663":119358,"_2970":119460},[],"cifrar en tránsito y en reposo;",{"_3487":71425,"_30445":71389,"_21099":119462,"_5":14424,"_27663":119358,"_2970":119463},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3487":71426,"_30445":71389,"_21099":119465,"_5":14424,"_27663":119358,"_2970":119466},[],"aplicar una política explícita de retención y legal hold;",{"_3487":71427,"_30445":71389,"_21099":119468,"_5":14424,"_27663":119358,"_2970":119469},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3487":71428,"_30445":71389,"_21099":119471,"_5":14424,"_27663":119362,"_2970":119472},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3487":71429,"_30445":71389,"_21099":119474,"_5":14424,"_27663":119362,"_2970":119475},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3487":71430,"_30445":71389,"_21099":119477,"_5":14424,"_27663":119370,"_2970":119478},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3487":71431,"_30445":71389,"_21099":119480,"_5":14424,"_27663":119374,"_2970":119481},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3487":71432,"_30445":71389,"_21099":119483,"_5":14424,"_27663":119378,"_2970":119484},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3487":71433,"_30445":71389,"_21099":119486,"_5":14424,"_27663":119382,"_2970":119487},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3487":71434,"_30445":71389,"_21099":119489,"_5":14424,"_27663":119386,"_2970":119490},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3487":71435,"_30445":71389,"_21099":119492,"_5":14424,"_27663":119390,"_2970":119493},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3487":71436,"_30445":71389,"_21099":119495,"_5":14424,"_27663":119390,"_2970":119496},[],"aparece un evento de auditoría correcto;",{"_3487":71437,"_30445":71389,"_21099":119498,"_5":14424,"_27663":119390,"_2970":119499},[],"el principal coincide con la identidad utilizada;",{"_3487":71438,"_30445":71389,"_21099":119501,"_5":14424,"_27663":119390,"_2970":119502},[],"el consumidor lo persiste una sola vez;",{"_3487":71439,"_30445":71389,"_21099":119504,"_5":14424,"_27663":119390,"_2970":119505},[],"puede recuperarse por recurso, actor y periodo;",{"_3487":71440,"_30445":71389,"_21099":119507,"_5":14424,"_27663":119390,"_2970":119508},[],"una interrupción del consumidor produce una alerta.",{"_3487":71441,"_30445":71389,"_21099":119510,"_5":14424,"_27663":119390,"_2970":119511},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3487":71442,"_30445":71442,"_5":14788,"_2970":119513,"_30797":119514,"_21099":119515,"_27663":71442},"Arquitectura de la plataforma",[49622,118603],[],{"_3487":71443,"_30445":71442,"_21099":119517,"_5":14424,"_27663":71442,"_2970":119518},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3487":71444,"_30445":71442,"_5":30794,"_21099":119520,"_27663":119521,"_2970":119522},[],"/docs/pr-preview/pr-68/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3487":71445,"_30445":71442,"_5":30794,"_21099":119524,"_27663":119525,"_2970":119526},[],"/docs/pr-preview/pr-68/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3487":71446,"_30445":71442,"_5":30794,"_21099":119528,"_27663":119529,"_2970":119530},[],"/docs/pr-preview/pr-68/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3487":71447,"_30445":71442,"_5":30794,"_21099":119532,"_27663":119533,"_2970":119534},[],"/docs/pr-preview/pr-68/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3487":71448,"_30445":71442,"_5":30794,"_21099":119536,"_27663":119537,"_2970":119538},[],"/docs/pr-preview/pr-68/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3487":71449,"_30445":71442,"_21099":119540,"_5":14424,"_27663":71442,"_2970":119541},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3487":71450,"_30445":71442,"_21099":119543,"_5":14424,"_27663":71442,"_2970":119544},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3487":71451,"_30445":71442,"_21099":119546,"_5":14424,"_27663":119521,"_2970":119547},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3487":71452,"_30445":71442,"_21099":119549,"_5":14424,"_27663":119525,"_2970":119550},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3487":71453,"_30445":71442,"_21099":119552,"_5":14424,"_27663":119529,"_2970":119553},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3487":71454,"_30445":71442,"_21099":119555,"_5":14424,"_27663":119533,"_2970":119556},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3487":71455,"_30445":71442,"_21099":119558,"_5":14424,"_27663":119537,"_2970":119559},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3487":71456,"_30445":71456,"_5":14788,"_2970":119561,"_30797":119562,"_21099":119563,"_27663":71456},"Cómo funciona Lamassu",[49622,118603],[],{"_3487":71457,"_30445":71456,"_21099":119565,"_5":14424,"_27663":71456,"_2970":119566},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3487":71458,"_30445":71456,"_5":30794,"_21099":119568,"_27663":119569,"_2970":119570},[],"/docs/pr-preview/pr-68/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3487":71459,"_30445":71456,"_5":30794,"_21099":119572,"_27663":119573,"_2970":119574},[],"/docs/pr-preview/pr-68/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3487":71460,"_30445":71456,"_21099":119576,"_5":14424,"_27663":71456,"_2970":119577},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3487":71461,"_30445":71456,"_21099":119579,"_5":14424,"_27663":119569,"_2970":119580},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3487":71462,"_30445":71456,"_21099":119582,"_5":14424,"_27663":119569,"_2970":119583},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3487":71463,"_30445":71456,"_21099":119585,"_5":14424,"_27663":119569,"_2970":119586},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3487":71464,"_30445":71456,"_21099":119588,"_5":14424,"_27663":119569,"_2970":119589},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3487":71465,"_30445":71456,"_21099":119591,"_5":14424,"_27663":119569,"_2970":119592},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3487":71466,"_30445":71456,"_21099":119594,"_5":14424,"_27663":119573,"_2970":119595},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3487":71467,"_30445":71456,"_21099":119597,"_5":14424,"_27663":119573,"_2970":119598},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3487":71468,"_30445":71456,"_21099":119600,"_5":14424,"_27663":119573,"_2970":119601},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3487":71469,"_30445":71456,"_21099":119603,"_5":14424,"_27663":119573,"_2970":119604},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3487":71470,"_30445":71456,"_21099":119606,"_5":14424,"_27663":119573,"_2970":119607},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3487":71471,"_30445":71456,"_21099":119609,"_5":14424,"_27663":119573,"_2970":119610},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3487":71472,"_30445":71456,"_21099":119612,"_5":14424,"_27663":119573,"_2970":119613},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3487":71473,"_30445":71473,"_5":14788,"_2970":119615,"_30797":119616,"_21099":119617,"_27663":71473},"Dispositivos e identidades",[49622,118603,52175,119615],[],{"_3487":71474,"_30445":71473,"_21099":119619,"_5":14424,"_27663":71473,"_2970":119620},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3487":71475,"_30445":71473,"_5":30794,"_21099":119622,"_27663":119623,"_2970":119624},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3487":71476,"_30445":71473,"_5":30794,"_21099":119626,"_27663":119627,"_2970":119628},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3487":71477,"_30445":71473,"_5":30794,"_21099":119630,"_27663":119631,"_2970":119632},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3487":71478,"_30445":71473,"_5":30794,"_21099":119634,"_27663":119635,"_2970":119636},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3487":71479,"_30445":71473,"_5":30794,"_21099":119638,"_27663":119639,"_2970":119640},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3487":71480,"_30445":71473,"_5":30794,"_21099":119642,"_27663":119643,"_2970":119644},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3487":71481,"_30445":71473,"_5":30794,"_21099":119646,"_27663":119647,"_2970":119648},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3487":71482,"_30445":71473,"_5":30794,"_21099":119650,"_27663":119651,"_2970":119652},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3487":71483,"_30445":71473,"_5":30794,"_21099":119654,"_27663":119655,"_2970":119656},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3487":71484,"_30445":71473,"_5":30794,"_21099":119658,"_27663":119659,"_2970":119660},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3487":71485,"_30445":71473,"_5":30794,"_21099":119662,"_27663":119663,"_2970":119664},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3487":71486,"_30445":71473,"_21099":119666,"_5":14424,"_27663":71473,"_2970":119667},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3487":71487,"_30445":71473,"_21099":119669,"_5":14424,"_27663":71473,"_2970":119670},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3487":71488,"_30445":71473,"_21099":119672,"_5":14424,"_27663":119623,"_2970":119673},[],"Vista operativa",{"_3487":71489,"_30445":71473,"_21099":119675,"_5":14424,"_27663":119623,"_2970":119676},[],"Interpretación",{"_3487":71490,"_30445":71473,"_21099":119678,"_5":14424,"_27663":119623,"_2970":52238},[],{"_3487":71491,"_30445":71473,"_21099":119680,"_5":14424,"_27663":119623,"_2970":119681},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3487":71492,"_30445":71473,"_21099":119683,"_5":14424,"_27663":119623,"_2970":52244},[],{"_3487":71493,"_30445":71473,"_21099":119685,"_5":14424,"_27663":119623,"_2970":119686},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3487":71494,"_30445":71473,"_21099":119688,"_5":14424,"_27663":119623,"_2970":52250},[],{"_3487":71495,"_30445":71473,"_21099":119690,"_5":14424,"_27663":119623,"_2970":119691},[],"La identidad está en la ventana operativa de renovación.",{"_3487":71496,"_30445":71473,"_21099":119693,"_5":14424,"_27663":119623,"_2970":52256},[],{"_3487":71497,"_30445":71473,"_21099":119695,"_5":14424,"_27663":119623,"_2970":119696},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3487":71498,"_30445":71473,"_21099":119698,"_5":14424,"_27663":119623,"_2970":52262},[],{"_3487":71499,"_30445":71473,"_21099":119700,"_5":14424,"_27663":119623,"_2970":119701},[],"La identidad ha vencido.",{"_3487":71500,"_30445":71473,"_21099":119703,"_5":14424,"_27663":119623,"_2970":52268},[],{"_3487":71501,"_30445":71473,"_21099":119705,"_5":14424,"_27663":119623,"_2970":119706},[],"La identidad está marcada como revocada.",{"_3487":71502,"_30445":71473,"_21099":119708,"_5":14424,"_27663":119623,"_2970":52274},[],{"_3487":71503,"_30445":71473,"_21099":119710,"_5":14424,"_27663":119623,"_2970":119711},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3487":71504,"_30445":71473,"_21099":119713,"_5":14424,"_27663":119623,"_2970":119714},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3487":71505,"_30445":71473,"_21099":119716,"_5":14424,"_27663":119627,"_2970":119717},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3487":71506,"_30445":71473,"_21099":119719,"_5":14424,"_27663":119627,"_2970":119720},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3487":71507,"_30445":71473,"_21099":119722,"_5":14424,"_27663":119627,"_2970":119723},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3487":71508,"_30445":71473,"_21099":119725,"_5":14424,"_27663":119627,"_2970":119726},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3487":71509,"_30445":71473,"_21099":119728,"_5":14424,"_27663":119631,"_2970":119729},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3487":71510,"_30445":71473,"_21099":119731,"_5":14424,"_27663":119635,"_2970":119732},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3487":71511,"_30445":71473,"_21099":119734,"_5":14424,"_27663":119639,"_2970":119735},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3487":71512,"_30445":71473,"_21099":119737,"_5":14424,"_27663":119643,"_2970":119738},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3487":71513,"_30445":71473,"_21099":119740,"_5":14424,"_27663":119647,"_2970":119741},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3487":71514,"_30445":71473,"_21099":119743,"_5":14424,"_27663":119647,"_2970":119744},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3487":71515,"_30445":71473,"_21099":119746,"_5":14424,"_27663":119651,"_2970":119747},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3487":71516,"_30445":71473,"_21099":119749,"_5":14424,"_27663":119651,"_2970":119750},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3487":71517,"_30445":71473,"_21099":119752,"_5":14424,"_27663":119651,"_2970":119753},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3487":71518,"_30445":71473,"_21099":119755,"_5":14424,"_27663":119651,"_2970":119756},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3487":71519,"_30445":71473,"_21099":119758,"_5":14424,"_27663":119651,"_2970":119759},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3487":71520,"_30445":71473,"_21099":119761,"_5":14424,"_27663":119651,"_2970":119762},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3487":71521,"_30445":71473,"_21099":119764,"_5":14424,"_27663":119655,"_2970":119765},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3487":71522,"_30445":71473,"_21099":119767,"_5":14424,"_27663":119655,"_2970":119768},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3487":71523,"_30445":71473,"_21099":119770,"_5":14424,"_27663":119659,"_2970":119771},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3487":71524,"_30445":71473,"_21099":119773,"_5":14424,"_27663":119659,"_2970":119774},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3487":71525,"_30445":71473,"_21099":119776,"_5":14424,"_27663":119659,"_2970":119777},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3487":71526,"_30445":71473,"_21099":119779,"_5":14424,"_27663":119659,"_2970":119780},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3487":71527,"_30445":71473,"_21099":119782,"_5":14424,"_27663":119663,"_2970":119783},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3487":71528,"_30445":71473,"_21099":119785,"_5":14424,"_27663":119663,"_2970":119786},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3487":71529,"_30445":71529,"_5":14788,"_2970":119788,"_30797":119789,"_21099":119791,"_27663":71529},"Identidad inicial y autenticación",[49622,118603,52175,119615,119790],"Enrolamiento con PKI",[],{"_3487":71530,"_30445":71529,"_21099":119793,"_5":14424,"_27663":71529,"_2970":119794},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3487":71531,"_30445":71529,"_5":30794,"_21099":119796,"_27663":119797,"_2970":119798},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3487":71532,"_30445":71529,"_5":30794,"_21099":119800,"_27663":119801,"_2970":119802},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3487":71533,"_30445":71529,"_5":30794,"_21099":119804,"_27663":119805,"_2970":119806},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3487":71534,"_30445":71529,"_5":30794,"_21099":119808,"_27663":119809,"_2970":119810},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3487":71535,"_30445":71529,"_5":30794,"_21099":119812,"_27663":119813,"_2970":119814},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3487":71536,"_30445":71529,"_21099":119816,"_5":14424,"_27663":71529,"_2970":119817},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3487":71537,"_30445":71529,"_21099":119819,"_5":14424,"_27663":119797,"_2970":119820},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3487":71538,"_30445":71529,"_21099":119822,"_5":14424,"_27663":119797,"_2970":119823},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3487":71539,"_30445":71529,"_21099":119825,"_5":14424,"_27663":119801,"_2970":119826},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3487":71540,"_30445":71529,"_21099":119828,"_5":14424,"_27663":119801,"_2970":119829},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3487":71541,"_30445":71529,"_21099":119831,"_5":14424,"_27663":119801,"_2970":119832},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3487":71542,"_30445":71529,"_21099":119834,"_5":14424,"_27663":119805,"_2970":119835},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3487":71543,"_30445":71529,"_21099":119837,"_5":14424,"_27663":119805,"_2970":119838},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3487":71544,"_30445":71529,"_21099":119840,"_5":14424,"_27663":119809,"_2970":119841},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3487":71545,"_30445":71529,"_21099":119843,"_5":14424,"_27663":119809,"_2970":119844},[],"Ejemplo de cuerpo:",{"_3487":71546,"_30445":71529,"_21099":119846,"_5":14424,"_27663":119809,"_2970":119847},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3487":71547,"_30445":71529,"_21099":119849,"_5":14424,"_27663":119809,"_2970":119850},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3487":71548,"_30445":71529,"_21099":119852,"_5":14424,"_27663":119809,"_2970":119853},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3487":71549,"_30445":71529,"_21099":119855,"_5":14424,"_27663":119809,"_2970":119856},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3487":71550,"_30445":71529,"_21099":119858,"_5":14424,"_27663":119813,"_2970":119859},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3487":71551,"_30445":71529,"_21099":119861,"_5":14424,"_27663":119813,"_2970":119862},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3487":71552,"_30445":71552,"_5":14788,"_2970":119864,"_30797":119865,"_21099":119866,"_27663":71552},"Configura y opera el DMS",[49622,118603,52175,119615,119790],[],{"_3487":71553,"_30445":71552,"_21099":119868,"_5":14424,"_27663":71552,"_2970":119869},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3487":71554,"_30445":71552,"_5":30794,"_21099":119871,"_27663":119872,"_2970":117116},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3487":71555,"_30445":71552,"_5":30794,"_21099":119874,"_27663":119875,"_2970":119876},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3487":71556,"_30445":71552,"_5":30794,"_21099":119878,"_27663":119879,"_2970":119880},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3487":71557,"_30445":71552,"_5":30794,"_21099":119882,"_27663":119883,"_2970":119884},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3487":71558,"_30445":71552,"_5":30794,"_21099":119886,"_27663":119887,"_2970":119888},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3487":71559,"_30445":71552,"_5":30794,"_21099":119890,"_27663":119891,"_2970":119892},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3487":71560,"_30445":71552,"_5":30794,"_21099":119894,"_27663":119895,"_2970":119896},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3487":71561,"_30445":71552,"_5":30794,"_21099":119898,"_27663":119899,"_2970":119900},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3487":71562,"_30445":71552,"_5":30794,"_21099":119902,"_27663":119903,"_2970":52470},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3487":71563,"_30445":71552,"_5":30794,"_21099":119905,"_27663":119906,"_2970":52474},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3487":71564,"_30445":71552,"_5":30794,"_21099":119908,"_27663":119909,"_2970":119910},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3487":71565,"_30445":71552,"_5":30794,"_21099":119912,"_27663":119913,"_2970":119914},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3487":71566,"_30445":71552,"_5":30794,"_21099":119916,"_27663":119917,"_2970":119918},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3487":71567,"_30445":71552,"_5":30794,"_21099":119920,"_27663":119921,"_2970":119922},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3487":71568,"_30445":71552,"_5":30794,"_21099":119924,"_27663":119925,"_2970":52494},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3487":71569,"_30445":71552,"_5":30794,"_21099":119927,"_27663":119928,"_2970":119929},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3487":71570,"_30445":71552,"_5":30794,"_21099":119931,"_27663":119932,"_2970":119933},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3487":71571,"_30445":71552,"_5":30794,"_21099":119935,"_27663":119936,"_2970":119937},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3487":71572,"_30445":71552,"_21099":119939,"_5":14424,"_27663":71552,"_2970":119940},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3487":71573,"_30445":71552,"_21099":119942,"_5":14424,"_27663":119872,"_2970":119943},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3487":71574,"_30445":71552,"_21099":119945,"_5":14424,"_27663":119872,"_2970":119946},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3487":71575,"_30445":71552,"_21099":119948,"_5":14424,"_27663":119879,"_2970":119949},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3487":71576,"_30445":71552,"_21099":119951,"_5":14424,"_27663":119883,"_2970":119952},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3487":71577,"_30445":71552,"_21099":119954,"_5":14424,"_27663":119887,"_2970":119955},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3487":71578,"_30445":71552,"_21099":119957,"_5":14424,"_27663":119891,"_2970":119958},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3487":71579,"_30445":71552,"_21099":119960,"_5":14424,"_27663":119895,"_2970":119961},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3487":71580,"_30445":71552,"_21099":119963,"_5":14424,"_27663":119903,"_2970":119964},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3487":71581,"_30445":71552,"_21099":119966,"_5":14424,"_27663":119903,"_2970":119967},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3487":71582,"_30445":71552,"_21099":119969,"_5":14424,"_27663":119906,"_2970":119970},[],"Campo de `settings.enrollment_settings`",{"_3487":71583,"_30445":71552,"_21099":119972,"_5":14424,"_27663":119906,"_2970":119973},[],"Decisión",{"_3487":71584,"_30445":71552,"_21099":119975,"_5":14424,"_27663":119906,"_2970":52545},[],{"_3487":71585,"_30445":71552,"_21099":119977,"_5":14424,"_27663":119906,"_2970":119978},[],"`EST_RFC7030` para estas operaciones.",{"_3487":71586,"_30445":71552,"_21099":119980,"_5":14424,"_27663":119906,"_2970":52551},[],{"_3487":71587,"_30445":71552,"_21099":119982,"_5":14424,"_27663":119906,"_2970":119983},[],"ID de la CA que firmará.",{"_3487":71588,"_30445":71552,"_21099":119985,"_5":14424,"_27663":119906,"_2970":52557},[],{"_3487":71589,"_30445":71552,"_21099":119987,"_5":14424,"_27663":119906,"_2970":119988},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3487":71590,"_30445":71552,"_21099":119990,"_5":14424,"_27663":119906,"_2970":52563},[],{"_3487":71591,"_30445":71552,"_21099":119992,"_5":14424,"_27663":119906,"_2970":119993},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3487":71592,"_30445":71552,"_21099":119995,"_5":14424,"_27663":119906,"_2970":52569},[],{"_3487":71593,"_30445":71552,"_21099":119997,"_5":14424,"_27663":119906,"_2970":119998},[],"Uno de los cuatro modos de autenticación.",{"_3487":71594,"_30445":71552,"_21099":120000,"_5":14424,"_27663":119906,"_2970":120001},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3487":71595,"_30445":71552,"_21099":120003,"_5":14424,"_27663":119909,"_2970":120004},[],"Los bloques son independientes:",{"_3487":71596,"_30445":71552,"_21099":120006,"_5":14424,"_27663":119909,"_2970":120007},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3487":71597,"_30445":71552,"_21099":120009,"_5":14424,"_27663":119909,"_2970":120010},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3487":71598,"_30445":71552,"_21099":120012,"_5":14424,"_27663":119909,"_2970":52587},[],{"_3487":71599,"_30445":71552,"_21099":120014,"_5":14424,"_27663":119909,"_2970":120015},[],"Control aplicado en la operación configurada",{"_3487":71600,"_30445":71552,"_21099":120017,"_5":14424,"_27663":119909,"_2970":52593},[],{"_3487":71601,"_30445":71552,"_21099":120019,"_5":14424,"_27663":119909,"_2970":120020},[],"Validación del certificado presentado.",{"_3487":71602,"_30445":71552,"_21099":120022,"_5":14424,"_27663":119909,"_2970":52599},[],{"_3487":71603,"_30445":71552,"_21099":120024,"_5":14424,"_27663":119909,"_2970":120025},[],"Autorización del webhook configurado.",{"_3487":71604,"_30445":71552,"_21099":120027,"_5":14424,"_27663":119909,"_2970":52605},[],{"_3487":71605,"_30445":71552,"_21099":120029,"_5":14424,"_27663":119909,"_2970":120030},[],"Validación del certificado y, después, aprobación del webhook.",{"_3487":71606,"_30445":71552,"_21099":120032,"_5":14424,"_27663":119909,"_2970":52611},[],{"_3487":71607,"_30445":71552,"_21099":120034,"_5":14424,"_27663":119909,"_2970":120035},[],"Sin autenticación del solicitante por el DMS.",{"_3487":71608,"_30445":71552,"_21099":120037,"_5":14424,"_27663":119909,"_2970":120038},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3487":71609,"_30445":71552,"_21099":120040,"_5":14424,"_27663":119909,"_2970":120041},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3487":71610,"_30445":71552,"_21099":120043,"_5":14424,"_27663":119909,"_2970":120044},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3487":71611,"_30445":71552,"_21099":120046,"_5":14424,"_27663":119909,"_2970":120047},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3487":71612,"_30445":71552,"_21099":120049,"_5":14424,"_27663":119913,"_2970":120050},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3487":71613,"_30445":71552,"_21099":120052,"_5":14424,"_27663":119913,"_2970":120053},[],"Campo de `external_webhook_settings`",{"_3487":71614,"_30445":71552,"_21099":120055,"_5":14424,"_27663":119913,"_2970":119973},[],{"_3487":71615,"_30445":71552,"_21099":120057,"_5":14424,"_27663":119913,"_2970":52637},[],{"_3487":71616,"_30445":71552,"_21099":120059,"_5":14424,"_27663":119913,"_2970":120060},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3487":71617,"_30445":71552,"_21099":120062,"_5":14424,"_27663":119913,"_2970":52643},[],{"_3487":71618,"_30445":71552,"_21099":120064,"_5":14424,"_27663":119913,"_2970":120065},[],"`POST` o `PUT`; `POST` por defecto.",{"_3487":71619,"_30445":71552,"_21099":120067,"_5":14424,"_27663":119913,"_2970":52649},[],{"_3487":71620,"_30445":71552,"_21099":120069,"_5":14424,"_27663":119913,"_2970":120070},[],"Etiqueta usada en los logs del servicio.",{"_3487":71621,"_30445":71552,"_21099":120072,"_5":14424,"_27663":119913,"_2970":52655},[],{"_3487":71622,"_30445":71552,"_21099":120074,"_5":14424,"_27663":119913,"_2970":120075},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3487":71623,"_30445":71552,"_21099":120077,"_5":14424,"_27663":119913,"_2970":52661},[],{"_3487":71624,"_30445":71552,"_21099":120079,"_5":14424,"_27663":119913,"_2970":120080},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3487":71625,"_30445":71552,"_21099":120082,"_5":14424,"_27663":119913,"_2970":52667},[],{"_3487":71626,"_30445":71552,"_21099":120084,"_5":14424,"_27663":119913,"_2970":120085},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3487":71627,"_30445":71552,"_21099":120087,"_5":14424,"_27663":119913,"_2970":52673},[],{"_3487":71628,"_30445":71552,"_21099":120089,"_5":14424,"_27663":119913,"_2970":120090},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3487":71629,"_30445":71552,"_21099":120092,"_5":14424,"_27663":119913,"_2970":52679},[],{"_3487":71630,"_30445":71552,"_21099":120094,"_5":14424,"_27663":119913,"_2970":120095},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3487":71631,"_30445":71552,"_21099":120097,"_5":14424,"_27663":119913,"_2970":52685},[],{"_3487":71632,"_30445":71552,"_21099":120099,"_5":14424,"_27663":119913,"_2970":120100},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3487":71633,"_30445":71552,"_21099":120102,"_5":14424,"_27663":119913,"_2970":52691},[],{"_3487":71634,"_30445":71552,"_21099":120104,"_5":14424,"_27663":119913,"_2970":120105},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3487":71635,"_30445":71552,"_21099":120107,"_5":14424,"_27663":119913,"_2970":120108},[],"Reglas de esa configuración:",{"_3487":71636,"_30445":71552,"_21099":120110,"_5":14424,"_27663":119913,"_2970":120111},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3487":71637,"_30445":71552,"_21099":120113,"_5":14424,"_27663":119913,"_2970":120114},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3487":71638,"_30445":71552,"_21099":120116,"_5":14424,"_27663":119913,"_2970":120117},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3487":71639,"_30445":71552,"_21099":120119,"_5":14424,"_27663":119913,"_2970":120120},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3487":71640,"_30445":71552,"_21099":120122,"_5":14424,"_27663":119913,"_2970":120123},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3487":71641,"_30445":71552,"_21099":120125,"_5":14424,"_27663":119913,"_2970":120126},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3487":71642,"_30445":71552,"_21099":120128,"_5":14424,"_27663":119913,"_2970":120129},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3487":71643,"_30445":71552,"_21099":120131,"_5":14424,"_27663":119913,"_2970":120132},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3487":71644,"_30445":71552,"_21099":120134,"_5":14424,"_27663":119913,"_2970":120135},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3487":71645,"_30445":71552,"_21099":120137,"_5":14424,"_27663":119917,"_2970":120138},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3487":71646,"_30445":71552,"_21099":120140,"_5":14424,"_27663":119921,"_2970":120141},[],"Campo de `settings.reenrollment_settings`",{"_3487":71647,"_30445":71552,"_21099":120143,"_5":14424,"_27663":119921,"_2970":120144},[],"Función",{"_3487":71648,"_30445":71552,"_21099":120146,"_5":14424,"_27663":119921,"_2970":52735},[],{"_3487":71649,"_30445":71552,"_21099":120148,"_5":14424,"_27663":119921,"_2970":120149},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3487":71650,"_30445":71552,"_21099":120151,"_5":14424,"_27663":119921,"_2970":52741},[],{"_3487":71651,"_30445":71552,"_21099":120153,"_5":14424,"_27663":119921,"_2970":120154},[],"Umbral operativo preventivo de monitorización.",{"_3487":71652,"_30445":71552,"_21099":120156,"_5":14424,"_27663":119921,"_2970":52747},[],{"_3487":71653,"_30445":71552,"_21099":120158,"_5":14424,"_27663":119921,"_2970":120159},[],"Umbral operativo crítico de monitorización.",{"_3487":71654,"_30445":71552,"_21099":120161,"_5":14424,"_27663":119921,"_2970":52753},[],{"_3487":71655,"_30445":71552,"_21099":120163,"_5":14424,"_27663":119921,"_2970":120164},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3487":71656,"_30445":71552,"_21099":120166,"_5":14424,"_27663":119921,"_2970":52759},[],{"_3487":71657,"_30445":71552,"_21099":120168,"_5":14424,"_27663":119921,"_2970":120169},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3487":71658,"_30445":71552,"_21099":120171,"_5":14424,"_27663":119921,"_2970":52765},[],{"_3487":71659,"_30445":71552,"_21099":120173,"_5":14424,"_27663":119921,"_2970":120174},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3487":71660,"_30445":71552,"_21099":120176,"_5":14424,"_27663":119921,"_2970":120177},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3487":71661,"_30445":71552,"_21099":120179,"_5":14424,"_27663":119925,"_2970":120180},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3487":71662,"_30445":71552,"_21099":120182,"_5":14424,"_27663":119928,"_2970":117480},[],{"_3487":71663,"_30445":71552,"_21099":120184,"_5":14424,"_27663":119928,"_2970":120185},[],"Qué publica",{"_3487":71664,"_30445":71552,"_21099":120187,"_5":14424,"_27663":119928,"_2970":52782},[],{"_3487":71665,"_30445":71552,"_21099":120189,"_5":14424,"_27663":119928,"_2970":120190},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3487":71666,"_30445":71552,"_21099":120192,"_5":14424,"_27663":119928,"_2970":52788},[],{"_3487":71667,"_30445":71552,"_21099":120194,"_5":14424,"_27663":119928,"_2970":120195},[],"Certificado de la CA emisora seleccionada.",{"_3487":71668,"_30445":71552,"_21099":120197,"_5":14424,"_27663":119928,"_2970":52794},[],{"_3487":71669,"_30445":71552,"_21099":120199,"_5":14424,"_27663":119928,"_2970":120200},[],"Certificados de las CAs elegidas explícitamente.",{"_3487":71670,"_30445":71552,"_21099":120202,"_5":14424,"_27663":119928,"_2970":120203},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3487":71671,"_30445":71552,"_21099":120205,"_5":14424,"_27663":119932,"_2970":120206},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3487":71672,"_30445":71552,"_21099":120208,"_5":14424,"_27663":119932,"_2970":120209},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3487":71673,"_30445":71552,"_21099":120211,"_5":14424,"_27663":119932,"_2970":120212},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3487":71674,"_30445":71552,"_21099":120214,"_5":14424,"_27663":119936,"_2970":120215},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3487":71675,"_30445":71675,"_5":14788,"_2970":120217,"_30797":120218,"_21099":120219,"_27663":71675},"Integra el cliente EST",[49622,118603,52175,119615,119790],[],{"_3487":71676,"_30445":71675,"_21099":120221,"_5":14424,"_27663":71675,"_2970":120222},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3487":71677,"_30445":71675,"_5":30794,"_21099":120224,"_27663":120225,"_2970":117116},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3487":71678,"_30445":71675,"_5":30794,"_21099":120227,"_27663":120228,"_2970":120229},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3487":71679,"_30445":71675,"_5":30794,"_21099":120231,"_27663":120232,"_2970":120233},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3487":71680,"_30445":71675,"_5":30794,"_21099":120235,"_27663":120236,"_2970":120237},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3487":71681,"_30445":71675,"_5":30794,"_21099":120239,"_27663":120240,"_2970":120241},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3487":71682,"_30445":71675,"_5":30794,"_21099":120243,"_27663":120244,"_2970":120245},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3487":71683,"_30445":71675,"_21099":120247,"_5":14424,"_27663":71675,"_2970":120248},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3487":71684,"_30445":71675,"_21099":120250,"_5":14424,"_27663":120225,"_2970":120251},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3487":71685,"_30445":71675,"_21099":120253,"_5":14424,"_27663":120225,"_2970":120254},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3487":71686,"_30445":71675,"_21099":120256,"_5":14424,"_27663":120225,"_2970":120257},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3487":71687,"_30445":71675,"_21099":120259,"_5":14424,"_27663":120228,"_2970":120260},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3487":71688,"_30445":71675,"_21099":120262,"_5":14424,"_27663":120228,"_2970":120263},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3487":71689,"_30445":71675,"_21099":120265,"_5":14424,"_27663":120232,"_2970":120266},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3487":71690,"_30445":71675,"_21099":120268,"_5":14424,"_27663":120232,"_2970":120269},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3487":71691,"_30445":71675,"_21099":120271,"_5":14424,"_27663":120236,"_2970":120272},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3487":71692,"_30445":71675,"_21099":120274,"_5":14424,"_27663":120236,"_2970":120275},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3487":71693,"_30445":71675,"_21099":120277,"_5":14424,"_27663":120240,"_2970":120278},[],"Para el caso de una raíz que emite directamente:",{"_3487":71694,"_30445":71675,"_21099":120280,"_5":14424,"_27663":120240,"_2970":120281},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3487":71695,"_30445":71675,"_21099":120283,"_5":14424,"_27663":120240,"_2970":120284},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3487":71696,"_30445":71675,"_21099":120286,"_5":14424,"_27663":120244,"_2970":120287},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3487":71697,"_30445":71697,"_5":14788,"_2970":120289,"_30797":120290,"_21099":120291,"_27663":71697},"Referencia EST",[49622,118603,52175,119615,119790],[],{"_3487":71698,"_30445":71697,"_21099":120293,"_5":14424,"_27663":71697,"_2970":120294},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3487":71699,"_30445":71697,"_5":30794,"_21099":120296,"_27663":120297,"_2970":120298},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3487":71700,"_30445":71697,"_5":30794,"_21099":120300,"_27663":120301,"_2970":22862},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3487":71701,"_30445":71697,"_5":30794,"_21099":120303,"_27663":120304,"_2970":26256},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3487":71702,"_30445":71697,"_5":30794,"_21099":120306,"_27663":120307,"_2970":26263},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3487":71703,"_30445":71697,"_5":30794,"_21099":120309,"_27663":120310,"_2970":25577},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3487":71704,"_30445":71697,"_5":30794,"_21099":120312,"_27663":120313,"_2970":120314},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3487":71705,"_30445":71697,"_5":30794,"_21099":120316,"_27663":120317,"_2970":120318},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3487":71706,"_30445":71697,"_5":30794,"_21099":120320,"_27663":120321,"_2970":120322},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3487":71707,"_30445":71697,"_21099":120324,"_5":14424,"_27663":71697,"_2970":120325},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3487":71708,"_30445":71697,"_21099":120327,"_5":14424,"_27663":120297,"_2970":120328},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3487":71709,"_30445":71697,"_21099":120330,"_5":14424,"_27663":120297,"_2970":118354},[],{"_3487":71710,"_30445":71697,"_21099":120332,"_5":14424,"_27663":120297,"_2970":120333},[],"Método",{"_3487":71711,"_30445":71697,"_21099":120335,"_5":14424,"_27663":120297,"_2970":120336},[],"Autenticación y condición",{"_3487":71712,"_30445":71697,"_21099":120338,"_5":14424,"_27663":120297,"_2970":52937},[],{"_3487":71713,"_30445":71697,"_21099":120340,"_5":14424,"_27663":120297,"_2970":52940},[],{"_3487":71714,"_30445":71697,"_21099":120342,"_5":14424,"_27663":120297,"_2970":120343},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3487":71715,"_30445":71697,"_21099":120345,"_5":14424,"_27663":120297,"_2970":52946},[],{"_3487":71716,"_30445":71697,"_21099":120347,"_5":14424,"_27663":120297,"_2970":52949},[],{"_3487":71717,"_30445":71697,"_21099":120349,"_5":14424,"_27663":120297,"_2970":120350},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3487":71718,"_30445":71697,"_21099":120352,"_5":14424,"_27663":120297,"_2970":52955},[],{"_3487":71719,"_30445":71697,"_21099":120354,"_5":14424,"_27663":120297,"_2970":52949},[],{"_3487":71720,"_30445":71697,"_21099":120356,"_5":14424,"_27663":120297,"_2970":120357},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3487":71721,"_30445":71697,"_21099":120359,"_5":14424,"_27663":120297,"_2970":52963},[],{"_3487":71722,"_30445":71697,"_21099":120361,"_5":14424,"_27663":120297,"_2970":52949},[],{"_3487":71723,"_30445":71697,"_21099":120363,"_5":14424,"_27663":120297,"_2970":120364},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3487":71724,"_30445":71697,"_21099":120366,"_5":14424,"_27663":120297,"_2970":120367},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3487":71725,"_30445":71697,"_21099":120369,"_5":14424,"_27663":120301,"_2970":120370},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3487":71726,"_30445":71697,"_21099":120372,"_5":14424,"_27663":120301,"_2970":120373},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3487":71727,"_30445":71697,"_21099":120375,"_5":14424,"_27663":120304,"_2970":120376},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3487":71728,"_30445":71697,"_21099":120378,"_5":14424,"_27663":120304,"_2970":120379},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3487":71729,"_30445":71697,"_21099":120381,"_5":14424,"_27663":120307,"_2970":120382},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3487":71730,"_30445":71697,"_21099":120384,"_5":14424,"_27663":120307,"_2970":120385},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3487":71731,"_30445":71697,"_21099":120387,"_5":14424,"_27663":120310,"_2970":120388},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3487":71732,"_30445":71697,"_21099":120390,"_5":14424,"_27663":120310,"_2970":120391},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3487":71733,"_30445":71697,"_21099":120393,"_5":14424,"_27663":120313,"_2970":120394},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3487":71734,"_30445":71697,"_21099":120396,"_5":14424,"_27663":120313,"_2970":120397},[],"Parte",{"_3487":71735,"_30445":71697,"_21099":120399,"_5":14424,"_27663":120313,"_2970":120400},[],"Contenido tras decodificar su Base64",{"_3487":71736,"_30445":71697,"_21099":120402,"_5":14424,"_27663":120313,"_2970":53007},[],{"_3487":71737,"_30445":71697,"_21099":120404,"_5":14424,"_27663":120313,"_2970":120405},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3487":71738,"_30445":71697,"_21099":120407,"_5":14424,"_27663":120313,"_2970":53013},[],{"_3487":71739,"_30445":71697,"_21099":120409,"_5":14424,"_27663":120313,"_2970":120410},[],"PKCS#7 DER con el certificado emitido.",{"_3487":71740,"_30445":71697,"_21099":120412,"_5":14424,"_27663":120313,"_2970":120413},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3487":71741,"_30445":71697,"_21099":120415,"_5":14424,"_27663":120317,"_2970":120416},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3487":71742,"_30445":71697,"_21099":120418,"_5":14424,"_27663":120317,"_2970":120419},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3487":71743,"_30445":71697,"_21099":120421,"_5":14424,"_27663":120317,"_2970":120422},[],"Convierte y comprueba el resultado:",{"_3487":71744,"_30445":71697,"_21099":120424,"_5":14424,"_27663":120317,"_2970":120425},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3487":71745,"_30445":71697,"_21099":120427,"_5":14424,"_27663":120321,"_2970":120428},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3487":71746,"_30445":71697,"_21099":120430,"_5":14424,"_27663":120321,"_2970":120431},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3487":71747,"_30445":71747,"_5":14788,"_2970":119790,"_30797":120433,"_21099":120434,"_27663":71747},[49622,118603,52175,119615,119790],[],{"_3487":71748,"_30445":71747,"_21099":120436,"_5":14424,"_27663":71747,"_2970":120437},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3487":71749,"_30445":71747,"_5":30794,"_21099":120439,"_27663":120440,"_2970":120441},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3487":71750,"_30445":71747,"_5":30794,"_21099":120443,"_27663":120444,"_2970":120445},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3487":71751,"_30445":71747,"_5":30794,"_21099":120447,"_27663":120448,"_2970":120449},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3487":71752,"_30445":71747,"_5":30794,"_21099":120451,"_27663":120452,"_2970":120453},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3487":71753,"_30445":71747,"_21099":120455,"_5":14424,"_27663":71747,"_2970":120456},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3487":71754,"_30445":71747,"_21099":120458,"_5":14424,"_27663":120440,"_2970":120459},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3487":71755,"_30445":71747,"_21099":120461,"_5":14424,"_27663":120440,"_2970":120462},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3487":71756,"_30445":71747,"_21099":120464,"_5":14424,"_27663":120440,"_2970":120465},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3487":71757,"_30445":71747,"_21099":120467,"_5":14424,"_27663":120440,"_2970":120468},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3487":71758,"_30445":71747,"_21099":120470,"_5":14424,"_27663":120440,"_2970":120471},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3487":71759,"_30445":71747,"_21099":120473,"_5":14424,"_27663":120440,"_2970":120474},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3487":71760,"_30445":71747,"_21099":120476,"_5":14424,"_27663":120444,"_2970":120477},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3487":71761,"_30445":71747,"_21099":120479,"_5":14424,"_27663":120444,"_2970":120480},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3487":71762,"_30445":71747,"_21099":120482,"_5":14424,"_27663":120444,"_2970":120483},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3487":71763,"_30445":71747,"_21099":120485,"_5":14424,"_27663":120444,"_2970":120486},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3487":71764,"_30445":71747,"_21099":120488,"_5":14424,"_27663":120448,"_2970":120489},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3487":71765,"_30445":71747,"_21099":120491,"_5":14424,"_27663":120448,"_2970":120492},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3487":71766,"_30445":71747,"_21099":120494,"_5":14424,"_27663":120448,"_2970":120495},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3487":71767,"_30445":71747,"_21099":120497,"_5":14424,"_27663":120448,"_2970":120498},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3487":71768,"_30445":71747,"_21099":120500,"_5":14424,"_27663":120452,"_2970":120501},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3487":71769,"_30445":71747,"_21099":120503,"_5":14424,"_27663":120452,"_2970":120504},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3487":71770,"_30445":71770,"_5":14788,"_2970":120506,"_30797":120507,"_21099":120508,"_27663":71770},"Estrategias de aprovisionamiento",[49622,118603,52175,119615,119790],[],{"_3487":71771,"_30445":71770,"_21099":120510,"_5":14424,"_27663":71770,"_2970":120511},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3487":71772,"_30445":71770,"_5":30794,"_21099":120513,"_27663":120514,"_2970":120515},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3487":71773,"_30445":71770,"_5":30794,"_21099":120517,"_27663":120518,"_2970":120519},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3487":71774,"_30445":71770,"_5":30794,"_21099":120521,"_27663":120522,"_2970":120523},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3487":71775,"_30445":71770,"_5":30794,"_21099":120525,"_27663":120526,"_2970":120527},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3487":71776,"_30445":71770,"_5":30794,"_21099":120529,"_27663":120530,"_2970":120531},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3487":71777,"_30445":71770,"_21099":120533,"_5":14424,"_27663":71770,"_2970":120534},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3487":71778,"_30445":71770,"_21099":120536,"_5":14424,"_27663":120514,"_2970":120537},[],"Recorrido",{"_3487":71779,"_30445":71770,"_21099":120539,"_5":14424,"_27663":120514,"_2970":120540},[],"Cuándo existe el dispositivo",{"_3487":71780,"_30445":71770,"_21099":120542,"_5":14424,"_27663":120514,"_2970":120543},[],"Qué compruebas",{"_3487":71781,"_30445":71770,"_21099":120545,"_5":14424,"_27663":120514,"_2970":120546},[],"Asignación manual",{"_3487":71782,"_30445":71770,"_21099":120548,"_5":14424,"_27663":120514,"_2970":120549},[],"El operador lo crea antes de asociar un certificado.",{"_3487":71783,"_30445":71770,"_21099":120551,"_5":14424,"_27663":120514,"_2970":120552},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3487":71784,"_30445":71770,"_21099":120554,"_5":14424,"_27663":120514,"_2970":120555},[],"EST con `JITP`",{"_3487":71785,"_30445":71770,"_21099":120557,"_5":14424,"_27663":120514,"_2970":120558},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3487":71786,"_30445":71770,"_21099":120560,"_5":14424,"_27663":120514,"_2970":120561},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3487":71787,"_30445":71770,"_21099":120563,"_5":14424,"_27663":120514,"_2970":120564},[],"EST con `PRE_REGISTRATION`",{"_3487":71788,"_30445":71770,"_21099":120566,"_5":14424,"_27663":120514,"_2970":120567},[],"Debe existir antes de `/simpleenroll`.",{"_3487":71789,"_30445":71770,"_21099":120569,"_5":14424,"_27663":120514,"_2970":120570},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3487":71790,"_30445":71770,"_21099":120572,"_5":14424,"_27663":120514,"_2970":120573},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3487":71791,"_30445":71770,"_21099":120575,"_5":14424,"_27663":120514,"_2970":120576},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3487":71792,"_30445":71770,"_21099":120578,"_5":14424,"_27663":120518,"_2970":120579},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3487":71793,"_30445":71770,"_21099":120581,"_5":14424,"_27663":120518,"_2970":120582},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3487":71794,"_30445":71770,"_21099":120584,"_5":14424,"_27663":120518,"_2970":120585},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3487":71795,"_30445":71770,"_21099":120587,"_5":14424,"_27663":120522,"_2970":120588},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3487":71796,"_30445":71770,"_21099":120590,"_5":14424,"_27663":120522,"_2970":120591},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3487":71797,"_30445":71770,"_21099":120593,"_5":14424,"_27663":120522,"_2970":120594},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3487":71798,"_30445":71770,"_21099":120596,"_5":14424,"_27663":120522,"_2970":120597},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3487":71799,"_30445":71770,"_21099":120599,"_5":14424,"_27663":120522,"_2970":120600},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3487":71800,"_30445":71770,"_21099":120602,"_5":14424,"_27663":120522,"_2970":120603},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3487":71801,"_30445":71770,"_21099":120605,"_5":14424,"_27663":120526,"_2970":117480},[],{"_3487":71802,"_30445":71770,"_21099":120607,"_5":14424,"_27663":120526,"_2970":120608},[],"Material que atraviesa EST",{"_3487":71803,"_30445":71770,"_21099":120610,"_5":14424,"_27663":120526,"_2970":120611},[],"Clave generada por el dispositivo",{"_3487":71804,"_30445":71770,"_21099":120613,"_5":14424,"_27663":120526,"_2970":120614},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3487":71805,"_30445":71770,"_21099":120616,"_5":14424,"_27663":120526,"_2970":120617},[],"Clave ya disponible en el dispositivo",{"_3487":71806,"_30445":71770,"_21099":120619,"_5":14424,"_27663":120526,"_2970":120620},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3487":71807,"_30445":71770,"_21099":120622,"_5":14424,"_27663":120526,"_2970":52494},[],{"_3487":71808,"_30445":71770,"_21099":120624,"_5":14424,"_27663":120526,"_2970":120625},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3487":71809,"_30445":71770,"_21099":120627,"_5":14424,"_27663":120526,"_2970":120628},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3487":71810,"_30445":71770,"_21099":120630,"_5":14424,"_27663":120530,"_2970":120631},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3487":71811,"_30445":71811,"_5":14788,"_2970":120633,"_30797":120634,"_21099":120635,"_27663":71811},"Renovación y recuperación",[49622,118603,52175,119615,119790],[],{"_3487":71812,"_30445":71811,"_21099":120637,"_5":14424,"_27663":71811,"_2970":120638},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3487":71813,"_30445":71811,"_5":30794,"_21099":120640,"_27663":120641,"_2970":120642},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3487":71814,"_30445":71811,"_5":30794,"_21099":120644,"_27663":120645,"_2970":120646},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3487":71815,"_30445":71811,"_5":30794,"_21099":120648,"_27663":120649,"_2970":120650},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3487":71816,"_30445":71811,"_5":30794,"_21099":120652,"_27663":120653,"_2970":120654},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3487":71817,"_30445":71811,"_5":30794,"_21099":120656,"_27663":120657,"_2970":120658},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3487":71818,"_30445":71811,"_21099":120660,"_5":14424,"_27663":71811,"_2970":120661},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3487":71819,"_30445":71811,"_21099":120663,"_5":14424,"_27663":120641,"_2970":120664},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3487":71820,"_30445":71811,"_21099":120666,"_5":14424,"_27663":120641,"_2970":120667},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3487":71821,"_30445":71811,"_21099":120669,"_5":14424,"_27663":120641,"_2970":120670},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3487":71822,"_30445":71811,"_21099":120672,"_5":14424,"_27663":120641,"_2970":120673},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3487":71823,"_30445":71811,"_21099":120675,"_5":14424,"_27663":120645,"_2970":120676},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3487":71824,"_30445":71811,"_21099":120678,"_5":14424,"_27663":120645,"_2970":120679},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3487":71825,"_30445":71811,"_21099":120681,"_5":14424,"_27663":120649,"_2970":120682},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3487":71826,"_30445":71811,"_21099":120684,"_5":14424,"_27663":120649,"_2970":120685},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3487":71827,"_30445":71811,"_21099":120687,"_5":14424,"_27663":120649,"_2970":120688},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3487":71828,"_30445":71811,"_21099":120690,"_5":14424,"_27663":120653,"_2970":120691},[],"Situación",{"_3487":71829,"_30445":71811,"_21099":120693,"_5":14424,"_27663":120653,"_2970":120694},[],"Procedimiento",{"_3487":71830,"_30445":71811,"_21099":120696,"_5":14424,"_27663":120653,"_2970":120697},[],"Certificado vigente, fuera de ventana",{"_3487":71831,"_30445":71811,"_21099":120699,"_5":14424,"_27663":120653,"_2970":120700},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3487":71832,"_30445":71811,"_21099":120702,"_5":14424,"_27663":120653,"_2970":120703},[],"Certificado vencido, clave disponible",{"_3487":71833,"_30445":71811,"_21099":120705,"_5":14424,"_27663":120653,"_2970":120706},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3487":71834,"_30445":71811,"_21099":120708,"_5":14424,"_27663":120653,"_2970":120709},[],"Renovación por webhook o `NO_AUTH`",{"_3487":71835,"_30445":71811,"_21099":120711,"_5":14424,"_27663":120653,"_2970":120712},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3487":71836,"_30445":71811,"_21099":120714,"_5":14424,"_27663":120653,"_2970":120715},[],"Clave perdida o inaccesible",{"_3487":71837,"_30445":71811,"_21099":120717,"_5":14424,"_27663":120653,"_2970":120718},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3487":71838,"_30445":71811,"_21099":120720,"_5":14424,"_27663":120653,"_2970":120721},[],"Identidad actual revocada",{"_3487":71839,"_30445":71811,"_21099":120723,"_5":14424,"_27663":120653,"_2970":120724},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3487":71840,"_30445":71811,"_21099":120726,"_5":14424,"_27663":120653,"_2970":120727},[],"Dispositivo sin identidad",{"_3487":71841,"_30445":71811,"_21099":120729,"_5":14424,"_27663":120653,"_2970":120730},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3487":71842,"_30445":71811,"_21099":120732,"_5":14424,"_27663":120653,"_2970":120733},[],"Dispositivo retirado",{"_3487":71843,"_30445":71811,"_21099":120735,"_5":14424,"_27663":120653,"_2970":120736},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3487":71844,"_30445":71811,"_21099":120738,"_5":14424,"_27663":120653,"_2970":120739},[],"Timeout, HTTP 500 o fallo de instalación",{"_3487":71845,"_30445":71811,"_21099":120741,"_5":14424,"_27663":120653,"_2970":120742},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3487":71846,"_30445":71811,"_21099":120744,"_5":14424,"_27663":120657,"_2970":120745},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3487":71847,"_30445":71811,"_21099":120747,"_5":14424,"_27663":120657,"_2970":120748},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3487":71848,"_30445":71848,"_5":14788,"_2970":120750,"_30797":120751,"_21099":120752,"_27663":71848},"Diagnóstico de enrolamiento",[49622,118603,52175,119615,119790],[],{"_3487":71849,"_30445":71848,"_21099":120754,"_5":14424,"_27663":71848,"_2970":120755},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3487":71850,"_30445":71848,"_5":30794,"_21099":120757,"_27663":120758,"_2970":120759},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3487":71851,"_30445":71848,"_5":30794,"_21099":120761,"_27663":120762,"_2970":120763},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3487":71852,"_30445":71848,"_5":30794,"_21099":120765,"_27663":120766,"_2970":120322},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3487":71853,"_30445":71848,"_5":30794,"_21099":120768,"_27663":120769,"_2970":120770},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3487":71854,"_30445":71848,"_21099":120772,"_5":14424,"_27663":71848,"_2970":120773},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3487":71855,"_30445":71848,"_21099":120775,"_5":14424,"_27663":120762,"_2970":120776},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3487":71856,"_30445":71848,"_21099":120778,"_5":14424,"_27663":120762,"_2970":120779},[],"Síntoma o mensaje",{"_3487":71857,"_30445":71848,"_21099":120781,"_5":14424,"_27663":120762,"_2970":120782},[],"Qué revisar",{"_3487":71858,"_30445":71848,"_21099":120784,"_5":14424,"_27663":120762,"_2970":120785},[],"curl rechaza TLS, nombre o emisor",{"_3487":71859,"_30445":71848,"_21099":120787,"_5":14424,"_27663":120762,"_2970":120788},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3487":71860,"_30445":71848,"_21099":120790,"_5":14424,"_27663":120762,"_2970":120791},[],"404 o APS ausente",{"_3487":71861,"_30445":71848,"_21099":120793,"_5":14424,"_27663":120762,"_2970":120794},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3487":71862,"_30445":71848,"_21099":120796,"_5":14424,"_27663":120762,"_2970":120797},[],"400, error de CSR o formato",{"_3487":71863,"_30445":71848,"_21099":120799,"_5":14424,"_27663":120762,"_2970":120800},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3487":71864,"_30445":71848,"_21099":120802,"_5":14424,"_27663":120762,"_2970":120803},[],"Credencial ausente o certificado no válido",{"_3487":71865,"_30445":71848,"_21099":120805,"_5":14424,"_27663":120762,"_2970":120806},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3487":71866,"_30445":71848,"_21099":120808,"_5":14424,"_27663":120762,"_2970":120809},[],"Webhook deniega, expira o responde sin autorización",{"_3487":71867,"_30445":71848,"_21099":120811,"_5":14424,"_27663":120762,"_2970":120812},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3487":71868,"_30445":71848,"_21099":120814,"_5":14424,"_27663":120762,"_2970":53420},[],{"_3487":71869,"_30445":71848,"_21099":120816,"_5":14424,"_27663":120762,"_2970":120817},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3487":71870,"_30445":71848,"_21099":120819,"_5":14424,"_27663":120762,"_2970":53426},[],{"_3487":71871,"_30445":71848,"_21099":120821,"_5":14424,"_27663":120762,"_2970":120822},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3487":71872,"_30445":71848,"_21099":120824,"_5":14424,"_27663":120762,"_2970":53432},[],{"_3487":71873,"_30445":71848,"_21099":120826,"_5":14424,"_27663":120762,"_2970":120827},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3487":71874,"_30445":71848,"_21099":120829,"_5":14424,"_27663":120762,"_2970":53438},[],{"_3487":71875,"_30445":71848,"_21099":120831,"_5":14424,"_27663":120762,"_2970":120832},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3487":71876,"_30445":71848,"_21099":120834,"_5":14424,"_27663":120762,"_2970":53444},[],{"_3487":71877,"_30445":71848,"_21099":120836,"_5":14424,"_27663":120762,"_2970":120837},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3487":71878,"_30445":71848,"_21099":120839,"_5":14424,"_27663":120762,"_2970":120840},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3487":71879,"_30445":71848,"_21099":120842,"_5":14424,"_27663":120762,"_2970":120843},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3487":71880,"_30445":71848,"_21099":120845,"_5":14424,"_27663":120762,"_2970":120846},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3487":71881,"_30445":71848,"_21099":120848,"_5":14424,"_27663":120762,"_2970":120849},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3487":71882,"_30445":71848,"_21099":120851,"_5":14424,"_27663":120762,"_2970":53462},[],{"_3487":71883,"_30445":71848,"_21099":120853,"_5":14424,"_27663":120762,"_2970":120854},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3487":71884,"_30445":71848,"_21099":120856,"_5":14424,"_27663":120762,"_2970":53468},[],{"_3487":71885,"_30445":71848,"_21099":120858,"_5":14424,"_27663":120762,"_2970":120859},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3487":71886,"_30445":71848,"_21099":120861,"_5":14424,"_27663":120762,"_2970":120862},[],"DMS propietario distinto",{"_3487":71887,"_30445":71848,"_21099":120864,"_5":14424,"_27663":120762,"_2970":120865},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3487":71888,"_30445":71848,"_21099":120867,"_5":14424,"_27663":120762,"_2970":53480},[],{"_3487":71889,"_30445":71848,"_21099":120869,"_5":14424,"_27663":120762,"_2970":120870},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3487":71890,"_30445":71848,"_21099":120872,"_5":14424,"_27663":120762,"_2970":53486},[],{"_3487":71891,"_30445":71848,"_21099":120874,"_5":14424,"_27663":120762,"_2970":120875},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3487":71892,"_30445":71848,"_21099":120877,"_5":14424,"_27663":120762,"_2970":120878},[],"Certificado actual revocado",{"_3487":71893,"_30445":71848,"_21099":120880,"_5":14424,"_27663":120762,"_2970":120881},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3487":71894,"_30445":71848,"_21099":120883,"_5":14424,"_27663":120762,"_2970":120884},[],"Error de CA, perfil o firma",{"_3487":71895,"_30445":71848,"_21099":120886,"_5":14424,"_27663":120762,"_2970":120887},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3487":71896,"_30445":71848,"_21099":120889,"_5":14424,"_27663":120762,"_2970":120890},[],"HTTP 200 sin conexión del dispositivo",{"_3487":71897,"_30445":71848,"_21099":120892,"_5":14424,"_27663":120762,"_2970":120893},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3487":71898,"_30445":71848,"_21099":120895,"_5":14424,"_27663":120762,"_2970":120896},[],"Timeout o error después de emitir",{"_3487":71899,"_30445":71848,"_21099":120898,"_5":14424,"_27663":120762,"_2970":120899},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3487":71900,"_30445":71848,"_21099":120901,"_5":14424,"_27663":120766,"_2970":120902},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3487":71901,"_30445":71848,"_21099":120904,"_5":14424,"_27663":120766,"_2970":120905},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3487":71902,"_30445":71848,"_21099":120907,"_5":14424,"_27663":120769,"_2970":120908},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3487":71903,"_30445":71848,"_21099":120910,"_5":14424,"_27663":120769,"_2970":120911},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3487":71904,"_30445":71848,"_21099":120913,"_5":14424,"_27663":120769,"_2970":120914},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3487":71905,"_30445":71848,"_21099":120916,"_5":14424,"_27663":120769,"_2970":120917},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3487":71906,"_30445":71848,"_21099":120919,"_5":14424,"_27663":120769,"_2970":120920},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3487":71907,"_30445":71848,"_21099":120922,"_5":14424,"_27663":120769,"_2970":120923},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3487":71908,"_30445":71848,"_21099":120925,"_5":14424,"_27663":120769,"_2970":120926},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3487":71909,"_30445":71909,"_5":14788,"_2970":120928,"_30797":120929,"_21099":120930,"_27663":71909},"Distribución y actualización de confianza",[49622,118603,52175,119615,119790],[],{"_3487":71910,"_30445":71909,"_21099":120932,"_5":14424,"_27663":71909,"_2970":120933},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3487":71911,"_30445":71909,"_5":30794,"_21099":120935,"_27663":120936,"_2970":120937},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3487":71912,"_30445":71909,"_5":30794,"_21099":120939,"_27663":120940,"_2970":120941},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3487":71913,"_30445":71909,"_5":30794,"_21099":120943,"_27663":120944,"_2970":120945},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3487":71914,"_30445":71909,"_5":30794,"_21099":120947,"_27663":120948,"_2970":120949},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3487":71915,"_30445":71909,"_5":30794,"_21099":120951,"_27663":120952,"_2970":120953},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3487":71916,"_30445":71909,"_21099":120955,"_5":14424,"_27663":71909,"_2970":120956},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3487":71917,"_30445":71909,"_21099":120958,"_5":14424,"_27663":120936,"_2970":120959},[],"Relación",{"_3487":71918,"_30445":71909,"_21099":120961,"_5":14424,"_27663":120936,"_2970":120962},[],"Material que prepara el responsable",{"_3487":71919,"_30445":71909,"_21099":120964,"_5":14424,"_27663":120936,"_2970":120965},[],"Dispositivo → servidor EST",{"_3487":71920,"_30445":71909,"_21099":120967,"_5":14424,"_27663":120936,"_2970":120968},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3487":71921,"_30445":71909,"_21099":120970,"_5":14424,"_27663":120936,"_2970":120971},[],"DMS → solicitante",{"_3487":71922,"_30445":71909,"_21099":120973,"_5":14424,"_27663":120936,"_2970":120974},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3487":71923,"_30445":71909,"_21099":120976,"_5":14424,"_27663":120936,"_2970":120977},[],"Consumidor → dispositivo",{"_3487":71924,"_30445":71909,"_21099":120979,"_5":14424,"_27663":120936,"_2970":120980},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3487":71925,"_30445":71909,"_21099":120982,"_5":14424,"_27663":120936,"_2970":120983},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3487":71926,"_30445":71909,"_21099":120985,"_5":14424,"_27663":120940,"_2970":120986},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3487":71927,"_30445":71909,"_21099":120988,"_5":14424,"_27663":120940,"_2970":120989},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3487":71928,"_30445":71909,"_21099":120991,"_5":14424,"_27663":120944,"_2970":120992},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3487":71929,"_30445":71909,"_21099":120994,"_5":14424,"_27663":120944,"_2970":120995},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3487":71930,"_30445":71909,"_21099":120997,"_5":14424,"_27663":120944,"_2970":120998},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3487":71931,"_30445":71909,"_21099":121000,"_5":14424,"_27663":120944,"_2970":121001},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3487":71932,"_30445":71909,"_21099":121003,"_5":14424,"_27663":120944,"_2970":121004},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3487":71933,"_30445":71909,"_21099":121006,"_5":14424,"_27663":120944,"_2970":121007},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3487":71934,"_30445":71909,"_21099":121009,"_5":14424,"_27663":120948,"_2970":121010},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3487":71935,"_30445":71909,"_21099":121012,"_5":14424,"_27663":120948,"_2970":121013},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3487":71936,"_30445":71909,"_21099":121015,"_5":14424,"_27663":120948,"_2970":121016},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3487":71937,"_30445":71909,"_21099":121018,"_5":14424,"_27663":120952,"_2970":121019},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3487":71938,"_30445":71938,"_5":14788,"_2970":53635,"_30797":121021,"_21099":121023,"_27663":71938},[49622,118603,52175,119615,121022],"Integraciones",[],{"_3487":71939,"_30445":71938,"_21099":121025,"_5":14424,"_27663":71938,"_2970":121026},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3487":71940,"_30445":71938,"_5":30794,"_21099":121028,"_27663":121029,"_2970":121030},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3487":71941,"_30445":71938,"_5":30794,"_21099":121032,"_27663":121033,"_2970":121034},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3487":71942,"_30445":71938,"_5":30794,"_21099":121036,"_27663":121037,"_2970":121038},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3487":71943,"_30445":71938,"_5":30794,"_21099":121040,"_27663":121041,"_2970":121042},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3487":71944,"_30445":71938,"_5":30794,"_21099":121044,"_27663":121045,"_2970":121046},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3487":71945,"_30445":71938,"_5":30794,"_21099":121048,"_27663":121049,"_2970":121050},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3487":71946,"_30445":71938,"_5":30794,"_21099":121052,"_27663":121053,"_2970":121054},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3487":71947,"_30445":71938,"_5":30794,"_21099":121056,"_27663":121057,"_2970":121058},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3487":71948,"_30445":71938,"_5":30794,"_21099":121060,"_27663":121061,"_2970":53677},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3487":71949,"_30445":71938,"_5":30794,"_21099":121063,"_27663":121064,"_2970":53681},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3487":71950,"_30445":71938,"_5":30794,"_21099":121066,"_27663":121067,"_2970":121068},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3487":71951,"_30445":71938,"_5":30794,"_21099":121070,"_27663":121071,"_2970":121072},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3487":71952,"_30445":71938,"_5":30794,"_21099":121074,"_27663":121075,"_2970":121076},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3487":71953,"_30445":71938,"_5":30794,"_21099":121078,"_27663":121079,"_2970":121080},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3487":71954,"_30445":71938,"_5":30794,"_21099":121082,"_27663":121083,"_2970":121084},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3487":71955,"_30445":71938,"_5":30794,"_21099":121086,"_27663":121087,"_2970":121088},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3487":71956,"_30445":71938,"_5":30794,"_21099":121090,"_27663":121091,"_2970":121092},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3487":71957,"_30445":71938,"_5":30794,"_21099":121094,"_27663":121095,"_2970":121096},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3487":71958,"_30445":71938,"_5":30794,"_21099":121098,"_27663":121099,"_2970":121100},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3487":71959,"_30445":71938,"_5":30794,"_21099":121102,"_27663":121103,"_2970":121104},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3487":71960,"_30445":71938,"_5":30794,"_21099":121106,"_27663":121107,"_2970":121108},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3487":71961,"_30445":71938,"_5":30794,"_21099":121110,"_27663":121111,"_2970":121112},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3487":71962,"_30445":71938,"_5":30794,"_21099":121114,"_27663":121115,"_2970":121116},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3487":71963,"_30445":71938,"_5":30794,"_21099":121118,"_27663":121119,"_2970":121120},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3487":71964,"_30445":71938,"_5":30794,"_21099":121122,"_27663":121123,"_2970":121124},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3487":71965,"_30445":71938,"_21099":121126,"_5":14424,"_27663":71938,"_2970":121127},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3487":71966,"_30445":71938,"_21099":121129,"_5":14424,"_27663":71938,"_2970":121130},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3487":71967,"_30445":71938,"_21099":121132,"_5":14424,"_27663":71938,"_2970":121133},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3487":71968,"_30445":71938,"_21099":121135,"_5":14424,"_27663":121029,"_2970":121136},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3487":71969,"_30445":71938,"_21099":121138,"_5":14424,"_27663":121029,"_2970":121139},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3487":71970,"_30445":71938,"_21099":121141,"_5":14424,"_27663":121029,"_2970":121142},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3487":71971,"_30445":71938,"_21099":121144,"_5":14424,"_27663":121029,"_2970":121145},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3487":71972,"_30445":71938,"_21099":121147,"_5":14424,"_27663":121033,"_2970":121148},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3487":71973,"_30445":71938,"_21099":121150,"_5":14424,"_27663":121037,"_2970":121151},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3487":71974,"_30445":71938,"_21099":121153,"_5":14424,"_27663":121037,"_2970":121154},[],"Acción IAM",{"_3487":71975,"_30445":71938,"_21099":121156,"_5":14424,"_27663":121037,"_2970":117486},[],{"_3487":71976,"_30445":71938,"_21099":121158,"_5":14424,"_27663":121037,"_2970":53776},[],{"_3487":71977,"_30445":71938,"_21099":121160,"_5":14424,"_27663":121037,"_2970":121161},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3487":71978,"_30445":71938,"_21099":121163,"_5":14424,"_27663":121037,"_2970":53782},[],{"_3487":71979,"_30445":71938,"_21099":121165,"_5":14424,"_27663":121037,"_2970":121166},[],"Registrar la CA en AWS IoT",{"_3487":71980,"_30445":71938,"_21099":121168,"_5":14424,"_27663":121037,"_2970":53788},[],{"_3487":71981,"_30445":71938,"_21099":121170,"_5":14424,"_27663":121037,"_2970":121171},[],"Consultar el estado del registro de la CA",{"_3487":71982,"_30445":71938,"_21099":121173,"_5":14424,"_27663":121037,"_2970":53794},[],{"_3487":71983,"_30445":71938,"_21099":121175,"_5":14424,"_27663":121037,"_2970":121176},[],"Crear o actualizar Things en IoT Core",{"_3487":71984,"_30445":71938,"_21099":121178,"_5":14424,"_27663":121037,"_2970":53800},[],{"_3487":71985,"_30445":71938,"_21099":121180,"_5":14424,"_27663":121037,"_2970":121181},[],"Aprovisionar Things mediante plantilla",{"_3487":71986,"_30445":71938,"_21099":121183,"_5":14424,"_27663":121037,"_2970":53806},[],{"_3487":71987,"_30445":71938,"_21099":121185,"_5":14424,"_27663":121037,"_2970":121186},[],"Registrar certificados de dispositivo",{"_3487":71988,"_30445":71938,"_21099":121188,"_5":14424,"_27663":121037,"_2970":53812},[],{"_3487":71989,"_30445":71938,"_21099":121190,"_5":14424,"_27663":121037,"_2970":121191},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3487":71990,"_30445":71938,"_21099":121193,"_5":14424,"_27663":121037,"_2970":53818},[],{"_3487":71991,"_30445":71938,"_21099":121195,"_5":14424,"_27663":121037,"_2970":121196},[],"Crear y adjuntar políticas IoT",{"_3487":71992,"_30445":71938,"_21099":121198,"_5":14424,"_27663":121037,"_2970":53824},[],{"_3487":71993,"_30445":71938,"_21099":121200,"_5":14424,"_27663":121037,"_2970":121201},[],"Gestionar grupos de Things",{"_3487":71994,"_30445":71938,"_21099":121203,"_5":14424,"_27663":121037,"_2970":53830},[],{"_3487":71995,"_30445":71938,"_21099":121205,"_5":14424,"_27663":121037,"_2970":121206},[],"Crear plantillas JITP",{"_3487":71996,"_30445":71938,"_21099":121208,"_5":14424,"_27663":121037,"_2970":53836},[],{"_3487":71997,"_30445":71938,"_21099":121210,"_5":14424,"_27663":121037,"_2970":121211},[],"Leer y escribir el Device Shadow",{"_3487":71998,"_30445":71938,"_21099":121213,"_5":14424,"_27663":121037,"_2970":121214},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3487":71999,"_30445":71938,"_21099":121216,"_5":14424,"_27663":121041,"_2970":121217},[],"Parámetro",{"_3487":72000,"_30445":71938,"_21099":121219,"_5":14424,"_27663":121041,"_2970":121220},[],"Tipo",{"_3487":72001,"_30445":71938,"_21099":121222,"_5":14424,"_27663":121041,"_2970":121223},[],"Requerido",{"_3487":72002,"_30445":71938,"_21099":121225,"_5":14424,"_27663":121041,"_2970":121226},[],"Descripción",{"_3487":72003,"_30445":71938,"_21099":121228,"_5":14424,"_27663":121041,"_2970":53857},[],{"_3487":72004,"_30445":71938,"_21099":121230,"_5":14424,"_27663":121041,"_2970":25195},[],{"_3487":72005,"_30445":71938,"_21099":121232,"_5":14424,"_27663":121041,"_2970":121233},[],"Sí",{"_3487":72006,"_30445":71938,"_21099":121235,"_5":14424,"_27663":121041,"_2970":121236},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3487":72007,"_30445":71938,"_21099":121238,"_5":14424,"_27663":121041,"_2970":53868},[],{"_3487":72008,"_30445":71938,"_21099":121240,"_5":14424,"_27663":121041,"_2970":25195},[],{"_3487":72009,"_30445":71938,"_21099":121242,"_5":14424,"_27663":121041,"_2970":121233},[],{"_3487":72010,"_30445":71938,"_21099":121244,"_5":14424,"_27663":121041,"_2970":121245},[],"Región AWS donde opera el conector.",{"_3487":72011,"_30445":71938,"_21099":121247,"_5":14424,"_27663":121041,"_2970":53878},[],{"_3487":72012,"_30445":71938,"_21099":121249,"_5":14424,"_27663":121041,"_2970":25195},[],{"_3487":72013,"_30445":71938,"_21099":121251,"_5":14424,"_27663":121041,"_2970":121233},[],{"_3487":72014,"_30445":71938,"_21099":121253,"_5":14424,"_27663":121041,"_2970":121254},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3487":72015,"_30445":71938,"_21099":121256,"_5":14424,"_27663":121041,"_2970":53888},[],{"_3487":72016,"_30445":71938,"_21099":121258,"_5":14424,"_27663":121041,"_2970":25195},[],{"_3487":72017,"_30445":71938,"_21099":121260,"_5":14424,"_27663":121041,"_2970":121261},[],"Solo con `auth_method=static`",{"_3487":72018,"_30445":71938,"_21099":121263,"_5":14424,"_27663":121041,"_2970":121264},[],"Clave de acceso AWS.",{"_3487":72019,"_30445":71938,"_21099":121266,"_5":14424,"_27663":121041,"_2970":53899},[],{"_3487":72020,"_30445":71938,"_21099":121268,"_5":14424,"_27663":121041,"_2970":25195},[],{"_3487":72021,"_30445":71938,"_21099":121270,"_5":14424,"_27663":121041,"_2970":121261},[],{"_3487":72022,"_30445":71938,"_21099":121272,"_5":14424,"_27663":121041,"_2970":121273},[],"Clave secreta AWS.",{"_3487":72023,"_30445":71938,"_21099":121275,"_5":14424,"_27663":121041,"_2970":53909},[],{"_3487":72024,"_30445":71938,"_21099":121277,"_5":14424,"_27663":121041,"_2970":25195},[],{"_3487":72025,"_30445":71938,"_21099":121279,"_5":14424,"_27663":121041,"_2970":53914},[],{"_3487":72026,"_30445":71938,"_21099":121281,"_5":14424,"_27663":121041,"_2970":121282},[],"Token de sesión (con `auth_method=static`).",{"_3487":72027,"_30445":71938,"_21099":121284,"_5":14424,"_27663":121041,"_2970":53920},[],{"_3487":72028,"_30445":71938,"_21099":121286,"_5":14424,"_27663":121041,"_2970":25195},[],{"_3487":72029,"_30445":71938,"_21099":121288,"_5":14424,"_27663":121041,"_2970":121289},[],"Solo con `auth_method=role`",{"_3487":72030,"_30445":71938,"_21099":121291,"_5":14424,"_27663":121041,"_2970":121292},[],"ARN del rol a asumir.",{"_3487":72031,"_30445":71938,"_21099":121294,"_5":14424,"_27663":121041,"_2970":53931},[],{"_3487":72032,"_30445":71938,"_21099":121296,"_5":14424,"_27663":121041,"_2970":25195},[],{"_3487":72033,"_30445":71938,"_21099":121298,"_5":14424,"_27663":121041,"_2970":53914},[],{"_3487":72034,"_30445":71938,"_21099":121300,"_5":14424,"_27663":121041,"_2970":121301},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3487":72035,"_30445":71938,"_21099":121303,"_5":14424,"_27663":121041,"_2970":53941},[],{"_3487":72036,"_30445":71938,"_21099":121305,"_5":14424,"_27663":121041,"_2970":90408},[],{"_3487":72037,"_30445":71938,"_21099":121307,"_5":14424,"_27663":121041,"_2970":121233},[],{"_3487":72038,"_30445":71938,"_21099":121309,"_5":14424,"_27663":121041,"_2970":121310},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3487":72039,"_30445":71938,"_21099":121312,"_5":14424,"_27663":121041,"_2970":53951},[],{"_3487":72040,"_30445":71938,"_21099":121314,"_5":14424,"_27663":121041,"_2970":25195},[],{"_3487":72041,"_30445":71938,"_21099":121316,"_5":14424,"_27663":121041,"_2970":121233},[],{"_3487":72042,"_30445":71938,"_21099":121318,"_5":14424,"_27663":121041,"_2970":121319},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3487":72043,"_30445":71938,"_21099":121321,"_5":14424,"_27663":121041,"_2970":53961},[],{"_3487":72044,"_30445":71938,"_21099":121323,"_5":14424,"_27663":121041,"_2970":25195},[],{"_3487":72045,"_30445":71938,"_21099":121325,"_5":14424,"_27663":121041,"_2970":121233},[],{"_3487":72046,"_30445":71938,"_21099":121327,"_5":14424,"_27663":121041,"_2970":121328},[],"URL HTTP del Device Manager de Lamassu.",{"_3487":72047,"_30445":71938,"_21099":121330,"_5":14424,"_27663":121041,"_2970":53971},[],{"_3487":72048,"_30445":71938,"_21099":121332,"_5":14424,"_27663":121041,"_2970":25195},[],{"_3487":72049,"_30445":71938,"_21099":121334,"_5":14424,"_27663":121041,"_2970":121233},[],{"_3487":72050,"_30445":71938,"_21099":121336,"_5":14424,"_27663":121041,"_2970":121337},[],"URL HTTP del servicio de CA de Lamassu.",{"_3487":72051,"_30445":71938,"_21099":121339,"_5":14424,"_27663":121045,"_2970":121340},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3487":72052,"_30445":71938,"_21099":121342,"_5":14424,"_27663":121045,"_2970":121343},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3487":72053,"_30445":71938,"_21099":121345,"_5":14424,"_27663":121045,"_2970":121346},[],"Tipo de CloudEvent",{"_3487":72054,"_30445":71938,"_21099":121348,"_5":14424,"_27663":121045,"_2970":121349},[],"Recurso en Lamassu",{"_3487":72055,"_30445":71938,"_21099":121351,"_5":14424,"_27663":121045,"_2970":121352},[],"Recurso AWS",{"_3487":72056,"_30445":71938,"_21099":121354,"_5":14424,"_27663":121045,"_2970":121355},[],"Acciones IAM",{"_3487":72057,"_30445":71938,"_21099":121357,"_5":14424,"_27663":121045,"_2970":121358},[],"Llamadas AWS y efecto",{"_3487":72058,"_30445":71938,"_21099":121360,"_5":14424,"_27663":121045,"_2970":121361},[],"Dónde en esta página",{"_3487":72059,"_30445":71938,"_21099":121363,"_5":14424,"_27663":121045,"_2970":54005},[],{"_3487":72060,"_30445":71938,"_21099":121365,"_5":14424,"_27663":121045,"_2970":54008},[],{"_3487":72061,"_30445":71938,"_21099":121367,"_5":14424,"_27663":121045,"_2970":54011},[],{"_3487":72062,"_30445":71938,"_21099":121369,"_5":14424,"_27663":121045,"_2970":54014},[],{"_3487":72063,"_30445":71938,"_21099":121371,"_5":14424,"_27663":121045,"_2970":121372},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3487":72064,"_30445":71938,"_21099":121374,"_5":14424,"_27663":121045,"_2970":121058},[],{"_3487":72065,"_30445":71938,"_21099":121376,"_5":14424,"_27663":121045,"_2970":54022},[],{"_3487":72066,"_30445":71938,"_21099":121378,"_5":14424,"_27663":121045,"_2970":54025},[],{"_3487":72067,"_30445":71938,"_21099":121380,"_5":14424,"_27663":121045,"_2970":54028},[],{"_3487":72068,"_30445":71938,"_21099":121382,"_5":14424,"_27663":121045,"_2970":54031},[],{"_3487":72069,"_30445":71938,"_21099":121384,"_5":14424,"_27663":121045,"_2970":121385},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3487":72070,"_30445":71938,"_21099":121387,"_5":14424,"_27663":121045,"_2970":121084},[],{"_3487":72071,"_30445":71938,"_21099":121389,"_5":14424,"_27663":121045,"_2970":54039},[],{"_3487":72072,"_30445":71938,"_21099":121391,"_5":14424,"_27663":121045,"_2970":121392},[],"Dispositivo",{"_3487":72073,"_30445":71938,"_21099":121394,"_5":14424,"_27663":121045,"_2970":54045},[],{"_3487":72074,"_30445":71938,"_21099":121396,"_5":14424,"_27663":121045,"_2970":54048},[],{"_3487":72075,"_30445":71938,"_21099":121398,"_5":14424,"_27663":121045,"_2970":121399},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3487":72076,"_30445":71938,"_21099":121401,"_5":14424,"_27663":121045,"_2970":121092},[],{"_3487":72077,"_30445":71938,"_21099":121403,"_5":14424,"_27663":121045,"_2970":54056},[],{"_3487":72078,"_30445":71938,"_21099":121405,"_5":14424,"_27663":121045,"_2970":121406},[],"Certificado",{"_3487":72079,"_30445":71938,"_21099":121408,"_5":14424,"_27663":121045,"_2970":54062},[],{"_3487":72080,"_30445":71938,"_21099":121410,"_5":14424,"_27663":121045,"_2970":121411},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3487":72081,"_30445":71938,"_21099":121413,"_5":14424,"_27663":121045,"_2970":121414},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3487":72082,"_30445":71938,"_21099":121416,"_5":14424,"_27663":121045,"_2970":121104},[],{"_3487":72083,"_30445":71938,"_21099":121418,"_5":14424,"_27663":121045,"_2970":54073},[],{"_3487":72084,"_30445":71938,"_21099":121420,"_5":14424,"_27663":121045,"_2970":121421},[],"Certificado / Dispositivo",{"_3487":72085,"_30445":71938,"_21099":121423,"_5":14424,"_27663":121045,"_2970":54079},[],{"_3487":72086,"_30445":71938,"_21099":121425,"_5":14424,"_27663":121045,"_2970":50018},[],{"_3487":72087,"_30445":71938,"_21099":121427,"_5":14424,"_27663":121045,"_2970":121428},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3487":72088,"_30445":71938,"_21099":121430,"_5":14424,"_27663":121045,"_2970":121112},[],{"_3487":72089,"_30445":71938,"_21099":121432,"_5":14424,"_27663":121049,"_2970":121433},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3487":72090,"_30445":71938,"_21099":121435,"_5":14424,"_27663":121053,"_2970":121436},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3487":72091,"_30445":71938,"_21099":121438,"_5":14424,"_27663":121053,"_2970":121439},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3487":72092,"_30445":71938,"_21099":121441,"_5":14424,"_27663":121057,"_2970":121442},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3487":72093,"_30445":71938,"_21099":121444,"_5":14424,"_27663":121057,"_2970":121445},[],"Transición",{"_3487":72094,"_30445":71938,"_21099":121447,"_5":14424,"_27663":121057,"_2970":121448},[],"Llamadas AWS",{"_3487":72095,"_30445":71938,"_21099":121450,"_5":14424,"_27663":121057,"_2970":121451},[],"`NoRegistrada` → `Solicitada`",{"_3487":72096,"_30445":71938,"_21099":121453,"_5":14424,"_27663":121057,"_2970":121454},[],"ninguna (solo escritura de metadatos)",{"_3487":72097,"_30445":71938,"_21099":121456,"_5":14424,"_27663":121057,"_2970":121457},[],"`Solicitada` → `Registrando`",{"_3487":72098,"_30445":71938,"_21099":121459,"_5":14424,"_27663":121057,"_2970":121460},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3487":72099,"_30445":71938,"_21099":121462,"_5":14424,"_27663":121057,"_2970":121463},[],"`Registrando` → `Completada`",{"_3487":72100,"_30445":71938,"_21099":121465,"_5":14424,"_27663":121057,"_2970":121466},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3487":72101,"_30445":71938,"_21099":121468,"_5":14424,"_27663":121057,"_2970":121469},[],"`Registrando` → `Fallida`",{"_3487":72102,"_30445":71938,"_21099":121471,"_5":14424,"_27663":121057,"_2970":121472},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3487":72103,"_30445":71938,"_21099":121474,"_5":14424,"_27663":121057,"_2970":121475},[],"`Fallida` / `Completada` → `Solicitada`",{"_3487":72104,"_30445":71938,"_21099":121477,"_5":14424,"_27663":121057,"_2970":121478},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3487":72105,"_30445":71938,"_21099":121480,"_5":14424,"_27663":121061,"_2970":121481},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3487":72106,"_30445":71938,"_21099":121483,"_5":14424,"_27663":121061,"_2970":121484},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3487":72107,"_30445":71938,"_21099":121486,"_5":14424,"_27663":121061,"_2970":121487},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3487":72108,"_30445":71938,"_21099":121489,"_5":14424,"_27663":121061,"_2970":121490},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3487":72109,"_30445":71938,"_21099":121492,"_5":14424,"_27663":121061,"_2970":121493},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3487":72110,"_30445":71938,"_21099":121495,"_5":14424,"_27663":121061,"_2970":121496},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3487":72111,"_30445":71938,"_21099":121498,"_5":14424,"_27663":121064,"_2970":121499},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3487":72112,"_30445":71938,"_21099":121501,"_5":14424,"_27663":121067,"_2970":121502},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3487":72113,"_30445":71938,"_21099":121504,"_5":14424,"_27663":121067,"_2970":121505},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3487":72114,"_30445":71938,"_21099":121507,"_5":14424,"_27663":121071,"_2970":121508},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3487":72115,"_30445":71938,"_21099":121510,"_5":14424,"_27663":121075,"_2970":121511},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3487":72116,"_30445":71938,"_21099":121513,"_5":14424,"_27663":121075,"_2970":121514},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3487":72117,"_30445":71938,"_21099":121516,"_5":14424,"_27663":121075,"_2970":121517},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3487":72118,"_30445":71938,"_21099":121519,"_5":14424,"_27663":121075,"_2970":121520},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3487":72119,"_30445":71938,"_21099":121522,"_5":14424,"_27663":121075,"_2970":121523},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3487":72120,"_30445":71938,"_21099":121525,"_5":14424,"_27663":121075,"_2970":121526},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3487":72121,"_30445":71938,"_21099":121528,"_5":14424,"_27663":121079,"_2970":121529},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3487":72122,"_30445":71938,"_21099":121531,"_5":14424,"_27663":121079,"_2970":121532},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3487":72123,"_30445":71938,"_21099":121534,"_5":14424,"_27663":121079,"_2970":121535},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3487":72124,"_30445":71938,"_21099":121537,"_5":14424,"_27663":121079,"_2970":121538},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3487":72125,"_30445":71938,"_21099":121540,"_5":14424,"_27663":121079,"_2970":121541},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3487":72126,"_30445":71938,"_21099":121543,"_5":14424,"_27663":121083,"_2970":121544},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3487":72127,"_30445":71938,"_21099":121546,"_5":14424,"_27663":121083,"_2970":121445},[],{"_3487":72128,"_30445":71938,"_21099":121548,"_5":14424,"_27663":121083,"_2970":121448},[],{"_3487":72129,"_30445":71938,"_21099":121550,"_5":14424,"_27663":121083,"_2970":121551},[],"`SinConfigurar` → `None` / `Auto`",{"_3487":72130,"_30445":71938,"_21099":121553,"_5":14424,"_27663":121083,"_2970":121554},[],"ninguna (solo configuración)",{"_3487":72131,"_30445":71938,"_21099":121556,"_5":14424,"_27663":121083,"_2970":54216},[],{"_3487":72132,"_30445":71938,"_21099":121558,"_5":14424,"_27663":121083,"_2970":121554},[],{"_3487":72133,"_30445":71938,"_21099":121560,"_5":14424,"_27663":121083,"_2970":121561},[],"Cualquiera → `Jitp`",{"_3487":72134,"_30445":71938,"_21099":121563,"_5":14424,"_27663":121083,"_2970":121564},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3487":72135,"_30445":71938,"_21099":121566,"_5":14424,"_27663":121083,"_2970":54227},[],{"_3487":72136,"_30445":71938,"_21099":121568,"_5":14424,"_27663":121083,"_2970":121569},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3487":72137,"_30445":71938,"_21099":121571,"_5":14424,"_27663":121087,"_2970":121572},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3487":72138,"_30445":71938,"_21099":121574,"_5":14424,"_27663":121087,"_2970":121575},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3487":72139,"_30445":71938,"_21099":121577,"_5":14424,"_27663":121087,"_2970":121578},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3487":72140,"_30445":71938,"_21099":121580,"_5":14424,"_27663":121091,"_2970":121581},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3487":72141,"_30445":71938,"_21099":121583,"_5":14424,"_27663":121091,"_2970":121445},[],{"_3487":72142,"_30445":71938,"_21099":121585,"_5":14424,"_27663":121091,"_2970":121448},[],{"_3487":72143,"_30445":71938,"_21099":121587,"_5":14424,"_27663":121091,"_2970":121588},[],"`Ausente` → `Aprovisionado`",{"_3487":72144,"_30445":71938,"_21099":121590,"_5":14424,"_27663":121091,"_2970":121591},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3487":72145,"_30445":71938,"_21099":121593,"_5":14424,"_27663":121091,"_2970":121594},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3487":72146,"_30445":71938,"_21099":121596,"_5":14424,"_27663":121091,"_2970":121597},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3487":72147,"_30445":71938,"_21099":121599,"_5":14424,"_27663":121091,"_2970":121600},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3487":72148,"_30445":71938,"_21099":121602,"_5":14424,"_27663":121095,"_2970":121603},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3487":72149,"_30445":71938,"_21099":121605,"_5":14424,"_27663":121095,"_2970":121606},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3487":72150,"_30445":71938,"_21099":121608,"_5":14424,"_27663":121095,"_2970":121609},[],"Para que el flujo JITP funcione correctamente:",{"_3487":72151,"_30445":71938,"_21099":121611,"_5":14424,"_27663":121095,"_2970":121612},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3487":72152,"_30445":71938,"_21099":121614,"_5":14424,"_27663":121095,"_2970":121615},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3487":72153,"_30445":71938,"_21099":121617,"_5":14424,"_27663":121095,"_2970":121618},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3487":72154,"_30445":71938,"_21099":121620,"_5":14424,"_27663":121095,"_2970":121621},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3487":72155,"_30445":71938,"_21099":121623,"_5":14424,"_27663":121099,"_2970":121624},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3487":72156,"_30445":71938,"_21099":121626,"_5":14424,"_27663":121099,"_2970":121627},[],"Estado en Lamassu",{"_3487":72157,"_30445":71938,"_21099":121629,"_5":14424,"_27663":121099,"_2970":121630},[],"Razón de revocación",{"_3487":72158,"_30445":71938,"_21099":121632,"_5":14424,"_27663":121099,"_2970":121633},[],"Estado en AWS IoT Core",{"_3487":72159,"_30445":71938,"_21099":121635,"_5":14424,"_27663":121099,"_2970":54297},[],{"_3487":72160,"_30445":71938,"_21099":121637,"_5":14424,"_27663":121099,"_2970":121638},[],"Ninguna",{"_3487":72161,"_30445":71938,"_21099":121640,"_5":14424,"_27663":121099,"_2970":54303},[],{"_3487":72162,"_30445":71938,"_21099":121642,"_5":14424,"_27663":121099,"_2970":54306},[],{"_3487":72163,"_30445":71938,"_21099":121644,"_5":14424,"_27663":121099,"_2970":54309},[],{"_3487":72164,"_30445":71938,"_21099":121646,"_5":14424,"_27663":121099,"_2970":54312},[],{"_3487":72165,"_30445":71938,"_21099":121648,"_5":14424,"_27663":121099,"_2970":54306},[],{"_3487":72166,"_30445":71938,"_21099":121650,"_5":14424,"_27663":121099,"_2970":121651},[],"Cualquier otra razón",{"_3487":72167,"_30445":71938,"_21099":121653,"_5":14424,"_27663":121099,"_2970":54320},[],{"_3487":72168,"_30445":71938,"_21099":121655,"_5":14424,"_27663":121099,"_2970":121656},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3487":72169,"_30445":71938,"_21099":121658,"_5":14424,"_27663":121103,"_2970":121659},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3487":72170,"_30445":71938,"_21099":121661,"_5":14424,"_27663":121103,"_2970":121445},[],{"_3487":72171,"_30445":71938,"_21099":121663,"_5":14424,"_27663":121103,"_2970":121448},[],{"_3487":72172,"_30445":71938,"_21099":121665,"_5":14424,"_27663":121103,"_2970":121666},[],"`NoSincronizado` → `Active`",{"_3487":72173,"_30445":71938,"_21099":121668,"_5":14424,"_27663":121103,"_2970":53812},[],{"_3487":72174,"_30445":71938,"_21099":121670,"_5":14424,"_27663":121103,"_2970":54338},[],{"_3487":72175,"_30445":71938,"_21099":121672,"_5":14424,"_27663":121103,"_2970":121673},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3487":72176,"_30445":71938,"_21099":121675,"_5":14424,"_27663":121103,"_2970":54344},[],{"_3487":72177,"_30445":71938,"_21099":121677,"_5":14424,"_27663":121103,"_2970":121673},[],{"_3487":72178,"_30445":71938,"_21099":121679,"_5":14424,"_27663":121103,"_2970":54349},[],{"_3487":72179,"_30445":71938,"_21099":121681,"_5":14424,"_27663":121103,"_2970":53812},[],{"_3487":72180,"_30445":71938,"_21099":121683,"_5":14424,"_27663":121103,"_2970":54354},[],{"_3487":72181,"_30445":71938,"_21099":121685,"_5":14424,"_27663":121103,"_2970":121686},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3487":72182,"_30445":71938,"_21099":121688,"_5":14424,"_27663":121107,"_2970":121689},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3487":72183,"_30445":71938,"_21099":121691,"_5":14424,"_27663":121107,"_2970":121692},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3487":72184,"_30445":71938,"_21099":121694,"_5":14424,"_27663":121107,"_2970":121695},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3487":72185,"_30445":71938,"_21099":121697,"_5":14424,"_27663":121111,"_2970":121698},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3487":72186,"_30445":71938,"_21099":121700,"_5":14424,"_27663":121111,"_2970":121701},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3487":72187,"_30445":71938,"_21099":121703,"_5":14424,"_27663":121115,"_2970":121704},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3487":72188,"_30445":71938,"_21099":121706,"_5":14424,"_27663":121115,"_2970":121707},[],"Existen dos tipos de acciones:",{"_3487":72189,"_30445":71938,"_21099":121709,"_5":14424,"_27663":121115,"_2970":121710},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3487":72190,"_30445":71938,"_21099":121712,"_5":14424,"_27663":121115,"_2970":121713},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3487":72191,"_30445":71938,"_21099":121715,"_5":14424,"_27663":121115,"_2970":121716},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3487":72192,"_30445":71938,"_21099":121718,"_5":14424,"_27663":121119,"_2970":121719},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3487":72193,"_30445":71938,"_21099":121721,"_5":14424,"_27663":121119,"_2970":121722},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3487":72194,"_30445":71938,"_21099":121724,"_5":14424,"_27663":121119,"_2970":121725},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3487":72195,"_30445":71938,"_21099":121727,"_5":14424,"_27663":121123,"_2970":121728},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3487":72196,"_30445":71938,"_21099":121730,"_5":14424,"_27663":121123,"_2970":121731},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3487":72197,"_30445":71938,"_21099":121733,"_5":14424,"_27663":121123,"_2970":121734},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3487":72198,"_30445":71938,"_21099":121736,"_5":14424,"_27663":121123,"_2970":121737},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3487":72199,"_30445":71938,"_21099":121739,"_5":14424,"_27663":121123,"_2970":121740},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3487":72200,"_30445":71938,"_21099":121742,"_5":14424,"_27663":121123,"_2970":121743},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3487":72201,"_30445":71938,"_21099":121745,"_5":14424,"_27663":121123,"_2970":121746},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3487":72202,"_30445":71938,"_21099":121748,"_5":14424,"_27663":121123,"_2970":121749},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3487":72203,"_30445":71938,"_21099":121751,"_5":14424,"_27663":121123,"_2970":121752},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3487":72204,"_30445":71938,"_21099":121754,"_5":14424,"_27663":121123,"_2970":121755},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3487":72205,"_30445":71938,"_21099":121757,"_5":14424,"_27663":121123,"_2970":121758},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3487":72206,"_30445":71938,"_21099":121760,"_5":14424,"_27663":121123,"_2970":121761},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3487":72207,"_30445":71938,"_21099":121763,"_5":14424,"_27663":121123,"_2970":121764},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3487":72208,"_30445":71938,"_21099":121766,"_5":14424,"_27663":121123,"_2970":121767},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3487":72209,"_30445":71938,"_21099":121769,"_5":14424,"_27663":121123,"_2970":121770},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3487":72210,"_30445":71938,"_21099":121772,"_5":14424,"_27663":121123,"_2970":121773},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3487":72211,"_30445":71938,"_21099":121775,"_5":14424,"_27663":121123,"_2970":121776},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3487":72212,"_30445":71938,"_21099":121778,"_5":14424,"_27663":121123,"_2970":121779},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3487":72213,"_30445":71938,"_21099":121781,"_5":14424,"_27663":121123,"_2970":121782},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3487":72214,"_30445":71938,"_21099":121784,"_5":14424,"_27663":121123,"_2970":121785},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3487":72215,"_30445":71938,"_21099":121787,"_5":14424,"_27663":121123,"_2970":121788},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3487":72216,"_30445":71938,"_21099":121790,"_5":14424,"_27663":121123,"_2970":121791},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3487":72217,"_30445":71938,"_21099":121793,"_5":14424,"_27663":121123,"_2970":121794},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3487":72218,"_30445":71938,"_21099":121796,"_5":14424,"_27663":121123,"_2970":121797},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3487":72219,"_30445":72219,"_5":14788,"_2970":52175,"_30797":121799,"_21099":121800,"_27663":72219},[49622,118603,52175],[],{"_3487":72220,"_30445":72219,"_21099":121802,"_5":14424,"_27663":72219,"_2970":121803},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3487":72221,"_30445":72219,"_5":30794,"_21099":121805,"_27663":121806,"_2970":121807},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3487":72222,"_30445":72219,"_5":30794,"_21099":121809,"_27663":121810,"_2970":119615},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3487":72223,"_30445":72219,"_5":30794,"_21099":121812,"_27663":121813,"_2970":119790},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3487":72224,"_30445":72219,"_5":30794,"_21099":121815,"_27663":121816,"_2970":121022},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/overview#integraciones",{"_3487":72225,"_30445":72219,"_5":30794,"_21099":121818,"_27663":121819,"_2970":121820},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3487":72226,"_30445":72219,"_21099":121822,"_5":14424,"_27663":72219,"_2970":121823},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3487":72227,"_30445":72219,"_21099":121825,"_5":14424,"_27663":121806,"_2970":121826},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3487":72228,"_30445":72219,"_21099":121828,"_5":14424,"_27663":121806,"_2970":121829},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3487":72229,"_30445":72219,"_21099":121831,"_5":14424,"_27663":121810,"_2970":121832},[],"Recurso",{"_3487":72230,"_30445":72219,"_21099":121834,"_5":14424,"_27663":121810,"_2970":121835},[],"Qué representa",{"_3487":72231,"_30445":72219,"_21099":121837,"_5":14424,"_27663":121810,"_2970":121838},[],"**Dispositivo**",{"_3487":72232,"_30445":72219,"_21099":121840,"_5":14424,"_27663":121810,"_2970":121841},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3487":72233,"_30445":72219,"_21099":121843,"_5":14424,"_27663":121810,"_2970":121844},[],"**Identidad**",{"_3487":72234,"_30445":72219,"_21099":121846,"_5":14424,"_27663":121810,"_2970":121847},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3487":72235,"_30445":72219,"_21099":121849,"_5":14424,"_27663":121810,"_2970":54521},[],{"_3487":72236,"_30445":72219,"_21099":121851,"_5":14424,"_27663":121810,"_2970":121852},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3487":72237,"_30445":72219,"_21099":121854,"_5":14424,"_27663":121810,"_2970":121855},[],"**Flota**",{"_3487":72238,"_30445":72219,"_21099":121857,"_5":14424,"_27663":121810,"_2970":121858},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3487":72239,"_30445":72219,"_21099":121860,"_5":14424,"_27663":121810,"_2970":121861},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3487":72240,"_30445":72219,"_21099":121863,"_5":14424,"_27663":121810,"_2970":121864},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3487":72241,"_30445":72219,"_21099":121866,"_5":14424,"_27663":121813,"_2970":121867},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3487":72242,"_30445":72219,"_21099":121869,"_5":14424,"_27663":121813,"_2970":121870},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3487":72243,"_30445":72219,"_21099":121872,"_5":14424,"_27663":121813,"_2970":121873},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3487":72244,"_30445":72219,"_21099":121875,"_5":14424,"_27663":121813,"_2970":121876},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3487":72245,"_30445":72219,"_21099":121878,"_5":14424,"_27663":121813,"_2970":121879},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3487":72246,"_30445":72219,"_21099":121881,"_5":14424,"_27663":121813,"_2970":121882},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3487":72247,"_30445":72219,"_21099":121884,"_5":14424,"_27663":121813,"_2970":121885},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3487":72248,"_30445":72219,"_21099":121887,"_5":14424,"_27663":121813,"_2970":121888},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3487":72249,"_30445":72219,"_21099":121890,"_5":14424,"_27663":121816,"_2970":121891},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3487":72250,"_30445":72219,"_21099":121893,"_5":14424,"_27663":121816,"_2970":121894},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3487":72251,"_30445":72219,"_21099":121896,"_5":14424,"_27663":121819,"_2970":121897},[],"Participante",{"_3487":72252,"_30445":72219,"_21099":121899,"_5":14424,"_27663":121819,"_2970":121900},[],"Responsabilidad",{"_3487":72253,"_30445":72219,"_21099":121902,"_5":14424,"_27663":121819,"_2970":121903},[],"Administrador PKI",{"_3487":72254,"_30445":72219,"_21099":121905,"_5":14424,"_27663":121819,"_2970":121906},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3487":72255,"_30445":72219,"_21099":121908,"_5":14424,"_27663":121819,"_2970":121909},[],"Administrador del aprovisionamiento",{"_3487":72256,"_30445":72219,"_21099":121911,"_5":14424,"_27663":121819,"_2970":121912},[],"DMS, admisión, autenticación por operación e inventario.",{"_3487":72257,"_30445":72219,"_21099":121914,"_5":14424,"_27663":121819,"_2970":121915},[],"Integrador del dispositivo",{"_3487":72258,"_30445":72219,"_21099":121917,"_5":14424,"_27663":121819,"_2970":121918},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3487":72259,"_30445":72219,"_21099":121920,"_5":14424,"_27663":121819,"_2970":121921},[],"Integrador del consumidor",{"_3487":72260,"_30445":72219,"_21099":121923,"_5":14424,"_27663":121819,"_2970":121924},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3487":72261,"_30445":72219,"_21099":121926,"_5":14424,"_27663":121819,"_2970":121927},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3487":72262,"_30445":72262,"_5":14788,"_2970":121929,"_30797":121930,"_21099":121932,"_27663":72262},"Enrola y conecta tu primer dispositivo",[49622,118603,52175,121931],"Primeros pasos",[],{"_3487":72263,"_30445":72262,"_21099":121934,"_5":14424,"_27663":72262,"_2970":121935},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3487":72264,"_30445":72262,"_5":30794,"_21099":121937,"_27663":121938,"_2970":117116},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3487":72265,"_30445":72262,"_5":30794,"_21099":121940,"_27663":121941,"_2970":121942},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3487":72266,"_30445":72262,"_5":30794,"_21099":121944,"_27663":121945,"_2970":121946},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3487":72267,"_30445":72262,"_5":30794,"_21099":121948,"_27663":121949,"_2970":121950},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3487":72268,"_30445":72262,"_5":30794,"_21099":121952,"_27663":121953,"_2970":121954},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3487":72269,"_30445":72262,"_5":30794,"_21099":121956,"_27663":121957,"_2970":121958},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3487":72270,"_30445":72262,"_5":30794,"_21099":121960,"_27663":121961,"_2970":121962},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3487":72271,"_30445":72262,"_5":30794,"_21099":121964,"_27663":121965,"_2970":121966},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3487":72272,"_30445":72262,"_21099":121968,"_5":14424,"_27663":72262,"_2970":121969},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3487":72273,"_30445":72262,"_21099":121971,"_5":14424,"_27663":121938,"_2970":121972},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3487":72274,"_30445":72262,"_21099":121974,"_5":14424,"_27663":121938,"_2970":121975},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3487":72275,"_30445":72262,"_21099":121977,"_5":14424,"_27663":121938,"_2970":121978},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3487":72276,"_30445":72262,"_21099":121980,"_5":14424,"_27663":121938,"_2970":121981},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3487":72277,"_30445":72262,"_21099":121983,"_5":14424,"_27663":121938,"_2970":121984},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3487":72278,"_30445":72262,"_21099":121986,"_5":14424,"_27663":121941,"_2970":121987},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3487":72279,"_30445":72262,"_21099":121989,"_5":14424,"_27663":121941,"_2970":121990},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3487":72280,"_30445":72262,"_21099":121992,"_5":14424,"_27663":121945,"_2970":121993},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3487":72281,"_30445":72262,"_21099":121995,"_5":14424,"_27663":121945,"_2970":121996},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3487":72282,"_30445":72262,"_21099":121998,"_5":14424,"_27663":121945,"_2970":121999},[],"Ajuste",{"_3487":72283,"_30445":72262,"_21099":122001,"_5":14424,"_27663":121945,"_2970":122002},[],"Valor de evaluación",{"_3487":72284,"_30445":72262,"_21099":122004,"_5":14424,"_27663":121945,"_2970":54677},[],{"_3487":72285,"_30445":72262,"_21099":122006,"_5":14424,"_27663":121945,"_2970":122007},[],"Raíz emisora de `device-root.pem`.",{"_3487":72286,"_30445":72262,"_21099":122009,"_5":14424,"_27663":121945,"_2970":119918},[],{"_3487":72287,"_30445":72262,"_21099":122011,"_5":14424,"_27663":121945,"_2970":122012},[],"Perfil final de 1 hora que acabas de preparar.",{"_3487":72288,"_30445":72262,"_21099":122014,"_5":14424,"_27663":121945,"_2970":54688},[],{"_3487":72289,"_30445":72262,"_21099":122016,"_5":14424,"_27663":121945,"_2970":54691},[],{"_3487":72290,"_30445":72262,"_21099":122018,"_5":14424,"_27663":121945,"_2970":54694},[],{"_3487":72291,"_30445":72262,"_21099":122020,"_5":14424,"_27663":121945,"_2970":122021},[],"Habilitado.",{"_3487":72292,"_30445":72262,"_21099":122023,"_5":14424,"_27663":121945,"_2970":54700},[],{"_3487":72293,"_30445":72262,"_21099":122025,"_5":14424,"_27663":121945,"_2970":122026},[],"Deshabilitado; el ID debe ser nuevo.",{"_3487":72294,"_30445":72262,"_21099":122028,"_5":14424,"_27663":121945,"_2970":122029},[],"Autenticación inicial",{"_3487":72295,"_30445":72262,"_21099":122031,"_5":14424,"_27663":121945,"_2970":122032},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3487":72296,"_30445":72262,"_21099":122034,"_5":14424,"_27663":121945,"_2970":122035},[],"Autenticación de renovación",{"_3487":72297,"_30445":72262,"_21099":122037,"_5":14424,"_27663":121945,"_2970":122038},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3487":72298,"_30445":72262,"_21099":122040,"_5":14424,"_27663":121945,"_2970":54718},[],{"_3487":72299,"_30445":72262,"_21099":122042,"_5":14424,"_27663":121945,"_2970":122043},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3487":72300,"_30445":72262,"_21099":122045,"_5":14424,"_27663":121945,"_2970":54724},[],{"_3487":72301,"_30445":72262,"_21099":122047,"_5":14424,"_27663":121945,"_2970":122048},[],"1 hora.",{"_3487":72302,"_30445":72262,"_21099":122050,"_5":14424,"_27663":121945,"_2970":54730},[],{"_3487":72303,"_30445":72262,"_21099":122052,"_5":14424,"_27663":121945,"_2970":122053},[],"30 minutos / 10 minutos.",{"_3487":72304,"_30445":72262,"_21099":122055,"_5":14424,"_27663":121945,"_2970":54736},[],{"_3487":72305,"_30445":72262,"_21099":122057,"_5":14424,"_27663":121945,"_2970":122058},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3487":72306,"_30445":72262,"_21099":122060,"_5":14424,"_27663":121945,"_2970":52494},[],{"_3487":72307,"_30445":72262,"_21099":122062,"_5":14424,"_27663":121945,"_2970":122063},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3487":72308,"_30445":72262,"_21099":122065,"_5":14424,"_27663":121945,"_2970":54747},[],{"_3487":72309,"_30445":72262,"_21099":122067,"_5":14424,"_27663":121945,"_2970":122068},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3487":72310,"_30445":72262,"_21099":122070,"_5":14424,"_27663":121945,"_2970":122071},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3487":72311,"_30445":72262,"_21099":122073,"_5":14424,"_27663":121949,"_2970":122074},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3487":72312,"_30445":72262,"_21099":122076,"_5":14424,"_27663":121949,"_2970":122077},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3487":72313,"_30445":72262,"_21099":122079,"_5":14424,"_27663":121953,"_2970":122080},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3487":72314,"_30445":72262,"_21099":122082,"_5":14424,"_27663":121953,"_2970":122083},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3487":72315,"_30445":72262,"_21099":122085,"_5":14424,"_27663":121953,"_2970":122086},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3487":72316,"_30445":72262,"_21099":122088,"_5":14424,"_27663":121957,"_2970":122089},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3487":72317,"_30445":72262,"_21099":122091,"_5":14424,"_27663":121957,"_2970":122092},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3487":72318,"_30445":72262,"_21099":122094,"_5":14424,"_27663":121961,"_2970":122095},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3487":72319,"_30445":72262,"_21099":122097,"_5":14424,"_27663":121961,"_2970":122098},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3487":72320,"_30445":72262,"_21099":122100,"_5":14424,"_27663":121961,"_2970":122101},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3487":72321,"_30445":72262,"_21099":122103,"_5":14424,"_27663":121961,"_2970":122104},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3487":72322,"_30445":72262,"_21099":122106,"_5":14424,"_27663":121961,"_2970":122107},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3487":72323,"_30445":72262,"_21099":122109,"_5":14424,"_27663":121965,"_2970":122110},[],"Comprobación",{"_3487":72324,"_30445":72262,"_21099":122112,"_5":14424,"_27663":121965,"_2970":122113},[],"Resultado esperado",{"_3487":72325,"_30445":72262,"_21099":122115,"_5":14424,"_27663":121965,"_2970":122116},[],"Registro",{"_3487":72326,"_30445":72262,"_21099":122118,"_5":14424,"_27663":121965,"_2970":122119},[],"ID creado automáticamente y DMS correcto.",{"_3487":72327,"_30445":72262,"_21099":122121,"_5":14424,"_27663":121965,"_2970":121406},[],{"_3487":72328,"_30445":72262,"_21099":122123,"_5":14424,"_27663":121965,"_2970":122124},[],"CN, perfil, serie y clave verificados.",{"_3487":72329,"_30445":72262,"_21099":122126,"_5":14424,"_27663":121965,"_2970":122127},[],"Inventario",{"_3487":72330,"_30445":72262,"_21099":122129,"_5":14424,"_27663":121965,"_2970":122130},[],"Serie recibida visible como identidad actual y en el historial.",{"_3487":72331,"_30445":72262,"_21099":122132,"_5":14424,"_27663":121965,"_2970":122133},[],"Consumidor",{"_3487":72332,"_30445":72262,"_21099":122135,"_5":14424,"_27663":121965,"_2970":122136},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3487":72333,"_30445":72262,"_21099":122138,"_5":14424,"_27663":121965,"_2970":122139},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3487":72334,"_30445":72262,"_21099":122141,"_5":14424,"_27663":121965,"_2970":122142},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3487":72335,"_30445":72335,"_5":14788,"_2970":119632,"_30797":122144,"_21099":122145,"_27663":72335},[49622,118603,52175,121931],[],{"_3487":72336,"_30445":72335,"_21099":122147,"_5":14424,"_27663":72335,"_2970":122148},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3487":72337,"_30445":72335,"_5":30794,"_21099":122150,"_27663":122151,"_2970":117116},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3487":72338,"_30445":72335,"_5":30794,"_21099":122153,"_27663":122154,"_2970":122155},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3487":72339,"_30445":72335,"_5":30794,"_21099":122157,"_27663":122158,"_2970":122159},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3487":72340,"_30445":72335,"_5":30794,"_21099":122161,"_27663":122162,"_2970":122163},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3487":72341,"_30445":72335,"_5":30794,"_21099":122165,"_27663":122166,"_2970":122167},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3487":72342,"_30445":72335,"_5":30794,"_21099":122169,"_27663":122170,"_2970":122171},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3487":72343,"_30445":72335,"_5":30794,"_21099":122173,"_27663":122174,"_2970":122113},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3487":72344,"_30445":72335,"_5":30794,"_21099":122176,"_27663":122177,"_2970":122178},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3487":72345,"_30445":72335,"_5":30794,"_21099":122180,"_27663":122181,"_2970":122182},[],"/docs/pr-preview/pr-68/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3487":72346,"_30445":72335,"_21099":122184,"_5":14424,"_27663":72335,"_2970":122185},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3487":72347,"_30445":72335,"_21099":122187,"_5":14424,"_27663":72335,"_2970":122188},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3487":72348,"_30445":72335,"_21099":122190,"_5":14424,"_27663":122151,"_2970":122191},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3487":72349,"_30445":72335,"_21099":122193,"_5":14424,"_27663":122151,"_2970":122194},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3487":72350,"_30445":72335,"_21099":122196,"_5":14424,"_27663":122151,"_2970":122197},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3487":72351,"_30445":72335,"_21099":122199,"_5":14424,"_27663":122151,"_2970":122200},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3487":72352,"_30445":72335,"_21099":122202,"_5":14424,"_27663":122154,"_2970":122203},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3487":72353,"_30445":72335,"_21099":122205,"_5":14424,"_27663":122154,"_2970":122206},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3487":72354,"_30445":72335,"_21099":122208,"_5":14424,"_27663":122154,"_2970":122209},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3487":72355,"_30445":72335,"_21099":122211,"_5":14424,"_27663":122154,"_2970":122212},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3487":72356,"_30445":72335,"_21099":122214,"_5":14424,"_27663":122154,"_2970":122215},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3487":72357,"_30445":72335,"_21099":122217,"_5":14424,"_27663":122154,"_2970":122218},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3487":72358,"_30445":72335,"_21099":122220,"_5":14424,"_27663":122154,"_2970":122221},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3487":72359,"_30445":72335,"_21099":122223,"_5":14424,"_27663":122154,"_2970":122224},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3487":72360,"_30445":72335,"_21099":122226,"_5":14424,"_27663":122158,"_2970":122227},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3487":72361,"_30445":72335,"_21099":122229,"_5":14424,"_27663":122158,"_2970":54912},[],{"_3487":72362,"_30445":72335,"_21099":122231,"_5":14424,"_27663":122158,"_2970":122232},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3487":72363,"_30445":72335,"_21099":122234,"_5":14424,"_27663":122158,"_2970":122235},[],"**Icon** y **Tags**: clasificación opcional.",{"_3487":72364,"_30445":72335,"_21099":122237,"_5":14424,"_27663":122158,"_2970":122238},[],"Confirma el registro.",{"_3487":72365,"_30445":72335,"_21099":122240,"_5":14424,"_27663":122162,"_2970":122241},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3487":72366,"_30445":72335,"_21099":122243,"_5":14424,"_27663":122162,"_2970":122244},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3487":72367,"_30445":72335,"_21099":122246,"_5":14424,"_27663":122166,"_2970":122247},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3487":72368,"_30445":72335,"_21099":122249,"_5":14424,"_27663":122166,"_2970":122250},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3487":72369,"_30445":72335,"_21099":122252,"_5":14424,"_27663":122170,"_2970":122253},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3487":72370,"_30445":72335,"_21099":122255,"_5":14424,"_27663":122170,"_2970":122256},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3487":72371,"_30445":72335,"_21099":122258,"_5":14424,"_27663":122174,"_2970":122110},[],{"_3487":72372,"_30445":72335,"_21099":122260,"_5":14424,"_27663":122174,"_2970":122261},[],"Resultado",{"_3487":72373,"_30445":72335,"_21099":122263,"_5":14424,"_27663":122174,"_2970":121392},[],{"_3487":72374,"_30445":72335,"_21099":122265,"_5":14424,"_27663":122174,"_2970":122266},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3487":72375,"_30445":72335,"_21099":122268,"_5":14424,"_27663":122174,"_2970":122269},[],"Identidad actual",{"_3487":72376,"_30445":72335,"_21099":122271,"_5":14424,"_27663":122174,"_2970":122272},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3487":72377,"_30445":72335,"_21099":122274,"_5":14424,"_27663":122174,"_2970":122275},[],"Historial",{"_3487":72378,"_30445":72335,"_21099":122277,"_5":14424,"_27663":122174,"_2970":122278},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3487":72379,"_30445":72335,"_21099":122280,"_5":14424,"_27663":122174,"_2970":122281},[],"Clave y certificado",{"_3487":72380,"_30445":72335,"_21099":122283,"_5":14424,"_27663":122174,"_2970":122284},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3487":72381,"_30445":72335,"_21099":122286,"_5":14424,"_27663":122177,"_2970":122287},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3487":72382,"_30445":72335,"_21099":122289,"_5":14424,"_27663":122177,"_2970":122290},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3487":72383,"_30445":72335,"_21099":122292,"_5":14424,"_27663":122177,"_2970":122293},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3487":72384,"_30445":72335,"_21099":122295,"_5":14424,"_27663":122177,"_2970":122296},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3487":72385,"_30445":72335,"_21099":122298,"_5":14424,"_27663":122181,"_2970":122299},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3487":72386,"_30445":72335,"_21099":122301,"_5":14424,"_27663":122181,"_2970":122302},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3487":72387,"_30445":72335,"_21099":122304,"_5":14424,"_27663":122181,"_2970":122305},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3487":72388,"_30445":72388,"_5":14788,"_2970":122307,"_30797":122308,"_21099":122309,"_27663":72388},"Plataforma Lamassu IoT",[49622,118603],[],{"_3487":72389,"_30445":72388,"_21099":122311,"_5":14424,"_27663":72388,"_2970":122312},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3487":72390,"_30445":72388,"_5":30794,"_21099":122314,"_27663":122315,"_2970":121807},[],"/docs/pr-preview/pr-68/es/platform/overview#empieza-aquí",{"_3487":72391,"_30445":72388,"_5":30794,"_21099":122317,"_27663":122318,"_2970":122319},[],"/docs/pr-preview/pr-68/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3487":72392,"_30445":72388,"_5":30794,"_21099":122321,"_27663":122322,"_2970":122323},[],"/docs/pr-preview/pr-68/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3487":72393,"_30445":72388,"_5":30794,"_21099":122325,"_27663":122326,"_2970":122327},[],"/docs/pr-preview/pr-68/es/platform/overview#capacidades-principales","Capacidades principales",{"_3487":72394,"_30445":72388,"_5":30794,"_21099":122329,"_27663":122330,"_2970":122331},[],"/docs/pr-preview/pr-68/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3487":72395,"_30445":72388,"_5":30794,"_21099":122333,"_27663":122334,"_2970":122335},[],"/docs/pr-preview/pr-68/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3487":72396,"_30445":72388,"_5":30794,"_21099":122337,"_27663":122338,"_2970":122339},[],"/docs/pr-preview/pr-68/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3487":72397,"_30445":72388,"_5":30794,"_21099":122341,"_27663":122342,"_2970":122343},[],"/docs/pr-preview/pr-68/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3487":72398,"_30445":72388,"_5":30794,"_21099":122345,"_27663":122346,"_2970":122347},[],"/docs/pr-preview/pr-68/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3487":72399,"_30445":72388,"_5":30794,"_21099":122349,"_27663":122350,"_2970":122351},[],"/docs/pr-preview/pr-68/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3487":72400,"_30445":72388,"_5":30794,"_21099":122353,"_27663":122354,"_2970":122355},[],"/docs/pr-preview/pr-68/es/platform/overview#referencia-operativa","Referencia operativa",{"_3487":72401,"_30445":72388,"_21099":122357,"_5":14424,"_27663":72388,"_2970":122358},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3487":72402,"_30445":72388,"_21099":122360,"_5":14424,"_27663":122315,"_2970":122361},[],"Elige el resultado que necesitas obtener:",{"_3487":72403,"_30445":72388,"_21099":122363,"_5":14424,"_27663":122315,"_2970":122364},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3487":72404,"_30445":72388,"_21099":122366,"_5":14424,"_27663":122315,"_2970":122367},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3487":72405,"_30445":72388,"_21099":122369,"_5":14424,"_27663":122315,"_2970":122370},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3487":72406,"_30445":72388,"_21099":122372,"_5":14424,"_27663":122318,"_2970":122373},[],"Bloque",{"_3487":72407,"_30445":72388,"_21099":122375,"_5":14424,"_27663":122318,"_2970":122376},[],"Qué gestionas",{"_3487":72408,"_30445":72388,"_21099":122378,"_5":14424,"_27663":122318,"_2970":122379},[],"Punto de entrada",{"_3487":72409,"_30445":72388,"_21099":122381,"_5":14424,"_27663":122318,"_2970":55065},[],{"_3487":72410,"_30445":72388,"_21099":122383,"_5":14424,"_27663":122318,"_2970":122384},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3487":72411,"_30445":72388,"_21099":122386,"_5":14424,"_27663":122318,"_2970":122387},[],"Visión general de PKI",{"_3487":72412,"_30445":72388,"_21099":122389,"_5":14424,"_27663":122318,"_2970":55074},[],{"_3487":72413,"_30445":72388,"_21099":122391,"_5":14424,"_27663":122318,"_2970":122392},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3487":72414,"_30445":72388,"_21099":122394,"_5":14424,"_27663":122318,"_2970":122395},[],"Visión general de IoT Fleets",{"_3487":72415,"_30445":72388,"_21099":122397,"_5":14424,"_27663":122318,"_2970":122398},[],"**Administración**",{"_3487":72416,"_30445":72388,"_21099":122400,"_5":14424,"_27663":122318,"_2970":122401},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3487":72417,"_30445":72388,"_21099":122403,"_5":14424,"_27663":122318,"_2970":118601},[],{"_3487":72418,"_30445":72388,"_21099":122405,"_5":14424,"_27663":122318,"_2970":122406},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3487":72419,"_30445":72388,"_21099":122408,"_5":14424,"_27663":122322,"_2970":122409},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3487":72420,"_30445":72388,"_21099":122411,"_5":14424,"_27663":122322,"_2970":122412},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3487":72421,"_30445":72388,"_21099":122414,"_5":14424,"_27663":122322,"_2970":122415},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3487":72422,"_30445":72388,"_21099":122417,"_5":14424,"_27663":122322,"_2970":122418},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3487":72423,"_30445":72388,"_21099":122420,"_5":14424,"_27663":122322,"_2970":122421},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3487":72424,"_30445":72388,"_21099":122423,"_5":14424,"_27663":122322,"_2970":122424},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3487":72425,"_30445":72388,"_21099":122426,"_5":14424,"_27663":122330,"_2970":122427},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3487":72426,"_30445":72388,"_21099":122429,"_5":14424,"_27663":122334,"_2970":122430},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3487":72427,"_30445":72388,"_21099":122432,"_5":14424,"_27663":122338,"_2970":122433},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3487":72428,"_30445":72388,"_21099":122435,"_5":14424,"_27663":122342,"_2970":122436},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3487":72429,"_30445":72388,"_21099":122438,"_5":14424,"_27663":122346,"_2970":122439},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3487":72430,"_30445":72388,"_21099":122441,"_5":14424,"_27663":122350,"_2970":122442},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3487":72431,"_30445":72388,"_21099":122444,"_5":14424,"_27663":122354,"_2970":121900},[],{"_3487":72432,"_30445":72388,"_21099":122446,"_5":14424,"_27663":122354,"_2970":122447},[],"Qué prepara o comprueba",{"_3487":72433,"_30445":72388,"_21099":122449,"_5":14424,"_27663":122354,"_2970":121903},[],{"_3487":72434,"_30445":72388,"_21099":122451,"_5":14424,"_27663":122354,"_2970":122452},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3487":72435,"_30445":72388,"_21099":122454,"_5":14424,"_27663":122354,"_2970":122455},[],"Administrador de la flota",{"_3487":72436,"_30445":72388,"_21099":122457,"_5":14424,"_27663":122354,"_2970":122458},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3487":72437,"_30445":72388,"_21099":122460,"_5":14424,"_27663":122354,"_2970":121915},[],{"_3487":72438,"_30445":72388,"_21099":122462,"_5":14424,"_27663":122354,"_2970":122463},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3487":72439,"_30445":72388,"_21099":122465,"_5":14424,"_27663":122354,"_2970":121921},[],{"_3487":72440,"_30445":72388,"_21099":122467,"_5":14424,"_27663":122354,"_2970":122468},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3487":72441,"_30445":72388,"_21099":122470,"_5":14424,"_27663":122354,"_2970":122471},[],"Operador de infraestructura",{"_3487":72442,"_30445":72388,"_21099":122473,"_5":14424,"_27663":122354,"_2970":122474},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3487":72443,"_30445":72388,"_21099":122476,"_5":14424,"_27663":122354,"_2970":122477},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3487":72444,"_30445":72444,"_5":14788,"_2970":122479,"_30797":122480,"_21099":122482,"_27663":72444},"Jerarquía y rotación de CAs",[49622,118603,55166,122481],"Claves, autoridades y certificados",[],{"_3487":72445,"_30445":72444,"_21099":122484,"_5":14424,"_27663":72444,"_2970":122485},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3487":72446,"_30445":72444,"_5":30794,"_21099":122487,"_27663":122488,"_2970":122489},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3487":72447,"_30445":72444,"_5":30794,"_21099":122491,"_27663":122492,"_2970":122493},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3487":72448,"_30445":72444,"_5":30794,"_21099":122495,"_27663":122496,"_2970":122497},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3487":72449,"_30445":72444,"_5":30794,"_21099":122499,"_27663":122500,"_2970":122501},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3487":72450,"_30445":72444,"_5":30794,"_21099":122503,"_27663":122504,"_2970":122505},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3487":72451,"_30445":72444,"_5":30794,"_21099":122507,"_27663":122508,"_2970":122509},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3487":72452,"_30445":72444,"_5":30794,"_21099":122511,"_27663":122512,"_2970":122513},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3487":72453,"_30445":72444,"_5":30794,"_21099":122515,"_27663":122516,"_2970":122517},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3487":72454,"_30445":72444,"_5":30794,"_21099":122519,"_27663":122520,"_2970":122521},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3487":72455,"_30445":72444,"_5":30794,"_21099":122523,"_27663":122524,"_2970":122525},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3487":72456,"_30445":72444,"_5":30794,"_21099":122527,"_27663":122528,"_2970":122529},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3487":72457,"_30445":72444,"_5":30794,"_21099":122531,"_27663":122532,"_2970":122533},[],"/docs/pr-preview/pr-68/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3487":72458,"_30445":72444,"_21099":122535,"_5":14424,"_27663":72444,"_2970":122536},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3487":72459,"_30445":72444,"_21099":122538,"_5":14424,"_27663":72444,"_2970":122539},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3487":72460,"_30445":72444,"_21099":122541,"_5":14424,"_27663":122488,"_2970":122542},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3487":72461,"_30445":72444,"_21099":122544,"_5":14424,"_27663":122488,"_2970":122545},[],"entorno, como producción y preproducción;",{"_3487":72462,"_30445":72444,"_21099":122547,"_5":14424,"_27663":122488,"_2970":122548},[],"propietario o equipo operador;",{"_3487":72463,"_30445":72444,"_21099":122550,"_5":14424,"_27663":122488,"_2970":122551},[],"familia de dispositivos o proceso de fabricación;",{"_3487":72464,"_30445":72444,"_21099":122553,"_5":14424,"_27663":122488,"_2970":122554},[],"región o requisito regulatorio;",{"_3487":72465,"_30445":72444,"_21099":122556,"_5":14424,"_27663":122488,"_2970":122557},[],"motor criptográfico o política de clave;",{"_3487":72466,"_30445":72444,"_21099":122559,"_5":14424,"_27663":122488,"_2970":122560},[],"ventana de mantenimiento y ritmo de renovación.",{"_3487":72467,"_30445":72444,"_21099":122562,"_5":14424,"_27663":122488,"_2970":122563},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3487":72468,"_30445":72444,"_21099":122565,"_5":14424,"_27663":122488,"_2970":122566},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3487":72469,"_30445":72444,"_21099":122568,"_5":14424,"_27663":122492,"_2970":122569},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3487":72470,"_30445":72444,"_21099":122571,"_5":14424,"_27663":122492,"_2970":122572},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3487":72471,"_30445":72444,"_21099":122574,"_5":14424,"_27663":122492,"_2970":122575},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3487":72472,"_30445":72444,"_21099":122577,"_5":14424,"_27663":122492,"_2970":122578},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3487":72473,"_30445":72444,"_21099":122580,"_5":14424,"_27663":122496,"_2970":122581},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3487":72474,"_30445":72444,"_21099":122583,"_5":14424,"_27663":122496,"_2970":122584},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3487":72475,"_30445":72444,"_21099":122586,"_5":14424,"_27663":122496,"_2970":122587},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3487":72476,"_30445":72444,"_21099":122589,"_5":14424,"_27663":122496,"_2970":122590},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3487":72477,"_30445":72444,"_21099":122592,"_5":14424,"_27663":122504,"_2970":122593},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3487":72478,"_30445":72444,"_21099":122595,"_5":14424,"_27663":122508,"_2970":122596},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3487":72479,"_30445":72444,"_21099":122598,"_5":14424,"_27663":122512,"_2970":122599},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3487":72480,"_30445":72444,"_21099":122601,"_5":14424,"_27663":122516,"_2970":122602},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3487":72481,"_30445":72444,"_21099":122604,"_5":14424,"_27663":122520,"_2970":122605},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3487":72482,"_30445":72444,"_21099":122607,"_5":14424,"_27663":122524,"_2970":122608},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3487":72483,"_30445":72444,"_21099":122610,"_5":14424,"_27663":122528,"_2970":122611},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3487":72484,"_30445":72444,"_21099":122613,"_5":14424,"_27663":122528,"_2970":122614},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3487":72485,"_30445":72444,"_21099":122616,"_5":14424,"_27663":122528,"_2970":122617},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3487":72486,"_30445":72444,"_21099":122619,"_5":14424,"_27663":122528,"_2970":122620},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3487":72487,"_30445":72444,"_21099":122622,"_5":14424,"_27663":122532,"_2970":122623},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3487":72488,"_30445":72444,"_21099":122625,"_5":14424,"_27663":122532,"_2970":122626},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3487":72489,"_30445":72444,"_21099":122628,"_5":14424,"_27663":122532,"_2970":122629},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3487":72490,"_30445":72444,"_21099":122631,"_5":14424,"_27663":122532,"_2970":122632},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3487":72491,"_30445":72444,"_21099":122634,"_5":14424,"_27663":122532,"_2970":122635},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3487":72492,"_30445":72444,"_21099":122637,"_5":14424,"_27663":122532,"_2970":122638},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3487":72493,"_30445":72444,"_21099":122640,"_5":14424,"_27663":122532,"_2970":122641},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3487":72494,"_30445":72494,"_5":14788,"_2970":122643,"_30797":122644,"_21099":122645,"_27663":72494},"Autoridades de certificación",[49622,118603,55166,122481],[],{"_3487":72495,"_30445":72494,"_21099":122647,"_5":14424,"_27663":72494,"_2970":122648},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3487":72496,"_30445":72494,"_5":30794,"_21099":122650,"_27663":122651,"_2970":122652},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3487":72497,"_30445":72494,"_5":30794,"_21099":122654,"_27663":122655,"_2970":122656},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3487":72498,"_30445":72494,"_5":30794,"_21099":122658,"_27663":122659,"_2970":117116},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3487":72499,"_30445":72494,"_5":30794,"_21099":122661,"_27663":122662,"_2970":122663},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3487":72500,"_30445":72494,"_5":30794,"_21099":122665,"_27663":122666,"_2970":122667},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3487":72501,"_30445":72494,"_5":30794,"_21099":122669,"_27663":122670,"_2970":122671},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3487":72502,"_30445":72494,"_5":30794,"_21099":122673,"_27663":122674,"_2970":122675},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3487":72503,"_30445":72494,"_5":30794,"_21099":122677,"_27663":122678,"_2970":122679},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3487":72504,"_30445":72494,"_5":30794,"_21099":122681,"_27663":122682,"_2970":122683},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3487":72505,"_30445":72494,"_5":30794,"_21099":122685,"_27663":122686,"_2970":122687},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3487":72506,"_30445":72494,"_5":30794,"_21099":122689,"_27663":122690,"_2970":122691},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3487":72507,"_30445":72494,"_5":30794,"_21099":122693,"_27663":122694,"_2970":122695},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3487":72508,"_30445":72494,"_5":30794,"_21099":122697,"_27663":122698,"_2970":122699},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3487":72509,"_30445":72494,"_5":30794,"_21099":122701,"_27663":122702,"_2970":122703},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3487":72510,"_30445":72494,"_5":30794,"_21099":122705,"_27663":122706,"_2970":122707},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3487":72511,"_30445":72494,"_5":30794,"_21099":122709,"_27663":122710,"_2970":122711},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3487":72512,"_30445":72494,"_5":30794,"_21099":122713,"_27663":122714,"_2970":122715},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3487":72513,"_30445":72494,"_5":30794,"_21099":122717,"_27663":122718,"_2970":122719},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3487":72514,"_30445":72494,"_5":30794,"_21099":122721,"_27663":122722,"_2970":122723},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3487":72515,"_30445":72494,"_5":30794,"_21099":122725,"_27663":122726,"_2970":122727},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3487":72516,"_30445":72494,"_5":30794,"_21099":122729,"_27663":122730,"_2970":122731},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3487":72517,"_30445":72494,"_5":30794,"_21099":122733,"_27663":122734,"_2970":122735},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3487":72518,"_30445":72494,"_5":30794,"_21099":122737,"_27663":122738,"_2970":122739},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3487":72519,"_30445":72494,"_21099":122741,"_5":14424,"_27663":72494,"_2970":122742},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3487":72520,"_30445":72494,"_21099":122744,"_5":14424,"_27663":72494,"_2970":122745},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3487":72521,"_30445":72494,"_21099":122747,"_5":14424,"_27663":72494,"_2970":122748},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3487":72522,"_30445":72494,"_21099":122750,"_5":14424,"_27663":122651,"_2970":122751},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3487":72523,"_30445":72494,"_21099":122753,"_5":14424,"_27663":122651,"_2970":122754},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3487":72524,"_30445":72494,"_21099":122756,"_5":14424,"_27663":122651,"_2970":122757},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3487":72525,"_30445":72494,"_21099":122759,"_5":14424,"_27663":122651,"_2970":122760},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3487":72526,"_30445":72494,"_21099":122762,"_5":14424,"_27663":122651,"_2970":122763},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3487":72527,"_30445":72494,"_21099":122765,"_5":14424,"_27663":122659,"_2970":122766},[],"Decide si la CA será raíz o intermedia.",{"_3487":72528,"_30445":72494,"_21099":122768,"_5":14424,"_27663":122659,"_2970":122769},[],"Elige el motor que custodiará la clave.",{"_3487":72529,"_30445":72494,"_21099":122771,"_5":14424,"_27663":122659,"_2970":122772},[],"Define una validez superior a la de los certificados que emitirá.",{"_3487":72530,"_30445":72494,"_21099":122774,"_5":14424,"_27663":122659,"_2970":122775},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3487":72531,"_30445":72494,"_21099":122777,"_5":14424,"_27663":122662,"_2970":122778},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3487":72532,"_30445":72494,"_21099":122780,"_5":14424,"_27663":122666,"_2970":122781},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3487":72533,"_30445":72494,"_21099":122783,"_5":14424,"_27663":122666,"_2970":122784},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3487":72534,"_30445":72494,"_21099":122786,"_5":14424,"_27663":122670,"_2970":122787},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3487":72535,"_30445":72494,"_21099":122789,"_5":14424,"_27663":122674,"_2970":122790},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3487":72536,"_30445":72494,"_21099":122792,"_5":14424,"_27663":122674,"_2970":122793},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3487":72537,"_30445":72494,"_21099":122795,"_5":14424,"_27663":122674,"_2970":122796},[],"`ST`: estado o provincia.",{"_3487":72538,"_30445":72494,"_21099":122798,"_5":14424,"_27663":122674,"_2970":122799},[],"`L`: localidad.",{"_3487":72539,"_30445":72494,"_21099":122801,"_5":14424,"_27663":122674,"_2970":122802},[],"`O`: organización.",{"_3487":72540,"_30445":72494,"_21099":122804,"_5":14424,"_27663":122674,"_2970":122805},[],"`OU`: unidad organizativa.",{"_3487":72541,"_30445":72494,"_21099":122807,"_5":14424,"_27663":122674,"_2970":122808},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3487":72542,"_30445":72494,"_21099":122810,"_5":14424,"_27663":122678,"_2970":122811},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3487":72543,"_30445":72494,"_21099":122813,"_5":14424,"_27663":122678,"_2970":122814},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3487":72544,"_30445":72494,"_21099":122816,"_5":14424,"_27663":122682,"_2970":122817},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3487":72545,"_30445":72494,"_21099":122819,"_5":14424,"_27663":122682,"_2970":122820},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3487":72546,"_30445":72494,"_21099":122822,"_5":14424,"_27663":122686,"_2970":122823},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3487":72547,"_30445":72494,"_21099":122825,"_5":14424,"_27663":122686,"_2970":122826},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3487":72548,"_30445":72494,"_21099":122828,"_5":14424,"_27663":122690,"_2970":122829},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3487":72549,"_30445":72494,"_21099":122831,"_5":14424,"_27663":122690,"_2970":122832},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3487":72550,"_30445":72494,"_21099":122834,"_5":14424,"_27663":122690,"_2970":122835},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3487":72551,"_30445":72494,"_21099":122837,"_5":14424,"_27663":122694,"_2970":122838},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3487":72552,"_30445":72494,"_21099":122840,"_5":14424,"_27663":122698,"_2970":122841},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3487":72553,"_30445":72494,"_21099":122843,"_5":14424,"_27663":122698,"_2970":122844},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3487":72554,"_30445":72494,"_21099":122846,"_5":14424,"_27663":122702,"_2970":122847},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3487":72555,"_30445":72494,"_21099":122849,"_5":14424,"_27663":122706,"_2970":122850},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3487":72556,"_30445":72494,"_21099":122852,"_5":14424,"_27663":122706,"_2970":122853},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3487":72557,"_30445":72494,"_21099":122855,"_5":14424,"_27663":122710,"_2970":122856},[],"Abre una CA desde el inventario para consultar:",{"_3487":72558,"_30445":72494,"_21099":122858,"_5":14424,"_27663":122710,"_2970":122859},[],"Estado y periodo de validez.",{"_3487":72559,"_30445":72494,"_21099":122861,"_5":14424,"_27663":122710,"_2970":122862},[],"Certificado y cadena en formato PEM.",{"_3487":72560,"_30445":72494,"_21099":122864,"_5":14424,"_27663":122710,"_2970":122865},[],"Número de certificados activos, expirados y revocados.",{"_3487":72561,"_30445":72494,"_21099":122867,"_5":14424,"_27663":122710,"_2970":122868},[],"Certificados emitidos en **Issued Certificates**.",{"_3487":72562,"_30445":72494,"_21099":122870,"_5":14424,"_27663":122710,"_2970":122871},[],"CRL vinculada a la autoridad.",{"_3487":72563,"_30445":72494,"_21099":122873,"_5":14424,"_27663":122710,"_2970":122874},[],"Metadatos y motor criptográfico asociado.",{"_3487":72564,"_30445":72494,"_21099":122876,"_5":14424,"_27663":122710,"_2970":122877},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3487":72565,"_30445":72494,"_21099":122879,"_5":14424,"_27663":122714,"_2970":122880},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3487":72566,"_30445":72494,"_21099":122882,"_5":14424,"_27663":122714,"_2970":122883},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3487":72567,"_30445":72494,"_21099":122885,"_5":14424,"_27663":122714,"_2970":122886},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3487":72568,"_30445":72494,"_21099":122888,"_5":14424,"_27663":122714,"_2970":122889},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3487":72569,"_30445":72494,"_21099":122891,"_5":14424,"_27663":122718,"_2970":122892},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3487":72570,"_30445":72494,"_21099":122894,"_5":14424,"_27663":122722,"_2970":122895},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3487":72571,"_30445":72494,"_21099":122897,"_5":14424,"_27663":122726,"_2970":122898},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3487":72572,"_30445":72494,"_21099":122900,"_5":14424,"_27663":122730,"_2970":122901},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3487":72573,"_30445":72494,"_21099":122903,"_5":14424,"_27663":122734,"_2970":122904},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3487":72574,"_30445":72494,"_21099":122906,"_5":14424,"_27663":122738,"_2970":122907},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3487":72575,"_30445":72494,"_21099":122909,"_5":14424,"_27663":122738,"_2970":122910},[],"Los ajustes de CRL de la CA se conservan como `ARCHIVED`. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante. Los ajustes archivados pueden borrarse con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Al borrarlos, la CRL deja de servirse y la acción no puede deshacerse; consulta la advertencia en CRL. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3487":72576,"_30445":72494,"_21099":122912,"_5":14424,"_27663":122738,"_2970":122913},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se borren esos ajustes, su última CRL sigue sirviéndose en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; los ajustes archivados dejan de poder editarse (consulta CRL).",{"_3487":72577,"_30445":72577,"_5":14788,"_2970":122915,"_30797":122916,"_21099":122917,"_27663":72577},"Perfiles de certificado",[49622,118603,55166,122481],[],{"_3487":72578,"_30445":72577,"_21099":122919,"_5":14424,"_27663":72577,"_2970":122920},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3487":72579,"_30445":72577,"_5":30794,"_21099":122922,"_27663":122923,"_2970":122924},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3487":72580,"_30445":72577,"_5":30794,"_21099":122926,"_27663":122927,"_2970":122928},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#validez","Validez",{"_3487":72581,"_30445":72577,"_5":30794,"_21099":122930,"_27663":122931,"_2970":122932},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3487":72582,"_30445":72577,"_5":30794,"_21099":122934,"_27663":122935,"_2970":122936},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3487":72583,"_30445":72577,"_5":30794,"_21099":122938,"_27663":122939,"_2970":122940},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3487":72584,"_30445":72577,"_5":30794,"_21099":122942,"_27663":122943,"_2970":122944},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3487":72585,"_30445":72577,"_5":30794,"_21099":122946,"_27663":122947,"_2970":122948},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3487":72586,"_30445":72577,"_5":30794,"_21099":122950,"_27663":122951,"_2970":122952},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3487":72587,"_30445":72577,"_5":30794,"_21099":122954,"_27663":122955,"_2970":122956},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3487":72588,"_30445":72577,"_5":30794,"_21099":122958,"_27663":122959,"_2970":122960},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3487":72589,"_30445":72577,"_5":30794,"_21099":122962,"_27663":122963,"_2970":122964},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3487":72590,"_30445":72577,"_5":30794,"_21099":122966,"_27663":122967,"_2970":122968},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3487":72591,"_30445":72577,"_5":30794,"_21099":122970,"_27663":122971,"_2970":122972},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3487":72592,"_30445":72577,"_5":30794,"_21099":122974,"_27663":122975,"_2970":122976},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3487":72593,"_30445":72577,"_5":30794,"_21099":122978,"_27663":122979,"_2970":122980},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3487":72594,"_30445":72577,"_5":30794,"_21099":122982,"_27663":122983,"_2970":122984},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3487":72595,"_30445":72577,"_21099":122986,"_5":14424,"_27663":72577,"_2970":122987},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3487":72596,"_30445":72577,"_21099":122989,"_5":14424,"_27663":72577,"_2970":122990},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3487":72597,"_30445":72577,"_21099":122992,"_5":14424,"_27663":122927,"_2970":122993},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3487":72598,"_30445":72577,"_21099":122995,"_5":14424,"_27663":122927,"_2970":122996},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3487":72599,"_30445":72577,"_21099":122998,"_5":14424,"_27663":122931,"_2970":122999},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3487":72600,"_30445":72577,"_21099":123001,"_5":14424,"_27663":122935,"_2970":123002},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3487":72601,"_30445":72577,"_21099":123004,"_5":14424,"_27663":122935,"_2970":123005},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3487":72602,"_30445":72577,"_21099":123007,"_5":14424,"_27663":122935,"_2970":123008},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3487":72603,"_30445":72577,"_21099":123010,"_5":14424,"_27663":122939,"_2970":123011},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3487":72604,"_30445":72577,"_21099":123013,"_5":14424,"_27663":122943,"_2970":123014},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3487":72605,"_30445":72577,"_21099":123016,"_5":14424,"_27663":122943,"_2970":123017},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3487":72606,"_30445":72577,"_21099":123019,"_5":14424,"_27663":122947,"_2970":123020},[],"La aplicación criptográfica puede:",{"_3487":72607,"_30445":72577,"_21099":123022,"_5":14424,"_27663":122947,"_2970":123023},[],"permitir o bloquear claves RSA;",{"_3487":72608,"_30445":72577,"_21099":123025,"_5":14424,"_27663":122947,"_2970":123026},[],"limitar los tamaños RSA admitidos;",{"_3487":72609,"_30445":72577,"_21099":123028,"_5":14424,"_27663":122947,"_2970":123029},[],"permitir o bloquear claves ECDSA;",{"_3487":72610,"_30445":72577,"_21099":123031,"_5":14424,"_27663":122947,"_2970":123032},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3487":72611,"_30445":72577,"_21099":123034,"_5":14424,"_27663":122947,"_2970":123035},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3487":72612,"_30445":72577,"_21099":123037,"_5":14424,"_27663":122951,"_2970":123038},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3487":72613,"_30445":72577,"_21099":123040,"_5":14424,"_27663":122951,"_2970":118354},[],{"_3487":72614,"_30445":72577,"_21099":123042,"_5":14424,"_27663":122951,"_2970":123043},[],"Primera opción",{"_3487":72615,"_30445":72577,"_21099":123045,"_5":14424,"_27663":122951,"_2970":123046},[],"Segunda opción",{"_3487":72616,"_30445":72577,"_21099":123048,"_5":14424,"_27663":122951,"_2970":123049},[],"Si no hay ninguna",{"_3487":72617,"_30445":72577,"_21099":123051,"_5":14424,"_27663":122951,"_2970":123052},[],"Firma directa con una CA",{"_3487":72618,"_30445":72577,"_21099":123054,"_5":14424,"_27663":122951,"_2970":123055},[],"`issuance_profile` incluido en la solicitud",{"_3487":72619,"_30445":72577,"_21099":123057,"_5":14424,"_27663":122951,"_2970":123058},[],"`issuance_profile_id` de la solicitud",{"_3487":72620,"_30445":72577,"_21099":123060,"_5":14424,"_27663":122951,"_2970":123061},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3487":72621,"_30445":72577,"_21099":123063,"_5":14424,"_27663":122951,"_2970":123064},[],"Emisión mediante DMS",{"_3487":72622,"_30445":72577,"_21099":123066,"_5":14424,"_27663":122951,"_2970":55753},[],{"_3487":72623,"_30445":72577,"_21099":123068,"_5":14424,"_27663":122951,"_2970":123069},[],"`settings.issuance_profile` incluido en el DMS",{"_3487":72624,"_30445":72577,"_21099":123071,"_5":14424,"_27663":122951,"_2970":123072},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3487":72625,"_30445":72577,"_21099":123074,"_5":14424,"_27663":122951,"_2970":123075},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3487":72626,"_30445":72577,"_21099":123077,"_5":14424,"_27663":122951,"_2970":123078},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3487":72627,"_30445":72577,"_21099":123080,"_5":14424,"_27663":122959,"_2970":123081},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3487":72628,"_30445":72577,"_21099":123083,"_5":14424,"_27663":122963,"_2970":123084},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3487":72629,"_30445":72577,"_21099":123086,"_5":14424,"_27663":122967,"_2970":123087},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3487":72630,"_30445":72577,"_21099":123089,"_5":14424,"_27663":122971,"_2970":123090},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3487":72631,"_30445":72577,"_21099":123092,"_5":14424,"_27663":122975,"_2970":123093},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3487":72632,"_30445":72577,"_21099":123095,"_5":14424,"_27663":122975,"_2970":123096},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3487":72633,"_30445":72577,"_21099":123098,"_5":14424,"_27663":122979,"_2970":123099},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3487":72634,"_30445":72577,"_21099":123101,"_5":14424,"_27663":122979,"_2970":123102},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3487":72635,"_30445":72577,"_21099":123104,"_5":14424,"_27663":122979,"_2970":123105},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3487":72636,"_30445":72577,"_21099":123107,"_5":14424,"_27663":122979,"_2970":123108},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3487":72637,"_30445":72577,"_21099":123110,"_5":14424,"_27663":122983,"_2970":123111},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3487":72638,"_30445":72577,"_21099":123113,"_5":14424,"_27663":122983,"_2970":123114},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3487":72639,"_30445":72639,"_5":14788,"_2970":123116,"_30797":123117,"_21099":123119,"_27663":72639},"Validación de certificados",[49622,118603,55166,123118],"Validación",[],{"_3487":72640,"_30445":72639,"_21099":123121,"_5":14424,"_27663":72639,"_2970":123122},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3487":72641,"_30445":72639,"_5":30794,"_21099":123124,"_27663":123125,"_2970":123126},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3487":72642,"_30445":72639,"_5":30794,"_21099":123128,"_27663":123129,"_2970":123130},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3487":72643,"_30445":72639,"_5":30794,"_21099":123132,"_27663":123133,"_2970":123134},[],"/docs/pr-preview/pr-68/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3487":72644,"_30445":72639,"_21099":123136,"_5":14424,"_27663":72639,"_2970":123137},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3487":72645,"_30445":72639,"_21099":123139,"_5":14424,"_27663":123125,"_2970":123140},[],"Verifica estos criterios juntos:",{"_3487":72646,"_30445":72639,"_21099":123142,"_5":14424,"_27663":123125,"_2970":122110},[],{"_3487":72647,"_30445":72639,"_21099":123144,"_5":14424,"_27663":123125,"_2970":123145},[],"Resultado necesario",{"_3487":72648,"_30445":72639,"_21099":123147,"_5":14424,"_27663":123125,"_2970":123148},[],"Cadena y firma",{"_3487":72649,"_30445":72639,"_21099":123150,"_5":14424,"_27663":123125,"_2970":123151},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3487":72650,"_30445":72639,"_21099":123153,"_5":14424,"_27663":123125,"_2970":123154},[],"Fechas",{"_3487":72651,"_30445":72639,"_21099":123156,"_5":14424,"_27663":123125,"_2970":123157},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3487":72652,"_30445":72639,"_21099":123159,"_5":14424,"_27663":123125,"_2970":118264},[],{"_3487":72653,"_30445":72639,"_21099":123161,"_5":14424,"_27663":123125,"_2970":123162},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3487":72654,"_30445":72639,"_21099":123164,"_5":14424,"_27663":123125,"_2970":123165},[],"Uso",{"_3487":72655,"_30445":72639,"_21099":123167,"_5":14424,"_27663":123125,"_2970":123168},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3487":72656,"_30445":72639,"_21099":123170,"_5":14424,"_27663":123125,"_2970":123171},[],"Revocación",{"_3487":72657,"_30445":72639,"_21099":123173,"_5":14424,"_27663":123125,"_2970":123174},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3487":72658,"_30445":72639,"_21099":123176,"_5":14424,"_27663":123125,"_2970":123177},[],"Autorización",{"_3487":72659,"_30445":72639,"_21099":123179,"_5":14424,"_27663":123125,"_2970":123180},[],"La aplicación permite la acción a esa identidad.",{"_3487":72660,"_30445":72639,"_21099":123182,"_5":14424,"_27663":123125,"_2970":123183},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3487":72661,"_30445":72639,"_21099":123185,"_5":14424,"_27663":123129,"_2970":123186},[],"Mecanismo",{"_3487":72662,"_30445":72639,"_21099":123188,"_5":14424,"_27663":123129,"_2970":123189},[],"Cuándo utilizarlo",{"_3487":72663,"_30445":72639,"_21099":123191,"_5":14424,"_27663":123129,"_2970":123192},[],"Qué debes mantener",{"_3487":72664,"_30445":72639,"_21099":123194,"_5":14424,"_27663":123129,"_2970":55881},[],{"_3487":72665,"_30445":72639,"_21099":123196,"_5":14424,"_27663":123129,"_2970":123197},[],"Consulta del estado de un certificado concreto.",{"_3487":72666,"_30445":72639,"_21099":123199,"_5":14424,"_27663":123129,"_2970":123200},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3487":72667,"_30445":72639,"_21099":123202,"_5":14424,"_27663":123129,"_2970":55890},[],{"_3487":72668,"_30445":72639,"_21099":123204,"_5":14424,"_27663":123129,"_2970":123205},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3487":72669,"_30445":72639,"_21099":123207,"_5":14424,"_27663":123129,"_2970":123208},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3487":72670,"_30445":72639,"_21099":123210,"_5":14424,"_27663":123129,"_2970":123211},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3487":72671,"_30445":72639,"_21099":123213,"_5":14424,"_27663":123129,"_2970":123214},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3487":72672,"_30445":72639,"_21099":123216,"_5":14424,"_27663":123133,"_2970":123217},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3487":72673,"_30445":72639,"_21099":123219,"_5":14424,"_27663":123133,"_2970":123220},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3487":72674,"_30445":72639,"_21099":123222,"_5":14424,"_27663":123133,"_2970":123223},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3487":72675,"_30445":72639,"_21099":123225,"_5":14424,"_27663":123133,"_2970":123226},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3487":72676,"_30445":72639,"_21099":123228,"_5":14424,"_27663":123133,"_2970":123229},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3487":72677,"_30445":72639,"_21099":123231,"_5":14424,"_27663":123133,"_2970":123232},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3487":72678,"_30445":72639,"_21099":123234,"_5":14424,"_27663":123133,"_2970":123235},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3487":72679,"_30445":72639,"_21099":123237,"_5":14424,"_27663":123133,"_2970":123238},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3487":72680,"_30445":72639,"_21099":123240,"_5":14424,"_27663":123133,"_2970":123241},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3487":72681,"_30445":72681,"_5":14788,"_2970":123243,"_30797":123244,"_21099":123245,"_27663":72681},"Certificados",[49622,118603,55166,122481],[],{"_3487":72682,"_30445":72681,"_21099":123247,"_5":14424,"_27663":72681,"_2970":123248},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3487":72683,"_30445":72681,"_5":30794,"_21099":123250,"_27663":123251,"_2970":123252},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3487":72684,"_30445":72681,"_5":30794,"_21099":123254,"_27663":123255,"_2970":123256},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3487":72685,"_30445":72681,"_5":30794,"_21099":123258,"_27663":123259,"_2970":123260},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3487":72686,"_30445":72681,"_5":30794,"_21099":123262,"_27663":123263,"_2970":123264},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3487":72687,"_30445":72681,"_5":30794,"_21099":123266,"_27663":123267,"_2970":123268},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3487":72688,"_30445":72681,"_5":30794,"_21099":123270,"_27663":123271,"_2970":123272},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3487":72689,"_30445":72681,"_5":30794,"_21099":123274,"_27663":123275,"_2970":123276},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3487":72690,"_30445":72681,"_5":30794,"_21099":123278,"_27663":123279,"_2970":123280},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3487":72691,"_30445":72681,"_5":30794,"_21099":123282,"_27663":123283,"_2970":123284},[],"/docs/pr-preview/pr-68/es/platform/pki/certificates#continúa","Continúa",{"_3487":72692,"_30445":72681,"_21099":123286,"_5":14424,"_27663":72681,"_2970":123287},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3487":72693,"_30445":72681,"_21099":123289,"_5":14424,"_27663":123251,"_2970":123290},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3487":72694,"_30445":72681,"_21099":123292,"_5":14424,"_27663":123251,"_2970":123293},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3487":72695,"_30445":72681,"_21099":123295,"_5":14424,"_27663":123251,"_2970":123296},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3487":72696,"_30445":72681,"_21099":123298,"_5":14424,"_27663":123251,"_2970":123299},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3487":72697,"_30445":72681,"_21099":123301,"_5":14424,"_27663":123251,"_2970":123302},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3487":72698,"_30445":72681,"_21099":123304,"_5":14424,"_27663":123251,"_2970":123305},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3487":72699,"_30445":72681,"_21099":123307,"_5":14424,"_27663":123251,"_2970":123308},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3487":72700,"_30445":72681,"_21099":123310,"_5":14424,"_27663":123255,"_2970":123311},[],"Descarga el PEM e inspecciónalo:",{"_3487":72701,"_30445":72681,"_21099":123313,"_5":14424,"_27663":123255,"_2970":123314},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3487":72702,"_30445":72681,"_21099":123316,"_5":14424,"_27663":123259,"_2970":123317},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3487":72703,"_30445":72681,"_21099":123319,"_5":14424,"_27663":123259,"_2970":123320},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3487":72704,"_30445":72681,"_21099":123322,"_5":14424,"_27663":123259,"_2970":123323},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3487":72705,"_30445":72681,"_21099":123325,"_5":14424,"_27663":123259,"_2970":123326},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3487":72706,"_30445":72681,"_21099":123328,"_5":14424,"_27663":123259,"_2970":123329},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3487":72707,"_30445":72681,"_21099":123331,"_5":14424,"_27663":123259,"_2970":123332},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3487":72708,"_30445":72681,"_21099":123334,"_5":14424,"_27663":123259,"_2970":123335},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3487":72709,"_30445":72681,"_21099":123337,"_5":14424,"_27663":123263,"_2970":123338},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3487":72710,"_30445":72681,"_21099":123340,"_5":14424,"_27663":123267,"_2970":123341},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3487":72711,"_30445":72681,"_21099":123343,"_5":14424,"_27663":123271,"_2970":123344},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3487":72712,"_30445":72681,"_21099":123346,"_5":14424,"_27663":123275,"_2970":123347},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3487":72713,"_30445":72681,"_21099":123349,"_5":14424,"_27663":123275,"_2970":123350},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3487":72714,"_30445":72681,"_21099":123352,"_5":14424,"_27663":123275,"_2970":123353},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3487":72715,"_30445":72681,"_21099":123355,"_5":14424,"_27663":123279,"_2970":123356},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3487":72716,"_30445":72681,"_21099":123358,"_5":14424,"_27663":123279,"_2970":123359},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3487":72717,"_30445":72681,"_21099":123361,"_5":14424,"_27663":123279,"_2970":123362},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3487":72718,"_30445":72681,"_21099":123364,"_5":14424,"_27663":123283,"_2970":123365},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3487":72719,"_30445":72681,"_21099":123367,"_5":14424,"_27663":123283,"_2970":123368},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3487":72720,"_30445":72720,"_5":14788,"_2970":123370,"_30797":123371,"_21099":123373,"_27663":72720},"Ciclo de vida de un certificado",[49622,118603,55166,123372],"Conceptos",[],{"_3487":72721,"_30445":72720,"_21099":123375,"_5":14424,"_27663":72720,"_2970":123376},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3487":72722,"_30445":72720,"_5":30794,"_21099":123378,"_27663":123379,"_2970":123380},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3487":72723,"_30445":72720,"_5":30794,"_21099":123382,"_27663":123383,"_2970":123384},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3487":72724,"_30445":72720,"_5":30794,"_21099":123386,"_27663":123387,"_2970":123388},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3487":72725,"_30445":72720,"_5":30794,"_21099":123390,"_27663":123391,"_2970":123392},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3487":72726,"_30445":72720,"_5":30794,"_21099":123394,"_27663":123395,"_2970":123396},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3487":72727,"_30445":72720,"_5":30794,"_21099":123398,"_27663":123399,"_2970":123400},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3487":72728,"_30445":72720,"_5":30794,"_21099":123402,"_27663":123403,"_2970":121104},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3487":72729,"_30445":72720,"_5":30794,"_21099":123405,"_27663":123406,"_2970":123407},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3487":72730,"_30445":72720,"_5":30794,"_21099":123409,"_27663":123410,"_2970":123411},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3487":72731,"_30445":72720,"_5":30794,"_21099":123413,"_27663":123414,"_2970":123415},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3487":72732,"_30445":72720,"_21099":123417,"_5":14424,"_27663":72720,"_2970":123418},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3487":72733,"_30445":72720,"_21099":123420,"_5":14424,"_27663":123383,"_2970":123421},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3487":72734,"_30445":72720,"_21099":123423,"_5":14424,"_27663":123387,"_2970":123424},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3487":72735,"_30445":72720,"_21099":123426,"_5":14424,"_27663":123391,"_2970":123427},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3487":72736,"_30445":72720,"_21099":123429,"_5":14424,"_27663":123395,"_2970":123430},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3487":72737,"_30445":72720,"_21099":123432,"_5":14424,"_27663":123399,"_2970":123433},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3487":72738,"_30445":72720,"_21099":123435,"_5":14424,"_27663":123403,"_2970":123436},[],"Lamassu persiste cuatro estados X.509:",{"_3487":72739,"_30445":72720,"_21099":123438,"_5":14424,"_27663":123403,"_2970":123439},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3487":72740,"_30445":72720,"_21099":123441,"_5":14424,"_27663":123403,"_2970":123442},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3487":72741,"_30445":72720,"_21099":123444,"_5":14424,"_27663":123403,"_2970":123445},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3487":72742,"_30445":72720,"_21099":123447,"_5":14424,"_27663":123403,"_2970":123448},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3487":72743,"_30445":72720,"_21099":123450,"_5":14424,"_27663":123403,"_2970":123451},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3487":72744,"_30445":72720,"_21099":123453,"_5":14424,"_27663":123406,"_2970":123454},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3487":72745,"_30445":72720,"_21099":123456,"_5":14424,"_27663":123406,"_2970":123457},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3487":72746,"_30445":72720,"_21099":123459,"_5":14424,"_27663":123406,"_2970":123460},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3487":72747,"_30445":72720,"_21099":123462,"_5":14424,"_27663":123410,"_2970":123463},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3487":72748,"_30445":72720,"_21099":123465,"_5":14424,"_27663":123410,"_2970":123466},[],"Antes de confirmar:",{"_3487":72749,"_30445":72720,"_21099":123468,"_5":14424,"_27663":123410,"_2970":123469},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3487":72750,"_30445":72720,"_21099":123471,"_5":14424,"_27663":123410,"_2970":123472},[],"Distribuye la nueva cadena de confianza.",{"_3487":72751,"_30445":72720,"_21099":123474,"_5":14424,"_27663":123410,"_2970":123475},[],"Reemite las identidades necesarias.",{"_3487":72752,"_30445":72720,"_21099":123477,"_5":14424,"_27663":123410,"_2970":123478},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3487":72753,"_30445":72720,"_21099":123480,"_5":14424,"_27663":123410,"_2970":123481},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3487":72754,"_30445":72720,"_21099":123483,"_5":14424,"_27663":123410,"_2970":123484},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3487":72755,"_30445":72720,"_21099":123486,"_5":14424,"_27663":123414,"_2970":123487},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3487":72756,"_30445":72720,"_21099":123489,"_5":14424,"_27663":123414,"_2970":123490},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3487":72757,"_30445":72720,"_21099":123492,"_5":14424,"_27663":123414,"_2970":123493},[],"Cambios de estado y razones de revocación.",{"_3487":72758,"_30445":72720,"_21099":123495,"_5":14424,"_27663":123414,"_2970":123496},[],"Publicación y vigencia de OCSP y CRLs.",{"_3487":72759,"_30445":72720,"_21099":123498,"_5":14424,"_27663":123414,"_2970":123499},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3487":72760,"_30445":72720,"_21099":123501,"_5":14424,"_27663":123414,"_2970":123502},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3487":72761,"_30445":72761,"_5":14788,"_2970":123504,"_30797":123505,"_21099":123506,"_27663":72761},"Modelo de confianza",[49622,118603,55166,123372],[],{"_3487":72762,"_30445":72761,"_21099":123508,"_5":14424,"_27663":72761,"_2970":123509},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3487":72763,"_30445":72761,"_5":30794,"_21099":123511,"_27663":123512,"_2970":123513},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3487":72764,"_30445":72761,"_5":30794,"_21099":123515,"_27663":123516,"_2970":123517},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3487":72765,"_30445":72761,"_5":30794,"_21099":123519,"_27663":123520,"_2970":123521},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3487":72766,"_30445":72761,"_5":30794,"_21099":123523,"_27663":123524,"_2970":123525},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3487":72767,"_30445":72761,"_5":30794,"_21099":123527,"_27663":123528,"_2970":123529},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3487":72768,"_30445":72761,"_5":30794,"_21099":123531,"_27663":123532,"_2970":123533},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3487":72769,"_30445":72761,"_5":30794,"_21099":123535,"_27663":123536,"_2970":123537},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3487":72770,"_30445":72761,"_5":30794,"_21099":123539,"_27663":123540,"_2970":123541},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3487":72771,"_30445":72761,"_5":30794,"_21099":123543,"_27663":123544,"_2970":123545},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3487":72772,"_30445":72761,"_5":30794,"_21099":123547,"_27663":123548,"_2970":123549},[],"/docs/pr-preview/pr-68/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3487":72773,"_30445":72761,"_21099":123551,"_5":14424,"_27663":72761,"_2970":123552},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3487":72774,"_30445":72761,"_21099":123554,"_5":14424,"_27663":123516,"_2970":123555},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3487":72775,"_30445":72761,"_21099":123557,"_5":14424,"_27663":123520,"_2970":123558},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3487":72776,"_30445":72761,"_21099":123560,"_5":14424,"_27663":123524,"_2970":123561},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3487":72777,"_30445":72761,"_21099":123563,"_5":14424,"_27663":123528,"_2970":123564},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3487":72778,"_30445":72761,"_21099":123566,"_5":14424,"_27663":123532,"_2970":123567},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3487":72779,"_30445":72761,"_21099":123569,"_5":14424,"_27663":123532,"_2970":123570},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3487":72780,"_30445":72761,"_21099":123572,"_5":14424,"_27663":123532,"_2970":123573},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3487":72781,"_30445":72761,"_21099":123575,"_5":14424,"_27663":123532,"_2970":123576},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3487":72782,"_30445":72761,"_21099":123578,"_5":14424,"_27663":123532,"_2970":123579},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3487":72783,"_30445":72761,"_21099":123581,"_5":14424,"_27663":123532,"_2970":123582},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3487":72784,"_30445":72761,"_21099":123584,"_5":14424,"_27663":123536,"_2970":123585},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3487":72785,"_30445":72761,"_21099":123587,"_5":14424,"_27663":123536,"_2970":123588},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3487":72786,"_30445":72761,"_21099":123590,"_5":14424,"_27663":123536,"_2970":123591},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3487":72787,"_30445":72761,"_21099":123593,"_5":14424,"_27663":123536,"_2970":123594},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3487":72788,"_30445":72761,"_21099":123596,"_5":14424,"_27663":123536,"_2970":123597},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3487":72789,"_30445":72761,"_21099":123599,"_5":14424,"_27663":123540,"_2970":123600},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3487":72790,"_30445":72761,"_21099":123602,"_5":14424,"_27663":123540,"_2970":123603},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3487":72791,"_30445":72761,"_21099":123605,"_5":14424,"_27663":123540,"_2970":123606},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3487":72792,"_30445":72761,"_21099":123608,"_5":14424,"_27663":123540,"_2970":123609},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3487":72793,"_30445":72761,"_21099":123611,"_5":14424,"_27663":123540,"_2970":123612},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3487":72794,"_30445":72761,"_21099":123614,"_5":14424,"_27663":123540,"_2970":123615},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3487":72795,"_30445":72761,"_21099":123617,"_5":14424,"_27663":123540,"_2970":123618},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3487":72796,"_30445":72761,"_21099":123620,"_5":14424,"_27663":123544,"_2970":123621},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3487":72797,"_30445":72761,"_21099":123623,"_5":14424,"_27663":123548,"_2970":123624},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3487":72798,"_30445":72761,"_21099":123626,"_5":14424,"_27663":123548,"_2970":123627},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3487":72799,"_30445":72761,"_21099":123629,"_5":14424,"_27663":123548,"_2970":123630},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3487":72800,"_30445":72761,"_21099":123632,"_5":14424,"_27663":123548,"_2970":123633},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3487":72801,"_30445":72761,"_21099":123635,"_5":14424,"_27663":123548,"_2970":123636},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3487":72802,"_30445":72761,"_21099":123638,"_5":14424,"_27663":123548,"_2970":123639},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3487":72803,"_30445":72761,"_21099":123641,"_5":14424,"_27663":123548,"_2970":123642},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3487":72804,"_30445":72804,"_5":14788,"_2970":123644,"_30797":123645,"_21099":123646,"_27663":72804},"Listas de revocación (CRL)",[49622,118603,55166,123118],[],{"_3487":72805,"_30445":72804,"_21099":123648,"_5":14424,"_27663":72804,"_2970":123649},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3487":72806,"_30445":72804,"_5":30794,"_21099":123651,"_27663":123652,"_2970":123653},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3487":72807,"_30445":72804,"_5":30794,"_21099":123655,"_27663":123656,"_2970":123657},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3487":72808,"_30445":72804,"_5":30794,"_21099":123659,"_27663":123660,"_2970":123661},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3487":72809,"_30445":72804,"_5":30794,"_21099":123663,"_27663":123664,"_2970":123665},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3487":72810,"_30445":72804,"_5":30794,"_21099":123667,"_27663":123668,"_2970":123669},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3487":72811,"_30445":72804,"_5":30794,"_21099":123671,"_27663":123672,"_2970":123673},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3487":72812,"_30445":72804,"_5":30794,"_21099":123675,"_27663":123676,"_2970":123677},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3487":72813,"_30445":72804,"_5":30794,"_21099":123679,"_27663":123680,"_2970":123681},[],"/docs/pr-preview/pr-68/es/platform/pki/crl#referencias","Referencias",{"_3487":72814,"_30445":72804,"_21099":123683,"_5":14424,"_27663":72804,"_2970":123684},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3487":72815,"_30445":72804,"_21099":123686,"_5":14424,"_27663":123652,"_2970":123687},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3487":72816,"_30445":72804,"_21099":123689,"_5":14424,"_27663":123652,"_2970":123690},[],"Campo",{"_3487":72817,"_30445":72804,"_21099":123692,"_5":14424,"_27663":123652,"_2970":120144},[],{"_3487":72818,"_30445":72804,"_21099":123694,"_5":14424,"_27663":123652,"_2970":56384},[],{"_3487":72819,"_30445":72804,"_21099":123696,"_5":14424,"_27663":123652,"_2970":123697},[],"ID de la CA a la que pertenecen los ajustes.",{"_3487":72820,"_30445":72804,"_21099":123699,"_5":14424,"_27663":123652,"_2970":56390},[],{"_3487":72821,"_30445":72804,"_21099":123701,"_5":14424,"_27663":123652,"_2970":123702},[],"Los ajustes `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA que fue revocada o ha expirado: su última CRL, si la hay, se publica y no se genera ninguna nueva. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3487":72822,"_30445":72804,"_21099":123704,"_5":14424,"_27663":123652,"_2970":56396},[],{"_3487":72823,"_30445":72804,"_21099":123706,"_5":14424,"_27663":123652,"_2970":123707},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3487":72824,"_30445":72804,"_21099":123709,"_5":14424,"_27663":123652,"_2970":56402},[],{"_3487":72825,"_30445":72804,"_21099":123711,"_5":14424,"_27663":123652,"_2970":123712},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3487":72826,"_30445":72804,"_21099":123714,"_5":14424,"_27663":123652,"_2970":123715},[],"Campo de `crl_options`",{"_3487":72827,"_30445":72804,"_21099":123717,"_5":14424,"_27663":123652,"_2970":120144},[],{"_3487":72828,"_30445":72804,"_21099":123719,"_5":14424,"_27663":123652,"_2970":123720},[],"Valor inicial",{"_3487":72829,"_30445":72804,"_21099":123722,"_5":14424,"_27663":123652,"_2970":56416},[],{"_3487":72830,"_30445":72804,"_21099":123724,"_5":14424,"_27663":123652,"_2970":123725},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3487":72831,"_30445":72804,"_21099":123727,"_5":14424,"_27663":123652,"_2970":123728},[],"7 días.",{"_3487":72832,"_30445":72804,"_21099":123730,"_5":14424,"_27663":123652,"_2970":56425},[],{"_3487":72833,"_30445":72804,"_21099":123732,"_5":14424,"_27663":123652,"_2970":123733},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3487":72834,"_30445":72804,"_21099":123735,"_5":14424,"_27663":123652,"_2970":123736},[],"6 días y 23 horas.",{"_3487":72835,"_30445":72804,"_21099":123738,"_5":14424,"_27663":123652,"_2970":56434},[],{"_3487":72836,"_30445":72804,"_21099":123740,"_5":14424,"_27663":123652,"_2970":123741},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3487":72837,"_30445":72804,"_21099":123743,"_5":14424,"_27663":123652,"_2970":56440},[],{"_3487":72838,"_30445":72804,"_21099":123745,"_5":14424,"_27663":123652,"_2970":56443},[],{"_3487":72839,"_30445":72804,"_21099":123747,"_5":14424,"_27663":123652,"_2970":123748},[],"Número de serie del certificado existente que firma la CRL.",{"_3487":72840,"_30445":72804,"_21099":123750,"_5":14424,"_27663":123652,"_2970":123751},[],"Número de serie del certificado actual de la CA.",{"_3487":72841,"_30445":72804,"_21099":123753,"_5":14424,"_27663":123652,"_2970":123754},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3487":72842,"_30445":72804,"_21099":123756,"_5":14424,"_27663":123652,"_2970":123757},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3487":72843,"_30445":72804,"_21099":123759,"_5":14424,"_27663":123652,"_2970":123760},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3487":72844,"_30445":72804,"_21099":123762,"_5":14424,"_27663":123652,"_2970":123763},[],"Los ajustes cuyo `status` es `FINAL` o `ARCHIVED` son de solo lectura: cualquier `PUT` devuelve 409. Eliminar una CA conserva sus ajustes de CRL:",{"_3487":72845,"_30445":72804,"_21099":123765,"_5":14424,"_27663":123652,"_2970":123766},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera.",{"_3487":72846,"_30445":72804,"_21099":123768,"_5":14424,"_27663":123652,"_2970":123769},[],"Los ajustes `ARCHIVED` de una CA eliminada pueden borrarse, con `DELETE` o desde la página Verification Authorities de la consola. Esa CRL deja de servirse — quien compruebe sus certificados contra ella dejará de encontrarla —, mientras que las CRLs ya publicadas permanecen en el bucket. La acción no puede deshacerse.",{"_3487":72847,"_30445":72804,"_21099":123771,"_5":14424,"_27663":123652,"_2970":123772},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3487":72848,"_30445":72804,"_21099":123774,"_5":14424,"_27663":123652,"_2970":123775},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3487":72849,"_30445":72804,"_21099":123777,"_5":14424,"_27663":123652,"_2970":123778},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3487":72850,"_30445":72804,"_21099":123780,"_5":14424,"_27663":123652,"_2970":123781},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3487":72851,"_30445":72804,"_21099":123783,"_5":14424,"_27663":123656,"_2970":123784},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3487":72852,"_30445":72804,"_21099":123786,"_5":14424,"_27663":123656,"_2970":123787},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3487":72853,"_30445":72804,"_21099":123789,"_5":14424,"_27663":123656,"_2970":123790},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3487":72854,"_30445":72804,"_21099":123792,"_5":14424,"_27663":123656,"_2970":123793},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3487":72855,"_30445":72804,"_21099":123795,"_5":14424,"_27663":123660,"_2970":123796},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3487":72856,"_30445":72804,"_21099":123798,"_5":14424,"_27663":123660,"_2970":123799},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3487":72857,"_30445":72804,"_21099":123801,"_5":14424,"_27663":123660,"_2970":123802},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3487":72858,"_30445":72804,"_21099":123804,"_5":14424,"_27663":123660,"_2970":123805},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3487":72859,"_30445":72804,"_21099":123807,"_5":14424,"_27663":123660,"_2970":123808},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3487":72860,"_30445":72804,"_21099":123810,"_5":14424,"_27663":123660,"_2970":123811},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3487":72861,"_30445":72804,"_21099":123813,"_5":14424,"_27663":123660,"_2970":123814},[],"Los ajustes con `status` `FINAL` o `ARCHIVED` se omiten: nada regenera su CRL.",{"_3487":72862,"_30445":72804,"_21099":123816,"_5":14424,"_27663":123660,"_2970":123817},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3487":72863,"_30445":72804,"_21099":123819,"_5":14424,"_27663":123660,"_2970":123820},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3487":72864,"_30445":72804,"_21099":123822,"_5":14424,"_27663":123664,"_2970":123823},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3487":72865,"_30445":72804,"_21099":123825,"_5":14424,"_27663":123664,"_2970":123826},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3487":72866,"_30445":72804,"_21099":123828,"_5":14424,"_27663":123668,"_2970":123829},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3487":72867,"_30445":72804,"_21099":123831,"_5":14424,"_27663":123668,"_2970":123832},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3487":72868,"_30445":72804,"_21099":123834,"_5":14424,"_27663":123668,"_2970":123835},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3487":72869,"_30445":72804,"_21099":123837,"_5":14424,"_27663":123668,"_2970":123838},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3487":72870,"_30445":72804,"_21099":123840,"_5":14424,"_27663":123668,"_2970":123841},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3487":72871,"_30445":72804,"_21099":123843,"_5":14424,"_27663":123672,"_2970":123844},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3487":72872,"_30445":72804,"_21099":123846,"_5":14424,"_27663":123672,"_2970":120333},[],{"_3487":72873,"_30445":72804,"_21099":123848,"_5":14424,"_27663":123672,"_2970":123849},[],"Path relativo",{"_3487":72874,"_30445":72804,"_21099":123851,"_5":14424,"_27663":123672,"_2970":118354},[],{"_3487":72875,"_30445":72804,"_21099":123853,"_5":14424,"_27663":123672,"_2970":56552},[],{"_3487":72876,"_30445":72804,"_21099":123855,"_5":14424,"_27663":123672,"_2970":56555},[],{"_3487":72877,"_30445":72804,"_21099":123857,"_5":14424,"_27663":123672,"_2970":123858},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3487":72878,"_30445":72804,"_21099":123860,"_5":14424,"_27663":123672,"_2970":56552},[],{"_3487":72879,"_30445":72804,"_21099":123862,"_5":14424,"_27663":123672,"_2970":56563},[],{"_3487":72880,"_30445":72804,"_21099":123864,"_5":14424,"_27663":123672,"_2970":123865},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3487":72881,"_30445":72804,"_21099":123867,"_5":14424,"_27663":123672,"_2970":56569},[],{"_3487":72882,"_30445":72804,"_21099":123869,"_5":14424,"_27663":123672,"_2970":56563},[],{"_3487":72883,"_30445":72804,"_21099":123871,"_5":14424,"_27663":123672,"_2970":123872},[],"Sustituir la configuración de CRL de una CA.",{"_3487":72884,"_30445":72804,"_21099":123874,"_5":14424,"_27663":123672,"_2970":56577},[],{"_3487":72885,"_30445":72804,"_21099":123876,"_5":14424,"_27663":123672,"_2970":56563},[],{"_3487":72886,"_30445":72804,"_21099":123878,"_5":14424,"_27663":123672,"_2970":123879},[],"Borrar los ajustes de una CA cuyos ajustes están `ARCHIVED`; sus CRLs publicadas permanecen en el bucket pero dejan de servirse.",{"_3487":72887,"_30445":72804,"_21099":123881,"_5":14424,"_27663":123672,"_2970":123882},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL. Un `DELETE` devuelve 409 salvo que los ajustes estén `ARCHIVED`.",{"_3487":72888,"_30445":72804,"_21099":123884,"_5":14424,"_27663":123672,"_2970":123885},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3487":72889,"_30445":72804,"_21099":123887,"_5":14424,"_27663":123676,"_2970":123888},[],"Síntoma",{"_3487":72890,"_30445":72804,"_21099":123890,"_5":14424,"_27663":123676,"_2970":123891},[],"Causa",{"_3487":72891,"_30445":72804,"_21099":123893,"_5":14424,"_27663":123676,"_2970":123894},[],"Acción",{"_3487":72892,"_30445":72804,"_21099":123896,"_5":14424,"_27663":123676,"_2970":123897},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3487":72893,"_30445":72804,"_21099":123899,"_5":14424,"_27663":123676,"_2970":123900},[],"Los ajustes no están `ACTIVE`: son `FINAL` o `ARCHIVED` (consulta la tabla del campo `status` en Ajustes de CRL).",{"_3487":72894,"_30445":72804,"_21099":123902,"_5":14424,"_27663":123676,"_2970":123903},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3487":72895,"_30445":72804,"_21099":123905,"_5":14424,"_27663":123676,"_2970":123906},[],"`PUT` devuelve 400.",{"_3487":72896,"_30445":72804,"_21099":123908,"_5":14424,"_27663":123676,"_2970":123909},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3487":72897,"_30445":72804,"_21099":123911,"_5":14424,"_27663":123676,"_2970":123912},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3487":72898,"_30445":72804,"_21099":123914,"_5":14424,"_27663":123676,"_2970":123915},[],"`PUT` devuelve 404.",{"_3487":72899,"_30445":72804,"_21099":123917,"_5":14424,"_27663":123676,"_2970":123918},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3487":72900,"_30445":72804,"_21099":123920,"_5":14424,"_27663":123676,"_2970":123921},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3487":72901,"_30445":72804,"_21099":123923,"_5":14424,"_27663":123676,"_2970":123924},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3487":72902,"_30445":72804,"_21099":123926,"_5":14424,"_27663":123676,"_2970":123927},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3487":72903,"_30445":72804,"_21099":123929,"_5":14424,"_27663":123676,"_2970":123930},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3487":72904,"_30445":72804,"_21099":123932,"_5":14424,"_27663":123676,"_2970":123933},[],"La CRL no cambia tras revocar un certificado.",{"_3487":72905,"_30445":72804,"_21099":123935,"_5":14424,"_27663":123676,"_2970":123936},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3487":72906,"_30445":72804,"_21099":123938,"_5":14424,"_27663":123676,"_2970":123939},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3487":72907,"_30445":72804,"_21099":123941,"_5":14424,"_27663":123676,"_2970":123942},[],"Un verificador rechaza la CRL por el emisor.",{"_3487":72908,"_30445":72804,"_21099":123944,"_5":14424,"_27663":123676,"_2970":123945},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3487":72909,"_30445":72804,"_21099":123947,"_5":14424,"_27663":123676,"_2970":123948},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3487":72910,"_30445":72804,"_21099":123950,"_5":14424,"_27663":123680,"_2970":123951},[],"RFC 5280: perfil X.509 y CRL.",{"_3487":72911,"_30445":72804,"_21099":123953,"_5":14424,"_27663":123680,"_2970":56657},[],{"_3487":72912,"_30445":72804,"_21099":123955,"_5":14424,"_27663":123680,"_2970":56660},[],{"_3487":72913,"_30445":72804,"_21099":123957,"_5":14424,"_27663":123680,"_2970":123958},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3487":72914,"_30445":72804,"_21099":123960,"_5":14424,"_27663":123680,"_2970":123961},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3487":72915,"_30445":72915,"_5":14788,"_2970":123963,"_30797":123964,"_21099":123965,"_27663":72915},"Claves y motores criptográficos",[49622,118603,55166,122481],[],{"_3487":72916,"_30445":72915,"_21099":123967,"_5":14424,"_27663":72915,"_2970":123968},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3487":72917,"_30445":72915,"_5":30794,"_21099":123970,"_27663":123971,"_2970":123972},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3487":72918,"_30445":72915,"_5":30794,"_21099":123974,"_27663":123975,"_2970":123976},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3487":72919,"_30445":72915,"_5":30794,"_21099":123978,"_27663":123979,"_2970":56685},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#file-system",{"_3487":72920,"_30445":72915,"_5":30794,"_21099":123981,"_27663":123982,"_2970":56689},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#hashicorp-vault",{"_3487":72921,"_30445":72915,"_5":30794,"_21099":123984,"_27663":123985,"_2970":56693},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#aws-secrets-manager",{"_3487":72922,"_30445":72915,"_5":30794,"_21099":123987,"_27663":123988,"_2970":56697},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#aws-kms",{"_3487":72923,"_30445":72915,"_5":30794,"_21099":123990,"_27663":123991,"_2970":56701},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#pkcs11",{"_3487":72924,"_30445":72915,"_5":30794,"_21099":123993,"_27663":123994,"_2970":56705},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#azure-key-vault",{"_3487":72925,"_30445":72915,"_5":30794,"_21099":123996,"_27663":123997,"_2970":123998},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3487":72926,"_30445":72915,"_5":30794,"_21099":124000,"_27663":124001,"_2970":124002},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3487":72927,"_30445":72915,"_5":30794,"_21099":124004,"_27663":124005,"_2970":124006},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3487":72928,"_30445":72915,"_5":30794,"_21099":124008,"_27663":124009,"_2970":124010},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3487":72929,"_30445":72915,"_5":30794,"_21099":124012,"_27663":124013,"_2970":124014},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3487":72930,"_30445":72915,"_5":30794,"_21099":124016,"_27663":124017,"_2970":124018},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3487":72931,"_30445":72915,"_5":30794,"_21099":124020,"_27663":124021,"_2970":124022},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3487":72932,"_30445":72915,"_5":30794,"_21099":124024,"_27663":124025,"_2970":56737},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#sign",{"_3487":72933,"_30445":72915,"_5":30794,"_21099":124027,"_27663":124028,"_2970":56741},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#verify",{"_3487":72934,"_30445":72915,"_5":30794,"_21099":124030,"_27663":124031,"_2970":124032},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3487":72935,"_30445":72915,"_5":30794,"_21099":124034,"_27663":124035,"_2970":124036},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3487":72936,"_30445":72915,"_5":30794,"_21099":124038,"_27663":124039,"_2970":124040},[],"/docs/pr-preview/pr-68/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3487":72937,"_30445":72915,"_21099":124042,"_5":14424,"_27663":72915,"_2970":124043},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3487":72938,"_30445":72915,"_21099":124045,"_5":14424,"_27663":72915,"_2970":124046},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3487":72939,"_30445":72915,"_21099":124048,"_5":14424,"_27663":123971,"_2970":124049},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3487":72940,"_30445":72915,"_21099":124051,"_5":14424,"_27663":123971,"_2970":124052},[],"En la práctica, permite:",{"_3487":72941,"_30445":72915,"_21099":124054,"_5":14424,"_27663":123971,"_2970":124055},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3487":72942,"_30445":72915,"_21099":124057,"_5":14424,"_27663":123971,"_2970":124058},[],"Importar claves creadas externamente.",{"_3487":72943,"_30445":72915,"_21099":124060,"_5":14424,"_27663":123971,"_2970":124061},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3487":72944,"_30445":72915,"_21099":124063,"_5":14424,"_27663":123971,"_2970":124064},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3487":72945,"_30445":72915,"_21099":124066,"_5":14424,"_27663":123975,"_2970":124067},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3487":72946,"_30445":72915,"_21099":124069,"_5":14424,"_27663":123975,"_2970":124070},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3487":72947,"_30445":72915,"_21099":124072,"_5":14424,"_27663":123975,"_2970":124073},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3487":72948,"_30445":72915,"_21099":124075,"_5":14424,"_27663":123979,"_2970":124076},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3487":72949,"_30445":72915,"_21099":124078,"_5":14424,"_27663":123982,"_2970":124079},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3487":72950,"_30445":72915,"_21099":124081,"_5":14424,"_27663":123982,"_2970":124082},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3487":72951,"_30445":72915,"_21099":124084,"_5":14424,"_27663":123985,"_2970":124085},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3487":72952,"_30445":72915,"_21099":124087,"_5":14424,"_27663":123988,"_2970":124088},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3487":72953,"_30445":72915,"_21099":124090,"_5":14424,"_27663":123991,"_2970":124091},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3487":72954,"_30445":72915,"_21099":124093,"_5":14424,"_27663":123994,"_2970":124094},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3487":72955,"_30445":72915,"_21099":124096,"_5":14424,"_27663":123994,"_2970":124097},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3487":72956,"_30445":72915,"_21099":124099,"_5":14424,"_27663":123994,"_2970":124100},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3487":72957,"_30445":72915,"_21099":124102,"_5":14424,"_27663":123994,"_2970":124103},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3487":72958,"_30445":72915,"_21099":124105,"_5":14424,"_27663":123997,"_2970":124106},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3487":72959,"_30445":72915,"_21099":124108,"_5":14424,"_27663":123997,"_2970":124109},[],"La tabla incluye los siguientes campos:",{"_3487":72960,"_30445":72915,"_21099":124111,"_5":14424,"_27663":123997,"_2970":124112},[],"**Name**: nombre descriptivo de la clave.",{"_3487":72961,"_30445":72915,"_21099":124114,"_5":14424,"_27663":123997,"_2970":124115},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3487":72962,"_30445":72915,"_21099":124117,"_5":14424,"_27663":123997,"_2970":124118},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3487":72963,"_30445":72915,"_21099":124120,"_5":14424,"_27663":123997,"_2970":124121},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3487":72964,"_30445":72915,"_21099":124123,"_5":14424,"_27663":123997,"_2970":124124},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3487":72965,"_30445":72915,"_21099":124126,"_5":14424,"_27663":123997,"_2970":124127},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3487":72966,"_30445":72915,"_21099":124129,"_5":14424,"_27663":123997,"_2970":124130},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3487":72967,"_30445":72915,"_21099":124132,"_5":14424,"_27663":123997,"_2970":124133},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3487":72968,"_30445":72915,"_21099":124135,"_5":14424,"_27663":123997,"_2970":124136},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3487":72969,"_30445":72915,"_21099":124138,"_5":14424,"_27663":123997,"_2970":124139},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3487":72970,"_30445":72915,"_21099":124141,"_5":14424,"_27663":123997,"_2970":124142},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3487":72971,"_30445":72915,"_21099":124144,"_5":14424,"_27663":123997,"_2970":124145},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3487":72972,"_30445":72915,"_21099":124147,"_5":14424,"_27663":123997,"_2970":124148},[],"**Delete Key** para eliminar la clave del sistema.",{"_3487":72973,"_30445":72915,"_21099":124150,"_5":14424,"_27663":124001,"_2970":124151},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3487":72974,"_30445":72915,"_21099":124153,"_5":14424,"_27663":124005,"_2970":124154},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3487":72975,"_30445":72915,"_21099":124156,"_5":14424,"_27663":124005,"_2970":124157},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3487":72976,"_30445":72915,"_21099":124159,"_5":14424,"_27663":124005,"_2970":124160},[],"**Key Name**: nombre único y descriptivo.",{"_3487":72977,"_30445":72915,"_21099":124162,"_5":14424,"_27663":124005,"_2970":124163},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3487":72978,"_30445":72915,"_21099":124165,"_5":14424,"_27663":124005,"_2970":124166},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3487":72979,"_30445":72915,"_21099":124168,"_5":14424,"_27663":124005,"_2970":124169},[],"**Tags**: metadatos para clasificar la clave.",{"_3487":72980,"_30445":72915,"_21099":124171,"_5":14424,"_27663":124005,"_2970":124172},[],"**Metadata**: información adicional para usos avanzados.",{"_3487":72981,"_30445":72915,"_21099":124174,"_5":14424,"_27663":124009,"_2970":124175},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3487":72982,"_30445":72915,"_21099":124177,"_5":14424,"_27663":124009,"_2970":124178},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3487":72983,"_30445":72915,"_21099":124180,"_5":14424,"_27663":124009,"_2970":124181},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3487":72984,"_30445":72915,"_21099":124183,"_5":14424,"_27663":124009,"_2970":124184},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3487":72985,"_30445":72915,"_21099":124186,"_5":14424,"_27663":124009,"_2970":124187},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3487":72986,"_30445":72915,"_21099":124189,"_5":14424,"_27663":124009,"_2970":124190},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3487":72987,"_30445":72915,"_21099":124192,"_5":14424,"_27663":124009,"_2970":124193},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3487":72988,"_30445":72915,"_21099":124195,"_5":14424,"_27663":124009,"_2970":124196},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3487":72989,"_30445":72915,"_21099":124198,"_5":14424,"_27663":124009,"_2970":124199},[],"**Metadata**: información adicional opcional.",{"_3487":72990,"_30445":72915,"_21099":124201,"_5":14424,"_27663":124009,"_2970":124202},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3487":72991,"_30445":72915,"_21099":124204,"_5":14424,"_27663":124009,"_2970":124205},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3487":72992,"_30445":72915,"_21099":124207,"_5":14424,"_27663":124013,"_2970":124208},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3487":72993,"_30445":72915,"_21099":124210,"_5":14424,"_27663":124017,"_2970":124211},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3487":72994,"_30445":72915,"_21099":124213,"_5":14424,"_27663":124017,"_2970":124214},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3487":72995,"_30445":72915,"_21099":124216,"_5":14424,"_27663":124017,"_2970":124217},[],"**Key Name**: nombre descriptivo.",{"_3487":72996,"_30445":72915,"_21099":124219,"_5":14424,"_27663":124017,"_2970":124220},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3487":72997,"_30445":72915,"_21099":124222,"_5":14424,"_27663":124017,"_2970":124223},[],"**Tags**: etiquetas asociadas.",{"_3487":72998,"_30445":72915,"_21099":124225,"_5":14424,"_27663":124017,"_2970":124226},[],"**Aliases**: nombres alternativos.",{"_3487":72999,"_30445":72915,"_21099":124228,"_5":14424,"_27663":124017,"_2970":124229},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3487":73000,"_30445":72915,"_21099":124231,"_5":14424,"_27663":124017,"_2970":124232},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3487":73001,"_30445":72915,"_21099":124234,"_5":14424,"_27663":124017,"_2970":124235},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3487":73002,"_30445":72915,"_21099":124237,"_5":14424,"_27663":124017,"_2970":124238},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3487":73003,"_30445":72915,"_21099":124240,"_5":14424,"_27663":124021,"_2970":124241},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3487":73004,"_30445":72915,"_21099":124243,"_5":14424,"_27663":124021,"_2970":124244},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3487":73005,"_30445":72915,"_21099":124246,"_5":14424,"_27663":124021,"_2970":124247},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3487":73006,"_30445":72915,"_21099":124249,"_5":14424,"_27663":124025,"_2970":124250},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3487":73007,"_30445":72915,"_21099":124252,"_5":14424,"_27663":124025,"_2970":124253},[],"Campos principales:",{"_3487":73008,"_30445":72915,"_21099":124255,"_5":14424,"_27663":124025,"_2970":124256},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3487":73009,"_30445":72915,"_21099":124258,"_5":14424,"_27663":124025,"_2970":124259},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3487":73010,"_30445":72915,"_21099":124261,"_5":14424,"_27663":124025,"_2970":124262},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3487":73011,"_30445":72915,"_21099":124264,"_5":14424,"_27663":124025,"_2970":124265},[],"**Message**: contenido que se va a firmar.",{"_3487":73012,"_30445":72915,"_21099":124267,"_5":14424,"_27663":124025,"_2970":124268},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3487":73013,"_30445":72915,"_21099":124270,"_5":14424,"_27663":124028,"_2970":124271},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3487":73014,"_30445":72915,"_21099":124273,"_5":14424,"_27663":124028,"_2970":124253},[],{"_3487":73015,"_30445":72915,"_21099":124275,"_5":14424,"_27663":124028,"_2970":124276},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3487":73016,"_30445":72915,"_21099":124278,"_5":14424,"_27663":124028,"_2970":124279},[],"**Message Type**: `Raw` o `Digest`.",{"_3487":73017,"_30445":72915,"_21099":124281,"_5":14424,"_27663":124028,"_2970":124282},[],"**Payload Encoding**: codificación del mensaje.",{"_3487":73018,"_30445":72915,"_21099":124284,"_5":14424,"_27663":124028,"_2970":124285},[],"**Message**: mensaje original o hash.",{"_3487":73019,"_30445":72915,"_21099":124287,"_5":14424,"_27663":124028,"_2970":124288},[],"**Signature**: firma que se desea comprobar.",{"_3487":73020,"_30445":72915,"_21099":124290,"_5":14424,"_27663":124028,"_2970":124291},[],"**Result**: indicador del resultado de la validación.",{"_3487":73021,"_30445":72915,"_21099":124293,"_5":14424,"_27663":124031,"_2970":124294},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3487":73022,"_30445":72915,"_21099":124296,"_5":14424,"_27663":124031,"_2970":124297},[],"Este flujo es útil para:",{"_3487":73023,"_30445":72915,"_21099":124299,"_5":14424,"_27663":124031,"_2970":124300},[],"Solicitar certificados a una CA externa.",{"_3487":73024,"_30445":72915,"_21099":124302,"_5":14424,"_27663":124031,"_2970":124303},[],"Renovar una identidad manteniendo la misma clave.",{"_3487":73025,"_30445":72915,"_21099":124305,"_5":14424,"_27663":124031,"_2970":124306},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3487":73026,"_30445":72915,"_21099":124308,"_5":14424,"_27663":124031,"_2970":124309},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3487":73027,"_30445":72915,"_21099":124311,"_5":14424,"_27663":124031,"_2970":124312},[],"**Organization (O)**: organización o empresa.",{"_3487":73028,"_30445":72915,"_21099":124314,"_5":14424,"_27663":124031,"_2970":124315},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3487":73029,"_30445":72915,"_21099":124317,"_5":14424,"_27663":124031,"_2970":124318},[],"**Country (C)**: código de país de dos letras.",{"_3487":73030,"_30445":72915,"_21099":124320,"_5":14424,"_27663":124031,"_2970":124321},[],"**State / Province (ST)**: estado o provincia.",{"_3487":73031,"_30445":72915,"_21099":124323,"_5":14424,"_27663":124031,"_2970":124324},[],"**Locality (L)**: ciudad o localidad.",{"_3487":73032,"_30445":72915,"_21099":124326,"_5":14424,"_27663":124031,"_2970":124327},[],"**Email Address**: correo de contacto.",{"_3487":73033,"_30445":72915,"_21099":124329,"_5":14424,"_27663":124031,"_2970":124330},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3487":73034,"_30445":72915,"_21099":124332,"_5":14424,"_27663":124031,"_2970":124333},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3487":73035,"_30445":72915,"_21099":124335,"_5":14424,"_27663":124035,"_2970":124336},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3487":73036,"_30445":72915,"_21099":124338,"_5":14424,"_27663":124035,"_2970":124339},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3487":73037,"_30445":72915,"_21099":124341,"_5":14424,"_27663":124039,"_2970":124342},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3487":73038,"_30445":72915,"_21099":124344,"_5":14424,"_27663":124039,"_2970":124345},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3487":73039,"_30445":73039,"_5":14788,"_2970":124347,"_30797":124348,"_21099":124349,"_27663":73039},"Validación online con OCSP",[49622,118603,55166,123118],[],{"_3487":73040,"_30445":73039,"_21099":124351,"_5":14424,"_27663":73039,"_2970":124352},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3487":73041,"_30445":73039,"_5":30794,"_21099":124354,"_27663":124355,"_2970":124356},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3487":73042,"_30445":73039,"_5":30794,"_21099":124358,"_27663":124359,"_2970":124360},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3487":73043,"_30445":73039,"_5":30794,"_21099":124362,"_27663":124363,"_2970":124364},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3487":73044,"_30445":73039,"_5":30794,"_21099":124366,"_27663":124367,"_2970":124368},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3487":73045,"_30445":73039,"_5":30794,"_21099":124370,"_27663":124371,"_2970":124372},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3487":73046,"_30445":73039,"_5":30794,"_21099":124374,"_27663":124375,"_2970":123681},[],"/docs/pr-preview/pr-68/es/platform/pki/ocsp#referencias",{"_3487":73047,"_30445":73039,"_21099":124377,"_5":14424,"_27663":73039,"_2970":124378},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3487":73048,"_30445":73039,"_21099":124380,"_5":14424,"_27663":124355,"_2970":124381},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3487":73049,"_30445":73039,"_21099":124383,"_5":14424,"_27663":124355,"_2970":124384},[],"Estado del registro",{"_3487":73050,"_30445":73039,"_21099":124386,"_5":14424,"_27663":124355,"_2970":124387},[],"Respuesta firmada",{"_3487":73051,"_30445":73039,"_21099":124389,"_5":14424,"_27663":124355,"_2970":54303},[],{"_3487":73052,"_30445":73039,"_21099":124391,"_5":14424,"_27663":124355,"_2970":57105},[],{"_3487":73053,"_30445":73039,"_21099":124393,"_5":14424,"_27663":124355,"_2970":54320},[],{"_3487":73054,"_30445":73039,"_21099":124395,"_5":14424,"_27663":124355,"_2970":124396},[],"`Revoked`, con razón y fecha de revocación.",{"_3487":73055,"_30445":73039,"_21099":124398,"_5":14424,"_27663":124355,"_2970":124399},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3487":73056,"_30445":73039,"_21099":124401,"_5":14424,"_27663":124355,"_2970":124402},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3487":73057,"_30445":73039,"_21099":124404,"_5":14424,"_27663":124355,"_2970":124405},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3487":73058,"_30445":73039,"_21099":124407,"_5":14424,"_27663":124355,"_2970":124408},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3487":73059,"_30445":73039,"_21099":124410,"_5":14424,"_27663":124355,"_2970":124411},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3487":73060,"_30445":73039,"_21099":124413,"_5":14424,"_27663":124359,"_2970":124414},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3487":73061,"_30445":73039,"_21099":124416,"_5":14424,"_27663":124359,"_2970":124417},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3487":73062,"_30445":73039,"_21099":124419,"_5":14424,"_27663":124363,"_2970":124420},[],"El servicio acepta:",{"_3487":73063,"_30445":73039,"_21099":124422,"_5":14424,"_27663":124363,"_2970":120333},[],{"_3487":73064,"_30445":73039,"_21099":124424,"_5":14424,"_27663":124363,"_2970":124425},[],"Ruta del servicio VA",{"_3487":73065,"_30445":73039,"_21099":124427,"_5":14424,"_27663":124363,"_2970":124428},[],"Formato",{"_3487":73066,"_30445":73039,"_21099":124430,"_5":14424,"_27663":124363,"_2970":57145},[],{"_3487":73067,"_30445":73039,"_21099":124432,"_5":14424,"_27663":124363,"_2970":57148},[],{"_3487":73068,"_30445":73039,"_21099":124434,"_5":14424,"_27663":124363,"_2970":124435},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3487":73069,"_30445":73039,"_21099":124437,"_5":14424,"_27663":124363,"_2970":56552},[],{"_3487":73070,"_30445":73039,"_21099":124439,"_5":14424,"_27663":124363,"_2970":57156},[],{"_3487":73071,"_30445":73039,"_21099":124441,"_5":14424,"_27663":124363,"_2970":124442},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3487":73072,"_30445":73039,"_21099":124444,"_5":14424,"_27663":124363,"_2970":124445},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3487":73073,"_30445":73039,"_21099":124447,"_5":14424,"_27663":124367,"_2970":124448},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3487":73074,"_30445":73039,"_21099":124450,"_5":14424,"_27663":124367,"_2970":124451},[],"Genera la solicitud:",{"_3487":73075,"_30445":73039,"_21099":124453,"_5":14424,"_27663":124367,"_2970":124454},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3487":73076,"_30445":73039,"_21099":124456,"_5":14424,"_27663":124367,"_2970":124457},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3487":73077,"_30445":73039,"_21099":124459,"_5":14424,"_27663":124367,"_2970":124460},[],"Verifica el DER recibido:",{"_3487":73078,"_30445":73039,"_21099":124462,"_5":14424,"_27663":124367,"_2970":124463},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3487":73079,"_30445":73039,"_21099":124465,"_5":14424,"_27663":124371,"_2970":124466},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3487":73080,"_30445":73039,"_21099":124468,"_5":14424,"_27663":124371,"_2970":124469},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3487":73081,"_30445":73039,"_21099":124471,"_5":14424,"_27663":124375,"_2970":57189},[],{"_3487":73082,"_30445":73039,"_21099":124473,"_5":14424,"_27663":124375,"_2970":57192},[],{"_3487":73083,"_30445":73039,"_21099":124475,"_5":14424,"_27663":124375,"_2970":124476},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3487":73084,"_30445":73039,"_21099":124478,"_5":14424,"_27663":124375,"_2970":123961},[],{"_3487":73085,"_30445":73085,"_5":14788,"_2970":55166,"_30797":124480,"_21099":124481,"_27663":73085},[49622,118603,55166],[],{"_3487":73086,"_30445":73085,"_21099":124483,"_5":14424,"_27663":73085,"_2970":124484},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3487":73087,"_30445":73085,"_5":30794,"_21099":124486,"_27663":124487,"_2970":121807},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#empieza-aquí",{"_3487":73088,"_30445":73085,"_5":30794,"_21099":124489,"_27663":124490,"_2970":124491},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3487":73089,"_30445":73085,"_5":30794,"_21099":124493,"_27663":124494,"_2970":122327},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#capacidades-principales",{"_3487":73090,"_30445":73085,"_5":30794,"_21099":124496,"_27663":124497,"_2970":122331},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3487":73091,"_30445":73085,"_5":30794,"_21099":124499,"_27663":124500,"_2970":122335},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3487":73092,"_30445":73085,"_5":30794,"_21099":124502,"_27663":124503,"_2970":122339},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#emite-y-controla-certificados",{"_3487":73093,"_30445":73085,"_5":30794,"_21099":124505,"_27663":124506,"_2970":122347},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#publica-el-estado-de-validación",{"_3487":73094,"_30445":73085,"_5":30794,"_21099":124508,"_27663":124509,"_2970":124510},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3487":73095,"_30445":73085,"_5":30794,"_21099":124512,"_27663":124513,"_2970":123284},[],"/docs/pr-preview/pr-68/es/platform/pki/overview#continúa",{"_3487":73096,"_30445":73085,"_21099":124515,"_5":14424,"_27663":73085,"_2970":124516},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3487":73097,"_30445":73085,"_21099":124518,"_5":14424,"_27663":124487,"_2970":124519},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3487":73098,"_30445":73085,"_21099":124521,"_5":14424,"_27663":124487,"_2970":124522},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3487":73099,"_30445":73085,"_21099":124524,"_5":14424,"_27663":124490,"_2970":124525},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3487":73100,"_30445":73085,"_21099":124527,"_5":14424,"_27663":124490,"_2970":124528},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3487":73101,"_30445":73085,"_21099":124530,"_5":14424,"_27663":124490,"_2970":124531},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3487":73102,"_30445":73085,"_21099":124533,"_5":14424,"_27663":124490,"_2970":124534},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3487":73103,"_30445":73085,"_21099":124536,"_5":14424,"_27663":124490,"_2970":124537},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3487":73104,"_30445":73085,"_21099":124539,"_5":14424,"_27663":124497,"_2970":124540},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3487":73105,"_30445":73085,"_21099":124542,"_5":14424,"_27663":124500,"_2970":124543},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3487":73106,"_30445":73085,"_21099":124545,"_5":14424,"_27663":124503,"_2970":124546},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3487":73107,"_30445":73085,"_21099":124548,"_5":14424,"_27663":124506,"_2970":124549},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3487":73108,"_30445":73085,"_21099":124551,"_5":14424,"_27663":124509,"_2970":124552},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3487":73109,"_30445":73085,"_21099":124554,"_5":14424,"_27663":124509,"_2970":124555},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3487":73110,"_30445":73085,"_21099":124557,"_5":14424,"_27663":124509,"_2970":124558},[],"su clave pública corresponda a la clave privada del cliente;",{"_3487":73111,"_30445":73085,"_21099":124560,"_5":14424,"_27663":124509,"_2970":124561},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3487":73112,"_30445":73085,"_21099":124563,"_5":14424,"_27663":124509,"_2970":124564},[],"sus fechas y usos permitan la operación;",{"_3487":73113,"_30445":73085,"_21099":124566,"_5":14424,"_27663":124509,"_2970":124567},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3487":73114,"_30445":73085,"_21099":124569,"_5":14424,"_27663":124509,"_2970":124570},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3487":73115,"_30445":73085,"_21099":124572,"_5":14424,"_27663":124513,"_2970":124573},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3487":73116,"_30445":73085,"_21099":124575,"_5":14424,"_27663":124513,"_2970":124576},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3487":73117,"_30445":73085,"_21099":124578,"_5":14424,"_27663":124513,"_2970":124579},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3487":73118,"_30445":73118,"_5":14788,"_2970":124581,"_30797":124582,"_21099":124583,"_27663":73118},"Crea tu primera CA",[49622,118603,55166,121931],[],{"_3487":73119,"_30445":73118,"_21099":124585,"_5":14424,"_27663":73118,"_2970":124586},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3487":73120,"_30445":73118,"_5":30794,"_21099":124588,"_27663":124589,"_2970":117116},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3487":73121,"_30445":73118,"_5":30794,"_21099":124591,"_27663":124592,"_2970":124593},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3487":73122,"_30445":73118,"_5":30794,"_21099":124595,"_27663":124596,"_2970":124597},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3487":73123,"_30445":73118,"_5":30794,"_21099":124599,"_27663":124600,"_2970":124601},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3487":73124,"_30445":73118,"_5":30794,"_21099":124603,"_27663":124604,"_2970":124605},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3487":73125,"_30445":73118,"_5":30794,"_21099":124607,"_27663":124608,"_2970":124609},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3487":73126,"_30445":73118,"_5":30794,"_21099":124611,"_27663":124612,"_2970":124613},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3487":73127,"_30445":73118,"_5":30794,"_21099":124615,"_27663":124616,"_2970":122178},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3487":73128,"_30445":73118,"_5":30794,"_21099":124618,"_27663":124619,"_2970":117140},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3487":73129,"_30445":73118,"_21099":124621,"_5":14424,"_27663":73118,"_2970":124622},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3487":73130,"_30445":73118,"_21099":124624,"_5":14424,"_27663":124589,"_2970":124625},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3487":73131,"_30445":73118,"_21099":124627,"_5":14424,"_27663":124589,"_2970":124628},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3487":73132,"_30445":73118,"_21099":124630,"_5":14424,"_27663":124589,"_2970":124631},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3487":73133,"_30445":73118,"_21099":124633,"_5":14424,"_27663":124589,"_2970":124634},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3487":73134,"_30445":73118,"_21099":124636,"_5":14424,"_27663":124592,"_2970":124637},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3487":73135,"_30445":73118,"_21099":124639,"_5":14424,"_27663":124592,"_2970":124640},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3487":73136,"_30445":73118,"_21099":124642,"_5":14424,"_27663":124596,"_2970":124643},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3487":73137,"_30445":73118,"_21099":124645,"_5":14424,"_27663":124596,"_2970":124646},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3487":73138,"_30445":73118,"_21099":124648,"_5":14424,"_27663":124600,"_2970":124649},[],"Selecciona **Root CA** y completa:",{"_3487":73139,"_30445":73118,"_21099":124651,"_5":14424,"_27663":124600,"_2970":57371},[],{"_3487":73140,"_30445":73118,"_21099":124653,"_5":14424,"_27663":124600,"_2970":124654},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3487":73141,"_30445":73118,"_21099":124656,"_5":14424,"_27663":124600,"_2970":124657},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3487":73142,"_30445":73118,"_21099":124659,"_5":14424,"_27663":124600,"_2970":124660},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3487":73143,"_30445":73118,"_21099":124662,"_5":14424,"_27663":124600,"_2970":124663},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3487":73144,"_30445":73118,"_21099":124665,"_5":14424,"_27663":124604,"_2970":124666},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3487":73145,"_30445":73118,"_21099":124668,"_5":14424,"_27663":124608,"_2970":124669},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3487":73146,"_30445":73118,"_21099":124671,"_5":14424,"_27663":124608,"_2970":124672},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3487":73147,"_30445":73118,"_21099":124674,"_5":14424,"_27663":124612,"_2970":124675},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3487":73148,"_30445":73118,"_21099":124677,"_5":14424,"_27663":124612,"_2970":124678},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3487":73149,"_30445":73118,"_21099":124680,"_5":14424,"_27663":124612,"_2970":124681},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3487":73150,"_30445":73118,"_21099":124683,"_5":14424,"_27663":124616,"_2970":124684},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3487":73151,"_30445":73118,"_21099":124686,"_5":14424,"_27663":124616,"_2970":124687},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3487":73152,"_30445":73118,"_21099":124689,"_5":14424,"_27663":124616,"_2970":124690},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3487":73153,"_30445":73118,"_21099":124692,"_5":14424,"_27663":124616,"_2970":124693},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3487":73154,"_30445":73118,"_21099":124695,"_5":14424,"_27663":124619,"_2970":124696},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3487":73155,"_30445":73155,"_5":14788,"_2970":124698,"_30797":124699,"_21099":124700,"_27663":73155},"Emite y verifica un certificado",[49622,118603,55166,121931],[],{"_3487":73156,"_30445":73155,"_21099":124702,"_5":14424,"_27663":73155,"_2970":124703},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3487":73157,"_30445":73155,"_5":30794,"_21099":124705,"_27663":124706,"_2970":117116},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3487":73158,"_30445":73155,"_5":30794,"_21099":124708,"_27663":124709,"_2970":124710},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3487":73159,"_30445":73155,"_5":30794,"_21099":124712,"_27663":124713,"_2970":124714},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3487":73160,"_30445":73155,"_5":30794,"_21099":124716,"_27663":124717,"_2970":124718},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3487":73161,"_30445":73155,"_5":30794,"_21099":124720,"_27663":124721,"_2970":124722},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3487":73162,"_30445":73155,"_5":30794,"_21099":124724,"_27663":124725,"_2970":124726},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3487":73163,"_30445":73155,"_5":30794,"_21099":124728,"_27663":124729,"_2970":124730},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3487":73164,"_30445":73155,"_5":30794,"_21099":124732,"_27663":124733,"_2970":124734},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3487":73165,"_30445":73155,"_5":30794,"_21099":124736,"_27663":124737,"_2970":124738},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3487":73166,"_30445":73155,"_5":30794,"_21099":124740,"_27663":124741,"_2970":124742},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3487":73167,"_30445":73155,"_5":30794,"_21099":124744,"_27663":124745,"_2970":122178},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3487":73168,"_30445":73155,"_5":30794,"_21099":124747,"_27663":124748,"_2970":117140},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3487":73169,"_30445":73155,"_21099":124750,"_5":14424,"_27663":73155,"_2970":124751},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3487":73170,"_30445":73155,"_21099":124753,"_5":14424,"_27663":124706,"_2970":124754},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3487":73171,"_30445":73155,"_21099":124756,"_5":14424,"_27663":124706,"_2970":124757},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3487":73172,"_30445":73155,"_21099":124759,"_5":14424,"_27663":124706,"_2970":124760},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3487":73173,"_30445":73155,"_21099":124762,"_5":14424,"_27663":124706,"_2970":124763},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3487":73174,"_30445":73155,"_21099":124765,"_5":14424,"_27663":124706,"_2970":124766},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3487":73175,"_30445":73155,"_21099":124768,"_5":14424,"_27663":124709,"_2970":124769},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3487":73176,"_30445":73155,"_21099":124771,"_5":14424,"_27663":124713,"_2970":124772},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3487":73177,"_30445":73155,"_21099":124774,"_5":14424,"_27663":124713,"_2970":124775},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3487":73178,"_30445":73155,"_21099":124777,"_5":14424,"_27663":124717,"_2970":124778},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3487":73179,"_30445":73155,"_21099":124780,"_5":14424,"_27663":124717,"_2970":124781},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3487":73180,"_30445":73155,"_21099":124783,"_5":14424,"_27663":124721,"_2970":124784},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3487":73181,"_30445":73155,"_21099":124786,"_5":14424,"_27663":124721,"_2970":124787},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3487":73182,"_30445":73155,"_21099":124789,"_5":14424,"_27663":124725,"_2970":124790},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3487":73183,"_30445":73155,"_21099":124792,"_5":14424,"_27663":124729,"_2970":124793},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3487":73184,"_30445":73155,"_21099":124795,"_5":14424,"_27663":124733,"_2970":124796},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3487":73185,"_30445":73155,"_21099":124798,"_5":14424,"_27663":124737,"_2970":124799},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3487":73186,"_30445":73155,"_21099":124801,"_5":14424,"_27663":124737,"_2970":124802},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3487":73187,"_30445":73155,"_21099":124804,"_5":14424,"_27663":124737,"_2970":124805},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3487":73188,"_30445":73155,"_21099":124807,"_5":14424,"_27663":124741,"_2970":124808},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3487":73189,"_30445":73155,"_21099":124810,"_5":14424,"_27663":124741,"_2970":124811},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3487":73190,"_30445":73155,"_21099":124813,"_5":14424,"_27663":124741,"_2970":124814},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3487":73191,"_30445":73155,"_21099":124816,"_5":14424,"_27663":124745,"_2970":122261},[],{"_3487":73192,"_30445":73155,"_21099":124818,"_5":14424,"_27663":124745,"_2970":120782},[],{"_3487":73193,"_30445":73155,"_21099":124820,"_5":14424,"_27663":124745,"_2970":124821},[],"La CA rechaza la emisión",{"_3487":73194,"_30445":73155,"_21099":124823,"_5":14424,"_27663":124745,"_2970":124824},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3487":73195,"_30445":73155,"_21099":124826,"_5":14424,"_27663":124745,"_2970":124827},[],"Sujeto o usos diferentes",{"_3487":73196,"_30445":73155,"_21099":124829,"_5":14424,"_27663":124745,"_2970":124830},[],"Perfil aplicado y valores solicitados.",{"_3487":73197,"_30445":73155,"_21099":124832,"_5":14424,"_27663":124745,"_2970":124833},[],"No se encuentra el emisor",{"_3487":73198,"_30445":73155,"_21099":124835,"_5":14424,"_27663":124745,"_2970":124836},[],"CA descargada y cadena intermedia necesaria.",{"_3487":73199,"_30445":73155,"_21099":124838,"_5":14424,"_27663":124745,"_2970":124839},[],"Falla la vigencia",{"_3487":73200,"_30445":73155,"_21099":124841,"_5":14424,"_27663":124745,"_2970":124842},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3487":73201,"_30445":73155,"_21099":124844,"_5":14424,"_27663":124745,"_2970":124845},[],"Los resúmenes de clave difieren",{"_3487":73202,"_30445":73155,"_21099":124847,"_5":14424,"_27663":124745,"_2970":124848},[],"Archivos de certificado y clave de la misma emisión.",{"_3487":73203,"_30445":73155,"_21099":124850,"_5":14424,"_27663":124745,"_2970":124851},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3487":73204,"_30445":73155,"_21099":124853,"_5":14424,"_27663":124748,"_2970":124854},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3487":73205,"_30445":73155,"_21099":124856,"_5":14424,"_27663":124748,"_2970":124857},[],"Gestionar certificados para inspección, estado y revocación.",{"_3487":73206,"_30445":73155,"_21099":124859,"_5":14424,"_27663":124748,"_2970":124860},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3487":73207,"_30445":73155,"_21099":124862,"_5":14424,"_27663":124748,"_2970":124863},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3487":73208,"_30445":73155,"_21099":124865,"_5":14424,"_27663":124748,"_2970":124866},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3487":73209,"_30445":73209,"_5":14788,"_2970":124868,"_30797":124869,"_21099":124870,"_27663":73209},"Primeros pasos de PKI",[49622,118603,55166,121931],[],{"_3487":73210,"_30445":73209,"_21099":124872,"_5":14424,"_27663":73209,"_2970":124873},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3487":73211,"_30445":73209,"_5":30794,"_21099":124875,"_27663":124876,"_2970":117116},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3487":73212,"_30445":73209,"_5":30794,"_21099":124878,"_27663":124879,"_2970":124880},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3487":73213,"_30445":73209,"_5":30794,"_21099":124882,"_27663":124883,"_2970":122113},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3487":73214,"_30445":73209,"_5":30794,"_21099":124885,"_27663":124886,"_2970":124887},[],"/docs/pr-preview/pr-68/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3487":73215,"_30445":73209,"_21099":124889,"_5":14424,"_27663":73209,"_2970":124890},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3487":73216,"_30445":73209,"_21099":124892,"_5":14424,"_27663":124876,"_2970":124893},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3487":73217,"_30445":73209,"_21099":124895,"_5":14424,"_27663":124876,"_2970":124896},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3487":73218,"_30445":73209,"_21099":124898,"_5":14424,"_27663":124876,"_2970":124899},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3487":73219,"_30445":73209,"_21099":124901,"_5":14424,"_27663":124876,"_2970":124902},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3487":73220,"_30445":73209,"_21099":124904,"_5":14424,"_27663":124876,"_2970":124905},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3487":73221,"_30445":73209,"_21099":124907,"_5":14424,"_27663":124879,"_2970":124908},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3487":73222,"_30445":73209,"_21099":124910,"_5":14424,"_27663":124879,"_2970":124911},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3487":73223,"_30445":73209,"_21099":124913,"_5":14424,"_27663":124879,"_2970":124914},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3487":73224,"_30445":73209,"_21099":124916,"_5":14424,"_27663":124879,"_2970":124917},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3487":73225,"_30445":73209,"_21099":124919,"_5":14424,"_27663":124883,"_2970":124920},[],"Archivo o recurso",{"_3487":73226,"_30445":73209,"_21099":124922,"_5":14424,"_27663":124883,"_2970":122110},[],{"_3487":73227,"_30445":73209,"_21099":124924,"_5":14424,"_27663":124883,"_2970":124925},[],"CA raíz activa y `ca.pem`",{"_3487":73228,"_30445":73209,"_21099":124927,"_5":14424,"_27663":124883,"_2970":124928},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3487":73229,"_30445":73209,"_21099":124930,"_5":14424,"_27663":124883,"_2970":124931},[],"Certificado final y `device.crt`",{"_3487":73230,"_30445":73209,"_21099":124933,"_5":14424,"_27663":124883,"_2970":124934},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3487":73231,"_30445":73209,"_21099":124936,"_5":14424,"_27663":124883,"_2970":124937},[],"Clave privada `device.key`",{"_3487":73232,"_30445":73209,"_21099":124939,"_5":14424,"_27663":124883,"_2970":124940},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3487":73233,"_30445":73209,"_21099":124942,"_5":14424,"_27663":124883,"_2970":124943},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3487":73234,"_30445":73209,"_21099":124945,"_5":14424,"_27663":124886,"_2970":124946},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3487":73235,"_30445":73209,"_21099":124948,"_5":14424,"_27663":124886,"_2970":124949},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3487":73236,"_30445":73209,"_21099":124951,"_5":14424,"_27663":124886,"_2970":124952},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3487":73237,"_30445":73237,"_5":14788,"_2970":124954,"_30797":124955,"_21099":124957,"_27663":73237},"Resolución de problemas PKI",[49622,118603,55166,124956],"Resolución de problemas",[],{"_3487":73238,"_30445":73237,"_21099":124959,"_5":14424,"_27663":73237,"_2970":124960},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3487":73239,"_30445":73237,"_5":30794,"_21099":124962,"_27663":124963,"_2970":124964},[],"/docs/pr-preview/pr-68/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3487":73240,"_30445":73237,"_5":30794,"_21099":124966,"_27663":124967,"_2970":124968},[],"/docs/pr-preview/pr-68/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3487":73241,"_30445":73237,"_5":30794,"_21099":124970,"_27663":124971,"_2970":124972},[],"/docs/pr-preview/pr-68/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3487":73242,"_30445":73237,"_21099":124974,"_5":14424,"_27663":73237,"_2970":124975},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3487":73243,"_30445":73237,"_21099":124977,"_5":14424,"_27663":73237,"_2970":124978},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3487":73244,"_30445":73237,"_21099":124980,"_5":14424,"_27663":124963,"_2970":122110},[],{"_3487":73245,"_30445":73237,"_21099":124982,"_5":14424,"_27663":124963,"_2970":120782},[],{"_3487":73246,"_30445":73237,"_21099":124984,"_5":14424,"_27663":124963,"_2970":117140},[],{"_3487":73247,"_30445":73237,"_21099":124986,"_5":14424,"_27663":124963,"_2970":54008},[],{"_3487":73248,"_30445":73237,"_21099":124988,"_5":14424,"_27663":124963,"_2970":124989},[],"Existe, está activa y sus fechas son utilizables.",{"_3487":73249,"_30445":73237,"_21099":124991,"_5":14424,"_27663":124963,"_2970":124992},[],"Autoridades.",{"_3487":73250,"_30445":73237,"_21099":124994,"_5":14424,"_27663":124963,"_2970":124995},[],"Clave",{"_3487":73251,"_30445":73237,"_21099":124997,"_5":14424,"_27663":124963,"_2970":124998},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3487":73252,"_30445":73237,"_21099":125000,"_5":14424,"_27663":124963,"_2970":125001},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3487":73253,"_30445":73237,"_21099":125003,"_5":14424,"_27663":124963,"_2970":57725},[],{"_3487":73254,"_30445":73237,"_21099":125005,"_5":14424,"_27663":124963,"_2970":125006},[],"PEM correcto y firma verificable.",{"_3487":73255,"_30445":73237,"_21099":125008,"_5":14424,"_27663":124963,"_2970":57731},[],{"_3487":73256,"_30445":73237,"_21099":125010,"_5":14424,"_27663":124963,"_2970":125011},[],"Perfil",{"_3487":73257,"_30445":73237,"_21099":125013,"_5":14424,"_27663":124963,"_2970":125014},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3487":73258,"_30445":73237,"_21099":125016,"_5":14424,"_27663":124963,"_2970":125017},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3487":73259,"_30445":73237,"_21099":125019,"_5":14424,"_27663":124963,"_2970":122261},[],{"_3487":73260,"_30445":73237,"_21099":125021,"_5":14424,"_27663":124963,"_2970":125022},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3487":73261,"_30445":73237,"_21099":125024,"_5":14424,"_27663":124963,"_2970":125025},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3487":73262,"_30445":73237,"_21099":125027,"_5":14424,"_27663":124963,"_2970":125028},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3487":73263,"_30445":73237,"_21099":125030,"_5":14424,"_27663":124963,"_2970":125031},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3487":73264,"_30445":73237,"_21099":125033,"_5":14424,"_27663":124967,"_2970":125034},[],"Revisa cada frontera por separado:",{"_3487":73265,"_30445":73237,"_21099":125036,"_5":14424,"_27663":124967,"_2970":125037},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3487":73266,"_30445":73237,"_21099":125039,"_5":14424,"_27663":124967,"_2970":125040},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3487":73267,"_30445":73237,"_21099":125042,"_5":14424,"_27663":124967,"_2970":125043},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3487":73268,"_30445":73237,"_21099":125045,"_5":14424,"_27663":124967,"_2970":125046},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3487":73269,"_30445":73237,"_21099":125048,"_5":14424,"_27663":124967,"_2970":125049},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3487":73270,"_30445":73237,"_21099":125051,"_5":14424,"_27663":124967,"_2970":125052},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3487":73271,"_30445":73237,"_21099":125054,"_5":14424,"_27663":124971,"_2970":125055},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3487":73272,"_30445":73237,"_21099":125057,"_5":14424,"_27663":124971,"_2970":125058},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3487":73273,"_30445":73273,"_5":14788,"_2970":125060,"_30797":125061,"_21099":125062,"_27663":73273},"Seguridad",[49622],[],{"_3487":73274,"_30445":73273,"_21099":125064,"_5":14424,"_27663":73273,"_2970":125065},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3487":73275,"_30445":73273,"_5":30794,"_21099":125067,"_27663":125068,"_2970":125069},[],"/docs/pr-preview/pr-68/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3487":73276,"_30445":73273,"_5":30794,"_21099":125071,"_27663":125072,"_2970":125073},[],"/docs/pr-preview/pr-68/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3487":73277,"_30445":73273,"_5":30794,"_21099":125075,"_27663":125076,"_2970":125077},[],"/docs/pr-preview/pr-68/es/security#versiones-soportadas","Versiones soportadas",{"_3487":73278,"_30445":73273,"_5":30794,"_21099":125079,"_27663":125080,"_2970":125081},[],"/docs/pr-preview/pr-68/es/security#divulgación-responsable","Divulgación responsable",{"_3487":73279,"_30445":73273,"_21099":125083,"_5":14424,"_27663":73273,"_2970":125084},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3487":73280,"_30445":73273,"_21099":125086,"_5":14424,"_27663":125068,"_2970":125087},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3487":73281,"_30445":73273,"_21099":125089,"_5":14424,"_27663":125068,"_2970":125090},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3487":73282,"_30445":73273,"_21099":125092,"_5":14424,"_27663":125068,"_2970":15158},[],{"_3487":73283,"_30445":73273,"_21099":125094,"_5":14424,"_27663":125068,"_2970":15000},[],{"_3487":73284,"_30445":73273,"_21099":125096,"_5":14424,"_27663":125068,"_2970":15047},[],{"_3487":73285,"_30445":73273,"_21099":125098,"_5":14424,"_27663":125068,"_2970":125099},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3487":73286,"_30445":73273,"_21099":125101,"_5":14424,"_27663":125068,"_2970":125102},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3487":73287,"_30445":73273,"_21099":125104,"_5":14424,"_27663":125072,"_2970":125105},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3487":73288,"_30445":73273,"_21099":125107,"_5":14424,"_27663":125072,"_2970":125108},[],"No incluyas en el reporte:",{"_3487":73289,"_30445":73273,"_21099":125110,"_5":14424,"_27663":125072,"_2970":125111},[],"Credenciales, tokens o claves privadas",{"_3487":73290,"_30445":73273,"_21099":125113,"_5":14424,"_27663":125072,"_2970":125114},[],"Datos de clientes o información identificable de clientes",{"_3487":73291,"_30445":73273,"_21099":125116,"_5":14424,"_27663":125072,"_2970":125117},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3487":73292,"_30445":73273,"_21099":125119,"_5":14424,"_27663":125076,"_2970":125120},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3487":73293,"_30445":73273,"_21099":125122,"_5":14424,"_27663":125076,"_2970":125123},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3487":73294,"_30445":73273,"_21099":125125,"_5":14424,"_27663":125080,"_2970":125126},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3487":73295,"_30445":73273,"_21099":125128,"_5":14424,"_27663":125080,"_2970":125129},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3487":73296,"_30445":73273,"_21099":125131,"_5":14424,"_27663":125080,"_2970":125132},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3487":73297,"_30445":73273,"_21099":125134,"_5":14424,"_27663":125080,"_2970":125135},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3487":73298,"_30445":73273,"_21099":125137,"_5":14424,"_27663":125080,"_2970":125138},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3487":73299,"_30445":73299,"_5":14788,"_2970":125140,"_30797":125141,"_21099":125143,"_27663":73299},"3.8.0 a 4.0.0",[49622,125142],"Actualizaciones",[],{"_3487":73300,"_30445":73299,"_21099":125145,"_5":14424,"_27663":73299,"_2970":125146},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3487":73301,"_30445":73299,"_5":30794,"_21099":125148,"_27663":125149,"_2970":125150},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3487":73302,"_30445":73299,"_5":30794,"_21099":125152,"_27663":125153,"_2970":125154},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3487":73303,"_30445":73299,"_5":30794,"_21099":125156,"_27663":125157,"_2970":125158},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3487":73304,"_30445":73299,"_5":30794,"_21099":125160,"_27663":125161,"_2970":125162},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3487":73305,"_30445":73299,"_5":30794,"_21099":125164,"_27663":125165,"_2970":125166},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3487":73306,"_30445":73299,"_5":30794,"_21099":125168,"_27663":125169,"_2970":125170},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3487":73307,"_30445":73299,"_5":30794,"_21099":125172,"_27663":125173,"_2970":57897},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3487":73308,"_30445":73299,"_5":30794,"_21099":125175,"_27663":125176,"_2970":125177},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3487":73309,"_30445":73299,"_5":30794,"_21099":125179,"_27663":125180,"_2970":125181},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3487":73310,"_30445":73299,"_5":30794,"_21099":125183,"_27663":125184,"_2970":125185},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3487":73311,"_30445":73299,"_5":30794,"_21099":125187,"_27663":125188,"_2970":125189},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3487":73312,"_30445":73299,"_5":30794,"_21099":125191,"_27663":125192,"_2970":125193},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3487":73313,"_30445":73299,"_5":30794,"_21099":125195,"_27663":125196,"_2970":125197},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3487":73314,"_30445":73299,"_5":30794,"_21099":125199,"_27663":125200,"_2970":125201},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3487":73315,"_30445":73299,"_5":30794,"_21099":125203,"_27663":125204,"_2970":125205},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3487":73316,"_30445":73299,"_5":30794,"_21099":125207,"_27663":125208,"_2970":125209},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3487":73317,"_30445":73299,"_5":30794,"_21099":125211,"_27663":125212,"_2970":125213},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3487":73318,"_30445":73299,"_5":30794,"_21099":125215,"_27663":125216,"_2970":125217},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3487":73319,"_30445":73299,"_5":30794,"_21099":125219,"_27663":125220,"_2970":125221},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3487":73320,"_30445":73299,"_5":30794,"_21099":125223,"_27663":125224,"_2970":125225},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3487":73321,"_30445":73299,"_5":30794,"_21099":125227,"_27663":125228,"_2970":125229},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3487":73322,"_30445":73299,"_5":30794,"_21099":125231,"_27663":125232,"_2970":125233},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3487":73323,"_30445":73299,"_5":30794,"_21099":125235,"_27663":125236,"_2970":125237},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3487":73324,"_30445":73299,"_5":30794,"_21099":125239,"_27663":125240,"_2970":125241},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3487":73325,"_30445":73299,"_5":30794,"_21099":125243,"_27663":125244,"_2970":125245},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3487":73326,"_30445":73299,"_5":30794,"_21099":125247,"_27663":125248,"_2970":125249},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3487":73327,"_30445":73299,"_5":30794,"_21099":125251,"_27663":125252,"_2970":125253},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3487":73328,"_30445":73299,"_5":30794,"_21099":125255,"_27663":125256,"_2970":125257},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3487":73329,"_30445":73299,"_5":30794,"_21099":125259,"_27663":125260,"_2970":125261},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3487":73330,"_30445":73299,"_5":30794,"_21099":125263,"_27663":125264,"_2970":125265},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3487":73331,"_30445":73299,"_5":30794,"_21099":125267,"_27663":125268,"_2970":125269},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3487":73332,"_30445":73299,"_5":30794,"_21099":125271,"_27663":125272,"_2970":125273},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3487":73333,"_30445":73299,"_5":30794,"_21099":125275,"_27663":125276,"_2970":125277},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3487":73334,"_30445":73299,"_5":30794,"_21099":125279,"_27663":125280,"_2970":125281},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3487":73335,"_30445":73299,"_5":30794,"_21099":125283,"_27663":125284,"_2970":125285},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3487":73336,"_30445":73299,"_5":30794,"_21099":125287,"_27663":125288,"_2970":125289},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3487":73337,"_30445":73299,"_5":30794,"_21099":125291,"_27663":125292,"_2970":125293},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3487":73338,"_30445":73299,"_5":30794,"_21099":125295,"_27663":125296,"_2970":125297},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3487":73339,"_30445":73299,"_5":30794,"_21099":125299,"_27663":125300,"_2970":125301},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3487":73340,"_30445":73299,"_5":30794,"_21099":125303,"_27663":125304,"_2970":125305},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3487":73341,"_30445":73299,"_5":30794,"_21099":125307,"_27663":125308,"_2970":121124},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3487":73342,"_30445":73299,"_5":30794,"_21099":125310,"_27663":125311,"_2970":125312},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3487":73343,"_30445":73299,"_5":30794,"_21099":125314,"_27663":125315,"_2970":125316},[],"/docs/pr-preview/pr-68/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3487":73344,"_30445":73299,"_21099":125318,"_5":14424,"_27663":73299,"_2970":125319},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3487":73345,"_30445":73299,"_21099":125321,"_5":14424,"_27663":73299,"_2970":125322},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3487":73346,"_30445":73299,"_21099":125324,"_5":14424,"_27663":73299,"_2970":125325},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3487":73347,"_30445":73299,"_21099":125327,"_5":14424,"_27663":73299,"_2970":125328},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3487":73348,"_30445":73299,"_21099":125330,"_5":14424,"_27663":73299,"_2970":125331},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3487":73349,"_30445":73299,"_21099":125333,"_5":14424,"_27663":73299,"_2970":125334},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3487":73350,"_30445":73299,"_21099":125336,"_5":14424,"_27663":73299,"_2970":125337},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3487":73351,"_30445":73299,"_21099":125339,"_5":14424,"_27663":125153,"_2970":125340},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3487":73352,"_30445":73299,"_21099":125342,"_5":14424,"_27663":125153,"_2970":125343},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3487":73353,"_30445":73299,"_21099":125345,"_5":14424,"_27663":125157,"_2970":125346},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3487":73354,"_30445":73299,"_21099":125348,"_5":14424,"_27663":125157,"_2970":125349},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3487":73355,"_30445":73299,"_21099":125351,"_5":14424,"_27663":125161,"_2970":125352},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3487":73356,"_30445":73299,"_21099":125354,"_5":14424,"_27663":125165,"_2970":125355},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3487":73357,"_30445":73299,"_21099":125357,"_5":14424,"_27663":125165,"_2970":125358},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3487":73358,"_30445":73299,"_21099":125360,"_5":14424,"_27663":125165,"_2970":125361},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3487":73359,"_30445":73299,"_21099":125363,"_5":14424,"_27663":125165,"_2970":125364},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3487":73360,"_30445":73299,"_21099":125366,"_5":14424,"_27663":125165,"_2970":125367},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3487":73361,"_30445":73299,"_21099":125369,"_5":14424,"_27663":125169,"_2970":125370},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3487":73362,"_30445":73299,"_21099":125372,"_5":14424,"_27663":125169,"_2970":125373},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3487":73363,"_30445":73299,"_21099":125375,"_5":14424,"_27663":125169,"_2970":125376},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3487":73364,"_30445":73299,"_21099":125378,"_5":14424,"_27663":125169,"_2970":125379},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3487":73365,"_30445":73299,"_21099":125381,"_5":14424,"_27663":125169,"_2970":125382},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3487":73366,"_30445":73299,"_21099":125384,"_5":14424,"_27663":125169,"_2970":125385},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3487":73367,"_30445":73299,"_21099":125387,"_5":14424,"_27663":125173,"_2970":125388},[],"Cambio",{"_3487":73368,"_30445":73299,"_21099":125390,"_5":14424,"_27663":125173,"_2970":125391},[],"A quién afecta",{"_3487":73369,"_30445":73299,"_21099":125393,"_5":14424,"_27663":125173,"_2970":125394},[],"Gravedad",{"_3487":73370,"_30445":73299,"_21099":125396,"_5":14424,"_27663":125173,"_2970":123894},[],{"_3487":73371,"_30445":73299,"_21099":125398,"_5":14424,"_27663":125173,"_2970":125181},[],{"_3487":73372,"_30445":73299,"_21099":125400,"_5":14424,"_27663":125173,"_2970":125401},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3487":73373,"_30445":73299,"_21099":125403,"_5":14424,"_27663":125173,"_2970":125404},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3487":73374,"_30445":73299,"_21099":125406,"_5":14424,"_27663":125173,"_2970":125407},[],"Copiar los datos a los volúmenes nuevos",{"_3487":73375,"_30445":73299,"_21099":125409,"_5":14424,"_27663":125173,"_2970":125185},[],{"_3487":73376,"_30445":73299,"_21099":125411,"_5":14424,"_27663":125173,"_2970":125412},[],"Todas las releases de Helm",{"_3487":73377,"_30445":73299,"_21099":125414,"_5":14424,"_27663":125173,"_2970":125415},[],"Alta: `helm upgrade` falla",{"_3487":73378,"_30445":73299,"_21099":125417,"_5":14424,"_27663":125173,"_2970":125418},[],"Eliminar o renombrar las claves heredadas",{"_3487":73379,"_30445":73299,"_21099":125420,"_5":14424,"_27663":125173,"_2970":125189},[],{"_3487":73380,"_30445":73299,"_21099":125422,"_5":14424,"_27663":125173,"_2970":125423},[],"Todos los despliegues",{"_3487":73381,"_30445":73299,"_21099":125425,"_5":14424,"_27663":125173,"_2970":125426},[],"Alta: sin principal de bootstrap no hay administrador",{"_3487":73382,"_30445":73299,"_21099":125428,"_5":14424,"_27663":125173,"_2970":125429},[],"Configurar `services.authz`",{"_3487":73383,"_30445":73299,"_21099":125431,"_5":14424,"_27663":125173,"_2970":125193},[],{"_3487":73384,"_30445":73299,"_21099":125433,"_5":14424,"_27663":125173,"_2970":125412},[],{"_3487":73385,"_30445":73299,"_21099":125435,"_5":14424,"_27663":125173,"_2970":125436},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3487":73386,"_30445":73299,"_21099":125438,"_5":14424,"_27663":125173,"_2970":125439},[],"Mover JWKS y roles a `services.authz`",{"_3487":73387,"_30445":73299,"_21099":125441,"_5":14424,"_27663":125173,"_2970":125213},[],{"_3487":73388,"_30445":73299,"_21099":125443,"_5":14424,"_27663":125173,"_2970":125444},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3487":73389,"_30445":73299,"_21099":125446,"_5":14424,"_27663":125173,"_2970":125447},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3487":73390,"_30445":73299,"_21099":125449,"_5":14424,"_27663":125173,"_2970":125450},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3487":73391,"_30445":73299,"_21099":125452,"_5":14424,"_27663":125173,"_2970":125217},[],{"_3487":73392,"_30445":73299,"_21099":125454,"_5":14424,"_27663":125173,"_2970":125455},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3487":73393,"_30445":73299,"_21099":125457,"_5":14424,"_27663":125173,"_2970":125458},[],"Alta: el backend ya no arranca con ellos",{"_3487":73394,"_30445":73299,"_21099":125460,"_5":14424,"_27663":125173,"_2970":125461},[],"Pasar a PostgreSQL antes de actualizar",{"_3487":73395,"_30445":73299,"_21099":125463,"_5":14424,"_27663":125173,"_2970":125261},[],{"_3487":73396,"_30445":73299,"_21099":125465,"_5":14424,"_27663":125173,"_2970":125466},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3487":73397,"_30445":73299,"_21099":125468,"_5":14424,"_27663":125173,"_2970":125469},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3487":73398,"_30445":73299,"_21099":125471,"_5":14424,"_27663":125173,"_2970":125472},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3487":73399,"_30445":73299,"_21099":125474,"_5":14424,"_27663":125173,"_2970":125475},[],"Webhooks con referencias a archivos",{"_3487":73400,"_30445":73299,"_21099":125477,"_5":14424,"_27663":125173,"_2970":125478},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3487":73401,"_30445":73299,"_21099":125480,"_5":14424,"_27663":125173,"_2970":125481},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3487":73402,"_30445":73299,"_21099":125483,"_5":14424,"_27663":125173,"_2970":125484},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3487":73403,"_30445":73299,"_21099":125486,"_5":14424,"_27663":125173,"_2970":125197},[],{"_3487":73404,"_30445":73299,"_21099":125488,"_5":14424,"_27663":125173,"_2970":125489},[],"Releases con identidades por servicio o material de claves montado",{"_3487":73405,"_30445":73299,"_21099":125491,"_5":14424,"_27663":125173,"_2970":125492},[],"Media: los servicios no pueden leer sus archivos",{"_3487":73406,"_30445":73299,"_21099":125494,"_5":14424,"_27663":125173,"_2970":125495},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3487":73407,"_30445":73299,"_21099":125497,"_5":14424,"_27663":125173,"_2970":125201},[],{"_3487":73408,"_30445":73299,"_21099":125499,"_5":14424,"_27663":125173,"_2970":125500},[],"Releases que definen `amqp.tls`",{"_3487":73409,"_30445":73299,"_21099":125502,"_5":14424,"_27663":125173,"_2970":125503},[],"Media: los clientes se conectan al puerto equivocado",{"_3487":73410,"_30445":73299,"_21099":125505,"_5":14424,"_27663":125173,"_2970":125506},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3487":73411,"_30445":73299,"_21099":125508,"_5":14424,"_27663":125173,"_2970":125221},[],{"_3487":73412,"_30445":73299,"_21099":125510,"_5":14424,"_27663":125173,"_2970":125511},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3487":73413,"_30445":73299,"_21099":125513,"_5":14424,"_27663":125173,"_2970":125514},[],"Media: las claves de CA quedan sin gestionar",{"_3487":73414,"_30445":73299,"_21099":125516,"_5":14424,"_27663":125173,"_2970":125517},[],"Ejecutar la migración de CA a KMS",{"_3487":73415,"_30445":73299,"_21099":125519,"_5":14424,"_27663":125173,"_2970":125520},[],"Verificación del certificado del receptor",{"_3487":73416,"_30445":73299,"_21099":125522,"_5":14424,"_27663":125173,"_2970":125523},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3487":73417,"_30445":73299,"_21099":125525,"_5":14424,"_27663":125173,"_2970":125526},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3487":73418,"_30445":73299,"_21099":125528,"_5":14424,"_27663":125173,"_2970":125529},[],"Poner `insecure_skip_verify` a `false`",{"_3487":73419,"_30445":73299,"_21099":125531,"_5":14424,"_27663":125173,"_2970":125237},[],{"_3487":73420,"_30445":73299,"_21099":125533,"_5":14424,"_27663":125173,"_2970":125534},[],"Scripts y consolas que editan DMS por API",{"_3487":73421,"_30445":73299,"_21099":125536,"_5":14424,"_27663":125173,"_2970":125537},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3487":73422,"_30445":73299,"_21099":125539,"_5":14424,"_27663":125173,"_2970":125540},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3487":73423,"_30445":73299,"_21099":125542,"_5":14424,"_27663":125173,"_2970":125257},[],{"_3487":73424,"_30445":73299,"_21099":125544,"_5":14424,"_27663":125173,"_2970":125545},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3487":73425,"_30445":73299,"_21099":125547,"_5":14424,"_27663":125173,"_2970":125548},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3487":73426,"_30445":73299,"_21099":125550,"_5":14424,"_27663":125173,"_2970":125551},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3487":73427,"_30445":73299,"_21099":125553,"_5":14424,"_27663":125173,"_2970":125265},[],{"_3487":73428,"_30445":73299,"_21099":125555,"_5":14424,"_27663":125173,"_2970":125556},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3487":73429,"_30445":73299,"_21099":125558,"_5":14424,"_27663":125173,"_2970":125559},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3487":73430,"_30445":73299,"_21099":125561,"_5":14424,"_27663":125173,"_2970":125562},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3487":73431,"_30445":73299,"_21099":125564,"_5":14424,"_27663":125173,"_2970":125253},[],{"_3487":73432,"_30445":73299,"_21099":125566,"_5":14424,"_27663":125173,"_2970":125567},[],"Consumidores que leen el campo `events` del dispositivo",{"_3487":73433,"_30445":73299,"_21099":125569,"_5":14424,"_27663":125173,"_2970":125570},[],"Media: el campo desaparece",{"_3487":73434,"_30445":73299,"_21099":125572,"_5":14424,"_27663":125173,"_2970":125573},[],"Usar los nuevos endpoints de eventos",{"_3487":73435,"_30445":73299,"_21099":125575,"_5":14424,"_27663":125173,"_2970":125273},[],{"_3487":73436,"_30445":73299,"_21099":125577,"_5":14424,"_27663":125173,"_2970":125578},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3487":73437,"_30445":73299,"_21099":125580,"_5":14424,"_27663":125173,"_2970":125581},[],"Media: la migración de la VA aborta",{"_3487":73438,"_30445":73299,"_21099":125583,"_5":14424,"_27663":125173,"_2970":125584},[],"Corregir los roles afectados antes de actualizar",{"_3487":73439,"_30445":73299,"_21099":125586,"_5":14424,"_27663":125173,"_2970":125205},[],{"_3487":73440,"_30445":73299,"_21099":125588,"_5":14424,"_27663":125173,"_2970":125589},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3487":73441,"_30445":73299,"_21099":125591,"_5":14424,"_27663":125173,"_2970":125592},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3487":73442,"_30445":73299,"_21099":125594,"_5":14424,"_27663":125173,"_2970":125595},[],"Actualizar el archivo de values",{"_3487":73443,"_30445":73299,"_21099":125597,"_5":14424,"_27663":125173,"_2970":125245},[],{"_3487":73444,"_30445":73299,"_21099":125599,"_5":14424,"_27663":125173,"_2970":125600},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3487":73445,"_30445":73299,"_21099":125602,"_5":14424,"_27663":125173,"_2970":125603},[],"Baja: prevalece el ID de la URL",{"_3487":73446,"_30445":73299,"_21099":125605,"_5":14424,"_27663":125173,"_2970":125606},[],"Enviar el ID en la URL",{"_3487":73447,"_30445":73299,"_21099":125608,"_5":14424,"_27663":125173,"_2970":125269},[],{"_3487":73448,"_30445":73299,"_21099":125610,"_5":14424,"_27663":125173,"_2970":125611},[],"Clientes que envían un `id` al crear o importar CAs",{"_3487":73449,"_30445":73299,"_21099":125613,"_5":14424,"_27663":125173,"_2970":125614},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3487":73450,"_30445":73299,"_21099":125616,"_5":14424,"_27663":125173,"_2970":125617},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3487":73451,"_30445":73299,"_21099":125619,"_5":14424,"_27663":125173,"_2970":125249},[],{"_3487":73452,"_30445":73299,"_21099":125621,"_5":14424,"_27663":125173,"_2970":125622},[],"Consumidores que comparan el `type` del certificado",{"_3487":73453,"_30445":73299,"_21099":125624,"_5":14424,"_27663":125173,"_2970":125625},[],"Baja: dos valores cambian de nombre",{"_3487":73454,"_30445":73299,"_21099":125627,"_5":14424,"_27663":125173,"_2970":125628},[],"Adaptar los consumidores",{"_3487":73455,"_30445":73299,"_21099":125630,"_5":14424,"_27663":125173,"_2970":125241},[],{"_3487":73456,"_30445":73299,"_21099":125632,"_5":14424,"_27663":125173,"_2970":125633},[],"Cualquier DMS",{"_3487":73457,"_30445":73299,"_21099":125635,"_5":14424,"_27663":125173,"_2970":125636},[],"Baja: solo informativo",{"_3487":73458,"_30445":73299,"_21099":125638,"_5":14424,"_27663":125173,"_2970":125639},[],"Revisar ambos bloques antes de editar",{"_3487":73459,"_30445":73299,"_21099":125641,"_5":14424,"_27663":125180,"_2970":125642},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3487":73460,"_30445":73299,"_21099":125644,"_5":14424,"_27663":125180,"_2970":125645},[],"El paso 4 de la guía de migración copia los datos.",{"_3487":73461,"_30445":73299,"_21099":125647,"_5":14424,"_27663":125184,"_2970":125648},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3487":73462,"_30445":73299,"_21099":125650,"_5":14424,"_27663":125188,"_2970":125651},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3487":73463,"_30445":73299,"_21099":125653,"_5":14424,"_27663":125192,"_2970":125654},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3487":73464,"_30445":73299,"_21099":125656,"_5":14424,"_27663":125196,"_2970":125657},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3487":73465,"_30445":73299,"_21099":125659,"_5":14424,"_27663":125196,"_2970":125660},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3487":73466,"_30445":73299,"_21099":125662,"_5":14424,"_27663":125200,"_2970":125663},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3487":73467,"_30445":73299,"_21099":125665,"_5":14424,"_27663":125204,"_2970":125666},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3487":73468,"_30445":73299,"_21099":125668,"_5":14424,"_27663":125204,"_2970":125669},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3487":73469,"_30445":73299,"_21099":125671,"_5":14424,"_27663":125204,"_2970":125672},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3487":73470,"_30445":73299,"_21099":125674,"_5":14424,"_27663":125204,"_2970":125675},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3487":73471,"_30445":73299,"_21099":125677,"_5":14424,"_27663":125204,"_2970":125678},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3487":73472,"_30445":73299,"_21099":125680,"_5":14424,"_27663":125204,"_2970":125681},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3487":73473,"_30445":73299,"_21099":125683,"_5":14424,"_27663":125212,"_2970":125684},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3487":73474,"_30445":73299,"_21099":125686,"_5":14424,"_27663":125212,"_2970":125687},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3487":73475,"_30445":73299,"_21099":125689,"_5":14424,"_27663":125212,"_2970":125690},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3487":73476,"_30445":73299,"_21099":125692,"_5":14424,"_27663":125212,"_2970":125693},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3487":73477,"_30445":73299,"_21099":125695,"_5":14424,"_27663":125212,"_2970":125696},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3487":73478,"_30445":73299,"_21099":125698,"_5":14424,"_27663":125216,"_2970":125699},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3487":73479,"_30445":73299,"_21099":125701,"_5":14424,"_27663":125220,"_2970":125702},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3487":73480,"_30445":73299,"_21099":125704,"_5":14424,"_27663":125220,"_2970":125705},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3487":73481,"_30445":73299,"_21099":125707,"_5":14424,"_27663":125220,"_2970":125708},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3487":73482,"_30445":73299,"_21099":125710,"_5":14424,"_27663":125220,"_2970":125711},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3487":73483,"_30445":73299,"_21099":125713,"_5":14424,"_27663":125220,"_2970":125714},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3487":73484,"_30445":73299,"_21099":125716,"_5":14424,"_27663":125220,"_2970":125717},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3487":73485,"_30445":73299,"_21099":125719,"_5":14424,"_27663":125220,"_2970":125720},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3487":73486,"_30445":73299,"_21099":125722,"_5":14424,"_27663":125220,"_2970":125723},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3487":73487,"_30445":73299,"_21099":125725,"_5":14424,"_27663":125224,"_2970":125726},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3487":73488,"_30445":73299,"_21099":125728,"_5":14424,"_27663":125232,"_2970":125729},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3487":73489,"_30445":73299,"_21099":125731,"_5":14424,"_27663":125232,"_2970":125732},[],"Campo en 3.8.0",{"_3487":73490,"_30445":73299,"_21099":125734,"_5":14424,"_27663":125232,"_2970":125735},[],"Campo en 4.0.0",{"_3487":73491,"_30445":73299,"_21099":125737,"_5":14424,"_27663":125232,"_2970":58462},[],{"_3487":73492,"_30445":73299,"_21099":125739,"_5":14424,"_27663":125232,"_2970":125740},[],"`insecure_skip_verify` (con el valor negado)",{"_3487":73493,"_30445":73299,"_21099":125742,"_5":14424,"_27663":125232,"_2970":58468},[],{"_3487":73494,"_30445":73299,"_21099":125744,"_5":14424,"_27663":125232,"_2970":58471},[],{"_3487":73495,"_30445":73299,"_21099":125746,"_5":14424,"_27663":125232,"_2970":58474},[],{"_3487":73496,"_30445":73299,"_21099":125748,"_5":14424,"_27663":125232,"_2970":58477},[],{"_3487":73497,"_30445":73299,"_21099":125750,"_5":14424,"_27663":125232,"_2970":58480},[],{"_3487":73498,"_30445":73299,"_21099":125752,"_5":14424,"_27663":125232,"_2970":58483},[],{"_3487":73499,"_30445":73299,"_21099":125754,"_5":14424,"_27663":125232,"_2970":125755},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3487":73500,"_30445":73299,"_21099":125757,"_5":14424,"_27663":125232,"_2970":125758},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3487":73501,"_30445":73299,"_21099":125760,"_5":14424,"_27663":125232,"_2970":125761},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3487":73502,"_30445":73299,"_21099":125763,"_5":14424,"_27663":125236,"_2970":125764},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3487":73503,"_30445":73299,"_21099":125766,"_5":14424,"_27663":125236,"_2970":125767},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3487":73504,"_30445":73299,"_21099":125769,"_5":14424,"_27663":125236,"_2970":125770},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3487":73505,"_30445":73299,"_21099":125772,"_5":14424,"_27663":125240,"_2970":125773},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3487":73506,"_30445":73299,"_21099":125775,"_5":14424,"_27663":125244,"_2970":125776},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3487":73507,"_30445":73299,"_21099":125778,"_5":14424,"_27663":125248,"_2970":125779},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3487":73508,"_30445":73299,"_21099":125781,"_5":14424,"_27663":125252,"_2970":125782},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3487":73509,"_30445":73299,"_21099":125784,"_5":14424,"_27663":125252,"_2970":125785},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3487":73510,"_30445":73299,"_21099":125787,"_5":14424,"_27663":125252,"_2970":125788},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3487":73511,"_30445":73299,"_21099":125790,"_5":14424,"_27663":125252,"_2970":125791},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3487":73512,"_30445":73299,"_21099":125793,"_5":14424,"_27663":125256,"_2970":125794},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3487":73513,"_30445":73299,"_21099":125796,"_5":14424,"_27663":125260,"_2970":125797},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3487":73514,"_30445":73299,"_21099":125799,"_5":14424,"_27663":125260,"_2970":125800},[],"Ruta",{"_3487":73515,"_30445":73299,"_21099":125802,"_5":14424,"_27663":125260,"_2970":118354},[],{"_3487":73516,"_30445":73299,"_21099":125804,"_5":14424,"_27663":125260,"_2970":58536},[],{"_3487":73517,"_30445":73299,"_21099":125806,"_5":14424,"_27663":125260,"_2970":125807},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3487":73518,"_30445":73299,"_21099":125809,"_5":14424,"_27663":125260,"_2970":58542},[],{"_3487":73519,"_30445":73299,"_21099":125811,"_5":14424,"_27663":125260,"_2970":125812},[],"Lee los ajustes de una CA.",{"_3487":73520,"_30445":73299,"_21099":125814,"_5":14424,"_27663":125260,"_2970":58548},[],{"_3487":73521,"_30445":73299,"_21099":125816,"_5":14424,"_27663":125260,"_2970":125817},[],"Sustituye los `crl_options`.",{"_3487":73522,"_30445":73299,"_21099":125819,"_5":14424,"_27663":125260,"_2970":125820},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3487":73523,"_30445":73299,"_21099":125822,"_5":14424,"_27663":125260,"_2970":125823},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3487":73524,"_30445":73299,"_21099":125825,"_5":14424,"_27663":125260,"_2970":125826},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3487":73525,"_30445":73299,"_21099":125828,"_5":14424,"_27663":125260,"_2970":125829},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3487":73526,"_30445":73299,"_21099":125831,"_5":14424,"_27663":125260,"_2970":125832},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3487":73527,"_30445":73299,"_21099":125834,"_5":14424,"_27663":125260,"_2970":125835},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3487":73528,"_30445":73299,"_21099":125837,"_5":14424,"_27663":125260,"_2970":125838},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3487":73529,"_30445":73299,"_21099":125840,"_5":14424,"_27663":125260,"_2970":125841},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3487":73530,"_30445":73299,"_21099":125843,"_5":14424,"_27663":125260,"_2970":125844},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3487":73531,"_30445":73299,"_21099":125846,"_5":14424,"_27663":125260,"_2970":125847},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3487":73532,"_30445":73299,"_21099":125849,"_5":14424,"_27663":125260,"_2970":125850},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3487":73533,"_30445":73299,"_21099":125852,"_5":14424,"_27663":125264,"_2970":125853},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3487":73534,"_30445":73299,"_21099":125855,"_5":14424,"_27663":125268,"_2970":125856},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3487":73535,"_30445":73299,"_21099":125858,"_5":14424,"_27663":125272,"_2970":125859},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3487":73536,"_30445":73299,"_21099":125861,"_5":14424,"_27663":125276,"_2970":125862},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3487":73537,"_30445":73299,"_21099":125864,"_5":14424,"_27663":125280,"_2970":125865},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3487":73538,"_30445":73299,"_21099":125867,"_5":14424,"_27663":125280,"_2970":125868},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3487":73539,"_30445":73299,"_21099":125870,"_5":14424,"_27663":125280,"_2970":125871},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3487":73540,"_30445":73299,"_21099":125873,"_5":14424,"_27663":125280,"_2970":125874},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3487":73541,"_30445":73299,"_21099":125876,"_5":14424,"_27663":125280,"_2970":125877},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3487":73542,"_30445":73299,"_21099":125879,"_5":14424,"_27663":125280,"_2970":125880},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3487":73543,"_30445":73299,"_21099":125882,"_5":14424,"_27663":125284,"_2970":125883},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3487":73544,"_30445":73299,"_21099":125885,"_5":14424,"_27663":125284,"_2970":125886},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3487":73545,"_30445":73299,"_21099":125888,"_5":14424,"_27663":125284,"_2970":125889},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3487":73546,"_30445":73299,"_21099":125891,"_5":14424,"_27663":125284,"_2970":125892},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3487":73547,"_30445":73299,"_21099":125894,"_5":14424,"_27663":125284,"_2970":125895},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3487":73548,"_30445":73299,"_21099":125897,"_5":14424,"_27663":125288,"_2970":125898},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3487":73549,"_30445":73299,"_21099":125900,"_5":14424,"_27663":125288,"_2970":125901},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3487":73550,"_30445":73299,"_21099":125903,"_5":14424,"_27663":125288,"_2970":125904},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`. Cada schema puede además definir su propio usuario y contraseña mediante las variables de entorno `LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_USERNAME` y `LAMASSU_AUTHZ_CREDENTIALS_<SCHEMA>_PASSWORD`, que tienen prioridad sobre los values globales `postgres.username` y `postgres.password` cuando están definidas. Consulta Variables de entorno para credenciales.",{"_3487":73551,"_30445":73299,"_21099":125906,"_5":14424,"_27663":125288,"_2970":125907},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3487":73552,"_30445":73299,"_21099":125909,"_5":14424,"_27663":125288,"_2970":125910},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3487":73553,"_30445":73299,"_21099":125912,"_5":14424,"_27663":125288,"_2970":125913},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3487":73554,"_30445":73299,"_21099":125915,"_5":14424,"_27663":125288,"_2970":125916},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3487":73555,"_30445":73299,"_21099":125918,"_5":14424,"_27663":125288,"_2970":125919},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3487":73556,"_30445":73299,"_21099":125921,"_5":14424,"_27663":125288,"_2970":125922},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3487":73557,"_30445":73299,"_21099":125924,"_5":14424,"_27663":125288,"_2970":125925},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3487":73558,"_30445":73299,"_21099":125927,"_5":14424,"_27663":125288,"_2970":125928},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3487":73559,"_30445":73299,"_21099":125930,"_5":14424,"_27663":125288,"_2970":125931},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3487":73560,"_30445":73299,"_21099":125933,"_5":14424,"_27663":125292,"_2970":125934},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3487":73561,"_30445":73299,"_21099":125936,"_5":14424,"_27663":125292,"_2970":125937},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3487":73562,"_30445":73299,"_21099":125939,"_5":14424,"_27663":125296,"_2970":125940},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3487":73563,"_30445":73299,"_21099":125942,"_5":14424,"_27663":125296,"_2970":125943},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3487":73564,"_30445":73299,"_21099":125945,"_5":14424,"_27663":125296,"_2970":125946},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3487":73565,"_30445":73299,"_21099":125948,"_5":14424,"_27663":125296,"_2970":125949},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3487":73566,"_30445":73299,"_21099":125951,"_5":14424,"_27663":125296,"_2970":125952},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3487":73567,"_30445":73299,"_21099":125954,"_5":14424,"_27663":125296,"_2970":125955},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3487":73568,"_30445":73299,"_21099":125957,"_5":14424,"_27663":125296,"_2970":125958},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3487":73569,"_30445":73299,"_21099":125960,"_5":14424,"_27663":125296,"_2970":125961},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3487":73570,"_30445":73299,"_21099":125963,"_5":14424,"_27663":125296,"_2970":125964},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3487":73571,"_30445":73299,"_21099":125966,"_5":14424,"_27663":125296,"_2970":125967},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3487":73572,"_30445":73299,"_21099":125969,"_5":14424,"_27663":125296,"_2970":125970},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3487":73573,"_30445":73299,"_21099":125972,"_5":14424,"_27663":125300,"_2970":125973},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3487":73574,"_30445":73299,"_21099":125975,"_5":14424,"_27663":125300,"_2970":125976},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3487":73575,"_30445":73299,"_21099":125978,"_5":14424,"_27663":125304,"_2970":125979},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3487":73576,"_30445":73299,"_21099":125981,"_5":14424,"_27663":125304,"_2970":125982},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3487":73577,"_30445":73299,"_21099":125984,"_5":14424,"_27663":125304,"_2970":125985},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3487":73578,"_30445":73299,"_21099":125987,"_5":14424,"_27663":125304,"_2970":125988},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3487":73579,"_30445":73299,"_21099":125990,"_5":14424,"_27663":125304,"_2970":125991},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3487":73580,"_30445":73299,"_21099":125993,"_5":14424,"_27663":125304,"_2970":125994},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3487":73581,"_30445":73299,"_21099":125996,"_5":14424,"_27663":125304,"_2970":125997},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3487":73582,"_30445":73299,"_21099":125999,"_5":14424,"_27663":125304,"_2970":126000},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3487":73583,"_30445":73299,"_21099":126002,"_5":14424,"_27663":125308,"_2970":126003},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3487":73584,"_30445":73299,"_21099":126005,"_5":14424,"_27663":125308,"_2970":126006},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3487":73585,"_30445":73299,"_21099":126008,"_5":14424,"_27663":125308,"_2970":126009},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3487":73586,"_30445":73299,"_21099":126011,"_5":14424,"_27663":125308,"_2970":126012},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3487":73587,"_30445":73299,"_21099":126014,"_5":14424,"_27663":125308,"_2970":126015},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3487":73588,"_30445":73299,"_21099":126017,"_5":14424,"_27663":125308,"_2970":126018},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3487":73589,"_30445":73299,"_21099":126020,"_5":14424,"_27663":125308,"_2970":126021},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3487":73590,"_30445":73299,"_21099":126023,"_5":14424,"_27663":125308,"_2970":126024},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3487":73591,"_30445":73299,"_21099":126026,"_5":14424,"_27663":125308,"_2970":126027},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3487":73592,"_30445":73299,"_21099":126029,"_5":14424,"_27663":125308,"_2970":126030},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3487":73593,"_30445":73299,"_21099":126032,"_5":14424,"_27663":125308,"_2970":126033},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3487":73594,"_30445":73299,"_21099":126035,"_5":14424,"_27663":125311,"_2970":126036},[],"Tras la actualización, comprueba en este orden:",{"_3487":73595,"_30445":73299,"_21099":126038,"_5":14424,"_27663":125311,"_2970":126039},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3487":73596,"_30445":73299,"_21099":126041,"_5":14424,"_27663":125311,"_2970":126042},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3487":73597,"_30445":73299,"_21099":126044,"_5":14424,"_27663":125311,"_2970":126045},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3487":73598,"_30445":73299,"_21099":126047,"_5":14424,"_27663":125311,"_2970":126048},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3487":73599,"_30445":73299,"_21099":126050,"_5":14424,"_27663":125311,"_2970":126051},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3487":73600,"_30445":73299,"_21099":126053,"_5":14424,"_27663":125311,"_2970":126054},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3487":73601,"_30445":73299,"_21099":126056,"_5":14424,"_27663":125311,"_2970":126057},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3487":73602,"_30445":73299,"_21099":126059,"_5":14424,"_27663":125311,"_2970":126060},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3487":73603,"_30445":73299,"_21099":126062,"_5":14424,"_27663":125311,"_2970":126063},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3487":73604,"_30445":73299,"_21099":126065,"_5":14424,"_27663":125311,"_2970":126066},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3487":73605,"_30445":73299,"_21099":126068,"_5":14424,"_27663":125311,"_2970":126069},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3487":73606,"_30445":73299,"_21099":126071,"_5":14424,"_27663":125311,"_2970":126072},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3487":73607,"_30445":73299,"_21099":126074,"_5":14424,"_27663":125311,"_2970":126075},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3487":73608,"_30445":73299,"_21099":126077,"_5":14424,"_27663":125311,"_2970":126078},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3487":73609,"_30445":73299,"_21099":126080,"_5":14424,"_27663":125311,"_2970":126081},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3487":73610,"_30445":73299,"_21099":126083,"_5":14424,"_27663":125315,"_2970":126084},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3487":73611,"_30445":73299,"_21099":126086,"_5":14424,"_27663":125315,"_2970":126087},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3487":73612,"_30445":73299,"_21099":126089,"_5":14424,"_27663":125315,"_2970":126090},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3487":73613,"_30445":73299,"_21099":126092,"_5":14424,"_27663":125315,"_2970":126093},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3487":73614,"_30445":73299,"_21099":126095,"_5":14424,"_27663":125315,"_2970":126096},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58833":126098,"_58835":126099,"_58837":126100,"_58839":126101,"_18300":3005,"_70658":3005},"spanish",[2970,30445,5,27663],{"_2970":25195,"_30445":25195,"_5":25195,"_27663":25195},{"_2970":126102,"_30445":129055,"_5":132008,"_27663":134961},{"_4681":126103,"_58843":126104,"_5":25195},{"_14512":6990,"_14892":7511,"_14911":3788,"_29439":5095,"_14898":4017,"_20026":3258,"_14533":4109,"_14540":3753,"_29381":3879,"_29789":16753,"_29810":7677,"_29415":3067,"_34796":3084,"_29518":20511,"_29854":9898,"_34803":23020,"_34806":4083,"_34809":7699,"_34812":5472,"_30261":3365,"_34817":19385,"_34819":25583,"_30291":14791,"_14907":18646,"_34823":7540,"_34826":10497,"_34828":6121,"_29838":10501,"_30256":7688,"_30304":15970,"_34833":4804,"_34835":7643,"_34837":6051,"_29535":6330,"_34840":3356,"_34842":3708,"_34844":5182,"_34846":21591,"_34848":3363,"_29452":7530,"_34851":5332,"_34853":6037,"_29446":7709,"_29875":7233,"_34857":5984,"_34859":7234,"_34862":4445,"_29492":8925,"_34866":11402,"_29372":4029,"_34869":7040,"_29420":17292,"_34872":7176,"_34874":15968,"_34877":11359,"_14901":4756,"_34880":5991,"_34882":9769,"_34885":17291,"_34887":6651