hooting-16","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#issuance-fails","content":"Correct PEM and verifiable signature."},"2630":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-17","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#issuance-fails","content":"`openssl req -in request.csr -noout -verify -text`."},"2631":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-18","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#issuance-fails","content":"Profile"},"2632":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-19","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#issuance-fails","content":"Selected source, existing ID, allowed algorithm and size."},"2633":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-20","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#issuance-fails","content":"Check Profiles precedence; CA and DMS resolve differently."},"2634":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-21","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#issuance-fails","content":"Result"},"2635":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-22","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#issuance-fails","content":"Appropriate subject, SAN, usages and dates."},"2636":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-23","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#issuance-fails","content":"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance."},"2637":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-24","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#issuance-fails","content":"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration."},"2638":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-25","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#issuance-fails","content":"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation."},"2639":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-26","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Check each boundary independently:"},"2640":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-27","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions."},"2641":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-28","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy."},"2642":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-29","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`."},"2643":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-30","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator."},"2644":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-31","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection."},"2645":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-32","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure."},"2646":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-33","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests."},"2647":{"id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting-34","page_id":"/docs/pr-preview/pr-69/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures."},"2648":{"id":"/docs/pr-preview/pr-69/security","page_id":"/docs/pr-preview/pr-69/security","type":"page","content":"Security","breadcrumbs":["Docs"],"tags":[],"url":"/docs/pr-preview/pr-69/security"},"2649":{"id":"/docs/pr-preview/pr-69/security-0","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security","content":"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes."},"2650":{"id":"/docs/pr-preview/pr-69/security-1","page_id":"/docs/pr-preview/pr-69/security","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/security#report-a-vulnerability","content":"Report a vulnerability"},"2651":{"id":"/docs/pr-preview/pr-69/security-2","page_id":"/docs/pr-preview/pr-69/security","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/security#what-to-include-in-a-report","content":"What to include in a report"},"2652":{"id":"/docs/pr-preview/pr-69/security-3","page_id":"/docs/pr-preview/pr-69/security","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/security#supported-versions","content":"Supported versions"},"2653":{"id":"/docs/pr-preview/pr-69/security-4","page_id":"/docs/pr-preview/pr-69/security","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/security#responsible-disclosure","content":"Responsible disclosure"},"2654":{"id":"/docs/pr-preview/pr-69/security-5","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security","content":"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes."},"2655":{"id":"/docs/pr-preview/pr-69/security-6","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#report-a-vulnerability","content":"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it."},"2656":{"id":"/docs/pr-preview/pr-69/security-7","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#report-a-vulnerability","content":"Instead, report privately using GitHub Security Advisories for the affected repository:"},"2657":{"id":"/docs/pr-preview/pr-69/security-8","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#report-a-vulnerability","content":"lamassuiot"},"2658":{"id":"/docs/pr-preview/pr-69/security-9","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#report-a-vulnerability","content":"lamassu-dashboard"},"2659":{"id":"/docs/pr-preview/pr-69/security-10","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#report-a-vulnerability","content":"lamassu-helm"},"2660":{"id":"/docs/pr-preview/pr-69/security-11","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#report-a-vulnerability","content":"This lets maintainers assess and address the issue before it is publicly disclosed."},"2661":{"id":"/docs/pr-preview/pr-69/security-12","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#report-a-vulnerability","content":"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly."},"2662":{"id":"/docs/pr-preview/pr-69/security-13","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#what-to-include-in-a-report","content":"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples."},"2663":{"id":"/docs/pr-preview/pr-69/security-14","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#what-to-include-in-a-report","content":"Do not include in the report:"},"2664":{"id":"/docs/pr-preview/pr-69/security-15","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#what-to-include-in-a-report","content":"Credentials, tokens, or private keys"},"2665":{"id":"/docs/pr-preview/pr-69/security-16","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#what-to-include-in-a-report","content":"Customer data or customer-identifiable information"},"2666":{"id":"/docs/pr-preview/pr-69/security-17","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#what-to-include-in-a-report","content":"Confidential architecture or internal infrastructure details"},"2667":{"id":"/docs/pr-preview/pr-69/security-18","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#supported-versions","content":"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported."},"2668":{"id":"/docs/pr-preview/pr-69/security-19","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#supported-versions","content":"For upgrade guidance, see Upgrades."},"2669":{"id":"/docs/pr-preview/pr-69/security-20","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#responsible-disclosure","content":"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure."},"2670":{"id":"/docs/pr-preview/pr-69/security-21","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#responsible-disclosure","content":"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability."},"2671":{"id":"/docs/pr-preview/pr-69/security-22","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#responsible-disclosure","content":"Only interact with accounts or data you own, or for which you have explicit permission."},"2672":{"id":"/docs/pr-preview/pr-69/security-23","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/security#responsible-disclosure","content":"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress."},"2673":{"id":"/docs/pr-preview/pr-69/security-24","page_id":"/docs/pr-preview/pr-69/security","tags":[],"type":"text","url":"/docs/pr-