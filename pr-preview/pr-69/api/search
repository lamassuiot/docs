:"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"Estados del modo de registro del DMS"},"1439":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-132","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"`EventBindDeviceIdentityKey`"},"1440":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-133","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"Dispositivo"},"1441":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-134","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`"},"1442":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-135","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`"},"1443":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-136","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión."},"1444":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-137","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"Ciclo de vida del Thing"},"1445":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-138","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"`EventUpdateCertificateStatusKey`"},"1446":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-139","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"Certificado"},"1447":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-140","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"`IoTCore/Certificate`"},"1448":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-141","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)"},"1449":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-142","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar."},"1450":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-143","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"Estados del certificado"},"1451":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-144","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`"},"1452":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-145","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"Certificado / Dispositivo"},"1453":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-146","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"`IoTCore/Certificate`, `IoTCore/Thing`"},"1454":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-147","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"—"},"1455":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-148","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados."},"1456":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-149","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","content":"Device Shadow y automatización"},"1457":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-150","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","content":"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA."},"1458":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-151","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","content":"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API."},"1459":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-152","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","content":"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya."},"1460":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-153","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:"},"1461":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-154","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"Transición"},"1462":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-155","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"Llamadas AWS"},"1463":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-156","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"`NoRegistrada` → `Solicitada`"},"1464":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-157","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"ninguna (solo escritura de metadatos)"},"1465":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-158","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"`Solicitada` → `Registrando`"},"1466":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-159","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"`iot:GetRegistrationCode` (solo Primary Account)"},"1467":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-160","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"`Registrando` → `Completada`"},"1468":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-161","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)"},"1469":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-162","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"`Registrando` → `Fallida`"},"1470":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-163","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA"},"1471":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-164","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"`Fallida` / `Completada` → `Solicitada`"},"1472":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-165","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)"},"1473":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-166","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:"},"1474":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-167","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS."},"1475":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-168","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS."},"1476":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-169","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`."},"1477":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-170","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente."},"1478":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-171","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`."},"1479":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-172","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","content":"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente."},"1480":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-173","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","content":"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS."},"1481":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-174","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","content":"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota."},"1482":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-175","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","content":"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado."},"1483":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-176","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:"},"1484":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-177","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"Crea o actualiza las políticas IoT configuradas en el DMS."},"1485":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-178","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente."},"1486":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-179","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse."},"1487":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-180","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager."},"1488":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-181","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core."},"1489":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-182","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","content":"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa."},"1490":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-183","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","content":"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core."},"1491":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-184","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","content":"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`."},"1492":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-185","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","content":"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`."},"1493":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-186","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","content":"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP."},"1494":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-187","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:"},"1495":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-188","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"Transición"},"1496":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-189","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"Llamadas AWS"},"1497":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-190","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"`SinConfigurar` → `None` / `Auto`"},"1498":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-191","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"ninguna (solo configuración)"},"1499":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-192","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"`None` ↔ `Auto`"},"1500":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-193","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"ninguna (solo configuración)"},"1501":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-194","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"Cualquiera → `Jitp`"},"1502":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-195","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)"},"1503":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-196","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"`Jitp` → `None` / `Auto`"},"1504":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-197","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"ninguna (la plantilla permanece en la cuenta AWS)"},"1505":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-198","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional."},"1506":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-199","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"El flujo completo desde el punto de vista del dispositivo es el siguiente:"},"1507":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-200","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado."},"1508":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-201","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","content":"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:"},"1509":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-202","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","content":"Transición"},"1510":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-203","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","content":"Llamadas AWS"},"1511":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-204","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","content":"`Ausente` → `Aprovisionado`"},"1512":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-205","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","content":"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)"},"1513":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-206","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","content":"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)"},"1514":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-207","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","content":"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu"},"1515":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-208","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","content":"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta."},"1516":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-209","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez."},"1517":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-210","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión."},"1518":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-211","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Para que el flujo JITP funcione correctamente:"},"1519":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-212","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP)."},"1520":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-213","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS."},"1521":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-214","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core."},"1522":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-215","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección."},"1523":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-216","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:"},"1524":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-217","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Estado en Lamassu"},"1525":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-218","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Razón de revocación"},"1526":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-219","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Estado en AWS IoT Core"},"1527":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-220","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Active`"},"1528":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-221","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Ninguna"},"1529":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-222","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`ACTIVE`"},"1530":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-223","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Revoked`"},"1531":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-224","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`certificateHold`"},"1532":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-225","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`INACTIVE`"},"1533":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-226","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Revoked`"},"1534":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-227","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Cualquier otra razón"},"1535":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-228","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`REVOKED`"},"1536":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-229","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`."},"1537":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-230","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:"},"1538":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-231","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"Transición"},"1539":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-232","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"Llamadas AWS"},"1540":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-233","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"`NoSincronizado` → `Active`"},"1541":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-234","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"`iot:UpdateCertificate`"},"1542":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-235","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"`Active` → `Inactive`"},"1543":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-236","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"`iot:UpdateCertificate` + desconexión MQTT forzada"},"1544":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-237","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"`Active` → `Revoked`"},"1545":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-238","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"`iot:UpdateCertificate` + desconexión MQTT forzada"},"1546":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-239","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"`Inactive` / `Revoked` → `Active`"},"1547":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-240","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"`iot:UpdateCertificate`"},"1548":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-241","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"`RenewalWindow` / `AboutToExpire` / `Expired`"},"1549":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-242","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"ninguna (estos estados no se sincronizan con AWS)"},"1550":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-243","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento."},"1551":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-244","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`."},"1552":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-245","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector."},"1553":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-246","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","content":"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`."},"1554":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-247","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","content":"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing)."},"1555":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-248","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia."},"1556":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-249","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"Existen dos tipos de acciones:"},"1557":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-250","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire."},"1558":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-251","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza."},"1559":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-252","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia."},"1560":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-253","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","content":"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:"},"1561":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-254","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","content":"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN."},"1562":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-255","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","content":"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector)."},"1563":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-256","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`."},"1564":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-257","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto."},"1565":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-258","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA."},"1566":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-259","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación."},"1567":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-260","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado."},"1568":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-261","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento."},"1569":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-262","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación."},"1570":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-263","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión."},"1571":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-264","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core."},"1572":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-265","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core."},"1573":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-266","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu."},"1574":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-267","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT."},"1575":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-268","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera."},"1576":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-269","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo."},"1577":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-270","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas."},"1578":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-271","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El Device Shadow no se actualiza cuando debería."},"1579":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-272","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado."},"1580":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-273","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`."},"1581":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-274","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS."},"1582":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-275","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector."},"1583":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-276","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS."},"1584":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-277","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1585":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-278","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />"},"1586":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-279","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />"},"1587":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","type":"page","content":"IoT Fleets","breadcrumbs":["Docs","Plataforma","IoT Fleets"],"tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview"},"1588":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-0","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","content":"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores."},"1589":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-1","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#empieza-aquí","content":"Empieza aquí"},"1590":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-2","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"Dispositivos e identidades"},"1591":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-3","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"Enrolamiento con PKI"},"1592":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-4","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#integraciones","content":"Integraciones"},"1593":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-5","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Quién prepara cada parte"},"1594":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-6","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","content":"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta."},"1595":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-7","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#empieza-aquí","content":"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado."},"1596":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-8","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#empieza-aquí","content":"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo."},"1597":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-9","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"Recurso"},"1598":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-10","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"Qué representa"},"1599":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-11","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"**Dispositivo**"},"1600":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-12","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"Una entrada de inventario con identificador, DMS propietario y clasificación."},"1601":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-13","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"**Identidad**"},"1602":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-14","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"La asociación del dispositivo con sus certificados: una versión activa y un historial."},"1603":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-15","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"**DMS**"},"1604":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-16","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza."},"1605":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-17","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"**Flota**"},"1606":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-18","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos."},"1607":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-19","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos."},"1608":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-20","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual."},"1609":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-21","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:"},"1610":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-22","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI."},"1611":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-23","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye."},"1612":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-24","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave."},"1613":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-25","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo."},"1614":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-26","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS."},"1615":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-27","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1616":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-28","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />"},"1617":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-29","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#integraciones","content":"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo."},"1618":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-30","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#integraciones","content":"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados."},"1619":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-31","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Participante"},"1620":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-32","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Responsabilidad"},"1621":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-33","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Administrador PKI"},"1622":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-34","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"CA, perfil de emisión, cadena y publicación de revocación."},"1623":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-35","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Administrador del aprovisionamiento"},"1624":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-36","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"DMS, admisión, autenticación por operación e inventario."},"1625":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-37","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Integrador del dispositivo"},"1626":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview-38","page_id":"/docs/pr-preview/pr-69/es/platf