ara comprobar posesión de la clave de la CSR."},"958":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-37","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enable_replaceable_enrollment`"},"959":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-38","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico."},"960":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-39","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`est_rfc7030_settings.auth_mode`"},"961":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-40","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Uno de los cuatro modos de autenticación."},"962":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-41","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales."},"963":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-42","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Los bloques son independientes:"},"964":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-43","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`."},"965":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-44","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`."},"966":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-45","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`auth_mode`"},"967":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-46","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Control aplicado en la operación configurada"},"968":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-47","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`CLIENT_CERTIFICATE`"},"969":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-48","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Validación del certificado presentado."},"970":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-49","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`EXTERNAL_WEBHOOK`"},"971":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-50","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Autorización del webhook configurado."},"972":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-51","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"973":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-52","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Validación del certificado y, después, aprobación del webhook."},"974":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-53","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`NO_AUTH`"},"975":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-54","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Sin autenticación del solicitante por el DMS."},"976":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-55","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla."},"977":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-56","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway."},"978":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-57","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`."},"979":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-58","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado."},"980":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-59","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:"},"981":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-60","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Campo de `external_webhook_settings`"},"982":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-61","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Decisión"},"983":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-62","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`url`"},"984":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-63","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones."},"985":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-64","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`method`"},"986":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-65","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`POST` o `PUT`; `POST` por defecto."},"987":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-66","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`name`"},"988":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-67","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Etiqueta usada en los logs del servicio."},"989":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-68","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.auth_mode`"},"990":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-69","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`."},"991":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-70","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.log_level`"},"992":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-71","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto."},"993":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-72","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.apikey_options`"},"994":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-73","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan."},"995":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-74","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.jwt_options`"},"996":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-75","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`."},"997":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-76","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.mtls_options`"},"998":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-77","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro."},"999":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-78","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.insecure_skip_verify`"},"1000":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-79","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí."},"1001":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-80","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.call_timeout`"},"1002":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-81","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto."},"1003":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-82","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Reglas de esa configuración:"},"1004":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-83","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro."},"1005":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-84","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan."},"1006":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-85","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`."},"1007":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-86","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan."},"1008":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-87","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada."},"1009":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-88","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia."},"1010":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-89","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas)."},"1011":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-90","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador."},"1012":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-91","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`."},"1013":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-92","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","content":"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes."},"1014":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-93","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Campo de `settings.reenrollment_settings`"},"1015":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-94","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Función"},"1016":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-95","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`reenrollment_delta`"},"1017":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-96","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"La ventana abre en `NotAfter` del certificado activo menos este delta."},"1018":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-97","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`preventive_delta`"},"1019":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-98","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Umbral operativo preventivo de monitorización."},"1020":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-99","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`critical_delta`"},"1021":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-100","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Umbral operativo crítico de monitorización."},"1022":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-101","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`enable_expired_renewal`"},"1023":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-102","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway."},"1024":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-103","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`est_rfc7030_settings.client_certificate_settings.validation_cas`"},"1025":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-104","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan."},"1026":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-105","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`revoke_on_reenrollment`"},"1027":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-106","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor."},"1028":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-107","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales."},"1029":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-108","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#serverkeygen","content":"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST."},"1030":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-109","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Opción"},"1031":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-110","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Qué publica"},"1032":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-111","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"**Include Lamassu System CA**"},"1033":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-112","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión."},"1034":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-113","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"**Include Enrollment CA**"},"1035":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-114","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Certificado de la CA emisora seleccionada."},"1036":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-115","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"**Managed CAs**"},"1037":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-116","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Certificados de las CAs elegidas explícitamente."},"1038":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-117","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor."},"1039":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-118","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","content":"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS."},"1040":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-119","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","content":"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs."},"1041":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-120","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","content":"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo."},"1042":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms-121","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","content":"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos."},"1043":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","type":"page","content":"Integra el cliente EST","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client"},"1044":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-0","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","content":"Prepara la confianza, envía una CSR y comprueba la identidad recibida."},"1045":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-1","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Antes de empezar"},"1046":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-2","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","content":"Descarga e inspecciona cacerts"},"1047":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-3","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","content":"Prepara la CSR"},"1048":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-4","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","content":"Solicita la identidad"},"1049":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-5","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Comprueba e instala el resultado"},"1050":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-6","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","content":"Siguientes pasos"},"1051":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-7","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","content":"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo."},"1052":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-8","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas."},"1053":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-9","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial."},"1054":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-10","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible."},"1055":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-11","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","content":"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo."},"1056":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-12","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","content":"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen."},"1057":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-13","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","content":"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos."},"1058":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-14","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","content":"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles."},"1059":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-15","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","content":"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:"},"1060":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-16","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","content":"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión."},"1061":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-17","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Para el caso de una raíz que emite directamente:"},"1062":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-18","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI."},"1063":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-19","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso."},"1064":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client-20","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","content":"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia."},"1065":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","type":"page","content":"Referencia EST","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference"},"1066":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-0","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","content":"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu."},"1067":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-1","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Referencia de endpoints"},"1068":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-2","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#cacerts","content":"cacerts"},"1069":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-3","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"simpleenroll"},"1070":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-4","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"simplereenroll"},"1071":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-5","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"serverkeygen"},"1072":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-6","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Formato de respuesta"},"1073":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-7","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Solicitud y extracción"},"1074":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-8","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","content":"Notas de compatibilidad"},"1075":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-9","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","content":"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política."},"1076":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-10","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos."},"1077":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-11","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Operación"},"1078":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-12","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Método"},"1079":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-13","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación y condición"},"1080":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-14","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/cacerts`"},"1081":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-15","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"GET"},"1082":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-16","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose."},"1083":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-17","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/simpleenroll`"},"1084":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-18","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"POST"},"1085":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-19","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación inicial y política de registro/sustitución del DMS."},"1086":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-20","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/simplereenroll`"},"1087":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-21","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"POST"},"1088":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-22","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación de renovación, identidad existente, sujeto, revocación y ventana."},"1089":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-23","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/serverkeygen`"},"1090":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-24","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"POST"},"1091":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-25","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación y admisión iniciales; generación en servidor habilitada."},"1092":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-26","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato."},"1093":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-27","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#cacerts","content":"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes."},"1094":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-28","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#cacerts","content":"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables."},"1095":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-29","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS."},"1096":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-30","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR."},"1097":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-31","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual."},"1098":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-32","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación."},"1099":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-33","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM."},"1100":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-34","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución."},"1101":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-35","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:"},"1102":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-36","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Parte"},"1103":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-37","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Contenido tras decodificar su Base64"},"1104":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-38","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"`application/pkcs8`"},"1105":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-39","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Clave privada PKCS#8 DER sin cifrar."},"1106":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-40","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"`application/pkcs7-mime; smime-type=certs-only`"},"1107":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-41","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"PKCS#7 DER con el certificado emitido."},"1108":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-42","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras."},"1109":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-43","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor."},"1110":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-44","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:"},"1111":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-45","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Convierte y comprueba el resultado:"},"1112":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-46","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python."},"1113":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-47","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","content":"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico."},"1114":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference-48","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","content":"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico."},"1115":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","type":"page","content":"Enrolamiento con PKI","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview"},"1116":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-0","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","content":"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST."},"1117":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-1","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El recorrido"},"1118":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-2","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"Para el administrador"},"1119":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-3","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"Para el integrador"},"1120":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-4","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","content":"Versión del contrato"},"1121":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-5","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","content":"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor."},"1122":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-6","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El administrador prepara CA, perfil de emisión y DMS."},"1123":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-7","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El integrador instala confianza inicial en el servidor EST y una credencial de admisión."},"1124":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-8","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El cliente solicita una identidad para su `Device ID` mediante EST."},"1125":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-9","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado."},"1126":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-10","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación."},"1127":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-11","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS."},"1128":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-12","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />"},"1129":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-13","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1130":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-14","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />"},"1131":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-15","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />"},"1132":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-16","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />"},"1133":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-17","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"1134":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-18","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />"},"1135":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-19","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />"},"1136":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-20","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","content":"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión."},"1137":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview-21","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","content":"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones."},"1138":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","type":"page","content":"Estrategias de aprovisionamiento","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies"},"1139":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-0","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","content":"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave."},"1140":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-1","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Elige el registro"},"1141":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-2","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","content":"Prerregistro y sustitución"},"1142":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-3","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"Elige la autenticación"},"1143":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-4","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Elige la custodia"},"1144":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-5","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","content":"Comprueba la decisión"},"1145":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-6","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","content":"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino."},"1146":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-7","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Recorrido"},"1147":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-8","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Cuándo existe el dispositivo"},"1148":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-9","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Qué compruebas"},"1149":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-10","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Asignación manual"},"1150":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-11","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"El operador lo crea antes de asociar un certificado."},"1151":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-12","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"ID, DMS propietario, CN del certificado y serie vinculada."},"1152":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-13","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"EST con `JITP`"},"1153":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-14","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Se crea para un CN desconocido durante `/simpleenroll`."},"1154":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-15","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Credencial autorizada, ID libre, perfil, alta e identidad resultantes."},"1155":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-16","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"EST con `PRE_REGISTRATION`"},"1156":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-17","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Debe existir antes de `/simpleenroll`."},"1157":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-18","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión."},"1158":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-19","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes."},"1159":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-20","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual."},"1160":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-21","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","content":"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION."},"1161":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-22","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","content":"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior."},"1162":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-23","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","content":"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar."},"1163":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-24","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"Decide por separado primer enrolamiento y reenrolamiento:"},"1164":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-25","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla."},"1165":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-26","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID."},"1166":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-27","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"**Certificado y webhook:** exige ambos controles en la operación configurada."},"1167":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-28","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS."},"1168":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-29","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación."},"1169":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-30","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Opción"},"1170":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-31","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Material que atraviesa EST"},"1171":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-32","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Clave generada por el dispositivo"},"1172":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-33","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"CSR pública y certificado; la clave permanece en el cliente."},"1173":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-34","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Clave ya disponible en el dispositivo"},"1174":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-35","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"CSR firmada con la clave existente y certificado nuevo."},"1175":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-36","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"ServerKeyGen"},"1176":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-37","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS."},"1177":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-38","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material."},"1178":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies-39","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","content":"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar."},"1179":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"page","content":"Renovación y recuperación","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery"},"1180":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-0","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","content":"Renueva sin perder la identidad y recupera dispositivos según su estado real."},"1181":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-1","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","content":"Prepara la renovación"},"1182":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-2","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","content":"Solicita el certificado sucesor"},"1183":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-3","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","content":"Instala y comprueba la nueva pareja"},"1184":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-4","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Recupera según el estado"},"1185":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-5","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","content":"Operación continua"},"1186":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-6","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","content":"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos."},"1187":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-7","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","content":"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente."},"1188":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-8","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","content":"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida."},"1189":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-9","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","content":"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana."},"1190":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-10","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","content":"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva."},"1191":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-11","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","content":"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos."},"1192":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-12","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","content":"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales."},"1193":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-13","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","content":"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión."},"1194":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-14","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","content":"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación."},"1195":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-15","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","content":"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación."},"1196":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-16","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Situación"},"1197":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-17","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Procedimiento"},"1198":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-18","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Certificado vigente, fuera de ventana"},"1199":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-19","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla."},"1200":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-20","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Certificado vencido, clave disponible"},"1201":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-21","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones."},"1202":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-22","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Renovación por webhook o `NO_AUTH`"},"1203":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-23","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal."},"1204":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-24","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Clave perdida o inaccesible"},"1205":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-25","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida."},"1206":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-26","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Identidad actual revocada"},"1207":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-27","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo."},"1208":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-28","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Dispositivo sin identidad"},"1209":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-29","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento."},"1210":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-30","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Dispositivo retirado"},"1211":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-31","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes."},"1212":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-32","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Timeout, HTTP 500 o fallo de instalación"},"1213":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-33","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior."},"1214":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-34","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","content":"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse."},"1215":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery-35","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","content":"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico."},"1216":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","type":"page","content":"Diagnóstico de enrolamiento","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting"},"1217":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-0","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","content":"Localiza fallos de transporte, autenticación, registro, emisión e instalación."},"1218":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-1","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","content":"Diagnóstico y compatibilidad"},"1219":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-2","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Códigos de error y diagnóstico"},"1220":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-3","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad","content":"Notas de compatibilidad"},"1221":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-4","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"El enrolamiento EST falla"},"1222":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-5","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","content":"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe."},"1223":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-6","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido."},"1224":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-7","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Síntoma o mensaje"},"1225":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-8","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Qué revisar"},"1226":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-9","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"curl rechaza TLS, nombre o emisor"},"1227":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-10","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación."},"1228":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-11","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"404 o APS ausente"},"1229":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-12","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio."},"1230":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-13","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"400, error de CSR o formato"},"1231":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-14","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación."},"1232":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-15","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Credencial ausente o certificado no válido"},"1233":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-16","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap."},"1234":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-17","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Webhook deniega, expira o responde sin autorización"},"1235":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-18","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`."},"1236":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-19","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`unexpected status code: <n>: redirects are not followed`"},"1237":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-20","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones."},"1238":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-21","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`webhook response exceeds 1048576 bytes`"},"1239":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-22","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización."},"1240":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-23","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`webhook config must not reference files`"},"1241":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-24","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS."},"1242":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-25","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`mtls_options.cert_content must be base64-encoded PEM`"},"1243":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-26","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave."},"1244":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-27","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`webhook mTLS certificate and key are invalid: …`"},"1245":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-28","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook."},"1246":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-29","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"400 `struct validation error` al crear o actualizar un DMS"},"1247":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-30","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS."},"1248":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-31","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"HTTP 500 con cuerpo `err` en enroll o reenroll"},"1249":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-32","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí."},"1250":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-33","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`device not preregistered`"},"1251":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-34","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"PRE\\_REGISTRATION requiere la entrada de inventario previa."},"1252":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-35","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`forbiddenNewEnrollment`"},"1253":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-36","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag."},"1254":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-37","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"DMS propietario distinto"},"1255":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-38","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto."},"1256":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-39","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`invalid RawSubject bytes`"},"1257":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-40","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN."},"1258":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-41","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`invalid reenroll window`"},"1259":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-42","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana."},"1260":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-43","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Certificado actual revocado"},"1261":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-44","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Renovación rechazada; prepara recuperación autorizada según la causa."},"1262":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-45","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Error de CA, perfil o firma"},"1263":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-46","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión."},"1264":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-47","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"HTTP 200 sin conexión del dispositivo"},"1265":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-48","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial."},"1266":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-49","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Timeout o error después de emitir"},"1267":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-50","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir."},"1268":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-51","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad","content":"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial."},"1269":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-52","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad","content":"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST."},"1270":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-53","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto."},"1271":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-54","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana."},"1272":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-55","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Verifica la CSR localmente y relaciona su CN con el inventario."},"1273":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-56","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados."},"1274":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-57","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor."},"1275":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-58","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS."},"1276":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting-59","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades."},"1277":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","type":"page","content":"Distribución y actualización de confianza","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution"},"1278":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-0","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","content":"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados."},"1279":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-1","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Tres relaciones de confianza"},"1280":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-2","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","content":"Qué devuelve cacerts"},"1281":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-3","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Instala lo necesario"},"1282":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-4","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","content":"Migra la confianza"},"1283":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-5","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","content":"Comprueba la actualización"},"1284":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-6","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","content":"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables."},"1285":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-7","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Relación"},"1286":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-8","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Material que prepara el responsable"},"1287":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-9","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Dispositivo → servidor EST"},"1288":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-10","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS."},"1289":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-11","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"DMS → solicitante"},"1290":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-12","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"CAs y reglas que autorizan la credencial inicial o de renovación."},"1291":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-13","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Consumidor → dispositivo"},"1292":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-14","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Raíces de la identidad operativa, intermedias, validación y permisos."},"1293":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-15","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza."},"1294":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-16","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","content":"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración."},"1295":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-17","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","content":"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST."},"1296":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-18","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades."},"1297":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-19","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Selecciona raíces que tu política haya aprobado como anclas."},"1298":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-20","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces."},"1299":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-21","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella."},"1300":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-22","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor."},"1301":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-23","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad."},"1302":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-24","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","content":"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva."},"1303":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-25","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","content":"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado."},"1304":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-26","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","content":"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI."},"1305":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution-27","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","content":"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos."},"1306":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","type":"page","content":"AWS IoT Core","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Integraciones"],"tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core"},"1307":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-0","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","content":"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos."},"1308":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-1","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","content":"Arquitectura del conector"},"1309":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-2","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","content":"Prerrequisitos"},"1310":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-3","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","content":"Permisos IAM necesarios"},"1311":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-4","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"Parámetros de configuración"},"1312":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core-5","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core","t