[],"type":"text","url":"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#credentials-and-generated-files","content":"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production."},"197":{"id":"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane-119","page_id":"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#verify-the-installation","content":"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway."},"198":{"id":"/docs/pr-preview/pr-69/deployment/self-hosted/helm","page_id":"/docs/pr-preview/pr-69/deployment/self-hosted/helm","type":"page","content":"Install with Helm","breadcrumbs":["Docs","Deployment","Kubernetes self-managed"],"tags":[],"url":"/docs/pr-preview/pr-69/deployment/self-hosted/helm"},"199":{"id":"/docs/pr-preview/pr-69/deployment/self-hosted/helm-0","page_id":"/docs/pr-preview/pr-69/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/deployment/self-hosted/helm","content":"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment."},"200":{"id":"/docs/pr-preview/pr-69/deployment/self-hosted/helm-1","page_id":"/docs/pr-preview/pr-69/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/deployment/self-hosted/helm#install-lamassu-with-helm","content":"Install Lamassu with Helm"},"201":{"id":"/docs/pr-preview/pr-69/deployment/self-hosted/helm-2","page_id":"/docs/pr-preview/pr-69/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/deployment/self-hosted/helm#before-you-begin","content":"Before you begin"},"202":{"id":"/docs/pr-preview/pr-69/deployment/self-hosted/helm-3","page_id":"/docs/pr-preview/pr-69/deploymen