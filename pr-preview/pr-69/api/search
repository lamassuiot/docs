platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct."},"2528":{"id":"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority-34","page_id":"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"PKI diagnostics covers issuance checks and cryptographic dependencies."},"2529":{"id":"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority-35","page_id":"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#next-step","content":"Continue with Issue and verify a certificate, using this authority and `ca.pem`."},"2530":{"id":"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate","page_id":"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate","type":"page","content":"Issue and verify a certificate","breadcrumbs":["Docs","Platform","PKI","Getting started"],"tags":[],"url":"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate"},"2531":{"id":"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate-0","page_id":"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate","content":"Issue a client certificate and check content, chain and key correspondence."},"2532":{"id":"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate-1","page_id":"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate","type":"heading"