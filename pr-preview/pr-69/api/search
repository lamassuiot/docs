r-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","content":"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad."},"1705":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-1","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"Antes de empezar"},"1706":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-2","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Prepara el DMS"},"1707":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-3","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"Registra el dispositivo"},"1708":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-4","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","content":"Comprueba el estado inicial"},"1709":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-5","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","content":"Asigna una identidad"},"1710":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-6","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","content":"Verifica el dispositivo"},"1711":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-7","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Resultado esperado"},"1712":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-8","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si el resultado falla"},"1713":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-9","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","content":"Automatiza el siguiente dispositivo"},"1714":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-10","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","content":"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad."},"1715":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-11","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","content":"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino."},"1716":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-12","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados."},"1717":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-13","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA."},"1718":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-14","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos."},"1719":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-15","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`."},"1720":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-16","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:"},"1721":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-17","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`."},"1722":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-18","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"En **Enrollment CA**, selecciona la CA que emitió `device.crt`."},"1723":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-19","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita."},"1724":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-20","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar."},"1725":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-21","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador."},"1726":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-22","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario."},"1727":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-23","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo."},"1728":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-24","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"Abre **Managed Devices** y la acción de registro. Completa:"},"1729":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-25","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"**Device ID**: `device-001`."},"1730":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-26","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro."},"1731":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-27","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"**Icon** y **Tags**: clasificación opcional."},"1732":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-28","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"Confirma el registro."},"1733":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-29","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","content":"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado."},"1734":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-30","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","content":"El registro crea la entrada de inventario; el certificado todavía debe asociarse."},"1735":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-31","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","content":"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI."},"1736":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-32","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","content":"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades."},"1737":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-33","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","content":"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación."},"1738":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-34","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","content":"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado."},"1739":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-35","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Comprobación"},"1740":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-36","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Resultado"},"1741":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-37","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Dispositivo"},"1742":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-38","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"`device-001` aparece en el inventario con el DMS previsto."},"1743":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-39","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Identidad actual"},"1744":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-40","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"El certificado asociado coincide con el que verificaste en PKI."},"1745":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-41","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Historial"},"1746":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-42","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"La emisión asociada aparece con su número de serie y fechas."},"1747":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-43","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Clave y certificado"},"1748":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-44","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Dispones de la pareja comprobada para instalarla en el dispositivo."},"1749":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-45","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura."},"1750":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-46","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista."},"1751":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-47","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido."},"1752":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-48","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades."},"1753":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-49","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","content":"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente."},"1754":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-50","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","content":"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo."},"1755":{"id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device-51","page_id":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","content":"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios."},"1756":{"id":"/docs/pr-preview/pr-69/es/platform/overview","page_id":"/docs/pr-preview/pr-69/es/platform/overview","type":"page","content":"Plataforma Lamassu IoT","breadcrumbs":["Docs","Plataforma"],"tags":[],"url":"/docs/pr-preview/pr-69/es/platform/overview"},"1757":{"id":"/docs/pr-preview/pr-69/es/platform/overview-0","page_id":"/docs/pr-preview/pr-69/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-69/es/platform/overview","content":"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos."},"1758":{"id":"/docs/pr-preview/pr-69/es/platform/overview-1","page_id":"/docs/pr-preview/pr-69/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/p