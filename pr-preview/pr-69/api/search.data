3":71403,"_5":31029,"_21251":118223,"_27884":118224,"_3010":118225},[],"/docs/pr-preview/pr-69/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3554":71407,"_30673":71403,"_5":31029,"_21251":118227,"_27884":118228,"_3010":118229},[],"/docs/pr-preview/pr-69/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3554":71408,"_30673":71403,"_5":31029,"_21251":118231,"_27884":118232,"_3010":118233},[],"/docs/pr-preview/pr-69/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3554":71409,"_30673":71403,"_5":31029,"_21251":118235,"_27884":118236,"_3010":118237},[],"/docs/pr-preview/pr-69/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3554":71410,"_30673":71403,"_5":31029,"_21251":118239,"_27884":118240,"_3010":118241},[],"/docs/pr-preview/pr-69/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3554":71411,"_30673":71403,"_5":31029,"_21251":118243,"_27884":118244,"_3010":118245},[],"/docs/pr-preview/pr-69/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3554":71412,"_30673":71403,"_21251":118247,"_5":14613,"_27884":71403,"_3010":118248},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3554":71413,"_30673":71403,"_21251":118250,"_5":14613,"_27884":118220,"_3010":118251},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3554":71414,"_30673":71403,"_21251":118253,"_5":14613,"_27884":118220,"_3010":118254},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3554":71415,"_30673":71403,"_21251":118256,"_5":14613,"_27884":118220,"_3010":118257},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3554":71416,"_30673":71403,"_21251":118259,"_5":14613,"_27884":118224,"_3010":118260},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3554":71417,"_30673":71403,"_21251":118262,"_5":14613,"_27884":118224,"_3010":118263},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3554":71418,"_30673":71403,"_21251":118265,"_5":14613,"_27884":118224,"_3010":118266},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3554":71419,"_30673":71403,"_21251":118268,"_5":14613,"_27884":118228,"_3010":118269},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3554":71420,"_30673":71403,"_21251":118271,"_5":14613,"_27884":118232,"_3010":118272},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3554":71421,"_30673":71403,"_21251":118274,"_5":14613,"_27884":118236,"_3010":118275},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3554":71422,"_30673":71403,"_21251":118277,"_5":14613,"_27884":118240,"_3010":118278},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3554":71423,"_30673":71403,"_21251":118280,"_5":14613,"_27884":118244,"_3010":118281},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3554":71424,"_30673":71424,"_5":14965,"_3010":118283,"_31032":118284,"_21251":118285,"_27884":71424},"Despliega Lamassu",[50083,118212],[],{"_3554":71425,"_30673":71424,"_21251":118287,"_5":14613,"_27884":71424,"_3010":118288},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3554":71426,"_30673":71424,"_5":31029,"_21251":118290,"_27884":118291,"_3010":118292},[],"/docs/pr-preview/pr-69/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3554":71427,"_30673":71424,"_5":31029,"_21251":118294,"_27884":118295,"_3010":118296},[],"/docs/pr-preview/pr-69/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3554":71428,"_30673":71424,"_5":31029,"_21251":118298,"_27884":118299,"_3010":118300},[],"/docs/pr-preview/pr-69/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3554":71429,"_30673":71424,"_21251":118302,"_5":14613,"_27884":71424,"_3010":118303},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3554":71430,"_30673":71424,"_21251":118305,"_5":14613,"_27884":118291,"_3010":118306},[],"Modelo",{"_3554":71431,"_30673":71424,"_21251":118308,"_5":14613,"_27884":118291,"_3010":118309},[],"Recomendado para",{"_3554":71432,"_30673":71424,"_21251":118311,"_5":14613,"_27884":118291,"_3010":118312},[],"Quién opera la infraestructura",{"_3554":71433,"_30673":71424,"_21251":118314,"_5":14613,"_27884":118291,"_3010":118315},[],"Punto de partida",{"_3554":71434,"_30673":71424,"_21251":118317,"_5":14613,"_27884":118291,"_3010":50190},[],{"_3554":71435,"_30673":71424,"_21251":118319,"_5":14613,"_27884":118291,"_3010":118320},[],"Producción, entornos regulados y despliegues personalizados",{"_3554":71436,"_30673":71424,"_21251":118322,"_5":14613,"_27884":118291,"_3010":118323},[],"Tu equipo",{"_3554":71437,"_30673":71424,"_21251":118325,"_5":14613,"_27884":118291,"_3010":118326},[],"Helm o Fastlane",{"_3554":71438,"_30673":71424,"_21251":118328,"_5":14613,"_27884":118291,"_3010":50202},[],{"_3554":71439,"_30673":71424,"_21251":118330,"_5":14613,"_27884":118291,"_3010":118331},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3554":71440,"_30673":71424,"_21251":118333,"_5":14613,"_27884":118291,"_3010":118323},[],{"_3554":71441,"_30673":71424,"_21251":118335,"_5":14613,"_27884":118291,"_3010":118336},[],"Imagen preconfigurada en EC2",{"_3554":71442,"_30673":71424,"_21251":118338,"_5":14613,"_27884":118291,"_3010":50213},[],{"_3554":71443,"_30673":71424,"_21251":118340,"_5":14613,"_27884":118291,"_3010":118341},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3554":71444,"_30673":71424,"_21251":118343,"_5":14613,"_27884":118291,"_3010":50219},[],{"_3554":71445,"_30673":71424,"_21251":118345,"_5":14613,"_27884":118291,"_3010":118346},[],"Suscripción gestionada",{"_3554":71446,"_30673":71424,"_21251":118348,"_5":14613,"_27884":118291,"_3010":118349},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3554":71447,"_30673":71424,"_21251":118351,"_5":14613,"_27884":118291,"_3010":118352},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3554":71448,"_30673":71424,"_21251":118354,"_5":14613,"_27884":118291,"_3010":118355},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3554":71449,"_30673":71424,"_21251":118357,"_5":14613,"_27884":118295,"_3010":118358},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3554":71450,"_30673":71424,"_21251":118360,"_5":14613,"_27884":118299,"_3010":118361},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3554":71451,"_30673":71451,"_5":14965,"_3010":118363,"_31032":118364,"_21251":118365,"_27884":71451},"Utiliza Lamassu como SaaS",[50083,118212,118213],[],{"_3554":71452,"_30673":71451,"_21251":118367,"_5":14613,"_27884":71451,"_3010":118368},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3554":71453,"_30673":71451,"_5":31029,"_21251":118370,"_27884":118371,"_3010":118372},[],"/docs/pr-preview/pr-69/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3554":71454,"_30673":71451,"_5":31029,"_21251":118374,"_27884":118375,"_3010":118376},[],"/docs/pr-preview/pr-69/es/deployment/saas#planes","Planes",{"_3554":71455,"_30673":71451,"_5":31029,"_21251":118378,"_27884":118379,"_3010":118380},[],"/docs/pr-preview/pr-69/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3554":71456,"_30673":71451,"_21251":118382,"_5":14613,"_27884":71451,"_3010":118383},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3554":71457,"_30673":71451,"_21251":118385,"_5":14613,"_27884":118371,"_3010":118386},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3554":71458,"_30673":71451,"_21251":118388,"_5":14613,"_27884":118371,"_3010":118389},[],"Copias de seguridad automáticas.",{"_3554":71459,"_30673":71451,"_21251":118391,"_5":14613,"_27884":118371,"_3010":118392},[],"Actualizaciones de versión.",{"_3554":71460,"_30673":71451,"_21251":118394,"_5":14613,"_27884":118371,"_3010":118395},[],"Soporte técnico y SLA según el plan contratado.",{"_3554":71461,"_30673":71451,"_21251":118397,"_5":14613,"_27884":118375,"_3010":50274},[],{"_3554":71462,"_30673":71451,"_21251":118399,"_5":14613,"_27884":118375,"_3010":118400},[],"Dispositivos",{"_3554":71463,"_30673":71451,"_21251":118402,"_5":14613,"_27884":118375,"_3010":118403},[],"Soporte",{"_3554":71464,"_30673":71451,"_21251":118405,"_5":14613,"_27884":118375,"_3010":50283},[],{"_3554":71465,"_30673":71451,"_21251":118407,"_5":14613,"_27884":118375,"_3010":50286},[],{"_3554":71466,"_30673":71451,"_21251":118409,"_5":14613,"_27884":118375,"_3010":118410},[],"Hasta 1.000",{"_3554":71467,"_30673":71451,"_21251":118412,"_5":14613,"_27884":118375,"_3010":50292},[],{"_3554":71468,"_30673":71451,"_21251":118414,"_5":14613,"_27884":118375,"_3010":118415},[],"99,5 %",{"_3554":71469,"_30673":71451,"_21251":118417,"_5":14613,"_27884":118375,"_3010":50298},[],{"_3554":71470,"_30673":71451,"_21251":118419,"_5":14613,"_27884":118375,"_3010":118420},[],"Hasta 10.000",{"_3554":71471,"_30673":71451,"_21251":118422,"_5":14613,"_27884":118375,"_3010":118423},[],"Email y chat",{"_3554":71472,"_30673":71451,"_21251":118425,"_5":14613,"_27884":118375,"_3010":118426},[],"99,9 %",{"_3554":71473,"_30673":71451,"_21251":118428,"_5":14613,"_27884":118375,"_3010":50310},[],{"_3554":71474,"_30673":71451,"_21251":118430,"_5":14613,"_27884":118375,"_3010":118431},[],"Ilimitados",{"_3554":71475,"_30673":71451,"_21251":118433,"_5":14613,"_27884":118375,"_3010":118434},[],"Dedicado",{"_3554":71476,"_30673":71451,"_21251":118436,"_5":14613,"_27884":118375,"_3010":118437},[],"99,99 %",{"_3554":71477,"_30673":71451,"_21251":118439,"_5":14613,"_27884":118379,"_3010":118440},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3554":71478,"_30673":71451,"_21251":118442,"_5":14613,"_27884":118379,"_3010":118443},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3554":71479,"_30673":71479,"_5":14965,"_3010":50327,"_31032":118445,"_21251":118447,"_27884":71479},[50083,118212,118446],"Kubernetes autogestionado",[],{"_3554":71480,"_30673":71479,"_21251":118449,"_5":14613,"_27884":71479,"_3010":118450},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3554":71481,"_30673":71479,"_5":31029,"_21251":118452,"_27884":118453,"_3010":118454},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3554":71482,"_30673":71479,"_5":31029,"_21251":118456,"_27884":118457,"_3010":118458},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3554":71483,"_30673":71479,"_5":31029,"_21251":118460,"_27884":118461,"_3010":118462},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3554":71484,"_30673":71479,"_5":31029,"_21251":118464,"_27884":118465,"_3010":118466},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3554":71485,"_30673":71479,"_5":31029,"_21251":118468,"_27884":118469,"_3010":118470},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3554":71486,"_30673":71479,"_5":31029,"_21251":118472,"_27884":118473,"_3010":118474},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3554":71487,"_30673":71479,"_5":31029,"_21251":118476,"_27884":118477,"_3010":118478},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3554":71488,"_30673":71479,"_5":31029,"_21251":118480,"_27884":118481,"_3010":118482},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3554":71489,"_30673":71479,"_5":31029,"_21251":118484,"_27884":118485,"_3010":118486},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3554":71490,"_30673":71479,"_5":31029,"_21251":118488,"_27884":118489,"_3010":118490},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3554":71491,"_30673":71479,"_5":31029,"_21251":118492,"_27884":118493,"_3010":118494},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3554":71492,"_30673":71479,"_21251":118496,"_5":14613,"_27884":118453,"_3010":118497},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3554":71493,"_30673":71479,"_21251":118499,"_5":14613,"_27884":118453,"_3010":118500},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3554":71494,"_30673":71479,"_21251":118502,"_5":14613,"_27884":118457,"_3010":118503},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3554":71495,"_30673":71479,"_21251":118505,"_5":14613,"_27884":118457,"_3010":118506},[],"Fastlane instala o configura",{"_3554":71496,"_30673":71479,"_21251":118508,"_5":14613,"_27884":118457,"_3010":118509},[],"Tú sigues proporcionando",{"_3554":71497,"_30673":71479,"_21251":118511,"_5":14613,"_27884":118457,"_3010":118512},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3554":71498,"_30673":71479,"_21251":118514,"_5":14613,"_27884":118457,"_3010":118515},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3554":71499,"_30673":71479,"_21251":118517,"_5":14613,"_27884":118457,"_3010":118518},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3554":71500,"_30673":71479,"_21251":118520,"_5":14613,"_27884":118457,"_3010":118521},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3554":71501,"_30673":71479,"_21251":118523,"_5":14613,"_27884":118457,"_3010":118524},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3554":71502,"_30673":71479,"_21251":118526,"_5":14613,"_27884":118457,"_3010":118527},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3554":71503,"_30673":71479,"_21251":118529,"_5":14613,"_27884":118457,"_3010":118530},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3554":71504,"_30673":71479,"_21251":118532,"_5":14613,"_27884":118457,"_3010":118533},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3554":71505,"_30673":71479,"_21251":118535,"_5":14613,"_27884":118457,"_3010":118536},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3554":71506,"_30673":71479,"_21251":118538,"_5":14613,"_27884":118461,"_3010":118539},[],"Necesitas:",{"_3554":71507,"_30673":71479,"_21251":118541,"_5":14613,"_27884":118461,"_3010":118542},[],"un clúster Kubernetes existente",{"_3554":71508,"_30673":71479,"_21251":118544,"_5":14613,"_27884":118461,"_3010":118545},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3554":71509,"_30673":71479,"_21251":118547,"_5":14613,"_27884":118461,"_3010":50429},[],{"_3554":71510,"_30673":71479,"_21251":118549,"_5":14613,"_27884":118461,"_3010":24019},[],{"_3554":71511,"_30673":71479,"_21251":118551,"_5":14613,"_27884":118461,"_3010":118552},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3554":71512,"_30673":71479,"_21251":118554,"_5":14613,"_27884":118461,"_3010":118555},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3554":71513,"_30673":71479,"_21251":118557,"_5":14613,"_27884":118461,"_3010":118558},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3554":71514,"_30673":71479,"_21251":118560,"_5":14613,"_27884":118461,"_3010":118561},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3554":71515,"_30673":71479,"_21251":118563,"_5":14613,"_27884":118461,"_3010":118564},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3554":71516,"_30673":71479,"_21251":118566,"_5":14613,"_27884":118465,"_3010":118567},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3554":71517,"_30673":71479,"_21251":118569,"_5":14613,"_27884":118465,"_3010":118570},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3554":71518,"_30673":71479,"_21251":118572,"_5":14613,"_27884":118469,"_3010":118573},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3554":71519,"_30673":71479,"_21251":118575,"_5":14613,"_27884":118469,"_3010":118576},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3554":71520,"_30673":71479,"_21251":118578,"_5":14613,"_27884":118469,"_3010":118579},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3554":71521,"_30673":71479,"_21251":118581,"_5":14613,"_27884":118469,"_3010":118582},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3554":71522,"_30673":71479,"_21251":118584,"_5":14613,"_27884":118473,"_3010":118585},[],"Opción",{"_3554":71523,"_30673":71479,"_21251":118587,"_5":14613,"_27884":118473,"_3010":118588},[],"Valor predeterminado",{"_3554":71524,"_30673":71479,"_21251":118590,"_5":14613,"_27884":118473,"_3010":118591},[],"Propósito",{"_3554":71525,"_30673":71479,"_21251":118593,"_5":14613,"_27884":118473,"_3010":50476},[],{"_3554":71526,"_30673":71479,"_21251":118595,"_5":14613,"_27884":118473,"_3010":50479},[],{"_3554":71527,"_30673":71479,"_21251":118597,"_5":14613,"_27884":118473,"_3010":118598},[],"Muestra la ayuda",{"_3554":71528,"_30673":71479,"_21251":118600,"_5":14613,"_27884":118473,"_3010":50485},[],{"_3554":71529,"_30673":71479,"_21251":118602,"_5":14613,"_27884":118473,"_3010":118603},[],"contexto actual",{"_3554":71530,"_30673":71479,"_21251":118605,"_5":14613,"_27884":118473,"_3010":118606},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3554":71531,"_30673":71479,"_21251":118608,"_5":14613,"_27884":118473,"_3010":50494},[],{"_3554":71532,"_30673":71479,"_21251":118610,"_5":14613,"_27884":118473,"_3010":6684},[],{"_3554":71533,"_30673":71479,"_21251":118612,"_5":14613,"_27884":118473,"_3010":118613},[],"Omite prompts y genera credenciales para las dependencias",{"_3554":71534,"_30673":71479,"_21251":118615,"_5":14613,"_27884":118473,"_3010":50502},[],{"_3554":71535,"_30673":71479,"_21251":118617,"_5":14613,"_27884":118473,"_3010":50505},[],{"_3554":71536,"_30673":71479,"_21251":118619,"_5":14613,"_27884":118473,"_3010":118620},[],"Namespace de la instalación",{"_3554":71537,"_30673":71479,"_21251":118622,"_5":14613,"_27884":118473,"_3010":50511},[],{"_3554":71538,"_30673":71479,"_21251":118624,"_5":14613,"_27884":118473,"_3010":50514},[],{"_3554":71539,"_30673":71479,"_21251":118626,"_5":14613,"_27884":118473,"_3010":118627},[],"Dominio usado por la UI, OIDC y el certificado",{"_3554":71540,"_30673":71479,"_21251":118629,"_5":14613,"_27884":118473,"_3010":50520},[],{"_3554":71541,"_30673":71479,"_21251":118631,"_5":14613,"_27884":118473,"_3010":15305},[],{"_3554":71542,"_30673":71479,"_21251":118633,"_5":14613,"_27884":118473,"_3010":118634},[],"Versión del chart de Lamassu",{"_3554":71543,"_30673":71479,"_21251":118636,"_5":14613,"_27884":118473,"_3010":50528},[],{"_3554":71544,"_30673":71479,"_21251":118638,"_5":14613,"_27884":118473,"_3010":50531},[],{"_3554":71545,"_30673":71479,"_21251":118640,"_5":14613,"_27884":118473,"_3010":118641},[],"Puerto del listener HTTPS",{"_3554":71546,"_30673":71479,"_21251":118643,"_5":14613,"_27884":118473,"_3010":50537},[],{"_3554":71547,"_30673":71479,"_21251":118645,"_5":14613,"_27884":118473,"_3010":50540},[],{"_3554":71548,"_30673":71479,"_21251":118647,"_5":14613,"_27884":118473,"_3010":118648},[],"Puerto del listener HTTP",{"_3554":71549,"_30673":71479,"_21251":118650,"_5":14613,"_27884":118473,"_3010":50546},[],{"_3554":71550,"_30673":71479,"_21251":118652,"_5":14613,"_27884":118473,"_3010":50479},[],{"_3554":71551,"_30673":71479,"_21251":118654,"_5":14613,"_27884":118473,"_3010":118655},[],"Certificado PEM para TLS downstream",{"_3554":71552,"_30673":71479,"_21251":118657,"_5":14613,"_27884":118473,"_3010":50554},[],{"_3554":71553,"_30673":71479,"_21251":118659,"_5":14613,"_27884":118473,"_3010":50479},[],{"_3554":71554,"_30673":71479,"_21251":118661,"_5":14613,"_27884":118473,"_3010":118662},[],"Clave privada PEM para TLS downstream",{"_3554":71555,"_30673":71479,"_21251":118664,"_5":14613,"_27884":118473,"_3010":50562},[],{"_3554":71556,"_30673":71479,"_21251":118666,"_5":14613,"_27884":118473,"_3010":118667},[],"chart del repositorio",{"_3554":71557,"_30673":71479,"_21251":118669,"_5":14613,"_27884":118473,"_3010":118670},[],"Usa un chart local de Lamassu sin empaquetar",{"_3554":71558,"_30673":71479,"_21251":118672,"_5":14613,"_27884":118473,"_3010":50571},[],{"_3554":71559,"_30673":71479,"_21251":118674,"_5":14613,"_27884":118473,"_3010":118675},[],"detección automática",{"_3554":71560,"_30673":71479,"_21251":118677,"_5":14613,"_27884":118473,"_3010":118678},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3554":71561,"_30673":71479,"_21251":118680,"_5":14613,"_27884":118473,"_3010":50579},[],{"_3554":71562,"_30673":71479,"_21251":118682,"_5":14613,"_27884":118473,"_3010":6684},[],{"_3554":71563,"_30673":71479,"_21251":118684,"_5":14613,"_27884":118473,"_3010":118685},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3554":71564,"_30673":71479,"_21251":118687,"_5":14613,"_27884":118473,"_3010":50587},[],{"_3554":71565,"_30673":71479,"_21251":118689,"_5":14613,"_27884":118473,"_3010":6684},[],{"_3554":71566,"_30673":71479,"_21251":118691,"_5":14613,"_27884":118473,"_3010":118692},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3554":71567,"_30673":71479,"_21251":118694,"_5":14613,"_27884":118473,"_3010":50595},[],{"_3554":71568,"_30673":71479,"_21251":118696,"_5":14613,"_27884":118473,"_3010":6684},[],{"_3554":71569,"_30673":71479,"_21251":118698,"_5":14613,"_27884":118473,"_3010":118699},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3554":71570,"_30673":71479,"_21251":118701,"_5":14613,"_27884":118473,"_3010":50603},[],{"_3554":71571,"_30673":71479,"_21251":118703,"_5":14613,"_27884":118473,"_3010":6684},[],{"_3554":71572,"_30673":71479,"_21251":118705,"_5":14613,"_27884":118473,"_3010":118706},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3554":71573,"_30673":71479,"_21251":118708,"_5":14613,"_27884":118473,"_3010":50611},[],{"_3554":71574,"_30673":71479,"_21251":118710,"_5":14613,"_27884":118473,"_3010":50614},[],{"_3554":71575,"_30673":71479,"_21251":118712,"_5":14613,"_27884":118473,"_3010":118713},[],"Usa otro chart local de SoftHSM",{"_3554":71576,"_30673":71479,"_21251":118715,"_5":14613,"_27884":118473,"_3010":118716},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3554":71577,"_30673":71479,"_21251":118718,"_5":14613,"_27884":118477,"_3010":118719},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3554":71578,"_30673":71479,"_21251":118721,"_5":14613,"_27884":118477,"_3010":118722},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3554":71579,"_30673":71479,"_21251":118724,"_5":14613,"_27884":118477,"_3010":118725},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3554":71580,"_30673":71479,"_21251":118727,"_5":14613,"_27884":118477,"_3010":118728},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3554":71581,"_30673":71479,"_21251":118730,"_5":14613,"_27884":118477,"_3010":118731},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3554":71582,"_30673":71479,"_21251":118733,"_5":14613,"_27884":118477,"_3010":118734},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3554":71583,"_30673":71479,"_21251":118736,"_5":14613,"_27884":118481,"_3010":50641},[],{"_3554":71584,"_30673":71479,"_21251":118738,"_5":14613,"_27884":118481,"_3010":118739},[],"valida las herramientas locales y el clúster seleccionado",{"_3554":71585,"_30673":71479,"_21251":118741,"_5":14613,"_27884":118481,"_3010":118742},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3554":71586,"_30673":71479,"_21251":118744,"_5":14613,"_27884":118481,"_3010":118745},[],"crea el namespace",{"_3554":71587,"_30673":71479,"_21251":118747,"_5":14613,"_27884":118481,"_3010":118748},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3554":71588,"_30673":71479,"_21251":118750,"_5":14613,"_27884":118481,"_3010":118751},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3554":71589,"_30673":71479,"_21251":118753,"_5":14613,"_27884":118481,"_3010":118754},[],"instala RabbitMQ",{"_3554":71590,"_30673":71479,"_21251":118756,"_5":14613,"_27884":118481,"_3010":118757},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3554":71591,"_30673":71479,"_21251":118759,"_5":14613,"_27884":118481,"_3010":118760},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3554":71592,"_30673":71479,"_21251":118762,"_5":14613,"_27884":118481,"_3010":118763},[],"carga datos de ejemplo opcionalmente",{"_3554":71593,"_30673":71479,"_21251":118765,"_5":14613,"_27884":118481,"_3010":118766},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3554":71594,"_30673":71479,"_21251":118768,"_5":14613,"_27884":118485,"_3010":118769},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3554":71595,"_30673":71479,"_21251":118771,"_5":14613,"_27884":118485,"_3010":118772},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3554":71596,"_30673":71479,"_21251":118774,"_5":14613,"_27884":118489,"_3010":118775},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3554":71597,"_30673":71479,"_21251":118777,"_5":14613,"_27884":118489,"_3010":118778},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3554":71598,"_30673":71479,"_21251":118780,"_5":14613,"_27884":118489,"_3010":118781},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3554":71599,"_30673":71479,"_21251":118783,"_5":14613,"_27884":118493,"_3010":118784},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3554":71600,"_30673":71600,"_5":14965,"_3010":118786,"_31032":118787,"_21251":118788,"_27884":71600},"Instala con Helm",[50083,118212,118446],[],{"_3554":71601,"_30673":71600,"_21251":118790,"_5":14613,"_27884":71600,"_3010":118791},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3554":71602,"_30673":71600,"_5":31029,"_21251":118793,"_27884":118794,"_3010":118795},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3554":71603,"_30673":71600,"_5":31029,"_21251":118797,"_27884":118798,"_3010":118462},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3554":71604,"_30673":71600,"_5":31029,"_21251":118800,"_27884":118801,"_3010":118802},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3554":71605,"_30673":71600,"_5":31029,"_21251":118804,"_27884":118805,"_3010":118806},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3554":71606,"_30673":71600,"_5":31029,"_21251":118808,"_27884":118809,"_3010":118810},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3554":71607,"_30673":71600,"_5":31029,"_21251":118812,"_27884":118813,"_3010":118814},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3554":71608,"_30673":71600,"_5":31029,"_21251":118816,"_27884":118817,"_3010":118818},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3554":71609,"_30673":71600,"_5":31029,"_21251":118820,"_27884":118821,"_3010":118822},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3554":71610,"_30673":71600,"_5":31029,"_21251":118824,"_27884":118825,"_3010":118826},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3554":71611,"_30673":71600,"_5":31029,"_21251":118828,"_27884":118829,"_3010":118830},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3554":71612,"_30673":71600,"_5":31029,"_21251":118832,"_27884":118833,"_3010":118834},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3554":71613,"_30673":71600,"_21251":118836,"_5":14613,"_27884":118794,"_3010":118837},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3554":71614,"_30673":71600,"_21251":118839,"_5":14613,"_27884":118798,"_3010":118840},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3554":71615,"_30673":71600,"_21251":118842,"_5":14613,"_27884":118798,"_3010":118843},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3554":71616,"_30673":71600,"_21251":118845,"_5":14613,"_27884":118798,"_3010":118846},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3554":71617,"_30673":71600,"_21251":118848,"_5":14613,"_27884":118798,"_3010":118849},[],"un broker RabbitMQ accesible y sus credenciales",{"_3554":71618,"_30673":71600,"_21251":118851,"_5":14613,"_27884":118798,"_3010":118852},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3554":71619,"_30673":71600,"_21251":118854,"_5":14613,"_27884":118798,"_3010":118855},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3554":71620,"_30673":71600,"_21251":118857,"_5":14613,"_27884":118798,"_3010":118858},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3554":71621,"_30673":71600,"_21251":118860,"_5":14613,"_27884":118798,"_3010":118861},[],"una StorageClass y un diseño de tráfico externo",{"_3554":71622,"_30673":71600,"_21251":118863,"_5":14613,"_27884":118798,"_3010":118864},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3554":71623,"_30673":71600,"_21251":118866,"_5":14613,"_27884":118798,"_3010":118867},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3554":71624,"_30673":71600,"_21251":118869,"_5":14613,"_27884":118798,"_3010":118870},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3554":71625,"_30673":71600,"_21251":118872,"_5":14613,"_27884":118801,"_3010":118873},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3554":71626,"_30673":71600,"_21251":118875,"_5":14613,"_27884":118801,"_3010":118876},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3554":71627,"_30673":71600,"_21251":118878,"_5":14613,"_27884":118801,"_3010":118879},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3554":71628,"_30673":71600,"_21251":118881,"_5":14613,"_27884":118805,"_3010":118882},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3554":71629,"_30673":71600,"_21251":118884,"_5":14613,"_27884":118805,"_3010":118885},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3554":71630,"_30673":71600,"_21251":118887,"_5":14613,"_27884":118805,"_3010":118888},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3554":71631,"_30673":71600,"_21251":118890,"_5":14613,"_27884":118805,"_3010":118891},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3554":71632,"_30673":71600,"_21251":118893,"_5":14613,"_27884":118809,"_3010":118894},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3554":71633,"_30673":71600,"_21251":118896,"_5":14613,"_27884":118813,"_3010":118897},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3554":71634,"_30673":71600,"_21251":118899,"_5":14613,"_27884":118813,"_3010":118900},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3554":71635,"_30673":71600,"_21251":118902,"_5":14613,"_27884":118813,"_3010":118903},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3554":71636,"_30673":71600,"_21251":118905,"_5":14613,"_27884":118813,"_3010":118906},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3554":71637,"_30673":71600,"_21251":118908,"_5":14613,"_27884":118813,"_3010":118909},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3554":71638,"_30673":71600,"_21251":118911,"_5":14613,"_27884":118813,"_3010":118912},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3554":71639,"_30673":71600,"_21251":118914,"_5":14613,"_27884":118813,"_3010":118915},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3554":71640,"_30673":71600,"_21251":118917,"_5":14613,"_27884":118817,"_3010":118918},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3554":71641,"_30673":71600,"_21251":118920,"_5":14613,"_27884":118817,"_3010":118921},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3554":71642,"_30673":71600,"_21251":118923,"_5":14613,"_27884":118817,"_3010":118924},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3554":71643,"_30673":71600,"_21251":118926,"_5":14613,"_27884":118817,"_3010":118927},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3554":71644,"_30673":71600,"_21251":118929,"_5":14613,"_27884":118821,"_3010":118930},[],"Para instalar un checkout local:",{"_3554":71645,"_30673":71600,"_21251":118932,"_5":14613,"_27884":118825,"_3010":118933},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3554":71646,"_30673":71600,"_21251":118935,"_5":14613,"_27884":118825,"_3010":118936},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3554":71647,"_30673":71600,"_21251":118938,"_5":14613,"_27884":118829,"_3010":118939},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3554":71648,"_30673":71600,"_21251":118941,"_5":14613,"_27884":118829,"_3010":118942},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3554":71649,"_30673":71600,"_21251":118944,"_5":14613,"_27884":118829,"_3010":118945},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3554":71650,"_30673":71600,"_21251":118947,"_5":14613,"_27884":118829,"_3010":118948},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3554":71651,"_30673":71600,"_21251":118950,"_5":14613,"_27884":118829,"_3010":118951},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3554":71652,"_30673":71600,"_21251":118953,"_5":14613,"_27884":118833,"_3010":118954},[],"Antes de pasar a producción, revisa:",{"_3554":71653,"_30673":71600,"_21251":118956,"_5":14613,"_27884":118833,"_3010":118957},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3554":71654,"_30673":71600,"_21251":118959,"_5":14613,"_27884":118833,"_3010":118960},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3554":71655,"_30673":71600,"_21251":118962,"_5":14613,"_27884":118833,"_3010":118963},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3554":71656,"_30673":71600,"_21251":118965,"_5":14613,"_27884":118833,"_3010":118966},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3554":71657,"_30673":71600,"_21251":118968,"_5":14613,"_27884":118833,"_3010":118969},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3554":71658,"_30673":71600,"_21251":118971,"_5":14613,"_27884":118833,"_3010":118972},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3554":71659,"_30673":71600,"_21251":118974,"_5":14613,"_27884":118833,"_3010":118975},[],"SMTP, observabilidad y entrega de alertas",{"_3554":71660,"_30673":71600,"_21251":118977,"_5":14613,"_27884":118833,"_3010":118978},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3554":71661,"_30673":71600,"_21251":118980,"_5":14613,"_27884":118833,"_3010":118981},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3554":71662,"_30673":71662,"_5":14965,"_3010":118983,"_31032":118984,"_21251":118985,"_27884":71662},"Expón el Gateway",[50083,118212,118446],[],{"_3554":71663,"_30673":71662,"_21251":118987,"_5":14613,"_27884":71662,"_3010":118988},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3554":71664,"_30673":71662,"_5":31029,"_21251":118990,"_27884":118991,"_3010":118992},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3554":71665,"_30673":71662,"_5":31029,"_21251":118994,"_27884":118995,"_3010":118996},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3554":71666,"_30673":71662,"_5":31029,"_21251":118998,"_27884":118999,"_3010":119000},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3554":71667,"_30673":71662,"_5":31029,"_21251":119002,"_27884":119003,"_3010":50909},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/networking#k3s",{"_3554":71668,"_30673":71662,"_5":31029,"_21251":119005,"_27884":119006,"_3010":119007},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3554":71669,"_30673":71662,"_5":31029,"_21251":119009,"_27884":119010,"_3010":119011},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3554":71670,"_30673":71662,"_5":31029,"_21251":119013,"_27884":119014,"_3010":119015},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3554":71671,"_30673":71662,"_5":31029,"_21251":119017,"_27884":119018,"_3010":119019},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3554":71672,"_30673":71662,"_5":31029,"_21251":119021,"_27884":119022,"_3010":119023},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3554":71673,"_30673":71662,"_5":31029,"_21251":119025,"_27884":119026,"_3010":119027},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3554":71674,"_30673":71662,"_5":31029,"_21251":119029,"_27884":119030,"_3010":119031},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3554":71675,"_30673":71662,"_21251":119033,"_5":14613,"_27884":118991,"_3010":119034},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3554":71676,"_30673":71662,"_21251":119036,"_5":14613,"_27884":118991,"_3010":119037},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3554":71677,"_30673":71662,"_21251":119039,"_5":14613,"_27884":118995,"_3010":119040},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3554":71678,"_30673":71662,"_21251":119042,"_5":14613,"_27884":118995,"_3010":119043},[],"Defínelo únicamente cuando:",{"_3554":71679,"_30673":71662,"_21251":119045,"_5":14613,"_27884":118995,"_3010":119046},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3554":71680,"_30673":71662,"_21251":119048,"_5":14613,"_27884":118995,"_3010":119049},[],"esa dirección está asignada a este Gateway",{"_3554":71681,"_30673":71662,"_21251":119051,"_5":14613,"_27884":118995,"_3010":119052},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3554":71682,"_30673":71662,"_21251":119054,"_5":14613,"_27884":118995,"_3010":119055},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3554":71683,"_30673":71662,"_21251":119057,"_5":14613,"_27884":118995,"_3010":119058},[],"No confundas estos valores:",{"_3554":71684,"_30673":71662,"_21251":119060,"_5":14613,"_27884":118995,"_3010":119061},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3554":71685,"_30673":71662,"_21251":119063,"_5":14613,"_27884":118995,"_3010":119064},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3554":71686,"_30673":71662,"_21251":119066,"_5":14613,"_27884":118995,"_3010":119067},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3554":71687,"_30673":71662,"_21251":119069,"_5":14613,"_27884":118999,"_3010":119070},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3554":71688,"_30673":71662,"_21251":119072,"_5":14613,"_27884":118999,"_3010":119073},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3554":71689,"_30673":71662,"_21251":119075,"_5":14613,"_27884":119003,"_3010":119076},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3554":71690,"_30673":71662,"_21251":119078,"_5":14613,"_27884":119003,"_3010":119079},[],"Para el diseño recomendado:",{"_3554":71691,"_30673":71662,"_21251":119081,"_5":14613,"_27884":119003,"_3010":119082},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3554":71692,"_30673":71662,"_21251":119084,"_5":14613,"_27884":119003,"_3010":119085},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3554":71693,"_30673":71662,"_21251":119087,"_5":14613,"_27884":119003,"_3010":119088},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3554":71694,"_30673":71662,"_21251":119090,"_5":14613,"_27884":119003,"_3010":119091},[],"Apunta DNS a la dirección accesible de la VM.",{"_3554":71695,"_30673":71662,"_21251":119093,"_5":14613,"_27884":119003,"_3010":119094},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3554":71696,"_30673":71662,"_21251":119096,"_5":14613,"_27884":119006,"_3010":119097},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3554":71697,"_30673":71662,"_21251":119099,"_5":14613,"_27884":119010,"_3010":119100},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3554":71698,"_30673":71662,"_21251":119102,"_5":14613,"_27884":119010,"_3010":119103},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3554":71699,"_30673":71662,"_21251":119105,"_5":14613,"_27884":119014,"_3010":119106},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3554":71700,"_30673":71662,"_21251":119108,"_5":14613,"_27884":119014,"_3010":119109},[],"Requisito",{"_3554":71701,"_30673":71662,"_21251":119111,"_5":14613,"_27884":119014,"_3010":119112},[],"Diseño recomendado",{"_3554":71702,"_30673":71662,"_21251":119114,"_5":14613,"_27884":119014,"_3010":119115},[],"Consecuencia",{"_3554":71703,"_30673":71662,"_21251":119117,"_5":14613,"_27884":119014,"_3010":119118},[],"Varias URL o servicios de Lamassu",{"_3554":71704,"_30673":71662,"_21251":119120,"_5":14613,"_27884":119014,"_3010":119121},[],"Un Gateway con varias rutas",{"_3554":71705,"_30673":71662,"_21251":119123,"_5":14613,"_27884":119014,"_3010":119124},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3554":71706,"_30673":71662,"_21251":119126,"_5":14613,"_27884":119014,"_3010":119127},[],"Gateways independientes e IP externas distintas",{"_3554":71707,"_30673":71662,"_21251":119129,"_5":14613,"_27884":119014,"_3010":119130},[],"Una VIP por Gateway",{"_3554":71708,"_30673":71662,"_21251":119132,"_5":14613,"_27884":119014,"_3010":119133},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3554":71709,"_30673":71662,"_21251":119135,"_5":14613,"_27884":119014,"_3010":119136},[],"Gateways independientes, un nodo y una IP",{"_3554":71710,"_30673":71662,"_21251":119138,"_5":14613,"_27884":119014,"_3010":119139},[],"Puertos externos diferentes",{"_3554":71711,"_30673":71662,"_21251":119141,"_5":14613,"_27884":119014,"_3010":119142},[],"Los clientes deben indicar puertos no estándar",{"_3554":71712,"_30673":71662,"_21251":119144,"_5":14613,"_27884":119014,"_3010":119145},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3554":71713,"_30673":71662,"_21251":119147,"_5":14613,"_27884":119014,"_3010":119148},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3554":71714,"_30673":71662,"_21251":119150,"_5":14613,"_27884":119014,"_3010":119151},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3554":71715,"_30673":71662,"_21251":119153,"_5":14613,"_27884":119014,"_3010":119154},[],"Recursos Gateway separados pero proxy compartido",{"_3554":71716,"_30673":71662,"_21251":119156,"_5":14613,"_27884":119014,"_3010":119157},[],"Modo merged Gateway de Envoy",{"_3554":71717,"_30673":71662,"_21251":119159,"_5":14613,"_27884":119014,"_3010":119160},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3554":71718,"_30673":71662,"_21251":119162,"_5":14613,"_27884":119014,"_3010":119163},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3554":71719,"_30673":71662,"_21251":119165,"_5":14613,"_27884":119014,"_3010":119166},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3554":71720,"_30673":71662,"_21251":119168,"_5":14613,"_27884":119014,"_3010":119169},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3554":71721,"_30673":71662,"_21251":119171,"_5":14613,"_27884":119014,"_3010":119172},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3554":71722,"_30673":71662,"_21251":119174,"_5":14613,"_27884":119018,"_3010":119175},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3554":71723,"_30673":71662,"_21251":119177,"_5":14613,"_27884":119022,"_3010":119178},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3554":71724,"_30673":71662,"_21251":119180,"_5":14613,"_27884":119022,"_3010":119181},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3554":71725,"_30673":71662,"_21251":119183,"_5":14613,"_27884":119022,"_3010":119184},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3554":71726,"_30673":71662,"_21251":119186,"_5":14613,"_27884":119022,"_3010":119187},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3554":71727,"_30673":71662,"_21251":119189,"_5":14613,"_27884":119022,"_3010":119190},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3554":71728,"_30673":71662,"_21251":119192,"_5":14613,"_27884":119026,"_3010":119193},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3554":71729,"_30673":71662,"_21251":119195,"_5":14613,"_27884":119026,"_3010":119196},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3554":71730,"_30673":71662,"_21251":119198,"_5":14613,"_27884":119030,"_3010":119199},[],"Comprueba, en orden:",{"_3554":71731,"_30673":71662,"_21251":119201,"_5":14613,"_27884":119030,"_3010":119202},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3554":71732,"_30673":71662,"_21251":119204,"_5":14613,"_27884":119030,"_3010":119205},[],"Su estado contiene la dirección esperada.",{"_3554":71733,"_30673":71662,"_21251":119207,"_5":14613,"_27884":119030,"_3010":119208},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3554":71734,"_30673":71662,"_21251":119210,"_5":14613,"_27884":119030,"_3010":119211},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3554":71735,"_30673":71662,"_21251":119213,"_5":14613,"_27884":119030,"_3010":119214},[],"DNS resuelve al endpoint accesible externamente.",{"_3554":71736,"_30673":71662,"_21251":119216,"_5":14613,"_27884":119030,"_3010":119217},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3554":71737,"_30673":71662,"_21251":119219,"_5":14613,"_27884":119030,"_3010":119220},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3554":71738,"_30673":71738,"_5":14965,"_3010":50190,"_31032":119222,"_21251":119223,"_27884":71738},[50083,118212,118446],[],{"_3554":71739,"_30673":71738,"_21251":119225,"_5":14613,"_27884":71738,"_3010":119226},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3554":71740,"_30673":71738,"_5":31029,"_21251":119228,"_27884":119229,"_3010":119230},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3554":71741,"_30673":71738,"_5":31029,"_21251":119232,"_27884":119233,"_3010":119234},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3554":71742,"_30673":71738,"_5":31029,"_21251":119236,"_27884":119237,"_3010":119238},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3554":71743,"_30673":71738,"_5":31029,"_21251":119240,"_27884":119241,"_3010":119242},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3554":71744,"_30673":71738,"_5":31029,"_21251":119244,"_27884":119245,"_3010":119246},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3554":71745,"_30673":71738,"_5":31029,"_21251":119248,"_27884":119249,"_3010":119250},[],"/docs/pr-preview/pr-69/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3554":71746,"_30673":71738,"_21251":119252,"_5":14613,"_27884":119229,"_3010":119253},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3554":71747,"_30673":71738,"_21251":119255,"_5":14613,"_27884":119233,"_3010":119256},[],"Flujo",{"_3554":71748,"_30673":71738,"_21251":119258,"_5":14613,"_27884":119233,"_3010":119259},[],"Úsalo para",{"_3554":71749,"_30673":71738,"_21251":119261,"_5":14613,"_27884":119233,"_3010":119262},[],"Qué instala",{"_3554":71750,"_30673":71738,"_21251":119264,"_5":14613,"_27884":119233,"_3010":51171},[],{"_3554":71751,"_30673":71738,"_21251":119266,"_5":14613,"_27884":119233,"_3010":119267},[],"Producción y entornos controlados",{"_3554":71752,"_30673":71738,"_21251":119269,"_5":14613,"_27884":119233,"_3010":119270},[],"Servicios de Lamassu y recursos de Gateway API",{"_3554":71753,"_30673":71738,"_21251":119272,"_5":14613,"_27884":119233,"_3010":50327},[],{"_3554":71754,"_30673":71738,"_21251":119274,"_5":14613,"_27884":119233,"_3010":119275},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3554":71755,"_30673":71738,"_21251":119277,"_5":14613,"_27884":119233,"_3010":119278},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3554":71756,"_30673":71738,"_21251":119280,"_5":14613,"_27884":119237,"_3010":119281},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3554":71757,"_30673":71738,"_21251":119283,"_5":14613,"_27884":119237,"_3010":119284},[],"Área",{"_3554":71758,"_30673":71738,"_21251":119286,"_5":14613,"_27884":119237,"_3010":119287},[],"El chart de Lamassu proporciona",{"_3554":71759,"_30673":71738,"_21251":119289,"_5":14613,"_27884":119237,"_3010":119290},[],"Tú proporcionas",{"_3554":71760,"_30673":71738,"_21251":119292,"_5":14613,"_27884":119237,"_3010":119293},[],"Aplicaciones Lamassu",{"_3554":71761,"_30673":71738,"_21251":119295,"_5":14613,"_27884":119237,"_3010":119296},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3554":71762,"_30673":71738,"_21251":119298,"_5":14613,"_27884":119237,"_3010":119299},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3554":71763,"_30673":71738,"_21251":119301,"_5":14613,"_27884":119237,"_3010":119302},[],"Datos PostgreSQL",{"_3554":71764,"_30673":71738,"_21251":119304,"_5":14613,"_27884":119237,"_3010":119305},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3554":71765,"_30673":71738,"_21251":119307,"_5":14613,"_27884":119237,"_3010":119308},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3554":71766,"_30673":71738,"_21251":119310,"_5":14613,"_27884":119237,"_3010":119311},[],"Mensajería",{"_3554":71767,"_30673":71738,"_21251":119313,"_5":14613,"_27884":119237,"_3010":119314},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3554":71768,"_30673":71738,"_21251":119316,"_5":14613,"_27884":119237,"_3010":119317},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3554":71769,"_30673":71738,"_21251":119319,"_5":14613,"_27884":119237,"_3010":119320},[],"Identidad",{"_3554":71770,"_30673":71738,"_21251":119322,"_5":14613,"_27884":119237,"_3010":119323},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3554":71771,"_30673":71738,"_21251":119325,"_5":14613,"_27884":119237,"_3010":119326},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3554":71772,"_30673":71738,"_21251":119328,"_5":14613,"_27884":119237,"_3010":119329},[],"Enrutamiento externo",{"_3554":71773,"_30673":71738,"_21251":119331,"_5":14613,"_27884":119237,"_3010":119332},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3554":71774,"_30673":71738,"_21251":119334,"_5":14613,"_27884":119237,"_3010":119335},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3554":71775,"_30673":71738,"_21251":119337,"_5":14613,"_27884":119237,"_3010":51245},[],{"_3554":71776,"_30673":71738,"_21251":119339,"_5":14613,"_27884":119237,"_3010":119340},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3554":71777,"_30673":71738,"_21251":119342,"_5":14613,"_27884":119237,"_3010":119343},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3554":71778,"_30673":71738,"_21251":119345,"_5":14613,"_27884":119237,"_3010":119346},[],"Datos persistentes de la aplicación",{"_3554":71779,"_30673":71738,"_21251":119348,"_5":14613,"_27884":119237,"_3010":119349},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3554":71780,"_30673":71738,"_21251":119351,"_5":14613,"_27884":119237,"_3010":119352},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3554":71781,"_30673":71738,"_21251":119354,"_5":14613,"_27884":119237,"_3010":119355},[],"Integraciones opcionales",{"_3554":71782,"_30673":71738,"_21251":119357,"_5":14613,"_27884":119237,"_3010":119358},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3554":71783,"_30673":71738,"_21251":119360,"_5":14613,"_27884":119237,"_3010":119361},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3554":71784,"_30673":71738,"_21251":119363,"_5":14613,"_27884":119237,"_3010":119364},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3554":71785,"_30673":71738,"_21251":119366,"_5":14613,"_27884":119237,"_3010":119367},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3554":71786,"_30673":71738,"_21251":119369,"_5":14613,"_27884":119241,"_3010":119370},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3554":71787,"_30673":71738,"_21251":119372,"_5":14613,"_27884":119241,"_3010":119373},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3554":71788,"_30673":71738,"_21251":119375,"_5":14613,"_27884":119245,"_3010":119376},[],"Kubernetes 1.24 o posterior",{"_3554":71789,"_30673":71738,"_21251":119378,"_5":14613,"_27884":119245,"_3010":119379},[],"Helm 3.2 o posterior",{"_3554":71790,"_30673":71738,"_21251":119381,"_5":14613,"_27884":119245,"_3010":119382},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3554":71791,"_30673":71738,"_21251":119384,"_5":14613,"_27884":119245,"_3010":119385},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3554":71792,"_30673":71738,"_21251":119387,"_5":14613,"_27884":119245,"_3010":119388},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3554":71793,"_30673":71738,"_21251":119390,"_5":14613,"_27884":119245,"_3010":119391},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3554":71794,"_30673":71738,"_21251":119393,"_5":14613,"_27884":119245,"_3010":119394},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3554":71795,"_30673":71738,"_21251":119396,"_5":14613,"_27884":119249,"_3010":119397},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3554":71796,"_30673":71738,"_21251":119399,"_5":14613,"_27884":119249,"_3010":119400},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3554":71797,"_30673":71738,"_21251":119402,"_5":14613,"_27884":119249,"_3010":119403},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3554":71798,"_30673":71738,"_21251":119405,"_5":14613,"_27884":119249,"_3010":119406},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3554":71799,"_30673":71799,"_5":14965,"_3010":119408,"_31032":119409,"_21251":119411,"_27884":71799},"Resolución de problemas de despliegue",[50083,118212,119410],"Operación",[],{"_3554":71800,"_30673":71799,"_21251":119413,"_5":14613,"_27884":71799,"_3010":119414},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3554":71801,"_30673":71799,"_5":31029,"_21251":119416,"_27884":119417,"_3010":119418},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3554":71802,"_30673":71799,"_5":31029,"_21251":119420,"_27884":119421,"_3010":119422},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3554":71803,"_30673":71799,"_5":31029,"_21251":119424,"_27884":119425,"_3010":119426},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3554":71804,"_30673":71799,"_5":31029,"_21251":119428,"_27884":119429,"_3010":119430},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3554":71805,"_30673":71799,"_5":31029,"_21251":119432,"_27884":119433,"_3010":119434},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3554":71806,"_30673":71799,"_5":31029,"_21251":119436,"_27884":119437,"_3010":119438},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3554":71807,"_30673":71799,"_5":31029,"_21251":119440,"_27884":119441,"_3010":119442},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3554":71808,"_30673":71799,"_5":31029,"_21251":119444,"_27884":119445,"_3010":119446},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3554":71809,"_30673":71799,"_5":31029,"_21251":119448,"_27884":119449,"_3010":119450},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3554":71810,"_30673":71799,"_5":31029,"_21251":119452,"_27884":119453,"_3010":119454},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3554":71811,"_30673":71799,"_5":31029,"_21251":119456,"_27884":119457,"_3010":119458},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3554":71812,"_30673":71799,"_5":31029,"_21251":119460,"_27884":119461,"_3010":119462},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3554":71813,"_30673":71799,"_5":31029,"_21251":119464,"_27884":119465,"_3010":119466},[],"/docs/pr-preview/pr-69/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3554":71814,"_30673":71799,"_21251":119468,"_5":14613,"_27884":71799,"_3010":119469},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3554":71815,"_30673":71799,"_21251":119471,"_5":14613,"_27884":119421,"_3010":119472},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3554":71816,"_30673":71799,"_21251":119474,"_5":14613,"_27884":119425,"_3010":119475},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3554":71817,"_30673":71799,"_21251":119477,"_5":14613,"_27884":119429,"_3010":119478},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3554":71818,"_30673":71799,"_21251":119480,"_5":14613,"_27884":119433,"_3010":119481},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3554":71819,"_30673":71799,"_21251":119483,"_5":14613,"_27884":119437,"_3010":119484},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3554":71820,"_30673":71799,"_21251":119486,"_5":14613,"_27884":119441,"_3010":119487},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3554":71821,"_30673":71799,"_21251":119489,"_5":14613,"_27884":119441,"_3010":119490},[],"Ejecuta también la prueba de conectividad del chart:",{"_3554":71822,"_30673":71799,"_21251":119492,"_5":14613,"_27884":119441,"_3010":119493},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3554":71823,"_30673":71799,"_21251":119495,"_5":14613,"_27884":119441,"_3010":119496},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3554":71824,"_30673":71799,"_21251":119498,"_5":14613,"_27884":119445,"_3010":119499},[],"Si recibes un 401:",{"_3554":71825,"_30673":71799,"_21251":119501,"_5":14613,"_27884":119445,"_3010":119502},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3554":71826,"_30673":71799,"_21251":119504,"_5":14613,"_27884":119445,"_3010":119505},[],"verifica emisor, audiencia y expiración del token;",{"_3554":71827,"_30673":71799,"_21251":119507,"_5":14613,"_27884":119445,"_3010":119508},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3554":71828,"_30673":71799,"_21251":119510,"_5":14613,"_27884":119445,"_3010":119511},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3554":71829,"_30673":71799,"_21251":119513,"_5":14613,"_27884":119445,"_3010":119514},[],"Si el login termina pero las APIs devuelven 403:",{"_3554":71830,"_30673":71799,"_21251":119516,"_5":14613,"_27884":119445,"_3010":119517},[],"inspecciona los claims reales del token;",{"_3554":71831,"_30673":71799,"_21251":119519,"_5":14613,"_27884":119445,"_3010":119520},[],"confirma que coinciden con un principal activo;",{"_3554":71832,"_30673":71799,"_21251":119522,"_5":14613,"_27884":119445,"_3010":119523},[],"revisa las políticas concedidas al principal;",{"_3554":71833,"_30673":71799,"_21251":119525,"_5":14613,"_27884":119445,"_3010":119526},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3554":71834,"_30673":71799,"_21251":119528,"_5":14613,"_27884":119445,"_3010":119529},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3554":71835,"_30673":71799,"_21251":119531,"_5":14613,"_27884":119449,"_3010":119532},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3554":71836,"_30673":71799,"_21251":119534,"_5":14613,"_27884":119449,"_3010":119535},[],"Localiza el pod y Service de authz.",{"_3554":71837,"_30673":71799,"_21251":119537,"_5":14613,"_27884":119449,"_3010":119538},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3554":71838,"_30673":71799,"_21251":119540,"_5":14613,"_27884":119449,"_3010":119541},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3554":71839,"_30673":71799,"_21251":119543,"_5":14613,"_27884":119449,"_3010":119544},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3554":71840,"_30673":71799,"_21251":119546,"_5":14613,"_27884":119449,"_3010":119547},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3554":71841,"_30673":71799,"_21251":119549,"_5":14613,"_27884":119453,"_3010":119550},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3554":71842,"_30673":71799,"_21251":119552,"_5":14613,"_27884":119457,"_3010":119553},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3554":71843,"_30673":71799,"_21251":119555,"_5":14613,"_27884":119457,"_3010":119556},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3554":71844,"_30673":71799,"_21251":119558,"_5":14613,"_27884":119457,"_3010":119559},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3554":71845,"_30673":71799,"_21251":119561,"_5":14613,"_27884":119457,"_3010":119562},[],"volumen persistente sin enlazar;",{"_3554":71846,"_30673":71799,"_21251":119564,"_5":14613,"_27884":119457,"_3010":119565},[],"imagen inaccesible o política de pull incorrecta;",{"_3554":71847,"_30673":71799,"_21251":119567,"_5":14613,"_27884":119457,"_3010":119568},[],"configuración inválida del motor criptográfico;",{"_3554":71848,"_30673":71799,"_21251":119570,"_5":14613,"_27884":119457,"_3010":119571},[],"límites de CPU o memoria demasiado bajos;",{"_3554":71849,"_30673":71799,"_21251":119573,"_5":14613,"_27884":119457,"_3010":119574},[],"migración previa incompleta.",{"_3554":71850,"_30673":71799,"_21251":119576,"_5":14613,"_27884":119457,"_3010":119577},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3554":71851,"_30673":71799,"_21251":119579,"_5":14613,"_27884":119457,"_3010":119580},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3554":71852,"_30673":71799,"_21251":119582,"_5":14613,"_27884":119457,"_3010":119583},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3554":71853,"_30673":71799,"_21251":119585,"_5":14613,"_27884":119461,"_3010":119586},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3554":71854,"_30673":71799,"_21251":119588,"_5":14613,"_27884":119461,"_3010":119589},[],"verifica que esté habilitado en el servicio emisor;",{"_3554":71855,"_30673":71799,"_21251":119591,"_5":14613,"_27884":119461,"_3010":119592},[],"comprueba conectividad y credenciales AMQP;",{"_3554":71856,"_30673":71799,"_21251":119594,"_5":14613,"_27884":119461,"_3010":119595},[],"revisa exchange, routing key, colas y consumidores;",{"_3554":71857,"_30673":71799,"_21251":119597,"_5":14613,"_27884":119461,"_3010":119598},[],"inspecciona dead-letter queues;",{"_3554":71858,"_30673":71799,"_21251":119600,"_5":14613,"_27884":119461,"_3010":119601},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3554":71859,"_30673":71799,"_21251":119603,"_5":14613,"_27884":119461,"_3010":119604},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3554":71860,"_30673":71799,"_21251":119606,"_5":14613,"_27884":119461,"_3010":119607},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3554":71861,"_30673":71799,"_21251":119609,"_5":14613,"_27884":119461,"_3010":119610},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3554":71862,"_30673":71799,"_21251":119612,"_5":14613,"_27884":119461,"_3010":119613},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3554":71863,"_30673":71799,"_21251":119615,"_5":14613,"_27884":119461,"_3010":119616},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3554":71864,"_30673":71799,"_21251":119618,"_5":14613,"_27884":119461,"_3010":119619},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3554":71865,"_30673":71799,"_21251":119621,"_5":14613,"_27884":119461,"_3010":119622},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3554":71866,"_30673":71799,"_21251":119624,"_5":14613,"_27884":119465,"_3010":119625},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3554":71867,"_30673":71799,"_21251":119627,"_5":14613,"_27884":119465,"_3010":119628},[],"Antes de cerrar una incidencia, guarda:",{"_3554":71868,"_30673":71799,"_21251":119630,"_5":14613,"_27884":119465,"_3010":119631},[],"causa confirmada;",{"_3554":71869,"_30673":71799,"_21251":119633,"_5":14613,"_27884":119465,"_3010":119634},[],"alcance temporal y recursos afectados;",{"_3554":71870,"_30673":71799,"_21251":119636,"_5":14613,"_27884":119465,"_3010":119637},[],"comandos o consultas utilizados;",{"_3554":71871,"_30673":71799,"_21251":119639,"_5":14613,"_27884":119465,"_3010":119640},[],"cambio aplicado y forma de revertirlo;",{"_3554":71872,"_30673":71799,"_21251":119642,"_5":14613,"_27884":119465,"_3010":119643},[],"validación desde un consumidor;",{"_3554":71873,"_30673":71799,"_21251":119645,"_5":14613,"_27884":119465,"_3010":119646},[],"acción preventiva y propietario.",{"_3554":71874,"_30673":71874,"_5":14965,"_3010":119648,"_31032":119649,"_21251":119653,"_27884":71874},"Modelo de datos",[50083,119650,119651,119652],"Plataforma","Administración","Control de acceso",[],{"_3554":71875,"_30673":71874,"_21251":119655,"_5":14613,"_27884":71874,"_3010":119656},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3554":71876,"_30673":71874,"_5":31029,"_21251":119658,"_27884":119659,"_3010":119660},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3554":71877,"_30673":71874,"_5":31029,"_21251":119662,"_27884":119663,"_3010":119664},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3554":71878,"_30673":71874,"_21251":119666,"_5":14613,"_27884":71874,"_3010":119667},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3554":71879,"_30673":71874,"_21251":119669,"_5":14613,"_27884":119659,"_3010":119670},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3554":71880,"_30673":71874,"_21251":119672,"_5":14613,"_27884":119659,"_3010":119673},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3554":71881,"_30673":71874,"_21251":119675,"_5":14613,"_27884":119659,"_3010":119676},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3554":71882,"_30673":71874,"_21251":119678,"_5":14613,"_27884":119663,"_3010":119679},[],"Entidad (`schema_name.entity_type`)",{"_3554":71883,"_30673":71874,"_21251":119681,"_5":14613,"_27884":119663,"_3010":119682},[],"Tabla (`table_name`)",{"_3554":71884,"_30673":71874,"_21251":119684,"_5":14613,"_27884":119663,"_3010":119685},[],"Clave (`primary_key`)",{"_3554":71885,"_30673":71874,"_21251":119687,"_5":14613,"_27884":119663,"_3010":51596},[],{"_3554":71886,"_30673":71874,"_21251":119689,"_5":14613,"_27884":119663,"_3010":51599},[],{"_3554":71887,"_30673":71874,"_21251":119691,"_5":14613,"_27884":119663,"_3010":51602},[],{"_3554":71888,"_30673":71874,"_21251":119693,"_5":14613,"_27884":119663,"_3010":51605},[],{"_3554":71889,"_30673":71874,"_21251":119695,"_5":14613,"_27884":119663,"_3010":51608},[],{"_3554":71890,"_30673":71874,"_21251":119697,"_5":14613,"_27884":119663,"_3010":51611},[],{"_3554":71891,"_30673":71874,"_21251":119699,"_5":14613,"_27884":119663,"_3010":51614},[],{"_3554":71892,"_30673":71874,"_21251":119701,"_5":14613,"_27884":119663,"_3010":51617},[],{"_3554":71893,"_30673":71874,"_21251":119703,"_5":14613,"_27884":119663,"_3010":51611},[],{"_3554":71894,"_30673":71874,"_21251":119705,"_5":14613,"_27884":119663,"_3010":51622},[],{"_3554":71895,"_30673":71874,"_21251":119707,"_5":14613,"_27884":119663,"_3010":51625},[],{"_3554":71896,"_30673":71874,"_21251":119709,"_5":14613,"_27884":119663,"_3010":51628},[],{"_3554":71897,"_30673":71874,"_21251":119711,"_5":14613,"_27884":119663,"_3010":51631},[],{"_3554":71898,"_30673":71874,"_21251":119713,"_5":14613,"_27884":119663,"_3010":51634},[],{"_3554":71899,"_30673":71874,"_21251":119715,"_5":14613,"_27884":119663,"_3010":51611},[],{"_3554":71900,"_30673":71874,"_21251":119717,"_5":14613,"_27884":119663,"_3010":51639},[],{"_3554":71901,"_30673":71874,"_21251":119719,"_5":14613,"_27884":119663,"_3010":51642},[],{"_3554":71902,"_30673":71874,"_21251":119721,"_5":14613,"_27884":119663,"_3010":51611},[],{"_3554":71903,"_30673":71874,"_21251":119723,"_5":14613,"_27884":119663,"_3010":51647},[],{"_3554":71904,"_30673":71874,"_21251":119725,"_5":14613,"_27884":119663,"_3010":51650},[],{"_3554":71905,"_30673":71874,"_21251":119727,"_5":14613,"_27884":119663,"_3010":51611},[],{"_3554":71906,"_30673":71874,"_21251":119729,"_5":14613,"_27884":119663,"_3010":51655},[],{"_3554":71907,"_30673":71874,"_21251":119731,"_5":14613,"_27884":119663,"_3010":51658},[],{"_3554":71908,"_30673":71874,"_21251":119733,"_5":14613,"_27884":119663,"_3010":51611},[],{"_3554":71909,"_30673":71874,"_21251":119735,"_5":14613,"_27884":119663,"_3010":51663},[],{"_3554":71910,"_30673":71874,"_21251":119737,"_5":14613,"_27884":119663,"_3010":51666},[],{"_3554":71911,"_30673":71874,"_21251":119739,"_5":14613,"_27884":119663,"_3010":51669},[],{"_3554":71912,"_30673":71874,"_21251":119741,"_5":14613,"_27884":119663,"_3010":51672},[],{"_3554":71913,"_30673":71874,"_21251":119743,"_5":14613,"_27884":119663,"_3010":51675},[],{"_3554":71914,"_30673":71874,"_21251":119745,"_5":14613,"_27884":119663,"_3010":51678},[],{"_3554":71915,"_30673":71874,"_21251":119747,"_5":14613,"_27884":119663,"_3010":119748},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3554":71916,"_30673":71874,"_21251":119750,"_5":14613,"_27884":119663,"_3010":119751},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3554":71917,"_30673":71874,"_21251":119753,"_5":14613,"_27884":119663,"_3010":119754},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3554":71918,"_30673":71918,"_5":14965,"_3010":119756,"_31032":119757,"_21251":119758,"_27884":71918},"Visión general del control de acceso",[50083,119650,119651,119652],[],{"_3554":71919,"_30673":71918,"_21251":119760,"_5":14613,"_27884":71918,"_3010":119761},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3554":71920,"_30673":71918,"_5":31029,"_21251":119763,"_27884":119764,"_3010":119765},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3554":71921,"_30673":71918,"_5":31029,"_21251":119767,"_27884":119768,"_3010":119769},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3554":71922,"_30673":71918,"_5":31029,"_21251":119771,"_27884":119772,"_3010":119773},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3554":71923,"_30673":71918,"_5":31029,"_21251":119775,"_27884":119776,"_3010":119777},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3554":71924,"_30673":71918,"_5":31029,"_21251":119779,"_27884":119780,"_3010":119781},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3554":71925,"_30673":71918,"_5":31029,"_21251":119783,"_27884":119784,"_3010":119785},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3554":71926,"_30673":71918,"_5":31029,"_21251":119787,"_27884":119788,"_3010":119789},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3554":71927,"_30673":71918,"_5":31029,"_21251":119791,"_27884":119792,"_3010":119793},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3554":71928,"_30673":71918,"_5":31029,"_21251":119795,"_27884":119796,"_3010":119797},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3554":71929,"_30673":71918,"_5":31029,"_21251":119799,"_27884":119800,"_3010":119801},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3554":71930,"_30673":71918,"_5":31029,"_21251":119803,"_27884":119804,"_3010":119805},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3554":71931,"_30673":71918,"_5":31029,"_21251":119807,"_27884":119808,"_3010":119809},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3554":71932,"_30673":71918,"_5":31029,"_21251":119811,"_27884":119812,"_3010":119813},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3554":71933,"_30673":71918,"_5":31029,"_21251":119815,"_27884":119816,"_3010":119817},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3554":71934,"_30673":71918,"_5":31029,"_21251":119819,"_27884":119820,"_3010":119821},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3554":71935,"_30673":71918,"_5":31029,"_21251":119823,"_27884":119824,"_3010":118818},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3554":71936,"_30673":71918,"_5":31029,"_21251":119826,"_27884":119827,"_3010":119828},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3554":71937,"_30673":71918,"_5":31029,"_21251":119830,"_27884":119831,"_3010":119832},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3554":71938,"_30673":71918,"_5":31029,"_21251":119834,"_27884":119835,"_3010":119836},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3554":71939,"_30673":71918,"_5":31029,"_21251":119838,"_27884":119839,"_3010":119840},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3554":71940,"_30673":71918,"_5":31029,"_21251":119842,"_27884":119843,"_3010":119844},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3554":71941,"_30673":71918,"_5":31029,"_21251":119846,"_27884":119847,"_3010":119848},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3554":71942,"_30673":71918,"_5":31029,"_21251":119850,"_27884":119851,"_3010":119852},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3554":71943,"_30673":71918,"_5":31029,"_21251":119854,"_27884":119855,"_3010":119856},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3554":71944,"_30673":71918,"_5":31029,"_21251":119858,"_27884":119859,"_3010":119860},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3554":71945,"_30673":71918,"_5":31029,"_21251":119862,"_27884":119863,"_3010":119864},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3554":71946,"_30673":71918,"_5":31029,"_21251":119866,"_27884":119867,"_3010":119868},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3554":71947,"_30673":71918,"_5":31029,"_21251":119870,"_27884":119871,"_3010":119872},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3554":71948,"_30673":71918,"_5":31029,"_21251":119874,"_27884":119875,"_3010":119876},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3554":71949,"_30673":71918,"_5":31029,"_21251":119878,"_27884":119879,"_3010":119880},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3554":71950,"_30673":71918,"_5":31029,"_21251":119882,"_27884":119883,"_3010":119884},[],"/docs/pr-preview/pr-69/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3554":71951,"_30673":71918,"_21251":119886,"_5":14613,"_27884":71918,"_3010":119887},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3554":71952,"_30673":71918,"_21251":119889,"_5":14613,"_27884":71918,"_3010":119890},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3554":71953,"_30673":71918,"_21251":119892,"_5":14613,"_27884":71918,"_3010":119893},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3554":71954,"_30673":71918,"_21251":119895,"_5":14613,"_27884":119764,"_3010":119896},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3554":71955,"_30673":71918,"_21251":119898,"_5":14613,"_27884":119764,"_3010":119899},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3554":71956,"_30673":71918,"_21251":119901,"_5":14613,"_27884":119764,"_3010":119902},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3554":71957,"_30673":71918,"_21251":119904,"_5":14613,"_27884":119764,"_3010":119905},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3554":71958,"_30673":71918,"_21251":119907,"_5":14613,"_27884":119764,"_3010":119908},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3554":71959,"_30673":71918,"_21251":119910,"_5":14613,"_27884":119764,"_3010":119911},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3554":71960,"_30673":71918,"_21251":119913,"_5":14613,"_27884":119768,"_3010":119914},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3554":71961,"_30673":71918,"_21251":119916,"_5":14613,"_27884":119768,"_3010":119917},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3554":71962,"_30673":71918,"_21251":119919,"_5":14613,"_27884":119772,"_3010":119920},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3554":71963,"_30673":71918,"_21251":119922,"_5":14613,"_27884":119772,"_3010":119923},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3554":71964,"_30673":71918,"_21251":119925,"_5":14613,"_27884":119772,"_3010":119926},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3554":71965,"_30673":71918,"_21251":119928,"_5":14613,"_27884":119772,"_3010":119929},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3554":71966,"_30673":71918,"_21251":119931,"_5":14613,"_27884":119772,"_3010":119932},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3554":71967,"_30673":71918,"_21251":119934,"_5":14613,"_27884":119772,"_3010":119935},[],"Carga por separado las políticas concedidas a cada principal.",{"_3554":71968,"_30673":71918,"_21251":119937,"_5":14613,"_27884":119772,"_3010":119938},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3554":71969,"_30673":71918,"_21251":119940,"_5":14613,"_27884":119772,"_3010":119941},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3554":71970,"_30673":71918,"_21251":119943,"_5":14613,"_27884":119772,"_3010":119944},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3554":71971,"_30673":71918,"_21251":119946,"_5":14613,"_27884":119772,"_3010":119947},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3554":71972,"_30673":71918,"_21251":119949,"_5":14613,"_27884":119772,"_3010":119950},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3554":71973,"_30673":71918,"_21251":119952,"_5":14613,"_27884":119772,"_3010":119953},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3554":71974,"_30673":71918,"_21251":119955,"_5":14613,"_27884":119776,"_3010":119956},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3554":71975,"_30673":71918,"_21251":119958,"_5":14613,"_27884":119776,"_3010":119959},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3554":71976,"_30673":71918,"_21251":119961,"_5":14613,"_27884":119776,"_3010":119962},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3554":71977,"_30673":71918,"_21251":119964,"_5":14613,"_27884":119776,"_3010":119965},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3554":71978,"_30673":71918,"_21251":119967,"_5":14613,"_27884":119776,"_3010":119968},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3554":71979,"_30673":71918,"_21251":119970,"_5":14613,"_27884":119776,"_3010":119971},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3554":71980,"_30673":71918,"_21251":119973,"_5":14613,"_27884":119776,"_3010":119974},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3554":71981,"_30673":71918,"_21251":119976,"_5":14613,"_27884":119776,"_3010":119977},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3554":71982,"_30673":71918,"_21251":119979,"_5":14613,"_27884":119776,"_3010":119980},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3554":71983,"_30673":71918,"_21251":119982,"_5":14613,"_27884":119776,"_3010":119983},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3554":71984,"_30673":71918,"_21251":119985,"_5":14613,"_27884":119780,"_3010":119986},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3554":71985,"_30673":71918,"_21251":119988,"_5":14613,"_27884":119780,"_3010":119989},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3554":71986,"_30673":71918,"_21251":119991,"_5":14613,"_27884":119780,"_3010":119992},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3554":71987,"_30673":71918,"_21251":119994,"_5":14613,"_27884":119780,"_3010":119995},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3554":71988,"_30673":71918,"_21251":119997,"_5":14613,"_27884":119780,"_3010":119998},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3554":71989,"_30673":71918,"_21251":120000,"_5":14613,"_27884":119780,"_3010":120001},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3554":71990,"_30673":71918,"_21251":120003,"_5":14613,"_27884":119780,"_3010":120004},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3554":71991,"_30673":71918,"_21251":120006,"_5":14613,"_27884":119780,"_3010":120007},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3554":71992,"_30673":71918,"_21251":120009,"_5":14613,"_27884":119780,"_3010":120010},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3554":71993,"_30673":71918,"_21251":120012,"_5":14613,"_27884":119780,"_3010":120013},[],"Las acciones se dividen en dos grupos:",{"_3554":71994,"_30673":71918,"_21251":120015,"_5":14613,"_27884":119780,"_3010":120016},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3554":71995,"_30673":71918,"_21251":120018,"_5":14613,"_27884":119780,"_3010":120019},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3554":71996,"_30673":71918,"_21251":120021,"_5":14613,"_27884":119780,"_3010":120022},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3554":71997,"_30673":71918,"_21251":120024,"_5":14613,"_27884":119784,"_3010":120025},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3554":71998,"_30673":71918,"_21251":120027,"_5":14613,"_27884":119784,"_3010":120028},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3554":71999,"_30673":71918,"_21251":120030,"_5":14613,"_27884":119784,"_3010":120031},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3554":72000,"_30673":71918,"_21251":120033,"_5":14613,"_27884":119788,"_3010":120034},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3554":72001,"_30673":71918,"_21251":120036,"_5":14613,"_27884":119788,"_3010":120037},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3554":72002,"_30673":71918,"_21251":120039,"_5":14613,"_27884":119788,"_3010":120040},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3554":72003,"_30673":71918,"_21251":120042,"_5":14613,"_27884":119788,"_3010":120043},[],"Los operadores implementados son:",{"_3554":72004,"_30673":71918,"_21251":120045,"_5":14613,"_27884":119788,"_3010":120046},[],"`equals`, para igualdad exacta;",{"_3554":72005,"_30673":71918,"_21251":120048,"_5":14613,"_27884":119788,"_3010":120049},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3554":72006,"_30673":71918,"_21251":120051,"_5":14613,"_27884":119788,"_3010":120052},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3554":72007,"_30673":71918,"_21251":120054,"_5":14613,"_27884":119788,"_3010":120055},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3554":72008,"_30673":71918,"_21251":120057,"_5":14613,"_27884":119792,"_3010":120058},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3554":72009,"_30673":71918,"_21251":120060,"_5":14613,"_27884":119792,"_3010":120061},[],"Los modos disponibles son:",{"_3554":72010,"_30673":71918,"_21251":120063,"_5":14613,"_27884":119792,"_3010":120064},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3554":72011,"_30673":71918,"_21251":120066,"_5":14613,"_27884":119792,"_3010":120067},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3554":72012,"_30673":71918,"_21251":120069,"_5":14613,"_27884":119792,"_3010":120070},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3554":72013,"_30673":71918,"_21251":120072,"_5":14613,"_27884":119792,"_3010":120073},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3554":72014,"_30673":71918,"_21251":120075,"_5":14613,"_27884":119792,"_3010":120076},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3554":72015,"_30673":71918,"_21251":120078,"_5":14613,"_27884":119792,"_3010":120079},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3554":72016,"_30673":71918,"_21251":120081,"_5":14613,"_27884":119796,"_3010":120082},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3554":72017,"_30673":71918,"_21251":120084,"_5":14613,"_27884":119796,"_3010":120085},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3554":72018,"_30673":71918,"_21251":120087,"_5":14613,"_27884":119796,"_3010":120088},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3554":72019,"_30673":71918,"_21251":120090,"_5":14613,"_27884":119796,"_3010":120091},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3554":72020,"_30673":71918,"_21251":120093,"_5":14613,"_27884":119804,"_3010":120094},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3554":72021,"_30673":71918,"_21251":120096,"_5":14613,"_27884":119804,"_3010":120097},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3554":72022,"_30673":71918,"_21251":120099,"_5":14613,"_27884":119808,"_3010":120100},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3554":72023,"_30673":71918,"_21251":120102,"_5":14613,"_27884":119808,"_3010":120103},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3554":72024,"_30673":71918,"_21251":120105,"_5":14613,"_27884":119808,"_3010":120106},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3554":72025,"_30673":71918,"_21251":120108,"_5":14613,"_27884":119808,"_3010":120109},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3554":72026,"_30673":71918,"_21251":120111,"_5":14613,"_27884":119808,"_3010":120112},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3554":72027,"_30673":71918,"_21251":120114,"_5":14613,"_27884":119812,"_3010":120115},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3554":72028,"_30673":71918,"_21251":120117,"_5":14613,"_27884":119812,"_3010":120118},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3554":72029,"_30673":71918,"_21251":120120,"_5":14613,"_27884":119812,"_3010":120121},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3554":72030,"_30673":71918,"_21251":120123,"_5":14613,"_27884":119816,"_3010":120124},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3554":72031,"_30673":71918,"_21251":120126,"_5":14613,"_27884":119816,"_3010":120127},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3554":72032,"_30673":71918,"_21251":120129,"_5":14613,"_27884":119816,"_3010":120130},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3554":72033,"_30673":71918,"_21251":120132,"_5":14613,"_27884":119816,"_3010":120133},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3554":72034,"_30673":71918,"_21251":120135,"_5":14613,"_27884":119816,"_3010":120136},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3554":72035,"_30673":71918,"_21251":120138,"_5":14613,"_27884":119816,"_3010":120139},[],"Ten en cuenta que:",{"_3554":72036,"_30673":71918,"_21251":120141,"_5":14613,"_27884":119816,"_3010":120142},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3554":72037,"_30673":71918,"_21251":120144,"_5":14613,"_27884":119816,"_3010":120145},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3554":72038,"_30673":71918,"_21251":120147,"_5":14613,"_27884":119816,"_3010":120148},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3554":72039,"_30673":71918,"_21251":120150,"_5":14613,"_27884":119820,"_3010":120151},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3554":72040,"_30673":71918,"_21251":120153,"_5":14613,"_27884":119820,"_3010":120154},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3554":72041,"_30673":71918,"_21251":120156,"_5":14613,"_27884":119820,"_3010":120157},[],"acceso completo y de solo lectura a KMS;",{"_3554":72042,"_30673":71918,"_21251":120159,"_5":14613,"_27884":119820,"_3010":120160},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3554":72043,"_30673":71918,"_21251":120162,"_5":14613,"_27884":119820,"_3010":120163},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3554":72044,"_30673":71918,"_21251":120165,"_5":14613,"_27884":119820,"_3010":120166},[],"acceso a la interfaz;",{"_3554":72045,"_30673":71918,"_21251":120168,"_5":14613,"_27884":119820,"_3010":120169},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3554":72046,"_30673":71918,"_21251":120171,"_5":14613,"_27884":119820,"_3010":120172},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3554":72047,"_30673":71918,"_21251":120174,"_5":14613,"_27884":119820,"_3010":120175},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3554":72048,"_30673":71918,"_21251":120177,"_5":14613,"_27884":119820,"_3010":120178},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3554":72049,"_30673":71918,"_21251":120180,"_5":14613,"_27884":119820,"_3010":120181},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3554":72050,"_30673":71918,"_21251":120183,"_5":14613,"_27884":119824,"_3010":120184},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3554":72051,"_30673":71918,"_21251":120186,"_5":14613,"_27884":119824,"_3010":120187},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3554":72052,"_30673":71918,"_21251":120189,"_5":14613,"_27884":119824,"_3010":120190},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3554":72053,"_30673":71918,"_21251":120192,"_5":14613,"_27884":119827,"_3010":120193},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3554":72054,"_30673":71918,"_21251":120195,"_5":14613,"_27884":119831,"_3010":120196},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3554":72055,"_30673":71918,"_21251":120198,"_5":14613,"_27884":119831,"_3010":120199},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3554":72056,"_30673":71918,"_21251":120201,"_5":14613,"_27884":119835,"_3010":120202},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3554":72057,"_30673":71918,"_21251":120204,"_5":14613,"_27884":119839,"_3010":120205},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3554":72058,"_30673":71918,"_21251":120207,"_5":14613,"_27884":119843,"_3010":120208},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3554":72059,"_30673":71918,"_21251":120210,"_5":14613,"_27884":119847,"_3010":120211},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3554":72060,"_30673":71918,"_21251":120213,"_5":14613,"_27884":119847,"_3010":120214},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3554":72061,"_30673":71918,"_21251":120216,"_5":14613,"_27884":119851,"_3010":120217},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3554":72062,"_30673":71918,"_21251":120219,"_5":14613,"_27884":119851,"_3010":120220},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3554":72063,"_30673":71918,"_21251":120222,"_5":14613,"_27884":119851,"_3010":120223},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3554":72064,"_30673":71918,"_21251":120225,"_5":14613,"_27884":119851,"_3010":120226},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3554":72065,"_30673":71918,"_21251":120228,"_5":14613,"_27884":119851,"_3010":120229},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3554":72066,"_30673":71918,"_21251":120231,"_5":14613,"_27884":119851,"_3010":120232},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3554":72067,"_30673":71918,"_21251":120234,"_5":14613,"_27884":119851,"_3010":120235},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3554":72068,"_30673":71918,"_21251":120237,"_5":14613,"_27884":119851,"_3010":120238},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3554":72069,"_30673":71918,"_21251":120240,"_5":14613,"_27884":119855,"_3010":120241},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3554":72070,"_30673":71918,"_21251":120243,"_5":14613,"_27884":119855,"_3010":120244},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3554":72071,"_30673":71918,"_21251":120246,"_5":14613,"_27884":119855,"_3010":120247},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3554":72072,"_30673":71918,"_21251":120249,"_5":14613,"_27884":119859,"_3010":120250},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3554":72073,"_30673":71918,"_21251":120252,"_5":14613,"_27884":119859,"_3010":120253},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3554":72074,"_30673":71918,"_21251":120255,"_5":14613,"_27884":119859,"_3010":120256},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3554":72075,"_30673":71918,"_21251":120258,"_5":14613,"_27884":119859,"_3010":120259},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3554":72076,"_30673":71918,"_21251":120261,"_5":14613,"_27884":119859,"_3010":120262},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3554":72077,"_30673":71918,"_21251":120264,"_5":14613,"_27884":119859,"_3010":120265},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3554":72078,"_30673":71918,"_21251":120267,"_5":14613,"_27884":119859,"_3010":120268},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3554":72079,"_30673":71918,"_21251":120270,"_5":14613,"_27884":119859,"_3010":120271},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3554":72080,"_30673":71918,"_21251":120273,"_5":14613,"_27884":119867,"_3010":120274},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3554":72081,"_30673":71918,"_21251":120276,"_5":14613,"_27884":119871,"_3010":120277},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3554":72082,"_30673":71918,"_21251":120279,"_5":14613,"_27884":119871,"_3010":120280},[],"que exista un principal activo del tipo correcto;",{"_3554":72083,"_30673":71918,"_21251":120282,"_5":14613,"_27884":119871,"_3010":120283},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3554":72084,"_30673":71918,"_21251":120285,"_5":14613,"_27884":119871,"_3010":120286},[],"que todas las condiciones del principal se cumplan;",{"_3554":72085,"_30673":71918,"_21251":120288,"_5":14613,"_27884":119871,"_3010":120289},[],"que el principal tenga concedida la política esperada;",{"_3554":72086,"_30673":71918,"_21251":120291,"_5":14613,"_27884":119871,"_3010":120292},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3554":72087,"_30673":71918,"_21251":120294,"_5":14613,"_27884":119871,"_3010":120295},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3554":72088,"_30673":71918,"_21251":120297,"_5":14613,"_27884":119871,"_3010":120298},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3554":72089,"_30673":71918,"_21251":120300,"_5":14613,"_27884":119871,"_3010":120301},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3554":72090,"_30673":71918,"_21251":120303,"_5":14613,"_27884":119875,"_3010":120304},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3554":72091,"_30673":71918,"_21251":120306,"_5":14613,"_27884":119879,"_3010":120307},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3554":72092,"_30673":71918,"_21251":120309,"_5":14613,"_27884":119883,"_3010":120310},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3554":72093,"_30673":71918,"_21251":120312,"_5":14613,"_27884":119883,"_3010":120313},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3554":72094,"_30673":72094,"_5":14965,"_3010":120315,"_31032":120316,"_21251":120317,"_27884":72094},"Alertas y suscripciones",[50083,119650,119651],[],{"_3554":72095,"_30673":72094,"_21251":120319,"_5":14613,"_27884":72094,"_3010":120320},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3554":72096,"_30673":72094,"_5":31029,"_21251":120322,"_27884":120323,"_3010":120324},[],"/docs/pr-preview/pr-69/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3554":72097,"_30673":72094,"_5":31029,"_21251":120326,"_27884":120327,"_3010":120328},[],"/docs/pr-preview/pr-69/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3554":72098,"_30673":72094,"_5":31029,"_21251":120330,"_27884":120331,"_3010":120332},[],"/docs/pr-preview/pr-69/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3554":72099,"_30673":72094,"_5":31029,"_21251":120334,"_27884":120335,"_3010":120336},[],"/docs/pr-preview/pr-69/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3554":72100,"_30673":72094,"_5":31029,"_21251":120338,"_27884":120339,"_3010":120340},[],"/docs/pr-preview/pr-69/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3554":72101,"_30673":72094,"_5":31029,"_21251":120342,"_27884":120343,"_3010":120344},[],"/docs/pr-preview/pr-69/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3554":72102,"_30673":72094,"_5":31029,"_21251":120346,"_27884":120347,"_3010":120348},[],"/docs/pr-preview/pr-69/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3554":72103,"_30673":72094,"_5":31029,"_21251":120350,"_27884":120351,"_3010":120352},[],"/docs/pr-preview/pr-69/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3554":72104,"_30673":72094,"_5":31029,"_21251":120354,"_27884":120355,"_3010":120356},[],"/docs/pr-preview/pr-69/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3554":72105,"_30673":72094,"_5":31029,"_21251":120358,"_27884":120359,"_3010":120360},[],"/docs/pr-preview/pr-69/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3554":72106,"_30673":72094,"_5":31029,"_21251":120362,"_27884":120363,"_3010":120364},[],"/docs/pr-preview/pr-69/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3554":72107,"_30673":72094,"_21251":120366,"_5":14613,"_27884":72094,"_3010":120367},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3554":72108,"_30673":72094,"_21251":120369,"_5":14613,"_27884":120323,"_3010":120370},[],"Un servicio publica un evento de dominio.",{"_3554":72109,"_30673":72094,"_21251":120372,"_5":14613,"_27884":120323,"_3010":120373},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3554":72110,"_30673":72094,"_21251":120375,"_5":14613,"_27884":120323,"_3010":120376},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3554":72111,"_30673":72094,"_21251":120378,"_5":14613,"_27884":120323,"_3010":120379},[],"Lamassu entrega el evento al canal configurado.",{"_3554":72112,"_30673":72094,"_21251":120381,"_5":14613,"_27884":120323,"_3010":120382},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3554":72113,"_30673":72094,"_21251":120384,"_5":14613,"_27884":120327,"_3010":120385},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3554":72114,"_30673":72094,"_21251":120387,"_5":14613,"_27884":120327,"_3010":120388},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3554":72115,"_30673":72094,"_21251":120390,"_5":14613,"_27884":120327,"_3010":120391},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3554":72116,"_30673":72094,"_21251":120393,"_5":14613,"_27884":120327,"_3010":120394},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3554":72117,"_30673":72094,"_21251":120396,"_5":14613,"_27884":120327,"_3010":120397},[],"`apikey_options` necesita `header` y `key`.",{"_3554":72118,"_30673":72094,"_21251":120399,"_5":14613,"_27884":120327,"_3010":120400},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3554":72119,"_30673":72094,"_21251":120402,"_5":14613,"_27884":120327,"_3010":120403},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3554":72120,"_30673":72094,"_21251":120405,"_5":14613,"_27884":120327,"_3010":120406},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3554":72121,"_30673":72094,"_21251":120408,"_5":14613,"_27884":120335,"_3010":120409},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3554":72122,"_30673":72094,"_21251":120411,"_5":14613,"_27884":120339,"_3010":120412},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3554":72123,"_30673":72094,"_21251":120414,"_5":14613,"_27884":120343,"_3010":120415},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3554":72124,"_30673":72094,"_21251":120417,"_5":14613,"_27884":120343,"_3010":120418},[],"**None** notifica todas las instancias del evento.",{"_3554":72125,"_30673":72094,"_21251":120420,"_5":14613,"_27884":120343,"_3010":120421},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3554":72126,"_30673":72094,"_21251":120423,"_5":14613,"_27884":120343,"_3010":120424},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3554":72127,"_30673":72094,"_21251":120426,"_5":14613,"_27884":120343,"_3010":120427},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3554":72128,"_30673":72094,"_21251":120429,"_5":14613,"_27884":120343,"_3010":120430},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3554":72129,"_30673":72094,"_21251":120432,"_5":14613,"_27884":120343,"_3010":120433},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3554":72130,"_30673":72094,"_21251":120435,"_5":14613,"_27884":120347,"_3010":120436},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3554":72131,"_30673":72094,"_21251":120438,"_5":14613,"_27884":120351,"_3010":120439},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3554":72132,"_30673":72094,"_21251":120441,"_5":14613,"_27884":120351,"_3010":120442},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3554":72133,"_30673":72094,"_21251":120444,"_5":14613,"_27884":120351,"_3010":120445},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3554":72134,"_30673":72094,"_21251":120447,"_5":14613,"_27884":120351,"_3010":120448},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3554":72135,"_30673":72094,"_21251":120450,"_5":14613,"_27884":120351,"_3010":120451},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3554":72136,"_30673":72094,"_21251":120453,"_5":14613,"_27884":120351,"_3010":120454},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3554":72137,"_30673":72094,"_21251":120456,"_5":14613,"_27884":120351,"_3010":120457},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3554":72138,"_30673":72094,"_21251":120459,"_5":14613,"_27884":120351,"_3010":120460},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3554":72139,"_30673":72094,"_21251":120462,"_5":14613,"_27884":120355,"_3010":120463},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3554":72140,"_30673":72094,"_21251":120465,"_5":14613,"_27884":120355,"_3010":120466},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3554":72141,"_30673":72094,"_21251":120468,"_5":14613,"_27884":120355,"_3010":120469},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3554":72142,"_30673":72094,"_21251":120471,"_5":14613,"_27884":120355,"_3010":120472},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3554":72143,"_30673":72094,"_21251":120474,"_5":14613,"_27884":120355,"_3010":120475},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3554":72144,"_30673":72094,"_21251":120477,"_5":14613,"_27884":120355,"_3010":120478},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3554":72145,"_30673":72094,"_21251":120480,"_5":14613,"_27884":120355,"_3010":120481},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3554":72146,"_30673":72094,"_21251":120483,"_5":14613,"_27884":120355,"_3010":120484},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3554":72147,"_30673":72094,"_21251":120486,"_5":14613,"_27884":120359,"_3010":120487},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3554":72148,"_30673":72094,"_21251":120489,"_5":14613,"_27884":120359,"_3010":120490},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3554":72149,"_30673":72094,"_21251":120492,"_5":14613,"_27884":120363,"_3010":120493},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3554":72150,"_30673":72094,"_21251":120495,"_5":14613,"_27884":120363,"_3010":120496},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3554":72151,"_30673":72094,"_21251":120498,"_5":14613,"_27884":120363,"_3010":120499},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3554":72152,"_30673":72094,"_21251":120501,"_5":14613,"_27884":120363,"_3010":120502},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3554":72153,"_30673":72094,"_21251":120504,"_5":14613,"_27884":120363,"_3010":120505},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3554":72154,"_30673":72094,"_21251":120507,"_5":14613,"_27884":120363,"_3010":120508},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3554":72155,"_30673":72094,"_21251":120510,"_5":14613,"_27884":120363,"_3010":120511},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3554":72156,"_30673":72094,"_21251":120513,"_5":14613,"_27884":120363,"_3010":120514},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3554":72157,"_30673":72094,"_21251":120516,"_5":14613,"_27884":120363,"_3010":120517},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3554":72158,"_30673":72094,"_21251":120519,"_5":14613,"_27884":120363,"_3010":120520},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3554":72159,"_30673":72159,"_5":14965,"_3010":120522,"_31032":120523,"_21251":120524,"_27884":72159},"Registros de auditoría",[50083,119650,119651],[],{"_3554":72160,"_30673":72159,"_21251":120526,"_5":14613,"_27884":72159,"_3010":120527},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3554":72161,"_30673":72159,"_5":31029,"_21251":120529,"_27884":120530,"_3010":120531},[],"/docs/pr-preview/pr-69/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3554":72162,"_30673":72159,"_5":31029,"_21251":120533,"_27884":120534,"_3010":120535},[],"/docs/pr-preview/pr-69/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3554":72163,"_30673":72159,"_5":31029,"_21251":120537,"_27884":120538,"_3010":120539},[],"/docs/pr-preview/pr-69/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3554":72164,"_30673":72159,"_5":31029,"_21251":120541,"_27884":120542,"_3010":120543},[],"/docs/pr-preview/pr-69/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3554":72165,"_30673":72159,"_5":31029,"_21251":120545,"_27884":120546,"_3010":120547},[],"/docs/pr-preview/pr-69/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3554":72166,"_30673":72159,"_5":31029,"_21251":120549,"_27884":120550,"_3010":120551},[],"/docs/pr-preview/pr-69/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3554":72167,"_30673":72159,"_5":31029,"_21251":120553,"_27884":120554,"_3010":120555},[],"/docs/pr-preview/pr-69/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3554":72168,"_30673":72159,"_5":31029,"_21251":120557,"_27884":120558,"_3010":120559},[],"/docs/pr-preview/pr-69/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3554":72169,"_30673":72159,"_5":31029,"_21251":120561,"_27884":120562,"_3010":120563},[],"/docs/pr-preview/pr-69/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3554":72170,"_30673":72159,"_5":31029,"_21251":120565,"_27884":120566,"_3010":120567},[],"/docs/pr-preview/pr-69/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3554":72171,"_30673":72159,"_5":31029,"_21251":120569,"_27884":120570,"_3010":120571},[],"/docs/pr-preview/pr-69/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3554":72172,"_30673":72159,"_21251":120573,"_5":14613,"_27884":72159,"_3010":120574},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3554":72173,"_30673":72159,"_21251":120576,"_5":14613,"_27884":120530,"_3010":120577},[],"El cuerpo de auditoría incluye:",{"_3554":72174,"_30673":72159,"_21251":120579,"_5":14613,"_27884":120530,"_3010":120580},[],"input: datos recibidos por la operación;",{"_3554":72175,"_30673":72159,"_21251":120582,"_5":14613,"_27884":120530,"_3010":120583},[],"has\\_error: indica si el servicio devolvió un error;",{"_3554":72176,"_30673":72159,"_21251":120585,"_5":14613,"_27884":120530,"_3010":120586},[],"output: resultado producido o mensaje de error;",{"_3554":72177,"_30673":72159,"_21251":120588,"_5":14613,"_27884":120530,"_3010":120589},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3554":72178,"_30673":72159,"_21251":120591,"_5":14613,"_27884":120530,"_3010":120592},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3554":72179,"_30673":72159,"_21251":120594,"_5":14613,"_27884":120530,"_3010":120595},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3554":72180,"_30673":72159,"_21251":120597,"_5":14613,"_27884":120534,"_3010":120598},[],"El backend aplica auditoría a mutaciones de:",{"_3554":72181,"_30673":72159,"_21251":120600,"_5":14613,"_27884":120534,"_3010":120601},[],"autoridades, certificados y perfiles de emisión;",{"_3554":72182,"_30673":72159,"_21251":120603,"_5":14613,"_27884":120534,"_3010":120604},[],"claves y motores KMS;",{"_3554":72183,"_30673":72159,"_21251":120606,"_5":14613,"_27884":120534,"_3010":120607},[],"dispositivos e identidades;",{"_3554":72184,"_30673":72159,"_21251":120609,"_5":14613,"_27884":120534,"_3010":120610},[],"DMS y operaciones de enrolamiento;",{"_3554":72185,"_30673":72159,"_21251":120612,"_5":14613,"_27884":120534,"_3010":120613},[],"funciones de validación y CRL;",{"_3554":72186,"_30673":72159,"_21251":120615,"_5":14613,"_27884":120534,"_3010":120616},[],"principales, políticas y concesiones de autorización.",{"_3554":72187,"_30673":72159,"_21251":120618,"_5":14613,"_27884":120534,"_3010":120619},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3554":72188,"_30673":72159,"_21251":120621,"_5":14613,"_27884":120538,"_3010":120622},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3554":72189,"_30673":72159,"_21251":120624,"_5":14613,"_27884":120538,"_3010":120625},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3554":72190,"_30673":72159,"_21251":120627,"_5":14613,"_27884":120538,"_3010":120628},[],"Diseña el consumidor para:",{"_3554":72191,"_30673":72159,"_21251":120630,"_5":14613,"_27884":120538,"_3010":120631},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3554":72192,"_30673":72159,"_21251":120633,"_5":14613,"_27884":120538,"_3010":120634},[],"conservar el CloudEvent completo sin modificar;",{"_3554":72193,"_30673":72159,"_21251":120636,"_5":14613,"_27884":120538,"_3010":120637},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3554":72194,"_30673":72159,"_21251":120639,"_5":14613,"_27884":120538,"_3010":120640},[],"cifrar en tránsito y en reposo;",{"_3554":72195,"_30673":72159,"_21251":120642,"_5":14613,"_27884":120538,"_3010":120643},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3554":72196,"_30673":72159,"_21251":120645,"_5":14613,"_27884":120538,"_3010":120646},[],"aplicar una política explícita de retención y legal hold;",{"_3554":72197,"_30673":72159,"_21251":120648,"_5":14613,"_27884":120538,"_3010":120649},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3554":72198,"_30673":72159,"_21251":120651,"_5":14613,"_27884":120542,"_3010":120652},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3554":72199,"_30673":72159,"_21251":120654,"_5":14613,"_27884":120542,"_3010":120655},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3554":72200,"_30673":72159,"_21251":120657,"_5":14613,"_27884":120550,"_3010":120658},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3554":72201,"_30673":72159,"_21251":120660,"_5":14613,"_27884":120554,"_3010":120661},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3554":72202,"_30673":72159,"_21251":120663,"_5":14613,"_27884":120558,"_3010":120664},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3554":72203,"_30673":72159,"_21251":120666,"_5":14613,"_27884":120562,"_3010":120667},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3554":72204,"_30673":72159,"_21251":120669,"_5":14613,"_27884":120566,"_3010":120670},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3554":72205,"_30673":72159,"_21251":120672,"_5":14613,"_27884":120570,"_3010":120673},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3554":72206,"_30673":72159,"_21251":120675,"_5":14613,"_27884":120570,"_3010":120676},[],"aparece un evento de auditoría correcto;",{"_3554":72207,"_30673":72159,"_21251":120678,"_5":14613,"_27884":120570,"_3010":120679},[],"el principal coincide con la identidad utilizada;",{"_3554":72208,"_30673":72159,"_21251":120681,"_5":14613,"_27884":120570,"_3010":120682},[],"el consumidor lo persiste una sola vez;",{"_3554":72209,"_30673":72159,"_21251":120684,"_5":14613,"_27884":120570,"_3010":120685},[],"puede recuperarse por recurso, actor y periodo;",{"_3554":72210,"_30673":72159,"_21251":120687,"_5":14613,"_27884":120570,"_3010":120688},[],"una interrupción del consumidor produce una alerta.",{"_3554":72211,"_30673":72159,"_21251":120690,"_5":14613,"_27884":120570,"_3010":120691},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3554":72212,"_30673":72212,"_5":14965,"_3010":120693,"_31032":120694,"_21251":120695,"_27884":72212},"Arquitectura de la plataforma",[50083,119650],[],{"_3554":72213,"_30673":72212,"_21251":120697,"_5":14613,"_27884":72212,"_3010":120698},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3554":72214,"_30673":72212,"_5":31029,"_21251":120700,"_27884":120701,"_3010":120702},[],"/docs/pr-preview/pr-69/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3554":72215,"_30673":72212,"_5":31029,"_21251":120704,"_27884":120705,"_3010":120706},[],"/docs/pr-preview/pr-69/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3554":72216,"_30673":72212,"_5":31029,"_21251":120708,"_27884":120709,"_3010":120710},[],"/docs/pr-preview/pr-69/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3554":72217,"_30673":72212,"_5":31029,"_21251":120712,"_27884":120713,"_3010":120714},[],"/docs/pr-preview/pr-69/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3554":72218,"_30673":72212,"_5":31029,"_21251":120716,"_27884":120717,"_3010":120718},[],"/docs/pr-preview/pr-69/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3554":72219,"_30673":72212,"_21251":120720,"_5":14613,"_27884":72212,"_3010":120721},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3554":72220,"_30673":72212,"_21251":120723,"_5":14613,"_27884":72212,"_3010":120724},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3554":72221,"_30673":72212,"_21251":120726,"_5":14613,"_27884":120701,"_3010":120727},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3554":72222,"_30673":72212,"_21251":120729,"_5":14613,"_27884":120705,"_3010":120730},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3554":72223,"_30673":72212,"_21251":120732,"_5":14613,"_27884":120709,"_3010":120733},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3554":72224,"_30673":72212,"_21251":120735,"_5":14613,"_27884":120713,"_3010":120736},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3554":72225,"_30673":72212,"_21251":120738,"_5":14613,"_27884":120717,"_3010":120739},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3554":72226,"_30673":72226,"_5":14965,"_3010":120741,"_31032":120742,"_21251":120743,"_27884":72226},"Cómo funciona Lamassu",[50083,119650],[],{"_3554":72227,"_30673":72226,"_21251":120745,"_5":14613,"_27884":72226,"_3010":120746},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3554":72228,"_30673":72226,"_5":31029,"_21251":120748,"_27884":120749,"_3010":120750},[],"/docs/pr-preview/pr-69/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3554":72229,"_30673":72226,"_5":31029,"_21251":120752,"_27884":120753,"_3010":120754},[],"/docs/pr-preview/pr-69/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3554":72230,"_30673":72226,"_21251":120756,"_5":14613,"_27884":72226,"_3010":120757},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3554":72231,"_30673":72226,"_21251":120759,"_5":14613,"_27884":120749,"_3010":120760},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3554":72232,"_30673":72226,"_21251":120762,"_5":14613,"_27884":120749,"_3010":120763},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3554":72233,"_30673":72226,"_21251":120765,"_5":14613,"_27884":120749,"_3010":120766},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3554":72234,"_30673":72226,"_21251":120768,"_5":14613,"_27884":120749,"_3010":120769},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3554":72235,"_30673":72226,"_21251":120771,"_5":14613,"_27884":120749,"_3010":120772},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3554":72236,"_30673":72226,"_21251":120774,"_5":14613,"_27884":120753,"_3010":120775},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3554":72237,"_30673":72226,"_21251":120777,"_5":14613,"_27884":120753,"_3010":120778},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3554":72238,"_30673":72226,"_21251":120780,"_5":14613,"_27884":120753,"_3010":120781},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3554":72239,"_30673":72226,"_21251":120783,"_5":14613,"_27884":120753,"_3010":120784},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3554":72240,"_30673":72226,"_21251":120786,"_5":14613,"_27884":120753,"_3010":120787},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3554":72241,"_30673":72226,"_21251":120789,"_5":14613,"_27884":120753,"_3010":120790},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3554":72242,"_30673":72226,"_21251":120792,"_5":14613,"_27884":120753,"_3010":120793},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3554":72243,"_30673":72243,"_5":14965,"_3010":120795,"_31032":120796,"_21251":120797,"_27884":72243},"Dispositivos e identidades",[50083,119650,52730,120795],[],{"_3554":72244,"_30673":72243,"_21251":120799,"_5":14613,"_27884":72243,"_3010":120800},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3554":72245,"_30673":72243,"_5":31029,"_21251":120802,"_27884":120803,"_3010":120804},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3554":72246,"_30673":72243,"_5":31029,"_21251":120806,"_27884":120807,"_3010":120808},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3554":72247,"_30673":72243,"_5":31029,"_21251":120810,"_27884":120811,"_3010":120812},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3554":72248,"_30673":72243,"_5":31029,"_21251":120814,"_27884":120815,"_3010":120816},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3554":72249,"_30673":72243,"_5":31029,"_21251":120818,"_27884":120819,"_3010":120820},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3554":72250,"_30673":72243,"_5":31029,"_21251":120822,"_27884":120823,"_3010":120824},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3554":72251,"_30673":72243,"_5":31029,"_21251":120826,"_27884":120827,"_3010":120828},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3554":72252,"_30673":72243,"_5":31029,"_21251":120830,"_27884":120831,"_3010":120832},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3554":72253,"_30673":72243,"_5":31029,"_21251":120834,"_27884":120835,"_3010":120836},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3554":72254,"_30673":72243,"_5":31029,"_21251":120838,"_27884":120839,"_3010":120840},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3554":72255,"_30673":72243,"_5":31029,"_21251":120842,"_27884":120843,"_3010":120844},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3554":72256,"_30673":72243,"_21251":120846,"_5":14613,"_27884":72243,"_3010":120847},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3554":72257,"_30673":72243,"_21251":120849,"_5":14613,"_27884":72243,"_3010":120850},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3554":72258,"_30673":72243,"_21251":120852,"_5":14613,"_27884":120803,"_3010":120853},[],"Vista operativa",{"_3554":72259,"_30673":72243,"_21251":120855,"_5":14613,"_27884":120803,"_3010":120856},[],"Interpretación",{"_3554":72260,"_30673":72243,"_21251":120858,"_5":14613,"_27884":120803,"_3010":52793},[],{"_3554":72261,"_30673":72243,"_21251":120860,"_5":14613,"_27884":120803,"_3010":120861},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3554":72262,"_30673":72243,"_21251":120863,"_5":14613,"_27884":120803,"_3010":52799},[],{"_3554":72263,"_30673":72243,"_21251":120865,"_5":14613,"_27884":120803,"_3010":120866},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3554":72264,"_30673":72243,"_21251":120868,"_5":14613,"_27884":120803,"_3010":52805},[],{"_3554":72265,"_30673":72243,"_21251":120870,"_5":14613,"_27884":120803,"_3010":120871},[],"La identidad está en la ventana operativa de renovación.",{"_3554":72266,"_30673":72243,"_21251":120873,"_5":14613,"_27884":120803,"_3010":52811},[],{"_3554":72267,"_30673":72243,"_21251":120875,"_5":14613,"_27884":120803,"_3010":120876},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3554":72268,"_30673":72243,"_21251":120878,"_5":14613,"_27884":120803,"_3010":52817},[],{"_3554":72269,"_30673":72243,"_21251":120880,"_5":14613,"_27884":120803,"_3010":120881},[],"La identidad ha vencido.",{"_3554":72270,"_30673":72243,"_21251":120883,"_5":14613,"_27884":120803,"_3010":52823},[],{"_3554":72271,"_30673":72243,"_21251":120885,"_5":14613,"_27884":120803,"_3010":120886},[],"La identidad está marcada como revocada.",{"_3554":72272,"_30673":72243,"_21251":120888,"_5":14613,"_27884":120803,"_3010":52829},[],{"_3554":72273,"_30673":72243,"_21251":120890,"_5":14613,"_27884":120803,"_3010":120891},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3554":72274,"_30673":72243,"_21251":120893,"_5":14613,"_27884":120803,"_3010":120894},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3554":72275,"_30673":72243,"_21251":120896,"_5":14613,"_27884":120807,"_3010":120897},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3554":72276,"_30673":72243,"_21251":120899,"_5":14613,"_27884":120807,"_3010":120900},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3554":72277,"_30673":72243,"_21251":120902,"_5":14613,"_27884":120807,"_3010":120903},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3554":72278,"_30673":72243,"_21251":120905,"_5":14613,"_27884":120807,"_3010":120906},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3554":72279,"_30673":72243,"_21251":120908,"_5":14613,"_27884":120811,"_3010":120909},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3554":72280,"_30673":72243,"_21251":120911,"_5":14613,"_27884":120815,"_3010":120912},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3554":72281,"_30673":72243,"_21251":120914,"_5":14613,"_27884":120819,"_3010":120915},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3554":72282,"_30673":72243,"_21251":120917,"_5":14613,"_27884":120823,"_3010":120918},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3554":72283,"_30673":72243,"_21251":120920,"_5":14613,"_27884":120827,"_3010":120921},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3554":72284,"_30673":72243,"_21251":120923,"_5":14613,"_27884":120827,"_3010":120924},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3554":72285,"_30673":72243,"_21251":120926,"_5":14613,"_27884":120831,"_3010":120927},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3554":72286,"_30673":72243,"_21251":120929,"_5":14613,"_27884":120831,"_3010":120930},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3554":72287,"_30673":72243,"_21251":120932,"_5":14613,"_27884":120831,"_3010":120933},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3554":72288,"_30673":72243,"_21251":120935,"_5":14613,"_27884":120831,"_3010":120936},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3554":72289,"_30673":72243,"_21251":120938,"_5":14613,"_27884":120831,"_3010":120939},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3554":72290,"_30673":72243,"_21251":120941,"_5":14613,"_27884":120831,"_3010":120942},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3554":72291,"_30673":72243,"_21251":120944,"_5":14613,"_27884":120835,"_3010":120945},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3554":72292,"_30673":72243,"_21251":120947,"_5":14613,"_27884":120835,"_3010":120948},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3554":72293,"_30673":72243,"_21251":120950,"_5":14613,"_27884":120839,"_3010":120951},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3554":72294,"_30673":72243,"_21251":120953,"_5":14613,"_27884":120839,"_3010":120954},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3554":72295,"_30673":72243,"_21251":120956,"_5":14613,"_27884":120839,"_3010":120957},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3554":72296,"_30673":72243,"_21251":120959,"_5":14613,"_27884":120839,"_3010":120960},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3554":72297,"_30673":72243,"_21251":120962,"_5":14613,"_27884":120843,"_3010":120963},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3554":72298,"_30673":72243,"_21251":120965,"_5":14613,"_27884":120843,"_3010":120966},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3554":72299,"_30673":72299,"_5":14965,"_3010":120968,"_31032":120969,"_21251":120971,"_27884":72299},"Identidad inicial y autenticación",[50083,119650,52730,120795,120970],"Enrolamiento con PKI",[],{"_3554":72300,"_30673":72299,"_21251":120973,"_5":14613,"_27884":72299,"_3010":120974},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3554":72301,"_30673":72299,"_5":31029,"_21251":120976,"_27884":120977,"_3010":120978},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3554":72302,"_30673":72299,"_5":31029,"_21251":120980,"_27884":120981,"_3010":120982},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3554":72303,"_30673":72299,"_5":31029,"_21251":120984,"_27884":120985,"_3010":120986},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3554":72304,"_30673":72299,"_5":31029,"_21251":120988,"_27884":120989,"_3010":120990},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3554":72305,"_30673":72299,"_5":31029,"_21251":120992,"_27884":120993,"_3010":120994},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3554":72306,"_30673":72299,"_21251":120996,"_5":14613,"_27884":72299,"_3010":120997},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3554":72307,"_30673":72299,"_21251":120999,"_5":14613,"_27884":120977,"_3010":121000},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3554":72308,"_30673":72299,"_21251":121002,"_5":14613,"_27884":120977,"_3010":121003},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3554":72309,"_30673":72299,"_21251":121005,"_5":14613,"_27884":120981,"_3010":121006},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3554":72310,"_30673":72299,"_21251":121008,"_5":14613,"_27884":120981,"_3010":121009},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3554":72311,"_30673":72299,"_21251":121011,"_5":14613,"_27884":120981,"_3010":121012},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3554":72312,"_30673":72299,"_21251":121014,"_5":14613,"_27884":120985,"_3010":121015},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3554":72313,"_30673":72299,"_21251":121017,"_5":14613,"_27884":120985,"_3010":121018},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3554":72314,"_30673":72299,"_21251":121020,"_5":14613,"_27884":120989,"_3010":121021},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3554":72315,"_30673":72299,"_21251":121023,"_5":14613,"_27884":120989,"_3010":121024},[],"Ejemplo de cuerpo:",{"_3554":72316,"_30673":72299,"_21251":121026,"_5":14613,"_27884":120989,"_3010":121027},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3554":72317,"_30673":72299,"_21251":121029,"_5":14613,"_27884":120989,"_3010":121030},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3554":72318,"_30673":72299,"_21251":121032,"_5":14613,"_27884":120989,"_3010":121033},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3554":72319,"_30673":72299,"_21251":121035,"_5":14613,"_27884":120989,"_3010":121036},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3554":72320,"_30673":72299,"_21251":121038,"_5":14613,"_27884":120993,"_3010":121039},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3554":72321,"_30673":72299,"_21251":121041,"_5":14613,"_27884":120993,"_3010":121042},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3554":72322,"_30673":72322,"_5":14965,"_3010":121044,"_31032":121045,"_21251":121046,"_27884":72322},"Configura y opera el DMS",[50083,119650,52730,120795,120970],[],{"_3554":72323,"_30673":72322,"_21251":121048,"_5":14613,"_27884":72322,"_3010":121049},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3554":72324,"_30673":72322,"_5":31029,"_21251":121051,"_27884":121052,"_3010":118221},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3554":72325,"_30673":72322,"_5":31029,"_21251":121054,"_27884":121055,"_3010":121056},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3554":72326,"_30673":72322,"_5":31029,"_21251":121058,"_27884":121059,"_3010":121060},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3554":72327,"_30673":72322,"_5":31029,"_21251":121062,"_27884":121063,"_3010":121064},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3554":72328,"_30673":72322,"_5":31029,"_21251":121066,"_27884":121067,"_3010":121068},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3554":72329,"_30673":72322,"_5":31029,"_21251":121070,"_27884":121071,"_3010":121072},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3554":72330,"_30673":72322,"_5":31029,"_21251":121074,"_27884":121075,"_3010":121076},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3554":72331,"_30673":72322,"_5":31029,"_21251":121078,"_27884":121079,"_3010":121080},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3554":72332,"_30673":72322,"_5":31029,"_21251":121082,"_27884":121083,"_3010":53025},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3554":72333,"_30673":72322,"_5":31029,"_21251":121085,"_27884":121086,"_3010":53029},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3554":72334,"_30673":72322,"_5":31029,"_21251":121088,"_27884":121089,"_3010":121090},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3554":72335,"_30673":72322,"_5":31029,"_21251":121092,"_27884":121093,"_3010":121094},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3554":72336,"_30673":72322,"_5":31029,"_21251":121096,"_27884":121097,"_3010":121098},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3554":72337,"_30673":72322,"_5":31029,"_21251":121100,"_27884":121101,"_3010":121102},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3554":72338,"_30673":72322,"_5":31029,"_21251":121104,"_27884":121105,"_3010":53049},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3554":72339,"_30673":72322,"_5":31029,"_21251":121107,"_27884":121108,"_3010":121109},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3554":72340,"_30673":72322,"_5":31029,"_21251":121111,"_27884":121112,"_3010":121113},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3554":72341,"_30673":72322,"_5":31029,"_21251":121115,"_27884":121116,"_3010":121117},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3554":72342,"_30673":72322,"_21251":121119,"_5":14613,"_27884":72322,"_3010":121120},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3554":72343,"_30673":72322,"_21251":121122,"_5":14613,"_27884":121052,"_3010":121123},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3554":72344,"_30673":72322,"_21251":121125,"_5":14613,"_27884":121052,"_3010":121126},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3554":72345,"_30673":72322,"_21251":121128,"_5":14613,"_27884":121059,"_3010":121129},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3554":72346,"_30673":72322,"_21251":121131,"_5":14613,"_27884":121063,"_3010":121132},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3554":72347,"_30673":72322,"_21251":121134,"_5":14613,"_27884":121067,"_3010":121135},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3554":72348,"_30673":72322,"_21251":121137,"_5":14613,"_27884":121071,"_3010":121138},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3554":72349,"_30673":72322,"_21251":121140,"_5":14613,"_27884":121075,"_3010":121141},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3554":72350,"_30673":72322,"_21251":121143,"_5":14613,"_27884":121083,"_3010":121144},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3554":72351,"_30673":72322,"_21251":121146,"_5":14613,"_27884":121083,"_3010":121147},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3554":72352,"_30673":72322,"_21251":121149,"_5":14613,"_27884":121086,"_3010":121150},[],"Campo de `settings.enrollment_settings`",{"_3554":72353,"_30673":72322,"_21251":121152,"_5":14613,"_27884":121086,"_3010":121153},[],"Decisión",{"_3554":72354,"_30673":72322,"_21251":121155,"_5":14613,"_27884":121086,"_3010":53100},[],{"_3554":72355,"_30673":72322,"_21251":121157,"_5":14613,"_27884":121086,"_3010":121158},[],"`EST_RFC7030` para estas operaciones.",{"_3554":72356,"_30673":72322,"_21251":121160,"_5":14613,"_27884":121086,"_3010":53106},[],{"_3554":72357,"_30673":72322,"_21251":121162,"_5":14613,"_27884":121086,"_3010":121163},[],"ID de la CA que firmará.",{"_3554":72358,"_30673":72322,"_21251":121165,"_5":14613,"_27884":121086,"_3010":53112},[],{"_3554":72359,"_30673":72322,"_21251":121167,"_5":14613,"_27884":121086,"_3010":121168},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3554":72360,"_30673":72322,"_21251":121170,"_5":14613,"_27884":121086,"_3010":53118},[],{"_3554":72361,"_30673":72322,"_21251":121172,"_5":14613,"_27884":121086,"_3010":121173},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3554":72362,"_30673":72322,"_21251":121175,"_5":14613,"_27884":121086,"_3010":53124},[],{"_3554":72363,"_30673":72322,"_21251":121177,"_5":14613,"_27884":121086,"_3010":121178},[],"Uno de los cuatro modos de autenticación.",{"_3554":72364,"_30673":72322,"_21251":121180,"_5":14613,"_27884":121086,"_3010":121181},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3554":72365,"_30673":72322,"_21251":121183,"_5":14613,"_27884":121089,"_3010":121184},[],"Los bloques son independientes:",{"_3554":72366,"_30673":72322,"_21251":121186,"_5":14613,"_27884":121089,"_3010":121187},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3554":72367,"_30673":72322,"_21251":121189,"_5":14613,"_27884":121089,"_3010":121190},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3554":72368,"_30673":72322,"_21251":121192,"_5":14613,"_27884":121089,"_3010":53142},[],{"_3554":72369,"_30673":72322,"_21251":121194,"_5":14613,"_27884":121089,"_3010":121195},[],"Control aplicado en la operación configurada",{"_3554":72370,"_30673":72322,"_21251":121197,"_5":14613,"_27884":121089,"_3010":53148},[],{"_3554":72371,"_30673":72322,"_21251":121199,"_5":14613,"_27884":121089,"_3010":121200},[],"Validación del certificado presentado.",{"_3554":72372,"_30673":72322,"_21251":121202,"_5":14613,"_27884":121089,"_3010":53154},[],{"_3554":72373,"_30673":72322,"_21251":121204,"_5":14613,"_27884":121089,"_3010":121205},[],"Autorización del webhook configurado.",{"_3554":72374,"_30673":72322,"_21251":121207,"_5":14613,"_27884":121089,"_3010":53160},[],{"_3554":72375,"_30673":72322,"_21251":121209,"_5":14613,"_27884":121089,"_3010":121210},[],"Validación del certificado y, después, aprobación del webhook.",{"_3554":72376,"_30673":72322,"_21251":121212,"_5":14613,"_27884":121089,"_3010":53166},[],{"_3554":72377,"_30673":72322,"_21251":121214,"_5":14613,"_27884":121089,"_3010":121215},[],"Sin autenticación del solicitante por el DMS.",{"_3554":72378,"_30673":72322,"_21251":121217,"_5":14613,"_27884":121089,"_3010":121218},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3554":72379,"_30673":72322,"_21251":121220,"_5":14613,"_27884":121089,"_3010":121221},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3554":72380,"_30673":72322,"_21251":121223,"_5":14613,"_27884":121089,"_3010":121224},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3554":72381,"_30673":72322,"_21251":121226,"_5":14613,"_27884":121089,"_3010":121227},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3554":72382,"_30673":72322,"_21251":121229,"_5":14613,"_27884":121093,"_3010":121230},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3554":72383,"_30673":72322,"_21251":121232,"_5":14613,"_27884":121093,"_3010":121233},[],"Campo de `external_webhook_settings`",{"_3554":72384,"_30673":72322,"_21251":121235,"_5":14613,"_27884":121093,"_3010":121153},[],{"_3554":72385,"_30673":72322,"_21251":121237,"_5":14613,"_27884":121093,"_3010":53192},[],{"_3554":72386,"_30673":72322,"_21251":121239,"_5":14613,"_27884":121093,"_3010":121240},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3554":72387,"_30673":72322,"_21251":121242,"_5":14613,"_27884":121093,"_3010":53198},[],{"_3554":72388,"_30673":72322,"_21251":121244,"_5":14613,"_27884":121093,"_3010":121245},[],"`POST` o `PUT`; `POST` por defecto.",{"_3554":72389,"_30673":72322,"_21251":121247,"_5":14613,"_27884":121093,"_3010":53204},[],{"_3554":72390,"_30673":72322,"_21251":121249,"_5":14613,"_27884":121093,"_3010":121250},[],"Etiqueta usada en los logs del servicio.",{"_3554":72391,"_30673":72322,"_21251":121252,"_5":14613,"_27884":121093,"_3010":53210},[],{"_3554":72392,"_30673":72322,"_21251":121254,"_5":14613,"_27884":121093,"_3010":121255},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3554":72393,"_30673":72322,"_21251":121257,"_5":14613,"_27884":121093,"_3010":53216},[],{"_3554":72394,"_30673":72322,"_21251":121259,"_5":14613,"_27884":121093,"_3010":121260},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3554":72395,"_30673":72322,"_21251":121262,"_5":14613,"_27884":121093,"_3010":53222},[],{"_3554":72396,"_30673":72322,"_21251":121264,"_5":14613,"_27884":121093,"_3010":121265},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3554":72397,"_30673":72322,"_21251":121267,"_5":14613,"_27884":121093,"_3010":53228},[],{"_3554":72398,"_30673":72322,"_21251":121269,"_5":14613,"_27884":121093,"_3010":121270},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3554":72399,"_30673":72322,"_21251":121272,"_5":14613,"_27884":121093,"_3010":53234},[],{"_3554":72400,"_30673":72322,"_21251":121274,"_5":14613,"_27884":121093,"_3010":121275},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3554":72401,"_30673":72322,"_21251":121277,"_5":14613,"_27884":121093,"_3010":53240},[],{"_3554":72402,"_30673":72322,"_21251":121279,"_5":14613,"_27884":121093,"_3010":121280},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3554":72403,"_30673":72322,"_21251":121282,"_5":14613,"_27884":121093,"_3010":53246},[],{"_3554":72404,"_30673":72322,"_21251":121284,"_5":14613,"_27884":121093,"_3010":121285},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3554":72405,"_30673":72322,"_21251":121287,"_5":14613,"_27884":121093,"_3010":121288},[],"Reglas de esa configuración:",{"_3554":72406,"_30673":72322,"_21251":121290,"_5":14613,"_27884":121093,"_3010":121291},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3554":72407,"_30673":72322,"_21251":121293,"_5":14613,"_27884":121093,"_3010":121294},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3554":72408,"_30673":72322,"_21251":121296,"_5":14613,"_27884":121093,"_3010":121297},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3554":72409,"_30673":72322,"_21251":121299,"_5":14613,"_27884":121093,"_3010":121300},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3554":72410,"_30673":72322,"_21251":121302,"_5":14613,"_27884":121093,"_3010":121303},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3554":72411,"_30673":72322,"_21251":121305,"_5":14613,"_27884":121093,"_3010":121306},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3554":72412,"_30673":72322,"_21251":121308,"_5":14613,"_27884":121093,"_3010":121309},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3554":72413,"_30673":72322,"_21251":121311,"_5":14613,"_27884":121093,"_3010":121312},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3554":72414,"_30673":72322,"_21251":121314,"_5":14613,"_27884":121093,"_3010":121315},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3554":72415,"_30673":72322,"_21251":121317,"_5":14613,"_27884":121097,"_3010":121318},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3554":72416,"_30673":72322,"_21251":121320,"_5":14613,"_27884":121101,"_3010":121321},[],"Campo de `settings.reenrollment_settings`",{"_3554":72417,"_30673":72322,"_21251":121323,"_5":14613,"_27884":121101,"_3010":121324},[],"Función",{"_3554":72418,"_30673":72322,"_21251":121326,"_5":14613,"_27884":121101,"_3010":53290},[],{"_3554":72419,"_30673":72322,"_21251":121328,"_5":14613,"_27884":121101,"_3010":121329},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3554":72420,"_30673":72322,"_21251":121331,"_5":14613,"_27884":121101,"_3010":53296},[],{"_3554":72421,"_30673":72322,"_21251":121333,"_5":14613,"_27884":121101,"_3010":121334},[],"Umbral operativo preventivo de monitorización.",{"_3554":72422,"_30673":72322,"_21251":121336,"_5":14613,"_27884":121101,"_3010":53302},[],{"_3554":72423,"_30673":72322,"_21251":121338,"_5":14613,"_27884":121101,"_3010":121339},[],"Umbral operativo crítico de monitorización.",{"_3554":72424,"_30673":72322,"_21251":121341,"_5":14613,"_27884":121101,"_3010":53308},[],{"_3554":72425,"_30673":72322,"_21251":121343,"_5":14613,"_27884":121101,"_3010":121344},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3554":72426,"_30673":72322,"_21251":121346,"_5":14613,"_27884":121101,"_3010":53314},[],{"_3554":72427,"_30673":72322,"_21251":121348,"_5":14613,"_27884":121101,"_3010":121349},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3554":72428,"_30673":72322,"_21251":121351,"_5":14613,"_27884":121101,"_3010":53320},[],{"_3554":72429,"_30673":72322,"_21251":121353,"_5":14613,"_27884":121101,"_3010":121354},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3554":72430,"_30673":72322,"_21251":121356,"_5":14613,"_27884":121101,"_3010":121357},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3554":72431,"_30673":72322,"_21251":121359,"_5":14613,"_27884":121105,"_3010":121360},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3554":72432,"_30673":72322,"_21251":121362,"_5":14613,"_27884":121108,"_3010":118585},[],{"_3554":72433,"_30673":72322,"_21251":121364,"_5":14613,"_27884":121108,"_3010":121365},[],"Qué publica",{"_3554":72434,"_30673":72322,"_21251":121367,"_5":14613,"_27884":121108,"_3010":53337},[],{"_3554":72435,"_30673":72322,"_21251":121369,"_5":14613,"_27884":121108,"_3010":121370},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3554":72436,"_30673":72322,"_21251":121372,"_5":14613,"_27884":121108,"_3010":53343},[],{"_3554":72437,"_30673":72322,"_21251":121374,"_5":14613,"_27884":121108,"_3010":121375},[],"Certificado de la CA emisora seleccionada.",{"_3554":72438,"_30673":72322,"_21251":121377,"_5":14613,"_27884":121108,"_3010":53349},[],{"_3554":72439,"_30673":72322,"_21251":121379,"_5":14613,"_27884":121108,"_3010":121380},[],"Certificados de las CAs elegidas explícitamente.",{"_3554":72440,"_30673":72322,"_21251":121382,"_5":14613,"_27884":121108,"_3010":121383},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3554":72441,"_30673":72322,"_21251":121385,"_5":14613,"_27884":121112,"_3010":121386},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3554":72442,"_30673":72322,"_21251":121388,"_5":14613,"_27884":121112,"_3010":121389},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3554":72443,"_30673":72322,"_21251":121391,"_5":14613,"_27884":121112,"_3010":121392},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3554":72444,"_30673":72322,"_21251":121394,"_5":14613,"_27884":121116,"_3010":121395},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3554":72445,"_30673":72445,"_5":14965,"_3010":121397,"_31032":121398,"_21251":121399,"_27884":72445},"Integra el cliente EST",[50083,119650,52730,120795,120970],[],{"_3554":72446,"_30673":72445,"_21251":121401,"_5":14613,"_27884":72445,"_3010":121402},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3554":72447,"_30673":72445,"_5":31029,"_21251":121404,"_27884":121405,"_3010":118221},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3554":72448,"_30673":72445,"_5":31029,"_21251":121407,"_27884":121408,"_3010":121409},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3554":72449,"_30673":72445,"_5":31029,"_21251":121411,"_27884":121412,"_3010":121413},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3554":72450,"_30673":72445,"_5":31029,"_21251":121415,"_27884":121416,"_3010":121417},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3554":72451,"_30673":72445,"_5":31029,"_21251":121419,"_27884":121420,"_3010":121421},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3554":72452,"_30673":72445,"_5":31029,"_21251":121423,"_27884":121424,"_3010":121425},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3554":72453,"_30673":72445,"_21251":121427,"_5":14613,"_27884":72445,"_3010":121428},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3554":72454,"_30673":72445,"_21251":121430,"_5":14613,"_27884":121405,"_3010":121431},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3554":72455,"_30673":72445,"_21251":121433,"_5":14613,"_27884":121405,"_3010":121434},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3554":72456,"_30673":72445,"_21251":121436,"_5":14613,"_27884":121405,"_3010":121437},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3554":72457,"_30673":72445,"_21251":121439,"_5":14613,"_27884":121408,"_3010":121440},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3554":72458,"_30673":72445,"_21251":121442,"_5":14613,"_27884":121408,"_3010":121443},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3554":72459,"_30673":72445,"_21251":121445,"_5":14613,"_27884":121412,"_3010":121446},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3554":72460,"_30673":72445,"_21251":121448,"_5":14613,"_27884":121412,"_3010":121449},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3554":72461,"_30673":72445,"_21251":121451,"_5":14613,"_27884":121416,"_3010":121452},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3554":72462,"_30673":72445,"_21251":121454,"_5":14613,"_27884":121416,"_3010":121455},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3554":72463,"_30673":72445,"_21251":121457,"_5":14613,"_27884":121420,"_3010":121458},[],"Para el caso de una raíz que emite directamente:",{"_3554":72464,"_30673":72445,"_21251":121460,"_5":14613,"_27884":121420,"_3010":121461},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3554":72465,"_30673":72445,"_21251":121463,"_5":14613,"_27884":121420,"_3010":121464},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3554":72466,"_30673":72445,"_21251":121466,"_5":14613,"_27884":121424,"_3010":121467},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3554":72467,"_30673":72467,"_5":14965,"_3010":121469,"_31032":121470,"_21251":121471,"_27884":72467},"Referencia EST",[50083,119650,52730,120795,120970],[],{"_3554":72468,"_30673":72467,"_21251":121473,"_5":14613,"_27884":72467,"_3010":121474},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3554":72469,"_30673":72467,"_5":31029,"_21251":121476,"_27884":121477,"_3010":121478},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3554":72470,"_30673":72467,"_5":31029,"_21251":121480,"_27884":121481,"_3010":23026},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3554":72471,"_30673":72467,"_5":31029,"_21251":121483,"_27884":121484,"_3010":26456},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3554":72472,"_30673":72467,"_5":31029,"_21251":121486,"_27884":121487,"_3010":26463},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3554":72473,"_30673":72467,"_5":31029,"_21251":121489,"_27884":121490,"_3010":25751},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3554":72474,"_30673":72467,"_5":31029,"_21251":121492,"_27884":121493,"_3010":121494},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3554":72475,"_30673":72467,"_5":31029,"_21251":121496,"_27884":121497,"_3010":121498},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3554":72476,"_30673":72467,"_5":31029,"_21251":121500,"_27884":121501,"_3010":121502},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3554":72477,"_30673":72467,"_21251":121504,"_5":14613,"_27884":72467,"_3010":121505},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3554":72478,"_30673":72467,"_21251":121507,"_5":14613,"_27884":121477,"_3010":121508},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3554":72479,"_30673":72467,"_21251":121510,"_5":14613,"_27884":121477,"_3010":119410},[],{"_3554":72480,"_30673":72467,"_21251":121512,"_5":14613,"_27884":121477,"_3010":121513},[],"Método",{"_3554":72481,"_30673":72467,"_21251":121515,"_5":14613,"_27884":121477,"_3010":121516},[],"Autenticación y condición",{"_3554":72482,"_30673":72467,"_21251":121518,"_5":14613,"_27884":121477,"_3010":53492},[],{"_3554":72483,"_30673":72467,"_21251":121520,"_5":14613,"_27884":121477,"_3010":53495},[],{"_3554":72484,"_30673":72467,"_21251":121522,"_5":14613,"_27884":121477,"_3010":121523},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3554":72485,"_30673":72467,"_21251":121525,"_5":14613,"_27884":121477,"_3010":53501},[],{"_3554":72486,"_30673":72467,"_21251":121527,"_5":14613,"_27884":121477,"_3010":53504},[],{"_3554":72487,"_30673":72467,"_21251":121529,"_5":14613,"_27884":121477,"_3010":121530},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3554":72488,"_30673":72467,"_21251":121532,"_5":14613,"_27884":121477,"_3010":53510},[],{"_3554":72489,"_30673":72467,"_21251":121534,"_5":14613,"_27884":121477,"_3010":53504},[],{"_3554":72490,"_30673":72467,"_21251":121536,"_5":14613,"_27884":121477,"_3010":121537},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3554":72491,"_30673":72467,"_21251":121539,"_5":14613,"_27884":121477,"_3010":53518},[],{"_3554":72492,"_30673":72467,"_21251":121541,"_5":14613,"_27884":121477,"_3010":53504},[],{"_3554":72493,"_30673":72467,"_21251":121543,"_5":14613,"_27884":121477,"_3010":121544},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3554":72494,"_30673":72467,"_21251":121546,"_5":14613,"_27884":121477,"_3010":121547},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3554":72495,"_30673":72467,"_21251":121549,"_5":14613,"_27884":121481,"_3010":121550},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3554":72496,"_30673":72467,"_21251":121552,"_5":14613,"_27884":121481,"_3010":121553},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3554":72497,"_30673":72467,"_21251":121555,"_5":14613,"_27884":121484,"_3010":121556},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3554":72498,"_30673":72467,"_21251":121558,"_5":14613,"_27884":121484,"_3010":121559},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3554":72499,"_30673":72467,"_21251":121561,"_5":14613,"_27884":121487,"_3010":121562},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3554":72500,"_30673":72467,"_21251":121564,"_5":14613,"_27884":121487,"_3010":121565},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3554":72501,"_30673":72467,"_21251":121567,"_5":14613,"_27884":121490,"_3010":121568},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3554":72502,"_30673":72467,"_21251":121570,"_5":14613,"_27884":121490,"_3010":121571},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3554":72503,"_30673":72467,"_21251":121573,"_5":14613,"_27884":121493,"_3010":121574},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3554":72504,"_30673":72467,"_21251":121576,"_5":14613,"_27884":121493,"_3010":121577},[],"Parte",{"_3554":72505,"_30673":72467,"_21251":121579,"_5":14613,"_27884":121493,"_3010":121580},[],"Contenido tras decodificar su Base64",{"_3554":72506,"_30673":72467,"_21251":121582,"_5":14613,"_27884":121493,"_3010":53562},[],{"_3554":72507,"_30673":72467,"_21251":121584,"_5":14613,"_27884":121493,"_3010":121585},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3554":72508,"_30673":72467,"_21251":121587,"_5":14613,"_27884":121493,"_3010":53568},[],{"_3554":72509,"_30673":72467,"_21251":121589,"_5":14613,"_27884":121493,"_3010":121590},[],"PKCS#7 DER con el certificado emitido.",{"_3554":72510,"_30673":72467,"_21251":121592,"_5":14613,"_27884":121493,"_3010":121593},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3554":72511,"_30673":72467,"_21251":121595,"_5":14613,"_27884":121497,"_3010":121596},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3554":72512,"_30673":72467,"_21251":121598,"_5":14613,"_27884":121497,"_3010":121599},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3554":72513,"_30673":72467,"_21251":121601,"_5":14613,"_27884":121497,"_3010":121602},[],"Convierte y comprueba el resultado:",{"_3554":72514,"_30673":72467,"_21251":121604,"_5":14613,"_27884":121497,"_3010":121605},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3554":72515,"_30673":72467,"_21251":121607,"_5":14613,"_27884":121501,"_3010":121608},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3554":72516,"_30673":72467,"_21251":121610,"_5":14613,"_27884":121501,"_3010":121611},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3554":72517,"_30673":72517,"_5":14965,"_3010":120970,"_31032":121613,"_21251":121614,"_27884":72517},[50083,119650,52730,120795,120970],[],{"_3554":72518,"_30673":72517,"_21251":121616,"_5":14613,"_27884":72517,"_3010":121617},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3554":72519,"_30673":72517,"_5":31029,"_21251":121619,"_27884":121620,"_3010":121621},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3554":72520,"_30673":72517,"_5":31029,"_21251":121623,"_27884":121624,"_3010":121625},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3554":72521,"_30673":72517,"_5":31029,"_21251":121627,"_27884":121628,"_3010":121629},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3554":72522,"_30673":72517,"_5":31029,"_21251":121631,"_27884":121632,"_3010":121633},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3554":72523,"_30673":72517,"_21251":121635,"_5":14613,"_27884":72517,"_3010":121636},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3554":72524,"_30673":72517,"_21251":121638,"_5":14613,"_27884":121620,"_3010":121639},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3554":72525,"_30673":72517,"_21251":121641,"_5":14613,"_27884":121620,"_3010":121642},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3554":72526,"_30673":72517,"_21251":121644,"_5":14613,"_27884":121620,"_3010":121645},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3554":72527,"_30673":72517,"_21251":121647,"_5":14613,"_27884":121620,"_3010":121648},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3554":72528,"_30673":72517,"_21251":121650,"_5":14613,"_27884":121620,"_3010":121651},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3554":72529,"_30673":72517,"_21251":121653,"_5":14613,"_27884":121620,"_3010":121654},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3554":72530,"_30673":72517,"_21251":121656,"_5":14613,"_27884":121624,"_3010":121657},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3554":72531,"_30673":72517,"_21251":121659,"_5":14613,"_27884":121624,"_3010":121660},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3554":72532,"_30673":72517,"_21251":121662,"_5":14613,"_27884":121624,"_3010":121663},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3554":72533,"_30673":72517,"_21251":121665,"_5":14613,"_27884":121624,"_3010":121666},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3554":72534,"_30673":72517,"_21251":121668,"_5":14613,"_27884":121628,"_3010":121669},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3554":72535,"_30673":72517,"_21251":121671,"_5":14613,"_27884":121628,"_3010":121672},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3554":72536,"_30673":72517,"_21251":121674,"_5":14613,"_27884":121628,"_3010":121675},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3554":72537,"_30673":72517,"_21251":121677,"_5":14613,"_27884":121628,"_3010":121678},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3554":72538,"_30673":72517,"_21251":121680,"_5":14613,"_27884":121632,"_3010":121681},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3554":72539,"_30673":72517,"_21251":121683,"_5":14613,"_27884":121632,"_3010":121684},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3554":72540,"_30673":72540,"_5":14965,"_3010":121686,"_31032":121687,"_21251":121688,"_27884":72540},"Estrategias de aprovisionamiento",[50083,119650,52730,120795,120970],[],{"_3554":72541,"_30673":72540,"_21251":121690,"_5":14613,"_27884":72540,"_3010":121691},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3554":72542,"_30673":72540,"_5":31029,"_21251":121693,"_27884":121694,"_3010":121695},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3554":72543,"_30673":72540,"_5":31029,"_21251":121697,"_27884":121698,"_3010":121699},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3554":72544,"_30673":72540,"_5":31029,"_21251":121701,"_27884":121702,"_3010":121703},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3554":72545,"_30673":72540,"_5":31029,"_21251":121705,"_27884":121706,"_3010":121707},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3554":72546,"_30673":72540,"_5":31029,"_21251":121709,"_27884":121710,"_3010":121711},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3554":72547,"_30673":72540,"_21251":121713,"_5":14613,"_27884":72540,"_3010":121714},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3554":72548,"_30673":72540,"_21251":121716,"_5":14613,"_27884":121694,"_3010":121717},[],"Recorrido",{"_3554":72549,"_30673":72540,"_21251":121719,"_5":14613,"_27884":121694,"_3010":121720},[],"Cuándo existe el dispositivo",{"_3554":72550,"_30673":72540,"_21251":121722,"_5":14613,"_27884":121694,"_3010":121723},[],"Qué compruebas",{"_3554":72551,"_30673":72540,"_21251":121725,"_5":14613,"_27884":121694,"_3010":121726},[],"Asignación manual",{"_3554":72552,"_30673":72540,"_21251":121728,"_5":14613,"_27884":121694,"_3010":121729},[],"El operador lo crea antes de asociar un certificado.",{"_3554":72553,"_30673":72540,"_21251":121731,"_5":14613,"_27884":121694,"_3010":121732},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3554":72554,"_30673":72540,"_21251":121734,"_5":14613,"_27884":121694,"_3010":121735},[],"EST con `JITP`",{"_3554":72555,"_30673":72540,"_21251":121737,"_5":14613,"_27884":121694,"_3010":121738},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3554":72556,"_30673":72540,"_21251":121740,"_5":14613,"_27884":121694,"_3010":121741},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3554":72557,"_30673":72540,"_21251":121743,"_5":14613,"_27884":121694,"_3010":121744},[],"EST con `PRE_REGISTRATION`",{"_3554":72558,"_30673":72540,"_21251":121746,"_5":14613,"_27884":121694,"_3010":121747},[],"Debe existir antes de `/simpleenroll`.",{"_3554":72559,"_30673":72540,"_21251":121749,"_5":14613,"_27884":121694,"_3010":121750},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3554":72560,"_30673":72540,"_21251":121752,"_5":14613,"_27884":121694,"_3010":121753},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3554":72561,"_30673":72540,"_21251":121755,"_5":14613,"_27884":121694,"_3010":121756},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3554":72562,"_30673":72540,"_21251":121758,"_5":14613,"_27884":121698,"_3010":121759},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3554":72563,"_30673":72540,"_21251":121761,"_5":14613,"_27884":121698,"_3010":121762},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3554":72564,"_30673":72540,"_21251":121764,"_5":14613,"_27884":121698,"_3010":121765},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3554":72565,"_30673":72540,"_21251":121767,"_5":14613,"_27884":121702,"_3010":121768},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3554":72566,"_30673":72540,"_21251":121770,"_5":14613,"_27884":121702,"_3010":121771},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3554":72567,"_30673":72540,"_21251":121773,"_5":14613,"_27884":121702,"_3010":121774},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3554":72568,"_30673":72540,"_21251":121776,"_5":14613,"_27884":121702,"_3010":121777},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3554":72569,"_30673":72540,"_21251":121779,"_5":14613,"_27884":121702,"_3010":121780},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3554":72570,"_30673":72540,"_21251":121782,"_5":14613,"_27884":121702,"_3010":121783},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3554":72571,"_30673":72540,"_21251":121785,"_5":14613,"_27884":121706,"_3010":118585},[],{"_3554":72572,"_30673":72540,"_21251":121787,"_5":14613,"_27884":121706,"_3010":121788},[],"Material que atraviesa EST",{"_3554":72573,"_30673":72540,"_21251":121790,"_5":14613,"_27884":121706,"_3010":121791},[],"Clave generada por el dispositivo",{"_3554":72574,"_30673":72540,"_21251":121793,"_5":14613,"_27884":121706,"_3010":121794},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3554":72575,"_30673":72540,"_21251":121796,"_5":14613,"_27884":121706,"_3010":121797},[],"Clave ya disponible en el dispositivo",{"_3554":72576,"_30673":72540,"_21251":121799,"_5":14613,"_27884":121706,"_3010":121800},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3554":72577,"_30673":72540,"_21251":121802,"_5":14613,"_27884":121706,"_3010":53049},[],{"_3554":72578,"_30673":72540,"_21251":121804,"_5":14613,"_27884":121706,"_3010":121805},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3554":72579,"_30673":72540,"_21251":121807,"_5":14613,"_27884":121706,"_3010":121808},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3554":72580,"_30673":72540,"_21251":121810,"_5":14613,"_27884":121710,"_3010":121811},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3554":72581,"_30673":72581,"_5":14965,"_3010":121813,"_31032":121814,"_21251":121815,"_27884":72581},"Renovación y recuperación",[50083,119650,52730,120795,120970],[],{"_3554":72582,"_30673":72581,"_21251":121817,"_5":14613,"_27884":72581,"_3010":121818},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3554":72583,"_30673":72581,"_5":31029,"_21251":121820,"_27884":121821,"_3010":121822},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3554":72584,"_30673":72581,"_5":31029,"_21251":121824,"_27884":121825,"_3010":121826},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3554":72585,"_30673":72581,"_5":31029,"_21251":121828,"_27884":121829,"_3010":121830},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3554":72586,"_30673":72581,"_5":31029,"_21251":121832,"_27884":121833,"_3010":121834},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3554":72587,"_30673":72581,"_5":31029,"_21251":121836,"_27884":121837,"_3010":121838},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3554":72588,"_30673":72581,"_21251":121840,"_5":14613,"_27884":72581,"_3010":121841},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3554":72589,"_30673":72581,"_21251":121843,"_5":14613,"_27884":121821,"_3010":121844},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3554":72590,"_30673":72581,"_21251":121846,"_5":14613,"_27884":121821,"_3010":121847},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3554":72591,"_30673":72581,"_21251":121849,"_5":14613,"_27884":121821,"_3010":121850},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3554":72592,"_30673":72581,"_21251":121852,"_5":14613,"_27884":121821,"_3010":121853},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3554":72593,"_30673":72581,"_21251":121855,"_5":14613,"_27884":121825,"_3010":121856},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3554":72594,"_30673":72581,"_21251":121858,"_5":14613,"_27884":121825,"_3010":121859},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3554":72595,"_30673":72581,"_21251":121861,"_5":14613,"_27884":121829,"_3010":121862},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3554":72596,"_30673":72581,"_21251":121864,"_5":14613,"_27884":121829,"_3010":121865},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3554":72597,"_30673":72581,"_21251":121867,"_5":14613,"_27884":121829,"_3010":121868},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3554":72598,"_30673":72581,"_21251":121870,"_5":14613,"_27884":121833,"_3010":121871},[],"Situación",{"_3554":72599,"_30673":72581,"_21251":121873,"_5":14613,"_27884":121833,"_3010":121874},[],"Procedimiento",{"_3554":72600,"_30673":72581,"_21251":121876,"_5":14613,"_27884":121833,"_3010":121877},[],"Certificado vigente, fuera de ventana",{"_3554":72601,"_30673":72581,"_21251":121879,"_5":14613,"_27884":121833,"_3010":121880},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3554":72602,"_30673":72581,"_21251":121882,"_5":14613,"_27884":121833,"_3010":121883},[],"Certificado vencido, clave disponible",{"_3554":72603,"_30673":72581,"_21251":121885,"_5":14613,"_27884":121833,"_3010":121886},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3554":72604,"_30673":72581,"_21251":121888,"_5":14613,"_27884":121833,"_3010":121889},[],"Renovación por webhook o `NO_AUTH`",{"_3554":72605,"_30673":72581,"_21251":121891,"_5":14613,"_27884":121833,"_3010":121892},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3554":72606,"_30673":72581,"_21251":121894,"_5":14613,"_27884":121833,"_3010":121895},[],"Clave perdida o inaccesible",{"_3554":72607,"_30673":72581,"_21251":121897,"_5":14613,"_27884":121833,"_3010":121898},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3554":72608,"_30673":72581,"_21251":121900,"_5":14613,"_27884":121833,"_3010":121901},[],"Identidad actual revocada",{"_3554":72609,"_30673":72581,"_21251":121903,"_5":14613,"_27884":121833,"_3010":121904},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3554":72610,"_30673":72581,"_21251":121906,"_5":14613,"_27884":121833,"_3010":121907},[],"Dispositivo sin identidad",{"_3554":72611,"_30673":72581,"_21251":121909,"_5":14613,"_27884":121833,"_3010":121910},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3554":72612,"_30673":72581,"_21251":121912,"_5":14613,"_27884":121833,"_3010":121913},[],"Dispositivo retirado",{"_3554":72613,"_30673":72581,"_21251":121915,"_5":14613,"_27884":121833,"_3010":121916},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3554":72614,"_30673":72581,"_21251":121918,"_5":14613,"_27884":121833,"_3010":121919},[],"Timeout, HTTP 500 o fallo de instalación",{"_3554":72615,"_30673":72581,"_21251":121921,"_5":14613,"_27884":121833,"_3010":121922},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3554":72616,"_30673":72581,"_21251":121924,"_5":14613,"_27884":121837,"_3010":121925},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3554":72617,"_30673":72581,"_21251":121927,"_5":14613,"_27884":121837,"_3010":121928},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3554":72618,"_30673":72618,"_5":14965,"_3010":121930,"_31032":121931,"_21251":121932,"_27884":72618},"Diagnóstico de enrolamiento",[50083,119650,52730,120795,120970],[],{"_3554":72619,"_30673":72618,"_21251":121934,"_5":14613,"_27884":72618,"_3010":121935},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3554":72620,"_30673":72618,"_5":31029,"_21251":121937,"_27884":121938,"_3010":121939},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3554":72621,"_30673":72618,"_5":31029,"_21251":121941,"_27884":121942,"_3010":121943},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3554":72622,"_30673":72618,"_5":31029,"_21251":121945,"_27884":121946,"_3010":121502},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3554":72623,"_30673":72618,"_5":31029,"_21251":121948,"_27884":121949,"_3010":121950},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3554":72624,"_30673":72618,"_21251":121952,"_5":14613,"_27884":72618,"_3010":121953},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3554":72625,"_30673":72618,"_21251":121955,"_5":14613,"_27884":121942,"_3010":121956},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3554":72626,"_30673":72618,"_21251":121958,"_5":14613,"_27884":121942,"_3010":121959},[],"Síntoma o mensaje",{"_3554":72627,"_30673":72618,"_21251":121961,"_5":14613,"_27884":121942,"_3010":121962},[],"Qué revisar",{"_3554":72628,"_30673":72618,"_21251":121964,"_5":14613,"_27884":121942,"_3010":121965},[],"curl rechaza TLS, nombre o emisor",{"_3554":72629,"_30673":72618,"_21251":121967,"_5":14613,"_27884":121942,"_3010":121968},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3554":72630,"_30673":72618,"_21251":121970,"_5":14613,"_27884":121942,"_3010":121971},[],"404 o APS ausente",{"_3554":72631,"_30673":72618,"_21251":121973,"_5":14613,"_27884":121942,"_3010":121974},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3554":72632,"_30673":72618,"_21251":121976,"_5":14613,"_27884":121942,"_3010":121977},[],"400, error de CSR o formato",{"_3554":72633,"_30673":72618,"_21251":121979,"_5":14613,"_27884":121942,"_3010":121980},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3554":72634,"_30673":72618,"_21251":121982,"_5":14613,"_27884":121942,"_3010":121983},[],"Credencial ausente o certificado no válido",{"_3554":72635,"_30673":72618,"_21251":121985,"_5":14613,"_27884":121942,"_3010":121986},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3554":72636,"_30673":72618,"_21251":121988,"_5":14613,"_27884":121942,"_3010":121989},[],"Webhook deniega, expira o responde sin autorización",{"_3554":72637,"_30673":72618,"_21251":121991,"_5":14613,"_27884":121942,"_3010":121992},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3554":72638,"_30673":72618,"_21251":121994,"_5":14613,"_27884":121942,"_3010":53975},[],{"_3554":72639,"_30673":72618,"_21251":121996,"_5":14613,"_27884":121942,"_3010":121997},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3554":72640,"_30673":72618,"_21251":121999,"_5":14613,"_27884":121942,"_3010":53981},[],{"_3554":72641,"_30673":72618,"_21251":122001,"_5":14613,"_27884":121942,"_3010":122002},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3554":72642,"_30673":72618,"_21251":122004,"_5":14613,"_27884":121942,"_3010":53987},[],{"_3554":72643,"_30673":72618,"_21251":122006,"_5":14613,"_27884":121942,"_3010":122007},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3554":72644,"_30673":72618,"_21251":122009,"_5":14613,"_27884":121942,"_3010":53993},[],{"_3554":72645,"_30673":72618,"_21251":122011,"_5":14613,"_27884":121942,"_3010":122012},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3554":72646,"_30673":72618,"_21251":122014,"_5":14613,"_27884":121942,"_3010":53999},[],{"_3554":72647,"_30673":72618,"_21251":122016,"_5":14613,"_27884":121942,"_3010":122017},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3554":72648,"_30673":72618,"_21251":122019,"_5":14613,"_27884":121942,"_3010":122020},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3554":72649,"_30673":72618,"_21251":122022,"_5":14613,"_27884":121942,"_3010":122023},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3554":72650,"_30673":72618,"_21251":122025,"_5":14613,"_27884":121942,"_3010":122026},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3554":72651,"_30673":72618,"_21251":122028,"_5":14613,"_27884":121942,"_3010":122029},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3554":72652,"_30673":72618,"_21251":122031,"_5":14613,"_27884":121942,"_3010":54017},[],{"_3554":72653,"_30673":72618,"_21251":122033,"_5":14613,"_27884":121942,"_3010":122034},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3554":72654,"_30673":72618,"_21251":122036,"_5":14613,"_27884":121942,"_3010":54023},[],{"_3554":72655,"_30673":72618,"_21251":122038,"_5":14613,"_27884":121942,"_3010":122039},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3554":72656,"_30673":72618,"_21251":122041,"_5":14613,"_27884":121942,"_3010":122042},[],"DMS propietario distinto",{"_3554":72657,"_30673":72618,"_21251":122044,"_5":14613,"_27884":121942,"_3010":122045},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3554":72658,"_30673":72618,"_21251":122047,"_5":14613,"_27884":121942,"_3010":54035},[],{"_3554":72659,"_30673":72618,"_21251":122049,"_5":14613,"_27884":121942,"_3010":122050},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3554":72660,"_30673":72618,"_21251":122052,"_5":14613,"_27884":121942,"_3010":54041},[],{"_3554":72661,"_30673":72618,"_21251":122054,"_5":14613,"_27884":121942,"_3010":122055},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3554":72662,"_30673":72618,"_21251":122057,"_5":14613,"_27884":121942,"_3010":122058},[],"Certificado actual revocado",{"_3554":72663,"_30673":72618,"_21251":122060,"_5":14613,"_27884":121942,"_3010":122061},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3554":72664,"_30673":72618,"_21251":122063,"_5":14613,"_27884":121942,"_3010":122064},[],"Error de CA, perfil o firma",{"_3554":72665,"_30673":72618,"_21251":122066,"_5":14613,"_27884":121942,"_3010":122067},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3554":72666,"_30673":72618,"_21251":122069,"_5":14613,"_27884":121942,"_3010":122070},[],"HTTP 200 sin conexión del dispositivo",{"_3554":72667,"_30673":72618,"_21251":122072,"_5":14613,"_27884":121942,"_3010":122073},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3554":72668,"_30673":72618,"_21251":122075,"_5":14613,"_27884":121942,"_3010":122076},[],"Timeout o error después de emitir",{"_3554":72669,"_30673":72618,"_21251":122078,"_5":14613,"_27884":121942,"_3010":122079},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3554":72670,"_30673":72618,"_21251":122081,"_5":14613,"_27884":121946,"_3010":122082},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3554":72671,"_30673":72618,"_21251":122084,"_5":14613,"_27884":121946,"_3010":122085},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3554":72672,"_30673":72618,"_21251":122087,"_5":14613,"_27884":121949,"_3010":122088},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3554":72673,"_30673":72618,"_21251":122090,"_5":14613,"_27884":121949,"_3010":122091},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3554":72674,"_30673":72618,"_21251":122093,"_5":14613,"_27884":121949,"_3010":122094},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3554":72675,"_30673":72618,"_21251":122096,"_5":14613,"_27884":121949,"_3010":122097},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3554":72676,"_30673":72618,"_21251":122099,"_5":14613,"_27884":121949,"_3010":122100},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3554":72677,"_30673":72618,"_21251":122102,"_5":14613,"_27884":121949,"_3010":122103},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3554":72678,"_30673":72618,"_21251":122105,"_5":14613,"_27884":121949,"_3010":122106},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3554":72679,"_30673":72679,"_5":14965,"_3010":122108,"_31032":122109,"_21251":122110,"_27884":72679},"Distribución y actualización de confianza",[50083,119650,52730,120795,120970],[],{"_3554":72680,"_30673":72679,"_21251":122112,"_5":14613,"_27884":72679,"_3010":122113},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3554":72681,"_30673":72679,"_5":31029,"_21251":122115,"_27884":122116,"_3010":122117},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3554":72682,"_30673":72679,"_5":31029,"_21251":122119,"_27884":122120,"_3010":122121},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3554":72683,"_30673":72679,"_5":31029,"_21251":122123,"_27884":122124,"_3010":122125},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3554":72684,"_30673":72679,"_5":31029,"_21251":122127,"_27884":122128,"_3010":122129},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3554":72685,"_30673":72679,"_5":31029,"_21251":122131,"_27884":122132,"_3010":122133},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3554":72686,"_30673":72679,"_21251":122135,"_5":14613,"_27884":72679,"_3010":122136},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3554":72687,"_30673":72679,"_21251":122138,"_5":14613,"_27884":122116,"_3010":122139},[],"Relación",{"_3554":72688,"_30673":72679,"_21251":122141,"_5":14613,"_27884":122116,"_3010":122142},[],"Material que prepara el responsable",{"_3554":72689,"_30673":72679,"_21251":122144,"_5":14613,"_27884":122116,"_3010":122145},[],"Dispositivo → servidor EST",{"_3554":72690,"_30673":72679,"_21251":122147,"_5":14613,"_27884":122116,"_3010":122148},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3554":72691,"_30673":72679,"_21251":122150,"_5":14613,"_27884":122116,"_3010":122151},[],"DMS → solicitante",{"_3554":72692,"_30673":72679,"_21251":122153,"_5":14613,"_27884":122116,"_3010":122154},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3554":72693,"_30673":72679,"_21251":122156,"_5":14613,"_27884":122116,"_3010":122157},[],"Consumidor → dispositivo",{"_3554":72694,"_30673":72679,"_21251":122159,"_5":14613,"_27884":122116,"_3010":122160},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3554":72695,"_30673":72679,"_21251":122162,"_5":14613,"_27884":122116,"_3010":122163},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3554":72696,"_30673":72679,"_21251":122165,"_5":14613,"_27884":122120,"_3010":122166},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3554":72697,"_30673":72679,"_21251":122168,"_5":14613,"_27884":122120,"_3010":122169},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3554":72698,"_30673":72679,"_21251":122171,"_5":14613,"_27884":122124,"_3010":122172},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3554":72699,"_30673":72679,"_21251":122174,"_5":14613,"_27884":122124,"_3010":122175},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3554":72700,"_30673":72679,"_21251":122177,"_5":14613,"_27884":122124,"_3010":122178},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3554":72701,"_30673":72679,"_21251":122180,"_5":14613,"_27884":122124,"_3010":122181},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3554":72702,"_30673":72679,"_21251":122183,"_5":14613,"_27884":122124,"_3010":122184},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3554":72703,"_30673":72679,"_21251":122186,"_5":14613,"_27884":122124,"_3010":122187},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3554":72704,"_30673":72679,"_21251":122189,"_5":14613,"_27884":122128,"_3010":122190},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3554":72705,"_30673":72679,"_21251":122192,"_5":14613,"_27884":122128,"_3010":122193},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3554":72706,"_30673":72679,"_21251":122195,"_5":14613,"_27884":122128,"_3010":122196},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3554":72707,"_30673":72679,"_21251":122198,"_5":14613,"_27884":122132,"_3010":122199},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3554":72708,"_30673":72708,"_5":14965,"_3010":54190,"_31032":122201,"_21251":122203,"_27884":72708},[50083,119650,52730,120795,122202],"Integraciones",[],{"_3554":72709,"_30673":72708,"_21251":122205,"_5":14613,"_27884":72708,"_3010":122206},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3554":72710,"_30673":72708,"_5":31029,"_21251":122208,"_27884":122209,"_3010":122210},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3554":72711,"_30673":72708,"_5":31029,"_21251":122212,"_27884":122213,"_3010":122214},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3554":72712,"_30673":72708,"_5":31029,"_21251":122216,"_27884":122217,"_3010":122218},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3554":72713,"_30673":72708,"_5":31029,"_21251":122220,"_27884":122221,"_3010":122222},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3554":72714,"_30673":72708,"_5":31029,"_21251":122224,"_27884":122225,"_3010":122226},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3554":72715,"_30673":72708,"_5":31029,"_21251":122228,"_27884":122229,"_3010":122230},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3554":72716,"_30673":72708,"_5":31029,"_21251":122232,"_27884":122233,"_3010":122234},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3554":72717,"_30673":72708,"_5":31029,"_21251":122236,"_27884":122237,"_3010":122238},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3554":72718,"_30673":72708,"_5":31029,"_21251":122240,"_27884":122241,"_3010":54232},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3554":72719,"_30673":72708,"_5":31029,"_21251":122243,"_27884":122244,"_3010":54236},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3554":72720,"_30673":72708,"_5":31029,"_21251":122246,"_27884":122247,"_3010":122248},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3554":72721,"_30673":72708,"_5":31029,"_21251":122250,"_27884":122251,"_3010":122252},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3554":72722,"_30673":72708,"_5":31029,"_21251":122254,"_27884":122255,"_3010":122256},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3554":72723,"_30673":72708,"_5":31029,"_21251":122258,"_27884":122259,"_3010":122260},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3554":72724,"_30673":72708,"_5":31029,"_21251":122262,"_27884":122263,"_3010":122264},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3554":72725,"_30673":72708,"_5":31029,"_21251":122266,"_27884":122267,"_3010":122268},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3554":72726,"_30673":72708,"_5":31029,"_21251":122270,"_27884":122271,"_3010":122272},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3554":72727,"_30673":72708,"_5":31029,"_21251":122274,"_27884":122275,"_3010":122276},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3554":72728,"_30673":72708,"_5":31029,"_21251":122278,"_27884":122279,"_3010":122280},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3554":72729,"_30673":72708,"_5":31029,"_21251":122282,"_27884":122283,"_3010":122284},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3554":72730,"_30673":72708,"_5":31029,"_21251":122286,"_27884":122287,"_3010":122288},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3554":72731,"_30673":72708,"_5":31029,"_21251":122290,"_27884":122291,"_3010":122292},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3554":72732,"_30673":72708,"_5":31029,"_21251":122294,"_27884":122295,"_3010":122296},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3554":72733,"_30673":72708,"_5":31029,"_21251":122298,"_27884":122299,"_3010":122300},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3554":72734,"_30673":72708,"_5":31029,"_21251":122302,"_27884":122303,"_3010":122304},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3554":72735,"_30673":72708,"_21251":122306,"_5":14613,"_27884":72708,"_3010":122307},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3554":72736,"_30673":72708,"_21251":122309,"_5":14613,"_27884":72708,"_3010":122310},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3554":72737,"_30673":72708,"_21251":122312,"_5":14613,"_27884":72708,"_3010":122313},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3554":72738,"_30673":72708,"_21251":122315,"_5":14613,"_27884":122209,"_3010":122316},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3554":72739,"_30673":72708,"_21251":122318,"_5":14613,"_27884":122209,"_3010":122319},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3554":72740,"_30673":72708,"_21251":122321,"_5":14613,"_27884":122209,"_3010":122322},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3554":72741,"_30673":72708,"_21251":122324,"_5":14613,"_27884":122209,"_3010":122325},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3554":72742,"_30673":72708,"_21251":122327,"_5":14613,"_27884":122213,"_3010":122328},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3554":72743,"_30673":72708,"_21251":122330,"_5":14613,"_27884":122217,"_3010":122331},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3554":72744,"_30673":72708,"_21251":122333,"_5":14613,"_27884":122217,"_3010":122334},[],"Acción IAM",{"_3554":72745,"_30673":72708,"_21251":122336,"_5":14613,"_27884":122217,"_3010":118591},[],{"_3554":72746,"_30673":72708,"_21251":122338,"_5":14613,"_27884":122217,"_3010":54331},[],{"_3554":72747,"_30673":72708,"_21251":122340,"_5":14613,"_27884":122217,"_3010":122341},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3554":72748,"_30673":72708,"_21251":122343,"_5":14613,"_27884":122217,"_3010":54337},[],{"_3554":72749,"_30673":72708,"_21251":122345,"_5":14613,"_27884":122217,"_3010":122346},[],"Registrar la CA en AWS IoT",{"_3554":72750,"_30673":72708,"_21251":122348,"_5":14613,"_27884":122217,"_3010":54343},[],{"_3554":72751,"_30673":72708,"_21251":122350,"_5":14613,"_27884":122217,"_3010":122351},[],"Consultar el estado del registro de la CA",{"_3554":72752,"_30673":72708,"_21251":122353,"_5":14613,"_27884":122217,"_3010":54349},[],{"_3554":72753,"_30673":72708,"_21251":122355,"_5":14613,"_27884":122217,"_3010":122356},[],"Crear o actualizar Things en IoT Core",{"_3554":72754,"_30673":72708,"_21251":122358,"_5":14613,"_27884":122217,"_3010":54355},[],{"_3554":72755,"_30673":72708,"_21251":122360,"_5":14613,"_27884":122217,"_3010":122361},[],"Aprovisionar Things mediante plantilla",{"_3554":72756,"_30673":72708,"_21251":122363,"_5":14613,"_27884":122217,"_3010":54361},[],{"_3554":72757,"_30673":72708,"_21251":122365,"_5":14613,"_27884":122217,"_3010":122366},[],"Registrar certificados de dispositivo",{"_3554":72758,"_30673":72708,"_21251":122368,"_5":14613,"_27884":122217,"_3010":54367},[],{"_3554":72759,"_30673":72708,"_21251":122370,"_5":14613,"_27884":122217,"_3010":122371},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3554":72760,"_30673":72708,"_21251":122373,"_5":14613,"_27884":122217,"_3010":54373},[],{"_3554":72761,"_30673":72708,"_21251":122375,"_5":14613,"_27884":122217,"_3010":122376},[],"Crear y adjuntar políticas IoT",{"_3554":72762,"_30673":72708,"_21251":122378,"_5":14613,"_27884":122217,"_3010":54379},[],{"_3554":72763,"_30673":72708,"_21251":122380,"_5":14613,"_27884":122217,"_3010":122381},[],"Gestionar grupos de Things",{"_3554":72764,"_30673":72708,"_21251":122383,"_5":14613,"_27884":122217,"_3010":54385},[],{"_3554":72765,"_30673":72708,"_21251":122385,"_5":14613,"_27884":122217,"_3010":122386},[],"Crear plantillas JITP",{"_3554":72766,"_30673":72708,"_21251":122388,"_5":14613,"_27884":122217,"_3010":54391},[],{"_3554":72767,"_30673":72708,"_21251":122390,"_5":14613,"_27884":122217,"_3010":122391},[],"Leer y escribir el Device Shadow",{"_3554":72768,"_30673":72708,"_21251":122393,"_5":14613,"_27884":122217,"_3010":122394},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3554":72769,"_30673":72708,"_21251":122396,"_5":14613,"_27884":122221,"_3010":122397},[],"Parámetro",{"_3554":72770,"_30673":72708,"_21251":122399,"_5":14613,"_27884":122221,"_3010":122400},[],"Tipo",{"_3554":72771,"_30673":72708,"_21251":122402,"_5":14613,"_27884":122221,"_3010":122403},[],"Requerido",{"_3554":72772,"_30673":72708,"_21251":122405,"_5":14613,"_27884":122221,"_3010":122406},[],"Descripción",{"_3554":72773,"_30673":72708,"_21251":122408,"_5":14613,"_27884":122221,"_3010":54412},[],{"_3554":72774,"_30673":72708,"_21251":122410,"_5":14613,"_27884":122221,"_3010":25376},[],{"_3554":72775,"_30673":72708,"_21251":122412,"_5":14613,"_27884":122221,"_3010":122413},[],"Sí",{"_3554":72776,"_30673":72708,"_21251":122415,"_5":14613,"_27884":122221,"_3010":122416},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3554":72777,"_30673":72708,"_21251":122418,"_5":14613,"_27884":122221,"_3010":54423},[],{"_3554":72778,"_30673":72708,"_21251":122420,"_5":14613,"_27884":122221,"_3010":25376},[],{"_3554":72779,"_30673":72708,"_21251":122422,"_5":14613,"_27884":122221,"_3010":122413},[],{"_3554":72780,"_30673":72708,"_21251":122424,"_5":14613,"_27884":122221,"_3010":122425},[],"Región AWS donde opera el conector.",{"_3554":72781,"_30673":72708,"_21251":122427,"_5":14613,"_27884":122221,"_3010":54433},[],{"_3554":72782,"_30673":72708,"_21251":122429,"_5":14613,"_27884":122221,"_3010":25376},[],{"_3554":72783,"_30673":72708,"_21251":122431,"_5":14613,"_27884":122221,"_3010":122413},[],{"_3554":72784,"_30673":72708,"_21251":122433,"_5":14613,"_27884":122221,"_3010":122434},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3554":72785,"_30673":72708,"_21251":122436,"_5":14613,"_27884":122221,"_3010":54443},[],{"_3554":72786,"_30673":72708,"_21251":122438,"_5":14613,"_27884":122221,"_3010":25376},[],{"_3554":72787,"_30673":72708,"_21251":122440,"_5":14613,"_27884":122221,"_3010":122441},[],"Solo con `auth_method=static`",{"_3554":72788,"_30673":72708,"_21251":122443,"_5":14613,"_27884":122221,"_3010":122444},[],"Clave de acceso AWS.",{"_3554":72789,"_30673":72708,"_21251":122446,"_5":14613,"_27884":122221,"_3010":54454},[],{"_3554":72790,"_30673":72708,"_21251":122448,"_5":14613,"_27884":122221,"_3010":25376},[],{"_3554":72791,"_30673":72708,"_21251":122450,"_5":14613,"_27884":122221,"_3010":122441},[],{"_3554":72792,"_30673":72708,"_21251":122452,"_5":14613,"_27884":122221,"_3010":122453},[],"Clave secreta AWS.",{"_3554":72793,"_30673":72708,"_21251":122455,"_5":14613,"_27884":122221,"_3010":54464},[],{"_3554":72794,"_30673":72708,"_21251":122457,"_5":14613,"_27884":122221,"_3010":25376},[],{"_3554":72795,"_30673":72708,"_21251":122459,"_5":14613,"_27884":122221,"_3010":54469},[],{"_3554":72796,"_30673":72708,"_21251":122461,"_5":14613,"_27884":122221,"_3010":122462},[],"Token de sesión (con `auth_method=static`).",{"_3554":72797,"_30673":72708,"_21251":122464,"_5":14613,"_27884":122221,"_3010":54475},[],{"_3554":72798,"_30673":72708,"_21251":122466,"_5":14613,"_27884":122221,"_3010":25376},[],{"_3554":72799,"_30673":72708,"_21251":122468,"_5":14613,"_27884":122221,"_3010":122469},[],"Solo con `auth_method=role`",{"_3554":72800,"_30673":72708,"_21251":122471,"_5":14613,"_27884":122221,"_3010":122472},[],"ARN del rol a asumir.",{"_3554":72801,"_30673":72708,"_21251":122474,"_5":14613,"_27884":122221,"_3010":54486},[],{"_3554":72802,"_30673":72708,"_21251":122476,"_5":14613,"_27884":122221,"_3010":25376},[],{"_3554":72803,"_30673":72708,"_21251":122478,"_5":14613,"_27884":122221,"_3010":54469},[],{"_3554":72804,"_30673":72708,"_21251":122480,"_5":14613,"_27884":122221,"_3010":122481},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3554":72805,"_30673":72708,"_21251":122483,"_5":14613,"_27884":122221,"_3010":54496},[],{"_3554":72806,"_30673":72708,"_21251":122485,"_5":14613,"_27884":122221,"_3010":91286},[],{"_3554":72807,"_30673":72708,"_21251":122487,"_5":14613,"_27884":122221,"_3010":122413},[],{"_3554":72808,"_30673":72708,"_21251":122489,"_5":14613,"_27884":122221,"_3010":122490},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3554":72809,"_30673":72708,"_21251":122492,"_5":14613,"_27884":122221,"_3010":54506},[],{"_3554":72810,"_30673":72708,"_21251":122494,"_5":14613,"_27884":122221,"_3010":25376},[],{"_3554":72811,"_30673":72708,"_21251":122496,"_5":14613,"_27884":122221,"_3010":122413},[],{"_3554":72812,"_30673":72708,"_21251":122498,"_5":14613,"_27884":122221,"_3010":122499},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3554":72813,"_30673":72708,"_21251":122501,"_5":14613,"_27884":122221,"_3010":54516},[],{"_3554":72814,"_30673":72708,"_21251":122503,"_5":14613,"_27884":122221,"_3010":25376},[],{"_3554":72815,"_30673":72708,"_21251":122505,"_5":14613,"_27884":122221,"_3010":122413},[],{"_3554":72816,"_30673":72708,"_21251":122507,"_5":14613,"_27884":122221,"_3010":122508},[],"URL HTTP del Device Manager de Lamassu.",{"_3554":72817,"_30673":72708,"_21251":122510,"_5":14613,"_27884":122221,"_3010":54526},[],{"_3554":72818,"_30673":72708,"_21251":122512,"_5":14613,"_27884":122221,"_3010":25376},[],{"_3554":72819,"_30673":72708,"_21251":122514,"_5":14613,"_27884":122221,"_3010":122413},[],{"_3554":72820,"_30673":72708,"_21251":122516,"_5":14613,"_27884":122221,"_3010":122517},[],"URL HTTP del servicio de CA de Lamassu.",{"_3554":72821,"_30673":72708,"_21251":122519,"_5":14613,"_27884":122225,"_3010":122520},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3554":72822,"_30673":72708,"_21251":122522,"_5":14613,"_27884":122225,"_3010":122523},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3554":72823,"_30673":72708,"_21251":122525,"_5":14613,"_27884":122225,"_3010":122526},[],"Tipo de CloudEvent",{"_3554":72824,"_30673":72708,"_21251":122528,"_5":14613,"_27884":122225,"_3010":122529},[],"Recurso en Lamassu",{"_3554":72825,"_30673":72708,"_21251":122531,"_5":14613,"_27884":122225,"_3010":122532},[],"Recurso AWS",{"_3554":72826,"_30673":72708,"_21251":122534,"_5":14613,"_27884":122225,"_3010":122535},[],"Acciones IAM",{"_3554":72827,"_30673":72708,"_21251":122537,"_5":14613,"_27884":122225,"_3010":122538},[],"Llamadas AWS y efecto",{"_3554":72828,"_30673":72708,"_21251":122540,"_5":14613,"_27884":122225,"_3010":122541},[],"Dónde en esta página",{"_3554":72829,"_30673":72708,"_21251":122543,"_5":14613,"_27884":122225,"_3010":54560},[],{"_3554":72830,"_30673":72708,"_21251":122545,"_5":14613,"_27884":122225,"_3010":54563},[],{"_3554":72831,"_30673":72708,"_21251":122547,"_5":14613,"_27884":122225,"_3010":54566},[],{"_3554":72832,"_30673":72708,"_21251":122549,"_5":14613,"_27884":122225,"_3010":54569},[],{"_3554":72833,"_30673":72708,"_21251":122551,"_5":14613,"_27884":122225,"_3010":122552},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3554":72834,"_30673":72708,"_21251":122554,"_5":14613,"_27884":122225,"_3010":122238},[],{"_3554":72835,"_30673":72708,"_21251":122556,"_5":14613,"_27884":122225,"_3010":54577},[],{"_3554":72836,"_30673":72708,"_21251":122558,"_5":14613,"_27884":122225,"_3010":54580},[],{"_3554":72837,"_30673":72708,"_21251":122560,"_5":14613,"_27884":122225,"_3010":54583},[],{"_3554":72838,"_30673":72708,"_21251":122562,"_5":14613,"_27884":122225,"_3010":54586},[],{"_3554":72839,"_30673":72708,"_21251":122564,"_5":14613,"_27884":122225,"_3010":122565},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3554":72840,"_30673":72708,"_21251":122567,"_5":14613,"_27884":122225,"_3010":122264},[],{"_3554":72841,"_30673":72708,"_21251":122569,"_5":14613,"_27884":122225,"_3010":54594},[],{"_3554":72842,"_30673":72708,"_21251":122571,"_5":14613,"_27884":122225,"_3010":122572},[],"Dispositivo",{"_3554":72843,"_30673":72708,"_21251":122574,"_5":14613,"_27884":122225,"_3010":54600},[],{"_3554":72844,"_30673":72708,"_21251":122576,"_5":14613,"_27884":122225,"_3010":54603},[],{"_3554":72845,"_30673":72708,"_21251":122578,"_5":14613,"_27884":122225,"_3010":122579},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3554":72846,"_30673":72708,"_21251":122581,"_5":14613,"_27884":122225,"_3010":122272},[],{"_3554":72847,"_30673":72708,"_21251":122583,"_5":14613,"_27884":122225,"_3010":54611},[],{"_3554":72848,"_30673":72708,"_21251":122585,"_5":14613,"_27884":122225,"_3010":122586},[],"Certificado",{"_3554":72849,"_30673":72708,"_21251":122588,"_5":14613,"_27884":122225,"_3010":54617},[],{"_3554":72850,"_30673":72708,"_21251":122590,"_5":14613,"_27884":122225,"_3010":122591},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3554":72851,"_30673":72708,"_21251":122593,"_5":14613,"_27884":122225,"_3010":122594},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3554":72852,"_30673":72708,"_21251":122596,"_5":14613,"_27884":122225,"_3010":122284},[],{"_3554":72853,"_30673":72708,"_21251":122598,"_5":14613,"_27884":122225,"_3010":54628},[],{"_3554":72854,"_30673":72708,"_21251":122600,"_5":14613,"_27884":122225,"_3010":122601},[],"Certificado / Dispositivo",{"_3554":72855,"_30673":72708,"_21251":122603,"_5":14613,"_27884":122225,"_3010":54634},[],{"_3554":72856,"_30673":72708,"_21251":122605,"_5":14613,"_27884":122225,"_3010":50479},[],{"_3554":72857,"_30673":72708,"_21251":122607,"_5":14613,"_27884":122225,"_3010":122608},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3554":72858,"_30673":72708,"_21251":122610,"_5":14613,"_27884":122225,"_3010":122292},[],{"_3554":72859,"_30673":72708,"_21251":122612,"_5":14613,"_27884":122229,"_3010":122613},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3554":72860,"_30673":72708,"_21251":122615,"_5":14613,"_27884":122233,"_3010":122616},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3554":72861,"_30673":72708,"_21251":122618,"_5":14613,"_27884":122233,"_3010":122619},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3554":72862,"_30673":72708,"_21251":122621,"_5":14613,"_27884":122237,"_3010":122622},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3554":72863,"_30673":72708,"_21251":122624,"_5":14613,"_27884":122237,"_3010":122625},[],"Transición",{"_3554":72864,"_30673":72708,"_21251":122627,"_5":14613,"_27884":122237,"_3010":122628},[],"Llamadas AWS",{"_3554":72865,"_30673":72708,"_21251":122630,"_5":14613,"_27884":122237,"_3010":122631},[],"`NoRegistrada` → `Solicitada`",{"_3554":72866,"_30673":72708,"_21251":122633,"_5":14613,"_27884":122237,"_3010":122634},[],"ninguna (solo escritura de metadatos)",{"_3554":72867,"_30673":72708,"_21251":122636,"_5":14613,"_27884":122237,"_3010":122637},[],"`Solicitada` → `Registrando`",{"_3554":72868,"_30673":72708,"_21251":122639,"_5":14613,"_27884":122237,"_3010":122640},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3554":72869,"_30673":72708,"_21251":122642,"_5":14613,"_27884":122237,"_3010":122643},[],"`Registrando` → `Completada`",{"_3554":72870,"_30673":72708,"_21251":122645,"_5":14613,"_27884":122237,"_3010":122646},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3554":72871,"_30673":72708,"_21251":122648,"_5":14613,"_27884":122237,"_3010":122649},[],"`Registrando` → `Fallida`",{"_3554":72872,"_30673":72708,"_21251":122651,"_5":14613,"_27884":122237,"_3010":122652},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3554":72873,"_30673":72708,"_21251":122654,"_5":14613,"_27884":122237,"_3010":122655},[],"`Fallida` / `Completada` → `Solicitada`",{"_3554":72874,"_30673":72708,"_21251":122657,"_5":14613,"_27884":122237,"_3010":122658},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3554":72875,"_30673":72708,"_21251":122660,"_5":14613,"_27884":122241,"_3010":122661},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3554":72876,"_30673":72708,"_21251":122663,"_5":14613,"_27884":122241,"_3010":122664},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3554":72877,"_30673":72708,"_21251":122666,"_5":14613,"_27884":122241,"_3010":122667},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3554":72878,"_30673":72708,"_21251":122669,"_5":14613,"_27884":122241,"_3010":122670},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3554":72879,"_30673":72708,"_21251":122672,"_5":14613,"_27884":122241,"_3010":122673},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3554":72880,"_30673":72708,"_21251":122675,"_5":14613,"_27884":122241,"_3010":122676},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3554":72881,"_30673":72708,"_21251":122678,"_5":14613,"_27884":122244,"_3010":122679},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3554":72882,"_30673":72708,"_21251":122681,"_5":14613,"_27884":122247,"_3010":122682},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3554":72883,"_30673":72708,"_21251":122684,"_5":14613,"_27884":122247,"_3010":122685},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3554":72884,"_30673":72708,"_21251":122687,"_5":14613,"_27884":122251,"_3010":122688},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3554":72885,"_30673":72708,"_21251":122690,"_5":14613,"_27884":122255,"_3010":122691},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3554":72886,"_30673":72708,"_21251":122693,"_5":14613,"_27884":122255,"_3010":122694},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3554":72887,"_30673":72708,"_21251":122696,"_5":14613,"_27884":122255,"_3010":122697},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3554":72888,"_30673":72708,"_21251":122699,"_5":14613,"_27884":122255,"_3010":122700},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3554":72889,"_30673":72708,"_21251":122702,"_5":14613,"_27884":122255,"_3010":122703},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3554":72890,"_30673":72708,"_21251":122705,"_5":14613,"_27884":122255,"_3010":122706},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3554":72891,"_30673":72708,"_21251":122708,"_5":14613,"_27884":122259,"_3010":122709},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3554":72892,"_30673":72708,"_21251":122711,"_5":14613,"_27884":122259,"_3010":122712},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3554":72893,"_30673":72708,"_21251":122714,"_5":14613,"_27884":122259,"_3010":122715},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3554":72894,"_30673":72708,"_21251":122717,"_5":14613,"_27884":122259,"_3010":122718},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3554":72895,"_30673":72708,"_21251":122720,"_5":14613,"_27884":122259,"_3010":122721},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3554":72896,"_30673":72708,"_21251":122723,"_5":14613,"_27884":122263,"_3010":122724},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3554":72897,"_30673":72708,"_21251":122726,"_5":14613,"_27884":122263,"_3010":122625},[],{"_3554":72898,"_30673":72708,"_21251":122728,"_5":14613,"_27884":122263,"_3010":122628},[],{"_3554":72899,"_30673":72708,"_21251":122730,"_5":14613,"_27884":122263,"_3010":122731},[],"`SinConfigurar` → `None` / `Auto`",{"_3554":72900,"_30673":72708,"_21251":122733,"_5":14613,"_27884":122263,"_3010":122734},[],"ninguna (solo configuración)",{"_3554":72901,"_30673":72708,"_21251":122736,"_5":14613,"_27884":122263,"_3010":54771},[],{"_3554":72902,"_30673":72708,"_21251":122738,"_5":14613,"_27884":122263,"_3010":122734},[],{"_3554":72903,"_30673":72708,"_21251":122740,"_5":14613,"_27884":122263,"_3010":122741},[],"Cualquiera → `Jitp`",{"_3554":72904,"_30673":72708,"_21251":122743,"_5":14613,"_27884":122263,"_3010":122744},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3554":72905,"_30673":72708,"_21251":122746,"_5":14613,"_27884":122263,"_3010":54782},[],{"_3554":72906,"_30673":72708,"_21251":122748,"_5":14613,"_27884":122263,"_3010":122749},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3554":72907,"_30673":72708,"_21251":122751,"_5":14613,"_27884":122267,"_3010":122752},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3554":72908,"_30673":72708,"_21251":122754,"_5":14613,"_27884":122267,"_3010":122755},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3554":72909,"_30673":72708,"_21251":122757,"_5":14613,"_27884":122267,"_3010":122758},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3554":72910,"_30673":72708,"_21251":122760,"_5":14613,"_27884":122271,"_3010":122761},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3554":72911,"_30673":72708,"_21251":122763,"_5":14613,"_27884":122271,"_3010":122625},[],{"_3554":72912,"_30673":72708,"_21251":122765,"_5":14613,"_27884":122271,"_3010":122628},[],{"_3554":72913,"_30673":72708,"_21251":122767,"_5":14613,"_27884":122271,"_3010":122768},[],"`Ausente` → `Aprovisionado`",{"_3554":72914,"_30673":72708,"_21251":122770,"_5":14613,"_27884":122271,"_3010":122771},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3554":72915,"_30673":72708,"_21251":122773,"_5":14613,"_27884":122271,"_3010":122774},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3554":72916,"_30673":72708,"_21251":122776,"_5":14613,"_27884":122271,"_3010":122777},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3554":72917,"_30673":72708,"_21251":122779,"_5":14613,"_27884":122271,"_3010":122780},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3554":72918,"_30673":72708,"_21251":122782,"_5":14613,"_27884":122275,"_3010":122783},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3554":72919,"_30673":72708,"_21251":122785,"_5":14613,"_27884":122275,"_3010":122786},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3554":72920,"_30673":72708,"_21251":122788,"_5":14613,"_27884":122275,"_3010":122789},[],"Para que el flujo JITP funcione correctamente:",{"_3554":72921,"_30673":72708,"_21251":122791,"_5":14613,"_27884":122275,"_3010":122792},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3554":72922,"_30673":72708,"_21251":122794,"_5":14613,"_27884":122275,"_3010":122795},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3554":72923,"_30673":72708,"_21251":122797,"_5":14613,"_27884":122275,"_3010":122798},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3554":72924,"_30673":72708,"_21251":122800,"_5":14613,"_27884":122275,"_3010":122801},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3554":72925,"_30673":72708,"_21251":122803,"_5":14613,"_27884":122279,"_3010":122804},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3554":72926,"_30673":72708,"_21251":122806,"_5":14613,"_27884":122279,"_3010":122807},[],"Estado en Lamassu",{"_3554":72927,"_30673":72708,"_21251":122809,"_5":14613,"_27884":122279,"_3010":122810},[],"Razón de revocación",{"_3554":72928,"_30673":72708,"_21251":122812,"_5":14613,"_27884":122279,"_3010":122813},[],"Estado en AWS IoT Core",{"_3554":72929,"_30673":72708,"_21251":122815,"_5":14613,"_27884":122279,"_3010":54852},[],{"_3554":72930,"_30673":72708,"_21251":122817,"_5":14613,"_27884":122279,"_3010":122818},[],"Ninguna",{"_3554":72931,"_30673":72708,"_21251":122820,"_5":14613,"_27884":122279,"_3010":54858},[],{"_3554":72932,"_30673":72708,"_21251":122822,"_5":14613,"_27884":122279,"_3010":54861},[],{"_3554":72933,"_30673":72708,"_21251":122824,"_5":14613,"_27884":122279,"_3010":54864},[],{"_3554":72934,"_30673":72708,"_21251":122826,"_5":14613,"_27884":122279,"_3010":54867},[],{"_3554":72935,"_30673":72708,"_21251":122828,"_5":14613,"_27884":122279,"_3010":54861},[],{"_3554":72936,"_30673":72708,"_21251":122830,"_5":14613,"_27884":122279,"_3010":122831},[],"Cualquier otra razón",{"_3554":72937,"_30673":72708,"_21251":122833,"_5":14613,"_27884":122279,"_3010":54875},[],{"_3554":72938,"_30673":72708,"_21251":122835,"_5":14613,"_27884":122279,"_3010":122836},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3554":72939,"_30673":72708,"_21251":122838,"_5":14613,"_27884":122283,"_3010":122839},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3554":72940,"_30673":72708,"_21251":122841,"_5":14613,"_27884":122283,"_3010":122625},[],{"_3554":72941,"_30673":72708,"_21251":122843,"_5":14613,"_27884":122283,"_3010":122628},[],{"_3554":72942,"_30673":72708,"_21251":122845,"_5":14613,"_27884":122283,"_3010":122846},[],"`NoSincronizado` → `Active`",{"_3554":72943,"_30673":72708,"_21251":122848,"_5":14613,"_27884":122283,"_3010":54367},[],{"_3554":72944,"_30673":72708,"_21251":122850,"_5":14613,"_27884":122283,"_3010":54893},[],{"_3554":72945,"_30673":72708,"_21251":122852,"_5":14613,"_27884":122283,"_3010":122853},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3554":72946,"_30673":72708,"_21251":122855,"_5":14613,"_27884":122283,"_3010":54899},[],{"_3554":72947,"_30673":72708,"_21251":122857,"_5":14613,"_27884":122283,"_3010":122853},[],{"_3554":72948,"_30673":72708,"_21251":122859,"_5":14613,"_27884":122283,"_3010":54904},[],{"_3554":72949,"_30673":72708,"_21251":122861,"_5":14613,"_27884":122283,"_3010":54367},[],{"_3554":72950,"_30673":72708,"_21251":122863,"_5":14613,"_27884":122283,"_3010":54909},[],{"_3554":72951,"_30673":72708,"_21251":122865,"_5":14613,"_27884":122283,"_3010":122866},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3554":72952,"_30673":72708,"_21251":122868,"_5":14613,"_27884":122287,"_3010":122869},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3554":72953,"_30673":72708,"_21251":122871,"_5":14613,"_27884":122287,"_3010":122872},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3554":72954,"_30673":72708,"_21251":122874,"_5":14613,"_27884":122287,"_3010":122875},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3554":72955,"_30673":72708,"_21251":122877,"_5":14613,"_27884":122291,"_3010":122878},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3554":72956,"_30673":72708,"_21251":122880,"_5":14613,"_27884":122291,"_3010":122881},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3554":72957,"_30673":72708,"_21251":122883,"_5":14613,"_27884":122295,"_3010":122884},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3554":72958,"_30673":72708,"_21251":122886,"_5":14613,"_27884":122295,"_3010":122887},[],"Existen dos tipos de acciones:",{"_3554":72959,"_30673":72708,"_21251":122889,"_5":14613,"_27884":122295,"_3010":122890},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3554":72960,"_30673":72708,"_21251":122892,"_5":14613,"_27884":122295,"_3010":122893},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3554":72961,"_30673":72708,"_21251":122895,"_5":14613,"_27884":122295,"_3010":122896},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3554":72962,"_30673":72708,"_21251":122898,"_5":14613,"_27884":122299,"_3010":122899},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3554":72963,"_30673":72708,"_21251":122901,"_5":14613,"_27884":122299,"_3010":122902},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3554":72964,"_30673":72708,"_21251":122904,"_5":14613,"_27884":122299,"_3010":122905},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3554":72965,"_30673":72708,"_21251":122907,"_5":14613,"_27884":122303,"_3010":122908},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3554":72966,"_30673":72708,"_21251":122910,"_5":14613,"_27884":122303,"_3010":122911},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3554":72967,"_30673":72708,"_21251":122913,"_5":14613,"_27884":122303,"_3010":122914},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3554":72968,"_30673":72708,"_21251":122916,"_5":14613,"_27884":122303,"_3010":122917},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3554":72969,"_30673":72708,"_21251":122919,"_5":14613,"_27884":122303,"_3010":122920},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3554":72970,"_30673":72708,"_21251":122922,"_5":14613,"_27884":122303,"_3010":122923},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3554":72971,"_30673":72708,"_21251":122925,"_5":14613,"_27884":122303,"_3010":122926},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3554":72972,"_30673":72708,"_21251":122928,"_5":14613,"_27884":122303,"_3010":122929},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3554":72973,"_30673":72708,"_21251":122931,"_5":14613,"_27884":122303,"_3010":122932},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3554":72974,"_30673":72708,"_21251":122934,"_5":14613,"_27884":122303,"_3010":122935},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3554":72975,"_30673":72708,"_21251":122937,"_5":14613,"_27884":122303,"_3010":122938},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3554":72976,"_30673":72708,"_21251":122940,"_5":14613,"_27884":122303,"_3010":122941},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3554":72977,"_30673":72708,"_21251":122943,"_5":14613,"_27884":122303,"_3010":122944},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3554":72978,"_30673":72708,"_21251":122946,"_5":14613,"_27884":122303,"_3010":122947},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3554":72979,"_30673":72708,"_21251":122949,"_5":14613,"_27884":122303,"_3010":122950},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3554":72980,"_30673":72708,"_21251":122952,"_5":14613,"_27884":122303,"_3010":122953},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3554":72981,"_30673":72708,"_21251":122955,"_5":14613,"_27884":122303,"_3010":122956},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3554":72982,"_30673":72708,"_21251":122958,"_5":14613,"_27884":122303,"_3010":122959},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3554":72983,"_30673":72708,"_21251":122961,"_5":14613,"_27884":122303,"_3010":122962},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3554":72984,"_30673":72708,"_21251":122964,"_5":14613,"_27884":122303,"_3010":122965},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3554":72985,"_30673":72708,"_21251":122967,"_5":14613,"_27884":122303,"_3010":122968},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3554":72986,"_30673":72708,"_21251":122970,"_5":14613,"_27884":122303,"_3010":122971},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3554":72987,"_30673":72708,"_21251":122973,"_5":14613,"_27884":122303,"_3010":122974},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3554":72988,"_30673":72708,"_21251":122976,"_5":14613,"_27884":122303,"_3010":122977},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3554":72989,"_30673":72989,"_5":14965,"_3010":52730,"_31032":122979,"_21251":122980,"_27884":72989},[50083,119650,52730],[],{"_3554":72990,"_30673":72989,"_21251":122982,"_5":14613,"_27884":72989,"_3010":122983},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3554":72991,"_30673":72989,"_5":31029,"_21251":122985,"_27884":122986,"_3010":122987},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3554":72992,"_30673":72989,"_5":31029,"_21251":122989,"_27884":122990,"_3010":120795},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3554":72993,"_30673":72989,"_5":31029,"_21251":122992,"_27884":122993,"_3010":120970},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3554":72994,"_30673":72989,"_5":31029,"_21251":122995,"_27884":122996,"_3010":122202},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#integraciones",{"_3554":72995,"_30673":72989,"_5":31029,"_21251":122998,"_27884":122999,"_3010":123000},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3554":72996,"_30673":72989,"_21251":123002,"_5":14613,"_27884":72989,"_3010":123003},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3554":72997,"_30673":72989,"_21251":123005,"_5":14613,"_27884":122986,"_3010":123006},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3554":72998,"_30673":72989,"_21251":123008,"_5":14613,"_27884":122986,"_3010":123009},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3554":72999,"_30673":72989,"_21251":123011,"_5":14613,"_27884":122990,"_3010":123012},[],"Recurso",{"_3554":73000,"_30673":72989,"_21251":123014,"_5":14613,"_27884":122990,"_3010":123015},[],"Qué representa",{"_3554":73001,"_30673":72989,"_21251":123017,"_5":14613,"_27884":122990,"_3010":123018},[],"**Dispositivo**",{"_3554":73002,"_30673":72989,"_21251":123020,"_5":14613,"_27884":122990,"_3010":123021},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3554":73003,"_30673":72989,"_21251":123023,"_5":14613,"_27884":122990,"_3010":123024},[],"**Identidad**",{"_3554":73004,"_30673":72989,"_21251":123026,"_5":14613,"_27884":122990,"_3010":123027},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3554":73005,"_30673":72989,"_21251":123029,"_5":14613,"_27884":122990,"_3010":55076},[],{"_3554":73006,"_30673":72989,"_21251":123031,"_5":14613,"_27884":122990,"_3010":123032},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3554":73007,"_30673":72989,"_21251":123034,"_5":14613,"_27884":122990,"_3010":123035},[],"**Flota**",{"_3554":73008,"_30673":72989,"_21251":123037,"_5":14613,"_27884":122990,"_3010":123038},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3554":73009,"_30673":72989,"_21251":123040,"_5":14613,"_27884":122990,"_3010":123041},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3554":73010,"_30673":72989,"_21251":123043,"_5":14613,"_27884":122990,"_3010":123044},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3554":73011,"_30673":72989,"_21251":123046,"_5":14613,"_27884":122993,"_3010":123047},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3554":73012,"_30673":72989,"_21251":123049,"_5":14613,"_27884":122993,"_3010":123050},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3554":73013,"_30673":72989,"_21251":123052,"_5":14613,"_27884":122993,"_3010":123053},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3554":73014,"_30673":72989,"_21251":123055,"_5":14613,"_27884":122993,"_3010":123056},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3554":73015,"_30673":72989,"_21251":123058,"_5":14613,"_27884":122993,"_3010":123059},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3554":73016,"_30673":72989,"_21251":123061,"_5":14613,"_27884":122993,"_3010":123062},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3554":73017,"_30673":72989,"_21251":123064,"_5":14613,"_27884":122993,"_3010":123065},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3554":73018,"_30673":72989,"_21251":123067,"_5":14613,"_27884":122993,"_3010":123068},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3554":73019,"_30673":72989,"_21251":123070,"_5":14613,"_27884":122996,"_3010":123071},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3554":73020,"_30673":72989,"_21251":123073,"_5":14613,"_27884":122996,"_3010":123074},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3554":73021,"_30673":72989,"_21251":123076,"_5":14613,"_27884":122999,"_3010":123077},[],"Participante",{"_3554":73022,"_30673":72989,"_21251":123079,"_5":14613,"_27884":122999,"_3010":123080},[],"Responsabilidad",{"_3554":73023,"_30673":72989,"_21251":123082,"_5":14613,"_27884":122999,"_3010":123083},[],"Administrador PKI",{"_3554":73024,"_30673":72989,"_21251":123085,"_5":14613,"_27884":122999,"_3010":123086},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3554":73025,"_30673":72989,"_21251":123088,"_5":14613,"_27884":122999,"_3010":123089},[],"Administrador del aprovisionamiento",{"_3554":73026,"_30673":72989,"_21251":123091,"_5":14613,"_27884":122999,"_3010":123092},[],"DMS, admisión, autenticación por operación e inventario.",{"_3554":73027,"_30673":72989,"_21251":123094,"_5":14613,"_27884":122999,"_3010":123095},[],"Integrador del dispositivo",{"_3554":73028,"_30673":72989,"_21251":123097,"_5":14613,"_27884":122999,"_3010":123098},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3554":73029,"_30673":72989,"_21251":123100,"_5":14613,"_27884":122999,"_3010":123101},[],"Integrador del consumidor",{"_3554":73030,"_30673":72989,"_21251":123103,"_5":14613,"_27884":122999,"_3010":123104},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3554":73031,"_30673":72989,"_21251":123106,"_5":14613,"_27884":122999,"_3010":123107},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3554":73032,"_30673":73032,"_5":14965,"_3010":123109,"_31032":123110,"_21251":123112,"_27884":73032},"Enrola y conecta tu primer dispositivo",[50083,119650,52730,123111],"Primeros pasos",[],{"_3554":73033,"_30673":73032,"_21251":123114,"_5":14613,"_27884":73032,"_3010":123115},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3554":73034,"_30673":73032,"_5":31029,"_21251":123117,"_27884":123118,"_3010":118221},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3554":73035,"_30673":73032,"_5":31029,"_21251":123120,"_27884":123121,"_3010":123122},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3554":73036,"_30673":73032,"_5":31029,"_21251":123124,"_27884":123125,"_3010":123126},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3554":73037,"_30673":73032,"_5":31029,"_21251":123128,"_27884":123129,"_3010":123130},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3554":73038,"_30673":73032,"_5":31029,"_21251":123132,"_27884":123133,"_3010":123134},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3554":73039,"_30673":73032,"_5":31029,"_21251":123136,"_27884":123137,"_3010":123138},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3554":73040,"_30673":73032,"_5":31029,"_21251":123140,"_27884":123141,"_3010":123142},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3554":73041,"_30673":73032,"_5":31029,"_21251":123144,"_27884":123145,"_3010":123146},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3554":73042,"_30673":73032,"_21251":123148,"_5":14613,"_27884":73032,"_3010":123149},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3554":73043,"_30673":73032,"_21251":123151,"_5":14613,"_27884":123118,"_3010":123152},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3554":73044,"_30673":73032,"_21251":123154,"_5":14613,"_27884":123118,"_3010":123155},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3554":73045,"_30673":73032,"_21251":123157,"_5":14613,"_27884":123118,"_3010":123158},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3554":73046,"_30673":73032,"_21251":123160,"_5":14613,"_27884":123118,"_3010":123161},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3554":73047,"_30673":73032,"_21251":123163,"_5":14613,"_27884":123118,"_3010":123164},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3554":73048,"_30673":73032,"_21251":123166,"_5":14613,"_27884":123121,"_3010":123167},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3554":73049,"_30673":73032,"_21251":123169,"_5":14613,"_27884":123121,"_3010":123170},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3554":73050,"_30673":73032,"_21251":123172,"_5":14613,"_27884":123125,"_3010":123173},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3554":73051,"_30673":73032,"_21251":123175,"_5":14613,"_27884":123125,"_3010":123176},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3554":73052,"_30673":73032,"_21251":123178,"_5":14613,"_27884":123125,"_3010":123179},[],"Ajuste",{"_3554":73053,"_30673":73032,"_21251":123181,"_5":14613,"_27884":123125,"_3010":123182},[],"Valor de evaluación",{"_3554":73054,"_30673":73032,"_21251":123184,"_5":14613,"_27884":123125,"_3010":55232},[],{"_3554":73055,"_30673":73032,"_21251":123186,"_5":14613,"_27884":123125,"_3010":123187},[],"Raíz emisora de `device-root.pem`.",{"_3554":73056,"_30673":73032,"_21251":123189,"_5":14613,"_27884":123125,"_3010":121098},[],{"_3554":73057,"_30673":73032,"_21251":123191,"_5":14613,"_27884":123125,"_3010":123192},[],"Perfil final de 1 hora que acabas de preparar.",{"_3554":73058,"_30673":73032,"_21251":123194,"_5":14613,"_27884":123125,"_3010":55243},[],{"_3554":73059,"_30673":73032,"_21251":123196,"_5":14613,"_27884":123125,"_3010":55246},[],{"_3554":73060,"_30673":73032,"_21251":123198,"_5":14613,"_27884":123125,"_3010":55249},[],{"_3554":73061,"_30673":73032,"_21251":123200,"_5":14613,"_27884":123125,"_3010":123201},[],"Habilitado.",{"_3554":73062,"_30673":73032,"_21251":123203,"_5":14613,"_27884":123125,"_3010":55255},[],{"_3554":73063,"_30673":73032,"_21251":123205,"_5":14613,"_27884":123125,"_3010":123206},[],"Deshabilitado; el ID debe ser nuevo.",{"_3554":73064,"_30673":73032,"_21251":123208,"_5":14613,"_27884":123125,"_3010":123209},[],"Autenticación inicial",{"_3554":73065,"_30673":73032,"_21251":123211,"_5":14613,"_27884":123125,"_3010":123212},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3554":73066,"_30673":73032,"_21251":123214,"_5":14613,"_27884":123125,"_3010":123215},[],"Autenticación de renovación",{"_3554":73067,"_30673":73032,"_21251":123217,"_5":14613,"_27884":123125,"_3010":123218},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3554":73068,"_30673":73032,"_21251":123220,"_5":14613,"_27884":123125,"_3010":55273},[],{"_3554":73069,"_30673":73032,"_21251":123222,"_5":14613,"_27884":123125,"_3010":123223},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3554":73070,"_30673":73032,"_21251":123225,"_5":14613,"_27884":123125,"_3010":55279},[],{"_3554":73071,"_30673":73032,"_21251":123227,"_5":14613,"_27884":123125,"_3010":123228},[],"1 hora.",{"_3554":73072,"_30673":73032,"_21251":123230,"_5":14613,"_27884":123125,"_3010":55285},[],{"_3554":73073,"_30673":73032,"_21251":123232,"_5":14613,"_27884":123125,"_3010":123233},[],"30 minutos / 10 minutos.",{"_3554":73074,"_30673":73032,"_21251":123235,"_5":14613,"_27884":123125,"_3010":55291},[],{"_3554":73075,"_30673":73032,"_21251":123237,"_5":14613,"_27884":123125,"_3010":123238},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3554":73076,"_30673":73032,"_21251":123240,"_5":14613,"_27884":123125,"_3010":53049},[],{"_3554":73077,"_30673":73032,"_21251":123242,"_5":14613,"_27884":123125,"_3010":123243},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3554":73078,"_30673":73032,"_21251":123245,"_5":14613,"_27884":123125,"_3010":55302},[],{"_3554":73079,"_30673":73032,"_21251":123247,"_5":14613,"_27884":123125,"_3010":123248},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3554":73080,"_30673":73032,"_21251":123250,"_5":14613,"_27884":123125,"_3010":123251},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3554":73081,"_30673":73032,"_21251":123253,"_5":14613,"_27884":123129,"_3010":123254},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3554":73082,"_30673":73032,"_21251":123256,"_5":14613,"_27884":123129,"_3010":123257},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3554":73083,"_30673":73032,"_21251":123259,"_5":14613,"_27884":123133,"_3010":123260},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3554":73084,"_30673":73032,"_21251":123262,"_5":14613,"_27884":123133,"_3010":123263},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3554":73085,"_30673":73032,"_21251":123265,"_5":14613,"_27884":123133,"_3010":123266},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3554":73086,"_30673":73032,"_21251":123268,"_5":14613,"_27884":123137,"_3010":123269},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3554":73087,"_30673":73032,"_21251":123271,"_5":14613,"_27884":123137,"_3010":123272},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3554":73088,"_30673":73032,"_21251":123274,"_5":14613,"_27884":123141,"_3010":123275},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3554":73089,"_30673":73032,"_21251":123277,"_5":14613,"_27884":123141,"_3010":123278},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3554":73090,"_30673":73032,"_21251":123280,"_5":14613,"_27884":123141,"_3010":123281},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3554":73091,"_30673":73032,"_21251":123283,"_5":14613,"_27884":123141,"_3010":123284},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3554":73092,"_30673":73032,"_21251":123286,"_5":14613,"_27884":123141,"_3010":123287},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3554":73093,"_30673":73032,"_21251":123289,"_5":14613,"_27884":123145,"_3010":123290},[],"Comprobación",{"_3554":73094,"_30673":73032,"_21251":123292,"_5":14613,"_27884":123145,"_3010":123293},[],"Resultado esperado",{"_3554":73095,"_30673":73032,"_21251":123295,"_5":14613,"_27884":123145,"_3010":123296},[],"Registro",{"_3554":73096,"_30673":73032,"_21251":123298,"_5":14613,"_27884":123145,"_3010":123299},[],"ID creado automáticamente y DMS correcto.",{"_3554":73097,"_30673":73032,"_21251":123301,"_5":14613,"_27884":123145,"_3010":122586},[],{"_3554":73098,"_30673":73032,"_21251":123303,"_5":14613,"_27884":123145,"_3010":123304},[],"CN, perfil, serie y clave verificados.",{"_3554":73099,"_30673":73032,"_21251":123306,"_5":14613,"_27884":123145,"_3010":123307},[],"Inventario",{"_3554":73100,"_30673":73032,"_21251":123309,"_5":14613,"_27884":123145,"_3010":123310},[],"Serie recibida visible como identidad actual y en el historial.",{"_3554":73101,"_30673":73032,"_21251":123312,"_5":14613,"_27884":123145,"_3010":123313},[],"Consumidor",{"_3554":73102,"_30673":73032,"_21251":123315,"_5":14613,"_27884":123145,"_3010":123316},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3554":73103,"_30673":73032,"_21251":123318,"_5":14613,"_27884":123145,"_3010":123319},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3554":73104,"_30673":73032,"_21251":123321,"_5":14613,"_27884":123145,"_3010":123322},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3554":73105,"_30673":73105,"_5":14965,"_3010":120812,"_31032":123324,"_21251":123325,"_27884":73105},[50083,119650,52730,123111],[],{"_3554":73106,"_30673":73105,"_21251":123327,"_5":14613,"_27884":73105,"_3010":123328},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3554":73107,"_30673":73105,"_5":31029,"_21251":123330,"_27884":123331,"_3010":118221},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3554":73108,"_30673":73105,"_5":31029,"_21251":123333,"_27884":123334,"_3010":123335},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3554":73109,"_30673":73105,"_5":31029,"_21251":123337,"_27884":123338,"_3010":123339},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3554":73110,"_30673":73105,"_5":31029,"_21251":123341,"_27884":123342,"_3010":123343},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3554":73111,"_30673":73105,"_5":31029,"_21251":123345,"_27884":123346,"_3010":123347},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3554":73112,"_30673":73105,"_5":31029,"_21251":123349,"_27884":123350,"_3010":123351},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3554":73113,"_30673":73105,"_5":31029,"_21251":123353,"_27884":123354,"_3010":123293},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3554":73114,"_30673":73105,"_5":31029,"_21251":123356,"_27884":123357,"_3010":123358},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3554":73115,"_30673":73105,"_5":31029,"_21251":123360,"_27884":123361,"_3010":123362},[],"/docs/pr-preview/pr-69/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3554":73116,"_30673":73105,"_21251":123364,"_5":14613,"_27884":73105,"_3010":123365},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3554":73117,"_30673":73105,"_21251":123367,"_5":14613,"_27884":73105,"_3010":123368},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3554":73118,"_30673":73105,"_21251":123370,"_5":14613,"_27884":123331,"_3010":123371},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3554":73119,"_30673":73105,"_21251":123373,"_5":14613,"_27884":123331,"_3010":123374},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3554":73120,"_30673":73105,"_21251":123376,"_5":14613,"_27884":123331,"_3010":123377},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3554":73121,"_30673":73105,"_21251":123379,"_5":14613,"_27884":123331,"_3010":123380},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3554":73122,"_30673":73105,"_21251":123382,"_5":14613,"_27884":123334,"_3010":123383},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3554":73123,"_30673":73105,"_21251":123385,"_5":14613,"_27884":123334,"_3010":123386},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3554":73124,"_30673":73105,"_21251":123388,"_5":14613,"_27884":123334,"_3010":123389},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3554":73125,"_30673":73105,"_21251":123391,"_5":14613,"_27884":123334,"_3010":123392},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3554":73126,"_30673":73105,"_21251":123394,"_5":14613,"_27884":123334,"_3010":123395},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3554":73127,"_30673":73105,"_21251":123397,"_5":14613,"_27884":123334,"_3010":123398},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3554":73128,"_30673":73105,"_21251":123400,"_5":14613,"_27884":123334,"_3010":123401},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3554":73129,"_30673":73105,"_21251":123403,"_5":14613,"_27884":123334,"_3010":123404},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3554":73130,"_30673":73105,"_21251":123406,"_5":14613,"_27884":123338,"_3010":123407},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3554":73131,"_30673":73105,"_21251":123409,"_5":14613,"_27884":123338,"_3010":55467},[],{"_3554":73132,"_30673":73105,"_21251":123411,"_5":14613,"_27884":123338,"_3010":123412},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3554":73133,"_30673":73105,"_21251":123414,"_5":14613,"_27884":123338,"_3010":123415},[],"**Icon** y **Tags**: clasificación opcional.",{"_3554":73134,"_30673":73105,"_21251":123417,"_5":14613,"_27884":123338,"_3010":123418},[],"Confirma el registro.",{"_3554":73135,"_30673":73105,"_21251":123420,"_5":14613,"_27884":123342,"_3010":123421},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3554":73136,"_30673":73105,"_21251":123423,"_5":14613,"_27884":123342,"_3010":123424},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3554":73137,"_30673":73105,"_21251":123426,"_5":14613,"_27884":123346,"_3010":123427},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3554":73138,"_30673":73105,"_21251":123429,"_5":14613,"_27884":123346,"_3010":123430},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3554":73139,"_30673":73105,"_21251":123432,"_5":14613,"_27884":123350,"_3010":123433},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3554":73140,"_30673":73105,"_21251":123435,"_5":14613,"_27884":123350,"_3010":123436},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3554":73141,"_30673":73105,"_21251":123438,"_5":14613,"_27884":123354,"_3010":123290},[],{"_3554":73142,"_30673":73105,"_21251":123440,"_5":14613,"_27884":123354,"_3010":123441},[],"Resultado",{"_3554":73143,"_30673":73105,"_21251":123443,"_5":14613,"_27884":123354,"_3010":122572},[],{"_3554":73144,"_30673":73105,"_21251":123445,"_5":14613,"_27884":123354,"_3010":123446},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3554":73145,"_30673":73105,"_21251":123448,"_5":14613,"_27884":123354,"_3010":123449},[],"Identidad actual",{"_3554":73146,"_30673":73105,"_21251":123451,"_5":14613,"_27884":123354,"_3010":123452},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3554":73147,"_30673":73105,"_21251":123454,"_5":14613,"_27884":123354,"_3010":123455},[],"Historial",{"_3554":73148,"_30673":73105,"_21251":123457,"_5":14613,"_27884":123354,"_3010":123458},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3554":73149,"_30673":73105,"_21251":123460,"_5":14613,"_27884":123354,"_3010":123461},[],"Clave y certificado",{"_3554":73150,"_30673":73105,"_21251":123463,"_5":14613,"_27884":123354,"_3010":123464},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3554":73151,"_30673":73105,"_21251":123466,"_5":14613,"_27884":123357,"_3010":123467},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3554":73152,"_30673":73105,"_21251":123469,"_5":14613,"_27884":123357,"_3010":123470},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3554":73153,"_30673":73105,"_21251":123472,"_5":14613,"_27884":123357,"_3010":123473},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3554":73154,"_30673":73105,"_21251":123475,"_5":14613,"_27884":123357,"_3010":123476},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3554":73155,"_30673":73105,"_21251":123478,"_5":14613,"_27884":123361,"_3010":123479},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3554":73156,"_30673":73105,"_21251":123481,"_5":14613,"_27884":123361,"_3010":123482},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3554":73157,"_30673":73105,"_21251":123484,"_5":14613,"_27884":123361,"_3010":123485},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3554":73158,"_30673":73158,"_5":14965,"_3010":123487,"_31032":123488,"_21251":123489,"_27884":73158},"Plataforma Lamassu IoT",[50083,119650],[],{"_3554":73159,"_30673":73158,"_21251":123491,"_5":14613,"_27884":73158,"_3010":123492},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3554":73160,"_30673":73158,"_5":31029,"_21251":123494,"_27884":123495,"_3010":122987},[],"/docs/pr-preview/pr-69/es/platform/overview#empieza-aquí",{"_3554":73161,"_30673":73158,"_5":31029,"_21251":123497,"_27884":123498,"_3010":123499},[],"/docs/pr-preview/pr-69/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3554":73162,"_30673":73158,"_5":31029,"_21251":123501,"_27884":123502,"_3010":123503},[],"/docs/pr-preview/pr-69/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3554":73163,"_30673":73158,"_5":31029,"_21251":123505,"_27884":123506,"_3010":123507},[],"/docs/pr-preview/pr-69/es/platform/overview#capacidades-principales","Capacidades principales",{"_3554":73164,"_30673":73158,"_5":31029,"_21251":123509,"_27884":123510,"_3010":123511},[],"/docs/pr-preview/pr-69/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3554":73165,"_30673":73158,"_5":31029,"_21251":123513,"_27884":123514,"_3010":123515},[],"/docs/pr-preview/pr-69/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3554":73166,"_30673":73158,"_5":31029,"_21251":123517,"_27884":123518,"_3010":123519},[],"/docs/pr-preview/pr-69/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3554":73167,"_30673":73158,"_5":31029,"_21251":123521,"_27884":123522,"_3010":123523},[],"/docs/pr-preview/pr-69/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3554":73168,"_30673":73158,"_5":31029,"_21251":123525,"_27884":123526,"_3010":123527},[],"/docs/pr-preview/pr-69/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3554":73169,"_30673":73158,"_5":31029,"_21251":123529,"_27884":123530,"_3010":123531},[],"/docs/pr-preview/pr-69/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3554":73170,"_30673":73158,"_5":31029,"_21251":123533,"_27884":123534,"_3010":123535},[],"/docs/pr-preview/pr-69/es/platform/overview#referencia-operativa","Referencia operativa",{"_3554":73171,"_30673":73158,"_21251":123537,"_5":14613,"_27884":73158,"_3010":123538},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3554":73172,"_30673":73158,"_21251":123540,"_5":14613,"_27884":123495,"_3010":123541},[],"Elige el resultado que necesitas obtener:",{"_3554":73173,"_30673":73158,"_21251":123543,"_5":14613,"_27884":123495,"_3010":123544},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3554":73174,"_30673":73158,"_21251":123546,"_5":14613,"_27884":123495,"_3010":123547},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3554":73175,"_30673":73158,"_21251":123549,"_5":14613,"_27884":123495,"_3010":123550},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3554":73176,"_30673":73158,"_21251":123552,"_5":14613,"_27884":123498,"_3010":123553},[],"Bloque",{"_3554":73177,"_30673":73158,"_21251":123555,"_5":14613,"_27884":123498,"_3010":123556},[],"Qué gestionas",{"_3554":73178,"_30673":73158,"_21251":123558,"_5":14613,"_27884":123498,"_3010":123559},[],"Punto de entrada",{"_3554":73179,"_30673":73158,"_21251":123561,"_5":14613,"_27884":123498,"_3010":55620},[],{"_3554":73180,"_30673":73158,"_21251":123563,"_5":14613,"_27884":123498,"_3010":123564},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3554":73181,"_30673":73158,"_21251":123566,"_5":14613,"_27884":123498,"_3010":123567},[],"Visión general de PKI",{"_3554":73182,"_30673":73158,"_21251":123569,"_5":14613,"_27884":123498,"_3010":55629},[],{"_3554":73183,"_30673":73158,"_21251":123571,"_5":14613,"_27884":123498,"_3010":123572},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3554":73184,"_30673":73158,"_21251":123574,"_5":14613,"_27884":123498,"_3010":123575},[],"Visión general de IoT Fleets",{"_3554":73185,"_30673":73158,"_21251":123577,"_5":14613,"_27884":123498,"_3010":123578},[],"**Administración**",{"_3554":73186,"_30673":73158,"_21251":123580,"_5":14613,"_27884":123498,"_3010":123581},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3554":73187,"_30673":73158,"_21251":123583,"_5":14613,"_27884":123498,"_3010":119652},[],{"_3554":73188,"_30673":73158,"_21251":123585,"_5":14613,"_27884":123498,"_3010":123586},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3554":73189,"_30673":73158,"_21251":123588,"_5":14613,"_27884":123502,"_3010":123589},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3554":73190,"_30673":73158,"_21251":123591,"_5":14613,"_27884":123502,"_3010":123592},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3554":73191,"_30673":73158,"_21251":123594,"_5":14613,"_27884":123502,"_3010":123595},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3554":73192,"_30673":73158,"_21251":123597,"_5":14613,"_27884":123502,"_3010":123598},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3554":73193,"_30673":73158,"_21251":123600,"_5":14613,"_27884":123502,"_3010":123601},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3554":73194,"_30673":73158,"_21251":123603,"_5":14613,"_27884":123502,"_3010":123604},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3554":73195,"_30673":73158,"_21251":123606,"_5":14613,"_27884":123510,"_3010":123607},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3554":73196,"_30673":73158,"_21251":123609,"_5":14613,"_27884":123514,"_3010":123610},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3554":73197,"_30673":73158,"_21251":123612,"_5":14613,"_27884":123518,"_3010":123613},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3554":73198,"_30673":73158,"_21251":123615,"_5":14613,"_27884":123522,"_3010":123616},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3554":73199,"_30673":73158,"_21251":123618,"_5":14613,"_27884":123526,"_3010":123619},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3554":73200,"_30673":73158,"_21251":123621,"_5":14613,"_27884":123530,"_3010":123622},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3554":73201,"_30673":73158,"_21251":123624,"_5":14613,"_27884":123534,"_3010":123080},[],{"_3554":73202,"_30673":73158,"_21251":123626,"_5":14613,"_27884":123534,"_3010":123627},[],"Qué prepara o comprueba",{"_3554":73203,"_30673":73158,"_21251":123629,"_5":14613,"_27884":123534,"_3010":123083},[],{"_3554":73204,"_30673":73158,"_21251":123631,"_5":14613,"_27884":123534,"_3010":123632},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3554":73205,"_30673":73158,"_21251":123634,"_5":14613,"_27884":123534,"_3010":123635},[],"Administrador de la flota",{"_3554":73206,"_30673":73158,"_21251":123637,"_5":14613,"_27884":123534,"_3010":123638},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3554":73207,"_30673":73158,"_21251":123640,"_5":14613,"_27884":123534,"_3010":123095},[],{"_3554":73208,"_30673":73158,"_21251":123642,"_5":14613,"_27884":123534,"_3010":123643},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3554":73209,"_30673":73158,"_21251":123645,"_5":14613,"_27884":123534,"_3010":123101},[],{"_3554":73210,"_30673":73158,"_21251":123647,"_5":14613,"_27884":123534,"_3010":123648},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3554":73211,"_30673":73158,"_21251":123650,"_5":14613,"_27884":123534,"_3010":123651},[],"Operador de infraestructura",{"_3554":73212,"_30673":73158,"_21251":123653,"_5":14613,"_27884":123534,"_3010":123654},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3554":73213,"_30673":73158,"_21251":123656,"_5":14613,"_27884":123534,"_3010":123657},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3554":73214,"_30673":73214,"_5":14965,"_3010":123659,"_31032":123660,"_21251":123662,"_27884":73214},"Jerarquía y rotación de CAs",[50083,119650,55721,123661],"Claves, autoridades y certificados",[],{"_3554":73215,"_30673":73214,"_21251":123664,"_5":14613,"_27884":73214,"_3010":123665},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3554":73216,"_30673":73214,"_5":31029,"_21251":123667,"_27884":123668,"_3010":123669},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3554":73217,"_30673":73214,"_5":31029,"_21251":123671,"_27884":123672,"_3010":123673},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3554":73218,"_30673":73214,"_5":31029,"_21251":123675,"_27884":123676,"_3010":123677},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3554":73219,"_30673":73214,"_5":31029,"_21251":123679,"_27884":123680,"_3010":123681},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3554":73220,"_30673":73214,"_5":31029,"_21251":123683,"_27884":123684,"_3010":123685},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3554":73221,"_30673":73214,"_5":31029,"_21251":123687,"_27884":123688,"_3010":123689},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3554":73222,"_30673":73214,"_5":31029,"_21251":123691,"_27884":123692,"_3010":123693},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3554":73223,"_30673":73214,"_5":31029,"_21251":123695,"_27884":123696,"_3010":123697},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3554":73224,"_30673":73214,"_5":31029,"_21251":123699,"_27884":123700,"_3010":123701},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3554":73225,"_30673":73214,"_5":31029,"_21251":123703,"_27884":123704,"_3010":123705},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3554":73226,"_30673":73214,"_5":31029,"_21251":123707,"_27884":123708,"_3010":123709},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3554":73227,"_30673":73214,"_5":31029,"_21251":123711,"_27884":123712,"_3010":123713},[],"/docs/pr-preview/pr-69/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3554":73228,"_30673":73214,"_21251":123715,"_5":14613,"_27884":73214,"_3010":123716},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3554":73229,"_30673":73214,"_21251":123718,"_5":14613,"_27884":73214,"_3010":123719},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3554":73230,"_30673":73214,"_21251":123721,"_5":14613,"_27884":123668,"_3010":123722},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3554":73231,"_30673":73214,"_21251":123724,"_5":14613,"_27884":123668,"_3010":123725},[],"entorno, como producción y preproducción;",{"_3554":73232,"_30673":73214,"_21251":123727,"_5":14613,"_27884":123668,"_3010":123728},[],"propietario o equipo operador;",{"_3554":73233,"_30673":73214,"_21251":123730,"_5":14613,"_27884":123668,"_3010":123731},[],"familia de dispositivos o proceso de fabricación;",{"_3554":73234,"_30673":73214,"_21251":123733,"_5":14613,"_27884":123668,"_3010":123734},[],"región o requisito regulatorio;",{"_3554":73235,"_30673":73214,"_21251":123736,"_5":14613,"_27884":123668,"_3010":123737},[],"motor criptográfico o política de clave;",{"_3554":73236,"_30673":73214,"_21251":123739,"_5":14613,"_27884":123668,"_3010":123740},[],"ventana de mantenimiento y ritmo de renovación.",{"_3554":73237,"_30673":73214,"_21251":123742,"_5":14613,"_27884":123668,"_3010":123743},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3554":73238,"_30673":73214,"_21251":123745,"_5":14613,"_27884":123668,"_3010":123746},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3554":73239,"_30673":73214,"_21251":123748,"_5":14613,"_27884":123672,"_3010":123749},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3554":73240,"_30673":73214,"_21251":123751,"_5":14613,"_27884":123672,"_3010":123752},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3554":73241,"_30673":73214,"_21251":123754,"_5":14613,"_27884":123672,"_3010":123755},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3554":73242,"_30673":73214,"_21251":123757,"_5":14613,"_27884":123672,"_3010":123758},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3554":73243,"_30673":73214,"_21251":123760,"_5":14613,"_27884":123676,"_3010":123761},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3554":73244,"_30673":73214,"_21251":123763,"_5":14613,"_27884":123676,"_3010":123764},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3554":73245,"_30673":73214,"_21251":123766,"_5":14613,"_27884":123676,"_3010":123767},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3554":73246,"_30673":73214,"_21251":123769,"_5":14613,"_27884":123676,"_3010":123770},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3554":73247,"_30673":73214,"_21251":123772,"_5":14613,"_27884":123684,"_3010":123773},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3554":73248,"_30673":73214,"_21251":123775,"_5":14613,"_27884":123688,"_3010":123776},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3554":73249,"_30673":73214,"_21251":123778,"_5":14613,"_27884":123692,"_3010":123779},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3554":73250,"_30673":73214,"_21251":123781,"_5":14613,"_27884":123696,"_3010":123782},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3554":73251,"_30673":73214,"_21251":123784,"_5":14613,"_27884":123700,"_3010":123785},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3554":73252,"_30673":73214,"_21251":123787,"_5":14613,"_27884":123704,"_3010":123788},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3554":73253,"_30673":73214,"_21251":123790,"_5":14613,"_27884":123708,"_3010":123791},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3554":73254,"_30673":73214,"_21251":123793,"_5":14613,"_27884":123708,"_3010":123794},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3554":73255,"_30673":73214,"_21251":123796,"_5":14613,"_27884":123708,"_3010":123797},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3554":73256,"_30673":73214,"_21251":123799,"_5":14613,"_27884":123708,"_3010":123800},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3554":73257,"_30673":73214,"_21251":123802,"_5":14613,"_27884":123712,"_3010":123803},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3554":73258,"_30673":73214,"_21251":123805,"_5":14613,"_27884":123712,"_3010":123806},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3554":73259,"_30673":73214,"_21251":123808,"_5":14613,"_27884":123712,"_3010":123809},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3554":73260,"_30673":73214,"_21251":123811,"_5":14613,"_27884":123712,"_3010":123812},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3554":73261,"_30673":73214,"_21251":123814,"_5":14613,"_27884":123712,"_3010":123815},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3554":73262,"_30673":73214,"_21251":123817,"_5":14613,"_27884":123712,"_3010":123818},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3554":73263,"_30673":73214,"_21251":123820,"_5":14613,"_27884":123712,"_3010":123821},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3554":73264,"_30673":73264,"_5":14965,"_3010":123823,"_31032":123824,"_21251":123825,"_27884":73264},"Autoridades de certificación",[50083,119650,55721,123661],[],{"_3554":73265,"_30673":73264,"_21251":123827,"_5":14613,"_27884":73264,"_3010":123828},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3554":73266,"_30673":73264,"_5":31029,"_21251":123830,"_27884":123831,"_3010":123832},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3554":73267,"_30673":73264,"_5":31029,"_21251":123834,"_27884":123835,"_3010":123836},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3554":73268,"_30673":73264,"_5":31029,"_21251":123838,"_27884":123839,"_3010":118221},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3554":73269,"_30673":73264,"_5":31029,"_21251":123841,"_27884":123842,"_3010":123843},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3554":73270,"_30673":73264,"_5":31029,"_21251":123845,"_27884":123846,"_3010":123847},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3554":73271,"_30673":73264,"_5":31029,"_21251":123849,"_27884":123850,"_3010":123851},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3554":73272,"_30673":73264,"_5":31029,"_21251":123853,"_27884":123854,"_3010":123855},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3554":73273,"_30673":73264,"_5":31029,"_21251":123857,"_27884":123858,"_3010":123859},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3554":73274,"_30673":73264,"_5":31029,"_21251":123861,"_27884":123862,"_3010":123863},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3554":73275,"_30673":73264,"_5":31029,"_21251":123865,"_27884":123866,"_3010":123867},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3554":73276,"_30673":73264,"_5":31029,"_21251":123869,"_27884":123870,"_3010":123871},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3554":73277,"_30673":73264,"_5":31029,"_21251":123873,"_27884":123874,"_3010":123875},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3554":73278,"_30673":73264,"_5":31029,"_21251":123877,"_27884":123878,"_3010":123879},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3554":73279,"_30673":73264,"_5":31029,"_21251":123881,"_27884":123882,"_3010":123883},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3554":73280,"_30673":73264,"_5":31029,"_21251":123885,"_27884":123886,"_3010":123887},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3554":73281,"_30673":73264,"_5":31029,"_21251":123889,"_27884":123890,"_3010":123891},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3554":73282,"_30673":73264,"_5":31029,"_21251":123893,"_27884":123894,"_3010":123895},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3554":73283,"_30673":73264,"_5":31029,"_21251":123897,"_27884":123898,"_3010":123899},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3554":73284,"_30673":73264,"_5":31029,"_21251":123901,"_27884":123902,"_3010":123903},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3554":73285,"_30673":73264,"_5":31029,"_21251":123905,"_27884":123906,"_3010":123907},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3554":73286,"_30673":73264,"_5":31029,"_21251":123909,"_27884":123910,"_3010":123911},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3554":73287,"_30673":73264,"_5":31029,"_21251":123913,"_27884":123914,"_3010":123915},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3554":73288,"_30673":73264,"_5":31029,"_21251":123917,"_27884":123918,"_3010":123919},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3554":73289,"_30673":73264,"_21251":123921,"_5":14613,"_27884":73264,"_3010":123922},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3554":73290,"_30673":73264,"_21251":123924,"_5":14613,"_27884":73264,"_3010":123925},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3554":73291,"_30673":73264,"_21251":123927,"_5":14613,"_27884":73264,"_3010":123928},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3554":73292,"_30673":73264,"_21251":123930,"_5":14613,"_27884":123831,"_3010":123931},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3554":73293,"_30673":73264,"_21251":123933,"_5":14613,"_27884":123831,"_3010":123934},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3554":73294,"_30673":73264,"_21251":123936,"_5":14613,"_27884":123831,"_3010":123937},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3554":73295,"_30673":73264,"_21251":123939,"_5":14613,"_27884":123831,"_3010":123940},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3554":73296,"_30673":73264,"_21251":123942,"_5":14613,"_27884":123831,"_3010":123943},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3554":73297,"_30673":73264,"_21251":123945,"_5":14613,"_27884":123839,"_3010":123946},[],"Decide si la CA será raíz o intermedia.",{"_3554":73298,"_30673":73264,"_21251":123948,"_5":14613,"_27884":123839,"_3010":123949},[],"Elige el motor que custodiará la clave.",{"_3554":73299,"_30673":73264,"_21251":123951,"_5":14613,"_27884":123839,"_3010":123952},[],"Define una validez superior a la de los certificados que emitirá.",{"_3554":73300,"_30673":73264,"_21251":123954,"_5":14613,"_27884":123839,"_3010":123955},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3554":73301,"_30673":73264,"_21251":123957,"_5":14613,"_27884":123842,"_3010":123958},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3554":73302,"_30673":73264,"_21251":123960,"_5":14613,"_27884":123846,"_3010":123961},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3554":73303,"_30673":73264,"_21251":123963,"_5":14613,"_27884":123846,"_3010":123964},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3554":73304,"_30673":73264,"_21251":123966,"_5":14613,"_27884":123850,"_3010":123967},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3554":73305,"_30673":73264,"_21251":123969,"_5":14613,"_27884":123854,"_3010":123970},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3554":73306,"_30673":73264,"_21251":123972,"_5":14613,"_27884":123854,"_3010":123973},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3554":73307,"_30673":73264,"_21251":123975,"_5":14613,"_27884":123854,"_3010":123976},[],"`ST`: estado o provincia.",{"_3554":73308,"_30673":73264,"_21251":123978,"_5":14613,"_27884":123854,"_3010":123979},[],"`L`: localidad.",{"_3554":73309,"_30673":73264,"_21251":123981,"_5":14613,"_27884":123854,"_3010":123982},[],"`O`: organización.",{"_3554":73310,"_30673":73264,"_21251":123984,"_5":14613,"_27884":123854,"_3010":123985},[],"`OU`: unidad organizativa.",{"_3554":73311,"_30673":73264,"_21251":123987,"_5":14613,"_27884":123854,"_3010":123988},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3554":73312,"_30673":73264,"_21251":123990,"_5":14613,"_27884":123858,"_3010":123991},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3554":73313,"_30673":73264,"_21251":123993,"_5":14613,"_27884":123858,"_3010":123994},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3554":73314,"_30673":73264,"_21251":123996,"_5":14613,"_27884":123862,"_3010":123997},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3554":73315,"_30673":73264,"_21251":123999,"_5":14613,"_27884":123862,"_3010":124000},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3554":73316,"_30673":73264,"_21251":124002,"_5":14613,"_27884":123866,"_3010":124003},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3554":73317,"_30673":73264,"_21251":124005,"_5":14613,"_27884":123866,"_3010":124006},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3554":73318,"_30673":73264,"_21251":124008,"_5":14613,"_27884":123870,"_3010":124009},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3554":73319,"_30673":73264,"_21251":124011,"_5":14613,"_27884":123870,"_3010":124012},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3554":73320,"_30673":73264,"_21251":124014,"_5":14613,"_27884":123870,"_3010":124015},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3554":73321,"_30673":73264,"_21251":124017,"_5":14613,"_27884":123874,"_3010":124018},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3554":73322,"_30673":73264,"_21251":124020,"_5":14613,"_27884":123878,"_3010":124021},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3554":73323,"_30673":73264,"_21251":124023,"_5":14613,"_27884":123878,"_3010":124024},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3554":73324,"_30673":73264,"_21251":124026,"_5":14613,"_27884":123882,"_3010":124027},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3554":73325,"_30673":73264,"_21251":124029,"_5":14613,"_27884":123886,"_3010":124030},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3554":73326,"_30673":73264,"_21251":124032,"_5":14613,"_27884":123886,"_3010":124033},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3554":73327,"_30673":73264,"_21251":124035,"_5":14613,"_27884":123890,"_3010":124036},[],"Abre una CA desde el inventario para consultar:",{"_3554":73328,"_30673":73264,"_21251":124038,"_5":14613,"_27884":123890,"_3010":124039},[],"Estado y periodo de validez.",{"_3554":73329,"_30673":73264,"_21251":124041,"_5":14613,"_27884":123890,"_3010":124042},[],"Certificado y cadena en formato PEM.",{"_3554":73330,"_30673":73264,"_21251":124044,"_5":14613,"_27884":123890,"_3010":124045},[],"Número de certificados activos, expirados y revocados.",{"_3554":73331,"_30673":73264,"_21251":124047,"_5":14613,"_27884":123890,"_3010":124048},[],"Certificados emitidos en **Issued Certificates**.",{"_3554":73332,"_30673":73264,"_21251":124050,"_5":14613,"_27884":123890,"_3010":124051},[],"CRL vinculada a la autoridad.",{"_3554":73333,"_30673":73264,"_21251":124053,"_5":14613,"_27884":123890,"_3010":124054},[],"Metadatos y motor criptográfico asociado.",{"_3554":73334,"_30673":73264,"_21251":124056,"_5":14613,"_27884":123890,"_3010":124057},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3554":73335,"_30673":73264,"_21251":124059,"_5":14613,"_27884":123894,"_3010":124060},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3554":73336,"_30673":73264,"_21251":124062,"_5":14613,"_27884":123894,"_3010":124063},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3554":73337,"_30673":73264,"_21251":124065,"_5":14613,"_27884":123894,"_3010":124066},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3554":73338,"_30673":73264,"_21251":124068,"_5":14613,"_27884":123894,"_3010":124069},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3554":73339,"_30673":73264,"_21251":124071,"_5":14613,"_27884":123898,"_3010":124072},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3554":73340,"_30673":73264,"_21251":124074,"_5":14613,"_27884":123902,"_3010":124075},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3554":73341,"_30673":73264,"_21251":124077,"_5":14613,"_27884":123906,"_3010":124078},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3554":73342,"_30673":73264,"_21251":124080,"_5":14613,"_27884":123910,"_3010":124081},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3554":73343,"_30673":73264,"_21251":124083,"_5":14613,"_27884":123914,"_3010":124084},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3554":73344,"_30673":73264,"_21251":124086,"_5":14613,"_27884":123918,"_3010":124087},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3554":73345,"_30673":73264,"_21251":124089,"_5":14613,"_27884":123918,"_3010":124090},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3554":73346,"_30673":73264,"_21251":124092,"_5":14613,"_27884":123918,"_3010":124093},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3554":73347,"_30673":73264,"_21251":124095,"_5":14613,"_27884":123918,"_3010":124096},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3554":73348,"_30673":73348,"_5":14965,"_3010":124098,"_31032":124099,"_21251":124100,"_27884":73348},"Perfiles de certificado",[50083,119650,55721,123661],[],{"_3554":73349,"_30673":73348,"_21251":124102,"_5":14613,"_27884":73348,"_3010":124103},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3554":73350,"_30673":73348,"_5":31029,"_21251":124105,"_27884":124106,"_3010":124107},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3554":73351,"_30673":73348,"_5":31029,"_21251":124109,"_27884":124110,"_3010":124111},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#validez","Validez",{"_3554":73352,"_30673":73348,"_5":31029,"_21251":124113,"_27884":124114,"_3010":124115},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3554":73353,"_30673":73348,"_5":31029,"_21251":124117,"_27884":124118,"_3010":124119},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3554":73354,"_30673":73348,"_5":31029,"_21251":124121,"_27884":124122,"_3010":124123},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3554":73355,"_30673":73348,"_5":31029,"_21251":124125,"_27884":124126,"_3010":124127},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3554":73356,"_30673":73348,"_5":31029,"_21251":124129,"_27884":124130,"_3010":124131},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3554":73357,"_30673":73348,"_5":31029,"_21251":124133,"_27884":124134,"_3010":124135},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3554":73358,"_30673":73348,"_5":31029,"_21251":124137,"_27884":124138,"_3010":124139},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3554":73359,"_30673":73348,"_5":31029,"_21251":124141,"_27884":124142,"_3010":124143},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3554":73360,"_30673":73348,"_5":31029,"_21251":124145,"_27884":124146,"_3010":124147},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3554":73361,"_30673":73348,"_5":31029,"_21251":124149,"_27884":124150,"_3010":124151},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3554":73362,"_30673":73348,"_5":31029,"_21251":124153,"_27884":124154,"_3010":124155},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3554":73363,"_30673":73348,"_5":31029,"_21251":124157,"_27884":124158,"_3010":124159},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3554":73364,"_30673":73348,"_5":31029,"_21251":124161,"_27884":124162,"_3010":124163},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3554":73365,"_30673":73348,"_5":31029,"_21251":124165,"_27884":124166,"_3010":124167},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3554":73366,"_30673":73348,"_21251":124169,"_5":14613,"_27884":73348,"_3010":124170},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3554":73367,"_30673":73348,"_21251":124172,"_5":14613,"_27884":73348,"_3010":124173},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3554":73368,"_30673":73348,"_21251":124175,"_5":14613,"_27884":124110,"_3010":124176},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3554":73369,"_30673":73348,"_21251":124178,"_5":14613,"_27884":124110,"_3010":124179},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3554":73370,"_30673":73348,"_21251":124181,"_5":14613,"_27884":124114,"_3010":124182},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3554":73371,"_30673":73348,"_21251":124184,"_5":14613,"_27884":124118,"_3010":124185},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3554":73372,"_30673":73348,"_21251":124187,"_5":14613,"_27884":124118,"_3010":124188},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3554":73373,"_30673":73348,"_21251":124190,"_5":14613,"_27884":124118,"_3010":124191},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3554":73374,"_30673":73348,"_21251":124193,"_5":14613,"_27884":124122,"_3010":124194},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3554":73375,"_30673":73348,"_21251":124196,"_5":14613,"_27884":124126,"_3010":124197},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3554":73376,"_30673":73348,"_21251":124199,"_5":14613,"_27884":124126,"_3010":124200},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3554":73377,"_30673":73348,"_21251":124202,"_5":14613,"_27884":124130,"_3010":124203},[],"La aplicación criptográfica puede:",{"_3554":73378,"_30673":73348,"_21251":124205,"_5":14613,"_27884":124130,"_3010":124206},[],"permitir o bloquear claves RSA;",{"_3554":73379,"_30673":73348,"_21251":124208,"_5":14613,"_27884":124130,"_3010":124209},[],"limitar los tamaños RSA admitidos;",{"_3554":73380,"_30673":73348,"_21251":124211,"_5":14613,"_27884":124130,"_3010":124212},[],"permitir o bloquear claves ECDSA;",{"_3554":73381,"_30673":73348,"_21251":124214,"_5":14613,"_27884":124130,"_3010":124215},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3554":73382,"_30673":73348,"_21251":124217,"_5":14613,"_27884":124130,"_3010":124218},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3554":73383,"_30673":73348,"_21251":124220,"_5":14613,"_27884":124134,"_3010":124221},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3554":73384,"_30673":73348,"_21251":124223,"_5":14613,"_27884":124134,"_3010":119410},[],{"_3554":73385,"_30673":73348,"_21251":124225,"_5":14613,"_27884":124134,"_3010":124226},[],"Primera opción",{"_3554":73386,"_30673":73348,"_21251":124228,"_5":14613,"_27884":124134,"_3010":124229},[],"Segunda opción",{"_3554":73387,"_30673":73348,"_21251":124231,"_5":14613,"_27884":124134,"_3010":124232},[],"Si no hay ninguna",{"_3554":73388,"_30673":73348,"_21251":124234,"_5":14613,"_27884":124134,"_3010":124235},[],"Firma directa con una CA",{"_3554":73389,"_30673":73348,"_21251":124237,"_5":14613,"_27884":124134,"_3010":124238},[],"`issuance_profile` incluido en la solicitud",{"_3554":73390,"_30673":73348,"_21251":124240,"_5":14613,"_27884":124134,"_3010":124241},[],"`issuance_profile_id` de la solicitud",{"_3554":73391,"_30673":73348,"_21251":124243,"_5":14613,"_27884":124134,"_3010":124244},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3554":73392,"_30673":73348,"_21251":124246,"_5":14613,"_27884":124134,"_3010":124247},[],"Emisión mediante DMS",{"_3554":73393,"_30673":73348,"_21251":124249,"_5":14613,"_27884":124134,"_3010":56311},[],{"_3554":73394,"_30673":73348,"_21251":124251,"_5":14613,"_27884":124134,"_3010":124252},[],"`settings.issuance_profile` incluido en el DMS",{"_3554":73395,"_30673":73348,"_21251":124254,"_5":14613,"_27884":124134,"_3010":124255},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3554":73396,"_30673":73348,"_21251":124257,"_5":14613,"_27884":124134,"_3010":124258},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3554":73397,"_30673":73348,"_21251":124260,"_5":14613,"_27884":124134,"_3010":124261},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3554":73398,"_30673":73348,"_21251":124263,"_5":14613,"_27884":124142,"_3010":124264},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3554":73399,"_30673":73348,"_21251":124266,"_5":14613,"_27884":124146,"_3010":124267},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3554":73400,"_30673":73348,"_21251":124269,"_5":14613,"_27884":124150,"_3010":124270},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3554":73401,"_30673":73348,"_21251":124272,"_5":14613,"_27884":124154,"_3010":124273},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3554":73402,"_30673":73348,"_21251":124275,"_5":14613,"_27884":124158,"_3010":124276},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3554":73403,"_30673":73348,"_21251":124278,"_5":14613,"_27884":124158,"_3010":124279},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3554":73404,"_30673":73348,"_21251":124281,"_5":14613,"_27884":124162,"_3010":124282},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3554":73405,"_30673":73348,"_21251":124284,"_5":14613,"_27884":124162,"_3010":124285},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3554":73406,"_30673":73348,"_21251":124287,"_5":14613,"_27884":124162,"_3010":124288},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3554":73407,"_30673":73348,"_21251":124290,"_5":14613,"_27884":124162,"_3010":124291},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3554":73408,"_30673":73348,"_21251":124293,"_5":14613,"_27884":124166,"_3010":124294},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3554":73409,"_30673":73348,"_21251":124296,"_5":14613,"_27884":124166,"_3010":124297},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3554":73410,"_30673":73410,"_5":14965,"_3010":124299,"_31032":124300,"_21251":124302,"_27884":73410},"Validación de certificados",[50083,119650,55721,124301],"Validación",[],{"_3554":73411,"_30673":73410,"_21251":124304,"_5":14613,"_27884":73410,"_3010":124305},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3554":73412,"_30673":73410,"_5":31029,"_21251":124307,"_27884":124308,"_3010":124309},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3554":73413,"_30673":73410,"_5":31029,"_21251":124311,"_27884":124312,"_3010":124313},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3554":73414,"_30673":73410,"_5":31029,"_21251":124315,"_27884":124316,"_3010":124317},[],"/docs/pr-preview/pr-69/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3554":73415,"_30673":73410,"_21251":124319,"_5":14613,"_27884":73410,"_3010":124320},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3554":73416,"_30673":73410,"_21251":124322,"_5":14613,"_27884":124308,"_3010":124323},[],"Verifica estos criterios juntos:",{"_3554":73417,"_30673":73410,"_21251":124325,"_5":14613,"_27884":124308,"_3010":123290},[],{"_3554":73418,"_30673":73410,"_21251":124327,"_5":14613,"_27884":124308,"_3010":124328},[],"Resultado necesario",{"_3554":73419,"_30673":73410,"_21251":124330,"_5":14613,"_27884":124308,"_3010":124331},[],"Cadena y firma",{"_3554":73420,"_30673":73410,"_21251":124333,"_5":14613,"_27884":124308,"_3010":124334},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3554":73421,"_30673":73410,"_21251":124336,"_5":14613,"_27884":124308,"_3010":124337},[],"Fechas",{"_3554":73422,"_30673":73410,"_21251":124339,"_5":14613,"_27884":124308,"_3010":124340},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3554":73423,"_30673":73410,"_21251":124342,"_5":14613,"_27884":124308,"_3010":119320},[],{"_3554":73424,"_30673":73410,"_21251":124344,"_5":14613,"_27884":124308,"_3010":124345},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3554":73425,"_30673":73410,"_21251":124347,"_5":14613,"_27884":124308,"_3010":124348},[],"Uso",{"_3554":73426,"_30673":73410,"_21251":124350,"_5":14613,"_27884":124308,"_3010":124351},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3554":73427,"_30673":73410,"_21251":124353,"_5":14613,"_27884":124308,"_3010":124354},[],"Revocación",{"_3554":73428,"_30673":73410,"_21251":124356,"_5":14613,"_27884":124308,"_3010":124357},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3554":73429,"_30673":73410,"_21251":124359,"_5":14613,"_27884":124308,"_3010":124360},[],"Autorización",{"_3554":73430,"_30673":73410,"_21251":124362,"_5":14613,"_27884":124308,"_3010":124363},[],"La aplicación permite la acción a esa identidad.",{"_3554":73431,"_30673":73410,"_21251":124365,"_5":14613,"_27884":124308,"_3010":124366},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3554":73432,"_30673":73410,"_21251":124368,"_5":14613,"_27884":124312,"_3010":124369},[],"Mecanismo",{"_3554":73433,"_30673":73410,"_21251":124371,"_5":14613,"_27884":124312,"_3010":124372},[],"Cuándo utilizarlo",{"_3554":73434,"_30673":73410,"_21251":124374,"_5":14613,"_27884":124312,"_3010":124375},[],"Qué debes mantener",{"_3554":73435,"_30673":73410,"_21251":124377,"_5":14613,"_27884":124312,"_3010":56439},[],{"_3554":73436,"_30673":73410,"_21251":124379,"_5":14613,"_27884":124312,"_3010":124380},[],"Consulta del estado de un certificado concreto.",{"_3554":73437,"_30673":73410,"_21251":124382,"_5":14613,"_27884":124312,"_3010":124383},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3554":73438,"_30673":73410,"_21251":124385,"_5":14613,"_27884":124312,"_3010":56448},[],{"_3554":73439,"_30673":73410,"_21251":124387,"_5":14613,"_27884":124312,"_3010":124388},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3554":73440,"_30673":73410,"_21251":124390,"_5":14613,"_27884":124312,"_3010":124391},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3554":73441,"_30673":73410,"_21251":124393,"_5":14613,"_27884":124312,"_3010":124394},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3554":73442,"_30673":73410,"_21251":124396,"_5":14613,"_27884":124312,"_3010":124397},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3554":73443,"_30673":73410,"_21251":124399,"_5":14613,"_27884":124316,"_3010":124400},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3554":73444,"_30673":73410,"_21251":124402,"_5":14613,"_27884":124316,"_3010":124403},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3554":73445,"_30673":73410,"_21251":124405,"_5":14613,"_27884":124316,"_3010":124406},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3554":73446,"_30673":73410,"_21251":124408,"_5":14613,"_27884":124316,"_3010":124409},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3554":73447,"_30673":73410,"_21251":124411,"_5":14613,"_27884":124316,"_3010":124412},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3554":73448,"_30673":73410,"_21251":124414,"_5":14613,"_27884":124316,"_3010":124415},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3554":73449,"_30673":73410,"_21251":124417,"_5":14613,"_27884":124316,"_3010":124418},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3554":73450,"_30673":73410,"_21251":124420,"_5":14613,"_27884":124316,"_3010":124421},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3554":73451,"_30673":73410,"_21251":124423,"_5":14613,"_27884":124316,"_3010":124424},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3554":73452,"_30673":73452,"_5":14965,"_3010":124426,"_31032":124427,"_21251":124428,"_27884":73452},"Certificados",[50083,119650,55721,123661],[],{"_3554":73453,"_30673":73452,"_21251":124430,"_5":14613,"_27884":73452,"_3010":124431},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3554":73454,"_30673":73452,"_5":31029,"_21251":124433,"_27884":124434,"_3010":124435},[],"/docs/pr-preview/pr-69/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3554":73455,"_30673":73452,"_5":31029,"_21251":124437,"_27884":124438,"_3010":124439},[],"/docs/pr-preview/pr-69/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3554":73456,"_30673":73452,"_5":31029,"_21251":124441,"_27884":124442,"_3010":124443},[],"/docs/pr-preview/pr-69/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3554":73457,"_30673":73452,"_5":31029,"_21251":124445,"_27884":124446,"_3010":124447},[],"/docs/pr-preview/pr-69/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3554":73458,"_30673":73452,"_5":31029,"_21251":124449,"_27884":124450,"_3010":124451},[],"/docs/pr-preview/pr-69/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3554":73459,"_30673":73452,"_5":31029,"_21251":124453,"_27884":124454,"_3010":124455},[],"/docs/pr-preview/pr-69/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3554":73460,"_30673":73452,"_5":31029,"_21251":124457,"_27884":124458,"_3010":124459},[],"/docs/pr-preview/pr-69/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3554":73461,"_30673":73452,"_5":31029,"_21251":124461,"_27884":124462,"_3010":124463},[],"/docs/pr-preview/pr-69/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3554":73462,"_30673":73452,"_5":31029,"_21251":124465,"_27884":124466,"_3010":124467},[],"/docs/pr-preview/pr-69/es/platform/pki/certificates#continúa","Continúa",{"_3554":73463,"_30673":73452,"_21251":124469,"_5":14613,"_27884":73452,"_3010":124470},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3554":73464,"_30673":73452,"_21251":124472,"_5":14613,"_27884":124434,"_3010":124473},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3554":73465,"_30673":73452,"_21251":124475,"_5":14613,"_27884":124434,"_3010":124476},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3554":73466,"_30673":73452,"_21251":124478,"_5":14613,"_27884":124434,"_3010":124479},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3554":73467,"_30673":73452,"_21251":124481,"_5":14613,"_27884":124434,"_3010":124482},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3554":73468,"_30673":73452,"_21251":124484,"_5":14613,"_27884":124434,"_3010":124485},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3554":73469,"_30673":73452,"_21251":124487,"_5":14613,"_27884":124434,"_3010":124488},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3554":73470,"_30673":73452,"_21251":124490,"_5":14613,"_27884":124434,"_3010":124491},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3554":73471,"_30673":73452,"_21251":124493,"_5":14613,"_27884":124438,"_3010":124494},[],"Descarga el PEM e inspecciónalo:",{"_3554":73472,"_30673":73452,"_21251":124496,"_5":14613,"_27884":124438,"_3010":124497},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3554":73473,"_30673":73452,"_21251":124499,"_5":14613,"_27884":124442,"_3010":124500},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3554":73474,"_30673":73452,"_21251":124502,"_5":14613,"_27884":124442,"_3010":124503},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3554":73475,"_30673":73452,"_21251":124505,"_5":14613,"_27884":124442,"_3010":124506},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3554":73476,"_30673":73452,"_21251":124508,"_5":14613,"_27884":124442,"_3010":124509},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3554":73477,"_30673":73452,"_21251":124511,"_5":14613,"_27884":124442,"_3010":124512},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3554":73478,"_30673":73452,"_21251":124514,"_5":14613,"_27884":124442,"_3010":124515},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3554":73479,"_30673":73452,"_21251":124517,"_5":14613,"_27884":124442,"_3010":124518},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3554":73480,"_30673":73452,"_21251":124520,"_5":14613,"_27884":124446,"_3010":124521},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3554":73481,"_30673":73452,"_21251":124523,"_5":14613,"_27884":124450,"_3010":124524},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3554":73482,"_30673":73452,"_21251":124526,"_5":14613,"_27884":124454,"_3010":124527},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3554":73483,"_30673":73452,"_21251":124529,"_5":14613,"_27884":124458,"_3010":124530},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3554":73484,"_30673":73452,"_21251":124532,"_5":14613,"_27884":124458,"_3010":124533},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3554":73485,"_30673":73452,"_21251":124535,"_5":14613,"_27884":124458,"_3010":124536},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3554":73486,"_30673":73452,"_21251":124538,"_5":14613,"_27884":124462,"_3010":124539},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3554":73487,"_30673":73452,"_21251":124541,"_5":14613,"_27884":124462,"_3010":124542},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3554":73488,"_30673":73452,"_21251":124544,"_5":14613,"_27884":124462,"_3010":124545},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3554":73489,"_30673":73452,"_21251":124547,"_5":14613,"_27884":124466,"_3010":124548},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3554":73490,"_30673":73452,"_21251":124550,"_5":14613,"_27884":124466,"_3010":124551},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3554":73491,"_30673":73491,"_5":14965,"_3010":124553,"_31032":124554,"_21251":124556,"_27884":73491},"Ciclo de vida de un certificado",[50083,119650,55721,124555],"Conceptos",[],{"_3554":73492,"_30673":73491,"_21251":124558,"_5":14613,"_27884":73491,"_3010":124559},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3554":73493,"_30673":73491,"_5":31029,"_21251":124561,"_27884":124562,"_3010":124563},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3554":73494,"_30673":73491,"_5":31029,"_21251":124565,"_27884":124566,"_3010":124567},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3554":73495,"_30673":73491,"_5":31029,"_21251":124569,"_27884":124570,"_3010":124571},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3554":73496,"_30673":73491,"_5":31029,"_21251":124573,"_27884":124574,"_3010":124575},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3554":73497,"_30673":73491,"_5":31029,"_21251":124577,"_27884":124578,"_3010":124579},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3554":73498,"_30673":73491,"_5":31029,"_21251":124581,"_27884":124582,"_3010":124583},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3554":73499,"_30673":73491,"_5":31029,"_21251":124585,"_27884":124586,"_3010":122284},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3554":73500,"_30673":73491,"_5":31029,"_21251":124588,"_27884":124589,"_3010":124590},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3554":73501,"_30673":73491,"_5":31029,"_21251":124592,"_27884":124593,"_3010":124594},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3554":73502,"_30673":73491,"_5":31029,"_21251":124596,"_27884":124597,"_3010":124598},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3554":73503,"_30673":73491,"_21251":124600,"_5":14613,"_27884":73491,"_3010":124601},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3554":73504,"_30673":73491,"_21251":124603,"_5":14613,"_27884":124566,"_3010":124604},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3554":73505,"_30673":73491,"_21251":124606,"_5":14613,"_27884":124570,"_3010":124607},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3554":73506,"_30673":73491,"_21251":124609,"_5":14613,"_27884":124574,"_3010":124610},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3554":73507,"_30673":73491,"_21251":124612,"_5":14613,"_27884":124578,"_3010":124613},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3554":73508,"_30673":73491,"_21251":124615,"_5":14613,"_27884":124582,"_3010":124616},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3554":73509,"_30673":73491,"_21251":124618,"_5":14613,"_27884":124586,"_3010":124619},[],"Lamassu persiste cuatro estados X.509:",{"_3554":73510,"_30673":73491,"_21251":124621,"_5":14613,"_27884":124586,"_3010":124622},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3554":73511,"_30673":73491,"_21251":124624,"_5":14613,"_27884":124586,"_3010":124625},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3554":73512,"_30673":73491,"_21251":124627,"_5":14613,"_27884":124586,"_3010":124628},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3554":73513,"_30673":73491,"_21251":124630,"_5":14613,"_27884":124586,"_3010":124631},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3554":73514,"_30673":73491,"_21251":124633,"_5":14613,"_27884":124586,"_3010":124634},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3554":73515,"_30673":73491,"_21251":124636,"_5":14613,"_27884":124589,"_3010":124637},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3554":73516,"_30673":73491,"_21251":124639,"_5":14613,"_27884":124589,"_3010":124640},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3554":73517,"_30673":73491,"_21251":124642,"_5":14613,"_27884":124589,"_3010":124643},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3554":73518,"_30673":73491,"_21251":124645,"_5":14613,"_27884":124593,"_3010":124646},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3554":73519,"_30673":73491,"_21251":124648,"_5":14613,"_27884":124593,"_3010":124649},[],"Antes de confirmar:",{"_3554":73520,"_30673":73491,"_21251":124651,"_5":14613,"_27884":124593,"_3010":124652},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3554":73521,"_30673":73491,"_21251":124654,"_5":14613,"_27884":124593,"_3010":124655},[],"Distribuye la nueva cadena de confianza.",{"_3554":73522,"_30673":73491,"_21251":124657,"_5":14613,"_27884":124593,"_3010":124658},[],"Reemite las identidades necesarias.",{"_3554":73523,"_30673":73491,"_21251":124660,"_5":14613,"_27884":124593,"_3010":124661},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3554":73524,"_30673":73491,"_21251":124663,"_5":14613,"_27884":124593,"_3010":124664},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3554":73525,"_30673":73491,"_21251":124666,"_5":14613,"_27884":124593,"_3010":124667},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3554":73526,"_30673":73491,"_21251":124669,"_5":14613,"_27884":124597,"_3010":124670},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3554":73527,"_30673":73491,"_21251":124672,"_5":14613,"_27884":124597,"_3010":124673},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3554":73528,"_30673":73491,"_21251":124675,"_5":14613,"_27884":124597,"_3010":124676},[],"Cambios de estado y razones de revocación.",{"_3554":73529,"_30673":73491,"_21251":124678,"_5":14613,"_27884":124597,"_3010":124679},[],"Publicación y vigencia de OCSP y CRLs.",{"_3554":73530,"_30673":73491,"_21251":124681,"_5":14613,"_27884":124597,"_3010":124682},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3554":73531,"_30673":73491,"_21251":124684,"_5":14613,"_27884":124597,"_3010":124685},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3554":73532,"_30673":73532,"_5":14965,"_3010":124687,"_31032":124688,"_21251":124689,"_27884":73532},"Modelo de confianza",[50083,119650,55721,124555],[],{"_3554":73533,"_30673":73532,"_21251":124691,"_5":14613,"_27884":73532,"_3010":124692},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3554":73534,"_30673":73532,"_5":31029,"_21251":124694,"_27884":124695,"_3010":124696},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3554":73535,"_30673":73532,"_5":31029,"_21251":124698,"_27884":124699,"_3010":124700},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3554":73536,"_30673":73532,"_5":31029,"_21251":124702,"_27884":124703,"_3010":124704},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3554":73537,"_30673":73532,"_5":31029,"_21251":124706,"_27884":124707,"_3010":124708},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3554":73538,"_30673":73532,"_5":31029,"_21251":124710,"_27884":124711,"_3010":124712},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3554":73539,"_30673":73532,"_5":31029,"_21251":124714,"_27884":124715,"_3010":124716},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3554":73540,"_30673":73532,"_5":31029,"_21251":124718,"_27884":124719,"_3010":124720},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3554":73541,"_30673":73532,"_5":31029,"_21251":124722,"_27884":124723,"_3010":124724},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3554":73542,"_30673":73532,"_5":31029,"_21251":124726,"_27884":124727,"_3010":124728},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3554":73543,"_30673":73532,"_5":31029,"_21251":124730,"_27884":124731,"_3010":124732},[],"/docs/pr-preview/pr-69/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3554":73544,"_30673":73532,"_21251":124734,"_5":14613,"_27884":73532,"_3010":124735},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3554":73545,"_30673":73532,"_21251":124737,"_5":14613,"_27884":124699,"_3010":124738},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3554":73546,"_30673":73532,"_21251":124740,"_5":14613,"_27884":124703,"_3010":124741},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3554":73547,"_30673":73532,"_21251":124743,"_5":14613,"_27884":124707,"_3010":124744},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3554":73548,"_30673":73532,"_21251":124746,"_5":14613,"_27884":124711,"_3010":124747},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3554":73549,"_30673":73532,"_21251":124749,"_5":14613,"_27884":124715,"_3010":124750},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3554":73550,"_30673":73532,"_21251":124752,"_5":14613,"_27884":124715,"_3010":124753},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3554":73551,"_30673":73532,"_21251":124755,"_5":14613,"_27884":124715,"_3010":124756},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3554":73552,"_30673":73532,"_21251":124758,"_5":14613,"_27884":124715,"_3010":124759},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3554":73553,"_30673":73532,"_21251":124761,"_5":14613,"_27884":124715,"_3010":124762},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3554":73554,"_30673":73532,"_21251":124764,"_5":14613,"_27884":124715,"_3010":124765},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3554":73555,"_30673":73532,"_21251":124767,"_5":14613,"_27884":124719,"_3010":124768},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3554":73556,"_30673":73532,"_21251":124770,"_5":14613,"_27884":124719,"_3010":124771},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3554":73557,"_30673":73532,"_21251":124773,"_5":14613,"_27884":124719,"_3010":124774},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3554":73558,"_30673":73532,"_21251":124776,"_5":14613,"_27884":124719,"_3010":124777},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3554":73559,"_30673":73532,"_21251":124779,"_5":14613,"_27884":124719,"_3010":124780},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3554":73560,"_30673":73532,"_21251":124782,"_5":14613,"_27884":124723,"_3010":124783},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3554":73561,"_30673":73532,"_21251":124785,"_5":14613,"_27884":124723,"_3010":124786},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3554":73562,"_30673":73532,"_21251":124788,"_5":14613,"_27884":124723,"_3010":124789},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3554":73563,"_30673":73532,"_21251":124791,"_5":14613,"_27884":124723,"_3010":124792},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3554":73564,"_30673":73532,"_21251":124794,"_5":14613,"_27884":124723,"_3010":124795},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3554":73565,"_30673":73532,"_21251":124797,"_5":14613,"_27884":124723,"_3010":124798},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3554":73566,"_30673":73532,"_21251":124800,"_5":14613,"_27884":124723,"_3010":124801},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3554":73567,"_30673":73532,"_21251":124803,"_5":14613,"_27884":124727,"_3010":124804},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3554":73568,"_30673":73532,"_21251":124806,"_5":14613,"_27884":124731,"_3010":124807},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3554":73569,"_30673":73532,"_21251":124809,"_5":14613,"_27884":124731,"_3010":124810},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3554":73570,"_30673":73532,"_21251":124812,"_5":14613,"_27884":124731,"_3010":124813},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3554":73571,"_30673":73532,"_21251":124815,"_5":14613,"_27884":124731,"_3010":124816},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3554":73572,"_30673":73532,"_21251":124818,"_5":14613,"_27884":124731,"_3010":124819},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3554":73573,"_30673":73532,"_21251":124821,"_5":14613,"_27884":124731,"_3010":124822},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3554":73574,"_30673":73532,"_21251":124824,"_5":14613,"_27884":124731,"_3010":124825},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3554":73575,"_30673":73575,"_5":14965,"_3010":124827,"_31032":124828,"_21251":124829,"_27884":73575},"Listas de revocación (CRL)",[50083,119650,55721,124301],[],{"_3554":73576,"_30673":73575,"_21251":124831,"_5":14613,"_27884":73575,"_3010":124832},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3554":73577,"_30673":73575,"_5":31029,"_21251":124834,"_27884":124835,"_3010":124836},[],"/docs/pr-preview/pr-69/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3554":73578,"_30673":73575,"_5":31029,"_21251":124838,"_27884":124839,"_3010":124840},[],"/docs/pr-preview/pr-69/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3554":73579,"_30673":73575,"_5":31029,"_21251":124842,"_27884":124843,"_3010":124844},[],"/docs/pr-preview/pr-69/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3554":73580,"_30673":73575,"_5":31029,"_21251":124846,"_27884":124847,"_3010":124848},[],"/docs/pr-preview/pr-69/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3554":73581,"_30673":73575,"_5":31029,"_21251":124850,"_27884":124851,"_3010":124852},[],"/docs/pr-preview/pr-69/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3554":73582,"_30673":73575,"_5":31029,"_21251":124854,"_27884":124855,"_3010":124856},[],"/docs/pr-preview/pr-69/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3554":73583,"_30673":73575,"_5":31029,"_21251":124858,"_27884":124859,"_3010":124860},[],"/docs/pr-preview/pr-69/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3554":73584,"_30673":73575,"_5":31029,"_21251":124862,"_27884":124863,"_3010":124864},[],"/docs/pr-preview/pr-69/es/platform/pki/crl#referencias","Referencias",{"_3554":73585,"_30673":73575,"_21251":124866,"_5":14613,"_27884":73575,"_3010":124867},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3554":73586,"_30673":73575,"_21251":124869,"_5":14613,"_27884":124835,"_3010":124870},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3554":73587,"_30673":73575,"_21251":124872,"_5":14613,"_27884":124835,"_3010":124873},[],"Campo",{"_3554":73588,"_30673":73575,"_21251":124875,"_5":14613,"_27884":124835,"_3010":121324},[],{"_3554":73589,"_30673":73575,"_21251":124877,"_5":14613,"_27884":124835,"_3010":51678},[],{"_3554":73590,"_30673":73575,"_21251":124879,"_5":14613,"_27884":124835,"_3010":124880},[],"ID de la CA a la que pertenecen los ajustes.",{"_3554":73591,"_30673":73575,"_21251":124882,"_5":14613,"_27884":124835,"_3010":56947},[],{"_3554":73592,"_30673":73575,"_21251":124884,"_5":14613,"_27884":124835,"_3010":124885},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3554":73593,"_30673":73575,"_21251":124887,"_5":14613,"_27884":124835,"_3010":56953},[],{"_3554":73594,"_30673":73575,"_21251":124889,"_5":14613,"_27884":124835,"_3010":124890},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3554":73595,"_30673":73575,"_21251":124892,"_5":14613,"_27884":124835,"_3010":56959},[],{"_3554":73596,"_30673":73575,"_21251":124894,"_5":14613,"_27884":124835,"_3010":124895},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3554":73597,"_30673":73575,"_21251":124897,"_5":14613,"_27884":124835,"_3010":124898},[],"Campo de `crl_options`",{"_3554":73598,"_30673":73575,"_21251":124900,"_5":14613,"_27884":124835,"_3010":121324},[],{"_3554":73599,"_30673":73575,"_21251":124902,"_5":14613,"_27884":124835,"_3010":124903},[],"Valor inicial",{"_3554":73600,"_30673":73575,"_21251":124905,"_5":14613,"_27884":124835,"_3010":56973},[],{"_3554":73601,"_30673":73575,"_21251":124907,"_5":14613,"_27884":124835,"_3010":124908},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3554":73602,"_30673":73575,"_21251":124910,"_5":14613,"_27884":124835,"_3010":124911},[],"7 días.",{"_3554":73603,"_30673":73575,"_21251":124913,"_5":14613,"_27884":124835,"_3010":56982},[],{"_3554":73604,"_30673":73575,"_21251":124915,"_5":14613,"_27884":124835,"_3010":124916},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3554":73605,"_30673":73575,"_21251":124918,"_5":14613,"_27884":124835,"_3010":124919},[],"6 días y 23 horas.",{"_3554":73606,"_30673":73575,"_21251":124921,"_5":14613,"_27884":124835,"_3010":56991},[],{"_3554":73607,"_30673":73575,"_21251":124923,"_5":14613,"_27884":124835,"_3010":124924},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3554":73608,"_30673":73575,"_21251":124926,"_5":14613,"_27884":124835,"_3010":56997},[],{"_3554":73609,"_30673":73575,"_21251":124928,"_5":14613,"_27884":124835,"_3010":57000},[],{"_3554":73610,"_30673":73575,"_21251":124930,"_5":14613,"_27884":124835,"_3010":124931},[],"Número de serie del certificado existente que firma la CRL.",{"_3554":73611,"_30673":73575,"_21251":124933,"_5":14613,"_27884":124835,"_3010":124934},[],"Número de serie del certificado actual de la CA.",{"_3554":73612,"_30673":73575,"_21251":124936,"_5":14613,"_27884":124835,"_3010":124937},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3554":73613,"_30673":73575,"_21251":124939,"_5":14613,"_27884":124835,"_3010":124940},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3554":73614,"_30673":73575,"_21251":124942,"_5":14613,"_27884":124835,"_3010":124943},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3554":73615,"_30673":73575,"_21251":124945,"_5":14613,"_27884":124835,"_3010":124946},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3554":73616,"_30673":73575,"_21251":124948,"_5":14613,"_27884":124835,"_3010":124949},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3554":73617,"_30673":73575,"_21251":124951,"_5":14613,"_27884":124835,"_3010":124952},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3554":73618,"_30673":73575,"_21251":124954,"_5":14613,"_27884":124835,"_3010":124955},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3554":73619,"_30673":73575,"_21251":124957,"_5":14613,"_27884":124835,"_3010":124958},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3554":73620,"_30673":73575,"_21251":124960,"_5":14613,"_27884":124835,"_3010":124961},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3554":73621,"_30673":73575,"_21251":124963,"_5":14613,"_27884":124835,"_3010":124964},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3554":73622,"_30673":73575,"_21251":124966,"_5":14613,"_27884":124835,"_3010":124967},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3554":73623,"_30673":73575,"_21251":124969,"_5":14613,"_27884":124839,"_3010":124970},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3554":73624,"_30673":73575,"_21251":124972,"_5":14613,"_27884":124839,"_3010":124973},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3554":73625,"_30673":73575,"_21251":124975,"_5":14613,"_27884":124839,"_3010":124976},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3554":73626,"_30673":73575,"_21251":124978,"_5":14613,"_27884":124839,"_3010":124979},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3554":73627,"_30673":73575,"_21251":124981,"_5":14613,"_27884":124843,"_3010":124982},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3554":73628,"_30673":73575,"_21251":124984,"_5":14613,"_27884":124843,"_3010":124985},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3554":73629,"_30673":73575,"_21251":124987,"_5":14613,"_27884":124843,"_3010":124988},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3554":73630,"_30673":73575,"_21251":124990,"_5":14613,"_27884":124843,"_3010":124991},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3554":73631,"_30673":73575,"_21251":124993,"_5":14613,"_27884":124843,"_3010":124994},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3554":73632,"_30673":73575,"_21251":124996,"_5":14613,"_27884":124843,"_3010":124997},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3554":73633,"_30673":73575,"_21251":124999,"_5":14613,"_27884":124843,"_3010":125000},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3554":73634,"_30673":73575,"_21251":125002,"_5":14613,"_27884":124843,"_3010":125003},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3554":73635,"_30673":73575,"_21251":125005,"_5":14613,"_27884":124843,"_3010":125006},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3554":73636,"_30673":73575,"_21251":125008,"_5":14613,"_27884":124847,"_3010":125009},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3554":73637,"_30673":73575,"_21251":125011,"_5":14613,"_27884":124847,"_3010":125012},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3554":73638,"_30673":73575,"_21251":125014,"_5":14613,"_27884":124851,"_3010":125015},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3554":73639,"_30673":73575,"_21251":125017,"_5":14613,"_27884":124851,"_3010":125018},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3554":73640,"_30673":73575,"_21251":125020,"_5":14613,"_27884":124851,"_3010":125021},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3554":73641,"_30673":73575,"_21251":125023,"_5":14613,"_27884":124851,"_3010":125024},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3554":73642,"_30673":73575,"_21251":125026,"_5":14613,"_27884":124851,"_3010":125027},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3554":73643,"_30673":73575,"_21251":125029,"_5":14613,"_27884":124855,"_3010":125030},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3554":73644,"_30673":73575,"_21251":125032,"_5":14613,"_27884":124855,"_3010":121513},[],{"_3554":73645,"_30673":73575,"_21251":125034,"_5":14613,"_27884":124855,"_3010":125035},[],"Path relativo",{"_3554":73646,"_30673":73575,"_21251":125037,"_5":14613,"_27884":124855,"_3010":119410},[],{"_3554":73647,"_30673":73575,"_21251":125039,"_5":14613,"_27884":124855,"_3010":57112},[],{"_3554":73648,"_30673":73575,"_21251":125041,"_5":14613,"_27884":124855,"_3010":57115},[],{"_3554":73649,"_30673":73575,"_21251":125043,"_5":14613,"_27884":124855,"_3010":125044},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3554":73650,"_30673":73575,"_21251":125046,"_5":14613,"_27884":124855,"_3010":57112},[],{"_3554":73651,"_30673":73575,"_21251":125048,"_5":14613,"_27884":124855,"_3010":57123},[],{"_3554":73652,"_30673":73575,"_21251":125050,"_5":14613,"_27884":124855,"_3010":125051},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3554":73653,"_30673":73575,"_21251":125053,"_5":14613,"_27884":124855,"_3010":57129},[],{"_3554":73654,"_30673":73575,"_21251":125055,"_5":14613,"_27884":124855,"_3010":57123},[],{"_3554":73655,"_30673":73575,"_21251":125057,"_5":14613,"_27884":124855,"_3010":125058},[],"Sustituir la configuración de CRL de una CA.",{"_3554":73656,"_30673":73575,"_21251":125060,"_5":14613,"_27884":124855,"_3010":57137},[],{"_3554":73657,"_30673":73575,"_21251":125062,"_5":14613,"_27884":124855,"_3010":57123},[],{"_3554":73658,"_30673":73575,"_21251":125064,"_5":14613,"_27884":124855,"_3010":125065},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3554":73659,"_30673":73575,"_21251":125067,"_5":14613,"_27884":124855,"_3010":125068},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3554":73660,"_30673":73575,"_21251":125070,"_5":14613,"_27884":124855,"_3010":125071},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3554":73661,"_30673":73575,"_21251":125073,"_5":14613,"_27884":124855,"_3010":125074},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3554":73662,"_30673":73575,"_21251":125076,"_5":14613,"_27884":124859,"_3010":125077},[],"Síntoma",{"_3554":73663,"_30673":73575,"_21251":125079,"_5":14613,"_27884":124859,"_3010":125080},[],"Causa",{"_3554":73664,"_30673":73575,"_21251":125082,"_5":14613,"_27884":124859,"_3010":125083},[],"Acción",{"_3554":73665,"_30673":73575,"_21251":125085,"_5":14613,"_27884":124859,"_3010":125086},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3554":73666,"_30673":73575,"_21251":125088,"_5":14613,"_27884":124859,"_3010":125089},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3554":73667,"_30673":73575,"_21251":125091,"_5":14613,"_27884":124859,"_3010":125092},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3554":73668,"_30673":73575,"_21251":125094,"_5":14613,"_27884":124859,"_3010":125095},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3554":73669,"_30673":73575,"_21251":125097,"_5":14613,"_27884":124859,"_3010":125098},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3554":73670,"_30673":73575,"_21251":125100,"_5":14613,"_27884":124859,"_3010":125101},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3554":73671,"_30673":73575,"_21251":125103,"_5":14613,"_27884":124859,"_3010":125104},[],"`PUT` devuelve 400.",{"_3554":73672,"_30673":73575,"_21251":125106,"_5":14613,"_27884":124859,"_3010":125107},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3554":73673,"_30673":73575,"_21251":125109,"_5":14613,"_27884":124859,"_3010":125110},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3554":73674,"_30673":73575,"_21251":125112,"_5":14613,"_27884":124859,"_3010":125113},[],"`PUT` devuelve 404.",{"_3554":73675,"_30673":73575,"_21251":125115,"_5":14613,"_27884":124859,"_3010":125116},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3554":73676,"_30673":73575,"_21251":125118,"_5":14613,"_27884":124859,"_3010":125119},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3554":73677,"_30673":73575,"_21251":125121,"_5":14613,"_27884":124859,"_3010":125122},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3554":73678,"_30673":73575,"_21251":125124,"_5":14613,"_27884":124859,"_3010":125125},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3554":73679,"_30673":73575,"_21251":125127,"_5":14613,"_27884":124859,"_3010":125128},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3554":73680,"_30673":73575,"_21251":125130,"_5":14613,"_27884":124859,"_3010":125131},[],"La CRL no cambia tras revocar un certificado.",{"_3554":73681,"_30673":73575,"_21251":125133,"_5":14613,"_27884":124859,"_3010":125134},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3554":73682,"_30673":73575,"_21251":125136,"_5":14613,"_27884":124859,"_3010":125137},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3554":73683,"_30673":73575,"_21251":125139,"_5":14613,"_27884":124859,"_3010":125140},[],"Un verificador rechaza la CRL por el emisor.",{"_3554":73684,"_30673":73575,"_21251":125142,"_5":14613,"_27884":124859,"_3010":125143},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3554":73685,"_30673":73575,"_21251":125145,"_5":14613,"_27884":124859,"_3010":125146},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3554":73686,"_30673":73575,"_21251":125148,"_5":14613,"_27884":124863,"_3010":125149},[],"RFC 5280: perfil X.509 y CRL.",{"_3554":73687,"_30673":73575,"_21251":125151,"_5":14613,"_27884":124863,"_3010":57229},[],{"_3554":73688,"_30673":73575,"_21251":125153,"_5":14613,"_27884":124863,"_3010":57232},[],{"_3554":73689,"_30673":73575,"_21251":125155,"_5":14613,"_27884":124863,"_3010":125156},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3554":73690,"_30673":73575,"_21251":125158,"_5":14613,"_27884":124863,"_3010":125159},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3554":73691,"_30673":73691,"_5":14965,"_3010":125161,"_31032":125162,"_21251":125163,"_27884":73691},"Claves y motores criptográficos",[50083,119650,55721,123661],[],{"_3554":73692,"_30673":73691,"_21251":125165,"_5":14613,"_27884":73691,"_3010":125166},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3554":73693,"_30673":73691,"_5":31029,"_21251":125168,"_27884":125169,"_3010":125170},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3554":73694,"_30673":73691,"_5":31029,"_21251":125172,"_27884":125173,"_3010":125174},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3554":73695,"_30673":73691,"_5":31029,"_21251":125176,"_27884":125177,"_3010":57257},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#file-system",{"_3554":73696,"_30673":73691,"_5":31029,"_21251":125179,"_27884":125180,"_3010":57261},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#hashicorp-vault",{"_3554":73697,"_30673":73691,"_5":31029,"_21251":125182,"_27884":125183,"_3010":57265},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#aws-secrets-manager",{"_3554":73698,"_30673":73691,"_5":31029,"_21251":125185,"_27884":125186,"_3010":57269},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#aws-kms",{"_3554":73699,"_30673":73691,"_5":31029,"_21251":125188,"_27884":125189,"_3010":57273},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#pkcs11",{"_3554":73700,"_30673":73691,"_5":31029,"_21251":125191,"_27884":125192,"_3010":57277},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#azure-key-vault",{"_3554":73701,"_30673":73691,"_5":31029,"_21251":125194,"_27884":125195,"_3010":125196},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3554":73702,"_30673":73691,"_5":31029,"_21251":125198,"_27884":125199,"_3010":125200},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3554":73703,"_30673":73691,"_5":31029,"_21251":125202,"_27884":125203,"_3010":125204},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3554":73704,"_30673":73691,"_5":31029,"_21251":125206,"_27884":125207,"_3010":125208},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3554":73705,"_30673":73691,"_5":31029,"_21251":125210,"_27884":125211,"_3010":125212},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3554":73706,"_30673":73691,"_5":31029,"_21251":125214,"_27884":125215,"_3010":125216},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3554":73707,"_30673":73691,"_5":31029,"_21251":125218,"_27884":125219,"_3010":125220},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3554":73708,"_30673":73691,"_5":31029,"_21251":125222,"_27884":125223,"_3010":57309},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#sign",{"_3554":73709,"_30673":73691,"_5":31029,"_21251":125225,"_27884":125226,"_3010":57313},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#verify",{"_3554":73710,"_30673":73691,"_5":31029,"_21251":125228,"_27884":125229,"_3010":125230},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3554":73711,"_30673":73691,"_5":31029,"_21251":125232,"_27884":125233,"_3010":125234},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3554":73712,"_30673":73691,"_5":31029,"_21251":125236,"_27884":125237,"_3010":125238},[],"/docs/pr-preview/pr-69/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3554":73713,"_30673":73691,"_21251":125240,"_5":14613,"_27884":73691,"_3010":125241},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3554":73714,"_30673":73691,"_21251":125243,"_5":14613,"_27884":73691,"_3010":125244},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3554":73715,"_30673":73691,"_21251":125246,"_5":14613,"_27884":125169,"_3010":125247},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3554":73716,"_30673":73691,"_21251":125249,"_5":14613,"_27884":125169,"_3010":125250},[],"En la práctica, permite:",{"_3554":73717,"_30673":73691,"_21251":125252,"_5":14613,"_27884":125169,"_3010":125253},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3554":73718,"_30673":73691,"_21251":125255,"_5":14613,"_27884":125169,"_3010":125256},[],"Importar claves creadas externamente.",{"_3554":73719,"_30673":73691,"_21251":125258,"_5":14613,"_27884":125169,"_3010":125259},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3554":73720,"_30673":73691,"_21251":125261,"_5":14613,"_27884":125169,"_3010":125262},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3554":73721,"_30673":73691,"_21251":125264,"_5":14613,"_27884":125173,"_3010":125265},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3554":73722,"_30673":73691,"_21251":125267,"_5":14613,"_27884":125173,"_3010":125268},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3554":73723,"_30673":73691,"_21251":125270,"_5":14613,"_27884":125173,"_3010":125271},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3554":73724,"_30673":73691,"_21251":125273,"_5":14613,"_27884":125177,"_3010":125274},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3554":73725,"_30673":73691,"_21251":125276,"_5":14613,"_27884":125180,"_3010":125277},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3554":73726,"_30673":73691,"_21251":125279,"_5":14613,"_27884":125180,"_3010":125280},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3554":73727,"_30673":73691,"_21251":125282,"_5":14613,"_27884":125183,"_3010":125283},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3554":73728,"_30673":73691,"_21251":125285,"_5":14613,"_27884":125186,"_3010":125286},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3554":73729,"_30673":73691,"_21251":125288,"_5":14613,"_27884":125189,"_3010":125289},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3554":73730,"_30673":73691,"_21251":125291,"_5":14613,"_27884":125192,"_3010":125292},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3554":73731,"_30673":73691,"_21251":125294,"_5":14613,"_27884":125192,"_3010":125295},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3554":73732,"_30673":73691,"_21251":125297,"_5":14613,"_27884":125192,"_3010":125298},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3554":73733,"_30673":73691,"_21251":125300,"_5":14613,"_27884":125192,"_3010":125301},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3554":73734,"_30673":73691,"_21251":125303,"_5":14613,"_27884":125195,"_3010":125304},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3554":73735,"_30673":73691,"_21251":125306,"_5":14613,"_27884":125195,"_3010":125307},[],"La tabla incluye los siguientes campos:",{"_3554":73736,"_30673":73691,"_21251":125309,"_5":14613,"_27884":125195,"_3010":125310},[],"**Name**: nombre descriptivo de la clave.",{"_3554":73737,"_30673":73691,"_21251":125312,"_5":14613,"_27884":125195,"_3010":125313},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3554":73738,"_30673":73691,"_21251":125315,"_5":14613,"_27884":125195,"_3010":125316},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3554":73739,"_30673":73691,"_21251":125318,"_5":14613,"_27884":125195,"_3010":125319},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3554":73740,"_30673":73691,"_21251":125321,"_5":14613,"_27884":125195,"_3010":125322},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3554":73741,"_30673":73691,"_21251":125324,"_5":14613,"_27884":125195,"_3010":125325},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3554":73742,"_30673":73691,"_21251":125327,"_5":14613,"_27884":125195,"_3010":125328},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3554":73743,"_30673":73691,"_21251":125330,"_5":14613,"_27884":125195,"_3010":125331},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3554":73744,"_30673":73691,"_21251":125333,"_5":14613,"_27884":125195,"_3010":125334},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3554":73745,"_30673":73691,"_21251":125336,"_5":14613,"_27884":125195,"_3010":125337},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3554":73746,"_30673":73691,"_21251":125339,"_5":14613,"_27884":125195,"_3010":125340},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3554":73747,"_30673":73691,"_21251":125342,"_5":14613,"_27884":125195,"_3010":125343},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3554":73748,"_30673":73691,"_21251":125345,"_5":14613,"_27884":125195,"_3010":125346},[],"**Delete Key** para eliminar la clave del sistema.",{"_3554":73749,"_30673":73691,"_21251":125348,"_5":14613,"_27884":125199,"_3010":125349},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3554":73750,"_30673":73691,"_21251":125351,"_5":14613,"_27884":125203,"_3010":125352},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3554":73751,"_30673":73691,"_21251":125354,"_5":14613,"_27884":125203,"_3010":125355},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3554":73752,"_30673":73691,"_21251":125357,"_5":14613,"_27884":125203,"_3010":125358},[],"**Key Name**: nombre único y descriptivo.",{"_3554":73753,"_30673":73691,"_21251":125360,"_5":14613,"_27884":125203,"_3010":125361},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3554":73754,"_30673":73691,"_21251":125363,"_5":14613,"_27884":125203,"_3010":125364},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3554":73755,"_30673":73691,"_21251":125366,"_5":14613,"_27884":125203,"_3010":125367},[],"**Tags**: metadatos para clasificar la clave.",{"_3554":73756,"_30673":73691,"_21251":125369,"_5":14613,"_27884":125203,"_3010":125370},[],"**Metadata**: información adicional para usos avanzados.",{"_3554":73757,"_30673":73691,"_21251":125372,"_5":14613,"_27884":125207,"_3010":125373},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3554":73758,"_30673":73691,"_21251":125375,"_5":14613,"_27884":125207,"_3010":125376},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3554":73759,"_30673":73691,"_21251":125378,"_5":14613,"_27884":125207,"_3010":125379},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3554":73760,"_30673":73691,"_21251":125381,"_5":14613,"_27884":125207,"_3010":125382},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3554":73761,"_30673":73691,"_21251":125384,"_5":14613,"_27884":125207,"_3010":125385},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3554":73762,"_30673":73691,"_21251":125387,"_5":14613,"_27884":125207,"_3010":125388},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3554":73763,"_30673":73691,"_21251":125390,"_5":14613,"_27884":125207,"_3010":125391},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3554":73764,"_30673":73691,"_21251":125393,"_5":14613,"_27884":125207,"_3010":125394},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3554":73765,"_30673":73691,"_21251":125396,"_5":14613,"_27884":125207,"_3010":125397},[],"**Metadata**: información adicional opcional.",{"_3554":73766,"_30673":73691,"_21251":125399,"_5":14613,"_27884":125207,"_3010":125400},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3554":73767,"_30673":73691,"_21251":125402,"_5":14613,"_27884":125207,"_3010":125403},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3554":73768,"_30673":73691,"_21251":125405,"_5":14613,"_27884":125211,"_3010":125406},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3554":73769,"_30673":73691,"_21251":125408,"_5":14613,"_27884":125215,"_3010":125409},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3554":73770,"_30673":73691,"_21251":125411,"_5":14613,"_27884":125215,"_3010":125412},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3554":73771,"_30673":73691,"_21251":125414,"_5":14613,"_27884":125215,"_3010":125415},[],"**Key Name**: nombre descriptivo.",{"_3554":73772,"_30673":73691,"_21251":125417,"_5":14613,"_27884":125215,"_3010":125418},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3554":73773,"_30673":73691,"_21251":125420,"_5":14613,"_27884":125215,"_3010":125421},[],"**Tags**: etiquetas asociadas.",{"_3554":73774,"_30673":73691,"_21251":125423,"_5":14613,"_27884":125215,"_3010":125424},[],"**Aliases**: nombres alternativos.",{"_3554":73775,"_30673":73691,"_21251":125426,"_5":14613,"_27884":125215,"_3010":125427},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3554":73776,"_30673":73691,"_21251":125429,"_5":14613,"_27884":125215,"_3010":125430},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3554":73777,"_30673":73691,"_21251":125432,"_5":14613,"_27884":125215,"_3010":125433},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3554":73778,"_30673":73691,"_21251":125435,"_5":14613,"_27884":125215,"_3010":125436},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3554":73779,"_30673":73691,"_21251":125438,"_5":14613,"_27884":125219,"_3010":125439},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3554":73780,"_30673":73691,"_21251":125441,"_5":14613,"_27884":125219,"_3010":125442},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3554":73781,"_30673":73691,"_21251":125444,"_5":14613,"_27884":125219,"_3010":125445},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3554":73782,"_30673":73691,"_21251":125447,"_5":14613,"_27884":125223,"_3010":125448},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3554":73783,"_30673":73691,"_21251":125450,"_5":14613,"_27884":125223,"_3010":125451},[],"Campos principales:",{"_3554":73784,"_30673":73691,"_21251":125453,"_5":14613,"_27884":125223,"_3010":125454},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3554":73785,"_30673":73691,"_21251":125456,"_5":14613,"_27884":125223,"_3010":125457},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3554":73786,"_30673":73691,"_21251":125459,"_5":14613,"_27884":125223,"_3010":125460},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3554":73787,"_30673":73691,"_21251":125462,"_5":14613,"_27884":125223,"_3010":125463},[],"**Message**: contenido que se va a firmar.",{"_3554":73788,"_30673":73691,"_21251":125465,"_5":14613,"_27884":125223,"_3010":125466},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3554":73789,"_30673":73691,"_21251":125468,"_5":14613,"_27884":125226,"_3010":125469},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3554":73790,"_30673":73691,"_21251":125471,"_5":14613,"_27884":125226,"_3010":125451},[],{"_3554":73791,"_30673":73691,"_21251":125473,"_5":14613,"_27884":125226,"_3010":125474},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3554":73792,"_30673":73691,"_21251":125476,"_5":14613,"_27884":125226,"_3010":125477},[],"**Message Type**: `Raw` o `Digest`.",{"_3554":73793,"_30673":73691,"_21251":125479,"_5":14613,"_27884":125226,"_3010":125480},[],"**Payload Encoding**: codificación del mensaje.",{"_3554":73794,"_30673":73691,"_21251":125482,"_5":14613,"_27884":125226,"_3010":125483},[],"**Message**: mensaje original o hash.",{"_3554":73795,"_30673":73691,"_21251":125485,"_5":14613,"_27884":125226,"_3010":125486},[],"**Signature**: firma que se desea comprobar.",{"_3554":73796,"_30673":73691,"_21251":125488,"_5":14613,"_27884":125226,"_3010":125489},[],"**Result**: indicador del resultado de la validación.",{"_3554":73797,"_30673":73691,"_21251":125491,"_5":14613,"_27884":125229,"_3010":125492},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3554":73798,"_30673":73691,"_21251":125494,"_5":14613,"_27884":125229,"_3010":125495},[],"Este flujo es útil para:",{"_3554":73799,"_30673":73691,"_21251":125497,"_5":14613,"_27884":125229,"_3010":125498},[],"Solicitar certificados a una CA externa.",{"_3554":73800,"_30673":73691,"_21251":125500,"_5":14613,"_27884":125229,"_3010":125501},[],"Renovar una identidad manteniendo la misma clave.",{"_3554":73801,"_30673":73691,"_21251":125503,"_5":14613,"_27884":125229,"_3010":125504},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3554":73802,"_30673":73691,"_21251":125506,"_5":14613,"_27884":125229,"_3010":125507},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3554":73803,"_30673":73691,"_21251":125509,"_5":14613,"_27884":125229,"_3010":125510},[],"**Organization (O)**: organización o empresa.",{"_3554":73804,"_30673":73691,"_21251":125512,"_5":14613,"_27884":125229,"_3010":125513},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3554":73805,"_30673":73691,"_21251":125515,"_5":14613,"_27884":125229,"_3010":125516},[],"**Country (C)**: código de país de dos letras.",{"_3554":73806,"_30673":73691,"_21251":125518,"_5":14613,"_27884":125229,"_3010":125519},[],"**State / Province (ST)**: estado o provincia.",{"_3554":73807,"_30673":73691,"_21251":125521,"_5":14613,"_27884":125229,"_3010":125522},[],"**Locality (L)**: ciudad o localidad.",{"_3554":73808,"_30673":73691,"_21251":125524,"_5":14613,"_27884":125229,"_3010":125525},[],"**Email Address**: correo de contacto.",{"_3554":73809,"_30673":73691,"_21251":125527,"_5":14613,"_27884":125229,"_3010":125528},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3554":73810,"_30673":73691,"_21251":125530,"_5":14613,"_27884":125229,"_3010":125531},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3554":73811,"_30673":73691,"_21251":125533,"_5":14613,"_27884":125233,"_3010":125534},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3554":73812,"_30673":73691,"_21251":125536,"_5":14613,"_27884":125233,"_3010":125537},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3554":73813,"_30673":73691,"_21251":125539,"_5":14613,"_27884":125237,"_3010":125540},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3554":73814,"_30673":73691,"_21251":125542,"_5":14613,"_27884":125237,"_3010":125543},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3554":73815,"_30673":73815,"_5":14965,"_3010":125545,"_31032":125546,"_21251":125547,"_27884":73815},"Validación online con OCSP",[50083,119650,55721,124301],[],{"_3554":73816,"_30673":73815,"_21251":125549,"_5":14613,"_27884":73815,"_3010":125550},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3554":73817,"_30673":73815,"_5":31029,"_21251":125552,"_27884":125553,"_3010":125554},[],"/docs/pr-preview/pr-69/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3554":73818,"_30673":73815,"_5":31029,"_21251":125556,"_27884":125557,"_3010":125558},[],"/docs/pr-preview/pr-69/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3554":73819,"_30673":73815,"_5":31029,"_21251":125560,"_27884":125561,"_3010":125562},[],"/docs/pr-preview/pr-69/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3554":73820,"_30673":73815,"_5":31029,"_21251":125564,"_27884":125565,"_3010":125566},[],"/docs/pr-preview/pr-69/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3554":73821,"_30673":73815,"_5":31029,"_21251":125568,"_27884":125569,"_3010":125570},[],"/docs/pr-preview/pr-69/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3554":73822,"_30673":73815,"_5":31029,"_21251":125572,"_27884":125573,"_3010":124864},[],"/docs/pr-preview/pr-69/es/platform/pki/ocsp#referencias",{"_3554":73823,"_30673":73815,"_21251":125575,"_5":14613,"_27884":73815,"_3010":125576},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3554":73824,"_30673":73815,"_21251":125578,"_5":14613,"_27884":125553,"_3010":125579},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3554":73825,"_30673":73815,"_21251":125581,"_5":14613,"_27884":125553,"_3010":125582},[],"Estado del registro",{"_3554":73826,"_30673":73815,"_21251":125584,"_5":14613,"_27884":125553,"_3010":125585},[],"Respuesta firmada",{"_3554":73827,"_30673":73815,"_21251":125587,"_5":14613,"_27884":125553,"_3010":54858},[],{"_3554":73828,"_30673":73815,"_21251":125589,"_5":14613,"_27884":125553,"_3010":57677},[],{"_3554":73829,"_30673":73815,"_21251":125591,"_5":14613,"_27884":125553,"_3010":54875},[],{"_3554":73830,"_30673":73815,"_21251":125593,"_5":14613,"_27884":125553,"_3010":125594},[],"`Revoked`, con razón y fecha de revocación.",{"_3554":73831,"_30673":73815,"_21251":125596,"_5":14613,"_27884":125553,"_3010":125597},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3554":73832,"_30673":73815,"_21251":125599,"_5":14613,"_27884":125553,"_3010":125600},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3554":73833,"_30673":73815,"_21251":125602,"_5":14613,"_27884":125553,"_3010":125603},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3554":73834,"_30673":73815,"_21251":125605,"_5":14613,"_27884":125553,"_3010":125606},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3554":73835,"_30673":73815,"_21251":125608,"_5":14613,"_27884":125553,"_3010":125609},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3554":73836,"_30673":73815,"_21251":125611,"_5":14613,"_27884":125557,"_3010":125612},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3554":73837,"_30673":73815,"_21251":125614,"_5":14613,"_27884":125557,"_3010":125615},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3554":73838,"_30673":73815,"_21251":125617,"_5":14613,"_27884":125561,"_3010":125618},[],"El servicio acepta:",{"_3554":73839,"_30673":73815,"_21251":125620,"_5":14613,"_27884":125561,"_3010":121513},[],{"_3554":73840,"_30673":73815,"_21251":125622,"_5":14613,"_27884":125561,"_3010":125623},[],"Ruta del servicio VA",{"_3554":73841,"_30673":73815,"_21251":125625,"_5":14613,"_27884":125561,"_3010":125626},[],"Formato",{"_3554":73842,"_30673":73815,"_21251":125628,"_5":14613,"_27884":125561,"_3010":57717},[],{"_3554":73843,"_30673":73815,"_21251":125630,"_5":14613,"_27884":125561,"_3010":57720},[],{"_3554":73844,"_30673":73815,"_21251":125632,"_5":14613,"_27884":125561,"_3010":125633},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3554":73845,"_30673":73815,"_21251":125635,"_5":14613,"_27884":125561,"_3010":57112},[],{"_3554":73846,"_30673":73815,"_21251":125637,"_5":14613,"_27884":125561,"_3010":57728},[],{"_3554":73847,"_30673":73815,"_21251":125639,"_5":14613,"_27884":125561,"_3010":125640},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3554":73848,"_30673":73815,"_21251":125642,"_5":14613,"_27884":125561,"_3010":125643},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3554":73849,"_30673":73815,"_21251":125645,"_5":14613,"_27884":125565,"_3010":125646},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3554":73850,"_30673":73815,"_21251":125648,"_5":14613,"_27884":125565,"_3010":125649},[],"Genera la solicitud:",{"_3554":73851,"_30673":73815,"_21251":125651,"_5":14613,"_27884":125565,"_3010":125652},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3554":73852,"_30673":73815,"_21251":125654,"_5":14613,"_27884":125565,"_3010":125655},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3554":73853,"_30673":73815,"_21251":125657,"_5":14613,"_27884":125565,"_3010":125658},[],"Verifica el DER recibido:",{"_3554":73854,"_30673":73815,"_21251":125660,"_5":14613,"_27884":125565,"_3010":125661},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3554":73855,"_30673":73815,"_21251":125663,"_5":14613,"_27884":125569,"_3010":125664},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3554":73856,"_30673":73815,"_21251":125666,"_5":14613,"_27884":125569,"_3010":125667},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3554":73857,"_30673":73815,"_21251":125669,"_5":14613,"_27884":125573,"_3010":57761},[],{"_3554":73858,"_30673":73815,"_21251":125671,"_5":14613,"_27884":125573,"_3010":57764},[],{"_3554":73859,"_30673":73815,"_21251":125673,"_5":14613,"_27884":125573,"_3010":125674},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3554":73860,"_30673":73815,"_21251":125676,"_5":14613,"_27884":125573,"_3010":125159},[],{"_3554":73861,"_30673":73861,"_5":14965,"_3010":55721,"_31032":125678,"_21251":125679,"_27884":73861},[50083,119650,55721],[],{"_3554":73862,"_30673":73861,"_21251":125681,"_5":14613,"_27884":73861,"_3010":125682},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3554":73863,"_30673":73861,"_5":31029,"_21251":125684,"_27884":125685,"_3010":122987},[],"/docs/pr-preview/pr-69/es/platform/pki/overview#empieza-aquí",{"_3554":73864,"_30673":73861,"_5":31029,"_21251":125687,"_27884":125688,"_3010":125689},[],"/docs/pr-preview/pr-69/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3554":73865,"_30673":73861,"_5":31029,"_21251":125691,"_27884":125692,"_3010":123507},[],"/docs/pr-preview/pr-69/es/platform/pki/overview#capacidades-principales",{"_3554":73866,"_30673":73861,"_5":31029,"_21251":125694,"_27884":125695,"_3010":123511},[],"/docs/pr-preview/pr-69/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3554":73867,"_30673":73861,"_5":31029,"_21251":125697,"_27884":125698,"_3010":123515},[],"/docs/pr-preview/pr-69/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3554":73868,"_30673":73861,"_5":31029,"_21251":125700,"_27884":125701,"_3010":123519},[],"/docs/pr-preview/pr-69/es/platform/pki/overview#emite-y-controla-certificados",{"_3554":73869,"_30673":73861,"_5":31029,"_21251":125703,"_27884":125704,"_3010":123527},[],"/docs/pr-preview/pr-69/es/platform/pki/overview#publica-el-estado-de-validación",{"_3554":73870,"_30673":73861,"_5":31029,"_21251":125706,"_27884":125707,"_3010":125708},[],"/docs/pr-preview/pr-69/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3554":73871,"_30673":73861,"_5":31029,"_21251":125710,"_27884":125711,"_3010":124467},[],"/docs/pr-preview/pr-69/es/platform/pki/overview#continúa",{"_3554":73872,"_30673":73861,"_21251":125713,"_5":14613,"_27884":73861,"_3010":125714},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3554":73873,"_30673":73861,"_21251":125716,"_5":14613,"_27884":125685,"_3010":125717},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3554":73874,"_30673":73861,"_21251":125719,"_5":14613,"_27884":125685,"_3010":125720},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3554":73875,"_30673":73861,"_21251":125722,"_5":14613,"_27884":125688,"_3010":125723},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3554":73876,"_30673":73861,"_21251":125725,"_5":14613,"_27884":125688,"_3010":125726},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3554":73877,"_30673":73861,"_21251":125728,"_5":14613,"_27884":125688,"_3010":125729},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3554":73878,"_30673":73861,"_21251":125731,"_5":14613,"_27884":125688,"_3010":125732},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3554":73879,"_30673":73861,"_21251":125734,"_5":14613,"_27884":125688,"_3010":125735},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3554":73880,"_30673":73861,"_21251":125737,"_5":14613,"_27884":125695,"_3010":125738},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3554":73881,"_30673":73861,"_21251":125740,"_5":14613,"_27884":125698,"_3010":125741},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3554":73882,"_30673":73861,"_21251":125743,"_5":14613,"_27884":125701,"_3010":125744},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3554":73883,"_30673":73861,"_21251":125746,"_5":14613,"_27884":125704,"_3010":125747},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3554":73884,"_30673":73861,"_21251":125749,"_5":14613,"_27884":125707,"_3010":125750},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3554":73885,"_30673":73861,"_21251":125752,"_5":14613,"_27884":125707,"_3010":125753},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3554":73886,"_30673":73861,"_21251":125755,"_5":14613,"_27884":125707,"_3010":125756},[],"su clave pública corresponda a la clave privada del cliente;",{"_3554":73887,"_30673":73861,"_21251":125758,"_5":14613,"_27884":125707,"_3010":125759},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3554":73888,"_30673":73861,"_21251":125761,"_5":14613,"_27884":125707,"_3010":125762},[],"sus fechas y usos permitan la operación;",{"_3554":73889,"_30673":73861,"_21251":125764,"_5":14613,"_27884":125707,"_3010":125765},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3554":73890,"_30673":73861,"_21251":125767,"_5":14613,"_27884":125707,"_3010":125768},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3554":73891,"_30673":73861,"_21251":125770,"_5":14613,"_27884":125711,"_3010":125771},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3554":73892,"_30673":73861,"_21251":125773,"_5":14613,"_27884":125711,"_3010":125774},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3554":73893,"_30673":73861,"_21251":125776,"_5":14613,"_27884":125711,"_3010":125777},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3554":73894,"_30673":73894,"_5":14965,"_3010":125779,"_31032":125780,"_21251":125781,"_27884":73894},"Crea tu primera CA",[50083,119650,55721,123111],[],{"_3554":73895,"_30673":73894,"_21251":125783,"_5":14613,"_27884":73894,"_3010":125784},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3554":73896,"_30673":73894,"_5":31029,"_21251":125786,"_27884":125787,"_3010":118221},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3554":73897,"_30673":73894,"_5":31029,"_21251":125789,"_27884":125790,"_3010":125791},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3554":73898,"_30673":73894,"_5":31029,"_21251":125793,"_27884":125794,"_3010":125795},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3554":73899,"_30673":73894,"_5":31029,"_21251":125797,"_27884":125798,"_3010":125799},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3554":73900,"_30673":73894,"_5":31029,"_21251":125801,"_27884":125802,"_3010":125803},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3554":73901,"_30673":73894,"_5":31029,"_21251":125805,"_27884":125806,"_3010":125807},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3554":73902,"_30673":73894,"_5":31029,"_21251":125809,"_27884":125810,"_3010":125811},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3554":73903,"_30673":73894,"_5":31029,"_21251":125813,"_27884":125814,"_3010":123358},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3554":73904,"_30673":73894,"_5":31029,"_21251":125816,"_27884":125817,"_3010":118245},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3554":73905,"_30673":73894,"_21251":125819,"_5":14613,"_27884":73894,"_3010":125820},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3554":73906,"_30673":73894,"_21251":125822,"_5":14613,"_27884":125787,"_3010":125823},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3554":73907,"_30673":73894,"_21251":125825,"_5":14613,"_27884":125787,"_3010":125826},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3554":73908,"_30673":73894,"_21251":125828,"_5":14613,"_27884":125787,"_3010":125829},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3554":73909,"_30673":73894,"_21251":125831,"_5":14613,"_27884":125787,"_3010":125832},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3554":73910,"_30673":73894,"_21251":125834,"_5":14613,"_27884":125790,"_3010":125835},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3554":73911,"_30673":73894,"_21251":125837,"_5":14613,"_27884":125790,"_3010":125838},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3554":73912,"_30673":73894,"_21251":125840,"_5":14613,"_27884":125794,"_3010":125841},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3554":73913,"_30673":73894,"_21251":125843,"_5":14613,"_27884":125794,"_3010":125844},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3554":73914,"_30673":73894,"_21251":125846,"_5":14613,"_27884":125798,"_3010":125847},[],"Selecciona **Root CA** y completa:",{"_3554":73915,"_30673":73894,"_21251":125849,"_5":14613,"_27884":125798,"_3010":57943},[],{"_3554":73916,"_30673":73894,"_21251":125851,"_5":14613,"_27884":125798,"_3010":125852},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3554":73917,"_30673":73894,"_21251":125854,"_5":14613,"_27884":125798,"_3010":125855},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3554":73918,"_30673":73894,"_21251":125857,"_5":14613,"_27884":125798,"_3010":125858},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3554":73919,"_30673":73894,"_21251":125860,"_5":14613,"_27884":125798,"_3010":125861},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3554":73920,"_30673":73894,"_21251":125863,"_5":14613,"_27884":125802,"_3010":125864},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3554":73921,"_30673":73894,"_21251":125866,"_5":14613,"_27884":125806,"_3010":125867},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3554":73922,"_30673":73894,"_21251":125869,"_5":14613,"_27884":125806,"_3010":125870},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3554":73923,"_30673":73894,"_21251":125872,"_5":14613,"_27884":125810,"_3010":125873},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3554":73924,"_30673":73894,"_21251":125875,"_5":14613,"_27884":125810,"_3010":125876},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3554":73925,"_30673":73894,"_21251":125878,"_5":14613,"_27884":125810,"_3010":125879},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3554":73926,"_30673":73894,"_21251":125881,"_5":14613,"_27884":125814,"_3010":125882},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3554":73927,"_30673":73894,"_21251":125884,"_5":14613,"_27884":125814,"_3010":125885},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3554":73928,"_30673":73894,"_21251":125887,"_5":14613,"_27884":125814,"_3010":125888},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3554":73929,"_30673":73894,"_21251":125890,"_5":14613,"_27884":125814,"_3010":125891},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3554":73930,"_30673":73894,"_21251":125893,"_5":14613,"_27884":125817,"_3010":125894},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3554":73931,"_30673":73931,"_5":14965,"_3010":125896,"_31032":125897,"_21251":125898,"_27884":73931},"Emite y verifica un certificado",[50083,119650,55721,123111],[],{"_3554":73932,"_30673":73931,"_21251":125900,"_5":14613,"_27884":73931,"_3010":125901},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3554":73933,"_30673":73931,"_5":31029,"_21251":125903,"_27884":125904,"_3010":118221},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3554":73934,"_30673":73931,"_5":31029,"_21251":125906,"_27884":125907,"_3010":125908},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3554":73935,"_30673":73931,"_5":31029,"_21251":125910,"_27884":125911,"_3010":125912},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3554":73936,"_30673":73931,"_5":31029,"_21251":125914,"_27884":125915,"_3010":125916},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3554":73937,"_30673":73931,"_5":31029,"_21251":125918,"_27884":125919,"_3010":125920},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3554":73938,"_30673":73931,"_5":31029,"_21251":125922,"_27884":125923,"_3010":125924},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3554":73939,"_30673":73931,"_5":31029,"_21251":125926,"_27884":125927,"_3010":125928},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3554":73940,"_30673":73931,"_5":31029,"_21251":125930,"_27884":125931,"_3010":125932},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3554":73941,"_30673":73931,"_5":31029,"_21251":125934,"_27884":125935,"_3010":125936},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3554":73942,"_30673":73931,"_5":31029,"_21251":125938,"_27884":125939,"_3010":125940},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3554":73943,"_30673":73931,"_5":31029,"_21251":125942,"_27884":125943,"_3010":123358},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3554":73944,"_30673":73931,"_5":31029,"_21251":125945,"_27884":125946,"_3010":118245},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3554":73945,"_30673":73931,"_21251":125948,"_5":14613,"_27884":73931,"_3010":125949},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3554":73946,"_30673":73931,"_21251":125951,"_5":14613,"_27884":125904,"_3010":125952},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3554":73947,"_30673":73931,"_21251":125954,"_5":14613,"_27884":125904,"_3010":125955},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3554":73948,"_30673":73931,"_21251":125957,"_5":14613,"_27884":125904,"_3010":125958},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3554":73949,"_30673":73931,"_21251":125960,"_5":14613,"_27884":125904,"_3010":125961},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3554":73950,"_30673":73931,"_21251":125963,"_5":14613,"_27884":125904,"_3010":125964},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3554":73951,"_30673":73931,"_21251":125966,"_5":14613,"_27884":125907,"_3010":125967},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3554":73952,"_30673":73931,"_21251":125969,"_5":14613,"_27884":125911,"_3010":125970},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3554":73953,"_30673":73931,"_21251":125972,"_5":14613,"_27884":125911,"_3010":125973},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3554":73954,"_30673":73931,"_21251":125975,"_5":14613,"_27884":125915,"_3010":125976},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3554":73955,"_30673":73931,"_21251":125978,"_5":14613,"_27884":125915,"_3010":125979},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3554":73956,"_30673":73931,"_21251":125981,"_5":14613,"_27884":125919,"_3010":125982},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3554":73957,"_30673":73931,"_21251":125984,"_5":14613,"_27884":125919,"_3010":125985},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3554":73958,"_30673":73931,"_21251":125987,"_5":14613,"_27884":125923,"_3010":125988},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3554":73959,"_30673":73931,"_21251":125990,"_5":14613,"_27884":125927,"_3010":125991},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3554":73960,"_30673":73931,"_21251":125993,"_5":14613,"_27884":125931,"_3010":125994},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3554":73961,"_30673":73931,"_21251":125996,"_5":14613,"_27884":125935,"_3010":125997},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3554":73962,"_30673":73931,"_21251":125999,"_5":14613,"_27884":125935,"_3010":126000},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3554":73963,"_30673":73931,"_21251":126002,"_5":14613,"_27884":125935,"_3010":126003},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3554":73964,"_30673":73931,"_21251":126005,"_5":14613,"_27884":125939,"_3010":126006},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3554":73965,"_30673":73931,"_21251":126008,"_5":14613,"_27884":125939,"_3010":126009},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3554":73966,"_30673":73931,"_21251":126011,"_5":14613,"_27884":125939,"_3010":126012},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3554":73967,"_30673":73931,"_21251":126014,"_5":14613,"_27884":125943,"_3010":123441},[],{"_3554":73968,"_30673":73931,"_21251":126016,"_5":14613,"_27884":125943,"_3010":121962},[],{"_3554":73969,"_30673":73931,"_21251":126018,"_5":14613,"_27884":125943,"_3010":126019},[],"La CA rechaza la emisión",{"_3554":73970,"_30673":73931,"_21251":126021,"_5":14613,"_27884":125943,"_3010":126022},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3554":73971,"_30673":73931,"_21251":126024,"_5":14613,"_27884":125943,"_3010":126025},[],"Sujeto o usos diferentes",{"_3554":73972,"_30673":73931,"_21251":126027,"_5":14613,"_27884":125943,"_3010":126028},[],"Perfil aplicado y valores solicitados.",{"_3554":73973,"_30673":73931,"_21251":126030,"_5":14613,"_27884":125943,"_3010":126031},[],"No se encuentra el emisor",{"_3554":73974,"_30673":73931,"_21251":126033,"_5":14613,"_27884":125943,"_3010":126034},[],"CA descargada y cadena intermedia necesaria.",{"_3554":73975,"_30673":73931,"_21251":126036,"_5":14613,"_27884":125943,"_3010":126037},[],"Falla la vigencia",{"_3554":73976,"_30673":73931,"_21251":126039,"_5":14613,"_27884":125943,"_3010":126040},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3554":73977,"_30673":73931,"_21251":126042,"_5":14613,"_27884":125943,"_3010":126043},[],"Los resúmenes de clave difieren",{"_3554":73978,"_30673":73931,"_21251":126045,"_5":14613,"_27884":125943,"_3010":126046},[],"Archivos de certificado y clave de la misma emisión.",{"_3554":73979,"_30673":73931,"_21251":126048,"_5":14613,"_27884":125943,"_3010":126049},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3554":73980,"_30673":73931,"_21251":126051,"_5":14613,"_27884":125946,"_3010":126052},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3554":73981,"_30673":73931,"_21251":126054,"_5":14613,"_27884":125946,"_3010":126055},[],"Gestionar certificados para inspección, estado y revocación.",{"_3554":73982,"_30673":73931,"_21251":126057,"_5":14613,"_27884":125946,"_3010":126058},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3554":73983,"_30673":73931,"_21251":126060,"_5":14613,"_27884":125946,"_3010":126061},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3554":73984,"_30673":73931,"_21251":126063,"_5":14613,"_27884":125946,"_3010":126064},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3554":73985,"_30673":73985,"_5":14965,"_3010":126066,"_31032":126067,"_21251":126068,"_27884":73985},"Primeros pasos de PKI",[50083,119650,55721,123111],[],{"_3554":73986,"_30673":73985,"_21251":126070,"_5":14613,"_27884":73985,"_3010":126071},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3554":73987,"_30673":73985,"_5":31029,"_21251":126073,"_27884":126074,"_3010":118221},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3554":73988,"_30673":73985,"_5":31029,"_21251":126076,"_27884":126077,"_3010":126078},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3554":73989,"_30673":73985,"_5":31029,"_21251":126080,"_27884":126081,"_3010":123293},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3554":73990,"_30673":73985,"_5":31029,"_21251":126083,"_27884":126084,"_3010":126085},[],"/docs/pr-preview/pr-69/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3554":73991,"_30673":73985,"_21251":126087,"_5":14613,"_27884":73985,"_3010":126088},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3554":73992,"_30673":73985,"_21251":126090,"_5":14613,"_27884":126074,"_3010":126091},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3554":73993,"_30673":73985,"_21251":126093,"_5":14613,"_27884":126074,"_3010":126094},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3554":73994,"_30673":73985,"_21251":126096,"_5":14613,"_27884":126074,"_3010":126097},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3554":73995,"_30673":73985,"_21251":126099,"_5":14613,"_27884":126074,"_3010":126100},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3554":73996,"_30673":73985,"_21251":126102,"_5":14613,"_27884":126074,"_3010":126103},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3554":73997,"_30673":73985,"_21251":126105,"_5":14613,"_27884":126077,"_3010":126106},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3554":73998,"_30673":73985,"_21251":126108,"_5":14613,"_27884":126077,"_3010":126109},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3554":73999,"_30673":73985,"_21251":126111,"_5":14613,"_27884":126077,"_3010":126112},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3554":74000,"_30673":73985,"_21251":126114,"_5":14613,"_27884":126077,"_3010":126115},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3554":74001,"_30673":73985,"_21251":126117,"_5":14613,"_27884":126081,"_3010":126118},[],"Archivo o recurso",{"_3554":74002,"_30673":73985,"_21251":126120,"_5":14613,"_27884":126081,"_3010":123290},[],{"_3554":74003,"_30673":73985,"_21251":126122,"_5":14613,"_27884":126081,"_3010":126123},[],"CA raíz activa y `ca.pem`",{"_3554":74004,"_30673":73985,"_21251":126125,"_5":14613,"_27884":126081,"_3010":126126},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3554":74005,"_30673":73985,"_21251":126128,"_5":14613,"_27884":126081,"_3010":126129},[],"Certificado final y `device.crt`",{"_3554":74006,"_30673":73985,"_21251":126131,"_5":14613,"_27884":126081,"_3010":126132},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3554":74007,"_30673":73985,"_21251":126134,"_5":14613,"_27884":126081,"_3010":126135},[],"Clave privada `device.key`",{"_3554":74008,"_30673":73985,"_21251":126137,"_5":14613,"_27884":126081,"_3010":126138},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3554":74009,"_30673":73985,"_21251":126140,"_5":14613,"_27884":126081,"_3010":126141},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3554":74010,"_30673":73985,"_21251":126143,"_5":14613,"_27884":126084,"_3010":126144},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3554":74011,"_30673":73985,"_21251":126146,"_5":14613,"_27884":126084,"_3010":126147},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3554":74012,"_30673":73985,"_21251":126149,"_5":14613,"_27884":126084,"_3010":126150},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3554":74013,"_30673":74013,"_5":14965,"_3010":126152,"_31032":126153,"_21251":126155,"_27884":74013},"Resolución de problemas PKI",[50083,119650,55721,126154],"Resolución de problemas",[],{"_3554":74014,"_30673":74013,"_21251":126157,"_5":14613,"_27884":74013,"_3010":126158},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3554":74015,"_30673":74013,"_5":31029,"_21251":126160,"_27884":126161,"_3010":126162},[],"/docs/pr-preview/pr-69/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3554":74016,"_30673":74013,"_5":31029,"_21251":126164,"_27884":126165,"_3010":126166},[],"/docs/pr-preview/pr-69/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3554":74017,"_30673":74013,"_5":31029,"_21251":126168,"_27884":126169,"_3010":126170},[],"/docs/pr-preview/pr-69/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3554":74018,"_30673":74013,"_21251":126172,"_5":14613,"_27884":74013,"_3010":126173},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3554":74019,"_30673":74013,"_21251":126175,"_5":14613,"_27884":74013,"_3010":126176},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3554":74020,"_30673":74013,"_21251":126178,"_5":14613,"_27884":126161,"_3010":123290},[],{"_3554":74021,"_30673":74013,"_21251":126180,"_5":14613,"_27884":126161,"_3010":121962},[],{"_3554":74022,"_30673":74013,"_21251":126182,"_5":14613,"_27884":126161,"_3010":118245},[],{"_3554":74023,"_30673":74013,"_21251":126184,"_5":14613,"_27884":126161,"_3010":54563},[],{"_3554":74024,"_30673":74013,"_21251":126186,"_5":14613,"_27884":126161,"_3010":126187},[],"Existe, está activa y sus fechas son utilizables.",{"_3554":74025,"_30673":74013,"_21251":126189,"_5":14613,"_27884":126161,"_3010":126190},[],"Autoridades.",{"_3554":74026,"_30673":74013,"_21251":126192,"_5":14613,"_27884":126161,"_3010":126193},[],"Clave",{"_3554":74027,"_30673":74013,"_21251":126195,"_5":14613,"_27884":126161,"_3010":126196},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3554":74028,"_30673":74013,"_21251":126198,"_5":14613,"_27884":126161,"_3010":126199},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3554":74029,"_30673":74013,"_21251":126201,"_5":14613,"_27884":126161,"_3010":58297},[],{"_3554":74030,"_30673":74013,"_21251":126203,"_5":14613,"_27884":126161,"_3010":126204},[],"PEM correcto y firma verificable.",{"_3554":74031,"_30673":74013,"_21251":126206,"_5":14613,"_27884":126161,"_3010":58303},[],{"_3554":74032,"_30673":74013,"_21251":126208,"_5":14613,"_27884":126161,"_3010":126209},[],"Perfil",{"_3554":74033,"_30673":74013,"_21251":126211,"_5":14613,"_27884":126161,"_3010":126212},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3554":74034,"_30673":74013,"_21251":126214,"_5":14613,"_27884":126161,"_3010":126215},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3554":74035,"_30673":74013,"_21251":126217,"_5":14613,"_27884":126161,"_3010":123441},[],{"_3554":74036,"_30673":74013,"_21251":126219,"_5":14613,"_27884":126161,"_3010":126220},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3554":74037,"_30673":74013,"_21251":126222,"_5":14613,"_27884":126161,"_3010":126223},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3554":74038,"_30673":74013,"_21251":126225,"_5":14613,"_27884":126161,"_3010":126226},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3554":74039,"_30673":74013,"_21251":126228,"_5":14613,"_27884":126161,"_3010":126229},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3554":74040,"_30673":74013,"_21251":126231,"_5":14613,"_27884":126165,"_3010":126232},[],"Revisa cada frontera por separado:",{"_3554":74041,"_30673":74013,"_21251":126234,"_5":14613,"_27884":126165,"_3010":126235},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3554":74042,"_30673":74013,"_21251":126237,"_5":14613,"_27884":126165,"_3010":126238},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3554":74043,"_30673":74013,"_21251":126240,"_5":14613,"_27884":126165,"_3010":126241},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3554":74044,"_30673":74013,"_21251":126243,"_5":14613,"_27884":126165,"_3010":126244},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3554":74045,"_30673":74013,"_21251":126246,"_5":14613,"_27884":126165,"_3010":126247},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3554":74046,"_30673":74013,"_21251":126249,"_5":14613,"_27884":126165,"_3010":126250},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3554":74047,"_30673":74013,"_21251":126252,"_5":14613,"_27884":126169,"_3010":126253},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3554":74048,"_30673":74013,"_21251":126255,"_5":14613,"_27884":126169,"_3010":126256},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3554":74049,"_30673":74049,"_5":14965,"_3010":126258,"_31032":126259,"_21251":126260,"_27884":74049},"Seguridad",[50083],[],{"_3554":74050,"_30673":74049,"_21251":126262,"_5":14613,"_27884":74049,"_3010":126263},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3554":74051,"_30673":74049,"_5":31029,"_21251":126265,"_27884":126266,"_3010":126267},[],"/docs/pr-preview/pr-69/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3554":74052,"_30673":74049,"_5":31029,"_21251":126269,"_27884":126270,"_3010":126271},[],"/docs/pr-preview/pr-69/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3554":74053,"_30673":74049,"_5":31029,"_21251":126273,"_27884":126274,"_3010":126275},[],"/docs/pr-preview/pr-69/es/security#versiones-soportadas","Versiones soportadas",{"_3554":74054,"_30673":74049,"_5":31029,"_21251":126277,"_27884":126278,"_3010":126279},[],"/docs/pr-preview/pr-69/es/security#divulgación-responsable","Divulgación responsable",{"_3554":74055,"_30673":74049,"_21251":126281,"_5":14613,"_27884":74049,"_3010":126282},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3554":74056,"_30673":74049,"_21251":126284,"_5":14613,"_27884":126266,"_3010":126285},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3554":74057,"_30673":74049,"_21251":126287,"_5":14613,"_27884":126266,"_3010":126288},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3554":74058,"_30673":74049,"_21251":126290,"_5":14613,"_27884":126266,"_3010":15232},[],{"_3554":74059,"_30673":74049,"_21251":126292,"_5":14613,"_27884":126266,"_3010":15172},[],{"_3554":74060,"_30673":74049,"_21251":126294,"_5":14613,"_27884":126266,"_3010":15219},[],{"_3554":74061,"_30673":74049,"_21251":126296,"_5":14613,"_27884":126266,"_3010":126297},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3554":74062,"_30673":74049,"_21251":126299,"_5":14613,"_27884":126266,"_3010":126300},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3554":74063,"_30673":74049,"_21251":126302,"_5":14613,"_27884":126270,"_3010":126303},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3554":74064,"_30673":74049,"_21251":126305,"_5":14613,"_27884":126270,"_3010":126306},[],"No incluyas en el reporte:",{"_3554":74065,"_30673":74049,"_21251":126308,"_5":14613,"_27884":126270,"_3010":126309},[],"Credenciales, tokens o claves privadas",{"_3554":74066,"_30673":74049,"_21251":126311,"_5":14613,"_27884":126270,"_3010":126312},[],"Datos de clientes o información identificable de clientes",{"_3554":74067,"_30673":74049,"_21251":126314,"_5":14613,"_27884":126270,"_3010":126315},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3554":74068,"_30673":74049,"_21251":126317,"_5":14613,"_27884":126274,"_3010":126318},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3554":74069,"_30673":74049,"_21251":126320,"_5":14613,"_27884":126274,"_3010":126321},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3554":74070,"_30673":74049,"_21251":126323,"_5":14613,"_27884":126278,"_3010":126324},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3554":74071,"_30673":74049,"_21251":126326,"_5":14613,"_27884":126278,"_3010":126327},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3554":74072,"_30673":74049,"_21251":126329,"_5":14613,"_27884":126278,"_3010":126330},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3554":74073,"_30673":74049,"_21251":126332,"_5":14613,"_27884":126278,"_3010":126333},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3554":74074,"_30673":74049,"_21251":126335,"_5":14613,"_27884":126278,"_3010":126336},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3554":74075,"_30673":74075,"_5":14965,"_3010":126338,"_31032":126339,"_21251":126341,"_27884":74075},"3.8.0 a 4.0.0",[50083,126340],"Actualizaciones",[],{"_3554":74076,"_30673":74075,"_21251":126343,"_5":14613,"_27884":74075,"_3010":126344},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3554":74077,"_30673":74075,"_5":31029,"_21251":126346,"_27884":126347,"_3010":126348},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3554":74078,"_30673":74075,"_5":31029,"_21251":126350,"_27884":126351,"_3010":126352},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3554":74079,"_30673":74075,"_5":31029,"_21251":126354,"_27884":126355,"_3010":126356},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3554":74080,"_30673":74075,"_5":31029,"_21251":126358,"_27884":126359,"_3010":126360},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3554":74081,"_30673":74075,"_5":31029,"_21251":126362,"_27884":126363,"_3010":126364},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3554":74082,"_30673":74075,"_5":31029,"_21251":126366,"_27884":126367,"_3010":126368},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3554":74083,"_30673":74075,"_5":31029,"_21251":126370,"_27884":126371,"_3010":58469},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3554":74084,"_30673":74075,"_5":31029,"_21251":126373,"_27884":126374,"_3010":126375},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3554":74085,"_30673":74075,"_5":31029,"_21251":126377,"_27884":126378,"_3010":126379},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3554":74086,"_30673":74075,"_5":31029,"_21251":126381,"_27884":126382,"_3010":126383},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3554":74087,"_30673":74075,"_5":31029,"_21251":126385,"_27884":126386,"_3010":126387},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3554":74088,"_30673":74075,"_5":31029,"_21251":126389,"_27884":126390,"_3010":126391},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3554":74089,"_30673":74075,"_5":31029,"_21251":126393,"_27884":126394,"_3010":126395},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3554":74090,"_30673":74075,"_5":31029,"_21251":126397,"_27884":126398,"_3010":126399},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3554":74091,"_30673":74075,"_5":31029,"_21251":126401,"_27884":126402,"_3010":126403},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3554":74092,"_30673":74075,"_5":31029,"_21251":126405,"_27884":126406,"_3010":126407},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3554":74093,"_30673":74075,"_5":31029,"_21251":126409,"_27884":126410,"_3010":126411},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3554":74094,"_30673":74075,"_5":31029,"_21251":126413,"_27884":126414,"_3010":126415},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3554":74095,"_30673":74075,"_5":31029,"_21251":126417,"_27884":126418,"_3010":126419},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3554":74096,"_30673":74075,"_5":31029,"_21251":126421,"_27884":126422,"_3010":126423},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3554":74097,"_30673":74075,"_5":31029,"_21251":126425,"_27884":126426,"_3010":126427},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3554":74098,"_30673":74075,"_5":31029,"_21251":126429,"_27884":126430,"_3010":126431},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3554":74099,"_30673":74075,"_5":31029,"_21251":126433,"_27884":126434,"_3010":126435},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3554":74100,"_30673":74075,"_5":31029,"_21251":126437,"_27884":126438,"_3010":126439},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3554":74101,"_30673":74075,"_5":31029,"_21251":126441,"_27884":126442,"_3010":126443},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3554":74102,"_30673":74075,"_5":31029,"_21251":126445,"_27884":126446,"_3010":126447},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3554":74103,"_30673":74075,"_5":31029,"_21251":126449,"_27884":126450,"_3010":126451},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3554":74104,"_30673":74075,"_5":31029,"_21251":126453,"_27884":126454,"_3010":126455},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3554":74105,"_30673":74075,"_5":31029,"_21251":126457,"_27884":126458,"_3010":126459},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3554":74106,"_30673":74075,"_5":31029,"_21251":126461,"_27884":126462,"_3010":126463},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3554":74107,"_30673":74075,"_5":31029,"_21251":126465,"_27884":126466,"_3010":126467},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3554":74108,"_30673":74075,"_5":31029,"_21251":126469,"_27884":126470,"_3010":126471},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3554":74109,"_30673":74075,"_5":31029,"_21251":126473,"_27884":126474,"_3010":126475},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3554":74110,"_30673":74075,"_5":31029,"_21251":126477,"_27884":126478,"_3010":126479},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3554":74111,"_30673":74075,"_5":31029,"_21251":126481,"_27884":126482,"_3010":126483},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3554":74112,"_30673":74075,"_5":31029,"_21251":126485,"_27884":126486,"_3010":126487},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3554":74113,"_30673":74075,"_5":31029,"_21251":126489,"_27884":126490,"_3010":126491},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3554":74114,"_30673":74075,"_5":31029,"_21251":126493,"_27884":126494,"_3010":126495},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3554":74115,"_30673":74075,"_5":31029,"_21251":126497,"_27884":126498,"_3010":126499},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3554":74116,"_30673":74075,"_5":31029,"_21251":126501,"_27884":126502,"_3010":126503},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3554":74117,"_30673":74075,"_5":31029,"_21251":126505,"_27884":126506,"_3010":122304},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3554":74118,"_30673":74075,"_5":31029,"_21251":126508,"_27884":126509,"_3010":126510},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3554":74119,"_30673":74075,"_5":31029,"_21251":126512,"_27884":126513,"_3010":126514},[],"/docs/pr-preview/pr-69/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3554":74120,"_30673":74075,"_21251":126516,"_5":14613,"_27884":74075,"_3010":126517},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3554":74121,"_30673":74075,"_21251":126519,"_5":14613,"_27884":74075,"_3010":126520},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3554":74122,"_30673":74075,"_21251":126522,"_5":14613,"_27884":74075,"_3010":126523},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3554":74123,"_30673":74075,"_21251":126525,"_5":14613,"_27884":74075,"_3010":126526},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3554":74124,"_30673":74075,"_21251":126528,"_5":14613,"_27884":74075,"_3010":126529},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3554":74125,"_30673":74075,"_21251":126531,"_5":14613,"_27884":74075,"_3010":126532},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3554":74126,"_30673":74075,"_21251":126534,"_5":14613,"_27884":74075,"_3010":126535},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3554":74127,"_30673":74075,"_21251":126537,"_5":14613,"_27884":126351,"_3010":126538},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3554":74128,"_30673":74075,"_21251":126540,"_5":14613,"_27884":126351,"_3010":126541},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3554":74129,"_30673":74075,"_21251":126543,"_5":14613,"_27884":126355,"_3010":126544},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3554":74130,"_30673":74075,"_21251":126546,"_5":14613,"_27884":126355,"_3010":126547},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3554":74131,"_30673":74075,"_21251":126549,"_5":14613,"_27884":126359,"_3010":126550},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3554":74132,"_30673":74075,"_21251":126552,"_5":14613,"_27884":126363,"_3010":126553},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3554":74133,"_30673":74075,"_21251":126555,"_5":14613,"_27884":126363,"_3010":126556},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3554":74134,"_30673":74075,"_21251":126558,"_5":14613,"_27884":126363,"_3010":126559},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3554":74135,"_30673":74075,"_21251":126561,"_5":14613,"_27884":126363,"_3010":126562},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3554":74136,"_30673":74075,"_21251":126564,"_5":14613,"_27884":126363,"_3010":126565},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3554":74137,"_30673":74075,"_21251":126567,"_5":14613,"_27884":126367,"_3010":126568},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3554":74138,"_30673":74075,"_21251":126570,"_5":14613,"_27884":126367,"_3010":126571},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3554":74139,"_30673":74075,"_21251":126573,"_5":14613,"_27884":126367,"_3010":126574},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3554":74140,"_30673":74075,"_21251":126576,"_5":14613,"_27884":126367,"_3010":126577},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3554":74141,"_30673":74075,"_21251":126579,"_5":14613,"_27884":126367,"_3010":126580},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3554":74142,"_30673":74075,"_21251":126582,"_5":14613,"_27884":126367,"_3010":126583},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3554":74143,"_30673":74075,"_21251":126585,"_5":14613,"_27884":126371,"_3010":126586},[],"Cambio",{"_3554":74144,"_30673":74075,"_21251":126588,"_5":14613,"_27884":126371,"_3010":126589},[],"A quién afecta",{"_3554":74145,"_30673":74075,"_21251":126591,"_5":14613,"_27884":126371,"_3010":126592},[],"Gravedad",{"_3554":74146,"_30673":74075,"_21251":126594,"_5":14613,"_27884":126371,"_3010":125083},[],{"_3554":74147,"_30673":74075,"_21251":126596,"_5":14613,"_27884":126371,"_3010":126379},[],{"_3554":74148,"_30673":74075,"_21251":126598,"_5":14613,"_27884":126371,"_3010":126599},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3554":74149,"_30673":74075,"_21251":126601,"_5":14613,"_27884":126371,"_3010":126602},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3554":74150,"_30673":74075,"_21251":126604,"_5":14613,"_27884":126371,"_3010":126605},[],"Copiar los datos a los volúmenes nuevos",{"_3554":74151,"_30673":74075,"_21251":126607,"_5":14613,"_27884":126371,"_3010":126383},[],{"_3554":74152,"_30673":74075,"_21251":126609,"_5":14613,"_27884":126371,"_3010":126610},[],"Todas las releases de Helm",{"_3554":74153,"_30673":74075,"_21251":126612,"_5":14613,"_27884":126371,"_3010":126613},[],"Alta: `helm upgrade` falla",{"_3554":74154,"_30673":74075,"_21251":126615,"_5":14613,"_27884":126371,"_3010":126616},[],"Eliminar o renombrar las claves heredadas",{"_3554":74155,"_30673":74075,"_21251":126618,"_5":14613,"_27884":126371,"_3010":126387},[],{"_3554":74156,"_30673":74075,"_21251":126620,"_5":14613,"_27884":126371,"_3010":126621},[],"Todos los despliegues",{"_3554":74157,"_30673":74075,"_21251":126623,"_5":14613,"_27884":126371,"_3010":126624},[],"Alta: sin principal de bootstrap no hay administrador",{"_3554":74158,"_30673":74075,"_21251":126626,"_5":14613,"_27884":126371,"_3010":126627},[],"Configurar `services.authz`",{"_3554":74159,"_30673":74075,"_21251":126629,"_5":14613,"_27884":126371,"_3010":126391},[],{"_3554":74160,"_30673":74075,"_21251":126631,"_5":14613,"_27884":126371,"_3010":126610},[],{"_3554":74161,"_30673":74075,"_21251":126633,"_5":14613,"_27884":126371,"_3010":126634},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3554":74162,"_30673":74075,"_21251":126636,"_5":14613,"_27884":126371,"_3010":126637},[],"Mover JWKS y roles a `services.authz`",{"_3554":74163,"_30673":74075,"_21251":126639,"_5":14613,"_27884":126371,"_3010":126411},[],{"_3554":74164,"_30673":74075,"_21251":126641,"_5":14613,"_27884":126371,"_3010":126642},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3554":74165,"_30673":74075,"_21251":126644,"_5":14613,"_27884":126371,"_3010":126645},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3554":74166,"_30673":74075,"_21251":126647,"_5":14613,"_27884":126371,"_3010":126648},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3554":74167,"_30673":74075,"_21251":126650,"_5":14613,"_27884":126371,"_3010":126415},[],{"_3554":74168,"_30673":74075,"_21251":126652,"_5":14613,"_27884":126371,"_3010":126653},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3554":74169,"_30673":74075,"_21251":126655,"_5":14613,"_27884":126371,"_3010":126656},[],"Alta: el backend ya no arranca con ellos",{"_3554":74170,"_30673":74075,"_21251":126658,"_5":14613,"_27884":126371,"_3010":126659},[],"Pasar a PostgreSQL antes de actualizar",{"_3554":74171,"_30673":74075,"_21251":126661,"_5":14613,"_27884":126371,"_3010":126459},[],{"_3554":74172,"_30673":74075,"_21251":126663,"_5":14613,"_27884":126371,"_3010":126664},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3554":74173,"_30673":74075,"_21251":126666,"_5":14613,"_27884":126371,"_3010":126667},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3554":74174,"_30673":74075,"_21251":126669,"_5":14613,"_27884":126371,"_3010":126670},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3554":74175,"_30673":74075,"_21251":126672,"_5":14613,"_27884":126371,"_3010":126673},[],"Webhooks con referencias a archivos",{"_3554":74176,"_30673":74075,"_21251":126675,"_5":14613,"_27884":126371,"_3010":126676},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3554":74177,"_30673":74075,"_21251":126678,"_5":14613,"_27884":126371,"_3010":126679},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3554":74178,"_30673":74075,"_21251":126681,"_5":14613,"_27884":126371,"_3010":126682},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3554":74179,"_30673":74075,"_21251":126684,"_5":14613,"_27884":126371,"_3010":126395},[],{"_3554":74180,"_30673":74075,"_21251":126686,"_5":14613,"_27884":126371,"_3010":126687},[],"Releases con identidades por servicio o material de claves montado",{"_3554":74181,"_30673":74075,"_21251":126689,"_5":14613,"_27884":126371,"_3010":126690},[],"Media: los servicios no pueden leer sus archivos",{"_3554":74182,"_30673":74075,"_21251":126692,"_5":14613,"_27884":126371,"_3010":126693},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3554":74183,"_30673":74075,"_21251":126695,"_5":14613,"_27884":126371,"_3010":126399},[],{"_3554":74184,"_30673":74075,"_21251":126697,"_5":14613,"_27884":126371,"_3010":126698},[],"Releases que definen `amqp.tls`",{"_3554":74185,"_30673":74075,"_21251":126700,"_5":14613,"_27884":126371,"_3010":126701},[],"Media: los clientes se conectan al puerto equivocado",{"_3554":74186,"_30673":74075,"_21251":126703,"_5":14613,"_27884":126371,"_3010":126704},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3554":74187,"_30673":74075,"_21251":126706,"_5":14613,"_27884":126371,"_3010":126419},[],{"_3554":74188,"_30673":74075,"_21251":126708,"_5":14613,"_27884":126371,"_3010":126709},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3554":74189,"_30673":74075,"_21251":126711,"_5":14613,"_27884":126371,"_3010":126712},[],"Media: las claves de CA quedan sin gestionar",{"_3554":74190,"_30673":74075,"_21251":126714,"_5":14613,"_27884":126371,"_3010":126715},[],"Ejecutar la migración de CA a KMS",{"_3554":74191,"_30673":74075,"_21251":126717,"_5":14613,"_27884":126371,"_3010":126718},[],"Verificación del certificado del receptor",{"_3554":74192,"_30673":74075,"_21251":126720,"_5":14613,"_27884":126371,"_3010":126721},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3554":74193,"_30673":74075,"_21251":126723,"_5":14613,"_27884":126371,"_3010":126724},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3554":74194,"_30673":74075,"_21251":126726,"_5":14613,"_27884":126371,"_3010":126727},[],"Poner `insecure_skip_verify` a `false`",{"_3554":74195,"_30673":74075,"_21251":126729,"_5":14613,"_27884":126371,"_3010":126435},[],{"_3554":74196,"_30673":74075,"_21251":126731,"_5":14613,"_27884":126371,"_3010":126732},[],"Scripts y consolas que editan DMS por API",{"_3554":74197,"_30673":74075,"_21251":126734,"_5":14613,"_27884":126371,"_3010":126735},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3554":74198,"_30673":74075,"_21251":126737,"_5":14613,"_27884":126371,"_3010":126738},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3554":74199,"_30673":74075,"_21251":126740,"_5":14613,"_27884":126371,"_3010":126455},[],{"_3554":74200,"_30673":74075,"_21251":126742,"_5":14613,"_27884":126371,"_3010":126743},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3554":74201,"_30673":74075,"_21251":126745,"_5":14613,"_27884":126371,"_3010":126746},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3554":74202,"_30673":74075,"_21251":126748,"_5":14613,"_27884":126371,"_3010":126749},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3554":74203,"_30673":74075,"_21251":126751,"_5":14613,"_27884":126371,"_3010":126463},[],{"_3554":74204,"_30673":74075,"_21251":126753,"_5":14613,"_27884":126371,"_3010":126754},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3554":74205,"_30673":74075,"_21251":126756,"_5":14613,"_27884":126371,"_3010":126757},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3554":74206,"_30673":74075,"_21251":126759,"_5":14613,"_27884":126371,"_3010":126760},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3554":74207,"_30673":74075,"_21251":126762,"_5":14613,"_27884":126371,"_3010":126451},[],{"_3554":74208,"_30673":74075,"_21251":126764,"_5":14613,"_27884":126371,"_3010":126765},[],"Consumidores que leen el campo `events` del dispositivo",{"_3554":74209,"_30673":74075,"_21251":126767,"_5":14613,"_27884":126371,"_3010":126768},[],"Media: el campo desaparece",{"_3554":74210,"_30673":74075,"_21251":126770,"_5":14613,"_27884":126371,"_3010":126771},[],"Usar los nuevos endpoints de eventos",{"_3554":74211,"_30673":74075,"_21251":126773,"_5":14613,"_27884":126371,"_3010":126471},[],{"_3554":74212,"_30673":74075,"_21251":126775,"_5":14613,"_27884":126371,"_3010":126776},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3554":74213,"_30673":74075,"_21251":126778,"_5":14613,"_27884":126371,"_3010":126779},[],"Media: la migración de la VA aborta",{"_3554":74214,"_30673":74075,"_21251":126781,"_5":14613,"_27884":126371,"_3010":126782},[],"Corregir los roles afectados antes de actualizar",{"_3554":74215,"_30673":74075,"_21251":126784,"_5":14613,"_27884":126371,"_3010":126403},[],{"_3554":74216,"_30673":74075,"_21251":126786,"_5":14613,"_27884":126371,"_3010":126787},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3554":74217,"_30673":74075,"_21251":126789,"_5":14613,"_27884":126371,"_3010":126790},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3554":74218,"_30673":74075,"_21251":126792,"_5":14613,"_27884":126371,"_3010":126793},[],"Actualizar el archivo de values",{"_3554":74219,"_30673":74075,"_21251":126795,"_5":14613,"_27884":126371,"_3010":126443},[],{"_3554":74220,"_30673":74075,"_21251":126797,"_5":14613,"_27884":126371,"_3010":126798},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3554":74221,"_30673":74075,"_21251":126800,"_5":14613,"_27884":126371,"_3010":126801},[],"Baja: prevalece el ID de la URL",{"_3554":74222,"_30673":74075,"_21251":126803,"_5":14613,"_27884":126371,"_3010":126804},[],"Enviar el ID en la URL",{"_3554":74223,"_30673":74075,"_21251":126806,"_5":14613,"_27884":126371,"_3010":126467},[],{"_3554":74224,"_30673":74075,"_21251":126808,"_5":14613,"_27884":126371,"_3010":126809},[],"Clientes que envían un `id` al crear o importar CAs",{"_3554":74225,"_30673":74075,"_21251":126811,"_5":14613,"_27884":126371,"_3010":126812},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3554":74226,"_30673":74075,"_21251":126814,"_5":14613,"_27884":126371,"_3010":126815},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3554":74227,"_30673":74075,"_21251":126817,"_5":14613,"_27884":126371,"_3010":126447},[],{"_3554":74228,"_30673":74075,"_21251":126819,"_5":14613,"_27884":126371,"_3010":126820},[],"Consumidores que comparan el `type` del certificado",{"_3554":74229,"_30673":74075,"_21251":126822,"_5":14613,"_27884":126371,"_3010":126823},[],"Baja: dos valores cambian de nombre",{"_3554":74230,"_30673":74075,"_21251":126825,"_5":14613,"_27884":126371,"_3010":126826},[],"Adaptar los consumidores",{"_3554":74231,"_30673":74075,"_21251":126828,"_5":14613,"_27884":126371,"_3010":126439},[],{"_3554":74232,"_30673":74075,"_21251":126830,"_5":14613,"_27884":126371,"_3010":126831},[],"Cualquier DMS",{"_3554":74233,"_30673":74075,"_21251":126833,"_5":14613,"_27884":126371,"_3010":126834},[],"Baja: solo informativo",{"_3554":74234,"_30673":74075,"_21251":126836,"_5":14613,"_27884":126371,"_3010":126837},[],"Revisar ambos bloques antes de editar",{"_3554":74235,"_30673":74075,"_21251":126839,"_5":14613,"_27884":126378,"_3010":126840},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3554":74236,"_30673":74075,"_21251":126842,"_5":14613,"_27884":126378,"_3010":126843},[],"El paso 4 de la guía de migración copia los datos.",{"_3554":74237,"_30673":74075,"_21251":126845,"_5":14613,"_27884":126382,"_3010":126846},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3554":74238,"_30673":74075,"_21251":126848,"_5":14613,"_27884":126386,"_3010":126849},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3554":74239,"_30673":74075,"_21251":126851,"_5":14613,"_27884":126390,"_3010":126852},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3554":74240,"_30673":74075,"_21251":126854,"_5":14613,"_27884":126394,"_3010":126855},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3554":74241,"_30673":74075,"_21251":126857,"_5":14613,"_27884":126394,"_3010":126858},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3554":74242,"_30673":74075,"_21251":126860,"_5":14613,"_27884":126398,"_3010":126861},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3554":74243,"_30673":74075,"_21251":126863,"_5":14613,"_27884":126402,"_3010":126864},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3554":74244,"_30673":74075,"_21251":126866,"_5":14613,"_27884":126402,"_3010":126867},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3554":74245,"_30673":74075,"_21251":126869,"_5":14613,"_27884":126402,"_3010":126870},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3554":74246,"_30673":74075,"_21251":126872,"_5":14613,"_27884":126402,"_3010":126873},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3554":74247,"_30673":74075,"_21251":126875,"_5":14613,"_27884":126402,"_3010":126876},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3554":74248,"_30673":74075,"_21251":126878,"_5":14613,"_27884":126402,"_3010":126879},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3554":74249,"_30673":74075,"_21251":126881,"_5":14613,"_27884":126410,"_3010":126882},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3554":74250,"_30673":74075,"_21251":126884,"_5":14613,"_27884":126410,"_3010":126885},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3554":74251,"_30673":74075,"_21251":126887,"_5":14613,"_27884":126410,"_3010":126888},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3554":74252,"_30673":74075,"_21251":126890,"_5":14613,"_27884":126410,"_3010":126891},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3554":74253,"_30673":74075,"_21251":126893,"_5":14613,"_27884":126410,"_3010":126894},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3554":74254,"_30673":74075,"_21251":126896,"_5":14613,"_27884":126414,"_3010":126897},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3554":74255,"_30673":74075,"_21251":126899,"_5":14613,"_27884":126418,"_3010":126900},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3554":74256,"_30673":74075,"_21251":126902,"_5":14613,"_27884":126418,"_3010":126903},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3554":74257,"_30673":74075,"_21251":126905,"_5":14613,"_27884":126418,"_3010":126906},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3554":74258,"_30673":74075,"_21251":126908,"_5":14613,"_27884":126418,"_3010":126909},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3554":74259,"_30673":74075,"_21251":126911,"_5":14613,"_27884":126418,"_3010":126912},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3554":74260,"_30673":74075,"_21251":126914,"_5":14613,"_27884":126418,"_3010":126915},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3554":74261,"_30673":74075,"_21251":126917,"_5":14613,"_27884":126418,"_3010":126918},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3554":74262,"_30673":74075,"_21251":126920,"_5":14613,"_27884":126418,"_3010":126921},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3554":74263,"_30673":74075,"_21251":126923,"_5":14613,"_27884":126422,"_3010":126924},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3554":74264,"_30673":74075,"_21251":126926,"_5":14613,"_27884":126430,"_3010":126927},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3554":74265,"_30673":74075,"_21251":126929,"_5":14613,"_27884":126430,"_3010":126930},[],"Campo en 3.8.0",{"_3554":74266,"_30673":74075,"_21251":126932,"_5":14613,"_27884":126430,"_3010":126933},[],"Campo en 4.0.0",{"_3554":74267,"_30673":74075,"_21251":126935,"_5":14613,"_27884":126430,"_3010":59034},[],{"_3554":74268,"_30673":74075,"_21251":126937,"_5":14613,"_27884":126430,"_3010":126938},[],"`insecure_skip_verify` (con el valor negado)",{"_3554":74269,"_30673":74075,"_21251":126940,"_5":14613,"_27884":126430,"_3010":59040},[],{"_3554":74270,"_30673":74075,"_21251":126942,"_5":14613,"_27884":126430,"_3010":59043},[],{"_3554":74271,"_30673":74075,"_21251":126944,"_5":14613,"_27884":126430,"_3010":59046},[],{"_3554":74272,"_30673":74075,"_21251":126946,"_5":14613,"_27884":126430,"_3010":59049},[],{"_3554":74273,"_30673":74075,"_21251":126948,"_5":14613,"_27884":126430,"_3010":59052},[],{"_3554":74274,"_30673":74075,"_21251":126950,"_5":14613,"_27884":126430,"_3010":59055},[],{"_3554":74275,"_30673":74075,"_21251":126952,"_5":14613,"_27884":126430,"_3010":126953},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3554":74276,"_30673":74075,"_21251":126955,"_5":14613,"_27884":126430,"_3010":126956},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3554":74277,"_30673":74075,"_21251":126958,"_5":14613,"_27884":126430,"_3010":126959},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3554":74278,"_30673":74075,"_21251":126961,"_5":14613,"_27884":126434,"_3010":126962},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3554":74279,"_30673":74075,"_21251":126964,"_5":14613,"_27884":126434,"_3010":126965},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3554":74280,"_30673":74075,"_21251":126967,"_5":14613,"_27884":126434,"_3010":126968},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3554":74281,"_30673":74075,"_21251":126970,"_5":14613,"_27884":126438,"_3010":126971},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3554":74282,"_30673":74075,"_21251":126973,"_5":14613,"_27884":126442,"_3010":126974},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3554":74283,"_30673":74075,"_21251":126976,"_5":14613,"_27884":126446,"_3010":126977},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3554":74284,"_30673":74075,"_21251":126979,"_5":14613,"_27884":126450,"_3010":126980},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3554":74285,"_30673":74075,"_21251":126982,"_5":14613,"_27884":126450,"_3010":126983},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3554":74286,"_30673":74075,"_21251":126985,"_5":14613,"_27884":126450,"_3010":126986},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3554":74287,"_30673":74075,"_21251":126988,"_5":14613,"_27884":126450,"_3010":126989},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3554":74288,"_30673":74075,"_21251":126991,"_5":14613,"_27884":126454,"_3010":126992},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3554":74289,"_30673":74075,"_21251":126994,"_5":14613,"_27884":126458,"_3010":126995},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3554":74290,"_30673":74075,"_21251":126997,"_5":14613,"_27884":126458,"_3010":126998},[],"Ruta",{"_3554":74291,"_30673":74075,"_21251":127000,"_5":14613,"_27884":126458,"_3010":119410},[],{"_3554":74292,"_30673":74075,"_21251":127002,"_5":14613,"_27884":126458,"_3010":59108},[],{"_3554":74293,"_30673":74075,"_21251":127004,"_5":14613,"_27884":126458,"_3010":127005},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3554":74294,"_30673":74075,"_21251":127007,"_5":14613,"_27884":126458,"_3010":59114},[],{"_3554":74295,"_30673":74075,"_21251":127009,"_5":14613,"_27884":126458,"_3010":127010},[],"Lee los ajustes de una CA.",{"_3554":74296,"_30673":74075,"_21251":127012,"_5":14613,"_27884":126458,"_3010":59120},[],{"_3554":74297,"_30673":74075,"_21251":127014,"_5":14613,"_27884":126458,"_3010":127015},[],"Sustituye los `crl_options`.",{"_3554":74298,"_30673":74075,"_21251":127017,"_5":14613,"_27884":126458,"_3010":59126},[],{"_3554":74299,"_30673":74075,"_21251":127019,"_5":14613,"_27884":126458,"_3010":127020},[],"Elimina los ajustes archivados de una CA.",{"_3554":74300,"_30673":74075,"_21251":127022,"_5":14613,"_27884":126458,"_3010":127023},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3554":74301,"_30673":74075,"_21251":127025,"_5":14613,"_27884":126458,"_3010":127026},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3554":74302,"_30673":74075,"_21251":127028,"_5":14613,"_27884":126458,"_3010":127029},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3554":74303,"_30673":74075,"_21251":127031,"_5":14613,"_27884":126458,"_3010":127032},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3554":74304,"_30673":74075,"_21251":127034,"_5":14613,"_27884":126458,"_3010":127035},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3554":74305,"_30673":74075,"_21251":127037,"_5":14613,"_27884":126458,"_3010":127038},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3554":74306,"_30673":74075,"_21251":127040,"_5":14613,"_27884":126458,"_3010":127041},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3554":74307,"_30673":74075,"_21251":127043,"_5":14613,"_27884":126458,"_3010":127044},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3554":74308,"_30673":74075,"_21251":127046,"_5":14613,"_27884":126458,"_3010":127047},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3554":74309,"_30673":74075,"_21251":127049,"_5":14613,"_27884":126458,"_3010":127050},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3554":74310,"_30673":74075,"_21251":127052,"_5":14613,"_27884":126458,"_3010":127053},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3554":74311,"_30673":74075,"_21251":127055,"_5":14613,"_27884":126462,"_3010":127056},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3554":74312,"_30673":74075,"_21251":127058,"_5":14613,"_27884":126466,"_3010":127059},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3554":74313,"_30673":74075,"_21251":127061,"_5":14613,"_27884":126470,"_3010":127062},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3554":74314,"_30673":74075,"_21251":127064,"_5":14613,"_27884":126474,"_3010":127065},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3554":74315,"_30673":74075,"_21251":127067,"_5":14613,"_27884":126478,"_3010":127068},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3554":74316,"_30673":74075,"_21251":127070,"_5":14613,"_27884":126478,"_3010":127071},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3554":74317,"_30673":74075,"_21251":127073,"_5":14613,"_27884":126478,"_3010":127074},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3554":74318,"_30673":74075,"_21251":127076,"_5":14613,"_27884":126478,"_3010":127077},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3554":74319,"_30673":74075,"_21251":127079,"_5":14613,"_27884":126478,"_3010":127080},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3554":74320,"_30673":74075,"_21251":127082,"_5":14613,"_27884":126478,"_3010":127083},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3554":74321,"_30673":74075,"_21251":127085,"_5":14613,"_27884":126482,"_3010":127086},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3554":74322,"_30673":74075,"_21251":127088,"_5":14613,"_27884":126482,"_3010":127089},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3554":74323,"_30673":74075,"_21251":127091,"_5":14613,"_27884":126482,"_3010":127092},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3554":74324,"_30673":74075,"_21251":127094,"_5":14613,"_27884":126482,"_3010":127095},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3554":74325,"_30673":74075,"_21251":127097,"_5":14613,"_27884":126482,"_3010":127098},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3554":74326,"_30673":74075,"_21251":127100,"_5":14613,"_27884":126486,"_3010":127101},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3554":74327,"_30673":74075,"_21251":127103,"_5":14613,"_27884":126486,"_3010":127104},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3554":74328,"_30673":74075,"_21251":127106,"_5":14613,"_27884":126486,"_3010":127107},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3554":74329,"_30673":74075,"_21251":127109,"_5":14613,"_27884":126486,"_3010":127110},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3554":74330,"_30673":74075,"_21251":127112,"_5":14613,"_27884":126486,"_3010":127113},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3554":74331,"_30673":74075,"_21251":127115,"_5":14613,"_27884":126486,"_3010":127116},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3554":74332,"_30673":74075,"_21251":127118,"_5":14613,"_27884":126486,"_3010":127119},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3554":74333,"_30673":74075,"_21251":127121,"_5":14613,"_27884":126486,"_3010":127122},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3554":74334,"_30673":74075,"_21251":127124,"_5":14613,"_27884":126486,"_3010":127125},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3554":74335,"_30673":74075,"_21251":127127,"_5":14613,"_27884":126486,"_3010":127128},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3554":74336,"_30673":74075,"_21251":127130,"_5":14613,"_27884":126486,"_3010":127131},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3554":74337,"_30673":74075,"_21251":127133,"_5":14613,"_27884":126486,"_3010":127134},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3554":74338,"_30673":74075,"_21251":127136,"_5":14613,"_27884":126490,"_3010":127137},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3554":74339,"_30673":74075,"_21251":127139,"_5":14613,"_27884":126490,"_3010":127140},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3554":74340,"_30673":74075,"_21251":127142,"_5":14613,"_27884":126494,"_3010":127143},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3554":74341,"_30673":74075,"_21251":127145,"_5":14613,"_27884":126494,"_3010":127146},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3554":74342,"_30673":74075,"_21251":127148,"_5":14613,"_27884":126494,"_3010":127149},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3554":74343,"_30673":74075,"_21251":127151,"_5":14613,"_27884":126494,"_3010":127152},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3554":74344,"_30673":74075,"_21251":127154,"_5":14613,"_27884":126494,"_3010":127155},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3554":74345,"_30673":74075,"_21251":127157,"_5":14613,"_27884":126494,"_3010":127158},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3554":74346,"_30673":74075,"_21251":127160,"_5":14613,"_27884":126494,"_3010":127161},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3554":74347,"_30673":74075,"_21251":127163,"_5":14613,"_27884":126494,"_3010":127164},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3554":74348,"_30673":74075,"_21251":127166,"_5":14613,"_27884":126494,"_3010":127167},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3554":74349,"_30673":74075,"_21251":127169,"_5":14613,"_27884":126494,"_3010":127170},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3554":74350,"_30673":74075,"_21251":127172,"_5":14613,"_27884":126494,"_3010":127173},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3554":74351,"_30673":74075,"_21251":127175,"_5":14613,"_27884":126498,"_3010":127176},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3554":74352,"_30673":74075,"_21251":127178,"_5":14613,"_27884":126498,"_3010":127179},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3554":74353,"_30673":74075,"_21251":127181,"_5":14613,"_27884":126502,"_3010":127182},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3554":74354,"_30673":74075,"_21251":127184,"_5":14613,"_27884":126502,"_3010":127185},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3554":74355,"_30673":74075,"_21251":127187,"_5":14613,"_27884":126502,"_3010":127188},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3554":74356,"_30673":74075,"_21251":127190,"_5":14613,"_27884":126502,"_3010":127191},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3554":74357,"_30673":74075,"_21251":127193,"_5":14613,"_27884":126502,"_3010":127194},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3554":74358,"_30673":74075,"_21251":127196,"_5":14613,"_27884":126502,"_3010":127197},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3554":74359,"_30673":74075,"_21251":127199,"_5":14613,"_27884":126502,"_3010":127200},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3554":74360,"_30673":74075,"_21251":127202,"_5":14613,"_27884":126502,"_3010":127203},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3554":74361,"_30673":74075,"_21251":127205,"_5":14613,"_27884":126506,"_3010":127206},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3554":74362,"_30673":74075,"_21251":127208,"_5":14613,"_27884":126506,"_3010":127209},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3554":74363,"_30673":74075,"_21251":127211,"_5":14613,"_27884":126506,"_3010":127212},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3554":74364,"_30673":74075,"_21251":127214,"_5":14613,"_27884":126506,"_3010":127215},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3554":74365,"_30673":74075,"_21251":127217,"_5":14613,"_27884":126506,"_3010":127218},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3554":74366,"_30673":74075,"_21251":127220,"_5":14613,"_27884":126506,"_3010":127221},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3554":74367,"_30673":74075,"_21251":127223,"_5":14613,"_27884":126506,"_3010":127224},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3554":74368,"_30673":74075,"_21251":127226,"_5":14613,"_27884":126506,"_3010":127227},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3554":74369,"_30673":74075,"_21251":127229,"_5":14613,"_27884":126506,"_3010":127230},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3554":74370,"_30673":74075,"_21251":127232,"_5":14613,"_27884":126506,"_3010":127233},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3554":74371,"_30673":74075,"_21251":127235,"_5":14613,"_27884":126506,"_3010":127236},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3554":74372,"_30673":74075,"_21251":127238,"_5":14613,"_27884":126509,"_3010":127239},[],"Tras la actualización, comprueba en este orden:",{"_3554":74373,"_30673":74075,"_21251":127241,"_5":14613,"_27884":126509,"_3010":127242},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3554":74374,"_30673":74075,"_21251":127244,"_5":14613,"_27884":126509,"_3010":127245},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3554":74375,"_30673":74075,"_21251":127247,"_5":14613,"_27884":126509,"_3010":127248},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3554":74376,"_30673":74075,"_21251":127250,"_5":14613,"_27884":126509,"_3010":127251},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3554":74377,"_30673":74075,"_21251":127253,"_5":14613,"_27884":126509,"_3010":127254},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3554":74378,"_30673":74075,"_21251":127256,"_5":14613,"_27884":126509,"_3010":127257},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3554":74379,"_30673":74075,"_21251":127259,"_5":14613,"_27884":126509,"_3010":127260},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3554":74380,"_30673":74075,"_21251":127262,"_5":14613,"_27884":126509,"_3010":127263},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3554":74381,"_30673":74075,"_21251":127265,"_5":14613,"_27884":126509,"_3010":127266},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3554":74382,"_30673":74075,"_21251":127268,"_5":14613,"_27884":126509,"_3010":127269},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3554":74383,"_30673":74075,"_21251":127271,"_5":14613,"_27884":126509,"_3010":127272},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3554":74384,"_30673":74075,"_21251":127274,"_5":14613,"_27884":126509,"_3010":127275},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3554":74385,"_30673":74075,"_21251":127277,"_5":14613,"_27884":126509,"_3010":127278},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3554":74386,"_30673":74075,"_21251":127280,"_5":14613,"_27884":126509,"_3010":127281},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3554":74387,"_30673":74075,"_21251":127283,"_5":14613,"_27884":126509,"_3010":127284},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3554":74388,"_30673":74075,"_21251":127286,"_5":14613,"_27884":126513,"_3010":127287},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3554":74389,"_30673":74075,"_21251":127289,"_5":14613,"_27884":126513,"_3010":127290},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3554":74390,"_30673":74075,"_21251":127292,"_5":14613,"_27884":126513,"_3010":127293},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3554":74391,"_30673":74075,"_21251":127295,"_5":14613,"_27884":126513,"_3010":127296},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3554":74392,"_30673":74075,"_21251":127298,"_5":14613,"_27884":126513,"_3010":127299},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_59411":127301,"_59413":127302,"_59415":127303,"_59417":127304,"_18417":3045,"_71396":3045},"spanish",[3010,30673,5,27884],{"_3010":25376,"_30673":25376,"_5":25376,"_27884":25376},{"_3010":127305,"_30673":130298,"_5":133291,"_27884":136284},{"_4745":127306,"_59421":127307,"_5":25376},{"_14689":7744,"_15064":5050,"_15083":5181,"_29671":7155,"_15070":4069,"_20170":5547,"_14710":8219,"_14717":3784,"_29613":5056,"_30027":16853,"_30048":10983,"_29647":12971,"_35056":12477,"_29750":20650,"_30092":10069,"_35063":23183,"_35066":4238,"_35069":7832,"_35072":3298,"_30499":3409,"_35077":10127,"_35079":4381,"_30529":4661,"_15079":18816,"_35083":7673,"_35086":7099,"_35088":6641,"_30076":11085,"_30494":7819,"_30542":7818,"_35093":4868,"_35095":7776,"_35097":18280,"_29767":6438,"_35100":3400,"_35102":3479,"_35104":5257,"_35106":6505,"_35108":3407,"_29684":7663,"_35111":5408,"_35113":5156,"_29678":7173,"_30113":13133,"_35117":23427,"_35119":20667,"_35122":5067,"_29724":4824,"_35126":4490,"_29604":5829,"_35129":20654,"_29652":7811,"_35132":7839,"_35134":7788,"_35137":17954,"_15073":17053,"_35140":3845,"_35142":3119,"_35145":16054,"_35147":15840,"_35149":9940,"_35151":11962,"_35153":21013,"_20173":3397,"_35156":18792,"_35158":5045,"_29625":8318,"_30070":16284,"_30738":3349,"_35163":7515,"_35165":7522,"_30559":3501,"_35168":3311,"_35170":13925,"_35172":4701,"_30653":9086,"_30129":7764,"_35176":7716,"_35178":7098,"_29662":7817,"_35181":4810,"_35183":3411,"_35185":4971,"_30575":4727,"_29744":3432,"_29129":6138,"_35190":3486,"_35192":4004,"_35194":4880,"_29793":3596,"_35198":5636,"_30064":3497,"_35202":3084,"_35204":10497,"_35206":6900,"_35208":3333,"_35210":16024,"_35212":7086,"_29782":6506,"_30032":25754,"_35216":5219,"_35218":7156,"_35220":4718,"_35223":5958,"_35225":12269,"_35227":6727,"_35229":5215,"_35231":7725,"_35233":3193,"_35235":8366,"_35238":5956,"_35240":5681,"_35242":4835,"_35244":8762,"_35246":5227,"_35249":7216,"_35251":3638,"_35254":20438,"_35257":16196,"_35259":4950,"_35261":6446,"_35263":4028,"_35265":8072,"_35267":50073,"_35269":3434,"_35271":6056,"_35273":4547,"_30075":6145,"_35276":4799,"_35278":19729,"_35280":21790,"_35282":3886,"_35284":5933,"_35286":6128,"_35288":7053,"_35290":7057,"_35292":12331,"_35294":6057,"_35296":4160,"_35298":5685,"_35300":4056,"_35302":18921,"_35304":11406,"_35306":5039,"_35308":3834,"_35310":8319,"_35312":7686,"_35314":3047,"_35316":14592,"_35318":7687,"_35320":7041,"_35322":3715,"_35324":4057,"_35326":15142,"_35328":4505,"_35330":3253,"_35332":3320,"_35334":7287,"_35336":5121,"_35338":13135,"_35340":25553,"_35342":7052,"_35344":5259,"_35346":5143,"_35348":4798,"_35350":7763,"_35352":4821,"_30069":4581,"_35355":3390,"_35357":20269,"_35359":5929,"_35361":4113,"_35363":6507,"_35365":5260,"_35368":4055,"_35370":5317,"_35372":6888,"_35374":20470,"_35376":18495,"_35378":5038,"_35380":25479,"_35382":5088,"_35384":12376,"_35386":7094,"_35388":3727,"_35390":7769,"_35392":3417,"_35394":11181,"_35396":3783,"_35398":20468,"_35400":4838,"_30063":3263,"_35403":8899,"_35406":3345,"_35409":3392,"_35411":17296,"_35413":6164,"_35415":13668,"_35417":16855,"_30514":14495,"_35420":4811,"_35422":4273,"_35424":4805,"_30504":12465,"_35427":6742,"_35429":4162,"_35431":3477,"_35433":4806,"_35435":7071,"_35437":3310,"_35439":5367,"_35