1":50111,"_27884":50112,"_3010":50113},[],"/docs/pr-preview/pr-69/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3554":23,"_30673":15,"_5":31029,"_21251":50115,"_27884":50116,"_3010":50117},[],"/docs/pr-preview/pr-69/deployment/aws-marketplace#next-step","Next step",{"_3554":24,"_30673":15,"_21251":50119,"_5":14613,"_27884":15,"_3010":50120},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3554":25,"_30673":15,"_21251":50122,"_5":14613,"_27884":50092,"_3010":50123},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3554":26,"_30673":15,"_21251":50125,"_5":14613,"_27884":50092,"_3010":50126},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3554":27,"_30673":15,"_21251":50128,"_5":14613,"_27884":50092,"_3010":50129},[],"A security group allowing the necessary endpoints.",{"_3554":28,"_30673":15,"_21251":50131,"_5":14613,"_27884":50096,"_3010":50132},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3554":29,"_30673":15,"_21251":50134,"_5":14613,"_27884":50096,"_3010":50135},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3554":30,"_30673":15,"_21251":50137,"_5":14613,"_27884":50096,"_3010":50138},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3554":31,"_30673":15,"_21251":50140,"_5":14613,"_27884":50100,"_3010":50141},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3554":32,"_30673":15,"_21251":50143,"_5":14613,"_27884":50104,"_3010":50144},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3554":33,"_30673":15,"_21251":50146,"_5":14613,"_27884":50108,"_3010":50147},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3554":34,"_30673":15,"_21251":50149,"_5":14613,"_27884":50112,"_3010":50150},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3554":35,"_30673":15,"_21251":50152,"_5":14613,"_27884":50116,"_3010":50153},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3554":36,"_30673":36,"_5":14965,"_3010":50155,"_31032":50156,"_21251":50157,"_27884":36},"Deploy Lamassu",[50083,50084],[],{"_3554":37,"_30673":36,"_21251":50159,"_5":14613,"_27884":36,"_3010":50160},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3554":38,"_30673":36,"_5":31029,"_21251":50162,"_27884":50163,"_3010":50164},[],"/docs/pr-preview/pr-69/deployment/overview#choose-a-model","Choose a model",{"_3554":39,"_30673":36,"_5":31029,"_21251":50166,"_27884":50167,"_3010":50168},[],"/docs/pr-preview/pr-69/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3554":40,"_30673":36,"_5":31029,"_21251":50170,"_27884":50171,"_3010":50172},[],"/docs/pr-preview/pr-69/deployment/overview#after-deployment","After deployment",{"_3554":41,"_30673":36,"_21251":50174,"_5":14613,"_27884":36,"_3010":50175},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3554":42,"_30673":36,"_21251":50177,"_5":14613,"_27884":50163,"_3010":50178},[],"Model",{"_3554":43,"_30673":36,"_21251":50180,"_5":14613,"_27884":50163,"_3010":50181},[],"Recommended for",{"_3554":44,"_30673":36,"_21251":50183,"_5":14613,"_27884":50163,"_3010":50184},[],"Who operates the infrastructure",{"_3554":45,"_30673":36,"_21251":50186,"_5":14613,"_27884":50163,"_3010":50187},[],"Starting point",{"_3554":46,"_30673":36,"_21251":50189,"_5":14613,"_27884":50163,"_3010":50190},[],"Kubernetes self-managed",{"_3554":47,"_30673":36,"_21251":50192,"_5":14613,"_27884":50163,"_3010":50193},[],"Production, regulated environments and custom deployments",{"_3554":48,"_30673":36,"_21251":50195,"_5":14613,"_27884":50163,"_3010":50196},[],"Your team",{"_3554":49,"_30673":36,"_21251":50198,"_5":14613,"_27884":50163,"_3010":50199},[],"Helm or Fastlane",{"_3554":50,"_30673":36,"_21251":50201,"_5":14613,"_27884":50163,"_3010":50202},[],"AWS Marketplace",{"_3554":51,"_30673":36,"_21251":50204,"_5":14613,"_27884":50163,"_3010":50205},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3554":52,"_30673":36,"_21251":50207,"_5":14613,"_27884":50163,"_3010":50196},[],{"_3554":53,"_30673":36,"_21251":50209,"_5":14613,"_27884":50163,"_3010":50210},[],"Preconfigured image on EC2",{"_3554":54,"_30673":36,"_21251":50212,"_5":14613,"_27884":50163,"_3010":50213},[],"SaaS",{"_3554":55,"_30673":36,"_21251":50215,"_5":14613,"_27884":50163,"_3010":50216},[],"Teams that want to use the platform without operating it",{"_3554":56,"_30673":36,"_21251":50218,"_5":14613,"_27884":50163,"_3010":50219},[],"Lamassu",{"_3554":57,"_30673":36,"_21251":50221,"_5":14613,"_27884":50163,"_3010":50222},[],"Managed subscription",{"_3554":58,"_30673":36,"_21251":50224,"_5":14613,"_27884":50163,"_3010":50225},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3554":59,"_30673":36,"_21251":50227,"_5":14613,"_27884":50163,"_3010":50228},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3554":60,"_30673":36,"_21251":50230,"_5":14613,"_27884":50163,"_3010":50231},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3554":61,"_30673":36,"_21251":50233,"_5":14613,"_27884":50167,"_3010":50234},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3554":62,"_30673":36,"_21251":50236,"_5":14613,"_27884":50171,"_3010":50237},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3554":63,"_30673":63,"_5":14965,"_3010":50239,"_31032":50240,"_21251":50241,"_27884":63},"Use Lamassu as SaaS",[50083,50084,50085],[],{"_3554":64,"_30673":63,"_21251":50243,"_5":14613,"_27884":63,"_3010":50244},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3554":65,"_30673":63,"_5":31029,"_21251":50246,"_27884":50247,"_3010":50248},[],"/docs/pr-preview/pr-69/deployment/saas#what-the-service-manages","What the service manages",{"_3554":66,"_30673":63,"_5":31029,"_21251":50250,"_27884":50251,"_3010":50252},[],"/docs/pr-preview/pr-69/deployment/saas#plans","Plans",{"_3554":67,"_30673":63,"_5":31029,"_21251":50254,"_27884":50255,"_3010":50256},[],"/docs/pr-preview/pr-69/deployment/saas#request-access","Request access",{"_3554":68,"_30673":63,"_21251":50258,"_5":14613,"_27884":63,"_3010":50259},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3554":69,"_30673":63,"_21251":50261,"_5":14613,"_27884":50247,"_3010":50262},[],"Platform availability and maintenance.",{"_3554":70,"_30673":63,"_21251":50264,"_5":14613,"_27884":50247,"_3010":50265},[],"Automatic backups.",{"_3554":71,"_30673":63,"_21251":50267,"_5":14613,"_27884":50247,"_3010":50268},[],"Version upgrades.",{"_3554":72,"_30673":63,"_21251":50270,"_5":14613,"_27884":50247,"_3010":50271},[],"Technical support and SLA according to your plan.",{"_3554":73,"_30673":63,"_21251":50273,"_5":14613,"_27884":50251,"_3010":50274},[],"Plan",{"_3554":74,"_30673":63,"_21251":50276,"_5":14613,"_27884":50251,"_3010":50277},[],"Devices",{"_3554":75,"_30673":63,"_21251":50279,"_5":14613,"_27884":50251,"_3010":50280},[],"Support",{"_3554":76,"_30673":63,"_21251":50282,"_5":14613,"_27884":50251,"_3010":50283},[],"SLA",{"_3554":77,"_30673":63,"_21251":50285,"_5":14613,"_27884":50251,"_3010":50286},[],"Starter",{"_3554":78,"_30673":63,"_21251":50288,"_5":14613,"_27884":50251,"_3010":50289},[],"Up to 1,000",{"_3554":79,"_30673":63,"_21251":50291,"_5":14613,"_27884":50251,"_3010":50292},[],"Email",{"_3554":80,"_30673":63,"_21251":50294,"_5":14613,"_27884":50251,"_3010":50295},[],"99.5 %",{"_3554":81,"_30673":63,"_21251":50297,"_5":14613,"_27884":50251,"_3010":50298},[],"Professional",{"_3554":82,"_30673":63,"_21251":50300,"_5":14613,"_27884":50251,"_3010":50301},[],"Up to 10,000",{"_3554":83,"_30673":63,"_21251":50303,"_5":14613,"_27884":50251,"_3010":50304},[],"Email and chat",{"_3554":84,"_30673":63,"_21251":50306,"_5":14613,"_27884":50251,"_3010":50307},[],"99.9 %",{"_3554":85,"_30673":63,"_21251":50309,"_5":14613,"_27884":50251,"_3010":50310},[],"Enterprise",{"_3554":86,"_30673":63,"_21251":50312,"_5":14613,"_27884":50251,"_3010":50313},[],"Unlimited",{"_3554":87,"_30673":63,"_21251":50315,"_5":14613,"_27884":50251,"_3010":50316},[],"Dedicated",{"_3554":88,"_30673":63,"_21251":50318,"_5":14613,"_27884":50251,"_3010":50319},[],"99.99 %",{"_3554":89,"_30673":63,"_21251":50321,"_5":14613,"_27884":50255,"_3010":50322},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3554":90,"_30673":63,"_21251":50324,"_5":14613,"_27884":50255,"_3010":50325},[],"When you receive your instance's credentials, continue with Get started.",{"_3554":91,"_30673":91,"_5":14965,"_3010":50327,"_31032":50328,"_21251":50329,"_27884":91},"Fastlane",[50083,50084,50190],[],{"_3554":92,"_30673":91,"_21251":50331,"_5":14613,"_27884":91,"_3010":50332},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3554":93,"_30673":91,"_5":31029,"_21251":50334,"_27884":50335,"_3010":50336},[],"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3554":94,"_30673":91,"_5":31029,"_21251":50338,"_27884":50339,"_3010":50340},[],"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3554":95,"_30673":91,"_5":31029,"_21251":50342,"_27884":50343,"_3010":50093},[],"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#before-you-begin",{"_3554":96,"_30673":91,"_5":31029,"_21251":50345,"_27884":50346,"_3010":50347},[],"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3554":97,"_30673":91,"_5":31029,"_21251":50349,"_27884":50350,"_3010":50351},[],"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3554":98,"_30673":91,"_5":31029,"_21251":50353,"_27884":50354,"_3010":50355},[],"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3554":99,"_30673":91,"_5":31029,"_21251":50357,"_27884":50358,"_3010":50359},[],"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3554":100,"_30673":91,"_5":31029,"_21251":50361,"_27884":50362,"_3010":50363},[],"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3554":101,"_30673":91,"_5":31029,"_21251":50365,"_27884":50366,"_3010":50367},[],"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3554":102,"_30673":91,"_5":31029,"_21251":50369,"_27884":50370,"_3010":50371},[],"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3554":103,"_30673":91,"_5":31029,"_21251":50373,"_27884":50374,"_3010":50375},[],"/docs/pr-preview/pr-69/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3554":104,"_30673":91,"_21251":50377,"_5":14613,"_27884":50335,"_3010":50378},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3554":105,"_30673":91,"_21251":50380,"_5":14613,"_27884":50335,"_3010":50381},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3554":106,"_30673":91,"_21251":50383,"_5":14613,"_27884":50339,"_3010":50384},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3554":107,"_30673":91,"_21251":50386,"_5":14613,"_27884":50339,"_3010":50387},[],"Fastlane installs or configures",{"_3554":108,"_30673":91,"_21251":50389,"_5":14613,"_27884":50339,"_3010":50390},[],"You still provide",{"_3554":109,"_30673":91,"_21251":50392,"_5":14613,"_27884":50339,"_3010":50393},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3554":110,"_30673":91,"_21251":50395,"_5":14613,"_27884":50339,"_3010":50396},[],"The Kubernetes cluster, nodes and persistent storage",{"_3554":111,"_30673":91,"_21251":50398,"_5":14613,"_27884":50339,"_3010":50399},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3554":112,"_30673":91,"_21251":50401,"_5":14613,"_27884":50339,"_3010":50402},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3554":113,"_30673":91,"_21251":50404,"_5":14613,"_27884":50339,"_3010":50405},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3554":114,"_30673":91,"_21251":50407,"_5":14613,"_27884":50339,"_3010":50408},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3554":115,"_30673":91,"_21251":50410,"_5":14613,"_27884":50339,"_3010":50411},[],"Optional observability and lab HSM components",{"_3554":116,"_30673":91,"_21251":50413,"_5":14613,"_27884":50339,"_3010":50414},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3554":117,"_30673":91,"_21251":50416,"_5":14613,"_27884":50339,"_3010":50417},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3554":118,"_30673":91,"_21251":50419,"_5":14613,"_27884":50343,"_3010":50420},[],"You need:",{"_3554":119,"_30673":91,"_21251":50422,"_5":14613,"_27884":50343,"_3010":50423},[],"an existing Kubernetes cluster",{"_3554":120,"_30673":91,"_21251":50425,"_5":14613,"_27884":50343,"_3010":50426},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3554":121,"_30673":91,"_21251":50428,"_5":14613,"_27884":50343,"_3010":50429},[],"`yq`",{"_3554":122,"_30673":91,"_21251":50431,"_5":14613,"_27884":50343,"_3010":24019},[],{"_3554":123,"_30673":91,"_21251":50433,"_5":14613,"_27884":50343,"_3010":50434},[],"`jq` only when using `--sample-data` or `--development`",{"_3554":124,"_30673":91,"_21251":50436,"_5":14613,"_27884":50343,"_3010":50437},[],"`ssh-keygen` only when using `--with-hsm`",{"_3554":125,"_30673":91,"_21251":50439,"_5":14613,"_27884":50343,"_3010":50440},[],"free external ports 80 and 443 on a single-node K3s host",{"_3554":126,"_30673":91,"_21251":50442,"_5":14613,"_27884":50343,"_3010":50443},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3554":127,"_30673":91,"_21251":50445,"_5":14613,"_27884":50343,"_3010":50446},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3554":128,"_30673":91,"_21251":50448,"_5":14613,"_27884":50346,"_3010":50449},[],"Run the script from a clone of the Helm repository:",{"_3554":129,"_30673":91,"_21251":50451,"_5":14613,"_27884":50346,"_3010":50452},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3554":130,"_30673":91,"_21251":50454,"_5":14613,"_27884":50350,"_3010":50455},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3554":131,"_30673":91,"_21251":50457,"_5":14613,"_27884":50350,"_3010":50458},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3554":132,"_30673":91,"_21251":50460,"_5":14613,"_27884":50350,"_3010":50461},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3554":133,"_30673":91,"_21251":50463,"_5":14613,"_27884":50350,"_3010":50464},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3554":134,"_30673":91,"_21251":50466,"_5":14613,"_27884":50354,"_3010":50467},[],"Option",{"_3554":135,"_30673":91,"_21251":50469,"_5":14613,"_27884":50354,"_3010":50470},[],"Default",{"_3554":136,"_30673":91,"_21251":50472,"_5":14613,"_27884":50354,"_3010":50473},[],"Purpose",{"_3554":137,"_30673":91,"_21251":50475,"_5":14613,"_27884":50354,"_3010":50476},[],"`-h`, `--help`",{"_3554":138,"_30673":91,"_21251":50478,"_5":14613,"_27884":50354,"_3010":50479},[],"—",{"_3554":139,"_30673":91,"_21251":50481,"_5":14613,"_27884":50354,"_3010":50482},[],"Show help",{"_3554":140,"_30673":91,"_21251":50484,"_5":14613,"_27884":50354,"_3010":50485},[],"`-c`, `--context`",{"_3554":141,"_30673":91,"_21251":50487,"_5":14613,"_27884":50354,"_3010":50488},[],"current context",{"_3554":142,"_30673":91,"_21251":50490,"_5":14613,"_27884":50354,"_3010":50491},[],"Select the kubeconfig context for kubectl and Helm",{"_3554":143,"_30673":91,"_21251":50493,"_5":14613,"_27884":50354,"_3010":50494},[],"`-n`, `--non-interactive`",{"_3554":144,"_30673":91,"_21251":50496,"_5":14613,"_27884":50354,"_3010":6684},[],{"_3554":145,"_30673":91,"_21251":50498,"_5":14613,"_27884":50354,"_3010":50499},[],"Skip prompts and generate dependency credentials",{"_3554":146,"_30673":91,"_21251":50501,"_5":14613,"_27884":50354,"_3010":50502},[],"`-ns`, `--namespace`",{"_3554":147,"_30673":91,"_21251":50504,"_5":14613,"_27884":50354,"_3010":50505},[],"`lamassu-dev`",{"_3554":148,"_30673":91,"_21251":50507,"_5":14613,"_27884":50354,"_3010":50508},[],"Namespace for the installation",{"_3554":149,"_30673":91,"_21251":50510,"_5":14613,"_27884":50354,"_3010":50511},[],"`-d`, `--domain`",{"_3554":150,"_30673":91,"_21251":50513,"_5":14613,"_27884":50354,"_3010":50514},[],"`dev.lamassu.io`",{"_3554":151,"_30673":91,"_21251":50516,"_5":14613,"_27884":50354,"_3010":50517},[],"Domain used by the UI, OIDC and certificate",{"_3554":152,"_30673":91,"_21251":50519,"_5":14613,"_27884":50354,"_3010":50520},[],"`-v`, `--version`",{"_3554":153,"_30673":91,"_21251":50522,"_5":14613,"_27884":50354,"_3010":15305},[],{"_3554":154,"_30673":91,"_21251":50524,"_5":14613,"_27884":50354,"_3010":50525},[],"Lamassu chart version",{"_3554":155,"_30673":91,"_21251":50527,"_5":14613,"_27884":50354,"_3010":50528},[],"`--https-port`",{"_3554":156,"_30673":91,"_21251":50530,"_5":14613,"_27884":50354,"_3010":50531},[],"`443`",{"_3554":157,"_30673":91,"_21251":50533,"_5":14613,"_27884":50354,"_3010":50534},[],"Gateway HTTPS listener port",{"_3554":158,"_30673":91,"_21251":50536,"_5":14613,"_27884":50354,"_3010":50537},[],"`--http-port`",{"_3554":159,"_30673":91,"_21251":50539,"_5":14613,"_27884":50354,"_3010":50540},[],"`80`",{"_3554":160,"_30673":91,"_21251":50542,"_5":14613,"_27884":50354,"_3010":50543},[],"Gateway HTTP listener port",{"_3554":161,"_30673":91,"_21251":50545,"_5":14613,"_27884":50354,"_3010":50546},[],"`--tls-crt`",{"_3554":162,"_30673":91,"_21251":50548,"_5":14613,"_27884":50354,"_3010":50479},[],{"_3554":163,"_30673":91,"_21251":50550,"_5":14613,"_27884":50354,"_3010":50551},[],"PEM certificate for downstream TLS",{"_3554":164,"_30673":91,"_21251":50553,"_5":14613,"_27884":50354,"_3010":50554},[],"`--tls-key`",{"_3554":165,"_30673":91,"_21251":50556,"_5":14613,"_27884":50354,"_3010":50479},[],{"_3554":166,"_30673":91,"_21251":50558,"_5":14613,"_27884":50354,"_3010":50559},[],"PEM private key for downstream TLS",{"_3554":167,"_30673":91,"_21251":50561,"_5":14613,"_27884":50354,"_3010":50562},[],"`-l`, `--local-chart-path`",{"_3554":168,"_30673":91,"_21251":50564,"_5":14613,"_27884":50354,"_3010":50565},[],"repository chart",{"_3554":169,"_30673":91,"_21251":50567,"_5":14613,"_27884":50354,"_3010":50568},[],"Use an unpacked local Lamassu chart",{"_3554":170,"_30673":91,"_21251":50570,"_5":14613,"_27884":50354,"_3010":50571},[],"`-ip`, `--gateway-ip`",{"_3554":171,"_30673":91,"_21251":50573,"_5":14613,"_27884":50354,"_3010":8930},[],{"_3554":172,"_30673":91,"_21251":50575,"_5":14613,"_27884":50354,"_3010":50576},[],"Override the address written to `gateway.addresses`",{"_3554":173,"_30673":91,"_21251":50578,"_5":14613,"_27884":50354,"_3010":50579},[],"`--otel`",{"_3554":174,"_30673":91,"_21251":50581,"_5":14613,"_27884":50354,"_3010":6684},[],{"_3554":175,"_30673":91,"_21251":50583,"_5":14613,"_27884":50354,"_3010":50584},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3554":176,"_30673":91,"_21251":50586,"_5":14613,"_27884":50354,"_3010":50587},[],"`--development`",{"_3554":177,"_30673":91,"_21251":50589,"_5":14613,"_27884":50354,"_3010":6684},[],{"_3554":178,"_30673":91,"_21251":50591,"_5":14613,"_27884":50354,"_3010":50592},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3554":179,"_30673":91,"_21251":50594,"_5":14613,"_27884":50354,"_3010":50595},[],"`--sample-data`",{"_3554":180,"_30673":91,"_21251":50597,"_5":14613,"_27884":50354,"_3010":6684},[],{"_3554":181,"_30673":91,"_21251":50599,"_5":14613,"_27884":50354,"_3010":50600},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3554":182,"_30673":91,"_21251":50602,"_5":14613,"_27884":50354,"_3010":50603},[],"`--with-hsm`",{"_3554":183,"_30673":91,"_21251":50605,"_5":14613,"_27884":50354,"_3010":6684},[],{"_3554":184,"_30673":91,"_21251":50607,"_5":14613,"_27884":50354,"_3010":50608},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3554":185,"_30673":91,"_21251":50610,"_5":14613,"_27884":50354,"_3010":50611},[],"`--softhsm-chart-path`",{"_3554":186,"_30673":91,"_21251":50613,"_5":14613,"_27884":50354,"_3010":50614},[],"`./charts/softhsm`",{"_3554":187,"_30673":91,"_21251":50616,"_5":14613,"_27884":50354,"_3010":50617},[],"Use a different local SoftHSM chart",{"_3554":188,"_30673":91,"_21251":50619,"_5":14613,"_27884":50354,"_3010":50620},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3554":189,"_30673":91,"_21251":50622,"_5":14613,"_27884":50358,"_3010":50623},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3554":190,"_30673":91,"_21251":50625,"_5":14613,"_27884":50358,"_3010":50626},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3554":191,"_30673":91,"_21251":50628,"_5":14613,"_27884":50358,"_3010":50629},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3554":192,"_30673":91,"_21251":50631,"_5":14613,"_27884":50358,"_3010":50632},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3554":193,"_30673":91,"_21251":50634,"_5":14613,"_27884":50358,"_3010":50635},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3554":194,"_30673":91,"_21251":50637,"_5":14613,"_27884":50358,"_3010":50638},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3554":195,"_30673":91,"_21251":50640,"_5":14613,"_27884":50362,"_3010":50641},[],"Fastlane:",{"_3554":196,"_30673":91,"_21251":50643,"_5":14613,"_27884":50362,"_3010":50644},[],"validates local tools and the selected cluster",{"_3554":197,"_30673":91,"_21251":50646,"_5":14613,"_27884":50362,"_3010":50647},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3554":198,"_30673":91,"_21251":50649,"_5":14613,"_27884":50362,"_3010":50650},[],"creates the namespace",{"_3554":199,"_30673":91,"_21251":50652,"_5":14613,"_27884":50362,"_3010":50653},[],"installs PostgreSQL and creates the required databases",{"_3554":200,"_30673":91,"_21251":50655,"_5":14613,"_27884":50362,"_3010":50656},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3554":201,"_30673":91,"_21251":50658,"_5":14613,"_27884":50362,"_3010":50659},[],"installs RabbitMQ",{"_3554":202,"_30673":91,"_21251":50661,"_5":14613,"_27884":50362,"_3010":50662},[],"optionally installs observability and lab HSM components",{"_3554":203,"_30673":91,"_21251":50664,"_5":14613,"_27884":50362,"_3010":50665},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3554":204,"_30673":91,"_21251":50667,"_5":14613,"_27884":50362,"_3010":50668},[],"optionally loads sample data",{"_3554":205,"_30673":91,"_21251":50670,"_5":14613,"_27884":50362,"_3010":50671},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3554":206,"_30673":91,"_21251":50673,"_5":14613,"_27884":50366,"_3010":50674},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3554":207,"_30673":91,"_21251":50676,"_5":14613,"_27884":50366,"_3010":50677},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3554":208,"_30673":91,"_21251":50679,"_5":14613,"_27884":50370,"_3010":50680},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3554":209,"_30673":91,"_21251":50682,"_5":14613,"_27884":50370,"_3010":50683},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3554":210,"_30673":91,"_21251":50685,"_5":14613,"_27884":50370,"_3010":50686},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3554":211,"_30673":91,"_21251":50688,"_5":14613,"_27884":50374,"_3010":50689},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3554":212,"_30673":212,"_5":14965,"_3010":50691,"_31032":50692,"_21251":50693,"_27884":212},"Install with Helm",[50083,50084,50190],[],{"_3554":213,"_30673":212,"_21251":50695,"_5":14613,"_27884":212,"_3010":50696},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3554":214,"_30673":212,"_5":31029,"_21251":50698,"_27884":50699,"_3010":50700},[],"/docs/pr-preview/pr-69/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3554":215,"_30673":212,"_5":31029,"_21251":50702,"_27884":50703,"_3010":50093},[],"/docs/pr-preview/pr-69/deployment/self-hosted/helm#before-you-begin",{"_3554":216,"_30673":212,"_5":31029,"_21251":50705,"_27884":50706,"_3010":50707},[],"/docs/pr-preview/pr-69/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3554":217,"_30673":212,"_5":31029,"_21251":50709,"_27884":50710,"_3010":50711},[],"/docs/pr-preview/pr-69/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3554":218,"_30673":212,"_5":31029,"_21251":50713,"_27884":50714,"_3010":50715},[],"/docs/pr-preview/pr-69/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3554":219,"_30673":212,"_5":31029,"_21251":50717,"_27884":50718,"_3010":50719},[],"/docs/pr-preview/pr-69/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3554":220,"_30673":212,"_5":31029,"_21251":50721,"_27884":50722,"_3010":50723},[],"/docs/pr-preview/pr-69/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3554":221,"_30673":212,"_5":31029,"_21251":50725,"_27884":50726,"_3010":50727},[],"/docs/pr-preview/pr-69/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3554":222,"_30673":212,"_5":31029,"_21251":50729,"_27884":50730,"_3010":50731},[],"/docs/pr-preview/pr-69/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3554":223,"_30673":212,"_5":31029,"_21251":50733,"_27884":50734,"_3010":50735},[],"/docs/pr-preview/pr-69/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3554":224,"_30673":212,"_5":31029,"_21251":50737,"_27884":50738,"_3010":50739},[],"/docs/pr-preview/pr-69/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3554":225,"_30673":212,"_21251":50741,"_5":14613,"_27884":50699,"_3010":50742},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3554":226,"_30673":212,"_21251":50744,"_5":14613,"_27884":50703,"_3010":50745},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3554":227,"_30673":212,"_21251":50747,"_5":14613,"_27884":50703,"_3010":50748},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3554":228,"_30673":212,"_21251":50750,"_5":14613,"_27884":50703,"_3010":50751},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3554":229,"_30673":212,"_21251":50753,"_5":14613,"_27884":50703,"_3010":50754},[],"a reachable RabbitMQ broker and credentials",{"_3554":230,"_30673":212,"_21251":50756,"_5":14613,"_27884":50703,"_3010":50757},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3554":231,"_30673":212,"_21251":50759,"_5":14613,"_27884":50703,"_3010":50760},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3554":232,"_30673":212,"_21251":50762,"_5":14613,"_27884":50703,"_3010":50763},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3554":233,"_30673":212,"_21251":50765,"_5":14613,"_27884":50703,"_3010":50766},[],"a StorageClass and an external traffic design",{"_3554":234,"_30673":212,"_21251":50768,"_5":14613,"_27884":50703,"_3010":50769},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3554":235,"_30673":212,"_21251":50771,"_5":14613,"_27884":50703,"_3010":50772},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3554":236,"_30673":212,"_21251":50774,"_5":14613,"_27884":50703,"_3010":50775},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3554":237,"_30673":212,"_21251":50777,"_5":14613,"_27884":50706,"_3010":50778},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3554":238,"_30673":212,"_21251":50780,"_5":14613,"_27884":50706,"_3010":50781},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3554":239,"_30673":212,"_21251":50783,"_5":14613,"_27884":50706,"_3010":50784},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3554":240,"_30673":212,"_21251":50786,"_5":14613,"_27884":50710,"_3010":50787},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3554":241,"_30673":212,"_21251":50789,"_5":14613,"_27884":50710,"_3010":50790},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3554":242,"_30673":212,"_21251":50792,"_5":14613,"_27884":50710,"_3010":50793},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3554":243,"_30673":212,"_21251":50795,"_5":14613,"_27884":50710,"_3010":50796},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3554":244,"_30673":212,"_21251":50798,"_5":14613,"_27884":50714,"_3010":50799},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3554":245,"_30673":212,"_21251":50801,"_5":14613,"_27884":50718,"_3010":50802},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3554":246,"_30673":212,"_21251":50804,"_5":14613,"_27884":50718,"_3010":50805},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3554":247,"_30673":212,"_21251":50807,"_5":14613,"_27884":50718,"_3010":50808},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3554":248,"_30673":212,"_21251":50810,"_5":14613,"_27884":50718,"_3010":50811},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3554":249,"_30673":212,"_21251":50813,"_5":14613,"_27884":50718,"_3010":50814},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3554":250,"_30673":212,"_21251":50816,"_5":14613,"_27884":50718,"_3010":50817},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3554":251,"_30673":212,"_21251":50819,"_5":14613,"_27884":50718,"_3010":50820},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3554":252,"_30673":212,"_21251":50822,"_5":14613,"_27884":50722,"_3010":50823},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3554":253,"_30673":212,"_21251":50825,"_5":14613,"_27884":50722,"_3010":50826},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3554":254,"_30673":212,"_21251":50828,"_5":14613,"_27884":50722,"_3010":50829},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3554":255,"_30673":212,"_21251":50831,"_5":14613,"_27884":50722,"_3010":50832},[],"See Access control for the principal and policy model.",{"_3554":256,"_30673":212,"_21251":50834,"_5":14613,"_27884":50726,"_3010":50835},[],"To install a local checkout instead:",{"_3554":257,"_30673":212,"_21251":50837,"_5":14613,"_27884":50730,"_3010":50838},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3554":258,"_30673":212,"_21251":50840,"_5":14613,"_27884":50730,"_3010":50841},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3554":259,"_30673":212,"_21251":50843,"_5":14613,"_27884":50734,"_3010":50844},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3554":260,"_30673":212,"_21251":50846,"_5":14613,"_27884":50734,"_3010":50847},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3554":261,"_30673":212,"_21251":50849,"_5":14613,"_27884":50734,"_3010":50850},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3554":262,"_30673":212,"_21251":50852,"_5":14613,"_27884":50734,"_3010":50853},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3554":263,"_30673":212,"_21251":50855,"_5":14613,"_27884":50734,"_3010":50856},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3554":264,"_30673":212,"_21251":50858,"_5":14613,"_27884":50738,"_3010":50859},[],"Before going live, review:",{"_3554":265,"_30673":212,"_21251":50861,"_5":14613,"_27884":50738,"_3010":50862},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3554":266,"_30673":212,"_21251":50864,"_5":14613,"_27884":50738,"_3010":50865},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3554":267,"_30673":212,"_21251":50867,"_5":14613,"_27884":50738,"_3010":50868},[],"shared VA storage before increasing VA replicas",{"_3554":268,"_30673":212,"_21251":50870,"_5":14613,"_27884":50738,"_3010":50871},[],"managed OIDC roles and removal of evaluation credentials",{"_3554":269,"_30673":212,"_21251":50873,"_5":14613,"_27884":50738,"_3010":50874},[],"a trusted TLS issuer or externally managed certificate",{"_3554":270,"_30673":212,"_21251":50876,"_5":14613,"_27884":50738,"_3010":50877},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3554":271,"_30673":212,"_21251":50879,"_5":14613,"_27884":50738,"_3010":50880},[],"SMTP, observability and alert delivery",{"_3554":272,"_30673":212,"_21251":50882,"_5":14613,"_27884":50738,"_3010":50883},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3554":273,"_30673":212,"_21251":50885,"_5":14613,"_27884":50738,"_3010":50886},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3554":274,"_30673":274,"_5":14965,"_3010":50888,"_31032":50889,"_21251":50890,"_27884":274},"Expose the Gateway",[50083,50084,50190],[],{"_3554":275,"_30673":274,"_21251":50892,"_5":14613,"_27884":274,"_3010":50893},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3554":276,"_30673":274,"_5":31029,"_21251":50895,"_27884":50896,"_3010":50897},[],"/docs/pr-preview/pr-69/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3554":277,"_30673":274,"_5":31029,"_21251":50899,"_27884":50900,"_3010":50901},[],"/docs/pr-preview/pr-69/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3554":278,"_30673":274,"_5":31029,"_21251":50903,"_27884":50904,"_3010":50905},[],"/docs/pr-preview/pr-69/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3554":279,"_30673":274,"_5":31029,"_21251":50907,"_27884":50908,"_3010":50909},[],"/docs/pr-preview/pr-69/deployment/self-hosted/networking#k3s","K3s",{"_3554":280,"_30673":274,"_5":31029,"_21251":50911,"_27884":50912,"_3010":50913},[],"/docs/pr-preview/pr-69/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3554":281,"_30673":274,"_5":31029,"_21251":50915,"_27884":50916,"_3010":50917},[],"/docs/pr-preview/pr-69/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3554":282,"_30673":274,"_5":31029,"_21251":50919,"_27884":50920,"_3010":50921},[],"/docs/pr-preview/pr-69/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3554":283,"_30673":274,"_5":31029,"_21251":50923,"_27884":50924,"_3010":50925},[],"/docs/pr-preview/pr-69/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3554":284,"_30673":274,"_5":31029,"_21251":50927,"_27884":50928,"_3010":50929},[],"/docs/pr-preview/pr-69/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3554":285,"_30673":274,"_5":31029,"_21251":50931,"_27884":50932,"_3010":50933},[],"/docs/pr-preview/pr-69/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3554":286,"_30673":274,"_5":31029,"_21251":50935,"_27884":50936,"_3010":50937},[],"/docs/pr-preview/pr-69/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3554":287,"_30673":274,"_21251":50939,"_5":14613,"_27884":50896,"_3010":50940},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3554":288,"_30673":274,"_21251":50942,"_5":14613,"_27884":50896,"_3010":50943},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3554":289,"_30673":274,"_21251":50945,"_5":14613,"_27884":50900,"_3010":50946},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3554":290,"_30673":274,"_21251":50948,"_5":14613,"_27884":50900,"_3010":50949},[],"Set it only when:",{"_3554":291,"_30673":274,"_21251":50951,"_5":14613,"_27884":50900,"_3010":50952},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3554":292,"_30673":274,"_21251":50954,"_5":14613,"_27884":50900,"_3010":50955},[],"that address is allocated to this Gateway",{"_3554":293,"_30673":274,"_21251":50957,"_5":14613,"_27884":50900,"_3010":50958},[],"the surrounding network already routes traffic for it to the cluster",{"_3554":294,"_30673":274,"_21251":50960,"_5":14613,"_27884":50900,"_3010":50961},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3554":295,"_30673":274,"_21251":50963,"_5":14613,"_27884":50900,"_3010":50964},[],"Keep these two settings separate:",{"_3554":296,"_30673":274,"_21251":50966,"_5":14613,"_27884":50900,"_3010":50967},[],"`gateway.addresses` requests an address for the Gateway.",{"_3554":297,"_30673":274,"_21251":50969,"_5":14613,"_27884":50900,"_3010":50970},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3554":298,"_30673":274,"_21251":50972,"_5":14613,"_27884":50900,"_3010":50973},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3554":299,"_30673":274,"_21251":50975,"_5":14613,"_27884":50904,"_3010":50976},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3554":300,"_30673":274,"_21251":50978,"_5":14613,"_27884":50904,"_3010":50979},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3554":301,"_30673":274,"_21251":50981,"_5":14613,"_27884":50908,"_3010":50982},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3554":302,"_30673":274,"_21251":50984,"_5":14613,"_27884":50908,"_3010":50985},[],"For the recommended design:",{"_3554":303,"_30673":274,"_21251":50987,"_5":14613,"_27884":50908,"_3010":50988},[],"Use only one externally exposed Lamassu Gateway.",{"_3554":304,"_30673":274,"_21251":50990,"_5":14613,"_27884":50908,"_3010":50991},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3554":305,"_30673":274,"_21251":50993,"_5":14613,"_27884":50908,"_3010":50994},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3554":306,"_30673":274,"_21251":50996,"_5":14613,"_27884":50908,"_3010":50997},[],"Point DNS at the VM's reachable address.",{"_3554":307,"_30673":274,"_21251":50999,"_5":14613,"_27884":50908,"_3010":51000},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3554":308,"_30673":274,"_21251":51002,"_5":14613,"_27884":50912,"_3010":51003},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3554":309,"_30673":274,"_21251":51005,"_5":14613,"_27884":50916,"_3010":51006},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3554":310,"_30673":274,"_21251":51008,"_5":14613,"_27884":50916,"_3010":51009},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3554":311,"_30673":274,"_21251":51011,"_5":14613,"_27884":50920,"_3010":51012},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3554":312,"_30673":274,"_21251":51014,"_5":14613,"_27884":50920,"_3010":51015},[],"Requirement",{"_3554":313,"_30673":274,"_21251":51017,"_5":14613,"_27884":50920,"_3010":51018},[],"Recommended design",{"_3554":314,"_30673":274,"_21251":51020,"_5":14613,"_27884":50920,"_3010":51021},[],"Consequence",{"_3554":315,"_30673":274,"_21251":51023,"_5":14613,"_27884":50920,"_3010":51024},[],"Several Lamassu URLs or services",{"_3554":316,"_30673":274,"_21251":51026,"_5":14613,"_27884":50920,"_3010":51027},[],"One Gateway with multiple routes",{"_3554":317,"_30673":274,"_21251":51029,"_5":14613,"_27884":50920,"_3010":51030},[],"One IP and one proxy fleet; this is the chart default",{"_3554":318,"_30673":274,"_21251":51032,"_5":14613,"_27884":50920,"_3010":51033},[],"Independent Gateways and separate external IPs",{"_3554":319,"_30673":274,"_21251":51035,"_5":14613,"_27884":50920,"_3010":51036},[],"One VIP per Gateway",{"_3554":320,"_30673":274,"_21251":51038,"_5":14613,"_27884":50920,"_3010":51039},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3554":321,"_30673":274,"_21251":51041,"_5":14613,"_27884":50920,"_3010":51042},[],"Independent Gateways on one node and one IP",{"_3554":322,"_30673":274,"_21251":51044,"_5":14613,"_27884":50920,"_3010":51045},[],"Use different external ports",{"_3554":323,"_30673":274,"_21251":51047,"_5":14613,"_27884":50920,"_3010":51048},[],"Clients must include non-standard ports",{"_3554":324,"_30673":274,"_21251":51050,"_5":14613,"_27884":50920,"_3010":51051},[],"Separate TLS/mTLS termination behind one IP",{"_3554":325,"_30673":274,"_21251":51053,"_5":14613,"_27884":50920,"_3010":51054},[],"Front-door SNI routing to internal Gateways",{"_3554":326,"_30673":274,"_21251":51056,"_5":14613,"_27884":50920,"_3010":51057},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3554":327,"_30673":274,"_21251":51059,"_5":14613,"_27884":50920,"_3010":51060},[],"Separate Gateway resources but shared proxy infrastructure",{"_3554":328,"_30673":274,"_21251":51062,"_5":14613,"_27884":50920,"_3010":51063},[],"Envoy merged-Gateway mode",{"_3554":329,"_30673":274,"_21251":51065,"_5":14613,"_27884":50920,"_3010":51066},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3554":330,"_30673":274,"_21251":51068,"_5":14613,"_27884":50920,"_3010":51069},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3554":331,"_30673":274,"_21251":51071,"_5":14613,"_27884":50920,"_3010":51072},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3554":332,"_30673":274,"_21251":51074,"_5":14613,"_27884":50920,"_3010":51075},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3554":333,"_30673":274,"_21251":51077,"_5":14613,"_27884":50920,"_3010":51078},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3554":334,"_30673":274,"_21251":51080,"_5":14613,"_27884":50924,"_3010":51081},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3554":335,"_30673":274,"_21251":51083,"_5":14613,"_27884":50928,"_3010":51084},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3554":336,"_30673":274,"_21251":51086,"_5":14613,"_27884":50928,"_3010":51087},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3554":337,"_30673":274,"_21251":51089,"_5":14613,"_27884":50928,"_3010":51090},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3554":338,"_30673":274,"_21251":51092,"_5":14613,"_27884":50928,"_3010":51093},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3554":339,"_30673":274,"_21251":51095,"_5":14613,"_27884":50928,"_3010":51096},[],"If none of those are possible, use different external ports or change the external network design.",{"_3554":340,"_30673":274,"_21251":51098,"_5":14613,"_27884":50932,"_3010":51099},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3554":341,"_30673":274,"_21251":51101,"_5":14613,"_27884":50932,"_3010":51102},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3554":342,"_30673":274,"_21251":51104,"_5":14613,"_27884":50936,"_3010":51105},[],"Check, in order:",{"_3554":343,"_30673":274,"_21251":51107,"_5":14613,"_27884":50936,"_3010":51108},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3554":344,"_30673":274,"_21251":51110,"_5":14613,"_27884":50936,"_3010":51111},[],"Its status contains the expected address.",{"_3554":345,"_30673":274,"_21251":51113,"_5":14613,"_27884":50936,"_3010":51114},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3554":346,"_30673":274,"_21251":51116,"_5":14613,"_27884":50936,"_3010":51117},[],"Port 443 reaches that address from the client network.",{"_3554":347,"_30673":274,"_21251":51119,"_5":14613,"_27884":50936,"_3010":51120},[],"DNS resolves to the externally reachable endpoint.",{"_3554":348,"_30673":274,"_21251":51122,"_5":14613,"_27884":50936,"_3010":51123},[],"The certificate contains the DNS name or IP used by the client.",{"_3554":349,"_30673":274,"_21251":51125,"_5":14613,"_27884":50936,"_3010":51126},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3554":350,"_30673":350,"_5":14965,"_3010":50190,"_31032":51128,"_21251":51129,"_27884":350},[50083,50084,50190],[],{"_3554":351,"_30673":350,"_21251":51131,"_5":14613,"_27884":350,"_3010":51132},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3554":352,"_30673":350,"_5":31029,"_21251":51134,"_27884":51135,"_3010":51136},[],"/docs/pr-preview/pr-69/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3554":353,"_30673":350,"_5":31029,"_21251":51138,"_27884":51139,"_3010":51140},[],"/docs/pr-preview/pr-69/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3554":354,"_30673":350,"_5":31029,"_21251":51142,"_27884":51143,"_3010":51144},[],"/docs/pr-preview/pr-69/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3554":355,"_30673":350,"_5":31029,"_21251":51146,"_27884":51147,"_3010":51148},[],"/docs/pr-preview/pr-69/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3554":356,"_30673":350,"_5":31029,"_21251":51150,"_27884":51151,"_3010":51152},[],"/docs/pr-preview/pr-69/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3554":357,"_30673":350,"_5":31029,"_21251":51154,"_27884":51155,"_3010":51156},[],"/docs/pr-preview/pr-69/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3554":358,"_30673":350,"_21251":51158,"_5":14613,"_27884":51135,"_3010":51159},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3554":359,"_30673":350,"_21251":51161,"_5":14613,"_27884":51139,"_3010":51162},[],"Workflow",{"_3554":360,"_30673":350,"_21251":51164,"_5":14613,"_27884":51139,"_3010":51165},[],"Use it for",{"_3554":361,"_30673":350,"_21251":51167,"_5":14613,"_27884":51139,"_3010":51168},[],"What it installs",{"_3554":362,"_30673":350,"_21251":51170,"_5":14613,"_27884":51139,"_3010":51171},[],"Helm",{"_3554":363,"_30673":350,"_21251":51173,"_5":14613,"_27884":51139,"_3010":51174},[],"Production and controlled environments",{"_3554":364,"_30673":350,"_21251":51176,"_5":14613,"_27884":51139,"_3010":51177},[],"Lamassu services and Gateway API resources",{"_3554":365,"_30673":350,"_21251":51179,"_5":14613,"_27884":51139,"_3010":50327},[],{"_3554":366,"_30673":350,"_21251":51181,"_5":14613,"_27884":51139,"_3010":51182},[],"Evaluation, demos, CI and small lab clusters",{"_3554":367,"_30673":350,"_21251":51184,"_5":14613,"_27884":51139,"_3010":51185},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3554":368,"_30673":350,"_21251":51187,"_5":14613,"_27884":51143,"_3010":51188},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3554":369,"_30673":350,"_21251":51190,"_5":14613,"_27884":51143,"_3010":51191},[],"Area",{"_3554":370,"_30673":350,"_21251":51193,"_5":14613,"_27884":51143,"_3010":51194},[],"The Lamassu chart provides",{"_3554":371,"_30673":350,"_21251":51196,"_5":14613,"_27884":51143,"_3010":51197},[],"You provide",{"_3554":372,"_30673":350,"_21251":51199,"_5":14613,"_27884":51143,"_3010":51200},[],"Lamassu applications",{"_3554":373,"_30673":350,"_21251":51202,"_5":14613,"_27884":51143,"_3010":51203},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3554":374,"_30673":350,"_21251":51205,"_5":14613,"_27884":51143,"_3010":51206},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3554":375,"_30673":350,"_21251":51208,"_5":14613,"_27884":51143,"_3010":51209},[],"PostgreSQL data",{"_3554":376,"_30673":350,"_21251":51211,"_5":14613,"_27884":51143,"_3010":51212},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3554":377,"_30673":350,"_21251":51214,"_5":14613,"_27884":51143,"_3010":51215},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3554":378,"_30673":350,"_21251":51217,"_5":14613,"_27884":51143,"_3010":51218},[],"Messaging",{"_3554":379,"_30673":350,"_21251":51220,"_5":14613,"_27884":51143,"_3010":51221},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3554":380,"_30673":350,"_21251":51223,"_5":14613,"_27884":51143,"_3010":51224},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3554":381,"_30673":350,"_21251":51226,"_5":14613,"_27884":51143,"_3010":51227},[],"Identity",{"_3554":382,"_30673":350,"_21251":51229,"_5":14613,"_27884":51143,"_3010":51230},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3554":383,"_30673":350,"_21251":51232,"_5":14613,"_27884":51143,"_3010":51233},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3554":384,"_30673":350,"_21251":51235,"_5":14613,"_27884":51143,"_3010":51236},[],"External routing",{"_3554":385,"_30673":350,"_21251":51238,"_5":14613,"_27884":51143,"_3010":51239},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3554":386,"_30673":350,"_21251":51241,"_5":14613,"_27884":51143,"_3010":51242},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3554":387,"_30673":350,"_21251":51244,"_5":14613,"_27884":51143,"_3010":51245},[],"TLS",{"_3554":388,"_30673":350,"_21251":51247,"_5":14613,"_27884":51143,"_3010":51248},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3554":389,"_30673":350,"_21251":51250,"_5":14613,"_27884":51143,"_3010":51251},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3554":390,"_30673":350,"_21251":51253,"_5":14613,"_27884":51143,"_3010":51254},[],"Persistent application data",{"_3554":391,"_30673":350,"_21251":51256,"_5":14613,"_27884":51143,"_3010":51257},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3554":392,"_30673":350,"_21251":51259,"_5":14613,"_27884":51143,"_3010":51260},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3554":393,"_30673":350,"_21251":51262,"_5":14613,"_27884":51143,"_3010":51263},[],"Optional integrations",{"_3554":394,"_30673":350,"_21251":51265,"_5":14613,"_27884":51143,"_3010":51266},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3554":395,"_30673":350,"_21251":51268,"_5":14613,"_27884":51143,"_3010":51269},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3554":396,"_30673":350,"_21251":51271,"_5":14613,"_27884":51143,"_3010":51272},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3554":397,"_30673":350,"_21251":51274,"_5":14613,"_27884":51143,"_3010":51275},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3554":398,"_30673":350,"_21251":51277,"_5":14613,"_27884":51147,"_3010":51278},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3554":399,"_30673":350,"_21251":51280,"_5":14613,"_27884":51147,"_3010":51281},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3554":400,"_30673":350,"_21251":51283,"_5":14613,"_27884":51151,"_3010":51284},[],"Kubernetes 1.24 or newer",{"_3554":401,"_30673":350,"_21251":51286,"_5":14613,"_27884":51151,"_3010":51287},[],"Helm 3.2 or newer",{"_3554":402,"_30673":350,"_21251":51289,"_5":14613,"_27884":51151,"_3010":51290},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3554":403,"_30673":350,"_21251":51292,"_5":14613,"_27884":51151,"_3010":51293},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3554":404,"_30673":350,"_21251":51295,"_5":14613,"_27884":51151,"_3010":51296},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3554":405,"_30673":350,"_21251":51298,"_5":14613,"_27884":51151,"_3010":51299},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3554":406,"_30673":350,"_21251":51301,"_5":14613,"_27884":51151,"_3010":51302},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3554":407,"_30673":350,"_21251":51304,"_5":14613,"_27884":51155,"_3010":51305},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3554":408,"_30673":350,"_21251":51307,"_5":14613,"_27884":51155,"_3010":51308},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3554":409,"_30673":350,"_21251":51310,"_5":14613,"_27884":51155,"_3010":51311},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3554":410,"_30673":350,"_21251":51313,"_5":14613,"_27884":51155,"_3010":51314},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3554":411,"_30673":411,"_5":14965,"_3010":51316,"_31032":51317,"_21251":51319,"_27884":411},"Deployment troubleshooting",[50083,50084,51318],"Operations",[],{"_3554":412,"_30673":411,"_21251":51321,"_5":14613,"_27884":411,"_3010":51322},[],"Diagnose access, service health and infrastructure dependencies.",{"_3554":413,"_30673":411,"_5":31029,"_21251":51324,"_27884":51325,"_3010":51326},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3554":414,"_30673":411,"_5":31029,"_21251":51328,"_27884":51329,"_3010":51330},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3554":415,"_30673":411,"_5":31029,"_21251":51332,"_27884":51333,"_3010":51334},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3554":416,"_30673":411,"_5":31029,"_21251":51336,"_27884":51337,"_3010":51338},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3554":417,"_30673":411,"_5":31029,"_21251":51340,"_27884":51341,"_3010":51342},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3554":418,"_30673":411,"_5":31029,"_21251":51344,"_27884":51345,"_3010":51346},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3554":419,"_30673":411,"_5":31029,"_21251":51348,"_27884":51349,"_3010":51350},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3554":420,"_30673":411,"_5":31029,"_21251":51352,"_27884":51353,"_3010":51354},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3554":421,"_30673":411,"_5":31029,"_21251":51356,"_27884":51357,"_3010":51358},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3554":422,"_30673":411,"_5":31029,"_21251":51360,"_27884":51361,"_3010":51362},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3554":423,"_30673":411,"_5":31029,"_21251":51364,"_27884":51365,"_3010":51366},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3554":424,"_30673":411,"_5":31029,"_21251":51368,"_27884":51369,"_3010":51370},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3554":425,"_30673":411,"_5":31029,"_21251":51372,"_27884":51373,"_3010":51374},[],"/docs/pr-preview/pr-69/deployment/troubleshooting#observability","Observability",{"_3554":426,"_30673":411,"_21251":51376,"_5":14613,"_27884":411,"_3010":51377},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3554":427,"_30673":411,"_21251":51379,"_5":14613,"_27884":51329,"_3010":51380},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3554":428,"_30673":411,"_21251":51382,"_5":14613,"_27884":51333,"_3010":51383},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3554":429,"_30673":411,"_21251":51385,"_5":14613,"_27884":51337,"_3010":51386},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3554":430,"_30673":411,"_21251":51388,"_5":14613,"_27884":51341,"_3010":51389},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3554":431,"_30673":411,"_21251":51391,"_5":14613,"_27884":51345,"_3010":51392},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3554":432,"_30673":411,"_21251":51394,"_5":14613,"_27884":51349,"_3010":51395},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3554":433,"_30673":411,"_21251":51397,"_5":14613,"_27884":51349,"_3010":51398},[],"Also run the chart's connectivity test:",{"_3554":434,"_30673":411,"_21251":51400,"_5":14613,"_27884":51349,"_3010":51401},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3554":435,"_30673":411,"_21251":51403,"_5":14613,"_27884":51349,"_3010":51404},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3554":436,"_30673":411,"_21251":51406,"_5":14613,"_27884":51353,"_3010":51407},[],"If you receive a 401:",{"_3554":437,"_30673":411,"_21251":51409,"_5":14613,"_27884":51353,"_3010":51410},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3554":438,"_30673":411,"_21251":51412,"_5":14613,"_27884":51353,"_3010":51413},[],"verify issuer, audience and expiration of the token;",{"_3554":439,"_30673":411,"_21251":51415,"_5":14613,"_27884":51353,"_3010":51416},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3554":440,"_30673":411,"_21251":51418,"_5":14613,"_27884":51353,"_3010":51419},[],"check that the provider's public and internal routes point to the same realm.",{"_3554":441,"_30673":411,"_21251":51421,"_5":14613,"_27884":51353,"_3010":51422},[],"If login succeeds but the APIs return 403:",{"_3554":442,"_30673":411,"_21251":51424,"_5":14613,"_27884":51353,"_3010":51425},[],"inspect the token's real claims;",{"_3554":443,"_30673":411,"_21251":51427,"_5":14613,"_27884":51353,"_3010":51428},[],"confirm they match an active principal;",{"_3554":444,"_30673":411,"_21251":51430,"_5":14613,"_27884":51353,"_3010":51431},[],"review the policies granted to that principal;",{"_3554":445,"_30673":411,"_21251":51433,"_5":14613,"_27884":51353,"_3010":51434},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3554":446,"_30673":411,"_21251":51436,"_5":14613,"_27884":51353,"_3010":51437},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3554":447,"_30673":411,"_21251":51439,"_5":14613,"_27884":51357,"_3010":51440},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3554":448,"_30673":411,"_21251":51442,"_5":14613,"_27884":51357,"_3010":51443},[],"Locate the authz pod and Service.",{"_3554":449,"_30673":411,"_21251":51445,"_5":14613,"_27884":51357,"_3010":51446},[],"Check /health, logs and its database connection.",{"_3554":450,"_30673":411,"_21251":51448,"_5":14613,"_27884":51357,"_3010":51449},[],"Verify the DNS and port configured in externalAuthorization.",{"_3554":451,"_30673":411,"_21251":51451,"_5":14613,"_27884":51357,"_3010":51452},[],"Check the check route is /v1/ext\\_authz/check.",{"_3554":452,"_30673":411,"_21251":51454,"_5":14613,"_27884":51357,"_3010":51455},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3554":453,"_30673":411,"_21251":51457,"_5":14613,"_27884":51361,"_3010":51458},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3554":454,"_30673":411,"_21251":51460,"_5":14613,"_27884":51365,"_3010":51461},[],"Review kubectl describe pod first. Common causes are:",{"_3554":455,"_30673":411,"_21251":51463,"_5":14613,"_27884":51365,"_3010":51464},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3554":456,"_30673":411,"_21251":51466,"_5":14613,"_27884":51365,"_3010":51467},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3554":457,"_30673":411,"_21251":51469,"_5":14613,"_27884":51365,"_3010":51470},[],"unbound persistent volume;",{"_3554":458,"_30673":411,"_21251":51472,"_5":14613,"_27884":51365,"_3010":51473},[],"inaccessible image or incorrect pull policy;",{"_3554":459,"_30673":411,"_21251":51475,"_5":14613,"_27884":51365,"_3010":51476},[],"invalid cryptographic engine configuration;",{"_3554":460,"_30673":411,"_21251":51478,"_5":14613,"_27884":51365,"_3010":51479},[],"CPU or memory limits set too low;",{"_3554":461,"_30673":411,"_21251":51481,"_5":14613,"_27884":51365,"_3010":51482},[],"an incomplete prior migration.",{"_3554":462,"_30673":411,"_21251":51484,"_5":14613,"_27884":51365,"_3010":51485},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3554":463,"_30673":411,"_21251":51487,"_5":14613,"_27884":51365,"_3010":51488},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3554":464,"_30673":411,"_21251":51490,"_5":14613,"_27884":51365,"_3010":51491},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3554":465,"_30673":411,"_21251":51493,"_5":14613,"_27884":51369,"_3010":51494},[],"Domain and audit events depend on the bus publisher:",{"_3554":466,"_30673":411,"_21251":51496,"_5":14613,"_27884":51369,"_3010":51497},[],"verify it is enabled in the emitting service;",{"_3554":467,"_30673":411,"_21251":51499,"_5":14613,"_27884":51369,"_3010":51500},[],"check AMQP connectivity and credentials;",{"_3554":468,"_30673":411,"_21251":51502,"_5":14613,"_27884":51369,"_3010":51503},[],"review exchange, routing key, queues and consumers;",{"_3554":469,"_30673":411,"_21251":51505,"_5":14613,"_27884":51369,"_3010":51506},[],"inspect dead-letter queues;",{"_3554":470,"_30673":411,"_21251":51508,"_5":14613,"_27884":51369,"_3010":51509},[],"alert on orphan durable queues and backlog growth.",{"_3554":471,"_30673":411,"_21251":51511,"_5":14613,"_27884":51369,"_3010":51512},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3554":472,"_30673":411,"_21251":51514,"_5":14613,"_27884":51369,"_3010":51515},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3554":473,"_30673":411,"_21251":51517,"_5":14613,"_27884":51369,"_3010":51518},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3554":474,"_30673":411,"_21251":51520,"_5":14613,"_27884":51369,"_3010":51521},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3554":475,"_30673":411,"_21251":51523,"_5":14613,"_27884":51369,"_3010":51524},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3554":476,"_30673":411,"_21251":51526,"_5":14613,"_27884":51369,"_3010":51527},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3554":477,"_30673":411,"_21251":51529,"_5":14613,"_27884":51369,"_3010":51530},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3554":478,"_30673":411,"_21251":51532,"_5":14613,"_27884":51373,"_3010":51533},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3554":479,"_30673":411,"_21251":51535,"_5":14613,"_27884":51373,"_3010":51536},[],"Before closing an incident, record:",{"_3554":480,"_30673":411,"_21251":51538,"_5":14613,"_27884":51373,"_3010":51539},[],"the confirmed cause;",{"_3554":481,"_30673":411,"_21251":51541,"_5":14613,"_27884":51373,"_3010":51542},[],"the time scope and affected resources;",{"_3554":482,"_30673":411,"_21251":51544,"_5":14613,"_27884":51373,"_3010":51545},[],"the commands or queries used;",{"_3554":483,"_30673":411,"_21251":51547,"_5":14613,"_27884":51373,"_3010":51548},[],"the applied change and how to revert it;",{"_3554":484,"_30673":411,"_21251":51550,"_5":14613,"_27884":51373,"_3010":51551},[],"validation from a consumer;",{"_3554":485,"_30673":411,"_21251":51553,"_5":14613,"_27884":51373,"_3010":51554},[],"the preventive action and its owner.",{"_3554":486,"_30673":486,"_5":14965,"_3010":51556,"_31032":51557,"_21251":51561,"_27884":486},"Data model",[50083,51558,51559,51560],"Platform","Administration","Access control",[],{"_3554":487,"_30673":486,"_21251":51563,"_5":14613,"_27884":486,"_3010":51564},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3554":488,"_30673":486,"_5":31029,"_21251":51566,"_27884":51567,"_3010":51568},[],"/docs/pr-preview/pr-69/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3554":489,"_30673":486,"_5":31029,"_21251":51570,"_27884":51571,"_3010":51572},[],"/docs/pr-preview/pr-69/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3554":490,"_30673":486,"_21251":51574,"_5":14613,"_27884":486,"_3010":51575},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3554":491,"_30673":486,"_21251":51577,"_5":14613,"_27884":51567,"_3010":51578},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3554":492,"_30673":486,"_21251":51580,"_5":14613,"_27884":51567,"_3010":51581},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3554":493,"_30673":486,"_21251":51583,"_5":14613,"_27884":51567,"_3010":51584},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3554":494,"_30673":486,"_21251":51586,"_5":14613,"_27884":51571,"_3010":51587},[],"Entity (`schema_name.entity_type`)",{"_3554":495,"_30673":486,"_21251":51589,"_5":14613,"_27884":51571,"_3010":51590},[],"Table (`table_name`)",{"_3554":496,"_30673":486,"_21251":51592,"_5":14613,"_27884":51571,"_3010":51593},[],"Key (`primary_key`)",{"_3554":497,"_30673":486,"_21251":51595,"_5":14613,"_27884":51571,"_3010":51596},[],"`alerts.event`",{"_3554":498,"_30673":486,"_21251":51598,"_5":14613,"_27884":51571,"_3010":51599},[],"`events`",{"_3554":499,"_30673":486,"_21251":51601,"_5":14613,"_27884":51571,"_3010":51602},[],"`event_type`",{"_3554":500,"_30673":486,"_21251":51604,"_5":14613,"_27884":51571,"_3010":51605},[],"`alerts.subscription`",{"_3554":501,"_30673":486,"_21251":51607,"_5":14613,"_27884":51571,"_3010":51608},[],"`subscriptions`",{"_3554":502,"_30673":486,"_21251":51610,"_5":14613,"_27884":51571,"_3010":51611},[],"`id`",{"_3554":503,"_30673":486,"_21251":51613,"_5":14613,"_27884":51571,"_3010":51614},[],"`ca.ca_certificate`",{"_3554":504,"_30673":486,"_21251":51616,"_5":14613,"_27884":51571,"_3010":51617},[],"`ca_certificates`",{"_3554":505,"_30673":486,"_21251":51619,"_5":14613,"_27884":51571,"_3010":51611},[],{"_3554":506,"_30673":486,"_21251":51621,"_5":14613,"_27884":51571,"_3010":51622},[],"`ca.certificate`",{"_3554":507,"_30673":486,"_21251":51624,"_5":14613,"_27884":51571,"_3010":51625},[],"`certificates`",{"_3554":508,"_30673":486,"_21251":51627,"_5":14613,"_27884":51571,"_3010":51628},[],"`serial_number`",{"_3554":509,"_30673":486,"_21251":51630,"_5":14613,"_27884":51571,"_3010":51631},[],"`ca.issuance_profile`",{"_3554":510,"_30673":486,"_21251":51633,"_5":14613,"_27884":51571,"_3010":51634},[],"`issuance_profiles`",{"_3554":511,"_30673":486,"_21251":51636,"_5":14613,"_27884":51571,"_3010":51611},[],{"_3554":512,"_30673":486,"_21251":51638,"_5":14613,"_27884":51571,"_3010":51639},[],"`devicemanager.device_group`",{"_3554":513,"_30673":486,"_21251":51641,"_5":14613,"_27884":51571,"_3010":51642},[],"`device_groups`",{"_3554":514,"_30673":486,"_21251":51644,"_5":14613,"_27884":51571,"_3010":51611},[],{"_3554":515,"_30673":486,"_21251":51646,"_5":14613,"_27884":51571,"_3010":51647},[],"`devicemanager.device`",{"_3554":516,"_30673":486,"_21251":51649,"_5":14613,"_27884":51571,"_3010":51650},[],"`devices`",{"_3554":517,"_30673":486,"_21251":51652,"_5":14613,"_27884":51571,"_3010":51611},[],{"_3554":518,"_30673":486,"_21251":51654,"_5":14613,"_27884":51571,"_3010":51655},[],"`dmsmanager.dms`",{"_3554":519,"_30673":486,"_21251":51657,"_5":14613,"_27884":51571,"_3010":51658},[],"`dms`",{"_3554":520,"_30673":486,"_21251":51660,"_5":14613,"_27884":51571,"_3010":51611},[],{"_3554":521,"_30673":486,"_21251":51662,"_5":14613,"_27884":51571,"_3010":51663},[],"`kms.kms_key`",{"_3554":522,"_30673":486,"_21251":51665,"_5":14613,"_27884":51571,"_3010":51666},[],"`kms_keys`",{"_3554":523,"_30673":486,"_21251":51668,"_5":14613,"_27884":51571,"_3010":51669},[],"`key_id`, `engine_id`",{"_3554":524,"_30673":486,"_21251":51671,"_5":14613,"_27884":51571,"_3010":51672},[],"`va.crl_settings`",{"_3554":525,"_30673":486,"_21251":51674,"_5":14613,"_27884":51571,"_3010":51675},[],"`crl_settings`",{"_3554":526,"_30673":486,"_21251":51677,"_5":14613,"_27884":51571,"_3010":51678},[],"`ca_id`",{"_3554":527,"_30673":486,"_21251":51680,"_5":14613,"_27884":51571,"_3010":51681},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3554":528,"_30673":486,"_21251":51683,"_5":14613,"_27884":51571,"_3010":51684},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3554":529,"_30673":486,"_21251":51686,"_5":14613,"_27884":51571,"_3010":51687},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3554":530,"_30673":530,"_5":14965,"_3010":51689,"_31032":51690,"_21251":51691,"_27884":530},"Access control overview",[50083,51558,51559,51560],[],{"_3554":531,"_30673":530,"_21251":51693,"_5":14613,"_27884":530,"_3010":51694},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3554":532,"_30673":530,"_5":31029,"_21251":51696,"_27884":51697,"_3010":51698},[],"/docs/pr-preview/pr-69/platform/administration/access-control#essential-concepts","Essential concepts",{"_3554":533,"_30673":530,"_5":31029,"_21251":51700,"_27884":51701,"_3010":51702},[],"/docs/pr-preview/pr-69/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3554":534,"_30673":530,"_5":31029,"_21251":51704,"_27884":51705,"_3010":51706},[],"/docs/pr-preview/pr-69/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3554":535,"_30673":530,"_5":31029,"_21251":51708,"_27884":51709,"_3010":51710},[],"/docs/pr-preview/pr-69/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3554":536,"_30673":530,"_5":31029,"_21251":51712,"_27884":51713,"_3010":51714},[],"/docs/pr-preview/pr-69/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3554":537,"_30673":530,"_5":31029,"_21251":51716,"_27884":51717,"_3010":51718},[],"/docs/pr-preview/pr-69/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3554":538,"_30673":530,"_5":31029,"_21251":51720,"_27884":51721,"_3010":51722},[],"/docs/pr-preview/pr-69/platform/administration/access-control#oidc-principals","OIDC principals",{"_3554":539,"_30673":530,"_5":31029,"_21251":51724,"_27884":51725,"_3010":51726},[],"/docs/pr-preview/pr-69/platform/administration/access-control#x509-principals","X.509 principals",{"_3554":540,"_30673":530,"_5":31029,"_21251":51728,"_27884":51729,"_3010":51730},[],"/docs/pr-preview/pr-69/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3554":541,"_30673":530,"_5":31029,"_21251":51732,"_27884":51733,"_3010":51734},[],"/docs/pr-preview/pr-69/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3554":542,"_30673":530,"_5":31029,"_21251":51736,"_27884":51737,"_3010":51738},[],"/docs/pr-preview/pr-69/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3554":543,"_30673":530,"_5":31029,"_21251":51740,"_27884":51741,"_3010":51742},[],"/docs/pr-preview/pr-69/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3554":544,"_30673":530,"_5":31029,"_21251":51744,"_27884":51745,"_3010":51746},[],"/docs/pr-preview/pr-69/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3554":545,"_30673":530,"_5":31029,"_21251":51748,"_27884":51749,"_3010":51750},[],"/docs/pr-preview/pr-69/platform/administration/access-control#http-rules","HTTP rules",{"_3554":546,"_30673":530,"_5":31029,"_21251":51752,"_27884":51753,"_3010":51754},[],"/docs/pr-preview/pr-69/platform/administration/access-control#included-policies","Included policies",{"_3554":547,"_30673":530,"_5":31029,"_21251":51756,"_27884":51757,"_3010":50723},[],"/docs/pr-preview/pr-69/platform/administration/access-control#provision-the-first-administrator",{"_3554":548,"_30673":530,"_5":31029,"_21251":51759,"_27884":51760,"_3010":51761},[],"/docs/pr-preview/pr-69/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3554":549,"_30673":530,"_5":31029,"_21251":51763,"_27884":51764,"_3010":51765},[],"/docs/pr-preview/pr-69/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3554":550,"_30673":530,"_5":31029,"_21251":51767,"_27884":51768,"_3010":51769},[],"/docs/pr-preview/pr-69/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3554":551,"_30673":530,"_5":31029,"_21251":51771,"_27884":51772,"_3010":51773},[],"/docs/pr-preview/pr-69/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3554":552,"_30673":530,"_5":31029,"_21251":51775,"_27884":51776,"_3010":51777},[],"/docs/pr-preview/pr-69/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3554":553,"_30673":530,"_5":31029,"_21251":51779,"_27884":51780,"_3010":51781},[],"/docs/pr-preview/pr-69/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3554":554,"_30673":530,"_5":31029,"_21251":51783,"_27884":51784,"_3010":51785},[],"/docs/pr-preview/pr-69/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3554":555,"_30673":530,"_5":31029,"_21251":51787,"_27884":51788,"_3010":51789},[],"/docs/pr-preview/pr-69/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3554":556,"_30673":530,"_5":31029,"_21251":51791,"_27884":51792,"_3010":51793},[],"/docs/pr-preview/pr-69/platform/administration/access-control#operational-checklist","Operational checklist",{"_3554":557,"_30673":530,"_5":31029,"_21251":51795,"_27884":51796,"_3010":51797},[],"/docs/pr-preview/pr-69/platform/administration/access-control#diagnostics","Diagnostics",{"_3554":558,"_30673":530,"_5":31029,"_21251":51799,"_27884":51800,"_3010":51801},[],"/docs/pr-preview/pr-69/platform/administration/access-control#the-response-is-401","The response is 401",{"_3554":559,"_30673":530,"_5":31029,"_21251":51803,"_27884":51804,"_3010":51805},[],"/docs/pr-preview/pr-69/platform/administration/access-control#the-response-is-403","The response is 403",{"_3554":560,"_30673":530,"_5":31029,"_21251":51807,"_27884":51808,"_3010":51809},[],"/docs/pr-preview/pr-69/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3554":561,"_30673":530,"_5":31029,"_21251":51811,"_27884":51812,"_3010":51813},[],"/docs/pr-preview/pr-69/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3554":562,"_30673":530,"_5":31029,"_21251":51815,"_27884":51816,"_3010":51817},[],"/docs/pr-preview/pr-69/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3554":563,"_30673":530,"_21251":51819,"_5":14613,"_27884":530,"_3010":51820},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3554":564,"_30673":530,"_21251":51822,"_5":14613,"_27884":530,"_3010":51823},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3554":565,"_30673":530,"_21251":51825,"_5":14613,"_27884":530,"_3010":51826},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3554":566,"_30673":530,"_21251":51828,"_5":14613,"_27884":51697,"_3010":51829},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3554":567,"_30673":530,"_21251":51831,"_5":14613,"_27884":51697,"_3010":51832},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3554":568,"_30673":530,"_21251":51834,"_5":14613,"_27884":51697,"_3010":51835},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3554":569,"_30673":530,"_21251":51837,"_5":14613,"_27884":51697,"_3010":51838},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3554":570,"_30673":530,"_21251":51840,"_5":14613,"_27884":51697,"_3010":51841},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3554":571,"_30673":530,"_21251":51843,"_5":14613,"_27884":51697,"_3010":51844},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3554":572,"_30673":530,"_21251":51846,"_5":14613,"_27884":51701,"_3010":51847},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3554":573,"_30673":530,"_21251":51849,"_5":14613,"_27884":51701,"_3010":51850},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3554":574,"_30673":530,"_21251":51852,"_5":14613,"_27884":51705,"_3010":51853},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3554":575,"_30673":530,"_21251":51855,"_5":14613,"_27884":51705,"_3010":51856},[],"The decision is made **before forwarding the request to the service**:",{"_3554":576,"_30673":530,"_21251":51858,"_5":14613,"_27884":51705,"_3010":51859},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3554":577,"_30673":530,"_21251":51861,"_5":14613,"_27884":51705,"_3010":51862},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3554":578,"_30673":530,"_21251":51864,"_5":14613,"_27884":51705,"_3010":51865},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3554":579,"_30673":530,"_21251":51867,"_5":14613,"_27884":51705,"_3010":51868},[],"It separately loads the policies granted to each principal.",{"_3554":580,"_30673":530,"_21251":51870,"_5":14613,"_27884":51705,"_3010":51871},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3554":581,"_30673":530,"_21251":51873,"_5":14613,"_27884":51705,"_3010":51874},[],"`authz` looks for an HTTP rule granting that action.",{"_3554":582,"_30673":530,"_21251":51876,"_5":14613,"_27884":51705,"_3010":51877},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3554":583,"_30673":530,"_21251":51879,"_5":14613,"_27884":51705,"_3010":51880},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3554":584,"_30673":530,"_21251":51882,"_5":14613,"_27884":51705,"_3010":51883},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3554":585,"_30673":530,"_21251":51885,"_5":14613,"_27884":51705,"_3010":51886},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3554":586,"_30673":530,"_21251":51888,"_5":14613,"_27884":51709,"_3010":51889},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3554":587,"_30673":530,"_21251":51891,"_5":14613,"_27884":51709,"_3010":51892},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3554":588,"_30673":530,"_21251":51894,"_5":14613,"_27884":51709,"_3010":51895},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3554":589,"_30673":530,"_21251":51897,"_5":14613,"_27884":51709,"_3010":51898},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3554":590,"_30673":530,"_21251":51900,"_5":14613,"_27884":51709,"_3010":51901},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3554":591,"_30673":530,"_21251":51903,"_5":14613,"_27884":51709,"_3010":51904},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3554":592,"_30673":530,"_21251":51906,"_5":14613,"_27884":51709,"_3010":51907},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3554":593,"_30673":530,"_21251":51909,"_5":14613,"_27884":51709,"_3010":51910},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3554":594,"_30673":530,"_21251":51912,"_5":14613,"_27884":51709,"_3010":51913},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3554":595,"_30673":530,"_21251":51915,"_5":14613,"_27884":51709,"_3010":51916},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3554":596,"_30673":530,"_21251":51918,"_5":14613,"_27884":51713,"_3010":51919},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3554":597,"_30673":530,"_21251":51921,"_5":14613,"_27884":51713,"_3010":51922},[],"The decision is made with the domain operation context:",{"_3554":598,"_30673":530,"_21251":51924,"_5":14613,"_27884":51713,"_3010":51925},[],"The middleware extracts the credential and resolves the matching principals.",{"_3554":599,"_30673":530,"_21251":51927,"_5":14613,"_27884":51713,"_3010":51928},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3554":600,"_30673":530,"_21251":51930,"_5":14613,"_27884":51713,"_3010":51931},[],"`authz` gathers the entity rules of the granted policies.",{"_3554":601,"_30673":530,"_21251":51933,"_5":14613,"_27884":51713,"_3010":51934},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3554":602,"_30673":530,"_21251":51936,"_5":14613,"_27884":51713,"_3010":51937},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3554":603,"_30673":530,"_21251":51939,"_5":14613,"_27884":51713,"_3010":51940},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3554":604,"_30673":530,"_21251":51942,"_5":14613,"_27884":51713,"_3010":51943},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3554":605,"_30673":530,"_21251":51945,"_5":14613,"_27884":51713,"_3010":51946},[],"Actions fall into two groups:",{"_3554":606,"_30673":530,"_21251":51948,"_5":14613,"_27884":51713,"_3010":51949},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3554":607,"_30673":530,"_21251":51951,"_5":14613,"_27884":51713,"_3010":51952},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3554":608,"_30673":530,"_21251":51954,"_5":14613,"_27884":51713,"_3010":51955},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3554":609,"_30673":530,"_21251":51957,"_5":14613,"_27884":51717,"_3010":51958},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3554":610,"_30673":530,"_21251":51960,"_5":14613,"_27884":51717,"_3010":51961},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3554":611,"_30673":530,"_21251":51963,"_5":14613,"_27884":51717,"_3010":51964},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3554":612,"_30673":530,"_21251":51966,"_5":14613,"_27884":51721,"_3010":51967},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3554":613,"_30673":530,"_21251":51969,"_5":14613,"_27884":51721,"_3010":51970},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3554":614,"_30673":530,"_21251":51972,"_5":14613,"_27884":51721,"_3010":51973},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3554":615,"_30673":530,"_21251":51975,"_5":14613,"_27884":51721,"_3010":51976},[],"The implemented operators are:",{"_3554":616,"_30673":530,"_21251":51978,"_5":14613,"_27884":51721,"_3010":51979},[],"`equals`, for exact equality;",{"_3554":617,"_30673":530,"_21251":51981,"_5":14613,"_27884":51721,"_3010":51982},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3554":618,"_30673":530,"_21251":51984,"_5":14613,"_27884":51721,"_3010":51985},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3554":619,"_30673":530,"_21251":51987,"_5":14613,"_27884":51721,"_3010":51988},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3554":620,"_30673":530,"_21251":51990,"_5":14613,"_27884":51725,"_3010":51991},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3554":621,"_30673":530,"_21251":51993,"_5":14613,"_27884":51725,"_3010":51994},[],"The available modes are:",{"_3554":622,"_30673":530,"_21251":51996,"_5":14613,"_27884":51725,"_3010":51997},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3554":623,"_30673":530,"_21251":51999,"_5":14613,"_27884":51725,"_3010":52000},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3554":624,"_30673":530,"_21251":52002,"_5":14613,"_27884":51725,"_3010":52003},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3554":625,"_30673":530,"_21251":52005,"_5":14613,"_27884":51725,"_3010":52006},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3554":626,"_30673":530,"_21251":52008,"_5":14613,"_27884":51725,"_3010":52009},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3554":627,"_30673":530,"_21251":52011,"_5":14613,"_27884":51725,"_3010":52012},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3554":628,"_30673":530,"_21251":52014,"_5":14613,"_27884":51729,"_3010":52015},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3554":629,"_30673":530,"_21251":52017,"_5":14613,"_27884":51729,"_3010":52018},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3554":630,"_30673":530,"_21251":52020,"_5":14613,"_27884":51729,"_3010":52021},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3554":631,"_30673":530,"_21251":52023,"_5":14613,"_27884":51729,"_3010":52024},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3554":632,"_30673":530,"_21251":52026,"_5":14613,"_27884":51737,"_3010":52027},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3554":633,"_30673":530,"_21251":52029,"_5":14613,"_27884":51737,"_3010":52030},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3554":634,"_30673":530,"_21251":52032,"_5":14613,"_27884":51741,"_3010":52033},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3554":635,"_30673":530,"_21251":52035,"_5":14613,"_27884":51741,"_3010":52036},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3554":636,"_30673":530,"_21251":52038,"_5":14613,"_27884":51741,"_3010":52039},[],"The data model shows how the resources used in entity rules are connected.",{"_3554":637,"_30673":530,"_21251":52041,"_5":14613,"_27884":51741,"_3010":52042},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3554":638,"_30673":530,"_21251":52044,"_5":14613,"_27884":51741,"_3010":52045},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3554":639,"_30673":530,"_21251":52047,"_5":14613,"_27884":51745,"_3010":52048},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3554":640,"_30673":530,"_21251":52050,"_5":14613,"_27884":51745,"_3010":52051},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3554":641,"_30673":530,"_21251":52053,"_5":14613,"_27884":51745,"_3010":52054},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3554":642,"_30673":530,"_21251":52056,"_5":14613,"_27884":51749,"_3010":52057},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3554":643,"_30673":530,"_21251":52059,"_5":14613,"_27884":51749,"_3010":52060},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3554":644,"_30673":530,"_21251":52062,"_5":14613,"_27884":51749,"_3010":52063},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3554":645,"_30673":530,"_21251":52065,"_5":14613,"_27884":51749,"_3010":52066},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3554":646,"_30673":530,"_21251":52068,"_5":14613,"_27884":51749,"_3010":52069},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3554":647,"_30673":530,"_21251":52071,"_5":14613,"_27884":51749,"_3010":52072},[],"Note that:",{"_3554":648,"_30673":530,"_21251":52074,"_5":14613,"_27884":51749,"_3010":52075},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3554":649,"_30673":530,"_21251":52077,"_5":14613,"_27884":51749,"_3010":52078},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3554":650,"_30673":530,"_21251":52080,"_5":14613,"_27884":51749,"_3010":52081},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3554":651,"_30673":530,"_21251":52083,"_5":14613,"_27884":51753,"_3010":52084},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3554":652,"_30673":530,"_21251":52086,"_5":14613,"_27884":51753,"_3010":52087},[],"full and read-only access to certificates and authorities;",{"_3554":653,"_30673":530,"_21251":52089,"_5":14613,"_27884":51753,"_3010":52090},[],"full and read-only access to the KMS;",{"_3554":654,"_30673":530,"_21251":52092,"_5":14613,"_27884":51753,"_3010":52093},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3554":655,"_30673":530,"_21251":52095,"_5":14613,"_27884":51753,"_3010":52096},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3554":656,"_30673":530,"_21251":52098,"_5":14613,"_27884":51753,"_3010":52099},[],"console access;",{"_3554":657,"_30673":530,"_21251":52101,"_5":14613,"_27884":51753,"_3010":52102},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3554":658,"_30673":530,"_21251":52104,"_5":14613,"_27884":51753,"_3010":52105},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3554":659,"_30673":530,"_21251":52107,"_5":14613,"_27884":51753,"_3010":52108},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3554":660,"_30673":530,"_21251":52110,"_5":14613,"_27884":51753,"_3010":52111},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3554":661,"_30673":530,"_21251":52113,"_5":14613,"_27884":51753,"_3010":52114},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3554":662,"_30673":530,"_21251":52116,"_5":14613,"_27884":51757,"_3010":52117},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3554":663,"_30673":530,"_21251":52119,"_5":14613,"_27884":51757,"_3010":52120},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3554":664,"_30673":530,"_21251":52122,"_5":14613,"_27884":51757,"_3010":52123},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3554":665,"_30673":530,"_21251":52125,"_5":14613,"_27884":51760,"_3010":52126},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3554":666,"_30673":530,"_21251":52128,"_5":14613,"_27884":51764,"_3010":52129},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3554":667,"_30673":530,"_21251":52131,"_5":14613,"_27884":51764,"_3010":52132},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3554":668,"_30673":530,"_21251":52134,"_5":14613,"_27884":51768,"_3010":52135},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3554":669,"_30673":530,"_21251":52137,"_5":14613,"_27884":51772,"_3010":52138},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3554":670,"_30673":530,"_21251":52140,"_5":14613,"_27884":51776,"_3010":52141},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3554":671,"_30673":530,"_21251":52143,"_5":14613,"_27884":51780,"_3010":52144},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3554":672,"_30673":530,"_21251":52146,"_5":14613,"_27884":51780,"_3010":52147},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3554":673,"_30673":530,"_21251":52149,"_5":14613,"_27884":51784,"_3010":52150},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3554":674,"_30673":530,"_21251":52152,"_5":14613,"_27884":51784,"_3010":52153},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3554":675,"_30673":530,"_21251":52155,"_5":14613,"_27884":51784,"_3010":52156},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3554":676,"_30673":530,"_21251":52158,"_5":14613,"_27884":51784,"_3010":52159},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3554":677,"_30673":530,"_21251":52161,"_5":14613,"_27884":51784,"_3010":52162},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3554":678,"_30673":530,"_21251":52164,"_5":14613,"_27884":51784,"_3010":52165},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3554":679,"_30673":530,"_21251":52167,"_5":14613,"_27884":51784,"_3010":52168},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3554":680,"_30673":530,"_21251":52170,"_5":14613,"_27884":51784,"_3010":52171},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3554":681,"_30673":530,"_21251":52173,"_5":14613,"_27884":51788,"_3010":52174},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3554":682,"_30673":530,"_21251":52176,"_5":14613,"_27884":51788,"_3010":52177},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3554":683,"_30673":530,"_21251":52179,"_5":14613,"_27884":51788,"_3010":52180},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3554":684,"_30673":530,"_21251":52182,"_5":14613,"_27884":51792,"_3010":52183},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3554":685,"_30673":530,"_21251":52185,"_5":14613,"_27884":51792,"_3010":52186},[],"Use groups or stable roles for people and independent identities for automations.",{"_3554":686,"_30673":530,"_21251":52188,"_5":14613,"_27884":51792,"_3010":52189},[],"Keep at least two recovery administrators and test their access periodically.",{"_3554":687,"_30673":530,"_21251":52191,"_5":14613,"_27884":51792,"_3010":52192},[],"Review active principals, their matches and their grants after IdP changes.",{"_3554":688,"_30673":530,"_21251":52194,"_5":14613,"_27884":51792,"_3010":52195},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3554":689,"_30673":530,"_21251":52197,"_5":14613,"_27884":51792,"_3010":52198},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3554":690,"_30673":530,"_21251":52200,"_5":14613,"_27884":51792,"_3010":52201},[],"Always test one allowed and one denied operation for each role.",{"_3554":691,"_30673":530,"_21251":52203,"_5":14613,"_27884":51792,"_3010":52204},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3554":692,"_30673":530,"_21251":52206,"_5":14613,"_27884":51800,"_3010":52207},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3554":693,"_30673":530,"_21251":52209,"_5":14613,"_27884":51804,"_3010":52210},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3554":694,"_30673":530,"_21251":52212,"_5":14613,"_27884":51804,"_3010":52213},[],"that an active principal of the correct type exists;",{"_3554":695,"_30673":530,"_21251":52215,"_5":14613,"_27884":51804,"_3010":52216},[],"that the claim paths and values match the real token exactly;",{"_3554":696,"_30673":530,"_21251":52218,"_5":14613,"_27884":51804,"_3010":52219},[],"that all of the principal's conditions hold;",{"_3554":697,"_30673":530,"_21251":52221,"_5":14613,"_27884":51804,"_3010":52222},[],"that the principal has the expected policy granted;",{"_3554":698,"_30673":530,"_21251":52224,"_5":14613,"_27884":51804,"_3010":52225},[],"that the policy includes the action and the requested resource type or route;",{"_3554":699,"_30673":530,"_21251":52227,"_5":14613,"_27884":51804,"_3010":52228},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3554":700,"_30673":530,"_21251":52230,"_5":14613,"_27884":51804,"_3010":52231},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3554":701,"_30673":530,"_21251":52233,"_5":14613,"_27884":51804,"_3010":52234},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3554":702,"_30673":530,"_21251":52236,"_5":14613,"_27884":51808,"_3010":52237},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3554":703,"_30673":530,"_21251":52239,"_5":14613,"_27884":51812,"_3010":52240},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3554":704,"_30673":530,"_21251":52242,"_5":14613,"_27884":51816,"_3010":52243},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3554":705,"_30673":530,"_21251":52245,"_5":14613,"_27884":51816,"_3010":52246},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3554":706,"_30673":706,"_5":14965,"_3010":52248,"_31032":52249,"_21251":52250,"_27884":706},"Alerts and subscriptions",[50083,51558,51559],[],{"_3554":707,"_30673":706,"_21251":52252,"_5":14613,"_27884":706,"_3010":52253},[],"Send PKI events to people and external systems.",{"_3554":708,"_30673":706,"_5":31029,"_21251":52255,"_27884":52256,"_3010":52257},[],"/docs/pr-preview/pr-69/platform/administration/alerts#how-it-works","How it works",{"_3554":709,"_30673":706,"_5":31029,"_21251":52259,"_27884":52260,"_3010":52261},[],"/docs/pr-preview/pr-69/platform/administration/alerts#available-channels","Available channels",{"_3554":710,"_30673":706,"_5":31029,"_21251":52263,"_27884":52264,"_3010":52265},[],"/docs/pr-preview/pr-69/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3554":711,"_30673":706,"_5":31029,"_21251":52267,"_27884":52268,"_3010":52269},[],"/docs/pr-preview/pr-69/platform/administration/alerts#choose-the-event","Choose the event",{"_3554":712,"_30673":706,"_5":31029,"_21251":52271,"_27884":52272,"_3010":52273},[],"/docs/pr-preview/pr-69/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3554":713,"_30673":706,"_5":31029,"_21251":52275,"_27884":52276,"_3010":52277},[],"/docs/pr-preview/pr-69/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3554":714,"_30673":706,"_5":31029,"_21251":52279,"_27884":52280,"_3010":52281},[],"/docs/pr-preview/pr-69/platform/administration/alerts#review-and-activate","Review and activate",{"_3554":715,"_30673":706,"_5":31029,"_21251":52283,"_27884":52284,"_3010":52285},[],"/docs/pr-preview/pr-69/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3554":716,"_30673":706,"_5":31029,"_21251":52287,"_27884":52288,"_3010":52289},[],"/docs/pr-preview/pr-69/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3554":717,"_30673":706,"_5":31029,"_21251":52291,"_27884":52292,"_3010":52293},[],"/docs/pr-preview/pr-69/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3554":718,"_30673":706,"_5":31029,"_21251":52295,"_27884":52296,"_3010":52297},[],"/docs/pr-preview/pr-69/platform/administration/alerts#event-families","Event families",{"_3554":719,"_30673":706,"_21251":52299,"_5":14613,"_27884":706,"_3010":52300},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3554":720,"_30673":706,"_21251":52302,"_5":14613,"_27884":52256,"_3010":52303},[],"A service publishes a domain event.",{"_3554":721,"_30673":706,"_21251":52305,"_5":14613,"_27884":52256,"_3010":52306},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3554":722,"_30673":706,"_21251":52308,"_5":14613,"_27884":52256,"_3010":52309},[],"Each subscription's filter decides whether it should be notified.",{"_3554":723,"_30673":706,"_21251":52311,"_5":14613,"_27884":52256,"_3010":52312},[],"Lamassu delivers the event to the configured channel.",{"_3554":724,"_30673":706,"_21251":52314,"_5":14613,"_27884":52256,"_3010":52315},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3554":725,"_30673":706,"_21251":52317,"_5":14613,"_27884":52260,"_3010":52318},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3554":726,"_30673":706,"_21251":52320,"_5":14613,"_27884":52260,"_3010":52321},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3554":727,"_30673":706,"_21251":52323,"_5":14613,"_27884":52260,"_3010":52324},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3554":728,"_30673":706,"_21251":52326,"_5":14613,"_27884":52260,"_3010":52327},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3554":729,"_30673":706,"_21251":52329,"_5":14613,"_27884":52260,"_3010":52330},[],"`apikey_options` requires `header` and `key`.",{"_3554":730,"_30673":706,"_21251":52332,"_5":14613,"_27884":52260,"_3010":52333},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3554":731,"_30673":706,"_21251":52335,"_5":14613,"_27884":52260,"_3010":52336},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3554":732,"_30673":706,"_21251":52338,"_5":14613,"_27884":52260,"_3010":52339},[],"The alerts API reference documents the full `http_client` schema.",{"_3554":733,"_30673":706,"_21251":52341,"_5":14613,"_27884":52268,"_3010":52342},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3554":734,"_30673":706,"_21251":52344,"_5":14613,"_27884":52272,"_3010":52345},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3554":735,"_30673":706,"_21251":52347,"_5":14613,"_27884":52276,"_3010":52348},[],"Add a filter if you don't want to receive every instance of the event.",{"_3554":736,"_30673":706,"_21251":52350,"_5":14613,"_27884":52276,"_3010":52351},[],"**None** notifies all instances of the event.",{"_3554":737,"_30673":706,"_21251":52353,"_5":14613,"_27884":52276,"_3010":52354},[],"**JSON Path** evaluates one or more specific fields.",{"_3554":738,"_30673":706,"_21251":52356,"_5":14613,"_27884":52276,"_3010":52357},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3554":739,"_30673":706,"_21251":52359,"_5":14613,"_27884":52276,"_3010":52360},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3554":740,"_30673":706,"_21251":52362,"_5":14613,"_27884":52276,"_3010":52363},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3554":741,"_30673":706,"_21251":52365,"_5":14613,"_27884":52276,"_3010":52366},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3554":742,"_30673":706,"_21251":52368,"_5":14613,"_27884":52280,"_3010":52369},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3554":743,"_30673":706,"_21251":52371,"_5":14613,"_27884":52284,"_3010":52372},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3554":744,"_30673":706,"_21251":52374,"_5":14613,"_27884":52284,"_3010":52375},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3554":745,"_30673":706,"_21251":52377,"_5":14613,"_27884":52284,"_3010":52378},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3554":746,"_30673":706,"_21251":52380,"_5":14613,"_27884":52284,"_3010":52381},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3554":747,"_30673":706,"_21251":52383,"_5":14613,"_27884":52284,"_3010":52384},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3554":748,"_30673":706,"_21251":52386,"_5":14613,"_27884":52284,"_3010":52387},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3554":749,"_30673":706,"_21251":52389,"_5":14613,"_27884":52284,"_3010":52390},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3554":750,"_30673":706,"_21251":52392,"_5":14613,"_27884":52284,"_3010":52393},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3554":751,"_30673":706,"_21251":52395,"_5":14613,"_27884":52288,"_3010":52396},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3554":752,"_30673":706,"_21251":52398,"_5":14613,"_27884":52288,"_3010":52399},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3554":753,"_30673":706,"_21251":52401,"_5":14613,"_27884":52288,"_3010":52402},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3554":754,"_30673":706,"_21251":52404,"_5":14613,"_27884":52288,"_3010":52405},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3554":755,"_30673":706,"_21251":52407,"_5":14613,"_27884":52288,"_3010":52408},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3554":756,"_30673":706,"_21251":52410,"_5":14613,"_27884":52288,"_3010":52411},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3554":757,"_30673":706,"_21251":52413,"_5":14613,"_27884":52288,"_3010":52414},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3554":758,"_30673":706,"_21251":52416,"_5":14613,"_27884":52288,"_3010":52417},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3554":759,"_30673":706,"_21251":52419,"_5":14613,"_27884":52292,"_3010":52420},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3554":760,"_30673":706,"_21251":52422,"_5":14613,"_27884":52292,"_3010":52423},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3554":761,"_30673":706,"_21251":52425,"_5":14613,"_27884":52296,"_3010":52426},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3554":762,"_30673":706,"_21251":52428,"_5":14613,"_27884":52296,"_3010":52429},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3554":763,"_30673":706,"_21251":52431,"_5":14613,"_27884":52296,"_3010":52432},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3554":764,"_30673":706,"_21251":52434,"_5":14613,"_27884":52296,"_3010":52435},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3554":765,"_30673":706,"_21251":52437,"_5":14613,"_27884":52296,"_3010":52438},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3554":766,"_30673":706,"_21251":52440,"_5":14613,"_27884":52296,"_3010":52441},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3554":767,"_30673":706,"_21251":52443,"_5":14613,"_27884":52296,"_3010":52444},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3554":768,"_30673":706,"_21251":52446,"_5":14613,"_27884":52296,"_3010":52447},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3554":769,"_30673":706,"_21251":52449,"_5":14613,"_27884":52296,"_3010":52450},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3554":770,"_30673":706,"_21251":52452,"_5":14613,"_27884":52296,"_3010":52453},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3554":771,"_30673":771,"_5":14965,"_3010":52455,"_31032":52456,"_21251":52457,"_27884":771},"Audit logs",[50083,51558,51559],[],{"_3554":772,"_30673":771,"_21251":52459,"_5":14613,"_27884":771,"_3010":52460},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3554":773,"_30673":771,"_5":31029,"_21251":52462,"_27884":52463,"_3010":52464},[],"/docs/pr-preview/pr-69/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3554":774,"_30673":771,"_5":31029,"_21251":52466,"_27884":52467,"_3010":52468},[],"/docs/pr-preview/pr-69/platform/administration/audit-logs#coverage","Coverage",{"_3554":775,"_30673":771,"_5":31029,"_21251":52470,"_27884":52471,"_3010":52472},[],"/docs/pr-preview/pr-69/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3554":776,"_30673":771,"_5":31029,"_21251":52474,"_27884":52475,"_3010":52476},[],"/docs/pr-preview/pr-69/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3554":777,"_30673":771,"_5":31029,"_21251":52478,"_27884":52479,"_3010":52480},[],"/docs/pr-preview/pr-69/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3554":778,"_30673":771,"_5":31029,"_21251":52482,"_27884":52483,"_3010":52484},[],"/docs/pr-preview/pr-69/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3554":779,"_30673":771,"_5":31029,"_21251":52486,"_27884":52487,"_3010":52488},[],"/docs/pr-preview/pr-69/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3554":780,"_30673":771,"_5":31029,"_21251":52490,"_27884":52491,"_3010":52492},[],"/docs/pr-preview/pr-69/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3554":781,"_30673":771,"_5":31029,"_21251":52494,"_27884":52495,"_3010":52496},[],"/docs/pr-preview/pr-69/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3554":782,"_30673":771,"_5":31029,"_21251":52498,"_27884":52499,"_3010":52500},[],"/docs/pr-preview/pr-69/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3554":783,"_30673":771,"_5":31029,"_21251":52502,"_27884":52503,"_3010":52504},[],"/docs/pr-preview/pr-69/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3554":784,"_30673":771,"_21251":52506,"_5":14613,"_27884":771,"_3010":52507},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3554":785,"_30673":771,"_21251":52509,"_5":14613,"_27884":52463,"_3010":52510},[],"The audit body includes:",{"_3554":786,"_30673":771,"_21251":52512,"_5":14613,"_27884":52463,"_3010":52513},[],"input: data received by the operation;",{"_3554":787,"_30673":771,"_21251":52515,"_5":14613,"_27884":52463,"_3010":52516},[],"has\\_error: whether the service returned an error;",{"_3554":788,"_30673":771,"_21251":52518,"_5":14613,"_27884":52463,"_3010":52519},[],"output: produced result or error message;",{"_3554":789,"_30673":771,"_21251":52521,"_5":14613,"_27884":52463,"_3010":52522},[],"principals: identifiers of the principals that matched the request.",{"_3554":790,"_30673":771,"_21251":52524,"_5":14613,"_27884":52463,"_3010":52525},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3554":791,"_30673":771,"_21251":52527,"_5":14613,"_27884":52463,"_3010":52528},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3554":792,"_30673":771,"_21251":52530,"_5":14613,"_27884":52467,"_3010":52531},[],"The backend applies auditing to mutations of:",{"_3554":793,"_30673":771,"_21251":52533,"_5":14613,"_27884":52467,"_3010":52534},[],"authorities, certificates and issuance profiles;",{"_3554":794,"_30673":771,"_21251":52536,"_5":14613,"_27884":52467,"_3010":52537},[],"keys and KMS engines;",{"_3554":795,"_30673":771,"_21251":52539,"_5":14613,"_27884":52467,"_3010":52540},[],"devices and identities;",{"_3554":796,"_30673":771,"_21251":52542,"_5":14613,"_27884":52467,"_3010":52543},[],"DMSs and enrollment operations;",{"_3554":797,"_30673":771,"_21251":52545,"_5":14613,"_27884":52467,"_3010":52546},[],"validation functions and CRL;",{"_3554":798,"_30673":771,"_21251":52548,"_5":14613,"_27884":52467,"_3010":52549},[],"principals, policies and authorization grants.",{"_3554":799,"_30673":771,"_21251":52551,"_5":14613,"_27884":52467,"_3010":52552},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3554":800,"_30673":771,"_21251":52554,"_5":14613,"_27884":52471,"_3010":52555},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3554":801,"_30673":771,"_21251":52557,"_5":14613,"_27884":52471,"_3010":52558},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3554":802,"_30673":771,"_21251":52560,"_5":14613,"_27884":52471,"_3010":52561},[],"Design the consumer to:",{"_3554":803,"_30673":771,"_21251":52563,"_5":14613,"_27884":52471,"_3010":52564},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3554":804,"_30673":771,"_21251":52566,"_5":14613,"_27884":52471,"_3010":52567},[],"keep the complete CloudEvent unmodified;",{"_3554":805,"_30673":771,"_21251":52569,"_5":14613,"_27884":52471,"_3010":52570},[],"record the ingestion time and detect duplicates by ID;",{"_3554":806,"_30673":771,"_21251":52572,"_5":14613,"_27884":52471,"_3010":52573},[],"encrypt in transit and at rest;",{"_3554":807,"_30673":771,"_21251":52575,"_5":14613,"_27884":52471,"_3010":52576},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3554":808,"_30673":771,"_21251":52578,"_5":14613,"_27884":52471,"_3010":52579},[],"apply an explicit retention and legal hold policy;",{"_3554":809,"_30673":771,"_21251":52581,"_5":14613,"_27884":52471,"_3010":52582},[],"alert if it stops consuming or the pending queue grows.",{"_3554":810,"_30673":771,"_21251":52584,"_5":14613,"_27884":52475,"_3010":52585},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3554":811,"_30673":771,"_21251":52587,"_5":14613,"_27884":52475,"_3010":52588},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3554":812,"_30673":771,"_21251":52590,"_5":14613,"_27884":52483,"_3010":52591},[],"Start from the reported time and normalize every source to UTC.",{"_3554":813,"_30673":771,"_21251":52593,"_5":14613,"_27884":52487,"_3010":52594},[],"Filter by event type, service source and resource identifier.",{"_3554":814,"_30673":771,"_21251":52596,"_5":14613,"_27884":52491,"_3010":52597},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3554":815,"_30673":771,"_21251":52599,"_5":14613,"_27884":52495,"_3010":52600},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3554":816,"_30673":771,"_21251":52602,"_5":14613,"_27884":52499,"_3010":52603},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3554":817,"_30673":771,"_21251":52605,"_5":14613,"_27884":52503,"_3010":52606},[],"Generate a controlled mutation in a test environment and check that:",{"_3554":818,"_30673":771,"_21251":52608,"_5":14613,"_27884":52503,"_3010":52609},[],"a successful audit event appears;",{"_3554":819,"_30673":771,"_21251":52611,"_5":14613,"_27884":52503,"_3010":52612},[],"the principal matches the identity used;",{"_3554":820,"_30673":771,"_21251":52614,"_5":14613,"_27884":52503,"_3010":52615},[],"the consumer persists it exactly once;",{"_3554":821,"_30673":771,"_21251":52617,"_5":14613,"_27884":52503,"_3010":52618},[],"it can be retrieved by resource, actor and period;",{"_3554":822,"_30673":771,"_21251":52620,"_5":14613,"_27884":52503,"_3010":52621},[],"a consumer outage raises an alert.",{"_3554":823,"_30673":771,"_21251":52623,"_5":14613,"_27884":52503,"_3010":52624},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3554":824,"_30673":824,"_5":14965,"_3010":52626,"_31032":52627,"_21251":52628,"_27884":824},"Platform architecture",[50083,51558],[],{"_3554":825,"_30673":824,"_21251":52630,"_5":14613,"_27884":824,"_3010":52631},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3554":826,"_30673":824,"_5":31029,"_21251":52633,"_27884":52634,"_3010":52635},[],"/docs/pr-preview/pr-69/platform/concepts/architecture#control-plane","Control plane",{"_3554":827,"_30673":824,"_5":31029,"_21251":52637,"_27884":52638,"_3010":52639},[],"/docs/pr-preview/pr-69/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3554":828,"_30673":824,"_5":31029,"_21251":52641,"_27884":52642,"_3010":52643},[],"/docs/pr-preview/pr-69/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3554":829,"_30673":824,"_5":31029,"_21251":52645,"_27884":52646,"_3010":52647},[],"/docs/pr-preview/pr-69/platform/concepts/architecture#status-and-validation","Status and validation",{"_3554":830,"_30673":824,"_5":31029,"_21251":52649,"_27884":52650,"_3010":52651},[],"/docs/pr-preview/pr-69/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3554":831,"_30673":824,"_21251":52653,"_5":14613,"_27884":824,"_3010":52654},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3554":832,"_30673":824,"_21251":52656,"_5":14613,"_27884":824,"_3010":52657},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3554":833,"_30673":824,"_21251":52659,"_5":14613,"_27884":52634,"_3010":52660},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3554":834,"_30673":824,"_21251":52662,"_5":14613,"_27884":52638,"_3010":52663},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3554":835,"_30673":824,"_21251":52665,"_5":14613,"_27884":52642,"_3010":52666},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3554":836,"_30673":824,"_21251":52668,"_5":14613,"_27884":52646,"_3010":52669},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3554":837,"_30673":824,"_21251":52671,"_5":14613,"_27884":52650,"_3010":52672},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3554":838,"_30673":838,"_5":14965,"_3010":52674,"_31032":52675,"_21251":52676,"_27884":838},"How Lamassu works",[50083,51558],[],{"_3554":839,"_30673":838,"_21251":52678,"_5":14613,"_27884":838,"_3010":52679},[],"The mental model of trust, keys, certificates and devices.",{"_3554":840,"_30673":838,"_5":31029,"_21251":52681,"_27884":52682,"_3010":52683},[],"/docs/pr-preview/pr-69/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3554":841,"_30673":838,"_5":31029,"_21251":52685,"_27884":52686,"_3010":52687},[],"/docs/pr-preview/pr-69/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3554":842,"_30673":838,"_21251":52689,"_5":14613,"_27884":838,"_3010":52690},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3554":843,"_30673":838,"_21251":52692,"_5":14613,"_27884":52682,"_3010":52693},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3554":844,"_30673":838,"_21251":52695,"_5":14613,"_27884":52682,"_3010":52696},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3554":845,"_30673":838,"_21251":52698,"_5":14613,"_27884":52682,"_3010":52699},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3554":846,"_30673":838,"_21251":52701,"_5":14613,"_27884":52682,"_3010":52702},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3554":847,"_30673":838,"_21251":52704,"_5":14613,"_27884":52682,"_3010":52705},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3554":848,"_30673":838,"_21251":52707,"_5":14613,"_27884":52686,"_3010":52708},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3554":849,"_30673":838,"_21251":52710,"_5":14613,"_27884":52686,"_3010":52711},[],"A DMS relates that CA to an enrollment policy.",{"_3554":850,"_30673":838,"_21251":52713,"_5":14613,"_27884":52686,"_3010":52714},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3554":851,"_30673":838,"_21251":52716,"_5":14613,"_27884":52686,"_3010":52717},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3554":852,"_30673":838,"_21251":52719,"_5":14613,"_27884":52686,"_3010":52720},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3554":853,"_30673":838,"_21251":52722,"_5":14613,"_27884":52686,"_3010":52723},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3554":854,"_30673":838,"_21251":52725,"_5":14613,"_27884":52686,"_3010":52726},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3554":855,"_30673":855,"_5":14965,"_3010":52728,"_31032":52729,"_21251":52731,"_27884":855},"Devices and identities",[50083,51558,52730,52728],"IoT Fleets",[],{"_3554":856,"_30673":855,"_21251":52733,"_5":14613,"_27884":855,"_3010":52734},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3554":857,"_30673":855,"_5":31029,"_21251":52736,"_27884":52737,"_3010":52738},[],"/docs/pr-preview/pr-69/platform/iot-fleets/device-management#device-states","Device states",{"_3554":858,"_30673":855,"_5":31029,"_21251":52740,"_27884":52741,"_3010":52742},[],"/docs/pr-preview/pr-69/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3554":859,"_30673":855,"_5":31029,"_21251":52744,"_27884":52745,"_3010":52746},[],"/docs/pr-preview/pr-69/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3554":860,"_30673":855,"_5":31029,"_21251":52748,"_27884":52749,"_3010":52750},[],"/docs/pr-preview/pr-69/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3554":861,"_30673":855,"_5":31029,"_21251":52752,"_27884":52753,"_3010":52754},[],"/docs/pr-preview/pr-69/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3554":862,"_30673":855,"_5":31029,"_21251":52756,"_27884":52757,"_3010":52758},[],"/docs/pr-preview/pr-69/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3554":863,"_30673":855,"_5":31029,"_21251":52760,"_27884":52761,"_3010":52762},[],"/docs/pr-preview/pr-69/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3554":864,"_30673":855,"_5":31029,"_21251":52764,"_27884":52765,"_3010":52766},[],"/docs/pr-preview/pr-69/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3554":865,"_30673":855,"_5":31029,"_21251":52768,"_27884":52769,"_3010":52770},[],"/docs/pr-preview/pr-69/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3554":866,"_30673":855,"_5":31029,"_21251":52772,"_27884":52773,"_3010":52774},[],"/docs/pr-preview/pr-69/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3554":867,"_30673":855,"_5":31029,"_21251":52776,"_27884":52777,"_3010":52778},[],"/docs/pr-preview/pr-69/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3554":868,"_30673":855,"_21251":52780,"_5":14613,"_27884":855,"_3010":52781},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3554":869,"_30673":855,"_21251":52783,"_5":14613,"_27884":855,"_3010":52784},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3554":870,"_30673":855,"_21251":52786,"_5":14613,"_27884":52737,"_3010":52787},[],"Operational view",{"_3554":871,"_30673":855,"_21251":52789,"_5":14613,"_27884":52737,"_3010":52790},[],"Meaning",{"_3554":872,"_30673":855,"_21251":52792,"_5":14613,"_27884":52737,"_3010":52793},[],"**No Identity**",{"_3554":873,"_30673":855,"_21251":52795,"_5":14613,"_27884":52737,"_3010":52796},[],"A record exists without an associated identity.",{"_3554":874,"_30673":855,"_21251":52798,"_5":14613,"_27884":52737,"_3010":52799},[],"**Active**",{"_3554":875,"_30673":855,"_21251":52801,"_5":14613,"_27884":52737,"_3010":52802},[],"The slot is active; also check certificate dates, status and usages.",{"_3554":876,"_30673":855,"_21251":52804,"_5":14613,"_27884":52737,"_3010":52805},[],"**Renewal Pending**",{"_3554":877,"_30673":855,"_21251":52807,"_5":14613,"_27884":52737,"_3010":52808},[],"The identity is in the operational renewal window.",{"_3554":878,"_30673":855,"_21251":52810,"_5":14613,"_27884":52737,"_3010":52811},[],"**Expiring Soon**",{"_3554":879,"_30673":855,"_21251":52813,"_5":14613,"_27884":52737,"_3010":52814},[],"Expiration is approaching according to configured thresholds.",{"_3554":880,"_30673":855,"_21251":52816,"_5":14613,"_27884":52737,"_3010":52817},[],"**Expired**",{"_3554":881,"_30673":855,"_21251":52819,"_5":14613,"_27884":52737,"_3010":52820},[],"The identity has expired.",{"_3554":882,"_30673":855,"_21251":52822,"_5":14613,"_27884":52737,"_3010":52823},[],"**Revoked**",{"_3554":883,"_30673":855,"_21251":52825,"_5":14613,"_27884":52737,"_3010":52826},[],"The identity is marked revoked.",{"_3554":884,"_30673":855,"_21251":52828,"_5":14613,"_27884":52737,"_3010":52829},[],"**Decommissioned**",{"_3554":885,"_30673":855,"_21251":52831,"_5":14613,"_27884":52737,"_3010":52832},[],"The record is retired and ordinary updates do not restore operation.",{"_3554":886,"_30673":855,"_21251":52834,"_5":14613,"_27884":52737,"_3010":52835},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3554":887,"_30673":855,"_21251":52837,"_5":14613,"_27884":52741,"_3010":52838},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3554":888,"_30673":855,"_21251":52840,"_5":14613,"_27884":52741,"_3010":52841},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3554":889,"_30673":855,"_21251":52843,"_5":14613,"_27884":52741,"_3010":52844},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3554":890,"_30673":855,"_21251":52846,"_5":14613,"_27884":52741,"_3010":52847},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3554":891,"_30673":855,"_21251":52849,"_5":14613,"_27884":52745,"_3010":52850},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3554":892,"_30673":855,"_21251":52852,"_5":14613,"_27884":52749,"_3010":52853},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3554":893,"_30673":855,"_21251":52855,"_5":14613,"_27884":52753,"_3010":52856},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3554":894,"_30673":855,"_21251":52858,"_5":14613,"_27884":52757,"_3010":52859},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3554":895,"_30673":855,"_21251":52861,"_5":14613,"_27884":52761,"_3010":52862},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3554":896,"_30673":855,"_21251":52864,"_5":14613,"_27884":52761,"_3010":52865},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3554":897,"_30673":855,"_21251":52867,"_5":14613,"_27884":52765,"_3010":52868},[],"From **No Identity**, use **Assign Identity**:",{"_3554":898,"_30673":855,"_21251":52870,"_5":14613,"_27884":52765,"_3010":52871},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3554":899,"_30673":855,"_21251":52873,"_5":14613,"_27884":52765,"_3010":52874},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3554":900,"_30673":855,"_21251":52876,"_5":14613,"_27884":52765,"_3010":52877},[],"Confirm and read the serial, active version and history again.",{"_3554":901,"_30673":855,"_21251":52879,"_5":14613,"_27884":52765,"_3010":52880},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3554":902,"_30673":855,"_21251":52882,"_5":14613,"_27884":52765,"_3010":52883},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3554":903,"_30673":855,"_21251":52885,"_5":14613,"_27884":52769,"_3010":52886},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3554":904,"_30673":855,"_21251":52888,"_5":14613,"_27884":52769,"_3010":52889},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3554":905,"_30673":855,"_21251":52891,"_5":14613,"_27884":52773,"_3010":52892},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3554":906,"_30673":855,"_21251":52894,"_5":14613,"_27884":52773,"_3010":52895},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3554":907,"_30673":855,"_21251":52897,"_5":14613,"_27884":52773,"_3010":52898},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3554":908,"_30673":855,"_21251":52900,"_5":14613,"_27884":52773,"_3010":52901},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3554":909,"_30673":855,"_21251":52903,"_5":14613,"_27884":52777,"_3010":52904},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3554":910,"_30673":855,"_21251":52906,"_5":14613,"_27884":52777,"_3010":52907},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3554":911,"_30673":911,"_5":14965,"_3010":52909,"_31032":52910,"_21251":52912,"_27884":911},"Bootstrap identity and authentication",[50083,51558,52730,52728,52911],"Enrollment with PKI",[],{"_3554":912,"_30673":911,"_21251":52914,"_5":14613,"_27884":911,"_3010":52915},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3554":913,"_30673":911,"_5":31029,"_21251":52917,"_27884":52918,"_3010":52919},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3554":914,"_30673":911,"_5":31029,"_21251":52921,"_27884":52922,"_3010":52923},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3554":915,"_30673":911,"_5":31029,"_21251":52925,"_27884":52926,"_3010":52927},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3554":916,"_30673":911,"_5":31029,"_21251":52929,"_27884":52930,"_3010":52931},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3554":917,"_30673":911,"_5":31029,"_21251":52933,"_27884":52934,"_3010":52935},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3554":918,"_30673":911,"_21251":52937,"_5":14613,"_27884":911,"_3010":52938},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3554":919,"_30673":911,"_21251":52940,"_5":14613,"_27884":52918,"_3010":52941},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3554":920,"_30673":911,"_21251":52943,"_5":14613,"_27884":52918,"_3010":52944},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3554":921,"_30673":911,"_21251":52946,"_5":14613,"_27884":52922,"_3010":52947},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3554":922,"_30673":911,"_21251":52949,"_5":14613,"_27884":52922,"_3010":52950},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3554":923,"_30673":911,"_21251":52952,"_5":14613,"_27884":52922,"_3010":52953},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3554":924,"_30673":911,"_21251":52955,"_5":14613,"_27884":52926,"_3010":52956},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3554":925,"_30673":911,"_21251":52958,"_5":14613,"_27884":52926,"_3010":52959},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3554":926,"_30673":911,"_21251":52961,"_5":14613,"_27884":52930,"_3010":52962},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3554":927,"_30673":911,"_21251":52964,"_5":14613,"_27884":52930,"_3010":52965},[],"Example body:",{"_3554":928,"_30673":911,"_21251":52967,"_5":14613,"_27884":52930,"_3010":52968},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3554":929,"_30673":911,"_21251":52970,"_5":14613,"_27884":52930,"_3010":52971},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3554":930,"_30673":911,"_21251":52973,"_5":14613,"_27884":52930,"_3010":52974},[],"Continuation requires a successful HTTP response and JSON:",{"_3554":931,"_30673":911,"_21251":52976,"_5":14613,"_27884":52930,"_3010":52977},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3554":932,"_30673":911,"_21251":52979,"_5":14613,"_27884":52934,"_3010":52980},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3554":933,"_30673":911,"_21251":52982,"_5":14613,"_27884":52934,"_3010":52983},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3554":934,"_30673":934,"_5":14965,"_3010":52985,"_31032":52986,"_21251":52987,"_27884":934},"Configure and operate the DMS",[50083,51558,52730,52728,52911],[],{"_3554":935,"_30673":934,"_21251":52989,"_5":14613,"_27884":934,"_3010":52990},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3554":936,"_30673":934,"_5":31029,"_21251":52992,"_27884":52993,"_3010":50093},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3554":937,"_30673":934,"_5":31029,"_21251":52995,"_27884":52996,"_3010":52997},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3554":938,"_30673":934,"_5":31029,"_21251":52999,"_27884":53000,"_3010":53001},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3554":939,"_30673":934,"_5":31029,"_21251":53003,"_27884":53004,"_3010":53005},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3554":940,"_30673":934,"_5":31029,"_21251":53007,"_27884":53008,"_3010":53009},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3554":941,"_30673":934,"_5":31029,"_21251":53011,"_27884":53012,"_3010":53013},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3554":942,"_30673":934,"_5":31029,"_21251":53015,"_27884":53016,"_3010":53017},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3554":943,"_30673":934,"_5":31029,"_21251":53019,"_27884":53020,"_3010":53021},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3554":944,"_30673":934,"_5":31029,"_21251":53023,"_27884":53024,"_3010":53025},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3554":945,"_30673":934,"_5":31029,"_21251":53027,"_27884":53028,"_3010":53029},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3554":946,"_30673":934,"_5":31029,"_21251":53031,"_27884":53032,"_3010":53033},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3554":947,"_30673":934,"_5":31029,"_21251":53035,"_27884":53036,"_3010":53037},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3554":948,"_30673":934,"_5":31029,"_21251":53039,"_27884":53040,"_3010":53041},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3554":949,"_30673":934,"_5":31029,"_21251":53043,"_27884":53044,"_3010":53045},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3554":950,"_30673":934,"_5":31029,"_21251":53047,"_27884":53048,"_3010":53049},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3554":951,"_30673":934,"_5":31029,"_21251":53051,"_27884":53052,"_3010":53053},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3554":952,"_30673":934,"_5":31029,"_21251":53055,"_27884":53056,"_3010":53057},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3554":953,"_30673":934,"_5":31029,"_21251":53059,"_27884":53060,"_3010":53061},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3554":954,"_30673":934,"_21251":53063,"_5":14613,"_27884":934,"_3010":53064},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3554":955,"_30673":934,"_21251":53066,"_5":14613,"_27884":52993,"_3010":53067},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3554":956,"_30673":934,"_21251":53069,"_5":14613,"_27884":52993,"_3010":53070},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3554":957,"_30673":934,"_21251":53072,"_5":14613,"_27884":53000,"_3010":53073},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3554":958,"_30673":934,"_21251":53075,"_5":14613,"_27884":53004,"_3010":53076},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3554":959,"_30673":934,"_21251":53078,"_5":14613,"_27884":53008,"_3010":53079},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3554":960,"_30673":934,"_21251":53081,"_5":14613,"_27884":53012,"_3010":53082},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3554":961,"_30673":934,"_21251":53084,"_5":14613,"_27884":53016,"_3010":53085},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3554":962,"_30673":934,"_21251":53087,"_5":14613,"_27884":53024,"_3010":53088},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3554":963,"_30673":934,"_21251":53090,"_5":14613,"_27884":53024,"_3010":53091},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3554":964,"_30673":934,"_21251":53093,"_5":14613,"_27884":53028,"_3010":53094},[],"`settings.enrollment_settings` field",{"_3554":965,"_30673":934,"_21251":53096,"_5":14613,"_27884":53028,"_3010":53097},[],"Decision",{"_3554":966,"_30673":934,"_21251":53099,"_5":14613,"_27884":53028,"_3010":53100},[],"`protocol`",{"_3554":967,"_30673":934,"_21251":53102,"_5":14613,"_27884":53028,"_3010":53103},[],"`EST_RFC7030` for these operations.",{"_3554":968,"_30673":934,"_21251":53105,"_5":14613,"_27884":53028,"_3010":53106},[],"`enrollment_ca`",{"_3554":969,"_30673":934,"_21251":53108,"_5":14613,"_27884":53028,"_3010":53109},[],"ID of the signing CA.",{"_3554":970,"_30673":934,"_21251":53111,"_5":14613,"_27884":53028,"_3010":53112},[],"`verify_csr_signature`",{"_3554":971,"_30673":934,"_21251":53114,"_5":14613,"_27884":53028,"_3010":53115},[],"Keep `true` to verify CSR key possession.",{"_3554":972,"_30673":934,"_21251":53117,"_5":14613,"_27884":53028,"_3010":53118},[],"`enable_replaceable_enrollment`",{"_3554":973,"_30673":934,"_21251":53120,"_5":14613,"_27884":53028,"_3010":53121},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3554":974,"_30673":934,"_21251":53123,"_5":14613,"_27884":53028,"_3010":53124},[],"`est_rfc7030_settings.auth_mode`",{"_3554":975,"_30673":934,"_21251":53126,"_5":14613,"_27884":53028,"_3010":53127},[],"One of the four authentication modes.",{"_3554":976,"_30673":934,"_21251":53129,"_5":14613,"_27884":53028,"_3010":53130},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3554":977,"_30673":934,"_21251":53132,"_5":14613,"_27884":53032,"_3010":53133},[],"The blocks are independent:",{"_3554":978,"_30673":934,"_21251":53135,"_5":14613,"_27884":53032,"_3010":53136},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3554":979,"_30673":934,"_21251":53138,"_5":14613,"_27884":53032,"_3010":53139},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3554":980,"_30673":934,"_21251":53141,"_5":14613,"_27884":53032,"_3010":53142},[],"`auth_mode`",{"_3554":981,"_30673":934,"_21251":53144,"_5":14613,"_27884":53032,"_3010":53145},[],"Control applied in the configured operation",{"_3554":982,"_30673":934,"_21251":53147,"_5":14613,"_27884":53032,"_3010":53148},[],"`CLIENT_CERTIFICATE`",{"_3554":983,"_30673":934,"_21251":53150,"_5":14613,"_27884":53032,"_3010":53151},[],"Presented certificate validation.",{"_3554":984,"_30673":934,"_21251":53153,"_5":14613,"_27884":53032,"_3010":53154},[],"`EXTERNAL_WEBHOOK`",{"_3554":985,"_30673":934,"_21251":53156,"_5":14613,"_27884":53032,"_3010":53157},[],"Configured webhook authorization.",{"_3554":986,"_30673":934,"_21251":53159,"_5":14613,"_27884":53032,"_3010":53160},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3554":987,"_30673":934,"_21251":53162,"_5":14613,"_27884":53032,"_3010":53163},[],"Certificate validation followed by webhook approval.",{"_3554":988,"_30673":934,"_21251":53165,"_5":14613,"_27884":53032,"_3010":53166},[],"`NO_AUTH`",{"_3554":989,"_30673":934,"_21251":53168,"_5":14613,"_27884":53032,"_3010":53169},[],"No DMS requester authentication.",{"_3554":990,"_30673":934,"_21251":53171,"_5":14613,"_27884":53032,"_3010":53172},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3554":991,"_30673":934,"_21251":53174,"_5":14613,"_27884":53032,"_3010":53175},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3554":992,"_30673":934,"_21251":53177,"_5":14613,"_27884":53032,"_3010":53178},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3554":993,"_30673":934,"_21251":53180,"_5":14613,"_27884":53032,"_3010":53181},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3554":994,"_30673":934,"_21251":53183,"_5":14613,"_27884":53036,"_3010":53184},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3554":995,"_30673":934,"_21251":53186,"_5":14613,"_27884":53036,"_3010":53187},[],"`external_webhook_settings` field",{"_3554":996,"_30673":934,"_21251":53189,"_5":14613,"_27884":53036,"_3010":53097},[],{"_3554":997,"_30673":934,"_21251":53191,"_5":14613,"_27884":53036,"_3010":53192},[],"`url`",{"_3554":998,"_30673":934,"_21251":53194,"_5":14613,"_27884":53036,"_3010":53195},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3554":999,"_30673":934,"_21251":53197,"_5":14613,"_27884":53036,"_3010":53198},[],"`method`",{"_3554":1000,"_30673":934,"_21251":53200,"_5":14613,"_27884":53036,"_3010":53201},[],"`POST` or `PUT`; `POST` by default.",{"_3554":1001,"_30673":934,"_21251":53203,"_5":14613,"_27884":53036,"_3010":53204},[],"`name`",{"_3554":1002,"_30673":934,"_21251":53206,"_5":14613,"_27884":53036,"_3010":53207},[],"Label used in service logs.",{"_3554":1003,"_30673":934,"_21251":53209,"_5":14613,"_27884":53036,"_3010":53210},[],"`config.auth_mode`",{"_3554":1004,"_30673":934,"_21251":53212,"_5":14613,"_27884":53036,"_3010":53213},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3554":1005,"_30673":934,"_21251":53215,"_5":14613,"_27884":53036,"_3010":53216},[],"`config.log_level`",{"_3554":1006,"_30673":934,"_21251":53218,"_5":14613,"_27884":53036,"_3010":53219},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3554":1007,"_30673":934,"_21251":53221,"_5":14613,"_27884":53036,"_3010":53222},[],"`config.apikey_options`",{"_3554":1008,"_30673":934,"_21251":53224,"_5":14613,"_27884":53036,"_3010":53225},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3554":1009,"_30673":934,"_21251":53227,"_5":14613,"_27884":53036,"_3010":53228},[],"`config.jwt_options`",{"_3554":1010,"_30673":934,"_21251":53230,"_5":14613,"_27884":53036,"_3010":53231},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3554":1011,"_30673":934,"_21251":53233,"_5":14613,"_27884":53036,"_3010":53234},[],"`config.mtls_options`",{"_3554":1012,"_30673":934,"_21251":53236,"_5":14613,"_27884":53036,"_3010":53237},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3554":1013,"_30673":934,"_21251":53239,"_5":14613,"_27884":53036,"_3010":53240},[],"`config.insecure_skip_verify`",{"_3554":1014,"_30673":934,"_21251":53242,"_5":14613,"_27884":53036,"_3010":53243},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3554":1015,"_30673":934,"_21251":53245,"_5":14613,"_27884":53036,"_3010":53246},[],"`config.call_timeout`",{"_3554":1016,"_30673":934,"_21251":53248,"_5":14613,"_27884":53036,"_3010":53249},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3554":1017,"_30673":934,"_21251":53251,"_5":14613,"_27884":53036,"_3010":53252},[],"Rules for that configuration:",{"_3554":1018,"_30673":934,"_21251":53254,"_5":14613,"_27884":53036,"_3010":53255},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3554":1019,"_30673":934,"_21251":53257,"_5":14613,"_27884":53036,"_3010":53258},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3554":1020,"_30673":934,"_21251":53260,"_5":14613,"_27884":53036,"_3010":53261},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3554":1021,"_30673":934,"_21251":53263,"_5":14613,"_27884":53036,"_3010":53264},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3554":1022,"_30673":934,"_21251":53266,"_5":14613,"_27884":53036,"_3010":53267},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3554":1023,"_30673":934,"_21251":53269,"_5":14613,"_27884":53036,"_3010":53270},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3554":1024,"_30673":934,"_21251":53272,"_5":14613,"_27884":53036,"_3010":53273},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3554":1025,"_30673":934,"_21251":53275,"_5":14613,"_27884":53036,"_3010":53276},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3554":1026,"_30673":934,"_21251":53278,"_5":14613,"_27884":53036,"_3010":53279},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3554":1027,"_30673":934,"_21251":53281,"_5":14613,"_27884":53040,"_3010":53282},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3554":1028,"_30673":934,"_21251":53284,"_5":14613,"_27884":53044,"_3010":53285},[],"`settings.reenrollment_settings` field",{"_3554":1029,"_30673":934,"_21251":53287,"_5":14613,"_27884":53044,"_3010":50473},[],{"_3554":1030,"_30673":934,"_21251":53289,"_5":14613,"_27884":53044,"_3010":53290},[],"`reenrollment_delta`",{"_3554":1031,"_30673":934,"_21251":53292,"_5":14613,"_27884":53044,"_3010":53293},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3554":1032,"_30673":934,"_21251":53295,"_5":14613,"_27884":53044,"_3010":53296},[],"`preventive_delta`",{"_3554":1033,"_30673":934,"_21251":53298,"_5":14613,"_27884":53044,"_3010":53299},[],"Preventive operational monitoring threshold.",{"_3554":1034,"_30673":934,"_21251":53301,"_5":14613,"_27884":53044,"_3010":53302},[],"`critical_delta`",{"_3554":1035,"_30673":934,"_21251":53304,"_5":14613,"_27884":53044,"_3010":53305},[],"Critical operational monitoring threshold.",{"_3554":1036,"_30673":934,"_21251":53307,"_5":14613,"_27884":53044,"_3010":53308},[],"`enable_expired_renewal`",{"_3554":1037,"_30673":934,"_21251":53310,"_5":14613,"_27884":53044,"_3010":53311},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3554":1038,"_30673":934,"_21251":53313,"_5":14613,"_27884":53044,"_3010":53314},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3554":1039,"_30673":934,"_21251":53316,"_5":14613,"_27884":53044,"_3010":53317},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3554":1040,"_30673":934,"_21251":53319,"_5":14613,"_27884":53044,"_3010":53320},[],"`revoke_on_reenrollment`",{"_3554":1041,"_30673":934,"_21251":53322,"_5":14613,"_27884":53044,"_3010":53323},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3554":1042,"_30673":934,"_21251":53325,"_5":14613,"_27884":53044,"_3010":53326},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3554":1043,"_30673":934,"_21251":53328,"_5":14613,"_27884":53048,"_3010":53329},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3554":1044,"_30673":934,"_21251":53331,"_5":14613,"_27884":53052,"_3010":50467},[],{"_3554":1045,"_30673":934,"_21251":53333,"_5":14613,"_27884":53052,"_3010":53334},[],"Published material",{"_3554":1046,"_30673":934,"_21251":53336,"_5":14613,"_27884":53052,"_3010":53337},[],"**Include Lamassu System CA**",{"_3554":1047,"_30673":934,"_21251":53339,"_5":14613,"_27884":53052,"_3010":53340},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3554":1048,"_30673":934,"_21251":53342,"_5":14613,"_27884":53052,"_3010":53343},[],"**Include Enrollment CA**",{"_3554":1049,"_30673":934,"_21251":53345,"_5":14613,"_27884":53052,"_3010":53346},[],"Selected issuing CA certificate.",{"_3554":1050,"_30673":934,"_21251":53348,"_5":14613,"_27884":53052,"_3010":53349},[],"**Managed CAs**",{"_3554":1051,"_30673":934,"_21251":53351,"_5":14613,"_27884":53052,"_3010":53352},[],"Explicitly selected CA certificates.",{"_3554":1052,"_30673":934,"_21251":53354,"_5":14613,"_27884":53052,"_3010":53355},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3554":1053,"_30673":934,"_21251":53357,"_5":14613,"_27884":53056,"_3010":53358},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3554":1054,"_30673":934,"_21251":53360,"_5":14613,"_27884":53056,"_3010":53361},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3554":1055,"_30673":934,"_21251":53363,"_5":14613,"_27884":53056,"_3010":53364},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3554":1056,"_30673":934,"_21251":53366,"_5":14613,"_27884":53060,"_3010":53367},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3554":1057,"_30673":1057,"_5":14965,"_3010":53369,"_31032":53370,"_21251":53371,"_27884":1057},"Integrate the EST client",[50083,51558,52730,52728,52911],[],{"_3554":1058,"_30673":1057,"_21251":53373,"_5":14613,"_27884":1057,"_3010":53374},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3554":1059,"_30673":1057,"_5":31029,"_21251":53376,"_27884":53377,"_3010":50093},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3554":1060,"_30673":1057,"_5":31029,"_21251":53379,"_27884":53380,"_3010":53381},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3554":1061,"_30673":1057,"_5":31029,"_21251":53383,"_27884":53384,"_3010":53385},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3554":1062,"_30673":1057,"_5":31029,"_21251":53387,"_27884":53388,"_3010":53389},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3554":1063,"_30673":1057,"_5":31029,"_21251":53391,"_27884":53392,"_3010":53393},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3554":1064,"_30673":1057,"_5":31029,"_21251":53395,"_27884":53396,"_3010":53397},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3554":1065,"_30673":1057,"_21251":53399,"_5":14613,"_27884":1057,"_3010":53400},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3554":1066,"_30673":1057,"_21251":53402,"_5":14613,"_27884":53377,"_3010":53403},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3554":1067,"_30673":1057,"_21251":53405,"_5":14613,"_27884":53377,"_3010":53406},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3554":1068,"_30673":1057,"_21251":53408,"_5":14613,"_27884":53377,"_3010":53409},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3554":1069,"_30673":1057,"_21251":53411,"_5":14613,"_27884":53380,"_3010":53412},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3554":1070,"_30673":1057,"_21251":53414,"_5":14613,"_27884":53380,"_3010":53415},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3554":1071,"_30673":1057,"_21251":53417,"_5":14613,"_27884":53384,"_3010":53418},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3554":1072,"_30673":1057,"_21251":53420,"_5":14613,"_27884":53384,"_3010":53421},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3554":1073,"_30673":1057,"_21251":53423,"_5":14613,"_27884":53388,"_3010":53424},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3554":1074,"_30673":1057,"_21251":53426,"_5":14613,"_27884":53388,"_3010":53427},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3554":1075,"_30673":1057,"_21251":53429,"_5":14613,"_27884":53392,"_3010":53430},[],"For a root that issues directly:",{"_3554":1076,"_30673":1057,"_21251":53432,"_5":14613,"_27884":53392,"_3010":53433},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3554":1077,"_30673":1057,"_21251":53435,"_5":14613,"_27884":53392,"_3010":53436},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3554":1078,"_30673":1057,"_21251":53438,"_5":14613,"_27884":53396,"_3010":53439},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3554":1079,"_30673":1079,"_5":14965,"_3010":53441,"_31032":53442,"_21251":53443,"_27884":1079},"EST reference",[50083,51558,52730,52728,52911],[],{"_3554":1080,"_30673":1079,"_21251":53445,"_5":14613,"_27884":1079,"_3010":53446},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3554":1081,"_30673":1079,"_5":31029,"_21251":53448,"_27884":53449,"_3010":53450},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3554":1082,"_30673":1079,"_5":31029,"_21251":53452,"_27884":53453,"_3010":23026},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3554":1083,"_30673":1079,"_5":31029,"_21251":53455,"_27884":53456,"_3010":26456},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3554":1084,"_30673":1079,"_5":31029,"_21251":53458,"_27884":53459,"_3010":26463},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3554":1085,"_30673":1079,"_5":31029,"_21251":53461,"_27884":53462,"_3010":25751},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3554":1086,"_30673":1079,"_5":31029,"_21251":53464,"_27884":53465,"_3010":53466},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3554":1087,"_30673":1079,"_5":31029,"_21251":53468,"_27884":53469,"_3010":53470},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3554":1088,"_30673":1079,"_5":31029,"_21251":53472,"_27884":53473,"_3010":53474},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3554":1089,"_30673":1079,"_21251":53476,"_5":14613,"_27884":1079,"_3010":53477},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3554":1090,"_30673":1079,"_21251":53479,"_5":14613,"_27884":53449,"_3010":53480},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3554":1091,"_30673":1079,"_21251":53482,"_5":14613,"_27884":53449,"_3010":53483},[],"Operation",{"_3554":1092,"_30673":1079,"_21251":53485,"_5":14613,"_27884":53449,"_3010":53486},[],"Method",{"_3554":1093,"_30673":1079,"_21251":53488,"_5":14613,"_27884":53449,"_3010":53489},[],"Authentication and condition",{"_3554":1094,"_30673":1079,"_21251":53491,"_5":14613,"_27884":53449,"_3010":53492},[],"`/cacerts`",{"_3554":1095,"_30673":1079,"_21251":53494,"_5":14613,"_27884":53449,"_3010":53495},[],"GET",{"_3554":1096,"_30673":1079,"_21251":53497,"_5":14613,"_27884":53449,"_3010":53498},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3554":1097,"_30673":1079,"_21251":53500,"_5":14613,"_27884":53449,"_3010":53501},[],"`/simpleenroll`",{"_3554":1098,"_30673":1079,"_21251":53503,"_5":14613,"_27884":53449,"_3010":53504},[],"POST",{"_3554":1099,"_30673":1079,"_21251":53506,"_5":14613,"_27884":53449,"_3010":53507},[],"Initial authentication and DMS registration/replacement policy.",{"_3554":1100,"_30673":1079,"_21251":53509,"_5":14613,"_27884":53449,"_3010":53510},[],"`/simplereenroll`",{"_3554":1101,"_30673":1079,"_21251":53512,"_5":14613,"_27884":53449,"_3010":53504},[],{"_3554":1102,"_30673":1079,"_21251":53514,"_5":14613,"_27884":53449,"_3010":53515},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3554":1103,"_30673":1079,"_21251":53517,"_5":14613,"_27884":53449,"_3010":53518},[],"`/serverkeygen`",{"_3554":1104,"_30673":1079,"_21251":53520,"_5":14613,"_27884":53449,"_3010":53504},[],{"_3554":1105,"_30673":1079,"_21251":53522,"_5":14613,"_27884":53449,"_3010":53523},[],"Initial authentication and admission; server generation enabled.",{"_3554":1106,"_30673":1079,"_21251":53525,"_5":14613,"_27884":53449,"_3010":53526},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3554":1107,"_30673":1079,"_21251":53528,"_5":14613,"_27884":53453,"_3010":53529},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3554":1108,"_30673":1079,"_21251":53531,"_5":14613,"_27884":53453,"_3010":53532},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3554":1109,"_30673":1079,"_21251":53534,"_5":14613,"_27884":53456,"_3010":53535},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3554":1110,"_30673":1079,"_21251":53537,"_5":14613,"_27884":53456,"_3010":53538},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3554":1111,"_30673":1079,"_21251":53540,"_5":14613,"_27884":53459,"_3010":53541},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3554":1112,"_30673":1079,"_21251":53543,"_5":14613,"_27884":53459,"_3010":53544},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3554":1113,"_30673":1079,"_21251":53546,"_5":14613,"_27884":53462,"_3010":53547},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3554":1114,"_30673":1079,"_21251":53549,"_5":14613,"_27884":53462,"_3010":53550},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3554":1115,"_30673":1079,"_21251":53552,"_5":14613,"_27884":53465,"_3010":53553},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3554":1116,"_30673":1079,"_21251":53555,"_5":14613,"_27884":53465,"_3010":53556},[],"Part",{"_3554":1117,"_30673":1079,"_21251":53558,"_5":14613,"_27884":53465,"_3010":53559},[],"Content after decoding its Base64",{"_3554":1118,"_30673":1079,"_21251":53561,"_5":14613,"_27884":53465,"_3010":53562},[],"`application/pkcs8`",{"_3554":1119,"_30673":1079,"_21251":53564,"_5":14613,"_27884":53465,"_3010":53565},[],"Unencrypted DER PKCS#8 private key.",{"_3554":1120,"_30673":1079,"_21251":53567,"_5":14613,"_27884":53465,"_3010":53568},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3554":1121,"_30673":1079,"_21251":53570,"_5":14613,"_27884":53465,"_3010":53571},[],"DER PKCS#7 containing the issued certificate.",{"_3554":1122,"_30673":1079,"_21251":53573,"_5":14613,"_27884":53465,"_3010":53574},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3554":1123,"_30673":1079,"_21251":53576,"_5":14613,"_27884":53469,"_3010":53577},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3554":1124,"_30673":1079,"_21251":53579,"_5":14613,"_27884":53469,"_3010":53580},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3554":1125,"_30673":1079,"_21251":53582,"_5":14613,"_27884":53469,"_3010":53583},[],"Convert and check the result:",{"_3554":1126,"_30673":1079,"_21251":53585,"_5":14613,"_27884":53469,"_3010":53586},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3554":1127,"_30673":1079,"_21251":53588,"_5":14613,"_27884":53473,"_3010":53589},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3554":1128,"_30673":1079,"_21251":53591,"_5":14613,"_27884":53473,"_3010":53592},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3554":1129,"_30673":1129,"_5":14965,"_3010":52911,"_31032":53594,"_21251":53595,"_27884":1129},[50083,51558,52730,52728,52911],[],{"_3554":1130,"_30673":1129,"_21251":53597,"_5":14613,"_27884":1129,"_3010":53598},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3554":1131,"_30673":1129,"_5":31029,"_21251":53600,"_27884":53601,"_3010":53602},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3554":1132,"_30673":1129,"_5":31029,"_21251":53604,"_27884":53605,"_3010":53606},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3554":1133,"_30673":1129,"_5":31029,"_21251":53608,"_27884":53609,"_3010":53610},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3554":1134,"_30673":1129,"_5":31029,"_21251":53612,"_27884":53613,"_3010":53614},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3554":1135,"_30673":1129,"_21251":53616,"_5":14613,"_27884":1129,"_3010":53617},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3554":1136,"_30673":1129,"_21251":53619,"_5":14613,"_27884":53601,"_3010":53620},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3554":1137,"_30673":1129,"_21251":53622,"_5":14613,"_27884":53601,"_3010":53623},[],"The integrator installs initial EST server trust and an admission credential.",{"_3554":1138,"_30673":1129,"_21251":53625,"_5":14613,"_27884":53601,"_3010":53626},[],"The client requests an identity for its `Device ID` through EST.",{"_3554":1139,"_30673":1129,"_21251":53628,"_5":14613,"_27884":53601,"_3010":53629},[],"Certificate, device binding and key/certificate installation are checked.",{"_3554":1140,"_30673":1129,"_21251":53631,"_5":14613,"_27884":53601,"_3010":53632},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3554":1141,"_30673":1129,"_21251":53634,"_5":14613,"_27884":53601,"_3010":53635},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3554":1142,"_30673":1129,"_21251":53637,"_5":14613,"_27884":53605,"_3010":53638},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3554":1143,"_30673":1129,"_21251":53640,"_5":14613,"_27884":53605,"_3010":53641},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3554":1144,"_30673":1129,"_21251":53643,"_5":14613,"_27884":53605,"_3010":53644},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3554":1145,"_30673":1129,"_21251":53646,"_5":14613,"_27884":53605,"_3010":53647},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3554":1146,"_30673":1129,"_21251":53649,"_5":14613,"_27884":53609,"_3010":53650},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3554":1147,"_30673":1129,"_21251":53652,"_5":14613,"_27884":53609,"_3010":53653},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3554":1148,"_30673":1129,"_21251":53655,"_5":14613,"_27884":53609,"_3010":53656},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3554":1149,"_30673":1129,"_21251":53658,"_5":14613,"_27884":53609,"_3010":53659},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3554":1150,"_30673":1129,"_21251":53661,"_5":14613,"_27884":53613,"_3010":53662},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3554":1151,"_30673":1129,"_21251":53664,"_5":14613,"_27884":53613,"_3010":53665},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3554":1152,"_30673":1152,"_5":14965,"_3010":53667,"_31032":53668,"_21251":53669,"_27884":1152},"Provisioning strategies",[50083,51558,52730,52728,52911],[],{"_3554":1153,"_30673":1152,"_21251":53671,"_5":14613,"_27884":1152,"_3010":53672},[],"Choose device registration, identity authorization and key generation.",{"_3554":1154,"_30673":1152,"_5":31029,"_21251":53674,"_27884":53675,"_3010":53676},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3554":1155,"_30673":1152,"_5":31029,"_21251":53678,"_27884":53679,"_3010":53680},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3554":1156,"_30673":1152,"_5":31029,"_21251":53682,"_27884":53683,"_3010":53684},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3554":1157,"_30673":1152,"_5":31029,"_21251":53686,"_27884":53687,"_3010":53688},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3554":1158,"_30673":1152,"_5":31029,"_21251":53690,"_27884":53691,"_3010":53692},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3554":1159,"_30673":1152,"_21251":53694,"_5":14613,"_27884":1152,"_3010":53695},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3554":1160,"_30673":1152,"_21251":53697,"_5":14613,"_27884":53675,"_3010":53698},[],"Path",{"_3554":1161,"_30673":1152,"_21251":53700,"_5":14613,"_27884":53675,"_3010":53701},[],"When the device exists",{"_3554":1162,"_30673":1152,"_21251":53703,"_5":14613,"_27884":53675,"_3010":53704},[],"What to check",{"_3554":1163,"_30673":1152,"_21251":53706,"_5":14613,"_27884":53675,"_3010":53707},[],"Manual assignment",{"_3554":1164,"_30673":1152,"_21251":53709,"_5":14613,"_27884":53675,"_3010":53710},[],"An operator creates it before associating a certificate.",{"_3554":1165,"_30673":1152,"_21251":53712,"_5":14613,"_27884":53675,"_3010":53713},[],"ID, owning DMS, certificate CN and bound serial.",{"_3554":1166,"_30673":1152,"_21251":53715,"_5":14613,"_27884":53675,"_3010":53716},[],"EST with `JITP`",{"_3554":1167,"_30673":1152,"_21251":53718,"_5":14613,"_27884":53675,"_3010":53719},[],"Created for an unknown CN during `/simpleenroll`.",{"_3554":1168,"_30673":1152,"_21251":53721,"_5":14613,"_27884":53675,"_3010":53722},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3554":1169,"_30673":1152,"_21251":53724,"_5":14613,"_27884":53675,"_3010":53725},[],"EST with `PRE_REGISTRATION`",{"_3554":1170,"_30673":1152,"_21251":53727,"_5":14613,"_27884":53675,"_3010":53728},[],"Must exist before `/simpleenroll`.",{"_3554":1171,"_30673":1152,"_21251":53730,"_5":14613,"_27884":53675,"_3010":53731},[],"Approved record, same DMS and replacement conditions for your version.",{"_3554":1172,"_30673":1152,"_21251":53733,"_5":14613,"_27884":53675,"_3010":53734},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3554":1173,"_30673":1152,"_21251":53736,"_5":14613,"_27884":53675,"_3010":53737},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3554":1174,"_30673":1152,"_21251":53739,"_5":14613,"_27884":53679,"_3010":53740},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3554":1175,"_30673":1152,"_21251":53742,"_5":14613,"_27884":53679,"_3010":53743},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3554":1176,"_30673":1152,"_21251":53745,"_5":14613,"_27884":53679,"_3010":53746},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3554":1177,"_30673":1152,"_21251":53748,"_5":14613,"_27884":53683,"_3010":53749},[],"Decide initial enrollment and re-enrollment separately:",{"_3554":1178,"_30673":1152,"_21251":53751,"_5":14613,"_27884":53683,"_3010":53752},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3554":1179,"_30673":1152,"_21251":53754,"_5":14613,"_27884":53683,"_3010":53755},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3554":1180,"_30673":1152,"_21251":53757,"_5":14613,"_27884":53683,"_3010":53758},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3554":1181,"_30673":1152,"_21251":53760,"_5":14613,"_27884":53683,"_3010":53761},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3554":1182,"_30673":1152,"_21251":53763,"_5":14613,"_27884":53683,"_3010":53764},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3554":1183,"_30673":1152,"_21251":53766,"_5":14613,"_27884":53687,"_3010":50467},[],{"_3554":1184,"_30673":1152,"_21251":53768,"_5":14613,"_27884":53687,"_3010":53769},[],"Material crossing EST",{"_3554":1185,"_30673":1152,"_21251":53771,"_5":14613,"_27884":53687,"_3010":53772},[],"Device-generated key",{"_3554":1186,"_30673":1152,"_21251":53774,"_5":14613,"_27884":53687,"_3010":53775},[],"Public CSR and certificate; the key stays on the client.",{"_3554":1187,"_30673":1152,"_21251":53777,"_5":14613,"_27884":53687,"_3010":53778},[],"Existing device key",{"_3554":1188,"_30673":1152,"_21251":53780,"_5":14613,"_27884":53687,"_3010":53781},[],"CSR signed with that key and a new certificate.",{"_3554":1189,"_30673":1152,"_21251":53783,"_5":14613,"_27884":53687,"_3010":53049},[],{"_3554":1190,"_30673":1152,"_21251":53785,"_5":14613,"_27884":53687,"_3010":53786},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3554":1191,"_30673":1152,"_21251":53788,"_5":14613,"_27884":53687,"_3010":53789},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3554":1192,"_30673":1152,"_21251":53791,"_5":14613,"_27884":53691,"_3010":53792},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3554":1193,"_30673":1193,"_5":14965,"_3010":53794,"_31032":53795,"_21251":53796,"_27884":1193},"Renewal and recovery",[50083,51558,52730,52728,52911],[],{"_3554":1194,"_30673":1193,"_21251":53798,"_5":14613,"_27884":1193,"_3010":53799},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3554":1195,"_30673":1193,"_5":31029,"_21251":53801,"_27884":53802,"_3010":53803},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3554":1196,"_30673":1193,"_5":31029,"_21251":53805,"_27884":53806,"_3010":53807},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3554":1197,"_30673":1193,"_5":31029,"_21251":53809,"_27884":53810,"_3010":53811},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3554":1198,"_30673":1193,"_5":31029,"_21251":53813,"_27884":53814,"_3010":53815},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3554":1199,"_30673":1193,"_5":31029,"_21251":53817,"_27884":53818,"_3010":53819},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3554":1200,"_30673":1193,"_21251":53821,"_5":14613,"_27884":1193,"_3010":53822},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3554":1201,"_30673":1193,"_21251":53824,"_5":14613,"_27884":53802,"_3010":53825},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3554":1202,"_30673":1193,"_21251":53827,"_5":14613,"_27884":53802,"_3010":53828},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3554":1203,"_30673":1193,"_21251":53830,"_5":14613,"_27884":53802,"_3010":53831},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3554":1204,"_30673":1193,"_21251":53833,"_5":14613,"_27884":53802,"_3010":53834},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3554":1205,"_30673":1193,"_21251":53836,"_5":14613,"_27884":53806,"_3010":53837},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3554":1206,"_30673":1193,"_21251":53839,"_5":14613,"_27884":53806,"_3010":53840},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3554":1207,"_30673":1193,"_21251":53842,"_5":14613,"_27884":53810,"_3010":53843},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3554":1208,"_30673":1193,"_21251":53845,"_5":14613,"_27884":53810,"_3010":53846},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3554":1209,"_30673":1193,"_21251":53848,"_5":14613,"_27884":53810,"_3010":53849},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3554":1210,"_30673":1193,"_21251":53851,"_5":14613,"_27884":53814,"_3010":53852},[],"Situation",{"_3554":1211,"_30673":1193,"_21251":53854,"_5":14613,"_27884":53814,"_3010":53855},[],"Procedure",{"_3554":1212,"_30673":1193,"_21251":53857,"_5":14613,"_27884":53814,"_3010":53858},[],"Valid certificate, outside the window",{"_3554":1213,"_30673":1193,"_21251":53860,"_5":14613,"_27884":53814,"_3010":53861},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3554":1214,"_30673":1193,"_21251":53863,"_5":14613,"_27884":53814,"_3010":53864},[],"Expired certificate, key available",{"_3554":1215,"_30673":1193,"_21251":53866,"_5":14613,"_27884":53814,"_3010":53867},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3554":1216,"_30673":1193,"_21251":53869,"_5":14613,"_27884":53814,"_3010":53870},[],"Renewal through webhook or `NO_AUTH`",{"_3554":1217,"_30673":1193,"_21251":53872,"_5":14613,"_27884":53814,"_3010":53873},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3554":1218,"_30673":1193,"_21251":53875,"_5":14613,"_27884":53814,"_3010":53876},[],"Lost or inaccessible key",{"_3554":1219,"_30673":1193,"_21251":53878,"_5":14613,"_27884":53814,"_3010":53879},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3554":1220,"_30673":1193,"_21251":53881,"_5":14613,"_27884":53814,"_3010":53882},[],"Current identity revoked",{"_3554":1221,"_30673":1193,"_21251":53884,"_5":14613,"_27884":53814,"_3010":53885},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3554":1222,"_30673":1193,"_21251":53887,"_5":14613,"_27884":53814,"_3010":53888},[],"Device without an identity",{"_3554":1223,"_30673":1193,"_21251":53890,"_5":14613,"_27884":53814,"_3010":53891},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3554":1224,"_30673":1193,"_21251":53893,"_5":14613,"_27884":53814,"_3010":53894},[],"Retired device",{"_3554":1225,"_30673":1193,"_21251":53896,"_5":14613,"_27884":53814,"_3010":53897},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3554":1226,"_30673":1193,"_21251":53899,"_5":14613,"_27884":53814,"_3010":53900},[],"Timeout, HTTP 500 or installation failure",{"_3554":1227,"_30673":1193,"_21251":53902,"_5":14613,"_27884":53814,"_3010":53903},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3554":1228,"_30673":1193,"_21251":53905,"_5":14613,"_27884":53818,"_3010":53906},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3554":1229,"_30673":1193,"_21251":53908,"_5":14613,"_27884":53818,"_3010":53909},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3554":1230,"_30673":1230,"_5":14965,"_3010":53911,"_31032":53912,"_21251":53913,"_27884":1230},"Enrollment troubleshooting",[50083,51558,52730,52728,52911],[],{"_3554":1231,"_30673":1230,"_21251":53915,"_5":14613,"_27884":1230,"_3010":53916},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3554":1232,"_30673":1230,"_5":31029,"_21251":53918,"_27884":53919,"_3010":53920},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3554":1233,"_30673":1230,"_5":31029,"_21251":53922,"_27884":53923,"_3010":53924},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3554":1234,"_30673":1230,"_5":31029,"_21251":53926,"_27884":53927,"_3010":53474},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3554":1235,"_30673":1230,"_5":31029,"_21251":53929,"_27884":53930,"_3010":53931},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3554":1236,"_30673":1230,"_21251":53933,"_5":14613,"_27884":1230,"_3010":53934},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3554":1237,"_30673":1230,"_21251":53936,"_5":14613,"_27884":53923,"_3010":53937},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3554":1238,"_30673":1230,"_21251":53939,"_5":14613,"_27884":53923,"_3010":53940},[],"Symptom or message",{"_3554":1239,"_30673":1230,"_21251":53942,"_5":14613,"_27884":53923,"_3010":53704},[],{"_3554":1240,"_30673":1230,"_21251":53944,"_5":14613,"_27884":53923,"_3010":53945},[],"curl rejects TLS, name or issuer",{"_3554":1241,"_30673":1230,"_21251":53947,"_5":14613,"_27884":53923,"_3010":53948},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3554":1242,"_30673":1230,"_21251":53950,"_5":14613,"_27884":53923,"_3010":53951},[],"404 or missing APS",{"_3554":1243,"_30673":1230,"_21251":53953,"_5":14613,"_27884":53923,"_3010":53954},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3554":1244,"_30673":1230,"_21251":53956,"_5":14613,"_27884":53923,"_3010":53957},[],"400, CSR or format error",{"_3554":1245,"_30673":1230,"_21251":53959,"_5":14613,"_27884":53923,"_3010":53960},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3554":1246,"_30673":1230,"_21251":53962,"_5":14613,"_27884":53923,"_3010":53963},[],"Missing credential or invalid certificate",{"_3554":1247,"_30673":1230,"_21251":53965,"_5":14613,"_27884":53923,"_3010":53966},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3554":1248,"_30673":1230,"_21251":53968,"_5":14613,"_27884":53923,"_3010":53969},[],"Webhook denies, times out or responds without authorization",{"_3554":1249,"_30673":1230,"_21251":53971,"_5":14613,"_27884":53923,"_3010":53972},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3554":1250,"_30673":1230,"_21251":53974,"_5":14613,"_27884":53923,"_3010":53975},[],"`unexpected status code: <n>: redirects are not followed`",{"_3554":1251,"_30673":1230,"_21251":53977,"_5":14613,"_27884":53923,"_3010":53978},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3554":1252,"_30673":1230,"_21251":53980,"_5":14613,"_27884":53923,"_3010":53981},[],"`webhook response exceeds 1048576 bytes`",{"_3554":1253,"_30673":1230,"_21251":53983,"_5":14613,"_27884":53923,"_3010":53984},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3554":1254,"_30673":1230,"_21251":53986,"_5":14613,"_27884":53923,"_3010":53987},[],"`webhook config must not reference files`",{"_3554":1255,"_30673":1230,"_21251":53989,"_5":14613,"_27884":53923,"_3010":53990},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3554":1256,"_30673":1230,"_21251":53992,"_5":14613,"_27884":53923,"_3010":53993},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3554":1257,"_30673":1230,"_21251":53995,"_5":14613,"_27884":53923,"_3010":53996},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3554":1258,"_30673":1230,"_21251":53998,"_5":14613,"_27884":53923,"_3010":53999},[],"`webhook mTLS certificate and key are invalid: …`",{"_3554":1259,"_30673":1230,"_21251":54001,"_5":14613,"_27884":53923,"_3010":54002},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3554":1260,"_30673":1230,"_21251":54004,"_5":14613,"_27884":53923,"_3010":54005},[],"400 `struct validation error` creating or updating a DMS",{"_3554":1261,"_30673":1230,"_21251":54007,"_5":14613,"_27884":53923,"_3010":54008},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3554":1262,"_30673":1230,"_21251":54010,"_5":14613,"_27884":53923,"_3010":54011},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3554":1263,"_30673":1230,"_21251":54013,"_5":14613,"_27884":53923,"_3010":54014},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3554":1264,"_30673":1230,"_21251":54016,"_5":14613,"_27884":53923,"_3010":54017},[],"`device not preregistered`",{"_3554":1265,"_30673":1230,"_21251":54019,"_5":14613,"_27884":53923,"_3010":54020},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3554":1266,"_30673":1230,"_21251":54022,"_5":14613,"_27884":53923,"_3010":54023},[],"`forbiddenNewEnrollment`",{"_3554":1267,"_30673":1230,"_21251":54025,"_5":14613,"_27884":53923,"_3010":54026},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3554":1268,"_30673":1230,"_21251":54028,"_5":14613,"_27884":53923,"_3010":54029},[],"Different owning DMS",{"_3554":1269,"_30673":1230,"_21251":54031,"_5":14613,"_27884":53923,"_3010":54032},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3554":1270,"_30673":1230,"_21251":54034,"_5":14613,"_27884":53923,"_3010":54035},[],"`invalid RawSubject bytes`",{"_3554":1271,"_30673":1230,"_21251":54037,"_5":14613,"_27884":53923,"_3010":54038},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3554":1272,"_30673":1230,"_21251":54040,"_5":14613,"_27884":53923,"_3010":54041},[],"`invalid reenroll window`",{"_3554":1273,"_30673":1230,"_21251":54043,"_5":14613,"_27884":53923,"_3010":54044},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3554":1274,"_30673":1230,"_21251":54046,"_5":14613,"_27884":53923,"_3010":54047},[],"Current certificate revoked",{"_3554":1275,"_30673":1230,"_21251":54049,"_5":14613,"_27884":53923,"_3010":54050},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3554":1276,"_30673":1230,"_21251":54052,"_5":14613,"_27884":53923,"_3010":54053},[],"CA, profile or signing error",{"_3554":1277,"_30673":1230,"_21251":54055,"_5":14613,"_27884":53923,"_3010":54056},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3554":1278,"_30673":1230,"_21251":54058,"_5":14613,"_27884":53923,"_3010":54059},[],"HTTP 200 without a device connection",{"_3554":1279,"_30673":1230,"_21251":54061,"_5":14613,"_27884":53923,"_3010":54062},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3554":1280,"_30673":1230,"_21251":54064,"_5":14613,"_27884":53923,"_3010":54065},[],"Timeout or error after issuance",{"_3554":1281,"_30673":1230,"_21251":54067,"_5":14613,"_27884":53923,"_3010":54068},[],"New certificates, current slot and previous identity's state before retrying.",{"_3554":1282,"_30673":1230,"_21251":54070,"_5":14613,"_27884":53927,"_3010":54071},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3554":1283,"_30673":1230,"_21251":54073,"_5":14613,"_27884":53927,"_3010":54074},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3554":1284,"_30673":1230,"_21251":54076,"_5":14613,"_27884":53930,"_3010":54077},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3554":1285,"_30673":1230,"_21251":54079,"_5":14613,"_27884":53930,"_3010":54080},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3554":1286,"_30673":1230,"_21251":54082,"_5":14613,"_27884":53930,"_3010":54083},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3554":1287,"_30673":1230,"_21251":54085,"_5":14613,"_27884":53930,"_3010":54086},[],"Make one request, save headers/body and query the device and certificates.",{"_3554":1288,"_30673":1230,"_21251":54088,"_5":14613,"_27884":53930,"_3010":54089},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3554":1289,"_30673":1230,"_21251":54091,"_5":14613,"_27884":53930,"_3010":54092},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3554":1290,"_30673":1230,"_21251":54094,"_5":14613,"_27884":53930,"_3010":54095},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3554":1291,"_30673":1291,"_5":14965,"_3010":54097,"_31032":54098,"_21251":54099,"_27884":1291},"Trust distribution and updates",[50083,51558,52730,52728,52911],[],{"_3554":1292,"_30673":1291,"_21251":54101,"_5":14613,"_27884":1291,"_3010":54102},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3554":1293,"_30673":1291,"_5":31029,"_21251":54104,"_27884":54105,"_3010":54106},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3554":1294,"_30673":1291,"_5":31029,"_21251":54108,"_27884":54109,"_3010":54110},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3554":1295,"_30673":1291,"_5":31029,"_21251":54112,"_27884":54113,"_3010":54114},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3554":1296,"_30673":1291,"_5":31029,"_21251":54116,"_27884":54117,"_3010":54118},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3554":1297,"_30673":1291,"_5":31029,"_21251":54120,"_27884":54121,"_3010":54122},[],"/docs/pr-preview/pr-69/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3554":1298,"_30673":1291,"_21251":54124,"_5":14613,"_27884":1291,"_3010":54125},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3554":1299,"_30673":1291,"_21251":54127,"_5":14613,"_27884":54105,"_3010":54128},[],"Relationship",{"_3554":1300,"_30673":1291,"_21251":54130,"_5":14613,"_27884":54105,"_3010":54131},[],"Material prepared by its owner",{"_3554":1301,"_30673":1291,"_21251":54133,"_5":14613,"_27884":54105,"_3010":54134},[],"Device → EST server",{"_3554":1302,"_30673":1291,"_21251":54136,"_5":14613,"_27884":54105,"_3010":54137},[],"Previously verified server root, chain or pin and TLS name.",{"_3554":1303,"_30673":1291,"_21251":54139,"_5":14613,"_27884":54105,"_3010":54140},[],"DMS → requester",{"_3554":1304,"_30673":1291,"_21251":54142,"_5":14613,"_27884":54105,"_3010":54143},[],"CAs and rules authorizing initial or renewal credentials.",{"_3554":1305,"_30673":1291,"_21251":54145,"_5":14613,"_27884":54105,"_3010":54146},[],"Consumer → device",{"_3554":1306,"_30673":1291,"_21251":54148,"_5":14613,"_27884":54105,"_3010":54149},[],"Operational identity roots, intermediates, validation and permissions.",{"_3554":1307,"_30673":1291,"_21251":54151,"_5":14613,"_27884":54105,"_3010":54152},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3554":1308,"_30673":1291,"_21251":54154,"_5":14613,"_27884":54109,"_3010":54155},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3554":1309,"_30673":1291,"_21251":54157,"_5":14613,"_27884":54109,"_3010":54158},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3554":1310,"_30673":1291,"_21251":54160,"_5":14613,"_27884":54113,"_3010":54161},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3554":1311,"_30673":1291,"_21251":54163,"_5":14613,"_27884":54113,"_3010":54164},[],"Select policy-approved roots as anchors.",{"_3554":1312,"_30673":1291,"_21251":54166,"_5":14613,"_27884":54113,"_3010":54167},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3554":1313,"_30673":1291,"_21251":54169,"_5":14613,"_27884":54113,"_3010":54170},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3554":1314,"_30673":1291,"_21251":54172,"_5":14613,"_27884":54113,"_3010":54173},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3554":1315,"_30673":1291,"_21251":54175,"_5":14613,"_27884":54113,"_3010":54176},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3554":1316,"_30673":1291,"_21251":54178,"_5":14613,"_27884":54117,"_3010":54179},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3554":1317,"_30673":1291,"_21251":54181,"_5":14613,"_27884":54117,"_3010":54182},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3554":1318,"_30673":1291,"_21251":54184,"_5":14613,"_27884":54117,"_3010":54185},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3554":1319,"_30673":1291,"_21251":54187,"_5":14613,"_27884":54121,"_3010":54188},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3554":1320,"_30673":1320,"_5":14965,"_3010":54190,"_31032":54191,"_21251":54193,"_27884":1320},"AWS IoT Core",[50083,51558,52730,52728,54192],"Integrations",[],{"_3554":1321,"_30673":1320,"_21251":54195,"_5":14613,"_27884":1320,"_3010":54196},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3554":1322,"_30673":1320,"_5":31029,"_21251":54198,"_27884":54199,"_3010":54200},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3554":1323,"_30673":1320,"_5":31029,"_21251":54202,"_27884":54203,"_3010":54204},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3554":1324,"_30673":1320,"_5":31029,"_21251":54206,"_27884":54207,"_3010":54208},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3554":1325,"_30673":1320,"_5":31029,"_21251":54210,"_27884":54211,"_3010":54212},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3554":1326,"_30673":1320,"_5":31029,"_21251":54214,"_27884":54215,"_3010":54216},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3554":1327,"_30673":1320,"_5":31029,"_21251":54218,"_27884":54219,"_3010":54220},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3554":1328,"_30673":1320,"_5":31029,"_21251":54222,"_27884":54223,"_3010":54224},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3554":1329,"_30673":1320,"_5":31029,"_21251":54226,"_27884":54227,"_3010":54228},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3554":1330,"_30673":1320,"_5":31029,"_21251":54230,"_27884":54231,"_3010":54232},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3554":1331,"_30673":1320,"_5":31029,"_21251":54234,"_27884":54235,"_3010":54236},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3554":1332,"_30673":1320,"_5":31029,"_21251":54238,"_27884":54239,"_3010":54240},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3554":1333,"_30673":1320,"_5":31029,"_21251":54242,"_27884":54243,"_3010":54244},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3554":1334,"_30673":1320,"_5":31029,"_21251":54246,"_27884":54247,"_3010":54248},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3554":1335,"_30673":1320,"_5":31029,"_21251":54250,"_27884":54251,"_3010":54252},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3554":1336,"_30673":1320,"_5":31029,"_21251":54254,"_27884":54255,"_3010":54256},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3554":1337,"_30673":1320,"_5":31029,"_21251":54258,"_27884":54259,"_3010":54260},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3554":1338,"_30673":1320,"_5":31029,"_21251":54262,"_27884":54263,"_3010":54264},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3554":1339,"_30673":1320,"_5":31029,"_21251":54266,"_27884":54267,"_3010":54268},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3554":1340,"_30673":1320,"_5":31029,"_21251":54270,"_27884":54271,"_3010":54272},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3554":1341,"_30673":1320,"_5":31029,"_21251":54274,"_27884":54275,"_3010":54276},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3554":1342,"_30673":1320,"_5":31029,"_21251":54278,"_27884":54279,"_3010":54280},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3554":1343,"_30673":1320,"_5":31029,"_21251":54282,"_27884":54283,"_3010":54284},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3554":1344,"_30673":1320,"_5":31029,"_21251":54286,"_27884":54287,"_3010":54288},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3554":1345,"_30673":1320,"_5":31029,"_21251":54290,"_27884":54291,"_3010":54292},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3554":1346,"_30673":1320,"_5":31029,"_21251":54294,"_27884":54295,"_3010":54296},[],"/docs/pr-preview/pr-69/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3554":1347,"_30673":1320,"_21251":54298,"_5":14613,"_27884":1320,"_3010":54299},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3554":1348,"_30673":1320,"_21251":54301,"_5":14613,"_27884":1320,"_3010":54302},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3554":1349,"_30673":1320,"_21251":54304,"_5":14613,"_27884":1320,"_3010":54305},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3554":1350,"_30673":1320,"_21251":54307,"_5":14613,"_27884":54199,"_3010":54308},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3554":1351,"_30673":1320,"_21251":54310,"_5":14613,"_27884":54199,"_3010":54311},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3554":1352,"_30673":1320,"_21251":54313,"_5":14613,"_27884":54199,"_3010":54314},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3554":1353,"_30673":1320,"_21251":54316,"_5":14613,"_27884":54199,"_3010":54317},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3554":1354,"_30673":1320,"_21251":54319,"_5":14613,"_27884":54203,"_3010":54320},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3554":1355,"_30673":1320,"_21251":54322,"_5":14613,"_27884":54207,"_3010":54323},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3554":1356,"_30673":1320,"_21251":54325,"_5":14613,"_27884":54207,"_3010":54326},[],"IAM action",{"_3554":1357,"_30673":1320,"_21251":54328,"_5":14613,"_27884":54207,"_3010":50473},[],{"_3554":1358,"_30673":1320,"_21251":54330,"_5":14613,"_27884":54207,"_3010":54331},[],"`iot:GetRegistrationCode`",{"_3554":1359,"_30673":1320,"_21251":54333,"_5":14613,"_27884":54207,"_3010":54334},[],"Obtain the verification code for CA registration in the Primary Account",{"_3554":1360,"_30673":1320,"_21251":54336,"_5":14613,"_27884":54207,"_3010":54337},[],"`iot:RegisterCACertificate`",{"_3554":1361,"_30673":1320,"_21251":54339,"_5":14613,"_27884":54207,"_3010":54340},[],"Register the CA in AWS IoT",{"_3554":1362,"_30673":1320,"_21251":54342,"_5":14613,"_27884":54207,"_3010":54343},[],"`iot:DescribeCACertificate`",{"_3554":1363,"_30673":1320,"_21251":54345,"_5":14613,"_27884":54207,"_3010":54346},[],"Check the CA registration status",{"_3554":1364,"_30673":1320,"_21251":54348,"_5":14613,"_27884":54207,"_3010":54349},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3554":1365,"_30673":1320,"_21251":54351,"_5":14613,"_27884":54207,"_3010":54352},[],"Create or update Things in IoT Core",{"_3554":1366,"_30673":1320,"_21251":54354,"_5":14613,"_27884":54207,"_3010":54355},[],"`iot:RegisterThing`",{"_3554":1367,"_30673":1320,"_21251":54357,"_5":14613,"_27884":54207,"_3010":54358},[],"Provision Things through a template",{"_3554":1368,"_30673":1320,"_21251":54360,"_5":14613,"_27884":54207,"_3010":54361},[],"`iot:RegisterCertificate`",{"_3554":1369,"_30673":1320,"_21251":54363,"_5":14613,"_27884":54207,"_3010":54364},[],"Register device certificates",{"_3554":1370,"_30673":1320,"_21251":54366,"_5":14613,"_27884":54207,"_3010":54367},[],"`iot:UpdateCertificate`",{"_3554":1371,"_30673":1320,"_21251":54369,"_5":14613,"_27884":54207,"_3010":54370},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3554":1372,"_30673":1320,"_21251":54372,"_5":14613,"_27884":54207,"_3010":54373},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3554":1373,"_30673":1320,"_21251":54375,"_5":14613,"_27884":54207,"_3010":54376},[],"Create and attach IoT policies",{"_3554":1374,"_30673":1320,"_21251":54378,"_5":14613,"_27884":54207,"_3010":54379},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3554":1375,"_30673":1320,"_21251":54381,"_5":14613,"_27884":54207,"_3010":54382},[],"Manage Thing groups",{"_3554":1376,"_30673":1320,"_21251":54384,"_5":14613,"_27884":54207,"_3010":54385},[],"`iot:CreateProvisioningTemplate`",{"_3554":1377,"_30673":1320,"_21251":54387,"_5":14613,"_27884":54207,"_3010":54388},[],"Create JITP templates",{"_3554":1378,"_30673":1320,"_21251":54390,"_5":14613,"_27884":54207,"_3010":54391},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3554":1379,"_30673":1320,"_21251":54393,"_5":14613,"_27884":54207,"_3010":54394},[],"Read and write the Device Shadow",{"_3554":1380,"_30673":1320,"_21251":54396,"_5":14613,"_27884":54207,"_3010":54397},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3554":1381,"_30673":1320,"_21251":54399,"_5":14613,"_27884":54211,"_3010":54400},[],"Parameter",{"_3554":1382,"_30673":1320,"_21251":54402,"_5":14613,"_27884":54211,"_3010":54403},[],"Type",{"_3554":1383,"_30673":1320,"_21251":54405,"_5":14613,"_27884":54211,"_3010":54406},[],"Required",{"_3554":1384,"_30673":1320,"_21251":54408,"_5":14613,"_27884":54211,"_3010":54409},[],"Description",{"_3554":1385,"_30673":1320,"_21251":54411,"_5":14613,"_27884":54211,"_3010":54412},[],"`connector_id`",{"_3554":1386,"_30673":1320,"_21251":54414,"_5":14613,"_27884":54211,"_3010":25376},[],{"_3554":1387,"_30673":1320,"_21251":54416,"_5":14613,"_27884":54211,"_3010":54417},[],"Yes",{"_3554":1388,"_30673":1320,"_21251":54419,"_5":14613,"_27884":54211,"_3010":54420},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3554":1389,"_30673":1320,"_21251":54422,"_5":14613,"_27884":54211,"_3010":54423},[],"`aws_config.region`",{"_3554":1390,"_30673":1320,"_21251":54425,"_5":14613,"_27884":54211,"_3010":25376},[],{"_3554":1391,"_30673":1320,"_21251":54427,"_5":14613,"_27884":54211,"_3010":54417},[],{"_3554":1392,"_30673":1320,"_21251":54429,"_5":14613,"_27884":54211,"_3010":54430},[],"AWS region where the connector operates.",{"_3554":1393,"_30673":1320,"_21251":54432,"_5":14613,"_27884":54211,"_3010":54433},[],"`aws_config.auth_method`",{"_3554":1394,"_30673":1320,"_21251":54435,"_5":14613,"_27884":54211,"_3010":25376},[],{"_3554":1395,"_30673":1320,"_21251":54437,"_5":14613,"_27884":54211,"_3010":54417},[],{"_3554":1396,"_30673":1320,"_21251":54439,"_5":14613,"_27884":54211,"_3010":54440},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3554":1397,"_30673":1320,"_21251":54442,"_5":14613,"_27884":54211,"_3010":54443},[],"`aws_config.access_key_id`",{"_3554":1398,"_30673":1320,"_21251":54445,"_5":14613,"_27884":54211,"_3010":25376},[],{"_3554":1399,"_30673":1320,"_21251":54447,"_5":14613,"_27884":54211,"_3010":54448},[],"Only with `auth_method=static`",{"_3554":1400,"_30673":1320,"_21251":54450,"_5":14613,"_27884":54211,"_3010":54451},[],"AWS access key.",{"_3554":1401,"_30673":1320,"_21251":54453,"_5":14613,"_27884":54211,"_3010":54454},[],"`aws_config.secret_access_key`",{"_3554":1402,"_30673":1320,"_21251":54456,"_5":14613,"_27884":54211,"_3010":25376},[],{"_3554":1403,"_30673":1320,"_21251":54458,"_5":14613,"_27884":54211,"_3010":54448},[],{"_3554":1404,"_30673":1320,"_21251":54460,"_5":14613,"_27884":54211,"_3010":54461},[],"AWS secret key.",{"_3554":1405,"_30673":1320,"_21251":54463,"_5":14613,"_27884":54211,"_3010":54464},[],"`aws_config.session_token`",{"_3554":1406,"_30673":1320,"_21251":54466,"_5":14613,"_27884":54211,"_3010":25376},[],{"_3554":1407,"_30673":1320,"_21251":54468,"_5":14613,"_27884":54211,"_3010":54469},[],"No",{"_3554":1408,"_30673":1320,"_21251":54471,"_5":14613,"_27884":54211,"_3010":54472},[],"Session token (with `auth_method=static`).",{"_3554":1409,"_30673":1320,"_21251":54474,"_5":14613,"_27884":54211,"_3010":54475},[],"`aws_config.role_arn`",{"_3554":1410,"_30673":1320,"_21251":54477,"_5":14613,"_27884":54211,"_3010":25376},[],{"_3554":1411,"_30673":1320,"_21251":54479,"_5":14613,"_27884":54211,"_3010":54480},[],"Only with `auth_method=role`",{"_3554":1412,"_30673":1320,"_21251":54482,"_5":14613,"_27884":54211,"_3010":54483},[],"ARN of the role to assume.",{"_3554":1413,"_30673":1320,"_21251":54485,"_5":14613,"_27884":54211,"_3010":54486},[],"`aws_config.endpoint_url`",{"_3554":1414,"_30673":1320,"_21251":54488,"_5":14613,"_27884":54211,"_3010":25376},[],{"_3554":1415,"_30673":1320,"_21251":54490,"_5":14613,"_27884":54211,"_3010":54469},[],{"_3554":1416,"_30673":1320,"_21251":54492,"_5":14613,"_27884":54211,"_3010":54493},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3554":1417,"_30673":1320,"_21251":54495,"_5":14613,"_27884":54211,"_3010":54496},[],"`subscriber_event_bus`",{"_3554":1418,"_30673":1320,"_21251":54498,"_5":14613,"_27884":54211,"_3010":17893},[],{"_3554":1419,"_30673":1320,"_21251":54500,"_5":14613,"_27884":54211,"_3010":54417},[],{"_3554":1420,"_30673":1320,"_21251":54502,"_5":14613,"_27884":54211,"_3010":54503},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3554":1421,"_30673":1320,"_21251":54505,"_5":14613,"_27884":54211,"_3010":54506},[],"`dms_manager_client`",{"_3554":1422,"_30673":1320,"_21251":54508,"_5":14613,"_27884":54211,"_3010":25376},[],{"_3554":1423,"_30673":1320,"_21251":54510,"_5":14613,"_27884":54211,"_3010":54417},[],{"_3554":1424,"_30673":1320,"_21251":54512,"_5":14613,"_27884":54211,"_3010":54513},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3554":1425,"_30673":1320,"_21251":54515,"_5":14613,"_27884":54211,"_3010":54516},[],"`device_manager_client`",{"_3554":1426,"_30673":1320,"_21251":54518,"_5":14613,"_27884":54211,"_3010":25376},[],{"_3554":1427,"_30673":1320,"_21251":54520,"_5":14613,"_27884":54211,"_3010":54417},[],{"_3554":1428,"_30673":1320,"_21251":54522,"_5":14613,"_27884":54211,"_3010":54523},[],"HTTP URL of Lamassu's Device Manager.",{"_3554":1429,"_30673":1320,"_21251":54525,"_5":14613,"_27884":54211,"_3010":54526},[],"`ca_client`",{"_3554":1430,"_30673":1320,"_21251":54528,"_5":14613,"_27884":54211,"_3010":25376},[],{"_3554":1431,"_30673":1320,"_21251":54530,"_5":14613,"_27884":54211,"_3010":54417},[],{"_3554":1432,"_30673":1320,"_21251":54532,"_5":14613,"_27884":54211,"_3010":54533},[],"HTTP URL of Lamassu's CA service.",{"_3554":1433,"_30673":1320,"_21251":54535,"_5":14613,"_27884":54215,"_3010":54536},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3554":1434,"_30673":1320,"_21251":54538,"_5":14613,"_27884":54215,"_3010":54539},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3554":1435,"_30673":1320,"_21251":54541,"_5":14613,"_27884":54215,"_3010":54542},[],"CloudEvent type",{"_3554":1436,"_30673":1320,"_21251":54544,"_5":14613,"_27884":54215,"_3010":54545},[],"Lamassu resource",{"_3554":1437,"_30673":1320,"_21251":54547,"_5":14613,"_27884":54215,"_3010":54548},[],"AWS Resource",{"_3554":1438,"_30673":1320,"_21251":54550,"_5":14613,"_27884":54215,"_3010":54551},[],"IAM actions",{"_3554":1439,"_30673":1320,"_21251":54553,"_5":14613,"_27884":54215,"_3010":54554},[],"AWS calls and effect",{"_3554":1440,"_30673":1320,"_21251":54556,"_5":14613,"_27884":54215,"_3010":54557},[],"Where in this page",{"_3554":1441,"_30673":1320,"_21251":54559,"_5":14613,"_27884":54215,"_3010":54560},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3554":1442,"_30673":1320,"_21251":54562,"_5":14613,"_27884":54215,"_3010":54563},[],"CA",{"_3554":1443,"_30673":1320,"_21251":54565,"_5":14613,"_27884":54215,"_3010":54566},[],"`IoTCore/CACertificate`",{"_3554":1444,"_30673":1320,"_21251":54568,"_5":14613,"_27884":54215,"_3010":54569},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3554":1445,"_30673":1320,"_21251":54571,"_5":14613,"_27884":54215,"_3010":54572},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3554":1446,"_30673":1320,"_21251":54574,"_5":14613,"_27884":54215,"_3010":54228},[],{"_3554":1447,"_30673":1320,"_21251":54576,"_5":14613,"_27884":54215,"_3010":54577},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3554":1448,"_30673":1320,"_21251":54579,"_5":14613,"_27884":54215,"_3010":54580},[],"DMS",{"_3554":1449,"_30673":1320,"_21251":54582,"_5":14613,"_27884":54215,"_3010":54583},[],"`IoTCore/ProvisioningTemplate`",{"_3554":1450,"_30673":1320,"_21251":54585,"_5":14613,"_27884":54215,"_3010":54586},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3554":1451,"_30673":1320,"_21251":54588,"_5":14613,"_27884":54215,"_3010":54589},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3554":1452,"_30673":1320,"_21251":54591,"_5":14613,"_27884":54215,"_3010":54256},[],{"_3554":1453,"_30673":1320,"_21251":54593,"_5":14613,"_27884":54215,"_3010":54594},[],"`EventBindDeviceIdentityKey`",{"_3554":1454,"_30673":1320,"_21251":54596,"_5":14613,"_27884":54215,"_3010":54597},[],"Device",{"_3554":1455,"_30673":1320,"_21251":54599,"_5":14613,"_27884":54215,"_3010":54600},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3554":1456,"_30673":1320,"_21251":54602,"_5":14613,"_27884":54215,"_3010":54603},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3554":1457,"_30673":1320,"_21251":54605,"_5":14613,"_27884":54215,"_3010":54606},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3554":1458,"_30673":1320,"_21251":54608,"_5":14613,"_27884":54215,"_3010":54264},[],{"_3554":1459,"_30673":1320,"_21251":54610,"_5":14613,"_27884":54215,"_3010":54611},[],"`EventUpdateCertificateStatusKey`",{"_3554":1460,"_30673":1320,"_21251":54613,"_5":14613,"_27884":54215,"_3010":54614},[],"Certificate",{"_3554":1461,"_30673":1320,"_21251":54616,"_5":14613,"_27884":54215,"_3010":54617},[],"`IoTCore/Certificate`",{"_3554":1462,"_30673":1320,"_21251":54619,"_5":14613,"_27884":54215,"_3010":54620},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3554":1463,"_30673":1320,"_21251":54622,"_5":14613,"_27884":54215,"_3010":54623},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3554":1464,"_30673":1320,"_21251":54625,"_5":14613,"_27884":54215,"_3010":54276},[],{"_3554":1465,"_30673":1320,"_21251":54627,"_5":14613,"_27884":54215,"_3010":54628},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3554":1466,"_30673":1320,"_21251":54630,"_5":14613,"_27884":54215,"_3010":54631},[],"Certificate / Device",{"_3554":1467,"_30673":1320,"_21251":54633,"_5":14613,"_27884":54215,"_3010":54634},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3554":1468,"_30673":1320,"_21251":54636,"_5":14613,"_27884":54215,"_3010":50479},[],{"_3554":1469,"_30673":1320,"_21251":54638,"_5":14613,"_27884":54215,"_3010":54639},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3554":1470,"_30673":1320,"_21251":54641,"_5":14613,"_27884":54215,"_3010":54284},[],{"_3554":1471,"_30673":1320,"_21251":54643,"_5":14613,"_27884":54219,"_3010":54644},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3554":1472,"_30673":1320,"_21251":54646,"_5":14613,"_27884":54223,"_3010":54647},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3554":1473,"_30673":1320,"_21251":54649,"_5":14613,"_27884":54223,"_3010":54650},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3554":1474,"_30673":1320,"_21251":54652,"_5":14613,"_27884":54227,"_3010":54653},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3554":1475,"_30673":1320,"_21251":54655,"_5":14613,"_27884":54227,"_3010":54656},[],"Transition",{"_3554":1476,"_30673":1320,"_21251":54658,"_5":14613,"_27884":54227,"_3010":54659},[],"AWS calls",{"_3554":1477,"_30673":1320,"_21251":54661,"_5":14613,"_27884":54227,"_3010":54662},[],"`NotRegistered` → `Requested`",{"_3554":1478,"_30673":1320,"_21251":54664,"_5":14613,"_27884":54227,"_3010":54665},[],"none (metadata write only)",{"_3554":1479,"_30673":1320,"_21251":54667,"_5":14613,"_27884":54227,"_3010":54668},[],"`Requested` → `Registering`",{"_3554":1480,"_30673":1320,"_21251":54670,"_5":14613,"_27884":54227,"_3010":54671},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3554":1481,"_30673":1320,"_21251":54673,"_5":14613,"_27884":54227,"_3010":54674},[],"`Registering` → `Succeeded`",{"_3554":1482,"_30673":1320,"_21251":54676,"_5":14613,"_27884":54227,"_3010":54677},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3554":1483,"_30673":1320,"_21251":54679,"_5":14613,"_27884":54227,"_3010":54680},[],"`Registering` → `Failed`",{"_3554":1484,"_30673":1320,"_21251":54682,"_5":14613,"_27884":54227,"_3010":54683},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3554":1485,"_30673":1320,"_21251":54685,"_5":14613,"_27884":54227,"_3010":54686},[],"`Failed` / `Succeeded` → `Requested`",{"_3554":1486,"_30673":1320,"_21251":54688,"_5":14613,"_27884":54227,"_3010":54689},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3554":1487,"_30673":1320,"_21251":54691,"_5":14613,"_27884":54231,"_3010":54692},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3554":1488,"_30673":1320,"_21251":54694,"_5":14613,"_27884":54231,"_3010":54695},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3554":1489,"_30673":1320,"_21251":54697,"_5":14613,"_27884":54231,"_3010":54698},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3554":1490,"_30673":1320,"_21251":54700,"_5":14613,"_27884":54231,"_3010":54701},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3554":1491,"_30673":1320,"_21251":54703,"_5":14613,"_27884":54231,"_3010":54704},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3554":1492,"_30673":1320,"_21251":54706,"_5":14613,"_27884":54231,"_3010":54707},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3554":1493,"_30673":1320,"_21251":54709,"_5":14613,"_27884":54235,"_3010":54710},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3554":1494,"_30673":1320,"_21251":54712,"_5":14613,"_27884":54239,"_3010":54713},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3554":1495,"_30673":1320,"_21251":54715,"_5":14613,"_27884":54239,"_3010":54716},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3554":1496,"_30673":1320,"_21251":54718,"_5":14613,"_27884":54243,"_3010":54719},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3554":1497,"_30673":1320,"_21251":54721,"_5":14613,"_27884":54247,"_3010":54722},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3554":1498,"_30673":1320,"_21251":54724,"_5":14613,"_27884":54247,"_3010":54725},[],"Creates or updates the IoT policies configured in the DMS.",{"_3554":1499,"_30673":1320,"_21251":54727,"_5":14613,"_27884":54247,"_3010":54728},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3554":1500,"_30673":1320,"_21251":54730,"_5":14613,"_27884":54247,"_3010":54731},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3554":1501,"_30673":1320,"_21251":54733,"_5":14613,"_27884":54247,"_3010":54734},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3554":1502,"_30673":1320,"_21251":54736,"_5":14613,"_27884":54247,"_3010":54737},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3554":1503,"_30673":1320,"_21251":54739,"_5":14613,"_27884":54247,"_3010":54740},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3554":1504,"_30673":1320,"_21251":54742,"_5":14613,"_27884":54251,"_3010":54743},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3554":1505,"_30673":1320,"_21251":54745,"_5":14613,"_27884":54251,"_3010":54746},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3554":1506,"_30673":1320,"_21251":54748,"_5":14613,"_27884":54251,"_3010":54749},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3554":1507,"_30673":1320,"_21251":54751,"_5":14613,"_27884":54251,"_3010":54752},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3554":1508,"_30673":1320,"_21251":54754,"_5":14613,"_27884":54251,"_3010":54755},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3554":1509,"_30673":1320,"_21251":54757,"_5":14613,"_27884":54255,"_3010":54758},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3554":1510,"_30673":1320,"_21251":54760,"_5":14613,"_27884":54255,"_3010":54656},[],{"_3554":1511,"_30673":1320,"_21251":54762,"_5":14613,"_27884":54255,"_3010":54659},[],{"_3554":1512,"_30673":1320,"_21251":54764,"_5":14613,"_27884":54255,"_3010":54765},[],"`Unconfigured` → `None` / `Auto`",{"_3554":1513,"_30673":1320,"_21251":54767,"_5":14613,"_27884":54255,"_3010":54768},[],"none (configuration only)",{"_3554":1514,"_30673":1320,"_21251":54770,"_5":14613,"_27884":54255,"_3010":54771},[],"`None` ↔ `Auto`",{"_3554":1515,"_30673":1320,"_21251":54773,"_5":14613,"_27884":54255,"_3010":54768},[],{"_3554":1516,"_30673":1320,"_21251":54775,"_5":14613,"_27884":54255,"_3010":54776},[],"Any → `Jitp`",{"_3554":1517,"_30673":1320,"_21251":54778,"_5":14613,"_27884":54255,"_3010":54779},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3554":1518,"_30673":1320,"_21251":54781,"_5":14613,"_27884":54255,"_3010":54782},[],"`Jitp` → `None` / `Auto`",{"_3554":1519,"_30673":1320,"_21251":54784,"_5":14613,"_27884":54255,"_3010":54785},[],"none (the template stays in the AWS account)",{"_3554":1520,"_30673":1320,"_21251":54787,"_5":14613,"_27884":54259,"_3010":54788},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3554":1521,"_30673":1320,"_21251":54790,"_5":14613,"_27884":54259,"_3010":54791},[],"The full flow from the device's perspective is:",{"_3554":1522,"_30673":1320,"_21251":54793,"_5":14613,"_27884":54259,"_3010":54794},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3554":1523,"_30673":1320,"_21251":54796,"_5":14613,"_27884":54263,"_3010":54797},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3554":1524,"_30673":1320,"_21251":54799,"_5":14613,"_27884":54263,"_3010":54656},[],{"_3554":1525,"_30673":1320,"_21251":54801,"_5":14613,"_27884":54263,"_3010":54659},[],{"_3554":1526,"_30673":1320,"_21251":54803,"_5":14613,"_27884":54263,"_3010":54804},[],"`Absent` → `Provisioned`",{"_3554":1527,"_30673":1320,"_21251":54806,"_5":14613,"_27884":54263,"_3010":54807},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3554":1528,"_30673":1320,"_21251":54809,"_5":14613,"_27884":54263,"_3010":54810},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3554":1529,"_30673":1320,"_21251":54812,"_5":14613,"_27884":54263,"_3010":54813},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3554":1530,"_30673":1320,"_21251":54815,"_5":14613,"_27884":54263,"_3010":54816},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3554":1531,"_30673":1320,"_21251":54818,"_5":14613,"_27884":54267,"_3010":54819},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3554":1532,"_30673":1320,"_21251":54821,"_5":14613,"_27884":54267,"_3010":54822},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3554":1533,"_30673":1320,"_21251":54824,"_5":14613,"_27884":54267,"_3010":54825},[],"For the JITP flow to work correctly:",{"_3554":1534,"_30673":1320,"_21251":54827,"_5":14613,"_27884":54267,"_3010":54828},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3554":1535,"_30673":1320,"_21251":54830,"_5":14613,"_27884":54267,"_3010":54831},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3554":1536,"_30673":1320,"_21251":54833,"_5":14613,"_27884":54267,"_3010":54834},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3554":1537,"_30673":1320,"_21251":54836,"_5":14613,"_27884":54267,"_3010":54837},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3554":1538,"_30673":1320,"_21251":54839,"_5":14613,"_27884":54271,"_3010":54840},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3554":1539,"_30673":1320,"_21251":54842,"_5":14613,"_27884":54271,"_3010":54843},[],"Status in Lamassu",{"_3554":1540,"_30673":1320,"_21251":54845,"_5":14613,"_27884":54271,"_3010":54846},[],"Revocation reason",{"_3554":1541,"_30673":1320,"_21251":54848,"_5":14613,"_27884":54271,"_3010":54849},[],"Status in AWS IoT Core",{"_3554":1542,"_30673":1320,"_21251":54851,"_5":14613,"_27884":54271,"_3010":54852},[],"`Active`",{"_3554":1543,"_30673":1320,"_21251":54854,"_5":14613,"_27884":54271,"_3010":54855},[],"None",{"_3554":1544,"_30673":1320,"_21251":54857,"_5":14613,"_27884":54271,"_3010":54858},[],"`ACTIVE`",{"_3554":1545,"_30673":1320,"_21251":54860,"_5":14613,"_27884":54271,"_3010":54861},[],"`Revoked`",{"_3554":1546,"_30673":1320,"_21251":54863,"_5":14613,"_27884":54271,"_3010":54864},[],"`certificateHold`",{"_3554":1547,"_30673":1320,"_21251":54866,"_5":14613,"_27884":54271,"_3010":54867},[],"`INACTIVE`",{"_3554":1548,"_30673":1320,"_21251":54869,"_5":14613,"_27884":54271,"_3010":54861},[],{"_3554":1549,"_30673":1320,"_21251":54871,"_5":14613,"_27884":54271,"_3010":54872},[],"Any other reason",{"_3554":1550,"_30673":1320,"_21251":54874,"_5":14613,"_27884":54271,"_3010":54875},[],"`REVOKED`",{"_3554":1551,"_30673":1320,"_21251":54877,"_5":14613,"_27884":54271,"_3010":54878},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3554":1552,"_30673":1320,"_21251":54880,"_5":14613,"_27884":54275,"_3010":54881},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3554":1553,"_30673":1320,"_21251":54883,"_5":14613,"_27884":54275,"_3010":54656},[],{"_3554":1554,"_30673":1320,"_21251":54885,"_5":14613,"_27884":54275,"_3010":54659},[],{"_3554":1555,"_30673":1320,"_21251":54887,"_5":14613,"_27884":54275,"_3010":54888},[],"`NotSynced` → `Active`",{"_3554":1556,"_30673":1320,"_21251":54890,"_5":14613,"_27884":54275,"_3010":54367},[],{"_3554":1557,"_30673":1320,"_21251":54892,"_5":14613,"_27884":54275,"_3010":54893},[],"`Active` → `Inactive`",{"_3554":1558,"_30673":1320,"_21251":54895,"_5":14613,"_27884":54275,"_3010":54896},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3554":1559,"_30673":1320,"_21251":54898,"_5":14613,"_27884":54275,"_3010":54899},[],"`Active` → `Revoked`",{"_3554":1560,"_30673":1320,"_21251":54901,"_5":14613,"_27884":54275,"_3010":54896},[],{"_3554":1561,"_30673":1320,"_21251":54903,"_5":14613,"_27884":54275,"_3010":54904},[],"`Inactive` / `Revoked` → `Active`",{"_3554":1562,"_30673":1320,"_21251":54906,"_5":14613,"_27884":54275,"_3010":54367},[],{"_3554":1563,"_30673":1320,"_21251":54908,"_5":14613,"_27884":54275,"_3010":54909},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3554":1564,"_30673":1320,"_21251":54911,"_5":14613,"_27884":54275,"_3010":54912},[],"none (these states are not synced to AWS)",{"_3554":1565,"_30673":1320,"_21251":54914,"_5":14613,"_27884":54279,"_3010":54915},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3554":1566,"_30673":1320,"_21251":54917,"_5":14613,"_27884":54279,"_3010":54918},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3554":1567,"_30673":1320,"_21251":54920,"_5":14613,"_27884":54279,"_3010":54921},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3554":1568,"_30673":1320,"_21251":54923,"_5":14613,"_27884":54283,"_3010":54924},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3554":1569,"_30673":1320,"_21251":54926,"_5":14613,"_27884":54283,"_3010":54927},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3554":1570,"_30673":1320,"_21251":54929,"_5":14613,"_27884":54287,"_3010":54930},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3554":1571,"_30673":1320,"_21251":54932,"_5":14613,"_27884":54287,"_3010":54933},[],"There are two action types:",{"_3554":1572,"_30673":1320,"_21251":54935,"_5":14613,"_27884":54287,"_3010":54936},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3554":1573,"_30673":1320,"_21251":54938,"_5":14613,"_27884":54287,"_3010":54939},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3554":1574,"_30673":1320,"_21251":54941,"_5":14613,"_27884":54287,"_3010":54942},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3554":1575,"_30673":1320,"_21251":54944,"_5":14613,"_27884":54291,"_3010":54945},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3554":1576,"_30673":1320,"_21251":54947,"_5":14613,"_27884":54291,"_3010":54948},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3554":1577,"_30673":1320,"_21251":54950,"_5":14613,"_27884":54291,"_3010":54951},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3554":1578,"_30673":1320,"_21251":54953,"_5":14613,"_27884":54295,"_3010":54954},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3554":1579,"_30673":1320,"_21251":54956,"_5":14613,"_27884":54295,"_3010":54957},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3554":1580,"_30673":1320,"_21251":54959,"_5":14613,"_27884":54295,"_3010":54960},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3554":1581,"_30673":1320,"_21251":54962,"_5":14613,"_27884":54295,"_3010":54963},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3554":1582,"_30673":1320,"_21251":54965,"_5":14613,"_27884":54295,"_3010":54966},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3554":1583,"_30673":1320,"_21251":54968,"_5":14613,"_27884":54295,"_3010":54969},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3554":1584,"_30673":1320,"_21251":54971,"_5":14613,"_27884":54295,"_3010":54972},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3554":1585,"_30673":1320,"_21251":54974,"_5":14613,"_27884":54295,"_3010":54975},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3554":1586,"_30673":1320,"_21251":54977,"_5":14613,"_27884":54295,"_3010":54978},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3554":1587,"_30673":1320,"_21251":54980,"_5":14613,"_27884":54295,"_3010":54981},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3554":1588,"_30673":1320,"_21251":54983,"_5":14613,"_27884":54295,"_3010":54984},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3554":1589,"_30673":1320,"_21251":54986,"_5":14613,"_27884":54295,"_3010":54987},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3554":1590,"_30673":1320,"_21251":54989,"_5":14613,"_27884":54295,"_3010":54990},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3554":1591,"_30673":1320,"_21251":54992,"_5":14613,"_27884":54295,"_3010":54993},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3554":1592,"_30673":1320,"_21251":54995,"_5":14613,"_27884":54295,"_3010":54996},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3554":1593,"_30673":1320,"_21251":54998,"_5":14613,"_27884":54295,"_3010":54999},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3554":1594,"_30673":1320,"_21251":55001,"_5":14613,"_27884":54295,"_3010":55002},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3554":1595,"_30673":1320,"_21251":55004,"_5":14613,"_27884":54295,"_3010":55005},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3554":1596,"_30673":1320,"_21251":55007,"_5":14613,"_27884":54295,"_3010":55008},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3554":1597,"_30673":1320,"_21251":55010,"_5":14613,"_27884":54295,"_3010":55011},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3554":1598,"_30673":1320,"_21251":55013,"_5":14613,"_27884":54295,"_3010":55014},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3554":1599,"_30673":1320,"_21251":55016,"_5":14613,"_27884":54295,"_3010":55017},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3554":1600,"_30673":1320,"_21251":55019,"_5":14613,"_27884":54295,"_3010":55020},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3554":1601,"_30673":1320,"_21251":55022,"_5":14613,"_27884":54295,"_3010":55023},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3554":1602,"_30673":1602,"_5":14965,"_3010":52730,"_31032":55025,"_21251":55026,"_27884":1602},[50083,51558,52730],[],{"_3554":1603,"_30673":1602,"_21251":55028,"_5":14613,"_27884":1602,"_3010":55029},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3554":1604,"_30673":1602,"_5":31029,"_21251":55031,"_27884":55032,"_3010":55033},[],"/docs/pr-preview/pr-69/platform/iot-fleets/overview#start-here","Start here",{"_3554":1605,"_30673":1602,"_5":31029,"_21251":55035,"_27884":55036,"_3010":52728},[],"/docs/pr-preview/pr-69/platform/iot-fleets/overview#devices-and-identities",{"_3554":1606,"_30673":1602,"_5":31029,"_21251":55038,"_27884":55039,"_3010":52911},[],"/docs/pr-preview/pr-69/platform/iot-fleets/overview#enrollment-with-pki",{"_3554":1607,"_30673":1602,"_5":31029,"_21251":55041,"_27884":55042,"_3010":54192},[],"/docs/pr-preview/pr-69/platform/iot-fleets/overview#integrations",{"_3554":1608,"_30673":1602,"_5":31029,"_21251":55044,"_27884":55045,"_3010":55046},[],"/docs/pr-preview/pr-69/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3554":1609,"_30673":1602,"_21251":55048,"_5":14613,"_27884":1602,"_3010":55049},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3554":1610,"_30673":1602,"_21251":55051,"_5":14613,"_27884":55032,"_3010":55052},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3554":1611,"_30673":1602,"_21251":55054,"_5":14613,"_27884":55032,"_3010":55055},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3554":1612,"_30673":1602,"_21251":55057,"_5":14613,"_27884":55036,"_3010":55058},[],"Resource",{"_3554":1613,"_30673":1602,"_21251":55060,"_5":14613,"_27884":55036,"_3010":55061},[],"What it represents",{"_3554":1614,"_30673":1602,"_21251":55063,"_5":14613,"_27884":55036,"_3010":55064},[],"**Device**",{"_3554":1615,"_30673":1602,"_21251":55066,"_5":14613,"_27884":55036,"_3010":55067},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3554":1616,"_30673":1602,"_21251":55069,"_5":14613,"_27884":55036,"_3010":55070},[],"**Identity**",{"_3554":1617,"_30673":1602,"_21251":55072,"_5":14613,"_27884":55036,"_3010":55073},[],"The device's association with its certificates: an active version and a history.",{"_3554":1618,"_30673":1602,"_21251":55075,"_5":14613,"_27884":55036,"_3010":55076},[],"**DMS**",{"_3554":1619,"_30673":1602,"_21251":55078,"_5":14613,"_27884":55036,"_3010":55079},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3554":1620,"_30673":1602,"_21251":55081,"_5":14613,"_27884":55036,"_3010":55082},[],"**Fleet**",{"_3554":1621,"_30673":1602,"_21251":55084,"_5":14613,"_27884":55036,"_3010":55085},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3554":1622,"_30673":1602,"_21251":55087,"_5":14613,"_27884":55036,"_3010":55088},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3554":1623,"_30673":1602,"_21251":55090,"_5":14613,"_27884":55036,"_3010":55091},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3554":1624,"_30673":1602,"_21251":55093,"_5":14613,"_27884":55039,"_3010":55094},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3554":1625,"_30673":1602,"_21251":55096,"_5":14613,"_27884":55039,"_3010":55097},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3554":1626,"_30673":1602,"_21251":55099,"_5":14613,"_27884":55039,"_3010":55100},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3554":1627,"_30673":1602,"_21251":55102,"_5":14613,"_27884":55039,"_3010":55103},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3554":1628,"_30673":1602,"_21251":55105,"_5":14613,"_27884":55039,"_3010":55106},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3554":1629,"_30673":1602,"_21251":55108,"_5":14613,"_27884":55039,"_3010":55109},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3554":1630,"_30673":1602,"_21251":55111,"_5":14613,"_27884":55039,"_3010":55112},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3554":1631,"_30673":1602,"_21251":55114,"_5":14613,"_27884":55039,"_3010":55115},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3554":1632,"_30673":1602,"_21251":55117,"_5":14613,"_27884":55042,"_3010":55118},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3554":1633,"_30673":1602,"_21251":55120,"_5":14613,"_27884":55042,"_3010":55121},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3554":1634,"_30673":1602,"_21251":55123,"_5":14613,"_27884":55045,"_3010":55124},[],"Participant",{"_3554":1635,"_30673":1602,"_21251":55126,"_5":14613,"_27884":55045,"_3010":55127},[],"Responsibility",{"_3554":1636,"_30673":1602,"_21251":55129,"_5":14613,"_27884":55045,"_3010":55130},[],"PKI administrator",{"_3554":1637,"_30673":1602,"_21251":55132,"_5":14613,"_27884":55045,"_3010":55133},[],"CA, issuance profile, chain and revocation publication.",{"_3554":1638,"_30673":1602,"_21251":55135,"_5":14613,"_27884":55045,"_3010":55136},[],"Provisioning administrator",{"_3554":1639,"_30673":1602,"_21251":55138,"_5":14613,"_27884":55045,"_3010":55139},[],"DMS, admission, authentication per operation and inventory.",{"_3554":1640,"_30673":1602,"_21251":55141,"_5":14613,"_27884":55045,"_3010":55142},[],"Device integrator",{"_3554":1641,"_30673":1602,"_21251":55144,"_5":14613,"_27884":55045,"_3010":55145},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3554":1642,"_30673":1602,"_21251":55147,"_5":14613,"_27884":55045,"_3010":55148},[],"Consumer integrator",{"_3554":1643,"_30673":1602,"_21251":55150,"_5":14613,"_27884":55045,"_3010":55151},[],"Trusted issuers, validation and device permissions in the destination.",{"_3554":1644,"_30673":1602,"_21251":55153,"_5":14613,"_27884":55045,"_3010":55154},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3554":1645,"_30673":1645,"_5":14965,"_3010":55156,"_31032":55157,"_21251":55159,"_27884":1645},"Enroll and connect your first device",[50083,51558,52730,55158],"Getting started",[],{"_3554":1646,"_30673":1645,"_21251":55161,"_5":14613,"_27884":1645,"_3010":55162},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3554":1647,"_30673":1645,"_5":31029,"_21251":55164,"_27884":55165,"_3010":50093},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3554":1648,"_30673":1645,"_5":31029,"_21251":55167,"_27884":55168,"_3010":55169},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3554":1649,"_30673":1645,"_5":31029,"_21251":55171,"_27884":55172,"_3010":55173},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3554":1650,"_30673":1645,"_5":31029,"_21251":55175,"_27884":55176,"_3010":55177},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3554":1651,"_30673":1645,"_5":31029,"_21251":55179,"_27884":55180,"_3010":55181},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3554":1652,"_30673":1645,"_5":31029,"_21251":55183,"_27884":55184,"_3010":55185},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3554":1653,"_30673":1645,"_5":31029,"_21251":55187,"_27884":55188,"_3010":55189},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3554":1654,"_30673":1645,"_5":31029,"_21251":55191,"_27884":55192,"_3010":55193},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3554":1655,"_30673":1645,"_21251":55195,"_5":14613,"_27884":1645,"_3010":55196},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3554":1656,"_30673":1645,"_21251":55198,"_5":14613,"_27884":55165,"_3010":55199},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3554":1657,"_30673":1645,"_21251":55201,"_5":14613,"_27884":55165,"_3010":55202},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3554":1658,"_30673":1645,"_21251":55204,"_5":14613,"_27884":55165,"_3010":55205},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3554":1659,"_30673":1645,"_21251":55207,"_5":14613,"_27884":55165,"_3010":55208},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3554":1660,"_30673":1645,"_21251":55210,"_5":14613,"_27884":55165,"_3010":55211},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3554":1661,"_30673":1645,"_21251":55213,"_5":14613,"_27884":55168,"_3010":55214},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3554":1662,"_30673":1645,"_21251":55216,"_5":14613,"_27884":55168,"_3010":55217},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3554":1663,"_30673":1645,"_21251":55219,"_5":14613,"_27884":55172,"_3010":55220},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3554":1664,"_30673":1645,"_21251":55222,"_5":14613,"_27884":55172,"_3010":55223},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3554":1665,"_30673":1645,"_21251":55225,"_5":14613,"_27884":55172,"_3010":55226},[],"Setting",{"_3554":1666,"_30673":1645,"_21251":55228,"_5":14613,"_27884":55172,"_3010":55229},[],"Evaluation value",{"_3554":1667,"_30673":1645,"_21251":55231,"_5":14613,"_27884":55172,"_3010":55232},[],"Enrollment CA",{"_3554":1668,"_30673":1645,"_21251":55234,"_5":14613,"_27884":55172,"_3010":55235},[],"Issuing root from `device-root.pem`.",{"_3554":1669,"_30673":1645,"_21251":55237,"_5":14613,"_27884":55172,"_3010":53041},[],{"_3554":1670,"_30673":1645,"_21251":55239,"_5":14613,"_27884":55172,"_3010":55240},[],"The 1-hour leaf profile you just prepared.",{"_3554":1671,"_30673":1645,"_21251":55242,"_5":14613,"_27884":55172,"_3010":55243},[],"Protocol / Registration Mode",{"_3554":1672,"_30673":1645,"_21251":55245,"_5":14613,"_27884":55172,"_3010":55246},[],"`EST_RFC7030` / `JITP`.",{"_3554":1673,"_30673":1645,"_21251":55248,"_5":14613,"_27884":55172,"_3010":55249},[],"Verify CSR Signature",{"_3554":1674,"_30673":1645,"_21251":55251,"_5":14613,"_27884":55172,"_3010":55252},[],"Enabled.",{"_3554":1675,"_30673":1645,"_21251":55254,"_5":14613,"_27884":55172,"_3010":55255},[],"Enable Replaceable Enrollment",{"_3554":1676,"_30673":1645,"_21251":55257,"_5":14613,"_27884":55172,"_3010":55258},[],"Disabled; the ID must be new.",{"_3554":1677,"_30673":1645,"_21251":55260,"_5":14613,"_27884":55172,"_3010":55261},[],"Initial authentication",{"_3554":1678,"_30673":1645,"_21251":55263,"_5":14613,"_27884":55172,"_3010":55264},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3554":1679,"_30673":1645,"_21251":55266,"_5":14613,"_27884":55172,"_3010":55267},[],"Renewal authentication",{"_3554":1680,"_30673":1645,"_21251":55269,"_5":14613,"_27884":55172,"_3010":55270},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3554":1681,"_30673":1645,"_21251":55272,"_5":14613,"_27884":55172,"_3010":55273},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3554":1682,"_30673":1645,"_21251":55275,"_5":14613,"_27884":55172,"_3010":55276},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3554":1683,"_30673":1645,"_21251":55278,"_5":14613,"_27884":55172,"_3010":55279},[],"Re-enrollment Delta",{"_3554":1684,"_30673":1645,"_21251":55281,"_5":14613,"_27884":55172,"_3010":55282},[],"1 hour.",{"_3554":1685,"_30673":1645,"_21251":55284,"_5":14613,"_27884":55172,"_3010":55285},[],"Preventive / Critical Delta",{"_3554":1686,"_30673":1645,"_21251":55287,"_5":14613,"_27884":55172,"_3010":55288},[],"30 minutes / 10 minutes.",{"_3554":1687,"_30673":1645,"_21251":55290,"_5":14613,"_27884":55172,"_3010":55291},[],"Revoke on Re-enrollment",{"_3554":1688,"_30673":1645,"_21251":55293,"_5":14613,"_27884":55172,"_3010":55294},[],"Disabled to test the successor before retiring the previous identity.",{"_3554":1689,"_30673":1645,"_21251":55296,"_5":14613,"_27884":55172,"_3010":53049},[],{"_3554":1690,"_30673":1645,"_21251":55298,"_5":14613,"_27884":55172,"_3010":55299},[],"Disabled; the operational key is generated in the client.",{"_3554":1691,"_30673":1645,"_21251":55301,"_5":14613,"_27884":55172,"_3010":55302},[],"CA Distribution",{"_3554":1692,"_30673":1645,"_21251":55304,"_5":14613,"_27884":55172,"_3010":55305},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3554":1693,"_30673":1645,"_21251":55307,"_5":14613,"_27884":55172,"_3010":55308},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3554":1694,"_30673":1645,"_21251":55310,"_5":14613,"_27884":55176,"_3010":55311},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3554":1695,"_30673":1645,"_21251":55313,"_5":14613,"_27884":55176,"_3010":55314},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3554":1696,"_30673":1645,"_21251":55316,"_5":14613,"_27884":55180,"_3010":55317},[],"Generate a new key and CSR with the selected identifier:",{"_3554":1697,"_30673":1645,"_21251":55319,"_5":14613,"_27884":55180,"_3010":55320},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3554":1698,"_30673":1645,"_21251":55322,"_5":14613,"_27884":55180,"_3010":55323},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3554":1699,"_30673":1645,"_21251":55325,"_5":14613,"_27884":55184,"_3010":55326},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3554":1700,"_30673":1645,"_21251":55328,"_5":14613,"_27884":55184,"_3010":55329},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3554":1701,"_30673":1645,"_21251":55331,"_5":14613,"_27884":55188,"_3010":55332},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3554":1702,"_30673":1645,"_21251":55334,"_5":14613,"_27884":55188,"_3010":55335},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3554":1703,"_30673":1645,"_21251":55337,"_5":14613,"_27884":55188,"_3010":55338},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3554":1704,"_30673":1645,"_21251":55340,"_5":14613,"_27884":55188,"_3010":55341},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3554":1705,"_30673":1645,"_21251":55343,"_5":14613,"_27884":55188,"_3010":55344},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3554":1706,"_30673":1645,"_21251":55346,"_5":14613,"_27884":55192,"_3010":55347},[],"Check",{"_3554":1707,"_30673":1645,"_21251":55349,"_5":14613,"_27884":55192,"_3010":55350},[],"Expected result",{"_3554":1708,"_30673":1645,"_21251":55352,"_5":14613,"_27884":55192,"_3010":55353},[],"Registration",{"_3554":1709,"_30673":1645,"_21251":55355,"_5":14613,"_27884":55192,"_3010":55356},[],"ID created automatically and correct DMS.",{"_3554":1710,"_30673":1645,"_21251":55358,"_5":14613,"_27884":55192,"_3010":54614},[],{"_3554":1711,"_30673":1645,"_21251":55360,"_5":14613,"_27884":55192,"_3010":55361},[],"CN, profile, serial and key verified.",{"_3554":1712,"_30673":1645,"_21251":55363,"_5":14613,"_27884":55192,"_3010":55364},[],"Inventory",{"_3554":1713,"_30673":1645,"_21251":55366,"_5":14613,"_27884":55192,"_3010":55367},[],"Received serial visible as the current identity and in history.",{"_3554":1714,"_30673":1645,"_21251":55369,"_5":14613,"_27884":55192,"_3010":55370},[],"Consumer",{"_3554":1715,"_30673":1645,"_21251":55372,"_5":14613,"_27884":55192,"_3010":55373},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3554":1716,"_30673":1645,"_21251":55375,"_5":14613,"_27884":55192,"_3010":55376},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3554":1717,"_30673":1645,"_21251":55378,"_5":14613,"_27884":55192,"_3010":55379},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3554":1718,"_30673":1718,"_5":14965,"_3010":52746,"_31032":55381,"_21251":55382,"_27884":1718},[50083,51558,52730,55158],[],{"_3554":1719,"_30673":1718,"_21251":55384,"_5":14613,"_27884":1718,"_3010":55385},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3554":1720,"_30673":1718,"_5":31029,"_21251":55387,"_27884":55388,"_3010":50093},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3554":1721,"_30673":1718,"_5":31029,"_21251":55390,"_27884":55391,"_3010":55392},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3554":1722,"_30673":1718,"_5":31029,"_21251":55394,"_27884":55395,"_3010":55396},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3554":1723,"_30673":1718,"_5":31029,"_21251":55398,"_27884":55399,"_3010":55400},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3554":1724,"_30673":1718,"_5":31029,"_21251":55402,"_27884":55403,"_3010":55404},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3554":1725,"_30673":1718,"_5":31029,"_21251":55406,"_27884":55407,"_3010":55408},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3554":1726,"_30673":1718,"_5":31029,"_21251":55410,"_27884":55411,"_3010":55350},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3554":1727,"_30673":1718,"_5":31029,"_21251":55413,"_27884":55414,"_3010":55415},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3554":1728,"_30673":1718,"_5":31029,"_21251":55417,"_27884":55418,"_3010":55419},[],"/docs/pr-preview/pr-69/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3554":1729,"_30673":1718,"_21251":55421,"_5":14613,"_27884":1718,"_3010":55422},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3554":1730,"_30673":1718,"_21251":55424,"_5":14613,"_27884":1718,"_3010":55425},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3554":1731,"_30673":1718,"_21251":55427,"_5":14613,"_27884":55388,"_3010":55428},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3554":1732,"_30673":1718,"_21251":55430,"_5":14613,"_27884":55388,"_3010":55431},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3554":1733,"_30673":1718,"_21251":55433,"_5":14613,"_27884":55388,"_3010":55434},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3554":1734,"_30673":1718,"_21251":55436,"_5":14613,"_27884":55388,"_3010":55437},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3554":1735,"_30673":1718,"_21251":55439,"_5":14613,"_27884":55391,"_3010":55440},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3554":1736,"_30673":1718,"_21251":55442,"_5":14613,"_27884":55391,"_3010":55443},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3554":1737,"_30673":1718,"_21251":55445,"_5":14613,"_27884":55391,"_3010":55446},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3554":1738,"_30673":1718,"_21251":55448,"_5":14613,"_27884":55391,"_3010":55449},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3554":1739,"_30673":1718,"_21251":55451,"_5":14613,"_27884":55391,"_3010":55452},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3554":1740,"_30673":1718,"_21251":55454,"_5":14613,"_27884":55391,"_3010":55455},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3554":1741,"_30673":1718,"_21251":55457,"_5":14613,"_27884":55391,"_3010":55458},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3554":1742,"_30673":1718,"_21251":55460,"_5":14613,"_27884":55391,"_3010":55461},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3554":1743,"_30673":1718,"_21251":55463,"_5":14613,"_27884":55395,"_3010":55464},[],"Open **Managed Devices** and the registration action. Complete:",{"_3554":1744,"_30673":1718,"_21251":55466,"_5":14613,"_27884":55395,"_3010":55467},[],"**Device ID**: `device-001`.",{"_3554":1745,"_30673":1718,"_21251":55469,"_5":14613,"_27884":55395,"_3010":55470},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3554":1746,"_30673":1718,"_21251":55472,"_5":14613,"_27884":55395,"_3010":55473},[],"**Icon** and **Tags**: optional classification.",{"_3554":1747,"_30673":1718,"_21251":55475,"_5":14613,"_27884":55395,"_3010":55476},[],"Confirm registration.",{"_3554":1748,"_30673":1718,"_21251":55478,"_5":14613,"_27884":55399,"_3010":55479},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3554":1749,"_30673":1718,"_21251":55481,"_5":14613,"_27884":55399,"_3010":55482},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3554":1750,"_30673":1718,"_21251":55484,"_5":14613,"_27884":55403,"_3010":55485},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3554":1751,"_30673":1718,"_21251":55487,"_5":14613,"_27884":55403,"_3010":55488},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3554":1752,"_30673":1718,"_21251":55490,"_5":14613,"_27884":55407,"_3010":55491},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3554":1753,"_30673":1718,"_21251":55493,"_5":14613,"_27884":55407,"_3010":55494},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3554":1754,"_30673":1718,"_21251":55496,"_5":14613,"_27884":55411,"_3010":55347},[],{"_3554":1755,"_30673":1718,"_21251":55498,"_5":14613,"_27884":55411,"_3010":55499},[],"Result",{"_3554":1756,"_30673":1718,"_21251":55501,"_5":14613,"_27884":55411,"_3010":54597},[],{"_3554":1757,"_30673":1718,"_21251":55503,"_5":14613,"_27884":55411,"_3010":55504},[],"`device-001` appears in inventory with the expected DMS.",{"_3554":1758,"_30673":1718,"_21251":55506,"_5":14613,"_27884":55411,"_3010":55507},[],"Current identity",{"_3554":1759,"_30673":1718,"_21251":55509,"_5":14613,"_27884":55411,"_3010":55510},[],"The associated certificate matches the one you verified in PKI.",{"_3554":1760,"_30673":1718,"_21251":55512,"_5":14613,"_27884":55411,"_3010":55513},[],"History",{"_3554":1761,"_30673":1718,"_21251":55515,"_5":14613,"_27884":55411,"_3010":55516},[],"The associated issuance appears with its serial number and dates.",{"_3554":1762,"_30673":1718,"_21251":55518,"_5":14613,"_27884":55411,"_3010":55519},[],"Key and certificate",{"_3554":1763,"_30673":1718,"_21251":55521,"_5":14613,"_27884":55411,"_3010":55522},[],"You have the verified pair ready to install on the device.",{"_3554":1764,"_30673":1718,"_21251":55524,"_5":14613,"_27884":55414,"_3010":55525},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3554":1765,"_30673":1718,"_21251":55527,"_5":14613,"_27884":55414,"_3010":55528},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3554":1766,"_30673":1718,"_21251":55530,"_5":14613,"_27884":55414,"_3010":55531},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3554":1767,"_30673":1718,"_21251":55533,"_5":14613,"_27884":55414,"_3010":55534},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3554":1768,"_30673":1718,"_21251":55536,"_5":14613,"_27884":55418,"_3010":55537},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3554":1769,"_30673":1718,"_21251":55539,"_5":14613,"_27884":55418,"_3010":55540},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3554":1770,"_30673":1718,"_21251":55542,"_5":14613,"_27884":55418,"_3010":55543},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3554":1771,"_30673":1771,"_5":14965,"_3010":55545,"_31032":55546,"_21251":55547,"_27884":1771},"Lamassu IoT Platform",[50083,51558],[],{"_3554":1772,"_30673":1771,"_21251":55549,"_5":14613,"_27884":1771,"_3010":55550},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3554":1773,"_30673":1771,"_5":31029,"_21251":55552,"_27884":55553,"_3010":55033},[],"/docs/pr-preview/pr-69/platform/overview#start-here",{"_3554":1774,"_30673":1771,"_5":31029,"_21251":55555,"_27884":55556,"_3010":55557},[],"/docs/pr-preview/pr-69/platform/overview#choose-your-path","Choose your path",{"_3554":1775,"_30673":1771,"_5":31029,"_21251":55559,"_27884":55560,"_3010":55561},[],"/docs/pr-preview/pr-69/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3554":1776,"_30673":1771,"_5":31029,"_21251":55563,"_27884":55564,"_3010":55565},[],"/docs/pr-preview/pr-69/platform/overview#core-capabilities","Core capabilities",{"_3554":1777,"_30673":1771,"_5":31029,"_21251":55567,"_27884":55568,"_3010":55569},[],"/docs/pr-preview/pr-69/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3554":1778,"_30673":1771,"_5":31029,"_21251":55571,"_27884":55572,"_3010":55573},[],"/docs/pr-preview/pr-69/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3554":1779,"_30673":1771,"_5":31029,"_21251":55575,"_27884":55576,"_3010":55577},[],"/docs/pr-preview/pr-69/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3554":1780,"_30673":1771,"_5":31029,"_21251":55579,"_27884":55580,"_3010":55581},[],"/docs/pr-preview/pr-69/platform/overview#automate-device-identities","Automate device identities",{"_3554":1781,"_30673":1771,"_5":31029,"_21251":55583,"_27884":55584,"_3010":55585},[],"/docs/pr-preview/pr-69/platform/overview#publish-validation-status","Publish validation status",{"_3554":1782,"_30673":1771,"_5":31029,"_21251":55587,"_27884":55588,"_3010":55589},[],"/docs/pr-preview/pr-69/platform/overview#react-to-events","React to events",{"_3554":1783,"_30673":1771,"_5":31029,"_21251":55591,"_27884":55592,"_3010":55593},[],"/docs/pr-preview/pr-69/platform/overview#operational-reference","Operational reference",{"_3554":1784,"_30673":1771,"_21251":55595,"_5":14613,"_27884":1771,"_3010":55596},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3554":1785,"_30673":1771,"_21251":55598,"_5":14613,"_27884":55553,"_3010":55599},[],"Choose the result you need:",{"_3554":1786,"_30673":1771,"_21251":55601,"_5":14613,"_27884":55553,"_3010":55602},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3554":1787,"_30673":1771,"_21251":55604,"_5":14613,"_27884":55553,"_3010":55605},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3554":1788,"_30673":1771,"_21251":55607,"_5":14613,"_27884":55553,"_3010":55608},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3554":1789,"_30673":1771,"_21251":55610,"_5":14613,"_27884":55556,"_3010":55611},[],"Section",{"_3554":1790,"_30673":1771,"_21251":55613,"_5":14613,"_27884":55556,"_3010":55614},[],"What you manage",{"_3554":1791,"_30673":1771,"_21251":55616,"_5":14613,"_27884":55556,"_3010":55617},[],"Entry point",{"_3554":1792,"_30673":1771,"_21251":55619,"_5":14613,"_27884":55556,"_3010":55620},[],"**PKI**",{"_3554":1793,"_30673":1771,"_21251":55622,"_5":14613,"_27884":55556,"_3010":55623},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3554":1794,"_30673":1771,"_21251":55625,"_5":14613,"_27884":55556,"_3010":55626},[],"PKI overview",{"_3554":1795,"_30673":1771,"_21251":55628,"_5":14613,"_27884":55556,"_3010":55629},[],"**IoT Fleets**",{"_3554":1796,"_30673":1771,"_21251":55631,"_5":14613,"_27884":55556,"_3010":55632},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3554":1797,"_30673":1771,"_21251":55634,"_5":14613,"_27884":55556,"_3010":55635},[],"IoT Fleets overview",{"_3554":1798,"_30673":1771,"_21251":55637,"_5":14613,"_27884":55556,"_3010":55638},[],"**Administration**",{"_3554":1799,"_30673":1771,"_21251":55640,"_5":14613,"_27884":55556,"_3010":55641},[],"Operator permissions, audit and event subscriptions.",{"_3554":1800,"_30673":1771,"_21251":55643,"_5":14613,"_27884":55556,"_3010":51560},[],{"_3554":1801,"_30673":1771,"_21251":55645,"_5":14613,"_27884":55556,"_3010":55646},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3554":1802,"_30673":1771,"_21251":55648,"_5":14613,"_27884":55560,"_3010":55649},[],"An identity's journey connects four responsibilities:",{"_3554":1803,"_30673":1771,"_21251":55651,"_5":14613,"_27884":55560,"_3010":55652},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3554":1804,"_30673":1771,"_21251":55654,"_5":14613,"_27884":55560,"_3010":55655},[],"The provisioning administrator configures the DMS and initial trust.",{"_3554":1805,"_30673":1771,"_21251":55657,"_5":14613,"_27884":55560,"_3010":55658},[],"The device client requests a certificate and installs it with the matching key.",{"_3554":1806,"_30673":1771,"_21251":55660,"_5":14613,"_27884":55560,"_3010":55661},[],"The consumer validates the identity and applies its access permissions.",{"_3554":1807,"_30673":1771,"_21251":55663,"_5":14613,"_27884":55560,"_3010":55664},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3554":1808,"_30673":1771,"_21251":55666,"_5":14613,"_27884":55568,"_3010":55667},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3554":1809,"_30673":1771,"_21251":55669,"_5":14613,"_27884":55572,"_3010":55670},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3554":1810,"_30673":1771,"_21251":55672,"_5":14613,"_27884":55576,"_3010":55673},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3554":1811,"_30673":1771,"_21251":55675,"_5":14613,"_27884":55580,"_3010":55676},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3554":1812,"_30673":1771,"_21251":55678,"_5":14613,"_27884":55584,"_3010":55679},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3554":1813,"_30673":1771,"_21251":55681,"_5":14613,"_27884":55588,"_3010":55682},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3554":1814,"_30673":1771,"_21251":55684,"_5":14613,"_27884":55592,"_3010":55127},[],{"_3554":1815,"_30673":1771,"_21251":55686,"_5":14613,"_27884":55592,"_3010":55687},[],"What it prepares or checks",{"_3554":1816,"_30673":1771,"_21251":55689,"_5":14613,"_27884":55592,"_3010":55130},[],{"_3554":1817,"_30673":1771,"_21251":55691,"_5":14613,"_27884":55592,"_3010":55692},[],"Key custody, CA hierarchy, profiles and validation.",{"_3554":1818,"_30673":1771,"_21251":55694,"_5":14613,"_27884":55592,"_3010":55695},[],"Fleet administrator",{"_3554":1819,"_30673":1771,"_21251":55697,"_5":14613,"_27884":55592,"_3010":55698},[],"DMS, device admission, renewal policy and inventory.",{"_3554":1820,"_30673":1771,"_21251":55700,"_5":14613,"_27884":55592,"_3010":55142},[],{"_3554":1821,"_30673":1771,"_21251":55702,"_5":14613,"_27884":55592,"_3010":55703},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3554":1822,"_30673":1771,"_21251":55705,"_5":14613,"_27884":55592,"_3010":55148},[],{"_3554":1823,"_30673":1771,"_21251":55707,"_5":14613,"_27884":55592,"_3010":55708},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3554":1824,"_30673":1771,"_21251":55710,"_5":14613,"_27884":55592,"_3010":55711},[],"Infrastructure operator",{"_3554":1825,"_30673":1771,"_21251":55713,"_5":14613,"_27884":55592,"_3010":55714},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3554":1826,"_30673":1771,"_21251":55716,"_5":14613,"_27884":55592,"_3010":55717},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3554":1827,"_30673":1827,"_5":14965,"_3010":55719,"_31032":55720,"_21251":55723,"_27884":1827},"CA hierarchy and rotation",[50083,51558,55721,55722],"PKI","Keys, authorities and certificates",[],{"_3554":1828,"_30673":1827,"_21251":55725,"_5":14613,"_27884":1827,"_3010":55726},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3554":1829,"_30673":1827,"_5":31029,"_21251":55728,"_27884":55729,"_3010":55730},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3554":1830,"_30673":1827,"_5":31029,"_21251":55732,"_27884":55733,"_3010":55734},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3554":1831,"_30673":1827,"_5":31029,"_21251":55736,"_27884":55737,"_3010":55738},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3554":1832,"_30673":1827,"_5":31029,"_21251":55740,"_27884":55741,"_3010":55742},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3554":1833,"_30673":1827,"_5":31029,"_21251":55744,"_27884":55745,"_3010":55746},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3554":1834,"_30673":1827,"_5":31029,"_21251":55748,"_27884":55749,"_3010":55750},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3554":1835,"_30673":1827,"_5":31029,"_21251":55752,"_27884":55753,"_3010":55754},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3554":1836,"_30673":1827,"_5":31029,"_21251":55756,"_27884":55757,"_3010":55758},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3554":1837,"_30673":1827,"_5":31029,"_21251":55760,"_27884":55761,"_3010":55762},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3554":1838,"_30673":1827,"_5":31029,"_21251":55764,"_27884":55765,"_3010":55766},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3554":1839,"_30673":1827,"_5":31029,"_21251":55768,"_27884":55769,"_3010":55770},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3554":1840,"_30673":1827,"_5":31029,"_21251":55772,"_27884":55773,"_3010":55774},[],"/docs/pr-preview/pr-69/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3554":1841,"_30673":1827,"_21251":55776,"_5":14613,"_27884":1827,"_3010":55777},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3554":1842,"_30673":1827,"_21251":55779,"_5":14613,"_27884":1827,"_3010":55780},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3554":1843,"_30673":1827,"_21251":55782,"_5":14613,"_27884":55729,"_3010":55783},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3554":1844,"_30673":1827,"_21251":55785,"_5":14613,"_27884":55729,"_3010":55786},[],"environment, such as production and preproduction;",{"_3554":1845,"_30673":1827,"_21251":55788,"_5":14613,"_27884":55729,"_3010":55789},[],"owner or operating team;",{"_3554":1846,"_30673":1827,"_21251":55791,"_5":14613,"_27884":55729,"_3010":55792},[],"device family or manufacturing process;",{"_3554":1847,"_30673":1827,"_21251":55794,"_5":14613,"_27884":55729,"_3010":55795},[],"region or regulatory requirement;",{"_3554":1848,"_30673":1827,"_21251":55797,"_5":14613,"_27884":55729,"_3010":55798},[],"cryptographic engine or key policy;",{"_3554":1849,"_30673":1827,"_21251":55800,"_5":14613,"_27884":55729,"_3010":55801},[],"maintenance window and renewal cadence.",{"_3554":1850,"_30673":1827,"_21251":55803,"_5":14613,"_27884":55729,"_3010":55804},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3554":1851,"_30673":1827,"_21251":55806,"_5":14613,"_27884":55729,"_3010":55807},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3554":1852,"_30673":1827,"_21251":55809,"_5":14613,"_27884":55733,"_3010":55810},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3554":1853,"_30673":1827,"_21251":55812,"_5":14613,"_27884":55733,"_3010":55813},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3554":1854,"_30673":1827,"_21251":55815,"_5":14613,"_27884":55733,"_3010":55816},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3554":1855,"_30673":1827,"_21251":55818,"_5":14613,"_27884":55733,"_3010":55819},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3554":1856,"_30673":1827,"_21251":55821,"_5":14613,"_27884":55737,"_3010":55822},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3554":1857,"_30673":1827,"_21251":55824,"_5":14613,"_27884":55737,"_3010":55825},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3554":1858,"_30673":1827,"_21251":55827,"_5":14613,"_27884":55737,"_3010":55828},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3554":1859,"_30673":1827,"_21251":55830,"_5":14613,"_27884":55737,"_3010":55831},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3554":1860,"_30673":1827,"_21251":55833,"_5":14613,"_27884":55745,"_3010":55834},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3554":1861,"_30673":1827,"_21251":55836,"_5":14613,"_27884":55749,"_3010":55837},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3554":1862,"_30673":1827,"_21251":55839,"_5":14613,"_27884":55753,"_3010":55840},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3554":1863,"_30673":1827,"_21251":55842,"_5":14613,"_27884":55757,"_3010":55843},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3554":1864,"_30673":1827,"_21251":55845,"_5":14613,"_27884":55761,"_3010":55846},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3554":1865,"_30673":1827,"_21251":55848,"_5":14613,"_27884":55765,"_3010":55849},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3554":1866,"_30673":1827,"_21251":55851,"_5":14613,"_27884":55769,"_3010":55852},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3554":1867,"_30673":1827,"_21251":55854,"_5":14613,"_27884":55769,"_3010":55855},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3554":1868,"_30673":1827,"_21251":55857,"_5":14613,"_27884":55769,"_3010":55858},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3554":1869,"_30673":1827,"_21251":55860,"_5":14613,"_27884":55769,"_3010":55861},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3554":1870,"_30673":1827,"_21251":55863,"_5":14613,"_27884":55773,"_3010":55864},[],"The new chain ends in an anchor installed by the consumer.",{"_3554":1871,"_30673":1827,"_21251":55866,"_5":14613,"_27884":55773,"_3010":55867},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3554":1872,"_30673":1827,"_21251":55869,"_5":14613,"_27884":55773,"_3010":55870},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3554":1873,"_30673":1827,"_21251":55872,"_5":14613,"_27884":55773,"_3010":55873},[],"Re-enrollment accepts the old identity during the planned period.",{"_3554":1874,"_30673":1827,"_21251":55875,"_5":14613,"_27884":55773,"_3010":55876},[],"OCSP and CRL respond for the authorities that remain active.",{"_3554":1875,"_30673":1827,"_21251":55878,"_5":14613,"_27884":55773,"_3010":55879},[],"No DMS is left accidentally issuing from the old CA.",{"_3554":1876,"_30673":1827,"_21251":55881,"_5":14613,"_27884":55773,"_3010":55882},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3554":1877,"_30673":1877,"_5":14965,"_3010":55884,"_31032":55885,"_21251":55886,"_27884":1877},"Certification authorities",[50083,51558,55721,55722],[],{"_3554":1878,"_30673":1877,"_21251":55888,"_5":14613,"_27884":1877,"_3010":55889},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3554":1879,"_30673":1877,"_5":31029,"_21251":55891,"_27884":55892,"_3010":55893},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3554":1880,"_30673":1877,"_5":31029,"_21251":55895,"_27884":55896,"_3010":55897},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3554":1881,"_30673":1877,"_5":31029,"_21251":55899,"_27884":55900,"_3010":50093},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#before-you-begin",{"_3554":1882,"_30673":1877,"_5":31029,"_21251":55902,"_27884":55903,"_3010":55904},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3554":1883,"_30673":1877,"_5":31029,"_21251":55906,"_27884":55907,"_3010":55908},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3554":1884,"_30673":1877,"_5":31029,"_21251":55910,"_27884":55911,"_3010":55912},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3554":1885,"_30673":1877,"_5":31029,"_21251":55914,"_27884":55915,"_3010":55916},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3554":1886,"_30673":1877,"_5":31029,"_21251":55918,"_27884":55919,"_3010":55920},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3554":1887,"_30673":1877,"_5":31029,"_21251":55922,"_27884":55923,"_3010":55924},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3554":1888,"_30673":1877,"_5":31029,"_21251":55926,"_27884":55927,"_3010":55928},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3554":1889,"_30673":1877,"_5":31029,"_21251":55930,"_27884":55931,"_3010":55932},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3554":1890,"_30673":1877,"_5":31029,"_21251":55934,"_27884":55935,"_3010":55936},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3554":1891,"_30673":1877,"_5":31029,"_21251":55938,"_27884":55939,"_3010":55940},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3554":1892,"_30673":1877,"_5":31029,"_21251":55942,"_27884":55943,"_3010":55944},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3554":1893,"_30673":1877,"_5":31029,"_21251":55946,"_27884":55947,"_3010":55948},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3554":1894,"_30673":1877,"_5":31029,"_21251":55950,"_27884":55951,"_3010":55952},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3554":1895,"_30673":1877,"_5":31029,"_21251":55954,"_27884":55955,"_3010":55956},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3554":1896,"_30673":1877,"_5":31029,"_21251":55958,"_27884":55959,"_3010":55960},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3554":1897,"_30673":1877,"_5":31029,"_21251":55962,"_27884":55963,"_3010":55964},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3554":1898,"_30673":1877,"_5":31029,"_21251":55966,"_27884":55967,"_3010":55968},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3554":1899,"_30673":1877,"_5":31029,"_21251":55970,"_27884":55971,"_3010":55972},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3554":1900,"_30673":1877,"_5":31029,"_21251":55974,"_27884":55975,"_3010":55976},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3554":1901,"_30673":1877,"_5":31029,"_21251":55978,"_27884":55979,"_3010":55980},[],"/docs/pr-preview/pr-69/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3554":1902,"_30673":1877,"_21251":55982,"_5":14613,"_27884":1877,"_3010":55983},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3554":1903,"_30673":1877,"_21251":55985,"_5":14613,"_27884":1877,"_3010":55986},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3554":1904,"_30673":1877,"_21251":55988,"_5":14613,"_27884":1877,"_3010":55989},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3554":1905,"_30673":1877,"_21251":55991,"_5":14613,"_27884":55892,"_3010":55992},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3554":1906,"_30673":1877,"_21251":55994,"_5":14613,"_27884":55892,"_3010":55995},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3554":1907,"_30673":1877,"_21251":55997,"_5":14613,"_27884":55892,"_3010":55998},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3554":1908,"_30673":1877,"_21251":56000,"_5":14613,"_27884":55892,"_3010":56001},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3554":1909,"_30673":1877,"_21251":56003,"_5":14613,"_27884":55892,"_3010":56004},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3554":1910,"_30673":1877,"_21251":56006,"_5":14613,"_27884":55900,"_3010":56007},[],"Decide whether the CA will be a root or an intermediate.",{"_3554":1911,"_30673":1877,"_21251":56009,"_5":14613,"_27884":55900,"_3010":56010},[],"Choose the engine that will keep the key.",{"_3554":1912,"_30673":1877,"_21251":56012,"_5":14613,"_27884":55900,"_3010":56013},[],"Define a validity longer than that of the certificates it will issue.",{"_3554":1913,"_30673":1877,"_21251":56015,"_5":14613,"_27884":55900,"_3010":56016},[],"For an intermediate CA, make sure the parent CA is active.",{"_3554":1914,"_30673":1877,"_21251":56018,"_5":14613,"_27884":55903,"_3010":56019},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3554":1915,"_30673":1877,"_21251":56021,"_5":14613,"_27884":55907,"_3010":56022},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3554":1916,"_30673":1877,"_21251":56024,"_5":14613,"_27884":55907,"_3010":56025},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3554":1917,"_30673":1877,"_21251":56027,"_5":14613,"_27884":55911,"_3010":56028},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3554":1918,"_30673":1877,"_21251":56030,"_5":14613,"_27884":55915,"_3010":56031},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3554":1919,"_30673":1877,"_21251":56033,"_5":14613,"_27884":55915,"_3010":56034},[],"`C`: two-letter ISO 3166-1 country code.",{"_3554":1920,"_30673":1877,"_21251":56036,"_5":14613,"_27884":55915,"_3010":56037},[],"`ST`: state or province.",{"_3554":1921,"_30673":1877,"_21251":56039,"_5":14613,"_27884":55915,"_3010":56040},[],"`L`: locality.",{"_3554":1922,"_30673":1877,"_21251":56042,"_5":14613,"_27884":55915,"_3010":56043},[],"`O`: organization.",{"_3554":1923,"_30673":1877,"_21251":56045,"_5":14613,"_27884":55915,"_3010":56046},[],"`OU`: organizational unit.",{"_3554":1924,"_30673":1877,"_21251":56048,"_5":14613,"_27884":55915,"_3010":56049},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3554":1925,"_30673":1877,"_21251":56051,"_5":14613,"_27884":55919,"_3010":56052},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3554":1926,"_30673":1877,"_21251":56054,"_5":14613,"_27884":55919,"_3010":56055},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3554":1927,"_30673":1877,"_21251":56057,"_5":14613,"_27884":55923,"_3010":56058},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3554":1928,"_30673":1877,"_21251":56060,"_5":14613,"_27884":55923,"_3010":56061},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3554":1929,"_30673":1877,"_21251":56063,"_5":14613,"_27884":55927,"_3010":56064},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3554":1930,"_30673":1877,"_21251":56066,"_5":14613,"_27884":55927,"_3010":56067},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3554":1931,"_30673":1877,"_21251":56069,"_5":14613,"_27884":55931,"_3010":56070},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3554":1932,"_30673":1877,"_21251":56072,"_5":14613,"_27884":55931,"_3010":56073},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3554":1933,"_30673":1877,"_21251":56075,"_5":14613,"_27884":55931,"_3010":56076},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3554":1934,"_30673":1877,"_21251":56078,"_5":14613,"_27884":55935,"_3010":56079},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3554":1935,"_30673":1877,"_21251":56081,"_5":14613,"_27884":55939,"_3010":56082},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3554":1936,"_30673":1877,"_21251":56084,"_5":14613,"_27884":55939,"_3010":56085},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3554":1937,"_30673":1877,"_21251":56087,"_5":14613,"_27884":55943,"_3010":56088},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3554":1938,"_30673":1877,"_21251":56090,"_5":14613,"_27884":55947,"_3010":56091},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3554":1939,"_30673":1877,"_21251":56093,"_5":14613,"_27884":55947,"_3010":56094},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3554":1940,"_30673":1877,"_21251":56096,"_5":14613,"_27884":55951,"_3010":56097},[],"Open a CA from the inventory to review:",{"_3554":1941,"_30673":1877,"_21251":56099,"_5":14613,"_27884":55951,"_3010":56100},[],"Status and validity period.",{"_3554":1942,"_30673":1877,"_21251":56102,"_5":14613,"_27884":55951,"_3010":56103},[],"Certificate and chain in PEM format.",{"_3554":1943,"_30673":1877,"_21251":56105,"_5":14613,"_27884":55951,"_3010":56106},[],"Number of active, expired and revoked certificates.",{"_3554":1944,"_30673":1877,"_21251":56108,"_5":14613,"_27884":55951,"_3010":56109},[],"Certificates issued in **Issued Certificates**.",{"_3554":1945,"_30673":1877,"_21251":56111,"_5":14613,"_27884":55951,"_3010":56112},[],"The CRL linked to the authority.",{"_3554":1946,"_30673":1877,"_21251":56114,"_5":14613,"_27884":55951,"_3010":56115},[],"Metadata and the associated cryptographic engine.",{"_3554":1947,"_30673":1877,"_21251":56117,"_5":14613,"_27884":55951,"_3010":56118},[],"You can filter the inventory by name, status and CA type.",{"_3554":1948,"_30673":1877,"_21251":56120,"_5":14613,"_27884":55955,"_3010":56121},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3554":1949,"_30673":1877,"_21251":56123,"_5":14613,"_27884":55955,"_3010":56124},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3554":1950,"_30673":1877,"_21251":56126,"_5":14613,"_27884":55955,"_3010":56127},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3554":1951,"_30673":1877,"_21251":56129,"_5":14613,"_27884":55955,"_3010":56130},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3554":1952,"_30673":1877,"_21251":56132,"_5":14613,"_27884":55959,"_3010":56133},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3554":1953,"_30673":1877,"_21251":56135,"_5":14613,"_27884":55963,"_3010":56136},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3554":1954,"_30673":1877,"_21251":56138,"_5":14613,"_27884":55967,"_3010":56139},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3554":1955,"_30673":1877,"_21251":56141,"_5":14613,"_27884":55971,"_3010":56142},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3554":1956,"_30673":1877,"_21251":56144,"_5":14613,"_27884":55975,"_3010":56145},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3554":1957,"_30673":1877,"_21251":56147,"_5":14613,"_27884":55979,"_3010":56148},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3554":1958,"_30673":1877,"_21251":56150,"_5":14613,"_27884":55979,"_3010":56151},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3554":1959,"_30673":1877,"_21251":56153,"_5":14613,"_27884":55979,"_3010":56154},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3554":1960,"_30673":1877,"_21251":56156,"_5":14613,"_27884":55979,"_3010":56157},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3554":1961,"_30673":1961,"_5":14965,"_3010":56159,"_31032":56160,"_21251":56161,"_27884":1961},"Certificate profiles",[50083,51558,55721,55722],[],{"_3554":1962,"_30673":1961,"_21251":56163,"_5":14613,"_27884":1961,"_3010":56164},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3554":1963,"_30673":1961,"_5":31029,"_21251":56166,"_27884":56167,"_3010":56168},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3554":1964,"_30673":1961,"_5":31029,"_21251":56170,"_27884":56171,"_3010":56172},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#validity","Validity",{"_3554":1965,"_30673":1961,"_5":31029,"_21251":56174,"_27884":56175,"_3010":56176},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3554":1966,"_30673":1961,"_5":31029,"_21251":56178,"_27884":56179,"_3010":56180},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3554":1967,"_30673":1961,"_5":31029,"_21251":56182,"_27884":56183,"_3010":56184},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#subject","Subject",{"_3554":1968,"_30673":1961,"_5":31029,"_21251":56186,"_27884":56187,"_3010":56188},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3554":1969,"_30673":1961,"_5":31029,"_21251":56190,"_27884":56191,"_3010":56192},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3554":1970,"_30673":1961,"_5":31029,"_21251":56194,"_27884":56195,"_3010":56196},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3554":1971,"_30673":1961,"_5":31029,"_21251":56198,"_27884":56199,"_3010":56200},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3554":1972,"_30673":1961,"_5":31029,"_21251":56202,"_27884":56203,"_3010":56204},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3554":1973,"_30673":1961,"_5":31029,"_21251":56206,"_27884":56207,"_3010":56208},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3554":1974,"_30673":1961,"_5":31029,"_21251":56210,"_27884":56211,"_3010":56212},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3554":1975,"_30673":1961,"_5":31029,"_21251":56214,"_27884":56215,"_3010":56216},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3554":1976,"_30673":1961,"_5":31029,"_21251":56218,"_27884":56219,"_3010":56220},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3554":1977,"_30673":1961,"_5":31029,"_21251":56222,"_27884":56223,"_3010":56224},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#design-examples","Design examples",{"_3554":1978,"_30673":1961,"_5":31029,"_21251":56226,"_27884":56227,"_3010":56228},[],"/docs/pr-preview/pr-69/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3554":1979,"_30673":1961,"_21251":56230,"_5":14613,"_27884":1961,"_3010":56231},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3554":1980,"_30673":1961,"_21251":56233,"_5":14613,"_27884":1961,"_3010":56234},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3554":1981,"_30673":1961,"_21251":56236,"_5":14613,"_27884":56171,"_3010":56237},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3554":1982,"_30673":1961,"_21251":56239,"_5":14613,"_27884":56171,"_3010":56240},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3554":1983,"_30673":1961,"_21251":56242,"_5":14613,"_27884":56175,"_3010":56243},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3554":1984,"_30673":1961,"_21251":56245,"_5":14613,"_27884":56179,"_3010":56246},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3554":1985,"_30673":1961,"_21251":56248,"_5":14613,"_27884":56179,"_3010":56249},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3554":1986,"_30673":1961,"_21251":56251,"_5":14613,"_27884":56179,"_3010":56252},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3554":1987,"_30673":1961,"_21251":56254,"_5":14613,"_27884":56183,"_3010":56255},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3554":1988,"_30673":1961,"_21251":56257,"_5":14613,"_27884":56187,"_3010":56258},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3554":1989,"_30673":1961,"_21251":56260,"_5":14613,"_27884":56187,"_3010":56261},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3554":1990,"_30673":1961,"_21251":56263,"_5":14613,"_27884":56191,"_3010":56264},[],"The cryptographic enforcement can:",{"_3554":1991,"_30673":1961,"_21251":56266,"_5":14613,"_27884":56191,"_3010":56267},[],"allow or block RSA keys;",{"_3554":1992,"_30673":1961,"_21251":56269,"_5":14613,"_27884":56191,"_3010":56270},[],"limit the supported RSA sizes;",{"_3554":1993,"_30673":1961,"_21251":56272,"_5":14613,"_27884":56191,"_3010":56273},[],"allow or block ECDSA keys;",{"_3554":1994,"_30673":1961,"_21251":56275,"_5":14613,"_27884":56191,"_3010":56276},[],"limit the supported ECDSA sizes or curves.",{"_3554":1995,"_30673":1961,"_21251":56278,"_5":14613,"_27884":56191,"_3010":56279},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3554":1996,"_30673":1961,"_21251":56281,"_5":14613,"_27884":56195,"_3010":56282},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3554":1997,"_30673":1961,"_21251":56284,"_5":14613,"_27884":56195,"_3010":53483},[],{"_3554":1998,"_30673":1961,"_21251":56286,"_5":14613,"_27884":56195,"_3010":56287},[],"First choice",{"_3554":1999,"_30673":1961,"_21251":56289,"_5":14613,"_27884":56195,"_3010":56290},[],"Second choice",{"_3554":2000,"_30673":1961,"_21251":56292,"_5":14613,"_27884":56195,"_3010":56293},[],"If neither is supplied",{"_3554":2001,"_30673":1961,"_21251":56295,"_5":14613,"_27884":56195,"_3010":56296},[],"Direct signing with a CA",{"_3554":2002,"_30673":1961,"_21251":56298,"_5":14613,"_27884":56195,"_3010":56299},[],"`issuance_profile` embedded in the request",{"_3554":2003,"_30673":1961,"_21251":56301,"_5":14613,"_27884":56195,"_3010":56302},[],"Request `issuance_profile_id`",{"_3554":2004,"_30673":1961,"_21251":56304,"_5":14613,"_27884":56195,"_3010":56305},[],"CA default profile (`profile_id`).",{"_3554":2005,"_30673":1961,"_21251":56307,"_5":14613,"_27884":56195,"_3010":56308},[],"Issuance through a DMS",{"_3554":2006,"_30673":1961,"_21251":56310,"_5":14613,"_27884":56195,"_3010":56311},[],"`settings.issuance_profile_id`",{"_3554":2007,"_30673":1961,"_21251":56313,"_5":14613,"_27884":56195,"_3010":56314},[],"`settings.issuance_profile` embedded in the DMS",{"_3554":2008,"_30673":1961,"_21251":56316,"_5":14613,"_27884":56195,"_3010":56317},[],"Enrollment CA default profile.",{"_3554":2009,"_30673":1961,"_21251":56319,"_5":14613,"_27884":56195,"_3010":56320},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3554":2010,"_30673":1961,"_21251":56322,"_5":14613,"_27884":56195,"_3010":56323},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3554":2011,"_30673":1961,"_21251":56325,"_5":14613,"_27884":56203,"_3010":56326},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3554":2012,"_30673":1961,"_21251":56328,"_5":14613,"_27884":56207,"_3010":56329},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3554":2013,"_30673":1961,"_21251":56331,"_5":14613,"_27884":56211,"_3010":56332},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3554":2014,"_30673":1961,"_21251":56334,"_5":14613,"_27884":56215,"_3010":56335},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3554":2015,"_30673":1961,"_21251":56337,"_5":14613,"_27884":56219,"_3010":56338},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3554":2016,"_30673":1961,"_21251":56340,"_5":14613,"_27884":56219,"_3010":56341},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3554":2017,"_30673":1961,"_21251":56343,"_5":14613,"_27884":56223,"_3010":56344},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3554":2018,"_30673":1961,"_21251":56346,"_5":14613,"_27884":56223,"_3010":56347},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3554":2019,"_30673":1961,"_21251":56349,"_5":14613,"_27884":56223,"_3010":56350},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3554":2020,"_30673":1961,"_21251":56352,"_5":14613,"_27884":56223,"_3010":56353},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3554":2021,"_30673":1961,"_21251":56355,"_5":14613,"_27884":56227,"_3010":56356},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3554":2022,"_30673":1961,"_21251":56358,"_5":14613,"_27884":56227,"_3010":56359},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3554":2023,"_30673":2023,"_5":14965,"_3010":56361,"_31032":56362,"_21251":56364,"_27884":2023},"Certificate validation",[50083,51558,55721,56363],"Validation",[],{"_3554":2024,"_30673":2023,"_21251":56366,"_5":14613,"_27884":2023,"_3010":56367},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3554":2025,"_30673":2023,"_5":31029,"_21251":56369,"_27884":56370,"_3010":56371},[],"/docs/pr-preview/pr-69/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3554":2026,"_30673":2023,"_5":31029,"_21251":56373,"_27884":56374,"_3010":56375},[],"/docs/pr-preview/pr-69/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3554":2027,"_30673":2023,"_5":31029,"_21251":56377,"_27884":56378,"_3010":56379},[],"/docs/pr-preview/pr-69/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3554":2028,"_30673":2023,"_21251":56381,"_5":14613,"_27884":2023,"_3010":56382},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3554":2029,"_30673":2023,"_21251":56384,"_5":14613,"_27884":56370,"_3010":56385},[],"Verify these criteria together:",{"_3554":2030,"_30673":2023,"_21251":56387,"_5":14613,"_27884":56370,"_3010":55347},[],{"_3554":2031,"_30673":2023,"_21251":56389,"_5":14613,"_27884":56370,"_3010":56390},[],"Required result",{"_3554":2032,"_30673":2023,"_21251":56392,"_5":14613,"_27884":56370,"_3010":56393},[],"Chain and signature",{"_3554":2033,"_30673":2023,"_21251":56395,"_5":14613,"_27884":56370,"_3010":56396},[],"Valid chain to a root deliberately installed in the consumer.",{"_3554":2034,"_30673":2023,"_21251":56398,"_5":14613,"_27884":56370,"_3010":56399},[],"Dates",{"_3554":2035,"_30673":2023,"_21251":56401,"_5":14613,"_27884":56370,"_3010":56402},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3554":2036,"_30673":2023,"_21251":56404,"_5":14613,"_27884":56370,"_3010":51227},[],{"_3554":2037,"_30673":2023,"_21251":56406,"_5":14613,"_27884":56370,"_3010":56407},[],"Name, SAN or identifier matches the expected peer.",{"_3554":2038,"_30673":2023,"_21251":56409,"_5":14613,"_27884":56370,"_3010":50473},[],{"_3554":2039,"_30673":2023,"_21251":56411,"_5":14613,"_27884":56370,"_3010":56412},[],"KU, EKU and constraints permit the specific operation.",{"_3554":2040,"_30673":2023,"_21251":56414,"_5":14613,"_27884":56370,"_3010":56415},[],"Revocation",{"_3554":2041,"_30673":2023,"_21251":56417,"_5":14613,"_27884":56370,"_3010":56418},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3554":2042,"_30673":2023,"_21251":56420,"_5":14613,"_27884":56370,"_3010":56421},[],"Authorization",{"_3554":2043,"_30673":2023,"_21251":56423,"_5":14613,"_27884":56370,"_3010":56424},[],"The application permits that identity to perform the action.",{"_3554":2044,"_30673":2023,"_21251":56426,"_5":14613,"_27884":56370,"_3010":56427},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3554":2045,"_30673":2023,"_21251":56429,"_5":14613,"_27884":56374,"_3010":56430},[],"Mechanism",{"_3554":2046,"_30673":2023,"_21251":56432,"_5":14613,"_27884":56374,"_3010":56433},[],"When to use it",{"_3554":2047,"_30673":2023,"_21251":56435,"_5":14613,"_27884":56374,"_3010":56436},[],"What you must maintain",{"_3554":2048,"_30673":2023,"_21251":56438,"_5":14613,"_27884":56374,"_3010":56439},[],"OCSP",{"_3554":2049,"_30673":2023,"_21251":56441,"_5":14613,"_27884":56374,"_3010":56442},[],"Status query for a specific certificate.",{"_3554":2050,"_30673":2023,"_21251":56444,"_5":14613,"_27884":56374,"_3010":56445},[],"Responder access, signature verification and cache/freshness policy.",{"_3554":2051,"_30673":2023,"_21251":56447,"_5":14613,"_27884":56374,"_3010":56448},[],"CRL",{"_3554":2052,"_30673":2023,"_21251":56450,"_5":14613,"_27884":56374,"_3010":56451},[],"Local checks for many certificates or offline operation.",{"_3554":2053,"_30673":2023,"_21251":56453,"_5":14613,"_27884":56374,"_3010":56454},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3554":2054,"_30673":2023,"_21251":56456,"_5":14613,"_27884":56374,"_3010":56457},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3554":2055,"_30673":2023,"_21251":56459,"_5":14613,"_27884":56374,"_3010":56460},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3554":2056,"_30673":2023,"_21251":56462,"_5":14613,"_27884":56378,"_3010":56463},[],"Accept a current, authorized certificate with a known chain.",{"_3554":2057,"_30673":2023,"_21251":56465,"_5":14613,"_27884":56378,"_3010":56466},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3554":2058,"_30673":2023,"_21251":56468,"_5":14613,"_27884":56378,"_3010":56469},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3554":2059,"_30673":2023,"_21251":56471,"_5":14613,"_27884":56378,"_3010":56472},[],"Check that a new connection with that identity is rejected.",{"_3554":2060,"_30673":2023,"_21251":56474,"_5":14613,"_27884":56378,"_3010":56475},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3554":2061,"_30673":2023,"_21251":56477,"_5":14613,"_27884":56378,"_3010":56478},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3554":2062,"_30673":2023,"_21251":56480,"_5":14613,"_27884":56378,"_3010":56481},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3554":2063,"_30673":2023,"_21251":56483,"_5":14613,"_27884":56378,"_3010":56484},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3554":2064,"_30673":2023,"_21251":56486,"_5":14613,"_27884":56378,"_3010":56487},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3554":2065,"_30673":2065,"_5":14965,"_3010":56489,"_31032":56490,"_21251":56491,"_27884":2065},"Certificates",[50083,51558,55721,55722],[],{"_3554":2066,"_30673":2065,"_21251":56493,"_5":14613,"_27884":2065,"_3010":56494},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3554":2067,"_30673":2065,"_5":31029,"_21251":56496,"_27884":56497,"_3010":56498},[],"/docs/pr-preview/pr-69/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3554":2068,"_30673":2065,"_5":31029,"_21251":56500,"_27884":56501,"_3010":56502},[],"/docs/pr-preview/pr-69/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3554":2069,"_30673":2065,"_5":31029,"_21251":56504,"_27884":56505,"_3010":56506},[],"/docs/pr-preview/pr-69/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3554":2070,"_30673":2065,"_5":31029,"_21251":56508,"_27884":56509,"_3010":56510},[],"/docs/pr-preview/pr-69/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3554":2071,"_30673":2065,"_5":31029,"_21251":56512,"_27884":56513,"_3010":56514},[],"/docs/pr-preview/pr-69/platform/pki/certificates#open-the-action","Open the action",{"_3554":2072,"_30673":2065,"_5":31029,"_21251":56516,"_27884":56517,"_3010":56518},[],"/docs/pr-preview/pr-69/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3554":2073,"_30673":2065,"_5":31029,"_21251":56520,"_27884":56521,"_3010":56522},[],"/docs/pr-preview/pr-69/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3554":2074,"_30673":2065,"_5":31029,"_21251":56524,"_27884":56525,"_3010":56526},[],"/docs/pr-preview/pr-69/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3554":2075,"_30673":2065,"_5":31029,"_21251":56528,"_27884":56529,"_3010":56530},[],"/docs/pr-preview/pr-69/platform/pki/certificates#continue","Continue",{"_3554":2076,"_30673":2065,"_21251":56532,"_5":14613,"_27884":2065,"_3010":56533},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3554":2077,"_30673":2065,"_21251":56535,"_5":14613,"_27884":56497,"_3010":56536},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3554":2078,"_30673":2065,"_21251":56538,"_5":14613,"_27884":56497,"_3010":56539},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3554":2079,"_30673":2065,"_21251":56541,"_5":14613,"_27884":56497,"_3010":56542},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3554":2080,"_30673":2065,"_21251":56544,"_5":14613,"_27884":56497,"_3010":56545},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3554":2081,"_30673":2065,"_21251":56547,"_5":14613,"_27884":56497,"_3010":56548},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3554":2082,"_30673":2065,"_21251":56550,"_5":14613,"_27884":56497,"_3010":56551},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3554":2083,"_30673":2065,"_21251":56553,"_5":14613,"_27884":56497,"_3010":56554},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3554":2084,"_30673":2065,"_21251":56556,"_5":14613,"_27884":56501,"_3010":56557},[],"Download the PEM and inspect it:",{"_3554":2085,"_30673":2065,"_21251":56559,"_5":14613,"_27884":56501,"_3010":56560},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3554":2086,"_30673":2065,"_21251":56562,"_5":14613,"_27884":56505,"_3010":56563},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3554":2087,"_30673":2065,"_21251":56565,"_5":14613,"_27884":56505,"_3010":56566},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3554":2088,"_30673":2065,"_21251":56568,"_5":14613,"_27884":56505,"_3010":56569},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3554":2089,"_30673":2065,"_21251":56571,"_5":14613,"_27884":56505,"_3010":56572},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3554":2090,"_30673":2065,"_21251":56574,"_5":14613,"_27884":56505,"_3010":56575},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3554":2091,"_30673":2065,"_21251":56577,"_5":14613,"_27884":56505,"_3010":56578},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3554":2092,"_30673":2065,"_21251":56580,"_5":14613,"_27884":56505,"_3010":56581},[],"For browser key generation, follow Issue your first certificate.",{"_3554":2093,"_30673":2065,"_21251":56583,"_5":14613,"_27884":56509,"_3010":56584},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3554":2094,"_30673":2065,"_21251":56586,"_5":14613,"_27884":56513,"_3010":56587},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3554":2095,"_30673":2065,"_21251":56589,"_5":14613,"_27884":56517,"_3010":56590},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3554":2096,"_30673":2065,"_21251":56592,"_5":14613,"_27884":56521,"_3010":56593},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3554":2097,"_30673":2065,"_21251":56595,"_5":14613,"_27884":56521,"_3010":56596},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3554":2098,"_30673":2065,"_21251":56598,"_5":14613,"_27884":56521,"_3010":56599},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3554":2099,"_30673":2065,"_21251":56601,"_5":14613,"_27884":56525,"_3010":56602},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3554":2100,"_30673":2065,"_21251":56604,"_5":14613,"_27884":56525,"_3010":56605},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3554":2101,"_30673":2065,"_21251":56607,"_5":14613,"_27884":56525,"_3010":56608},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3554":2102,"_30673":2065,"_21251":56610,"_5":14613,"_27884":56529,"_3010":56611},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3554":2103,"_30673":2065,"_21251":56613,"_5":14613,"_27884":56529,"_3010":56614},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3554":2104,"_30673":2104,"_5":14965,"_3010":56616,"_31032":56617,"_21251":56619,"_27884":2104},"Certificate lifecycle",[50083,51558,55721,56618],"Concepts",[],{"_3554":2105,"_30673":2104,"_21251":56621,"_5":14613,"_27884":2104,"_3010":56622},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3554":2106,"_30673":2104,"_5":31029,"_21251":56624,"_27884":56625,"_3010":56626},[],"/docs/pr-preview/pr-69/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3554":2107,"_30673":2104,"_5":31029,"_21251":56628,"_27884":56629,"_3010":56630},[],"/docs/pr-preview/pr-69/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3554":2108,"_30673":2104,"_5":31029,"_21251":56632,"_27884":56633,"_3010":56634},[],"/docs/pr-preview/pr-69/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3554":2109,"_30673":2104,"_5":31029,"_21251":56636,"_27884":56637,"_3010":56638},[],"/docs/pr-preview/pr-69/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3554":2110,"_30673":2104,"_5":31029,"_21251":56640,"_27884":56641,"_3010":56642},[],"/docs/pr-preview/pr-69/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3554":2111,"_30673":2104,"_5":31029,"_21251":56644,"_27884":56645,"_3010":56646},[],"/docs/pr-preview/pr-69/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3554":2112,"_30673":2104,"_5":31029,"_21251":56648,"_27884":56649,"_3010":56650},[],"/docs/pr-preview/pr-69/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3554":2113,"_30673":2104,"_5":31029,"_21251":56652,"_27884":56653,"_3010":56654},[],"/docs/pr-preview/pr-69/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3554":2114,"_30673":2104,"_5":31029,"_21251":56656,"_27884":56657,"_3010":56658},[],"/docs/pr-preview/pr-69/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3554":2115,"_30673":2104,"_5":31029,"_21251":56660,"_27884":56661,"_3010":56662},[],"/docs/pr-preview/pr-69/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3554":2116,"_30673":2104,"_21251":56664,"_5":14613,"_27884":2104,"_3010":56665},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3554":2117,"_30673":2104,"_21251":56667,"_5":14613,"_27884":56629,"_3010":56668},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3554":2118,"_30673":2104,"_21251":56670,"_5":14613,"_27884":56633,"_3010":56671},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3554":2119,"_30673":2104,"_21251":56673,"_5":14613,"_27884":56637,"_3010":56674},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3554":2120,"_30673":2104,"_21251":56676,"_5":14613,"_27884":56641,"_3010":56677},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3554":2121,"_30673":2104,"_21251":56679,"_5":14613,"_27884":56645,"_3010":56680},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3554":2122,"_30673":2104,"_21251":56682,"_5":14613,"_27884":56649,"_3010":56683},[],"Lamassu persists four X.509 states:",{"_3554":2123,"_30673":2104,"_21251":56685,"_5":14613,"_27884":56649,"_3010":56686},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3554":2124,"_30673":2104,"_21251":56688,"_5":14613,"_27884":56649,"_3010":56689},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3554":2125,"_30673":2104,"_21251":56691,"_5":14613,"_27884":56649,"_3010":56692},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3554":2126,"_30673":2104,"_21251":56694,"_5":14613,"_27884":56649,"_3010":56695},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3554":2127,"_30673":2104,"_21251":56697,"_5":14613,"_27884":56649,"_3010":56698},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3554":2128,"_30673":2104,"_21251":56700,"_5":14613,"_27884":56653,"_3010":56701},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3554":2129,"_30673":2104,"_21251":56703,"_5":14613,"_27884":56653,"_3010":56704},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3554":2130,"_30673":2104,"_21251":56706,"_5":14613,"_27884":56653,"_3010":56707},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3554":2131,"_30673":2104,"_21251":56709,"_5":14613,"_27884":56657,"_3010":56710},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3554":2132,"_30673":2104,"_21251":56712,"_5":14613,"_27884":56657,"_3010":56713},[],"Before confirming:",{"_3554":2133,"_30673":2104,"_21251":56715,"_5":14613,"_27884":56657,"_3010":56716},[],"Identify DMSs, devices and services that trust that chain.",{"_3554":2134,"_30673":2104,"_21251":56718,"_5":14613,"_27884":56657,"_3010":56719},[],"Distribute the new chain of trust.",{"_3554":2135,"_30673":2104,"_21251":56721,"_5":14613,"_27884":56657,"_3010":56722},[],"Reissue the necessary identities.",{"_3554":2136,"_30673":2104,"_21251":56724,"_5":14613,"_27884":56657,"_3010":56725},[],"Check OCSP and CRL from a real consumer.",{"_3554":2137,"_30673":2104,"_21251":56727,"_5":14613,"_27884":56657,"_3010":56728},[],"Revoke the old CA once no legitimate traffic remains.",{"_3554":2138,"_30673":2104,"_21251":56730,"_5":14613,"_27884":56657,"_3010":56731},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3554":2139,"_30673":2104,"_21251":56733,"_5":14613,"_27884":56661,"_3010":56734},[],"Certificates entering the preventive or critical renewal window.",{"_3554":2140,"_30673":2104,"_21251":56736,"_5":14613,"_27884":56661,"_3010":56737},[],"Repeated enrollment or re-enrollment failures.",{"_3554":2141,"_30673":2104,"_21251":56739,"_5":14613,"_27884":56661,"_3010":56740},[],"Status changes and revocation reasons.",{"_3554":2142,"_30673":2104,"_21251":56742,"_5":14613,"_27884":56661,"_3010":56743},[],"OCSP and CRL publication and validity.",{"_3554":2143,"_30673":2104,"_21251":56745,"_5":14613,"_27884":56661,"_3010":56746},[],"Dependencies still presenting a replaced certificate.",{"_3554":2144,"_30673":2104,"_21251":56748,"_5":14613,"_27884":56661,"_3010":56749},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3554":2145,"_30673":2145,"_5":14965,"_3010":56751,"_31032":56752,"_21251":56753,"_27884":2145},"Trust model",[50083,51558,55721,56618],[],{"_3554":2146,"_30673":2145,"_21251":56755,"_5":14613,"_27884":2145,"_3010":56756},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3554":2147,"_30673":2145,"_5":31029,"_21251":56758,"_27884":56759,"_3010":56760},[],"/docs/pr-preview/pr-69/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3554":2148,"_30673":2145,"_5":31029,"_21251":56762,"_27884":56763,"_3010":56764},[],"/docs/pr-preview/pr-69/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3554":2149,"_30673":2145,"_5":31029,"_21251":56766,"_27884":56767,"_3010":56768},[],"/docs/pr-preview/pr-69/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3554":2150,"_30673":2145,"_5":31029,"_21251":56770,"_27884":56771,"_3010":56772},[],"/docs/pr-preview/pr-69/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3554":2151,"_30673":2145,"_5":31029,"_21251":56774,"_27884":56775,"_3010":56776},[],"/docs/pr-preview/pr-69/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3554":2152,"_30673":2145,"_5":31029,"_21251":56778,"_27884":56779,"_3010":56780},[],"/docs/pr-preview/pr-69/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3554":2153,"_30673":2145,"_5":31029,"_21251":56782,"_27884":56783,"_3010":56784},[],"/docs/pr-preview/pr-69/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3554":2154,"_30673":2145,"_5":31029,"_21251":56786,"_27884":56787,"_3010":56788},[],"/docs/pr-preview/pr-69/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3554":2155,"_30673":2145,"_5":31029,"_21251":56790,"_27884":56791,"_3010":56792},[],"/docs/pr-preview/pr-69/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3554":2156,"_30673":2145,"_5":31029,"_21251":56794,"_27884":56795,"_3010":56796},[],"/docs/pr-preview/pr-69/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3554":2157,"_30673":2145,"_21251":56798,"_5":14613,"_27884":2145,"_3010":56799},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3554":2158,"_30673":2145,"_21251":56801,"_5":14613,"_27884":56763,"_3010":56802},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3554":2159,"_30673":2145,"_21251":56804,"_5":14613,"_27884":56767,"_3010":56805},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3554":2160,"_30673":2145,"_21251":56807,"_5":14613,"_27884":56771,"_3010":56808},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3554":2161,"_30673":2145,"_21251":56810,"_5":14613,"_27884":56775,"_3010":56811},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3554":2162,"_30673":2145,"_21251":56813,"_5":14613,"_27884":56779,"_3010":56814},[],"The device proves it can enroll according to the DMS policy.",{"_3554":2163,"_30673":2145,"_21251":56816,"_5":14613,"_27884":56779,"_3010":56817},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3554":2164,"_30673":2145,"_21251":56819,"_5":14613,"_27884":56779,"_3010":56820},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3554":2165,"_30673":2145,"_21251":56822,"_5":14613,"_27884":56779,"_3010":56823},[],"The device installs the certificate and the chain it needs.",{"_3554":2166,"_30673":2145,"_21251":56825,"_5":14613,"_27884":56779,"_3010":56826},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3554":2167,"_30673":2145,"_21251":56828,"_5":14613,"_27884":56779,"_3010":56829},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3554":2168,"_30673":2145,"_21251":56831,"_5":14613,"_27884":56783,"_3010":56832},[],"A DMS relates three sets that are worth designing separately:",{"_3554":2169,"_30673":2145,"_21251":56834,"_5":14613,"_27884":56783,"_3010":56835},[],"**Enrollment CA:** signs the new identities.",{"_3554":2170,"_30673":2145,"_21251":56837,"_5":14613,"_27884":56783,"_3010":56838},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3554":2171,"_30673":2145,"_21251":56840,"_5":14613,"_27884":56783,"_3010":56841},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3554":2172,"_30673":2145,"_21251":56843,"_5":14613,"_27884":56783,"_3010":56844},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3554":2173,"_30673":2145,"_21251":56846,"_5":14613,"_27884":56787,"_3010":56847},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3554":2174,"_30673":2145,"_21251":56849,"_5":14613,"_27884":56787,"_3010":56850},[],"that the current date is between `Not Before` and `Not After`;",{"_3554":2175,"_30673":2145,"_21251":56852,"_5":14613,"_27884":56787,"_3010":56853},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3554":2176,"_30673":2145,"_21251":56855,"_5":14613,"_27884":56787,"_3010":56856},[],"that names, SANs and subject match the expected identity;",{"_3554":2177,"_30673":2145,"_21251":56858,"_5":14613,"_27884":56787,"_3010":56859},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3554":2178,"_30673":2145,"_21251":56861,"_5":14613,"_27884":56787,"_3010":56862},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3554":2179,"_30673":2145,"_21251":56864,"_5":14613,"_27884":56787,"_3010":56865},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3554":2180,"_30673":2145,"_21251":56867,"_5":14613,"_27884":56791,"_3010":56868},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3554":2181,"_30673":2145,"_21251":56870,"_5":14613,"_27884":56795,"_3010":56871},[],"Keep the root out of daily operations, or with very restricted access.",{"_3554":2182,"_30673":2145,"_21251":56873,"_5":14613,"_27884":56795,"_3010":56874},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3554":2183,"_30673":2145,"_21251":56876,"_5":14613,"_27884":56795,"_3010":56877},[],"Assign explicit profiles to every use case.",{"_3554":2184,"_30673":2145,"_21251":56879,"_5":14613,"_27884":56795,"_3010":56880},[],"Distribute the new trust before starting a rotation.",{"_3554":2185,"_30673":2145,"_21251":56882,"_5":14613,"_27884":56795,"_3010":56883},[],"Keep enough overlap to renew a disconnected fleet.",{"_3554":2186,"_30673":2145,"_21251":56885,"_5":14613,"_27884":56795,"_3010":56886},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3554":2187,"_30673":2145,"_21251":56888,"_5":14613,"_27884":56795,"_3010":56889},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3554":2188,"_30673":2188,"_5":14965,"_3010":56891,"_31032":56892,"_21251":56893,"_27884":2188},"Revocation lists (CRL)",[50083,51558,55721,56363],[],{"_3554":2189,"_30673":2188,"_21251":56895,"_5":14613,"_27884":2188,"_3010":56896},[],"Generate and distribute signed lists to validate certificates offline.",{"_3554":2190,"_30673":2188,"_5":31029,"_21251":56898,"_27884":56899,"_3010":56900},[],"/docs/pr-preview/pr-69/platform/pki/crl#crl-settings","CRL settings",{"_3554":2191,"_30673":2188,"_5":31029,"_21251":56902,"_27884":56903,"_3010":56904},[],"/docs/pr-preview/pr-69/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3554":2192,"_30673":2188,"_5":31029,"_21251":56906,"_27884":56907,"_3010":56908},[],"/docs/pr-preview/pr-69/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3554":2193,"_30673":2188,"_5":31029,"_21251":56910,"_27884":56911,"_3010":56912},[],"/docs/pr-preview/pr-69/platform/pki/crl#crl-contents","CRL contents",{"_3554":2194,"_30673":2188,"_5":31029,"_21251":56914,"_27884":56915,"_3010":56916},[],"/docs/pr-preview/pr-69/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3554":2195,"_30673":2188,"_5":31029,"_21251":56918,"_27884":56919,"_3010":56920},[],"/docs/pr-preview/pr-69/platform/pki/crl#crl-settings-api","CRL settings API",{"_3554":2196,"_30673":2188,"_5":31029,"_21251":56922,"_27884":56923,"_3010":56924},[],"/docs/pr-preview/pr-69/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3554":2197,"_30673":2188,"_5":31029,"_21251":56926,"_27884":56927,"_3010":56928},[],"/docs/pr-preview/pr-69/platform/pki/crl#references","References",{"_3554":2198,"_30673":2188,"_21251":56930,"_5":14613,"_27884":2188,"_3010":56931},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3554":2199,"_30673":2188,"_21251":56933,"_5":14613,"_27884":56899,"_3010":56934},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3554":2200,"_30673":2188,"_21251":56936,"_5":14613,"_27884":56899,"_3010":56937},[],"Field",{"_3554":2201,"_30673":2188,"_21251":56939,"_5":14613,"_27884":56899,"_3010":50473},[],{"_3554":2202,"_30673":2188,"_21251":56941,"_5":14613,"_27884":56899,"_3010":51678},[],{"_3554":2203,"_30673":2188,"_21251":56943,"_5":14613,"_27884":56899,"_3010":56944},[],"ID of the CA the settings belong to.",{"_3554":2204,"_30673":2188,"_21251":56946,"_5":14613,"_27884":56899,"_3010":56947},[],"`status`",{"_3554":2205,"_30673":2188,"_21251":56949,"_5":14613,"_27884":56899,"_3010":56950},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3554":2206,"_30673":2188,"_21251":56952,"_5":14613,"_27884":56899,"_3010":56953},[],"`legacy_ski`",{"_3554":2207,"_30673":2188,"_21251":56955,"_5":14613,"_27884":56899,"_3010":56956},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3554":2208,"_30673":2188,"_21251":56958,"_5":14613,"_27884":56899,"_3010":56959},[],"`latest_crl`",{"_3554":2209,"_30673":2188,"_21251":56961,"_5":14613,"_27884":56899,"_3010":56962},[],"Version, validity start and end of the last published list. Read-only.",{"_3554":2210,"_30673":2188,"_21251":56964,"_5":14613,"_27884":56899,"_3010":56965},[],"`crl_options` field",{"_3554":2211,"_30673":2188,"_21251":56967,"_5":14613,"_27884":56899,"_3010":50473},[],{"_3554":2212,"_30673":2188,"_21251":56969,"_5":14613,"_27884":56899,"_3010":56970},[],"Initial value",{"_3554":2213,"_30673":2188,"_21251":56972,"_5":14613,"_27884":56899,"_3010":56973},[],"`validity`",{"_3554":2214,"_30673":2188,"_21251":56975,"_5":14613,"_27884":56899,"_3010":56976},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3554":2215,"_30673":2188,"_21251":56978,"_5":14613,"_27884":56899,"_3010":56979},[],"7 days.",{"_3554":2216,"_30673":2188,"_21251":56981,"_5":14613,"_27884":56899,"_3010":56982},[],"`refresh_interval`",{"_3554":2217,"_30673":2188,"_21251":56984,"_5":14613,"_27884":56899,"_3010":56985},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3554":2218,"_30673":2188,"_21251":56987,"_5":14613,"_27884":56899,"_3010":56988},[],"6 days and 23 hours.",{"_3554":2219,"_30673":2188,"_21251":56990,"_5":14613,"_27884":56899,"_3010":56991},[],"`regenerate_on_revoke`",{"_3554":2220,"_30673":2188,"_21251":56993,"_5":14613,"_27884":56899,"_3010":56994},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3554":2221,"_30673":2188,"_21251":56996,"_5":14613,"_27884":56899,"_3010":56997},[],"`true`.",{"_3554":2222,"_30673":2188,"_21251":56999,"_5":14613,"_27884":56899,"_3010":57000},[],"`signer_serial_number`",{"_3554":2223,"_30673":2188,"_21251":57002,"_5":14613,"_27884":56899,"_3010":57003},[],"Serial number of the existing certificate that signs the CRL.",{"_3554":2224,"_30673":2188,"_21251":57005,"_5":14613,"_27884":56899,"_3010":57006},[],"Serial number of the CA’s current certificate.",{"_3554":2225,"_30673":2188,"_21251":57008,"_5":14613,"_27884":56899,"_3010":57009},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3554":2226,"_30673":2188,"_21251":57011,"_5":14613,"_27884":56899,"_3010":57012},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3554":2227,"_30673":2188,"_21251":57014,"_5":14613,"_27884":56899,"_3010":57015},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3554":2228,"_30673":2188,"_21251":57017,"_5":14613,"_27884":56899,"_3010":57018},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3554":2229,"_30673":2188,"_21251":57020,"_5":14613,"_27884":56899,"_3010":57021},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3554":2230,"_30673":2188,"_21251":57023,"_5":14613,"_27884":56899,"_3010":57024},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3554":2231,"_30673":2188,"_21251":57026,"_5":14613,"_27884":56899,"_3010":57027},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3554":2232,"_30673":2188,"_21251":57029,"_5":14613,"_27884":56899,"_3010":57030},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3554":2233,"_30673":2188,"_21251":57032,"_5":14613,"_27884":56899,"_3010":57033},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3554":2234,"_30673":2188,"_21251":57035,"_5":14613,"_27884":56899,"_3010":57036},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3554":2235,"_30673":2188,"_21251":57038,"_5":14613,"_27884":56899,"_3010":57039},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3554":2236,"_30673":2188,"_21251":57041,"_5":14613,"_27884":56903,"_3010":57042},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3554":2237,"_30673":2188,"_21251":57044,"_5":14613,"_27884":56903,"_3010":57045},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3554":2238,"_30673":2188,"_21251":57047,"_5":14613,"_27884":56903,"_3010":57048},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3554":2239,"_30673":2188,"_21251":57050,"_5":14613,"_27884":56903,"_3010":57051},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3554":2240,"_30673":2188,"_21251":57053,"_5":14613,"_27884":56907,"_3010":57054},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3554":2241,"_30673":2188,"_21251":57056,"_5":14613,"_27884":56907,"_3010":57057},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3554":2242,"_30673":2188,"_21251":57059,"_5":14613,"_27884":56907,"_3010":57060},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3554":2243,"_30673":2188,"_21251":57062,"_5":14613,"_27884":56907,"_3010":57063},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3554":2244,"_30673":2188,"_21251":57065,"_5":14613,"_27884":56907,"_3010":57066},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3554":2245,"_30673":2188,"_21251":57068,"_5":14613,"_27884":56907,"_3010":57069},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3554":2246,"_30673":2188,"_21251":57071,"_5":14613,"_27884":56907,"_3010":57072},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3554":2247,"_30673":2188,"_21251":57074,"_5":14613,"_27884":56907,"_3010":57075},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3554":2248,"_30673":2188,"_21251":57077,"_5":14613,"_27884":56907,"_3010":57078},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3554":2249,"_30673":2188,"_21251":57080,"_5":14613,"_27884":56911,"_3010":57081},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3554":2250,"_30673":2188,"_21251":57083,"_5":14613,"_27884":56911,"_3010":57084},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3554":2251,"_30673":2188,"_21251":57086,"_5":14613,"_27884":56915,"_3010":57087},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3554":2252,"_30673":2188,"_21251":57089,"_5":14613,"_27884":56915,"_3010":57090},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3554":2253,"_30673":2188,"_21251":57092,"_5":14613,"_27884":56915,"_3010":57093},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3554":2254,"_30673":2188,"_21251":57095,"_5":14613,"_27884":56915,"_3010":57096},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3554":2255,"_30673":2188,"_21251":57098,"_5":14613,"_27884":56915,"_3010":57099},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3554":2256,"_30673":2188,"_21251":57101,"_5":14613,"_27884":56919,"_3010":57102},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3554":2257,"_30673":2188,"_21251":57104,"_5":14613,"_27884":56919,"_3010":53486},[],{"_3554":2258,"_30673":2188,"_21251":57106,"_5":14613,"_27884":56919,"_3010":57107},[],"Relative path",{"_3554":2259,"_30673":2188,"_21251":57109,"_5":14613,"_27884":56919,"_3010":53483},[],{"_3554":2260,"_30673":2188,"_21251":57111,"_5":14613,"_27884":56919,"_3010":57112},[],"`GET`",{"_3554":2261,"_30673":2188,"_21251":57114,"_5":14613,"_27884":56919,"_3010":57115},[],"`/v1/crl-settings`",{"_3554":2262,"_30673":2188,"_21251":57117,"_5":14613,"_27884":56919,"_3010":57118},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3554":2263,"_30673":2188,"_21251":57120,"_5":14613,"_27884":56919,"_3010":57112},[],{"_3554":2264,"_30673":2188,"_21251":57122,"_5":14613,"_27884":56919,"_3010":57123},[],"`/v1/crl-settings/{ca-id}`",{"_3554":2265,"_30673":2188,"_21251":57125,"_5":14613,"_27884":56919,"_3010":57126},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3554":2266,"_30673":2188,"_21251":57128,"_5":14613,"_27884":56919,"_3010":57129},[],"`PUT`",{"_3554":2267,"_30673":2188,"_21251":57131,"_5":14613,"_27884":56919,"_3010":57123},[],{"_3554":2268,"_30673":2188,"_21251":57133,"_5":14613,"_27884":56919,"_3010":57134},[],"Replace the CRL configuration of a CA.",{"_3554":2269,"_30673":2188,"_21251":57136,"_5":14613,"_27884":56919,"_3010":57137},[],"`DELETE`",{"_3554":2270,"_30673":2188,"_21251":57139,"_5":14613,"_27884":56919,"_3010":57123},[],{"_3554":2271,"_30673":2188,"_21251":57141,"_5":14613,"_27884":56919,"_3010":57142},[],"Remove the archived CRL settings of a CA.",{"_3554":2272,"_30673":2188,"_21251":57144,"_5":14613,"_27884":56919,"_3010":57145},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3554":2273,"_30673":2188,"_21251":57147,"_5":14613,"_27884":56919,"_3010":57148},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3554":2274,"_30673":2188,"_21251":57150,"_5":14613,"_27884":56919,"_3010":57151},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3554":2275,"_30673":2188,"_21251":57153,"_5":14613,"_27884":56923,"_3010":57154},[],"Symptom",{"_3554":2276,"_30673":2188,"_21251":57156,"_5":14613,"_27884":56923,"_3010":57157},[],"Cause",{"_3554":2277,"_30673":2188,"_21251":57159,"_5":14613,"_27884":56923,"_3010":57160},[],"Action",{"_3554":2278,"_30673":2188,"_21251":57162,"_5":14613,"_27884":56923,"_3010":57163},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3554":2279,"_30673":2188,"_21251":57165,"_5":14613,"_27884":56923,"_3010":57166},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3554":2280,"_30673":2188,"_21251":57168,"_5":14613,"_27884":56923,"_3010":57169},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3554":2281,"_30673":2188,"_21251":57171,"_5":14613,"_27884":56923,"_3010":57172},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3554":2282,"_30673":2188,"_21251":57174,"_5":14613,"_27884":56923,"_3010":57175},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3554":2283,"_30673":2188,"_21251":57177,"_5":14613,"_27884":56923,"_3010":57178},[],"Delete the CA first; deleting it archives its settings.",{"_3554":2284,"_30673":2188,"_21251":57180,"_5":14613,"_27884":56923,"_3010":57181},[],"`PUT` returns 400.",{"_3554":2285,"_30673":2188,"_21251":57183,"_5":14613,"_27884":56923,"_3010":57184},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3554":2286,"_30673":2188,"_21251":57186,"_5":14613,"_27884":56923,"_3010":57187},[],"Set the serial number of a valid certificate of that CA.",{"_3554":2287,"_30673":2188,"_21251":57189,"_5":14613,"_27884":56923,"_3010":57190},[],"`PUT` returns 404.",{"_3554":2288,"_30673":2188,"_21251":57192,"_5":14613,"_27884":56923,"_3010":57193},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3554":2289,"_30673":2188,"_21251":57195,"_5":14613,"_27884":56923,"_3010":57196},[],"Check the CA ID and the signer serial number.",{"_3554":2290,"_30673":2188,"_21251":57198,"_5":14613,"_27884":56923,"_3010":57199},[],"`PUT` returns 400 from a 3.x client.",{"_3554":2291,"_30673":2188,"_21251":57201,"_5":14613,"_27884":56923,"_3010":57202},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3554":2292,"_30673":2188,"_21251":57204,"_5":14613,"_27884":56923,"_3010":57205},[],"Update the client to send the new field.",{"_3554":2293,"_30673":2188,"_21251":57207,"_5":14613,"_27884":56923,"_3010":57208},[],"The CRL does not change after revoking a certificate.",{"_3554":2294,"_30673":2188,"_21251":57210,"_5":14613,"_27884":56923,"_3010":57211},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3554":2295,"_30673":2188,"_21251":57213,"_5":14613,"_27884":56923,"_3010":57214},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3554":2296,"_30673":2188,"_21251":57216,"_5":14613,"_27884":56923,"_3010":57217},[],"A verifier rejects the CRL because of the issuer.",{"_3554":2297,"_30673":2188,"_21251":57219,"_5":14613,"_27884":56923,"_3010":57220},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3554":2298,"_30673":2188,"_21251":57222,"_5":14613,"_27884":56923,"_3010":57223},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3554":2299,"_30673":2188,"_21251":57225,"_5":14613,"_27884":56927,"_3010":57226},[],"RFC 5280: X.509 and CRL profile.",{"_3554":2300,"_30673":2188,"_21251":57228,"_5":14613,"_27884":56927,"_3010":57229},[],"OpenSSL: openssl-crl.",{"_3554":2301,"_30673":2188,"_21251":57231,"_5":14613,"_27884":56927,"_3010":57232},[],"OpenSSL: openssl-verify.",{"_3554":2302,"_30673":2188,"_21251":57234,"_5":14613,"_27884":56927,"_3010":57235},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3554":2303,"_30673":2188,"_21251":57237,"_5":14613,"_27884":56927,"_3010":57238},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3554":2304,"_30673":2304,"_5":14965,"_3010":57240,"_31032":57241,"_21251":57242,"_27884":2304},"Keys and cryptographic engines",[50083,51558,55721,55722],[],{"_3554":2305,"_30673":2304,"_21251":57244,"_5":14613,"_27884":2304,"_3010":57245},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3554":2306,"_30673":2304,"_5":31029,"_21251":57247,"_27884":57248,"_3010":57249},[],"/docs/pr-preview/pr-69/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3554":2307,"_30673":2304,"_5":31029,"_21251":57251,"_27884":57252,"_3010":57253},[],"/docs/pr-preview/pr-69/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3554":2308,"_30673":2304,"_5":31029,"_21251":57255,"_27884":57256,"_3010":57257},[],"/docs/pr-preview/pr-69/platform/pki/key-management#file-system","File System",{"_3554":2309,"_30673":2304,"_5":31029,"_21251":57259,"_27884":57260,"_3010":57261},[],"/docs/pr-preview/pr-69/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3554":2310,"_30673":2304,"_5":31029,"_21251":57263,"_27884":57264,"_3010":57265},[],"/docs/pr-preview/pr-69/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3554":2311,"_30673":2304,"_5":31029,"_21251":57267,"_27884":57268,"_3010":57269},[],"/docs/pr-preview/pr-69/platform/pki/key-management#aws-kms","AWS KMS",{"_3554":2312,"_30673":2304,"_5":31029,"_21251":57271,"_27884":57272,"_3010":57273},[],"/docs/pr-preview/pr-69/platform/pki/key-management#pkcs11","PKCS#11",{"_3554":2313,"_30673":2304,"_5":31029,"_21251":57275,"_27884":57276,"_3010":57277},[],"/docs/pr-preview/pr-69/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3554":2314,"_30673":2304,"_5":31029,"_21251":57279,"_27884":57280,"_3010":57281},[],"/docs/pr-preview/pr-69/platform/pki/key-management#key-inventory","Key inventory",{"_3554":2315,"_30673":2304,"_5":31029,"_21251":57283,"_27884":57284,"_3010":57285},[],"/docs/pr-preview/pr-69/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3554":2316,"_30673":2304,"_5":31029,"_21251":57287,"_27884":57288,"_3010":57289},[],"/docs/pr-preview/pr-69/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3554":2317,"_30673":2304,"_5":31029,"_21251":57291,"_27884":57292,"_3010":57293},[],"/docs/pr-preview/pr-69/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3554":2318,"_30673":2304,"_5":31029,"_21251":57295,"_27884":57296,"_3010":57297},[],"/docs/pr-preview/pr-69/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3554":2319,"_30673":2304,"_5":31029,"_21251":57299,"_27884":57300,"_3010":57301},[],"/docs/pr-preview/pr-69/platform/pki/key-management#view-details","View details",{"_3554":2320,"_30673":2304,"_5":31029,"_21251":57303,"_27884":57304,"_3010":57305},[],"/docs/pr-preview/pr-69/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3554":2321,"_30673":2304,"_5":31029,"_21251":57307,"_27884":57308,"_3010":57309},[],"/docs/pr-preview/pr-69/platform/pki/key-management#sign","Sign",{"_3554":2322,"_30673":2304,"_5":31029,"_21251":57311,"_27884":57312,"_3010":57313},[],"/docs/pr-preview/pr-69/platform/pki/key-management#verify","Verify",{"_3554":2323,"_30673":2304,"_5":31029,"_21251":57315,"_27884":57316,"_3010":57317},[],"/docs/pr-preview/pr-69/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3554":2324,"_30673":2304,"_5":31029,"_21251":57319,"_27884":57320,"_3010":57321},[],"/docs/pr-preview/pr-69/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3554":2325,"_30673":2304,"_5":31029,"_21251":57323,"_27884":57324,"_3010":57325},[],"/docs/pr-preview/pr-69/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3554":2326,"_30673":2304,"_21251":57327,"_5":14613,"_27884":2304,"_3010":57328},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3554":2327,"_30673":2304,"_21251":57330,"_5":14613,"_27884":2304,"_3010":57331},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3554":2328,"_30673":2304,"_21251":57333,"_5":14613,"_27884":57248,"_3010":57334},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3554":2329,"_30673":2304,"_21251":57336,"_5":14613,"_27884":57248,"_3010":57337},[],"In practice, it lets you:",{"_3554":2330,"_30673":2304,"_21251":57339,"_5":14613,"_27884":57248,"_3010":57340},[],"Generate new key pairs from Lamassu IoT.",{"_3554":2331,"_30673":2304,"_21251":57342,"_5":14613,"_27884":57248,"_3010":57343},[],"Import keys created externally.",{"_3554":2332,"_30673":2304,"_21251":57345,"_5":14613,"_27884":57248,"_3010":57346},[],"Delegate custody and cryptographic operations to external engines.",{"_3554":2333,"_30673":2304,"_21251":57348,"_5":14613,"_27884":57248,"_3010":57349},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3554":2334,"_30673":2304,"_21251":57351,"_5":14613,"_27884":57252,"_3010":57352},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3554":2335,"_30673":2304,"_21251":57354,"_5":14613,"_27884":57252,"_3010":57355},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3554":2336,"_30673":2304,"_21251":57357,"_5":14613,"_27884":57252,"_3010":57358},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3554":2337,"_30673":2304,"_21251":57360,"_5":14613,"_27884":57256,"_3010":57361},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3554":2338,"_30673":2304,"_21251":57363,"_5":14613,"_27884":57260,"_3010":57364},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3554":2339,"_30673":2304,"_21251":57366,"_5":14613,"_27884":57260,"_3010":57367},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3554":2340,"_30673":2304,"_21251":57369,"_5":14613,"_27884":57264,"_3010":57370},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3554":2341,"_30673":2304,"_21251":57372,"_5":14613,"_27884":57268,"_3010":57373},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3554":2342,"_30673":2304,"_21251":57375,"_5":14613,"_27884":57272,"_3010":57376},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3554":2343,"_30673":2304,"_21251":57378,"_5":14613,"_27884":57276,"_3010":57379},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3554":2344,"_30673":2304,"_21251":57381,"_5":14613,"_27884":57276,"_3010":57382},[],"Lamassu shows the enabled engines in the console.",{"_3554":2345,"_30673":2304,"_21251":57384,"_5":14613,"_27884":57276,"_3010":57385},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3554":2346,"_30673":2304,"_21251":57387,"_5":14613,"_27884":57276,"_3010":57388},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3554":2347,"_30673":2304,"_21251":57390,"_5":14613,"_27884":57280,"_3010":57391},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3554":2348,"_30673":2304,"_21251":57393,"_5":14613,"_27884":57280,"_3010":57394},[],"The table includes the following fields:",{"_3554":2349,"_30673":2304,"_21251":57396,"_5":14613,"_27884":57280,"_3010":57397},[],"**Name**: descriptive name of the key.",{"_3554":2350,"_30673":2304,"_21251":57399,"_5":14613,"_27884":57280,"_3010":57400},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3554":2351,"_30673":2304,"_21251":57402,"_5":14613,"_27884":57280,"_3010":57403},[],"**Strength**: visual indicator of cryptographic strength.",{"_3554":2352,"_30673":2304,"_21251":57405,"_5":14613,"_27884":57280,"_3010":57406},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3554":2353,"_30673":2304,"_21251":57408,"_5":14613,"_27884":57280,"_3010":57409},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3554":2354,"_30673":2304,"_21251":57411,"_5":14613,"_27884":57280,"_3010":57412},[],"**Aliases**: alternative names associated with the key.",{"_3554":2355,"_30673":2304,"_21251":57414,"_5":14613,"_27884":57280,"_3010":57415},[],"**Tags**: labels for classification and search.",{"_3554":2356,"_30673":2304,"_21251":57417,"_5":14613,"_27884":57280,"_3010":57418},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3554":2357,"_30673":2304,"_21251":57420,"_5":14613,"_27884":57280,"_3010":57421},[],"From this view you also reach the most common actions:",{"_3554":2358,"_30673":2304,"_21251":57423,"_5":14613,"_27884":57280,"_3010":57424},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3554":2359,"_30673":2304,"_21251":57426,"_5":14613,"_27884":57280,"_3010":57427},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3554":2360,"_30673":2304,"_21251":57429,"_5":14613,"_27884":57280,"_3010":57430},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3554":2361,"_30673":2304,"_21251":57432,"_5":14613,"_27884":57280,"_3010":57433},[],"**Delete Key** to remove the key from the system.",{"_3554":2362,"_30673":2304,"_21251":57435,"_5":14613,"_27884":57284,"_3010":57436},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3554":2363,"_30673":2304,"_21251":57438,"_5":14613,"_27884":57288,"_3010":57439},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3554":2364,"_30673":2304,"_21251":57441,"_5":14613,"_27884":57288,"_3010":57442},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3554":2365,"_30673":2304,"_21251":57444,"_5":14613,"_27884":57288,"_3010":57445},[],"**Key Name**: unique and descriptive name.",{"_3554":2366,"_30673":2304,"_21251":57447,"_5":14613,"_27884":57288,"_3010":57448},[],"**Crypto Engine**: engine that will keep the key.",{"_3554":2367,"_30673":2304,"_21251":57450,"_5":14613,"_27884":57288,"_3010":57451},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3554":2368,"_30673":2304,"_21251":57453,"_5":14613,"_27884":57288,"_3010":57454},[],"**Tags**: metadata to classify the key.",{"_3554":2369,"_30673":2304,"_21251":57456,"_5":14613,"_27884":57288,"_3010":57457},[],"**Metadata**: additional information for advanced uses.",{"_3554":2370,"_30673":2304,"_21251":57459,"_5":14613,"_27884":57292,"_3010":57460},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3554":2371,"_30673":2304,"_21251":57462,"_5":14613,"_27884":57292,"_3010":57463},[],"When you have an exportable private key and the destination engine supports import.",{"_3554":2372,"_30673":2304,"_21251":57465,"_5":14613,"_27884":57292,"_3010":57466},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3554":2373,"_30673":2304,"_21251":57468,"_5":14613,"_27884":57292,"_3010":57469},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3554":2374,"_30673":2304,"_21251":57471,"_5":14613,"_27884":57292,"_3010":57472},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3554":2375,"_30673":2304,"_21251":57474,"_5":14613,"_27884":57292,"_3010":57475},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3554":2376,"_30673":2304,"_21251":57477,"_5":14613,"_27884":57292,"_3010":57478},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3554":2377,"_30673":2304,"_21251":57480,"_5":14613,"_27884":57292,"_3010":57481},[],"**Tags**: labels for organization and search.",{"_3554":2378,"_30673":2304,"_21251":57483,"_5":14613,"_27884":57292,"_3010":57484},[],"**Metadata**: additional optional information.",{"_3554":2379,"_30673":2304,"_21251":57486,"_5":14613,"_27884":57292,"_3010":57487},[],"**Private Key (PEM)**: private key in PEM format.",{"_3554":2380,"_30673":2304,"_21251":57489,"_5":14613,"_27884":57292,"_3010":57490},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3554":2381,"_30673":2304,"_21251":57492,"_5":14613,"_27884":57296,"_3010":57493},[],"Each registered key has a detail view and several operational actions.",{"_3554":2382,"_30673":2304,"_21251":57495,"_5":14613,"_27884":57300,"_3010":57496},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3554":2383,"_30673":2304,"_21251":57498,"_5":14613,"_27884":57300,"_3010":57499},[],"The **Overview** tab shows, among others, these fields:",{"_3554":2384,"_30673":2304,"_21251":57501,"_5":14613,"_27884":57300,"_3010":57502},[],"**Key Name**: descriptive name.",{"_3554":2385,"_30673":2304,"_21251":57504,"_5":14613,"_27884":57300,"_3010":57505},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3554":2386,"_30673":2304,"_21251":57507,"_5":14613,"_27884":57300,"_3010":57508},[],"**Tags**: associated labels.",{"_3554":2387,"_30673":2304,"_21251":57510,"_5":14613,"_27884":57300,"_3010":57511},[],"**Aliases**: alternative names.",{"_3554":2388,"_30673":2304,"_21251":57513,"_5":14613,"_27884":57300,"_3010":57514},[],"**Crypto Engine**: engine where the key resides.",{"_3554":2389,"_30673":2304,"_21251":57516,"_5":14613,"_27884":57300,"_3010":57517},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3554":2390,"_30673":2304,"_21251":57519,"_5":14613,"_27884":57300,"_3010":57520},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3554":2391,"_30673":2304,"_21251":57522,"_5":14613,"_27884":57300,"_3010":57523},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3554":2392,"_30673":2304,"_21251":57525,"_5":14613,"_27884":57304,"_3010":57526},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3554":2393,"_30673":2304,"_21251":57528,"_5":14613,"_27884":57304,"_3010":57529},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3554":2394,"_30673":2304,"_21251":57531,"_5":14613,"_27884":57304,"_3010":57532},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3554":2395,"_30673":2304,"_21251":57534,"_5":14613,"_27884":57308,"_3010":57535},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3554":2396,"_30673":2304,"_21251":57537,"_5":14613,"_27884":57308,"_3010":57538},[],"Main fields:",{"_3554":2397,"_30673":2304,"_21251":57540,"_5":14613,"_27884":57308,"_3010":57541},[],"**Algorithm**: signing algorithm available for the key type.",{"_3554":2398,"_30673":2304,"_21251":57543,"_5":14613,"_27884":57308,"_3010":57544},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3554":2399,"_30673":2304,"_21251":57546,"_5":14613,"_27884":57308,"_3010":57547},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3554":2400,"_30673":2304,"_21251":57549,"_5":14613,"_27884":57308,"_3010":57550},[],"**Message**: content to sign.",{"_3554":2401,"_30673":2304,"_21251":57552,"_5":14613,"_27884":57308,"_3010":57553},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3554":2402,"_30673":2304,"_21251":57555,"_5":14613,"_27884":57312,"_3010":57556},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3554":2403,"_30673":2304,"_21251":57558,"_5":14613,"_27884":57312,"_3010":57538},[],{"_3554":2404,"_30673":2304,"_21251":57560,"_5":14613,"_27884":57312,"_3010":57561},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3554":2405,"_30673":2304,"_21251":57563,"_5":14613,"_27884":57312,"_3010":57564},[],"**Message Type**: `Raw` or `Digest`.",{"_3554":2406,"_30673":2304,"_21251":57566,"_5":14613,"_27884":57312,"_3010":57567},[],"**Payload Encoding**: encoding of the message.",{"_3554":2407,"_30673":2304,"_21251":57569,"_5":14613,"_27884":57312,"_3010":57570},[],"**Message**: original message or hash.",{"_3554":2408,"_30673":2304,"_21251":57572,"_5":14613,"_27884":57312,"_3010":57573},[],"**Signature**: signature to check.",{"_3554":2409,"_30673":2304,"_21251":57575,"_5":14613,"_27884":57312,"_3010":57576},[],"**Result**: indicator of the validation result.",{"_3554":2410,"_30673":2304,"_21251":57578,"_5":14613,"_27884":57316,"_3010":57579},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3554":2411,"_30673":2304,"_21251":57581,"_5":14613,"_27884":57316,"_3010":57582},[],"This flow is useful for:",{"_3554":2412,"_30673":2304,"_21251":57584,"_5":14613,"_27884":57316,"_3010":57585},[],"Requesting certificates from an external CA.",{"_3554":2413,"_30673":2304,"_21251":57587,"_5":14613,"_27884":57316,"_3010":57588},[],"Renewing an identity while keeping the same key.",{"_3554":2414,"_30673":2304,"_21251":57590,"_5":14613,"_27884":57316,"_3010":57591},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3554":2415,"_30673":2304,"_21251":57593,"_5":14613,"_27884":57316,"_3010":57594},[],"**Common Name (CN)**: main name of the identity.",{"_3554":2416,"_30673":2304,"_21251":57596,"_5":14613,"_27884":57316,"_3010":57597},[],"**Organization (O)**: organization or company.",{"_3554":2417,"_30673":2304,"_21251":57599,"_5":14613,"_27884":57316,"_3010":57600},[],"**Organizational Unit (OU)**: department or unit.",{"_3554":2418,"_30673":2304,"_21251":57602,"_5":14613,"_27884":57316,"_3010":57603},[],"**Country (C)**: two-letter country code.",{"_3554":2419,"_30673":2304,"_21251":57605,"_5":14613,"_27884":57316,"_3010":57606},[],"**State / Province (ST)**: state or province.",{"_3554":2420,"_30673":2304,"_21251":57608,"_5":14613,"_27884":57316,"_3010":57609},[],"**Locality (L)**: city or locality.",{"_3554":2421,"_30673":2304,"_21251":57611,"_5":14613,"_27884":57316,"_3010":57612},[],"**Email Address**: contact email.",{"_3554":2422,"_30673":2304,"_21251":57614,"_5":14613,"_27884":57316,"_3010":57615},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3554":2423,"_30673":2304,"_21251":57617,"_5":14613,"_27884":57316,"_3010":57618},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3554":2424,"_30673":2304,"_21251":57620,"_5":14613,"_27884":57320,"_3010":57621},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3554":2425,"_30673":2304,"_21251":57623,"_5":14613,"_27884":57320,"_3010":57624},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3554":2426,"_30673":2304,"_21251":57626,"_5":14613,"_27884":57324,"_3010":57627},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3554":2427,"_30673":2304,"_21251":57629,"_5":14613,"_27884":57324,"_3010":57630},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3554":2428,"_30673":2428,"_5":14965,"_3010":57632,"_31032":57633,"_21251":57634,"_27884":2428},"Online validation with OCSP",[50083,51558,55721,56363],[],{"_3554":2429,"_30673":2428,"_21251":57636,"_5":14613,"_27884":2428,"_3010":57637},[],"Query signed status and verify the responder’s response.",{"_3554":2430,"_30673":2428,"_5":31029,"_21251":57639,"_27884":57640,"_3010":57641},[],"/docs/pr-preview/pr-69/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3554":2431,"_30673":2428,"_5":31029,"_21251":57643,"_27884":57644,"_3010":57645},[],"/docs/pr-preview/pr-69/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3554":2432,"_30673":2428,"_5":31029,"_21251":57647,"_27884":57648,"_3010":57649},[],"/docs/pr-preview/pr-69/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3554":2433,"_30673":2428,"_5":31029,"_21251":57651,"_27884":57652,"_3010":57653},[],"/docs/pr-preview/pr-69/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3554":2434,"_30673":2428,"_5":31029,"_21251":57655,"_27884":57656,"_3010":57657},[],"/docs/pr-preview/pr-69/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3554":2435,"_30673":2428,"_5":31029,"_21251":57659,"_27884":57660,"_3010":56928},[],"/docs/pr-preview/pr-69/platform/pki/ocsp#references",{"_3554":2436,"_30673":2428,"_21251":57662,"_5":14613,"_27884":2428,"_3010":57663},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3554":2437,"_30673":2428,"_21251":57665,"_5":14613,"_27884":57640,"_3010":57666},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3554":2438,"_30673":2428,"_21251":57668,"_5":14613,"_27884":57640,"_3010":57669},[],"Record status",{"_3554":2439,"_30673":2428,"_21251":57671,"_5":14613,"_27884":57640,"_3010":57672},[],"Signed response",{"_3554":2440,"_30673":2428,"_21251":57674,"_5":14613,"_27884":57640,"_3010":54858},[],{"_3554":2441,"_30673":2428,"_21251":57676,"_5":14613,"_27884":57640,"_3010":57677},[],"`Good`.",{"_3554":2442,"_30673":2428,"_21251":57679,"_5":14613,"_27884":57640,"_3010":54875},[],{"_3554":2443,"_30673":2428,"_21251":57681,"_5":14613,"_27884":57640,"_3010":57682},[],"`Revoked`, with revocation reason and timestamp.",{"_3554":2444,"_30673":2428,"_21251":57684,"_5":14613,"_27884":57640,"_3010":57685},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3554":2445,"_30673":2428,"_21251":57687,"_5":14613,"_27884":57640,"_3010":57688},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3554":2446,"_30673":2428,"_21251":57690,"_5":14613,"_27884":57640,"_3010":57691},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3554":2447,"_30673":2428,"_21251":57693,"_5":14613,"_27884":57640,"_3010":57694},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3554":2448,"_30673":2428,"_21251":57696,"_5":14613,"_27884":57640,"_3010":57697},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3554":2449,"_30673":2428,"_21251":57699,"_5":14613,"_27884":57644,"_3010":57700},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3554":2450,"_30673":2428,"_21251":57702,"_5":14613,"_27884":57644,"_3010":57703},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3554":2451,"_30673":2428,"_21251":57705,"_5":14613,"_27884":57648,"_3010":57706},[],"The service accepts:",{"_3554":2452,"_30673":2428,"_21251":57708,"_5":14613,"_27884":57648,"_3010":53486},[],{"_3554":2453,"_30673":2428,"_21251":57710,"_5":14613,"_27884":57648,"_3010":57711},[],"VA service path",{"_3554":2454,"_30673":2428,"_21251":57713,"_5":14613,"_27884":57648,"_3010":57714},[],"Format",{"_3554":2455,"_30673":2428,"_21251":57716,"_5":14613,"_27884":57648,"_3010":57717},[],"`POST`",{"_3554":2456,"_30673":2428,"_21251":57719,"_5":14613,"_27884":57648,"_3010":57720},[],"`/ocsp`",{"_3554":2457,"_30673":2428,"_21251":57722,"_5":14613,"_27884":57648,"_3010":57723},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3554":2458,"_30673":2428,"_21251":57725,"_5":14613,"_27884":57648,"_3010":57112},[],{"_3554":2459,"_30673":2428,"_21251":57727,"_5":14613,"_27884":57648,"_3010":57728},[],"`/ocsp/{ocsp_request}`",{"_3554":2460,"_30673":2428,"_21251":57730,"_5":14613,"_27884":57648,"_3010":57731},[],"DER request encoded using padded URL Base64.",{"_3554":2461,"_30673":2428,"_21251":57733,"_5":14613,"_27884":57648,"_3010":57734},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3554":2462,"_30673":2428,"_21251":57736,"_5":14613,"_27884":57652,"_3010":57737},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3554":2463,"_30673":2428,"_21251":57739,"_5":14613,"_27884":57652,"_3010":57740},[],"Generate the request:",{"_3554":2464,"_30673":2428,"_21251":57742,"_5":14613,"_27884":57652,"_3010":57743},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3554":2465,"_30673":2428,"_21251":57745,"_5":14613,"_27884":57652,"_3010":57746},[],"Replace the example URL with the inspected endpoint:",{"_3554":2466,"_30673":2428,"_21251":57748,"_5":14613,"_27884":57652,"_3010":57749},[],"Verify the returned DER:",{"_3554":2467,"_30673":2428,"_21251":57751,"_5":14613,"_27884":57652,"_3010":57752},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3554":2468,"_30673":2428,"_21251":57754,"_5":14613,"_27884":57656,"_3010":57755},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3554":2469,"_30673":2428,"_21251":57757,"_5":14613,"_27884":57656,"_3010":57758},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3554":2470,"_30673":2428,"_21251":57760,"_5":14613,"_27884":57660,"_3010":57761},[],"RFC 6960: OCSP.",{"_3554":2471,"_30673":2428,"_21251":57763,"_5":14613,"_27884":57660,"_3010":57764},[],"OpenSSL: openssl-ocsp.",{"_3554":2472,"_30673":2428,"_21251":57766,"_5":14613,"_27884":57660,"_3010":57767},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3554":2473,"_30673":2428,"_21251":57769,"_5":14613,"_27884":57660,"_3010":57238},[],{"_3554":2474,"_30673":2474,"_5":14965,"_3010":55721,"_31032":57771,"_21251":57772,"_27884":2474},[50083,51558,55721],[],{"_3554":2475,"_30673":2474,"_21251":57774,"_5":14613,"_27884":2474,"_3010":57775},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3554":2476,"_30673":2474,"_5":31029,"_21251":57777,"_27884":57778,"_3010":55033},[],"/docs/pr-preview/pr-69/platform/pki/overview#start-here",{"_3554":2477,"_30673":2474,"_5":31029,"_21251":57780,"_27884":57781,"_3010":57782},[],"/docs/pr-preview/pr-69/platform/pki/overview#what-you-need","What you need",{"_3554":2478,"_30673":2474,"_5":31029,"_21251":57784,"_27884":57785,"_3010":55565},[],"/docs/pr-preview/pr-69/platform/pki/overview#core-capabilities",{"_3554":2479,"_30673":2474,"_5":31029,"_21251":57787,"_27884":57788,"_3010":55569},[],"/docs/pr-preview/pr-69/platform/pki/overview#build-your-trust-hierarchy",{"_3554":2480,"_30673":2474,"_5":31029,"_21251":57790,"_27884":57791,"_3010":55573},[],"/docs/pr-preview/pr-69/platform/pki/overview#protect-cryptographic-keys",{"_3554":2481,"_30673":2474,"_5":31029,"_21251":57793,"_27884":57794,"_3010":55577},[],"/docs/pr-preview/pr-69/platform/pki/overview#issue-and-control-certificates",{"_3554":2482,"_30673":2474,"_5":31029,"_21251":57796,"_27884":57797,"_3010":55585},[],"/docs/pr-preview/pr-69/platform/pki/overview#publish-validation-status",{"_3554":2483,"_30673":2474,"_5":31029,"_21251":57799,"_27884":57800,"_3010":57801},[],"/docs/pr-preview/pr-69/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3554":2484,"_30673":2474,"_5":31029,"_21251":57803,"_27884":57804,"_3010":56530},[],"/docs/pr-preview/pr-69/platform/pki/overview#continue",{"_3554":2485,"_30673":2474,"_21251":57806,"_5":14613,"_27884":2474,"_3010":57807},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3554":2486,"_30673":2474,"_21251":57809,"_5":14613,"_27884":57778,"_3010":57810},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3554":2487,"_30673":2474,"_21251":57812,"_5":14613,"_27884":57778,"_3010":57813},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3554":2488,"_30673":2474,"_21251":57815,"_5":14613,"_27884":57781,"_3010":57816},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3554":2489,"_30673":2474,"_21251":57818,"_5":14613,"_27884":57781,"_3010":57819},[],"An available cryptographic engine to keep the authority's key.",{"_3554":2490,"_30673":2474,"_21251":57821,"_5":14613,"_27884":57781,"_3010":57822},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3554":2491,"_30673":2474,"_21251":57824,"_5":14613,"_27884":57781,"_3010":57825},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3554":2492,"_30673":2474,"_21251":57827,"_5":14613,"_27884":57781,"_3010":57828},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3554":2493,"_30673":2474,"_21251":57830,"_5":14613,"_27884":57788,"_3010":57831},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3554":2494,"_30673":2474,"_21251":57833,"_5":14613,"_27884":57791,"_3010":57834},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3554":2495,"_30673":2474,"_21251":57836,"_5":14613,"_27884":57794,"_3010":57837},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3554":2496,"_30673":2474,"_21251":57839,"_5":14613,"_27884":57797,"_3010":57840},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3554":2497,"_30673":2474,"_21251":57842,"_5":14613,"_27884":57800,"_3010":57843},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3554":2498,"_30673":2474,"_21251":57845,"_5":14613,"_27884":57800,"_3010":57846},[],"its subject and extensions identify the expected client;",{"_3554":2499,"_30673":2474,"_21251":57848,"_5":14613,"_27884":57800,"_3010":57849},[],"its public key matches the client's private key;",{"_3554":2500,"_30673":2474,"_21251":57851,"_5":14613,"_27884":57800,"_3010":57852},[],"its chain reaches a root trusted by the consumer;",{"_3554":2501,"_30673":2474,"_21251":57854,"_5":14613,"_27884":57800,"_3010":57855},[],"its dates and usages allow the operation;",{"_3554":2502,"_30673":2474,"_21251":57857,"_5":14613,"_27884":57800,"_3010":57858},[],"the consumer applies revocation checks and authorization.",{"_3554":2503,"_30673":2474,"_21251":57860,"_5":14613,"_27884":57800,"_3010":57861},[],"The issuance path includes the first independent checks.",{"_3554":2504,"_30673":2474,"_21251":57863,"_5":14613,"_27884":57804,"_3010":57864},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3554":2505,"_30673":2474,"_21251":57866,"_5":14613,"_27884":57804,"_3010":57867},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3554":2506,"_30673":2474,"_21251":57869,"_5":14613,"_27884":57804,"_3010":57870},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3554":2507,"_30673":2507,"_5":14965,"_3010":57872,"_31032":57873,"_21251":57874,"_27884":2507},"Create your first CA",[50083,51558,55721,55158],[],{"_3554":2508,"_30673":2507,"_21251":57876,"_5":14613,"_27884":2507,"_3010":57877},[],"Create an evaluation root and check its certificate before issuing.",{"_3554":2509,"_30673":2507,"_5":31029,"_21251":57879,"_27884":57880,"_3010":50093},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3554":2510,"_30673":2507,"_5":31029,"_21251":57882,"_27884":57883,"_3010":57884},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3554":2511,"_30673":2507,"_5":31029,"_21251":57886,"_27884":57887,"_3010":57888},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3554":2512,"_30673":2507,"_5":31029,"_21251":57890,"_27884":57891,"_3010":57892},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3554":2513,"_30673":2507,"_5":31029,"_21251":57894,"_27884":57895,"_3010":57896},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3554":2514,"_30673":2507,"_5":31029,"_21251":57898,"_27884":57899,"_3010":57900},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3554":2515,"_30673":2507,"_5":31029,"_21251":57902,"_27884":57903,"_3010":57904},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3554":2516,"_30673":2507,"_5":31029,"_21251":57906,"_27884":57907,"_3010":55415},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3554":2517,"_30673":2507,"_5":31029,"_21251":57909,"_27884":57910,"_3010":50117},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3554":2518,"_30673":2507,"_21251":57912,"_5":14613,"_27884":2507,"_3010":57913},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3554":2519,"_30673":2507,"_21251":57915,"_5":14613,"_27884":57880,"_3010":57916},[],"Console access and permission to create keys and authorities.",{"_3554":2520,"_30673":2507,"_21251":57918,"_5":14613,"_27884":57880,"_3010":57919},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3554":2521,"_30673":2507,"_21251":57921,"_5":14613,"_27884":57880,"_3010":57922},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3554":2522,"_30673":2507,"_21251":57924,"_5":14613,"_27884":57880,"_3010":57925},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3554":2523,"_30673":2507,"_21251":57927,"_5":14613,"_27884":57883,"_3010":57928},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3554":2524,"_30673":2507,"_21251":57930,"_5":14613,"_27884":57883,"_3010":57931},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3554":2525,"_30673":2507,"_21251":57933,"_5":14613,"_27884":57887,"_3010":57934},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3554":2526,"_30673":2507,"_21251":57936,"_5":14613,"_27884":57887,"_3010":57937},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3554":2527,"_30673":2507,"_21251":57939,"_5":14613,"_27884":57891,"_3010":57940},[],"Select **Root CA** and complete:",{"_3554":2528,"_30673":2507,"_21251":57942,"_5":14613,"_27884":57891,"_3010":57943},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3554":2529,"_30673":2507,"_21251":57945,"_5":14613,"_27884":57891,"_3010":57946},[],"**Subject**: organization and country details for your evaluation.",{"_3554":2530,"_30673":2507,"_21251":57948,"_5":14613,"_27884":57891,"_3010":57949},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3554":2531,"_30673":2507,"_21251":57951,"_5":14613,"_27884":57891,"_3010":57952},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3554":2532,"_30673":2507,"_21251":57954,"_5":14613,"_27884":57891,"_3010":57955},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3554":2533,"_30673":2507,"_21251":57957,"_5":14613,"_27884":57895,"_3010":57958},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3554":2534,"_30673":2507,"_21251":57960,"_5":14613,"_27884":57899,"_3010":57961},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3554":2535,"_30673":2507,"_21251":57963,"_5":14613,"_27884":57899,"_3010":57964},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3554":2536,"_30673":2507,"_21251":57966,"_5":14613,"_27884":57903,"_3010":57967},[],"Run from the directory where you saved `ca.pem`:",{"_3554":2537,"_30673":2507,"_21251":57969,"_5":14613,"_27884":57903,"_3010":57970},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3554":2538,"_30673":2507,"_21251":57972,"_5":14613,"_27884":57903,"_3010":57973},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3554":2539,"_30673":2507,"_21251":57975,"_5":14613,"_27884":57907,"_3010":57976},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3554":2540,"_30673":2507,"_21251":57978,"_5":14613,"_27884":57907,"_3010":57979},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3554":2541,"_30673":2507,"_21251":57981,"_5":14613,"_27884":57907,"_3010":57982},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3554":2542,"_30673":2507,"_21251":57984,"_5":14613,"_27884":57907,"_3010":57985},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3554":2543,"_30673":2507,"_21251":57987,"_5":14613,"_27884":57910,"_3010":57988},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3554":2544,"_30673":2544,"_5":14965,"_3010":57990,"_31032":57991,"_21251":57992,"_27884":2544},"Issue and verify a certificate",[50083,51558,55721,55158],[],{"_3554":2545,"_30673":2544,"_21251":57994,"_5":14613,"_27884":2544,"_3010":57995},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3554":2546,"_30673":2544,"_5":31029,"_21251":57997,"_27884":57998,"_3010":50093},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3554":2547,"_30673":2544,"_5":31029,"_21251":58000,"_27884":58001,"_3010":58002},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3554":2548,"_30673":2544,"_5":31029,"_21251":58004,"_27884":58005,"_3010":58006},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3554":2549,"_30673":2544,"_5":31029,"_21251":58008,"_27884":58009,"_3010":58010},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3554":2550,"_30673":2544,"_5":31029,"_21251":58012,"_27884":58013,"_3010":58014},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3554":2551,"_30673":2544,"_5":31029,"_21251":58016,"_27884":58017,"_3010":58018},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3554":2552,"_30673":2544,"_5":31029,"_21251":58020,"_27884":58021,"_3010":58022},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3554":2553,"_30673":2544,"_5":31029,"_21251":58024,"_27884":58025,"_3010":58026},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3554":2554,"_30673":2544,"_5":31029,"_21251":58028,"_27884":58029,"_3010":58030},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3554":2555,"_30673":2544,"_5":31029,"_21251":58032,"_27884":58033,"_3010":58034},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3554":2556,"_30673":2544,"_5":31029,"_21251":58036,"_27884":58037,"_3010":55415},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3554":2557,"_30673":2544,"_5":31029,"_21251":58039,"_27884":58040,"_3010":50117},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/issue-certificate#next-step",{"_3554":2558,"_30673":2544,"_21251":58042,"_5":14613,"_27884":2544,"_3010":58043},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3554":2559,"_30673":2544,"_21251":58045,"_5":14613,"_27884":57998,"_3010":58046},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3554":2560,"_30673":2544,"_21251":58048,"_5":14613,"_27884":57998,"_3010":58049},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3554":2561,"_30673":2544,"_21251":58051,"_5":14613,"_27884":57998,"_3010":58052},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3554":2562,"_30673":2544,"_21251":58054,"_5":14613,"_27884":57998,"_3010":58055},[],"A client identifier: here we use `device-001`.",{"_3554":2563,"_30673":2544,"_21251":58057,"_5":14613,"_27884":57998,"_3010":58058},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3554":2564,"_30673":2544,"_21251":58060,"_5":14613,"_27884":58001,"_3010":58061},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3554":2565,"_30673":2544,"_21251":58063,"_5":14613,"_27884":58005,"_3010":58064},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3554":2566,"_30673":2544,"_21251":58066,"_5":14613,"_27884":58005,"_3010":58067},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3554":2567,"_30673":2544,"_21251":58069,"_5":14613,"_27884":58009,"_3010":58070},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3554":2568,"_30673":2544,"_21251":58072,"_5":14613,"_27884":58009,"_3010":58073},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3554":2569,"_30673":2544,"_21251":58075,"_5":14613,"_27884":58013,"_3010":58076},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3554":2570,"_30673":2544,"_21251":58078,"_5":14613,"_27884":58013,"_3010":58079},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3554":2571,"_30673":2544,"_21251":58081,"_5":14613,"_27884":58017,"_3010":58082},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3554":2572,"_30673":2544,"_21251":58084,"_5":14613,"_27884":58021,"_3010":58085},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3554":2573,"_30673":2544,"_21251":58087,"_5":14613,"_27884":58025,"_3010":58088},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3554":2574,"_30673":2544,"_21251":58090,"_5":14613,"_27884":58029,"_3010":58091},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3554":2575,"_30673":2544,"_21251":58093,"_5":14613,"_27884":58029,"_3010":58094},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3554":2576,"_30673":2544,"_21251":58096,"_5":14613,"_27884":58029,"_3010":58097},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3554":2577,"_30673":2544,"_21251":58099,"_5":14613,"_27884":58033,"_3010":58100},[],"In Bash, compare the two public-key digests:",{"_3554":2578,"_30673":2544,"_21251":58102,"_5":14613,"_27884":58033,"_3010":58103},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3554":2579,"_30673":2544,"_21251":58105,"_5":14613,"_27884":58033,"_3010":58106},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3554":2580,"_30673":2544,"_21251":58108,"_5":14613,"_27884":58037,"_3010":55499},[],{"_3554":2581,"_30673":2544,"_21251":58110,"_5":14613,"_27884":58037,"_3010":58111},[],"What to review",{"_3554":2582,"_30673":2544,"_21251":58113,"_5":14613,"_27884":58037,"_3010":58114},[],"The CA rejects issuance",{"_3554":2583,"_30673":2544,"_21251":58116,"_5":14613,"_27884":58037,"_3010":58117},[],"Permissions, CA state and key, algorithm and profile.",{"_3554":2584,"_30673":2544,"_21251":58119,"_5":14613,"_27884":58037,"_3010":58120},[],"Different subject or usages",{"_3554":2585,"_30673":2544,"_21251":58122,"_5":14613,"_27884":58037,"_3010":58123},[],"Applied profile and requested values.",{"_3554":2586,"_30673":2544,"_21251":58125,"_5":14613,"_27884":58037,"_3010":58126},[],"Issuer cannot be found",{"_3554":2587,"_30673":2544,"_21251":58128,"_5":14613,"_27884":58037,"_3010":58129},[],"Downloaded CA and required intermediate chain.",{"_3554":2588,"_30673":2544,"_21251":58131,"_5":14613,"_27884":58037,"_3010":58132},[],"Validity fails",{"_3554":2589,"_30673":2544,"_21251":58134,"_5":14613,"_27884":58037,"_3010":58135},[],"Certificate and CA dates, and the computer's clock.",{"_3554":2590,"_30673":2544,"_21251":58137,"_5":14613,"_27884":58037,"_3010":58138},[],"Public-key digests differ",{"_3554":2591,"_30673":2544,"_21251":58140,"_5":14613,"_27884":58037,"_3010":58141},[],"Certificate and key files from the same issuance.",{"_3554":2592,"_30673":2544,"_21251":58143,"_5":14613,"_27884":58037,"_3010":58144},[],"See PKI diagnostics to narrow an issuance failure.",{"_3554":2593,"_30673":2544,"_21251":58146,"_5":14613,"_27884":58040,"_3010":58147},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3554":2594,"_30673":2544,"_21251":58149,"_5":14613,"_27884":58040,"_3010":58150},[],"Manage certificates for inspection, status and revocation.",{"_3554":2595,"_30673":2544,"_21251":58152,"_5":14613,"_27884":58040,"_3010":58153},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3554":2596,"_30673":2544,"_21251":58155,"_5":14613,"_27884":58040,"_3010":58156},[],"Prepare EST for the device to request its next identities.",{"_3554":2597,"_30673":2544,"_21251":58158,"_5":14613,"_27884":58040,"_3010":58159},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3554":2598,"_30673":2598,"_5":14965,"_3010":58161,"_31032":58162,"_21251":58163,"_27884":2598},"PKI getting started",[50083,51558,55721,55158],[],{"_3554":2599,"_30673":2598,"_21251":58165,"_5":14613,"_27884":2598,"_3010":58166},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3554":2600,"_30673":2598,"_5":31029,"_21251":58168,"_27884":58169,"_3010":50093},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/overview#before-you-begin",{"_3554":2601,"_30673":2598,"_5":31029,"_21251":58171,"_27884":58172,"_3010":58173},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3554":2602,"_30673":2598,"_5":31029,"_21251":58175,"_27884":58176,"_3010":55350},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/overview#expected-result",{"_3554":2603,"_30673":2598,"_5":31029,"_21251":58178,"_27884":58179,"_3010":58180},[],"/docs/pr-preview/pr-69/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3554":2604,"_30673":2598,"_21251":58182,"_5":14613,"_27884":2598,"_3010":58183},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3554":2605,"_30673":2598,"_21251":58185,"_5":14613,"_27884":58169,"_3010":58186},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3554":2606,"_30673":2598,"_21251":58188,"_5":14613,"_27884":58169,"_3010":58189},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3554":2607,"_30673":2598,"_21251":58191,"_5":14613,"_27884":58169,"_3010":58192},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3554":2608,"_30673":2598,"_21251":58194,"_5":14613,"_27884":58169,"_3010":58195},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3554":2609,"_30673":2598,"_21251":58197,"_5":14613,"_27884":58169,"_3010":58198},[],"A working directory with restricted access for the downloaded key.",{"_3554":2610,"_30673":2598,"_21251":58200,"_5":14613,"_27884":58172,"_3010":58201},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3554":2611,"_30673":2598,"_21251":58203,"_5":14613,"_27884":58172,"_3010":58204},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3554":2612,"_30673":2598,"_21251":58206,"_5":14613,"_27884":58172,"_3010":58207},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3554":2613,"_30673":2598,"_21251":58209,"_5":14613,"_27884":58172,"_3010":58210},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3554":2614,"_30673":2598,"_21251":58212,"_5":14613,"_27884":58176,"_3010":58213},[],"File or resource",{"_3554":2615,"_30673":2598,"_21251":58215,"_5":14613,"_27884":58176,"_3010":55347},[],{"_3554":2616,"_30673":2598,"_21251":58217,"_5":14613,"_27884":58176,"_3010":58218},[],"Active root CA and `ca.pem`",{"_3554":2617,"_30673":2598,"_21251":58220,"_5":14613,"_27884":58176,"_3010":58221},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3554":2618,"_30673":2598,"_21251":58223,"_5":14613,"_27884":58176,"_3010":58224},[],"End-entity certificate and `device.crt`",{"_3554":2619,"_30673":2598,"_21251":58226,"_5":14613,"_27884":58176,"_3010":58227},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3554":2620,"_30673":2598,"_21251":58229,"_5":14613,"_27884":58176,"_3010":58230},[],"Private key `device.key`",{"_3554":2621,"_30673":2598,"_21251":58232,"_5":14613,"_27884":58176,"_3010":58233},[],"Its public key matches the one included in `device.crt`.",{"_3554":2622,"_30673":2598,"_21251":58235,"_5":14613,"_27884":58176,"_3010":58236},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3554":2623,"_30673":2598,"_21251":58238,"_5":14613,"_27884":58179,"_3010":58239},[],"To operate certificates, continue with Certificates and Validation.",{"_3554":2624,"_30673":2598,"_21251":58241,"_5":14613,"_27884":58179,"_3010":58242},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3554":2625,"_30673":2598,"_21251":58244,"_5":14613,"_27884":58179,"_3010":58245},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3554":2626,"_30673":2626,"_5":14965,"_3010":58247,"_31032":58248,"_21251":58249,"_27884":2626},"PKI troubleshooting",[50083,51558,55721,54296],[],{"_3554":2627,"_30673":2626,"_21251":58251,"_5":14613,"_27884":2626,"_3010":58252},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3554":2628,"_30673":2626,"_5":31029,"_21251":58254,"_27884":58255,"_3010":58256},[],"/docs/pr-preview/pr-69/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3554":2629,"_30673":2626,"_5":31029,"_21251":58258,"_27884":58259,"_3010":58260},[],"/docs/pr-preview/pr-69/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3554":2630,"_30673":2626,"_5":31029,"_21251":58262,"_27884":58263,"_3010":58264},[],"/docs/pr-preview/pr-69/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3554":2631,"_30673":2626,"_21251":58266,"_5":14613,"_27884":2626,"_3010":58267},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3554":2632,"_30673":2626,"_21251":58269,"_5":14613,"_27884":2626,"_3010":58270},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3554":2633,"_30673":2626,"_21251":58272,"_5":14613,"_27884":58255,"_3010":55347},[],{"_3554":2634,"_30673":2626,"_21251":58274,"_5":14613,"_27884":58255,"_3010":58275},[],"What to inspect",{"_3554":2635,"_30673":2626,"_21251":58277,"_5":14613,"_27884":58255,"_3010":50117},[],{"_3554":2636,"_30673":2626,"_21251":58279,"_5":14613,"_27884":58255,"_3010":54563},[],{"_3554":2637,"_30673":2626,"_21251":58281,"_5":14613,"_27884":58255,"_3010":58282},[],"Exists, is active and has usable dates.",{"_3554":2638,"_30673":2626,"_21251":58284,"_5":14613,"_27884":58255,"_3010":58285},[],"Authorities.",{"_3554":2639,"_30673":2626,"_21251":58287,"_5":14613,"_27884":58255,"_3010":58288},[],"Key",{"_3554":2640,"_30673":2626,"_21251":58290,"_5":14613,"_27884":58255,"_3010":58291},[],"The record has a usable private key and the engine can sign.",{"_3554":2641,"_30673":2626,"_21251":58293,"_5":14613,"_27884":58255,"_3010":58294},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3554":2642,"_30673":2626,"_21251":58296,"_5":14613,"_27884":58255,"_3010":58297},[],"CSR",{"_3554":2643,"_30673":2626,"_21251":58299,"_5":14613,"_27884":58255,"_3010":58300},[],"Correct PEM and verifiable signature.",{"_3554":2644,"_30673":2626,"_21251":58302,"_5":14613,"_27884":58255,"_3010":58303},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3554":2645,"_30673":2626,"_21251":58305,"_5":14613,"_27884":58255,"_3010":58306},[],"Profile",{"_3554":2646,"_30673":2626,"_21251":58308,"_5":14613,"_27884":58255,"_3010":58309},[],"Selected source, existing ID, allowed algorithm and size.",{"_3554":2647,"_30673":2626,"_21251":58311,"_5":14613,"_27884":58255,"_3010":58312},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3554":2648,"_30673":2626,"_21251":58314,"_5":14613,"_27884":58255,"_3010":55499},[],{"_3554":2649,"_30673":2626,"_21251":58316,"_5":14613,"_27884":58255,"_3010":58317},[],"Appropriate subject, SAN, usages and dates.",{"_3554":2650,"_30673":2626,"_21251":58319,"_5":14613,"_27884":58255,"_3010":58320},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3554":2651,"_30673":2626,"_21251":58322,"_5":14613,"_27884":58255,"_3010":58323},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3554":2652,"_30673":2626,"_21251":58325,"_5":14613,"_27884":58255,"_3010":58326},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3554":2653,"_30673":2626,"_21251":58328,"_5":14613,"_27884":58259,"_3010":58329},[],"Check each boundary independently:",{"_3554":2654,"_30673":2626,"_21251":58331,"_5":14613,"_27884":58259,"_3010":58332},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3554":2655,"_30673":2626,"_21251":58334,"_5":14613,"_27884":58259,"_3010":58335},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3554":2656,"_30673":2626,"_21251":58337,"_5":14613,"_27884":58259,"_3010":58338},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3554":2657,"_30673":2626,"_21251":58340,"_5":14613,"_27884":58259,"_3010":58341},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3554":2658,"_30673":2626,"_21251":58343,"_5":14613,"_27884":58259,"_3010":58344},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3554":2659,"_30673":2626,"_21251":58346,"_5":14613,"_27884":58259,"_3010":58347},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3554":2660,"_30673":2626,"_21251":58349,"_5":14613,"_27884":58263,"_3010":58350},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3554":2661,"_30673":2626,"_21251":58352,"_5":14613,"_27884":58263,"_3010":58353},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3554":2662,"_30673":2662,"_5":14965,"_3010":58355,"_31032":58356,"_21251":58357,"_27884":2662},"Security",[50083],[],{"_3554":2663,"_30673":2662,"_21251":58359,"_5":14613,"_27884":2662,"_3010":58360},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3554":2664,"_30673":2662,"_5":31029,"_21251":58362,"_27884":58363,"_3010":58364},[],"/docs/pr-preview/pr-69/security#report-a-vulnerability","Report a vulnerability",{"_3554":2665,"_30673":2662,"_5":31029,"_21251":58366,"_27884":58367,"_3010":58368},[],"/docs/pr-preview/pr-69/security#what-to-include-in-a-report","What to include in a report",{"_3554":2666,"_30673":2662,"_5":31029,"_21251":58370,"_27884":58371,"_3010":58372},[],"/docs/pr-preview/pr-69/security#supported-versions","Supported versions",{"_3554":2667,"_30673":2662,"_5":31029,"_21251":58374,"_27884":58375,"_3010":58376},[],"/docs/pr-preview/pr-69/security#responsible-disclosure","Responsible disclosure",{"_3554":2668,"_30673":2662,"_21251":58378,"_5":14613,"_27884":2662,"_3010":58379},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3554":2669,"_30673":2662,"_21251":58381,"_5":14613,"_27884":58363,"_3010":58382},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3554":2670,"_30673":2662,"_21251":58384,"_5":14613,"_27884":58363,"_3010":58385},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3554":2671,"_30673":2662,"_21251":58387,"_5":14613,"_27884":58363,"_3010":15232},[],{"_3554":2672,"_30673":2662,"_21251":58389,"_5":14613,"_27884":58363,"_3010":15172},[],{"_3554":2673,"_30673":2662,"_21251":58391,"_5":14613,"_27884":58363,"_3010":15219},[],{"_3554":2674,"_30673":2662,"_21251":58393,"_5":14613,"_27884":58363,"_3010":58394},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3554":2675,"_30673":2662,"_21251":58396,"_5":14613,"_27884":58363,"_3010":58397},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3554":2676,"_30673":2662,"_21251":58399,"_5":14613,"_27884":58367,"_3010":58400},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3554":2677,"_30673":2662,"_21251":58402,"_5":14613,"_27884":58367,"_3010":58403},[],"Do not include in the report:",{"_3554":2678,"_30673":2662,"_21251":58405,"_5":14613,"_27884":58367,"_3010":58406},[],"Credentials, tokens, or private keys",{"_3554":2679,"_30673":2662,"_21251":58408,"_5":14613,"_27884":58367,"_3010":58409},[],"Customer data or customer-identifiable information",{"_3554":2680,"_30673":2662,"_21251":58411,"_5":14613,"_27884":58367,"_3010":58412},[],"Confidential architecture or internal infrastructure details",{"_3554":2681,"_30673":2662,"_21251":58414,"_5":14613,"_27884":58371,"_3010":58415},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3554":2682,"_30673":2662,"_21251":58417,"_5":14613,"_27884":58371,"_3010":58418},[],"For upgrade guidance, see Upgrades.",{"_3554":2683,"_30673":2662,"_21251":58420,"_5":14613,"_27884":58375,"_3010":58421},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3554":2684,"_30673":2662,"_21251":58423,"_5":14613,"_27884":58375,"_3010":58424},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3554":2685,"_30673":2662,"_21251":58426,"_5":14613,"_27884":58375,"_3010":58427},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3554":2686,"_30673":2662,"_21251":58429,"_5":14613,"_27884":58375,"_3010":58430},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3554":2687,"_30673":2662,"_21251":58432,"_5":14613,"_27884":58375,"_3010":58433},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3554":2688,"_30673":2688,"_5":14965,"_3010":58435,"_31032":58436,"_21251":58438,"_27884":2688},"3.8.0 to 4.0.0",[50083,58437],"Upgrades",[],{"_3554":2689,"_30673":2688,"_21251":58440,"_5":14613,"_27884":2688,"_3010":58441},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3554":2690,"_30673":2688,"_5":31029,"_21251":58443,"_27884":58444,"_3010":58445},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3554":2691,"_30673":2688,"_5":31029,"_21251":58447,"_27884":58448,"_3010":58449},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3554":2692,"_30673":2688,"_5":31029,"_21251":58451,"_27884":58452,"_3010":58453},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3554":2693,"_30673":2688,"_5":31029,"_21251":58455,"_27884":58456,"_3010":58457},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3554":2694,"_30673":2688,"_5":31029,"_21251":58459,"_27884":58460,"_3010":58461},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3554":2695,"_30673":2688,"_5":31029,"_21251":58463,"_27884":58464,"_3010":58465},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3554":2696,"_30673":2688,"_5":31029,"_21251":58467,"_27884":58468,"_3010":58469},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3554":2697,"_30673":2688,"_5":31029,"_21251":58471,"_27884":58472,"_3010":58473},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3554":2698,"_30673":2688,"_5":31029,"_21251":58475,"_27884":58476,"_3010":58477},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3554":2699,"_30673":2688,"_5":31029,"_21251":58479,"_27884":58480,"_3010":58481},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3554":2700,"_30673":2688,"_5":31029,"_21251":58483,"_27884":58484,"_3010":58485},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3554":2701,"_30673":2688,"_5":31029,"_21251":58487,"_27884":58488,"_3010":58489},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3554":2702,"_30673":2688,"_5":31029,"_21251":58491,"_27884":58492,"_3010":58493},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3554":2703,"_30673":2688,"_5":31029,"_21251":58495,"_27884":58496,"_3010":58497},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3554":2704,"_30673":2688,"_5":31029,"_21251":58499,"_27884":58500,"_3010":58501},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3554":2705,"_30673":2688,"_5":31029,"_21251":58503,"_27884":58504,"_3010":58505},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3554":2706,"_30673":2688,"_5":31029,"_21251":58507,"_27884":58508,"_3010":58509},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3554":2707,"_30673":2688,"_5":31029,"_21251":58511,"_27884":58512,"_3010":58513},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3554":2708,"_30673":2688,"_5":31029,"_21251":58515,"_27884":58516,"_3010":58517},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3554":2709,"_30673":2688,"_5":31029,"_21251":58519,"_27884":58520,"_3010":58521},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3554":2710,"_30673":2688,"_5":31029,"_21251":58523,"_27884":58524,"_3010":58525},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3554":2711,"_30673":2688,"_5":31029,"_21251":58527,"_27884":58528,"_3010":58529},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3554":2712,"_30673":2688,"_5":31029,"_21251":58531,"_27884":58532,"_3010":58533},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3554":2713,"_30673":2688,"_5":31029,"_21251":58535,"_27884":58536,"_3010":58537},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3554":2714,"_30673":2688,"_5":31029,"_21251":58539,"_27884":58540,"_3010":58541},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3554":2715,"_30673":2688,"_5":31029,"_21251":58543,"_27884":58544,"_3010":58545},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3554":2716,"_30673":2688,"_5":31029,"_21251":58547,"_27884":58548,"_3010":58549},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3554":2717,"_30673":2688,"_5":31029,"_21251":58551,"_27884":58552,"_3010":58553},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3554":2718,"_30673":2688,"_5":31029,"_21251":58555,"_27884":58556,"_3010":58557},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3554":2719,"_30673":2688,"_5":31029,"_21251":58559,"_27884":58560,"_3010":58561},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3554":2720,"_30673":2688,"_5":31029,"_21251":58563,"_27884":58564,"_3010":58565},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3554":2721,"_30673":2688,"_5":31029,"_21251":58567,"_27884":58568,"_3010":58569},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3554":2722,"_30673":2688,"_5":31029,"_21251":58571,"_27884":58572,"_3010":58573},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3554":2723,"_30673":2688,"_5":31029,"_21251":58575,"_27884":58576,"_3010":58577},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3554":2724,"_30673":2688,"_5":31029,"_21251":58579,"_27884":58580,"_3010":58581},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3554":2725,"_30673":2688,"_5":31029,"_21251":58583,"_27884":58584,"_3010":58585},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3554":2726,"_30673":2688,"_5":31029,"_21251":58587,"_27884":58588,"_3010":58589},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3554":2727,"_30673":2688,"_5":31029,"_21251":58591,"_27884":58592,"_3010":58593},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3554":2728,"_30673":2688,"_5":31029,"_21251":58595,"_27884":58596,"_3010":58597},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3554":2729,"_30673":2688,"_5":31029,"_21251":58599,"_27884":58600,"_3010":58601},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3554":2730,"_30673":2688,"_5":31029,"_21251":58603,"_27884":58604,"_3010":54296},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3554":2731,"_30673":2688,"_5":31029,"_21251":58606,"_27884":58607,"_3010":58608},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3554":2732,"_30673":2688,"_5":31029,"_21251":58610,"_27884":58611,"_3010":58612},[],"/docs/pr-preview/pr-69/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3554":2733,"_30673":2688,"_21251":58614,"_5":14613,"_27884":2688,"_3010":58615},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3554":2734,"_30673":2688,"_21251":58617,"_5":14613,"_27884":2688,"_3010":58618},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3554":2735,"_30673":2688,"_21251":58620,"_5":14613,"_27884":2688,"_3010":58621},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3554":2736,"_30673":2688,"_21251":58623,"_5":14613,"_27884":2688,"_3010":58624},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3554":2737,"_30673":2688,"_21251":58626,"_5":14613,"_27884":2688,"_3010":58627},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3554":2738,"_30673":2688,"_21251":58629,"_5":14613,"_27884":2688,"_3010":58630},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3554":2739,"_30673":2688,"_21251":58632,"_5":14613,"_27884":2688,"_3010":58633},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3554":2740,"_30673":2688,"_21251":58635,"_5":14613,"_27884":58448,"_3010":58636},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3554":2741,"_30673":2688,"_21251":58638,"_5":14613,"_27884":58448,"_3010":58639},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3554":2742,"_30673":2688,"_21251":58641,"_5":14613,"_27884":58452,"_3010":58642},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3554":2743,"_30673":2688,"_21251":58644,"_5":14613,"_27884":58452,"_3010":58645},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3554":2744,"_30673":2688,"_21251":58647,"_5":14613,"_27884":58456,"_3010":58648},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3554":2745,"_30673":2688,"_21251":58650,"_5":14613,"_27884":58460,"_3010":58651},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3554":2746,"_30673":2688,"_21251":58653,"_5":14613,"_27884":58460,"_3010":58654},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3554":2747,"_30673":2688,"_21251":58656,"_5":14613,"_27884":58460,"_3010":58657},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3554":2748,"_30673":2688,"_21251":58659,"_5":14613,"_27884":58460,"_3010":58660},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3554":2749,"_30673":2688,"_21251":58662,"_5":14613,"_27884":58460,"_3010":58663},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3554":2750,"_30673":2688,"_21251":58665,"_5":14613,"_27884":58464,"_3010":58666},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3554":2751,"_30673":2688,"_21251":58668,"_5":14613,"_27884":58464,"_3010":58669},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3554":2752,"_30673":2688,"_21251":58671,"_5":14613,"_27884":58464,"_3010":58672},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3554":2753,"_30673":2688,"_21251":58674,"_5":14613,"_27884":58464,"_3010":58675},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3554":2754,"_30673":2688,"_21251":58677,"_5":14613,"_27884":58464,"_3010":58678},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3554":2755,"_30673":2688,"_21251":58680,"_5":14613,"_27884":58464,"_3010":58681},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3554":2756,"_30673":2688,"_21251":58683,"_5":14613,"_27884":58468,"_3010":58684},[],"Change",{"_3554":2757,"_30673":2688,"_21251":58686,"_5":14613,"_27884":58468,"_3010":58687},[],"Who is affected",{"_3554":2758,"_30673":2688,"_21251":58689,"_5":14613,"_27884":58468,"_3010":58690},[],"Severity",{"_3554":2759,"_30673":2688,"_21251":58692,"_5":14613,"_27884":58468,"_3010":57160},[],{"_3554":2760,"_30673":2688,"_21251":58694,"_5":14613,"_27884":58468,"_3010":58477},[],{"_3554":2761,"_30673":2688,"_21251":58696,"_5":14613,"_27884":58468,"_3010":58697},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3554":2762,"_30673":2688,"_21251":58699,"_5":14613,"_27884":58468,"_3010":58700},[],"High: KMS and VA start on empty volumes",{"_3554":2763,"_30673":2688,"_21251":58702,"_5":14613,"_27884":58468,"_3010":58703},[],"Copy the data into the new volumes",{"_3554":2764,"_30673":2688,"_21251":58705,"_5":14613,"_27884":58468,"_3010":58481},[],{"_3554":2765,"_30673":2688,"_21251":58707,"_5":14613,"_27884":58468,"_3010":58708},[],"Every Helm release",{"_3554":2766,"_30673":2688,"_21251":58710,"_5":14613,"_27884":58468,"_3010":58711},[],"High: `helm upgrade` fails",{"_3554":2767,"_30673":2688,"_21251":58713,"_5":14613,"_27884":58468,"_3010":58714},[],"Remove or rename legacy keys",{"_3554":2768,"_30673":2688,"_21251":58716,"_5":14613,"_27884":58468,"_3010":58485},[],{"_3554":2769,"_30673":2688,"_21251":58718,"_5":14613,"_27884":58468,"_3010":58719},[],"Every deployment",{"_3554":2770,"_30673":2688,"_21251":58721,"_5":14613,"_27884":58468,"_3010":58722},[],"High: without a bootstrap principal there is no administrator",{"_3554":2771,"_30673":2688,"_21251":58724,"_5":14613,"_27884":58468,"_3010":58725},[],"Configure `services.authz`",{"_3554":2772,"_30673":2688,"_21251":58727,"_5":14613,"_27884":58468,"_3010":58489},[],{"_3554":2773,"_30673":2688,"_21251":58729,"_5":14613,"_27884":58468,"_3010":58708},[],{"_3554":2774,"_30673":2688,"_21251":58731,"_5":14613,"_27884":58468,"_3010":58732},[],"High: `helm upgrade` fails on the old keys",{"_3554":2775,"_30673":2688,"_21251":58734,"_5":14613,"_27884":58468,"_3010":58735},[],"Move JWKS and roles into `services.authz`",{"_3554":2776,"_30673":2688,"_21251":58737,"_5":14613,"_27884":58468,"_3010":58509},[],{"_3554":2777,"_30673":2688,"_21251":58739,"_5":14613,"_27884":58468,"_3010":58740},[],"3.8.0 deployments with per-service databases",{"_3554":2778,"_30673":2688,"_21251":58742,"_5":14613,"_27884":58468,"_3010":58743},[],"High: services find no data, or a migration aborts",{"_3554":2779,"_30673":2688,"_21251":58745,"_5":14613,"_27884":58468,"_3010":58746},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3554":2780,"_30673":2688,"_21251":58748,"_5":14613,"_27884":58468,"_3010":58513},[],{"_3554":2781,"_30673":2688,"_21251":58750,"_5":14613,"_27884":58468,"_3010":58751},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3554":2782,"_30673":2688,"_21251":58753,"_5":14613,"_27884":58468,"_3010":58754},[],"High: the backend no longer starts with them",{"_3554":2783,"_30673":2688,"_21251":58756,"_5":14613,"_27884":58468,"_3010":58757},[],"Move to PostgreSQL before upgrading",{"_3554":2784,"_30673":2688,"_21251":58759,"_5":14613,"_27884":58468,"_3010":58557},[],{"_3554":2785,"_30673":2688,"_21251":58761,"_5":14613,"_27884":58468,"_3010":58762},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3554":2786,"_30673":2688,"_21251":58764,"_5":14613,"_27884":58468,"_3010":58765},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3554":2787,"_30673":2688,"_21251":58767,"_5":14613,"_27884":58468,"_3010":58768},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3554":2788,"_30673":2688,"_21251":58770,"_5":14613,"_27884":58468,"_3010":58771},[],"Webhooks with file references",{"_3554":2789,"_30673":2688,"_21251":58773,"_5":14613,"_27884":58468,"_3010":58774},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3554":2790,"_30673":2688,"_21251":58776,"_5":14613,"_27884":58468,"_3010":58777},[],"High: enrollments calling the webhook fail",{"_3554":2791,"_30673":2688,"_21251":58779,"_5":14613,"_27884":58468,"_3010":58780},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3554":2792,"_30673":2688,"_21251":58782,"_5":14613,"_27884":58468,"_3010":58493},[],{"_3554":2793,"_30673":2688,"_21251":58784,"_5":14613,"_27884":58468,"_3010":58785},[],"Releases with per-service identity overrides or mounted key material",{"_3554":2794,"_30673":2688,"_21251":58787,"_5":14613,"_27884":58468,"_3010":58788},[],"Medium: services cannot read their files",{"_3554":2795,"_30673":2688,"_21251":58790,"_5":14613,"_27884":58468,"_3010":58791},[],"Remove the overrides and fix volume ownership",{"_3554":2796,"_30673":2688,"_21251":58793,"_5":14613,"_27884":58468,"_3010":58497},[],{"_3554":2797,"_30673":2688,"_21251":58795,"_5":14613,"_27884":58468,"_3010":58796},[],"Releases that set `amqp.tls`",{"_3554":2798,"_30673":2688,"_21251":58798,"_5":14613,"_27884":58468,"_3010":58799},[],"Medium: clients connect to the wrong port",{"_3554":2799,"_30673":2688,"_21251":58801,"_5":14613,"_27884":58468,"_3010":58802},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3554":2800,"_30673":2688,"_21251":58804,"_5":14613,"_27884":58468,"_3010":58517},[],{"_3554":2801,"_30673":2688,"_21251":58806,"_5":14613,"_27884":58468,"_3010":58807},[],"Installations whose CA keys predate the KMS",{"_3554":2802,"_30673":2688,"_21251":58809,"_5":14613,"_27884":58468,"_3010":58810},[],"Medium: CA keys stay unmanaged",{"_3554":2803,"_30673":2688,"_21251":58812,"_5":14613,"_27884":58468,"_3010":58813},[],"Run the CA-to-KMS migration",{"_3554":2804,"_30673":2688,"_21251":58815,"_5":14613,"_27884":58468,"_3010":58816},[],"Receiver certificate verification",{"_3554":2805,"_30673":2688,"_21251":58818,"_5":14613,"_27884":58468,"_3010":58819},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3554":2806,"_30673":2688,"_21251":58821,"_5":14613,"_27884":58468,"_3010":58822},[],"Medium: credentials go to an unverified receiver",{"_3554":2807,"_30673":2688,"_21251":58824,"_5":14613,"_27884":58468,"_3010":58825},[],"Set `insecure_skip_verify` to `false`",{"_3554":2808,"_30673":2688,"_21251":58827,"_5":14613,"_27884":58468,"_3010":58533},[],{"_3554":2809,"_30673":2688,"_21251":58829,"_5":14613,"_27884":58468,"_3010":58830},[],"Scripts and consoles that edit DMSs through the API",{"_3554":2810,"_30673":2688,"_21251":58832,"_5":14613,"_27884":58468,"_3010":58833},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3554":2811,"_30673":2688,"_21251":58835,"_5":14613,"_27884":58468,"_3010":58836},[],"Read the DMS before editing and use the new field",{"_3554":2812,"_30673":2688,"_21251":58838,"_5":14613,"_27884":58468,"_3010":58553},[],{"_3554":2813,"_30673":2688,"_21251":58840,"_5":14613,"_27884":58468,"_3010":58841},[],"Clients that create or update CRL settings through the API",{"_3554":2814,"_30673":2688,"_21251":58843,"_5":14613,"_27884":58468,"_3010":58844},[],"Medium: requests with the old field return an error",{"_3554":2815,"_30673":2688,"_21251":58846,"_5":14613,"_27884":58468,"_3010":58847},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3554":2816,"_30673":2688,"_21251":58849,"_5":14613,"_27884":58468,"_3010":58561},[],{"_3554":2817,"_30673":2688,"_21251":58851,"_5":14613,"_27884":58468,"_3010":58852},[],"Alert subscriptions and consumers of the VA events",{"_3554":2818,"_30673":2688,"_21251":58854,"_5":14613,"_27884":58468,"_3010":58855},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3554":2819,"_30673":2688,"_21251":58857,"_5":14613,"_27884":58468,"_3010":58858},[],"Review conditions filtering on the old event payload or subject",{"_3554":2820,"_30673":2688,"_21251":58860,"_5":14613,"_27884":58468,"_3010":58549},[],{"_3554":2821,"_30673":2688,"_21251":58862,"_5":14613,"_27884":58468,"_3010":58863},[],"Consumers that read the device `events` field",{"_3554":2822,"_30673":2688,"_21251":58865,"_5":14613,"_27884":58468,"_3010":58866},[],"Medium: the field disappears",{"_3554":2823,"_30673":2688,"_21251":58868,"_5":14613,"_27884":58468,"_3010":58869},[],"Use the new event endpoints",{"_3554":2824,"_30673":2688,"_21251":58871,"_5":14613,"_27884":58468,"_3010":58569},[],{"_3554":2825,"_30673":2688,"_21251":58873,"_5":14613,"_27884":58468,"_3010":58874},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3554":2826,"_30673":2688,"_21251":58876,"_5":14613,"_27884":58468,"_3010":58877},[],"Medium: the VA migration aborts",{"_3554":2827,"_30673":2688,"_21251":58879,"_5":14613,"_27884":58468,"_3010":58880},[],"Fix the affected roles before upgrading",{"_3554":2828,"_30673":2688,"_21251":58882,"_5":14613,"_27884":58468,"_3010":58501},[],{"_3554":2829,"_30673":2688,"_21251":58884,"_5":14613,"_27884":58468,"_3010":58885},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3554":2830,"_30673":2688,"_21251":58887,"_5":14613,"_27884":58468,"_3010":58888},[],"Low to medium: validation errors or changed defaults",{"_3554":2831,"_30673":2688,"_21251":58890,"_5":14613,"_27884":58468,"_3010":58891},[],"Update the values file",{"_3554":2832,"_30673":2688,"_21251":58893,"_5":14613,"_27884":58468,"_3010":58541},[],{"_3554":2833,"_30673":2688,"_21251":58895,"_5":14613,"_27884":58468,"_3010":58896},[],"Clients that send the DMS ID in the update body",{"_3554":2834,"_30673":2688,"_21251":58898,"_5":14613,"_27884":58468,"_3010":58899},[],"Low: the ID in the URL wins",{"_3554":2835,"_30673":2688,"_21251":58901,"_5":14613,"_27884":58468,"_3010":58902},[],"Send the ID in the URL",{"_3554":2836,"_30673":2688,"_21251":58904,"_5":14613,"_27884":58468,"_3010":58565},[],{"_3554":2837,"_30673":2688,"_21251":58906,"_5":14613,"_27884":58468,"_3010":58907},[],"Clients that send an `id` when creating or importing CAs",{"_3554":2838,"_30673":2688,"_21251":58909,"_5":14613,"_27884":58468,"_3010":58910},[],"Low: the ID in the body is ignored, and the field is removed",{"_3554":2839,"_30673":2688,"_21251":58912,"_5":14613,"_27884":58468,"_3010":58913},[],"Let the backend assign the ID and use the returned one",{"_3554":2840,"_30673":2688,"_21251":58915,"_5":14613,"_27884":58468,"_3010":58545},[],{"_3554":2841,"_30673":2688,"_21251":58917,"_5":14613,"_27884":58468,"_3010":58918},[],"Consumers that match on certificate `type`",{"_3554":2842,"_30673":2688,"_21251":58920,"_5":14613,"_27884":58468,"_3010":58921},[],"Low: two values are renamed",{"_3554":2843,"_30673":2688,"_21251":58923,"_5":14613,"_27884":58468,"_3010":58924},[],"Adapt consumers",{"_3554":2844,"_30673":2688,"_21251":58926,"_5":14613,"_27884":58468,"_3010":58537},[],{"_3554":2845,"_30673":2688,"_21251":58928,"_5":14613,"_27884":58468,"_3010":58929},[],"Any DMS",{"_3554":2846,"_30673":2688,"_21251":58931,"_5":14613,"_27884":58468,"_3010":58932},[],"Low: informational",{"_3554":2847,"_30673":2688,"_21251":58934,"_5":14613,"_27884":58468,"_3010":58935},[],"Read both blocks before editing",{"_3554":2848,"_30673":2688,"_21251":58937,"_5":14613,"_27884":58476,"_3010":58938},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3554":2849,"_30673":2688,"_21251":58940,"_5":14613,"_27884":58476,"_3010":58941},[],"Step 4 of the migration guide copies the data.",{"_3554":2850,"_30673":2688,"_21251":58943,"_5":14613,"_27884":58480,"_3010":58944},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3554":2851,"_30673":2688,"_21251":58946,"_5":14613,"_27884":58484,"_3010":58947},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3554":2852,"_30673":2688,"_21251":58949,"_5":14613,"_27884":58488,"_3010":58950},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3554":2853,"_30673":2688,"_21251":58952,"_5":14613,"_27884":58492,"_3010":58953},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3554":2854,"_30673":2688,"_21251":58955,"_5":14613,"_27884":58492,"_3010":58956},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3554":2855,"_30673":2688,"_21251":58958,"_5":14613,"_27884":58496,"_3010":58959},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3554":2856,"_30673":2688,"_21251":58961,"_5":14613,"_27884":58500,"_3010":58962},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3554":2857,"_30673":2688,"_21251":58964,"_5":14613,"_27884":58500,"_3010":58965},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3554":2858,"_30673":2688,"_21251":58967,"_5":14613,"_27884":58500,"_3010":58968},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3554":2859,"_30673":2688,"_21251":58970,"_5":14613,"_27884":58500,"_3010":58971},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3554":2860,"_30673":2688,"_21251":58973,"_5":14613,"_27884":58500,"_3010":58974},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3554":2861,"_30673":2688,"_21251":58976,"_5":14613,"_27884":58500,"_3010":58977},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3554":2862,"_30673":2688,"_21251":58979,"_5":14613,"_27884":58508,"_3010":58980},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3554":2863,"_30673":2688,"_21251":58982,"_5":14613,"_27884":58508,"_3010":58983},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3554":2864,"_30673":2688,"_21251":58985,"_5":14613,"_27884":58508,"_3010":58986},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3554":2865,"_30673":2688,"_21251":58988,"_5":14613,"_27884":58508,"_3010":58989},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3554":2866,"_30673":2688,"_21251":58991,"_5":14613,"_27884":58508,"_3010":58992},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3554":2867,"_30673":2688,"_21251":58994,"_5":14613,"_27884":58512,"_3010":58995},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3554":2868,"_30673":2688,"_21251":58997,"_5":14613,"_27884":58516,"_3010":58998},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3554":2869,"_30673":2688,"_21251":59000,"_5":14613,"_27884":58516,"_3010":59001},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3554":2870,"_30673":2688,"_21251":59003,"_5":14613,"_27884":58516,"_3010":59004},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3554":2871,"_30673":2688,"_21251":59006,"_5":14613,"_27884":58516,"_3010":59007},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3554":2872,"_30673":2688,"_21251":59009,"_5":14613,"_27884":58516,"_3010":59010},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3554":2873,"_30673":2688,"_21251":59012,"_5":14613,"_27884":58516,"_3010":59013},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3554":2874,"_30673":2688,"_21251":59015,"_5":14613,"_27884":58516,"_3010":59016},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3554":2875,"_30673":2688,"_21251":59018,"_5":14613,"_27884":58516,"_3010":59019},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3554":2876,"_30673":2688,"_21251":59021,"_5":14613,"_27884":58520,"_3010":59022},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3554":2877,"_30673":2688,"_21251":59024,"_5":14613,"_27884":58528,"_3010":59025},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3554":2878,"_30673":2688,"_21251":59027,"_5":14613,"_27884":58528,"_3010":59028},[],"Field in 3.8.0",{"_3554":2879,"_30673":2688,"_21251":59030,"_5":14613,"_27884":58528,"_3010":59031},[],"Field in 4.0.0",{"_3554":2880,"_30673":2688,"_21251":59033,"_5":14613,"_27884":58528,"_3010":59034},[],"`validate_server_cert`",{"_3554":2881,"_30673":2688,"_21251":59036,"_5":14613,"_27884":58528,"_3010":59037},[],"`insecure_skip_verify` (value negated)",{"_3554":2882,"_30673":2688,"_21251":59039,"_5":14613,"_27884":58528,"_3010":59040},[],"`oidc`",{"_3554":2883,"_30673":2688,"_21251":59042,"_5":14613,"_27884":58528,"_3010":59043},[],"`jwt_options`",{"_3554":2884,"_30673":2688,"_21251":59045,"_5":14613,"_27884":58528,"_3010":59046},[],"`apikey`",{"_3554":2885,"_30673":2688,"_21251":59048,"_5":14613,"_27884":58528,"_3010":59049},[],"`apikey_options`",{"_3554":2886,"_30673":2688,"_21251":59051,"_5":14613,"_27884":58528,"_3010":59052},[],"`mtls`",{"_3554":2887,"_30673":2688,"_21251":59054,"_5":14613,"_27884":58528,"_3010":59055},[],"`mtls_options`",{"_3554":2888,"_30673":2688,"_21251":59057,"_5":14613,"_27884":58528,"_3010":59058},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3554":2889,"_30673":2688,"_21251":59060,"_5":14613,"_27884":58528,"_3010":59061},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3554":2890,"_30673":2688,"_21251":59063,"_5":14613,"_27884":58528,"_3010":59064},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3554":2891,"_30673":2688,"_21251":59066,"_5":14613,"_27884":58532,"_3010":59067},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3554":2892,"_30673":2688,"_21251":59069,"_5":14613,"_27884":58532,"_3010":59070},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3554":2893,"_30673":2688,"_21251":59072,"_5":14613,"_27884":58532,"_3010":59073},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3554":2894,"_30673":2688,"_21251":59075,"_5":14613,"_27884":58536,"_3010":59076},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3554":2895,"_30673":2688,"_21251":59078,"_5":14613,"_27884":58540,"_3010":59079},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3554":2896,"_30673":2688,"_21251":59081,"_5":14613,"_27884":58544,"_3010":59082},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3554":2897,"_30673":2688,"_21251":59084,"_5":14613,"_27884":58548,"_3010":59085},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3554":2898,"_30673":2688,"_21251":59087,"_5":14613,"_27884":58548,"_3010":59088},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3554":2899,"_30673":2688,"_21251":59090,"_5":14613,"_27884":58548,"_3010":59091},[],"`POST /v1/devices/:id/events` creates an event.",{"_3554":2900,"_30673":2688,"_21251":59093,"_5":14613,"_27884":58548,"_3010":59094},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3554":2901,"_30673":2688,"_21251":59096,"_5":14613,"_27884":58552,"_3010":59097},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3554":2902,"_30673":2688,"_21251":59099,"_5":14613,"_27884":58556,"_3010":59100},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3554":2903,"_30673":2688,"_21251":59102,"_5":14613,"_27884":58556,"_3010":59103},[],"Route",{"_3554":2904,"_30673":2688,"_21251":59105,"_5":14613,"_27884":58556,"_3010":53483},[],{"_3554":2905,"_30673":2688,"_21251":59107,"_5":14613,"_27884":58556,"_3010":59108},[],"`GET /v1/crl-settings`",{"_3554":2906,"_30673":2688,"_21251":59110,"_5":14613,"_27884":58556,"_3010":59111},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3554":2907,"_30673":2688,"_21251":59113,"_5":14613,"_27884":58556,"_3010":59114},[],"`GET /v1/crl-settings/{ca-id}`",{"_3554":2908,"_30673":2688,"_21251":59116,"_5":14613,"_27884":58556,"_3010":59117},[],"Reads the settings of a CA.",{"_3554":2909,"_30673":2688,"_21251":59119,"_5":14613,"_27884":58556,"_3010":59120},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3554":2910,"_30673":2688,"_21251":59122,"_5":14613,"_27884":58556,"_3010":59123},[],"Replaces `crl_options`.",{"_3554":2911,"_30673":2688,"_21251":59125,"_5":14613,"_27884":58556,"_3010":59126},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3554":2912,"_30673":2688,"_21251":59128,"_5":14613,"_27884":58556,"_3010":59129},[],"Removes the archived settings of a CA.",{"_3554":2913,"_30673":2688,"_21251":59131,"_5":14613,"_27884":58556,"_3010":59132},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3554":2914,"_30673":2688,"_21251":59134,"_5":14613,"_27884":58556,"_3010":59135},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3554":2915,"_30673":2688,"_21251":59137,"_5":14613,"_27884":58556,"_3010":59138},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3554":2916,"_30673":2688,"_21251":59140,"_5":14613,"_27884":58556,"_3010":59141},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3554":2917,"_30673":2688,"_21251":59143,"_5":14613,"_27884":58556,"_3010":59144},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3554":2918,"_30673":2688,"_21251":59146,"_5":14613,"_27884":58556,"_3010":59147},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3554":2919,"_30673":2688,"_21251":59149,"_5":14613,"_27884":58556,"_3010":59150},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3554":2920,"_30673":2688,"_21251":59152,"_5":14613,"_27884":58556,"_3010":59153},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3554":2921,"_30673":2688,"_21251":59155,"_5":14613,"_27884":58556,"_3010":59156},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3554":2922,"_30673":2688,"_21251":59158,"_5":14613,"_27884":58556,"_3010":59159},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3554":2923,"_30673":2688,"_21251":59161,"_5":14613,"_27884":58556,"_3010":59162},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3554":2924,"_30673":2688,"_21251":59164,"_5":14613,"_27884":58560,"_3010":59165},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3554":2925,"_30673":2688,"_21251":59167,"_5":14613,"_27884":58564,"_3010":59168},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3554":2926,"_30673":2688,"_21251":59170,"_5":14613,"_27884":58568,"_3010":59171},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3554":2927,"_30673":2688,"_21251":59173,"_5":14613,"_27884":58572,"_3010":59174},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3554":2928,"_30673":2688,"_21251":59176,"_5":14613,"_27884":58576,"_3010":59177},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3554":2929,"_30673":2688,"_21251":59179,"_5":14613,"_27884":58576,"_3010":59180},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3554":2930,"_30673":2688,"_21251":59182,"_5":14613,"_27884":58576,"_3010":59183},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3554":2931,"_30673":2688,"_21251":59185,"_5":14613,"_27884":58576,"_3010":59186},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3554":2932,"_30673":2688,"_21251":59188,"_5":14613,"_27884":58576,"_3010":59189},[],"Record the names of your local-storage PVCs:",{"_3554":2933,"_30673":2688,"_21251":59191,"_5":14613,"_27884":58576,"_3010":59192},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3554":2934,"_30673":2688,"_21251":59194,"_5":14613,"_27884":58580,"_3010":59195},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3554":2935,"_30673":2688,"_21251":59197,"_5":14613,"_27884":58580,"_3010":59198},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3554":2936,"_30673":2688,"_21251":59200,"_5":14613,"_27884":58580,"_3010":59201},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3554":2937,"_30673":2688,"_21251":59203,"_5":14613,"_27884":58580,"_3010":59204},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3554":2938,"_30673":2688,"_21251":59206,"_5":14613,"_27884":58580,"_3010":59207},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3554":2939,"_30673":2688,"_21251":59209,"_5":14613,"_27884":58584,"_3010":59210},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3554":2940,"_30673":2688,"_21251":59212,"_5":14613,"_27884":58584,"_3010":59213},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3554":2941,"_30673":2688,"_21251":59215,"_5":14613,"_27884":58584,"_3010":59216},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3554":2942,"_30673":2688,"_21251":59218,"_5":14613,"_27884":58584,"_3010":59219},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3554":2943,"_30673":2688,"_21251":59221,"_5":14613,"_27884":58584,"_3010":59222},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3554":2944,"_30673":2688,"_21251":59224,"_5":14613,"_27884":58584,"_3010":59225},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3554":2945,"_30673":2688,"_21251":59227,"_5":14613,"_27884":58584,"_3010":59228},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3554":2946,"_30673":2688,"_21251":59230,"_5":14613,"_27884":58584,"_3010":59231},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3554":2947,"_30673":2688,"_21251":59233,"_5":14613,"_27884":58584,"_3010":59234},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3554":2948,"_30673":2688,"_21251":59236,"_5":14613,"_27884":58584,"_3010":59237},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3554":2949,"_30673":2688,"_21251":59239,"_5":14613,"_27884":58584,"_3010":59240},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3554":2950,"_30673":2688,"_21251":59242,"_5":14613,"_27884":58584,"_3010":59243},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3554":2951,"_30673":2688,"_21251":59245,"_5":14613,"_27884":58588,"_3010":59246},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3554":2952,"_30673":2688,"_21251":59248,"_5":14613,"_27884":58588,"_3010":59249},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3554":2953,"_30673":2688,"_21251":59251,"_5":14613,"_27884":58592,"_3010":59252},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3554":2954,"_30673":2688,"_21251":59254,"_5":14613,"_27884":58592,"_3010":59255},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3554":2955,"_30673":2688,"_21251":59257,"_5":14613,"_27884":58592,"_3010":59258},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3554":2956,"_30673":2688,"_21251":59260,"_5":14613,"_27884":58592,"_3010":59261},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3554":2957,"_30673":2688,"_21251":59263,"_5":14613,"_27884":58592,"_3010":59264},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3554":2958,"_30673":2688,"_21251":59266,"_5":14613,"_27884":58592,"_3010":59267},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3554":2959,"_30673":2688,"_21251":59269,"_5":14613,"_27884":58592,"_3010":59270},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3554":2960,"_30673":2688,"_21251":59272,"_5":14613,"_27884":58592,"_3010":59273},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3554":2961,"_30673":2688,"_21251":59275,"_5":14613,"_27884":58592,"_3010":59276},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3554":2962,"_30673":2688,"_21251":59278,"_5":14613,"_27884":58592,"_3010":59279},[],"**Remove the helper and restore the recorded replica counts:**",{"_3554":2963,"_30673":2688,"_21251":59281,"_5":14613,"_27884":58592,"_3010":59282},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3554":2964,"_30673":2688,"_21251":59284,"_5":14613,"_27884":58596,"_3010":59285},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3554":2965,"_30673":2688,"_21251":59287,"_5":14613,"_27884":58596,"_3010":59288},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3554":2966,"_30673":2688,"_21251":59290,"_5":14613,"_27884":58600,"_3010":59291},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3554":2967,"_30673":2688,"_21251":59293,"_5":14613,"_27884":58600,"_3010":59294},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3554":2968,"_30673":2688,"_21251":59296,"_5":14613,"_27884":58600,"_3010":59297},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3554":2969,"_30673":2688,"_21251":59299,"_5":14613,"_27884":58600,"_3010":59300},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3554":2970,"_30673":2688,"_21251":59302,"_5":14613,"_27884":58600,"_3010":59303},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3554":2971,"_30673":2688,"_21251":59305,"_5":14613,"_27884":58600,"_3010":59306},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3554":2972,"_30673":2688,"_21251":59308,"_5":14613,"_27884":58600,"_3010":59309},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3554":2973,"_30673":2688,"_21251":59311,"_5":14613,"_27884":58600,"_3010":59312},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3554":2974,"_30673":2688,"_21251":59314,"_5":14613,"_27884":58604,"_3010":59315},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3554":2975,"_30673":2688,"_21251":59317,"_5":14613,"_27884":58604,"_3010":59318},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3554":2976,"_30673":2688,"_21251":59320,"_5":14613,"_27884":58604,"_3010":59321},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3554":2977,"_30673":2688,"_21251":59323,"_5":14613,"_27884":58604,"_3010":59324},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3554":2978,"_30673":2688,"_21251":59326,"_5":14613,"_27884":58604,"_3010":59327},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3554":2979,"_30673":2688,"_21251":59329,"_5":14613,"_27884":58604,"_3010":59330},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3554":2980,"_30673":2688,"_21251":59332,"_5":14613,"_27884":58604,"_3010":59333},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3554":2981,"_30673":2688,"_21251":59335,"_5":14613,"_27884":58604,"_3010":59336},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3554":2982,"_30673":2688,"_21251":59338,"_5":14613,"_27884":58604,"_3010":59339},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3554":2983,"_30673":2688,"_21251":59341,"_5":14613,"_27884":58604,"_3010":59342},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3554":2984,"_30673":2688,"_21251":59344,"_5":14613,"_27884":58604,"_3010":59345},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3554":2985,"_30673":2688,"_21251":59347,"_5":14613,"_27884":58607,"_3010":59348},[],"After the upgrade, check in this order:",{"_3554":2986,"_30673":2688,"_21251":59350,"_5":14613,"_27884":58607,"_3010":59351},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3554":2987,"_30673":2688,"_21251":59353,"_5":14613,"_27884":58607,"_3010":59354},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3554":2988,"_30673":2688,"_21251":59356,"_5":14613,"_27884":58607,"_3010":59357},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3554":2989,"_30673":2688,"_21251":59359,"_5":14613,"_27884":58607,"_3010":59360},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3554":2990,"_30673":2688,"_21251":59362,"_5":14613,"_27884":58607,"_3010":59363},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3554":2991,"_30673":2688,"_21251":59365,"_5":14613,"_27884":58607,"_3010":59366},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3554":2992,"_30673":2688,"_21251":59368,"_5":14613,"_27884":58607,"_3010":59369},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3554":2993,"_30673":2688,"_21251":59371,"_5":14613,"_27884":58607,"_3010":59372},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3554":2994,"_30673":2688,"_21251":59374,"_5":14613,"_27884":58607,"_3010":59375},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3554":2995,"_30673":2688,"_21251":59377,"_5":14613,"_27884":58607,"_3010":59378},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3554":2996,"_30673":2688,"_21251":59380,"_5":14613,"_27884":58607,"_3010":59381},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3554":2997,"_30673":2688,"_21251":59383,"_5":14613,"_27884":58607,"_3010":59384},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3554":2998,"_30673":2688,"_21251":59386,"_5":14613,"_27884":58607,"_3010":59387},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3554":2999,"_30673":2688,"_21251":59389,"_5":14613,"_27884":58607,"_3010":59390},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3554":3000,"_30673":2688,"_21251":59392,"_5":14613,"_27884":58607,"_3010":59393},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3554":3001,"_30673":2688,"_21251":59395,"_5":14613,"_27884":58611,"_3010":59396},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3554":3002,"_30673":2688,"_21251":59398,"_5":14613,"_27884":58611,"_3010":59399},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3554":3003,"_30673":2688,"_21251":59401,"_5":14613,"_27884":58611,"_3010":59402},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3554":3004,"_30673":2688,"_21251":59404,"_5":14613,"_27884":58611,"_3010":59405},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3554":3005,"_30673":2688,"_21251":59407,"_5":14613,"_27884":58611,"_3010":59408},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_59411":59412,"_59413":59414,"_59415":59416,"_59417":59418,"_18417":3045,"_71396":3045},"language","english","sortableProperties",[3010,30673,5,27884],"sortablePropertiesWithTypes",{"_3010":25376,"_30673":25376,"_5":25376,"_27884":25376},"sorts",{"_3010":59419,"_30673":62414,"_5":65408,"_27884":68402},{"_4745":59420,"_59421":59422,"_5":25376},{"_14689":8550,"_15064":7137,"_15083":7086,"_29671":6886,"_15070":5156,"_20170":6098,"_14710":12376,"_14717":20269,"_29613":6806,"_30027":7397,"_30048":4159,"_29647":7073,"_35056":3263,"_29750":7676,"_30092":5037,"_35063":4888,"_35066":16046,"_35069":16054,"_35072":4078,"_30499":8107,"_35077":4821,"_35079":7097,"_30529":5223,"_15079":3297,"_35083":11803,"_35086":7077,"_35088":6332,"_30076":6115,"_30494":23954,"_30542":5089,"_35093":3747,"_35095":6114,"_35097":7123,"_29767":3110,"_35100":20882,"_35102":6978,"_35104":6106,"_35106":3735,"_35108":3852,"_29684":4484,"_35111":17321,"_35113":4720,"_29678":7775,"_30113":7996,"_35117":7342,"_35119":6675,"_35122":6506,"_29724":14484,"_35126":6427,"_29604":18449,"_35129":14546,"_29652":3223,"_35132":5528,"_35134":5268,"_35137":6358,"_15073":7719,"_35140":29889,"_35142":7818,"_35145":8220,"_35147":5947,"_35149":13625,"_35151":18281,"_35153":6641,"_20173":12685,"_35156":4712,"_35158":6071,"_29625":4161,"_30070":5326,"_30738":11525,"_35163":3261,"_35165":12515,"_30559":6693,"_35168":3312,"_35170":4691,"_35172":9802,"_30653":12257,"_30129":6107,"_35176":7728,"_35178":5232,"_29662":3106,"_35181":9763,"_35183":7797,"_35185":3796,"_30575":4819,"_29744":17556,"_29129":7179,"_35190":8744,"_35192":25756,"_35194":4467,"_29793":3344,"_35198":25386,"_30064":3795,"_35202":7101,"_35204":4407,"_35206":6279,"_35208":3456,"_35210":7755,"_35212":3281,"_29782":5047,"_30032":9114,"_35216":3817,"_35218":4945,"_35220":16020,"_352