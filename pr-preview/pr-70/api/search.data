28057,"_41176":128060,"_41178":128063,"_41180":128066,"_41182":128069,"_41184":128072,"_41186":128075,"_41188":128078,"_41190":128081,"_41192":128084,"_41194":128087,"_41196":128090,"_41198":128093,"_41200":128096,"_41202":128099,"_41204":128102,"_41206":128105,"_41208":128108,"_41210":128111,"_41212":128114,"_41214":128117,"_41216":128120,"_41218":128123,"_41220":128126,"_41222":128129,"_41225":128132,"_41227":128135,"_41229":128138},{"_3587":71928,"_30795":71928,"_5":15024,"_3043":118959,"_31154":118960,"_21329":118963,"_27997":71928},"Despliega desde AWS Marketplace",[50381,118961,118962],"Despliegue","Otros modelos",[],{"_3587":71929,"_30795":71928,"_21329":118965,"_5":14664,"_27997":71928,"_3043":118966},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3587":71930,"_30795":71928,"_5":31151,"_21329":118968,"_27997":118969,"_3043":118970},[],"/docs/pr-preview/pr-70/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3587":71931,"_30795":71928,"_5":31151,"_21329":118972,"_27997":118973,"_3043":118974},[],"/docs/pr-preview/pr-70/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3587":71932,"_30795":71928,"_5":31151,"_21329":118976,"_27997":118977,"_3043":118978},[],"/docs/pr-preview/pr-70/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3587":71933,"_30795":71928,"_5":31151,"_21329":118980,"_27997":118981,"_3043":118982},[],"/docs/pr-preview/pr-70/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3587":71934,"_30795":71928,"_5":31151,"_21329":118984,"_27997":118985,"_3043":118986},[],"/docs/pr-preview/pr-70/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3587":71935,"_30795":71928,"_5":31151,"_21329":118988,"_27997":118989,"_3043":118990},[],"/docs/pr-preview/pr-70/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3587":71936,"_30795":71928,"_5":31151,"_21329":118992,"_27997":118993,"_3043":118994},[],"/docs/pr-preview/pr-70/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3587":71937,"_30795":71928,"_21329":118996,"_5":14664,"_27997":71928,"_3043":118997},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3587":71938,"_30795":71928,"_21329":118999,"_5":14664,"_27997":118969,"_3043":119000},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3587":71939,"_30795":71928,"_21329":119002,"_5":14664,"_27997":118969,"_3043":119003},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3587":71940,"_30795":71928,"_21329":119005,"_5":14664,"_27997":118969,"_3043":119006},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3587":71941,"_30795":71928,"_21329":119008,"_5":14664,"_27997":118973,"_3043":119009},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3587":71942,"_30795":71928,"_21329":119011,"_5":14664,"_27997":118973,"_3043":119012},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3587":71943,"_30795":71928,"_21329":119014,"_5":14664,"_27997":118973,"_3043":119015},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3587":71944,"_30795":71928,"_21329":119017,"_5":14664,"_27997":118977,"_3043":119018},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3587":71945,"_30795":71928,"_21329":119020,"_5":14664,"_27997":118981,"_3043":119021},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3587":71946,"_30795":71928,"_21329":119023,"_5":14664,"_27997":118985,"_3043":119024},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3587":71947,"_30795":71928,"_21329":119026,"_5":14664,"_27997":118989,"_3043":119027},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3587":71948,"_30795":71928,"_21329":119029,"_5":14664,"_27997":118993,"_3043":119030},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3587":71949,"_30795":71949,"_5":15024,"_3043":119032,"_31154":119033,"_21329":119034,"_27997":71949},"Despliega Lamassu",[50381,118961],[],{"_3587":71950,"_30795":71949,"_21329":119036,"_5":14664,"_27997":71949,"_3043":119037},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3587":71951,"_30795":71949,"_5":31151,"_21329":119039,"_27997":119040,"_3043":119041},[],"/docs/pr-preview/pr-70/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3587":71952,"_30795":71949,"_5":31151,"_21329":119043,"_27997":119044,"_3043":119045},[],"/docs/pr-preview/pr-70/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3587":71953,"_30795":71949,"_5":31151,"_21329":119047,"_27997":119048,"_3043":119049},[],"/docs/pr-preview/pr-70/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3587":71954,"_30795":71949,"_21329":119051,"_5":14664,"_27997":71949,"_3043":119052},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3587":71955,"_30795":71949,"_21329":119054,"_5":14664,"_27997":119040,"_3043":119055},[],"Modelo",{"_3587":71956,"_30795":71949,"_21329":119057,"_5":14664,"_27997":119040,"_3043":119058},[],"Recomendado para",{"_3587":71957,"_30795":71949,"_21329":119060,"_5":14664,"_27997":119040,"_3043":119061},[],"Quién opera la infraestructura",{"_3587":71958,"_30795":71949,"_21329":119063,"_5":14664,"_27997":119040,"_3043":119064},[],"Punto de partida",{"_3587":71959,"_30795":71949,"_21329":119066,"_5":14664,"_27997":119040,"_3043":50488},[],{"_3587":71960,"_30795":71949,"_21329":119068,"_5":14664,"_27997":119040,"_3043":119069},[],"Producción, entornos regulados y despliegues personalizados",{"_3587":71961,"_30795":71949,"_21329":119071,"_5":14664,"_27997":119040,"_3043":119072},[],"Tu equipo",{"_3587":71962,"_30795":71949,"_21329":119074,"_5":14664,"_27997":119040,"_3043":119075},[],"Helm o Fastlane",{"_3587":71963,"_30795":71949,"_21329":119077,"_5":14664,"_27997":119040,"_3043":50500},[],{"_3587":71964,"_30795":71949,"_21329":119079,"_5":14664,"_27997":119040,"_3043":119080},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3587":71965,"_30795":71949,"_21329":119082,"_5":14664,"_27997":119040,"_3043":119072},[],{"_3587":71966,"_30795":71949,"_21329":119084,"_5":14664,"_27997":119040,"_3043":119085},[],"Imagen preconfigurada en EC2",{"_3587":71967,"_30795":71949,"_21329":119087,"_5":14664,"_27997":119040,"_3043":50511},[],{"_3587":71968,"_30795":71949,"_21329":119089,"_5":14664,"_27997":119040,"_3043":119090},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3587":71969,"_30795":71949,"_21329":119092,"_5":14664,"_27997":119040,"_3043":50517},[],{"_3587":71970,"_30795":71949,"_21329":119094,"_5":14664,"_27997":119040,"_3043":119095},[],"Suscripción gestionada",{"_3587":71971,"_30795":71949,"_21329":119097,"_5":14664,"_27997":119040,"_3043":119098},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3587":71972,"_30795":71949,"_21329":119100,"_5":14664,"_27997":119040,"_3043":119101},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3587":71973,"_30795":71949,"_21329":119103,"_5":14664,"_27997":119040,"_3043":119104},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3587":71974,"_30795":71949,"_21329":119106,"_5":14664,"_27997":119044,"_3043":119107},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3587":71975,"_30795":71949,"_21329":119109,"_5":14664,"_27997":119048,"_3043":119110},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3587":71976,"_30795":71976,"_5":15024,"_3043":119112,"_31154":119113,"_21329":119114,"_27997":71976},"Utiliza Lamassu como SaaS",[50381,118961,118962],[],{"_3587":71977,"_30795":71976,"_21329":119116,"_5":14664,"_27997":71976,"_3043":119117},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3587":71978,"_30795":71976,"_5":31151,"_21329":119119,"_27997":119120,"_3043":119121},[],"/docs/pr-preview/pr-70/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3587":71979,"_30795":71976,"_5":31151,"_21329":119123,"_27997":119124,"_3043":119125},[],"/docs/pr-preview/pr-70/es/deployment/saas#planes","Planes",{"_3587":71980,"_30795":71976,"_5":31151,"_21329":119127,"_27997":119128,"_3043":119129},[],"/docs/pr-preview/pr-70/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3587":71981,"_30795":71976,"_21329":119131,"_5":14664,"_27997":71976,"_3043":119132},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3587":71982,"_30795":71976,"_21329":119134,"_5":14664,"_27997":119120,"_3043":119135},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3587":71983,"_30795":71976,"_21329":119137,"_5":14664,"_27997":119120,"_3043":119138},[],"Copias de seguridad automáticas.",{"_3587":71984,"_30795":71976,"_21329":119140,"_5":14664,"_27997":119120,"_3043":119141},[],"Actualizaciones de versión.",{"_3587":71985,"_30795":71976,"_21329":119143,"_5":14664,"_27997":119120,"_3043":119144},[],"Soporte técnico y SLA según el plan contratado.",{"_3587":71986,"_30795":71976,"_21329":119146,"_5":14664,"_27997":119124,"_3043":50572},[],{"_3587":71987,"_30795":71976,"_21329":119148,"_5":14664,"_27997":119124,"_3043":119149},[],"Dispositivos",{"_3587":71988,"_30795":71976,"_21329":119151,"_5":14664,"_27997":119124,"_3043":119152},[],"Soporte",{"_3587":71989,"_30795":71976,"_21329":119154,"_5":14664,"_27997":119124,"_3043":50581},[],{"_3587":71990,"_30795":71976,"_21329":119156,"_5":14664,"_27997":119124,"_3043":50584},[],{"_3587":71991,"_30795":71976,"_21329":119158,"_5":14664,"_27997":119124,"_3043":119159},[],"Hasta 1.000",{"_3587":71992,"_30795":71976,"_21329":119161,"_5":14664,"_27997":119124,"_3043":50590},[],{"_3587":71993,"_30795":71976,"_21329":119163,"_5":14664,"_27997":119124,"_3043":119164},[],"99,5 %",{"_3587":71994,"_30795":71976,"_21329":119166,"_5":14664,"_27997":119124,"_3043":50596},[],{"_3587":71995,"_30795":71976,"_21329":119168,"_5":14664,"_27997":119124,"_3043":119169},[],"Hasta 10.000",{"_3587":71996,"_30795":71976,"_21329":119171,"_5":14664,"_27997":119124,"_3043":119172},[],"Email y chat",{"_3587":71997,"_30795":71976,"_21329":119174,"_5":14664,"_27997":119124,"_3043":119175},[],"99,9 %",{"_3587":71998,"_30795":71976,"_21329":119177,"_5":14664,"_27997":119124,"_3043":50608},[],{"_3587":71999,"_30795":71976,"_21329":119179,"_5":14664,"_27997":119124,"_3043":119180},[],"Ilimitados",{"_3587":72000,"_30795":71976,"_21329":119182,"_5":14664,"_27997":119124,"_3043":119183},[],"Dedicado",{"_3587":72001,"_30795":71976,"_21329":119185,"_5":14664,"_27997":119124,"_3043":119186},[],"99,99 %",{"_3587":72002,"_30795":71976,"_21329":119188,"_5":14664,"_27997":119128,"_3043":119189},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3587":72003,"_30795":71976,"_21329":119191,"_5":14664,"_27997":119128,"_3043":119192},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3587":72004,"_30795":72004,"_5":15024,"_3043":50625,"_31154":119194,"_21329":119196,"_27997":72004},[50381,118961,119195],"Kubernetes autogestionado",[],{"_3587":72005,"_30795":72004,"_21329":119198,"_5":14664,"_27997":72004,"_3043":119199},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3587":72006,"_30795":72004,"_5":31151,"_21329":119201,"_27997":119202,"_3043":119203},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3587":72007,"_30795":72004,"_5":31151,"_21329":119205,"_27997":119206,"_3043":119207},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3587":72008,"_30795":72004,"_5":31151,"_21329":119209,"_27997":119210,"_3043":119211},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3587":72009,"_30795":72004,"_5":31151,"_21329":119213,"_27997":119214,"_3043":119215},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3587":72010,"_30795":72004,"_5":31151,"_21329":119217,"_27997":119218,"_3043":119219},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3587":72011,"_30795":72004,"_5":31151,"_21329":119221,"_27997":119222,"_3043":119223},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3587":72012,"_30795":72004,"_5":31151,"_21329":119225,"_27997":119226,"_3043":119227},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3587":72013,"_30795":72004,"_5":31151,"_21329":119229,"_27997":119230,"_3043":119231},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3587":72014,"_30795":72004,"_5":31151,"_21329":119233,"_27997":119234,"_3043":119235},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3587":72015,"_30795":72004,"_5":31151,"_21329":119237,"_27997":119238,"_3043":119239},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3587":72016,"_30795":72004,"_5":31151,"_21329":119241,"_27997":119242,"_3043":119243},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3587":72017,"_30795":72004,"_21329":119245,"_5":14664,"_27997":119202,"_3043":119246},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3587":72018,"_30795":72004,"_21329":119248,"_5":14664,"_27997":119202,"_3043":119249},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3587":72019,"_30795":72004,"_21329":119251,"_5":14664,"_27997":119206,"_3043":119252},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3587":72020,"_30795":72004,"_21329":119254,"_5":14664,"_27997":119206,"_3043":119255},[],"Fastlane instala o configura",{"_3587":72021,"_30795":72004,"_21329":119257,"_5":14664,"_27997":119206,"_3043":119258},[],"Tú sigues proporcionando",{"_3587":72022,"_30795":72004,"_21329":119260,"_5":14664,"_27997":119206,"_3043":119261},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3587":72023,"_30795":72004,"_21329":119263,"_5":14664,"_27997":119206,"_3043":119264},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3587":72024,"_30795":72004,"_21329":119266,"_5":14664,"_27997":119206,"_3043":119267},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3587":72025,"_30795":72004,"_21329":119269,"_5":14664,"_27997":119206,"_3043":119270},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3587":72026,"_30795":72004,"_21329":119272,"_5":14664,"_27997":119206,"_3043":119273},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3587":72027,"_30795":72004,"_21329":119275,"_5":14664,"_27997":119206,"_3043":119276},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3587":72028,"_30795":72004,"_21329":119278,"_5":14664,"_27997":119206,"_3043":119279},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3587":72029,"_30795":72004,"_21329":119281,"_5":14664,"_27997":119206,"_3043":119282},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3587":72030,"_30795":72004,"_21329":119284,"_5":14664,"_27997":119206,"_3043":119285},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3587":72031,"_30795":72004,"_21329":119287,"_5":14664,"_27997":119210,"_3043":119288},[],"Necesitas:",{"_3587":72032,"_30795":72004,"_21329":119290,"_5":14664,"_27997":119210,"_3043":119291},[],"un clúster Kubernetes existente",{"_3587":72033,"_30795":72004,"_21329":119293,"_5":14664,"_27997":119210,"_3043":119294},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3587":72034,"_30795":72004,"_21329":119296,"_5":14664,"_27997":119210,"_3043":50727},[],{"_3587":72035,"_30795":72004,"_21329":119298,"_5":14664,"_27997":119210,"_3043":24104},[],{"_3587":72036,"_30795":72004,"_21329":119300,"_5":14664,"_27997":119210,"_3043":119301},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3587":72037,"_30795":72004,"_21329":119303,"_5":14664,"_27997":119210,"_3043":119304},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3587":72038,"_30795":72004,"_21329":119306,"_5":14664,"_27997":119210,"_3043":119307},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3587":72039,"_30795":72004,"_21329":119309,"_5":14664,"_27997":119210,"_3043":119310},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3587":72040,"_30795":72004,"_21329":119312,"_5":14664,"_27997":119210,"_3043":119313},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3587":72041,"_30795":72004,"_21329":119315,"_5":14664,"_27997":119214,"_3043":119316},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3587":72042,"_30795":72004,"_21329":119318,"_5":14664,"_27997":119214,"_3043":119319},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3587":72043,"_30795":72004,"_21329":119321,"_5":14664,"_27997":119218,"_3043":119322},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3587":72044,"_30795":72004,"_21329":119324,"_5":14664,"_27997":119218,"_3043":119325},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3587":72045,"_30795":72004,"_21329":119327,"_5":14664,"_27997":119218,"_3043":119328},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3587":72046,"_30795":72004,"_21329":119330,"_5":14664,"_27997":119218,"_3043":119331},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3587":72047,"_30795":72004,"_21329":119333,"_5":14664,"_27997":119222,"_3043":119334},[],"Opción",{"_3587":72048,"_30795":72004,"_21329":119336,"_5":14664,"_27997":119222,"_3043":119337},[],"Valor predeterminado",{"_3587":72049,"_30795":72004,"_21329":119339,"_5":14664,"_27997":119222,"_3043":119340},[],"Propósito",{"_3587":72050,"_30795":72004,"_21329":119342,"_5":14664,"_27997":119222,"_3043":50774},[],{"_3587":72051,"_30795":72004,"_21329":119344,"_5":14664,"_27997":119222,"_3043":50777},[],{"_3587":72052,"_30795":72004,"_21329":119346,"_5":14664,"_27997":119222,"_3043":119347},[],"Muestra la ayuda",{"_3587":72053,"_30795":72004,"_21329":119349,"_5":14664,"_27997":119222,"_3043":50783},[],{"_3587":72054,"_30795":72004,"_21329":119351,"_5":14664,"_27997":119222,"_3043":119352},[],"contexto actual",{"_3587":72055,"_30795":72004,"_21329":119354,"_5":14664,"_27997":119222,"_3043":119355},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3587":72056,"_30795":72004,"_21329":119357,"_5":14664,"_27997":119222,"_3043":50792},[],{"_3587":72057,"_30795":72004,"_21329":119359,"_5":14664,"_27997":119222,"_3043":6728},[],{"_3587":72058,"_30795":72004,"_21329":119361,"_5":14664,"_27997":119222,"_3043":119362},[],"Omite prompts y genera credenciales para las dependencias",{"_3587":72059,"_30795":72004,"_21329":119364,"_5":14664,"_27997":119222,"_3043":50800},[],{"_3587":72060,"_30795":72004,"_21329":119366,"_5":14664,"_27997":119222,"_3043":50803},[],{"_3587":72061,"_30795":72004,"_21329":119368,"_5":14664,"_27997":119222,"_3043":119369},[],"Namespace de la instalación",{"_3587":72062,"_30795":72004,"_21329":119371,"_5":14664,"_27997":119222,"_3043":50809},[],{"_3587":72063,"_30795":72004,"_21329":119373,"_5":14664,"_27997":119222,"_3043":50812},[],{"_3587":72064,"_30795":72004,"_21329":119375,"_5":14664,"_27997":119222,"_3043":119376},[],"Dominio usado por la UI, OIDC y el certificado",{"_3587":72065,"_30795":72004,"_21329":119378,"_5":14664,"_27997":119222,"_3043":50818},[],{"_3587":72066,"_30795":72004,"_21329":119380,"_5":14664,"_27997":119222,"_3043":15374},[],{"_3587":72067,"_30795":72004,"_21329":119382,"_5":14664,"_27997":119222,"_3043":119383},[],"Versión del chart de Lamassu",{"_3587":72068,"_30795":72004,"_21329":119385,"_5":14664,"_27997":119222,"_3043":50826},[],{"_3587":72069,"_30795":72004,"_21329":119387,"_5":14664,"_27997":119222,"_3043":50829},[],{"_3587":72070,"_30795":72004,"_21329":119389,"_5":14664,"_27997":119222,"_3043":119390},[],"Puerto del listener HTTPS",{"_3587":72071,"_30795":72004,"_21329":119392,"_5":14664,"_27997":119222,"_3043":50835},[],{"_3587":72072,"_30795":72004,"_21329":119394,"_5":14664,"_27997":119222,"_3043":50838},[],{"_3587":72073,"_30795":72004,"_21329":119396,"_5":14664,"_27997":119222,"_3043":119397},[],"Puerto del listener HTTP",{"_3587":72074,"_30795":72004,"_21329":119399,"_5":14664,"_27997":119222,"_3043":50844},[],{"_3587":72075,"_30795":72004,"_21329":119401,"_5":14664,"_27997":119222,"_3043":50777},[],{"_3587":72076,"_30795":72004,"_21329":119403,"_5":14664,"_27997":119222,"_3043":119404},[],"Certificado PEM para TLS downstream",{"_3587":72077,"_30795":72004,"_21329":119406,"_5":14664,"_27997":119222,"_3043":50852},[],{"_3587":72078,"_30795":72004,"_21329":119408,"_5":14664,"_27997":119222,"_3043":50777},[],{"_3587":72079,"_30795":72004,"_21329":119410,"_5":14664,"_27997":119222,"_3043":119411},[],"Clave privada PEM para TLS downstream",{"_3587":72080,"_30795":72004,"_21329":119413,"_5":14664,"_27997":119222,"_3043":50860},[],{"_3587":72081,"_30795":72004,"_21329":119415,"_5":14664,"_27997":119222,"_3043":119416},[],"chart del repositorio",{"_3587":72082,"_30795":72004,"_21329":119418,"_5":14664,"_27997":119222,"_3043":119419},[],"Usa un chart local de Lamassu sin empaquetar",{"_3587":72083,"_30795":72004,"_21329":119421,"_5":14664,"_27997":119222,"_3043":50869},[],{"_3587":72084,"_30795":72004,"_21329":119423,"_5":14664,"_27997":119222,"_3043":119424},[],"detección automática",{"_3587":72085,"_30795":72004,"_21329":119426,"_5":14664,"_27997":119222,"_3043":119427},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3587":72086,"_30795":72004,"_21329":119429,"_5":14664,"_27997":119222,"_3043":50877},[],{"_3587":72087,"_30795":72004,"_21329":119431,"_5":14664,"_27997":119222,"_3043":6728},[],{"_3587":72088,"_30795":72004,"_21329":119433,"_5":14664,"_27997":119222,"_3043":119434},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3587":72089,"_30795":72004,"_21329":119436,"_5":14664,"_27997":119222,"_3043":50885},[],{"_3587":72090,"_30795":72004,"_21329":119438,"_5":14664,"_27997":119222,"_3043":6728},[],{"_3587":72091,"_30795":72004,"_21329":119440,"_5":14664,"_27997":119222,"_3043":119441},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3587":72092,"_30795":72004,"_21329":119443,"_5":14664,"_27997":119222,"_3043":50893},[],{"_3587":72093,"_30795":72004,"_21329":119445,"_5":14664,"_27997":119222,"_3043":6728},[],{"_3587":72094,"_30795":72004,"_21329":119447,"_5":14664,"_27997":119222,"_3043":119448},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3587":72095,"_30795":72004,"_21329":119450,"_5":14664,"_27997":119222,"_3043":50901},[],{"_3587":72096,"_30795":72004,"_21329":119452,"_5":14664,"_27997":119222,"_3043":6728},[],{"_3587":72097,"_30795":72004,"_21329":119454,"_5":14664,"_27997":119222,"_3043":119455},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3587":72098,"_30795":72004,"_21329":119457,"_5":14664,"_27997":119222,"_3043":50909},[],{"_3587":72099,"_30795":72004,"_21329":119459,"_5":14664,"_27997":119222,"_3043":50912},[],{"_3587":72100,"_30795":72004,"_21329":119461,"_5":14664,"_27997":119222,"_3043":119462},[],"Usa otro chart local de SoftHSM",{"_3587":72101,"_30795":72004,"_21329":119464,"_5":14664,"_27997":119222,"_3043":119465},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3587":72102,"_30795":72004,"_21329":119467,"_5":14664,"_27997":119226,"_3043":119468},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3587":72103,"_30795":72004,"_21329":119470,"_5":14664,"_27997":119226,"_3043":119471},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3587":72104,"_30795":72004,"_21329":119473,"_5":14664,"_27997":119226,"_3043":119474},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3587":72105,"_30795":72004,"_21329":119476,"_5":14664,"_27997":119226,"_3043":119477},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3587":72106,"_30795":72004,"_21329":119479,"_5":14664,"_27997":119226,"_3043":119480},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3587":72107,"_30795":72004,"_21329":119482,"_5":14664,"_27997":119226,"_3043":119483},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3587":72108,"_30795":72004,"_21329":119485,"_5":14664,"_27997":119230,"_3043":50939},[],{"_3587":72109,"_30795":72004,"_21329":119487,"_5":14664,"_27997":119230,"_3043":119488},[],"valida las herramientas locales y el clúster seleccionado",{"_3587":72110,"_30795":72004,"_21329":119490,"_5":14664,"_27997":119230,"_3043":119491},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3587":72111,"_30795":72004,"_21329":119493,"_5":14664,"_27997":119230,"_3043":119494},[],"crea el namespace",{"_3587":72112,"_30795":72004,"_21329":119496,"_5":14664,"_27997":119230,"_3043":119497},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3587":72113,"_30795":72004,"_21329":119499,"_5":14664,"_27997":119230,"_3043":119500},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3587":72114,"_30795":72004,"_21329":119502,"_5":14664,"_27997":119230,"_3043":119503},[],"instala RabbitMQ",{"_3587":72115,"_30795":72004,"_21329":119505,"_5":14664,"_27997":119230,"_3043":119506},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3587":72116,"_30795":72004,"_21329":119508,"_5":14664,"_27997":119230,"_3043":119509},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3587":72117,"_30795":72004,"_21329":119511,"_5":14664,"_27997":119230,"_3043":119512},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3587":72118,"_30795":72004,"_21329":119514,"_5":14664,"_27997":119230,"_3043":119515},[],"carga datos de ejemplo opcionalmente",{"_3587":72119,"_30795":72004,"_21329":119517,"_5":14664,"_27997":119230,"_3043":119518},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3587":72120,"_30795":72004,"_21329":119520,"_5":14664,"_27997":119234,"_3043":119521},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3587":72121,"_30795":72004,"_21329":119523,"_5":14664,"_27997":119234,"_3043":119524},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3587":72122,"_30795":72004,"_21329":119526,"_5":14664,"_27997":119238,"_3043":119527},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3587":72123,"_30795":72004,"_21329":119529,"_5":14664,"_27997":119238,"_3043":119530},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3587":72124,"_30795":72004,"_21329":119532,"_5":14664,"_27997":119238,"_3043":119533},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3587":72125,"_30795":72004,"_21329":119535,"_5":14664,"_27997":119238,"_3043":119536},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3587":72126,"_30795":72004,"_21329":119538,"_5":14664,"_27997":119242,"_3043":119539},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3587":72127,"_30795":72127,"_5":15024,"_3043":119541,"_31154":119542,"_21329":119543,"_27997":72127},"Instala con Helm",[50381,118961,119195],[],{"_3587":72128,"_30795":72127,"_21329":119545,"_5":14664,"_27997":72127,"_3043":119546},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3587":72129,"_30795":72127,"_5":31151,"_21329":119548,"_27997":119549,"_3043":119550},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3587":72130,"_30795":72127,"_5":31151,"_21329":119552,"_27997":119553,"_3043":119211},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3587":72131,"_30795":72127,"_5":31151,"_21329":119555,"_27997":119556,"_3043":119557},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3587":72132,"_30795":72127,"_5":31151,"_21329":119559,"_27997":119560,"_3043":119561},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3587":72133,"_30795":72127,"_5":31151,"_21329":119563,"_27997":119564,"_3043":119565},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3587":72134,"_30795":72127,"_5":31151,"_21329":119567,"_27997":119568,"_3043":119569},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3587":72135,"_30795":72127,"_5":31151,"_21329":119571,"_27997":119572,"_3043":119573},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3587":72136,"_30795":72127,"_5":31151,"_21329":119575,"_27997":119576,"_3043":119577},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3587":72137,"_30795":72127,"_5":31151,"_21329":119579,"_27997":119580,"_3043":119581},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3587":72138,"_30795":72127,"_5":31151,"_21329":119583,"_27997":119584,"_3043":119585},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3587":72139,"_30795":72127,"_5":31151,"_21329":119587,"_27997":119588,"_3043":119589},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3587":72140,"_30795":72127,"_5":31151,"_21329":119591,"_27997":119592,"_3043":119593},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3587":72141,"_30795":72127,"_21329":119595,"_5":14664,"_27997":119549,"_3043":119596},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3587":72142,"_30795":72127,"_21329":119598,"_5":14664,"_27997":119553,"_3043":119599},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3587":72143,"_30795":72127,"_21329":119601,"_5":14664,"_27997":119553,"_3043":119602},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3587":72144,"_30795":72127,"_21329":119604,"_5":14664,"_27997":119553,"_3043":119605},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3587":72145,"_30795":72127,"_21329":119607,"_5":14664,"_27997":119553,"_3043":119608},[],"un broker RabbitMQ accesible y sus credenciales",{"_3587":72146,"_30795":72127,"_21329":119610,"_5":14664,"_27997":119553,"_3043":119611},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3587":72147,"_30795":72127,"_21329":119613,"_5":14664,"_27997":119553,"_3043":119614},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3587":72148,"_30795":72127,"_21329":119616,"_5":14664,"_27997":119553,"_3043":119617},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3587":72149,"_30795":72127,"_21329":119619,"_5":14664,"_27997":119553,"_3043":119620},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3587":72150,"_30795":72127,"_21329":119622,"_5":14664,"_27997":119553,"_3043":119623},[],"una StorageClass y un diseño de tráfico externo",{"_3587":72151,"_30795":72127,"_21329":119625,"_5":14664,"_27997":119553,"_3043":119626},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3587":72152,"_30795":72127,"_21329":119628,"_5":14664,"_27997":119553,"_3043":119629},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3587":72153,"_30795":72127,"_21329":119631,"_5":14664,"_27997":119553,"_3043":119632},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3587":72154,"_30795":72127,"_21329":119634,"_5":14664,"_27997":119556,"_3043":119635},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3587":72155,"_30795":72127,"_21329":119637,"_5":14664,"_27997":119556,"_3043":119638},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3587":72156,"_30795":72127,"_21329":119640,"_5":14664,"_27997":119556,"_3043":119641},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3587":72157,"_30795":72127,"_21329":119643,"_5":14664,"_27997":119560,"_3043":119644},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3587":72158,"_30795":72127,"_21329":119646,"_5":14664,"_27997":119560,"_3043":119647},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3587":72159,"_30795":72127,"_21329":119649,"_5":14664,"_27997":119560,"_3043":119650},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3587":72160,"_30795":72127,"_21329":119652,"_5":14664,"_27997":119560,"_3043":119653},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3587":72161,"_30795":72127,"_21329":119655,"_5":14664,"_27997":119564,"_3043":119656},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3587":72162,"_30795":72127,"_21329":119658,"_5":14664,"_27997":119564,"_3043":119659},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3587":72163,"_30795":72127,"_21329":119661,"_5":14664,"_27997":119564,"_3043":119662},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3587":72164,"_30795":72127,"_21329":119664,"_5":14664,"_27997":119564,"_3043":119665},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3587":72165,"_30795":72127,"_21329":119667,"_5":14664,"_27997":119564,"_3043":119668},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3587":72166,"_30795":72127,"_21329":119670,"_5":14664,"_27997":119564,"_3043":119671},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3587":72167,"_30795":72127,"_21329":119673,"_5":14664,"_27997":119564,"_3043":119674},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3587":72168,"_30795":72127,"_21329":119676,"_5":14664,"_27997":119564,"_3043":119677},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3587":72169,"_30795":72127,"_21329":119679,"_5":14664,"_27997":119568,"_3043":119680},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3587":72170,"_30795":72127,"_21329":119682,"_5":14664,"_27997":119572,"_3043":119683},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3587":72171,"_30795":72127,"_21329":119685,"_5":14664,"_27997":119572,"_3043":119686},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3587":72172,"_30795":72127,"_21329":119688,"_5":14664,"_27997":119572,"_3043":119689},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3587":72173,"_30795":72127,"_21329":119691,"_5":14664,"_27997":119572,"_3043":119692},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3587":72174,"_30795":72127,"_21329":119694,"_5":14664,"_27997":119572,"_3043":119695},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3587":72175,"_30795":72127,"_21329":119697,"_5":14664,"_27997":119572,"_3043":119698},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3587":72176,"_30795":72127,"_21329":119700,"_5":14664,"_27997":119572,"_3043":119701},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3587":72177,"_30795":72127,"_21329":119703,"_5":14664,"_27997":119576,"_3043":119704},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3587":72178,"_30795":72127,"_21329":119706,"_5":14664,"_27997":119576,"_3043":119707},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3587":72179,"_30795":72127,"_21329":119709,"_5":14664,"_27997":119576,"_3043":119710},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3587":72180,"_30795":72127,"_21329":119712,"_5":14664,"_27997":119576,"_3043":119713},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3587":72181,"_30795":72127,"_21329":119715,"_5":14664,"_27997":119580,"_3043":119716},[],"Para instalar un checkout local:",{"_3587":72182,"_30795":72127,"_21329":119718,"_5":14664,"_27997":119584,"_3043":119719},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3587":72183,"_30795":72127,"_21329":119721,"_5":14664,"_27997":119584,"_3043":119722},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3587":72184,"_30795":72127,"_21329":119724,"_5":14664,"_27997":119588,"_3043":119725},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3587":72185,"_30795":72127,"_21329":119727,"_5":14664,"_27997":119588,"_3043":119728},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3587":72186,"_30795":72127,"_21329":119730,"_5":14664,"_27997":119588,"_3043":119731},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3587":72187,"_30795":72127,"_21329":119733,"_5":14664,"_27997":119588,"_3043":119734},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3587":72188,"_30795":72127,"_21329":119736,"_5":14664,"_27997":119588,"_3043":119737},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3587":72189,"_30795":72127,"_21329":119739,"_5":14664,"_27997":119592,"_3043":119740},[],"Antes de pasar a producción, revisa:",{"_3587":72190,"_30795":72127,"_21329":119742,"_5":14664,"_27997":119592,"_3043":119743},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3587":72191,"_30795":72127,"_21329":119745,"_5":14664,"_27997":119592,"_3043":119746},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3587":72192,"_30795":72127,"_21329":119748,"_5":14664,"_27997":119592,"_3043":119749},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3587":72193,"_30795":72127,"_21329":119751,"_5":14664,"_27997":119592,"_3043":119752},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3587":72194,"_30795":72127,"_21329":119754,"_5":14664,"_27997":119592,"_3043":119755},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3587":72195,"_30795":72127,"_21329":119757,"_5":14664,"_27997":119592,"_3043":119758},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3587":72196,"_30795":72127,"_21329":119760,"_5":14664,"_27997":119592,"_3043":119761},[],"SMTP, observabilidad y entrega de alertas",{"_3587":72197,"_30795":72127,"_21329":119763,"_5":14664,"_27997":119592,"_3043":119764},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3587":72198,"_30795":72127,"_21329":119766,"_5":14664,"_27997":119592,"_3043":119767},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3587":72199,"_30795":72199,"_5":15024,"_3043":119769,"_31154":119770,"_21329":119771,"_27997":72199},"Expón el Gateway",[50381,118961,119195],[],{"_3587":72200,"_30795":72199,"_21329":119773,"_5":14664,"_27997":72199,"_3043":119774},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3587":72201,"_30795":72199,"_5":31151,"_21329":119776,"_27997":119777,"_3043":119778},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3587":72202,"_30795":72199,"_5":31151,"_21329":119780,"_27997":119781,"_3043":119782},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3587":72203,"_30795":72199,"_5":31151,"_21329":119784,"_27997":119785,"_3043":119786},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3587":72204,"_30795":72199,"_5":31151,"_21329":119788,"_27997":119789,"_3043":51244},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/networking#k3s",{"_3587":72205,"_30795":72199,"_5":31151,"_21329":119791,"_27997":119792,"_3043":119793},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3587":72206,"_30795":72199,"_5":31151,"_21329":119795,"_27997":119796,"_3043":119797},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3587":72207,"_30795":72199,"_5":31151,"_21329":119799,"_27997":119800,"_3043":119801},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3587":72208,"_30795":72199,"_5":31151,"_21329":119803,"_27997":119804,"_3043":119805},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3587":72209,"_30795":72199,"_5":31151,"_21329":119807,"_27997":119808,"_3043":119809},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3587":72210,"_30795":72199,"_5":31151,"_21329":119811,"_27997":119812,"_3043":119813},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3587":72211,"_30795":72199,"_5":31151,"_21329":119815,"_27997":119816,"_3043":119817},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3587":72212,"_30795":72199,"_21329":119819,"_5":14664,"_27997":119777,"_3043":119820},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3587":72213,"_30795":72199,"_21329":119822,"_5":14664,"_27997":119777,"_3043":119823},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3587":72214,"_30795":72199,"_21329":119825,"_5":14664,"_27997":119781,"_3043":119826},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3587":72215,"_30795":72199,"_21329":119828,"_5":14664,"_27997":119781,"_3043":119829},[],"Defínelo únicamente cuando:",{"_3587":72216,"_30795":72199,"_21329":119831,"_5":14664,"_27997":119781,"_3043":119832},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3587":72217,"_30795":72199,"_21329":119834,"_5":14664,"_27997":119781,"_3043":119835},[],"esa dirección está asignada a este Gateway",{"_3587":72218,"_30795":72199,"_21329":119837,"_5":14664,"_27997":119781,"_3043":119838},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3587":72219,"_30795":72199,"_21329":119840,"_5":14664,"_27997":119781,"_3043":119841},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3587":72220,"_30795":72199,"_21329":119843,"_5":14664,"_27997":119781,"_3043":119844},[],"No confundas estos valores:",{"_3587":72221,"_30795":72199,"_21329":119846,"_5":14664,"_27997":119781,"_3043":119847},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3587":72222,"_30795":72199,"_21329":119849,"_5":14664,"_27997":119781,"_3043":119850},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3587":72223,"_30795":72199,"_21329":119852,"_5":14664,"_27997":119781,"_3043":119853},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3587":72224,"_30795":72199,"_21329":119855,"_5":14664,"_27997":119785,"_3043":119856},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3587":72225,"_30795":72199,"_21329":119858,"_5":14664,"_27997":119785,"_3043":119859},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3587":72226,"_30795":72199,"_21329":119861,"_5":14664,"_27997":119789,"_3043":119862},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3587":72227,"_30795":72199,"_21329":119864,"_5":14664,"_27997":119789,"_3043":119865},[],"Para el diseño recomendado:",{"_3587":72228,"_30795":72199,"_21329":119867,"_5":14664,"_27997":119789,"_3043":119868},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3587":72229,"_30795":72199,"_21329":119870,"_5":14664,"_27997":119789,"_3043":119871},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3587":72230,"_30795":72199,"_21329":119873,"_5":14664,"_27997":119789,"_3043":119874},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3587":72231,"_30795":72199,"_21329":119876,"_5":14664,"_27997":119789,"_3043":119877},[],"Apunta DNS a la dirección accesible de la VM.",{"_3587":72232,"_30795":72199,"_21329":119879,"_5":14664,"_27997":119789,"_3043":119880},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3587":72233,"_30795":72199,"_21329":119882,"_5":14664,"_27997":119792,"_3043":119883},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3587":72234,"_30795":72199,"_21329":119885,"_5":14664,"_27997":119796,"_3043":119886},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3587":72235,"_30795":72199,"_21329":119888,"_5":14664,"_27997":119796,"_3043":119889},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3587":72236,"_30795":72199,"_21329":119891,"_5":14664,"_27997":119800,"_3043":119892},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3587":72237,"_30795":72199,"_21329":119894,"_5":14664,"_27997":119800,"_3043":119895},[],"Requisito",{"_3587":72238,"_30795":72199,"_21329":119897,"_5":14664,"_27997":119800,"_3043":119898},[],"Diseño recomendado",{"_3587":72239,"_30795":72199,"_21329":119900,"_5":14664,"_27997":119800,"_3043":119901},[],"Consecuencia",{"_3587":72240,"_30795":72199,"_21329":119903,"_5":14664,"_27997":119800,"_3043":119904},[],"Varias URL o servicios de Lamassu",{"_3587":72241,"_30795":72199,"_21329":119906,"_5":14664,"_27997":119800,"_3043":119907},[],"Un Gateway con varias rutas",{"_3587":72242,"_30795":72199,"_21329":119909,"_5":14664,"_27997":119800,"_3043":119910},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3587":72243,"_30795":72199,"_21329":119912,"_5":14664,"_27997":119800,"_3043":119913},[],"Gateways independientes e IP externas distintas",{"_3587":72244,"_30795":72199,"_21329":119915,"_5":14664,"_27997":119800,"_3043":119916},[],"Una VIP por Gateway",{"_3587":72245,"_30795":72199,"_21329":119918,"_5":14664,"_27997":119800,"_3043":119919},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3587":72246,"_30795":72199,"_21329":119921,"_5":14664,"_27997":119800,"_3043":119922},[],"Gateways independientes, un nodo y una IP",{"_3587":72247,"_30795":72199,"_21329":119924,"_5":14664,"_27997":119800,"_3043":119925},[],"Puertos externos diferentes",{"_3587":72248,"_30795":72199,"_21329":119927,"_5":14664,"_27997":119800,"_3043":119928},[],"Los clientes deben indicar puertos no estándar",{"_3587":72249,"_30795":72199,"_21329":119930,"_5":14664,"_27997":119800,"_3043":119931},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3587":72250,"_30795":72199,"_21329":119933,"_5":14664,"_27997":119800,"_3043":119934},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3587":72251,"_30795":72199,"_21329":119936,"_5":14664,"_27997":119800,"_3043":119937},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3587":72252,"_30795":72199,"_21329":119939,"_5":14664,"_27997":119800,"_3043":119940},[],"Recursos Gateway separados pero proxy compartido",{"_3587":72253,"_30795":72199,"_21329":119942,"_5":14664,"_27997":119800,"_3043":119943},[],"Modo merged Gateway de Envoy",{"_3587":72254,"_30795":72199,"_21329":119945,"_5":14664,"_27997":119800,"_3043":119946},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3587":72255,"_30795":72199,"_21329":119948,"_5":14664,"_27997":119800,"_3043":119949},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3587":72256,"_30795":72199,"_21329":119951,"_5":14664,"_27997":119800,"_3043":119952},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3587":72257,"_30795":72199,"_21329":119954,"_5":14664,"_27997":119800,"_3043":119955},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3587":72258,"_30795":72199,"_21329":119957,"_5":14664,"_27997":119800,"_3043":119958},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3587":72259,"_30795":72199,"_21329":119960,"_5":14664,"_27997":119804,"_3043":119961},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3587":72260,"_30795":72199,"_21329":119963,"_5":14664,"_27997":119808,"_3043":119964},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3587":72261,"_30795":72199,"_21329":119966,"_5":14664,"_27997":119808,"_3043":119967},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3587":72262,"_30795":72199,"_21329":119969,"_5":14664,"_27997":119808,"_3043":119970},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3587":72263,"_30795":72199,"_21329":119972,"_5":14664,"_27997":119808,"_3043":119973},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3587":72264,"_30795":72199,"_21329":119975,"_5":14664,"_27997":119808,"_3043":119976},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3587":72265,"_30795":72199,"_21329":119978,"_5":14664,"_27997":119812,"_3043":119979},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3587":72266,"_30795":72199,"_21329":119981,"_5":14664,"_27997":119812,"_3043":119982},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3587":72267,"_30795":72199,"_21329":119984,"_5":14664,"_27997":119816,"_3043":119985},[],"Comprueba, en orden:",{"_3587":72268,"_30795":72199,"_21329":119987,"_5":14664,"_27997":119816,"_3043":119988},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3587":72269,"_30795":72199,"_21329":119990,"_5":14664,"_27997":119816,"_3043":119991},[],"Su estado contiene la dirección esperada.",{"_3587":72270,"_30795":72199,"_21329":119993,"_5":14664,"_27997":119816,"_3043":119994},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3587":72271,"_30795":72199,"_21329":119996,"_5":14664,"_27997":119816,"_3043":119997},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3587":72272,"_30795":72199,"_21329":119999,"_5":14664,"_27997":119816,"_3043":120000},[],"DNS resuelve al endpoint accesible externamente.",{"_3587":72273,"_30795":72199,"_21329":120002,"_5":14664,"_27997":119816,"_3043":120003},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3587":72274,"_30795":72199,"_21329":120005,"_5":14664,"_27997":119816,"_3043":120006},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3587":72275,"_30795":72275,"_5":15024,"_3043":50488,"_31154":120008,"_21329":120009,"_27997":72275},[50381,118961,119195],[],{"_3587":72276,"_30795":72275,"_21329":120011,"_5":14664,"_27997":72275,"_3043":120012},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3587":72277,"_30795":72275,"_5":31151,"_21329":120014,"_27997":120015,"_3043":120016},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3587":72278,"_30795":72275,"_5":31151,"_21329":120018,"_27997":120019,"_3043":120020},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3587":72279,"_30795":72275,"_5":31151,"_21329":120022,"_27997":120023,"_3043":120024},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3587":72280,"_30795":72275,"_5":31151,"_21329":120026,"_27997":120027,"_3043":120028},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3587":72281,"_30795":72275,"_5":31151,"_21329":120030,"_27997":120031,"_3043":120032},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3587":72282,"_30795":72275,"_5":31151,"_21329":120034,"_27997":120035,"_3043":120036},[],"/docs/pr-preview/pr-70/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3587":72283,"_30795":72275,"_21329":120038,"_5":14664,"_27997":120015,"_3043":120039},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3587":72284,"_30795":72275,"_21329":120041,"_5":14664,"_27997":120019,"_3043":120042},[],"Flujo",{"_3587":72285,"_30795":72275,"_21329":120044,"_5":14664,"_27997":120019,"_3043":120045},[],"Úsalo para",{"_3587":72286,"_30795":72275,"_21329":120047,"_5":14664,"_27997":120019,"_3043":120048},[],"Qué instala",{"_3587":72287,"_30795":72275,"_21329":120050,"_5":14664,"_27997":120019,"_3043":51506},[],{"_3587":72288,"_30795":72275,"_21329":120052,"_5":14664,"_27997":120019,"_3043":120053},[],"Producción y entornos controlados",{"_3587":72289,"_30795":72275,"_21329":120055,"_5":14664,"_27997":120019,"_3043":120056},[],"Servicios de Lamassu y recursos de Gateway API",{"_3587":72290,"_30795":72275,"_21329":120058,"_5":14664,"_27997":120019,"_3043":50625},[],{"_3587":72291,"_30795":72275,"_21329":120060,"_5":14664,"_27997":120019,"_3043":120061},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3587":72292,"_30795":72275,"_21329":120063,"_5":14664,"_27997":120019,"_3043":120064},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3587":72293,"_30795":72275,"_21329":120066,"_5":14664,"_27997":120023,"_3043":120067},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3587":72294,"_30795":72275,"_21329":120069,"_5":14664,"_27997":120023,"_3043":120070},[],"Área",{"_3587":72295,"_30795":72275,"_21329":120072,"_5":14664,"_27997":120023,"_3043":120073},[],"El chart de Lamassu proporciona",{"_3587":72296,"_30795":72275,"_21329":120075,"_5":14664,"_27997":120023,"_3043":120076},[],"Tú proporcionas",{"_3587":72297,"_30795":72275,"_21329":120078,"_5":14664,"_27997":120023,"_3043":120079},[],"Aplicaciones Lamassu",{"_3587":72298,"_30795":72275,"_21329":120081,"_5":14664,"_27997":120023,"_3043":120082},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3587":72299,"_30795":72275,"_21329":120084,"_5":14664,"_27997":120023,"_3043":120085},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3587":72300,"_30795":72275,"_21329":120087,"_5":14664,"_27997":120023,"_3043":120088},[],"Datos PostgreSQL",{"_3587":72301,"_30795":72275,"_21329":120090,"_5":14664,"_27997":120023,"_3043":120091},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3587":72302,"_30795":72275,"_21329":120093,"_5":14664,"_27997":120023,"_3043":120094},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3587":72303,"_30795":72275,"_21329":120096,"_5":14664,"_27997":120023,"_3043":120097},[],"Mensajería",{"_3587":72304,"_30795":72275,"_21329":120099,"_5":14664,"_27997":120023,"_3043":120100},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3587":72305,"_30795":72275,"_21329":120102,"_5":14664,"_27997":120023,"_3043":120103},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3587":72306,"_30795":72275,"_21329":120105,"_5":14664,"_27997":120023,"_3043":120106},[],"Identidad",{"_3587":72307,"_30795":72275,"_21329":120108,"_5":14664,"_27997":120023,"_3043":120109},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3587":72308,"_30795":72275,"_21329":120111,"_5":14664,"_27997":120023,"_3043":120112},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3587":72309,"_30795":72275,"_21329":120114,"_5":14664,"_27997":120023,"_3043":120115},[],"Enrutamiento externo",{"_3587":72310,"_30795":72275,"_21329":120117,"_5":14664,"_27997":120023,"_3043":120118},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3587":72311,"_30795":72275,"_21329":120120,"_5":14664,"_27997":120023,"_3043":120121},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3587":72312,"_30795":72275,"_21329":120123,"_5":14664,"_27997":120023,"_3043":51580},[],{"_3587":72313,"_30795":72275,"_21329":120125,"_5":14664,"_27997":120023,"_3043":120126},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3587":72314,"_30795":72275,"_21329":120128,"_5":14664,"_27997":120023,"_3043":120129},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3587":72315,"_30795":72275,"_21329":120131,"_5":14664,"_27997":120023,"_3043":120132},[],"Datos persistentes de la aplicación",{"_3587":72316,"_30795":72275,"_21329":120134,"_5":14664,"_27997":120023,"_3043":120135},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3587":72317,"_30795":72275,"_21329":120137,"_5":14664,"_27997":120023,"_3043":120138},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3587":72318,"_30795":72275,"_21329":120140,"_5":14664,"_27997":120023,"_3043":120141},[],"Integraciones opcionales",{"_3587":72319,"_30795":72275,"_21329":120143,"_5":14664,"_27997":120023,"_3043":120144},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3587":72320,"_30795":72275,"_21329":120146,"_5":14664,"_27997":120023,"_3043":120147},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3587":72321,"_30795":72275,"_21329":120149,"_5":14664,"_27997":120023,"_3043":120150},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3587":72322,"_30795":72275,"_21329":120152,"_5":14664,"_27997":120023,"_3043":120153},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3587":72323,"_30795":72275,"_21329":120155,"_5":14664,"_27997":120027,"_3043":120156},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3587":72324,"_30795":72275,"_21329":120158,"_5":14664,"_27997":120027,"_3043":120159},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3587":72325,"_30795":72275,"_21329":120161,"_5":14664,"_27997":120031,"_3043":120162},[],"Kubernetes 1.24 o posterior",{"_3587":72326,"_30795":72275,"_21329":120164,"_5":14664,"_27997":120031,"_3043":120165},[],"Helm 3.2 o posterior",{"_3587":72327,"_30795":72275,"_21329":120167,"_5":14664,"_27997":120031,"_3043":120168},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3587":72328,"_30795":72275,"_21329":120170,"_5":14664,"_27997":120031,"_3043":120171},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3587":72329,"_30795":72275,"_21329":120173,"_5":14664,"_27997":120031,"_3043":120174},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3587":72330,"_30795":72275,"_21329":120176,"_5":14664,"_27997":120031,"_3043":120177},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3587":72331,"_30795":72275,"_21329":120179,"_5":14664,"_27997":120031,"_3043":120180},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3587":72332,"_30795":72275,"_21329":120182,"_5":14664,"_27997":120035,"_3043":120183},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3587":72333,"_30795":72275,"_21329":120185,"_5":14664,"_27997":120035,"_3043":120186},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3587":72334,"_30795":72275,"_21329":120188,"_5":14664,"_27997":120035,"_3043":120189},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3587":72335,"_30795":72275,"_21329":120191,"_5":14664,"_27997":120035,"_3043":120192},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3587":72336,"_30795":72336,"_5":15024,"_3043":120194,"_31154":120195,"_21329":120197,"_27997":72336},"Resolución de problemas de despliegue",[50381,118961,120196],"Operación",[],{"_3587":72337,"_30795":72336,"_21329":120199,"_5":14664,"_27997":72336,"_3043":120200},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3587":72338,"_30795":72336,"_5":31151,"_21329":120202,"_27997":120203,"_3043":120204},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3587":72339,"_30795":72336,"_5":31151,"_21329":120206,"_27997":120207,"_3043":120208},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3587":72340,"_30795":72336,"_5":31151,"_21329":120210,"_27997":120211,"_3043":120212},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3587":72341,"_30795":72336,"_5":31151,"_21329":120214,"_27997":120215,"_3043":120216},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3587":72342,"_30795":72336,"_5":31151,"_21329":120218,"_27997":120219,"_3043":120220},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3587":72343,"_30795":72336,"_5":31151,"_21329":120222,"_27997":120223,"_3043":120224},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3587":72344,"_30795":72336,"_5":31151,"_21329":120226,"_27997":120227,"_3043":120228},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3587":72345,"_30795":72336,"_5":31151,"_21329":120230,"_27997":120231,"_3043":120232},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3587":72346,"_30795":72336,"_5":31151,"_21329":120234,"_27997":120235,"_3043":120236},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3587":72347,"_30795":72336,"_5":31151,"_21329":120238,"_27997":120239,"_3043":120240},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3587":72348,"_30795":72336,"_5":31151,"_21329":120242,"_27997":120243,"_3043":120244},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3587":72349,"_30795":72336,"_5":31151,"_21329":120246,"_27997":120247,"_3043":120248},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3587":72350,"_30795":72336,"_5":31151,"_21329":120250,"_27997":120251,"_3043":120252},[],"/docs/pr-preview/pr-70/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3587":72351,"_30795":72336,"_21329":120254,"_5":14664,"_27997":72336,"_3043":120255},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3587":72352,"_30795":72336,"_21329":120257,"_5":14664,"_27997":120207,"_3043":120258},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3587":72353,"_30795":72336,"_21329":120260,"_5":14664,"_27997":120211,"_3043":120261},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3587":72354,"_30795":72336,"_21329":120263,"_5":14664,"_27997":120215,"_3043":120264},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3587":72355,"_30795":72336,"_21329":120266,"_5":14664,"_27997":120219,"_3043":120267},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3587":72356,"_30795":72336,"_21329":120269,"_5":14664,"_27997":120223,"_3043":120270},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3587":72357,"_30795":72336,"_21329":120272,"_5":14664,"_27997":120227,"_3043":120273},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3587":72358,"_30795":72336,"_21329":120275,"_5":14664,"_27997":120227,"_3043":120276},[],"Ejecuta también la prueba de conectividad del chart:",{"_3587":72359,"_30795":72336,"_21329":120278,"_5":14664,"_27997":120227,"_3043":120279},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3587":72360,"_30795":72336,"_21329":120281,"_5":14664,"_27997":120227,"_3043":120282},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3587":72361,"_30795":72336,"_21329":120284,"_5":14664,"_27997":120231,"_3043":120285},[],"Si recibes un 401:",{"_3587":72362,"_30795":72336,"_21329":120287,"_5":14664,"_27997":120231,"_3043":120288},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3587":72363,"_30795":72336,"_21329":120290,"_5":14664,"_27997":120231,"_3043":120291},[],"verifica emisor, audiencia y expiración del token;",{"_3587":72364,"_30795":72336,"_21329":120293,"_5":14664,"_27997":120231,"_3043":120294},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3587":72365,"_30795":72336,"_21329":120296,"_5":14664,"_27997":120231,"_3043":120297},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3587":72366,"_30795":72336,"_21329":120299,"_5":14664,"_27997":120231,"_3043":120300},[],"Si el login termina pero las APIs devuelven 403:",{"_3587":72367,"_30795":72336,"_21329":120302,"_5":14664,"_27997":120231,"_3043":120303},[],"inspecciona los claims reales del token;",{"_3587":72368,"_30795":72336,"_21329":120305,"_5":14664,"_27997":120231,"_3043":120306},[],"confirma que coinciden con un principal activo;",{"_3587":72369,"_30795":72336,"_21329":120308,"_5":14664,"_27997":120231,"_3043":120309},[],"revisa las políticas concedidas al principal;",{"_3587":72370,"_30795":72336,"_21329":120311,"_5":14664,"_27997":120231,"_3043":120312},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3587":72371,"_30795":72336,"_21329":120314,"_5":14664,"_27997":120231,"_3043":120315},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3587":72372,"_30795":72336,"_21329":120317,"_5":14664,"_27997":120235,"_3043":120318},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3587":72373,"_30795":72336,"_21329":120320,"_5":14664,"_27997":120235,"_3043":120321},[],"Localiza el pod y Service de authz.",{"_3587":72374,"_30795":72336,"_21329":120323,"_5":14664,"_27997":120235,"_3043":120324},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3587":72375,"_30795":72336,"_21329":120326,"_5":14664,"_27997":120235,"_3043":120327},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3587":72376,"_30795":72336,"_21329":120329,"_5":14664,"_27997":120235,"_3043":120330},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3587":72377,"_30795":72336,"_21329":120332,"_5":14664,"_27997":120235,"_3043":120333},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3587":72378,"_30795":72336,"_21329":120335,"_5":14664,"_27997":120239,"_3043":120336},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3587":72379,"_30795":72336,"_21329":120338,"_5":14664,"_27997":120243,"_3043":120339},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3587":72380,"_30795":72336,"_21329":120341,"_5":14664,"_27997":120243,"_3043":120342},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3587":72381,"_30795":72336,"_21329":120344,"_5":14664,"_27997":120243,"_3043":120345},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3587":72382,"_30795":72336,"_21329":120347,"_5":14664,"_27997":120243,"_3043":120348},[],"volumen persistente sin enlazar;",{"_3587":72383,"_30795":72336,"_21329":120350,"_5":14664,"_27997":120243,"_3043":120351},[],"imagen inaccesible o política de pull incorrecta;",{"_3587":72384,"_30795":72336,"_21329":120353,"_5":14664,"_27997":120243,"_3043":120354},[],"configuración inválida del motor criptográfico;",{"_3587":72385,"_30795":72336,"_21329":120356,"_5":14664,"_27997":120243,"_3043":120357},[],"límites de CPU o memoria demasiado bajos;",{"_3587":72386,"_30795":72336,"_21329":120359,"_5":14664,"_27997":120243,"_3043":120360},[],"migración previa incompleta.",{"_3587":72387,"_30795":72336,"_21329":120362,"_5":14664,"_27997":120243,"_3043":120363},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3587":72388,"_30795":72336,"_21329":120365,"_5":14664,"_27997":120243,"_3043":120366},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3587":72389,"_30795":72336,"_21329":120368,"_5":14664,"_27997":120243,"_3043":120369},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3587":72390,"_30795":72336,"_21329":120371,"_5":14664,"_27997":120247,"_3043":120372},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3587":72391,"_30795":72336,"_21329":120374,"_5":14664,"_27997":120247,"_3043":120375},[],"verifica que esté habilitado en el servicio emisor;",{"_3587":72392,"_30795":72336,"_21329":120377,"_5":14664,"_27997":120247,"_3043":120378},[],"comprueba conectividad y credenciales AMQP;",{"_3587":72393,"_30795":72336,"_21329":120380,"_5":14664,"_27997":120247,"_3043":120381},[],"revisa exchange, routing key, colas y consumidores;",{"_3587":72394,"_30795":72336,"_21329":120383,"_5":14664,"_27997":120247,"_3043":120384},[],"inspecciona dead-letter queues;",{"_3587":72395,"_30795":72336,"_21329":120386,"_5":14664,"_27997":120247,"_3043":120387},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3587":72396,"_30795":72336,"_21329":120389,"_5":14664,"_27997":120247,"_3043":120390},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3587":72397,"_30795":72336,"_21329":120392,"_5":14664,"_27997":120247,"_3043":120393},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3587":72398,"_30795":72336,"_21329":120395,"_5":14664,"_27997":120247,"_3043":120396},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3587":72399,"_30795":72336,"_21329":120398,"_5":14664,"_27997":120247,"_3043":120399},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3587":72400,"_30795":72336,"_21329":120401,"_5":14664,"_27997":120247,"_3043":120402},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3587":72401,"_30795":72336,"_21329":120404,"_5":14664,"_27997":120247,"_3043":120405},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3587":72402,"_30795":72336,"_21329":120407,"_5":14664,"_27997":120247,"_3043":120408},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3587":72403,"_30795":72336,"_21329":120410,"_5":14664,"_27997":120251,"_3043":120411},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3587":72404,"_30795":72336,"_21329":120413,"_5":14664,"_27997":120251,"_3043":120414},[],"Antes de cerrar una incidencia, guarda:",{"_3587":72405,"_30795":72336,"_21329":120416,"_5":14664,"_27997":120251,"_3043":120417},[],"causa confirmada;",{"_3587":72406,"_30795":72336,"_21329":120419,"_5":14664,"_27997":120251,"_3043":120420},[],"alcance temporal y recursos afectados;",{"_3587":72407,"_30795":72336,"_21329":120422,"_5":14664,"_27997":120251,"_3043":120423},[],"comandos o consultas utilizados;",{"_3587":72408,"_30795":72336,"_21329":120425,"_5":14664,"_27997":120251,"_3043":120426},[],"cambio aplicado y forma de revertirlo;",{"_3587":72409,"_30795":72336,"_21329":120428,"_5":14664,"_27997":120251,"_3043":120429},[],"validación desde un consumidor;",{"_3587":72410,"_30795":72336,"_21329":120431,"_5":14664,"_27997":120251,"_3043":120432},[],"acción preventiva y propietario.",{"_3587":72411,"_30795":72411,"_5":15024,"_3043":120434,"_31154":120435,"_21329":120439,"_27997":72411},"Modelo de datos",[50381,120436,120437,120438],"Plataforma","Administración","Control de acceso",[],{"_3587":72412,"_30795":72411,"_21329":120441,"_5":14664,"_27997":72411,"_3043":120442},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3587":72413,"_30795":72411,"_5":31151,"_21329":120444,"_27997":120445,"_3043":120446},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3587":72414,"_30795":72411,"_5":31151,"_21329":120448,"_27997":120449,"_3043":120450},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3587":72415,"_30795":72411,"_21329":120452,"_5":14664,"_27997":72411,"_3043":120453},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3587":72416,"_30795":72411,"_21329":120455,"_5":14664,"_27997":120445,"_3043":120456},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3587":72417,"_30795":72411,"_21329":120458,"_5":14664,"_27997":120445,"_3043":120459},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3587":72418,"_30795":72411,"_21329":120461,"_5":14664,"_27997":120445,"_3043":120462},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3587":72419,"_30795":72411,"_21329":120464,"_5":14664,"_27997":120449,"_3043":120465},[],"Entidad (`schema_name.entity_type`)",{"_3587":72420,"_30795":72411,"_21329":120467,"_5":14664,"_27997":120449,"_3043":120468},[],"Tabla (`table_name`)",{"_3587":72421,"_30795":72411,"_21329":120470,"_5":14664,"_27997":120449,"_3043":120471},[],"Clave (`primary_key`)",{"_3587":72422,"_30795":72411,"_21329":120473,"_5":14664,"_27997":120449,"_3043":51931},[],{"_3587":72423,"_30795":72411,"_21329":120475,"_5":14664,"_27997":120449,"_3043":51934},[],{"_3587":72424,"_30795":72411,"_21329":120477,"_5":14664,"_27997":120449,"_3043":51937},[],{"_3587":72425,"_30795":72411,"_21329":120479,"_5":14664,"_27997":120449,"_3043":51940},[],{"_3587":72426,"_30795":72411,"_21329":120481,"_5":14664,"_27997":120449,"_3043":51943},[],{"_3587":72427,"_30795":72411,"_21329":120483,"_5":14664,"_27997":120449,"_3043":51946},[],{"_3587":72428,"_30795":72411,"_21329":120485,"_5":14664,"_27997":120449,"_3043":51949},[],{"_3587":72429,"_30795":72411,"_21329":120487,"_5":14664,"_27997":120449,"_3043":51952},[],{"_3587":72430,"_30795":72411,"_21329":120489,"_5":14664,"_27997":120449,"_3043":51946},[],{"_3587":72431,"_30795":72411,"_21329":120491,"_5":14664,"_27997":120449,"_3043":51957},[],{"_3587":72432,"_30795":72411,"_21329":120493,"_5":14664,"_27997":120449,"_3043":51960},[],{"_3587":72433,"_30795":72411,"_21329":120495,"_5":14664,"_27997":120449,"_3043":51963},[],{"_3587":72434,"_30795":72411,"_21329":120497,"_5":14664,"_27997":120449,"_3043":51966},[],{"_3587":72435,"_30795":72411,"_21329":120499,"_5":14664,"_27997":120449,"_3043":51969},[],{"_3587":72436,"_30795":72411,"_21329":120501,"_5":14664,"_27997":120449,"_3043":51946},[],{"_3587":72437,"_30795":72411,"_21329":120503,"_5":14664,"_27997":120449,"_3043":51974},[],{"_3587":72438,"_30795":72411,"_21329":120505,"_5":14664,"_27997":120449,"_3043":51977},[],{"_3587":72439,"_30795":72411,"_21329":120507,"_5":14664,"_27997":120449,"_3043":51946},[],{"_3587":72440,"_30795":72411,"_21329":120509,"_5":14664,"_27997":120449,"_3043":51982},[],{"_3587":72441,"_30795":72411,"_21329":120511,"_5":14664,"_27997":120449,"_3043":51985},[],{"_3587":72442,"_30795":72411,"_21329":120513,"_5":14664,"_27997":120449,"_3043":51946},[],{"_3587":72443,"_30795":72411,"_21329":120515,"_5":14664,"_27997":120449,"_3043":51990},[],{"_3587":72444,"_30795":72411,"_21329":120517,"_5":14664,"_27997":120449,"_3043":51993},[],{"_3587":72445,"_30795":72411,"_21329":120519,"_5":14664,"_27997":120449,"_3043":51946},[],{"_3587":72446,"_30795":72411,"_21329":120521,"_5":14664,"_27997":120449,"_3043":51998},[],{"_3587":72447,"_30795":72411,"_21329":120523,"_5":14664,"_27997":120449,"_3043":52001},[],{"_3587":72448,"_30795":72411,"_21329":120525,"_5":14664,"_27997":120449,"_3043":52004},[],{"_3587":72449,"_30795":72411,"_21329":120527,"_5":14664,"_27997":120449,"_3043":52007},[],{"_3587":72450,"_30795":72411,"_21329":120529,"_5":14664,"_27997":120449,"_3043":52010},[],{"_3587":72451,"_30795":72411,"_21329":120531,"_5":14664,"_27997":120449,"_3043":52013},[],{"_3587":72452,"_30795":72411,"_21329":120533,"_5":14664,"_27997":120449,"_3043":120534},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3587":72453,"_30795":72411,"_21329":120536,"_5":14664,"_27997":120449,"_3043":120537},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3587":72454,"_30795":72411,"_21329":120539,"_5":14664,"_27997":120449,"_3043":120540},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3587":72455,"_30795":72455,"_5":15024,"_3043":120542,"_31154":120543,"_21329":120544,"_27997":72455},"Visión general del control de acceso",[50381,120436,120437,120438],[],{"_3587":72456,"_30795":72455,"_21329":120546,"_5":14664,"_27997":72455,"_3043":120547},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3587":72457,"_30795":72455,"_5":31151,"_21329":120549,"_27997":120550,"_3043":120551},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3587":72458,"_30795":72455,"_5":31151,"_21329":120553,"_27997":120554,"_3043":120555},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3587":72459,"_30795":72455,"_5":31151,"_21329":120557,"_27997":120558,"_3043":120559},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3587":72460,"_30795":72455,"_5":31151,"_21329":120561,"_27997":120562,"_3043":120563},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3587":72461,"_30795":72455,"_5":31151,"_21329":120565,"_27997":120566,"_3043":120567},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3587":72462,"_30795":72455,"_5":31151,"_21329":120569,"_27997":120570,"_3043":120571},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3587":72463,"_30795":72455,"_5":31151,"_21329":120573,"_27997":120574,"_3043":120575},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3587":72464,"_30795":72455,"_5":31151,"_21329":120577,"_27997":120578,"_3043":120579},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3587":72465,"_30795":72455,"_5":31151,"_21329":120581,"_27997":120582,"_3043":120583},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3587":72466,"_30795":72455,"_5":31151,"_21329":120585,"_27997":120586,"_3043":120587},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3587":72467,"_30795":72455,"_5":31151,"_21329":120589,"_27997":120590,"_3043":120591},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3587":72468,"_30795":72455,"_5":31151,"_21329":120593,"_27997":120594,"_3043":120595},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3587":72469,"_30795":72455,"_5":31151,"_21329":120597,"_27997":120598,"_3043":120599},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3587":72470,"_30795":72455,"_5":31151,"_21329":120601,"_27997":120602,"_3043":120603},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3587":72471,"_30795":72455,"_5":31151,"_21329":120605,"_27997":120606,"_3043":120607},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3587":72472,"_30795":72455,"_5":31151,"_21329":120609,"_27997":120610,"_3043":119577},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3587":72473,"_30795":72455,"_5":31151,"_21329":120612,"_27997":120613,"_3043":120614},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3587":72474,"_30795":72455,"_5":31151,"_21329":120616,"_27997":120617,"_3043":120618},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3587":72475,"_30795":72455,"_5":31151,"_21329":120620,"_27997":120621,"_3043":120622},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3587":72476,"_30795":72455,"_5":31151,"_21329":120624,"_27997":120625,"_3043":120626},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3587":72477,"_30795":72455,"_5":31151,"_21329":120628,"_27997":120629,"_3043":120630},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3587":72478,"_30795":72455,"_5":31151,"_21329":120632,"_27997":120633,"_3043":120634},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3587":72479,"_30795":72455,"_5":31151,"_21329":120636,"_27997":120637,"_3043":120638},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3587":72480,"_30795":72455,"_5":31151,"_21329":120640,"_27997":120641,"_3043":120642},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3587":72481,"_30795":72455,"_5":31151,"_21329":120644,"_27997":120645,"_3043":120646},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3587":72482,"_30795":72455,"_5":31151,"_21329":120648,"_27997":120649,"_3043":120650},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3587":72483,"_30795":72455,"_5":31151,"_21329":120652,"_27997":120653,"_3043":120654},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3587":72484,"_30795":72455,"_5":31151,"_21329":120656,"_27997":120657,"_3043":120658},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3587":72485,"_30795":72455,"_5":31151,"_21329":120660,"_27997":120661,"_3043":120662},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3587":72486,"_30795":72455,"_5":31151,"_21329":120664,"_27997":120665,"_3043":120666},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3587":72487,"_30795":72455,"_5":31151,"_21329":120668,"_27997":120669,"_3043":120670},[],"/docs/pr-preview/pr-70/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3587":72488,"_30795":72455,"_21329":120672,"_5":14664,"_27997":72455,"_3043":120673},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3587":72489,"_30795":72455,"_21329":120675,"_5":14664,"_27997":72455,"_3043":120676},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3587":72490,"_30795":72455,"_21329":120678,"_5":14664,"_27997":72455,"_3043":120679},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3587":72491,"_30795":72455,"_21329":120681,"_5":14664,"_27997":120550,"_3043":120682},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3587":72492,"_30795":72455,"_21329":120684,"_5":14664,"_27997":120550,"_3043":120685},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3587":72493,"_30795":72455,"_21329":120687,"_5":14664,"_27997":120550,"_3043":120688},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3587":72494,"_30795":72455,"_21329":120690,"_5":14664,"_27997":120550,"_3043":120691},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3587":72495,"_30795":72455,"_21329":120693,"_5":14664,"_27997":120550,"_3043":120694},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3587":72496,"_30795":72455,"_21329":120696,"_5":14664,"_27997":120550,"_3043":120697},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3587":72497,"_30795":72455,"_21329":120699,"_5":14664,"_27997":120554,"_3043":120700},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3587":72498,"_30795":72455,"_21329":120702,"_5":14664,"_27997":120554,"_3043":120703},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3587":72499,"_30795":72455,"_21329":120705,"_5":14664,"_27997":120558,"_3043":120706},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3587":72500,"_30795":72455,"_21329":120708,"_5":14664,"_27997":120558,"_3043":120709},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3587":72501,"_30795":72455,"_21329":120711,"_5":14664,"_27997":120558,"_3043":120712},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3587":72502,"_30795":72455,"_21329":120714,"_5":14664,"_27997":120558,"_3043":120715},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3587":72503,"_30795":72455,"_21329":120717,"_5":14664,"_27997":120558,"_3043":120718},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3587":72504,"_30795":72455,"_21329":120720,"_5":14664,"_27997":120558,"_3043":120721},[],"Carga por separado las políticas concedidas a cada principal.",{"_3587":72505,"_30795":72455,"_21329":120723,"_5":14664,"_27997":120558,"_3043":120724},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3587":72506,"_30795":72455,"_21329":120726,"_5":14664,"_27997":120558,"_3043":120727},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3587":72507,"_30795":72455,"_21329":120729,"_5":14664,"_27997":120558,"_3043":120730},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3587":72508,"_30795":72455,"_21329":120732,"_5":14664,"_27997":120558,"_3043":120733},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3587":72509,"_30795":72455,"_21329":120735,"_5":14664,"_27997":120558,"_3043":120736},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3587":72510,"_30795":72455,"_21329":120738,"_5":14664,"_27997":120558,"_3043":120739},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3587":72511,"_30795":72455,"_21329":120741,"_5":14664,"_27997":120562,"_3043":120742},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3587":72512,"_30795":72455,"_21329":120744,"_5":14664,"_27997":120562,"_3043":120745},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3587":72513,"_30795":72455,"_21329":120747,"_5":14664,"_27997":120562,"_3043":120748},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3587":72514,"_30795":72455,"_21329":120750,"_5":14664,"_27997":120562,"_3043":120751},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3587":72515,"_30795":72455,"_21329":120753,"_5":14664,"_27997":120562,"_3043":120754},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3587":72516,"_30795":72455,"_21329":120756,"_5":14664,"_27997":120562,"_3043":120757},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3587":72517,"_30795":72455,"_21329":120759,"_5":14664,"_27997":120562,"_3043":120760},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3587":72518,"_30795":72455,"_21329":120762,"_5":14664,"_27997":120562,"_3043":120763},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3587":72519,"_30795":72455,"_21329":120765,"_5":14664,"_27997":120566,"_3043":120766},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3587":72520,"_30795":72455,"_21329":120768,"_5":14664,"_27997":120566,"_3043":120769},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3587":72521,"_30795":72455,"_21329":120771,"_5":14664,"_27997":120566,"_3043":120772},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3587":72522,"_30795":72455,"_21329":120774,"_5":14664,"_27997":120566,"_3043":120775},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3587":72523,"_30795":72455,"_21329":120777,"_5":14664,"_27997":120566,"_3043":120778},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3587":72524,"_30795":72455,"_21329":120780,"_5":14664,"_27997":120566,"_3043":120781},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3587":72525,"_30795":72455,"_21329":120783,"_5":14664,"_27997":120566,"_3043":120784},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3587":72526,"_30795":72455,"_21329":120786,"_5":14664,"_27997":120566,"_3043":120787},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3587":72527,"_30795":72455,"_21329":120789,"_5":14664,"_27997":120566,"_3043":120790},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3587":72528,"_30795":72455,"_21329":120792,"_5":14664,"_27997":120566,"_3043":120793},[],"Las acciones se dividen en dos grupos:",{"_3587":72529,"_30795":72455,"_21329":120795,"_5":14664,"_27997":120566,"_3043":120796},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3587":72530,"_30795":72455,"_21329":120798,"_5":14664,"_27997":120566,"_3043":120799},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3587":72531,"_30795":72455,"_21329":120801,"_5":14664,"_27997":120566,"_3043":120802},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3587":72532,"_30795":72455,"_21329":120804,"_5":14664,"_27997":120570,"_3043":120805},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3587":72533,"_30795":72455,"_21329":120807,"_5":14664,"_27997":120570,"_3043":120808},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3587":72534,"_30795":72455,"_21329":120810,"_5":14664,"_27997":120570,"_3043":120811},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3587":72535,"_30795":72455,"_21329":120813,"_5":14664,"_27997":120574,"_3043":120814},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3587":72536,"_30795":72455,"_21329":120816,"_5":14664,"_27997":120574,"_3043":120817},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3587":72537,"_30795":72455,"_21329":120819,"_5":14664,"_27997":120574,"_3043":120820},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3587":72538,"_30795":72455,"_21329":120822,"_5":14664,"_27997":120574,"_3043":120823},[],"Los operadores implementados son:",{"_3587":72539,"_30795":72455,"_21329":120825,"_5":14664,"_27997":120574,"_3043":120826},[],"`equals`, para igualdad exacta;",{"_3587":72540,"_30795":72455,"_21329":120828,"_5":14664,"_27997":120574,"_3043":120829},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3587":72541,"_30795":72455,"_21329":120831,"_5":14664,"_27997":120574,"_3043":120832},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3587":72542,"_30795":72455,"_21329":120834,"_5":14664,"_27997":120574,"_3043":120835},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3587":72543,"_30795":72455,"_21329":120837,"_5":14664,"_27997":120578,"_3043":120838},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3587":72544,"_30795":72455,"_21329":120840,"_5":14664,"_27997":120578,"_3043":120841},[],"Los modos disponibles son:",{"_3587":72545,"_30795":72455,"_21329":120843,"_5":14664,"_27997":120578,"_3043":120844},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3587":72546,"_30795":72455,"_21329":120846,"_5":14664,"_27997":120578,"_3043":120847},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3587":72547,"_30795":72455,"_21329":120849,"_5":14664,"_27997":120578,"_3043":120850},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3587":72548,"_30795":72455,"_21329":120852,"_5":14664,"_27997":120578,"_3043":120853},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3587":72549,"_30795":72455,"_21329":120855,"_5":14664,"_27997":120578,"_3043":120856},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3587":72550,"_30795":72455,"_21329":120858,"_5":14664,"_27997":120578,"_3043":120859},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3587":72551,"_30795":72455,"_21329":120861,"_5":14664,"_27997":120582,"_3043":120862},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3587":72552,"_30795":72455,"_21329":120864,"_5":14664,"_27997":120582,"_3043":120865},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3587":72553,"_30795":72455,"_21329":120867,"_5":14664,"_27997":120582,"_3043":120868},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3587":72554,"_30795":72455,"_21329":120870,"_5":14664,"_27997":120582,"_3043":120871},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3587":72555,"_30795":72455,"_21329":120873,"_5":14664,"_27997":120590,"_3043":120874},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3587":72556,"_30795":72455,"_21329":120876,"_5":14664,"_27997":120590,"_3043":120877},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3587":72557,"_30795":72455,"_21329":120879,"_5":14664,"_27997":120594,"_3043":120880},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3587":72558,"_30795":72455,"_21329":120882,"_5":14664,"_27997":120594,"_3043":120883},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3587":72559,"_30795":72455,"_21329":120885,"_5":14664,"_27997":120594,"_3043":120886},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3587":72560,"_30795":72455,"_21329":120888,"_5":14664,"_27997":120594,"_3043":120889},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3587":72561,"_30795":72455,"_21329":120891,"_5":14664,"_27997":120594,"_3043":120892},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3587":72562,"_30795":72455,"_21329":120894,"_5":14664,"_27997":120598,"_3043":120895},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3587":72563,"_30795":72455,"_21329":120897,"_5":14664,"_27997":120598,"_3043":120898},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3587":72564,"_30795":72455,"_21329":120900,"_5":14664,"_27997":120598,"_3043":120901},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3587":72565,"_30795":72455,"_21329":120903,"_5":14664,"_27997":120602,"_3043":120904},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3587":72566,"_30795":72455,"_21329":120906,"_5":14664,"_27997":120602,"_3043":120907},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3587":72567,"_30795":72455,"_21329":120909,"_5":14664,"_27997":120602,"_3043":120910},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3587":72568,"_30795":72455,"_21329":120912,"_5":14664,"_27997":120602,"_3043":120913},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3587":72569,"_30795":72455,"_21329":120915,"_5":14664,"_27997":120602,"_3043":120916},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3587":72570,"_30795":72455,"_21329":120918,"_5":14664,"_27997":120602,"_3043":120919},[],"Ten en cuenta que:",{"_3587":72571,"_30795":72455,"_21329":120921,"_5":14664,"_27997":120602,"_3043":120922},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3587":72572,"_30795":72455,"_21329":120924,"_5":14664,"_27997":120602,"_3043":120925},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3587":72573,"_30795":72455,"_21329":120927,"_5":14664,"_27997":120602,"_3043":120928},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3587":72574,"_30795":72455,"_21329":120930,"_5":14664,"_27997":120606,"_3043":120931},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3587":72575,"_30795":72455,"_21329":120933,"_5":14664,"_27997":120606,"_3043":120934},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3587":72576,"_30795":72455,"_21329":120936,"_5":14664,"_27997":120606,"_3043":120937},[],"acceso completo y de solo lectura a KMS;",{"_3587":72577,"_30795":72455,"_21329":120939,"_5":14664,"_27997":120606,"_3043":120940},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3587":72578,"_30795":72455,"_21329":120942,"_5":14664,"_27997":120606,"_3043":120943},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3587":72579,"_30795":72455,"_21329":120945,"_5":14664,"_27997":120606,"_3043":120946},[],"acceso a la interfaz;",{"_3587":72580,"_30795":72455,"_21329":120948,"_5":14664,"_27997":120606,"_3043":120949},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3587":72581,"_30795":72455,"_21329":120951,"_5":14664,"_27997":120606,"_3043":120952},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3587":72582,"_30795":72455,"_21329":120954,"_5":14664,"_27997":120606,"_3043":120955},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3587":72583,"_30795":72455,"_21329":120957,"_5":14664,"_27997":120610,"_3043":120958},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3587":72584,"_30795":72455,"_21329":120960,"_5":14664,"_27997":120610,"_3043":120961},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3587":72585,"_30795":72455,"_21329":120963,"_5":14664,"_27997":120610,"_3043":120964},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3587":72586,"_30795":72455,"_21329":120966,"_5":14664,"_27997":120613,"_3043":120967},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3587":72587,"_30795":72455,"_21329":120969,"_5":14664,"_27997":120617,"_3043":120970},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3587":72588,"_30795":72455,"_21329":120972,"_5":14664,"_27997":120617,"_3043":120973},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3587":72589,"_30795":72455,"_21329":120975,"_5":14664,"_27997":120621,"_3043":120976},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3587":72590,"_30795":72455,"_21329":120978,"_5":14664,"_27997":120625,"_3043":120979},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3587":72591,"_30795":72455,"_21329":120981,"_5":14664,"_27997":120629,"_3043":120982},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3587":72592,"_30795":72455,"_21329":120984,"_5":14664,"_27997":120633,"_3043":120985},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3587":72593,"_30795":72455,"_21329":120987,"_5":14664,"_27997":120633,"_3043":120988},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3587":72594,"_30795":72455,"_21329":120990,"_5":14664,"_27997":120637,"_3043":120991},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3587":72595,"_30795":72455,"_21329":120993,"_5":14664,"_27997":120637,"_3043":120994},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3587":72596,"_30795":72455,"_21329":120996,"_5":14664,"_27997":120637,"_3043":120997},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3587":72597,"_30795":72455,"_21329":120999,"_5":14664,"_27997":120637,"_3043":121000},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3587":72598,"_30795":72455,"_21329":121002,"_5":14664,"_27997":120637,"_3043":121003},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3587":72599,"_30795":72455,"_21329":121005,"_5":14664,"_27997":120637,"_3043":121006},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3587":72600,"_30795":72455,"_21329":121008,"_5":14664,"_27997":120637,"_3043":121009},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3587":72601,"_30795":72455,"_21329":121011,"_5":14664,"_27997":120637,"_3043":121012},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3587":72602,"_30795":72455,"_21329":121014,"_5":14664,"_27997":120641,"_3043":121015},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3587":72603,"_30795":72455,"_21329":121017,"_5":14664,"_27997":120641,"_3043":121018},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3587":72604,"_30795":72455,"_21329":121020,"_5":14664,"_27997":120641,"_3043":121021},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3587":72605,"_30795":72455,"_21329":121023,"_5":14664,"_27997":120645,"_3043":121024},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3587":72606,"_30795":72455,"_21329":121026,"_5":14664,"_27997":120645,"_3043":121027},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3587":72607,"_30795":72455,"_21329":121029,"_5":14664,"_27997":120645,"_3043":121030},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3587":72608,"_30795":72455,"_21329":121032,"_5":14664,"_27997":120645,"_3043":121033},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3587":72609,"_30795":72455,"_21329":121035,"_5":14664,"_27997":120645,"_3043":121036},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3587":72610,"_30795":72455,"_21329":121038,"_5":14664,"_27997":120645,"_3043":121039},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3587":72611,"_30795":72455,"_21329":121041,"_5":14664,"_27997":120645,"_3043":121042},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3587":72612,"_30795":72455,"_21329":121044,"_5":14664,"_27997":120645,"_3043":121045},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3587":72613,"_30795":72455,"_21329":121047,"_5":14664,"_27997":120653,"_3043":121048},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3587":72614,"_30795":72455,"_21329":121050,"_5":14664,"_27997":120657,"_3043":121051},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3587":72615,"_30795":72455,"_21329":121053,"_5":14664,"_27997":120657,"_3043":121054},[],"que exista un principal activo del tipo correcto;",{"_3587":72616,"_30795":72455,"_21329":121056,"_5":14664,"_27997":120657,"_3043":121057},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3587":72617,"_30795":72455,"_21329":121059,"_5":14664,"_27997":120657,"_3043":121060},[],"que todas las condiciones del principal se cumplan;",{"_3587":72618,"_30795":72455,"_21329":121062,"_5":14664,"_27997":120657,"_3043":121063},[],"que el principal tenga concedida la política esperada;",{"_3587":72619,"_30795":72455,"_21329":121065,"_5":14664,"_27997":120657,"_3043":121066},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3587":72620,"_30795":72455,"_21329":121068,"_5":14664,"_27997":120657,"_3043":121069},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3587":72621,"_30795":72455,"_21329":121071,"_5":14664,"_27997":120657,"_3043":121072},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3587":72622,"_30795":72455,"_21329":121074,"_5":14664,"_27997":120657,"_3043":121075},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3587":72623,"_30795":72455,"_21329":121077,"_5":14664,"_27997":120661,"_3043":121078},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3587":72624,"_30795":72455,"_21329":121080,"_5":14664,"_27997":120665,"_3043":121081},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3587":72625,"_30795":72455,"_21329":121083,"_5":14664,"_27997":120669,"_3043":121084},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3587":72626,"_30795":72455,"_21329":121086,"_5":14664,"_27997":120669,"_3043":121087},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3587":72627,"_30795":72627,"_5":15024,"_3043":121089,"_31154":121090,"_21329":121091,"_27997":72627},"Alertas y suscripciones",[50381,120436,120437],[],{"_3587":72628,"_30795":72627,"_21329":121093,"_5":14664,"_27997":72627,"_3043":121094},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3587":72629,"_30795":72627,"_5":31151,"_21329":121096,"_27997":121097,"_3043":121098},[],"/docs/pr-preview/pr-70/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3587":72630,"_30795":72627,"_5":31151,"_21329":121100,"_27997":121101,"_3043":121102},[],"/docs/pr-preview/pr-70/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3587":72631,"_30795":72627,"_5":31151,"_21329":121104,"_27997":121105,"_3043":121106},[],"/docs/pr-preview/pr-70/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3587":72632,"_30795":72627,"_5":31151,"_21329":121108,"_27997":121109,"_3043":121110},[],"/docs/pr-preview/pr-70/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3587":72633,"_30795":72627,"_5":31151,"_21329":121112,"_27997":121113,"_3043":121114},[],"/docs/pr-preview/pr-70/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3587":72634,"_30795":72627,"_5":31151,"_21329":121116,"_27997":121117,"_3043":121118},[],"/docs/pr-preview/pr-70/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3587":72635,"_30795":72627,"_5":31151,"_21329":121120,"_27997":121121,"_3043":121122},[],"/docs/pr-preview/pr-70/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3587":72636,"_30795":72627,"_5":31151,"_21329":121124,"_27997":121125,"_3043":121126},[],"/docs/pr-preview/pr-70/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3587":72637,"_30795":72627,"_5":31151,"_21329":121128,"_27997":121129,"_3043":121130},[],"/docs/pr-preview/pr-70/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3587":72638,"_30795":72627,"_5":31151,"_21329":121132,"_27997":121133,"_3043":121134},[],"/docs/pr-preview/pr-70/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3587":72639,"_30795":72627,"_5":31151,"_21329":121136,"_27997":121137,"_3043":121138},[],"/docs/pr-preview/pr-70/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3587":72640,"_30795":72627,"_21329":121140,"_5":14664,"_27997":72627,"_3043":121141},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3587":72641,"_30795":72627,"_21329":121143,"_5":14664,"_27997":121097,"_3043":121144},[],"Un servicio publica un evento de dominio.",{"_3587":72642,"_30795":72627,"_21329":121146,"_5":14664,"_27997":121097,"_3043":121147},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3587":72643,"_30795":72627,"_21329":121149,"_5":14664,"_27997":121097,"_3043":121150},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3587":72644,"_30795":72627,"_21329":121152,"_5":14664,"_27997":121097,"_3043":121153},[],"Lamassu entrega el evento al canal configurado.",{"_3587":72645,"_30795":72627,"_21329":121155,"_5":14664,"_27997":121097,"_3043":121156},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3587":72646,"_30795":72627,"_21329":121158,"_5":14664,"_27997":121101,"_3043":121159},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3587":72647,"_30795":72627,"_21329":121161,"_5":14664,"_27997":121101,"_3043":121162},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3587":72648,"_30795":72627,"_21329":121164,"_5":14664,"_27997":121101,"_3043":121165},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3587":72649,"_30795":72627,"_21329":121167,"_5":14664,"_27997":121101,"_3043":121168},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3587":72650,"_30795":72627,"_21329":121170,"_5":14664,"_27997":121101,"_3043":121171},[],"`apikey_options` necesita `header` y `key`.",{"_3587":72651,"_30795":72627,"_21329":121173,"_5":14664,"_27997":121101,"_3043":121174},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3587":72652,"_30795":72627,"_21329":121176,"_5":14664,"_27997":121101,"_3043":121177},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3587":72653,"_30795":72627,"_21329":121179,"_5":14664,"_27997":121101,"_3043":121180},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3587":72654,"_30795":72627,"_21329":121182,"_5":14664,"_27997":121109,"_3043":121183},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3587":72655,"_30795":72627,"_21329":121185,"_5":14664,"_27997":121113,"_3043":121186},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3587":72656,"_30795":72627,"_21329":121188,"_5":14664,"_27997":121117,"_3043":121189},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3587":72657,"_30795":72627,"_21329":121191,"_5":14664,"_27997":121117,"_3043":121192},[],"**None** notifica todas las instancias del evento.",{"_3587":72658,"_30795":72627,"_21329":121194,"_5":14664,"_27997":121117,"_3043":121195},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3587":72659,"_30795":72627,"_21329":121197,"_5":14664,"_27997":121117,"_3043":121198},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3587":72660,"_30795":72627,"_21329":121200,"_5":14664,"_27997":121117,"_3043":121201},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3587":72661,"_30795":72627,"_21329":121203,"_5":14664,"_27997":121117,"_3043":121204},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3587":72662,"_30795":72627,"_21329":121206,"_5":14664,"_27997":121117,"_3043":121207},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3587":72663,"_30795":72627,"_21329":121209,"_5":14664,"_27997":121121,"_3043":121210},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3587":72664,"_30795":72627,"_21329":121212,"_5":14664,"_27997":121125,"_3043":121213},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3587":72665,"_30795":72627,"_21329":121215,"_5":14664,"_27997":121125,"_3043":121216},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3587":72666,"_30795":72627,"_21329":121218,"_5":14664,"_27997":121125,"_3043":121219},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3587":72667,"_30795":72627,"_21329":121221,"_5":14664,"_27997":121125,"_3043":121222},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3587":72668,"_30795":72627,"_21329":121224,"_5":14664,"_27997":121125,"_3043":121225},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3587":72669,"_30795":72627,"_21329":121227,"_5":14664,"_27997":121125,"_3043":121228},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3587":72670,"_30795":72627,"_21329":121230,"_5":14664,"_27997":121125,"_3043":121231},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3587":72671,"_30795":72627,"_21329":121233,"_5":14664,"_27997":121125,"_3043":121234},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3587":72672,"_30795":72627,"_21329":121236,"_5":14664,"_27997":121129,"_3043":121237},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3587":72673,"_30795":72627,"_21329":121239,"_5":14664,"_27997":121129,"_3043":121240},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3587":72674,"_30795":72627,"_21329":121242,"_5":14664,"_27997":121129,"_3043":121243},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3587":72675,"_30795":72627,"_21329":121245,"_5":14664,"_27997":121129,"_3043":121246},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3587":72676,"_30795":72627,"_21329":121248,"_5":14664,"_27997":121129,"_3043":121249},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3587":72677,"_30795":72627,"_21329":121251,"_5":14664,"_27997":121129,"_3043":121252},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3587":72678,"_30795":72627,"_21329":121254,"_5":14664,"_27997":121129,"_3043":121255},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3587":72679,"_30795":72627,"_21329":121257,"_5":14664,"_27997":121129,"_3043":121258},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3587":72680,"_30795":72627,"_21329":121260,"_5":14664,"_27997":121133,"_3043":121261},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3587":72681,"_30795":72627,"_21329":121263,"_5":14664,"_27997":121133,"_3043":121264},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3587":72682,"_30795":72627,"_21329":121266,"_5":14664,"_27997":121137,"_3043":121267},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3587":72683,"_30795":72627,"_21329":121269,"_5":14664,"_27997":121137,"_3043":121270},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3587":72684,"_30795":72627,"_21329":121272,"_5":14664,"_27997":121137,"_3043":121273},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3587":72685,"_30795":72627,"_21329":121275,"_5":14664,"_27997":121137,"_3043":121276},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3587":72686,"_30795":72627,"_21329":121278,"_5":14664,"_27997":121137,"_3043":121279},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3587":72687,"_30795":72627,"_21329":121281,"_5":14664,"_27997":121137,"_3043":121282},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3587":72688,"_30795":72627,"_21329":121284,"_5":14664,"_27997":121137,"_3043":121285},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3587":72689,"_30795":72627,"_21329":121287,"_5":14664,"_27997":121137,"_3043":121288},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3587":72690,"_30795":72627,"_21329":121290,"_5":14664,"_27997":121137,"_3043":121291},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3587":72691,"_30795":72627,"_21329":121293,"_5":14664,"_27997":121137,"_3043":121294},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3587":72692,"_30795":72692,"_5":15024,"_3043":121296,"_31154":121297,"_21329":121298,"_27997":72692},"Registros de auditoría",[50381,120436,120437],[],{"_3587":72693,"_30795":72692,"_21329":121300,"_5":14664,"_27997":72692,"_3043":121301},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3587":72694,"_30795":72692,"_5":31151,"_21329":121303,"_27997":121304,"_3043":121305},[],"/docs/pr-preview/pr-70/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3587":72695,"_30795":72692,"_5":31151,"_21329":121307,"_27997":121308,"_3043":121309},[],"/docs/pr-preview/pr-70/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3587":72696,"_30795":72692,"_5":31151,"_21329":121311,"_27997":121312,"_3043":121313},[],"/docs/pr-preview/pr-70/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3587":72697,"_30795":72692,"_5":31151,"_21329":121315,"_27997":121316,"_3043":121317},[],"/docs/pr-preview/pr-70/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3587":72698,"_30795":72692,"_5":31151,"_21329":121319,"_27997":121320,"_3043":121321},[],"/docs/pr-preview/pr-70/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3587":72699,"_30795":72692,"_5":31151,"_21329":121323,"_27997":121324,"_3043":121325},[],"/docs/pr-preview/pr-70/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3587":72700,"_30795":72692,"_5":31151,"_21329":121327,"_27997":121328,"_3043":121329},[],"/docs/pr-preview/pr-70/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3587":72701,"_30795":72692,"_5":31151,"_21329":121331,"_27997":121332,"_3043":121333},[],"/docs/pr-preview/pr-70/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3587":72702,"_30795":72692,"_5":31151,"_21329":121335,"_27997":121336,"_3043":121337},[],"/docs/pr-preview/pr-70/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3587":72703,"_30795":72692,"_5":31151,"_21329":121339,"_27997":121340,"_3043":121341},[],"/docs/pr-preview/pr-70/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3587":72704,"_30795":72692,"_5":31151,"_21329":121343,"_27997":121344,"_3043":121345},[],"/docs/pr-preview/pr-70/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3587":72705,"_30795":72692,"_21329":121347,"_5":14664,"_27997":72692,"_3043":121348},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3587":72706,"_30795":72692,"_21329":121350,"_5":14664,"_27997":121304,"_3043":121351},[],"El cuerpo de auditoría incluye:",{"_3587":72707,"_30795":72692,"_21329":121353,"_5":14664,"_27997":121304,"_3043":121354},[],"input: datos recibidos por la operación;",{"_3587":72708,"_30795":72692,"_21329":121356,"_5":14664,"_27997":121304,"_3043":121357},[],"has\\_error: indica si el servicio devolvió un error;",{"_3587":72709,"_30795":72692,"_21329":121359,"_5":14664,"_27997":121304,"_3043":121360},[],"output: resultado producido o mensaje de error;",{"_3587":72710,"_30795":72692,"_21329":121362,"_5":14664,"_27997":121304,"_3043":121363},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3587":72711,"_30795":72692,"_21329":121365,"_5":14664,"_27997":121304,"_3043":121366},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3587":72712,"_30795":72692,"_21329":121368,"_5":14664,"_27997":121304,"_3043":121369},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3587":72713,"_30795":72692,"_21329":121371,"_5":14664,"_27997":121308,"_3043":121372},[],"El backend aplica auditoría a mutaciones de:",{"_3587":72714,"_30795":72692,"_21329":121374,"_5":14664,"_27997":121308,"_3043":121375},[],"autoridades, certificados y perfiles de emisión;",{"_3587":72715,"_30795":72692,"_21329":121377,"_5":14664,"_27997":121308,"_3043":121378},[],"claves y motores KMS;",{"_3587":72716,"_30795":72692,"_21329":121380,"_5":14664,"_27997":121308,"_3043":121381},[],"dispositivos e identidades;",{"_3587":72717,"_30795":72692,"_21329":121383,"_5":14664,"_27997":121308,"_3043":121384},[],"DMS y operaciones de enrolamiento;",{"_3587":72718,"_30795":72692,"_21329":121386,"_5":14664,"_27997":121308,"_3043":121387},[],"funciones de validación y CRL;",{"_3587":72719,"_30795":72692,"_21329":121389,"_5":14664,"_27997":121308,"_3043":121390},[],"principales, políticas y concesiones de autorización.",{"_3587":72720,"_30795":72692,"_21329":121392,"_5":14664,"_27997":121308,"_3043":121393},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3587":72721,"_30795":72692,"_21329":121395,"_5":14664,"_27997":121312,"_3043":121396},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3587":72722,"_30795":72692,"_21329":121398,"_5":14664,"_27997":121312,"_3043":121399},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3587":72723,"_30795":72692,"_21329":121401,"_5":14664,"_27997":121312,"_3043":121402},[],"Diseña el consumidor para:",{"_3587":72724,"_30795":72692,"_21329":121404,"_5":14664,"_27997":121312,"_3043":121405},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3587":72725,"_30795":72692,"_21329":121407,"_5":14664,"_27997":121312,"_3043":121408},[],"conservar el CloudEvent completo sin modificar;",{"_3587":72726,"_30795":72692,"_21329":121410,"_5":14664,"_27997":121312,"_3043":121411},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3587":72727,"_30795":72692,"_21329":121413,"_5":14664,"_27997":121312,"_3043":121414},[],"cifrar en tránsito y en reposo;",{"_3587":72728,"_30795":72692,"_21329":121416,"_5":14664,"_27997":121312,"_3043":121417},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3587":72729,"_30795":72692,"_21329":121419,"_5":14664,"_27997":121312,"_3043":121420},[],"aplicar una política explícita de retención y legal hold;",{"_3587":72730,"_30795":72692,"_21329":121422,"_5":14664,"_27997":121312,"_3043":121423},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3587":72731,"_30795":72692,"_21329":121425,"_5":14664,"_27997":121316,"_3043":121426},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3587":72732,"_30795":72692,"_21329":121428,"_5":14664,"_27997":121316,"_3043":121429},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3587":72733,"_30795":72692,"_21329":121431,"_5":14664,"_27997":121324,"_3043":121432},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3587":72734,"_30795":72692,"_21329":121434,"_5":14664,"_27997":121328,"_3043":121435},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3587":72735,"_30795":72692,"_21329":121437,"_5":14664,"_27997":121332,"_3043":121438},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3587":72736,"_30795":72692,"_21329":121440,"_5":14664,"_27997":121336,"_3043":121441},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3587":72737,"_30795":72692,"_21329":121443,"_5":14664,"_27997":121340,"_3043":121444},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3587":72738,"_30795":72692,"_21329":121446,"_5":14664,"_27997":121344,"_3043":121447},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3587":72739,"_30795":72692,"_21329":121449,"_5":14664,"_27997":121344,"_3043":121450},[],"aparece un evento de auditoría correcto;",{"_3587":72740,"_30795":72692,"_21329":121452,"_5":14664,"_27997":121344,"_3043":121453},[],"el principal coincide con la identidad utilizada;",{"_3587":72741,"_30795":72692,"_21329":121455,"_5":14664,"_27997":121344,"_3043":121456},[],"el consumidor lo persiste una sola vez;",{"_3587":72742,"_30795":72692,"_21329":121458,"_5":14664,"_27997":121344,"_3043":121459},[],"puede recuperarse por recurso, actor y periodo;",{"_3587":72743,"_30795":72692,"_21329":121461,"_5":14664,"_27997":121344,"_3043":121462},[],"una interrupción del consumidor produce una alerta.",{"_3587":72744,"_30795":72692,"_21329":121464,"_5":14664,"_27997":121344,"_3043":121465},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3587":72745,"_30795":72745,"_5":15024,"_3043":121467,"_31154":121468,"_21329":121469,"_27997":72745},"Arquitectura de la plataforma",[50381,120436],[],{"_3587":72746,"_30795":72745,"_21329":121471,"_5":14664,"_27997":72745,"_3043":121472},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3587":72747,"_30795":72745,"_5":31151,"_21329":121474,"_27997":121475,"_3043":121476},[],"/docs/pr-preview/pr-70/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3587":72748,"_30795":72745,"_5":31151,"_21329":121478,"_27997":121479,"_3043":121480},[],"/docs/pr-preview/pr-70/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3587":72749,"_30795":72745,"_5":31151,"_21329":121482,"_27997":121483,"_3043":121484},[],"/docs/pr-preview/pr-70/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3587":72750,"_30795":72745,"_5":31151,"_21329":121486,"_27997":121487,"_3043":121488},[],"/docs/pr-preview/pr-70/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3587":72751,"_30795":72745,"_5":31151,"_21329":121490,"_27997":121491,"_3043":121492},[],"/docs/pr-preview/pr-70/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3587":72752,"_30795":72745,"_21329":121494,"_5":14664,"_27997":72745,"_3043":121495},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3587":72753,"_30795":72745,"_21329":121497,"_5":14664,"_27997":72745,"_3043":121498},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3587":72754,"_30795":72745,"_21329":121500,"_5":14664,"_27997":121475,"_3043":121501},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3587":72755,"_30795":72745,"_21329":121503,"_5":14664,"_27997":121479,"_3043":121504},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3587":72756,"_30795":72745,"_21329":121506,"_5":14664,"_27997":121483,"_3043":121507},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3587":72757,"_30795":72745,"_21329":121509,"_5":14664,"_27997":121487,"_3043":121510},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3587":72758,"_30795":72745,"_21329":121512,"_5":14664,"_27997":121491,"_3043":121513},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3587":72759,"_30795":72759,"_5":15024,"_3043":121515,"_31154":121516,"_21329":121517,"_27997":72759},"Cómo funciona Lamassu",[50381,120436],[],{"_3587":72760,"_30795":72759,"_21329":121519,"_5":14664,"_27997":72759,"_3043":121520},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3587":72761,"_30795":72759,"_5":31151,"_21329":121522,"_27997":121523,"_3043":121524},[],"/docs/pr-preview/pr-70/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3587":72762,"_30795":72759,"_5":31151,"_21329":121526,"_27997":121527,"_3043":121528},[],"/docs/pr-preview/pr-70/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3587":72763,"_30795":72759,"_21329":121530,"_5":14664,"_27997":72759,"_3043":121531},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3587":72764,"_30795":72759,"_21329":121533,"_5":14664,"_27997":121523,"_3043":121534},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3587":72765,"_30795":72759,"_21329":121536,"_5":14664,"_27997":121523,"_3043":121537},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3587":72766,"_30795":72759,"_21329":121539,"_5":14664,"_27997":121523,"_3043":121540},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3587":72767,"_30795":72759,"_21329":121542,"_5":14664,"_27997":121523,"_3043":121543},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3587":72768,"_30795":72759,"_21329":121545,"_5":14664,"_27997":121523,"_3043":121546},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3587":72769,"_30795":72759,"_21329":121548,"_5":14664,"_27997":121527,"_3043":121549},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3587":72770,"_30795":72759,"_21329":121551,"_5":14664,"_27997":121527,"_3043":121552},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3587":72771,"_30795":72759,"_21329":121554,"_5":14664,"_27997":121527,"_3043":121555},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3587":72772,"_30795":72759,"_21329":121557,"_5":14664,"_27997":121527,"_3043":121558},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3587":72773,"_30795":72759,"_21329":121560,"_5":14664,"_27997":121527,"_3043":121561},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3587":72774,"_30795":72759,"_21329":121563,"_5":14664,"_27997":121527,"_3043":121564},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3587":72775,"_30795":72759,"_21329":121566,"_5":14664,"_27997":121527,"_3043":121567},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3587":72776,"_30795":72776,"_5":15024,"_3043":121569,"_31154":121570,"_21329":121571,"_27997":72776},"Dispositivos e identidades",[50381,120436,53053,121569],[],{"_3587":72777,"_30795":72776,"_21329":121573,"_5":14664,"_27997":72776,"_3043":121574},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3587":72778,"_30795":72776,"_5":31151,"_21329":121576,"_27997":121577,"_3043":121578},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3587":72779,"_30795":72776,"_5":31151,"_21329":121580,"_27997":121581,"_3043":121582},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3587":72780,"_30795":72776,"_5":31151,"_21329":121584,"_27997":121585,"_3043":121586},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3587":72781,"_30795":72776,"_5":31151,"_21329":121588,"_27997":121589,"_3043":121590},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3587":72782,"_30795":72776,"_5":31151,"_21329":121592,"_27997":121593,"_3043":121594},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3587":72783,"_30795":72776,"_5":31151,"_21329":121596,"_27997":121597,"_3043":121598},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3587":72784,"_30795":72776,"_5":31151,"_21329":121600,"_27997":121601,"_3043":121602},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3587":72785,"_30795":72776,"_5":31151,"_21329":121604,"_27997":121605,"_3043":121606},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3587":72786,"_30795":72776,"_5":31151,"_21329":121608,"_27997":121609,"_3043":121610},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3587":72787,"_30795":72776,"_5":31151,"_21329":121612,"_27997":121613,"_3043":121614},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3587":72788,"_30795":72776,"_5":31151,"_21329":121616,"_27997":121617,"_3043":121618},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3587":72789,"_30795":72776,"_21329":121620,"_5":14664,"_27997":72776,"_3043":121621},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3587":72790,"_30795":72776,"_21329":121623,"_5":14664,"_27997":72776,"_3043":121624},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3587":72791,"_30795":72776,"_21329":121626,"_5":14664,"_27997":121577,"_3043":121627},[],"Vista operativa",{"_3587":72792,"_30795":72776,"_21329":121629,"_5":14664,"_27997":121577,"_3043":121630},[],"Interpretación",{"_3587":72793,"_30795":72776,"_21329":121632,"_5":14664,"_27997":121577,"_3043":53116},[],{"_3587":72794,"_30795":72776,"_21329":121634,"_5":14664,"_27997":121577,"_3043":121635},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3587":72795,"_30795":72776,"_21329":121637,"_5":14664,"_27997":121577,"_3043":53122},[],{"_3587":72796,"_30795":72776,"_21329":121639,"_5":14664,"_27997":121577,"_3043":121640},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3587":72797,"_30795":72776,"_21329":121642,"_5":14664,"_27997":121577,"_3043":53128},[],{"_3587":72798,"_30795":72776,"_21329":121644,"_5":14664,"_27997":121577,"_3043":121645},[],"La identidad está en la ventana operativa de renovación.",{"_3587":72799,"_30795":72776,"_21329":121647,"_5":14664,"_27997":121577,"_3043":53134},[],{"_3587":72800,"_30795":72776,"_21329":121649,"_5":14664,"_27997":121577,"_3043":121650},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3587":72801,"_30795":72776,"_21329":121652,"_5":14664,"_27997":121577,"_3043":53140},[],{"_3587":72802,"_30795":72776,"_21329":121654,"_5":14664,"_27997":121577,"_3043":121655},[],"La identidad ha vencido.",{"_3587":72803,"_30795":72776,"_21329":121657,"_5":14664,"_27997":121577,"_3043":53146},[],{"_3587":72804,"_30795":72776,"_21329":121659,"_5":14664,"_27997":121577,"_3043":121660},[],"La identidad está marcada como revocada.",{"_3587":72805,"_30795":72776,"_21329":121662,"_5":14664,"_27997":121577,"_3043":53152},[],{"_3587":72806,"_30795":72776,"_21329":121664,"_5":14664,"_27997":121577,"_3043":121665},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3587":72807,"_30795":72776,"_21329":121667,"_5":14664,"_27997":121577,"_3043":121668},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3587":72808,"_30795":72776,"_21329":121670,"_5":14664,"_27997":121581,"_3043":121671},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3587":72809,"_30795":72776,"_21329":121673,"_5":14664,"_27997":121581,"_3043":121674},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3587":72810,"_30795":72776,"_21329":121676,"_5":14664,"_27997":121581,"_3043":121677},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3587":72811,"_30795":72776,"_21329":121679,"_5":14664,"_27997":121581,"_3043":121680},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3587":72812,"_30795":72776,"_21329":121682,"_5":14664,"_27997":121585,"_3043":121683},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3587":72813,"_30795":72776,"_21329":121685,"_5":14664,"_27997":121589,"_3043":121686},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3587":72814,"_30795":72776,"_21329":121688,"_5":14664,"_27997":121593,"_3043":121689},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3587":72815,"_30795":72776,"_21329":121691,"_5":14664,"_27997":121597,"_3043":121692},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3587":72816,"_30795":72776,"_21329":121694,"_5":14664,"_27997":121601,"_3043":121695},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3587":72817,"_30795":72776,"_21329":121697,"_5":14664,"_27997":121601,"_3043":121698},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3587":72818,"_30795":72776,"_21329":121700,"_5":14664,"_27997":121605,"_3043":121701},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3587":72819,"_30795":72776,"_21329":121703,"_5":14664,"_27997":121605,"_3043":121704},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3587":72820,"_30795":72776,"_21329":121706,"_5":14664,"_27997":121605,"_3043":121707},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3587":72821,"_30795":72776,"_21329":121709,"_5":14664,"_27997":121605,"_3043":121710},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3587":72822,"_30795":72776,"_21329":121712,"_5":14664,"_27997":121605,"_3043":121713},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3587":72823,"_30795":72776,"_21329":121715,"_5":14664,"_27997":121605,"_3043":121716},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3587":72824,"_30795":72776,"_21329":121718,"_5":14664,"_27997":121609,"_3043":121719},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3587":72825,"_30795":72776,"_21329":121721,"_5":14664,"_27997":121609,"_3043":121722},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3587":72826,"_30795":72776,"_21329":121724,"_5":14664,"_27997":121613,"_3043":121725},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3587":72827,"_30795":72776,"_21329":121727,"_5":14664,"_27997":121613,"_3043":121728},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3587":72828,"_30795":72776,"_21329":121730,"_5":14664,"_27997":121613,"_3043":121731},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3587":72829,"_30795":72776,"_21329":121733,"_5":14664,"_27997":121613,"_3043":121734},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3587":72830,"_30795":72776,"_21329":121736,"_5":14664,"_27997":121617,"_3043":121737},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3587":72831,"_30795":72776,"_21329":121739,"_5":14664,"_27997":121617,"_3043":121740},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3587":72832,"_30795":72832,"_5":15024,"_3043":121742,"_31154":121743,"_21329":121745,"_27997":72832},"Identidad inicial y autenticación",[50381,120436,53053,121569,121744],"Enrolamiento con PKI",[],{"_3587":72833,"_30795":72832,"_21329":121747,"_5":14664,"_27997":72832,"_3043":121748},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3587":72834,"_30795":72832,"_5":31151,"_21329":121750,"_27997":121751,"_3043":121752},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3587":72835,"_30795":72832,"_5":31151,"_21329":121754,"_27997":121755,"_3043":121756},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3587":72836,"_30795":72832,"_5":31151,"_21329":121758,"_27997":121759,"_3043":121760},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3587":72837,"_30795":72832,"_5":31151,"_21329":121762,"_27997":121763,"_3043":121764},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3587":72838,"_30795":72832,"_5":31151,"_21329":121766,"_27997":121767,"_3043":121768},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3587":72839,"_30795":72832,"_21329":121770,"_5":14664,"_27997":72832,"_3043":121771},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3587":72840,"_30795":72832,"_21329":121773,"_5":14664,"_27997":121751,"_3043":121774},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3587":72841,"_30795":72832,"_21329":121776,"_5":14664,"_27997":121751,"_3043":121777},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3587":72842,"_30795":72832,"_21329":121779,"_5":14664,"_27997":121755,"_3043":121780},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3587":72843,"_30795":72832,"_21329":121782,"_5":14664,"_27997":121755,"_3043":121783},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3587":72844,"_30795":72832,"_21329":121785,"_5":14664,"_27997":121755,"_3043":121786},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3587":72845,"_30795":72832,"_21329":121788,"_5":14664,"_27997":121759,"_3043":121789},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3587":72846,"_30795":72832,"_21329":121791,"_5":14664,"_27997":121759,"_3043":121792},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3587":72847,"_30795":72832,"_21329":121794,"_5":14664,"_27997":121763,"_3043":121795},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3587":72848,"_30795":72832,"_21329":121797,"_5":14664,"_27997":121763,"_3043":121798},[],"Ejemplo de cuerpo:",{"_3587":72849,"_30795":72832,"_21329":121800,"_5":14664,"_27997":121763,"_3043":121801},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3587":72850,"_30795":72832,"_21329":121803,"_5":14664,"_27997":121763,"_3043":121804},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3587":72851,"_30795":72832,"_21329":121806,"_5":14664,"_27997":121763,"_3043":121807},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3587":72852,"_30795":72832,"_21329":121809,"_5":14664,"_27997":121763,"_3043":121810},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3587":72853,"_30795":72832,"_21329":121812,"_5":14664,"_27997":121767,"_3043":121813},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3587":72854,"_30795":72832,"_21329":121815,"_5":14664,"_27997":121767,"_3043":121816},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3587":72855,"_30795":72855,"_5":15024,"_3043":121818,"_31154":121819,"_21329":121820,"_27997":72855},"Configura y opera el DMS",[50381,120436,53053,121569,121744],[],{"_3587":72856,"_30795":72855,"_21329":121822,"_5":14664,"_27997":72855,"_3043":121823},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3587":72857,"_30795":72855,"_5":31151,"_21329":121825,"_27997":121826,"_3043":118970},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3587":72858,"_30795":72855,"_5":31151,"_21329":121828,"_27997":121829,"_3043":121830},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3587":72859,"_30795":72855,"_5":31151,"_21329":121832,"_27997":121833,"_3043":121834},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3587":72860,"_30795":72855,"_5":31151,"_21329":121836,"_27997":121837,"_3043":121838},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3587":72861,"_30795":72855,"_5":31151,"_21329":121840,"_27997":121841,"_3043":121842},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3587":72862,"_30795":72855,"_5":31151,"_21329":121844,"_27997":121845,"_3043":121846},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3587":72863,"_30795":72855,"_5":31151,"_21329":121848,"_27997":121849,"_3043":121850},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3587":72864,"_30795":72855,"_5":31151,"_21329":121852,"_27997":121853,"_3043":121854},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3587":72865,"_30795":72855,"_5":31151,"_21329":121856,"_27997":121857,"_3043":53348},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3587":72866,"_30795":72855,"_5":31151,"_21329":121859,"_27997":121860,"_3043":53352},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3587":72867,"_30795":72855,"_5":31151,"_21329":121862,"_27997":121863,"_3043":121864},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3587":72868,"_30795":72855,"_5":31151,"_21329":121866,"_27997":121867,"_3043":121868},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3587":72869,"_30795":72855,"_5":31151,"_21329":121870,"_27997":121871,"_3043":121872},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3587":72870,"_30795":72855,"_5":31151,"_21329":121874,"_27997":121875,"_3043":121876},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3587":72871,"_30795":72855,"_5":31151,"_21329":121878,"_27997":121879,"_3043":53372},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3587":72872,"_30795":72855,"_5":31151,"_21329":121881,"_27997":121882,"_3043":121883},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3587":72873,"_30795":72855,"_5":31151,"_21329":121885,"_27997":121886,"_3043":121887},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3587":72874,"_30795":72855,"_5":31151,"_21329":121889,"_27997":121890,"_3043":121891},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3587":72875,"_30795":72855,"_21329":121893,"_5":14664,"_27997":72855,"_3043":121894},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3587":72876,"_30795":72855,"_21329":121896,"_5":14664,"_27997":121826,"_3043":121897},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3587":72877,"_30795":72855,"_21329":121899,"_5":14664,"_27997":121826,"_3043":121900},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3587":72878,"_30795":72855,"_21329":121902,"_5":14664,"_27997":121833,"_3043":121903},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3587":72879,"_30795":72855,"_21329":121905,"_5":14664,"_27997":121837,"_3043":121906},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3587":72880,"_30795":72855,"_21329":121908,"_5":14664,"_27997":121841,"_3043":121909},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3587":72881,"_30795":72855,"_21329":121911,"_5":14664,"_27997":121845,"_3043":121912},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3587":72882,"_30795":72855,"_21329":121914,"_5":14664,"_27997":121849,"_3043":121915},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3587":72883,"_30795":72855,"_21329":121917,"_5":14664,"_27997":121857,"_3043":121918},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3587":72884,"_30795":72855,"_21329":121920,"_5":14664,"_27997":121857,"_3043":121921},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3587":72885,"_30795":72855,"_21329":121923,"_5":14664,"_27997":121860,"_3043":121924},[],"Campo de `settings.enrollment_settings`",{"_3587":72886,"_30795":72855,"_21329":121926,"_5":14664,"_27997":121860,"_3043":121927},[],"Decisión",{"_3587":72887,"_30795":72855,"_21329":121929,"_5":14664,"_27997":121860,"_3043":53423},[],{"_3587":72888,"_30795":72855,"_21329":121931,"_5":14664,"_27997":121860,"_3043":121932},[],"`EST_RFC7030` para estas operaciones.",{"_3587":72889,"_30795":72855,"_21329":121934,"_5":14664,"_27997":121860,"_3043":53429},[],{"_3587":72890,"_30795":72855,"_21329":121936,"_5":14664,"_27997":121860,"_3043":121937},[],"ID de la CA que firmará.",{"_3587":72891,"_30795":72855,"_21329":121939,"_5":14664,"_27997":121860,"_3043":53435},[],{"_3587":72892,"_30795":72855,"_21329":121941,"_5":14664,"_27997":121860,"_3043":121942},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3587":72893,"_30795":72855,"_21329":121944,"_5":14664,"_27997":121860,"_3043":53441},[],{"_3587":72894,"_30795":72855,"_21329":121946,"_5":14664,"_27997":121860,"_3043":121947},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3587":72895,"_30795":72855,"_21329":121949,"_5":14664,"_27997":121860,"_3043":53447},[],{"_3587":72896,"_30795":72855,"_21329":121951,"_5":14664,"_27997":121860,"_3043":121952},[],"Uno de los cuatro modos de autenticación.",{"_3587":72897,"_30795":72855,"_21329":121954,"_5":14664,"_27997":121860,"_3043":121955},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3587":72898,"_30795":72855,"_21329":121957,"_5":14664,"_27997":121863,"_3043":121958},[],"Los bloques son independientes:",{"_3587":72899,"_30795":72855,"_21329":121960,"_5":14664,"_27997":121863,"_3043":121961},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3587":72900,"_30795":72855,"_21329":121963,"_5":14664,"_27997":121863,"_3043":121964},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3587":72901,"_30795":72855,"_21329":121966,"_5":14664,"_27997":121863,"_3043":53465},[],{"_3587":72902,"_30795":72855,"_21329":121968,"_5":14664,"_27997":121863,"_3043":121969},[],"Control aplicado en la operación configurada",{"_3587":72903,"_30795":72855,"_21329":121971,"_5":14664,"_27997":121863,"_3043":53471},[],{"_3587":72904,"_30795":72855,"_21329":121973,"_5":14664,"_27997":121863,"_3043":121974},[],"Validación del certificado presentado.",{"_3587":72905,"_30795":72855,"_21329":121976,"_5":14664,"_27997":121863,"_3043":53477},[],{"_3587":72906,"_30795":72855,"_21329":121978,"_5":14664,"_27997":121863,"_3043":121979},[],"Autorización del webhook configurado.",{"_3587":72907,"_30795":72855,"_21329":121981,"_5":14664,"_27997":121863,"_3043":53483},[],{"_3587":72908,"_30795":72855,"_21329":121983,"_5":14664,"_27997":121863,"_3043":121984},[],"Validación del certificado y, después, aprobación del webhook.",{"_3587":72909,"_30795":72855,"_21329":121986,"_5":14664,"_27997":121863,"_3043":53489},[],{"_3587":72910,"_30795":72855,"_21329":121988,"_5":14664,"_27997":121863,"_3043":121989},[],"Sin autenticación del solicitante por el DMS.",{"_3587":72911,"_30795":72855,"_21329":121991,"_5":14664,"_27997":121863,"_3043":121992},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3587":72912,"_30795":72855,"_21329":121994,"_5":14664,"_27997":121863,"_3043":121995},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3587":72913,"_30795":72855,"_21329":121997,"_5":14664,"_27997":121863,"_3043":121998},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3587":72914,"_30795":72855,"_21329":122000,"_5":14664,"_27997":121863,"_3043":122001},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3587":72915,"_30795":72855,"_21329":122003,"_5":14664,"_27997":121867,"_3043":122004},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3587":72916,"_30795":72855,"_21329":122006,"_5":14664,"_27997":121867,"_3043":122007},[],"Campo de `external_webhook_settings`",{"_3587":72917,"_30795":72855,"_21329":122009,"_5":14664,"_27997":121867,"_3043":121927},[],{"_3587":72918,"_30795":72855,"_21329":122011,"_5":14664,"_27997":121867,"_3043":53515},[],{"_3587":72919,"_30795":72855,"_21329":122013,"_5":14664,"_27997":121867,"_3043":122014},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3587":72920,"_30795":72855,"_21329":122016,"_5":14664,"_27997":121867,"_3043":53521},[],{"_3587":72921,"_30795":72855,"_21329":122018,"_5":14664,"_27997":121867,"_3043":122019},[],"`POST` o `PUT`; `POST` por defecto.",{"_3587":72922,"_30795":72855,"_21329":122021,"_5":14664,"_27997":121867,"_3043":53527},[],{"_3587":72923,"_30795":72855,"_21329":122023,"_5":14664,"_27997":121867,"_3043":122024},[],"Etiqueta usada en los logs del servicio.",{"_3587":72924,"_30795":72855,"_21329":122026,"_5":14664,"_27997":121867,"_3043":53533},[],{"_3587":72925,"_30795":72855,"_21329":122028,"_5":14664,"_27997":121867,"_3043":122029},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3587":72926,"_30795":72855,"_21329":122031,"_5":14664,"_27997":121867,"_3043":53539},[],{"_3587":72927,"_30795":72855,"_21329":122033,"_5":14664,"_27997":121867,"_3043":122034},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3587":72928,"_30795":72855,"_21329":122036,"_5":14664,"_27997":121867,"_3043":53545},[],{"_3587":72929,"_30795":72855,"_21329":122038,"_5":14664,"_27997":121867,"_3043":122039},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3587":72930,"_30795":72855,"_21329":122041,"_5":14664,"_27997":121867,"_3043":53551},[],{"_3587":72931,"_30795":72855,"_21329":122043,"_5":14664,"_27997":121867,"_3043":122044},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3587":72932,"_30795":72855,"_21329":122046,"_5":14664,"_27997":121867,"_3043":53557},[],{"_3587":72933,"_30795":72855,"_21329":122048,"_5":14664,"_27997":121867,"_3043":122049},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3587":72934,"_30795":72855,"_21329":122051,"_5":14664,"_27997":121867,"_3043":53563},[],{"_3587":72935,"_30795":72855,"_21329":122053,"_5":14664,"_27997":121867,"_3043":122054},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3587":72936,"_30795":72855,"_21329":122056,"_5":14664,"_27997":121867,"_3043":53569},[],{"_3587":72937,"_30795":72855,"_21329":122058,"_5":14664,"_27997":121867,"_3043":122059},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3587":72938,"_30795":72855,"_21329":122061,"_5":14664,"_27997":121867,"_3043":122062},[],"Reglas de esa configuración:",{"_3587":72939,"_30795":72855,"_21329":122064,"_5":14664,"_27997":121867,"_3043":122065},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3587":72940,"_30795":72855,"_21329":122067,"_5":14664,"_27997":121867,"_3043":122068},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3587":72941,"_30795":72855,"_21329":122070,"_5":14664,"_27997":121867,"_3043":122071},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3587":72942,"_30795":72855,"_21329":122073,"_5":14664,"_27997":121867,"_3043":122074},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3587":72943,"_30795":72855,"_21329":122076,"_5":14664,"_27997":121867,"_3043":122077},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3587":72944,"_30795":72855,"_21329":122079,"_5":14664,"_27997":121867,"_3043":122080},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3587":72945,"_30795":72855,"_21329":122082,"_5":14664,"_27997":121867,"_3043":122083},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3587":72946,"_30795":72855,"_21329":122085,"_5":14664,"_27997":121867,"_3043":122086},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3587":72947,"_30795":72855,"_21329":122088,"_5":14664,"_27997":121867,"_3043":122089},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3587":72948,"_30795":72855,"_21329":122091,"_5":14664,"_27997":121871,"_3043":122092},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3587":72949,"_30795":72855,"_21329":122094,"_5":14664,"_27997":121875,"_3043":122095},[],"Campo de `settings.reenrollment_settings`",{"_3587":72950,"_30795":72855,"_21329":122097,"_5":14664,"_27997":121875,"_3043":122098},[],"Función",{"_3587":72951,"_30795":72855,"_21329":122100,"_5":14664,"_27997":121875,"_3043":53613},[],{"_3587":72952,"_30795":72855,"_21329":122102,"_5":14664,"_27997":121875,"_3043":122103},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3587":72953,"_30795":72855,"_21329":122105,"_5":14664,"_27997":121875,"_3043":53619},[],{"_3587":72954,"_30795":72855,"_21329":122107,"_5":14664,"_27997":121875,"_3043":122108},[],"Umbral operativo preventivo de monitorización.",{"_3587":72955,"_30795":72855,"_21329":122110,"_5":14664,"_27997":121875,"_3043":53625},[],{"_3587":72956,"_30795":72855,"_21329":122112,"_5":14664,"_27997":121875,"_3043":122113},[],"Umbral operativo crítico de monitorización.",{"_3587":72957,"_30795":72855,"_21329":122115,"_5":14664,"_27997":121875,"_3043":53631},[],{"_3587":72958,"_30795":72855,"_21329":122117,"_5":14664,"_27997":121875,"_3043":122118},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3587":72959,"_30795":72855,"_21329":122120,"_5":14664,"_27997":121875,"_3043":53637},[],{"_3587":72960,"_30795":72855,"_21329":122122,"_5":14664,"_27997":121875,"_3043":122123},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3587":72961,"_30795":72855,"_21329":122125,"_5":14664,"_27997":121875,"_3043":53643},[],{"_3587":72962,"_30795":72855,"_21329":122127,"_5":14664,"_27997":121875,"_3043":122128},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3587":72963,"_30795":72855,"_21329":122130,"_5":14664,"_27997":121875,"_3043":122131},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3587":72964,"_30795":72855,"_21329":122133,"_5":14664,"_27997":121879,"_3043":122134},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3587":72965,"_30795":72855,"_21329":122136,"_5":14664,"_27997":121882,"_3043":119334},[],{"_3587":72966,"_30795":72855,"_21329":122138,"_5":14664,"_27997":121882,"_3043":122139},[],"Qué publica",{"_3587":72967,"_30795":72855,"_21329":122141,"_5":14664,"_27997":121882,"_3043":53660},[],{"_3587":72968,"_30795":72855,"_21329":122143,"_5":14664,"_27997":121882,"_3043":122144},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3587":72969,"_30795":72855,"_21329":122146,"_5":14664,"_27997":121882,"_3043":53666},[],{"_3587":72970,"_30795":72855,"_21329":122148,"_5":14664,"_27997":121882,"_3043":122149},[],"Certificado de la CA emisora seleccionada.",{"_3587":72971,"_30795":72855,"_21329":122151,"_5":14664,"_27997":121882,"_3043":53672},[],{"_3587":72972,"_30795":72855,"_21329":122153,"_5":14664,"_27997":121882,"_3043":122154},[],"Certificados de las CAs elegidas explícitamente.",{"_3587":72973,"_30795":72855,"_21329":122156,"_5":14664,"_27997":121882,"_3043":122157},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3587":72974,"_30795":72855,"_21329":122159,"_5":14664,"_27997":121886,"_3043":122160},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3587":72975,"_30795":72855,"_21329":122162,"_5":14664,"_27997":121886,"_3043":122163},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3587":72976,"_30795":72855,"_21329":122165,"_5":14664,"_27997":121886,"_3043":122166},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3587":72977,"_30795":72855,"_21329":122168,"_5":14664,"_27997":121890,"_3043":122169},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3587":72978,"_30795":72978,"_5":15024,"_3043":122171,"_31154":122172,"_21329":122173,"_27997":72978},"Integra el cliente EST",[50381,120436,53053,121569,121744],[],{"_3587":72979,"_30795":72978,"_21329":122175,"_5":14664,"_27997":72978,"_3043":122176},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3587":72980,"_30795":72978,"_5":31151,"_21329":122178,"_27997":122179,"_3043":118970},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3587":72981,"_30795":72978,"_5":31151,"_21329":122181,"_27997":122182,"_3043":122183},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3587":72982,"_30795":72978,"_5":31151,"_21329":122185,"_27997":122186,"_3043":122187},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3587":72983,"_30795":72978,"_5":31151,"_21329":122189,"_27997":122190,"_3043":122191},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3587":72984,"_30795":72978,"_5":31151,"_21329":122193,"_27997":122194,"_3043":122195},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3587":72985,"_30795":72978,"_5":31151,"_21329":122197,"_27997":122198,"_3043":122199},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3587":72986,"_30795":72978,"_21329":122201,"_5":14664,"_27997":72978,"_3043":122202},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3587":72987,"_30795":72978,"_21329":122204,"_5":14664,"_27997":122179,"_3043":122205},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3587":72988,"_30795":72978,"_21329":122207,"_5":14664,"_27997":122179,"_3043":122208},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3587":72989,"_30795":72978,"_21329":122210,"_5":14664,"_27997":122179,"_3043":122211},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3587":72990,"_30795":72978,"_21329":122213,"_5":14664,"_27997":122182,"_3043":122214},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3587":72991,"_30795":72978,"_21329":122216,"_5":14664,"_27997":122182,"_3043":122217},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3587":72992,"_30795":72978,"_21329":122219,"_5":14664,"_27997":122186,"_3043":122220},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3587":72993,"_30795":72978,"_21329":122222,"_5":14664,"_27997":122186,"_3043":122223},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3587":72994,"_30795":72978,"_21329":122225,"_5":14664,"_27997":122190,"_3043":122226},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3587":72995,"_30795":72978,"_21329":122228,"_5":14664,"_27997":122190,"_3043":122229},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3587":72996,"_30795":72978,"_21329":122231,"_5":14664,"_27997":122194,"_3043":122232},[],"Para el caso de una raíz que emite directamente:",{"_3587":72997,"_30795":72978,"_21329":122234,"_5":14664,"_27997":122194,"_3043":122235},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3587":72998,"_30795":72978,"_21329":122237,"_5":14664,"_27997":122194,"_3043":122238},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3587":72999,"_30795":72978,"_21329":122240,"_5":14664,"_27997":122198,"_3043":122241},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3587":73000,"_30795":73000,"_5":15024,"_3043":122243,"_31154":122244,"_21329":122245,"_27997":73000},"Referencia EST",[50381,120436,53053,121569,121744],[],{"_3587":73001,"_30795":73000,"_21329":122247,"_5":14664,"_27997":73000,"_3043":122248},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3587":73002,"_30795":73000,"_5":31151,"_21329":122250,"_27997":122251,"_3043":122252},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3587":73003,"_30795":73000,"_5":31151,"_21329":122254,"_27997":122255,"_3043":23110},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3587":73004,"_30795":73000,"_5":31151,"_21329":122257,"_27997":122258,"_3043":26553},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3587":73005,"_30795":73000,"_5":31151,"_21329":122260,"_27997":122261,"_3043":26560},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3587":73006,"_30795":73000,"_5":31151,"_21329":122263,"_27997":122264,"_3043":25846},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3587":73007,"_30795":73000,"_5":31151,"_21329":122266,"_27997":122267,"_3043":122268},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3587":73008,"_30795":73000,"_5":31151,"_21329":122270,"_27997":122271,"_3043":122272},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3587":73009,"_30795":73000,"_5":31151,"_21329":122274,"_27997":122275,"_3043":122276},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3587":73010,"_30795":73000,"_21329":122278,"_5":14664,"_27997":73000,"_3043":122279},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3587":73011,"_30795":73000,"_21329":122281,"_5":14664,"_27997":122251,"_3043":122282},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3587":73012,"_30795":73000,"_21329":122284,"_5":14664,"_27997":122251,"_3043":120196},[],{"_3587":73013,"_30795":73000,"_21329":122286,"_5":14664,"_27997":122251,"_3043":122287},[],"Método",{"_3587":73014,"_30795":73000,"_21329":122289,"_5":14664,"_27997":122251,"_3043":122290},[],"Autenticación y condición",{"_3587":73015,"_30795":73000,"_21329":122292,"_5":14664,"_27997":122251,"_3043":53815},[],{"_3587":73016,"_30795":73000,"_21329":122294,"_5":14664,"_27997":122251,"_3043":53818},[],{"_3587":73017,"_30795":73000,"_21329":122296,"_5":14664,"_27997":122251,"_3043":122297},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3587":73018,"_30795":73000,"_21329":122299,"_5":14664,"_27997":122251,"_3043":53824},[],{"_3587":73019,"_30795":73000,"_21329":122301,"_5":14664,"_27997":122251,"_3043":53827},[],{"_3587":73020,"_30795":73000,"_21329":122303,"_5":14664,"_27997":122251,"_3043":122304},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3587":73021,"_30795":73000,"_21329":122306,"_5":14664,"_27997":122251,"_3043":53833},[],{"_3587":73022,"_30795":73000,"_21329":122308,"_5":14664,"_27997":122251,"_3043":53827},[],{"_3587":73023,"_30795":73000,"_21329":122310,"_5":14664,"_27997":122251,"_3043":122311},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3587":73024,"_30795":73000,"_21329":122313,"_5":14664,"_27997":122251,"_3043":53841},[],{"_3587":73025,"_30795":73000,"_21329":122315,"_5":14664,"_27997":122251,"_3043":53827},[],{"_3587":73026,"_30795":73000,"_21329":122317,"_5":14664,"_27997":122251,"_3043":122318},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3587":73027,"_30795":73000,"_21329":122320,"_5":14664,"_27997":122251,"_3043":122321},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3587":73028,"_30795":73000,"_21329":122323,"_5":14664,"_27997":122255,"_3043":122324},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3587":73029,"_30795":73000,"_21329":122326,"_5":14664,"_27997":122255,"_3043":122327},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3587":73030,"_30795":73000,"_21329":122329,"_5":14664,"_27997":122258,"_3043":122330},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3587":73031,"_30795":73000,"_21329":122332,"_5":14664,"_27997":122258,"_3043":122333},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3587":73032,"_30795":73000,"_21329":122335,"_5":14664,"_27997":122261,"_3043":122336},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3587":73033,"_30795":73000,"_21329":122338,"_5":14664,"_27997":122261,"_3043":122339},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3587":73034,"_30795":73000,"_21329":122341,"_5":14664,"_27997":122264,"_3043":122342},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3587":73035,"_30795":73000,"_21329":122344,"_5":14664,"_27997":122264,"_3043":122345},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3587":73036,"_30795":73000,"_21329":122347,"_5":14664,"_27997":122267,"_3043":122348},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3587":73037,"_30795":73000,"_21329":122350,"_5":14664,"_27997":122267,"_3043":122351},[],"Parte",{"_3587":73038,"_30795":73000,"_21329":122353,"_5":14664,"_27997":122267,"_3043":122354},[],"Contenido tras decodificar su Base64",{"_3587":73039,"_30795":73000,"_21329":122356,"_5":14664,"_27997":122267,"_3043":53885},[],{"_3587":73040,"_30795":73000,"_21329":122358,"_5":14664,"_27997":122267,"_3043":122359},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3587":73041,"_30795":73000,"_21329":122361,"_5":14664,"_27997":122267,"_3043":53891},[],{"_3587":73042,"_30795":73000,"_21329":122363,"_5":14664,"_27997":122267,"_3043":122364},[],"PKCS#7 DER con el certificado emitido.",{"_3587":73043,"_30795":73000,"_21329":122366,"_5":14664,"_27997":122267,"_3043":122367},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3587":73044,"_30795":73000,"_21329":122369,"_5":14664,"_27997":122271,"_3043":122370},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3587":73045,"_30795":73000,"_21329":122372,"_5":14664,"_27997":122271,"_3043":122373},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3587":73046,"_30795":73000,"_21329":122375,"_5":14664,"_27997":122271,"_3043":122376},[],"Convierte y comprueba el resultado:",{"_3587":73047,"_30795":73000,"_21329":122378,"_5":14664,"_27997":122271,"_3043":122379},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3587":73048,"_30795":73000,"_21329":122381,"_5":14664,"_27997":122275,"_3043":122382},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3587":73049,"_30795":73000,"_21329":122384,"_5":14664,"_27997":122275,"_3043":122385},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3587":73050,"_30795":73050,"_5":15024,"_3043":121744,"_31154":122387,"_21329":122388,"_27997":73050},[50381,120436,53053,121569,121744],[],{"_3587":73051,"_30795":73050,"_21329":122390,"_5":14664,"_27997":73050,"_3043":122391},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3587":73052,"_30795":73050,"_5":31151,"_21329":122393,"_27997":122394,"_3043":122395},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3587":73053,"_30795":73050,"_5":31151,"_21329":122397,"_27997":122398,"_3043":122399},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3587":73054,"_30795":73050,"_5":31151,"_21329":122401,"_27997":122402,"_3043":122403},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3587":73055,"_30795":73050,"_5":31151,"_21329":122405,"_27997":122406,"_3043":122407},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3587":73056,"_30795":73050,"_21329":122409,"_5":14664,"_27997":73050,"_3043":122410},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3587":73057,"_30795":73050,"_21329":122412,"_5":14664,"_27997":122394,"_3043":122413},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3587":73058,"_30795":73050,"_21329":122415,"_5":14664,"_27997":122394,"_3043":122416},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3587":73059,"_30795":73050,"_21329":122418,"_5":14664,"_27997":122394,"_3043":122419},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3587":73060,"_30795":73050,"_21329":122421,"_5":14664,"_27997":122394,"_3043":122422},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3587":73061,"_30795":73050,"_21329":122424,"_5":14664,"_27997":122394,"_3043":122425},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3587":73062,"_30795":73050,"_21329":122427,"_5":14664,"_27997":122394,"_3043":122428},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3587":73063,"_30795":73050,"_21329":122430,"_5":14664,"_27997":122398,"_3043":122431},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3587":73064,"_30795":73050,"_21329":122433,"_5":14664,"_27997":122398,"_3043":122434},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3587":73065,"_30795":73050,"_21329":122436,"_5":14664,"_27997":122398,"_3043":122437},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3587":73066,"_30795":73050,"_21329":122439,"_5":14664,"_27997":122398,"_3043":122440},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3587":73067,"_30795":73050,"_21329":122442,"_5":14664,"_27997":122402,"_3043":122443},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3587":73068,"_30795":73050,"_21329":122445,"_5":14664,"_27997":122402,"_3043":122446},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3587":73069,"_30795":73050,"_21329":122448,"_5":14664,"_27997":122402,"_3043":122449},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3587":73070,"_30795":73050,"_21329":122451,"_5":14664,"_27997":122402,"_3043":122452},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3587":73071,"_30795":73050,"_21329":122454,"_5":14664,"_27997":122406,"_3043":122455},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3587":73072,"_30795":73050,"_21329":122457,"_5":14664,"_27997":122406,"_3043":122458},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3587":73073,"_30795":73073,"_5":15024,"_3043":122460,"_31154":122461,"_21329":122462,"_27997":73073},"Estrategias de aprovisionamiento",[50381,120436,53053,121569,121744],[],{"_3587":73074,"_30795":73073,"_21329":122464,"_5":14664,"_27997":73073,"_3043":122465},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3587":73075,"_30795":73073,"_5":31151,"_21329":122467,"_27997":122468,"_3043":122469},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3587":73076,"_30795":73073,"_5":31151,"_21329":122471,"_27997":122472,"_3043":122473},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3587":73077,"_30795":73073,"_5":31151,"_21329":122475,"_27997":122476,"_3043":122477},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3587":73078,"_30795":73073,"_5":31151,"_21329":122479,"_27997":122480,"_3043":122481},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3587":73079,"_30795":73073,"_5":31151,"_21329":122483,"_27997":122484,"_3043":122485},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3587":73080,"_30795":73073,"_21329":122487,"_5":14664,"_27997":73073,"_3043":122488},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3587":73081,"_30795":73073,"_21329":122490,"_5":14664,"_27997":122468,"_3043":122491},[],"Recorrido",{"_3587":73082,"_30795":73073,"_21329":122493,"_5":14664,"_27997":122468,"_3043":122494},[],"Cuándo existe el dispositivo",{"_3587":73083,"_30795":73073,"_21329":122496,"_5":14664,"_27997":122468,"_3043":122497},[],"Qué compruebas",{"_3587":73084,"_30795":73073,"_21329":122499,"_5":14664,"_27997":122468,"_3043":122500},[],"Asignación manual",{"_3587":73085,"_30795":73073,"_21329":122502,"_5":14664,"_27997":122468,"_3043":122503},[],"El operador lo crea antes de asociar un certificado.",{"_3587":73086,"_30795":73073,"_21329":122505,"_5":14664,"_27997":122468,"_3043":122506},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3587":73087,"_30795":73073,"_21329":122508,"_5":14664,"_27997":122468,"_3043":122509},[],"EST con `JITP`",{"_3587":73088,"_30795":73073,"_21329":122511,"_5":14664,"_27997":122468,"_3043":122512},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3587":73089,"_30795":73073,"_21329":122514,"_5":14664,"_27997":122468,"_3043":122515},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3587":73090,"_30795":73073,"_21329":122517,"_5":14664,"_27997":122468,"_3043":122518},[],"EST con `PRE_REGISTRATION`",{"_3587":73091,"_30795":73073,"_21329":122520,"_5":14664,"_27997":122468,"_3043":122521},[],"Debe existir antes de `/simpleenroll`.",{"_3587":73092,"_30795":73073,"_21329":122523,"_5":14664,"_27997":122468,"_3043":122524},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3587":73093,"_30795":73073,"_21329":122526,"_5":14664,"_27997":122468,"_3043":122527},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3587":73094,"_30795":73073,"_21329":122529,"_5":14664,"_27997":122468,"_3043":122530},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3587":73095,"_30795":73073,"_21329":122532,"_5":14664,"_27997":122472,"_3043":122533},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3587":73096,"_30795":73073,"_21329":122535,"_5":14664,"_27997":122472,"_3043":122536},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3587":73097,"_30795":73073,"_21329":122538,"_5":14664,"_27997":122472,"_3043":122539},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3587":73098,"_30795":73073,"_21329":122541,"_5":14664,"_27997":122476,"_3043":122542},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3587":73099,"_30795":73073,"_21329":122544,"_5":14664,"_27997":122476,"_3043":122545},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3587":73100,"_30795":73073,"_21329":122547,"_5":14664,"_27997":122476,"_3043":122548},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3587":73101,"_30795":73073,"_21329":122550,"_5":14664,"_27997":122476,"_3043":122551},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3587":73102,"_30795":73073,"_21329":122553,"_5":14664,"_27997":122476,"_3043":122554},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3587":73103,"_30795":73073,"_21329":122556,"_5":14664,"_27997":122476,"_3043":122557},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3587":73104,"_30795":73073,"_21329":122559,"_5":14664,"_27997":122480,"_3043":119334},[],{"_3587":73105,"_30795":73073,"_21329":122561,"_5":14664,"_27997":122480,"_3043":122562},[],"Material que atraviesa EST",{"_3587":73106,"_30795":73073,"_21329":122564,"_5":14664,"_27997":122480,"_3043":122565},[],"Clave generada por el dispositivo",{"_3587":73107,"_30795":73073,"_21329":122567,"_5":14664,"_27997":122480,"_3043":122568},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3587":73108,"_30795":73073,"_21329":122570,"_5":14664,"_27997":122480,"_3043":122571},[],"Clave ya disponible en el dispositivo",{"_3587":73109,"_30795":73073,"_21329":122573,"_5":14664,"_27997":122480,"_3043":122574},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3587":73110,"_30795":73073,"_21329":122576,"_5":14664,"_27997":122480,"_3043":53372},[],{"_3587":73111,"_30795":73073,"_21329":122578,"_5":14664,"_27997":122480,"_3043":122579},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3587":73112,"_30795":73073,"_21329":122581,"_5":14664,"_27997":122480,"_3043":122582},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3587":73113,"_30795":73073,"_21329":122584,"_5":14664,"_27997":122484,"_3043":122585},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3587":73114,"_30795":73114,"_5":15024,"_3043":122587,"_31154":122588,"_21329":122589,"_27997":73114},"Renovación y recuperación",[50381,120436,53053,121569,121744],[],{"_3587":73115,"_30795":73114,"_21329":122591,"_5":14664,"_27997":73114,"_3043":122592},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3587":73116,"_30795":73114,"_5":31151,"_21329":122594,"_27997":122595,"_3043":122596},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3587":73117,"_30795":73114,"_5":31151,"_21329":122598,"_27997":122599,"_3043":122600},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3587":73118,"_30795":73114,"_5":31151,"_21329":122602,"_27997":122603,"_3043":122604},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3587":73119,"_30795":73114,"_5":31151,"_21329":122606,"_27997":122607,"_3043":122608},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3587":73120,"_30795":73114,"_5":31151,"_21329":122610,"_27997":122611,"_3043":122612},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3587":73121,"_30795":73114,"_21329":122614,"_5":14664,"_27997":73114,"_3043":122615},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3587":73122,"_30795":73114,"_21329":122617,"_5":14664,"_27997":122595,"_3043":122618},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3587":73123,"_30795":73114,"_21329":122620,"_5":14664,"_27997":122595,"_3043":122621},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3587":73124,"_30795":73114,"_21329":122623,"_5":14664,"_27997":122595,"_3043":122624},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3587":73125,"_30795":73114,"_21329":122626,"_5":14664,"_27997":122595,"_3043":122627},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3587":73126,"_30795":73114,"_21329":122629,"_5":14664,"_27997":122599,"_3043":122630},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3587":73127,"_30795":73114,"_21329":122632,"_5":14664,"_27997":122599,"_3043":122633},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3587":73128,"_30795":73114,"_21329":122635,"_5":14664,"_27997":122603,"_3043":122636},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3587":73129,"_30795":73114,"_21329":122638,"_5":14664,"_27997":122603,"_3043":122639},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3587":73130,"_30795":73114,"_21329":122641,"_5":14664,"_27997":122603,"_3043":122642},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3587":73131,"_30795":73114,"_21329":122644,"_5":14664,"_27997":122607,"_3043":122645},[],"Situación",{"_3587":73132,"_30795":73114,"_21329":122647,"_5":14664,"_27997":122607,"_3043":122648},[],"Procedimiento",{"_3587":73133,"_30795":73114,"_21329":122650,"_5":14664,"_27997":122607,"_3043":122651},[],"Certificado vigente, fuera de ventana",{"_3587":73134,"_30795":73114,"_21329":122653,"_5":14664,"_27997":122607,"_3043":122654},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3587":73135,"_30795":73114,"_21329":122656,"_5":14664,"_27997":122607,"_3043":122657},[],"Certificado vencido, clave disponible",{"_3587":73136,"_30795":73114,"_21329":122659,"_5":14664,"_27997":122607,"_3043":122660},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3587":73137,"_30795":73114,"_21329":122662,"_5":14664,"_27997":122607,"_3043":122663},[],"Renovación por webhook o `NO_AUTH`",{"_3587":73138,"_30795":73114,"_21329":122665,"_5":14664,"_27997":122607,"_3043":122666},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3587":73139,"_30795":73114,"_21329":122668,"_5":14664,"_27997":122607,"_3043":122669},[],"Clave perdida o inaccesible",{"_3587":73140,"_30795":73114,"_21329":122671,"_5":14664,"_27997":122607,"_3043":122672},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3587":73141,"_30795":73114,"_21329":122674,"_5":14664,"_27997":122607,"_3043":122675},[],"Identidad actual revocada",{"_3587":73142,"_30795":73114,"_21329":122677,"_5":14664,"_27997":122607,"_3043":122678},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3587":73143,"_30795":73114,"_21329":122680,"_5":14664,"_27997":122607,"_3043":122681},[],"Dispositivo sin identidad",{"_3587":73144,"_30795":73114,"_21329":122683,"_5":14664,"_27997":122607,"_3043":122684},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3587":73145,"_30795":73114,"_21329":122686,"_5":14664,"_27997":122607,"_3043":122687},[],"Dispositivo retirado",{"_3587":73146,"_30795":73114,"_21329":122689,"_5":14664,"_27997":122607,"_3043":122690},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3587":73147,"_30795":73114,"_21329":122692,"_5":14664,"_27997":122607,"_3043":122693},[],"Timeout, HTTP 500 o fallo de instalación",{"_3587":73148,"_30795":73114,"_21329":122695,"_5":14664,"_27997":122607,"_3043":122696},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3587":73149,"_30795":73114,"_21329":122698,"_5":14664,"_27997":122611,"_3043":122699},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3587":73150,"_30795":73114,"_21329":122701,"_5":14664,"_27997":122611,"_3043":122702},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3587":73151,"_30795":73151,"_5":15024,"_3043":122704,"_31154":122705,"_21329":122706,"_27997":73151},"Diagnóstico de enrolamiento",[50381,120436,53053,121569,121744],[],{"_3587":73152,"_30795":73151,"_21329":122708,"_5":14664,"_27997":73151,"_3043":122709},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3587":73153,"_30795":73151,"_5":31151,"_21329":122711,"_27997":122712,"_3043":122713},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3587":73154,"_30795":73151,"_5":31151,"_21329":122715,"_27997":122716,"_3043":122717},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3587":73155,"_30795":73151,"_5":31151,"_21329":122719,"_27997":122720,"_3043":122276},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3587":73156,"_30795":73151,"_5":31151,"_21329":122722,"_27997":122723,"_3043":122724},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3587":73157,"_30795":73151,"_21329":122726,"_5":14664,"_27997":73151,"_3043":122727},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3587":73158,"_30795":73151,"_21329":122729,"_5":14664,"_27997":122716,"_3043":122730},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3587":73159,"_30795":73151,"_21329":122732,"_5":14664,"_27997":122716,"_3043":122733},[],"Síntoma o mensaje",{"_3587":73160,"_30795":73151,"_21329":122735,"_5":14664,"_27997":122716,"_3043":122736},[],"Qué revisar",{"_3587":73161,"_30795":73151,"_21329":122738,"_5":14664,"_27997":122716,"_3043":122739},[],"curl rechaza TLS, nombre o emisor",{"_3587":73162,"_30795":73151,"_21329":122741,"_5":14664,"_27997":122716,"_3043":122742},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3587":73163,"_30795":73151,"_21329":122744,"_5":14664,"_27997":122716,"_3043":122745},[],"404 o APS ausente",{"_3587":73164,"_30795":73151,"_21329":122747,"_5":14664,"_27997":122716,"_3043":122748},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3587":73165,"_30795":73151,"_21329":122750,"_5":14664,"_27997":122716,"_3043":122751},[],"400, error de CSR o formato",{"_3587":73166,"_30795":73151,"_21329":122753,"_5":14664,"_27997":122716,"_3043":122754},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3587":73167,"_30795":73151,"_21329":122756,"_5":14664,"_27997":122716,"_3043":122757},[],"Credencial ausente o certificado no válido",{"_3587":73168,"_30795":73151,"_21329":122759,"_5":14664,"_27997":122716,"_3043":122760},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3587":73169,"_30795":73151,"_21329":122762,"_5":14664,"_27997":122716,"_3043":122763},[],"Webhook deniega, expira o responde sin autorización",{"_3587":73170,"_30795":73151,"_21329":122765,"_5":14664,"_27997":122716,"_3043":122766},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3587":73171,"_30795":73151,"_21329":122768,"_5":14664,"_27997":122716,"_3043":54298},[],{"_3587":73172,"_30795":73151,"_21329":122770,"_5":14664,"_27997":122716,"_3043":122771},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3587":73173,"_30795":73151,"_21329":122773,"_5":14664,"_27997":122716,"_3043":54304},[],{"_3587":73174,"_30795":73151,"_21329":122775,"_5":14664,"_27997":122716,"_3043":122776},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3587":73175,"_30795":73151,"_21329":122778,"_5":14664,"_27997":122716,"_3043":54310},[],{"_3587":73176,"_30795":73151,"_21329":122780,"_5":14664,"_27997":122716,"_3043":122781},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3587":73177,"_30795":73151,"_21329":122783,"_5":14664,"_27997":122716,"_3043":54316},[],{"_3587":73178,"_30795":73151,"_21329":122785,"_5":14664,"_27997":122716,"_3043":122786},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3587":73179,"_30795":73151,"_21329":122788,"_5":14664,"_27997":122716,"_3043":54322},[],{"_3587":73180,"_30795":73151,"_21329":122790,"_5":14664,"_27997":122716,"_3043":122791},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3587":73181,"_30795":73151,"_21329":122793,"_5":14664,"_27997":122716,"_3043":122794},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3587":73182,"_30795":73151,"_21329":122796,"_5":14664,"_27997":122716,"_3043":122797},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3587":73183,"_30795":73151,"_21329":122799,"_5":14664,"_27997":122716,"_3043":122800},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3587":73184,"_30795":73151,"_21329":122802,"_5":14664,"_27997":122716,"_3043":122803},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3587":73185,"_30795":73151,"_21329":122805,"_5":14664,"_27997":122716,"_3043":54340},[],{"_3587":73186,"_30795":73151,"_21329":122807,"_5":14664,"_27997":122716,"_3043":122808},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3587":73187,"_30795":73151,"_21329":122810,"_5":14664,"_27997":122716,"_3043":54346},[],{"_3587":73188,"_30795":73151,"_21329":122812,"_5":14664,"_27997":122716,"_3043":122813},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3587":73189,"_30795":73151,"_21329":122815,"_5":14664,"_27997":122716,"_3043":122816},[],"DMS propietario distinto",{"_3587":73190,"_30795":73151,"_21329":122818,"_5":14664,"_27997":122716,"_3043":122819},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3587":73191,"_30795":73151,"_21329":122821,"_5":14664,"_27997":122716,"_3043":54358},[],{"_3587":73192,"_30795":73151,"_21329":122823,"_5":14664,"_27997":122716,"_3043":122824},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3587":73193,"_30795":73151,"_21329":122826,"_5":14664,"_27997":122716,"_3043":54364},[],{"_3587":73194,"_30795":73151,"_21329":122828,"_5":14664,"_27997":122716,"_3043":122829},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3587":73195,"_30795":73151,"_21329":122831,"_5":14664,"_27997":122716,"_3043":122832},[],"Certificado actual revocado",{"_3587":73196,"_30795":73151,"_21329":122834,"_5":14664,"_27997":122716,"_3043":122835},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3587":73197,"_30795":73151,"_21329":122837,"_5":14664,"_27997":122716,"_3043":122838},[],"Error de CA, perfil o firma",{"_3587":73198,"_30795":73151,"_21329":122840,"_5":14664,"_27997":122716,"_3043":122841},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3587":73199,"_30795":73151,"_21329":122843,"_5":14664,"_27997":122716,"_3043":122844},[],"HTTP 200 sin conexión del dispositivo",{"_3587":73200,"_30795":73151,"_21329":122846,"_5":14664,"_27997":122716,"_3043":122847},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3587":73201,"_30795":73151,"_21329":122849,"_5":14664,"_27997":122716,"_3043":122850},[],"Timeout o error después de emitir",{"_3587":73202,"_30795":73151,"_21329":122852,"_5":14664,"_27997":122716,"_3043":122853},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3587":73203,"_30795":73151,"_21329":122855,"_5":14664,"_27997":122720,"_3043":122856},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3587":73204,"_30795":73151,"_21329":122858,"_5":14664,"_27997":122720,"_3043":122859},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3587":73205,"_30795":73151,"_21329":122861,"_5":14664,"_27997":122723,"_3043":122862},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3587":73206,"_30795":73151,"_21329":122864,"_5":14664,"_27997":122723,"_3043":122865},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3587":73207,"_30795":73151,"_21329":122867,"_5":14664,"_27997":122723,"_3043":122868},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3587":73208,"_30795":73151,"_21329":122870,"_5":14664,"_27997":122723,"_3043":122871},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3587":73209,"_30795":73151,"_21329":122873,"_5":14664,"_27997":122723,"_3043":122874},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3587":73210,"_30795":73151,"_21329":122876,"_5":14664,"_27997":122723,"_3043":122877},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3587":73211,"_30795":73151,"_21329":122879,"_5":14664,"_27997":122723,"_3043":122880},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3587":73212,"_30795":73212,"_5":15024,"_3043":122882,"_31154":122883,"_21329":122884,"_27997":73212},"Distribución y actualización de confianza",[50381,120436,53053,121569,121744],[],{"_3587":73213,"_30795":73212,"_21329":122886,"_5":14664,"_27997":73212,"_3043":122887},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3587":73214,"_30795":73212,"_5":31151,"_21329":122889,"_27997":122890,"_3043":122891},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3587":73215,"_30795":73212,"_5":31151,"_21329":122893,"_27997":122894,"_3043":122895},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3587":73216,"_30795":73212,"_5":31151,"_21329":122897,"_27997":122898,"_3043":122899},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3587":73217,"_30795":73212,"_5":31151,"_21329":122901,"_27997":122902,"_3043":122903},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3587":73218,"_30795":73212,"_5":31151,"_21329":122905,"_27997":122906,"_3043":122907},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3587":73219,"_30795":73212,"_21329":122909,"_5":14664,"_27997":73212,"_3043":122910},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3587":73220,"_30795":73212,"_21329":122912,"_5":14664,"_27997":122890,"_3043":122913},[],"Relación",{"_3587":73221,"_30795":73212,"_21329":122915,"_5":14664,"_27997":122890,"_3043":122916},[],"Material que prepara el responsable",{"_3587":73222,"_30795":73212,"_21329":122918,"_5":14664,"_27997":122890,"_3043":122919},[],"Dispositivo → servidor EST",{"_3587":73223,"_30795":73212,"_21329":122921,"_5":14664,"_27997":122890,"_3043":122922},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3587":73224,"_30795":73212,"_21329":122924,"_5":14664,"_27997":122890,"_3043":122925},[],"DMS → solicitante",{"_3587":73225,"_30795":73212,"_21329":122927,"_5":14664,"_27997":122890,"_3043":122928},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3587":73226,"_30795":73212,"_21329":122930,"_5":14664,"_27997":122890,"_3043":122931},[],"Consumidor → dispositivo",{"_3587":73227,"_30795":73212,"_21329":122933,"_5":14664,"_27997":122890,"_3043":122934},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3587":73228,"_30795":73212,"_21329":122936,"_5":14664,"_27997":122890,"_3043":122937},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3587":73229,"_30795":73212,"_21329":122939,"_5":14664,"_27997":122894,"_3043":122940},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3587":73230,"_30795":73212,"_21329":122942,"_5":14664,"_27997":122894,"_3043":122943},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3587":73231,"_30795":73212,"_21329":122945,"_5":14664,"_27997":122898,"_3043":122946},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3587":73232,"_30795":73212,"_21329":122948,"_5":14664,"_27997":122898,"_3043":122949},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3587":73233,"_30795":73212,"_21329":122951,"_5":14664,"_27997":122898,"_3043":122952},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3587":73234,"_30795":73212,"_21329":122954,"_5":14664,"_27997":122898,"_3043":122955},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3587":73235,"_30795":73212,"_21329":122957,"_5":14664,"_27997":122898,"_3043":122958},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3587":73236,"_30795":73212,"_21329":122960,"_5":14664,"_27997":122898,"_3043":122961},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3587":73237,"_30795":73212,"_21329":122963,"_5":14664,"_27997":122902,"_3043":122964},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3587":73238,"_30795":73212,"_21329":122966,"_5":14664,"_27997":122902,"_3043":122967},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3587":73239,"_30795":73212,"_21329":122969,"_5":14664,"_27997":122902,"_3043":122970},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3587":73240,"_30795":73212,"_21329":122972,"_5":14664,"_27997":122906,"_3043":122973},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3587":73241,"_30795":73241,"_5":15024,"_3043":54513,"_31154":122975,"_21329":122977,"_27997":73241},[50381,120436,53053,121569,122976],"Integraciones",[],{"_3587":73242,"_30795":73241,"_21329":122979,"_5":14664,"_27997":73241,"_3043":122980},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3587":73243,"_30795":73241,"_5":31151,"_21329":122982,"_27997":122983,"_3043":122984},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3587":73244,"_30795":73241,"_5":31151,"_21329":122986,"_27997":122987,"_3043":122988},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3587":73245,"_30795":73241,"_5":31151,"_21329":122990,"_27997":122991,"_3043":122992},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3587":73246,"_30795":73241,"_5":31151,"_21329":122994,"_27997":122995,"_3043":122996},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3587":73247,"_30795":73241,"_5":31151,"_21329":122998,"_27997":122999,"_3043":123000},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3587":73248,"_30795":73241,"_5":31151,"_21329":123002,"_27997":123003,"_3043":123004},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3587":73249,"_30795":73241,"_5":31151,"_21329":123006,"_27997":123007,"_3043":123008},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3587":73250,"_30795":73241,"_5":31151,"_21329":123010,"_27997":123011,"_3043":123012},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3587":73251,"_30795":73241,"_5":31151,"_21329":123014,"_27997":123015,"_3043":54555},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3587":73252,"_30795":73241,"_5":31151,"_21329":123017,"_27997":123018,"_3043":54559},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3587":73253,"_30795":73241,"_5":31151,"_21329":123020,"_27997":123021,"_3043":123022},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3587":73254,"_30795":73241,"_5":31151,"_21329":123024,"_27997":123025,"_3043":123026},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3587":73255,"_30795":73241,"_5":31151,"_21329":123028,"_27997":123029,"_3043":123030},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3587":73256,"_30795":73241,"_5":31151,"_21329":123032,"_27997":123033,"_3043":123034},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3587":73257,"_30795":73241,"_5":31151,"_21329":123036,"_27997":123037,"_3043":123038},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3587":73258,"_30795":73241,"_5":31151,"_21329":123040,"_27997":123041,"_3043":123042},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3587":73259,"_30795":73241,"_5":31151,"_21329":123044,"_27997":123045,"_3043":123046},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3587":73260,"_30795":73241,"_5":31151,"_21329":123048,"_27997":123049,"_3043":123050},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3587":73261,"_30795":73241,"_5":31151,"_21329":123052,"_27997":123053,"_3043":123054},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3587":73262,"_30795":73241,"_5":31151,"_21329":123056,"_27997":123057,"_3043":123058},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3587":73263,"_30795":73241,"_5":31151,"_21329":123060,"_27997":123061,"_3043":123062},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3587":73264,"_30795":73241,"_5":31151,"_21329":123064,"_27997":123065,"_3043":123066},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3587":73265,"_30795":73241,"_5":31151,"_21329":123068,"_27997":123069,"_3043":123070},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3587":73266,"_30795":73241,"_5":31151,"_21329":123072,"_27997":123073,"_3043":123074},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3587":73267,"_30795":73241,"_5":31151,"_21329":123076,"_27997":123077,"_3043":123078},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3587":73268,"_30795":73241,"_21329":123080,"_5":14664,"_27997":73241,"_3043":123081},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3587":73269,"_30795":73241,"_21329":123083,"_5":14664,"_27997":73241,"_3043":123084},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3587":73270,"_30795":73241,"_21329":123086,"_5":14664,"_27997":73241,"_3043":123087},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3587":73271,"_30795":73241,"_21329":123089,"_5":14664,"_27997":122983,"_3043":123090},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3587":73272,"_30795":73241,"_21329":123092,"_5":14664,"_27997":122983,"_3043":123093},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3587":73273,"_30795":73241,"_21329":123095,"_5":14664,"_27997":122983,"_3043":123096},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3587":73274,"_30795":73241,"_21329":123098,"_5":14664,"_27997":122983,"_3043":123099},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3587":73275,"_30795":73241,"_21329":123101,"_5":14664,"_27997":122987,"_3043":123102},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3587":73276,"_30795":73241,"_21329":123104,"_5":14664,"_27997":122991,"_3043":123105},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3587":73277,"_30795":73241,"_21329":123107,"_5":14664,"_27997":122991,"_3043":123108},[],"Acción IAM",{"_3587":73278,"_30795":73241,"_21329":123110,"_5":14664,"_27997":122991,"_3043":119340},[],{"_3587":73279,"_30795":73241,"_21329":123112,"_5":14664,"_27997":122991,"_3043":54654},[],{"_3587":73280,"_30795":73241,"_21329":123114,"_5":14664,"_27997":122991,"_3043":123115},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3587":73281,"_30795":73241,"_21329":123117,"_5":14664,"_27997":122991,"_3043":54660},[],{"_3587":73282,"_30795":73241,"_21329":123119,"_5":14664,"_27997":122991,"_3043":123120},[],"Registrar la CA en AWS IoT",{"_3587":73283,"_30795":73241,"_21329":123122,"_5":14664,"_27997":122991,"_3043":54666},[],{"_3587":73284,"_30795":73241,"_21329":123124,"_5":14664,"_27997":122991,"_3043":123125},[],"Consultar el estado del registro de la CA",{"_3587":73285,"_30795":73241,"_21329":123127,"_5":14664,"_27997":122991,"_3043":54672},[],{"_3587":73286,"_30795":73241,"_21329":123129,"_5":14664,"_27997":122991,"_3043":123130},[],"Crear o actualizar Things en IoT Core",{"_3587":73287,"_30795":73241,"_21329":123132,"_5":14664,"_27997":122991,"_3043":54678},[],{"_3587":73288,"_30795":73241,"_21329":123134,"_5":14664,"_27997":122991,"_3043":123135},[],"Aprovisionar Things mediante plantilla",{"_3587":73289,"_30795":73241,"_21329":123137,"_5":14664,"_27997":122991,"_3043":54684},[],{"_3587":73290,"_30795":73241,"_21329":123139,"_5":14664,"_27997":122991,"_3043":123140},[],"Registrar certificados de dispositivo",{"_3587":73291,"_30795":73241,"_21329":123142,"_5":14664,"_27997":122991,"_3043":54690},[],{"_3587":73292,"_30795":73241,"_21329":123144,"_5":14664,"_27997":122991,"_3043":123145},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3587":73293,"_30795":73241,"_21329":123147,"_5":14664,"_27997":122991,"_3043":54696},[],{"_3587":73294,"_30795":73241,"_21329":123149,"_5":14664,"_27997":122991,"_3043":123150},[],"Crear y adjuntar políticas IoT",{"_3587":73295,"_30795":73241,"_21329":123152,"_5":14664,"_27997":122991,"_3043":54702},[],{"_3587":73296,"_30795":73241,"_21329":123154,"_5":14664,"_27997":122991,"_3043":123155},[],"Gestionar grupos de Things",{"_3587":73297,"_30795":73241,"_21329":123157,"_5":14664,"_27997":122991,"_3043":54708},[],{"_3587":73298,"_30795":73241,"_21329":123159,"_5":14664,"_27997":122991,"_3043":123160},[],"Crear plantillas JITP",{"_3587":73299,"_30795":73241,"_21329":123162,"_5":14664,"_27997":122991,"_3043":54714},[],{"_3587":73300,"_30795":73241,"_21329":123164,"_5":14664,"_27997":122991,"_3043":123165},[],"Leer y escribir el Device Shadow",{"_3587":73301,"_30795":73241,"_21329":123167,"_5":14664,"_27997":122991,"_3043":123168},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3587":73302,"_30795":73241,"_21329":123170,"_5":14664,"_27997":122995,"_3043":123171},[],"Parámetro",{"_3587":73303,"_30795":73241,"_21329":123173,"_5":14664,"_27997":122995,"_3043":123174},[],"Tipo",{"_3587":73304,"_30795":73241,"_21329":123176,"_5":14664,"_27997":122995,"_3043":123177},[],"Requerido",{"_3587":73305,"_30795":73241,"_21329":123179,"_5":14664,"_27997":122995,"_3043":123180},[],"Descripción",{"_3587":73306,"_30795":73241,"_21329":123182,"_5":14664,"_27997":122995,"_3043":54735},[],{"_3587":73307,"_30795":73241,"_21329":123184,"_5":14664,"_27997":122995,"_3043":25471},[],{"_3587":73308,"_30795":73241,"_21329":123186,"_5":14664,"_27997":122995,"_3043":123187},[],"Sí",{"_3587":73309,"_30795":73241,"_21329":123189,"_5":14664,"_27997":122995,"_3043":123190},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3587":73310,"_30795":73241,"_21329":123192,"_5":14664,"_27997":122995,"_3043":54746},[],{"_3587":73311,"_30795":73241,"_21329":123194,"_5":14664,"_27997":122995,"_3043":25471},[],{"_3587":73312,"_30795":73241,"_21329":123196,"_5":14664,"_27997":122995,"_3043":123187},[],{"_3587":73313,"_30795":73241,"_21329":123198,"_5":14664,"_27997":122995,"_3043":123199},[],"Región AWS donde opera el conector.",{"_3587":73314,"_30795":73241,"_21329":123201,"_5":14664,"_27997":122995,"_3043":54756},[],{"_3587":73315,"_30795":73241,"_21329":123203,"_5":14664,"_27997":122995,"_3043":25471},[],{"_3587":73316,"_30795":73241,"_21329":123205,"_5":14664,"_27997":122995,"_3043":123187},[],{"_3587":73317,"_30795":73241,"_21329":123207,"_5":14664,"_27997":122995,"_3043":123208},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3587":73318,"_30795":73241,"_21329":123210,"_5":14664,"_27997":122995,"_3043":54766},[],{"_3587":73319,"_30795":73241,"_21329":123212,"_5":14664,"_27997":122995,"_3043":25471},[],{"_3587":73320,"_30795":73241,"_21329":123214,"_5":14664,"_27997":122995,"_3043":123215},[],"Solo con `auth_method=static`",{"_3587":73321,"_30795":73241,"_21329":123217,"_5":14664,"_27997":122995,"_3043":123218},[],"Clave de acceso AWS.",{"_3587":73322,"_30795":73241,"_21329":123220,"_5":14664,"_27997":122995,"_3043":54777},[],{"_3587":73323,"_30795":73241,"_21329":123222,"_5":14664,"_27997":122995,"_3043":25471},[],{"_3587":73324,"_30795":73241,"_21329":123224,"_5":14664,"_27997":122995,"_3043":123215},[],{"_3587":73325,"_30795":73241,"_21329":123226,"_5":14664,"_27997":122995,"_3043":123227},[],"Clave secreta AWS.",{"_3587":73326,"_30795":73241,"_21329":123229,"_5":14664,"_27997":122995,"_3043":54787},[],{"_3587":73327,"_30795":73241,"_21329":123231,"_5":14664,"_27997":122995,"_3043":25471},[],{"_3587":73328,"_30795":73241,"_21329":123233,"_5":14664,"_27997":122995,"_3043":54792},[],{"_3587":73329,"_30795":73241,"_21329":123235,"_5":14664,"_27997":122995,"_3043":123236},[],"Token de sesión (con `auth_method=static`).",{"_3587":73330,"_30795":73241,"_21329":123238,"_5":14664,"_27997":122995,"_3043":54798},[],{"_3587":73331,"_30795":73241,"_21329":123240,"_5":14664,"_27997":122995,"_3043":25471},[],{"_3587":73332,"_30795":73241,"_21329":123242,"_5":14664,"_27997":122995,"_3043":123243},[],"Solo con `auth_method=role`",{"_3587":73333,"_30795":73241,"_21329":123245,"_5":14664,"_27997":122995,"_3043":123246},[],"ARN del rol a asumir.",{"_3587":73334,"_30795":73241,"_21329":123248,"_5":14664,"_27997":122995,"_3043":54809},[],{"_3587":73335,"_30795":73241,"_21329":123250,"_5":14664,"_27997":122995,"_3043":25471},[],{"_3587":73336,"_30795":73241,"_21329":123252,"_5":14664,"_27997":122995,"_3043":54792},[],{"_3587":73337,"_30795":73241,"_21329":123254,"_5":14664,"_27997":122995,"_3043":123255},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3587":73338,"_30795":73241,"_21329":123257,"_5":14664,"_27997":122995,"_3043":54819},[],{"_3587":73339,"_30795":73241,"_21329":123259,"_5":14664,"_27997":122995,"_3043":91864},[],{"_3587":73340,"_30795":73241,"_21329":123261,"_5":14664,"_27997":122995,"_3043":123187},[],{"_3587":73341,"_30795":73241,"_21329":123263,"_5":14664,"_27997":122995,"_3043":123264},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3587":73342,"_30795":73241,"_21329":123266,"_5":14664,"_27997":122995,"_3043":54829},[],{"_3587":73343,"_30795":73241,"_21329":123268,"_5":14664,"_27997":122995,"_3043":25471},[],{"_3587":73344,"_30795":73241,"_21329":123270,"_5":14664,"_27997":122995,"_3043":123187},[],{"_3587":73345,"_30795":73241,"_21329":123272,"_5":14664,"_27997":122995,"_3043":123273},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3587":73346,"_30795":73241,"_21329":123275,"_5":14664,"_27997":122995,"_3043":54839},[],{"_3587":73347,"_30795":73241,"_21329":123277,"_5":14664,"_27997":122995,"_3043":25471},[],{"_3587":73348,"_30795":73241,"_21329":123279,"_5":14664,"_27997":122995,"_3043":123187},[],{"_3587":73349,"_30795":73241,"_21329":123281,"_5":14664,"_27997":122995,"_3043":123282},[],"URL HTTP del Device Manager de Lamassu.",{"_3587":73350,"_30795":73241,"_21329":123284,"_5":14664,"_27997":122995,"_3043":54849},[],{"_3587":73351,"_30795":73241,"_21329":123286,"_5":14664,"_27997":122995,"_3043":25471},[],{"_3587":73352,"_30795":73241,"_21329":123288,"_5":14664,"_27997":122995,"_3043":123187},[],{"_3587":73353,"_30795":73241,"_21329":123290,"_5":14664,"_27997":122995,"_3043":123291},[],"URL HTTP del servicio de CA de Lamassu.",{"_3587":73354,"_30795":73241,"_21329":123293,"_5":14664,"_27997":122999,"_3043":123294},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3587":73355,"_30795":73241,"_21329":123296,"_5":14664,"_27997":122999,"_3043":123297},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3587":73356,"_30795":73241,"_21329":123299,"_5":14664,"_27997":122999,"_3043":123300},[],"Tipo de CloudEvent",{"_3587":73357,"_30795":73241,"_21329":123302,"_5":14664,"_27997":122999,"_3043":123303},[],"Recurso en Lamassu",{"_3587":73358,"_30795":73241,"_21329":123305,"_5":14664,"_27997":122999,"_3043":123306},[],"Recurso AWS",{"_3587":73359,"_30795":73241,"_21329":123308,"_5":14664,"_27997":122999,"_3043":123309},[],"Acciones IAM",{"_3587":73360,"_30795":73241,"_21329":123311,"_5":14664,"_27997":122999,"_3043":123312},[],"Llamadas AWS y efecto",{"_3587":73361,"_30795":73241,"_21329":123314,"_5":14664,"_27997":122999,"_3043":123315},[],"Dónde en esta página",{"_3587":73362,"_30795":73241,"_21329":123317,"_5":14664,"_27997":122999,"_3043":54883},[],{"_3587":73363,"_30795":73241,"_21329":123319,"_5":14664,"_27997":122999,"_3043":54886},[],{"_3587":73364,"_30795":73241,"_21329":123321,"_5":14664,"_27997":122999,"_3043":54889},[],{"_3587":73365,"_30795":73241,"_21329":123323,"_5":14664,"_27997":122999,"_3043":54892},[],{"_3587":73366,"_30795":73241,"_21329":123325,"_5":14664,"_27997":122999,"_3043":123326},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3587":73367,"_30795":73241,"_21329":123328,"_5":14664,"_27997":122999,"_3043":123012},[],{"_3587":73368,"_30795":73241,"_21329":123330,"_5":14664,"_27997":122999,"_3043":54900},[],{"_3587":73369,"_30795":73241,"_21329":123332,"_5":14664,"_27997":122999,"_3043":54903},[],{"_3587":73370,"_30795":73241,"_21329":123334,"_5":14664,"_27997":122999,"_3043":54906},[],{"_3587":73371,"_30795":73241,"_21329":123336,"_5":14664,"_27997":122999,"_3043":54909},[],{"_3587":73372,"_30795":73241,"_21329":123338,"_5":14664,"_27997":122999,"_3043":123339},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3587":73373,"_30795":73241,"_21329":123341,"_5":14664,"_27997":122999,"_3043":123038},[],{"_3587":73374,"_30795":73241,"_21329":123343,"_5":14664,"_27997":122999,"_3043":54917},[],{"_3587":73375,"_30795":73241,"_21329":123345,"_5":14664,"_27997":122999,"_3043":123346},[],"Dispositivo",{"_3587":73376,"_30795":73241,"_21329":123348,"_5":14664,"_27997":122999,"_3043":54923},[],{"_3587":73377,"_30795":73241,"_21329":123350,"_5":14664,"_27997":122999,"_3043":54926},[],{"_3587":73378,"_30795":73241,"_21329":123352,"_5":14664,"_27997":122999,"_3043":123353},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3587":73379,"_30795":73241,"_21329":123355,"_5":14664,"_27997":122999,"_3043":123046},[],{"_3587":73380,"_30795":73241,"_21329":123357,"_5":14664,"_27997":122999,"_3043":54934},[],{"_3587":73381,"_30795":73241,"_21329":123359,"_5":14664,"_27997":122999,"_3043":123360},[],"Certificado",{"_3587":73382,"_30795":73241,"_21329":123362,"_5":14664,"_27997":122999,"_3043":54940},[],{"_3587":73383,"_30795":73241,"_21329":123364,"_5":14664,"_27997":122999,"_3043":123365},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3587":73384,"_30795":73241,"_21329":123367,"_5":14664,"_27997":122999,"_3043":123368},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3587":73385,"_30795":73241,"_21329":123370,"_5":14664,"_27997":122999,"_3043":123058},[],{"_3587":73386,"_30795":73241,"_21329":123372,"_5":14664,"_27997":122999,"_3043":54951},[],{"_3587":73387,"_30795":73241,"_21329":123374,"_5":14664,"_27997":122999,"_3043":123375},[],"Certificado / Dispositivo",{"_3587":73388,"_30795":73241,"_21329":123377,"_5":14664,"_27997":122999,"_3043":54957},[],{"_3587":73389,"_30795":73241,"_21329":123379,"_5":14664,"_27997":122999,"_3043":50777},[],{"_3587":73390,"_30795":73241,"_21329":123381,"_5":14664,"_27997":122999,"_3043":123382},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3587":73391,"_30795":73241,"_21329":123384,"_5":14664,"_27997":122999,"_3043":123066},[],{"_3587":73392,"_30795":73241,"_21329":123386,"_5":14664,"_27997":123003,"_3043":123387},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3587":73393,"_30795":73241,"_21329":123389,"_5":14664,"_27997":123007,"_3043":123390},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3587":73394,"_30795":73241,"_21329":123392,"_5":14664,"_27997":123007,"_3043":123393},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3587":73395,"_30795":73241,"_21329":123395,"_5":14664,"_27997":123011,"_3043":123396},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3587":73396,"_30795":73241,"_21329":123398,"_5":14664,"_27997":123011,"_3043":123399},[],"Transición",{"_3587":73397,"_30795":73241,"_21329":123401,"_5":14664,"_27997":123011,"_3043":123402},[],"Llamadas AWS",{"_3587":73398,"_30795":73241,"_21329":123404,"_5":14664,"_27997":123011,"_3043":123405},[],"`NoRegistrada` → `Solicitada`",{"_3587":73399,"_30795":73241,"_21329":123407,"_5":14664,"_27997":123011,"_3043":123408},[],"ninguna (solo escritura de metadatos)",{"_3587":73400,"_30795":73241,"_21329":123410,"_5":14664,"_27997":123011,"_3043":123411},[],"`Solicitada` → `Registrando`",{"_3587":73401,"_30795":73241,"_21329":123413,"_5":14664,"_27997":123011,"_3043":123414},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3587":73402,"_30795":73241,"_21329":123416,"_5":14664,"_27997":123011,"_3043":123417},[],"`Registrando` → `Completada`",{"_3587":73403,"_30795":73241,"_21329":123419,"_5":14664,"_27997":123011,"_3043":123420},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3587":73404,"_30795":73241,"_21329":123422,"_5":14664,"_27997":123011,"_3043":123423},[],"`Registrando` → `Fallida`",{"_3587":73405,"_30795":73241,"_21329":123425,"_5":14664,"_27997":123011,"_3043":123426},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3587":73406,"_30795":73241,"_21329":123428,"_5":14664,"_27997":123011,"_3043":123429},[],"`Fallida` / `Completada` → `Solicitada`",{"_3587":73407,"_30795":73241,"_21329":123431,"_5":14664,"_27997":123011,"_3043":123432},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3587":73408,"_30795":73241,"_21329":123434,"_5":14664,"_27997":123015,"_3043":123435},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3587":73409,"_30795":73241,"_21329":123437,"_5":14664,"_27997":123015,"_3043":123438},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3587":73410,"_30795":73241,"_21329":123440,"_5":14664,"_27997":123015,"_3043":123441},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3587":73411,"_30795":73241,"_21329":123443,"_5":14664,"_27997":123015,"_3043":123444},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3587":73412,"_30795":73241,"_21329":123446,"_5":14664,"_27997":123015,"_3043":123447},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3587":73413,"_30795":73241,"_21329":123449,"_5":14664,"_27997":123015,"_3043":123450},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3587":73414,"_30795":73241,"_21329":123452,"_5":14664,"_27997":123018,"_3043":123453},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3587":73415,"_30795":73241,"_21329":123455,"_5":14664,"_27997":123021,"_3043":123456},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3587":73416,"_30795":73241,"_21329":123458,"_5":14664,"_27997":123021,"_3043":123459},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3587":73417,"_30795":73241,"_21329":123461,"_5":14664,"_27997":123025,"_3043":123462},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3587":73418,"_30795":73241,"_21329":123464,"_5":14664,"_27997":123029,"_3043":123465},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3587":73419,"_30795":73241,"_21329":123467,"_5":14664,"_27997":123029,"_3043":123468},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3587":73420,"_30795":73241,"_21329":123470,"_5":14664,"_27997":123029,"_3043":123471},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3587":73421,"_30795":73241,"_21329":123473,"_5":14664,"_27997":123029,"_3043":123474},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3587":73422,"_30795":73241,"_21329":123476,"_5":14664,"_27997":123029,"_3043":123477},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3587":73423,"_30795":73241,"_21329":123479,"_5":14664,"_27997":123029,"_3043":123480},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3587":73424,"_30795":73241,"_21329":123482,"_5":14664,"_27997":123033,"_3043":123483},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3587":73425,"_30795":73241,"_21329":123485,"_5":14664,"_27997":123033,"_3043":123486},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3587":73426,"_30795":73241,"_21329":123488,"_5":14664,"_27997":123033,"_3043":123489},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3587":73427,"_30795":73241,"_21329":123491,"_5":14664,"_27997":123033,"_3043":123492},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3587":73428,"_30795":73241,"_21329":123494,"_5":14664,"_27997":123033,"_3043":123495},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3587":73429,"_30795":73241,"_21329":123497,"_5":14664,"_27997":123037,"_3043":123498},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3587":73430,"_30795":73241,"_21329":123500,"_5":14664,"_27997":123037,"_3043":123399},[],{"_3587":73431,"_30795":73241,"_21329":123502,"_5":14664,"_27997":123037,"_3043":123402},[],{"_3587":73432,"_30795":73241,"_21329":123504,"_5":14664,"_27997":123037,"_3043":123505},[],"`SinConfigurar` → `None` / `Auto`",{"_3587":73433,"_30795":73241,"_21329":123507,"_5":14664,"_27997":123037,"_3043":123508},[],"ninguna (solo configuración)",{"_3587":73434,"_30795":73241,"_21329":123510,"_5":14664,"_27997":123037,"_3043":55094},[],{"_3587":73435,"_30795":73241,"_21329":123512,"_5":14664,"_27997":123037,"_3043":123508},[],{"_3587":73436,"_30795":73241,"_21329":123514,"_5":14664,"_27997":123037,"_3043":123515},[],"Cualquiera → `Jitp`",{"_3587":73437,"_30795":73241,"_21329":123517,"_5":14664,"_27997":123037,"_3043":123518},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3587":73438,"_30795":73241,"_21329":123520,"_5":14664,"_27997":123037,"_3043":55105},[],{"_3587":73439,"_30795":73241,"_21329":123522,"_5":14664,"_27997":123037,"_3043":123523},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3587":73440,"_30795":73241,"_21329":123525,"_5":14664,"_27997":123041,"_3043":123526},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3587":73441,"_30795":73241,"_21329":123528,"_5":14664,"_27997":123041,"_3043":123529},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3587":73442,"_30795":73241,"_21329":123531,"_5":14664,"_27997":123041,"_3043":123532},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3587":73443,"_30795":73241,"_21329":123534,"_5":14664,"_27997":123045,"_3043":123535},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3587":73444,"_30795":73241,"_21329":123537,"_5":14664,"_27997":123045,"_3043":123399},[],{"_3587":73445,"_30795":73241,"_21329":123539,"_5":14664,"_27997":123045,"_3043":123402},[],{"_3587":73446,"_30795":73241,"_21329":123541,"_5":14664,"_27997":123045,"_3043":123542},[],"`Ausente` → `Aprovisionado`",{"_3587":73447,"_30795":73241,"_21329":123544,"_5":14664,"_27997":123045,"_3043":123545},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3587":73448,"_30795":73241,"_21329":123547,"_5":14664,"_27997":123045,"_3043":123548},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3587":73449,"_30795":73241,"_21329":123550,"_5":14664,"_27997":123045,"_3043":123551},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3587":73450,"_30795":73241,"_21329":123553,"_5":14664,"_27997":123045,"_3043":123554},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3587":73451,"_30795":73241,"_21329":123556,"_5":14664,"_27997":123049,"_3043":123557},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3587":73452,"_30795":73241,"_21329":123559,"_5":14664,"_27997":123049,"_3043":123560},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3587":73453,"_30795":73241,"_21329":123562,"_5":14664,"_27997":123049,"_3043":123563},[],"Para que el flujo JITP funcione correctamente:",{"_3587":73454,"_30795":73241,"_21329":123565,"_5":14664,"_27997":123049,"_3043":123566},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3587":73455,"_30795":73241,"_21329":123568,"_5":14664,"_27997":123049,"_3043":123569},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3587":73456,"_30795":73241,"_21329":123571,"_5":14664,"_27997":123049,"_3043":123572},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3587":73457,"_30795":73241,"_21329":123574,"_5":14664,"_27997":123049,"_3043":123575},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3587":73458,"_30795":73241,"_21329":123577,"_5":14664,"_27997":123053,"_3043":123578},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3587":73459,"_30795":73241,"_21329":123580,"_5":14664,"_27997":123053,"_3043":123581},[],"Estado en Lamassu",{"_3587":73460,"_30795":73241,"_21329":123583,"_5":14664,"_27997":123053,"_3043":123584},[],"Razón de revocación",{"_3587":73461,"_30795":73241,"_21329":123586,"_5":14664,"_27997":123053,"_3043":123587},[],"Estado en AWS IoT Core",{"_3587":73462,"_30795":73241,"_21329":123589,"_5":14664,"_27997":123053,"_3043":55175},[],{"_3587":73463,"_30795":73241,"_21329":123591,"_5":14664,"_27997":123053,"_3043":123592},[],"Ninguna",{"_3587":73464,"_30795":73241,"_21329":123594,"_5":14664,"_27997":123053,"_3043":55181},[],{"_3587":73465,"_30795":73241,"_21329":123596,"_5":14664,"_27997":123053,"_3043":55184},[],{"_3587":73466,"_30795":73241,"_21329":123598,"_5":14664,"_27997":123053,"_3043":55187},[],{"_3587":73467,"_30795":73241,"_21329":123600,"_5":14664,"_27997":123053,"_3043":55190},[],{"_3587":73468,"_30795":73241,"_21329":123602,"_5":14664,"_27997":123053,"_3043":55184},[],{"_3587":73469,"_30795":73241,"_21329":123604,"_5":14664,"_27997":123053,"_3043":123605},[],"Cualquier otra razón",{"_3587":73470,"_30795":73241,"_21329":123607,"_5":14664,"_27997":123053,"_3043":55198},[],{"_3587":73471,"_30795":73241,"_21329":123609,"_5":14664,"_27997":123053,"_3043":123610},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3587":73472,"_30795":73241,"_21329":123612,"_5":14664,"_27997":123057,"_3043":123613},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3587":73473,"_30795":73241,"_21329":123615,"_5":14664,"_27997":123057,"_3043":123399},[],{"_3587":73474,"_30795":73241,"_21329":123617,"_5":14664,"_27997":123057,"_3043":123402},[],{"_3587":73475,"_30795":73241,"_21329":123619,"_5":14664,"_27997":123057,"_3043":123620},[],"`NoSincronizado` → `Active`",{"_3587":73476,"_30795":73241,"_21329":123622,"_5":14664,"_27997":123057,"_3043":54690},[],{"_3587":73477,"_30795":73241,"_21329":123624,"_5":14664,"_27997":123057,"_3043":55216},[],{"_3587":73478,"_30795":73241,"_21329":123626,"_5":14664,"_27997":123057,"_3043":123627},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3587":73479,"_30795":73241,"_21329":123629,"_5":14664,"_27997":123057,"_3043":55222},[],{"_3587":73480,"_30795":73241,"_21329":123631,"_5":14664,"_27997":123057,"_3043":123627},[],{"_3587":73481,"_30795":73241,"_21329":123633,"_5":14664,"_27997":123057,"_3043":55227},[],{"_3587":73482,"_30795":73241,"_21329":123635,"_5":14664,"_27997":123057,"_3043":54690},[],{"_3587":73483,"_30795":73241,"_21329":123637,"_5":14664,"_27997":123057,"_3043":55232},[],{"_3587":73484,"_30795":73241,"_21329":123639,"_5":14664,"_27997":123057,"_3043":123640},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3587":73485,"_30795":73241,"_21329":123642,"_5":14664,"_27997":123061,"_3043":123643},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3587":73486,"_30795":73241,"_21329":123645,"_5":14664,"_27997":123061,"_3043":123646},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3587":73487,"_30795":73241,"_21329":123648,"_5":14664,"_27997":123061,"_3043":123649},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3587":73488,"_30795":73241,"_21329":123651,"_5":14664,"_27997":123065,"_3043":123652},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3587":73489,"_30795":73241,"_21329":123654,"_5":14664,"_27997":123065,"_3043":123655},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3587":73490,"_30795":73241,"_21329":123657,"_5":14664,"_27997":123069,"_3043":123658},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3587":73491,"_30795":73241,"_21329":123660,"_5":14664,"_27997":123069,"_3043":123661},[],"Existen dos tipos de acciones:",{"_3587":73492,"_30795":73241,"_21329":123663,"_5":14664,"_27997":123069,"_3043":123664},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3587":73493,"_30795":73241,"_21329":123666,"_5":14664,"_27997":123069,"_3043":123667},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3587":73494,"_30795":73241,"_21329":123669,"_5":14664,"_27997":123069,"_3043":123670},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3587":73495,"_30795":73241,"_21329":123672,"_5":14664,"_27997":123073,"_3043":123673},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3587":73496,"_30795":73241,"_21329":123675,"_5":14664,"_27997":123073,"_3043":123676},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3587":73497,"_30795":73241,"_21329":123678,"_5":14664,"_27997":123073,"_3043":123679},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3587":73498,"_30795":73241,"_21329":123681,"_5":14664,"_27997":123077,"_3043":123682},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3587":73499,"_30795":73241,"_21329":123684,"_5":14664,"_27997":123077,"_3043":123685},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3587":73500,"_30795":73241,"_21329":123687,"_5":14664,"_27997":123077,"_3043":123688},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3587":73501,"_30795":73241,"_21329":123690,"_5":14664,"_27997":123077,"_3043":123691},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3587":73502,"_30795":73241,"_21329":123693,"_5":14664,"_27997":123077,"_3043":123694},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3587":73503,"_30795":73241,"_21329":123696,"_5":14664,"_27997":123077,"_3043":123697},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3587":73504,"_30795":73241,"_21329":123699,"_5":14664,"_27997":123077,"_3043":123700},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3587":73505,"_30795":73241,"_21329":123702,"_5":14664,"_27997":123077,"_3043":123703},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3587":73506,"_30795":73241,"_21329":123705,"_5":14664,"_27997":123077,"_3043":123706},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3587":73507,"_30795":73241,"_21329":123708,"_5":14664,"_27997":123077,"_3043":123709},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3587":73508,"_30795":73241,"_21329":123711,"_5":14664,"_27997":123077,"_3043":123712},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3587":73509,"_30795":73241,"_21329":123714,"_5":14664,"_27997":123077,"_3043":123715},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3587":73510,"_30795":73241,"_21329":123717,"_5":14664,"_27997":123077,"_3043":123718},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3587":73511,"_30795":73241,"_21329":123720,"_5":14664,"_27997":123077,"_3043":123721},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3587":73512,"_30795":73241,"_21329":123723,"_5":14664,"_27997":123077,"_3043":123724},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3587":73513,"_30795":73241,"_21329":123726,"_5":14664,"_27997":123077,"_3043":123727},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3587":73514,"_30795":73241,"_21329":123729,"_5":14664,"_27997":123077,"_3043":123730},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3587":73515,"_30795":73241,"_21329":123732,"_5":14664,"_27997":123077,"_3043":123733},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3587":73516,"_30795":73241,"_21329":123735,"_5":14664,"_27997":123077,"_3043":123736},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3587":73517,"_30795":73241,"_21329":123738,"_5":14664,"_27997":123077,"_3043":123739},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3587":73518,"_30795":73241,"_21329":123741,"_5":14664,"_27997":123077,"_3043":123742},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3587":73519,"_30795":73241,"_21329":123744,"_5":14664,"_27997":123077,"_3043":123745},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3587":73520,"_30795":73241,"_21329":123747,"_5":14664,"_27997":123077,"_3043":123748},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3587":73521,"_30795":73241,"_21329":123750,"_5":14664,"_27997":123077,"_3043":123751},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3587":73522,"_30795":73522,"_5":15024,"_3043":53053,"_31154":123753,"_21329":123754,"_27997":73522},[50381,120436,53053],[],{"_3587":73523,"_30795":73522,"_21329":123756,"_5":14664,"_27997":73522,"_3043":123757},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3587":73524,"_30795":73522,"_5":31151,"_21329":123759,"_27997":123760,"_3043":123761},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3587":73525,"_30795":73522,"_5":31151,"_21329":123763,"_27997":123764,"_3043":121569},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3587":73526,"_30795":73522,"_5":31151,"_21329":123766,"_27997":123767,"_3043":121744},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3587":73527,"_30795":73522,"_5":31151,"_21329":123769,"_27997":123770,"_3043":122976},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/overview#integraciones",{"_3587":73528,"_30795":73522,"_5":31151,"_21329":123772,"_27997":123773,"_3043":123774},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3587":73529,"_30795":73522,"_21329":123776,"_5":14664,"_27997":73522,"_3043":123777},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3587":73530,"_30795":73522,"_21329":123779,"_5":14664,"_27997":123760,"_3043":123780},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3587":73531,"_30795":73522,"_21329":123782,"_5":14664,"_27997":123760,"_3043":123783},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3587":73532,"_30795":73522,"_21329":123785,"_5":14664,"_27997":123764,"_3043":123786},[],"Recurso",{"_3587":73533,"_30795":73522,"_21329":123788,"_5":14664,"_27997":123764,"_3043":123789},[],"Qué representa",{"_3587":73534,"_30795":73522,"_21329":123791,"_5":14664,"_27997":123764,"_3043":123792},[],"**Dispositivo**",{"_3587":73535,"_30795":73522,"_21329":123794,"_5":14664,"_27997":123764,"_3043":123795},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3587":73536,"_30795":73522,"_21329":123797,"_5":14664,"_27997":123764,"_3043":123798},[],"**Identidad**",{"_3587":73537,"_30795":73522,"_21329":123800,"_5":14664,"_27997":123764,"_3043":123801},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3587":73538,"_30795":73522,"_21329":123803,"_5":14664,"_27997":123764,"_3043":55399},[],{"_3587":73539,"_30795":73522,"_21329":123805,"_5":14664,"_27997":123764,"_3043":123806},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3587":73540,"_30795":73522,"_21329":123808,"_5":14664,"_27997":123764,"_3043":123809},[],"**Flota**",{"_3587":73541,"_30795":73522,"_21329":123811,"_5":14664,"_27997":123764,"_3043":123812},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3587":73542,"_30795":73522,"_21329":123814,"_5":14664,"_27997":123764,"_3043":123815},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3587":73543,"_30795":73522,"_21329":123817,"_5":14664,"_27997":123764,"_3043":123818},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3587":73544,"_30795":73522,"_21329":123820,"_5":14664,"_27997":123767,"_3043":123821},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3587":73545,"_30795":73522,"_21329":123823,"_5":14664,"_27997":123767,"_3043":123824},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3587":73546,"_30795":73522,"_21329":123826,"_5":14664,"_27997":123767,"_3043":123827},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3587":73547,"_30795":73522,"_21329":123829,"_5":14664,"_27997":123767,"_3043":123830},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3587":73548,"_30795":73522,"_21329":123832,"_5":14664,"_27997":123767,"_3043":123833},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3587":73549,"_30795":73522,"_21329":123835,"_5":14664,"_27997":123767,"_3043":123836},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3587":73550,"_30795":73522,"_21329":123838,"_5":14664,"_27997":123767,"_3043":123839},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3587":73551,"_30795":73522,"_21329":123841,"_5":14664,"_27997":123767,"_3043":123842},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3587":73552,"_30795":73522,"_21329":123844,"_5":14664,"_27997":123770,"_3043":123845},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3587":73553,"_30795":73522,"_21329":123847,"_5":14664,"_27997":123770,"_3043":123848},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3587":73554,"_30795":73522,"_21329":123850,"_5":14664,"_27997":123773,"_3043":123851},[],"Participante",{"_3587":73555,"_30795":73522,"_21329":123853,"_5":14664,"_27997":123773,"_3043":123854},[],"Responsabilidad",{"_3587":73556,"_30795":73522,"_21329":123856,"_5":14664,"_27997":123773,"_3043":123857},[],"Administrador PKI",{"_3587":73557,"_30795":73522,"_21329":123859,"_5":14664,"_27997":123773,"_3043":123860},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3587":73558,"_30795":73522,"_21329":123862,"_5":14664,"_27997":123773,"_3043":123863},[],"Administrador del aprovisionamiento",{"_3587":73559,"_30795":73522,"_21329":123865,"_5":14664,"_27997":123773,"_3043":123866},[],"DMS, admisión, autenticación por operación e inventario.",{"_3587":73560,"_30795":73522,"_21329":123868,"_5":14664,"_27997":123773,"_3043":123869},[],"Integrador del dispositivo",{"_3587":73561,"_30795":73522,"_21329":123871,"_5":14664,"_27997":123773,"_3043":123872},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3587":73562,"_30795":73522,"_21329":123874,"_5":14664,"_27997":123773,"_3043":123875},[],"Integrador del consumidor",{"_3587":73563,"_30795":73522,"_21329":123877,"_5":14664,"_27997":123773,"_3043":123878},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3587":73564,"_30795":73522,"_21329":123880,"_5":14664,"_27997":123773,"_3043":123881},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3587":73565,"_30795":73565,"_5":15024,"_3043":123883,"_31154":123884,"_21329":123886,"_27997":73565},"Enrola y conecta tu primer dispositivo",[50381,120436,53053,123885],"Primeros pasos",[],{"_3587":73566,"_30795":73565,"_21329":123888,"_5":14664,"_27997":73565,"_3043":123889},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3587":73567,"_30795":73565,"_5":31151,"_21329":123891,"_27997":123892,"_3043":118970},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3587":73568,"_30795":73565,"_5":31151,"_21329":123894,"_27997":123895,"_3043":123896},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3587":73569,"_30795":73565,"_5":31151,"_21329":123898,"_27997":123899,"_3043":123900},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3587":73570,"_30795":73565,"_5":31151,"_21329":123902,"_27997":123903,"_3043":123904},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3587":73571,"_30795":73565,"_5":31151,"_21329":123906,"_27997":123907,"_3043":123908},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3587":73572,"_30795":73565,"_5":31151,"_21329":123910,"_27997":123911,"_3043":123912},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3587":73573,"_30795":73565,"_5":31151,"_21329":123914,"_27997":123915,"_3043":123916},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3587":73574,"_30795":73565,"_5":31151,"_21329":123918,"_27997":123919,"_3043":123920},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3587":73575,"_30795":73565,"_21329":123922,"_5":14664,"_27997":73565,"_3043":123923},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3587":73576,"_30795":73565,"_21329":123925,"_5":14664,"_27997":123892,"_3043":123926},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3587":73577,"_30795":73565,"_21329":123928,"_5":14664,"_27997":123892,"_3043":123929},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3587":73578,"_30795":73565,"_21329":123931,"_5":14664,"_27997":123892,"_3043":123932},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3587":73579,"_30795":73565,"_21329":123934,"_5":14664,"_27997":123892,"_3043":123935},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3587":73580,"_30795":73565,"_21329":123937,"_5":14664,"_27997":123892,"_3043":123938},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3587":73581,"_30795":73565,"_21329":123940,"_5":14664,"_27997":123895,"_3043":123941},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3587":73582,"_30795":73565,"_21329":123943,"_5":14664,"_27997":123895,"_3043":123944},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3587":73583,"_30795":73565,"_21329":123946,"_5":14664,"_27997":123899,"_3043":123947},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3587":73584,"_30795":73565,"_21329":123949,"_5":14664,"_27997":123899,"_3043":123950},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3587":73585,"_30795":73565,"_21329":123952,"_5":14664,"_27997":123899,"_3043":123953},[],"Ajuste",{"_3587":73586,"_30795":73565,"_21329":123955,"_5":14664,"_27997":123899,"_3043":123956},[],"Valor de evaluación",{"_3587":73587,"_30795":73565,"_21329":123958,"_5":14664,"_27997":123899,"_3043":55555},[],{"_3587":73588,"_30795":73565,"_21329":123960,"_5":14664,"_27997":123899,"_3043":123961},[],"Raíz emisora de `device-root.pem`.",{"_3587":73589,"_30795":73565,"_21329":123963,"_5":14664,"_27997":123899,"_3043":121872},[],{"_3587":73590,"_30795":73565,"_21329":123965,"_5":14664,"_27997":123899,"_3043":123966},[],"Perfil final de 1 hora que acabas de preparar.",{"_3587":73591,"_30795":73565,"_21329":123968,"_5":14664,"_27997":123899,"_3043":55566},[],{"_3587":73592,"_30795":73565,"_21329":123970,"_5":14664,"_27997":123899,"_3043":55569},[],{"_3587":73593,"_30795":73565,"_21329":123972,"_5":14664,"_27997":123899,"_3043":55572},[],{"_3587":73594,"_30795":73565,"_21329":123974,"_5":14664,"_27997":123899,"_3043":123975},[],"Habilitado.",{"_3587":73595,"_30795":73565,"_21329":123977,"_5":14664,"_27997":123899,"_3043":55578},[],{"_3587":73596,"_30795":73565,"_21329":123979,"_5":14664,"_27997":123899,"_3043":123980},[],"Deshabilitado; el ID debe ser nuevo.",{"_3587":73597,"_30795":73565,"_21329":123982,"_5":14664,"_27997":123899,"_3043":123983},[],"Autenticación inicial",{"_3587":73598,"_30795":73565,"_21329":123985,"_5":14664,"_27997":123899,"_3043":123986},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3587":73599,"_30795":73565,"_21329":123988,"_5":14664,"_27997":123899,"_3043":123989},[],"Autenticación de renovación",{"_3587":73600,"_30795":73565,"_21329":123991,"_5":14664,"_27997":123899,"_3043":123992},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3587":73601,"_30795":73565,"_21329":123994,"_5":14664,"_27997":123899,"_3043":55596},[],{"_3587":73602,"_30795":73565,"_21329":123996,"_5":14664,"_27997":123899,"_3043":123997},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3587":73603,"_30795":73565,"_21329":123999,"_5":14664,"_27997":123899,"_3043":55602},[],{"_3587":73604,"_30795":73565,"_21329":124001,"_5":14664,"_27997":123899,"_3043":124002},[],"1 hora.",{"_3587":73605,"_30795":73565,"_21329":124004,"_5":14664,"_27997":123899,"_3043":55608},[],{"_3587":73606,"_30795":73565,"_21329":124006,"_5":14664,"_27997":123899,"_3043":124007},[],"30 minutos / 10 minutos.",{"_3587":73607,"_30795":73565,"_21329":124009,"_5":14664,"_27997":123899,"_3043":55614},[],{"_3587":73608,"_30795":73565,"_21329":124011,"_5":14664,"_27997":123899,"_3043":124012},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3587":73609,"_30795":73565,"_21329":124014,"_5":14664,"_27997":123899,"_3043":53372},[],{"_3587":73610,"_30795":73565,"_21329":124016,"_5":14664,"_27997":123899,"_3043":124017},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3587":73611,"_30795":73565,"_21329":124019,"_5":14664,"_27997":123899,"_3043":55625},[],{"_3587":73612,"_30795":73565,"_21329":124021,"_5":14664,"_27997":123899,"_3043":124022},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3587":73613,"_30795":73565,"_21329":124024,"_5":14664,"_27997":123899,"_3043":124025},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3587":73614,"_30795":73565,"_21329":124027,"_5":14664,"_27997":123903,"_3043":124028},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3587":73615,"_30795":73565,"_21329":124030,"_5":14664,"_27997":123903,"_3043":124031},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3587":73616,"_30795":73565,"_21329":124033,"_5":14664,"_27997":123907,"_3043":124034},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3587":73617,"_30795":73565,"_21329":124036,"_5":14664,"_27997":123907,"_3043":124037},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3587":73618,"_30795":73565,"_21329":124039,"_5":14664,"_27997":123907,"_3043":124040},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3587":73619,"_30795":73565,"_21329":124042,"_5":14664,"_27997":123911,"_3043":124043},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3587":73620,"_30795":73565,"_21329":124045,"_5":14664,"_27997":123911,"_3043":124046},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3587":73621,"_30795":73565,"_21329":124048,"_5":14664,"_27997":123915,"_3043":124049},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3587":73622,"_30795":73565,"_21329":124051,"_5":14664,"_27997":123915,"_3043":124052},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3587":73623,"_30795":73565,"_21329":124054,"_5":14664,"_27997":123915,"_3043":124055},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3587":73624,"_30795":73565,"_21329":124057,"_5":14664,"_27997":123915,"_3043":124058},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3587":73625,"_30795":73565,"_21329":124060,"_5":14664,"_27997":123915,"_3043":124061},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3587":73626,"_30795":73565,"_21329":124063,"_5":14664,"_27997":123919,"_3043":124064},[],"Comprobación",{"_3587":73627,"_30795":73565,"_21329":124066,"_5":14664,"_27997":123919,"_3043":124067},[],"Resultado esperado",{"_3587":73628,"_30795":73565,"_21329":124069,"_5":14664,"_27997":123919,"_3043":124070},[],"Registro",{"_3587":73629,"_30795":73565,"_21329":124072,"_5":14664,"_27997":123919,"_3043":124073},[],"ID creado automáticamente y DMS correcto.",{"_3587":73630,"_30795":73565,"_21329":124075,"_5":14664,"_27997":123919,"_3043":123360},[],{"_3587":73631,"_30795":73565,"_21329":124077,"_5":14664,"_27997":123919,"_3043":124078},[],"CN, perfil, serie y clave verificados.",{"_3587":73632,"_30795":73565,"_21329":124080,"_5":14664,"_27997":123919,"_3043":124081},[],"Inventario",{"_3587":73633,"_30795":73565,"_21329":124083,"_5":14664,"_27997":123919,"_3043":124084},[],"Serie recibida visible como identidad actual y en el historial.",{"_3587":73634,"_30795":73565,"_21329":124086,"_5":14664,"_27997":123919,"_3043":124087},[],"Consumidor",{"_3587":73635,"_30795":73565,"_21329":124089,"_5":14664,"_27997":123919,"_3043":124090},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3587":73636,"_30795":73565,"_21329":124092,"_5":14664,"_27997":123919,"_3043":124093},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3587":73637,"_30795":73565,"_21329":124095,"_5":14664,"_27997":123919,"_3043":124096},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3587":73638,"_30795":73638,"_5":15024,"_3043":121586,"_31154":124098,"_21329":124099,"_27997":73638},[50381,120436,53053,123885],[],{"_3587":73639,"_30795":73638,"_21329":124101,"_5":14664,"_27997":73638,"_3043":124102},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3587":73640,"_30795":73638,"_5":31151,"_21329":124104,"_27997":124105,"_3043":118970},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3587":73641,"_30795":73638,"_5":31151,"_21329":124107,"_27997":124108,"_3043":124109},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3587":73642,"_30795":73638,"_5":31151,"_21329":124111,"_27997":124112,"_3043":124113},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3587":73643,"_30795":73638,"_5":31151,"_21329":124115,"_27997":124116,"_3043":124117},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3587":73644,"_30795":73638,"_5":31151,"_21329":124119,"_27997":124120,"_3043":124121},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3587":73645,"_30795":73638,"_5":31151,"_21329":124123,"_27997":124124,"_3043":124125},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3587":73646,"_30795":73638,"_5":31151,"_21329":124127,"_27997":124128,"_3043":124067},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3587":73647,"_30795":73638,"_5":31151,"_21329":124130,"_27997":124131,"_3043":124132},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3587":73648,"_30795":73638,"_5":31151,"_21329":124134,"_27997":124135,"_3043":124136},[],"/docs/pr-preview/pr-70/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3587":73649,"_30795":73638,"_21329":124138,"_5":14664,"_27997":73638,"_3043":124139},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3587":73650,"_30795":73638,"_21329":124141,"_5":14664,"_27997":73638,"_3043":124142},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3587":73651,"_30795":73638,"_21329":124144,"_5":14664,"_27997":124105,"_3043":124145},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3587":73652,"_30795":73638,"_21329":124147,"_5":14664,"_27997":124105,"_3043":124148},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3587":73653,"_30795":73638,"_21329":124150,"_5":14664,"_27997":124105,"_3043":124151},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3587":73654,"_30795":73638,"_21329":124153,"_5":14664,"_27997":124105,"_3043":124154},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3587":73655,"_30795":73638,"_21329":124156,"_5":14664,"_27997":124108,"_3043":124157},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3587":73656,"_30795":73638,"_21329":124159,"_5":14664,"_27997":124108,"_3043":124160},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3587":73657,"_30795":73638,"_21329":124162,"_5":14664,"_27997":124108,"_3043":124163},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3587":73658,"_30795":73638,"_21329":124165,"_5":14664,"_27997":124108,"_3043":124166},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3587":73659,"_30795":73638,"_21329":124168,"_5":14664,"_27997":124108,"_3043":124169},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3587":73660,"_30795":73638,"_21329":124171,"_5":14664,"_27997":124108,"_3043":124172},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3587":73661,"_30795":73638,"_21329":124174,"_5":14664,"_27997":124108,"_3043":124175},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3587":73662,"_30795":73638,"_21329":124177,"_5":14664,"_27997":124108,"_3043":124178},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3587":73663,"_30795":73638,"_21329":124180,"_5":14664,"_27997":124112,"_3043":124181},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3587":73664,"_30795":73638,"_21329":124183,"_5":14664,"_27997":124112,"_3043":55790},[],{"_3587":73665,"_30795":73638,"_21329":124185,"_5":14664,"_27997":124112,"_3043":124186},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3587":73666,"_30795":73638,"_21329":124188,"_5":14664,"_27997":124112,"_3043":124189},[],"**Icon** y **Tags**: clasificación opcional.",{"_3587":73667,"_30795":73638,"_21329":124191,"_5":14664,"_27997":124112,"_3043":124192},[],"Confirma el registro.",{"_3587":73668,"_30795":73638,"_21329":124194,"_5":14664,"_27997":124116,"_3043":124195},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3587":73669,"_30795":73638,"_21329":124197,"_5":14664,"_27997":124116,"_3043":124198},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3587":73670,"_30795":73638,"_21329":124200,"_5":14664,"_27997":124120,"_3043":124201},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3587":73671,"_30795":73638,"_21329":124203,"_5":14664,"_27997":124120,"_3043":124204},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3587":73672,"_30795":73638,"_21329":124206,"_5":14664,"_27997":124124,"_3043":124207},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3587":73673,"_30795":73638,"_21329":124209,"_5":14664,"_27997":124124,"_3043":124210},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3587":73674,"_30795":73638,"_21329":124212,"_5":14664,"_27997":124128,"_3043":124064},[],{"_3587":73675,"_30795":73638,"_21329":124214,"_5":14664,"_27997":124128,"_3043":124215},[],"Resultado",{"_3587":73676,"_30795":73638,"_21329":124217,"_5":14664,"_27997":124128,"_3043":123346},[],{"_3587":73677,"_30795":73638,"_21329":124219,"_5":14664,"_27997":124128,"_3043":124220},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3587":73678,"_30795":73638,"_21329":124222,"_5":14664,"_27997":124128,"_3043":124223},[],"Identidad actual",{"_3587":73679,"_30795":73638,"_21329":124225,"_5":14664,"_27997":124128,"_3043":124226},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3587":73680,"_30795":73638,"_21329":124228,"_5":14664,"_27997":124128,"_3043":124229},[],"Historial",{"_3587":73681,"_30795":73638,"_21329":124231,"_5":14664,"_27997":124128,"_3043":124232},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3587":73682,"_30795":73638,"_21329":124234,"_5":14664,"_27997":124128,"_3043":124235},[],"Clave y certificado",{"_3587":73683,"_30795":73638,"_21329":124237,"_5":14664,"_27997":124128,"_3043":124238},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3587":73684,"_30795":73638,"_21329":124240,"_5":14664,"_27997":124131,"_3043":124241},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3587":73685,"_30795":73638,"_21329":124243,"_5":14664,"_27997":124131,"_3043":124244},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3587":73686,"_30795":73638,"_21329":124246,"_5":14664,"_27997":124131,"_3043":124247},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3587":73687,"_30795":73638,"_21329":124249,"_5":14664,"_27997":124131,"_3043":124250},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3587":73688,"_30795":73638,"_21329":124252,"_5":14664,"_27997":124135,"_3043":124253},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3587":73689,"_30795":73638,"_21329":124255,"_5":14664,"_27997":124135,"_3043":124256},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3587":73690,"_30795":73638,"_21329":124258,"_5":14664,"_27997":124135,"_3043":124259},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3587":73691,"_30795":73691,"_5":15024,"_3043":124261,"_31154":124262,"_21329":124263,"_27997":73691},"Plataforma Lamassu IoT",[50381,120436],[],{"_3587":73692,"_30795":73691,"_21329":124265,"_5":14664,"_27997":73691,"_3043":124266},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3587":73693,"_30795":73691,"_5":31151,"_21329":124268,"_27997":124269,"_3043":123761},[],"/docs/pr-preview/pr-70/es/platform/overview#empieza-aquí",{"_3587":73694,"_30795":73691,"_5":31151,"_21329":124271,"_27997":124272,"_3043":124273},[],"/docs/pr-preview/pr-70/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3587":73695,"_30795":73691,"_5":31151,"_21329":124275,"_27997":124276,"_3043":124277},[],"/docs/pr-preview/pr-70/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3587":73696,"_30795":73691,"_5":31151,"_21329":124279,"_27997":124280,"_3043":124281},[],"/docs/pr-preview/pr-70/es/platform/overview#capacidades-principales","Capacidades principales",{"_3587":73697,"_30795":73691,"_5":31151,"_21329":124283,"_27997":124284,"_3043":124285},[],"/docs/pr-preview/pr-70/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3587":73698,"_30795":73691,"_5":31151,"_21329":124287,"_27997":124288,"_3043":124289},[],"/docs/pr-preview/pr-70/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3587":73699,"_30795":73691,"_5":31151,"_21329":124291,"_27997":124292,"_3043":124293},[],"/docs/pr-preview/pr-70/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3587":73700,"_30795":73691,"_5":31151,"_21329":124295,"_27997":124296,"_3043":124297},[],"/docs/pr-preview/pr-70/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3587":73701,"_30795":73691,"_5":31151,"_21329":124299,"_27997":124300,"_3043":124301},[],"/docs/pr-preview/pr-70/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3587":73702,"_30795":73691,"_5":31151,"_21329":124303,"_27997":124304,"_3043":124305},[],"/docs/pr-preview/pr-70/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3587":73703,"_30795":73691,"_5":31151,"_21329":124307,"_27997":124308,"_3043":124309},[],"/docs/pr-preview/pr-70/es/platform/overview#referencia-operativa","Referencia operativa",{"_3587":73704,"_30795":73691,"_21329":124311,"_5":14664,"_27997":73691,"_3043":124312},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3587":73705,"_30795":73691,"_21329":124314,"_5":14664,"_27997":124269,"_3043":124315},[],"Elige el resultado que necesitas obtener:",{"_3587":73706,"_30795":73691,"_21329":124317,"_5":14664,"_27997":124269,"_3043":124318},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3587":73707,"_30795":73691,"_21329":124320,"_5":14664,"_27997":124269,"_3043":124321},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3587":73708,"_30795":73691,"_21329":124323,"_5":14664,"_27997":124269,"_3043":124324},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3587":73709,"_30795":73691,"_21329":124326,"_5":14664,"_27997":124272,"_3043":124327},[],"Bloque",{"_3587":73710,"_30795":73691,"_21329":124329,"_5":14664,"_27997":124272,"_3043":124330},[],"Qué gestionas",{"_3587":73711,"_30795":73691,"_21329":124332,"_5":14664,"_27997":124272,"_3043":124333},[],"Punto de entrada",{"_3587":73712,"_30795":73691,"_21329":124335,"_5":14664,"_27997":124272,"_3043":55943},[],{"_3587":73713,"_30795":73691,"_21329":124337,"_5":14664,"_27997":124272,"_3043":124338},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3587":73714,"_30795":73691,"_21329":124340,"_5":14664,"_27997":124272,"_3043":124341},[],"Visión general de PKI",{"_3587":73715,"_30795":73691,"_21329":124343,"_5":14664,"_27997":124272,"_3043":55952},[],{"_3587":73716,"_30795":73691,"_21329":124345,"_5":14664,"_27997":124272,"_3043":124346},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3587":73717,"_30795":73691,"_21329":124348,"_5":14664,"_27997":124272,"_3043":124349},[],"Visión general de IoT Fleets",{"_3587":73718,"_30795":73691,"_21329":124351,"_5":14664,"_27997":124272,"_3043":124352},[],"**Administración**",{"_3587":73719,"_30795":73691,"_21329":124354,"_5":14664,"_27997":124272,"_3043":124355},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3587":73720,"_30795":73691,"_21329":124357,"_5":14664,"_27997":124272,"_3043":120438},[],{"_3587":73721,"_30795":73691,"_21329":124359,"_5":14664,"_27997":124272,"_3043":124360},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3587":73722,"_30795":73691,"_21329":124362,"_5":14664,"_27997":124276,"_3043":124363},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3587":73723,"_30795":73691,"_21329":124365,"_5":14664,"_27997":124276,"_3043":124366},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3587":73724,"_30795":73691,"_21329":124368,"_5":14664,"_27997":124276,"_3043":124369},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3587":73725,"_30795":73691,"_21329":124371,"_5":14664,"_27997":124276,"_3043":124372},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3587":73726,"_30795":73691,"_21329":124374,"_5":14664,"_27997":124276,"_3043":124375},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3587":73727,"_30795":73691,"_21329":124377,"_5":14664,"_27997":124276,"_3043":124378},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3587":73728,"_30795":73691,"_21329":124380,"_5":14664,"_27997":124284,"_3043":124381},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3587":73729,"_30795":73691,"_21329":124383,"_5":14664,"_27997":124288,"_3043":124384},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3587":73730,"_30795":73691,"_21329":124386,"_5":14664,"_27997":124292,"_3043":124387},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3587":73731,"_30795":73691,"_21329":124389,"_5":14664,"_27997":124296,"_3043":124390},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3587":73732,"_30795":73691,"_21329":124392,"_5":14664,"_27997":124300,"_3043":124393},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3587":73733,"_30795":73691,"_21329":124395,"_5":14664,"_27997":124304,"_3043":124396},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3587":73734,"_30795":73691,"_21329":124398,"_5":14664,"_27997":124308,"_3043":123854},[],{"_3587":73735,"_30795":73691,"_21329":124400,"_5":14664,"_27997":124308,"_3043":124401},[],"Qué prepara o comprueba",{"_3587":73736,"_30795":73691,"_21329":124403,"_5":14664,"_27997":124308,"_3043":123857},[],{"_3587":73737,"_30795":73691,"_21329":124405,"_5":14664,"_27997":124308,"_3043":124406},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3587":73738,"_30795":73691,"_21329":124408,"_5":14664,"_27997":124308,"_3043":124409},[],"Administrador de la flota",{"_3587":73739,"_30795":73691,"_21329":124411,"_5":14664,"_27997":124308,"_3043":124412},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3587":73740,"_30795":73691,"_21329":124414,"_5":14664,"_27997":124308,"_3043":123869},[],{"_3587":73741,"_30795":73691,"_21329":124416,"_5":14664,"_27997":124308,"_3043":124417},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3587":73742,"_30795":73691,"_21329":124419,"_5":14664,"_27997":124308,"_3043":123875},[],{"_3587":73743,"_30795":73691,"_21329":124421,"_5":14664,"_27997":124308,"_3043":124422},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3587":73744,"_30795":73691,"_21329":124424,"_5":14664,"_27997":124308,"_3043":124425},[],"Operador de infraestructura",{"_3587":73745,"_30795":73691,"_21329":124427,"_5":14664,"_27997":124308,"_3043":124428},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3587":73746,"_30795":73691,"_21329":124430,"_5":14664,"_27997":124308,"_3043":124431},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3587":73747,"_30795":73747,"_5":15024,"_3043":124433,"_31154":124434,"_21329":124436,"_27997":73747},"Jerarquía y rotación de CAs",[50381,120436,56044,124435],"Claves, autoridades y certificados",[],{"_3587":73748,"_30795":73747,"_21329":124438,"_5":14664,"_27997":73747,"_3043":124439},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3587":73749,"_30795":73747,"_5":31151,"_21329":124441,"_27997":124442,"_3043":124443},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3587":73750,"_30795":73747,"_5":31151,"_21329":124445,"_27997":124446,"_3043":124447},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3587":73751,"_30795":73747,"_5":31151,"_21329":124449,"_27997":124450,"_3043":124451},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3587":73752,"_30795":73747,"_5":31151,"_21329":124453,"_27997":124454,"_3043":124455},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3587":73753,"_30795":73747,"_5":31151,"_21329":124457,"_27997":124458,"_3043":124459},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3587":73754,"_30795":73747,"_5":31151,"_21329":124461,"_27997":124462,"_3043":124463},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3587":73755,"_30795":73747,"_5":31151,"_21329":124465,"_27997":124466,"_3043":124467},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3587":73756,"_30795":73747,"_5":31151,"_21329":124469,"_27997":124470,"_3043":124471},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3587":73757,"_30795":73747,"_5":31151,"_21329":124473,"_27997":124474,"_3043":124475},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3587":73758,"_30795":73747,"_5":31151,"_21329":124477,"_27997":124478,"_3043":124479},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3587":73759,"_30795":73747,"_5":31151,"_21329":124481,"_27997":124482,"_3043":124483},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3587":73760,"_30795":73747,"_5":31151,"_21329":124485,"_27997":124486,"_3043":124487},[],"/docs/pr-preview/pr-70/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3587":73761,"_30795":73747,"_21329":124489,"_5":14664,"_27997":73747,"_3043":124490},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3587":73762,"_30795":73747,"_21329":124492,"_5":14664,"_27997":73747,"_3043":124493},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3587":73763,"_30795":73747,"_21329":124495,"_5":14664,"_27997":124442,"_3043":124496},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3587":73764,"_30795":73747,"_21329":124498,"_5":14664,"_27997":124442,"_3043":124499},[],"entorno, como producción y preproducción;",{"_3587":73765,"_30795":73747,"_21329":124501,"_5":14664,"_27997":124442,"_3043":124502},[],"propietario o equipo operador;",{"_3587":73766,"_30795":73747,"_21329":124504,"_5":14664,"_27997":124442,"_3043":124505},[],"familia de dispositivos o proceso de fabricación;",{"_3587":73767,"_30795":73747,"_21329":124507,"_5":14664,"_27997":124442,"_3043":124508},[],"región o requisito regulatorio;",{"_3587":73768,"_30795":73747,"_21329":124510,"_5":14664,"_27997":124442,"_3043":124511},[],"motor criptográfico o política de clave;",{"_3587":73769,"_30795":73747,"_21329":124513,"_5":14664,"_27997":124442,"_3043":124514},[],"ventana de mantenimiento y ritmo de renovación.",{"_3587":73770,"_30795":73747,"_21329":124516,"_5":14664,"_27997":124442,"_3043":124517},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3587":73771,"_30795":73747,"_21329":124519,"_5":14664,"_27997":124442,"_3043":124520},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3587":73772,"_30795":73747,"_21329":124522,"_5":14664,"_27997":124446,"_3043":124523},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3587":73773,"_30795":73747,"_21329":124525,"_5":14664,"_27997":124446,"_3043":124526},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3587":73774,"_30795":73747,"_21329":124528,"_5":14664,"_27997":124446,"_3043":124529},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3587":73775,"_30795":73747,"_21329":124531,"_5":14664,"_27997":124446,"_3043":124532},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3587":73776,"_30795":73747,"_21329":124534,"_5":14664,"_27997":124450,"_3043":124535},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3587":73777,"_30795":73747,"_21329":124537,"_5":14664,"_27997":124450,"_3043":124538},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3587":73778,"_30795":73747,"_21329":124540,"_5":14664,"_27997":124450,"_3043":124541},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3587":73779,"_30795":73747,"_21329":124543,"_5":14664,"_27997":124450,"_3043":124544},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3587":73780,"_30795":73747,"_21329":124546,"_5":14664,"_27997":124458,"_3043":124547},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3587":73781,"_30795":73747,"_21329":124549,"_5":14664,"_27997":124462,"_3043":124550},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3587":73782,"_30795":73747,"_21329":124552,"_5":14664,"_27997":124466,"_3043":124553},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3587":73783,"_30795":73747,"_21329":124555,"_5":14664,"_27997":124470,"_3043":124556},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3587":73784,"_30795":73747,"_21329":124558,"_5":14664,"_27997":124474,"_3043":124559},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3587":73785,"_30795":73747,"_21329":124561,"_5":14664,"_27997":124478,"_3043":124562},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3587":73786,"_30795":73747,"_21329":124564,"_5":14664,"_27997":124482,"_3043":124565},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3587":73787,"_30795":73747,"_21329":124567,"_5":14664,"_27997":124482,"_3043":124568},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3587":73788,"_30795":73747,"_21329":124570,"_5":14664,"_27997":124482,"_3043":124571},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3587":73789,"_30795":73747,"_21329":124573,"_5":14664,"_27997":124482,"_3043":124574},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3587":73790,"_30795":73747,"_21329":124576,"_5":14664,"_27997":124486,"_3043":124577},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3587":73791,"_30795":73747,"_21329":124579,"_5":14664,"_27997":124486,"_3043":124580},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3587":73792,"_30795":73747,"_21329":124582,"_5":14664,"_27997":124486,"_3043":124583},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3587":73793,"_30795":73747,"_21329":124585,"_5":14664,"_27997":124486,"_3043":124586},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3587":73794,"_30795":73747,"_21329":124588,"_5":14664,"_27997":124486,"_3043":124589},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3587":73795,"_30795":73747,"_21329":124591,"_5":14664,"_27997":124486,"_3043":124592},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3587":73796,"_30795":73747,"_21329":124594,"_5":14664,"_27997":124486,"_3043":124595},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3587":73797,"_30795":73797,"_5":15024,"_3043":124597,"_31154":124598,"_21329":124599,"_27997":73797},"Autoridades de certificación",[50381,120436,56044,124435],[],{"_3587":73798,"_30795":73797,"_21329":124601,"_5":14664,"_27997":73797,"_3043":124602},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3587":73799,"_30795":73797,"_5":31151,"_21329":124604,"_27997":124605,"_3043":124606},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3587":73800,"_30795":73797,"_5":31151,"_21329":124608,"_27997":124609,"_3043":124610},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3587":73801,"_30795":73797,"_5":31151,"_21329":124612,"_27997":124613,"_3043":118970},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3587":73802,"_30795":73797,"_5":31151,"_21329":124615,"_27997":124616,"_3043":124617},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3587":73803,"_30795":73797,"_5":31151,"_21329":124619,"_27997":124620,"_3043":124621},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3587":73804,"_30795":73797,"_5":31151,"_21329":124623,"_27997":124624,"_3043":124625},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3587":73805,"_30795":73797,"_5":31151,"_21329":124627,"_27997":124628,"_3043":124629},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3587":73806,"_30795":73797,"_5":31151,"_21329":124631,"_27997":124632,"_3043":124633},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3587":73807,"_30795":73797,"_5":31151,"_21329":124635,"_27997":124636,"_3043":124637},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3587":73808,"_30795":73797,"_5":31151,"_21329":124639,"_27997":124640,"_3043":124641},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3587":73809,"_30795":73797,"_5":31151,"_21329":124643,"_27997":124644,"_3043":124645},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3587":73810,"_30795":73797,"_5":31151,"_21329":124647,"_27997":124648,"_3043":124649},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3587":73811,"_30795":73797,"_5":31151,"_21329":124651,"_27997":124652,"_3043":124653},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3587":73812,"_30795":73797,"_5":31151,"_21329":124655,"_27997":124656,"_3043":124657},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3587":73813,"_30795":73797,"_5":31151,"_21329":124659,"_27997":124660,"_3043":124661},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3587":73814,"_30795":73797,"_5":31151,"_21329":124663,"_27997":124664,"_3043":124665},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3587":73815,"_30795":73797,"_5":31151,"_21329":124667,"_27997":124668,"_3043":124669},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3587":73816,"_30795":73797,"_5":31151,"_21329":124671,"_27997":124672,"_3043":124673},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3587":73817,"_30795":73797,"_5":31151,"_21329":124675,"_27997":124676,"_3043":124677},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3587":73818,"_30795":73797,"_5":31151,"_21329":124679,"_27997":124680,"_3043":124681},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3587":73819,"_30795":73797,"_5":31151,"_21329":124683,"_27997":124684,"_3043":124685},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3587":73820,"_30795":73797,"_5":31151,"_21329":124687,"_27997":124688,"_3043":124689},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3587":73821,"_30795":73797,"_5":31151,"_21329":124691,"_27997":124692,"_3043":124693},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3587":73822,"_30795":73797,"_21329":124695,"_5":14664,"_27997":73797,"_3043":124696},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3587":73823,"_30795":73797,"_21329":124698,"_5":14664,"_27997":73797,"_3043":124699},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3587":73824,"_30795":73797,"_21329":124701,"_5":14664,"_27997":73797,"_3043":124702},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3587":73825,"_30795":73797,"_21329":124704,"_5":14664,"_27997":124605,"_3043":124705},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3587":73826,"_30795":73797,"_21329":124707,"_5":14664,"_27997":124605,"_3043":124708},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3587":73827,"_30795":73797,"_21329":124710,"_5":14664,"_27997":124605,"_3043":124711},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3587":73828,"_30795":73797,"_21329":124713,"_5":14664,"_27997":124605,"_3043":124714},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3587":73829,"_30795":73797,"_21329":124716,"_5":14664,"_27997":124605,"_3043":124717},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3587":73830,"_30795":73797,"_21329":124719,"_5":14664,"_27997":124613,"_3043":124720},[],"Decide si la CA será raíz o intermedia.",{"_3587":73831,"_30795":73797,"_21329":124722,"_5":14664,"_27997":124613,"_3043":124723},[],"Elige el motor que custodiará la clave.",{"_3587":73832,"_30795":73797,"_21329":124725,"_5":14664,"_27997":124613,"_3043":124726},[],"Define una validez superior a la de los certificados que emitirá.",{"_3587":73833,"_30795":73797,"_21329":124728,"_5":14664,"_27997":124613,"_3043":124729},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3587":73834,"_30795":73797,"_21329":124731,"_5":14664,"_27997":124616,"_3043":124732},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3587":73835,"_30795":73797,"_21329":124734,"_5":14664,"_27997":124620,"_3043":124735},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3587":73836,"_30795":73797,"_21329":124737,"_5":14664,"_27997":124620,"_3043":124738},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3587":73837,"_30795":73797,"_21329":124740,"_5":14664,"_27997":124624,"_3043":124741},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3587":73838,"_30795":73797,"_21329":124743,"_5":14664,"_27997":124628,"_3043":124744},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3587":73839,"_30795":73797,"_21329":124746,"_5":14664,"_27997":124628,"_3043":124747},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3587":73840,"_30795":73797,"_21329":124749,"_5":14664,"_27997":124628,"_3043":124750},[],"`ST`: estado o provincia.",{"_3587":73841,"_30795":73797,"_21329":124752,"_5":14664,"_27997":124628,"_3043":124753},[],"`L`: localidad.",{"_3587":73842,"_30795":73797,"_21329":124755,"_5":14664,"_27997":124628,"_3043":124756},[],"`O`: organización.",{"_3587":73843,"_30795":73797,"_21329":124758,"_5":14664,"_27997":124628,"_3043":124759},[],"`OU`: unidad organizativa.",{"_3587":73844,"_30795":73797,"_21329":124761,"_5":14664,"_27997":124628,"_3043":124762},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3587":73845,"_30795":73797,"_21329":124764,"_5":14664,"_27997":124632,"_3043":124765},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3587":73846,"_30795":73797,"_21329":124767,"_5":14664,"_27997":124632,"_3043":124768},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3587":73847,"_30795":73797,"_21329":124770,"_5":14664,"_27997":124636,"_3043":124771},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3587":73848,"_30795":73797,"_21329":124773,"_5":14664,"_27997":124636,"_3043":124774},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3587":73849,"_30795":73797,"_21329":124776,"_5":14664,"_27997":124640,"_3043":124777},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3587":73850,"_30795":73797,"_21329":124779,"_5":14664,"_27997":124640,"_3043":124780},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3587":73851,"_30795":73797,"_21329":124782,"_5":14664,"_27997":124644,"_3043":124783},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3587":73852,"_30795":73797,"_21329":124785,"_5":14664,"_27997":124644,"_3043":124786},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3587":73853,"_30795":73797,"_21329":124788,"_5":14664,"_27997":124644,"_3043":124789},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3587":73854,"_30795":73797,"_21329":124791,"_5":14664,"_27997":124648,"_3043":124792},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3587":73855,"_30795":73797,"_21329":124794,"_5":14664,"_27997":124652,"_3043":124795},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3587":73856,"_30795":73797,"_21329":124797,"_5":14664,"_27997":124652,"_3043":124798},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3587":73857,"_30795":73797,"_21329":124800,"_5":14664,"_27997":124656,"_3043":124801},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3587":73858,"_30795":73797,"_21329":124803,"_5":14664,"_27997":124660,"_3043":124804},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3587":73859,"_30795":73797,"_21329":124806,"_5":14664,"_27997":124660,"_3043":124807},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3587":73860,"_30795":73797,"_21329":124809,"_5":14664,"_27997":124664,"_3043":124810},[],"Abre una CA desde el inventario para consultar:",{"_3587":73861,"_30795":73797,"_21329":124812,"_5":14664,"_27997":124664,"_3043":124813},[],"Estado y periodo de validez.",{"_3587":73862,"_30795":73797,"_21329":124815,"_5":14664,"_27997":124664,"_3043":124816},[],"Certificado y cadena en formato PEM.",{"_3587":73863,"_30795":73797,"_21329":124818,"_5":14664,"_27997":124664,"_3043":124819},[],"Número de certificados activos, expirados y revocados.",{"_3587":73864,"_30795":73797,"_21329":124821,"_5":14664,"_27997":124664,"_3043":124822},[],"Certificados emitidos en **Issued Certificates**.",{"_3587":73865,"_30795":73797,"_21329":124824,"_5":14664,"_27997":124664,"_3043":124825},[],"CRL vinculada a la autoridad.",{"_3587":73866,"_30795":73797,"_21329":124827,"_5":14664,"_27997":124664,"_3043":124828},[],"Metadatos y motor criptográfico asociado.",{"_3587":73867,"_30795":73797,"_21329":124830,"_5":14664,"_27997":124664,"_3043":124831},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3587":73868,"_30795":73797,"_21329":124833,"_5":14664,"_27997":124668,"_3043":124834},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3587":73869,"_30795":73797,"_21329":124836,"_5":14664,"_27997":124668,"_3043":124837},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3587":73870,"_30795":73797,"_21329":124839,"_5":14664,"_27997":124668,"_3043":124840},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3587":73871,"_30795":73797,"_21329":124842,"_5":14664,"_27997":124668,"_3043":124843},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3587":73872,"_30795":73797,"_21329":124845,"_5":14664,"_27997":124672,"_3043":124846},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3587":73873,"_30795":73797,"_21329":124848,"_5":14664,"_27997":124676,"_3043":124849},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3587":73874,"_30795":73797,"_21329":124851,"_5":14664,"_27997":124680,"_3043":124852},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3587":73875,"_30795":73797,"_21329":124854,"_5":14664,"_27997":124684,"_3043":124855},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3587":73876,"_30795":73797,"_21329":124857,"_5":14664,"_27997":124688,"_3043":124858},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3587":73877,"_30795":73797,"_21329":124860,"_5":14664,"_27997":124692,"_3043":124861},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3587":73878,"_30795":73797,"_21329":124863,"_5":14664,"_27997":124692,"_3043":124864},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3587":73879,"_30795":73797,"_21329":124866,"_5":14664,"_27997":124692,"_3043":124867},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3587":73880,"_30795":73797,"_21329":124869,"_5":14664,"_27997":124692,"_3043":124870},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3587":73881,"_30795":73881,"_5":15024,"_3043":124872,"_31154":124873,"_21329":124874,"_27997":73881},"Perfiles de certificado",[50381,120436,56044,124435],[],{"_3587":73882,"_30795":73881,"_21329":124876,"_5":14664,"_27997":73881,"_3043":124877},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3587":73883,"_30795":73881,"_5":31151,"_21329":124879,"_27997":124880,"_3043":124881},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3587":73884,"_30795":73881,"_5":31151,"_21329":124883,"_27997":124884,"_3043":124885},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#validez","Validez",{"_3587":73885,"_30795":73881,"_5":31151,"_21329":124887,"_27997":124888,"_3043":124889},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3587":73886,"_30795":73881,"_5":31151,"_21329":124891,"_27997":124892,"_3043":124893},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3587":73887,"_30795":73881,"_5":31151,"_21329":124895,"_27997":124896,"_3043":124897},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3587":73888,"_30795":73881,"_5":31151,"_21329":124899,"_27997":124900,"_3043":124901},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3587":73889,"_30795":73881,"_5":31151,"_21329":124903,"_27997":124904,"_3043":124905},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3587":73890,"_30795":73881,"_5":31151,"_21329":124907,"_27997":124908,"_3043":124909},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3587":73891,"_30795":73881,"_5":31151,"_21329":124911,"_27997":124912,"_3043":124913},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3587":73892,"_30795":73881,"_5":31151,"_21329":124915,"_27997":124916,"_3043":124917},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3587":73893,"_30795":73881,"_5":31151,"_21329":124919,"_27997":124920,"_3043":124921},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3587":73894,"_30795":73881,"_5":31151,"_21329":124923,"_27997":124924,"_3043":124925},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3587":73895,"_30795":73881,"_5":31151,"_21329":124927,"_27997":124928,"_3043":124929},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3587":73896,"_30795":73881,"_5":31151,"_21329":124931,"_27997":124932,"_3043":124933},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3587":73897,"_30795":73881,"_5":31151,"_21329":124935,"_27997":124936,"_3043":124937},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3587":73898,"_30795":73881,"_5":31151,"_21329":124939,"_27997":124940,"_3043":124941},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3587":73899,"_30795":73881,"_21329":124943,"_5":14664,"_27997":73881,"_3043":124944},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3587":73900,"_30795":73881,"_21329":124946,"_5":14664,"_27997":73881,"_3043":124947},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3587":73901,"_30795":73881,"_21329":124949,"_5":14664,"_27997":124884,"_3043":124950},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3587":73902,"_30795":73881,"_21329":124952,"_5":14664,"_27997":124884,"_3043":124953},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3587":73903,"_30795":73881,"_21329":124955,"_5":14664,"_27997":124888,"_3043":124956},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3587":73904,"_30795":73881,"_21329":124958,"_5":14664,"_27997":124892,"_3043":124959},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3587":73905,"_30795":73881,"_21329":124961,"_5":14664,"_27997":124892,"_3043":124962},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3587":73906,"_30795":73881,"_21329":124964,"_5":14664,"_27997":124892,"_3043":124965},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3587":73907,"_30795":73881,"_21329":124967,"_5":14664,"_27997":124896,"_3043":124968},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3587":73908,"_30795":73881,"_21329":124970,"_5":14664,"_27997":124900,"_3043":124971},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3587":73909,"_30795":73881,"_21329":124973,"_5":14664,"_27997":124900,"_3043":124974},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3587":73910,"_30795":73881,"_21329":124976,"_5":14664,"_27997":124904,"_3043":124977},[],"La aplicación criptográfica puede:",{"_3587":73911,"_30795":73881,"_21329":124979,"_5":14664,"_27997":124904,"_3043":124980},[],"permitir o bloquear claves RSA;",{"_3587":73912,"_30795":73881,"_21329":124982,"_5":14664,"_27997":124904,"_3043":124983},[],"limitar los tamaños RSA admitidos;",{"_3587":73913,"_30795":73881,"_21329":124985,"_5":14664,"_27997":124904,"_3043":124986},[],"permitir o bloquear claves ECDSA;",{"_3587":73914,"_30795":73881,"_21329":124988,"_5":14664,"_27997":124904,"_3043":124989},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3587":73915,"_30795":73881,"_21329":124991,"_5":14664,"_27997":124904,"_3043":124992},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3587":73916,"_30795":73881,"_21329":124994,"_5":14664,"_27997":124908,"_3043":124995},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3587":73917,"_30795":73881,"_21329":124997,"_5":14664,"_27997":124908,"_3043":120196},[],{"_3587":73918,"_30795":73881,"_21329":124999,"_5":14664,"_27997":124908,"_3043":125000},[],"Primera opción",{"_3587":73919,"_30795":73881,"_21329":125002,"_5":14664,"_27997":124908,"_3043":125003},[],"Segunda opción",{"_3587":73920,"_30795":73881,"_21329":125005,"_5":14664,"_27997":124908,"_3043":125006},[],"Si no hay ninguna",{"_3587":73921,"_30795":73881,"_21329":125008,"_5":14664,"_27997":124908,"_3043":125009},[],"Firma directa con una CA",{"_3587":73922,"_30795":73881,"_21329":125011,"_5":14664,"_27997":124908,"_3043":125012},[],"`issuance_profile` incluido en la solicitud",{"_3587":73923,"_30795":73881,"_21329":125014,"_5":14664,"_27997":124908,"_3043":125015},[],"`issuance_profile_id` de la solicitud",{"_3587":73924,"_30795":73881,"_21329":125017,"_5":14664,"_27997":124908,"_3043":125018},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3587":73925,"_30795":73881,"_21329":125020,"_5":14664,"_27997":124908,"_3043":125021},[],"Emisión mediante DMS",{"_3587":73926,"_30795":73881,"_21329":125023,"_5":14664,"_27997":124908,"_3043":56634},[],{"_3587":73927,"_30795":73881,"_21329":125025,"_5":14664,"_27997":124908,"_3043":125026},[],"`settings.issuance_profile` incluido en el DMS",{"_3587":73928,"_30795":73881,"_21329":125028,"_5":14664,"_27997":124908,"_3043":125029},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3587":73929,"_30795":73881,"_21329":125031,"_5":14664,"_27997":124908,"_3043":125032},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3587":73930,"_30795":73881,"_21329":125034,"_5":14664,"_27997":124908,"_3043":125035},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3587":73931,"_30795":73881,"_21329":125037,"_5":14664,"_27997":124916,"_3043":125038},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3587":73932,"_30795":73881,"_21329":125040,"_5":14664,"_27997":124920,"_3043":125041},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3587":73933,"_30795":73881,"_21329":125043,"_5":14664,"_27997":124924,"_3043":125044},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3587":73934,"_30795":73881,"_21329":125046,"_5":14664,"_27997":124928,"_3043":125047},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3587":73935,"_30795":73881,"_21329":125049,"_5":14664,"_27997":124932,"_3043":125050},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3587":73936,"_30795":73881,"_21329":125052,"_5":14664,"_27997":124932,"_3043":125053},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3587":73937,"_30795":73881,"_21329":125055,"_5":14664,"_27997":124936,"_3043":125056},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3587":73938,"_30795":73881,"_21329":125058,"_5":14664,"_27997":124936,"_3043":125059},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3587":73939,"_30795":73881,"_21329":125061,"_5":14664,"_27997":124936,"_3043":125062},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3587":73940,"_30795":73881,"_21329":125064,"_5":14664,"_27997":124936,"_3043":125065},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3587":73941,"_30795":73881,"_21329":125067,"_5":14664,"_27997":124940,"_3043":125068},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3587":73942,"_30795":73881,"_21329":125070,"_5":14664,"_27997":124940,"_3043":125071},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3587":73943,"_30795":73943,"_5":15024,"_3043":125073,"_31154":125074,"_21329":125076,"_27997":73943},"Validación de certificados",[50381,120436,56044,125075],"Validación",[],{"_3587":73944,"_30795":73943,"_21329":125078,"_5":14664,"_27997":73943,"_3043":125079},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3587":73945,"_30795":73943,"_5":31151,"_21329":125081,"_27997":125082,"_3043":125083},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3587":73946,"_30795":73943,"_5":31151,"_21329":125085,"_27997":125086,"_3043":125087},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3587":73947,"_30795":73943,"_5":31151,"_21329":125089,"_27997":125090,"_3043":125091},[],"/docs/pr-preview/pr-70/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3587":73948,"_30795":73943,"_21329":125093,"_5":14664,"_27997":73943,"_3043":125094},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3587":73949,"_30795":73943,"_21329":125096,"_5":14664,"_27997":125082,"_3043":125097},[],"Verifica estos criterios juntos:",{"_3587":73950,"_30795":73943,"_21329":125099,"_5":14664,"_27997":125082,"_3043":124064},[],{"_3587":73951,"_30795":73943,"_21329":125101,"_5":14664,"_27997":125082,"_3043":125102},[],"Resultado necesario",{"_3587":73952,"_30795":73943,"_21329":125104,"_5":14664,"_27997":125082,"_3043":125105},[],"Cadena y firma",{"_3587":73953,"_30795":73943,"_21329":125107,"_5":14664,"_27997":125082,"_3043":125108},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3587":73954,"_30795":73943,"_21329":125110,"_5":14664,"_27997":125082,"_3043":125111},[],"Fechas",{"_3587":73955,"_30795":73943,"_21329":125113,"_5":14664,"_27997":125082,"_3043":125114},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3587":73956,"_30795":73943,"_21329":125116,"_5":14664,"_27997":125082,"_3043":120106},[],{"_3587":73957,"_30795":73943,"_21329":125118,"_5":14664,"_27997":125082,"_3043":125119},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3587":73958,"_30795":73943,"_21329":125121,"_5":14664,"_27997":125082,"_3043":125122},[],"Uso",{"_3587":73959,"_30795":73943,"_21329":125124,"_5":14664,"_27997":125082,"_3043":125125},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3587":73960,"_30795":73943,"_21329":125127,"_5":14664,"_27997":125082,"_3043":125128},[],"Revocación",{"_3587":73961,"_30795":73943,"_21329":125130,"_5":14664,"_27997":125082,"_3043":125131},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3587":73962,"_30795":73943,"_21329":125133,"_5":14664,"_27997":125082,"_3043":125134},[],"Autorización",{"_3587":73963,"_30795":73943,"_21329":125136,"_5":14664,"_27997":125082,"_3043":125137},[],"La aplicación permite la acción a esa identidad.",{"_3587":73964,"_30795":73943,"_21329":125139,"_5":14664,"_27997":125082,"_3043":125140},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3587":73965,"_30795":73943,"_21329":125142,"_5":14664,"_27997":125086,"_3043":125143},[],"Mecanismo",{"_3587":73966,"_30795":73943,"_21329":125145,"_5":14664,"_27997":125086,"_3043":125146},[],"Cuándo utilizarlo",{"_3587":73967,"_30795":73943,"_21329":125148,"_5":14664,"_27997":125086,"_3043":125149},[],"Qué debes mantener",{"_3587":73968,"_30795":73943,"_21329":125151,"_5":14664,"_27997":125086,"_3043":56762},[],{"_3587":73969,"_30795":73943,"_21329":125153,"_5":14664,"_27997":125086,"_3043":125154},[],"Consulta del estado de un certificado concreto.",{"_3587":73970,"_30795":73943,"_21329":125156,"_5":14664,"_27997":125086,"_3043":125157},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3587":73971,"_30795":73943,"_21329":125159,"_5":14664,"_27997":125086,"_3043":56771},[],{"_3587":73972,"_30795":73943,"_21329":125161,"_5":14664,"_27997":125086,"_3043":125162},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3587":73973,"_30795":73943,"_21329":125164,"_5":14664,"_27997":125086,"_3043":125165},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3587":73974,"_30795":73943,"_21329":125167,"_5":14664,"_27997":125086,"_3043":125168},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3587":73975,"_30795":73943,"_21329":125170,"_5":14664,"_27997":125086,"_3043":125171},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3587":73976,"_30795":73943,"_21329":125173,"_5":14664,"_27997":125090,"_3043":125174},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3587":73977,"_30795":73943,"_21329":125176,"_5":14664,"_27997":125090,"_3043":125177},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3587":73978,"_30795":73943,"_21329":125179,"_5":14664,"_27997":125090,"_3043":125180},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3587":73979,"_30795":73943,"_21329":125182,"_5":14664,"_27997":125090,"_3043":125183},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3587":73980,"_30795":73943,"_21329":125185,"_5":14664,"_27997":125090,"_3043":125186},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3587":73981,"_30795":73943,"_21329":125188,"_5":14664,"_27997":125090,"_3043":125189},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3587":73982,"_30795":73943,"_21329":125191,"_5":14664,"_27997":125090,"_3043":125192},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3587":73983,"_30795":73943,"_21329":125194,"_5":14664,"_27997":125090,"_3043":125195},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3587":73984,"_30795":73943,"_21329":125197,"_5":14664,"_27997":125090,"_3043":125198},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3587":73985,"_30795":73985,"_5":15024,"_3043":125200,"_31154":125201,"_21329":125202,"_27997":73985},"Certificados",[50381,120436,56044,124435],[],{"_3587":73986,"_30795":73985,"_21329":125204,"_5":14664,"_27997":73985,"_3043":125205},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3587":73987,"_30795":73985,"_5":31151,"_21329":125207,"_27997":125208,"_3043":125209},[],"/docs/pr-preview/pr-70/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3587":73988,"_30795":73985,"_5":31151,"_21329":125211,"_27997":125212,"_3043":125213},[],"/docs/pr-preview/pr-70/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3587":73989,"_30795":73985,"_5":31151,"_21329":125215,"_27997":125216,"_3043":125217},[],"/docs/pr-preview/pr-70/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3587":73990,"_30795":73985,"_5":31151,"_21329":125219,"_27997":125220,"_3043":125221},[],"/docs/pr-preview/pr-70/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3587":73991,"_30795":73985,"_5":31151,"_21329":125223,"_27997":125224,"_3043":125225},[],"/docs/pr-preview/pr-70/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3587":73992,"_30795":73985,"_5":31151,"_21329":125227,"_27997":125228,"_3043":125229},[],"/docs/pr-preview/pr-70/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3587":73993,"_30795":73985,"_5":31151,"_21329":125231,"_27997":125232,"_3043":125233},[],"/docs/pr-preview/pr-70/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3587":73994,"_30795":73985,"_5":31151,"_21329":125235,"_27997":125236,"_3043":125237},[],"/docs/pr-preview/pr-70/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3587":73995,"_30795":73985,"_5":31151,"_21329":125239,"_27997":125240,"_3043":125241},[],"/docs/pr-preview/pr-70/es/platform/pki/certificates#continúa","Continúa",{"_3587":73996,"_30795":73985,"_21329":125243,"_5":14664,"_27997":73985,"_3043":125244},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3587":73997,"_30795":73985,"_21329":125246,"_5":14664,"_27997":125208,"_3043":125247},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3587":73998,"_30795":73985,"_21329":125249,"_5":14664,"_27997":125208,"_3043":125250},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3587":73999,"_30795":73985,"_21329":125252,"_5":14664,"_27997":125208,"_3043":125253},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3587":74000,"_30795":73985,"_21329":125255,"_5":14664,"_27997":125208,"_3043":125256},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3587":74001,"_30795":73985,"_21329":125258,"_5":14664,"_27997":125208,"_3043":125259},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3587":74002,"_30795":73985,"_21329":125261,"_5":14664,"_27997":125208,"_3043":125262},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3587":74003,"_30795":73985,"_21329":125264,"_5":14664,"_27997":125208,"_3043":125265},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3587":74004,"_30795":73985,"_21329":125267,"_5":14664,"_27997":125212,"_3043":125268},[],"Descarga el PEM e inspecciónalo:",{"_3587":74005,"_30795":73985,"_21329":125270,"_5":14664,"_27997":125212,"_3043":125271},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3587":74006,"_30795":73985,"_21329":125273,"_5":14664,"_27997":125216,"_3043":125274},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3587":74007,"_30795":73985,"_21329":125276,"_5":14664,"_27997":125216,"_3043":125277},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3587":74008,"_30795":73985,"_21329":125279,"_5":14664,"_27997":125216,"_3043":125280},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3587":74009,"_30795":73985,"_21329":125282,"_5":14664,"_27997":125216,"_3043":125283},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3587":74010,"_30795":73985,"_21329":125285,"_5":14664,"_27997":125216,"_3043":125286},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3587":74011,"_30795":73985,"_21329":125288,"_5":14664,"_27997":125216,"_3043":125289},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3587":74012,"_30795":73985,"_21329":125291,"_5":14664,"_27997":125216,"_3043":125292},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3587":74013,"_30795":73985,"_21329":125294,"_5":14664,"_27997":125220,"_3043":125295},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3587":74014,"_30795":73985,"_21329":125297,"_5":14664,"_27997":125224,"_3043":125298},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3587":74015,"_30795":73985,"_21329":125300,"_5":14664,"_27997":125228,"_3043":125301},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3587":74016,"_30795":73985,"_21329":125303,"_5":14664,"_27997":125232,"_3043":125304},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3587":74017,"_30795":73985,"_21329":125306,"_5":14664,"_27997":125232,"_3043":125307},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3587":74018,"_30795":73985,"_21329":125309,"_5":14664,"_27997":125232,"_3043":125310},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3587":74019,"_30795":73985,"_21329":125312,"_5":14664,"_27997":125236,"_3043":125313},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3587":74020,"_30795":73985,"_21329":125315,"_5":14664,"_27997":125236,"_3043":125316},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3587":74021,"_30795":73985,"_21329":125318,"_5":14664,"_27997":125236,"_3043":125319},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3587":74022,"_30795":73985,"_21329":125321,"_5":14664,"_27997":125240,"_3043":125322},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3587":74023,"_30795":73985,"_21329":125324,"_5":14664,"_27997":125240,"_3043":125325},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3587":74024,"_30795":74024,"_5":15024,"_3043":125327,"_31154":125328,"_21329":125330,"_27997":74024},"Ciclo de vida de un certificado",[50381,120436,56044,125329],"Conceptos",[],{"_3587":74025,"_30795":74024,"_21329":125332,"_5":14664,"_27997":74024,"_3043":125333},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3587":74026,"_30795":74024,"_5":31151,"_21329":125335,"_27997":125336,"_3043":125337},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3587":74027,"_30795":74024,"_5":31151,"_21329":125339,"_27997":125340,"_3043":125341},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3587":74028,"_30795":74024,"_5":31151,"_21329":125343,"_27997":125344,"_3043":125345},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3587":74029,"_30795":74024,"_5":31151,"_21329":125347,"_27997":125348,"_3043":125349},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3587":74030,"_30795":74024,"_5":31151,"_21329":125351,"_27997":125352,"_3043":125353},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3587":74031,"_30795":74024,"_5":31151,"_21329":125355,"_27997":125356,"_3043":125357},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3587":74032,"_30795":74024,"_5":31151,"_21329":125359,"_27997":125360,"_3043":123058},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3587":74033,"_30795":74024,"_5":31151,"_21329":125362,"_27997":125363,"_3043":125364},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3587":74034,"_30795":74024,"_5":31151,"_21329":125366,"_27997":125367,"_3043":125368},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3587":74035,"_30795":74024,"_5":31151,"_21329":125370,"_27997":125371,"_3043":125372},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3587":74036,"_30795":74024,"_21329":125374,"_5":14664,"_27997":74024,"_3043":125375},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3587":74037,"_30795":74024,"_21329":125377,"_5":14664,"_27997":125340,"_3043":125378},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3587":74038,"_30795":74024,"_21329":125380,"_5":14664,"_27997":125344,"_3043":125381},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3587":74039,"_30795":74024,"_21329":125383,"_5":14664,"_27997":125348,"_3043":125384},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3587":74040,"_30795":74024,"_21329":125386,"_5":14664,"_27997":125352,"_3043":125387},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3587":74041,"_30795":74024,"_21329":125389,"_5":14664,"_27997":125356,"_3043":125390},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3587":74042,"_30795":74024,"_21329":125392,"_5":14664,"_27997":125360,"_3043":125393},[],"Lamassu persiste cuatro estados X.509:",{"_3587":74043,"_30795":74024,"_21329":125395,"_5":14664,"_27997":125360,"_3043":125396},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3587":74044,"_30795":74024,"_21329":125398,"_5":14664,"_27997":125360,"_3043":125399},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3587":74045,"_30795":74024,"_21329":125401,"_5":14664,"_27997":125360,"_3043":125402},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3587":74046,"_30795":74024,"_21329":125404,"_5":14664,"_27997":125360,"_3043":125405},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3587":74047,"_30795":74024,"_21329":125407,"_5":14664,"_27997":125360,"_3043":125408},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3587":74048,"_30795":74024,"_21329":125410,"_5":14664,"_27997":125363,"_3043":125411},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3587":74049,"_30795":74024,"_21329":125413,"_5":14664,"_27997":125363,"_3043":125414},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3587":74050,"_30795":74024,"_21329":125416,"_5":14664,"_27997":125363,"_3043":125417},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3587":74051,"_30795":74024,"_21329":125419,"_5":14664,"_27997":125367,"_3043":125420},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3587":74052,"_30795":74024,"_21329":125422,"_5":14664,"_27997":125367,"_3043":125423},[],"Antes de confirmar:",{"_3587":74053,"_30795":74024,"_21329":125425,"_5":14664,"_27997":125367,"_3043":125426},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3587":74054,"_30795":74024,"_21329":125428,"_5":14664,"_27997":125367,"_3043":125429},[],"Distribuye la nueva cadena de confianza.",{"_3587":74055,"_30795":74024,"_21329":125431,"_5":14664,"_27997":125367,"_3043":125432},[],"Reemite las identidades necesarias.",{"_3587":74056,"_30795":74024,"_21329":125434,"_5":14664,"_27997":125367,"_3043":125435},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3587":74057,"_30795":74024,"_21329":125437,"_5":14664,"_27997":125367,"_3043":125438},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3587":74058,"_30795":74024,"_21329":125440,"_5":14664,"_27997":125367,"_3043":125441},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3587":74059,"_30795":74024,"_21329":125443,"_5":14664,"_27997":125371,"_3043":125444},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3587":74060,"_30795":74024,"_21329":125446,"_5":14664,"_27997":125371,"_3043":125447},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3587":74061,"_30795":74024,"_21329":125449,"_5":14664,"_27997":125371,"_3043":125450},[],"Cambios de estado y razones de revocación.",{"_3587":74062,"_30795":74024,"_21329":125452,"_5":14664,"_27997":125371,"_3043":125453},[],"Publicación y vigencia de OCSP y CRLs.",{"_3587":74063,"_30795":74024,"_21329":125455,"_5":14664,"_27997":125371,"_3043":125456},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3587":74064,"_30795":74024,"_21329":125458,"_5":14664,"_27997":125371,"_3043":125459},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3587":74065,"_30795":74065,"_5":15024,"_3043":125461,"_31154":125462,"_21329":125463,"_27997":74065},"Modelo de confianza",[50381,120436,56044,125329],[],{"_3587":74066,"_30795":74065,"_21329":125465,"_5":14664,"_27997":74065,"_3043":125466},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3587":74067,"_30795":74065,"_5":31151,"_21329":125468,"_27997":125469,"_3043":125470},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3587":74068,"_30795":74065,"_5":31151,"_21329":125472,"_27997":125473,"_3043":125474},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3587":74069,"_30795":74065,"_5":31151,"_21329":125476,"_27997":125477,"_3043":125478},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3587":74070,"_30795":74065,"_5":31151,"_21329":125480,"_27997":125481,"_3043":125482},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3587":74071,"_30795":74065,"_5":31151,"_21329":125484,"_27997":125485,"_3043":125486},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3587":74072,"_30795":74065,"_5":31151,"_21329":125488,"_27997":125489,"_3043":125490},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3587":74073,"_30795":74065,"_5":31151,"_21329":125492,"_27997":125493,"_3043":125494},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3587":74074,"_30795":74065,"_5":31151,"_21329":125496,"_27997":125497,"_3043":125498},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3587":74075,"_30795":74065,"_5":31151,"_21329":125500,"_27997":125501,"_3043":125502},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3587":74076,"_30795":74065,"_5":31151,"_21329":125504,"_27997":125505,"_3043":125506},[],"/docs/pr-preview/pr-70/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3587":74077,"_30795":74065,"_21329":125508,"_5":14664,"_27997":74065,"_3043":125509},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3587":74078,"_30795":74065,"_21329":125511,"_5":14664,"_27997":125473,"_3043":125512},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3587":74079,"_30795":74065,"_21329":125514,"_5":14664,"_27997":125477,"_3043":125515},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3587":74080,"_30795":74065,"_21329":125517,"_5":14664,"_27997":125481,"_3043":125518},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3587":74081,"_30795":74065,"_21329":125520,"_5":14664,"_27997":125485,"_3043":125521},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3587":74082,"_30795":74065,"_21329":125523,"_5":14664,"_27997":125489,"_3043":125524},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3587":74083,"_30795":74065,"_21329":125526,"_5":14664,"_27997":125489,"_3043":125527},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3587":74084,"_30795":74065,"_21329":125529,"_5":14664,"_27997":125489,"_3043":125530},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3587":74085,"_30795":74065,"_21329":125532,"_5":14664,"_27997":125489,"_3043":125533},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3587":74086,"_30795":74065,"_21329":125535,"_5":14664,"_27997":125489,"_3043":125536},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3587":74087,"_30795":74065,"_21329":125538,"_5":14664,"_27997":125489,"_3043":125539},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3587":74088,"_30795":74065,"_21329":125541,"_5":14664,"_27997":125493,"_3043":125542},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3587":74089,"_30795":74065,"_21329":125544,"_5":14664,"_27997":125493,"_3043":125545},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3587":74090,"_30795":74065,"_21329":125547,"_5":14664,"_27997":125493,"_3043":125548},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3587":74091,"_30795":74065,"_21329":125550,"_5":14664,"_27997":125493,"_3043":125551},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3587":74092,"_30795":74065,"_21329":125553,"_5":14664,"_27997":125493,"_3043":125554},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3587":74093,"_30795":74065,"_21329":125556,"_5":14664,"_27997":125497,"_3043":125557},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3587":74094,"_30795":74065,"_21329":125559,"_5":14664,"_27997":125497,"_3043":125560},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3587":74095,"_30795":74065,"_21329":125562,"_5":14664,"_27997":125497,"_3043":125563},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3587":74096,"_30795":74065,"_21329":125565,"_5":14664,"_27997":125497,"_3043":125566},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3587":74097,"_30795":74065,"_21329":125568,"_5":14664,"_27997":125497,"_3043":125569},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3587":74098,"_30795":74065,"_21329":125571,"_5":14664,"_27997":125497,"_3043":125572},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3587":74099,"_30795":74065,"_21329":125574,"_5":14664,"_27997":125497,"_3043":125575},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3587":74100,"_30795":74065,"_21329":125577,"_5":14664,"_27997":125501,"_3043":125578},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3587":74101,"_30795":74065,"_21329":125580,"_5":14664,"_27997":125505,"_3043":125581},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3587":74102,"_30795":74065,"_21329":125583,"_5":14664,"_27997":125505,"_3043":125584},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3587":74103,"_30795":74065,"_21329":125586,"_5":14664,"_27997":125505,"_3043":125587},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3587":74104,"_30795":74065,"_21329":125589,"_5":14664,"_27997":125505,"_3043":125590},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3587":74105,"_30795":74065,"_21329":125592,"_5":14664,"_27997":125505,"_3043":125593},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3587":74106,"_30795":74065,"_21329":125595,"_5":14664,"_27997":125505,"_3043":125596},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3587":74107,"_30795":74065,"_21329":125598,"_5":14664,"_27997":125505,"_3043":125599},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3587":74108,"_30795":74108,"_5":15024,"_3043":125601,"_31154":125602,"_21329":125603,"_27997":74108},"Listas de revocación (CRL)",[50381,120436,56044,125075],[],{"_3587":74109,"_30795":74108,"_21329":125605,"_5":14664,"_27997":74108,"_3043":125606},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3587":74110,"_30795":74108,"_5":31151,"_21329":125608,"_27997":125609,"_3043":125610},[],"/docs/pr-preview/pr-70/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3587":74111,"_30795":74108,"_5":31151,"_21329":125612,"_27997":125613,"_3043":125614},[],"/docs/pr-preview/pr-70/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3587":74112,"_30795":74108,"_5":31151,"_21329":125616,"_27997":125617,"_3043":125618},[],"/docs/pr-preview/pr-70/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3587":74113,"_30795":74108,"_5":31151,"_21329":125620,"_27997":125621,"_3043":125622},[],"/docs/pr-preview/pr-70/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3587":74114,"_30795":74108,"_5":31151,"_21329":125624,"_27997":125625,"_3043":125626},[],"/docs/pr-preview/pr-70/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3587":74115,"_30795":74108,"_5":31151,"_21329":125628,"_27997":125629,"_3043":125630},[],"/docs/pr-preview/pr-70/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3587":74116,"_30795":74108,"_5":31151,"_21329":125632,"_27997":125633,"_3043":125634},[],"/docs/pr-preview/pr-70/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3587":74117,"_30795":74108,"_5":31151,"_21329":125636,"_27997":125637,"_3043":125638},[],"/docs/pr-preview/pr-70/es/platform/pki/crl#referencias","Referencias",{"_3587":74118,"_30795":74108,"_21329":125640,"_5":14664,"_27997":74108,"_3043":125641},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3587":74119,"_30795":74108,"_21329":125643,"_5":14664,"_27997":125609,"_3043":125644},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3587":74120,"_30795":74108,"_21329":125646,"_5":14664,"_27997":125609,"_3043":125647},[],"Campo",{"_3587":74121,"_30795":74108,"_21329":125649,"_5":14664,"_27997":125609,"_3043":122098},[],{"_3587":74122,"_30795":74108,"_21329":125651,"_5":14664,"_27997":125609,"_3043":52013},[],{"_3587":74123,"_30795":74108,"_21329":125653,"_5":14664,"_27997":125609,"_3043":125654},[],"ID de la CA a la que pertenecen los ajustes.",{"_3587":74124,"_30795":74108,"_21329":125656,"_5":14664,"_27997":125609,"_3043":57270},[],{"_3587":74125,"_30795":74108,"_21329":125658,"_5":14664,"_27997":125609,"_3043":125659},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3587":74126,"_30795":74108,"_21329":125661,"_5":14664,"_27997":125609,"_3043":57276},[],{"_3587":74127,"_30795":74108,"_21329":125663,"_5":14664,"_27997":125609,"_3043":125664},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3587":74128,"_30795":74108,"_21329":125666,"_5":14664,"_27997":125609,"_3043":57282},[],{"_3587":74129,"_30795":74108,"_21329":125668,"_5":14664,"_27997":125609,"_3043":125669},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3587":74130,"_30795":74108,"_21329":125671,"_5":14664,"_27997":125609,"_3043":125672},[],"Campo de `crl_options`",{"_3587":74131,"_30795":74108,"_21329":125674,"_5":14664,"_27997":125609,"_3043":122098},[],{"_3587":74132,"_30795":74108,"_21329":125676,"_5":14664,"_27997":125609,"_3043":125677},[],"Valor inicial",{"_3587":74133,"_30795":74108,"_21329":125679,"_5":14664,"_27997":125609,"_3043":57296},[],{"_3587":74134,"_30795":74108,"_21329":125681,"_5":14664,"_27997":125609,"_3043":125682},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3587":74135,"_30795":74108,"_21329":125684,"_5":14664,"_27997":125609,"_3043":125685},[],"7 días.",{"_3587":74136,"_30795":74108,"_21329":125687,"_5":14664,"_27997":125609,"_3043":57305},[],{"_3587":74137,"_30795":74108,"_21329":125689,"_5":14664,"_27997":125609,"_3043":125690},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3587":74138,"_30795":74108,"_21329":125692,"_5":14664,"_27997":125609,"_3043":125693},[],"6 días y 23 horas.",{"_3587":74139,"_30795":74108,"_21329":125695,"_5":14664,"_27997":125609,"_3043":57314},[],{"_3587":74140,"_30795":74108,"_21329":125697,"_5":14664,"_27997":125609,"_3043":125698},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3587":74141,"_30795":74108,"_21329":125700,"_5":14664,"_27997":125609,"_3043":57320},[],{"_3587":74142,"_30795":74108,"_21329":125702,"_5":14664,"_27997":125609,"_3043":57323},[],{"_3587":74143,"_30795":74108,"_21329":125704,"_5":14664,"_27997":125609,"_3043":125705},[],"Número de serie del certificado existente que firma la CRL.",{"_3587":74144,"_30795":74108,"_21329":125707,"_5":14664,"_27997":125609,"_3043":125708},[],"Número de serie del certificado actual de la CA.",{"_3587":74145,"_30795":74108,"_21329":125710,"_5":14664,"_27997":125609,"_3043":125711},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3587":74146,"_30795":74108,"_21329":125713,"_5":14664,"_27997":125609,"_3043":125714},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3587":74147,"_30795":74108,"_21329":125716,"_5":14664,"_27997":125609,"_3043":125717},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3587":74148,"_30795":74108,"_21329":125719,"_5":14664,"_27997":125609,"_3043":125720},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3587":74149,"_30795":74108,"_21329":125722,"_5":14664,"_27997":125609,"_3043":125723},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3587":74150,"_30795":74108,"_21329":125725,"_5":14664,"_27997":125609,"_3043":125726},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3587":74151,"_30795":74108,"_21329":125728,"_5":14664,"_27997":125609,"_3043":125729},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3587":74152,"_30795":74108,"_21329":125731,"_5":14664,"_27997":125609,"_3043":125732},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3587":74153,"_30795":74108,"_21329":125734,"_5":14664,"_27997":125609,"_3043":125735},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3587":74154,"_30795":74108,"_21329":125737,"_5":14664,"_27997":125609,"_3043":125738},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3587":74155,"_30795":74108,"_21329":125740,"_5":14664,"_27997":125609,"_3043":125741},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3587":74156,"_30795":74108,"_21329":125743,"_5":14664,"_27997":125613,"_3043":125744},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3587":74157,"_30795":74108,"_21329":125746,"_5":14664,"_27997":125613,"_3043":125747},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3587":74158,"_30795":74108,"_21329":125749,"_5":14664,"_27997":125613,"_3043":125750},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3587":74159,"_30795":74108,"_21329":125752,"_5":14664,"_27997":125613,"_3043":125753},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3587":74160,"_30795":74108,"_21329":125755,"_5":14664,"_27997":125617,"_3043":125756},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3587":74161,"_30795":74108,"_21329":125758,"_5":14664,"_27997":125617,"_3043":125759},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3587":74162,"_30795":74108,"_21329":125761,"_5":14664,"_27997":125617,"_3043":125762},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3587":74163,"_30795":74108,"_21329":125764,"_5":14664,"_27997":125617,"_3043":125765},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3587":74164,"_30795":74108,"_21329":125767,"_5":14664,"_27997":125617,"_3043":125768},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3587":74165,"_30795":74108,"_21329":125770,"_5":14664,"_27997":125617,"_3043":125771},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3587":74166,"_30795":74108,"_21329":125773,"_5":14664,"_27997":125617,"_3043":125774},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3587":74167,"_30795":74108,"_21329":125776,"_5":14664,"_27997":125617,"_3043":125777},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3587":74168,"_30795":74108,"_21329":125779,"_5":14664,"_27997":125617,"_3043":125780},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3587":74169,"_30795":74108,"_21329":125782,"_5":14664,"_27997":125621,"_3043":125783},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3587":74170,"_30795":74108,"_21329":125785,"_5":14664,"_27997":125621,"_3043":125786},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3587":74171,"_30795":74108,"_21329":125788,"_5":14664,"_27997":125625,"_3043":125789},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3587":74172,"_30795":74108,"_21329":125791,"_5":14664,"_27997":125625,"_3043":125792},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3587":74173,"_30795":74108,"_21329":125794,"_5":14664,"_27997":125625,"_3043":125795},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3587":74174,"_30795":74108,"_21329":125797,"_5":14664,"_27997":125625,"_3043":125798},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3587":74175,"_30795":74108,"_21329":125800,"_5":14664,"_27997":125625,"_3043":125801},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3587":74176,"_30795":74108,"_21329":125803,"_5":14664,"_27997":125629,"_3043":125804},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3587":74177,"_30795":74108,"_21329":125806,"_5":14664,"_27997":125629,"_3043":122287},[],{"_3587":74178,"_30795":74108,"_21329":125808,"_5":14664,"_27997":125629,"_3043":125809},[],"Path relativo",{"_3587":74179,"_30795":74108,"_21329":125811,"_5":14664,"_27997":125629,"_3043":120196},[],{"_3587":74180,"_30795":74108,"_21329":125813,"_5":14664,"_27997":125629,"_3043":57435},[],{"_3587":74181,"_30795":74108,"_21329":125815,"_5":14664,"_27997":125629,"_3043":57438},[],{"_3587":74182,"_30795":74108,"_21329":125817,"_5":14664,"_27997":125629,"_3043":125818},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3587":74183,"_30795":74108,"_21329":125820,"_5":14664,"_27997":125629,"_3043":57435},[],{"_3587":74184,"_30795":74108,"_21329":125822,"_5":14664,"_27997":125629,"_3043":57446},[],{"_3587":74185,"_30795":74108,"_21329":125824,"_5":14664,"_27997":125629,"_3043":125825},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3587":74186,"_30795":74108,"_21329":125827,"_5":14664,"_27997":125629,"_3043":57452},[],{"_3587":74187,"_30795":74108,"_21329":125829,"_5":14664,"_27997":125629,"_3043":57446},[],{"_3587":74188,"_30795":74108,"_21329":125831,"_5":14664,"_27997":125629,"_3043":125832},[],"Sustituir la configuración de CRL de una CA.",{"_3587":74189,"_30795":74108,"_21329":125834,"_5":14664,"_27997":125629,"_3043":57460},[],{"_3587":74190,"_30795":74108,"_21329":125836,"_5":14664,"_27997":125629,"_3043":57446},[],{"_3587":74191,"_30795":74108,"_21329":125838,"_5":14664,"_27997":125629,"_3043":125839},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3587":74192,"_30795":74108,"_21329":125841,"_5":14664,"_27997":125629,"_3043":125842},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3587":74193,"_30795":74108,"_21329":125844,"_5":14664,"_27997":125629,"_3043":125845},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3587":74194,"_30795":74108,"_21329":125847,"_5":14664,"_27997":125629,"_3043":125848},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3587":74195,"_30795":74108,"_21329":125850,"_5":14664,"_27997":125633,"_3043":125851},[],"Síntoma",{"_3587":74196,"_30795":74108,"_21329":125853,"_5":14664,"_27997":125633,"_3043":125854},[],"Causa",{"_3587":74197,"_30795":74108,"_21329":125856,"_5":14664,"_27997":125633,"_3043":125857},[],"Acción",{"_3587":74198,"_30795":74108,"_21329":125859,"_5":14664,"_27997":125633,"_3043":125860},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3587":74199,"_30795":74108,"_21329":125862,"_5":14664,"_27997":125633,"_3043":125863},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3587":74200,"_30795":74108,"_21329":125865,"_5":14664,"_27997":125633,"_3043":125866},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3587":74201,"_30795":74108,"_21329":125868,"_5":14664,"_27997":125633,"_3043":125869},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3587":74202,"_30795":74108,"_21329":125871,"_5":14664,"_27997":125633,"_3043":125872},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3587":74203,"_30795":74108,"_21329":125874,"_5":14664,"_27997":125633,"_3043":125875},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3587":74204,"_30795":74108,"_21329":125877,"_5":14664,"_27997":125633,"_3043":125878},[],"`PUT` devuelve 400.",{"_3587":74205,"_30795":74108,"_21329":125880,"_5":14664,"_27997":125633,"_3043":125881},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3587":74206,"_30795":74108,"_21329":125883,"_5":14664,"_27997":125633,"_3043":125884},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3587":74207,"_30795":74108,"_21329":125886,"_5":14664,"_27997":125633,"_3043":125887},[],"`PUT` devuelve 404.",{"_3587":74208,"_30795":74108,"_21329":125889,"_5":14664,"_27997":125633,"_3043":125890},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3587":74209,"_30795":74108,"_21329":125892,"_5":14664,"_27997":125633,"_3043":125893},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3587":74210,"_30795":74108,"_21329":125895,"_5":14664,"_27997":125633,"_3043":125896},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3587":74211,"_30795":74108,"_21329":125898,"_5":14664,"_27997":125633,"_3043":125899},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3587":74212,"_30795":74108,"_21329":125901,"_5":14664,"_27997":125633,"_3043":125902},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3587":74213,"_30795":74108,"_21329":125904,"_5":14664,"_27997":125633,"_3043":125905},[],"La CRL no cambia tras revocar un certificado.",{"_3587":74214,"_30795":74108,"_21329":125907,"_5":14664,"_27997":125633,"_3043":125908},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3587":74215,"_30795":74108,"_21329":125910,"_5":14664,"_27997":125633,"_3043":125911},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3587":74216,"_30795":74108,"_21329":125913,"_5":14664,"_27997":125633,"_3043":125914},[],"Un verificador rechaza la CRL por el emisor.",{"_3587":74217,"_30795":74108,"_21329":125916,"_5":14664,"_27997":125633,"_3043":125917},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3587":74218,"_30795":74108,"_21329":125919,"_5":14664,"_27997":125633,"_3043":125920},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3587":74219,"_30795":74108,"_21329":125922,"_5":14664,"_27997":125637,"_3043":125923},[],"RFC 5280: perfil X.509 y CRL.",{"_3587":74220,"_30795":74108,"_21329":125925,"_5":14664,"_27997":125637,"_3043":57552},[],{"_3587":74221,"_30795":74108,"_21329":125927,"_5":14664,"_27997":125637,"_3043":57555},[],{"_3587":74222,"_30795":74108,"_21329":125929,"_5":14664,"_27997":125637,"_3043":125930},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3587":74223,"_30795":74108,"_21329":125932,"_5":14664,"_27997":125637,"_3043":125933},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3587":74224,"_30795":74224,"_5":15024,"_3043":125935,"_31154":125936,"_21329":125937,"_27997":74224},"Claves y motores criptográficos",[50381,120436,56044,124435],[],{"_3587":74225,"_30795":74224,"_21329":125939,"_5":14664,"_27997":74224,"_3043":125940},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3587":74226,"_30795":74224,"_5":31151,"_21329":125942,"_27997":125943,"_3043":125944},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3587":74227,"_30795":74224,"_5":31151,"_21329":125946,"_27997":125947,"_3043":125948},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3587":74228,"_30795":74224,"_5":31151,"_21329":125950,"_27997":125951,"_3043":57580},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#file-system",{"_3587":74229,"_30795":74224,"_5":31151,"_21329":125953,"_27997":125954,"_3043":57584},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#hashicorp-vault",{"_3587":74230,"_30795":74224,"_5":31151,"_21329":125956,"_27997":125957,"_3043":57588},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#aws-secrets-manager",{"_3587":74231,"_30795":74224,"_5":31151,"_21329":125959,"_27997":125960,"_3043":57592},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#aws-kms",{"_3587":74232,"_30795":74224,"_5":31151,"_21329":125962,"_27997":125963,"_3043":57596},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#pkcs11",{"_3587":74233,"_30795":74224,"_5":31151,"_21329":125965,"_27997":125966,"_3043":57600},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#azure-key-vault",{"_3587":74234,"_30795":74224,"_5":31151,"_21329":125968,"_27997":125969,"_3043":125970},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3587":74235,"_30795":74224,"_5":31151,"_21329":125972,"_27997":125973,"_3043":125974},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3587":74236,"_30795":74224,"_5":31151,"_21329":125976,"_27997":125977,"_3043":125978},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3587":74237,"_30795":74224,"_5":31151,"_21329":125980,"_27997":125981,"_3043":125982},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3587":74238,"_30795":74224,"_5":31151,"_21329":125984,"_27997":125985,"_3043":125986},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3587":74239,"_30795":74224,"_5":31151,"_21329":125988,"_27997":125989,"_3043":125990},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3587":74240,"_30795":74224,"_5":31151,"_21329":125992,"_27997":125993,"_3043":125994},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3587":74241,"_30795":74224,"_5":31151,"_21329":125996,"_27997":125997,"_3043":57632},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#sign",{"_3587":74242,"_30795":74224,"_5":31151,"_21329":125999,"_27997":126000,"_3043":57636},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#verify",{"_3587":74243,"_30795":74224,"_5":31151,"_21329":126002,"_27997":126003,"_3043":126004},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3587":74244,"_30795":74224,"_5":31151,"_21329":126006,"_27997":126007,"_3043":126008},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3587":74245,"_30795":74224,"_5":31151,"_21329":126010,"_27997":126011,"_3043":126012},[],"/docs/pr-preview/pr-70/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3587":74246,"_30795":74224,"_21329":126014,"_5":14664,"_27997":74224,"_3043":126015},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3587":74247,"_30795":74224,"_21329":126017,"_5":14664,"_27997":74224,"_3043":126018},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3587":74248,"_30795":74224,"_21329":126020,"_5":14664,"_27997":125943,"_3043":126021},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3587":74249,"_30795":74224,"_21329":126023,"_5":14664,"_27997":125943,"_3043":126024},[],"En la práctica, permite:",{"_3587":74250,"_30795":74224,"_21329":126026,"_5":14664,"_27997":125943,"_3043":126027},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3587":74251,"_30795":74224,"_21329":126029,"_5":14664,"_27997":125943,"_3043":126030},[],"Importar claves creadas externamente.",{"_3587":74252,"_30795":74224,"_21329":126032,"_5":14664,"_27997":125943,"_3043":126033},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3587":74253,"_30795":74224,"_21329":126035,"_5":14664,"_27997":125943,"_3043":126036},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3587":74254,"_30795":74224,"_21329":126038,"_5":14664,"_27997":125947,"_3043":126039},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3587":74255,"_30795":74224,"_21329":126041,"_5":14664,"_27997":125947,"_3043":126042},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3587":74256,"_30795":74224,"_21329":126044,"_5":14664,"_27997":125947,"_3043":126045},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3587":74257,"_30795":74224,"_21329":126047,"_5":14664,"_27997":125951,"_3043":126048},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3587":74258,"_30795":74224,"_21329":126050,"_5":14664,"_27997":125954,"_3043":126051},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3587":74259,"_30795":74224,"_21329":126053,"_5":14664,"_27997":125954,"_3043":126054},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3587":74260,"_30795":74224,"_21329":126056,"_5":14664,"_27997":125957,"_3043":126057},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3587":74261,"_30795":74224,"_21329":126059,"_5":14664,"_27997":125960,"_3043":126060},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3587":74262,"_30795":74224,"_21329":126062,"_5":14664,"_27997":125963,"_3043":126063},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3587":74263,"_30795":74224,"_21329":126065,"_5":14664,"_27997":125966,"_3043":126066},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3587":74264,"_30795":74224,"_21329":126068,"_5":14664,"_27997":125966,"_3043":126069},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3587":74265,"_30795":74224,"_21329":126071,"_5":14664,"_27997":125966,"_3043":126072},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3587":74266,"_30795":74224,"_21329":126074,"_5":14664,"_27997":125966,"_3043":126075},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3587":74267,"_30795":74224,"_21329":126077,"_5":14664,"_27997":125969,"_3043":126078},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3587":74268,"_30795":74224,"_21329":126080,"_5":14664,"_27997":125969,"_3043":126081},[],"La tabla incluye los siguientes campos:",{"_3587":74269,"_30795":74224,"_21329":126083,"_5":14664,"_27997":125969,"_3043":126084},[],"**Name**: nombre descriptivo de la clave.",{"_3587":74270,"_30795":74224,"_21329":126086,"_5":14664,"_27997":125969,"_3043":126087},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3587":74271,"_30795":74224,"_21329":126089,"_5":14664,"_27997":125969,"_3043":126090},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3587":74272,"_30795":74224,"_21329":126092,"_5":14664,"_27997":125969,"_3043":126093},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3587":74273,"_30795":74224,"_21329":126095,"_5":14664,"_27997":125969,"_3043":126096},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3587":74274,"_30795":74224,"_21329":126098,"_5":14664,"_27997":125969,"_3043":126099},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3587":74275,"_30795":74224,"_21329":126101,"_5":14664,"_27997":125969,"_3043":126102},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3587":74276,"_30795":74224,"_21329":126104,"_5":14664,"_27997":125969,"_3043":126105},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3587":74277,"_30795":74224,"_21329":126107,"_5":14664,"_27997":125969,"_3043":126108},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3587":74278,"_30795":74224,"_21329":126110,"_5":14664,"_27997":125969,"_3043":126111},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3587":74279,"_30795":74224,"_21329":126113,"_5":14664,"_27997":125969,"_3043":126114},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3587":74280,"_30795":74224,"_21329":126116,"_5":14664,"_27997":125969,"_3043":126117},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3587":74281,"_30795":74224,"_21329":126119,"_5":14664,"_27997":125969,"_3043":126120},[],"**Delete Key** para eliminar la clave del sistema.",{"_3587":74282,"_30795":74224,"_21329":126122,"_5":14664,"_27997":125973,"_3043":126123},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3587":74283,"_30795":74224,"_21329":126125,"_5":14664,"_27997":125977,"_3043":126126},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3587":74284,"_30795":74224,"_21329":126128,"_5":14664,"_27997":125977,"_3043":126129},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3587":74285,"_30795":74224,"_21329":126131,"_5":14664,"_27997":125977,"_3043":126132},[],"**Key Name**: nombre único y descriptivo.",{"_3587":74286,"_30795":74224,"_21329":126134,"_5":14664,"_27997":125977,"_3043":126135},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3587":74287,"_30795":74224,"_21329":126137,"_5":14664,"_27997":125977,"_3043":126138},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3587":74288,"_30795":74224,"_21329":126140,"_5":14664,"_27997":125977,"_3043":126141},[],"**Tags**: metadatos para clasificar la clave.",{"_3587":74289,"_30795":74224,"_21329":126143,"_5":14664,"_27997":125977,"_3043":126144},[],"**Metadata**: información adicional para usos avanzados.",{"_3587":74290,"_30795":74224,"_21329":126146,"_5":14664,"_27997":125981,"_3043":126147},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3587":74291,"_30795":74224,"_21329":126149,"_5":14664,"_27997":125981,"_3043":126150},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3587":74292,"_30795":74224,"_21329":126152,"_5":14664,"_27997":125981,"_3043":126153},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3587":74293,"_30795":74224,"_21329":126155,"_5":14664,"_27997":125981,"_3043":126156},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3587":74294,"_30795":74224,"_21329":126158,"_5":14664,"_27997":125981,"_3043":126159},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3587":74295,"_30795":74224,"_21329":126161,"_5":14664,"_27997":125981,"_3043":126162},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3587":74296,"_30795":74224,"_21329":126164,"_5":14664,"_27997":125981,"_3043":126165},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3587":74297,"_30795":74224,"_21329":126167,"_5":14664,"_27997":125981,"_3043":126168},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3587":74298,"_30795":74224,"_21329":126170,"_5":14664,"_27997":125981,"_3043":126171},[],"**Metadata**: información adicional opcional.",{"_3587":74299,"_30795":74224,"_21329":126173,"_5":14664,"_27997":125981,"_3043":126174},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3587":74300,"_30795":74224,"_21329":126176,"_5":14664,"_27997":125981,"_3043":126177},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3587":74301,"_30795":74224,"_21329":126179,"_5":14664,"_27997":125985,"_3043":126180},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3587":74302,"_30795":74224,"_21329":126182,"_5":14664,"_27997":125989,"_3043":126183},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3587":74303,"_30795":74224,"_21329":126185,"_5":14664,"_27997":125989,"_3043":126186},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3587":74304,"_30795":74224,"_21329":126188,"_5":14664,"_27997":125989,"_3043":126189},[],"**Key Name**: nombre descriptivo.",{"_3587":74305,"_30795":74224,"_21329":126191,"_5":14664,"_27997":125989,"_3043":126192},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3587":74306,"_30795":74224,"_21329":126194,"_5":14664,"_27997":125989,"_3043":126195},[],"**Tags**: etiquetas asociadas.",{"_3587":74307,"_30795":74224,"_21329":126197,"_5":14664,"_27997":125989,"_3043":126198},[],"**Aliases**: nombres alternativos.",{"_3587":74308,"_30795":74224,"_21329":126200,"_5":14664,"_27997":125989,"_3043":126201},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3587":74309,"_30795":74224,"_21329":126203,"_5":14664,"_27997":125989,"_3043":126204},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3587":74310,"_30795":74224,"_21329":126206,"_5":14664,"_27997":125989,"_3043":126207},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3587":74311,"_30795":74224,"_21329":126209,"_5":14664,"_27997":125989,"_3043":126210},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3587":74312,"_30795":74224,"_21329":126212,"_5":14664,"_27997":125993,"_3043":126213},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3587":74313,"_30795":74224,"_21329":126215,"_5":14664,"_27997":125993,"_3043":126216},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3587":74314,"_30795":74224,"_21329":126218,"_5":14664,"_27997":125993,"_3043":126219},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3587":74315,"_30795":74224,"_21329":126221,"_5":14664,"_27997":125997,"_3043":126222},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3587":74316,"_30795":74224,"_21329":126224,"_5":14664,"_27997":125997,"_3043":126225},[],"Campos principales:",{"_3587":74317,"_30795":74224,"_21329":126227,"_5":14664,"_27997":125997,"_3043":126228},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3587":74318,"_30795":74224,"_21329":126230,"_5":14664,"_27997":125997,"_3043":126231},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3587":74319,"_30795":74224,"_21329":126233,"_5":14664,"_27997":125997,"_3043":126234},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3587":74320,"_30795":74224,"_21329":126236,"_5":14664,"_27997":125997,"_3043":126237},[],"**Message**: contenido que se va a firmar.",{"_3587":74321,"_30795":74224,"_21329":126239,"_5":14664,"_27997":125997,"_3043":126240},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3587":74322,"_30795":74224,"_21329":126242,"_5":14664,"_27997":126000,"_3043":126243},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3587":74323,"_30795":74224,"_21329":126245,"_5":14664,"_27997":126000,"_3043":126225},[],{"_3587":74324,"_30795":74224,"_21329":126247,"_5":14664,"_27997":126000,"_3043":126248},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3587":74325,"_30795":74224,"_21329":126250,"_5":14664,"_27997":126000,"_3043":126251},[],"**Message Type**: `Raw` o `Digest`.",{"_3587":74326,"_30795":74224,"_21329":126253,"_5":14664,"_27997":126000,"_3043":126254},[],"**Payload Encoding**: codificación del mensaje.",{"_3587":74327,"_30795":74224,"_21329":126256,"_5":14664,"_27997":126000,"_3043":126257},[],"**Message**: mensaje original o hash.",{"_3587":74328,"_30795":74224,"_21329":126259,"_5":14664,"_27997":126000,"_3043":126260},[],"**Signature**: firma que se desea comprobar.",{"_3587":74329,"_30795":74224,"_21329":126262,"_5":14664,"_27997":126000,"_3043":126263},[],"**Result**: indicador del resultado de la validación.",{"_3587":74330,"_30795":74224,"_21329":126265,"_5":14664,"_27997":126003,"_3043":126266},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3587":74331,"_30795":74224,"_21329":126268,"_5":14664,"_27997":126003,"_3043":126269},[],"Este flujo es útil para:",{"_3587":74332,"_30795":74224,"_21329":126271,"_5":14664,"_27997":126003,"_3043":126272},[],"Solicitar certificados a una CA externa.",{"_3587":74333,"_30795":74224,"_21329":126274,"_5":14664,"_27997":126003,"_3043":126275},[],"Renovar una identidad manteniendo la misma clave.",{"_3587":74334,"_30795":74224,"_21329":126277,"_5":14664,"_27997":126003,"_3043":126278},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3587":74335,"_30795":74224,"_21329":126280,"_5":14664,"_27997":126003,"_3043":126281},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3587":74336,"_30795":74224,"_21329":126283,"_5":14664,"_27997":126003,"_3043":126284},[],"**Organization (O)**: organización o empresa.",{"_3587":74337,"_30795":74224,"_21329":126286,"_5":14664,"_27997":126003,"_3043":126287},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3587":74338,"_30795":74224,"_21329":126289,"_5":14664,"_27997":126003,"_3043":126290},[],"**Country (C)**: código de país de dos letras.",{"_3587":74339,"_30795":74224,"_21329":126292,"_5":14664,"_27997":126003,"_3043":126293},[],"**State / Province (ST)**: estado o provincia.",{"_3587":74340,"_30795":74224,"_21329":126295,"_5":14664,"_27997":126003,"_3043":126296},[],"**Locality (L)**: ciudad o localidad.",{"_3587":74341,"_30795":74224,"_21329":126298,"_5":14664,"_27997":126003,"_3043":126299},[],"**Email Address**: correo de contacto.",{"_3587":74342,"_30795":74224,"_21329":126301,"_5":14664,"_27997":126003,"_3043":126302},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3587":74343,"_30795":74224,"_21329":126304,"_5":14664,"_27997":126003,"_3043":126305},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3587":74344,"_30795":74224,"_21329":126307,"_5":14664,"_27997":126007,"_3043":126308},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3587":74345,"_30795":74224,"_21329":126310,"_5":14664,"_27997":126007,"_3043":126311},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3587":74346,"_30795":74224,"_21329":126313,"_5":14664,"_27997":126011,"_3043":126314},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3587":74347,"_30795":74224,"_21329":126316,"_5":14664,"_27997":126011,"_3043":126317},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3587":74348,"_30795":74348,"_5":15024,"_3043":126319,"_31154":126320,"_21329":126321,"_27997":74348},"Validación online con OCSP",[50381,120436,56044,125075],[],{"_3587":74349,"_30795":74348,"_21329":126323,"_5":14664,"_27997":74348,"_3043":126324},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3587":74350,"_30795":74348,"_5":31151,"_21329":126326,"_27997":126327,"_3043":126328},[],"/docs/pr-preview/pr-70/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3587":74351,"_30795":74348,"_5":31151,"_21329":126330,"_27997":126331,"_3043":126332},[],"/docs/pr-preview/pr-70/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3587":74352,"_30795":74348,"_5":31151,"_21329":126334,"_27997":126335,"_3043":126336},[],"/docs/pr-preview/pr-70/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3587":74353,"_30795":74348,"_5":31151,"_21329":126338,"_27997":126339,"_3043":126340},[],"/docs/pr-preview/pr-70/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3587":74354,"_30795":74348,"_5":31151,"_21329":126342,"_27997":126343,"_3043":126344},[],"/docs/pr-preview/pr-70/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3587":74355,"_30795":74348,"_5":31151,"_21329":126346,"_27997":126347,"_3043":125638},[],"/docs/pr-preview/pr-70/es/platform/pki/ocsp#referencias",{"_3587":74356,"_30795":74348,"_21329":126349,"_5":14664,"_27997":74348,"_3043":126350},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3587":74357,"_30795":74348,"_21329":126352,"_5":14664,"_27997":126327,"_3043":126353},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3587":74358,"_30795":74348,"_21329":126355,"_5":14664,"_27997":126327,"_3043":126356},[],"Estado del registro",{"_3587":74359,"_30795":74348,"_21329":126358,"_5":14664,"_27997":126327,"_3043":126359},[],"Respuesta firmada",{"_3587":74360,"_30795":74348,"_21329":126361,"_5":14664,"_27997":126327,"_3043":55181},[],{"_3587":74361,"_30795":74348,"_21329":126363,"_5":14664,"_27997":126327,"_3043":58000},[],{"_3587":74362,"_30795":74348,"_21329":126365,"_5":14664,"_27997":126327,"_3043":55198},[],{"_3587":74363,"_30795":74348,"_21329":126367,"_5":14664,"_27997":126327,"_3043":126368},[],"`Revoked`, con razón y fecha de revocación.",{"_3587":74364,"_30795":74348,"_21329":126370,"_5":14664,"_27997":126327,"_3043":126371},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3587":74365,"_30795":74348,"_21329":126373,"_5":14664,"_27997":126327,"_3043":126374},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3587":74366,"_30795":74348,"_21329":126376,"_5":14664,"_27997":126327,"_3043":126377},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3587":74367,"_30795":74348,"_21329":126379,"_5":14664,"_27997":126327,"_3043":126380},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3587":74368,"_30795":74348,"_21329":126382,"_5":14664,"_27997":126327,"_3043":126383},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3587":74369,"_30795":74348,"_21329":126385,"_5":14664,"_27997":126331,"_3043":126386},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3587":74370,"_30795":74348,"_21329":126388,"_5":14664,"_27997":126331,"_3043":126389},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3587":74371,"_30795":74348,"_21329":126391,"_5":14664,"_27997":126335,"_3043":126392},[],"El servicio acepta:",{"_3587":74372,"_30795":74348,"_21329":126394,"_5":14664,"_27997":126335,"_3043":122287},[],{"_3587":74373,"_30795":74348,"_21329":126396,"_5":14664,"_27997":126335,"_3043":126397},[],"Ruta del servicio VA",{"_3587":74374,"_30795":74348,"_21329":126399,"_5":14664,"_27997":126335,"_3043":126400},[],"Formato",{"_3587":74375,"_30795":74348,"_21329":126402,"_5":14664,"_27997":126335,"_3043":58040},[],{"_3587":74376,"_30795":74348,"_21329":126404,"_5":14664,"_27997":126335,"_3043":58043},[],{"_3587":74377,"_30795":74348,"_21329":126406,"_5":14664,"_27997":126335,"_3043":126407},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3587":74378,"_30795":74348,"_21329":126409,"_5":14664,"_27997":126335,"_3043":57435},[],{"_3587":74379,"_30795":74348,"_21329":126411,"_5":14664,"_27997":126335,"_3043":58051},[],{"_3587":74380,"_30795":74348,"_21329":126413,"_5":14664,"_27997":126335,"_3043":126414},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3587":74381,"_30795":74348,"_21329":126416,"_5":14664,"_27997":126335,"_3043":126417},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3587":74382,"_30795":74348,"_21329":126419,"_5":14664,"_27997":126339,"_3043":126420},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3587":74383,"_30795":74348,"_21329":126422,"_5":14664,"_27997":126339,"_3043":126423},[],"Genera la solicitud:",{"_3587":74384,"_30795":74348,"_21329":126425,"_5":14664,"_27997":126339,"_3043":126426},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3587":74385,"_30795":74348,"_21329":126428,"_5":14664,"_27997":126339,"_3043":126429},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3587":74386,"_30795":74348,"_21329":126431,"_5":14664,"_27997":126339,"_3043":126432},[],"Verifica el DER recibido:",{"_3587":74387,"_30795":74348,"_21329":126434,"_5":14664,"_27997":126339,"_3043":126435},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3587":74388,"_30795":74348,"_21329":126437,"_5":14664,"_27997":126343,"_3043":126438},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3587":74389,"_30795":74348,"_21329":126440,"_5":14664,"_27997":126343,"_3043":126441},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3587":74390,"_30795":74348,"_21329":126443,"_5":14664,"_27997":126347,"_3043":58084},[],{"_3587":74391,"_30795":74348,"_21329":126445,"_5":14664,"_27997":126347,"_3043":58087},[],{"_3587":74392,"_30795":74348,"_21329":126447,"_5":14664,"_27997":126347,"_3043":126448},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3587":74393,"_30795":74348,"_21329":126450,"_5":14664,"_27997":126347,"_3043":125933},[],{"_3587":74394,"_30795":74394,"_5":15024,"_3043":56044,"_31154":126452,"_21329":126453,"_27997":74394},[50381,120436,56044],[],{"_3587":74395,"_30795":74394,"_21329":126455,"_5":14664,"_27997":74394,"_3043":126456},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3587":74396,"_30795":74394,"_5":31151,"_21329":126458,"_27997":126459,"_3043":123761},[],"/docs/pr-preview/pr-70/es/platform/pki/overview#empieza-aquí",{"_3587":74397,"_30795":74394,"_5":31151,"_21329":126461,"_27997":126462,"_3043":126463},[],"/docs/pr-preview/pr-70/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3587":74398,"_30795":74394,"_5":31151,"_21329":126465,"_27997":126466,"_3043":124281},[],"/docs/pr-preview/pr-70/es/platform/pki/overview#capacidades-principales",{"_3587":74399,"_30795":74394,"_5":31151,"_21329":126468,"_27997":126469,"_3043":124285},[],"/docs/pr-preview/pr-70/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3587":74400,"_30795":74394,"_5":31151,"_21329":126471,"_27997":126472,"_3043":124289},[],"/docs/pr-preview/pr-70/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3587":74401,"_30795":74394,"_5":31151,"_21329":126474,"_27997":126475,"_3043":124293},[],"/docs/pr-preview/pr-70/es/platform/pki/overview#emite-y-controla-certificados",{"_3587":74402,"_30795":74394,"_5":31151,"_21329":126477,"_27997":126478,"_3043":124301},[],"/docs/pr-preview/pr-70/es/platform/pki/overview#publica-el-estado-de-validación",{"_3587":74403,"_30795":74394,"_5":31151,"_21329":126480,"_27997":126481,"_3043":126482},[],"/docs/pr-preview/pr-70/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3587":74404,"_30795":74394,"_5":31151,"_21329":126484,"_27997":126485,"_3043":125241},[],"/docs/pr-preview/pr-70/es/platform/pki/overview#continúa",{"_3587":74405,"_30795":74394,"_21329":126487,"_5":14664,"_27997":74394,"_3043":126488},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3587":74406,"_30795":74394,"_21329":126490,"_5":14664,"_27997":126459,"_3043":126491},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3587":74407,"_30795":74394,"_21329":126493,"_5":14664,"_27997":126459,"_3043":126494},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3587":74408,"_30795":74394,"_21329":126496,"_5":14664,"_27997":126462,"_3043":126497},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3587":74409,"_30795":74394,"_21329":126499,"_5":14664,"_27997":126462,"_3043":126500},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3587":74410,"_30795":74394,"_21329":126502,"_5":14664,"_27997":126462,"_3043":126503},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3587":74411,"_30795":74394,"_21329":126505,"_5":14664,"_27997":126462,"_3043":126506},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3587":74412,"_30795":74394,"_21329":126508,"_5":14664,"_27997":126462,"_3043":126509},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3587":74413,"_30795":74394,"_21329":126511,"_5":14664,"_27997":126469,"_3043":126512},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3587":74414,"_30795":74394,"_21329":126514,"_5":14664,"_27997":126472,"_3043":126515},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3587":74415,"_30795":74394,"_21329":126517,"_5":14664,"_27997":126475,"_3043":126518},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3587":74416,"_30795":74394,"_21329":126520,"_5":14664,"_27997":126478,"_3043":126521},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3587":74417,"_30795":74394,"_21329":126523,"_5":14664,"_27997":126481,"_3043":126524},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3587":74418,"_30795":74394,"_21329":126526,"_5":14664,"_27997":126481,"_3043":126527},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3587":74419,"_30795":74394,"_21329":126529,"_5":14664,"_27997":126481,"_3043":126530},[],"su clave pública corresponda a la clave privada del cliente;",{"_3587":74420,"_30795":74394,"_21329":126532,"_5":14664,"_27997":126481,"_3043":126533},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3587":74421,"_30795":74394,"_21329":126535,"_5":14664,"_27997":126481,"_3043":126536},[],"sus fechas y usos permitan la operación;",{"_3587":74422,"_30795":74394,"_21329":126538,"_5":14664,"_27997":126481,"_3043":126539},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3587":74423,"_30795":74394,"_21329":126541,"_5":14664,"_27997":126481,"_3043":126542},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3587":74424,"_30795":74394,"_21329":126544,"_5":14664,"_27997":126485,"_3043":126545},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3587":74425,"_30795":74394,"_21329":126547,"_5":14664,"_27997":126485,"_3043":126548},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3587":74426,"_30795":74394,"_21329":126550,"_5":14664,"_27997":126485,"_3043":126551},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3587":74427,"_30795":74427,"_5":15024,"_3043":126553,"_31154":126554,"_21329":126555,"_27997":74427},"Crea tu primera CA",[50381,120436,56044,123885],[],{"_3587":74428,"_30795":74427,"_21329":126557,"_5":14664,"_27997":74427,"_3043":126558},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3587":74429,"_30795":74427,"_5":31151,"_21329":126560,"_27997":126561,"_3043":118970},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3587":74430,"_30795":74427,"_5":31151,"_21329":126563,"_27997":126564,"_3043":126565},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3587":74431,"_30795":74427,"_5":31151,"_21329":126567,"_27997":126568,"_3043":126569},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3587":74432,"_30795":74427,"_5":31151,"_21329":126571,"_27997":126572,"_3043":126573},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3587":74433,"_30795":74427,"_5":31151,"_21329":126575,"_27997":126576,"_3043":126577},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3587":74434,"_30795":74427,"_5":31151,"_21329":126579,"_27997":126580,"_3043":126581},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3587":74435,"_30795":74427,"_5":31151,"_21329":126583,"_27997":126584,"_3043":126585},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3587":74436,"_30795":74427,"_5":31151,"_21329":126587,"_27997":126588,"_3043":124132},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3587":74437,"_30795":74427,"_5":31151,"_21329":126590,"_27997":126591,"_3043":118994},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3587":74438,"_30795":74427,"_21329":126593,"_5":14664,"_27997":74427,"_3043":126594},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3587":74439,"_30795":74427,"_21329":126596,"_5":14664,"_27997":126561,"_3043":126597},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3587":74440,"_30795":74427,"_21329":126599,"_5":14664,"_27997":126561,"_3043":126600},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3587":74441,"_30795":74427,"_21329":126602,"_5":14664,"_27997":126561,"_3043":126603},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3587":74442,"_30795":74427,"_21329":126605,"_5":14664,"_27997":126561,"_3043":126606},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3587":74443,"_30795":74427,"_21329":126608,"_5":14664,"_27997":126564,"_3043":126609},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3587":74444,"_30795":74427,"_21329":126611,"_5":14664,"_27997":126564,"_3043":126612},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3587":74445,"_30795":74427,"_21329":126614,"_5":14664,"_27997":126568,"_3043":126615},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3587":74446,"_30795":74427,"_21329":126617,"_5":14664,"_27997":126568,"_3043":126618},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3587":74447,"_30795":74427,"_21329":126620,"_5":14664,"_27997":126572,"_3043":126621},[],"Selecciona **Root CA** y completa:",{"_3587":74448,"_30795":74427,"_21329":126623,"_5":14664,"_27997":126572,"_3043":58266},[],{"_3587":74449,"_30795":74427,"_21329":126625,"_5":14664,"_27997":126572,"_3043":126626},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3587":74450,"_30795":74427,"_21329":126628,"_5":14664,"_27997":126572,"_3043":126629},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3587":74451,"_30795":74427,"_21329":126631,"_5":14664,"_27997":126572,"_3043":126632},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3587":74452,"_30795":74427,"_21329":126634,"_5":14664,"_27997":126572,"_3043":126635},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3587":74453,"_30795":74427,"_21329":126637,"_5":14664,"_27997":126576,"_3043":126638},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3587":74454,"_30795":74427,"_21329":126640,"_5":14664,"_27997":126580,"_3043":126641},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3587":74455,"_30795":74427,"_21329":126643,"_5":14664,"_27997":126580,"_3043":126644},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3587":74456,"_30795":74427,"_21329":126646,"_5":14664,"_27997":126584,"_3043":126647},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3587":74457,"_30795":74427,"_21329":126649,"_5":14664,"_27997":126584,"_3043":126650},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3587":74458,"_30795":74427,"_21329":126652,"_5":14664,"_27997":126584,"_3043":126653},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3587":74459,"_30795":74427,"_21329":126655,"_5":14664,"_27997":126588,"_3043":126656},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3587":74460,"_30795":74427,"_21329":126658,"_5":14664,"_27997":126588,"_3043":126659},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3587":74461,"_30795":74427,"_21329":126661,"_5":14664,"_27997":126588,"_3043":126662},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3587":74462,"_30795":74427,"_21329":126664,"_5":14664,"_27997":126588,"_3043":126665},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3587":74463,"_30795":74427,"_21329":126667,"_5":14664,"_27997":126591,"_3043":126668},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3587":74464,"_30795":74464,"_5":15024,"_3043":126670,"_31154":126671,"_21329":126672,"_27997":74464},"Emite y verifica un certificado",[50381,120436,56044,123885],[],{"_3587":74465,"_30795":74464,"_21329":126674,"_5":14664,"_27997":74464,"_3043":126675},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3587":74466,"_30795":74464,"_5":31151,"_21329":126677,"_27997":126678,"_3043":118970},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3587":74467,"_30795":74464,"_5":31151,"_21329":126680,"_27997":126681,"_3043":126682},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3587":74468,"_30795":74464,"_5":31151,"_21329":126684,"_27997":126685,"_3043":126686},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3587":74469,"_30795":74464,"_5":31151,"_21329":126688,"_27997":126689,"_3043":126690},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3587":74470,"_30795":74464,"_5":31151,"_21329":126692,"_27997":126693,"_3043":126694},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3587":74471,"_30795":74464,"_5":31151,"_21329":126696,"_27997":126697,"_3043":126698},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3587":74472,"_30795":74464,"_5":31151,"_21329":126700,"_27997":126701,"_3043":126702},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3587":74473,"_30795":74464,"_5":31151,"_21329":126704,"_27997":126705,"_3043":126706},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3587":74474,"_30795":74464,"_5":31151,"_21329":126708,"_27997":126709,"_3043":126710},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3587":74475,"_30795":74464,"_5":31151,"_21329":126712,"_27997":126713,"_3043":126714},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3587":74476,"_30795":74464,"_5":31151,"_21329":126716,"_27997":126717,"_3043":124132},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3587":74477,"_30795":74464,"_5":31151,"_21329":126719,"_27997":126720,"_3043":118994},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3587":74478,"_30795":74464,"_21329":126722,"_5":14664,"_27997":74464,"_3043":126723},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3587":74479,"_30795":74464,"_21329":126725,"_5":14664,"_27997":126678,"_3043":126726},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3587":74480,"_30795":74464,"_21329":126728,"_5":14664,"_27997":126678,"_3043":126729},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3587":74481,"_30795":74464,"_21329":126731,"_5":14664,"_27997":126678,"_3043":126732},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3587":74482,"_30795":74464,"_21329":126734,"_5":14664,"_27997":126678,"_3043":126735},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3587":74483,"_30795":74464,"_21329":126737,"_5":14664,"_27997":126678,"_3043":126738},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3587":74484,"_30795":74464,"_21329":126740,"_5":14664,"_27997":126681,"_3043":126741},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3587":74485,"_30795":74464,"_21329":126743,"_5":14664,"_27997":126685,"_3043":126744},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3587":74486,"_30795":74464,"_21329":126746,"_5":14664,"_27997":126685,"_3043":126747},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3587":74487,"_30795":74464,"_21329":126749,"_5":14664,"_27997":126689,"_3043":126750},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3587":74488,"_30795":74464,"_21329":126752,"_5":14664,"_27997":126689,"_3043":126753},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3587":74489,"_30795":74464,"_21329":126755,"_5":14664,"_27997":126693,"_3043":126756},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3587":74490,"_30795":74464,"_21329":126758,"_5":14664,"_27997":126693,"_3043":126759},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3587":74491,"_30795":74464,"_21329":126761,"_5":14664,"_27997":126697,"_3043":126762},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3587":74492,"_30795":74464,"_21329":126764,"_5":14664,"_27997":126701,"_3043":126765},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3587":74493,"_30795":74464,"_21329":126767,"_5":14664,"_27997":126705,"_3043":126768},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3587":74494,"_30795":74464,"_21329":126770,"_5":14664,"_27997":126709,"_3043":126771},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3587":74495,"_30795":74464,"_21329":126773,"_5":14664,"_27997":126709,"_3043":126774},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3587":74496,"_30795":74464,"_21329":126776,"_5":14664,"_27997":126709,"_3043":126777},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3587":74497,"_30795":74464,"_21329":126779,"_5":14664,"_27997":126713,"_3043":126780},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3587":74498,"_30795":74464,"_21329":126782,"_5":14664,"_27997":126713,"_3043":126783},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3587":74499,"_30795":74464,"_21329":126785,"_5":14664,"_27997":126713,"_3043":126786},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3587":74500,"_30795":74464,"_21329":126788,"_5":14664,"_27997":126717,"_3043":124215},[],{"_3587":74501,"_30795":74464,"_21329":126790,"_5":14664,"_27997":126717,"_3043":122736},[],{"_3587":74502,"_30795":74464,"_21329":126792,"_5":14664,"_27997":126717,"_3043":126793},[],"La CA rechaza la emisión",{"_3587":74503,"_30795":74464,"_21329":126795,"_5":14664,"_27997":126717,"_3043":126796},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3587":74504,"_30795":74464,"_21329":126798,"_5":14664,"_27997":126717,"_3043":126799},[],"Sujeto o usos diferentes",{"_3587":74505,"_30795":74464,"_21329":126801,"_5":14664,"_27997":126717,"_3043":126802},[],"Perfil aplicado y valores solicitados.",{"_3587":74506,"_30795":74464,"_21329":126804,"_5":14664,"_27997":126717,"_3043":126805},[],"No se encuentra el emisor",{"_3587":74507,"_30795":74464,"_21329":126807,"_5":14664,"_27997":126717,"_3043":126808},[],"CA descargada y cadena intermedia necesaria.",{"_3587":74508,"_30795":74464,"_21329":126810,"_5":14664,"_27997":126717,"_3043":126811},[],"Falla la vigencia",{"_3587":74509,"_30795":74464,"_21329":126813,"_5":14664,"_27997":126717,"_3043":126814},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3587":74510,"_30795":74464,"_21329":126816,"_5":14664,"_27997":126717,"_3043":126817},[],"Los resúmenes de clave difieren",{"_3587":74511,"_30795":74464,"_21329":126819,"_5":14664,"_27997":126717,"_3043":126820},[],"Archivos de certificado y clave de la misma emisión.",{"_3587":74512,"_30795":74464,"_21329":126822,"_5":14664,"_27997":126717,"_3043":126823},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3587":74513,"_30795":74464,"_21329":126825,"_5":14664,"_27997":126720,"_3043":126826},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3587":74514,"_30795":74464,"_21329":126828,"_5":14664,"_27997":126720,"_3043":126829},[],"Gestionar certificados para inspección, estado y revocación.",{"_3587":74515,"_30795":74464,"_21329":126831,"_5":14664,"_27997":126720,"_3043":126832},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3587":74516,"_30795":74464,"_21329":126834,"_5":14664,"_27997":126720,"_3043":126835},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3587":74517,"_30795":74464,"_21329":126837,"_5":14664,"_27997":126720,"_3043":126838},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3587":74518,"_30795":74518,"_5":15024,"_3043":126840,"_31154":126841,"_21329":126842,"_27997":74518},"Primeros pasos de PKI",[50381,120436,56044,123885],[],{"_3587":74519,"_30795":74518,"_21329":126844,"_5":14664,"_27997":74518,"_3043":126845},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3587":74520,"_30795":74518,"_5":31151,"_21329":126847,"_27997":126848,"_3043":118970},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3587":74521,"_30795":74518,"_5":31151,"_21329":126850,"_27997":126851,"_3043":126852},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3587":74522,"_30795":74518,"_5":31151,"_21329":126854,"_27997":126855,"_3043":124067},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3587":74523,"_30795":74518,"_5":31151,"_21329":126857,"_27997":126858,"_3043":126859},[],"/docs/pr-preview/pr-70/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3587":74524,"_30795":74518,"_21329":126861,"_5":14664,"_27997":74518,"_3043":126862},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3587":74525,"_30795":74518,"_21329":126864,"_5":14664,"_27997":126848,"_3043":126865},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3587":74526,"_30795":74518,"_21329":126867,"_5":14664,"_27997":126848,"_3043":126868},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3587":74527,"_30795":74518,"_21329":126870,"_5":14664,"_27997":126848,"_3043":126871},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3587":74528,"_30795":74518,"_21329":126873,"_5":14664,"_27997":126848,"_3043":126874},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3587":74529,"_30795":74518,"_21329":126876,"_5":14664,"_27997":126848,"_3043":126877},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3587":74530,"_30795":74518,"_21329":126879,"_5":14664,"_27997":126851,"_3043":126880},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3587":74531,"_30795":74518,"_21329":126882,"_5":14664,"_27997":126851,"_3043":126883},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3587":74532,"_30795":74518,"_21329":126885,"_5":14664,"_27997":126851,"_3043":126886},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3587":74533,"_30795":74518,"_21329":126888,"_5":14664,"_27997":126851,"_3043":126889},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3587":74534,"_30795":74518,"_21329":126891,"_5":14664,"_27997":126855,"_3043":126892},[],"Archivo o recurso",{"_3587":74535,"_30795":74518,"_21329":126894,"_5":14664,"_27997":126855,"_3043":124064},[],{"_3587":74536,"_30795":74518,"_21329":126896,"_5":14664,"_27997":126855,"_3043":126897},[],"CA raíz activa y `ca.pem`",{"_3587":74537,"_30795":74518,"_21329":126899,"_5":14664,"_27997":126855,"_3043":126900},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3587":74538,"_30795":74518,"_21329":126902,"_5":14664,"_27997":126855,"_3043":126903},[],"Certificado final y `device.crt`",{"_3587":74539,"_30795":74518,"_21329":126905,"_5":14664,"_27997":126855,"_3043":126906},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3587":74540,"_30795":74518,"_21329":126908,"_5":14664,"_27997":126855,"_3043":126909},[],"Clave privada `device.key`",{"_3587":74541,"_30795":74518,"_21329":126911,"_5":14664,"_27997":126855,"_3043":126912},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3587":74542,"_30795":74518,"_21329":126914,"_5":14664,"_27997":126855,"_3043":126915},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3587":74543,"_30795":74518,"_21329":126917,"_5":14664,"_27997":126858,"_3043":126918},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3587":74544,"_30795":74518,"_21329":126920,"_5":14664,"_27997":126858,"_3043":126921},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3587":74545,"_30795":74518,"_21329":126923,"_5":14664,"_27997":126858,"_3043":126924},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3587":74546,"_30795":74546,"_5":15024,"_3043":126926,"_31154":126927,"_21329":126929,"_27997":74546},"Resolución de problemas PKI",[50381,120436,56044,126928],"Resolución de problemas",[],{"_3587":74547,"_30795":74546,"_21329":126931,"_5":14664,"_27997":74546,"_3043":126932},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3587":74548,"_30795":74546,"_5":31151,"_21329":126934,"_27997":126935,"_3043":126936},[],"/docs/pr-preview/pr-70/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3587":74549,"_30795":74546,"_5":31151,"_21329":126938,"_27997":126939,"_3043":126940},[],"/docs/pr-preview/pr-70/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3587":74550,"_30795":74546,"_5":31151,"_21329":126942,"_27997":126943,"_3043":126944},[],"/docs/pr-preview/pr-70/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3587":74551,"_30795":74546,"_21329":126946,"_5":14664,"_27997":74546,"_3043":126947},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3587":74552,"_30795":74546,"_21329":126949,"_5":14664,"_27997":74546,"_3043":126950},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3587":74553,"_30795":74546,"_21329":126952,"_5":14664,"_27997":126935,"_3043":124064},[],{"_3587":74554,"_30795":74546,"_21329":126954,"_5":14664,"_27997":126935,"_3043":122736},[],{"_3587":74555,"_30795":74546,"_21329":126956,"_5":14664,"_27997":126935,"_3043":118994},[],{"_3587":74556,"_30795":74546,"_21329":126958,"_5":14664,"_27997":126935,"_3043":54886},[],{"_3587":74557,"_30795":74546,"_21329":126960,"_5":14664,"_27997":126935,"_3043":126961},[],"Existe, está activa y sus fechas son utilizables.",{"_3587":74558,"_30795":74546,"_21329":126963,"_5":14664,"_27997":126935,"_3043":126964},[],"Autoridades.",{"_3587":74559,"_30795":74546,"_21329":126966,"_5":14664,"_27997":126935,"_3043":126967},[],"Clave",{"_3587":74560,"_30795":74546,"_21329":126969,"_5":14664,"_27997":126935,"_3043":126970},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3587":74561,"_30795":74546,"_21329":126972,"_5":14664,"_27997":126935,"_3043":126973},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3587":74562,"_30795":74546,"_21329":126975,"_5":14664,"_27997":126935,"_3043":58620},[],{"_3587":74563,"_30795":74546,"_21329":126977,"_5":14664,"_27997":126935,"_3043":126978},[],"PEM correcto y firma verificable.",{"_3587":74564,"_30795":74546,"_21329":126980,"_5":14664,"_27997":126935,"_3043":58626},[],{"_3587":74565,"_30795":74546,"_21329":126982,"_5":14664,"_27997":126935,"_3043":126983},[],"Perfil",{"_3587":74566,"_30795":74546,"_21329":126985,"_5":14664,"_27997":126935,"_3043":126986},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3587":74567,"_30795":74546,"_21329":126988,"_5":14664,"_27997":126935,"_3043":126989},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3587":74568,"_30795":74546,"_21329":126991,"_5":14664,"_27997":126935,"_3043":124215},[],{"_3587":74569,"_30795":74546,"_21329":126993,"_5":14664,"_27997":126935,"_3043":126994},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3587":74570,"_30795":74546,"_21329":126996,"_5":14664,"_27997":126935,"_3043":126997},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3587":74571,"_30795":74546,"_21329":126999,"_5":14664,"_27997":126935,"_3043":127000},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3587":74572,"_30795":74546,"_21329":127002,"_5":14664,"_27997":126935,"_3043":127003},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3587":74573,"_30795":74546,"_21329":127005,"_5":14664,"_27997":126939,"_3043":127006},[],"Revisa cada frontera por separado:",{"_3587":74574,"_30795":74546,"_21329":127008,"_5":14664,"_27997":126939,"_3043":127009},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3587":74575,"_30795":74546,"_21329":127011,"_5":14664,"_27997":126939,"_3043":127012},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3587":74576,"_30795":74546,"_21329":127014,"_5":14664,"_27997":126939,"_3043":127015},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3587":74577,"_30795":74546,"_21329":127017,"_5":14664,"_27997":126939,"_3043":127018},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3587":74578,"_30795":74546,"_21329":127020,"_5":14664,"_27997":126939,"_3043":127021},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3587":74579,"_30795":74546,"_21329":127023,"_5":14664,"_27997":126939,"_3043":127024},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3587":74580,"_30795":74546,"_21329":127026,"_5":14664,"_27997":126943,"_3043":127027},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3587":74581,"_30795":74546,"_21329":127029,"_5":14664,"_27997":126943,"_3043":127030},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3587":74582,"_30795":74582,"_5":15024,"_3043":127032,"_31154":127033,"_21329":127034,"_27997":74582},"Seguridad",[50381],[],{"_3587":74583,"_30795":74582,"_21329":127036,"_5":14664,"_27997":74582,"_3043":127037},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3587":74584,"_30795":74582,"_5":31151,"_21329":127039,"_27997":127040,"_3043":127041},[],"/docs/pr-preview/pr-70/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3587":74585,"_30795":74582,"_5":31151,"_21329":127043,"_27997":127044,"_3043":127045},[],"/docs/pr-preview/pr-70/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3587":74586,"_30795":74582,"_5":31151,"_21329":127047,"_27997":127048,"_3043":127049},[],"/docs/pr-preview/pr-70/es/security#versiones-soportadas","Versiones soportadas",{"_3587":74587,"_30795":74582,"_5":31151,"_21329":127051,"_27997":127052,"_3043":127053},[],"/docs/pr-preview/pr-70/es/security#divulgación-responsable","Divulgación responsable",{"_3587":74588,"_30795":74582,"_21329":127055,"_5":14664,"_27997":74582,"_3043":127056},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3587":74589,"_30795":74582,"_21329":127058,"_5":14664,"_27997":127040,"_3043":127059},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3587":74590,"_30795":74582,"_21329":127061,"_5":14664,"_27997":127040,"_3043":127062},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3587":74591,"_30795":74582,"_21329":127064,"_5":14664,"_27997":127040,"_3043":15301},[],{"_3587":74592,"_30795":74582,"_21329":127066,"_5":14664,"_27997":127040,"_3043":15231},[],{"_3587":74593,"_30795":74582,"_21329":127068,"_5":14664,"_27997":127040,"_3043":15288},[],{"_3587":74594,"_30795":74582,"_21329":127070,"_5":14664,"_27997":127040,"_3043":127071},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3587":74595,"_30795":74582,"_21329":127073,"_5":14664,"_27997":127040,"_3043":127074},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3587":74596,"_30795":74582,"_21329":127076,"_5":14664,"_27997":127044,"_3043":127077},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3587":74597,"_30795":74582,"_21329":127079,"_5":14664,"_27997":127044,"_3043":127080},[],"No incluyas en el reporte:",{"_3587":74598,"_30795":74582,"_21329":127082,"_5":14664,"_27997":127044,"_3043":127083},[],"Credenciales, tokens o claves privadas",{"_3587":74599,"_30795":74582,"_21329":127085,"_5":14664,"_27997":127044,"_3043":127086},[],"Datos de clientes o información identificable de clientes",{"_3587":74600,"_30795":74582,"_21329":127088,"_5":14664,"_27997":127044,"_3043":127089},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3587":74601,"_30795":74582,"_21329":127091,"_5":14664,"_27997":127048,"_3043":127092},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3587":74602,"_30795":74582,"_21329":127094,"_5":14664,"_27997":127048,"_3043":127095},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3587":74603,"_30795":74582,"_21329":127097,"_5":14664,"_27997":127052,"_3043":127098},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3587":74604,"_30795":74582,"_21329":127100,"_5":14664,"_27997":127052,"_3043":127101},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3587":74605,"_30795":74582,"_21329":127103,"_5":14664,"_27997":127052,"_3043":127104},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3587":74606,"_30795":74582,"_21329":127106,"_5":14664,"_27997":127052,"_3043":127107},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3587":74607,"_30795":74582,"_21329":127109,"_5":14664,"_27997":127052,"_3043":127110},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3587":74608,"_30795":74608,"_5":15024,"_3043":127112,"_31154":127113,"_21329":127115,"_27997":74608},"3.8.0 a 4.0.0",[50381,127114],"Actualizaciones",[],{"_3587":74609,"_30795":74608,"_21329":127117,"_5":14664,"_27997":74608,"_3043":127118},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3587":74610,"_30795":74608,"_5":31151,"_21329":127120,"_27997":127121,"_3043":127122},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3587":74611,"_30795":74608,"_5":31151,"_21329":127124,"_27997":127125,"_3043":127126},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3587":74612,"_30795":74608,"_5":31151,"_21329":127128,"_27997":127129,"_3043":127130},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3587":74613,"_30795":74608,"_5":31151,"_21329":127132,"_27997":127133,"_3043":127134},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3587":74614,"_30795":74608,"_5":31151,"_21329":127136,"_27997":127137,"_3043":127138},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3587":74615,"_30795":74608,"_5":31151,"_21329":127140,"_27997":127141,"_3043":127142},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3587":74616,"_30795":74608,"_5":31151,"_21329":127144,"_27997":127145,"_3043":58792},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3587":74617,"_30795":74608,"_5":31151,"_21329":127147,"_27997":127148,"_3043":127149},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3587":74618,"_30795":74608,"_5":31151,"_21329":127151,"_27997":127152,"_3043":127153},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3587":74619,"_30795":74608,"_5":31151,"_21329":127155,"_27997":127156,"_3043":127157},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3587":74620,"_30795":74608,"_5":31151,"_21329":127159,"_27997":127160,"_3043":119565},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3587":74621,"_30795":74608,"_5":31151,"_21329":127162,"_27997":127163,"_3043":127164},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3587":74622,"_30795":74608,"_5":31151,"_21329":127166,"_27997":127167,"_3043":127168},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3587":74623,"_30795":74608,"_5":31151,"_21329":127170,"_27997":127171,"_3043":127172},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3587":74624,"_30795":74608,"_5":31151,"_21329":127174,"_27997":127175,"_3043":127176},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3587":74625,"_30795":74608,"_5":31151,"_21329":127178,"_27997":127179,"_3043":127180},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3587":74626,"_30795":74608,"_5":31151,"_21329":127182,"_27997":127183,"_3043":127184},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3587":74627,"_30795":74608,"_5":31151,"_21329":127186,"_27997":127187,"_3043":127188},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3587":74628,"_30795":74608,"_5":31151,"_21329":127190,"_27997":127191,"_3043":127192},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3587":74629,"_30795":74608,"_5":31151,"_21329":127194,"_27997":127195,"_3043":127196},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3587":74630,"_30795":74608,"_5":31151,"_21329":127198,"_27997":127199,"_3043":127200},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3587":74631,"_30795":74608,"_5":31151,"_21329":127202,"_27997":127203,"_3043":127204},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3587":74632,"_30795":74608,"_5":31151,"_21329":127206,"_27997":127207,"_3043":127208},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3587":74633,"_30795":74608,"_5":31151,"_21329":127210,"_27997":127211,"_3043":127212},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3587":74634,"_30795":74608,"_5":31151,"_21329":127214,"_27997":127215,"_3043":127216},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3587":74635,"_30795":74608,"_5":31151,"_21329":127218,"_27997":127219,"_3043":127220},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3587":74636,"_30795":74608,"_5":31151,"_21329":127222,"_27997":127223,"_3043":127224},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3587":74637,"_30795":74608,"_5":31151,"_21329":127226,"_27997":127227,"_3043":127228},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3587":74638,"_30795":74608,"_5":31151,"_21329":127230,"_27997":127231,"_3043":127232},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3587":74639,"_30795":74608,"_5":31151,"_21329":127234,"_27997":127235,"_3043":127236},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3587":74640,"_30795":74608,"_5":31151,"_21329":127238,"_27997":127239,"_3043":127240},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3587":74641,"_30795":74608,"_5":31151,"_21329":127242,"_27997":127243,"_3043":127244},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3587":74642,"_30795":74608,"_5":31151,"_21329":127246,"_27997":127247,"_3043":127248},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3587":74643,"_30795":74608,"_5":31151,"_21329":127250,"_27997":127251,"_3043":127252},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3587":74644,"_30795":74608,"_5":31151,"_21329":127254,"_27997":127255,"_3043":127256},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3587":74645,"_30795":74608,"_5":31151,"_21329":127258,"_27997":127259,"_3043":127260},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3587":74646,"_30795":74608,"_5":31151,"_21329":127262,"_27997":127263,"_3043":127264},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3587":74647,"_30795":74608,"_5":31151,"_21329":127266,"_27997":127267,"_3043":127268},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3587":74648,"_30795":74608,"_5":31151,"_21329":127270,"_27997":127271,"_3043":127272},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3587":74649,"_30795":74608,"_5":31151,"_21329":127274,"_27997":127275,"_3043":127276},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3587":74650,"_30795":74608,"_5":31151,"_21329":127278,"_27997":127279,"_3043":127280},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3587":74651,"_30795":74608,"_5":31151,"_21329":127282,"_27997":127283,"_3043":123078},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3587":74652,"_30795":74608,"_5":31151,"_21329":127285,"_27997":127286,"_3043":127287},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3587":74653,"_30795":74608,"_5":31151,"_21329":127289,"_27997":127290,"_3043":127291},[],"/docs/pr-preview/pr-70/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3587":74654,"_30795":74608,"_21329":127293,"_5":14664,"_27997":74608,"_3043":127294},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3587":74655,"_30795":74608,"_21329":127296,"_5":14664,"_27997":74608,"_3043":127297},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3587":74656,"_30795":74608,"_21329":127299,"_5":14664,"_27997":74608,"_3043":127300},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3587":74657,"_30795":74608,"_21329":127302,"_5":14664,"_27997":74608,"_3043":127303},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3587":74658,"_30795":74608,"_21329":127305,"_5":14664,"_27997":74608,"_3043":127306},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3587":74659,"_30795":74608,"_21329":127308,"_5":14664,"_27997":74608,"_3043":127309},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3587":74660,"_30795":74608,"_21329":127311,"_5":14664,"_27997":74608,"_3043":127312},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3587":74661,"_30795":74608,"_21329":127314,"_5":14664,"_27997":127125,"_3043":127315},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3587":74662,"_30795":74608,"_21329":127317,"_5":14664,"_27997":127125,"_3043":127318},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3587":74663,"_30795":74608,"_21329":127320,"_5":14664,"_27997":127129,"_3043":127321},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3587":74664,"_30795":74608,"_21329":127323,"_5":14664,"_27997":127129,"_3043":127324},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3587":74665,"_30795":74608,"_21329":127326,"_5":14664,"_27997":127133,"_3043":127327},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3587":74666,"_30795":74608,"_21329":127329,"_5":14664,"_27997":127137,"_3043":127330},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3587":74667,"_30795":74608,"_21329":127332,"_5":14664,"_27997":127137,"_3043":127333},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3587":74668,"_30795":74608,"_21329":127335,"_5":14664,"_27997":127137,"_3043":127336},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3587":74669,"_30795":74608,"_21329":127338,"_5":14664,"_27997":127137,"_3043":127339},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3587":74670,"_30795":74608,"_21329":127341,"_5":14664,"_27997":127137,"_3043":127342},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3587":74671,"_30795":74608,"_21329":127344,"_5":14664,"_27997":127141,"_3043":127345},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3587":74672,"_30795":74608,"_21329":127347,"_5":14664,"_27997":127141,"_3043":127348},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3587":74673,"_30795":74608,"_21329":127350,"_5":14664,"_27997":127141,"_3043":127351},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3587":74674,"_30795":74608,"_21329":127353,"_5":14664,"_27997":127141,"_3043":127354},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3587":74675,"_30795":74608,"_21329":127356,"_5":14664,"_27997":127141,"_3043":127357},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3587":74676,"_30795":74608,"_21329":127359,"_5":14664,"_27997":127141,"_3043":127360},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3587":74677,"_30795":74608,"_21329":127362,"_5":14664,"_27997":127145,"_3043":127363},[],"Cambio",{"_3587":74678,"_30795":74608,"_21329":127365,"_5":14664,"_27997":127145,"_3043":127366},[],"A quién afecta",{"_3587":74679,"_30795":74608,"_21329":127368,"_5":14664,"_27997":127145,"_3043":127369},[],"Gravedad",{"_3587":74680,"_30795":74608,"_21329":127371,"_5":14664,"_27997":127145,"_3043":125857},[],{"_3587":74681,"_30795":74608,"_21329":127373,"_5":14664,"_27997":127145,"_3043":127153},[],{"_3587":74682,"_30795":74608,"_21329":127375,"_5":14664,"_27997":127145,"_3043":127376},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3587":74683,"_30795":74608,"_21329":127378,"_5":14664,"_27997":127145,"_3043":127379},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3587":74684,"_30795":74608,"_21329":127381,"_5":14664,"_27997":127145,"_3043":127382},[],"Copiar los datos a los volúmenes nuevos",{"_3587":74685,"_30795":74608,"_21329":127384,"_5":14664,"_27997":127145,"_3043":127157},[],{"_3587":74686,"_30795":74608,"_21329":127386,"_5":14664,"_27997":127145,"_3043":127387},[],"Todas las releases de Helm",{"_3587":74687,"_30795":74608,"_21329":127389,"_5":14664,"_27997":127145,"_3043":127390},[],"Alta: `helm upgrade` falla",{"_3587":74688,"_30795":74608,"_21329":127392,"_5":14664,"_27997":127145,"_3043":127393},[],"Eliminar o renombrar las claves heredadas",{"_3587":74689,"_30795":74608,"_21329":127395,"_5":14664,"_27997":127145,"_3043":119565},[],{"_3587":74690,"_30795":74608,"_21329":127397,"_5":14664,"_27997":127145,"_3043":127387},[],{"_3587":74691,"_30795":74608,"_21329":127399,"_5":14664,"_27997":127145,"_3043":127400},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3587":74692,"_30795":74608,"_21329":127402,"_5":14664,"_27997":127145,"_3043":127403},[],"Crear primero los Secrets; consulta el paso 2",{"_3587":74693,"_30795":74608,"_21329":127405,"_5":14664,"_27997":127145,"_3043":127164},[],{"_3587":74694,"_30795":74608,"_21329":127407,"_5":14664,"_27997":127145,"_3043":127408},[],"Todos los despliegues",{"_3587":74695,"_30795":74608,"_21329":127410,"_5":14664,"_27997":127145,"_3043":127411},[],"Alta: sin principal de bootstrap no hay administrador",{"_3587":74696,"_30795":74608,"_21329":127413,"_5":14664,"_27997":127145,"_3043":127414},[],"Configurar `services.authz`",{"_3587":74697,"_30795":74608,"_21329":127416,"_5":14664,"_27997":127145,"_3043":127168},[],{"_3587":74698,"_30795":74608,"_21329":127418,"_5":14664,"_27997":127145,"_3043":127387},[],{"_3587":74699,"_30795":74608,"_21329":127420,"_5":14664,"_27997":127145,"_3043":127421},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3587":74700,"_30795":74608,"_21329":127423,"_5":14664,"_27997":127145,"_3043":127424},[],"Mover JWKS y roles a `services.authz`",{"_3587":74701,"_30795":74608,"_21329":127426,"_5":14664,"_27997":127145,"_3043":127188},[],{"_3587":74702,"_30795":74608,"_21329":127428,"_5":14664,"_27997":127145,"_3043":127429},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3587":74703,"_30795":74608,"_21329":127431,"_5":14664,"_27997":127145,"_3043":127432},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3587":74704,"_30795":74608,"_21329":127434,"_5":14664,"_27997":127145,"_3043":127435},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3587":74705,"_30795":74608,"_21329":127437,"_5":14664,"_27997":127145,"_3043":127192},[],{"_3587":74706,"_30795":74608,"_21329":127439,"_5":14664,"_27997":127145,"_3043":127440},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3587":74707,"_30795":74608,"_21329":127442,"_5":14664,"_27997":127145,"_3043":127443},[],"Alta: el backend ya no arranca con ellos",{"_3587":74708,"_30795":74608,"_21329":127445,"_5":14664,"_27997":127145,"_3043":127446},[],"Pasar a PostgreSQL antes de actualizar",{"_3587":74709,"_30795":74608,"_21329":127448,"_5":14664,"_27997":127145,"_3043":127236},[],{"_3587":74710,"_30795":74608,"_21329":127450,"_5":14664,"_27997":127145,"_3043":127451},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3587":74711,"_30795":74608,"_21329":127453,"_5":14664,"_27997":127145,"_3043":127454},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3587":74712,"_30795":74608,"_21329":127456,"_5":14664,"_27997":127145,"_3043":127457},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3587":74713,"_30795":74608,"_21329":127459,"_5":14664,"_27997":127145,"_3043":127460},[],"Webhooks con referencias a archivos",{"_3587":74714,"_30795":74608,"_21329":127462,"_5":14664,"_27997":127145,"_3043":127463},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3587":74715,"_30795":74608,"_21329":127465,"_5":14664,"_27997":127145,"_3043":127466},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3587":74716,"_30795":74608,"_21329":127468,"_5":14664,"_27997":127145,"_3043":127469},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3587":74717,"_30795":74608,"_21329":127471,"_5":14664,"_27997":127145,"_3043":127172},[],{"_3587":74718,"_30795":74608,"_21329":127473,"_5":14664,"_27997":127145,"_3043":127474},[],"Releases con identidades por servicio o material de claves montado",{"_3587":74719,"_30795":74608,"_21329":127476,"_5":14664,"_27997":127145,"_3043":127477},[],"Media: los servicios no pueden leer sus archivos",{"_3587":74720,"_30795":74608,"_21329":127479,"_5":14664,"_27997":127145,"_3043":127480},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3587":74721,"_30795":74608,"_21329":127482,"_5":14664,"_27997":127145,"_3043":127176},[],{"_3587":74722,"_30795":74608,"_21329":127484,"_5":14664,"_27997":127145,"_3043":127485},[],"Releases que definen `amqp.tls`",{"_3587":74723,"_30795":74608,"_21329":127487,"_5":14664,"_27997":127145,"_3043":127488},[],"Media: los clientes se conectan al puerto equivocado",{"_3587":74724,"_30795":74608,"_21329":127490,"_5":14664,"_27997":127145,"_3043":127491},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3587":74725,"_30795":74608,"_21329":127493,"_5":14664,"_27997":127145,"_3043":127196},[],{"_3587":74726,"_30795":74608,"_21329":127495,"_5":14664,"_27997":127145,"_3043":127496},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3587":74727,"_30795":74608,"_21329":127498,"_5":14664,"_27997":127145,"_3043":127499},[],"Media: las claves de CA quedan sin gestionar",{"_3587":74728,"_30795":74608,"_21329":127501,"_5":14664,"_27997":127145,"_3043":127502},[],"Ejecutar la migración de CA a KMS",{"_3587":74729,"_30795":74608,"_21329":127504,"_5":14664,"_27997":127145,"_3043":127505},[],"Verificación del certificado del receptor",{"_3587":74730,"_30795":74608,"_21329":127507,"_5":14664,"_27997":127145,"_3043":127508},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3587":74731,"_30795":74608,"_21329":127510,"_5":14664,"_27997":127145,"_3043":127511},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3587":74732,"_30795":74608,"_21329":127513,"_5":14664,"_27997":127145,"_3043":127514},[],"Poner `insecure_skip_verify` a `false`",{"_3587":74733,"_30795":74608,"_21329":127516,"_5":14664,"_27997":127145,"_3043":127212},[],{"_3587":74734,"_30795":74608,"_21329":127518,"_5":14664,"_27997":127145,"_3043":127519},[],"Scripts y consolas que editan DMS por API",{"_3587":74735,"_30795":74608,"_21329":127521,"_5":14664,"_27997":127145,"_3043":127522},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3587":74736,"_30795":74608,"_21329":127524,"_5":14664,"_27997":127145,"_3043":127525},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3587":74737,"_30795":74608,"_21329":127527,"_5":14664,"_27997":127145,"_3043":127232},[],{"_3587":74738,"_30795":74608,"_21329":127529,"_5":14664,"_27997":127145,"_3043":127530},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3587":74739,"_30795":74608,"_21329":127532,"_5":14664,"_27997":127145,"_3043":127533},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3587":74740,"_30795":74608,"_21329":127535,"_5":14664,"_27997":127145,"_3043":127536},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3587":74741,"_30795":74608,"_21329":127538,"_5":14664,"_27997":127145,"_3043":127240},[],{"_3587":74742,"_30795":74608,"_21329":127540,"_5":14664,"_27997":127145,"_3043":127541},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3587":74743,"_30795":74608,"_21329":127543,"_5":14664,"_27997":127145,"_3043":127544},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3587":74744,"_30795":74608,"_21329":127546,"_5":14664,"_27997":127145,"_3043":127547},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3587":74745,"_30795":74608,"_21329":127549,"_5":14664,"_27997":127145,"_3043":127228},[],{"_3587":74746,"_30795":74608,"_21329":127551,"_5":14664,"_27997":127145,"_3043":127552},[],"Consumidores que leen el campo `events` del dispositivo",{"_3587":74747,"_30795":74608,"_21329":127554,"_5":14664,"_27997":127145,"_3043":127555},[],"Media: el campo desaparece",{"_3587":74748,"_30795":74608,"_21329":127557,"_5":14664,"_27997":127145,"_3043":127558},[],"Usar los nuevos endpoints de eventos",{"_3587":74749,"_30795":74608,"_21329":127560,"_5":14664,"_27997":127145,"_3043":127248},[],{"_3587":74750,"_30795":74608,"_21329":127562,"_5":14664,"_27997":127145,"_3043":127563},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3587":74751,"_30795":74608,"_21329":127565,"_5":14664,"_27997":127145,"_3043":127566},[],"Media: la migración de la VA aborta",{"_3587":74752,"_30795":74608,"_21329":127568,"_5":14664,"_27997":127145,"_3043":127569},[],"Corregir los roles afectados antes de actualizar",{"_3587":74753,"_30795":74608,"_21329":127571,"_5":14664,"_27997":127145,"_3043":127180},[],{"_3587":74754,"_30795":74608,"_21329":127573,"_5":14664,"_27997":127145,"_3043":127574},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3587":74755,"_30795":74608,"_21329":127576,"_5":14664,"_27997":127145,"_3043":127577},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3587":74756,"_30795":74608,"_21329":127579,"_5":14664,"_27997":127145,"_3043":127580},[],"Actualizar el archivo de values",{"_3587":74757,"_30795":74608,"_21329":127582,"_5":14664,"_27997":127145,"_3043":127220},[],{"_3587":74758,"_30795":74608,"_21329":127584,"_5":14664,"_27997":127145,"_3043":127585},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3587":74759,"_30795":74608,"_21329":127587,"_5":14664,"_27997":127145,"_3043":127588},[],"Baja: prevalece el ID de la URL",{"_3587":74760,"_30795":74608,"_21329":127590,"_5":14664,"_27997":127145,"_3043":127591},[],"Enviar el ID en la URL",{"_3587":74761,"_30795":74608,"_21329":127593,"_5":14664,"_27997":127145,"_3043":127244},[],{"_3587":74762,"_30795":74608,"_21329":127595,"_5":14664,"_27997":127145,"_3043":127596},[],"Clientes que envían un `id` al crear o importar CAs",{"_3587":74763,"_30795":74608,"_21329":127598,"_5":14664,"_27997":127145,"_3043":127599},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3587":74764,"_30795":74608,"_21329":127601,"_5":14664,"_27997":127145,"_3043":127602},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3587":74765,"_30795":74608,"_21329":127604,"_5":14664,"_27997":127145,"_3043":127224},[],{"_3587":74766,"_30795":74608,"_21329":127606,"_5":14664,"_27997":127145,"_3043":127607},[],"Consumidores que comparan el `type` del certificado",{"_3587":74767,"_30795":74608,"_21329":127609,"_5":14664,"_27997":127145,"_3043":127610},[],"Baja: dos valores cambian de nombre",{"_3587":74768,"_30795":74608,"_21329":127612,"_5":14664,"_27997":127145,"_3043":127613},[],"Adaptar los consumidores",{"_3587":74769,"_30795":74608,"_21329":127615,"_5":14664,"_27997":127145,"_3043":127216},[],{"_3587":74770,"_30795":74608,"_21329":127617,"_5":14664,"_27997":127145,"_3043":127618},[],"Cualquier DMS",{"_3587":74771,"_30795":74608,"_21329":127620,"_5":14664,"_27997":127145,"_3043":127621},[],"Baja: solo informativo",{"_3587":74772,"_30795":74608,"_21329":127623,"_5":14664,"_27997":127145,"_3043":127624},[],"Revisar ambos bloques antes de editar",{"_3587":74773,"_30795":74608,"_21329":127626,"_5":14664,"_27997":127152,"_3043":127627},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3587":74774,"_30795":74608,"_21329":127629,"_5":14664,"_27997":127152,"_3043":127630},[],"El paso 4 de la guía de migración copia los datos.",{"_3587":74775,"_30795":74608,"_21329":127632,"_5":14664,"_27997":127156,"_3043":127633},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3587":74776,"_30795":74608,"_21329":127635,"_5":14664,"_27997":127160,"_3043":127636},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3587":74777,"_30795":74608,"_21329":127638,"_5":14664,"_27997":127160,"_3043":127639},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3587":74778,"_30795":74608,"_21329":127641,"_5":14664,"_27997":127163,"_3043":127642},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3587":74779,"_30795":74608,"_21329":127644,"_5":14664,"_27997":127167,"_3043":127645},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3587":74780,"_30795":74608,"_21329":127647,"_5":14664,"_27997":127171,"_3043":127648},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3587":74781,"_30795":74608,"_21329":127650,"_5":14664,"_27997":127171,"_3043":127651},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3587":74782,"_30795":74608,"_21329":127653,"_5":14664,"_27997":127175,"_3043":127654},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3587":74783,"_30795":74608,"_21329":127656,"_5":14664,"_27997":127179,"_3043":127657},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3587":74784,"_30795":74608,"_21329":127659,"_5":14664,"_27997":127179,"_3043":127660},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3587":74785,"_30795":74608,"_21329":127662,"_5":14664,"_27997":127179,"_3043":127663},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3587":74786,"_30795":74608,"_21329":127665,"_5":14664,"_27997":127179,"_3043":127666},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3587":74787,"_30795":74608,"_21329":127668,"_5":14664,"_27997":127179,"_3043":127669},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3587":74788,"_30795":74608,"_21329":127671,"_5":14664,"_27997":127179,"_3043":127672},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3587":74789,"_30795":74608,"_21329":127674,"_5":14664,"_27997":127187,"_3043":127675},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3587":74790,"_30795":74608,"_21329":127677,"_5":14664,"_27997":127187,"_3043":127678},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3587":74791,"_30795":74608,"_21329":127680,"_5":14664,"_27997":127187,"_3043":127681},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3587":74792,"_30795":74608,"_21329":127683,"_5":14664,"_27997":127187,"_3043":127684},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3587":74793,"_30795":74608,"_21329":127686,"_5":14664,"_27997":127187,"_3043":127687},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3587":74794,"_30795":74608,"_21329":127689,"_5":14664,"_27997":127191,"_3043":127690},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3587":74795,"_30795":74608,"_21329":127692,"_5":14664,"_27997":127195,"_3043":127693},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3587":74796,"_30795":74608,"_21329":127695,"_5":14664,"_27997":127195,"_3043":127696},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3587":74797,"_30795":74608,"_21329":127698,"_5":14664,"_27997":127195,"_3043":127699},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3587":74798,"_30795":74608,"_21329":127701,"_5":14664,"_27997":127195,"_3043":127702},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3587":74799,"_30795":74608,"_21329":127704,"_5":14664,"_27997":127195,"_3043":127705},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3587":74800,"_30795":74608,"_21329":127707,"_5":14664,"_27997":127195,"_3043":127708},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3587":74801,"_30795":74608,"_21329":127710,"_5":14664,"_27997":127195,"_3043":127711},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3587":74802,"_30795":74608,"_21329":127713,"_5":14664,"_27997":127195,"_3043":127714},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3587":74803,"_30795":74608,"_21329":127716,"_5":14664,"_27997":127199,"_3043":127717},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3587":74804,"_30795":74608,"_21329":127719,"_5":14664,"_27997":127207,"_3043":127720},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3587":74805,"_30795":74608,"_21329":127722,"_5":14664,"_27997":127207,"_3043":127723},[],"Campo en 3.8.0",{"_3587":74806,"_30795":74608,"_21329":127725,"_5":14664,"_27997":127207,"_3043":127726},[],"Campo en 4.0.0",{"_3587":74807,"_30795":74608,"_21329":127728,"_5":14664,"_27997":127207,"_3043":59376},[],{"_3587":74808,"_30795":74608,"_21329":127730,"_5":14664,"_27997":127207,"_3043":127731},[],"`insecure_skip_verify` (con el valor negado)",{"_3587":74809,"_30795":74608,"_21329":127733,"_5":14664,"_27997":127207,"_3043":59382},[],{"_3587":74810,"_30795":74608,"_21329":127735,"_5":14664,"_27997":127207,"_3043":59385},[],{"_3587":74811,"_30795":74608,"_21329":127737,"_5":14664,"_27997":127207,"_3043":59388},[],{"_3587":74812,"_30795":74608,"_21329":127739,"_5":14664,"_27997":127207,"_3043":59391},[],{"_3587":74813,"_30795":74608,"_21329":127741,"_5":14664,"_27997":127207,"_3043":59394},[],{"_3587":74814,"_30795":74608,"_21329":127743,"_5":14664,"_27997":127207,"_3043":59397},[],{"_3587":74815,"_30795":74608,"_21329":127745,"_5":14664,"_27997":127207,"_3043":127746},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3587":74816,"_30795":74608,"_21329":127748,"_5":14664,"_27997":127207,"_3043":127749},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3587":74817,"_30795":74608,"_21329":127751,"_5":14664,"_27997":127207,"_3043":127752},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3587":74818,"_30795":74608,"_21329":127754,"_5":14664,"_27997":127211,"_3043":127755},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3587":74819,"_30795":74608,"_21329":127757,"_5":14664,"_27997":127211,"_3043":127758},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3587":74820,"_30795":74608,"_21329":127760,"_5":14664,"_27997":127211,"_3043":127761},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3587":74821,"_30795":74608,"_21329":127763,"_5":14664,"_27997":127215,"_3043":127764},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3587":74822,"_30795":74608,"_21329":127766,"_5":14664,"_27997":127219,"_3043":127767},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3587":74823,"_30795":74608,"_21329":127769,"_5":14664,"_27997":127223,"_3043":127770},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3587":74824,"_30795":74608,"_21329":127772,"_5":14664,"_27997":127227,"_3043":127773},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3587":74825,"_30795":74608,"_21329":127775,"_5":14664,"_27997":127227,"_3043":127776},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3587":74826,"_30795":74608,"_21329":127778,"_5":14664,"_27997":127227,"_3043":127779},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3587":74827,"_30795":74608,"_21329":127781,"_5":14664,"_27997":127227,"_3043":127782},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3587":74828,"_30795":74608,"_21329":127784,"_5":14664,"_27997":127231,"_3043":127785},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3587":74829,"_30795":74608,"_21329":127787,"_5":14664,"_27997":127235,"_3043":127788},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3587":74830,"_30795":74608,"_21329":127790,"_5":14664,"_27997":127235,"_3043":127791},[],"Ruta",{"_3587":74831,"_30795":74608,"_21329":127793,"_5":14664,"_27997":127235,"_3043":120196},[],{"_3587":74832,"_30795":74608,"_21329":127795,"_5":14664,"_27997":127235,"_3043":59450},[],{"_3587":74833,"_30795":74608,"_21329":127797,"_5":14664,"_27997":127235,"_3043":127798},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3587":74834,"_30795":74608,"_21329":127800,"_5":14664,"_27997":127235,"_3043":59456},[],{"_3587":74835,"_30795":74608,"_21329":127802,"_5":14664,"_27997":127235,"_3043":127803},[],"Lee los ajustes de una CA.",{"_3587":74836,"_30795":74608,"_21329":127805,"_5":14664,"_27997":127235,"_3043":59462},[],{"_3587":74837,"_30795":74608,"_21329":127807,"_5":14664,"_27997":127235,"_3043":127808},[],"Sustituye los `crl_options`.",{"_3587":74838,"_30795":74608,"_21329":127810,"_5":14664,"_27997":127235,"_3043":59468},[],{"_3587":74839,"_30795":74608,"_21329":127812,"_5":14664,"_27997":127235,"_3043":127813},[],"Elimina los ajustes archivados de una CA.",{"_3587":74840,"_30795":74608,"_21329":127815,"_5":14664,"_27997":127235,"_3043":127816},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3587":74841,"_30795":74608,"_21329":127818,"_5":14664,"_27997":127235,"_3043":127819},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3587":74842,"_30795":74608,"_21329":127821,"_5":14664,"_27997":127235,"_3043":127822},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3587":74843,"_30795":74608,"_21329":127824,"_5":14664,"_27997":127235,"_3043":127825},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3587":74844,"_30795":74608,"_21329":127827,"_5":14664,"_27997":127235,"_3043":127828},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3587":74845,"_30795":74608,"_21329":127830,"_5":14664,"_27997":127235,"_3043":127831},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3587":74846,"_30795":74608,"_21329":127833,"_5":14664,"_27997":127235,"_3043":127834},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3587":74847,"_30795":74608,"_21329":127836,"_5":14664,"_27997":127235,"_3043":127837},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3587":74848,"_30795":74608,"_21329":127839,"_5":14664,"_27997":127235,"_3043":127840},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3587":74849,"_30795":74608,"_21329":127842,"_5":14664,"_27997":127235,"_3043":127843},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3587":74850,"_30795":74608,"_21329":127845,"_5":14664,"_27997":127235,"_3043":127846},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3587":74851,"_30795":74608,"_21329":127848,"_5":14664,"_27997":127239,"_3043":127849},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3587":74852,"_30795":74608,"_21329":127851,"_5":14664,"_27997":127243,"_3043":127852},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3587":74853,"_30795":74608,"_21329":127854,"_5":14664,"_27997":127247,"_3043":127855},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3587":74854,"_30795":74608,"_21329":127857,"_5":14664,"_27997":127251,"_3043":127858},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3587":74855,"_30795":74608,"_21329":127860,"_5":14664,"_27997":127255,"_3043":127861},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3587":74856,"_30795":74608,"_21329":127863,"_5":14664,"_27997":127255,"_3043":127864},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3587":74857,"_30795":74608,"_21329":127866,"_5":14664,"_27997":127255,"_3043":127867},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3587":74858,"_30795":74608,"_21329":127869,"_5":14664,"_27997":127255,"_3043":127870},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3587":74859,"_30795":74608,"_21329":127872,"_5":14664,"_27997":127255,"_3043":127873},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3587":74860,"_30795":74608,"_21329":127875,"_5":14664,"_27997":127255,"_3043":127876},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3587":74861,"_30795":74608,"_21329":127878,"_5":14664,"_27997":127259,"_3043":127879},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3587":74862,"_30795":74608,"_21329":127881,"_5":14664,"_27997":127259,"_3043":127882},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3587":74863,"_30795":74608,"_21329":127884,"_5":14664,"_27997":127259,"_3043":127885},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3587":74864,"_30795":74608,"_21329":127887,"_5":14664,"_27997":127259,"_3043":127888},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3587":74865,"_30795":74608,"_21329":127890,"_5":14664,"_27997":127259,"_3043":127891},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3587":74866,"_30795":74608,"_21329":127893,"_5":14664,"_27997":127263,"_3043":127894},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3587":74867,"_30795":74608,"_21329":127896,"_5":14664,"_27997":127263,"_3043":127897},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3587":74868,"_30795":74608,"_21329":127899,"_5":14664,"_27997":127263,"_3043":127900},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3587":74869,"_30795":74608,"_21329":127902,"_5":14664,"_27997":127263,"_3043":59561},[],{"_3587":74870,"_30795":74608,"_21329":127904,"_5":14664,"_27997":127263,"_3043":127905},[],"Claves de datos obligatorias",{"_3587":74871,"_30795":74608,"_21329":127907,"_5":14664,"_27997":127263,"_3043":127908},[],"Cuándo",{"_3587":74872,"_30795":74608,"_21329":127910,"_5":14664,"_27997":127263,"_3043":127911},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3587":74873,"_30795":74608,"_21329":127913,"_5":14664,"_27997":127263,"_3043":59573},[],{"_3587":74874,"_30795":74608,"_21329":127915,"_5":14664,"_27997":127263,"_3043":127916},[],"Siempre",{"_3587":74875,"_30795":74608,"_21329":127918,"_5":14664,"_27997":127263,"_3043":127919},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3587":74876,"_30795":74608,"_21329":127921,"_5":14664,"_27997":127263,"_3043":59573},[],{"_3587":74877,"_30795":74608,"_21329":127923,"_5":14664,"_27997":127263,"_3043":127916},[],{"_3587":74878,"_30795":74608,"_21329":127925,"_5":14664,"_27997":127263,"_3043":59586},[],{"_3587":74879,"_30795":74608,"_21329":127927,"_5":14664,"_27997":127263,"_3043":59573},[],{"_3587":74880,"_30795":74608,"_21329":127929,"_5":14664,"_27997":127263,"_3043":127930},[],"Solo cuando hay autenticación SMTP",{"_3587":74881,"_30795":74608,"_21329":127932,"_5":14664,"_27997":127263,"_3043":127933},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3587":74882,"_30795":74608,"_21329":127935,"_5":14664,"_27997":127263,"_3043":127936},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3587":74883,"_30795":74608,"_21329":127938,"_5":14664,"_27997":127263,"_3043":127939},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3587":74884,"_30795":74608,"_21329":127941,"_5":14664,"_27997":127263,"_3043":127942},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3587":74885,"_30795":74608,"_21329":127944,"_5":14664,"_27997":127263,"_3043":127945},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3587":74886,"_30795":74608,"_21329":127947,"_5":14664,"_27997":127263,"_3043":127948},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; la conexión usa el Secret de credenciales de PostgreSQL global — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3587":74887,"_30795":74608,"_21329":127950,"_5":14664,"_27997":127263,"_3043":127951},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3587":74888,"_30795":74608,"_21329":127953,"_5":14664,"_27997":127263,"_3043":127954},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3587":74889,"_30795":74608,"_21329":127956,"_5":14664,"_27997":127263,"_3043":127957},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3587":74890,"_30795":74608,"_21329":127959,"_5":14664,"_27997":127263,"_3043":127960},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3587":74891,"_30795":74608,"_21329":127962,"_5":14664,"_27997":127263,"_3043":127963},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3587":74892,"_30795":74608,"_21329":127965,"_5":14664,"_27997":127263,"_3043":127966},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3587":74893,"_30795":74608,"_21329":127968,"_5":14664,"_27997":127263,"_3043":127969},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3587":74894,"_30795":74608,"_21329":127971,"_5":14664,"_27997":127263,"_3043":127972},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3587":74895,"_30795":74608,"_21329":127974,"_5":14664,"_27997":127263,"_3043":127975},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3587":74896,"_30795":74608,"_21329":127977,"_5":14664,"_27997":127267,"_3043":127978},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3587":74897,"_30795":74608,"_21329":127980,"_5":14664,"_27997":127267,"_3043":127981},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3587":74898,"_30795":74608,"_21329":127983,"_5":14664,"_27997":127271,"_3043":127984},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3587":74899,"_30795":74608,"_21329":127986,"_5":14664,"_27997":127271,"_3043":127987},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3587":74900,"_30795":74608,"_21329":127989,"_5":14664,"_27997":127271,"_3043":127990},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3587":74901,"_30795":74608,"_21329":127992,"_5":14664,"_27997":127271,"_3043":127993},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3587":74902,"_30795":74608,"_21329":127995,"_5":14664,"_27997":127271,"_3043":127996},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3587":74903,"_30795":74608,"_21329":127998,"_5":14664,"_27997":127271,"_3043":127999},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3587":74904,"_30795":74608,"_21329":128001,"_5":14664,"_27997":127271,"_3043":128002},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3587":74905,"_30795":74608,"_21329":128004,"_5":14664,"_27997":127271,"_3043":128005},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3587":74906,"_30795":74608,"_21329":128007,"_5":14664,"_27997":127271,"_3043":128008},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3587":74907,"_30795":74608,"_21329":128010,"_5":14664,"_27997":127271,"_3043":128011},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3587":74908,"_30795":74608,"_21329":128013,"_5":14664,"_27997":127271,"_3043":128014},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3587":74909,"_30795":74608,"_21329":128016,"_5":14664,"_27997":127275,"_3043":128017},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3587":74910,"_30795":74608,"_21329":128019,"_5":14664,"_27997":127275,"_3043":128020},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3587":74911,"_30795":74608,"_21329":128022,"_5":14664,"_27997":127279,"_3043":128023},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3587":74912,"_30795":74608,"_21329":128025,"_5":14664,"_27997":127279,"_3043":128026},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3587":74913,"_30795":74608,"_21329":128028,"_5":14664,"_27997":127279,"_3043":128029},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3587":74914,"_30795":74608,"_21329":128031,"_5":14664,"_27997":127279,"_3043":128032},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3587":74915,"_30795":74608,"_21329":128034,"_5":14664,"_27997":127279,"_3043":128035},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3587":74916,"_30795":74608,"_21329":128037,"_5":14664,"_27997":127279,"_3043":128038},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3587":74917,"_30795":74608,"_21329":128040,"_5":14664,"_27997":127279,"_3043":128041},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3587":74918,"_30795":74608,"_21329":128043,"_5":14664,"_27997":127279,"_3043":128044},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3587":74919,"_30795":74608,"_21329":128046,"_5":14664,"_27997":127283,"_3043":128047},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3587":74920,"_30795":74608,"_21329":128049,"_5":14664,"_27997":127283,"_3043":128050},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3587":74921,"_30795":74608,"_21329":128052,"_5":14664,"_27997":127283,"_3043":128053},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3587":74922,"_30795":74608,"_21329":128055,"_5":14664,"_27997":127283,"_3043":128056},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3587":74923,"_30795":74608,"_21329":128058,"_5":14664,"_27997":127283,"_3043":128059},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3587":74924,"_30795":74608,"_21329":128061,"_5":14664,"_27997":127283,"_3043":128062},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3587":74925,"_30795":74608,"_21329":128064,"_5":14664,"_27997":127283,"_3043":128065},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3587":74926,"_30795":74608,"_21329":128067,"_5":14664,"_27997":127283,"_3043":128068},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3587":74927,"_30795":74608,"_21329":128070,"_5":14664,"_27997":127283,"_3043":128071},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3587":74928,"_30795":74608,"_21329":128073,"_5":14664,"_27997":127283,"_3043":128074},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3587":74929,"_30795":74608,"_21329":128076,"_5":14664,"_27997":127283,"_3043":128077},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3587":74930,"_30795":74608,"_21329":128079,"_5":14664,"_27997":127286,"_3043":128080},[],"Tras la actualización, comprueba en este orden:",{"_3587":74931,"_30795":74608,"_21329":128082,"_5":14664,"_27997":127286,"_3043":128083},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3587":74932,"_30795":74608,"_21329":128085,"_5":14664,"_27997":127286,"_3043":128086},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3587":74933,"_30795":74608,"_21329":128088,"_5":14664,"_27997":127286,"_3043":128089},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3587":74934,"_30795":74608,"_21329":128091,"_5":14664,"_27997":127286,"_3043":128092},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3587":74935,"_30795":74608,"_21329":128094,"_5":14664,"_27997":127286,"_3043":128095},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3587":74936,"_30795":74608,"_21329":128097,"_5":14664,"_27997":127286,"_3043":128098},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3587":74937,"_30795":74608,"_21329":128100,"_5":14664,"_27997":127286,"_3043":128101},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3587":74938,"_30795":74608,"_21329":128103,"_5":14664,"_27997":127286,"_3043":128104},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3587":74939,"_30795":74608,"_21329":128106,"_5":14664,"_27997":127286,"_3043":128107},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3587":74940,"_30795":74608,"_21329":128109,"_5":14664,"_27997":127286,"_3043":128110},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3587":74941,"_30795":74608,"_21329":128112,"_5":14664,"_27997":127286,"_3043":128113},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3587":74942,"_30795":74608,"_21329":128115,"_5":14664,"_27997":127286,"_3043":128116},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3587":74943,"_30795":74608,"_21329":128118,"_5":14664,"_27997":127286,"_3043":128119},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3587":74944,"_30795":74608,"_21329":128121,"_5":14664,"_27997":127286,"_3043":128122},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3587":74945,"_30795":74608,"_21329":128124,"_5":14664,"_27997":127286,"_3043":128125},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3587":74946,"_30795":74608,"_21329":128127,"_5":14664,"_27997":127290,"_3043":128128},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3587":74947,"_30795":74608,"_21329":128130,"_5":14664,"_27997":127290,"_3043":128131},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3587":74948,"_30795":74608,"_21329":128133,"_5":14664,"_27997":127290,"_3043":128134},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3587":74949,"_30795":74608,"_21329":128136,"_5":14664,"_27997":127290,"_3043":128137},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3587":74950,"_30795":74608,"_21329":128139,"_5":14664,"_27997":127290,"_3043":128140},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_59804":128142,"_59806":128143,"_59808":128144,"_59810":128145,"_18469":3078,"_71921":3078},"spanish",[3043,30795,5,27997],{"_3043":25471,"_30795":25471,"_5":25471,"_27997":25471},{"_3043":128146,"_30795":131172,"_5":134198,"_27997":137224},{"_4781":128147,"_59814":128148,"_5":25471},{"_14740":3353,"_15123":5276,"_15142":6124,"_29799":7407,"_15129":4170,"_20241":4278,"_14761":5310,"_14768":7172,"_29741":12008,"_30150":18331,"_30171":18339,"_29775":7233,"_35189":5106,"_29878":20727,"_30215":10114,"_35196":5393,"_35199":4104,"_35202":6467,"_35205":3333,"_30617":7810,"_35210":11586,"_35212":3926,"_30652":13652,"_15138":30811,"_35216":7715,"_35219":17549,"_35221":7201,"_30199":5205,"_30637":3477,"_30665":4343,"_35226":7202,"_35228":17862,"_35230":7200,"_29895":10705,"_35233":5305,"_35235":4107,"_35237":7689,"_35239":12571,"_35241":3446,"_29812":6185,"_35244":3403,"_35246":5994,"_29806":6794,"_30236":10650,"_35250":27589,"_35252":14454,"_35255":5111,"_29852":6479,"_35259":8396,"_29732":4736,"_35262":3803,"_29780":4060,"_35265":10606,"_35267":7171,"_35270":6144,"_15132":3521,"_35273":6116,"_35275":7883,"_35278":7196,"_35280":3523,"_35282":3493,"_35284":13182,"_35286":7225,"_20244":6153,"_35289":7485,"_35291":3797,"_29753":6684,"_30193":6154,"_35295":11912,"_30860":4274,"_35298":5446,"_30682":3535,"_35301":3815,"_35303":7121,"_35305":4583,"_30775":14702,"_30252":10108,"_35309":16859,"_35311":7152,"_29790":7701,"_35314":4850,"_35316":10848,"_35318":6481,"_30698":5232,"_29872":12638,"_29257":17352,"_35323":4856,"_35325":26563,"_35327":4920,"_29921":12144,"_35331":6539,"_30187":24197,"_35335":5682,"_35337":6527,"_35339":7814,"_35341":5452,"_35343":3400,"_35345":7629,"_29910":10911,"_30155":3329,"_35349":3319,"_35351":5208,"_35353":8768,"_35356":7845,"_35358":7708,"_35360":9290,"_35362":3292,"_35364":7137,"_35366":9054,"_35368":4333,"_35371":4892,"_35373":18471,"_35375":5708,"_35377":3361,"_35379":4373,"_35382":6004,"_35384":24090,"_35387":7618,"_35390":4366,"_35392":25028,"_35394":6490,"_35396":8149,"_35398":5079,"_35400":50371,"_35402":10115,"_35404":7104,"_35406":18501,"_30198":23203,"_35409":5166,"_35411":5298,"_35413":16356,"_35415":4837,"_35417":3958,"_35419":5573,"_35421":4090,"_35423":3507,"_35425":6343,"_35427":5969,"_35429":10720,"_35431":5723,"_35433":7336,"_35435":4150,"_35437":10356,"_354