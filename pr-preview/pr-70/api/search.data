1170":59709,"_41172":59712,"_41174":59715,"_41176":59718,"_41178":59721,"_41180":59724,"_41182":59727,"_41184":59730,"_41186":59733,"_41188":59736,"_41190":59739,"_41192":59742,"_41194":59745,"_41196":59748,"_41198":59751,"_41200":59754,"_41202":59757,"_41204":59760,"_41206":59763,"_41208":59766,"_41210":59769,"_41212":59772,"_41214":59775,"_41216":59778,"_41218":59781,"_41220":59784,"_41222":59787,"_41225":59790,"_41227":59793,"_41229":59796,"_41231":59799},{"_3587":15,"_30795":15,"_5":15024,"_3043":50379,"_31154":50380,"_21329":50384,"_27997":15},"Deploy from AWS Marketplace",[50381,50382,50383],"Docs","Deployment","Other models",[],{"_3587":16,"_30795":15,"_21329":50386,"_5":14664,"_27997":15,"_3043":50387},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3587":17,"_30795":15,"_5":31151,"_21329":50389,"_27997":50390,"_3043":50391},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3587":18,"_30795":15,"_5":31151,"_21329":50393,"_27997":50394,"_3043":50395},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3587":19,"_30795":15,"_5":31151,"_21329":50397,"_27997":50398,"_3043":50399},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3587":20,"_30795":15,"_5":31151,"_21329":50401,"_27997":50402,"_3043":50403},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3587":21,"_30795":15,"_5":31151,"_21329":50405,"_27997":50406,"_3043":50407},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3587":22,"_30795":15,"_5":31151,"_21329":50409,"_27997":50410,"_3043":50411},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3587":23,"_30795":15,"_5":31151,"_21329":50413,"_27997":50414,"_3043":50415},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#next-step","Next step",{"_3587":24,"_30795":15,"_21329":50417,"_5":14664,"_27997":15,"_3043":50418},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3587":25,"_30795":15,"_21329":50420,"_5":14664,"_27997":50390,"_3043":50421},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3587":26,"_30795":15,"_21329":50423,"_5":14664,"_27997":50390,"_3043":50424},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3587":27,"_30795":15,"_21329":50426,"_5":14664,"_27997":50390,"_3043":50427},[],"A security group allowing the necessary endpoints.",{"_3587":28,"_30795":15,"_21329":50429,"_5":14664,"_27997":50394,"_3043":50430},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3587":29,"_30795":15,"_21329":50432,"_5":14664,"_27997":50394,"_3043":50433},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3587":30,"_30795":15,"_21329":50435,"_5":14664,"_27997":50394,"_3043":50436},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3587":31,"_30795":15,"_21329":50438,"_5":14664,"_27997":50398,"_3043":50439},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3587":32,"_30795":15,"_21329":50441,"_5":14664,"_27997":50402,"_3043":50442},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3587":33,"_30795":15,"_21329":50444,"_5":14664,"_27997":50406,"_3043":50445},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3587":34,"_30795":15,"_21329":50447,"_5":14664,"_27997":50410,"_3043":50448},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3587":35,"_30795":15,"_21329":50450,"_5":14664,"_27997":50414,"_3043":50451},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3587":36,"_30795":36,"_5":15024,"_3043":50453,"_31154":50454,"_21329":50455,"_27997":36},"Deploy Lamassu",[50381,50382],[],{"_3587":37,"_30795":36,"_21329":50457,"_5":14664,"_27997":36,"_3043":50458},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3587":38,"_30795":36,"_5":31151,"_21329":50460,"_27997":50461,"_3043":50462},[],"/docs/pr-preview/pr-70/deployment/overview#choose-a-model","Choose a model",{"_3587":39,"_30795":36,"_5":31151,"_21329":50464,"_27997":50465,"_3043":50466},[],"/docs/pr-preview/pr-70/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3587":40,"_30795":36,"_5":31151,"_21329":50468,"_27997":50469,"_3043":50470},[],"/docs/pr-preview/pr-70/deployment/overview#after-deployment","After deployment",{"_3587":41,"_30795":36,"_21329":50472,"_5":14664,"_27997":36,"_3043":50473},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3587":42,"_30795":36,"_21329":50475,"_5":14664,"_27997":50461,"_3043":50476},[],"Model",{"_3587":43,"_30795":36,"_21329":50478,"_5":14664,"_27997":50461,"_3043":50479},[],"Recommended for",{"_3587":44,"_30795":36,"_21329":50481,"_5":14664,"_27997":50461,"_3043":50482},[],"Who operates the infrastructure",{"_3587":45,"_30795":36,"_21329":50484,"_5":14664,"_27997":50461,"_3043":50485},[],"Starting point",{"_3587":46,"_30795":36,"_21329":50487,"_5":14664,"_27997":50461,"_3043":50488},[],"Kubernetes self-managed",{"_3587":47,"_30795":36,"_21329":50490,"_5":14664,"_27997":50461,"_3043":50491},[],"Production, regulated environments and custom deployments",{"_3587":48,"_30795":36,"_21329":50493,"_5":14664,"_27997":50461,"_3043":50494},[],"Your team",{"_3587":49,"_30795":36,"_21329":50496,"_5":14664,"_27997":50461,"_3043":50497},[],"Helm or Fastlane",{"_3587":50,"_30795":36,"_21329":50499,"_5":14664,"_27997":50461,"_3043":50500},[],"AWS Marketplace",{"_3587":51,"_30795":36,"_21329":50502,"_5":14664,"_27997":50461,"_3043":50503},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3587":52,"_30795":36,"_21329":50505,"_5":14664,"_27997":50461,"_3043":50494},[],{"_3587":53,"_30795":36,"_21329":50507,"_5":14664,"_27997":50461,"_3043":50508},[],"Preconfigured image on EC2",{"_3587":54,"_30795":36,"_21329":50510,"_5":14664,"_27997":50461,"_3043":50511},[],"SaaS",{"_3587":55,"_30795":36,"_21329":50513,"_5":14664,"_27997":50461,"_3043":50514},[],"Teams that want to use the platform without operating it",{"_3587":56,"_30795":36,"_21329":50516,"_5":14664,"_27997":50461,"_3043":50517},[],"Lamassu",{"_3587":57,"_30795":36,"_21329":50519,"_5":14664,"_27997":50461,"_3043":50520},[],"Managed subscription",{"_3587":58,"_30795":36,"_21329":50522,"_5":14664,"_27997":50461,"_3043":50523},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3587":59,"_30795":36,"_21329":50525,"_5":14664,"_27997":50461,"_3043":50526},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3587":60,"_30795":36,"_21329":50528,"_5":14664,"_27997":50461,"_3043":50529},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3587":61,"_30795":36,"_21329":50531,"_5":14664,"_27997":50465,"_3043":50532},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3587":62,"_30795":36,"_21329":50534,"_5":14664,"_27997":50469,"_3043":50535},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3587":63,"_30795":63,"_5":15024,"_3043":50537,"_31154":50538,"_21329":50539,"_27997":63},"Use Lamassu as SaaS",[50381,50382,50383],[],{"_3587":64,"_30795":63,"_21329":50541,"_5":14664,"_27997":63,"_3043":50542},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3587":65,"_30795":63,"_5":31151,"_21329":50544,"_27997":50545,"_3043":50546},[],"/docs/pr-preview/pr-70/deployment/saas#what-the-service-manages","What the service manages",{"_3587":66,"_30795":63,"_5":31151,"_21329":50548,"_27997":50549,"_3043":50550},[],"/docs/pr-preview/pr-70/deployment/saas#plans","Plans",{"_3587":67,"_30795":63,"_5":31151,"_21329":50552,"_27997":50553,"_3043":50554},[],"/docs/pr-preview/pr-70/deployment/saas#request-access","Request access",{"_3587":68,"_30795":63,"_21329":50556,"_5":14664,"_27997":63,"_3043":50557},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3587":69,"_30795":63,"_21329":50559,"_5":14664,"_27997":50545,"_3043":50560},[],"Platform availability and maintenance.",{"_3587":70,"_30795":63,"_21329":50562,"_5":14664,"_27997":50545,"_3043":50563},[],"Automatic backups.",{"_3587":71,"_30795":63,"_21329":50565,"_5":14664,"_27997":50545,"_3043":50566},[],"Version upgrades.",{"_3587":72,"_30795":63,"_21329":50568,"_5":14664,"_27997":50545,"_3043":50569},[],"Technical support and SLA according to your plan.",{"_3587":73,"_30795":63,"_21329":50571,"_5":14664,"_27997":50549,"_3043":50572},[],"Plan",{"_3587":74,"_30795":63,"_21329":50574,"_5":14664,"_27997":50549,"_3043":50575},[],"Devices",{"_3587":75,"_30795":63,"_21329":50577,"_5":14664,"_27997":50549,"_3043":50578},[],"Support",{"_3587":76,"_30795":63,"_21329":50580,"_5":14664,"_27997":50549,"_3043":50581},[],"SLA",{"_3587":77,"_30795":63,"_21329":50583,"_5":14664,"_27997":50549,"_3043":50584},[],"Starter",{"_3587":78,"_30795":63,"_21329":50586,"_5":14664,"_27997":50549,"_3043":50587},[],"Up to 1,000",{"_3587":79,"_30795":63,"_21329":50589,"_5":14664,"_27997":50549,"_3043":50590},[],"Email",{"_3587":80,"_30795":63,"_21329":50592,"_5":14664,"_27997":50549,"_3043":50593},[],"99.5 %",{"_3587":81,"_30795":63,"_21329":50595,"_5":14664,"_27997":50549,"_3043":50596},[],"Professional",{"_3587":82,"_30795":63,"_21329":50598,"_5":14664,"_27997":50549,"_3043":50599},[],"Up to 10,000",{"_3587":83,"_30795":63,"_21329":50601,"_5":14664,"_27997":50549,"_3043":50602},[],"Email and chat",{"_3587":84,"_30795":63,"_21329":50604,"_5":14664,"_27997":50549,"_3043":50605},[],"99.9 %",{"_3587":85,"_30795":63,"_21329":50607,"_5":14664,"_27997":50549,"_3043":50608},[],"Enterprise",{"_3587":86,"_30795":63,"_21329":50610,"_5":14664,"_27997":50549,"_3043":50611},[],"Unlimited",{"_3587":87,"_30795":63,"_21329":50613,"_5":14664,"_27997":50549,"_3043":50614},[],"Dedicated",{"_3587":88,"_30795":63,"_21329":50616,"_5":14664,"_27997":50549,"_3043":50617},[],"99.99 %",{"_3587":89,"_30795":63,"_21329":50619,"_5":14664,"_27997":50553,"_3043":50620},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3587":90,"_30795":63,"_21329":50622,"_5":14664,"_27997":50553,"_3043":50623},[],"When you receive your instance's credentials, continue with Get started.",{"_3587":91,"_30795":91,"_5":15024,"_3043":50625,"_31154":50626,"_21329":50627,"_27997":91},"Fastlane",[50381,50382,50488],[],{"_3587":92,"_30795":91,"_21329":50629,"_5":14664,"_27997":91,"_3043":50630},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3587":93,"_30795":91,"_5":31151,"_21329":50632,"_27997":50633,"_3043":50634},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3587":94,"_30795":91,"_5":31151,"_21329":50636,"_27997":50637,"_3043":50638},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3587":95,"_30795":91,"_5":31151,"_21329":50640,"_27997":50641,"_3043":50391},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#before-you-begin",{"_3587":96,"_30795":91,"_5":31151,"_21329":50643,"_27997":50644,"_3043":50645},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3587":97,"_30795":91,"_5":31151,"_21329":50647,"_27997":50648,"_3043":50649},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3587":98,"_30795":91,"_5":31151,"_21329":50651,"_27997":50652,"_3043":50653},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3587":99,"_30795":91,"_5":31151,"_21329":50655,"_27997":50656,"_3043":50657},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3587":100,"_30795":91,"_5":31151,"_21329":50659,"_27997":50660,"_3043":50661},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3587":101,"_30795":91,"_5":31151,"_21329":50663,"_27997":50664,"_3043":50665},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3587":102,"_30795":91,"_5":31151,"_21329":50667,"_27997":50668,"_3043":50669},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3587":103,"_30795":91,"_5":31151,"_21329":50671,"_27997":50672,"_3043":50673},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3587":104,"_30795":91,"_21329":50675,"_5":14664,"_27997":50633,"_3043":50676},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3587":105,"_30795":91,"_21329":50678,"_5":14664,"_27997":50633,"_3043":50679},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3587":106,"_30795":91,"_21329":50681,"_5":14664,"_27997":50637,"_3043":50682},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3587":107,"_30795":91,"_21329":50684,"_5":14664,"_27997":50637,"_3043":50685},[],"Fastlane installs or configures",{"_3587":108,"_30795":91,"_21329":50687,"_5":14664,"_27997":50637,"_3043":50688},[],"You still provide",{"_3587":109,"_30795":91,"_21329":50690,"_5":14664,"_27997":50637,"_3043":50691},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3587":110,"_30795":91,"_21329":50693,"_5":14664,"_27997":50637,"_3043":50694},[],"The Kubernetes cluster, nodes and persistent storage",{"_3587":111,"_30795":91,"_21329":50696,"_5":14664,"_27997":50637,"_3043":50697},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3587":112,"_30795":91,"_21329":50699,"_5":14664,"_27997":50637,"_3043":50700},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3587":113,"_30795":91,"_21329":50702,"_5":14664,"_27997":50637,"_3043":50703},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3587":114,"_30795":91,"_21329":50705,"_5":14664,"_27997":50637,"_3043":50706},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3587":115,"_30795":91,"_21329":50708,"_5":14664,"_27997":50637,"_3043":50709},[],"Optional observability and lab HSM components",{"_3587":116,"_30795":91,"_21329":50711,"_5":14664,"_27997":50637,"_3043":50712},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3587":117,"_30795":91,"_21329":50714,"_5":14664,"_27997":50637,"_3043":50715},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3587":118,"_30795":91,"_21329":50717,"_5":14664,"_27997":50641,"_3043":50718},[],"You need:",{"_3587":119,"_30795":91,"_21329":50720,"_5":14664,"_27997":50641,"_3043":50721},[],"an existing Kubernetes cluster",{"_3587":120,"_30795":91,"_21329":50723,"_5":14664,"_27997":50641,"_3043":50724},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3587":121,"_30795":91,"_21329":50726,"_5":14664,"_27997":50641,"_3043":50727},[],"`yq`",{"_3587":122,"_30795":91,"_21329":50729,"_5":14664,"_27997":50641,"_3043":24104},[],{"_3587":123,"_30795":91,"_21329":50731,"_5":14664,"_27997":50641,"_3043":50732},[],"`jq` only when using `--sample-data` or `--development`",{"_3587":124,"_30795":91,"_21329":50734,"_5":14664,"_27997":50641,"_3043":50735},[],"`ssh-keygen` only when using `--with-hsm`",{"_3587":125,"_30795":91,"_21329":50737,"_5":14664,"_27997":50641,"_3043":50738},[],"free external ports 80 and 443 on a single-node K3s host",{"_3587":126,"_30795":91,"_21329":50740,"_5":14664,"_27997":50641,"_3043":50741},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3587":127,"_30795":91,"_21329":50743,"_5":14664,"_27997":50641,"_3043":50744},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3587":128,"_30795":91,"_21329":50746,"_5":14664,"_27997":50644,"_3043":50747},[],"Run the script from a clone of the Helm repository:",{"_3587":129,"_30795":91,"_21329":50749,"_5":14664,"_27997":50644,"_3043":50750},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3587":130,"_30795":91,"_21329":50752,"_5":14664,"_27997":50648,"_3043":50753},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3587":131,"_30795":91,"_21329":50755,"_5":14664,"_27997":50648,"_3043":50756},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3587":132,"_30795":91,"_21329":50758,"_5":14664,"_27997":50648,"_3043":50759},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3587":133,"_30795":91,"_21329":50761,"_5":14664,"_27997":50648,"_3043":50762},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3587":134,"_30795":91,"_21329":50764,"_5":14664,"_27997":50652,"_3043":50765},[],"Option",{"_3587":135,"_30795":91,"_21329":50767,"_5":14664,"_27997":50652,"_3043":50768},[],"Default",{"_3587":136,"_30795":91,"_21329":50770,"_5":14664,"_27997":50652,"_3043":50771},[],"Purpose",{"_3587":137,"_30795":91,"_21329":50773,"_5":14664,"_27997":50652,"_3043":50774},[],"`-h`, `--help`",{"_3587":138,"_30795":91,"_21329":50776,"_5":14664,"_27997":50652,"_3043":50777},[],"—",{"_3587":139,"_30795":91,"_21329":50779,"_5":14664,"_27997":50652,"_3043":50780},[],"Show help",{"_3587":140,"_30795":91,"_21329":50782,"_5":14664,"_27997":50652,"_3043":50783},[],"`-c`, `--context`",{"_3587":141,"_30795":91,"_21329":50785,"_5":14664,"_27997":50652,"_3043":50786},[],"current context",{"_3587":142,"_30795":91,"_21329":50788,"_5":14664,"_27997":50652,"_3043":50789},[],"Select the kubeconfig context for kubectl and Helm",{"_3587":143,"_30795":91,"_21329":50791,"_5":14664,"_27997":50652,"_3043":50792},[],"`-n`, `--non-interactive`",{"_3587":144,"_30795":91,"_21329":50794,"_5":14664,"_27997":50652,"_3043":6728},[],{"_3587":145,"_30795":91,"_21329":50796,"_5":14664,"_27997":50652,"_3043":50797},[],"Skip prompts and generate dependency credentials",{"_3587":146,"_30795":91,"_21329":50799,"_5":14664,"_27997":50652,"_3043":50800},[],"`-ns`, `--namespace`",{"_3587":147,"_30795":91,"_21329":50802,"_5":14664,"_27997":50652,"_3043":50803},[],"`lamassu-dev`",{"_3587":148,"_30795":91,"_21329":50805,"_5":14664,"_27997":50652,"_3043":50806},[],"Namespace for the installation",{"_3587":149,"_30795":91,"_21329":50808,"_5":14664,"_27997":50652,"_3043":50809},[],"`-d`, `--domain`",{"_3587":150,"_30795":91,"_21329":50811,"_5":14664,"_27997":50652,"_3043":50812},[],"`dev.lamassu.io`",{"_3587":151,"_30795":91,"_21329":50814,"_5":14664,"_27997":50652,"_3043":50815},[],"Domain used by the UI, OIDC and certificate",{"_3587":152,"_30795":91,"_21329":50817,"_5":14664,"_27997":50652,"_3043":50818},[],"`-v`, `--version`",{"_3587":153,"_30795":91,"_21329":50820,"_5":14664,"_27997":50652,"_3043":15374},[],{"_3587":154,"_30795":91,"_21329":50822,"_5":14664,"_27997":50652,"_3043":50823},[],"Lamassu chart version",{"_3587":155,"_30795":91,"_21329":50825,"_5":14664,"_27997":50652,"_3043":50826},[],"`--https-port`",{"_3587":156,"_30795":91,"_21329":50828,"_5":14664,"_27997":50652,"_3043":50829},[],"`443`",{"_3587":157,"_30795":91,"_21329":50831,"_5":14664,"_27997":50652,"_3043":50832},[],"Gateway HTTPS listener port",{"_3587":158,"_30795":91,"_21329":50834,"_5":14664,"_27997":50652,"_3043":50835},[],"`--http-port`",{"_3587":159,"_30795":91,"_21329":50837,"_5":14664,"_27997":50652,"_3043":50838},[],"`80`",{"_3587":160,"_30795":91,"_21329":50840,"_5":14664,"_27997":50652,"_3043":50841},[],"Gateway HTTP listener port",{"_3587":161,"_30795":91,"_21329":50843,"_5":14664,"_27997":50652,"_3043":50844},[],"`--tls-crt`",{"_3587":162,"_30795":91,"_21329":50846,"_5":14664,"_27997":50652,"_3043":50777},[],{"_3587":163,"_30795":91,"_21329":50848,"_5":14664,"_27997":50652,"_3043":50849},[],"PEM certificate for downstream TLS",{"_3587":164,"_30795":91,"_21329":50851,"_5":14664,"_27997":50652,"_3043":50852},[],"`--tls-key`",{"_3587":165,"_30795":91,"_21329":50854,"_5":14664,"_27997":50652,"_3043":50777},[],{"_3587":166,"_30795":91,"_21329":50856,"_5":14664,"_27997":50652,"_3043":50857},[],"PEM private key for downstream TLS",{"_3587":167,"_30795":91,"_21329":50859,"_5":14664,"_27997":50652,"_3043":50860},[],"`-l`, `--local-chart-path`",{"_3587":168,"_30795":91,"_21329":50862,"_5":14664,"_27997":50652,"_3043":50863},[],"repository chart",{"_3587":169,"_30795":91,"_21329":50865,"_5":14664,"_27997":50652,"_3043":50866},[],"Use an unpacked local Lamassu chart",{"_3587":170,"_30795":91,"_21329":50868,"_5":14664,"_27997":50652,"_3043":50869},[],"`-ip`, `--gateway-ip`",{"_3587":171,"_30795":91,"_21329":50871,"_5":14664,"_27997":50652,"_3043":8975},[],{"_3587":172,"_30795":91,"_21329":50873,"_5":14664,"_27997":50652,"_3043":50874},[],"Override the address written to `gateway.addresses`",{"_3587":173,"_30795":91,"_21329":50876,"_5":14664,"_27997":50652,"_3043":50877},[],"`--otel`",{"_3587":174,"_30795":91,"_21329":50879,"_5":14664,"_27997":50652,"_3043":6728},[],{"_3587":175,"_30795":91,"_21329":50881,"_5":14664,"_27997":50652,"_3043":50882},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3587":176,"_30795":91,"_21329":50884,"_5":14664,"_27997":50652,"_3043":50885},[],"`--development`",{"_3587":177,"_30795":91,"_21329":50887,"_5":14664,"_27997":50652,"_3043":6728},[],{"_3587":178,"_30795":91,"_21329":50889,"_5":14664,"_27997":50652,"_3043":50890},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3587":179,"_30795":91,"_21329":50892,"_5":14664,"_27997":50652,"_3043":50893},[],"`--sample-data`",{"_3587":180,"_30795":91,"_21329":50895,"_5":14664,"_27997":50652,"_3043":6728},[],{"_3587":181,"_30795":91,"_21329":50897,"_5":14664,"_27997":50652,"_3043":50898},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3587":182,"_30795":91,"_21329":50900,"_5":14664,"_27997":50652,"_3043":50901},[],"`--with-hsm`",{"_3587":183,"_30795":91,"_21329":50903,"_5":14664,"_27997":50652,"_3043":6728},[],{"_3587":184,"_30795":91,"_21329":50905,"_5":14664,"_27997":50652,"_3043":50906},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3587":185,"_30795":91,"_21329":50908,"_5":14664,"_27997":50652,"_3043":50909},[],"`--softhsm-chart-path`",{"_3587":186,"_30795":91,"_21329":50911,"_5":14664,"_27997":50652,"_3043":50912},[],"`./charts/softhsm`",{"_3587":187,"_30795":91,"_21329":50914,"_5":14664,"_27997":50652,"_3043":50915},[],"Use a different local SoftHSM chart",{"_3587":188,"_30795":91,"_21329":50917,"_5":14664,"_27997":50652,"_3043":50918},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3587":189,"_30795":91,"_21329":50920,"_5":14664,"_27997":50656,"_3043":50921},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3587":190,"_30795":91,"_21329":50923,"_5":14664,"_27997":50656,"_3043":50924},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3587":191,"_30795":91,"_21329":50926,"_5":14664,"_27997":50656,"_3043":50927},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3587":192,"_30795":91,"_21329":50929,"_5":14664,"_27997":50656,"_3043":50930},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3587":193,"_30795":91,"_21329":50932,"_5":14664,"_27997":50656,"_3043":50933},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3587":194,"_30795":91,"_21329":50935,"_5":14664,"_27997":50656,"_3043":50936},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3587":195,"_30795":91,"_21329":50938,"_5":14664,"_27997":50660,"_3043":50939},[],"Fastlane:",{"_3587":196,"_30795":91,"_21329":50941,"_5":14664,"_27997":50660,"_3043":50942},[],"validates local tools and the selected cluster",{"_3587":197,"_30795":91,"_21329":50944,"_5":14664,"_27997":50660,"_3043":50945},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3587":198,"_30795":91,"_21329":50947,"_5":14664,"_27997":50660,"_3043":50948},[],"creates the namespace",{"_3587":199,"_30795":91,"_21329":50950,"_5":14664,"_27997":50660,"_3043":50951},[],"installs PostgreSQL and creates the required databases",{"_3587":200,"_30795":91,"_21329":50953,"_5":14664,"_27997":50660,"_3043":50954},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3587":201,"_30795":91,"_21329":50956,"_5":14664,"_27997":50660,"_3043":50957},[],"installs RabbitMQ",{"_3587":202,"_30795":91,"_21329":50959,"_5":14664,"_27997":50660,"_3043":50960},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3587":203,"_30795":91,"_21329":50962,"_5":14664,"_27997":50660,"_3043":50963},[],"optionally installs observability and lab HSM components",{"_3587":204,"_30795":91,"_21329":50965,"_5":14664,"_27997":50660,"_3043":50966},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3587":205,"_30795":91,"_21329":50968,"_5":14664,"_27997":50660,"_3043":50969},[],"optionally loads sample data",{"_3587":206,"_30795":91,"_21329":50971,"_5":14664,"_27997":50660,"_3043":50972},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3587":207,"_30795":91,"_21329":50974,"_5":14664,"_27997":50664,"_3043":50975},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3587":208,"_30795":91,"_21329":50977,"_5":14664,"_27997":50664,"_3043":50978},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3587":209,"_30795":91,"_21329":50980,"_5":14664,"_27997":50668,"_3043":50981},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3587":210,"_30795":91,"_21329":50983,"_5":14664,"_27997":50668,"_3043":50984},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3587":211,"_30795":91,"_21329":50986,"_5":14664,"_27997":50668,"_3043":50987},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3587":212,"_30795":91,"_21329":50989,"_5":14664,"_27997":50668,"_3043":50990},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3587":213,"_30795":91,"_21329":50992,"_5":14664,"_27997":50672,"_3043":50993},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3587":214,"_30795":214,"_5":15024,"_3043":50995,"_31154":50996,"_21329":50997,"_27997":214},"Install with Helm",[50381,50382,50488],[],{"_3587":215,"_30795":214,"_21329":50999,"_5":14664,"_27997":214,"_3043":51000},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3587":216,"_30795":214,"_5":31151,"_21329":51002,"_27997":51003,"_3043":51004},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3587":217,"_30795":214,"_5":31151,"_21329":51006,"_27997":51007,"_3043":50391},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#before-you-begin",{"_3587":218,"_30795":214,"_5":31151,"_21329":51009,"_27997":51010,"_3043":51011},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3587":219,"_30795":214,"_5":31151,"_21329":51013,"_27997":51014,"_3043":51015},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3587":220,"_30795":214,"_5":31151,"_21329":51017,"_27997":51018,"_3043":51019},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3587":221,"_30795":214,"_5":31151,"_21329":51021,"_27997":51022,"_3043":51023},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3587":222,"_30795":214,"_5":31151,"_21329":51025,"_27997":51026,"_3043":51027},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3587":223,"_30795":214,"_5":31151,"_21329":51029,"_27997":51030,"_3043":51031},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3587":224,"_30795":214,"_5":31151,"_21329":51033,"_27997":51034,"_3043":51035},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3587":225,"_30795":214,"_5":31151,"_21329":51037,"_27997":51038,"_3043":51039},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3587":226,"_30795":214,"_5":31151,"_21329":51041,"_27997":51042,"_3043":51043},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3587":227,"_30795":214,"_5":31151,"_21329":51045,"_27997":51046,"_3043":51047},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3587":228,"_30795":214,"_21329":51049,"_5":14664,"_27997":51003,"_3043":51050},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3587":229,"_30795":214,"_21329":51052,"_5":14664,"_27997":51007,"_3043":51053},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3587":230,"_30795":214,"_21329":51055,"_5":14664,"_27997":51007,"_3043":51056},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3587":231,"_30795":214,"_21329":51058,"_5":14664,"_27997":51007,"_3043":51059},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3587":232,"_30795":214,"_21329":51061,"_5":14664,"_27997":51007,"_3043":51062},[],"a reachable RabbitMQ broker and credentials",{"_3587":233,"_30795":214,"_21329":51064,"_5":14664,"_27997":51007,"_3043":51065},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3587":234,"_30795":214,"_21329":51067,"_5":14664,"_27997":51007,"_3043":51068},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3587":235,"_30795":214,"_21329":51070,"_5":14664,"_27997":51007,"_3043":51071},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3587":236,"_30795":214,"_21329":51073,"_5":14664,"_27997":51007,"_3043":51074},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3587":237,"_30795":214,"_21329":51076,"_5":14664,"_27997":51007,"_3043":51077},[],"a StorageClass and an external traffic design",{"_3587":238,"_30795":214,"_21329":51079,"_5":14664,"_27997":51007,"_3043":51080},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3587":239,"_30795":214,"_21329":51082,"_5":14664,"_27997":51007,"_3043":51083},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3587":240,"_30795":214,"_21329":51085,"_5":14664,"_27997":51007,"_3043":51086},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3587":241,"_30795":214,"_21329":51088,"_5":14664,"_27997":51010,"_3043":51089},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3587":242,"_30795":214,"_21329":51091,"_5":14664,"_27997":51010,"_3043":51092},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3587":243,"_30795":214,"_21329":51094,"_5":14664,"_27997":51010,"_3043":51095},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3587":244,"_30795":214,"_21329":51097,"_5":14664,"_27997":51014,"_3043":51098},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3587":245,"_30795":214,"_21329":51100,"_5":14664,"_27997":51014,"_3043":51101},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3587":246,"_30795":214,"_21329":51103,"_5":14664,"_27997":51014,"_3043":51104},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3587":247,"_30795":214,"_21329":51106,"_5":14664,"_27997":51014,"_3043":51107},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3587":248,"_30795":214,"_21329":51109,"_5":14664,"_27997":51018,"_3043":51110},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3587":249,"_30795":214,"_21329":51112,"_5":14664,"_27997":51018,"_3043":51113},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3587":250,"_30795":214,"_21329":51115,"_5":14664,"_27997":51018,"_3043":51116},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3587":251,"_30795":214,"_21329":51118,"_5":14664,"_27997":51018,"_3043":51119},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3587":252,"_30795":214,"_21329":51121,"_5":14664,"_27997":51018,"_3043":51122},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3587":253,"_30795":214,"_21329":51124,"_5":14664,"_27997":51018,"_3043":51125},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3587":254,"_30795":214,"_21329":51127,"_5":14664,"_27997":51018,"_3043":51128},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3587":255,"_30795":214,"_21329":51130,"_5":14664,"_27997":51018,"_3043":51131},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3587":256,"_30795":214,"_21329":51133,"_5":14664,"_27997":51022,"_3043":51134},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3587":257,"_30795":214,"_21329":51136,"_5":14664,"_27997":51026,"_3043":51137},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3587":258,"_30795":214,"_21329":51139,"_5":14664,"_27997":51026,"_3043":51140},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3587":259,"_30795":214,"_21329":51142,"_5":14664,"_27997":51026,"_3043":51143},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3587":260,"_30795":214,"_21329":51145,"_5":14664,"_27997":51026,"_3043":51146},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3587":261,"_30795":214,"_21329":51148,"_5":14664,"_27997":51026,"_3043":51149},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3587":262,"_30795":214,"_21329":51151,"_5":14664,"_27997":51026,"_3043":51152},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3587":263,"_30795":214,"_21329":51154,"_5":14664,"_27997":51026,"_3043":51155},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3587":264,"_30795":214,"_21329":51157,"_5":14664,"_27997":51030,"_3043":51158},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3587":265,"_30795":214,"_21329":51160,"_5":14664,"_27997":51030,"_3043":51161},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3587":266,"_30795":214,"_21329":51163,"_5":14664,"_27997":51030,"_3043":51164},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3587":267,"_30795":214,"_21329":51166,"_5":14664,"_27997":51030,"_3043":51167},[],"See Access control for the principal and policy model.",{"_3587":268,"_30795":214,"_21329":51169,"_5":14664,"_27997":51034,"_3043":51170},[],"To install a local checkout instead:",{"_3587":269,"_30795":214,"_21329":51172,"_5":14664,"_27997":51038,"_3043":51173},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3587":270,"_30795":214,"_21329":51175,"_5":14664,"_27997":51038,"_3043":51176},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3587":271,"_30795":214,"_21329":51178,"_5":14664,"_27997":51042,"_3043":51179},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3587":272,"_30795":214,"_21329":51181,"_5":14664,"_27997":51042,"_3043":51182},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3587":273,"_30795":214,"_21329":51184,"_5":14664,"_27997":51042,"_3043":51185},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3587":274,"_30795":214,"_21329":51187,"_5":14664,"_27997":51042,"_3043":51188},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3587":275,"_30795":214,"_21329":51190,"_5":14664,"_27997":51042,"_3043":51191},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3587":276,"_30795":214,"_21329":51193,"_5":14664,"_27997":51046,"_3043":51194},[],"Before going live, review:",{"_3587":277,"_30795":214,"_21329":51196,"_5":14664,"_27997":51046,"_3043":51197},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3587":278,"_30795":214,"_21329":51199,"_5":14664,"_27997":51046,"_3043":51200},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3587":279,"_30795":214,"_21329":51202,"_5":14664,"_27997":51046,"_3043":51203},[],"shared VA storage before increasing VA replicas",{"_3587":280,"_30795":214,"_21329":51205,"_5":14664,"_27997":51046,"_3043":51206},[],"managed OIDC roles and removal of evaluation credentials",{"_3587":281,"_30795":214,"_21329":51208,"_5":14664,"_27997":51046,"_3043":51209},[],"a trusted TLS issuer or externally managed certificate",{"_3587":282,"_30795":214,"_21329":51211,"_5":14664,"_27997":51046,"_3043":51212},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3587":283,"_30795":214,"_21329":51214,"_5":14664,"_27997":51046,"_3043":51215},[],"SMTP, observability and alert delivery",{"_3587":284,"_30795":214,"_21329":51217,"_5":14664,"_27997":51046,"_3043":51218},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3587":285,"_30795":214,"_21329":51220,"_5":14664,"_27997":51046,"_3043":51221},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3587":286,"_30795":286,"_5":15024,"_3043":51223,"_31154":51224,"_21329":51225,"_27997":286},"Expose the Gateway",[50381,50382,50488],[],{"_3587":287,"_30795":286,"_21329":51227,"_5":14664,"_27997":286,"_3043":51228},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3587":288,"_30795":286,"_5":31151,"_21329":51230,"_27997":51231,"_3043":51232},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3587":289,"_30795":286,"_5":31151,"_21329":51234,"_27997":51235,"_3043":51236},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3587":290,"_30795":286,"_5":31151,"_21329":51238,"_27997":51239,"_3043":51240},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3587":291,"_30795":286,"_5":31151,"_21329":51242,"_27997":51243,"_3043":51244},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#k3s","K3s",{"_3587":292,"_30795":286,"_5":31151,"_21329":51246,"_27997":51247,"_3043":51248},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3587":293,"_30795":286,"_5":31151,"_21329":51250,"_27997":51251,"_3043":51252},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3587":294,"_30795":286,"_5":31151,"_21329":51254,"_27997":51255,"_3043":51256},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3587":295,"_30795":286,"_5":31151,"_21329":51258,"_27997":51259,"_3043":51260},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3587":296,"_30795":286,"_5":31151,"_21329":51262,"_27997":51263,"_3043":51264},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3587":297,"_30795":286,"_5":31151,"_21329":51266,"_27997":51267,"_3043":51268},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3587":298,"_30795":286,"_5":31151,"_21329":51270,"_27997":51271,"_3043":51272},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3587":299,"_30795":286,"_21329":51274,"_5":14664,"_27997":51231,"_3043":51275},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3587":300,"_30795":286,"_21329":51277,"_5":14664,"_27997":51231,"_3043":51278},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3587":301,"_30795":286,"_21329":51280,"_5":14664,"_27997":51235,"_3043":51281},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3587":302,"_30795":286,"_21329":51283,"_5":14664,"_27997":51235,"_3043":51284},[],"Set it only when:",{"_3587":303,"_30795":286,"_21329":51286,"_5":14664,"_27997":51235,"_3043":51287},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3587":304,"_30795":286,"_21329":51289,"_5":14664,"_27997":51235,"_3043":51290},[],"that address is allocated to this Gateway",{"_3587":305,"_30795":286,"_21329":51292,"_5":14664,"_27997":51235,"_3043":51293},[],"the surrounding network already routes traffic for it to the cluster",{"_3587":306,"_30795":286,"_21329":51295,"_5":14664,"_27997":51235,"_3043":51296},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3587":307,"_30795":286,"_21329":51298,"_5":14664,"_27997":51235,"_3043":51299},[],"Keep these two settings separate:",{"_3587":308,"_30795":286,"_21329":51301,"_5":14664,"_27997":51235,"_3043":51302},[],"`gateway.addresses` requests an address for the Gateway.",{"_3587":309,"_30795":286,"_21329":51304,"_5":14664,"_27997":51235,"_3043":51305},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3587":310,"_30795":286,"_21329":51307,"_5":14664,"_27997":51235,"_3043":51308},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3587":311,"_30795":286,"_21329":51310,"_5":14664,"_27997":51239,"_3043":51311},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3587":312,"_30795":286,"_21329":51313,"_5":14664,"_27997":51239,"_3043":51314},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3587":313,"_30795":286,"_21329":51316,"_5":14664,"_27997":51243,"_3043":51317},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3587":314,"_30795":286,"_21329":51319,"_5":14664,"_27997":51243,"_3043":51320},[],"For the recommended design:",{"_3587":315,"_30795":286,"_21329":51322,"_5":14664,"_27997":51243,"_3043":51323},[],"Use only one externally exposed Lamassu Gateway.",{"_3587":316,"_30795":286,"_21329":51325,"_5":14664,"_27997":51243,"_3043":51326},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3587":317,"_30795":286,"_21329":51328,"_5":14664,"_27997":51243,"_3043":51329},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3587":318,"_30795":286,"_21329":51331,"_5":14664,"_27997":51243,"_3043":51332},[],"Point DNS at the VM's reachable address.",{"_3587":319,"_30795":286,"_21329":51334,"_5":14664,"_27997":51243,"_3043":51335},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3587":320,"_30795":286,"_21329":51337,"_5":14664,"_27997":51247,"_3043":51338},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3587":321,"_30795":286,"_21329":51340,"_5":14664,"_27997":51251,"_3043":51341},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3587":322,"_30795":286,"_21329":51343,"_5":14664,"_27997":51251,"_3043":51344},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3587":323,"_30795":286,"_21329":51346,"_5":14664,"_27997":51255,"_3043":51347},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3587":324,"_30795":286,"_21329":51349,"_5":14664,"_27997":51255,"_3043":51350},[],"Requirement",{"_3587":325,"_30795":286,"_21329":51352,"_5":14664,"_27997":51255,"_3043":51353},[],"Recommended design",{"_3587":326,"_30795":286,"_21329":51355,"_5":14664,"_27997":51255,"_3043":51356},[],"Consequence",{"_3587":327,"_30795":286,"_21329":51358,"_5":14664,"_27997":51255,"_3043":51359},[],"Several Lamassu URLs or services",{"_3587":328,"_30795":286,"_21329":51361,"_5":14664,"_27997":51255,"_3043":51362},[],"One Gateway with multiple routes",{"_3587":329,"_30795":286,"_21329":51364,"_5":14664,"_27997":51255,"_3043":51365},[],"One IP and one proxy fleet; this is the chart default",{"_3587":330,"_30795":286,"_21329":51367,"_5":14664,"_27997":51255,"_3043":51368},[],"Independent Gateways and separate external IPs",{"_3587":331,"_30795":286,"_21329":51370,"_5":14664,"_27997":51255,"_3043":51371},[],"One VIP per Gateway",{"_3587":332,"_30795":286,"_21329":51373,"_5":14664,"_27997":51255,"_3043":51374},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3587":333,"_30795":286,"_21329":51376,"_5":14664,"_27997":51255,"_3043":51377},[],"Independent Gateways on one node and one IP",{"_3587":334,"_30795":286,"_21329":51379,"_5":14664,"_27997":51255,"_3043":51380},[],"Use different external ports",{"_3587":335,"_30795":286,"_21329":51382,"_5":14664,"_27997":51255,"_3043":51383},[],"Clients must include non-standard ports",{"_3587":336,"_30795":286,"_21329":51385,"_5":14664,"_27997":51255,"_3043":51386},[],"Separate TLS/mTLS termination behind one IP",{"_3587":337,"_30795":286,"_21329":51388,"_5":14664,"_27997":51255,"_3043":51389},[],"Front-door SNI routing to internal Gateways",{"_3587":338,"_30795":286,"_21329":51391,"_5":14664,"_27997":51255,"_3043":51392},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3587":339,"_30795":286,"_21329":51394,"_5":14664,"_27997":51255,"_3043":51395},[],"Separate Gateway resources but shared proxy infrastructure",{"_3587":340,"_30795":286,"_21329":51397,"_5":14664,"_27997":51255,"_3043":51398},[],"Envoy merged-Gateway mode",{"_3587":341,"_30795":286,"_21329":51400,"_5":14664,"_27997":51255,"_3043":51401},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3587":342,"_30795":286,"_21329":51403,"_5":14664,"_27997":51255,"_3043":51404},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3587":343,"_30795":286,"_21329":51406,"_5":14664,"_27997":51255,"_3043":51407},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3587":344,"_30795":286,"_21329":51409,"_5":14664,"_27997":51255,"_3043":51410},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3587":345,"_30795":286,"_21329":51412,"_5":14664,"_27997":51255,"_3043":51413},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3587":346,"_30795":286,"_21329":51415,"_5":14664,"_27997":51259,"_3043":51416},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3587":347,"_30795":286,"_21329":51418,"_5":14664,"_27997":51263,"_3043":51419},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3587":348,"_30795":286,"_21329":51421,"_5":14664,"_27997":51263,"_3043":51422},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3587":349,"_30795":286,"_21329":51424,"_5":14664,"_27997":51263,"_3043":51425},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3587":350,"_30795":286,"_21329":51427,"_5":14664,"_27997":51263,"_3043":51428},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3587":351,"_30795":286,"_21329":51430,"_5":14664,"_27997":51263,"_3043":51431},[],"If none of those are possible, use different external ports or change the external network design.",{"_3587":352,"_30795":286,"_21329":51433,"_5":14664,"_27997":51267,"_3043":51434},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3587":353,"_30795":286,"_21329":51436,"_5":14664,"_27997":51267,"_3043":51437},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3587":354,"_30795":286,"_21329":51439,"_5":14664,"_27997":51271,"_3043":51440},[],"Check, in order:",{"_3587":355,"_30795":286,"_21329":51442,"_5":14664,"_27997":51271,"_3043":51443},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3587":356,"_30795":286,"_21329":51445,"_5":14664,"_27997":51271,"_3043":51446},[],"Its status contains the expected address.",{"_3587":357,"_30795":286,"_21329":51448,"_5":14664,"_27997":51271,"_3043":51449},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3587":358,"_30795":286,"_21329":51451,"_5":14664,"_27997":51271,"_3043":51452},[],"Port 443 reaches that address from the client network.",{"_3587":359,"_30795":286,"_21329":51454,"_5":14664,"_27997":51271,"_3043":51455},[],"DNS resolves to the externally reachable endpoint.",{"_3587":360,"_30795":286,"_21329":51457,"_5":14664,"_27997":51271,"_3043":51458},[],"The certificate contains the DNS name or IP used by the client.",{"_3587":361,"_30795":286,"_21329":51460,"_5":14664,"_27997":51271,"_3043":51461},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3587":362,"_30795":362,"_5":15024,"_3043":50488,"_31154":51463,"_21329":51464,"_27997":362},[50381,50382,50488],[],{"_3587":363,"_30795":362,"_21329":51466,"_5":14664,"_27997":362,"_3043":51467},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3587":364,"_30795":362,"_5":31151,"_21329":51469,"_27997":51470,"_3043":51471},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3587":365,"_30795":362,"_5":31151,"_21329":51473,"_27997":51474,"_3043":51475},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3587":366,"_30795":362,"_5":31151,"_21329":51477,"_27997":51478,"_3043":51479},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3587":367,"_30795":362,"_5":31151,"_21329":51481,"_27997":51482,"_3043":51483},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3587":368,"_30795":362,"_5":31151,"_21329":51485,"_27997":51486,"_3043":51487},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3587":369,"_30795":362,"_5":31151,"_21329":51489,"_27997":51490,"_3043":51491},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3587":370,"_30795":362,"_21329":51493,"_5":14664,"_27997":51470,"_3043":51494},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3587":371,"_30795":362,"_21329":51496,"_5":14664,"_27997":51474,"_3043":51497},[],"Workflow",{"_3587":372,"_30795":362,"_21329":51499,"_5":14664,"_27997":51474,"_3043":51500},[],"Use it for",{"_3587":373,"_30795":362,"_21329":51502,"_5":14664,"_27997":51474,"_3043":51503},[],"What it installs",{"_3587":374,"_30795":362,"_21329":51505,"_5":14664,"_27997":51474,"_3043":51506},[],"Helm",{"_3587":375,"_30795":362,"_21329":51508,"_5":14664,"_27997":51474,"_3043":51509},[],"Production and controlled environments",{"_3587":376,"_30795":362,"_21329":51511,"_5":14664,"_27997":51474,"_3043":51512},[],"Lamassu services and Gateway API resources",{"_3587":377,"_30795":362,"_21329":51514,"_5":14664,"_27997":51474,"_3043":50625},[],{"_3587":378,"_30795":362,"_21329":51516,"_5":14664,"_27997":51474,"_3043":51517},[],"Evaluation, demos, CI and small lab clusters",{"_3587":379,"_30795":362,"_21329":51519,"_5":14664,"_27997":51474,"_3043":51520},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3587":380,"_30795":362,"_21329":51522,"_5":14664,"_27997":51478,"_3043":51523},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3587":381,"_30795":362,"_21329":51525,"_5":14664,"_27997":51478,"_3043":51526},[],"Area",{"_3587":382,"_30795":362,"_21329":51528,"_5":14664,"_27997":51478,"_3043":51529},[],"The Lamassu chart provides",{"_3587":383,"_30795":362,"_21329":51531,"_5":14664,"_27997":51478,"_3043":51532},[],"You provide",{"_3587":384,"_30795":362,"_21329":51534,"_5":14664,"_27997":51478,"_3043":51535},[],"Lamassu applications",{"_3587":385,"_30795":362,"_21329":51537,"_5":14664,"_27997":51478,"_3043":51538},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3587":386,"_30795":362,"_21329":51540,"_5":14664,"_27997":51478,"_3043":51541},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3587":387,"_30795":362,"_21329":51543,"_5":14664,"_27997":51478,"_3043":51544},[],"PostgreSQL data",{"_3587":388,"_30795":362,"_21329":51546,"_5":14664,"_27997":51478,"_3043":51547},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3587":389,"_30795":362,"_21329":51549,"_5":14664,"_27997":51478,"_3043":51550},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3587":390,"_30795":362,"_21329":51552,"_5":14664,"_27997":51478,"_3043":51553},[],"Messaging",{"_3587":391,"_30795":362,"_21329":51555,"_5":14664,"_27997":51478,"_3043":51556},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3587":392,"_30795":362,"_21329":51558,"_5":14664,"_27997":51478,"_3043":51559},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3587":393,"_30795":362,"_21329":51561,"_5":14664,"_27997":51478,"_3043":51562},[],"Identity",{"_3587":394,"_30795":362,"_21329":51564,"_5":14664,"_27997":51478,"_3043":51565},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3587":395,"_30795":362,"_21329":51567,"_5":14664,"_27997":51478,"_3043":51568},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3587":396,"_30795":362,"_21329":51570,"_5":14664,"_27997":51478,"_3043":51571},[],"External routing",{"_3587":397,"_30795":362,"_21329":51573,"_5":14664,"_27997":51478,"_3043":51574},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3587":398,"_30795":362,"_21329":51576,"_5":14664,"_27997":51478,"_3043":51577},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3587":399,"_30795":362,"_21329":51579,"_5":14664,"_27997":51478,"_3043":51580},[],"TLS",{"_3587":400,"_30795":362,"_21329":51582,"_5":14664,"_27997":51478,"_3043":51583},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3587":401,"_30795":362,"_21329":51585,"_5":14664,"_27997":51478,"_3043":51586},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3587":402,"_30795":362,"_21329":51588,"_5":14664,"_27997":51478,"_3043":51589},[],"Persistent application data",{"_3587":403,"_30795":362,"_21329":51591,"_5":14664,"_27997":51478,"_3043":51592},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3587":404,"_30795":362,"_21329":51594,"_5":14664,"_27997":51478,"_3043":51595},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3587":405,"_30795":362,"_21329":51597,"_5":14664,"_27997":51478,"_3043":51598},[],"Optional integrations",{"_3587":406,"_30795":362,"_21329":51600,"_5":14664,"_27997":51478,"_3043":51601},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3587":407,"_30795":362,"_21329":51603,"_5":14664,"_27997":51478,"_3043":51604},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3587":408,"_30795":362,"_21329":51606,"_5":14664,"_27997":51478,"_3043":51607},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3587":409,"_30795":362,"_21329":51609,"_5":14664,"_27997":51478,"_3043":51610},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3587":410,"_30795":362,"_21329":51612,"_5":14664,"_27997":51482,"_3043":51613},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3587":411,"_30795":362,"_21329":51615,"_5":14664,"_27997":51482,"_3043":51616},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3587":412,"_30795":362,"_21329":51618,"_5":14664,"_27997":51486,"_3043":51619},[],"Kubernetes 1.24 or newer",{"_3587":413,"_30795":362,"_21329":51621,"_5":14664,"_27997":51486,"_3043":51622},[],"Helm 3.2 or newer",{"_3587":414,"_30795":362,"_21329":51624,"_5":14664,"_27997":51486,"_3043":51625},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3587":415,"_30795":362,"_21329":51627,"_5":14664,"_27997":51486,"_3043":51628},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3587":416,"_30795":362,"_21329":51630,"_5":14664,"_27997":51486,"_3043":51631},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3587":417,"_30795":362,"_21329":51633,"_5":14664,"_27997":51486,"_3043":51634},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3587":418,"_30795":362,"_21329":51636,"_5":14664,"_27997":51486,"_3043":51637},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3587":419,"_30795":362,"_21329":51639,"_5":14664,"_27997":51490,"_3043":51640},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3587":420,"_30795":362,"_21329":51642,"_5":14664,"_27997":51490,"_3043":51643},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3587":421,"_30795":362,"_21329":51645,"_5":14664,"_27997":51490,"_3043":51646},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3587":422,"_30795":362,"_21329":51648,"_5":14664,"_27997":51490,"_3043":51649},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3587":423,"_30795":423,"_5":15024,"_3043":51651,"_31154":51652,"_21329":51654,"_27997":423},"Deployment troubleshooting",[50381,50382,51653],"Operations",[],{"_3587":424,"_30795":423,"_21329":51656,"_5":14664,"_27997":423,"_3043":51657},[],"Diagnose access, service health and infrastructure dependencies.",{"_3587":425,"_30795":423,"_5":31151,"_21329":51659,"_27997":51660,"_3043":51661},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3587":426,"_30795":423,"_5":31151,"_21329":51663,"_27997":51664,"_3043":51665},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3587":427,"_30795":423,"_5":31151,"_21329":51667,"_27997":51668,"_3043":51669},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3587":428,"_30795":423,"_5":31151,"_21329":51671,"_27997":51672,"_3043":51673},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3587":429,"_30795":423,"_5":31151,"_21329":51675,"_27997":51676,"_3043":51677},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3587":430,"_30795":423,"_5":31151,"_21329":51679,"_27997":51680,"_3043":51681},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3587":431,"_30795":423,"_5":31151,"_21329":51683,"_27997":51684,"_3043":51685},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3587":432,"_30795":423,"_5":31151,"_21329":51687,"_27997":51688,"_3043":51689},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3587":433,"_30795":423,"_5":31151,"_21329":51691,"_27997":51692,"_3043":51693},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3587":434,"_30795":423,"_5":31151,"_21329":51695,"_27997":51696,"_3043":51697},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3587":435,"_30795":423,"_5":31151,"_21329":51699,"_27997":51700,"_3043":51701},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3587":436,"_30795":423,"_5":31151,"_21329":51703,"_27997":51704,"_3043":51705},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3587":437,"_30795":423,"_5":31151,"_21329":51707,"_27997":51708,"_3043":51709},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#observability","Observability",{"_3587":438,"_30795":423,"_21329":51711,"_5":14664,"_27997":423,"_3043":51712},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3587":439,"_30795":423,"_21329":51714,"_5":14664,"_27997":51664,"_3043":51715},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3587":440,"_30795":423,"_21329":51717,"_5":14664,"_27997":51668,"_3043":51718},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3587":441,"_30795":423,"_21329":51720,"_5":14664,"_27997":51672,"_3043":51721},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3587":442,"_30795":423,"_21329":51723,"_5":14664,"_27997":51676,"_3043":51724},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3587":443,"_30795":423,"_21329":51726,"_5":14664,"_27997":51680,"_3043":51727},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3587":444,"_30795":423,"_21329":51729,"_5":14664,"_27997":51684,"_3043":51730},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3587":445,"_30795":423,"_21329":51732,"_5":14664,"_27997":51684,"_3043":51733},[],"Also run the chart's connectivity test:",{"_3587":446,"_30795":423,"_21329":51735,"_5":14664,"_27997":51684,"_3043":51736},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3587":447,"_30795":423,"_21329":51738,"_5":14664,"_27997":51684,"_3043":51739},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3587":448,"_30795":423,"_21329":51741,"_5":14664,"_27997":51688,"_3043":51742},[],"If you receive a 401:",{"_3587":449,"_30795":423,"_21329":51744,"_5":14664,"_27997":51688,"_3043":51745},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3587":450,"_30795":423,"_21329":51747,"_5":14664,"_27997":51688,"_3043":51748},[],"verify issuer, audience and expiration of the token;",{"_3587":451,"_30795":423,"_21329":51750,"_5":14664,"_27997":51688,"_3043":51751},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3587":452,"_30795":423,"_21329":51753,"_5":14664,"_27997":51688,"_3043":51754},[],"check that the provider's public and internal routes point to the same realm.",{"_3587":453,"_30795":423,"_21329":51756,"_5":14664,"_27997":51688,"_3043":51757},[],"If login succeeds but the APIs return 403:",{"_3587":454,"_30795":423,"_21329":51759,"_5":14664,"_27997":51688,"_3043":51760},[],"inspect the token's real claims;",{"_3587":455,"_30795":423,"_21329":51762,"_5":14664,"_27997":51688,"_3043":51763},[],"confirm they match an active principal;",{"_3587":456,"_30795":423,"_21329":51765,"_5":14664,"_27997":51688,"_3043":51766},[],"review the policies granted to that principal;",{"_3587":457,"_30795":423,"_21329":51768,"_5":14664,"_27997":51688,"_3043":51769},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3587":458,"_30795":423,"_21329":51771,"_5":14664,"_27997":51688,"_3043":51772},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3587":459,"_30795":423,"_21329":51774,"_5":14664,"_27997":51692,"_3043":51775},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3587":460,"_30795":423,"_21329":51777,"_5":14664,"_27997":51692,"_3043":51778},[],"Locate the authz pod and Service.",{"_3587":461,"_30795":423,"_21329":51780,"_5":14664,"_27997":51692,"_3043":51781},[],"Check /health, logs and its database connection.",{"_3587":462,"_30795":423,"_21329":51783,"_5":14664,"_27997":51692,"_3043":51784},[],"Verify the DNS and port configured in externalAuthorization.",{"_3587":463,"_30795":423,"_21329":51786,"_5":14664,"_27997":51692,"_3043":51787},[],"Check the check route is /v1/ext\\_authz/check.",{"_3587":464,"_30795":423,"_21329":51789,"_5":14664,"_27997":51692,"_3043":51790},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3587":465,"_30795":423,"_21329":51792,"_5":14664,"_27997":51696,"_3043":51793},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3587":466,"_30795":423,"_21329":51795,"_5":14664,"_27997":51700,"_3043":51796},[],"Review kubectl describe pod first. Common causes are:",{"_3587":467,"_30795":423,"_21329":51798,"_5":14664,"_27997":51700,"_3043":51799},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3587":468,"_30795":423,"_21329":51801,"_5":14664,"_27997":51700,"_3043":51802},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3587":469,"_30795":423,"_21329":51804,"_5":14664,"_27997":51700,"_3043":51805},[],"unbound persistent volume;",{"_3587":470,"_30795":423,"_21329":51807,"_5":14664,"_27997":51700,"_3043":51808},[],"inaccessible image or incorrect pull policy;",{"_3587":471,"_30795":423,"_21329":51810,"_5":14664,"_27997":51700,"_3043":51811},[],"invalid cryptographic engine configuration;",{"_3587":472,"_30795":423,"_21329":51813,"_5":14664,"_27997":51700,"_3043":51814},[],"CPU or memory limits set too low;",{"_3587":473,"_30795":423,"_21329":51816,"_5":14664,"_27997":51700,"_3043":51817},[],"an incomplete prior migration.",{"_3587":474,"_30795":423,"_21329":51819,"_5":14664,"_27997":51700,"_3043":51820},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3587":475,"_30795":423,"_21329":51822,"_5":14664,"_27997":51700,"_3043":51823},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3587":476,"_30795":423,"_21329":51825,"_5":14664,"_27997":51700,"_3043":51826},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3587":477,"_30795":423,"_21329":51828,"_5":14664,"_27997":51704,"_3043":51829},[],"Domain and audit events depend on the bus publisher:",{"_3587":478,"_30795":423,"_21329":51831,"_5":14664,"_27997":51704,"_3043":51832},[],"verify it is enabled in the emitting service;",{"_3587":479,"_30795":423,"_21329":51834,"_5":14664,"_27997":51704,"_3043":51835},[],"check AMQP connectivity and credentials;",{"_3587":480,"_30795":423,"_21329":51837,"_5":14664,"_27997":51704,"_3043":51838},[],"review exchange, routing key, queues and consumers;",{"_3587":481,"_30795":423,"_21329":51840,"_5":14664,"_27997":51704,"_3043":51841},[],"inspect dead-letter queues;",{"_3587":482,"_30795":423,"_21329":51843,"_5":14664,"_27997":51704,"_3043":51844},[],"alert on orphan durable queues and backlog growth.",{"_3587":483,"_30795":423,"_21329":51846,"_5":14664,"_27997":51704,"_3043":51847},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3587":484,"_30795":423,"_21329":51849,"_5":14664,"_27997":51704,"_3043":51850},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3587":485,"_30795":423,"_21329":51852,"_5":14664,"_27997":51704,"_3043":51853},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3587":486,"_30795":423,"_21329":51855,"_5":14664,"_27997":51704,"_3043":51856},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3587":487,"_30795":423,"_21329":51858,"_5":14664,"_27997":51704,"_3043":51859},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3587":488,"_30795":423,"_21329":51861,"_5":14664,"_27997":51704,"_3043":51862},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3587":489,"_30795":423,"_21329":51864,"_5":14664,"_27997":51704,"_3043":51865},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3587":490,"_30795":423,"_21329":51867,"_5":14664,"_27997":51708,"_3043":51868},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3587":491,"_30795":423,"_21329":51870,"_5":14664,"_27997":51708,"_3043":51871},[],"Before closing an incident, record:",{"_3587":492,"_30795":423,"_21329":51873,"_5":14664,"_27997":51708,"_3043":51874},[],"the confirmed cause;",{"_3587":493,"_30795":423,"_21329":51876,"_5":14664,"_27997":51708,"_3043":51877},[],"the time scope and affected resources;",{"_3587":494,"_30795":423,"_21329":51879,"_5":14664,"_27997":51708,"_3043":51880},[],"the commands or queries used;",{"_3587":495,"_30795":423,"_21329":51882,"_5":14664,"_27997":51708,"_3043":51883},[],"the applied change and how to revert it;",{"_3587":496,"_30795":423,"_21329":51885,"_5":14664,"_27997":51708,"_3043":51886},[],"validation from a consumer;",{"_3587":497,"_30795":423,"_21329":51888,"_5":14664,"_27997":51708,"_3043":51889},[],"the preventive action and its owner.",{"_3587":498,"_30795":498,"_5":15024,"_3043":51891,"_31154":51892,"_21329":51896,"_27997":498},"Data model",[50381,51893,51894,51895],"Platform","Administration","Access control",[],{"_3587":499,"_30795":498,"_21329":51898,"_5":14664,"_27997":498,"_3043":51899},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3587":500,"_30795":498,"_5":31151,"_21329":51901,"_27997":51902,"_3043":51903},[],"/docs/pr-preview/pr-70/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3587":501,"_30795":498,"_5":31151,"_21329":51905,"_27997":51906,"_3043":51907},[],"/docs/pr-preview/pr-70/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3587":502,"_30795":498,"_21329":51909,"_5":14664,"_27997":498,"_3043":51910},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3587":503,"_30795":498,"_21329":51912,"_5":14664,"_27997":51902,"_3043":51913},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3587":504,"_30795":498,"_21329":51915,"_5":14664,"_27997":51902,"_3043":51916},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3587":505,"_30795":498,"_21329":51918,"_5":14664,"_27997":51902,"_3043":51919},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3587":506,"_30795":498,"_21329":51921,"_5":14664,"_27997":51906,"_3043":51922},[],"Entity (`schema_name.entity_type`)",{"_3587":507,"_30795":498,"_21329":51924,"_5":14664,"_27997":51906,"_3043":51925},[],"Table (`table_name`)",{"_3587":508,"_30795":498,"_21329":51927,"_5":14664,"_27997":51906,"_3043":51928},[],"Key (`primary_key`)",{"_3587":509,"_30795":498,"_21329":51930,"_5":14664,"_27997":51906,"_3043":51931},[],"`alerts.event`",{"_3587":510,"_30795":498,"_21329":51933,"_5":14664,"_27997":51906,"_3043":51934},[],"`events`",{"_3587":511,"_30795":498,"_21329":51936,"_5":14664,"_27997":51906,"_3043":51937},[],"`event_type`",{"_3587":512,"_30795":498,"_21329":51939,"_5":14664,"_27997":51906,"_3043":51940},[],"`alerts.subscription`",{"_3587":513,"_30795":498,"_21329":51942,"_5":14664,"_27997":51906,"_3043":51943},[],"`subscriptions`",{"_3587":514,"_30795":498,"_21329":51945,"_5":14664,"_27997":51906,"_3043":51946},[],"`id`",{"_3587":515,"_30795":498,"_21329":51948,"_5":14664,"_27997":51906,"_3043":51949},[],"`ca.ca_certificate`",{"_3587":516,"_30795":498,"_21329":51951,"_5":14664,"_27997":51906,"_3043":51952},[],"`ca_certificates`",{"_3587":517,"_30795":498,"_21329":51954,"_5":14664,"_27997":51906,"_3043":51946},[],{"_3587":518,"_30795":498,"_21329":51956,"_5":14664,"_27997":51906,"_3043":51957},[],"`ca.certificate`",{"_3587":519,"_30795":498,"_21329":51959,"_5":14664,"_27997":51906,"_3043":51960},[],"`certificates`",{"_3587":520,"_30795":498,"_21329":51962,"_5":14664,"_27997":51906,"_3043":51963},[],"`serial_number`",{"_3587":521,"_30795":498,"_21329":51965,"_5":14664,"_27997":51906,"_3043":51966},[],"`ca.issuance_profile`",{"_3587":522,"_30795":498,"_21329":51968,"_5":14664,"_27997":51906,"_3043":51969},[],"`issuance_profiles`",{"_3587":523,"_30795":498,"_21329":51971,"_5":14664,"_27997":51906,"_3043":51946},[],{"_3587":524,"_30795":498,"_21329":51973,"_5":14664,"_27997":51906,"_3043":51974},[],"`devicemanager.device_group`",{"_3587":525,"_30795":498,"_21329":51976,"_5":14664,"_27997":51906,"_3043":51977},[],"`device_groups`",{"_3587":526,"_30795":498,"_21329":51979,"_5":14664,"_27997":51906,"_3043":51946},[],{"_3587":527,"_30795":498,"_21329":51981,"_5":14664,"_27997":51906,"_3043":51982},[],"`devicemanager.device`",{"_3587":528,"_30795":498,"_21329":51984,"_5":14664,"_27997":51906,"_3043":51985},[],"`devices`",{"_3587":529,"_30795":498,"_21329":51987,"_5":14664,"_27997":51906,"_3043":51946},[],{"_3587":530,"_30795":498,"_21329":51989,"_5":14664,"_27997":51906,"_3043":51990},[],"`dmsmanager.dms`",{"_3587":531,"_30795":498,"_21329":51992,"_5":14664,"_27997":51906,"_3043":51993},[],"`dms`",{"_3587":532,"_30795":498,"_21329":51995,"_5":14664,"_27997":51906,"_3043":51946},[],{"_3587":533,"_30795":498,"_21329":51997,"_5":14664,"_27997":51906,"_3043":51998},[],"`kms.kms_key`",{"_3587":534,"_30795":498,"_21329":52000,"_5":14664,"_27997":51906,"_3043":52001},[],"`kms_keys`",{"_3587":535,"_30795":498,"_21329":52003,"_5":14664,"_27997":51906,"_3043":52004},[],"`key_id`, `engine_id`",{"_3587":536,"_30795":498,"_21329":52006,"_5":14664,"_27997":51906,"_3043":52007},[],"`va.crl_settings`",{"_3587":537,"_30795":498,"_21329":52009,"_5":14664,"_27997":51906,"_3043":52010},[],"`crl_settings`",{"_3587":538,"_30795":498,"_21329":52012,"_5":14664,"_27997":51906,"_3043":52013},[],"`ca_id`",{"_3587":539,"_30795":498,"_21329":52015,"_5":14664,"_27997":51906,"_3043":52016},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3587":540,"_30795":498,"_21329":52018,"_5":14664,"_27997":51906,"_3043":52019},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3587":541,"_30795":498,"_21329":52021,"_5":14664,"_27997":51906,"_3043":52022},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3587":542,"_30795":542,"_5":15024,"_3043":52024,"_31154":52025,"_21329":52026,"_27997":542},"Access control overview",[50381,51893,51894,51895],[],{"_3587":543,"_30795":542,"_21329":52028,"_5":14664,"_27997":542,"_3043":52029},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3587":544,"_30795":542,"_5":31151,"_21329":52031,"_27997":52032,"_3043":52033},[],"/docs/pr-preview/pr-70/platform/administration/access-control#essential-concepts","Essential concepts",{"_3587":545,"_30795":542,"_5":31151,"_21329":52035,"_27997":52036,"_3043":52037},[],"/docs/pr-preview/pr-70/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3587":546,"_30795":542,"_5":31151,"_21329":52039,"_27997":52040,"_3043":52041},[],"/docs/pr-preview/pr-70/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3587":547,"_30795":542,"_5":31151,"_21329":52043,"_27997":52044,"_3043":52045},[],"/docs/pr-preview/pr-70/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3587":548,"_30795":542,"_5":31151,"_21329":52047,"_27997":52048,"_3043":52049},[],"/docs/pr-preview/pr-70/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3587":549,"_30795":542,"_5":31151,"_21329":52051,"_27997":52052,"_3043":52053},[],"/docs/pr-preview/pr-70/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3587":550,"_30795":542,"_5":31151,"_21329":52055,"_27997":52056,"_3043":52057},[],"/docs/pr-preview/pr-70/platform/administration/access-control#oidc-principals","OIDC principals",{"_3587":551,"_30795":542,"_5":31151,"_21329":52059,"_27997":52060,"_3043":52061},[],"/docs/pr-preview/pr-70/platform/administration/access-control#x509-principals","X.509 principals",{"_3587":552,"_30795":542,"_5":31151,"_21329":52063,"_27997":52064,"_3043":52065},[],"/docs/pr-preview/pr-70/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3587":553,"_30795":542,"_5":31151,"_21329":52067,"_27997":52068,"_3043":52069},[],"/docs/pr-preview/pr-70/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3587":554,"_30795":542,"_5":31151,"_21329":52071,"_27997":52072,"_3043":52073},[],"/docs/pr-preview/pr-70/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3587":555,"_30795":542,"_5":31151,"_21329":52075,"_27997":52076,"_3043":52077},[],"/docs/pr-preview/pr-70/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3587":556,"_30795":542,"_5":31151,"_21329":52079,"_27997":52080,"_3043":52081},[],"/docs/pr-preview/pr-70/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3587":557,"_30795":542,"_5":31151,"_21329":52083,"_27997":52084,"_3043":52085},[],"/docs/pr-preview/pr-70/platform/administration/access-control#http-rules","HTTP rules",{"_3587":558,"_30795":542,"_5":31151,"_21329":52087,"_27997":52088,"_3043":52089},[],"/docs/pr-preview/pr-70/platform/administration/access-control#included-policies","Included policies",{"_3587":559,"_30795":542,"_5":31151,"_21329":52091,"_27997":52092,"_3043":51031},[],"/docs/pr-preview/pr-70/platform/administration/access-control#provision-the-first-administrator",{"_3587":560,"_30795":542,"_5":31151,"_21329":52094,"_27997":52095,"_3043":52096},[],"/docs/pr-preview/pr-70/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3587":561,"_30795":542,"_5":31151,"_21329":52098,"_27997":52099,"_3043":52100},[],"/docs/pr-preview/pr-70/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3587":562,"_30795":542,"_5":31151,"_21329":52102,"_27997":52103,"_3043":52104},[],"/docs/pr-preview/pr-70/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3587":563,"_30795":542,"_5":31151,"_21329":52106,"_27997":52107,"_3043":52108},[],"/docs/pr-preview/pr-70/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3587":564,"_30795":542,"_5":31151,"_21329":52110,"_27997":52111,"_3043":52112},[],"/docs/pr-preview/pr-70/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3587":565,"_30795":542,"_5":31151,"_21329":52114,"_27997":52115,"_3043":52116},[],"/docs/pr-preview/pr-70/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3587":566,"_30795":542,"_5":31151,"_21329":52118,"_27997":52119,"_3043":52120},[],"/docs/pr-preview/pr-70/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3587":567,"_30795":542,"_5":31151,"_21329":52122,"_27997":52123,"_3043":52124},[],"/docs/pr-preview/pr-70/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3587":568,"_30795":542,"_5":31151,"_21329":52126,"_27997":52127,"_3043":52128},[],"/docs/pr-preview/pr-70/platform/administration/access-control#operational-checklist","Operational checklist",{"_3587":569,"_30795":542,"_5":31151,"_21329":52130,"_27997":52131,"_3043":52132},[],"/docs/pr-preview/pr-70/platform/administration/access-control#diagnostics","Diagnostics",{"_3587":570,"_30795":542,"_5":31151,"_21329":52134,"_27997":52135,"_3043":52136},[],"/docs/pr-preview/pr-70/platform/administration/access-control#the-response-is-401","The response is 401",{"_3587":571,"_30795":542,"_5":31151,"_21329":52138,"_27997":52139,"_3043":52140},[],"/docs/pr-preview/pr-70/platform/administration/access-control#the-response-is-403","The response is 403",{"_3587":572,"_30795":542,"_5":31151,"_21329":52142,"_27997":52143,"_3043":52144},[],"/docs/pr-preview/pr-70/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3587":573,"_30795":542,"_5":31151,"_21329":52146,"_27997":52147,"_3043":52148},[],"/docs/pr-preview/pr-70/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3587":574,"_30795":542,"_5":31151,"_21329":52150,"_27997":52151,"_3043":52152},[],"/docs/pr-preview/pr-70/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3587":575,"_30795":542,"_21329":52154,"_5":14664,"_27997":542,"_3043":52155},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3587":576,"_30795":542,"_21329":52157,"_5":14664,"_27997":542,"_3043":52158},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3587":577,"_30795":542,"_21329":52160,"_5":14664,"_27997":542,"_3043":52161},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3587":578,"_30795":542,"_21329":52163,"_5":14664,"_27997":52032,"_3043":52164},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3587":579,"_30795":542,"_21329":52166,"_5":14664,"_27997":52032,"_3043":52167},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3587":580,"_30795":542,"_21329":52169,"_5":14664,"_27997":52032,"_3043":52170},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3587":581,"_30795":542,"_21329":52172,"_5":14664,"_27997":52032,"_3043":52173},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3587":582,"_30795":542,"_21329":52175,"_5":14664,"_27997":52032,"_3043":52176},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3587":583,"_30795":542,"_21329":52178,"_5":14664,"_27997":52032,"_3043":52179},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3587":584,"_30795":542,"_21329":52181,"_5":14664,"_27997":52036,"_3043":52182},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3587":585,"_30795":542,"_21329":52184,"_5":14664,"_27997":52036,"_3043":52185},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3587":586,"_30795":542,"_21329":52187,"_5":14664,"_27997":52040,"_3043":52188},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3587":587,"_30795":542,"_21329":52190,"_5":14664,"_27997":52040,"_3043":52191},[],"The decision is made **before forwarding the request to the service**:",{"_3587":588,"_30795":542,"_21329":52193,"_5":14664,"_27997":52040,"_3043":52194},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3587":589,"_30795":542,"_21329":52196,"_5":14664,"_27997":52040,"_3043":52197},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3587":590,"_30795":542,"_21329":52199,"_5":14664,"_27997":52040,"_3043":52200},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3587":591,"_30795":542,"_21329":52202,"_5":14664,"_27997":52040,"_3043":52203},[],"It separately loads the policies granted to each principal.",{"_3587":592,"_30795":542,"_21329":52205,"_5":14664,"_27997":52040,"_3043":52206},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3587":593,"_30795":542,"_21329":52208,"_5":14664,"_27997":52040,"_3043":52209},[],"`authz` looks for an HTTP rule granting that action.",{"_3587":594,"_30795":542,"_21329":52211,"_5":14664,"_27997":52040,"_3043":52212},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3587":595,"_30795":542,"_21329":52214,"_5":14664,"_27997":52040,"_3043":52215},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3587":596,"_30795":542,"_21329":52217,"_5":14664,"_27997":52040,"_3043":52218},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3587":597,"_30795":542,"_21329":52220,"_5":14664,"_27997":52040,"_3043":52221},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3587":598,"_30795":542,"_21329":52223,"_5":14664,"_27997":52044,"_3043":52224},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3587":599,"_30795":542,"_21329":52226,"_5":14664,"_27997":52044,"_3043":52227},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3587":600,"_30795":542,"_21329":52229,"_5":14664,"_27997":52044,"_3043":52230},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3587":601,"_30795":542,"_21329":52232,"_5":14664,"_27997":52044,"_3043":52233},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3587":602,"_30795":542,"_21329":52235,"_5":14664,"_27997":52044,"_3043":52236},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3587":603,"_30795":542,"_21329":52238,"_5":14664,"_27997":52044,"_3043":52239},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3587":604,"_30795":542,"_21329":52241,"_5":14664,"_27997":52044,"_3043":52242},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3587":605,"_30795":542,"_21329":52244,"_5":14664,"_27997":52044,"_3043":52245},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3587":606,"_30795":542,"_21329":52247,"_5":14664,"_27997":52048,"_3043":52248},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3587":607,"_30795":542,"_21329":52250,"_5":14664,"_27997":52048,"_3043":52251},[],"The decision is made with the domain operation context:",{"_3587":608,"_30795":542,"_21329":52253,"_5":14664,"_27997":52048,"_3043":52254},[],"The middleware extracts the credential and resolves the matching principals.",{"_3587":609,"_30795":542,"_21329":52256,"_5":14664,"_27997":52048,"_3043":52257},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3587":610,"_30795":542,"_21329":52259,"_5":14664,"_27997":52048,"_3043":52260},[],"`authz` gathers the entity rules of the granted policies.",{"_3587":611,"_30795":542,"_21329":52262,"_5":14664,"_27997":52048,"_3043":52263},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3587":612,"_30795":542,"_21329":52265,"_5":14664,"_27997":52048,"_3043":52266},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3587":613,"_30795":542,"_21329":52268,"_5":14664,"_27997":52048,"_3043":52269},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3587":614,"_30795":542,"_21329":52271,"_5":14664,"_27997":52048,"_3043":52272},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3587":615,"_30795":542,"_21329":52274,"_5":14664,"_27997":52048,"_3043":52275},[],"Actions fall into two groups:",{"_3587":616,"_30795":542,"_21329":52277,"_5":14664,"_27997":52048,"_3043":52278},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3587":617,"_30795":542,"_21329":52280,"_5":14664,"_27997":52048,"_3043":52281},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3587":618,"_30795":542,"_21329":52283,"_5":14664,"_27997":52048,"_3043":52284},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3587":619,"_30795":542,"_21329":52286,"_5":14664,"_27997":52052,"_3043":52287},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3587":620,"_30795":542,"_21329":52289,"_5":14664,"_27997":52052,"_3043":52290},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3587":621,"_30795":542,"_21329":52292,"_5":14664,"_27997":52052,"_3043":52293},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3587":622,"_30795":542,"_21329":52295,"_5":14664,"_27997":52056,"_3043":52296},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3587":623,"_30795":542,"_21329":52298,"_5":14664,"_27997":52056,"_3043":52299},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3587":624,"_30795":542,"_21329":52301,"_5":14664,"_27997":52056,"_3043":52302},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3587":625,"_30795":542,"_21329":52304,"_5":14664,"_27997":52056,"_3043":52305},[],"The implemented operators are:",{"_3587":626,"_30795":542,"_21329":52307,"_5":14664,"_27997":52056,"_3043":52308},[],"`equals`, for exact equality;",{"_3587":627,"_30795":542,"_21329":52310,"_5":14664,"_27997":52056,"_3043":52311},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3587":628,"_30795":542,"_21329":52313,"_5":14664,"_27997":52056,"_3043":52314},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3587":629,"_30795":542,"_21329":52316,"_5":14664,"_27997":52056,"_3043":52317},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3587":630,"_30795":542,"_21329":52319,"_5":14664,"_27997":52060,"_3043":52320},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3587":631,"_30795":542,"_21329":52322,"_5":14664,"_27997":52060,"_3043":52323},[],"The available modes are:",{"_3587":632,"_30795":542,"_21329":52325,"_5":14664,"_27997":52060,"_3043":52326},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3587":633,"_30795":542,"_21329":52328,"_5":14664,"_27997":52060,"_3043":52329},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3587":634,"_30795":542,"_21329":52331,"_5":14664,"_27997":52060,"_3043":52332},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3587":635,"_30795":542,"_21329":52334,"_5":14664,"_27997":52060,"_3043":52335},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3587":636,"_30795":542,"_21329":52337,"_5":14664,"_27997":52060,"_3043":52338},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3587":637,"_30795":542,"_21329":52340,"_5":14664,"_27997":52060,"_3043":52341},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3587":638,"_30795":542,"_21329":52343,"_5":14664,"_27997":52064,"_3043":52344},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3587":639,"_30795":542,"_21329":52346,"_5":14664,"_27997":52064,"_3043":52347},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3587":640,"_30795":542,"_21329":52349,"_5":14664,"_27997":52064,"_3043":52350},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3587":641,"_30795":542,"_21329":52352,"_5":14664,"_27997":52064,"_3043":52353},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3587":642,"_30795":542,"_21329":52355,"_5":14664,"_27997":52072,"_3043":52356},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3587":643,"_30795":542,"_21329":52358,"_5":14664,"_27997":52072,"_3043":52359},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3587":644,"_30795":542,"_21329":52361,"_5":14664,"_27997":52076,"_3043":52362},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3587":645,"_30795":542,"_21329":52364,"_5":14664,"_27997":52076,"_3043":52365},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3587":646,"_30795":542,"_21329":52367,"_5":14664,"_27997":52076,"_3043":52368},[],"The data model shows how the resources used in entity rules are connected.",{"_3587":647,"_30795":542,"_21329":52370,"_5":14664,"_27997":52076,"_3043":52371},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3587":648,"_30795":542,"_21329":52373,"_5":14664,"_27997":52076,"_3043":52374},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3587":649,"_30795":542,"_21329":52376,"_5":14664,"_27997":52080,"_3043":52377},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3587":650,"_30795":542,"_21329":52379,"_5":14664,"_27997":52080,"_3043":52380},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3587":651,"_30795":542,"_21329":52382,"_5":14664,"_27997":52080,"_3043":52383},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3587":652,"_30795":542,"_21329":52385,"_5":14664,"_27997":52084,"_3043":52386},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3587":653,"_30795":542,"_21329":52388,"_5":14664,"_27997":52084,"_3043":52389},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3587":654,"_30795":542,"_21329":52391,"_5":14664,"_27997":52084,"_3043":52392},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3587":655,"_30795":542,"_21329":52394,"_5":14664,"_27997":52084,"_3043":52395},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3587":656,"_30795":542,"_21329":52397,"_5":14664,"_27997":52084,"_3043":52398},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3587":657,"_30795":542,"_21329":52400,"_5":14664,"_27997":52084,"_3043":52401},[],"Note that:",{"_3587":658,"_30795":542,"_21329":52403,"_5":14664,"_27997":52084,"_3043":52404},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3587":659,"_30795":542,"_21329":52406,"_5":14664,"_27997":52084,"_3043":52407},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3587":660,"_30795":542,"_21329":52409,"_5":14664,"_27997":52084,"_3043":52410},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3587":661,"_30795":542,"_21329":52412,"_5":14664,"_27997":52088,"_3043":52413},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3587":662,"_30795":542,"_21329":52415,"_5":14664,"_27997":52088,"_3043":52416},[],"full and read-only access to certificates and authorities;",{"_3587":663,"_30795":542,"_21329":52418,"_5":14664,"_27997":52088,"_3043":52419},[],"full and read-only access to the KMS;",{"_3587":664,"_30795":542,"_21329":52421,"_5":14664,"_27997":52088,"_3043":52422},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3587":665,"_30795":542,"_21329":52424,"_5":14664,"_27997":52088,"_3043":52425},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3587":666,"_30795":542,"_21329":52427,"_5":14664,"_27997":52088,"_3043":52428},[],"console access;",{"_3587":667,"_30795":542,"_21329":52430,"_5":14664,"_27997":52088,"_3043":52431},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3587":668,"_30795":542,"_21329":52433,"_5":14664,"_27997":52088,"_3043":52434},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3587":669,"_30795":542,"_21329":52436,"_5":14664,"_27997":52088,"_3043":52437},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3587":670,"_30795":542,"_21329":52439,"_5":14664,"_27997":52092,"_3043":52440},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3587":671,"_30795":542,"_21329":52442,"_5":14664,"_27997":52092,"_3043":52443},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3587":672,"_30795":542,"_21329":52445,"_5":14664,"_27997":52092,"_3043":52446},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3587":673,"_30795":542,"_21329":52448,"_5":14664,"_27997":52095,"_3043":52449},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3587":674,"_30795":542,"_21329":52451,"_5":14664,"_27997":52099,"_3043":52452},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3587":675,"_30795":542,"_21329":52454,"_5":14664,"_27997":52099,"_3043":52455},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3587":676,"_30795":542,"_21329":52457,"_5":14664,"_27997":52103,"_3043":52458},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3587":677,"_30795":542,"_21329":52460,"_5":14664,"_27997":52107,"_3043":52461},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3587":678,"_30795":542,"_21329":52463,"_5":14664,"_27997":52111,"_3043":52464},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3587":679,"_30795":542,"_21329":52466,"_5":14664,"_27997":52115,"_3043":52467},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3587":680,"_30795":542,"_21329":52469,"_5":14664,"_27997":52115,"_3043":52470},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3587":681,"_30795":542,"_21329":52472,"_5":14664,"_27997":52119,"_3043":52473},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3587":682,"_30795":542,"_21329":52475,"_5":14664,"_27997":52119,"_3043":52476},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3587":683,"_30795":542,"_21329":52478,"_5":14664,"_27997":52119,"_3043":52479},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3587":684,"_30795":542,"_21329":52481,"_5":14664,"_27997":52119,"_3043":52482},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3587":685,"_30795":542,"_21329":52484,"_5":14664,"_27997":52119,"_3043":52485},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3587":686,"_30795":542,"_21329":52487,"_5":14664,"_27997":52119,"_3043":52488},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3587":687,"_30795":542,"_21329":52490,"_5":14664,"_27997":52119,"_3043":52491},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3587":688,"_30795":542,"_21329":52493,"_5":14664,"_27997":52119,"_3043":52494},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3587":689,"_30795":542,"_21329":52496,"_5":14664,"_27997":52123,"_3043":52497},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3587":690,"_30795":542,"_21329":52499,"_5":14664,"_27997":52123,"_3043":52500},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3587":691,"_30795":542,"_21329":52502,"_5":14664,"_27997":52123,"_3043":52503},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3587":692,"_30795":542,"_21329":52505,"_5":14664,"_27997":52127,"_3043":52506},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3587":693,"_30795":542,"_21329":52508,"_5":14664,"_27997":52127,"_3043":52509},[],"Use groups or stable roles for people and independent identities for automations.",{"_3587":694,"_30795":542,"_21329":52511,"_5":14664,"_27997":52127,"_3043":52512},[],"Keep at least two recovery administrators and test their access periodically.",{"_3587":695,"_30795":542,"_21329":52514,"_5":14664,"_27997":52127,"_3043":52515},[],"Review active principals, their matches and their grants after IdP changes.",{"_3587":696,"_30795":542,"_21329":52517,"_5":14664,"_27997":52127,"_3043":52518},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3587":697,"_30795":542,"_21329":52520,"_5":14664,"_27997":52127,"_3043":52521},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3587":698,"_30795":542,"_21329":52523,"_5":14664,"_27997":52127,"_3043":52524},[],"Always test one allowed and one denied operation for each role.",{"_3587":699,"_30795":542,"_21329":52526,"_5":14664,"_27997":52127,"_3043":52527},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3587":700,"_30795":542,"_21329":52529,"_5":14664,"_27997":52135,"_3043":52530},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3587":701,"_30795":542,"_21329":52532,"_5":14664,"_27997":52139,"_3043":52533},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3587":702,"_30795":542,"_21329":52535,"_5":14664,"_27997":52139,"_3043":52536},[],"that an active principal of the correct type exists;",{"_3587":703,"_30795":542,"_21329":52538,"_5":14664,"_27997":52139,"_3043":52539},[],"that the claim paths and values match the real token exactly;",{"_3587":704,"_30795":542,"_21329":52541,"_5":14664,"_27997":52139,"_3043":52542},[],"that all of the principal's conditions hold;",{"_3587":705,"_30795":542,"_21329":52544,"_5":14664,"_27997":52139,"_3043":52545},[],"that the principal has the expected policy granted;",{"_3587":706,"_30795":542,"_21329":52547,"_5":14664,"_27997":52139,"_3043":52548},[],"that the policy includes the action and the requested resource type or route;",{"_3587":707,"_30795":542,"_21329":52550,"_5":14664,"_27997":52139,"_3043":52551},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3587":708,"_30795":542,"_21329":52553,"_5":14664,"_27997":52139,"_3043":52554},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3587":709,"_30795":542,"_21329":52556,"_5":14664,"_27997":52139,"_3043":52557},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3587":710,"_30795":542,"_21329":52559,"_5":14664,"_27997":52143,"_3043":52560},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3587":711,"_30795":542,"_21329":52562,"_5":14664,"_27997":52147,"_3043":52563},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3587":712,"_30795":542,"_21329":52565,"_5":14664,"_27997":52151,"_3043":52566},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3587":713,"_30795":542,"_21329":52568,"_5":14664,"_27997":52151,"_3043":52569},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3587":714,"_30795":714,"_5":15024,"_3043":52571,"_31154":52572,"_21329":52573,"_27997":714},"Alerts and subscriptions",[50381,51893,51894],[],{"_3587":715,"_30795":714,"_21329":52575,"_5":14664,"_27997":714,"_3043":52576},[],"Send PKI events to people and external systems.",{"_3587":716,"_30795":714,"_5":31151,"_21329":52578,"_27997":52579,"_3043":52580},[],"/docs/pr-preview/pr-70/platform/administration/alerts#how-it-works","How it works",{"_3587":717,"_30795":714,"_5":31151,"_21329":52582,"_27997":52583,"_3043":52584},[],"/docs/pr-preview/pr-70/platform/administration/alerts#available-channels","Available channels",{"_3587":718,"_30795":714,"_5":31151,"_21329":52586,"_27997":52587,"_3043":52588},[],"/docs/pr-preview/pr-70/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3587":719,"_30795":714,"_5":31151,"_21329":52590,"_27997":52591,"_3043":52592},[],"/docs/pr-preview/pr-70/platform/administration/alerts#choose-the-event","Choose the event",{"_3587":720,"_30795":714,"_5":31151,"_21329":52594,"_27997":52595,"_3043":52596},[],"/docs/pr-preview/pr-70/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3587":721,"_30795":714,"_5":31151,"_21329":52598,"_27997":52599,"_3043":52600},[],"/docs/pr-preview/pr-70/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3587":722,"_30795":714,"_5":31151,"_21329":52602,"_27997":52603,"_3043":52604},[],"/docs/pr-preview/pr-70/platform/administration/alerts#review-and-activate","Review and activate",{"_3587":723,"_30795":714,"_5":31151,"_21329":52606,"_27997":52607,"_3043":52608},[],"/docs/pr-preview/pr-70/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3587":724,"_30795":714,"_5":31151,"_21329":52610,"_27997":52611,"_3043":52612},[],"/docs/pr-preview/pr-70/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3587":725,"_30795":714,"_5":31151,"_21329":52614,"_27997":52615,"_3043":52616},[],"/docs/pr-preview/pr-70/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3587":726,"_30795":714,"_5":31151,"_21329":52618,"_27997":52619,"_3043":52620},[],"/docs/pr-preview/pr-70/platform/administration/alerts#event-families","Event families",{"_3587":727,"_30795":714,"_21329":52622,"_5":14664,"_27997":714,"_3043":52623},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3587":728,"_30795":714,"_21329":52625,"_5":14664,"_27997":52579,"_3043":52626},[],"A service publishes a domain event.",{"_3587":729,"_30795":714,"_21329":52628,"_5":14664,"_27997":52579,"_3043":52629},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3587":730,"_30795":714,"_21329":52631,"_5":14664,"_27997":52579,"_3043":52632},[],"Each subscription's filter decides whether it should be notified.",{"_3587":731,"_30795":714,"_21329":52634,"_5":14664,"_27997":52579,"_3043":52635},[],"Lamassu delivers the event to the configured channel.",{"_3587":732,"_30795":714,"_21329":52637,"_5":14664,"_27997":52579,"_3043":52638},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3587":733,"_30795":714,"_21329":52640,"_5":14664,"_27997":52583,"_3043":52641},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3587":734,"_30795":714,"_21329":52643,"_5":14664,"_27997":52583,"_3043":52644},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3587":735,"_30795":714,"_21329":52646,"_5":14664,"_27997":52583,"_3043":52647},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3587":736,"_30795":714,"_21329":52649,"_5":14664,"_27997":52583,"_3043":52650},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3587":737,"_30795":714,"_21329":52652,"_5":14664,"_27997":52583,"_3043":52653},[],"`apikey_options` requires `header` and `key`.",{"_3587":738,"_30795":714,"_21329":52655,"_5":14664,"_27997":52583,"_3043":52656},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3587":739,"_30795":714,"_21329":52658,"_5":14664,"_27997":52583,"_3043":52659},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3587":740,"_30795":714,"_21329":52661,"_5":14664,"_27997":52583,"_3043":52662},[],"The alerts API reference documents the full `http_client` schema.",{"_3587":741,"_30795":714,"_21329":52664,"_5":14664,"_27997":52591,"_3043":52665},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3587":742,"_30795":714,"_21329":52667,"_5":14664,"_27997":52595,"_3043":52668},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3587":743,"_30795":714,"_21329":52670,"_5":14664,"_27997":52599,"_3043":52671},[],"Add a filter if you don't want to receive every instance of the event.",{"_3587":744,"_30795":714,"_21329":52673,"_5":14664,"_27997":52599,"_3043":52674},[],"**None** notifies all instances of the event.",{"_3587":745,"_30795":714,"_21329":52676,"_5":14664,"_27997":52599,"_3043":52677},[],"**JSON Path** evaluates one or more specific fields.",{"_3587":746,"_30795":714,"_21329":52679,"_5":14664,"_27997":52599,"_3043":52680},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3587":747,"_30795":714,"_21329":52682,"_5":14664,"_27997":52599,"_3043":52683},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3587":748,"_30795":714,"_21329":52685,"_5":14664,"_27997":52599,"_3043":52686},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3587":749,"_30795":714,"_21329":52688,"_5":14664,"_27997":52599,"_3043":52689},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3587":750,"_30795":714,"_21329":52691,"_5":14664,"_27997":52603,"_3043":52692},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3587":751,"_30795":714,"_21329":52694,"_5":14664,"_27997":52607,"_3043":52695},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3587":752,"_30795":714,"_21329":52697,"_5":14664,"_27997":52607,"_3043":52698},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3587":753,"_30795":714,"_21329":52700,"_5":14664,"_27997":52607,"_3043":52701},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3587":754,"_30795":714,"_21329":52703,"_5":14664,"_27997":52607,"_3043":52704},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3587":755,"_30795":714,"_21329":52706,"_5":14664,"_27997":52607,"_3043":52707},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3587":756,"_30795":714,"_21329":52709,"_5":14664,"_27997":52607,"_3043":52710},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3587":757,"_30795":714,"_21329":52712,"_5":14664,"_27997":52607,"_3043":52713},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3587":758,"_30795":714,"_21329":52715,"_5":14664,"_27997":52607,"_3043":52716},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3587":759,"_30795":714,"_21329":52718,"_5":14664,"_27997":52611,"_3043":52719},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3587":760,"_30795":714,"_21329":52721,"_5":14664,"_27997":52611,"_3043":52722},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3587":761,"_30795":714,"_21329":52724,"_5":14664,"_27997":52611,"_3043":52725},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3587":762,"_30795":714,"_21329":52727,"_5":14664,"_27997":52611,"_3043":52728},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3587":763,"_30795":714,"_21329":52730,"_5":14664,"_27997":52611,"_3043":52731},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3587":764,"_30795":714,"_21329":52733,"_5":14664,"_27997":52611,"_3043":52734},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3587":765,"_30795":714,"_21329":52736,"_5":14664,"_27997":52611,"_3043":52737},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3587":766,"_30795":714,"_21329":52739,"_5":14664,"_27997":52611,"_3043":52740},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3587":767,"_30795":714,"_21329":52742,"_5":14664,"_27997":52615,"_3043":52743},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3587":768,"_30795":714,"_21329":52745,"_5":14664,"_27997":52615,"_3043":52746},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3587":769,"_30795":714,"_21329":52748,"_5":14664,"_27997":52619,"_3043":52749},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3587":770,"_30795":714,"_21329":52751,"_5":14664,"_27997":52619,"_3043":52752},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3587":771,"_30795":714,"_21329":52754,"_5":14664,"_27997":52619,"_3043":52755},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3587":772,"_30795":714,"_21329":52757,"_5":14664,"_27997":52619,"_3043":52758},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3587":773,"_30795":714,"_21329":52760,"_5":14664,"_27997":52619,"_3043":52761},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3587":774,"_30795":714,"_21329":52763,"_5":14664,"_27997":52619,"_3043":52764},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3587":775,"_30795":714,"_21329":52766,"_5":14664,"_27997":52619,"_3043":52767},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3587":776,"_30795":714,"_21329":52769,"_5":14664,"_27997":52619,"_3043":52770},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3587":777,"_30795":714,"_21329":52772,"_5":14664,"_27997":52619,"_3043":52773},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3587":778,"_30795":714,"_21329":52775,"_5":14664,"_27997":52619,"_3043":52776},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3587":779,"_30795":779,"_5":15024,"_3043":52778,"_31154":52779,"_21329":52780,"_27997":779},"Audit logs",[50381,51893,51894],[],{"_3587":780,"_30795":779,"_21329":52782,"_5":14664,"_27997":779,"_3043":52783},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3587":781,"_30795":779,"_5":31151,"_21329":52785,"_27997":52786,"_3043":52787},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3587":782,"_30795":779,"_5":31151,"_21329":52789,"_27997":52790,"_3043":52791},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#coverage","Coverage",{"_3587":783,"_30795":779,"_5":31151,"_21329":52793,"_27997":52794,"_3043":52795},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3587":784,"_30795":779,"_5":31151,"_21329":52797,"_27997":52798,"_3043":52799},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3587":785,"_30795":779,"_5":31151,"_21329":52801,"_27997":52802,"_3043":52803},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3587":786,"_30795":779,"_5":31151,"_21329":52805,"_27997":52806,"_3043":52807},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3587":787,"_30795":779,"_5":31151,"_21329":52809,"_27997":52810,"_3043":52811},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3587":788,"_30795":779,"_5":31151,"_21329":52813,"_27997":52814,"_3043":52815},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3587":789,"_30795":779,"_5":31151,"_21329":52817,"_27997":52818,"_3043":52819},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3587":790,"_30795":779,"_5":31151,"_21329":52821,"_27997":52822,"_3043":52823},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3587":791,"_30795":779,"_5":31151,"_21329":52825,"_27997":52826,"_3043":52827},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3587":792,"_30795":779,"_21329":52829,"_5":14664,"_27997":779,"_3043":52830},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3587":793,"_30795":779,"_21329":52832,"_5":14664,"_27997":52786,"_3043":52833},[],"The audit body includes:",{"_3587":794,"_30795":779,"_21329":52835,"_5":14664,"_27997":52786,"_3043":52836},[],"input: data received by the operation;",{"_3587":795,"_30795":779,"_21329":52838,"_5":14664,"_27997":52786,"_3043":52839},[],"has\\_error: whether the service returned an error;",{"_3587":796,"_30795":779,"_21329":52841,"_5":14664,"_27997":52786,"_3043":52842},[],"output: produced result or error message;",{"_3587":797,"_30795":779,"_21329":52844,"_5":14664,"_27997":52786,"_3043":52845},[],"principals: identifiers of the principals that matched the request.",{"_3587":798,"_30795":779,"_21329":52847,"_5":14664,"_27997":52786,"_3043":52848},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3587":799,"_30795":779,"_21329":52850,"_5":14664,"_27997":52786,"_3043":52851},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3587":800,"_30795":779,"_21329":52853,"_5":14664,"_27997":52790,"_3043":52854},[],"The backend applies auditing to mutations of:",{"_3587":801,"_30795":779,"_21329":52856,"_5":14664,"_27997":52790,"_3043":52857},[],"authorities, certificates and issuance profiles;",{"_3587":802,"_30795":779,"_21329":52859,"_5":14664,"_27997":52790,"_3043":52860},[],"keys and KMS engines;",{"_3587":803,"_30795":779,"_21329":52862,"_5":14664,"_27997":52790,"_3043":52863},[],"devices and identities;",{"_3587":804,"_30795":779,"_21329":52865,"_5":14664,"_27997":52790,"_3043":52866},[],"DMSs and enrollment operations;",{"_3587":805,"_30795":779,"_21329":52868,"_5":14664,"_27997":52790,"_3043":52869},[],"validation functions and CRL;",{"_3587":806,"_30795":779,"_21329":52871,"_5":14664,"_27997":52790,"_3043":52872},[],"principals, policies and authorization grants.",{"_3587":807,"_30795":779,"_21329":52874,"_5":14664,"_27997":52790,"_3043":52875},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3587":808,"_30795":779,"_21329":52877,"_5":14664,"_27997":52794,"_3043":52878},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3587":809,"_30795":779,"_21329":52880,"_5":14664,"_27997":52794,"_3043":52881},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3587":810,"_30795":779,"_21329":52883,"_5":14664,"_27997":52794,"_3043":52884},[],"Design the consumer to:",{"_3587":811,"_30795":779,"_21329":52886,"_5":14664,"_27997":52794,"_3043":52887},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3587":812,"_30795":779,"_21329":52889,"_5":14664,"_27997":52794,"_3043":52890},[],"keep the complete CloudEvent unmodified;",{"_3587":813,"_30795":779,"_21329":52892,"_5":14664,"_27997":52794,"_3043":52893},[],"record the ingestion time and detect duplicates by ID;",{"_3587":814,"_30795":779,"_21329":52895,"_5":14664,"_27997":52794,"_3043":52896},[],"encrypt in transit and at rest;",{"_3587":815,"_30795":779,"_21329":52898,"_5":14664,"_27997":52794,"_3043":52899},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3587":816,"_30795":779,"_21329":52901,"_5":14664,"_27997":52794,"_3043":52902},[],"apply an explicit retention and legal hold policy;",{"_3587":817,"_30795":779,"_21329":52904,"_5":14664,"_27997":52794,"_3043":52905},[],"alert if it stops consuming or the pending queue grows.",{"_3587":818,"_30795":779,"_21329":52907,"_5":14664,"_27997":52798,"_3043":52908},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3587":819,"_30795":779,"_21329":52910,"_5":14664,"_27997":52798,"_3043":52911},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3587":820,"_30795":779,"_21329":52913,"_5":14664,"_27997":52806,"_3043":52914},[],"Start from the reported time and normalize every source to UTC.",{"_3587":821,"_30795":779,"_21329":52916,"_5":14664,"_27997":52810,"_3043":52917},[],"Filter by event type, service source and resource identifier.",{"_3587":822,"_30795":779,"_21329":52919,"_5":14664,"_27997":52814,"_3043":52920},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3587":823,"_30795":779,"_21329":52922,"_5":14664,"_27997":52818,"_3043":52923},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3587":824,"_30795":779,"_21329":52925,"_5":14664,"_27997":52822,"_3043":52926},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3587":825,"_30795":779,"_21329":52928,"_5":14664,"_27997":52826,"_3043":52929},[],"Generate a controlled mutation in a test environment and check that:",{"_3587":826,"_30795":779,"_21329":52931,"_5":14664,"_27997":52826,"_3043":52932},[],"a successful audit event appears;",{"_3587":827,"_30795":779,"_21329":52934,"_5":14664,"_27997":52826,"_3043":52935},[],"the principal matches the identity used;",{"_3587":828,"_30795":779,"_21329":52937,"_5":14664,"_27997":52826,"_3043":52938},[],"the consumer persists it exactly once;",{"_3587":829,"_30795":779,"_21329":52940,"_5":14664,"_27997":52826,"_3043":52941},[],"it can be retrieved by resource, actor and period;",{"_3587":830,"_30795":779,"_21329":52943,"_5":14664,"_27997":52826,"_3043":52944},[],"a consumer outage raises an alert.",{"_3587":831,"_30795":779,"_21329":52946,"_5":14664,"_27997":52826,"_3043":52947},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3587":832,"_30795":832,"_5":15024,"_3043":52949,"_31154":52950,"_21329":52951,"_27997":832},"Platform architecture",[50381,51893],[],{"_3587":833,"_30795":832,"_21329":52953,"_5":14664,"_27997":832,"_3043":52954},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3587":834,"_30795":832,"_5":31151,"_21329":52956,"_27997":52957,"_3043":52958},[],"/docs/pr-preview/pr-70/platform/concepts/architecture#control-plane","Control plane",{"_3587":835,"_30795":832,"_5":31151,"_21329":52960,"_27997":52961,"_3043":52962},[],"/docs/pr-preview/pr-70/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3587":836,"_30795":832,"_5":31151,"_21329":52964,"_27997":52965,"_3043":52966},[],"/docs/pr-preview/pr-70/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3587":837,"_30795":832,"_5":31151,"_21329":52968,"_27997":52969,"_3043":52970},[],"/docs/pr-preview/pr-70/platform/concepts/architecture#status-and-validation","Status and validation",{"_3587":838,"_30795":832,"_5":31151,"_21329":52972,"_27997":52973,"_3043":52974},[],"/docs/pr-preview/pr-70/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3587":839,"_30795":832,"_21329":52976,"_5":14664,"_27997":832,"_3043":52977},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3587":840,"_30795":832,"_21329":52979,"_5":14664,"_27997":832,"_3043":52980},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3587":841,"_30795":832,"_21329":52982,"_5":14664,"_27997":52957,"_3043":52983},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3587":842,"_30795":832,"_21329":52985,"_5":14664,"_27997":52961,"_3043":52986},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3587":843,"_30795":832,"_21329":52988,"_5":14664,"_27997":52965,"_3043":52989},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3587":844,"_30795":832,"_21329":52991,"_5":14664,"_27997":52969,"_3043":52992},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3587":845,"_30795":832,"_21329":52994,"_5":14664,"_27997":52973,"_3043":52995},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3587":846,"_30795":846,"_5":15024,"_3043":52997,"_31154":52998,"_21329":52999,"_27997":846},"How Lamassu works",[50381,51893],[],{"_3587":847,"_30795":846,"_21329":53001,"_5":14664,"_27997":846,"_3043":53002},[],"The mental model of trust, keys, certificates and devices.",{"_3587":848,"_30795":846,"_5":31151,"_21329":53004,"_27997":53005,"_3043":53006},[],"/docs/pr-preview/pr-70/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3587":849,"_30795":846,"_5":31151,"_21329":53008,"_27997":53009,"_3043":53010},[],"/docs/pr-preview/pr-70/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3587":850,"_30795":846,"_21329":53012,"_5":14664,"_27997":846,"_3043":53013},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3587":851,"_30795":846,"_21329":53015,"_5":14664,"_27997":53005,"_3043":53016},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3587":852,"_30795":846,"_21329":53018,"_5":14664,"_27997":53005,"_3043":53019},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3587":853,"_30795":846,"_21329":53021,"_5":14664,"_27997":53005,"_3043":53022},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3587":854,"_30795":846,"_21329":53024,"_5":14664,"_27997":53005,"_3043":53025},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3587":855,"_30795":846,"_21329":53027,"_5":14664,"_27997":53005,"_3043":53028},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3587":856,"_30795":846,"_21329":53030,"_5":14664,"_27997":53009,"_3043":53031},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3587":857,"_30795":846,"_21329":53033,"_5":14664,"_27997":53009,"_3043":53034},[],"A DMS relates that CA to an enrollment policy.",{"_3587":858,"_30795":846,"_21329":53036,"_5":14664,"_27997":53009,"_3043":53037},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3587":859,"_30795":846,"_21329":53039,"_5":14664,"_27997":53009,"_3043":53040},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3587":860,"_30795":846,"_21329":53042,"_5":14664,"_27997":53009,"_3043":53043},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3587":861,"_30795":846,"_21329":53045,"_5":14664,"_27997":53009,"_3043":53046},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3587":862,"_30795":846,"_21329":53048,"_5":14664,"_27997":53009,"_3043":53049},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3587":863,"_30795":863,"_5":15024,"_3043":53051,"_31154":53052,"_21329":53054,"_27997":863},"Devices and identities",[50381,51893,53053,53051],"IoT Fleets",[],{"_3587":864,"_30795":863,"_21329":53056,"_5":14664,"_27997":863,"_3043":53057},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3587":865,"_30795":863,"_5":31151,"_21329":53059,"_27997":53060,"_3043":53061},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#device-states","Device states",{"_3587":866,"_30795":863,"_5":31151,"_21329":53063,"_27997":53064,"_3043":53065},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3587":867,"_30795":863,"_5":31151,"_21329":53067,"_27997":53068,"_3043":53069},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3587":868,"_30795":863,"_5":31151,"_21329":53071,"_27997":53072,"_3043":53073},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3587":869,"_30795":863,"_5":31151,"_21329":53075,"_27997":53076,"_3043":53077},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3587":870,"_30795":863,"_5":31151,"_21329":53079,"_27997":53080,"_3043":53081},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3587":871,"_30795":863,"_5":31151,"_21329":53083,"_27997":53084,"_3043":53085},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3587":872,"_30795":863,"_5":31151,"_21329":53087,"_27997":53088,"_3043":53089},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3587":873,"_30795":863,"_5":31151,"_21329":53091,"_27997":53092,"_3043":53093},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3587":874,"_30795":863,"_5":31151,"_21329":53095,"_27997":53096,"_3043":53097},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3587":875,"_30795":863,"_5":31151,"_21329":53099,"_27997":53100,"_3043":53101},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3587":876,"_30795":863,"_21329":53103,"_5":14664,"_27997":863,"_3043":53104},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3587":877,"_30795":863,"_21329":53106,"_5":14664,"_27997":863,"_3043":53107},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3587":878,"_30795":863,"_21329":53109,"_5":14664,"_27997":53060,"_3043":53110},[],"Operational view",{"_3587":879,"_30795":863,"_21329":53112,"_5":14664,"_27997":53060,"_3043":53113},[],"Meaning",{"_3587":880,"_30795":863,"_21329":53115,"_5":14664,"_27997":53060,"_3043":53116},[],"**No Identity**",{"_3587":881,"_30795":863,"_21329":53118,"_5":14664,"_27997":53060,"_3043":53119},[],"A record exists without an associated identity.",{"_3587":882,"_30795":863,"_21329":53121,"_5":14664,"_27997":53060,"_3043":53122},[],"**Active**",{"_3587":883,"_30795":863,"_21329":53124,"_5":14664,"_27997":53060,"_3043":53125},[],"The slot is active; also check certificate dates, status and usages.",{"_3587":884,"_30795":863,"_21329":53127,"_5":14664,"_27997":53060,"_3043":53128},[],"**Renewal Pending**",{"_3587":885,"_30795":863,"_21329":53130,"_5":14664,"_27997":53060,"_3043":53131},[],"The identity is in the operational renewal window.",{"_3587":886,"_30795":863,"_21329":53133,"_5":14664,"_27997":53060,"_3043":53134},[],"**Expiring Soon**",{"_3587":887,"_30795":863,"_21329":53136,"_5":14664,"_27997":53060,"_3043":53137},[],"Expiration is approaching according to configured thresholds.",{"_3587":888,"_30795":863,"_21329":53139,"_5":14664,"_27997":53060,"_3043":53140},[],"**Expired**",{"_3587":889,"_30795":863,"_21329":53142,"_5":14664,"_27997":53060,"_3043":53143},[],"The identity has expired.",{"_3587":890,"_30795":863,"_21329":53145,"_5":14664,"_27997":53060,"_3043":53146},[],"**Revoked**",{"_3587":891,"_30795":863,"_21329":53148,"_5":14664,"_27997":53060,"_3043":53149},[],"The identity is marked revoked.",{"_3587":892,"_30795":863,"_21329":53151,"_5":14664,"_27997":53060,"_3043":53152},[],"**Decommissioned**",{"_3587":893,"_30795":863,"_21329":53154,"_5":14664,"_27997":53060,"_3043":53155},[],"The record is retired and ordinary updates do not restore operation.",{"_3587":894,"_30795":863,"_21329":53157,"_5":14664,"_27997":53060,"_3043":53158},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3587":895,"_30795":863,"_21329":53160,"_5":14664,"_27997":53064,"_3043":53161},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3587":896,"_30795":863,"_21329":53163,"_5":14664,"_27997":53064,"_3043":53164},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3587":897,"_30795":863,"_21329":53166,"_5":14664,"_27997":53064,"_3043":53167},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3587":898,"_30795":863,"_21329":53169,"_5":14664,"_27997":53064,"_3043":53170},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3587":899,"_30795":863,"_21329":53172,"_5":14664,"_27997":53068,"_3043":53173},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3587":900,"_30795":863,"_21329":53175,"_5":14664,"_27997":53072,"_3043":53176},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3587":901,"_30795":863,"_21329":53178,"_5":14664,"_27997":53076,"_3043":53179},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3587":902,"_30795":863,"_21329":53181,"_5":14664,"_27997":53080,"_3043":53182},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3587":903,"_30795":863,"_21329":53184,"_5":14664,"_27997":53084,"_3043":53185},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3587":904,"_30795":863,"_21329":53187,"_5":14664,"_27997":53084,"_3043":53188},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3587":905,"_30795":863,"_21329":53190,"_5":14664,"_27997":53088,"_3043":53191},[],"From **No Identity**, use **Assign Identity**:",{"_3587":906,"_30795":863,"_21329":53193,"_5":14664,"_27997":53088,"_3043":53194},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3587":907,"_30795":863,"_21329":53196,"_5":14664,"_27997":53088,"_3043":53197},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3587":908,"_30795":863,"_21329":53199,"_5":14664,"_27997":53088,"_3043":53200},[],"Confirm and read the serial, active version and history again.",{"_3587":909,"_30795":863,"_21329":53202,"_5":14664,"_27997":53088,"_3043":53203},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3587":910,"_30795":863,"_21329":53205,"_5":14664,"_27997":53088,"_3043":53206},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3587":911,"_30795":863,"_21329":53208,"_5":14664,"_27997":53092,"_3043":53209},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3587":912,"_30795":863,"_21329":53211,"_5":14664,"_27997":53092,"_3043":53212},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3587":913,"_30795":863,"_21329":53214,"_5":14664,"_27997":53096,"_3043":53215},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3587":914,"_30795":863,"_21329":53217,"_5":14664,"_27997":53096,"_3043":53218},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3587":915,"_30795":863,"_21329":53220,"_5":14664,"_27997":53096,"_3043":53221},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3587":916,"_30795":863,"_21329":53223,"_5":14664,"_27997":53096,"_3043":53224},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3587":917,"_30795":863,"_21329":53226,"_5":14664,"_27997":53100,"_3043":53227},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3587":918,"_30795":863,"_21329":53229,"_5":14664,"_27997":53100,"_3043":53230},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3587":919,"_30795":919,"_5":15024,"_3043":53232,"_31154":53233,"_21329":53235,"_27997":919},"Bootstrap identity and authentication",[50381,51893,53053,53051,53234],"Enrollment with PKI",[],{"_3587":920,"_30795":919,"_21329":53237,"_5":14664,"_27997":919,"_3043":53238},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3587":921,"_30795":919,"_5":31151,"_21329":53240,"_27997":53241,"_3043":53242},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3587":922,"_30795":919,"_5":31151,"_21329":53244,"_27997":53245,"_3043":53246},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3587":923,"_30795":919,"_5":31151,"_21329":53248,"_27997":53249,"_3043":53250},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3587":924,"_30795":919,"_5":31151,"_21329":53252,"_27997":53253,"_3043":53254},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3587":925,"_30795":919,"_5":31151,"_21329":53256,"_27997":53257,"_3043":53258},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3587":926,"_30795":919,"_21329":53260,"_5":14664,"_27997":919,"_3043":53261},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3587":927,"_30795":919,"_21329":53263,"_5":14664,"_27997":53241,"_3043":53264},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3587":928,"_30795":919,"_21329":53266,"_5":14664,"_27997":53241,"_3043":53267},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3587":929,"_30795":919,"_21329":53269,"_5":14664,"_27997":53245,"_3043":53270},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3587":930,"_30795":919,"_21329":53272,"_5":14664,"_27997":53245,"_3043":53273},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3587":931,"_30795":919,"_21329":53275,"_5":14664,"_27997":53245,"_3043":53276},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3587":932,"_30795":919,"_21329":53278,"_5":14664,"_27997":53249,"_3043":53279},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3587":933,"_30795":919,"_21329":53281,"_5":14664,"_27997":53249,"_3043":53282},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3587":934,"_30795":919,"_21329":53284,"_5":14664,"_27997":53253,"_3043":53285},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3587":935,"_30795":919,"_21329":53287,"_5":14664,"_27997":53253,"_3043":53288},[],"Example body:",{"_3587":936,"_30795":919,"_21329":53290,"_5":14664,"_27997":53253,"_3043":53291},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3587":937,"_30795":919,"_21329":53293,"_5":14664,"_27997":53253,"_3043":53294},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3587":938,"_30795":919,"_21329":53296,"_5":14664,"_27997":53253,"_3043":53297},[],"Continuation requires a successful HTTP response and JSON:",{"_3587":939,"_30795":919,"_21329":53299,"_5":14664,"_27997":53253,"_3043":53300},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3587":940,"_30795":919,"_21329":53302,"_5":14664,"_27997":53257,"_3043":53303},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3587":941,"_30795":919,"_21329":53305,"_5":14664,"_27997":53257,"_3043":53306},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3587":942,"_30795":942,"_5":15024,"_3043":53308,"_31154":53309,"_21329":53310,"_27997":942},"Configure and operate the DMS",[50381,51893,53053,53051,53234],[],{"_3587":943,"_30795":942,"_21329":53312,"_5":14664,"_27997":942,"_3043":53313},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3587":944,"_30795":942,"_5":31151,"_21329":53315,"_27997":53316,"_3043":50391},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3587":945,"_30795":942,"_5":31151,"_21329":53318,"_27997":53319,"_3043":53320},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3587":946,"_30795":942,"_5":31151,"_21329":53322,"_27997":53323,"_3043":53324},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3587":947,"_30795":942,"_5":31151,"_21329":53326,"_27997":53327,"_3043":53328},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3587":948,"_30795":942,"_5":31151,"_21329":53330,"_27997":53331,"_3043":53332},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3587":949,"_30795":942,"_5":31151,"_21329":53334,"_27997":53335,"_3043":53336},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3587":950,"_30795":942,"_5":31151,"_21329":53338,"_27997":53339,"_3043":53340},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3587":951,"_30795":942,"_5":31151,"_21329":53342,"_27997":53343,"_3043":53344},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3587":952,"_30795":942,"_5":31151,"_21329":53346,"_27997":53347,"_3043":53348},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3587":953,"_30795":942,"_5":31151,"_21329":53350,"_27997":53351,"_3043":53352},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3587":954,"_30795":942,"_5":31151,"_21329":53354,"_27997":53355,"_3043":53356},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3587":955,"_30795":942,"_5":31151,"_21329":53358,"_27997":53359,"_3043":53360},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3587":956,"_30795":942,"_5":31151,"_21329":53362,"_27997":53363,"_3043":53364},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3587":957,"_30795":942,"_5":31151,"_21329":53366,"_27997":53367,"_3043":53368},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3587":958,"_30795":942,"_5":31151,"_21329":53370,"_27997":53371,"_3043":53372},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3587":959,"_30795":942,"_5":31151,"_21329":53374,"_27997":53375,"_3043":53376},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3587":960,"_30795":942,"_5":31151,"_21329":53378,"_27997":53379,"_3043":53380},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3587":961,"_30795":942,"_5":31151,"_21329":53382,"_27997":53383,"_3043":53384},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3587":962,"_30795":942,"_21329":53386,"_5":14664,"_27997":942,"_3043":53387},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3587":963,"_30795":942,"_21329":53389,"_5":14664,"_27997":53316,"_3043":53390},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3587":964,"_30795":942,"_21329":53392,"_5":14664,"_27997":53316,"_3043":53393},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3587":965,"_30795":942,"_21329":53395,"_5":14664,"_27997":53323,"_3043":53396},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3587":966,"_30795":942,"_21329":53398,"_5":14664,"_27997":53327,"_3043":53399},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3587":967,"_30795":942,"_21329":53401,"_5":14664,"_27997":53331,"_3043":53402},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3587":968,"_30795":942,"_21329":53404,"_5":14664,"_27997":53335,"_3043":53405},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3587":969,"_30795":942,"_21329":53407,"_5":14664,"_27997":53339,"_3043":53408},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3587":970,"_30795":942,"_21329":53410,"_5":14664,"_27997":53347,"_3043":53411},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3587":971,"_30795":942,"_21329":53413,"_5":14664,"_27997":53347,"_3043":53414},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3587":972,"_30795":942,"_21329":53416,"_5":14664,"_27997":53351,"_3043":53417},[],"`settings.enrollment_settings` field",{"_3587":973,"_30795":942,"_21329":53419,"_5":14664,"_27997":53351,"_3043":53420},[],"Decision",{"_3587":974,"_30795":942,"_21329":53422,"_5":14664,"_27997":53351,"_3043":53423},[],"`protocol`",{"_3587":975,"_30795":942,"_21329":53425,"_5":14664,"_27997":53351,"_3043":53426},[],"`EST_RFC7030` for these operations.",{"_3587":976,"_30795":942,"_21329":53428,"_5":14664,"_27997":53351,"_3043":53429},[],"`enrollment_ca`",{"_3587":977,"_30795":942,"_21329":53431,"_5":14664,"_27997":53351,"_3043":53432},[],"ID of the signing CA.",{"_3587":978,"_30795":942,"_21329":53434,"_5":14664,"_27997":53351,"_3043":53435},[],"`verify_csr_signature`",{"_3587":979,"_30795":942,"_21329":53437,"_5":14664,"_27997":53351,"_3043":53438},[],"Keep `true` to verify CSR key possession.",{"_3587":980,"_30795":942,"_21329":53440,"_5":14664,"_27997":53351,"_3043":53441},[],"`enable_replaceable_enrollment`",{"_3587":981,"_30795":942,"_21329":53443,"_5":14664,"_27997":53351,"_3043":53444},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3587":982,"_30795":942,"_21329":53446,"_5":14664,"_27997":53351,"_3043":53447},[],"`est_rfc7030_settings.auth_mode`",{"_3587":983,"_30795":942,"_21329":53449,"_5":14664,"_27997":53351,"_3043":53450},[],"One of the four authentication modes.",{"_3587":984,"_30795":942,"_21329":53452,"_5":14664,"_27997":53351,"_3043":53453},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3587":985,"_30795":942,"_21329":53455,"_5":14664,"_27997":53355,"_3043":53456},[],"The blocks are independent:",{"_3587":986,"_30795":942,"_21329":53458,"_5":14664,"_27997":53355,"_3043":53459},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3587":987,"_30795":942,"_21329":53461,"_5":14664,"_27997":53355,"_3043":53462},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3587":988,"_30795":942,"_21329":53464,"_5":14664,"_27997":53355,"_3043":53465},[],"`auth_mode`",{"_3587":989,"_30795":942,"_21329":53467,"_5":14664,"_27997":53355,"_3043":53468},[],"Control applied in the configured operation",{"_3587":990,"_30795":942,"_21329":53470,"_5":14664,"_27997":53355,"_3043":53471},[],"`CLIENT_CERTIFICATE`",{"_3587":991,"_30795":942,"_21329":53473,"_5":14664,"_27997":53355,"_3043":53474},[],"Presented certificate validation.",{"_3587":992,"_30795":942,"_21329":53476,"_5":14664,"_27997":53355,"_3043":53477},[],"`EXTERNAL_WEBHOOK`",{"_3587":993,"_30795":942,"_21329":53479,"_5":14664,"_27997":53355,"_3043":53480},[],"Configured webhook authorization.",{"_3587":994,"_30795":942,"_21329":53482,"_5":14664,"_27997":53355,"_3043":53483},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3587":995,"_30795":942,"_21329":53485,"_5":14664,"_27997":53355,"_3043":53486},[],"Certificate validation followed by webhook approval.",{"_3587":996,"_30795":942,"_21329":53488,"_5":14664,"_27997":53355,"_3043":53489},[],"`NO_AUTH`",{"_3587":997,"_30795":942,"_21329":53491,"_5":14664,"_27997":53355,"_3043":53492},[],"No DMS requester authentication.",{"_3587":998,"_30795":942,"_21329":53494,"_5":14664,"_27997":53355,"_3043":53495},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3587":999,"_30795":942,"_21329":53497,"_5":14664,"_27997":53355,"_3043":53498},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3587":1000,"_30795":942,"_21329":53500,"_5":14664,"_27997":53355,"_3043":53501},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3587":1001,"_30795":942,"_21329":53503,"_5":14664,"_27997":53355,"_3043":53504},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3587":1002,"_30795":942,"_21329":53506,"_5":14664,"_27997":53359,"_3043":53507},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3587":1003,"_30795":942,"_21329":53509,"_5":14664,"_27997":53359,"_3043":53510},[],"`external_webhook_settings` field",{"_3587":1004,"_30795":942,"_21329":53512,"_5":14664,"_27997":53359,"_3043":53420},[],{"_3587":1005,"_30795":942,"_21329":53514,"_5":14664,"_27997":53359,"_3043":53515},[],"`url`",{"_3587":1006,"_30795":942,"_21329":53517,"_5":14664,"_27997":53359,"_3043":53518},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3587":1007,"_30795":942,"_21329":53520,"_5":14664,"_27997":53359,"_3043":53521},[],"`method`",{"_3587":1008,"_30795":942,"_21329":53523,"_5":14664,"_27997":53359,"_3043":53524},[],"`POST` or `PUT`; `POST` by default.",{"_3587":1009,"_30795":942,"_21329":53526,"_5":14664,"_27997":53359,"_3043":53527},[],"`name`",{"_3587":1010,"_30795":942,"_21329":53529,"_5":14664,"_27997":53359,"_3043":53530},[],"Label used in service logs.",{"_3587":1011,"_30795":942,"_21329":53532,"_5":14664,"_27997":53359,"_3043":53533},[],"`config.auth_mode`",{"_3587":1012,"_30795":942,"_21329":53535,"_5":14664,"_27997":53359,"_3043":53536},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3587":1013,"_30795":942,"_21329":53538,"_5":14664,"_27997":53359,"_3043":53539},[],"`config.log_level`",{"_3587":1014,"_30795":942,"_21329":53541,"_5":14664,"_27997":53359,"_3043":53542},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3587":1015,"_30795":942,"_21329":53544,"_5":14664,"_27997":53359,"_3043":53545},[],"`config.apikey_options`",{"_3587":1016,"_30795":942,"_21329":53547,"_5":14664,"_27997":53359,"_3043":53548},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3587":1017,"_30795":942,"_21329":53550,"_5":14664,"_27997":53359,"_3043":53551},[],"`config.jwt_options`",{"_3587":1018,"_30795":942,"_21329":53553,"_5":14664,"_27997":53359,"_3043":53554},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3587":1019,"_30795":942,"_21329":53556,"_5":14664,"_27997":53359,"_3043":53557},[],"`config.mtls_options`",{"_3587":1020,"_30795":942,"_21329":53559,"_5":14664,"_27997":53359,"_3043":53560},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3587":1021,"_30795":942,"_21329":53562,"_5":14664,"_27997":53359,"_3043":53563},[],"`config.insecure_skip_verify`",{"_3587":1022,"_30795":942,"_21329":53565,"_5":14664,"_27997":53359,"_3043":53566},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3587":1023,"_30795":942,"_21329":53568,"_5":14664,"_27997":53359,"_3043":53569},[],"`config.call_timeout`",{"_3587":1024,"_30795":942,"_21329":53571,"_5":14664,"_27997":53359,"_3043":53572},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3587":1025,"_30795":942,"_21329":53574,"_5":14664,"_27997":53359,"_3043":53575},[],"Rules for that configuration:",{"_3587":1026,"_30795":942,"_21329":53577,"_5":14664,"_27997":53359,"_3043":53578},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3587":1027,"_30795":942,"_21329":53580,"_5":14664,"_27997":53359,"_3043":53581},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3587":1028,"_30795":942,"_21329":53583,"_5":14664,"_27997":53359,"_3043":53584},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3587":1029,"_30795":942,"_21329":53586,"_5":14664,"_27997":53359,"_3043":53587},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3587":1030,"_30795":942,"_21329":53589,"_5":14664,"_27997":53359,"_3043":53590},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3587":1031,"_30795":942,"_21329":53592,"_5":14664,"_27997":53359,"_3043":53593},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3587":1032,"_30795":942,"_21329":53595,"_5":14664,"_27997":53359,"_3043":53596},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3587":1033,"_30795":942,"_21329":53598,"_5":14664,"_27997":53359,"_3043":53599},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3587":1034,"_30795":942,"_21329":53601,"_5":14664,"_27997":53359,"_3043":53602},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3587":1035,"_30795":942,"_21329":53604,"_5":14664,"_27997":53363,"_3043":53605},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3587":1036,"_30795":942,"_21329":53607,"_5":14664,"_27997":53367,"_3043":53608},[],"`settings.reenrollment_settings` field",{"_3587":1037,"_30795":942,"_21329":53610,"_5":14664,"_27997":53367,"_3043":50771},[],{"_3587":1038,"_30795":942,"_21329":53612,"_5":14664,"_27997":53367,"_3043":53613},[],"`reenrollment_delta`",{"_3587":1039,"_30795":942,"_21329":53615,"_5":14664,"_27997":53367,"_3043":53616},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3587":1040,"_30795":942,"_21329":53618,"_5":14664,"_27997":53367,"_3043":53619},[],"`preventive_delta`",{"_3587":1041,"_30795":942,"_21329":53621,"_5":14664,"_27997":53367,"_3043":53622},[],"Preventive operational monitoring threshold.",{"_3587":1042,"_30795":942,"_21329":53624,"_5":14664,"_27997":53367,"_3043":53625},[],"`critical_delta`",{"_3587":1043,"_30795":942,"_21329":53627,"_5":14664,"_27997":53367,"_3043":53628},[],"Critical operational monitoring threshold.",{"_3587":1044,"_30795":942,"_21329":53630,"_5":14664,"_27997":53367,"_3043":53631},[],"`enable_expired_renewal`",{"_3587":1045,"_30795":942,"_21329":53633,"_5":14664,"_27997":53367,"_3043":53634},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3587":1046,"_30795":942,"_21329":53636,"_5":14664,"_27997":53367,"_3043":53637},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3587":1047,"_30795":942,"_21329":53639,"_5":14664,"_27997":53367,"_3043":53640},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3587":1048,"_30795":942,"_21329":53642,"_5":14664,"_27997":53367,"_3043":53643},[],"`revoke_on_reenrollment`",{"_3587":1049,"_30795":942,"_21329":53645,"_5":14664,"_27997":53367,"_3043":53646},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3587":1050,"_30795":942,"_21329":53648,"_5":14664,"_27997":53367,"_3043":53649},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3587":1051,"_30795":942,"_21329":53651,"_5":14664,"_27997":53371,"_3043":53652},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3587":1052,"_30795":942,"_21329":53654,"_5":14664,"_27997":53375,"_3043":50765},[],{"_3587":1053,"_30795":942,"_21329":53656,"_5":14664,"_27997":53375,"_3043":53657},[],"Published material",{"_3587":1054,"_30795":942,"_21329":53659,"_5":14664,"_27997":53375,"_3043":53660},[],"**Include Lamassu System CA**",{"_3587":1055,"_30795":942,"_21329":53662,"_5":14664,"_27997":53375,"_3043":53663},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3587":1056,"_30795":942,"_21329":53665,"_5":14664,"_27997":53375,"_3043":53666},[],"**Include Enrollment CA**",{"_3587":1057,"_30795":942,"_21329":53668,"_5":14664,"_27997":53375,"_3043":53669},[],"Selected issuing CA certificate.",{"_3587":1058,"_30795":942,"_21329":53671,"_5":14664,"_27997":53375,"_3043":53672},[],"**Managed CAs**",{"_3587":1059,"_30795":942,"_21329":53674,"_5":14664,"_27997":53375,"_3043":53675},[],"Explicitly selected CA certificates.",{"_3587":1060,"_30795":942,"_21329":53677,"_5":14664,"_27997":53375,"_3043":53678},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3587":1061,"_30795":942,"_21329":53680,"_5":14664,"_27997":53379,"_3043":53681},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3587":1062,"_30795":942,"_21329":53683,"_5":14664,"_27997":53379,"_3043":53684},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3587":1063,"_30795":942,"_21329":53686,"_5":14664,"_27997":53379,"_3043":53687},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3587":1064,"_30795":942,"_21329":53689,"_5":14664,"_27997":53383,"_3043":53690},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3587":1065,"_30795":1065,"_5":15024,"_3043":53692,"_31154":53693,"_21329":53694,"_27997":1065},"Integrate the EST client",[50381,51893,53053,53051,53234],[],{"_3587":1066,"_30795":1065,"_21329":53696,"_5":14664,"_27997":1065,"_3043":53697},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3587":1067,"_30795":1065,"_5":31151,"_21329":53699,"_27997":53700,"_3043":50391},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3587":1068,"_30795":1065,"_5":31151,"_21329":53702,"_27997":53703,"_3043":53704},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3587":1069,"_30795":1065,"_5":31151,"_21329":53706,"_27997":53707,"_3043":53708},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3587":1070,"_30795":1065,"_5":31151,"_21329":53710,"_27997":53711,"_3043":53712},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3587":1071,"_30795":1065,"_5":31151,"_21329":53714,"_27997":53715,"_3043":53716},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3587":1072,"_30795":1065,"_5":31151,"_21329":53718,"_27997":53719,"_3043":53720},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3587":1073,"_30795":1065,"_21329":53722,"_5":14664,"_27997":1065,"_3043":53723},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3587":1074,"_30795":1065,"_21329":53725,"_5":14664,"_27997":53700,"_3043":53726},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3587":1075,"_30795":1065,"_21329":53728,"_5":14664,"_27997":53700,"_3043":53729},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3587":1076,"_30795":1065,"_21329":53731,"_5":14664,"_27997":53700,"_3043":53732},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3587":1077,"_30795":1065,"_21329":53734,"_5":14664,"_27997":53703,"_3043":53735},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3587":1078,"_30795":1065,"_21329":53737,"_5":14664,"_27997":53703,"_3043":53738},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3587":1079,"_30795":1065,"_21329":53740,"_5":14664,"_27997":53707,"_3043":53741},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3587":1080,"_30795":1065,"_21329":53743,"_5":14664,"_27997":53707,"_3043":53744},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3587":1081,"_30795":1065,"_21329":53746,"_5":14664,"_27997":53711,"_3043":53747},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3587":1082,"_30795":1065,"_21329":53749,"_5":14664,"_27997":53711,"_3043":53750},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3587":1083,"_30795":1065,"_21329":53752,"_5":14664,"_27997":53715,"_3043":53753},[],"For a root that issues directly:",{"_3587":1084,"_30795":1065,"_21329":53755,"_5":14664,"_27997":53715,"_3043":53756},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3587":1085,"_30795":1065,"_21329":53758,"_5":14664,"_27997":53715,"_3043":53759},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3587":1086,"_30795":1065,"_21329":53761,"_5":14664,"_27997":53719,"_3043":53762},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3587":1087,"_30795":1087,"_5":15024,"_3043":53764,"_31154":53765,"_21329":53766,"_27997":1087},"EST reference",[50381,51893,53053,53051,53234],[],{"_3587":1088,"_30795":1087,"_21329":53768,"_5":14664,"_27997":1087,"_3043":53769},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3587":1089,"_30795":1087,"_5":31151,"_21329":53771,"_27997":53772,"_3043":53773},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3587":1090,"_30795":1087,"_5":31151,"_21329":53775,"_27997":53776,"_3043":23110},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3587":1091,"_30795":1087,"_5":31151,"_21329":53778,"_27997":53779,"_3043":26553},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3587":1092,"_30795":1087,"_5":31151,"_21329":53781,"_27997":53782,"_3043":26560},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3587":1093,"_30795":1087,"_5":31151,"_21329":53784,"_27997":53785,"_3043":25846},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3587":1094,"_30795":1087,"_5":31151,"_21329":53787,"_27997":53788,"_3043":53789},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3587":1095,"_30795":1087,"_5":31151,"_21329":53791,"_27997":53792,"_3043":53793},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3587":1096,"_30795":1087,"_5":31151,"_21329":53795,"_27997":53796,"_3043":53797},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3587":1097,"_30795":1087,"_21329":53799,"_5":14664,"_27997":1087,"_3043":53800},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3587":1098,"_30795":1087,"_21329":53802,"_5":14664,"_27997":53772,"_3043":53803},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3587":1099,"_30795":1087,"_21329":53805,"_5":14664,"_27997":53772,"_3043":53806},[],"Operation",{"_3587":1100,"_30795":1087,"_21329":53808,"_5":14664,"_27997":53772,"_3043":53809},[],"Method",{"_3587":1101,"_30795":1087,"_21329":53811,"_5":14664,"_27997":53772,"_3043":53812},[],"Authentication and condition",{"_3587":1102,"_30795":1087,"_21329":53814,"_5":14664,"_27997":53772,"_3043":53815},[],"`/cacerts`",{"_3587":1103,"_30795":1087,"_21329":53817,"_5":14664,"_27997":53772,"_3043":53818},[],"GET",{"_3587":1104,"_30795":1087,"_21329":53820,"_5":14664,"_27997":53772,"_3043":53821},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3587":1105,"_30795":1087,"_21329":53823,"_5":14664,"_27997":53772,"_3043":53824},[],"`/simpleenroll`",{"_3587":1106,"_30795":1087,"_21329":53826,"_5":14664,"_27997":53772,"_3043":53827},[],"POST",{"_3587":1107,"_30795":1087,"_21329":53829,"_5":14664,"_27997":53772,"_3043":53830},[],"Initial authentication and DMS registration/replacement policy.",{"_3587":1108,"_30795":1087,"_21329":53832,"_5":14664,"_27997":53772,"_3043":53833},[],"`/simplereenroll`",{"_3587":1109,"_30795":1087,"_21329":53835,"_5":14664,"_27997":53772,"_3043":53827},[],{"_3587":1110,"_30795":1087,"_21329":53837,"_5":14664,"_27997":53772,"_3043":53838},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3587":1111,"_30795":1087,"_21329":53840,"_5":14664,"_27997":53772,"_3043":53841},[],"`/serverkeygen`",{"_3587":1112,"_30795":1087,"_21329":53843,"_5":14664,"_27997":53772,"_3043":53827},[],{"_3587":1113,"_30795":1087,"_21329":53845,"_5":14664,"_27997":53772,"_3043":53846},[],"Initial authentication and admission; server generation enabled.",{"_3587":1114,"_30795":1087,"_21329":53848,"_5":14664,"_27997":53772,"_3043":53849},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3587":1115,"_30795":1087,"_21329":53851,"_5":14664,"_27997":53776,"_3043":53852},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3587":1116,"_30795":1087,"_21329":53854,"_5":14664,"_27997":53776,"_3043":53855},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3587":1117,"_30795":1087,"_21329":53857,"_5":14664,"_27997":53779,"_3043":53858},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3587":1118,"_30795":1087,"_21329":53860,"_5":14664,"_27997":53779,"_3043":53861},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3587":1119,"_30795":1087,"_21329":53863,"_5":14664,"_27997":53782,"_3043":53864},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3587":1120,"_30795":1087,"_21329":53866,"_5":14664,"_27997":53782,"_3043":53867},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3587":1121,"_30795":1087,"_21329":53869,"_5":14664,"_27997":53785,"_3043":53870},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3587":1122,"_30795":1087,"_21329":53872,"_5":14664,"_27997":53785,"_3043":53873},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3587":1123,"_30795":1087,"_21329":53875,"_5":14664,"_27997":53788,"_3043":53876},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3587":1124,"_30795":1087,"_21329":53878,"_5":14664,"_27997":53788,"_3043":53879},[],"Part",{"_3587":1125,"_30795":1087,"_21329":53881,"_5":14664,"_27997":53788,"_3043":53882},[],"Content after decoding its Base64",{"_3587":1126,"_30795":1087,"_21329":53884,"_5":14664,"_27997":53788,"_3043":53885},[],"`application/pkcs8`",{"_3587":1127,"_30795":1087,"_21329":53887,"_5":14664,"_27997":53788,"_3043":53888},[],"Unencrypted DER PKCS#8 private key.",{"_3587":1128,"_30795":1087,"_21329":53890,"_5":14664,"_27997":53788,"_3043":53891},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3587":1129,"_30795":1087,"_21329":53893,"_5":14664,"_27997":53788,"_3043":53894},[],"DER PKCS#7 containing the issued certificate.",{"_3587":1130,"_30795":1087,"_21329":53896,"_5":14664,"_27997":53788,"_3043":53897},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3587":1131,"_30795":1087,"_21329":53899,"_5":14664,"_27997":53792,"_3043":53900},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3587":1132,"_30795":1087,"_21329":53902,"_5":14664,"_27997":53792,"_3043":53903},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3587":1133,"_30795":1087,"_21329":53905,"_5":14664,"_27997":53792,"_3043":53906},[],"Convert and check the result:",{"_3587":1134,"_30795":1087,"_21329":53908,"_5":14664,"_27997":53792,"_3043":53909},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3587":1135,"_30795":1087,"_21329":53911,"_5":14664,"_27997":53796,"_3043":53912},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3587":1136,"_30795":1087,"_21329":53914,"_5":14664,"_27997":53796,"_3043":53915},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3587":1137,"_30795":1137,"_5":15024,"_3043":53234,"_31154":53917,"_21329":53918,"_27997":1137},[50381,51893,53053,53051,53234],[],{"_3587":1138,"_30795":1137,"_21329":53920,"_5":14664,"_27997":1137,"_3043":53921},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3587":1139,"_30795":1137,"_5":31151,"_21329":53923,"_27997":53924,"_3043":53925},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3587":1140,"_30795":1137,"_5":31151,"_21329":53927,"_27997":53928,"_3043":53929},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3587":1141,"_30795":1137,"_5":31151,"_21329":53931,"_27997":53932,"_3043":53933},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3587":1142,"_30795":1137,"_5":31151,"_21329":53935,"_27997":53936,"_3043":53937},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3587":1143,"_30795":1137,"_21329":53939,"_5":14664,"_27997":1137,"_3043":53940},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3587":1144,"_30795":1137,"_21329":53942,"_5":14664,"_27997":53924,"_3043":53943},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3587":1145,"_30795":1137,"_21329":53945,"_5":14664,"_27997":53924,"_3043":53946},[],"The integrator installs initial EST server trust and an admission credential.",{"_3587":1146,"_30795":1137,"_21329":53948,"_5":14664,"_27997":53924,"_3043":53949},[],"The client requests an identity for its `Device ID` through EST.",{"_3587":1147,"_30795":1137,"_21329":53951,"_5":14664,"_27997":53924,"_3043":53952},[],"Certificate, device binding and key/certificate installation are checked.",{"_3587":1148,"_30795":1137,"_21329":53954,"_5":14664,"_27997":53924,"_3043":53955},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3587":1149,"_30795":1137,"_21329":53957,"_5":14664,"_27997":53924,"_3043":53958},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3587":1150,"_30795":1137,"_21329":53960,"_5":14664,"_27997":53928,"_3043":53961},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3587":1151,"_30795":1137,"_21329":53963,"_5":14664,"_27997":53928,"_3043":53964},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3587":1152,"_30795":1137,"_21329":53966,"_5":14664,"_27997":53928,"_3043":53967},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3587":1153,"_30795":1137,"_21329":53969,"_5":14664,"_27997":53928,"_3043":53970},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3587":1154,"_30795":1137,"_21329":53972,"_5":14664,"_27997":53932,"_3043":53973},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3587":1155,"_30795":1137,"_21329":53975,"_5":14664,"_27997":53932,"_3043":53976},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3587":1156,"_30795":1137,"_21329":53978,"_5":14664,"_27997":53932,"_3043":53979},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3587":1157,"_30795":1137,"_21329":53981,"_5":14664,"_27997":53932,"_3043":53982},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3587":1158,"_30795":1137,"_21329":53984,"_5":14664,"_27997":53936,"_3043":53985},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3587":1159,"_30795":1137,"_21329":53987,"_5":14664,"_27997":53936,"_3043":53988},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3587":1160,"_30795":1160,"_5":15024,"_3043":53990,"_31154":53991,"_21329":53992,"_27997":1160},"Provisioning strategies",[50381,51893,53053,53051,53234],[],{"_3587":1161,"_30795":1160,"_21329":53994,"_5":14664,"_27997":1160,"_3043":53995},[],"Choose device registration, identity authorization and key generation.",{"_3587":1162,"_30795":1160,"_5":31151,"_21329":53997,"_27997":53998,"_3043":53999},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3587":1163,"_30795":1160,"_5":31151,"_21329":54001,"_27997":54002,"_3043":54003},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3587":1164,"_30795":1160,"_5":31151,"_21329":54005,"_27997":54006,"_3043":54007},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3587":1165,"_30795":1160,"_5":31151,"_21329":54009,"_27997":54010,"_3043":54011},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3587":1166,"_30795":1160,"_5":31151,"_21329":54013,"_27997":54014,"_3043":54015},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3587":1167,"_30795":1160,"_21329":54017,"_5":14664,"_27997":1160,"_3043":54018},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3587":1168,"_30795":1160,"_21329":54020,"_5":14664,"_27997":53998,"_3043":54021},[],"Path",{"_3587":1169,"_30795":1160,"_21329":54023,"_5":14664,"_27997":53998,"_3043":54024},[],"When the device exists",{"_3587":1170,"_30795":1160,"_21329":54026,"_5":14664,"_27997":53998,"_3043":54027},[],"What to check",{"_3587":1171,"_30795":1160,"_21329":54029,"_5":14664,"_27997":53998,"_3043":54030},[],"Manual assignment",{"_3587":1172,"_30795":1160,"_21329":54032,"_5":14664,"_27997":53998,"_3043":54033},[],"An operator creates it before associating a certificate.",{"_3587":1173,"_30795":1160,"_21329":54035,"_5":14664,"_27997":53998,"_3043":54036},[],"ID, owning DMS, certificate CN and bound serial.",{"_3587":1174,"_30795":1160,"_21329":54038,"_5":14664,"_27997":53998,"_3043":54039},[],"EST with `JITP`",{"_3587":1175,"_30795":1160,"_21329":54041,"_5":14664,"_27997":53998,"_3043":54042},[],"Created for an unknown CN during `/simpleenroll`.",{"_3587":1176,"_30795":1160,"_21329":54044,"_5":14664,"_27997":53998,"_3043":54045},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3587":1177,"_30795":1160,"_21329":54047,"_5":14664,"_27997":53998,"_3043":54048},[],"EST with `PRE_REGISTRATION`",{"_3587":1178,"_30795":1160,"_21329":54050,"_5":14664,"_27997":53998,"_3043":54051},[],"Must exist before `/simpleenroll`.",{"_3587":1179,"_30795":1160,"_21329":54053,"_5":14664,"_27997":53998,"_3043":54054},[],"Approved record, same DMS and replacement conditions for your version.",{"_3587":1180,"_30795":1160,"_21329":54056,"_5":14664,"_27997":53998,"_3043":54057},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3587":1181,"_30795":1160,"_21329":54059,"_5":14664,"_27997":53998,"_3043":54060},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3587":1182,"_30795":1160,"_21329":54062,"_5":14664,"_27997":54002,"_3043":54063},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3587":1183,"_30795":1160,"_21329":54065,"_5":14664,"_27997":54002,"_3043":54066},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3587":1184,"_30795":1160,"_21329":54068,"_5":14664,"_27997":54002,"_3043":54069},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3587":1185,"_30795":1160,"_21329":54071,"_5":14664,"_27997":54006,"_3043":54072},[],"Decide initial enrollment and re-enrollment separately:",{"_3587":1186,"_30795":1160,"_21329":54074,"_5":14664,"_27997":54006,"_3043":54075},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3587":1187,"_30795":1160,"_21329":54077,"_5":14664,"_27997":54006,"_3043":54078},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3587":1188,"_30795":1160,"_21329":54080,"_5":14664,"_27997":54006,"_3043":54081},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3587":1189,"_30795":1160,"_21329":54083,"_5":14664,"_27997":54006,"_3043":54084},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3587":1190,"_30795":1160,"_21329":54086,"_5":14664,"_27997":54006,"_3043":54087},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3587":1191,"_30795":1160,"_21329":54089,"_5":14664,"_27997":54010,"_3043":50765},[],{"_3587":1192,"_30795":1160,"_21329":54091,"_5":14664,"_27997":54010,"_3043":54092},[],"Material crossing EST",{"_3587":1193,"_30795":1160,"_21329":54094,"_5":14664,"_27997":54010,"_3043":54095},[],"Device-generated key",{"_3587":1194,"_30795":1160,"_21329":54097,"_5":14664,"_27997":54010,"_3043":54098},[],"Public CSR and certificate; the key stays on the client.",{"_3587":1195,"_30795":1160,"_21329":54100,"_5":14664,"_27997":54010,"_3043":54101},[],"Existing device key",{"_3587":1196,"_30795":1160,"_21329":54103,"_5":14664,"_27997":54010,"_3043":54104},[],"CSR signed with that key and a new certificate.",{"_3587":1197,"_30795":1160,"_21329":54106,"_5":14664,"_27997":54010,"_3043":53372},[],{"_3587":1198,"_30795":1160,"_21329":54108,"_5":14664,"_27997":54010,"_3043":54109},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3587":1199,"_30795":1160,"_21329":54111,"_5":14664,"_27997":54010,"_3043":54112},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3587":1200,"_30795":1160,"_21329":54114,"_5":14664,"_27997":54014,"_3043":54115},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3587":1201,"_30795":1201,"_5":15024,"_3043":54117,"_31154":54118,"_21329":54119,"_27997":1201},"Renewal and recovery",[50381,51893,53053,53051,53234],[],{"_3587":1202,"_30795":1201,"_21329":54121,"_5":14664,"_27997":1201,"_3043":54122},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3587":1203,"_30795":1201,"_5":31151,"_21329":54124,"_27997":54125,"_3043":54126},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3587":1204,"_30795":1201,"_5":31151,"_21329":54128,"_27997":54129,"_3043":54130},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3587":1205,"_30795":1201,"_5":31151,"_21329":54132,"_27997":54133,"_3043":54134},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3587":1206,"_30795":1201,"_5":31151,"_21329":54136,"_27997":54137,"_3043":54138},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3587":1207,"_30795":1201,"_5":31151,"_21329":54140,"_27997":54141,"_3043":54142},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3587":1208,"_30795":1201,"_21329":54144,"_5":14664,"_27997":1201,"_3043":54145},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3587":1209,"_30795":1201,"_21329":54147,"_5":14664,"_27997":54125,"_3043":54148},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3587":1210,"_30795":1201,"_21329":54150,"_5":14664,"_27997":54125,"_3043":54151},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3587":1211,"_30795":1201,"_21329":54153,"_5":14664,"_27997":54125,"_3043":54154},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3587":1212,"_30795":1201,"_21329":54156,"_5":14664,"_27997":54125,"_3043":54157},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3587":1213,"_30795":1201,"_21329":54159,"_5":14664,"_27997":54129,"_3043":54160},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3587":1214,"_30795":1201,"_21329":54162,"_5":14664,"_27997":54129,"_3043":54163},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3587":1215,"_30795":1201,"_21329":54165,"_5":14664,"_27997":54133,"_3043":54166},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3587":1216,"_30795":1201,"_21329":54168,"_5":14664,"_27997":54133,"_3043":54169},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3587":1217,"_30795":1201,"_21329":54171,"_5":14664,"_27997":54133,"_3043":54172},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3587":1218,"_30795":1201,"_21329":54174,"_5":14664,"_27997":54137,"_3043":54175},[],"Situation",{"_3587":1219,"_30795":1201,"_21329":54177,"_5":14664,"_27997":54137,"_3043":54178},[],"Procedure",{"_3587":1220,"_30795":1201,"_21329":54180,"_5":14664,"_27997":54137,"_3043":54181},[],"Valid certificate, outside the window",{"_3587":1221,"_30795":1201,"_21329":54183,"_5":14664,"_27997":54137,"_3043":54184},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3587":1222,"_30795":1201,"_21329":54186,"_5":14664,"_27997":54137,"_3043":54187},[],"Expired certificate, key available",{"_3587":1223,"_30795":1201,"_21329":54189,"_5":14664,"_27997":54137,"_3043":54190},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3587":1224,"_30795":1201,"_21329":54192,"_5":14664,"_27997":54137,"_3043":54193},[],"Renewal through webhook or `NO_AUTH`",{"_3587":1225,"_30795":1201,"_21329":54195,"_5":14664,"_27997":54137,"_3043":54196},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3587":1226,"_30795":1201,"_21329":54198,"_5":14664,"_27997":54137,"_3043":54199},[],"Lost or inaccessible key",{"_3587":1227,"_30795":1201,"_21329":54201,"_5":14664,"_27997":54137,"_3043":54202},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3587":1228,"_30795":1201,"_21329":54204,"_5":14664,"_27997":54137,"_3043":54205},[],"Current identity revoked",{"_3587":1229,"_30795":1201,"_21329":54207,"_5":14664,"_27997":54137,"_3043":54208},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3587":1230,"_30795":1201,"_21329":54210,"_5":14664,"_27997":54137,"_3043":54211},[],"Device without an identity",{"_3587":1231,"_30795":1201,"_21329":54213,"_5":14664,"_27997":54137,"_3043":54214},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3587":1232,"_30795":1201,"_21329":54216,"_5":14664,"_27997":54137,"_3043":54217},[],"Retired device",{"_3587":1233,"_30795":1201,"_21329":54219,"_5":14664,"_27997":54137,"_3043":54220},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3587":1234,"_30795":1201,"_21329":54222,"_5":14664,"_27997":54137,"_3043":54223},[],"Timeout, HTTP 500 or installation failure",{"_3587":1235,"_30795":1201,"_21329":54225,"_5":14664,"_27997":54137,"_3043":54226},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3587":1236,"_30795":1201,"_21329":54228,"_5":14664,"_27997":54141,"_3043":54229},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3587":1237,"_30795":1201,"_21329":54231,"_5":14664,"_27997":54141,"_3043":54232},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3587":1238,"_30795":1238,"_5":15024,"_3043":54234,"_31154":54235,"_21329":54236,"_27997":1238},"Enrollment troubleshooting",[50381,51893,53053,53051,53234],[],{"_3587":1239,"_30795":1238,"_21329":54238,"_5":14664,"_27997":1238,"_3043":54239},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3587":1240,"_30795":1238,"_5":31151,"_21329":54241,"_27997":54242,"_3043":54243},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3587":1241,"_30795":1238,"_5":31151,"_21329":54245,"_27997":54246,"_3043":54247},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3587":1242,"_30795":1238,"_5":31151,"_21329":54249,"_27997":54250,"_3043":53797},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3587":1243,"_30795":1238,"_5":31151,"_21329":54252,"_27997":54253,"_3043":54254},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3587":1244,"_30795":1238,"_21329":54256,"_5":14664,"_27997":1238,"_3043":54257},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3587":1245,"_30795":1238,"_21329":54259,"_5":14664,"_27997":54246,"_3043":54260},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3587":1246,"_30795":1238,"_21329":54262,"_5":14664,"_27997":54246,"_3043":54263},[],"Symptom or message",{"_3587":1247,"_30795":1238,"_21329":54265,"_5":14664,"_27997":54246,"_3043":54027},[],{"_3587":1248,"_30795":1238,"_21329":54267,"_5":14664,"_27997":54246,"_3043":54268},[],"curl rejects TLS, name or issuer",{"_3587":1249,"_30795":1238,"_21329":54270,"_5":14664,"_27997":54246,"_3043":54271},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3587":1250,"_30795":1238,"_21329":54273,"_5":14664,"_27997":54246,"_3043":54274},[],"404 or missing APS",{"_3587":1251,"_30795":1238,"_21329":54276,"_5":14664,"_27997":54246,"_3043":54277},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3587":1252,"_30795":1238,"_21329":54279,"_5":14664,"_27997":54246,"_3043":54280},[],"400, CSR or format error",{"_3587":1253,"_30795":1238,"_21329":54282,"_5":14664,"_27997":54246,"_3043":54283},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3587":1254,"_30795":1238,"_21329":54285,"_5":14664,"_27997":54246,"_3043":54286},[],"Missing credential or invalid certificate",{"_3587":1255,"_30795":1238,"_21329":54288,"_5":14664,"_27997":54246,"_3043":54289},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3587":1256,"_30795":1238,"_21329":54291,"_5":14664,"_27997":54246,"_3043":54292},[],"Webhook denies, times out or responds without authorization",{"_3587":1257,"_30795":1238,"_21329":54294,"_5":14664,"_27997":54246,"_3043":54295},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3587":1258,"_30795":1238,"_21329":54297,"_5":14664,"_27997":54246,"_3043":54298},[],"`unexpected status code: <n>: redirects are not followed`",{"_3587":1259,"_30795":1238,"_21329":54300,"_5":14664,"_27997":54246,"_3043":54301},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3587":1260,"_30795":1238,"_21329":54303,"_5":14664,"_27997":54246,"_3043":54304},[],"`webhook response exceeds 1048576 bytes`",{"_3587":1261,"_30795":1238,"_21329":54306,"_5":14664,"_27997":54246,"_3043":54307},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3587":1262,"_30795":1238,"_21329":54309,"_5":14664,"_27997":54246,"_3043":54310},[],"`webhook config must not reference files`",{"_3587":1263,"_30795":1238,"_21329":54312,"_5":14664,"_27997":54246,"_3043":54313},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3587":1264,"_30795":1238,"_21329":54315,"_5":14664,"_27997":54246,"_3043":54316},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3587":1265,"_30795":1238,"_21329":54318,"_5":14664,"_27997":54246,"_3043":54319},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3587":1266,"_30795":1238,"_21329":54321,"_5":14664,"_27997":54246,"_3043":54322},[],"`webhook mTLS certificate and key are invalid: …`",{"_3587":1267,"_30795":1238,"_21329":54324,"_5":14664,"_27997":54246,"_3043":54325},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3587":1268,"_30795":1238,"_21329":54327,"_5":14664,"_27997":54246,"_3043":54328},[],"400 `struct validation error` creating or updating a DMS",{"_3587":1269,"_30795":1238,"_21329":54330,"_5":14664,"_27997":54246,"_3043":54331},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3587":1270,"_30795":1238,"_21329":54333,"_5":14664,"_27997":54246,"_3043":54334},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3587":1271,"_30795":1238,"_21329":54336,"_5":14664,"_27997":54246,"_3043":54337},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3587":1272,"_30795":1238,"_21329":54339,"_5":14664,"_27997":54246,"_3043":54340},[],"`device not preregistered`",{"_3587":1273,"_30795":1238,"_21329":54342,"_5":14664,"_27997":54246,"_3043":54343},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3587":1274,"_30795":1238,"_21329":54345,"_5":14664,"_27997":54246,"_3043":54346},[],"`forbiddenNewEnrollment`",{"_3587":1275,"_30795":1238,"_21329":54348,"_5":14664,"_27997":54246,"_3043":54349},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3587":1276,"_30795":1238,"_21329":54351,"_5":14664,"_27997":54246,"_3043":54352},[],"Different owning DMS",{"_3587":1277,"_30795":1238,"_21329":54354,"_5":14664,"_27997":54246,"_3043":54355},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3587":1278,"_30795":1238,"_21329":54357,"_5":14664,"_27997":54246,"_3043":54358},[],"`invalid RawSubject bytes`",{"_3587":1279,"_30795":1238,"_21329":54360,"_5":14664,"_27997":54246,"_3043":54361},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3587":1280,"_30795":1238,"_21329":54363,"_5":14664,"_27997":54246,"_3043":54364},[],"`invalid reenroll window`",{"_3587":1281,"_30795":1238,"_21329":54366,"_5":14664,"_27997":54246,"_3043":54367},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3587":1282,"_30795":1238,"_21329":54369,"_5":14664,"_27997":54246,"_3043":54370},[],"Current certificate revoked",{"_3587":1283,"_30795":1238,"_21329":54372,"_5":14664,"_27997":54246,"_3043":54373},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3587":1284,"_30795":1238,"_21329":54375,"_5":14664,"_27997":54246,"_3043":54376},[],"CA, profile or signing error",{"_3587":1285,"_30795":1238,"_21329":54378,"_5":14664,"_27997":54246,"_3043":54379},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3587":1286,"_30795":1238,"_21329":54381,"_5":14664,"_27997":54246,"_3043":54382},[],"HTTP 200 without a device connection",{"_3587":1287,"_30795":1238,"_21329":54384,"_5":14664,"_27997":54246,"_3043":54385},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3587":1288,"_30795":1238,"_21329":54387,"_5":14664,"_27997":54246,"_3043":54388},[],"Timeout or error after issuance",{"_3587":1289,"_30795":1238,"_21329":54390,"_5":14664,"_27997":54246,"_3043":54391},[],"New certificates, current slot and previous identity's state before retrying.",{"_3587":1290,"_30795":1238,"_21329":54393,"_5":14664,"_27997":54250,"_3043":54394},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3587":1291,"_30795":1238,"_21329":54396,"_5":14664,"_27997":54250,"_3043":54397},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3587":1292,"_30795":1238,"_21329":54399,"_5":14664,"_27997":54253,"_3043":54400},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3587":1293,"_30795":1238,"_21329":54402,"_5":14664,"_27997":54253,"_3043":54403},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3587":1294,"_30795":1238,"_21329":54405,"_5":14664,"_27997":54253,"_3043":54406},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3587":1295,"_30795":1238,"_21329":54408,"_5":14664,"_27997":54253,"_3043":54409},[],"Make one request, save headers/body and query the device and certificates.",{"_3587":1296,"_30795":1238,"_21329":54411,"_5":14664,"_27997":54253,"_3043":54412},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3587":1297,"_30795":1238,"_21329":54414,"_5":14664,"_27997":54253,"_3043":54415},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3587":1298,"_30795":1238,"_21329":54417,"_5":14664,"_27997":54253,"_3043":54418},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3587":1299,"_30795":1299,"_5":15024,"_3043":54420,"_31154":54421,"_21329":54422,"_27997":1299},"Trust distribution and updates",[50381,51893,53053,53051,53234],[],{"_3587":1300,"_30795":1299,"_21329":54424,"_5":14664,"_27997":1299,"_3043":54425},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3587":1301,"_30795":1299,"_5":31151,"_21329":54427,"_27997":54428,"_3043":54429},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3587":1302,"_30795":1299,"_5":31151,"_21329":54431,"_27997":54432,"_3043":54433},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3587":1303,"_30795":1299,"_5":31151,"_21329":54435,"_27997":54436,"_3043":54437},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3587":1304,"_30795":1299,"_5":31151,"_21329":54439,"_27997":54440,"_3043":54441},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3587":1305,"_30795":1299,"_5":31151,"_21329":54443,"_27997":54444,"_3043":54445},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3587":1306,"_30795":1299,"_21329":54447,"_5":14664,"_27997":1299,"_3043":54448},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3587":1307,"_30795":1299,"_21329":54450,"_5":14664,"_27997":54428,"_3043":54451},[],"Relationship",{"_3587":1308,"_30795":1299,"_21329":54453,"_5":14664,"_27997":54428,"_3043":54454},[],"Material prepared by its owner",{"_3587":1309,"_30795":1299,"_21329":54456,"_5":14664,"_27997":54428,"_3043":54457},[],"Device → EST server",{"_3587":1310,"_30795":1299,"_21329":54459,"_5":14664,"_27997":54428,"_3043":54460},[],"Previously verified server root, chain or pin and TLS name.",{"_3587":1311,"_30795":1299,"_21329":54462,"_5":14664,"_27997":54428,"_3043":54463},[],"DMS → requester",{"_3587":1312,"_30795":1299,"_21329":54465,"_5":14664,"_27997":54428,"_3043":54466},[],"CAs and rules authorizing initial or renewal credentials.",{"_3587":1313,"_30795":1299,"_21329":54468,"_5":14664,"_27997":54428,"_3043":54469},[],"Consumer → device",{"_3587":1314,"_30795":1299,"_21329":54471,"_5":14664,"_27997":54428,"_3043":54472},[],"Operational identity roots, intermediates, validation and permissions.",{"_3587":1315,"_30795":1299,"_21329":54474,"_5":14664,"_27997":54428,"_3043":54475},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3587":1316,"_30795":1299,"_21329":54477,"_5":14664,"_27997":54432,"_3043":54478},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3587":1317,"_30795":1299,"_21329":54480,"_5":14664,"_27997":54432,"_3043":54481},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3587":1318,"_30795":1299,"_21329":54483,"_5":14664,"_27997":54436,"_3043":54484},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3587":1319,"_30795":1299,"_21329":54486,"_5":14664,"_27997":54436,"_3043":54487},[],"Select policy-approved roots as anchors.",{"_3587":1320,"_30795":1299,"_21329":54489,"_5":14664,"_27997":54436,"_3043":54490},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3587":1321,"_30795":1299,"_21329":54492,"_5":14664,"_27997":54436,"_3043":54493},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3587":1322,"_30795":1299,"_21329":54495,"_5":14664,"_27997":54436,"_3043":54496},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3587":1323,"_30795":1299,"_21329":54498,"_5":14664,"_27997":54436,"_3043":54499},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3587":1324,"_30795":1299,"_21329":54501,"_5":14664,"_27997":54440,"_3043":54502},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3587":1325,"_30795":1299,"_21329":54504,"_5":14664,"_27997":54440,"_3043":54505},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3587":1326,"_30795":1299,"_21329":54507,"_5":14664,"_27997":54440,"_3043":54508},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3587":1327,"_30795":1299,"_21329":54510,"_5":14664,"_27997":54444,"_3043":54511},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3587":1328,"_30795":1328,"_5":15024,"_3043":54513,"_31154":54514,"_21329":54516,"_27997":1328},"AWS IoT Core",[50381,51893,53053,53051,54515],"Integrations",[],{"_3587":1329,"_30795":1328,"_21329":54518,"_5":14664,"_27997":1328,"_3043":54519},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3587":1330,"_30795":1328,"_5":31151,"_21329":54521,"_27997":54522,"_3043":54523},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3587":1331,"_30795":1328,"_5":31151,"_21329":54525,"_27997":54526,"_3043":54527},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3587":1332,"_30795":1328,"_5":31151,"_21329":54529,"_27997":54530,"_3043":54531},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3587":1333,"_30795":1328,"_5":31151,"_21329":54533,"_27997":54534,"_3043":54535},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3587":1334,"_30795":1328,"_5":31151,"_21329":54537,"_27997":54538,"_3043":54539},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3587":1335,"_30795":1328,"_5":31151,"_21329":54541,"_27997":54542,"_3043":54543},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3587":1336,"_30795":1328,"_5":31151,"_21329":54545,"_27997":54546,"_3043":54547},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3587":1337,"_30795":1328,"_5":31151,"_21329":54549,"_27997":54550,"_3043":54551},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3587":1338,"_30795":1328,"_5":31151,"_21329":54553,"_27997":54554,"_3043":54555},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3587":1339,"_30795":1328,"_5":31151,"_21329":54557,"_27997":54558,"_3043":54559},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3587":1340,"_30795":1328,"_5":31151,"_21329":54561,"_27997":54562,"_3043":54563},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3587":1341,"_30795":1328,"_5":31151,"_21329":54565,"_27997":54566,"_3043":54567},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3587":1342,"_30795":1328,"_5":31151,"_21329":54569,"_27997":54570,"_3043":54571},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3587":1343,"_30795":1328,"_5":31151,"_21329":54573,"_27997":54574,"_3043":54575},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3587":1344,"_30795":1328,"_5":31151,"_21329":54577,"_27997":54578,"_3043":54579},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3587":1345,"_30795":1328,"_5":31151,"_21329":54581,"_27997":54582,"_3043":54583},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3587":1346,"_30795":1328,"_5":31151,"_21329":54585,"_27997":54586,"_3043":54587},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3587":1347,"_30795":1328,"_5":31151,"_21329":54589,"_27997":54590,"_3043":54591},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3587":1348,"_30795":1328,"_5":31151,"_21329":54593,"_27997":54594,"_3043":54595},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3587":1349,"_30795":1328,"_5":31151,"_21329":54597,"_27997":54598,"_3043":54599},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3587":1350,"_30795":1328,"_5":31151,"_21329":54601,"_27997":54602,"_3043":54603},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3587":1351,"_30795":1328,"_5":31151,"_21329":54605,"_27997":54606,"_3043":54607},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3587":1352,"_30795":1328,"_5":31151,"_21329":54609,"_27997":54610,"_3043":54611},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3587":1353,"_30795":1328,"_5":31151,"_21329":54613,"_27997":54614,"_3043":54615},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3587":1354,"_30795":1328,"_5":31151,"_21329":54617,"_27997":54618,"_3043":54619},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3587":1355,"_30795":1328,"_21329":54621,"_5":14664,"_27997":1328,"_3043":54622},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3587":1356,"_30795":1328,"_21329":54624,"_5":14664,"_27997":1328,"_3043":54625},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3587":1357,"_30795":1328,"_21329":54627,"_5":14664,"_27997":1328,"_3043":54628},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3587":1358,"_30795":1328,"_21329":54630,"_5":14664,"_27997":54522,"_3043":54631},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3587":1359,"_30795":1328,"_21329":54633,"_5":14664,"_27997":54522,"_3043":54634},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3587":1360,"_30795":1328,"_21329":54636,"_5":14664,"_27997":54522,"_3043":54637},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3587":1361,"_30795":1328,"_21329":54639,"_5":14664,"_27997":54522,"_3043":54640},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3587":1362,"_30795":1328,"_21329":54642,"_5":14664,"_27997":54526,"_3043":54643},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3587":1363,"_30795":1328,"_21329":54645,"_5":14664,"_27997":54530,"_3043":54646},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3587":1364,"_30795":1328,"_21329":54648,"_5":14664,"_27997":54530,"_3043":54649},[],"IAM action",{"_3587":1365,"_30795":1328,"_21329":54651,"_5":14664,"_27997":54530,"_3043":50771},[],{"_3587":1366,"_30795":1328,"_21329":54653,"_5":14664,"_27997":54530,"_3043":54654},[],"`iot:GetRegistrationCode`",{"_3587":1367,"_30795":1328,"_21329":54656,"_5":14664,"_27997":54530,"_3043":54657},[],"Obtain the verification code for CA registration in the Primary Account",{"_3587":1368,"_30795":1328,"_21329":54659,"_5":14664,"_27997":54530,"_3043":54660},[],"`iot:RegisterCACertificate`",{"_3587":1369,"_30795":1328,"_21329":54662,"_5":14664,"_27997":54530,"_3043":54663},[],"Register the CA in AWS IoT",{"_3587":1370,"_30795":1328,"_21329":54665,"_5":14664,"_27997":54530,"_3043":54666},[],"`iot:DescribeCACertificate`",{"_3587":1371,"_30795":1328,"_21329":54668,"_5":14664,"_27997":54530,"_3043":54669},[],"Check the CA registration status",{"_3587":1372,"_30795":1328,"_21329":54671,"_5":14664,"_27997":54530,"_3043":54672},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3587":1373,"_30795":1328,"_21329":54674,"_5":14664,"_27997":54530,"_3043":54675},[],"Create or update Things in IoT Core",{"_3587":1374,"_30795":1328,"_21329":54677,"_5":14664,"_27997":54530,"_3043":54678},[],"`iot:RegisterThing`",{"_3587":1375,"_30795":1328,"_21329":54680,"_5":14664,"_27997":54530,"_3043":54681},[],"Provision Things through a template",{"_3587":1376,"_30795":1328,"_21329":54683,"_5":14664,"_27997":54530,"_3043":54684},[],"`iot:RegisterCertificate`",{"_3587":1377,"_30795":1328,"_21329":54686,"_5":14664,"_27997":54530,"_3043":54687},[],"Register device certificates",{"_3587":1378,"_30795":1328,"_21329":54689,"_5":14664,"_27997":54530,"_3043":54690},[],"`iot:UpdateCertificate`",{"_3587":1379,"_30795":1328,"_21329":54692,"_5":14664,"_27997":54530,"_3043":54693},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3587":1380,"_30795":1328,"_21329":54695,"_5":14664,"_27997":54530,"_3043":54696},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3587":1381,"_30795":1328,"_21329":54698,"_5":14664,"_27997":54530,"_3043":54699},[],"Create and attach IoT policies",{"_3587":1382,"_30795":1328,"_21329":54701,"_5":14664,"_27997":54530,"_3043":54702},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3587":1383,"_30795":1328,"_21329":54704,"_5":14664,"_27997":54530,"_3043":54705},[],"Manage Thing groups",{"_3587":1384,"_30795":1328,"_21329":54707,"_5":14664,"_27997":54530,"_3043":54708},[],"`iot:CreateProvisioningTemplate`",{"_3587":1385,"_30795":1328,"_21329":54710,"_5":14664,"_27997":54530,"_3043":54711},[],"Create JITP templates",{"_3587":1386,"_30795":1328,"_21329":54713,"_5":14664,"_27997":54530,"_3043":54714},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3587":1387,"_30795":1328,"_21329":54716,"_5":14664,"_27997":54530,"_3043":54717},[],"Read and write the Device Shadow",{"_3587":1388,"_30795":1328,"_21329":54719,"_5":14664,"_27997":54530,"_3043":54720},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3587":1389,"_30795":1328,"_21329":54722,"_5":14664,"_27997":54534,"_3043":54723},[],"Parameter",{"_3587":1390,"_30795":1328,"_21329":54725,"_5":14664,"_27997":54534,"_3043":54726},[],"Type",{"_3587":1391,"_30795":1328,"_21329":54728,"_5":14664,"_27997":54534,"_3043":54729},[],"Required",{"_3587":1392,"_30795":1328,"_21329":54731,"_5":14664,"_27997":54534,"_3043":54732},[],"Description",{"_3587":1393,"_30795":1328,"_21329":54734,"_5":14664,"_27997":54534,"_3043":54735},[],"`connector_id`",{"_3587":1394,"_30795":1328,"_21329":54737,"_5":14664,"_27997":54534,"_3043":25471},[],{"_3587":1395,"_30795":1328,"_21329":54739,"_5":14664,"_27997":54534,"_3043":54740},[],"Yes",{"_3587":1396,"_30795":1328,"_21329":54742,"_5":14664,"_27997":54534,"_3043":54743},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3587":1397,"_30795":1328,"_21329":54745,"_5":14664,"_27997":54534,"_3043":54746},[],"`aws_config.region`",{"_3587":1398,"_30795":1328,"_21329":54748,"_5":14664,"_27997":54534,"_3043":25471},[],{"_3587":1399,"_30795":1328,"_21329":54750,"_5":14664,"_27997":54534,"_3043":54740},[],{"_3587":1400,"_30795":1328,"_21329":54752,"_5":14664,"_27997":54534,"_3043":54753},[],"AWS region where the connector operates.",{"_3587":1401,"_30795":1328,"_21329":54755,"_5":14664,"_27997":54534,"_3043":54756},[],"`aws_config.auth_method`",{"_3587":1402,"_30795":1328,"_21329":54758,"_5":14664,"_27997":54534,"_3043":25471},[],{"_3587":1403,"_30795":1328,"_21329":54760,"_5":14664,"_27997":54534,"_3043":54740},[],{"_3587":1404,"_30795":1328,"_21329":54762,"_5":14664,"_27997":54534,"_3043":54763},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3587":1405,"_30795":1328,"_21329":54765,"_5":14664,"_27997":54534,"_3043":54766},[],"`aws_config.access_key_id`",{"_3587":1406,"_30795":1328,"_21329":54768,"_5":14664,"_27997":54534,"_3043":25471},[],{"_3587":1407,"_30795":1328,"_21329":54770,"_5":14664,"_27997":54534,"_3043":54771},[],"Only with `auth_method=static`",{"_3587":1408,"_30795":1328,"_21329":54773,"_5":14664,"_27997":54534,"_3043":54774},[],"AWS access key.",{"_3587":1409,"_30795":1328,"_21329":54776,"_5":14664,"_27997":54534,"_3043":54777},[],"`aws_config.secret_access_key`",{"_3587":1410,"_30795":1328,"_21329":54779,"_5":14664,"_27997":54534,"_3043":25471},[],{"_3587":1411,"_30795":1328,"_21329":54781,"_5":14664,"_27997":54534,"_3043":54771},[],{"_3587":1412,"_30795":1328,"_21329":54783,"_5":14664,"_27997":54534,"_3043":54784},[],"AWS secret key.",{"_3587":1413,"_30795":1328,"_21329":54786,"_5":14664,"_27997":54534,"_3043":54787},[],"`aws_config.session_token`",{"_3587":1414,"_30795":1328,"_21329":54789,"_5":14664,"_27997":54534,"_3043":25471},[],{"_3587":1415,"_30795":1328,"_21329":54791,"_5":14664,"_27997":54534,"_3043":54792},[],"No",{"_3587":1416,"_30795":1328,"_21329":54794,"_5":14664,"_27997":54534,"_3043":54795},[],"Session token (with `auth_method=static`).",{"_3587":1417,"_30795":1328,"_21329":54797,"_5":14664,"_27997":54534,"_3043":54798},[],"`aws_config.role_arn`",{"_3587":1418,"_30795":1328,"_21329":54800,"_5":14664,"_27997":54534,"_3043":25471},[],{"_3587":1419,"_30795":1328,"_21329":54802,"_5":14664,"_27997":54534,"_3043":54803},[],"Only with `auth_method=role`",{"_3587":1420,"_30795":1328,"_21329":54805,"_5":14664,"_27997":54534,"_3043":54806},[],"ARN of the role to assume.",{"_3587":1421,"_30795":1328,"_21329":54808,"_5":14664,"_27997":54534,"_3043":54809},[],"`aws_config.endpoint_url`",{"_3587":1422,"_30795":1328,"_21329":54811,"_5":14664,"_27997":54534,"_3043":25471},[],{"_3587":1423,"_30795":1328,"_21329":54813,"_5":14664,"_27997":54534,"_3043":54792},[],{"_3587":1424,"_30795":1328,"_21329":54815,"_5":14664,"_27997":54534,"_3043":54816},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3587":1425,"_30795":1328,"_21329":54818,"_5":14664,"_27997":54534,"_3043":54819},[],"`subscriber_event_bus`",{"_3587":1426,"_30795":1328,"_21329":54821,"_5":14664,"_27997":54534,"_3043":17945},[],{"_3587":1427,"_30795":1328,"_21329":54823,"_5":14664,"_27997":54534,"_3043":54740},[],{"_3587":1428,"_30795":1328,"_21329":54825,"_5":14664,"_27997":54534,"_3043":54826},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3587":1429,"_30795":1328,"_21329":54828,"_5":14664,"_27997":54534,"_3043":54829},[],"`dms_manager_client`",{"_3587":1430,"_30795":1328,"_21329":54831,"_5":14664,"_27997":54534,"_3043":25471},[],{"_3587":1431,"_30795":1328,"_21329":54833,"_5":14664,"_27997":54534,"_3043":54740},[],{"_3587":1432,"_30795":1328,"_21329":54835,"_5":14664,"_27997":54534,"_3043":54836},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3587":1433,"_30795":1328,"_21329":54838,"_5":14664,"_27997":54534,"_3043":54839},[],"`device_manager_client`",{"_3587":1434,"_30795":1328,"_21329":54841,"_5":14664,"_27997":54534,"_3043":25471},[],{"_3587":1435,"_30795":1328,"_21329":54843,"_5":14664,"_27997":54534,"_3043":54740},[],{"_3587":1436,"_30795":1328,"_21329":54845,"_5":14664,"_27997":54534,"_3043":54846},[],"HTTP URL of Lamassu's Device Manager.",{"_3587":1437,"_30795":1328,"_21329":54848,"_5":14664,"_27997":54534,"_3043":54849},[],"`ca_client`",{"_3587":1438,"_30795":1328,"_21329":54851,"_5":14664,"_27997":54534,"_3043":25471},[],{"_3587":1439,"_30795":1328,"_21329":54853,"_5":14664,"_27997":54534,"_3043":54740},[],{"_3587":1440,"_30795":1328,"_21329":54855,"_5":14664,"_27997":54534,"_3043":54856},[],"HTTP URL of Lamassu's CA service.",{"_3587":1441,"_30795":1328,"_21329":54858,"_5":14664,"_27997":54538,"_3043":54859},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3587":1442,"_30795":1328,"_21329":54861,"_5":14664,"_27997":54538,"_3043":54862},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3587":1443,"_30795":1328,"_21329":54864,"_5":14664,"_27997":54538,"_3043":54865},[],"CloudEvent type",{"_3587":1444,"_30795":1328,"_21329":54867,"_5":14664,"_27997":54538,"_3043":54868},[],"Lamassu resource",{"_3587":1445,"_30795":1328,"_21329":54870,"_5":14664,"_27997":54538,"_3043":54871},[],"AWS Resource",{"_3587":1446,"_30795":1328,"_21329":54873,"_5":14664,"_27997":54538,"_3043":54874},[],"IAM actions",{"_3587":1447,"_30795":1328,"_21329":54876,"_5":14664,"_27997":54538,"_3043":54877},[],"AWS calls and effect",{"_3587":1448,"_30795":1328,"_21329":54879,"_5":14664,"_27997":54538,"_3043":54880},[],"Where in this page",{"_3587":1449,"_30795":1328,"_21329":54882,"_5":14664,"_27997":54538,"_3043":54883},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3587":1450,"_30795":1328,"_21329":54885,"_5":14664,"_27997":54538,"_3043":54886},[],"CA",{"_3587":1451,"_30795":1328,"_21329":54888,"_5":14664,"_27997":54538,"_3043":54889},[],"`IoTCore/CACertificate`",{"_3587":1452,"_30795":1328,"_21329":54891,"_5":14664,"_27997":54538,"_3043":54892},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3587":1453,"_30795":1328,"_21329":54894,"_5":14664,"_27997":54538,"_3043":54895},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3587":1454,"_30795":1328,"_21329":54897,"_5":14664,"_27997":54538,"_3043":54551},[],{"_3587":1455,"_30795":1328,"_21329":54899,"_5":14664,"_27997":54538,"_3043":54900},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3587":1456,"_30795":1328,"_21329":54902,"_5":14664,"_27997":54538,"_3043":54903},[],"DMS",{"_3587":1457,"_30795":1328,"_21329":54905,"_5":14664,"_27997":54538,"_3043":54906},[],"`IoTCore/ProvisioningTemplate`",{"_3587":1458,"_30795":1328,"_21329":54908,"_5":14664,"_27997":54538,"_3043":54909},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3587":1459,"_30795":1328,"_21329":54911,"_5":14664,"_27997":54538,"_3043":54912},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3587":1460,"_30795":1328,"_21329":54914,"_5":14664,"_27997":54538,"_3043":54579},[],{"_3587":1461,"_30795":1328,"_21329":54916,"_5":14664,"_27997":54538,"_3043":54917},[],"`EventBindDeviceIdentityKey`",{"_3587":1462,"_30795":1328,"_21329":54919,"_5":14664,"_27997":54538,"_3043":54920},[],"Device",{"_3587":1463,"_30795":1328,"_21329":54922,"_5":14664,"_27997":54538,"_3043":54923},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3587":1464,"_30795":1328,"_21329":54925,"_5":14664,"_27997":54538,"_3043":54926},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3587":1465,"_30795":1328,"_21329":54928,"_5":14664,"_27997":54538,"_3043":54929},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3587":1466,"_30795":1328,"_21329":54931,"_5":14664,"_27997":54538,"_3043":54587},[],{"_3587":1467,"_30795":1328,"_21329":54933,"_5":14664,"_27997":54538,"_3043":54934},[],"`EventUpdateCertificateStatusKey`",{"_3587":1468,"_30795":1328,"_21329":54936,"_5":14664,"_27997":54538,"_3043":54937},[],"Certificate",{"_3587":1469,"_30795":1328,"_21329":54939,"_5":14664,"_27997":54538,"_3043":54940},[],"`IoTCore/Certificate`",{"_3587":1470,"_30795":1328,"_21329":54942,"_5":14664,"_27997":54538,"_3043":54943},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3587":1471,"_30795":1328,"_21329":54945,"_5":14664,"_27997":54538,"_3043":54946},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3587":1472,"_30795":1328,"_21329":54948,"_5":14664,"_27997":54538,"_3043":54599},[],{"_3587":1473,"_30795":1328,"_21329":54950,"_5":14664,"_27997":54538,"_3043":54951},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3587":1474,"_30795":1328,"_21329":54953,"_5":14664,"_27997":54538,"_3043":54954},[],"Certificate / Device",{"_3587":1475,"_30795":1328,"_21329":54956,"_5":14664,"_27997":54538,"_3043":54957},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3587":1476,"_30795":1328,"_21329":54959,"_5":14664,"_27997":54538,"_3043":50777},[],{"_3587":1477,"_30795":1328,"_21329":54961,"_5":14664,"_27997":54538,"_3043":54962},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3587":1478,"_30795":1328,"_21329":54964,"_5":14664,"_27997":54538,"_3043":54607},[],{"_3587":1479,"_30795":1328,"_21329":54966,"_5":14664,"_27997":54542,"_3043":54967},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3587":1480,"_30795":1328,"_21329":54969,"_5":14664,"_27997":54546,"_3043":54970},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3587":1481,"_30795":1328,"_21329":54972,"_5":14664,"_27997":54546,"_3043":54973},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3587":1482,"_30795":1328,"_21329":54975,"_5":14664,"_27997":54550,"_3043":54976},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3587":1483,"_30795":1328,"_21329":54978,"_5":14664,"_27997":54550,"_3043":54979},[],"Transition",{"_3587":1484,"_30795":1328,"_21329":54981,"_5":14664,"_27997":54550,"_3043":54982},[],"AWS calls",{"_3587":1485,"_30795":1328,"_21329":54984,"_5":14664,"_27997":54550,"_3043":54985},[],"`NotRegistered` → `Requested`",{"_3587":1486,"_30795":1328,"_21329":54987,"_5":14664,"_27997":54550,"_3043":54988},[],"none (metadata write only)",{"_3587":1487,"_30795":1328,"_21329":54990,"_5":14664,"_27997":54550,"_3043":54991},[],"`Requested` → `Registering`",{"_3587":1488,"_30795":1328,"_21329":54993,"_5":14664,"_27997":54550,"_3043":54994},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3587":1489,"_30795":1328,"_21329":54996,"_5":14664,"_27997":54550,"_3043":54997},[],"`Registering` → `Succeeded`",{"_3587":1490,"_30795":1328,"_21329":54999,"_5":14664,"_27997":54550,"_3043":55000},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3587":1491,"_30795":1328,"_21329":55002,"_5":14664,"_27997":54550,"_3043":55003},[],"`Registering` → `Failed`",{"_3587":1492,"_30795":1328,"_21329":55005,"_5":14664,"_27997":54550,"_3043":55006},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3587":1493,"_30795":1328,"_21329":55008,"_5":14664,"_27997":54550,"_3043":55009},[],"`Failed` / `Succeeded` → `Requested`",{"_3587":1494,"_30795":1328,"_21329":55011,"_5":14664,"_27997":54550,"_3043":55012},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3587":1495,"_30795":1328,"_21329":55014,"_5":14664,"_27997":54554,"_3043":55015},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3587":1496,"_30795":1328,"_21329":55017,"_5":14664,"_27997":54554,"_3043":55018},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3587":1497,"_30795":1328,"_21329":55020,"_5":14664,"_27997":54554,"_3043":55021},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3587":1498,"_30795":1328,"_21329":55023,"_5":14664,"_27997":54554,"_3043":55024},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3587":1499,"_30795":1328,"_21329":55026,"_5":14664,"_27997":54554,"_3043":55027},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3587":1500,"_30795":1328,"_21329":55029,"_5":14664,"_27997":54554,"_3043":55030},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3587":1501,"_30795":1328,"_21329":55032,"_5":14664,"_27997":54558,"_3043":55033},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3587":1502,"_30795":1328,"_21329":55035,"_5":14664,"_27997":54562,"_3043":55036},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3587":1503,"_30795":1328,"_21329":55038,"_5":14664,"_27997":54562,"_3043":55039},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3587":1504,"_30795":1328,"_21329":55041,"_5":14664,"_27997":54566,"_3043":55042},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3587":1505,"_30795":1328,"_21329":55044,"_5":14664,"_27997":54570,"_3043":55045},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3587":1506,"_30795":1328,"_21329":55047,"_5":14664,"_27997":54570,"_3043":55048},[],"Creates or updates the IoT policies configured in the DMS.",{"_3587":1507,"_30795":1328,"_21329":55050,"_5":14664,"_27997":54570,"_3043":55051},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3587":1508,"_30795":1328,"_21329":55053,"_5":14664,"_27997":54570,"_3043":55054},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3587":1509,"_30795":1328,"_21329":55056,"_5":14664,"_27997":54570,"_3043":55057},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3587":1510,"_30795":1328,"_21329":55059,"_5":14664,"_27997":54570,"_3043":55060},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3587":1511,"_30795":1328,"_21329":55062,"_5":14664,"_27997":54570,"_3043":55063},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3587":1512,"_30795":1328,"_21329":55065,"_5":14664,"_27997":54574,"_3043":55066},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3587":1513,"_30795":1328,"_21329":55068,"_5":14664,"_27997":54574,"_3043":55069},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3587":1514,"_30795":1328,"_21329":55071,"_5":14664,"_27997":54574,"_3043":55072},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3587":1515,"_30795":1328,"_21329":55074,"_5":14664,"_27997":54574,"_3043":55075},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3587":1516,"_30795":1328,"_21329":55077,"_5":14664,"_27997":54574,"_3043":55078},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3587":1517,"_30795":1328,"_21329":55080,"_5":14664,"_27997":54578,"_3043":55081},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3587":1518,"_30795":1328,"_21329":55083,"_5":14664,"_27997":54578,"_3043":54979},[],{"_3587":1519,"_30795":1328,"_21329":55085,"_5":14664,"_27997":54578,"_3043":54982},[],{"_3587":1520,"_30795":1328,"_21329":55087,"_5":14664,"_27997":54578,"_3043":55088},[],"`Unconfigured` → `None` / `Auto`",{"_3587":1521,"_30795":1328,"_21329":55090,"_5":14664,"_27997":54578,"_3043":55091},[],"none (configuration only)",{"_3587":1522,"_30795":1328,"_21329":55093,"_5":14664,"_27997":54578,"_3043":55094},[],"`None` ↔ `Auto`",{"_3587":1523,"_30795":1328,"_21329":55096,"_5":14664,"_27997":54578,"_3043":55091},[],{"_3587":1524,"_30795":1328,"_21329":55098,"_5":14664,"_27997":54578,"_3043":55099},[],"Any → `Jitp`",{"_3587":1525,"_30795":1328,"_21329":55101,"_5":14664,"_27997":54578,"_3043":55102},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3587":1526,"_30795":1328,"_21329":55104,"_5":14664,"_27997":54578,"_3043":55105},[],"`Jitp` → `None` / `Auto`",{"_3587":1527,"_30795":1328,"_21329":55107,"_5":14664,"_27997":54578,"_3043":55108},[],"none (the template stays in the AWS account)",{"_3587":1528,"_30795":1328,"_21329":55110,"_5":14664,"_27997":54582,"_3043":55111},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3587":1529,"_30795":1328,"_21329":55113,"_5":14664,"_27997":54582,"_3043":55114},[],"The full flow from the device's perspective is:",{"_3587":1530,"_30795":1328,"_21329":55116,"_5":14664,"_27997":54582,"_3043":55117},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3587":1531,"_30795":1328,"_21329":55119,"_5":14664,"_27997":54586,"_3043":55120},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3587":1532,"_30795":1328,"_21329":55122,"_5":14664,"_27997":54586,"_3043":54979},[],{"_3587":1533,"_30795":1328,"_21329":55124,"_5":14664,"_27997":54586,"_3043":54982},[],{"_3587":1534,"_30795":1328,"_21329":55126,"_5":14664,"_27997":54586,"_3043":55127},[],"`Absent` → `Provisioned`",{"_3587":1535,"_30795":1328,"_21329":55129,"_5":14664,"_27997":54586,"_3043":55130},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3587":1536,"_30795":1328,"_21329":55132,"_5":14664,"_27997":54586,"_3043":55133},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3587":1537,"_30795":1328,"_21329":55135,"_5":14664,"_27997":54586,"_3043":55136},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3587":1538,"_30795":1328,"_21329":55138,"_5":14664,"_27997":54586,"_3043":55139},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3587":1539,"_30795":1328,"_21329":55141,"_5":14664,"_27997":54590,"_3043":55142},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3587":1540,"_30795":1328,"_21329":55144,"_5":14664,"_27997":54590,"_3043":55145},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3587":1541,"_30795":1328,"_21329":55147,"_5":14664,"_27997":54590,"_3043":55148},[],"For the JITP flow to work correctly:",{"_3587":1542,"_30795":1328,"_21329":55150,"_5":14664,"_27997":54590,"_3043":55151},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3587":1543,"_30795":1328,"_21329":55153,"_5":14664,"_27997":54590,"_3043":55154},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3587":1544,"_30795":1328,"_21329":55156,"_5":14664,"_27997":54590,"_3043":55157},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3587":1545,"_30795":1328,"_21329":55159,"_5":14664,"_27997":54590,"_3043":55160},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3587":1546,"_30795":1328,"_21329":55162,"_5":14664,"_27997":54594,"_3043":55163},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3587":1547,"_30795":1328,"_21329":55165,"_5":14664,"_27997":54594,"_3043":55166},[],"Status in Lamassu",{"_3587":1548,"_30795":1328,"_21329":55168,"_5":14664,"_27997":54594,"_3043":55169},[],"Revocation reason",{"_3587":1549,"_30795":1328,"_21329":55171,"_5":14664,"_27997":54594,"_3043":55172},[],"Status in AWS IoT Core",{"_3587":1550,"_30795":1328,"_21329":55174,"_5":14664,"_27997":54594,"_3043":55175},[],"`Active`",{"_3587":1551,"_30795":1328,"_21329":55177,"_5":14664,"_27997":54594,"_3043":55178},[],"None",{"_3587":1552,"_30795":1328,"_21329":55180,"_5":14664,"_27997":54594,"_3043":55181},[],"`ACTIVE`",{"_3587":1553,"_30795":1328,"_21329":55183,"_5":14664,"_27997":54594,"_3043":55184},[],"`Revoked`",{"_3587":1554,"_30795":1328,"_21329":55186,"_5":14664,"_27997":54594,"_3043":55187},[],"`certificateHold`",{"_3587":1555,"_30795":1328,"_21329":55189,"_5":14664,"_27997":54594,"_3043":55190},[],"`INACTIVE`",{"_3587":1556,"_30795":1328,"_21329":55192,"_5":14664,"_27997":54594,"_3043":55184},[],{"_3587":1557,"_30795":1328,"_21329":55194,"_5":14664,"_27997":54594,"_3043":55195},[],"Any other reason",{"_3587":1558,"_30795":1328,"_21329":55197,"_5":14664,"_27997":54594,"_3043":55198},[],"`REVOKED`",{"_3587":1559,"_30795":1328,"_21329":55200,"_5":14664,"_27997":54594,"_3043":55201},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3587":1560,"_30795":1328,"_21329":55203,"_5":14664,"_27997":54598,"_3043":55204},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3587":1561,"_30795":1328,"_21329":55206,"_5":14664,"_27997":54598,"_3043":54979},[],{"_3587":1562,"_30795":1328,"_21329":55208,"_5":14664,"_27997":54598,"_3043":54982},[],{"_3587":1563,"_30795":1328,"_21329":55210,"_5":14664,"_27997":54598,"_3043":55211},[],"`NotSynced` → `Active`",{"_3587":1564,"_30795":1328,"_21329":55213,"_5":14664,"_27997":54598,"_3043":54690},[],{"_3587":1565,"_30795":1328,"_21329":55215,"_5":14664,"_27997":54598,"_3043":55216},[],"`Active` → `Inactive`",{"_3587":1566,"_30795":1328,"_21329":55218,"_5":14664,"_27997":54598,"_3043":55219},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3587":1567,"_30795":1328,"_21329":55221,"_5":14664,"_27997":54598,"_3043":55222},[],"`Active` → `Revoked`",{"_3587":1568,"_30795":1328,"_21329":55224,"_5":14664,"_27997":54598,"_3043":55219},[],{"_3587":1569,"_30795":1328,"_21329":55226,"_5":14664,"_27997":54598,"_3043":55227},[],"`Inactive` / `Revoked` → `Active`",{"_3587":1570,"_30795":1328,"_21329":55229,"_5":14664,"_27997":54598,"_3043":54690},[],{"_3587":1571,"_30795":1328,"_21329":55231,"_5":14664,"_27997":54598,"_3043":55232},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3587":1572,"_30795":1328,"_21329":55234,"_5":14664,"_27997":54598,"_3043":55235},[],"none (these states are not synced to AWS)",{"_3587":1573,"_30795":1328,"_21329":55237,"_5":14664,"_27997":54602,"_3043":55238},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3587":1574,"_30795":1328,"_21329":55240,"_5":14664,"_27997":54602,"_3043":55241},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3587":1575,"_30795":1328,"_21329":55243,"_5":14664,"_27997":54602,"_3043":55244},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3587":1576,"_30795":1328,"_21329":55246,"_5":14664,"_27997":54606,"_3043":55247},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3587":1577,"_30795":1328,"_21329":55249,"_5":14664,"_27997":54606,"_3043":55250},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3587":1578,"_30795":1328,"_21329":55252,"_5":14664,"_27997":54610,"_3043":55253},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3587":1579,"_30795":1328,"_21329":55255,"_5":14664,"_27997":54610,"_3043":55256},[],"There are two action types:",{"_3587":1580,"_30795":1328,"_21329":55258,"_5":14664,"_27997":54610,"_3043":55259},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3587":1581,"_30795":1328,"_21329":55261,"_5":14664,"_27997":54610,"_3043":55262},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3587":1582,"_30795":1328,"_21329":55264,"_5":14664,"_27997":54610,"_3043":55265},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3587":1583,"_30795":1328,"_21329":55267,"_5":14664,"_27997":54614,"_3043":55268},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3587":1584,"_30795":1328,"_21329":55270,"_5":14664,"_27997":54614,"_3043":55271},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3587":1585,"_30795":1328,"_21329":55273,"_5":14664,"_27997":54614,"_3043":55274},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3587":1586,"_30795":1328,"_21329":55276,"_5":14664,"_27997":54618,"_3043":55277},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3587":1587,"_30795":1328,"_21329":55279,"_5":14664,"_27997":54618,"_3043":55280},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3587":1588,"_30795":1328,"_21329":55282,"_5":14664,"_27997":54618,"_3043":55283},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3587":1589,"_30795":1328,"_21329":55285,"_5":14664,"_27997":54618,"_3043":55286},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3587":1590,"_30795":1328,"_21329":55288,"_5":14664,"_27997":54618,"_3043":55289},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3587":1591,"_30795":1328,"_21329":55291,"_5":14664,"_27997":54618,"_3043":55292},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3587":1592,"_30795":1328,"_21329":55294,"_5":14664,"_27997":54618,"_3043":55295},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3587":1593,"_30795":1328,"_21329":55297,"_5":14664,"_27997":54618,"_3043":55298},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3587":1594,"_30795":1328,"_21329":55300,"_5":14664,"_27997":54618,"_3043":55301},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3587":1595,"_30795":1328,"_21329":55303,"_5":14664,"_27997":54618,"_3043":55304},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3587":1596,"_30795":1328,"_21329":55306,"_5":14664,"_27997":54618,"_3043":55307},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3587":1597,"_30795":1328,"_21329":55309,"_5":14664,"_27997":54618,"_3043":55310},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3587":1598,"_30795":1328,"_21329":55312,"_5":14664,"_27997":54618,"_3043":55313},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3587":1599,"_30795":1328,"_21329":55315,"_5":14664,"_27997":54618,"_3043":55316},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3587":1600,"_30795":1328,"_21329":55318,"_5":14664,"_27997":54618,"_3043":55319},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3587":1601,"_30795":1328,"_21329":55321,"_5":14664,"_27997":54618,"_3043":55322},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3587":1602,"_30795":1328,"_21329":55324,"_5":14664,"_27997":54618,"_3043":55325},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3587":1603,"_30795":1328,"_21329":55327,"_5":14664,"_27997":54618,"_3043":55328},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3587":1604,"_30795":1328,"_21329":55330,"_5":14664,"_27997":54618,"_3043":55331},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3587":1605,"_30795":1328,"_21329":55333,"_5":14664,"_27997":54618,"_3043":55334},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3587":1606,"_30795":1328,"_21329":55336,"_5":14664,"_27997":54618,"_3043":55337},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3587":1607,"_30795":1328,"_21329":55339,"_5":14664,"_27997":54618,"_3043":55340},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3587":1608,"_30795":1328,"_21329":55342,"_5":14664,"_27997":54618,"_3043":55343},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3587":1609,"_30795":1328,"_21329":55345,"_5":14664,"_27997":54618,"_3043":55346},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3587":1610,"_30795":1610,"_5":15024,"_3043":53053,"_31154":55348,"_21329":55349,"_27997":1610},[50381,51893,53053],[],{"_3587":1611,"_30795":1610,"_21329":55351,"_5":14664,"_27997":1610,"_3043":55352},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3587":1612,"_30795":1610,"_5":31151,"_21329":55354,"_27997":55355,"_3043":55356},[],"/docs/pr-preview/pr-70/platform/iot-fleets/overview#start-here","Start here",{"_3587":1613,"_30795":1610,"_5":31151,"_21329":55358,"_27997":55359,"_3043":53051},[],"/docs/pr-preview/pr-70/platform/iot-fleets/overview#devices-and-identities",{"_3587":1614,"_30795":1610,"_5":31151,"_21329":55361,"_27997":55362,"_3043":53234},[],"/docs/pr-preview/pr-70/platform/iot-fleets/overview#enrollment-with-pki",{"_3587":1615,"_30795":1610,"_5":31151,"_21329":55364,"_27997":55365,"_3043":54515},[],"/docs/pr-preview/pr-70/platform/iot-fleets/overview#integrations",{"_3587":1616,"_30795":1610,"_5":31151,"_21329":55367,"_27997":55368,"_3043":55369},[],"/docs/pr-preview/pr-70/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3587":1617,"_30795":1610,"_21329":55371,"_5":14664,"_27997":1610,"_3043":55372},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3587":1618,"_30795":1610,"_21329":55374,"_5":14664,"_27997":55355,"_3043":55375},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3587":1619,"_30795":1610,"_21329":55377,"_5":14664,"_27997":55355,"_3043":55378},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3587":1620,"_30795":1610,"_21329":55380,"_5":14664,"_27997":55359,"_3043":55381},[],"Resource",{"_3587":1621,"_30795":1610,"_21329":55383,"_5":14664,"_27997":55359,"_3043":55384},[],"What it represents",{"_3587":1622,"_30795":1610,"_21329":55386,"_5":14664,"_27997":55359,"_3043":55387},[],"**Device**",{"_3587":1623,"_30795":1610,"_21329":55389,"_5":14664,"_27997":55359,"_3043":55390},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3587":1624,"_30795":1610,"_21329":55392,"_5":14664,"_27997":55359,"_3043":55393},[],"**Identity**",{"_3587":1625,"_30795":1610,"_21329":55395,"_5":14664,"_27997":55359,"_3043":55396},[],"The device's association with its certificates: an active version and a history.",{"_3587":1626,"_30795":1610,"_21329":55398,"_5":14664,"_27997":55359,"_3043":55399},[],"**DMS**",{"_3587":1627,"_30795":1610,"_21329":55401,"_5":14664,"_27997":55359,"_3043":55402},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3587":1628,"_30795":1610,"_21329":55404,"_5":14664,"_27997":55359,"_3043":55405},[],"**Fleet**",{"_3587":1629,"_30795":1610,"_21329":55407,"_5":14664,"_27997":55359,"_3043":55408},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3587":1630,"_30795":1610,"_21329":55410,"_5":14664,"_27997":55359,"_3043":55411},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3587":1631,"_30795":1610,"_21329":55413,"_5":14664,"_27997":55359,"_3043":55414},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3587":1632,"_30795":1610,"_21329":55416,"_5":14664,"_27997":55362,"_3043":55417},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3587":1633,"_30795":1610,"_21329":55419,"_5":14664,"_27997":55362,"_3043":55420},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3587":1634,"_30795":1610,"_21329":55422,"_5":14664,"_27997":55362,"_3043":55423},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3587":1635,"_30795":1610,"_21329":55425,"_5":14664,"_27997":55362,"_3043":55426},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3587":1636,"_30795":1610,"_21329":55428,"_5":14664,"_27997":55362,"_3043":55429},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3587":1637,"_30795":1610,"_21329":55431,"_5":14664,"_27997":55362,"_3043":55432},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3587":1638,"_30795":1610,"_21329":55434,"_5":14664,"_27997":55362,"_3043":55435},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3587":1639,"_30795":1610,"_21329":55437,"_5":14664,"_27997":55362,"_3043":55438},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3587":1640,"_30795":1610,"_21329":55440,"_5":14664,"_27997":55365,"_3043":55441},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3587":1641,"_30795":1610,"_21329":55443,"_5":14664,"_27997":55365,"_3043":55444},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3587":1642,"_30795":1610,"_21329":55446,"_5":14664,"_27997":55368,"_3043":55447},[],"Participant",{"_3587":1643,"_30795":1610,"_21329":55449,"_5":14664,"_27997":55368,"_3043":55450},[],"Responsibility",{"_3587":1644,"_30795":1610,"_21329":55452,"_5":14664,"_27997":55368,"_3043":55453},[],"PKI administrator",{"_3587":1645,"_30795":1610,"_21329":55455,"_5":14664,"_27997":55368,"_3043":55456},[],"CA, issuance profile, chain and revocation publication.",{"_3587":1646,"_30795":1610,"_21329":55458,"_5":14664,"_27997":55368,"_3043":55459},[],"Provisioning administrator",{"_3587":1647,"_30795":1610,"_21329":55461,"_5":14664,"_27997":55368,"_3043":55462},[],"DMS, admission, authentication per operation and inventory.",{"_3587":1648,"_30795":1610,"_21329":55464,"_5":14664,"_27997":55368,"_3043":55465},[],"Device integrator",{"_3587":1649,"_30795":1610,"_21329":55467,"_5":14664,"_27997":55368,"_3043":55468},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3587":1650,"_30795":1610,"_21329":55470,"_5":14664,"_27997":55368,"_3043":55471},[],"Consumer integrator",{"_3587":1651,"_30795":1610,"_21329":55473,"_5":14664,"_27997":55368,"_3043":55474},[],"Trusted issuers, validation and device permissions in the destination.",{"_3587":1652,"_30795":1610,"_21329":55476,"_5":14664,"_27997":55368,"_3043":55477},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3587":1653,"_30795":1653,"_5":15024,"_3043":55479,"_31154":55480,"_21329":55482,"_27997":1653},"Enroll and connect your first device",[50381,51893,53053,55481],"Getting started",[],{"_3587":1654,"_30795":1653,"_21329":55484,"_5":14664,"_27997":1653,"_3043":55485},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3587":1655,"_30795":1653,"_5":31151,"_21329":55487,"_27997":55488,"_3043":50391},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3587":1656,"_30795":1653,"_5":31151,"_21329":55490,"_27997":55491,"_3043":55492},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3587":1657,"_30795":1653,"_5":31151,"_21329":55494,"_27997":55495,"_3043":55496},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3587":1658,"_30795":1653,"_5":31151,"_21329":55498,"_27997":55499,"_3043":55500},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3587":1659,"_30795":1653,"_5":31151,"_21329":55502,"_27997":55503,"_3043":55504},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3587":1660,"_30795":1653,"_5":31151,"_21329":55506,"_27997":55507,"_3043":55508},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3587":1661,"_30795":1653,"_5":31151,"_21329":55510,"_27997":55511,"_3043":55512},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3587":1662,"_30795":1653,"_5":31151,"_21329":55514,"_27997":55515,"_3043":55516},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3587":1663,"_30795":1653,"_21329":55518,"_5":14664,"_27997":1653,"_3043":55519},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3587":1664,"_30795":1653,"_21329":55521,"_5":14664,"_27997":55488,"_3043":55522},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3587":1665,"_30795":1653,"_21329":55524,"_5":14664,"_27997":55488,"_3043":55525},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3587":1666,"_30795":1653,"_21329":55527,"_5":14664,"_27997":55488,"_3043":55528},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3587":1667,"_30795":1653,"_21329":55530,"_5":14664,"_27997":55488,"_3043":55531},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3587":1668,"_30795":1653,"_21329":55533,"_5":14664,"_27997":55488,"_3043":55534},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3587":1669,"_30795":1653,"_21329":55536,"_5":14664,"_27997":55491,"_3043":55537},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3587":1670,"_30795":1653,"_21329":55539,"_5":14664,"_27997":55491,"_3043":55540},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3587":1671,"_30795":1653,"_21329":55542,"_5":14664,"_27997":55495,"_3043":55543},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3587":1672,"_30795":1653,"_21329":55545,"_5":14664,"_27997":55495,"_3043":55546},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3587":1673,"_30795":1653,"_21329":55548,"_5":14664,"_27997":55495,"_3043":55549},[],"Setting",{"_3587":1674,"_30795":1653,"_21329":55551,"_5":14664,"_27997":55495,"_3043":55552},[],"Evaluation value",{"_3587":1675,"_30795":1653,"_21329":55554,"_5":14664,"_27997":55495,"_3043":55555},[],"Enrollment CA",{"_3587":1676,"_30795":1653,"_21329":55557,"_5":14664,"_27997":55495,"_3043":55558},[],"Issuing root from `device-root.pem`.",{"_3587":1677,"_30795":1653,"_21329":55560,"_5":14664,"_27997":55495,"_3043":53364},[],{"_3587":1678,"_30795":1653,"_21329":55562,"_5":14664,"_27997":55495,"_3043":55563},[],"The 1-hour leaf profile you just prepared.",{"_3587":1679,"_30795":1653,"_21329":55565,"_5":14664,"_27997":55495,"_3043":55566},[],"Protocol / Registration Mode",{"_3587":1680,"_30795":1653,"_21329":55568,"_5":14664,"_27997":55495,"_3043":55569},[],"`EST_RFC7030` / `JITP`.",{"_3587":1681,"_30795":1653,"_21329":55571,"_5":14664,"_27997":55495,"_3043":55572},[],"Verify CSR Signature",{"_3587":1682,"_30795":1653,"_21329":55574,"_5":14664,"_27997":55495,"_3043":55575},[],"Enabled.",{"_3587":1683,"_30795":1653,"_21329":55577,"_5":14664,"_27997":55495,"_3043":55578},[],"Enable Replaceable Enrollment",{"_3587":1684,"_30795":1653,"_21329":55580,"_5":14664,"_27997":55495,"_3043":55581},[],"Disabled; the ID must be new.",{"_3587":1685,"_30795":1653,"_21329":55583,"_5":14664,"_27997":55495,"_3043":55584},[],"Initial authentication",{"_3587":1686,"_30795":1653,"_21329":55586,"_5":14664,"_27997":55495,"_3043":55587},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3587":1687,"_30795":1653,"_21329":55589,"_5":14664,"_27997":55495,"_3043":55590},[],"Renewal authentication",{"_3587":1688,"_30795":1653,"_21329":55592,"_5":14664,"_27997":55495,"_3043":55593},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3587":1689,"_30795":1653,"_21329":55595,"_5":14664,"_27997":55495,"_3043":55596},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3587":1690,"_30795":1653,"_21329":55598,"_5":14664,"_27997":55495,"_3043":55599},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3587":1691,"_30795":1653,"_21329":55601,"_5":14664,"_27997":55495,"_3043":55602},[],"Re-enrollment Delta",{"_3587":1692,"_30795":1653,"_21329":55604,"_5":14664,"_27997":55495,"_3043":55605},[],"1 hour.",{"_3587":1693,"_30795":1653,"_21329":55607,"_5":14664,"_27997":55495,"_3043":55608},[],"Preventive / Critical Delta",{"_3587":1694,"_30795":1653,"_21329":55610,"_5":14664,"_27997":55495,"_3043":55611},[],"30 minutes / 10 minutes.",{"_3587":1695,"_30795":1653,"_21329":55613,"_5":14664,"_27997":55495,"_3043":55614},[],"Revoke on Re-enrollment",{"_3587":1696,"_30795":1653,"_21329":55616,"_5":14664,"_27997":55495,"_3043":55617},[],"Disabled to test the successor before retiring the previous identity.",{"_3587":1697,"_30795":1653,"_21329":55619,"_5":14664,"_27997":55495,"_3043":53372},[],{"_3587":1698,"_30795":1653,"_21329":55621,"_5":14664,"_27997":55495,"_3043":55622},[],"Disabled; the operational key is generated in the client.",{"_3587":1699,"_30795":1653,"_21329":55624,"_5":14664,"_27997":55495,"_3043":55625},[],"CA Distribution",{"_3587":1700,"_30795":1653,"_21329":55627,"_5":14664,"_27997":55495,"_3043":55628},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3587":1701,"_30795":1653,"_21329":55630,"_5":14664,"_27997":55495,"_3043":55631},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3587":1702,"_30795":1653,"_21329":55633,"_5":14664,"_27997":55499,"_3043":55634},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3587":1703,"_30795":1653,"_21329":55636,"_5":14664,"_27997":55499,"_3043":55637},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3587":1704,"_30795":1653,"_21329":55639,"_5":14664,"_27997":55503,"_3043":55640},[],"Generate a new key and CSR with the selected identifier:",{"_3587":1705,"_30795":1653,"_21329":55642,"_5":14664,"_27997":55503,"_3043":55643},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3587":1706,"_30795":1653,"_21329":55645,"_5":14664,"_27997":55503,"_3043":55646},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3587":1707,"_30795":1653,"_21329":55648,"_5":14664,"_27997":55507,"_3043":55649},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3587":1708,"_30795":1653,"_21329":55651,"_5":14664,"_27997":55507,"_3043":55652},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3587":1709,"_30795":1653,"_21329":55654,"_5":14664,"_27997":55511,"_3043":55655},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3587":1710,"_30795":1653,"_21329":55657,"_5":14664,"_27997":55511,"_3043":55658},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3587":1711,"_30795":1653,"_21329":55660,"_5":14664,"_27997":55511,"_3043":55661},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3587":1712,"_30795":1653,"_21329":55663,"_5":14664,"_27997":55511,"_3043":55664},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3587":1713,"_30795":1653,"_21329":55666,"_5":14664,"_27997":55511,"_3043":55667},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3587":1714,"_30795":1653,"_21329":55669,"_5":14664,"_27997":55515,"_3043":55670},[],"Check",{"_3587":1715,"_30795":1653,"_21329":55672,"_5":14664,"_27997":55515,"_3043":55673},[],"Expected result",{"_3587":1716,"_30795":1653,"_21329":55675,"_5":14664,"_27997":55515,"_3043":55676},[],"Registration",{"_3587":1717,"_30795":1653,"_21329":55678,"_5":14664,"_27997":55515,"_3043":55679},[],"ID created automatically and correct DMS.",{"_3587":1718,"_30795":1653,"_21329":55681,"_5":14664,"_27997":55515,"_3043":54937},[],{"_3587":1719,"_30795":1653,"_21329":55683,"_5":14664,"_27997":55515,"_3043":55684},[],"CN, profile, serial and key verified.",{"_3587":1720,"_30795":1653,"_21329":55686,"_5":14664,"_27997":55515,"_3043":55687},[],"Inventory",{"_3587":1721,"_30795":1653,"_21329":55689,"_5":14664,"_27997":55515,"_3043":55690},[],"Received serial visible as the current identity and in history.",{"_3587":1722,"_30795":1653,"_21329":55692,"_5":14664,"_27997":55515,"_3043":55693},[],"Consumer",{"_3587":1723,"_30795":1653,"_21329":55695,"_5":14664,"_27997":55515,"_3043":55696},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3587":1724,"_30795":1653,"_21329":55698,"_5":14664,"_27997":55515,"_3043":55699},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3587":1725,"_30795":1653,"_21329":55701,"_5":14664,"_27997":55515,"_3043":55702},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3587":1726,"_30795":1726,"_5":15024,"_3043":53069,"_31154":55704,"_21329":55705,"_27997":1726},[50381,51893,53053,55481],[],{"_3587":1727,"_30795":1726,"_21329":55707,"_5":14664,"_27997":1726,"_3043":55708},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3587":1728,"_30795":1726,"_5":31151,"_21329":55710,"_27997":55711,"_3043":50391},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3587":1729,"_30795":1726,"_5":31151,"_21329":55713,"_27997":55714,"_3043":55715},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3587":1730,"_30795":1726,"_5":31151,"_21329":55717,"_27997":55718,"_3043":55719},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3587":1731,"_30795":1726,"_5":31151,"_21329":55721,"_27997":55722,"_3043":55723},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3587":1732,"_30795":1726,"_5":31151,"_21329":55725,"_27997":55726,"_3043":55727},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3587":1733,"_30795":1726,"_5":31151,"_21329":55729,"_27997":55730,"_3043":55731},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3587":1734,"_30795":1726,"_5":31151,"_21329":55733,"_27997":55734,"_3043":55673},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3587":1735,"_30795":1726,"_5":31151,"_21329":55736,"_27997":55737,"_3043":55738},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3587":1736,"_30795":1726,"_5":31151,"_21329":55740,"_27997":55741,"_3043":55742},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3587":1737,"_30795":1726,"_21329":55744,"_5":14664,"_27997":1726,"_3043":55745},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3587":1738,"_30795":1726,"_21329":55747,"_5":14664,"_27997":1726,"_3043":55748},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3587":1739,"_30795":1726,"_21329":55750,"_5":14664,"_27997":55711,"_3043":55751},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3587":1740,"_30795":1726,"_21329":55753,"_5":14664,"_27997":55711,"_3043":55754},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3587":1741,"_30795":1726,"_21329":55756,"_5":14664,"_27997":55711,"_3043":55757},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3587":1742,"_30795":1726,"_21329":55759,"_5":14664,"_27997":55711,"_3043":55760},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3587":1743,"_30795":1726,"_21329":55762,"_5":14664,"_27997":55714,"_3043":55763},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3587":1744,"_30795":1726,"_21329":55765,"_5":14664,"_27997":55714,"_3043":55766},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3587":1745,"_30795":1726,"_21329":55768,"_5":14664,"_27997":55714,"_3043":55769},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3587":1746,"_30795":1726,"_21329":55771,"_5":14664,"_27997":55714,"_3043":55772},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3587":1747,"_30795":1726,"_21329":55774,"_5":14664,"_27997":55714,"_3043":55775},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3587":1748,"_30795":1726,"_21329":55777,"_5":14664,"_27997":55714,"_3043":55778},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3587":1749,"_30795":1726,"_21329":55780,"_5":14664,"_27997":55714,"_3043":55781},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3587":1750,"_30795":1726,"_21329":55783,"_5":14664,"_27997":55714,"_3043":55784},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3587":1751,"_30795":1726,"_21329":55786,"_5":14664,"_27997":55718,"_3043":55787},[],"Open **Managed Devices** and the registration action. Complete:",{"_3587":1752,"_30795":1726,"_21329":55789,"_5":14664,"_27997":55718,"_3043":55790},[],"**Device ID**: `device-001`.",{"_3587":1753,"_30795":1726,"_21329":55792,"_5":14664,"_27997":55718,"_3043":55793},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3587":1754,"_30795":1726,"_21329":55795,"_5":14664,"_27997":55718,"_3043":55796},[],"**Icon** and **Tags**: optional classification.",{"_3587":1755,"_30795":1726,"_21329":55798,"_5":14664,"_27997":55718,"_3043":55799},[],"Confirm registration.",{"_3587":1756,"_30795":1726,"_21329":55801,"_5":14664,"_27997":55722,"_3043":55802},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3587":1757,"_30795":1726,"_21329":55804,"_5":14664,"_27997":55722,"_3043":55805},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3587":1758,"_30795":1726,"_21329":55807,"_5":14664,"_27997":55726,"_3043":55808},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3587":1759,"_30795":1726,"_21329":55810,"_5":14664,"_27997":55726,"_3043":55811},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3587":1760,"_30795":1726,"_21329":55813,"_5":14664,"_27997":55730,"_3043":55814},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3587":1761,"_30795":1726,"_21329":55816,"_5":14664,"_27997":55730,"_3043":55817},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3587":1762,"_30795":1726,"_21329":55819,"_5":14664,"_27997":55734,"_3043":55670},[],{"_3587":1763,"_30795":1726,"_21329":55821,"_5":14664,"_27997":55734,"_3043":55822},[],"Result",{"_3587":1764,"_30795":1726,"_21329":55824,"_5":14664,"_27997":55734,"_3043":54920},[],{"_3587":1765,"_30795":1726,"_21329":55826,"_5":14664,"_27997":55734,"_3043":55827},[],"`device-001` appears in inventory with the expected DMS.",{"_3587":1766,"_30795":1726,"_21329":55829,"_5":14664,"_27997":55734,"_3043":55830},[],"Current identity",{"_3587":1767,"_30795":1726,"_21329":55832,"_5":14664,"_27997":55734,"_3043":55833},[],"The associated certificate matches the one you verified in PKI.",{"_3587":1768,"_30795":1726,"_21329":55835,"_5":14664,"_27997":55734,"_3043":55836},[],"History",{"_3587":1769,"_30795":1726,"_21329":55838,"_5":14664,"_27997":55734,"_3043":55839},[],"The associated issuance appears with its serial number and dates.",{"_3587":1770,"_30795":1726,"_21329":55841,"_5":14664,"_27997":55734,"_3043":55842},[],"Key and certificate",{"_3587":1771,"_30795":1726,"_21329":55844,"_5":14664,"_27997":55734,"_3043":55845},[],"You have the verified pair ready to install on the device.",{"_3587":1772,"_30795":1726,"_21329":55847,"_5":14664,"_27997":55737,"_3043":55848},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3587":1773,"_30795":1726,"_21329":55850,"_5":14664,"_27997":55737,"_3043":55851},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3587":1774,"_30795":1726,"_21329":55853,"_5":14664,"_27997":55737,"_3043":55854},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3587":1775,"_30795":1726,"_21329":55856,"_5":14664,"_27997":55737,"_3043":55857},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3587":1776,"_30795":1726,"_21329":55859,"_5":14664,"_27997":55741,"_3043":55860},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3587":1777,"_30795":1726,"_21329":55862,"_5":14664,"_27997":55741,"_3043":55863},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3587":1778,"_30795":1726,"_21329":55865,"_5":14664,"_27997":55741,"_3043":55866},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3587":1779,"_30795":1779,"_5":15024,"_3043":55868,"_31154":55869,"_21329":55870,"_27997":1779},"Lamassu IoT Platform",[50381,51893],[],{"_3587":1780,"_30795":1779,"_21329":55872,"_5":14664,"_27997":1779,"_3043":55873},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3587":1781,"_30795":1779,"_5":31151,"_21329":55875,"_27997":55876,"_3043":55356},[],"/docs/pr-preview/pr-70/platform/overview#start-here",{"_3587":1782,"_30795":1779,"_5":31151,"_21329":55878,"_27997":55879,"_3043":55880},[],"/docs/pr-preview/pr-70/platform/overview#choose-your-path","Choose your path",{"_3587":1783,"_30795":1779,"_5":31151,"_21329":55882,"_27997":55883,"_3043":55884},[],"/docs/pr-preview/pr-70/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3587":1784,"_30795":1779,"_5":31151,"_21329":55886,"_27997":55887,"_3043":55888},[],"/docs/pr-preview/pr-70/platform/overview#core-capabilities","Core capabilities",{"_3587":1785,"_30795":1779,"_5":31151,"_21329":55890,"_27997":55891,"_3043":55892},[],"/docs/pr-preview/pr-70/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3587":1786,"_30795":1779,"_5":31151,"_21329":55894,"_27997":55895,"_3043":55896},[],"/docs/pr-preview/pr-70/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3587":1787,"_30795":1779,"_5":31151,"_21329":55898,"_27997":55899,"_3043":55900},[],"/docs/pr-preview/pr-70/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3587":1788,"_30795":1779,"_5":31151,"_21329":55902,"_27997":55903,"_3043":55904},[],"/docs/pr-preview/pr-70/platform/overview#automate-device-identities","Automate device identities",{"_3587":1789,"_30795":1779,"_5":31151,"_21329":55906,"_27997":55907,"_3043":55908},[],"/docs/pr-preview/pr-70/platform/overview#publish-validation-status","Publish validation status",{"_3587":1790,"_30795":1779,"_5":31151,"_21329":55910,"_27997":55911,"_3043":55912},[],"/docs/pr-preview/pr-70/platform/overview#react-to-events","React to events",{"_3587":1791,"_30795":1779,"_5":31151,"_21329":55914,"_27997":55915,"_3043":55916},[],"/docs/pr-preview/pr-70/platform/overview#operational-reference","Operational reference",{"_3587":1792,"_30795":1779,"_21329":55918,"_5":14664,"_27997":1779,"_3043":55919},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3587":1793,"_30795":1779,"_21329":55921,"_5":14664,"_27997":55876,"_3043":55922},[],"Choose the result you need:",{"_3587":1794,"_30795":1779,"_21329":55924,"_5":14664,"_27997":55876,"_3043":55925},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3587":1795,"_30795":1779,"_21329":55927,"_5":14664,"_27997":55876,"_3043":55928},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3587":1796,"_30795":1779,"_21329":55930,"_5":14664,"_27997":55876,"_3043":55931},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3587":1797,"_30795":1779,"_21329":55933,"_5":14664,"_27997":55879,"_3043":55934},[],"Section",{"_3587":1798,"_30795":1779,"_21329":55936,"_5":14664,"_27997":55879,"_3043":55937},[],"What you manage",{"_3587":1799,"_30795":1779,"_21329":55939,"_5":14664,"_27997":55879,"_3043":55940},[],"Entry point",{"_3587":1800,"_30795":1779,"_21329":55942,"_5":14664,"_27997":55879,"_3043":55943},[],"**PKI**",{"_3587":1801,"_30795":1779,"_21329":55945,"_5":14664,"_27997":55879,"_3043":55946},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3587":1802,"_30795":1779,"_21329":55948,"_5":14664,"_27997":55879,"_3043":55949},[],"PKI overview",{"_3587":1803,"_30795":1779,"_21329":55951,"_5":14664,"_27997":55879,"_3043":55952},[],"**IoT Fleets**",{"_3587":1804,"_30795":1779,"_21329":55954,"_5":14664,"_27997":55879,"_3043":55955},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3587":1805,"_30795":1779,"_21329":55957,"_5":14664,"_27997":55879,"_3043":55958},[],"IoT Fleets overview",{"_3587":1806,"_30795":1779,"_21329":55960,"_5":14664,"_27997":55879,"_3043":55961},[],"**Administration**",{"_3587":1807,"_30795":1779,"_21329":55963,"_5":14664,"_27997":55879,"_3043":55964},[],"Operator permissions, audit and event subscriptions.",{"_3587":1808,"_30795":1779,"_21329":55966,"_5":14664,"_27997":55879,"_3043":51895},[],{"_3587":1809,"_30795":1779,"_21329":55968,"_5":14664,"_27997":55879,"_3043":55969},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3587":1810,"_30795":1779,"_21329":55971,"_5":14664,"_27997":55883,"_3043":55972},[],"An identity's journey connects four responsibilities:",{"_3587":1811,"_30795":1779,"_21329":55974,"_5":14664,"_27997":55883,"_3043":55975},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3587":1812,"_30795":1779,"_21329":55977,"_5":14664,"_27997":55883,"_3043":55978},[],"The provisioning administrator configures the DMS and initial trust.",{"_3587":1813,"_30795":1779,"_21329":55980,"_5":14664,"_27997":55883,"_3043":55981},[],"The device client requests a certificate and installs it with the matching key.",{"_3587":1814,"_30795":1779,"_21329":55983,"_5":14664,"_27997":55883,"_3043":55984},[],"The consumer validates the identity and applies its access permissions.",{"_3587":1815,"_30795":1779,"_21329":55986,"_5":14664,"_27997":55883,"_3043":55987},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3587":1816,"_30795":1779,"_21329":55989,"_5":14664,"_27997":55891,"_3043":55990},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3587":1817,"_30795":1779,"_21329":55992,"_5":14664,"_27997":55895,"_3043":55993},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3587":1818,"_30795":1779,"_21329":55995,"_5":14664,"_27997":55899,"_3043":55996},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3587":1819,"_30795":1779,"_21329":55998,"_5":14664,"_27997":55903,"_3043":55999},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3587":1820,"_30795":1779,"_21329":56001,"_5":14664,"_27997":55907,"_3043":56002},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3587":1821,"_30795":1779,"_21329":56004,"_5":14664,"_27997":55911,"_3043":56005},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3587":1822,"_30795":1779,"_21329":56007,"_5":14664,"_27997":55915,"_3043":55450},[],{"_3587":1823,"_30795":1779,"_21329":56009,"_5":14664,"_27997":55915,"_3043":56010},[],"What it prepares or checks",{"_3587":1824,"_30795":1779,"_21329":56012,"_5":14664,"_27997":55915,"_3043":55453},[],{"_3587":1825,"_30795":1779,"_21329":56014,"_5":14664,"_27997":55915,"_3043":56015},[],"Key custody, CA hierarchy, profiles and validation.",{"_3587":1826,"_30795":1779,"_21329":56017,"_5":14664,"_27997":55915,"_3043":56018},[],"Fleet administrator",{"_3587":1827,"_30795":1779,"_21329":56020,"_5":14664,"_27997":55915,"_3043":56021},[],"DMS, device admission, renewal policy and inventory.",{"_3587":1828,"_30795":1779,"_21329":56023,"_5":14664,"_27997":55915,"_3043":55465},[],{"_3587":1829,"_30795":1779,"_21329":56025,"_5":14664,"_27997":55915,"_3043":56026},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3587":1830,"_30795":1779,"_21329":56028,"_5":14664,"_27997":55915,"_3043":55471},[],{"_3587":1831,"_30795":1779,"_21329":56030,"_5":14664,"_27997":55915,"_3043":56031},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3587":1832,"_30795":1779,"_21329":56033,"_5":14664,"_27997":55915,"_3043":56034},[],"Infrastructure operator",{"_3587":1833,"_30795":1779,"_21329":56036,"_5":14664,"_27997":55915,"_3043":56037},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3587":1834,"_30795":1779,"_21329":56039,"_5":14664,"_27997":55915,"_3043":56040},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3587":1835,"_30795":1835,"_5":15024,"_3043":56042,"_31154":56043,"_21329":56046,"_27997":1835},"CA hierarchy and rotation",[50381,51893,56044,56045],"PKI","Keys, authorities and certificates",[],{"_3587":1836,"_30795":1835,"_21329":56048,"_5":14664,"_27997":1835,"_3043":56049},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3587":1837,"_30795":1835,"_5":31151,"_21329":56051,"_27997":56052,"_3043":56053},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3587":1838,"_30795":1835,"_5":31151,"_21329":56055,"_27997":56056,"_3043":56057},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3587":1839,"_30795":1835,"_5":31151,"_21329":56059,"_27997":56060,"_3043":56061},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3587":1840,"_30795":1835,"_5":31151,"_21329":56063,"_27997":56064,"_3043":56065},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3587":1841,"_30795":1835,"_5":31151,"_21329":56067,"_27997":56068,"_3043":56069},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3587":1842,"_30795":1835,"_5":31151,"_21329":56071,"_27997":56072,"_3043":56073},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3587":1843,"_30795":1835,"_5":31151,"_21329":56075,"_27997":56076,"_3043":56077},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3587":1844,"_30795":1835,"_5":31151,"_21329":56079,"_27997":56080,"_3043":56081},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3587":1845,"_30795":1835,"_5":31151,"_21329":56083,"_27997":56084,"_3043":56085},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3587":1846,"_30795":1835,"_5":31151,"_21329":56087,"_27997":56088,"_3043":56089},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3587":1847,"_30795":1835,"_5":31151,"_21329":56091,"_27997":56092,"_3043":56093},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3587":1848,"_30795":1835,"_5":31151,"_21329":56095,"_27997":56096,"_3043":56097},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3587":1849,"_30795":1835,"_21329":56099,"_5":14664,"_27997":1835,"_3043":56100},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3587":1850,"_30795":1835,"_21329":56102,"_5":14664,"_27997":1835,"_3043":56103},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3587":1851,"_30795":1835,"_21329":56105,"_5":14664,"_27997":56052,"_3043":56106},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3587":1852,"_30795":1835,"_21329":56108,"_5":14664,"_27997":56052,"_3043":56109},[],"environment, such as production and preproduction;",{"_3587":1853,"_30795":1835,"_21329":56111,"_5":14664,"_27997":56052,"_3043":56112},[],"owner or operating team;",{"_3587":1854,"_30795":1835,"_21329":56114,"_5":14664,"_27997":56052,"_3043":56115},[],"device family or manufacturing process;",{"_3587":1855,"_30795":1835,"_21329":56117,"_5":14664,"_27997":56052,"_3043":56118},[],"region or regulatory requirement;",{"_3587":1856,"_30795":1835,"_21329":56120,"_5":14664,"_27997":56052,"_3043":56121},[],"cryptographic engine or key policy;",{"_3587":1857,"_30795":1835,"_21329":56123,"_5":14664,"_27997":56052,"_3043":56124},[],"maintenance window and renewal cadence.",{"_3587":1858,"_30795":1835,"_21329":56126,"_5":14664,"_27997":56052,"_3043":56127},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3587":1859,"_30795":1835,"_21329":56129,"_5":14664,"_27997":56052,"_3043":56130},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3587":1860,"_30795":1835,"_21329":56132,"_5":14664,"_27997":56056,"_3043":56133},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3587":1861,"_30795":1835,"_21329":56135,"_5":14664,"_27997":56056,"_3043":56136},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3587":1862,"_30795":1835,"_21329":56138,"_5":14664,"_27997":56056,"_3043":56139},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3587":1863,"_30795":1835,"_21329":56141,"_5":14664,"_27997":56056,"_3043":56142},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3587":1864,"_30795":1835,"_21329":56144,"_5":14664,"_27997":56060,"_3043":56145},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3587":1865,"_30795":1835,"_21329":56147,"_5":14664,"_27997":56060,"_3043":56148},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3587":1866,"_30795":1835,"_21329":56150,"_5":14664,"_27997":56060,"_3043":56151},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3587":1867,"_30795":1835,"_21329":56153,"_5":14664,"_27997":56060,"_3043":56154},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3587":1868,"_30795":1835,"_21329":56156,"_5":14664,"_27997":56068,"_3043":56157},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3587":1869,"_30795":1835,"_21329":56159,"_5":14664,"_27997":56072,"_3043":56160},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3587":1870,"_30795":1835,"_21329":56162,"_5":14664,"_27997":56076,"_3043":56163},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3587":1871,"_30795":1835,"_21329":56165,"_5":14664,"_27997":56080,"_3043":56166},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3587":1872,"_30795":1835,"_21329":56168,"_5":14664,"_27997":56084,"_3043":56169},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3587":1873,"_30795":1835,"_21329":56171,"_5":14664,"_27997":56088,"_3043":56172},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3587":1874,"_30795":1835,"_21329":56174,"_5":14664,"_27997":56092,"_3043":56175},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3587":1875,"_30795":1835,"_21329":56177,"_5":14664,"_27997":56092,"_3043":56178},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3587":1876,"_30795":1835,"_21329":56180,"_5":14664,"_27997":56092,"_3043":56181},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3587":1877,"_30795":1835,"_21329":56183,"_5":14664,"_27997":56092,"_3043":56184},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3587":1878,"_30795":1835,"_21329":56186,"_5":14664,"_27997":56096,"_3043":56187},[],"The new chain ends in an anchor installed by the consumer.",{"_3587":1879,"_30795":1835,"_21329":56189,"_5":14664,"_27997":56096,"_3043":56190},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3587":1880,"_30795":1835,"_21329":56192,"_5":14664,"_27997":56096,"_3043":56193},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3587":1881,"_30795":1835,"_21329":56195,"_5":14664,"_27997":56096,"_3043":56196},[],"Re-enrollment accepts the old identity during the planned period.",{"_3587":1882,"_30795":1835,"_21329":56198,"_5":14664,"_27997":56096,"_3043":56199},[],"OCSP and CRL respond for the authorities that remain active.",{"_3587":1883,"_30795":1835,"_21329":56201,"_5":14664,"_27997":56096,"_3043":56202},[],"No DMS is left accidentally issuing from the old CA.",{"_3587":1884,"_30795":1835,"_21329":56204,"_5":14664,"_27997":56096,"_3043":56205},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3587":1885,"_30795":1885,"_5":15024,"_3043":56207,"_31154":56208,"_21329":56209,"_27997":1885},"Certification authorities",[50381,51893,56044,56045],[],{"_3587":1886,"_30795":1885,"_21329":56211,"_5":14664,"_27997":1885,"_3043":56212},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3587":1887,"_30795":1885,"_5":31151,"_21329":56214,"_27997":56215,"_3043":56216},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3587":1888,"_30795":1885,"_5":31151,"_21329":56218,"_27997":56219,"_3043":56220},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3587":1889,"_30795":1885,"_5":31151,"_21329":56222,"_27997":56223,"_3043":50391},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#before-you-begin",{"_3587":1890,"_30795":1885,"_5":31151,"_21329":56225,"_27997":56226,"_3043":56227},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3587":1891,"_30795":1885,"_5":31151,"_21329":56229,"_27997":56230,"_3043":56231},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3587":1892,"_30795":1885,"_5":31151,"_21329":56233,"_27997":56234,"_3043":56235},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3587":1893,"_30795":1885,"_5":31151,"_21329":56237,"_27997":56238,"_3043":56239},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3587":1894,"_30795":1885,"_5":31151,"_21329":56241,"_27997":56242,"_3043":56243},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3587":1895,"_30795":1885,"_5":31151,"_21329":56245,"_27997":56246,"_3043":56247},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3587":1896,"_30795":1885,"_5":31151,"_21329":56249,"_27997":56250,"_3043":56251},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3587":1897,"_30795":1885,"_5":31151,"_21329":56253,"_27997":56254,"_3043":56255},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3587":1898,"_30795":1885,"_5":31151,"_21329":56257,"_27997":56258,"_3043":56259},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3587":1899,"_30795":1885,"_5":31151,"_21329":56261,"_27997":56262,"_3043":56263},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3587":1900,"_30795":1885,"_5":31151,"_21329":56265,"_27997":56266,"_3043":56267},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3587":1901,"_30795":1885,"_5":31151,"_21329":56269,"_27997":56270,"_3043":56271},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3587":1902,"_30795":1885,"_5":31151,"_21329":56273,"_27997":56274,"_3043":56275},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3587":1903,"_30795":1885,"_5":31151,"_21329":56277,"_27997":56278,"_3043":56279},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3587":1904,"_30795":1885,"_5":31151,"_21329":56281,"_27997":56282,"_3043":56283},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3587":1905,"_30795":1885,"_5":31151,"_21329":56285,"_27997":56286,"_3043":56287},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3587":1906,"_30795":1885,"_5":31151,"_21329":56289,"_27997":56290,"_3043":56291},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3587":1907,"_30795":1885,"_5":31151,"_21329":56293,"_27997":56294,"_3043":56295},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3587":1908,"_30795":1885,"_5":31151,"_21329":56297,"_27997":56298,"_3043":56299},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3587":1909,"_30795":1885,"_5":31151,"_21329":56301,"_27997":56302,"_3043":56303},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3587":1910,"_30795":1885,"_21329":56305,"_5":14664,"_27997":1885,"_3043":56306},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3587":1911,"_30795":1885,"_21329":56308,"_5":14664,"_27997":1885,"_3043":56309},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3587":1912,"_30795":1885,"_21329":56311,"_5":14664,"_27997":1885,"_3043":56312},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3587":1913,"_30795":1885,"_21329":56314,"_5":14664,"_27997":56215,"_3043":56315},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3587":1914,"_30795":1885,"_21329":56317,"_5":14664,"_27997":56215,"_3043":56318},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3587":1915,"_30795":1885,"_21329":56320,"_5":14664,"_27997":56215,"_3043":56321},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3587":1916,"_30795":1885,"_21329":56323,"_5":14664,"_27997":56215,"_3043":56324},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3587":1917,"_30795":1885,"_21329":56326,"_5":14664,"_27997":56215,"_3043":56327},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3587":1918,"_30795":1885,"_21329":56329,"_5":14664,"_27997":56223,"_3043":56330},[],"Decide whether the CA will be a root or an intermediate.",{"_3587":1919,"_30795":1885,"_21329":56332,"_5":14664,"_27997":56223,"_3043":56333},[],"Choose the engine that will keep the key.",{"_3587":1920,"_30795":1885,"_21329":56335,"_5":14664,"_27997":56223,"_3043":56336},[],"Define a validity longer than that of the certificates it will issue.",{"_3587":1921,"_30795":1885,"_21329":56338,"_5":14664,"_27997":56223,"_3043":56339},[],"For an intermediate CA, make sure the parent CA is active.",{"_3587":1922,"_30795":1885,"_21329":56341,"_5":14664,"_27997":56226,"_3043":56342},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3587":1923,"_30795":1885,"_21329":56344,"_5":14664,"_27997":56230,"_3043":56345},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3587":1924,"_30795":1885,"_21329":56347,"_5":14664,"_27997":56230,"_3043":56348},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3587":1925,"_30795":1885,"_21329":56350,"_5":14664,"_27997":56234,"_3043":56351},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3587":1926,"_30795":1885,"_21329":56353,"_5":14664,"_27997":56238,"_3043":56354},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3587":1927,"_30795":1885,"_21329":56356,"_5":14664,"_27997":56238,"_3043":56357},[],"`C`: two-letter ISO 3166-1 country code.",{"_3587":1928,"_30795":1885,"_21329":56359,"_5":14664,"_27997":56238,"_3043":56360},[],"`ST`: state or province.",{"_3587":1929,"_30795":1885,"_21329":56362,"_5":14664,"_27997":56238,"_3043":56363},[],"`L`: locality.",{"_3587":1930,"_30795":1885,"_21329":56365,"_5":14664,"_27997":56238,"_3043":56366},[],"`O`: organization.",{"_3587":1931,"_30795":1885,"_21329":56368,"_5":14664,"_27997":56238,"_3043":56369},[],"`OU`: organizational unit.",{"_3587":1932,"_30795":1885,"_21329":56371,"_5":14664,"_27997":56238,"_3043":56372},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3587":1933,"_30795":1885,"_21329":56374,"_5":14664,"_27997":56242,"_3043":56375},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3587":1934,"_30795":1885,"_21329":56377,"_5":14664,"_27997":56242,"_3043":56378},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3587":1935,"_30795":1885,"_21329":56380,"_5":14664,"_27997":56246,"_3043":56381},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3587":1936,"_30795":1885,"_21329":56383,"_5":14664,"_27997":56246,"_3043":56384},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3587":1937,"_30795":1885,"_21329":56386,"_5":14664,"_27997":56250,"_3043":56387},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3587":1938,"_30795":1885,"_21329":56389,"_5":14664,"_27997":56250,"_3043":56390},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3587":1939,"_30795":1885,"_21329":56392,"_5":14664,"_27997":56254,"_3043":56393},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3587":1940,"_30795":1885,"_21329":56395,"_5":14664,"_27997":56254,"_3043":56396},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3587":1941,"_30795":1885,"_21329":56398,"_5":14664,"_27997":56254,"_3043":56399},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3587":1942,"_30795":1885,"_21329":56401,"_5":14664,"_27997":56258,"_3043":56402},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3587":1943,"_30795":1885,"_21329":56404,"_5":14664,"_27997":56262,"_3043":56405},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3587":1944,"_30795":1885,"_21329":56407,"_5":14664,"_27997":56262,"_3043":56408},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3587":1945,"_30795":1885,"_21329":56410,"_5":14664,"_27997":56266,"_3043":56411},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3587":1946,"_30795":1885,"_21329":56413,"_5":14664,"_27997":56270,"_3043":56414},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3587":1947,"_30795":1885,"_21329":56416,"_5":14664,"_27997":56270,"_3043":56417},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3587":1948,"_30795":1885,"_21329":56419,"_5":14664,"_27997":56274,"_3043":56420},[],"Open a CA from the inventory to review:",{"_3587":1949,"_30795":1885,"_21329":56422,"_5":14664,"_27997":56274,"_3043":56423},[],"Status and validity period.",{"_3587":1950,"_30795":1885,"_21329":56425,"_5":14664,"_27997":56274,"_3043":56426},[],"Certificate and chain in PEM format.",{"_3587":1951,"_30795":1885,"_21329":56428,"_5":14664,"_27997":56274,"_3043":56429},[],"Number of active, expired and revoked certificates.",{"_3587":1952,"_30795":1885,"_21329":56431,"_5":14664,"_27997":56274,"_3043":56432},[],"Certificates issued in **Issued Certificates**.",{"_3587":1953,"_30795":1885,"_21329":56434,"_5":14664,"_27997":56274,"_3043":56435},[],"The CRL linked to the authority.",{"_3587":1954,"_30795":1885,"_21329":56437,"_5":14664,"_27997":56274,"_3043":56438},[],"Metadata and the associated cryptographic engine.",{"_3587":1955,"_30795":1885,"_21329":56440,"_5":14664,"_27997":56274,"_3043":56441},[],"You can filter the inventory by name, status and CA type.",{"_3587":1956,"_30795":1885,"_21329":56443,"_5":14664,"_27997":56278,"_3043":56444},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3587":1957,"_30795":1885,"_21329":56446,"_5":14664,"_27997":56278,"_3043":56447},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3587":1958,"_30795":1885,"_21329":56449,"_5":14664,"_27997":56278,"_3043":56450},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3587":1959,"_30795":1885,"_21329":56452,"_5":14664,"_27997":56278,"_3043":56453},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3587":1960,"_30795":1885,"_21329":56455,"_5":14664,"_27997":56282,"_3043":56456},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3587":1961,"_30795":1885,"_21329":56458,"_5":14664,"_27997":56286,"_3043":56459},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3587":1962,"_30795":1885,"_21329":56461,"_5":14664,"_27997":56290,"_3043":56462},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3587":1963,"_30795":1885,"_21329":56464,"_5":14664,"_27997":56294,"_3043":56465},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3587":1964,"_30795":1885,"_21329":56467,"_5":14664,"_27997":56298,"_3043":56468},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3587":1965,"_30795":1885,"_21329":56470,"_5":14664,"_27997":56302,"_3043":56471},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3587":1966,"_30795":1885,"_21329":56473,"_5":14664,"_27997":56302,"_3043":56474},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3587":1967,"_30795":1885,"_21329":56476,"_5":14664,"_27997":56302,"_3043":56477},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3587":1968,"_30795":1885,"_21329":56479,"_5":14664,"_27997":56302,"_3043":56480},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3587":1969,"_30795":1969,"_5":15024,"_3043":56482,"_31154":56483,"_21329":56484,"_27997":1969},"Certificate profiles",[50381,51893,56044,56045],[],{"_3587":1970,"_30795":1969,"_21329":56486,"_5":14664,"_27997":1969,"_3043":56487},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3587":1971,"_30795":1969,"_5":31151,"_21329":56489,"_27997":56490,"_3043":56491},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3587":1972,"_30795":1969,"_5":31151,"_21329":56493,"_27997":56494,"_3043":56495},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#validity","Validity",{"_3587":1973,"_30795":1969,"_5":31151,"_21329":56497,"_27997":56498,"_3043":56499},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3587":1974,"_30795":1969,"_5":31151,"_21329":56501,"_27997":56502,"_3043":56503},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3587":1975,"_30795":1969,"_5":31151,"_21329":56505,"_27997":56506,"_3043":56507},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#subject","Subject",{"_3587":1976,"_30795":1969,"_5":31151,"_21329":56509,"_27997":56510,"_3043":56511},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3587":1977,"_30795":1969,"_5":31151,"_21329":56513,"_27997":56514,"_3043":56515},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3587":1978,"_30795":1969,"_5":31151,"_21329":56517,"_27997":56518,"_3043":56519},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3587":1979,"_30795":1969,"_5":31151,"_21329":56521,"_27997":56522,"_3043":56523},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3587":1980,"_30795":1969,"_5":31151,"_21329":56525,"_27997":56526,"_3043":56527},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3587":1981,"_30795":1969,"_5":31151,"_21329":56529,"_27997":56530,"_3043":56531},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3587":1982,"_30795":1969,"_5":31151,"_21329":56533,"_27997":56534,"_3043":56535},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3587":1983,"_30795":1969,"_5":31151,"_21329":56537,"_27997":56538,"_3043":56539},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3587":1984,"_30795":1969,"_5":31151,"_21329":56541,"_27997":56542,"_3043":56543},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3587":1985,"_30795":1969,"_5":31151,"_21329":56545,"_27997":56546,"_3043":56547},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#design-examples","Design examples",{"_3587":1986,"_30795":1969,"_5":31151,"_21329":56549,"_27997":56550,"_3043":56551},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3587":1987,"_30795":1969,"_21329":56553,"_5":14664,"_27997":1969,"_3043":56554},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3587":1988,"_30795":1969,"_21329":56556,"_5":14664,"_27997":1969,"_3043":56557},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3587":1989,"_30795":1969,"_21329":56559,"_5":14664,"_27997":56494,"_3043":56560},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3587":1990,"_30795":1969,"_21329":56562,"_5":14664,"_27997":56494,"_3043":56563},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3587":1991,"_30795":1969,"_21329":56565,"_5":14664,"_27997":56498,"_3043":56566},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3587":1992,"_30795":1969,"_21329":56568,"_5":14664,"_27997":56502,"_3043":56569},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3587":1993,"_30795":1969,"_21329":56571,"_5":14664,"_27997":56502,"_3043":56572},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3587":1994,"_30795":1969,"_21329":56574,"_5":14664,"_27997":56502,"_3043":56575},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3587":1995,"_30795":1969,"_21329":56577,"_5":14664,"_27997":56506,"_3043":56578},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3587":1996,"_30795":1969,"_21329":56580,"_5":14664,"_27997":56510,"_3043":56581},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3587":1997,"_30795":1969,"_21329":56583,"_5":14664,"_27997":56510,"_3043":56584},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3587":1998,"_30795":1969,"_21329":56586,"_5":14664,"_27997":56514,"_3043":56587},[],"The cryptographic enforcement can:",{"_3587":1999,"_30795":1969,"_21329":56589,"_5":14664,"_27997":56514,"_3043":56590},[],"allow or block RSA keys;",{"_3587":2000,"_30795":1969,"_21329":56592,"_5":14664,"_27997":56514,"_3043":56593},[],"limit the supported RSA sizes;",{"_3587":2001,"_30795":1969,"_21329":56595,"_5":14664,"_27997":56514,"_3043":56596},[],"allow or block ECDSA keys;",{"_3587":2002,"_30795":1969,"_21329":56598,"_5":14664,"_27997":56514,"_3043":56599},[],"limit the supported ECDSA sizes or curves.",{"_3587":2003,"_30795":1969,"_21329":56601,"_5":14664,"_27997":56514,"_3043":56602},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3587":2004,"_30795":1969,"_21329":56604,"_5":14664,"_27997":56518,"_3043":56605},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3587":2005,"_30795":1969,"_21329":56607,"_5":14664,"_27997":56518,"_3043":53806},[],{"_3587":2006,"_30795":1969,"_21329":56609,"_5":14664,"_27997":56518,"_3043":56610},[],"First choice",{"_3587":2007,"_30795":1969,"_21329":56612,"_5":14664,"_27997":56518,"_3043":56613},[],"Second choice",{"_3587":2008,"_30795":1969,"_21329":56615,"_5":14664,"_27997":56518,"_3043":56616},[],"If neither is supplied",{"_3587":2009,"_30795":1969,"_21329":56618,"_5":14664,"_27997":56518,"_3043":56619},[],"Direct signing with a CA",{"_3587":2010,"_30795":1969,"_21329":56621,"_5":14664,"_27997":56518,"_3043":56622},[],"`issuance_profile` embedded in the request",{"_3587":2011,"_30795":1969,"_21329":56624,"_5":14664,"_27997":56518,"_3043":56625},[],"Request `issuance_profile_id`",{"_3587":2012,"_30795":1969,"_21329":56627,"_5":14664,"_27997":56518,"_3043":56628},[],"CA default profile (`profile_id`).",{"_3587":2013,"_30795":1969,"_21329":56630,"_5":14664,"_27997":56518,"_3043":56631},[],"Issuance through a DMS",{"_3587":2014,"_30795":1969,"_21329":56633,"_5":14664,"_27997":56518,"_3043":56634},[],"`settings.issuance_profile_id`",{"_3587":2015,"_30795":1969,"_21329":56636,"_5":14664,"_27997":56518,"_3043":56637},[],"`settings.issuance_profile` embedded in the DMS",{"_3587":2016,"_30795":1969,"_21329":56639,"_5":14664,"_27997":56518,"_3043":56640},[],"Enrollment CA default profile.",{"_3587":2017,"_30795":1969,"_21329":56642,"_5":14664,"_27997":56518,"_3043":56643},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3587":2018,"_30795":1969,"_21329":56645,"_5":14664,"_27997":56518,"_3043":56646},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3587":2019,"_30795":1969,"_21329":56648,"_5":14664,"_27997":56526,"_3043":56649},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3587":2020,"_30795":1969,"_21329":56651,"_5":14664,"_27997":56530,"_3043":56652},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3587":2021,"_30795":1969,"_21329":56654,"_5":14664,"_27997":56534,"_3043":56655},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3587":2022,"_30795":1969,"_21329":56657,"_5":14664,"_27997":56538,"_3043":56658},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3587":2023,"_30795":1969,"_21329":56660,"_5":14664,"_27997":56542,"_3043":56661},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3587":2024,"_30795":1969,"_21329":56663,"_5":14664,"_27997":56542,"_3043":56664},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3587":2025,"_30795":1969,"_21329":56666,"_5":14664,"_27997":56546,"_3043":56667},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3587":2026,"_30795":1969,"_21329":56669,"_5":14664,"_27997":56546,"_3043":56670},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3587":2027,"_30795":1969,"_21329":56672,"_5":14664,"_27997":56546,"_3043":56673},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3587":2028,"_30795":1969,"_21329":56675,"_5":14664,"_27997":56546,"_3043":56676},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3587":2029,"_30795":1969,"_21329":56678,"_5":14664,"_27997":56550,"_3043":56679},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3587":2030,"_30795":1969,"_21329":56681,"_5":14664,"_27997":56550,"_3043":56682},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3587":2031,"_30795":2031,"_5":15024,"_3043":56684,"_31154":56685,"_21329":56687,"_27997":2031},"Certificate validation",[50381,51893,56044,56686],"Validation",[],{"_3587":2032,"_30795":2031,"_21329":56689,"_5":14664,"_27997":2031,"_3043":56690},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3587":2033,"_30795":2031,"_5":31151,"_21329":56692,"_27997":56693,"_3043":56694},[],"/docs/pr-preview/pr-70/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3587":2034,"_30795":2031,"_5":31151,"_21329":56696,"_27997":56697,"_3043":56698},[],"/docs/pr-preview/pr-70/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3587":2035,"_30795":2031,"_5":31151,"_21329":56700,"_27997":56701,"_3043":56702},[],"/docs/pr-preview/pr-70/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3587":2036,"_30795":2031,"_21329":56704,"_5":14664,"_27997":2031,"_3043":56705},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3587":2037,"_30795":2031,"_21329":56707,"_5":14664,"_27997":56693,"_3043":56708},[],"Verify these criteria together:",{"_3587":2038,"_30795":2031,"_21329":56710,"_5":14664,"_27997":56693,"_3043":55670},[],{"_3587":2039,"_30795":2031,"_21329":56712,"_5":14664,"_27997":56693,"_3043":56713},[],"Required result",{"_3587":2040,"_30795":2031,"_21329":56715,"_5":14664,"_27997":56693,"_3043":56716},[],"Chain and signature",{"_3587":2041,"_30795":2031,"_21329":56718,"_5":14664,"_27997":56693,"_3043":56719},[],"Valid chain to a root deliberately installed in the consumer.",{"_3587":2042,"_30795":2031,"_21329":56721,"_5":14664,"_27997":56693,"_3043":56722},[],"Dates",{"_3587":2043,"_30795":2031,"_21329":56724,"_5":14664,"_27997":56693,"_3043":56725},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3587":2044,"_30795":2031,"_21329":56727,"_5":14664,"_27997":56693,"_3043":51562},[],{"_3587":2045,"_30795":2031,"_21329":56729,"_5":14664,"_27997":56693,"_3043":56730},[],"Name, SAN or identifier matches the expected peer.",{"_3587":2046,"_30795":2031,"_21329":56732,"_5":14664,"_27997":56693,"_3043":50771},[],{"_3587":2047,"_30795":2031,"_21329":56734,"_5":14664,"_27997":56693,"_3043":56735},[],"KU, EKU and constraints permit the specific operation.",{"_3587":2048,"_30795":2031,"_21329":56737,"_5":14664,"_27997":56693,"_3043":56738},[],"Revocation",{"_3587":2049,"_30795":2031,"_21329":56740,"_5":14664,"_27997":56693,"_3043":56741},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3587":2050,"_30795":2031,"_21329":56743,"_5":14664,"_27997":56693,"_3043":56744},[],"Authorization",{"_3587":2051,"_30795":2031,"_21329":56746,"_5":14664,"_27997":56693,"_3043":56747},[],"The application permits that identity to perform the action.",{"_3587":2052,"_30795":2031,"_21329":56749,"_5":14664,"_27997":56693,"_3043":56750},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3587":2053,"_30795":2031,"_21329":56752,"_5":14664,"_27997":56697,"_3043":56753},[],"Mechanism",{"_3587":2054,"_30795":2031,"_21329":56755,"_5":14664,"_27997":56697,"_3043":56756},[],"When to use it",{"_3587":2055,"_30795":2031,"_21329":56758,"_5":14664,"_27997":56697,"_3043":56759},[],"What you must maintain",{"_3587":2056,"_30795":2031,"_21329":56761,"_5":14664,"_27997":56697,"_3043":56762},[],"OCSP",{"_3587":2057,"_30795":2031,"_21329":56764,"_5":14664,"_27997":56697,"_3043":56765},[],"Status query for a specific certificate.",{"_3587":2058,"_30795":2031,"_21329":56767,"_5":14664,"_27997":56697,"_3043":56768},[],"Responder access, signature verification and cache/freshness policy.",{"_3587":2059,"_30795":2031,"_21329":56770,"_5":14664,"_27997":56697,"_3043":56771},[],"CRL",{"_3587":2060,"_30795":2031,"_21329":56773,"_5":14664,"_27997":56697,"_3043":56774},[],"Local checks for many certificates or offline operation.",{"_3587":2061,"_30795":2031,"_21329":56776,"_5":14664,"_27997":56697,"_3043":56777},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3587":2062,"_30795":2031,"_21329":56779,"_5":14664,"_27997":56697,"_3043":56780},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3587":2063,"_30795":2031,"_21329":56782,"_5":14664,"_27997":56697,"_3043":56783},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3587":2064,"_30795":2031,"_21329":56785,"_5":14664,"_27997":56701,"_3043":56786},[],"Accept a current, authorized certificate with a known chain.",{"_3587":2065,"_30795":2031,"_21329":56788,"_5":14664,"_27997":56701,"_3043":56789},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3587":2066,"_30795":2031,"_21329":56791,"_5":14664,"_27997":56701,"_3043":56792},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3587":2067,"_30795":2031,"_21329":56794,"_5":14664,"_27997":56701,"_3043":56795},[],"Check that a new connection with that identity is rejected.",{"_3587":2068,"_30795":2031,"_21329":56797,"_5":14664,"_27997":56701,"_3043":56798},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3587":2069,"_30795":2031,"_21329":56800,"_5":14664,"_27997":56701,"_3043":56801},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3587":2070,"_30795":2031,"_21329":56803,"_5":14664,"_27997":56701,"_3043":56804},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3587":2071,"_30795":2031,"_21329":56806,"_5":14664,"_27997":56701,"_3043":56807},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3587":2072,"_30795":2031,"_21329":56809,"_5":14664,"_27997":56701,"_3043":56810},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3587":2073,"_30795":2073,"_5":15024,"_3043":56812,"_31154":56813,"_21329":56814,"_27997":2073},"Certificates",[50381,51893,56044,56045],[],{"_3587":2074,"_30795":2073,"_21329":56816,"_5":14664,"_27997":2073,"_3043":56817},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3587":2075,"_30795":2073,"_5":31151,"_21329":56819,"_27997":56820,"_3043":56821},[],"/docs/pr-preview/pr-70/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3587":2076,"_30795":2073,"_5":31151,"_21329":56823,"_27997":56824,"_3043":56825},[],"/docs/pr-preview/pr-70/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3587":2077,"_30795":2073,"_5":31151,"_21329":56827,"_27997":56828,"_3043":56829},[],"/docs/pr-preview/pr-70/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3587":2078,"_30795":2073,"_5":31151,"_21329":56831,"_27997":56832,"_3043":56833},[],"/docs/pr-preview/pr-70/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3587":2079,"_30795":2073,"_5":31151,"_21329":56835,"_27997":56836,"_3043":56837},[],"/docs/pr-preview/pr-70/platform/pki/certificates#open-the-action","Open the action",{"_3587":2080,"_30795":2073,"_5":31151,"_21329":56839,"_27997":56840,"_3043":56841},[],"/docs/pr-preview/pr-70/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3587":2081,"_30795":2073,"_5":31151,"_21329":56843,"_27997":56844,"_3043":56845},[],"/docs/pr-preview/pr-70/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3587":2082,"_30795":2073,"_5":31151,"_21329":56847,"_27997":56848,"_3043":56849},[],"/docs/pr-preview/pr-70/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3587":2083,"_30795":2073,"_5":31151,"_21329":56851,"_27997":56852,"_3043":56853},[],"/docs/pr-preview/pr-70/platform/pki/certificates#continue","Continue",{"_3587":2084,"_30795":2073,"_21329":56855,"_5":14664,"_27997":2073,"_3043":56856},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3587":2085,"_30795":2073,"_21329":56858,"_5":14664,"_27997":56820,"_3043":56859},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3587":2086,"_30795":2073,"_21329":56861,"_5":14664,"_27997":56820,"_3043":56862},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3587":2087,"_30795":2073,"_21329":56864,"_5":14664,"_27997":56820,"_3043":56865},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3587":2088,"_30795":2073,"_21329":56867,"_5":14664,"_27997":56820,"_3043":56868},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3587":2089,"_30795":2073,"_21329":56870,"_5":14664,"_27997":56820,"_3043":56871},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3587":2090,"_30795":2073,"_21329":56873,"_5":14664,"_27997":56820,"_3043":56874},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3587":2091,"_30795":2073,"_21329":56876,"_5":14664,"_27997":56820,"_3043":56877},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3587":2092,"_30795":2073,"_21329":56879,"_5":14664,"_27997":56824,"_3043":56880},[],"Download the PEM and inspect it:",{"_3587":2093,"_30795":2073,"_21329":56882,"_5":14664,"_27997":56824,"_3043":56883},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3587":2094,"_30795":2073,"_21329":56885,"_5":14664,"_27997":56828,"_3043":56886},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3587":2095,"_30795":2073,"_21329":56888,"_5":14664,"_27997":56828,"_3043":56889},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3587":2096,"_30795":2073,"_21329":56891,"_5":14664,"_27997":56828,"_3043":56892},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3587":2097,"_30795":2073,"_21329":56894,"_5":14664,"_27997":56828,"_3043":56895},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3587":2098,"_30795":2073,"_21329":56897,"_5":14664,"_27997":56828,"_3043":56898},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3587":2099,"_30795":2073,"_21329":56900,"_5":14664,"_27997":56828,"_3043":56901},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3587":2100,"_30795":2073,"_21329":56903,"_5":14664,"_27997":56828,"_3043":56904},[],"For browser key generation, follow Issue your first certificate.",{"_3587":2101,"_30795":2073,"_21329":56906,"_5":14664,"_27997":56832,"_3043":56907},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3587":2102,"_30795":2073,"_21329":56909,"_5":14664,"_27997":56836,"_3043":56910},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3587":2103,"_30795":2073,"_21329":56912,"_5":14664,"_27997":56840,"_3043":56913},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3587":2104,"_30795":2073,"_21329":56915,"_5":14664,"_27997":56844,"_3043":56916},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3587":2105,"_30795":2073,"_21329":56918,"_5":14664,"_27997":56844,"_3043":56919},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3587":2106,"_30795":2073,"_21329":56921,"_5":14664,"_27997":56844,"_3043":56922},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3587":2107,"_30795":2073,"_21329":56924,"_5":14664,"_27997":56848,"_3043":56925},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3587":2108,"_30795":2073,"_21329":56927,"_5":14664,"_27997":56848,"_3043":56928},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3587":2109,"_30795":2073,"_21329":56930,"_5":14664,"_27997":56848,"_3043":56931},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3587":2110,"_30795":2073,"_21329":56933,"_5":14664,"_27997":56852,"_3043":56934},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3587":2111,"_30795":2073,"_21329":56936,"_5":14664,"_27997":56852,"_3043":56937},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3587":2112,"_30795":2112,"_5":15024,"_3043":56939,"_31154":56940,"_21329":56942,"_27997":2112},"Certificate lifecycle",[50381,51893,56044,56941],"Concepts",[],{"_3587":2113,"_30795":2112,"_21329":56944,"_5":14664,"_27997":2112,"_3043":56945},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3587":2114,"_30795":2112,"_5":31151,"_21329":56947,"_27997":56948,"_3043":56949},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3587":2115,"_30795":2112,"_5":31151,"_21329":56951,"_27997":56952,"_3043":56953},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3587":2116,"_30795":2112,"_5":31151,"_21329":56955,"_27997":56956,"_3043":56957},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3587":2117,"_30795":2112,"_5":31151,"_21329":56959,"_27997":56960,"_3043":56961},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3587":2118,"_30795":2112,"_5":31151,"_21329":56963,"_27997":56964,"_3043":56965},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3587":2119,"_30795":2112,"_5":31151,"_21329":56967,"_27997":56968,"_3043":56969},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3587":2120,"_30795":2112,"_5":31151,"_21329":56971,"_27997":56972,"_3043":56973},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3587":2121,"_30795":2112,"_5":31151,"_21329":56975,"_27997":56976,"_3043":56977},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3587":2122,"_30795":2112,"_5":31151,"_21329":56979,"_27997":56980,"_3043":56981},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3587":2123,"_30795":2112,"_5":31151,"_21329":56983,"_27997":56984,"_3043":56985},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3587":2124,"_30795":2112,"_21329":56987,"_5":14664,"_27997":2112,"_3043":56988},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3587":2125,"_30795":2112,"_21329":56990,"_5":14664,"_27997":56952,"_3043":56991},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3587":2126,"_30795":2112,"_21329":56993,"_5":14664,"_27997":56956,"_3043":56994},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3587":2127,"_30795":2112,"_21329":56996,"_5":14664,"_27997":56960,"_3043":56997},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3587":2128,"_30795":2112,"_21329":56999,"_5":14664,"_27997":56964,"_3043":57000},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3587":2129,"_30795":2112,"_21329":57002,"_5":14664,"_27997":56968,"_3043":57003},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3587":2130,"_30795":2112,"_21329":57005,"_5":14664,"_27997":56972,"_3043":57006},[],"Lamassu persists four X.509 states:",{"_3587":2131,"_30795":2112,"_21329":57008,"_5":14664,"_27997":56972,"_3043":57009},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3587":2132,"_30795":2112,"_21329":57011,"_5":14664,"_27997":56972,"_3043":57012},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3587":2133,"_30795":2112,"_21329":57014,"_5":14664,"_27997":56972,"_3043":57015},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3587":2134,"_30795":2112,"_21329":57017,"_5":14664,"_27997":56972,"_3043":57018},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3587":2135,"_30795":2112,"_21329":57020,"_5":14664,"_27997":56972,"_3043":57021},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3587":2136,"_30795":2112,"_21329":57023,"_5":14664,"_27997":56976,"_3043":57024},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3587":2137,"_30795":2112,"_21329":57026,"_5":14664,"_27997":56976,"_3043":57027},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3587":2138,"_30795":2112,"_21329":57029,"_5":14664,"_27997":56976,"_3043":57030},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3587":2139,"_30795":2112,"_21329":57032,"_5":14664,"_27997":56980,"_3043":57033},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3587":2140,"_30795":2112,"_21329":57035,"_5":14664,"_27997":56980,"_3043":57036},[],"Before confirming:",{"_3587":2141,"_30795":2112,"_21329":57038,"_5":14664,"_27997":56980,"_3043":57039},[],"Identify DMSs, devices and services that trust that chain.",{"_3587":2142,"_30795":2112,"_21329":57041,"_5":14664,"_27997":56980,"_3043":57042},[],"Distribute the new chain of trust.",{"_3587":2143,"_30795":2112,"_21329":57044,"_5":14664,"_27997":56980,"_3043":57045},[],"Reissue the necessary identities.",{"_3587":2144,"_30795":2112,"_21329":57047,"_5":14664,"_27997":56980,"_3043":57048},[],"Check OCSP and CRL from a real consumer.",{"_3587":2145,"_30795":2112,"_21329":57050,"_5":14664,"_27997":56980,"_3043":57051},[],"Revoke the old CA once no legitimate traffic remains.",{"_3587":2146,"_30795":2112,"_21329":57053,"_5":14664,"_27997":56980,"_3043":57054},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3587":2147,"_30795":2112,"_21329":57056,"_5":14664,"_27997":56984,"_3043":57057},[],"Certificates entering the preventive or critical renewal window.",{"_3587":2148,"_30795":2112,"_21329":57059,"_5":14664,"_27997":56984,"_3043":57060},[],"Repeated enrollment or re-enrollment failures.",{"_3587":2149,"_30795":2112,"_21329":57062,"_5":14664,"_27997":56984,"_3043":57063},[],"Status changes and revocation reasons.",{"_3587":2150,"_30795":2112,"_21329":57065,"_5":14664,"_27997":56984,"_3043":57066},[],"OCSP and CRL publication and validity.",{"_3587":2151,"_30795":2112,"_21329":57068,"_5":14664,"_27997":56984,"_3043":57069},[],"Dependencies still presenting a replaced certificate.",{"_3587":2152,"_30795":2112,"_21329":57071,"_5":14664,"_27997":56984,"_3043":57072},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3587":2153,"_30795":2153,"_5":15024,"_3043":57074,"_31154":57075,"_21329":57076,"_27997":2153},"Trust model",[50381,51893,56044,56941],[],{"_3587":2154,"_30795":2153,"_21329":57078,"_5":14664,"_27997":2153,"_3043":57079},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3587":2155,"_30795":2153,"_5":31151,"_21329":57081,"_27997":57082,"_3043":57083},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3587":2156,"_30795":2153,"_5":31151,"_21329":57085,"_27997":57086,"_3043":57087},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3587":2157,"_30795":2153,"_5":31151,"_21329":57089,"_27997":57090,"_3043":57091},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3587":2158,"_30795":2153,"_5":31151,"_21329":57093,"_27997":57094,"_3043":57095},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3587":2159,"_30795":2153,"_5":31151,"_21329":57097,"_27997":57098,"_3043":57099},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3587":2160,"_30795":2153,"_5":31151,"_21329":57101,"_27997":57102,"_3043":57103},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3587":2161,"_30795":2153,"_5":31151,"_21329":57105,"_27997":57106,"_3043":57107},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3587":2162,"_30795":2153,"_5":31151,"_21329":57109,"_27997":57110,"_3043":57111},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3587":2163,"_30795":2153,"_5":31151,"_21329":57113,"_27997":57114,"_3043":57115},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3587":2164,"_30795":2153,"_5":31151,"_21329":57117,"_27997":57118,"_3043":57119},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3587":2165,"_30795":2153,"_21329":57121,"_5":14664,"_27997":2153,"_3043":57122},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3587":2166,"_30795":2153,"_21329":57124,"_5":14664,"_27997":57086,"_3043":57125},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3587":2167,"_30795":2153,"_21329":57127,"_5":14664,"_27997":57090,"_3043":57128},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3587":2168,"_30795":2153,"_21329":57130,"_5":14664,"_27997":57094,"_3043":57131},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3587":2169,"_30795":2153,"_21329":57133,"_5":14664,"_27997":57098,"_3043":57134},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3587":2170,"_30795":2153,"_21329":57136,"_5":14664,"_27997":57102,"_3043":57137},[],"The device proves it can enroll according to the DMS policy.",{"_3587":2171,"_30795":2153,"_21329":57139,"_5":14664,"_27997":57102,"_3043":57140},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3587":2172,"_30795":2153,"_21329":57142,"_5":14664,"_27997":57102,"_3043":57143},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3587":2173,"_30795":2153,"_21329":57145,"_5":14664,"_27997":57102,"_3043":57146},[],"The device installs the certificate and the chain it needs.",{"_3587":2174,"_30795":2153,"_21329":57148,"_5":14664,"_27997":57102,"_3043":57149},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3587":2175,"_30795":2153,"_21329":57151,"_5":14664,"_27997":57102,"_3043":57152},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3587":2176,"_30795":2153,"_21329":57154,"_5":14664,"_27997":57106,"_3043":57155},[],"A DMS relates three sets that are worth designing separately:",{"_3587":2177,"_30795":2153,"_21329":57157,"_5":14664,"_27997":57106,"_3043":57158},[],"**Enrollment CA:** signs the new identities.",{"_3587":2178,"_30795":2153,"_21329":57160,"_5":14664,"_27997":57106,"_3043":57161},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3587":2179,"_30795":2153,"_21329":57163,"_5":14664,"_27997":57106,"_3043":57164},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3587":2180,"_30795":2153,"_21329":57166,"_5":14664,"_27997":57106,"_3043":57167},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3587":2181,"_30795":2153,"_21329":57169,"_5":14664,"_27997":57110,"_3043":57170},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3587":2182,"_30795":2153,"_21329":57172,"_5":14664,"_27997":57110,"_3043":57173},[],"that the current date is between `Not Before` and `Not After`;",{"_3587":2183,"_30795":2153,"_21329":57175,"_5":14664,"_27997":57110,"_3043":57176},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3587":2184,"_30795":2153,"_21329":57178,"_5":14664,"_27997":57110,"_3043":57179},[],"that names, SANs and subject match the expected identity;",{"_3587":2185,"_30795":2153,"_21329":57181,"_5":14664,"_27997":57110,"_3043":57182},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3587":2186,"_30795":2153,"_21329":57184,"_5":14664,"_27997":57110,"_3043":57185},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3587":2187,"_30795":2153,"_21329":57187,"_5":14664,"_27997":57110,"_3043":57188},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3587":2188,"_30795":2153,"_21329":57190,"_5":14664,"_27997":57114,"_3043":57191},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3587":2189,"_30795":2153,"_21329":57193,"_5":14664,"_27997":57118,"_3043":57194},[],"Keep the root out of daily operations, or with very restricted access.",{"_3587":2190,"_30795":2153,"_21329":57196,"_5":14664,"_27997":57118,"_3043":57197},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3587":2191,"_30795":2153,"_21329":57199,"_5":14664,"_27997":57118,"_3043":57200},[],"Assign explicit profiles to every use case.",{"_3587":2192,"_30795":2153,"_21329":57202,"_5":14664,"_27997":57118,"_3043":57203},[],"Distribute the new trust before starting a rotation.",{"_3587":2193,"_30795":2153,"_21329":57205,"_5":14664,"_27997":57118,"_3043":57206},[],"Keep enough overlap to renew a disconnected fleet.",{"_3587":2194,"_30795":2153,"_21329":57208,"_5":14664,"_27997":57118,"_3043":57209},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3587":2195,"_30795":2153,"_21329":57211,"_5":14664,"_27997":57118,"_3043":57212},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3587":2196,"_30795":2196,"_5":15024,"_3043":57214,"_31154":57215,"_21329":57216,"_27997":2196},"Revocation lists (CRL)",[50381,51893,56044,56686],[],{"_3587":2197,"_30795":2196,"_21329":57218,"_5":14664,"_27997":2196,"_3043":57219},[],"Generate and distribute signed lists to validate certificates offline.",{"_3587":2198,"_30795":2196,"_5":31151,"_21329":57221,"_27997":57222,"_3043":57223},[],"/docs/pr-preview/pr-70/platform/pki/crl#crl-settings","CRL settings",{"_3587":2199,"_30795":2196,"_5":31151,"_21329":57225,"_27997":57226,"_3043":57227},[],"/docs/pr-preview/pr-70/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3587":2200,"_30795":2196,"_5":31151,"_21329":57229,"_27997":57230,"_3043":57231},[],"/docs/pr-preview/pr-70/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3587":2201,"_30795":2196,"_5":31151,"_21329":57233,"_27997":57234,"_3043":57235},[],"/docs/pr-preview/pr-70/platform/pki/crl#crl-contents","CRL contents",{"_3587":2202,"_30795":2196,"_5":31151,"_21329":57237,"_27997":57238,"_3043":57239},[],"/docs/pr-preview/pr-70/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3587":2203,"_30795":2196,"_5":31151,"_21329":57241,"_27997":57242,"_3043":57243},[],"/docs/pr-preview/pr-70/platform/pki/crl#crl-settings-api","CRL settings API",{"_3587":2204,"_30795":2196,"_5":31151,"_21329":57245,"_27997":57246,"_3043":57247},[],"/docs/pr-preview/pr-70/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3587":2205,"_30795":2196,"_5":31151,"_21329":57249,"_27997":57250,"_3043":57251},[],"/docs/pr-preview/pr-70/platform/pki/crl#references","References",{"_3587":2206,"_30795":2196,"_21329":57253,"_5":14664,"_27997":2196,"_3043":57254},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3587":2207,"_30795":2196,"_21329":57256,"_5":14664,"_27997":57222,"_3043":57257},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3587":2208,"_30795":2196,"_21329":57259,"_5":14664,"_27997":57222,"_3043":57260},[],"Field",{"_3587":2209,"_30795":2196,"_21329":57262,"_5":14664,"_27997":57222,"_3043":50771},[],{"_3587":2210,"_30795":2196,"_21329":57264,"_5":14664,"_27997":57222,"_3043":52013},[],{"_3587":2211,"_30795":2196,"_21329":57266,"_5":14664,"_27997":57222,"_3043":57267},[],"ID of the CA the settings belong to.",{"_3587":2212,"_30795":2196,"_21329":57269,"_5":14664,"_27997":57222,"_3043":57270},[],"`status`",{"_3587":2213,"_30795":2196,"_21329":57272,"_5":14664,"_27997":57222,"_3043":57273},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3587":2214,"_30795":2196,"_21329":57275,"_5":14664,"_27997":57222,"_3043":57276},[],"`legacy_ski`",{"_3587":2215,"_30795":2196,"_21329":57278,"_5":14664,"_27997":57222,"_3043":57279},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3587":2216,"_30795":2196,"_21329":57281,"_5":14664,"_27997":57222,"_3043":57282},[],"`latest_crl`",{"_3587":2217,"_30795":2196,"_21329":57284,"_5":14664,"_27997":57222,"_3043":57285},[],"Version, validity start and end of the last published list. Read-only.",{"_3587":2218,"_30795":2196,"_21329":57287,"_5":14664,"_27997":57222,"_3043":57288},[],"`crl_options` field",{"_3587":2219,"_30795":2196,"_21329":57290,"_5":14664,"_27997":57222,"_3043":50771},[],{"_3587":2220,"_30795":2196,"_21329":57292,"_5":14664,"_27997":57222,"_3043":57293},[],"Initial value",{"_3587":2221,"_30795":2196,"_21329":57295,"_5":14664,"_27997":57222,"_3043":57296},[],"`validity`",{"_3587":2222,"_30795":2196,"_21329":57298,"_5":14664,"_27997":57222,"_3043":57299},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3587":2223,"_30795":2196,"_21329":57301,"_5":14664,"_27997":57222,"_3043":57302},[],"7 days.",{"_3587":2224,"_30795":2196,"_21329":57304,"_5":14664,"_27997":57222,"_3043":57305},[],"`refresh_interval`",{"_3587":2225,"_30795":2196,"_21329":57307,"_5":14664,"_27997":57222,"_3043":57308},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3587":2226,"_30795":2196,"_21329":57310,"_5":14664,"_27997":57222,"_3043":57311},[],"6 days and 23 hours.",{"_3587":2227,"_30795":2196,"_21329":57313,"_5":14664,"_27997":57222,"_3043":57314},[],"`regenerate_on_revoke`",{"_3587":2228,"_30795":2196,"_21329":57316,"_5":14664,"_27997":57222,"_3043":57317},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3587":2229,"_30795":2196,"_21329":57319,"_5":14664,"_27997":57222,"_3043":57320},[],"`true`.",{"_3587":2230,"_30795":2196,"_21329":57322,"_5":14664,"_27997":57222,"_3043":57323},[],"`signer_serial_number`",{"_3587":2231,"_30795":2196,"_21329":57325,"_5":14664,"_27997":57222,"_3043":57326},[],"Serial number of the existing certificate that signs the CRL.",{"_3587":2232,"_30795":2196,"_21329":57328,"_5":14664,"_27997":57222,"_3043":57329},[],"Serial number of the CA’s current certificate.",{"_3587":2233,"_30795":2196,"_21329":57331,"_5":14664,"_27997":57222,"_3043":57332},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3587":2234,"_30795":2196,"_21329":57334,"_5":14664,"_27997":57222,"_3043":57335},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3587":2235,"_30795":2196,"_21329":57337,"_5":14664,"_27997":57222,"_3043":57338},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3587":2236,"_30795":2196,"_21329":57340,"_5":14664,"_27997":57222,"_3043":57341},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3587":2237,"_30795":2196,"_21329":57343,"_5":14664,"_27997":57222,"_3043":57344},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3587":2238,"_30795":2196,"_21329":57346,"_5":14664,"_27997":57222,"_3043":57347},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3587":2239,"_30795":2196,"_21329":57349,"_5":14664,"_27997":57222,"_3043":57350},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3587":2240,"_30795":2196,"_21329":57352,"_5":14664,"_27997":57222,"_3043":57353},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3587":2241,"_30795":2196,"_21329":57355,"_5":14664,"_27997":57222,"_3043":57356},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3587":2242,"_30795":2196,"_21329":57358,"_5":14664,"_27997":57222,"_3043":57359},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3587":2243,"_30795":2196,"_21329":57361,"_5":14664,"_27997":57222,"_3043":57362},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3587":2244,"_30795":2196,"_21329":57364,"_5":14664,"_27997":57226,"_3043":57365},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3587":2245,"_30795":2196,"_21329":57367,"_5":14664,"_27997":57226,"_3043":57368},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3587":2246,"_30795":2196,"_21329":57370,"_5":14664,"_27997":57226,"_3043":57371},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3587":2247,"_30795":2196,"_21329":57373,"_5":14664,"_27997":57226,"_3043":57374},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3587":2248,"_30795":2196,"_21329":57376,"_5":14664,"_27997":57230,"_3043":57377},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3587":2249,"_30795":2196,"_21329":57379,"_5":14664,"_27997":57230,"_3043":57380},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3587":2250,"_30795":2196,"_21329":57382,"_5":14664,"_27997":57230,"_3043":57383},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3587":2251,"_30795":2196,"_21329":57385,"_5":14664,"_27997":57230,"_3043":57386},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3587":2252,"_30795":2196,"_21329":57388,"_5":14664,"_27997":57230,"_3043":57389},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3587":2253,"_30795":2196,"_21329":57391,"_5":14664,"_27997":57230,"_3043":57392},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3587":2254,"_30795":2196,"_21329":57394,"_5":14664,"_27997":57230,"_3043":57395},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3587":2255,"_30795":2196,"_21329":57397,"_5":14664,"_27997":57230,"_3043":57398},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3587":2256,"_30795":2196,"_21329":57400,"_5":14664,"_27997":57230,"_3043":57401},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3587":2257,"_30795":2196,"_21329":57403,"_5":14664,"_27997":57234,"_3043":57404},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3587":2258,"_30795":2196,"_21329":57406,"_5":14664,"_27997":57234,"_3043":57407},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3587":2259,"_30795":2196,"_21329":57409,"_5":14664,"_27997":57238,"_3043":57410},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3587":2260,"_30795":2196,"_21329":57412,"_5":14664,"_27997":57238,"_3043":57413},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3587":2261,"_30795":2196,"_21329":57415,"_5":14664,"_27997":57238,"_3043":57416},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3587":2262,"_30795":2196,"_21329":57418,"_5":14664,"_27997":57238,"_3043":57419},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3587":2263,"_30795":2196,"_21329":57421,"_5":14664,"_27997":57238,"_3043":57422},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3587":2264,"_30795":2196,"_21329":57424,"_5":14664,"_27997":57242,"_3043":57425},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3587":2265,"_30795":2196,"_21329":57427,"_5":14664,"_27997":57242,"_3043":53809},[],{"_3587":2266,"_30795":2196,"_21329":57429,"_5":14664,"_27997":57242,"_3043":57430},[],"Relative path",{"_3587":2267,"_30795":2196,"_21329":57432,"_5":14664,"_27997":57242,"_3043":53806},[],{"_3587":2268,"_30795":2196,"_21329":57434,"_5":14664,"_27997":57242,"_3043":57435},[],"`GET`",{"_3587":2269,"_30795":2196,"_21329":57437,"_5":14664,"_27997":57242,"_3043":57438},[],"`/v1/crl-settings`",{"_3587":2270,"_30795":2196,"_21329":57440,"_5":14664,"_27997":57242,"_3043":57441},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3587":2271,"_30795":2196,"_21329":57443,"_5":14664,"_27997":57242,"_3043":57435},[],{"_3587":2272,"_30795":2196,"_21329":57445,"_5":14664,"_27997":57242,"_3043":57446},[],"`/v1/crl-settings/{ca-id}`",{"_3587":2273,"_30795":2196,"_21329":57448,"_5":14664,"_27997":57242,"_3043":57449},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3587":2274,"_30795":2196,"_21329":57451,"_5":14664,"_27997":57242,"_3043":57452},[],"`PUT`",{"_3587":2275,"_30795":2196,"_21329":57454,"_5":14664,"_27997":57242,"_3043":57446},[],{"_3587":2276,"_30795":2196,"_21329":57456,"_5":14664,"_27997":57242,"_3043":57457},[],"Replace the CRL configuration of a CA.",{"_3587":2277,"_30795":2196,"_21329":57459,"_5":14664,"_27997":57242,"_3043":57460},[],"`DELETE`",{"_3587":2278,"_30795":2196,"_21329":57462,"_5":14664,"_27997":57242,"_3043":57446},[],{"_3587":2279,"_30795":2196,"_21329":57464,"_5":14664,"_27997":57242,"_3043":57465},[],"Remove the archived CRL settings of a CA.",{"_3587":2280,"_30795":2196,"_21329":57467,"_5":14664,"_27997":57242,"_3043":57468},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3587":2281,"_30795":2196,"_21329":57470,"_5":14664,"_27997":57242,"_3043":57471},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3587":2282,"_30795":2196,"_21329":57473,"_5":14664,"_27997":57242,"_3043":57474},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3587":2283,"_30795":2196,"_21329":57476,"_5":14664,"_27997":57246,"_3043":57477},[],"Symptom",{"_3587":2284,"_30795":2196,"_21329":57479,"_5":14664,"_27997":57246,"_3043":57480},[],"Cause",{"_3587":2285,"_30795":2196,"_21329":57482,"_5":14664,"_27997":57246,"_3043":57483},[],"Action",{"_3587":2286,"_30795":2196,"_21329":57485,"_5":14664,"_27997":57246,"_3043":57486},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3587":2287,"_30795":2196,"_21329":57488,"_5":14664,"_27997":57246,"_3043":57489},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3587":2288,"_30795":2196,"_21329":57491,"_5":14664,"_27997":57246,"_3043":57492},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3587":2289,"_30795":2196,"_21329":57494,"_5":14664,"_27997":57246,"_3043":57495},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3587":2290,"_30795":2196,"_21329":57497,"_5":14664,"_27997":57246,"_3043":57498},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3587":2291,"_30795":2196,"_21329":57500,"_5":14664,"_27997":57246,"_3043":57501},[],"Delete the CA first; deleting it archives its settings.",{"_3587":2292,"_30795":2196,"_21329":57503,"_5":14664,"_27997":57246,"_3043":57504},[],"`PUT` returns 400.",{"_3587":2293,"_30795":2196,"_21329":57506,"_5":14664,"_27997":57246,"_3043":57507},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3587":2294,"_30795":2196,"_21329":57509,"_5":14664,"_27997":57246,"_3043":57510},[],"Set the serial number of a valid certificate of that CA.",{"_3587":2295,"_30795":2196,"_21329":57512,"_5":14664,"_27997":57246,"_3043":57513},[],"`PUT` returns 404.",{"_3587":2296,"_30795":2196,"_21329":57515,"_5":14664,"_27997":57246,"_3043":57516},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3587":2297,"_30795":2196,"_21329":57518,"_5":14664,"_27997":57246,"_3043":57519},[],"Check the CA ID and the signer serial number.",{"_3587":2298,"_30795":2196,"_21329":57521,"_5":14664,"_27997":57246,"_3043":57522},[],"`PUT` returns 400 from a 3.x client.",{"_3587":2299,"_30795":2196,"_21329":57524,"_5":14664,"_27997":57246,"_3043":57525},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3587":2300,"_30795":2196,"_21329":57527,"_5":14664,"_27997":57246,"_3043":57528},[],"Update the client to send the new field.",{"_3587":2301,"_30795":2196,"_21329":57530,"_5":14664,"_27997":57246,"_3043":57531},[],"The CRL does not change after revoking a certificate.",{"_3587":2302,"_30795":2196,"_21329":57533,"_5":14664,"_27997":57246,"_3043":57534},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3587":2303,"_30795":2196,"_21329":57536,"_5":14664,"_27997":57246,"_3043":57537},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3587":2304,"_30795":2196,"_21329":57539,"_5":14664,"_27997":57246,"_3043":57540},[],"A verifier rejects the CRL because of the issuer.",{"_3587":2305,"_30795":2196,"_21329":57542,"_5":14664,"_27997":57246,"_3043":57543},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3587":2306,"_30795":2196,"_21329":57545,"_5":14664,"_27997":57246,"_3043":57546},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3587":2307,"_30795":2196,"_21329":57548,"_5":14664,"_27997":57250,"_3043":57549},[],"RFC 5280: X.509 and CRL profile.",{"_3587":2308,"_30795":2196,"_21329":57551,"_5":14664,"_27997":57250,"_3043":57552},[],"OpenSSL: openssl-crl.",{"_3587":2309,"_30795":2196,"_21329":57554,"_5":14664,"_27997":57250,"_3043":57555},[],"OpenSSL: openssl-verify.",{"_3587":2310,"_30795":2196,"_21329":57557,"_5":14664,"_27997":57250,"_3043":57558},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3587":2311,"_30795":2196,"_21329":57560,"_5":14664,"_27997":57250,"_3043":57561},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3587":2312,"_30795":2312,"_5":15024,"_3043":57563,"_31154":57564,"_21329":57565,"_27997":2312},"Keys and cryptographic engines",[50381,51893,56044,56045],[],{"_3587":2313,"_30795":2312,"_21329":57567,"_5":14664,"_27997":2312,"_3043":57568},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3587":2314,"_30795":2312,"_5":31151,"_21329":57570,"_27997":57571,"_3043":57572},[],"/docs/pr-preview/pr-70/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3587":2315,"_30795":2312,"_5":31151,"_21329":57574,"_27997":57575,"_3043":57576},[],"/docs/pr-preview/pr-70/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3587":2316,"_30795":2312,"_5":31151,"_21329":57578,"_27997":57579,"_3043":57580},[],"/docs/pr-preview/pr-70/platform/pki/key-management#file-system","File System",{"_3587":2317,"_30795":2312,"_5":31151,"_21329":57582,"_27997":57583,"_3043":57584},[],"/docs/pr-preview/pr-70/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3587":2318,"_30795":2312,"_5":31151,"_21329":57586,"_27997":57587,"_3043":57588},[],"/docs/pr-preview/pr-70/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3587":2319,"_30795":2312,"_5":31151,"_21329":57590,"_27997":57591,"_3043":57592},[],"/docs/pr-preview/pr-70/platform/pki/key-management#aws-kms","AWS KMS",{"_3587":2320,"_30795":2312,"_5":31151,"_21329":57594,"_27997":57595,"_3043":57596},[],"/docs/pr-preview/pr-70/platform/pki/key-management#pkcs11","PKCS#11",{"_3587":2321,"_30795":2312,"_5":31151,"_21329":57598,"_27997":57599,"_3043":57600},[],"/docs/pr-preview/pr-70/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3587":2322,"_30795":2312,"_5":31151,"_21329":57602,"_27997":57603,"_3043":57604},[],"/docs/pr-preview/pr-70/platform/pki/key-management#key-inventory","Key inventory",{"_3587":2323,"_30795":2312,"_5":31151,"_21329":57606,"_27997":57607,"_3043":57608},[],"/docs/pr-preview/pr-70/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3587":2324,"_30795":2312,"_5":31151,"_21329":57610,"_27997":57611,"_3043":57612},[],"/docs/pr-preview/pr-70/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3587":2325,"_30795":2312,"_5":31151,"_21329":57614,"_27997":57615,"_3043":57616},[],"/docs/pr-preview/pr-70/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3587":2326,"_30795":2312,"_5":31151,"_21329":57618,"_27997":57619,"_3043":57620},[],"/docs/pr-preview/pr-70/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3587":2327,"_30795":2312,"_5":31151,"_21329":57622,"_27997":57623,"_3043":57624},[],"/docs/pr-preview/pr-70/platform/pki/key-management#view-details","View details",{"_3587":2328,"_30795":2312,"_5":31151,"_21329":57626,"_27997":57627,"_3043":57628},[],"/docs/pr-preview/pr-70/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3587":2329,"_30795":2312,"_5":31151,"_21329":57630,"_27997":57631,"_3043":57632},[],"/docs/pr-preview/pr-70/platform/pki/key-management#sign","Sign",{"_3587":2330,"_30795":2312,"_5":31151,"_21329":57634,"_27997":57635,"_3043":57636},[],"/docs/pr-preview/pr-70/platform/pki/key-management#verify","Verify",{"_3587":2331,"_30795":2312,"_5":31151,"_21329":57638,"_27997":57639,"_3043":57640},[],"/docs/pr-preview/pr-70/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3587":2332,"_30795":2312,"_5":31151,"_21329":57642,"_27997":57643,"_3043":57644},[],"/docs/pr-preview/pr-70/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3587":2333,"_30795":2312,"_5":31151,"_21329":57646,"_27997":57647,"_3043":57648},[],"/docs/pr-preview/pr-70/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3587":2334,"_30795":2312,"_21329":57650,"_5":14664,"_27997":2312,"_3043":57651},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3587":2335,"_30795":2312,"_21329":57653,"_5":14664,"_27997":2312,"_3043":57654},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3587":2336,"_30795":2312,"_21329":57656,"_5":14664,"_27997":57571,"_3043":57657},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3587":2337,"_30795":2312,"_21329":57659,"_5":14664,"_27997":57571,"_3043":57660},[],"In practice, it lets you:",{"_3587":2338,"_30795":2312,"_21329":57662,"_5":14664,"_27997":57571,"_3043":57663},[],"Generate new key pairs from Lamassu IoT.",{"_3587":2339,"_30795":2312,"_21329":57665,"_5":14664,"_27997":57571,"_3043":57666},[],"Import keys created externally.",{"_3587":2340,"_30795":2312,"_21329":57668,"_5":14664,"_27997":57571,"_3043":57669},[],"Delegate custody and cryptographic operations to external engines.",{"_3587":2341,"_30795":2312,"_21329":57671,"_5":14664,"_27997":57571,"_3043":57672},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3587":2342,"_30795":2312,"_21329":57674,"_5":14664,"_27997":57575,"_3043":57675},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3587":2343,"_30795":2312,"_21329":57677,"_5":14664,"_27997":57575,"_3043":57678},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3587":2344,"_30795":2312,"_21329":57680,"_5":14664,"_27997":57575,"_3043":57681},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3587":2345,"_30795":2312,"_21329":57683,"_5":14664,"_27997":57579,"_3043":57684},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3587":2346,"_30795":2312,"_21329":57686,"_5":14664,"_27997":57583,"_3043":57687},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3587":2347,"_30795":2312,"_21329":57689,"_5":14664,"_27997":57583,"_3043":57690},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3587":2348,"_30795":2312,"_21329":57692,"_5":14664,"_27997":57587,"_3043":57693},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3587":2349,"_30795":2312,"_21329":57695,"_5":14664,"_27997":57591,"_3043":57696},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3587":2350,"_30795":2312,"_21329":57698,"_5":14664,"_27997":57595,"_3043":57699},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3587":2351,"_30795":2312,"_21329":57701,"_5":14664,"_27997":57599,"_3043":57702},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3587":2352,"_30795":2312,"_21329":57704,"_5":14664,"_27997":57599,"_3043":57705},[],"Lamassu shows the enabled engines in the console.",{"_3587":2353,"_30795":2312,"_21329":57707,"_5":14664,"_27997":57599,"_3043":57708},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3587":2354,"_30795":2312,"_21329":57710,"_5":14664,"_27997":57599,"_3043":57711},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3587":2355,"_30795":2312,"_21329":57713,"_5":14664,"_27997":57603,"_3043":57714},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3587":2356,"_30795":2312,"_21329":57716,"_5":14664,"_27997":57603,"_3043":57717},[],"The table includes the following fields:",{"_3587":2357,"_30795":2312,"_21329":57719,"_5":14664,"_27997":57603,"_3043":57720},[],"**Name**: descriptive name of the key.",{"_3587":2358,"_30795":2312,"_21329":57722,"_5":14664,"_27997":57603,"_3043":57723},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3587":2359,"_30795":2312,"_21329":57725,"_5":14664,"_27997":57603,"_3043":57726},[],"**Strength**: visual indicator of cryptographic strength.",{"_3587":2360,"_30795":2312,"_21329":57728,"_5":14664,"_27997":57603,"_3043":57729},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3587":2361,"_30795":2312,"_21329":57731,"_5":14664,"_27997":57603,"_3043":57732},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3587":2362,"_30795":2312,"_21329":57734,"_5":14664,"_27997":57603,"_3043":57735},[],"**Aliases**: alternative names associated with the key.",{"_3587":2363,"_30795":2312,"_21329":57737,"_5":14664,"_27997":57603,"_3043":57738},[],"**Tags**: labels for classification and search.",{"_3587":2364,"_30795":2312,"_21329":57740,"_5":14664,"_27997":57603,"_3043":57741},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3587":2365,"_30795":2312,"_21329":57743,"_5":14664,"_27997":57603,"_3043":57744},[],"From this view you also reach the most common actions:",{"_3587":2366,"_30795":2312,"_21329":57746,"_5":14664,"_27997":57603,"_3043":57747},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3587":2367,"_30795":2312,"_21329":57749,"_5":14664,"_27997":57603,"_3043":57750},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3587":2368,"_30795":2312,"_21329":57752,"_5":14664,"_27997":57603,"_3043":57753},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3587":2369,"_30795":2312,"_21329":57755,"_5":14664,"_27997":57603,"_3043":57756},[],"**Delete Key** to remove the key from the system.",{"_3587":2370,"_30795":2312,"_21329":57758,"_5":14664,"_27997":57607,"_3043":57759},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3587":2371,"_30795":2312,"_21329":57761,"_5":14664,"_27997":57611,"_3043":57762},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3587":2372,"_30795":2312,"_21329":57764,"_5":14664,"_27997":57611,"_3043":57765},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3587":2373,"_30795":2312,"_21329":57767,"_5":14664,"_27997":57611,"_3043":57768},[],"**Key Name**: unique and descriptive name.",{"_3587":2374,"_30795":2312,"_21329":57770,"_5":14664,"_27997":57611,"_3043":57771},[],"**Crypto Engine**: engine that will keep the key.",{"_3587":2375,"_30795":2312,"_21329":57773,"_5":14664,"_27997":57611,"_3043":57774},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3587":2376,"_30795":2312,"_21329":57776,"_5":14664,"_27997":57611,"_3043":57777},[],"**Tags**: metadata to classify the key.",{"_3587":2377,"_30795":2312,"_21329":57779,"_5":14664,"_27997":57611,"_3043":57780},[],"**Metadata**: additional information for advanced uses.",{"_3587":2378,"_30795":2312,"_21329":57782,"_5":14664,"_27997":57615,"_3043":57783},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3587":2379,"_30795":2312,"_21329":57785,"_5":14664,"_27997":57615,"_3043":57786},[],"When you have an exportable private key and the destination engine supports import.",{"_3587":2380,"_30795":2312,"_21329":57788,"_5":14664,"_27997":57615,"_3043":57789},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3587":2381,"_30795":2312,"_21329":57791,"_5":14664,"_27997":57615,"_3043":57792},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3587":2382,"_30795":2312,"_21329":57794,"_5":14664,"_27997":57615,"_3043":57795},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3587":2383,"_30795":2312,"_21329":57797,"_5":14664,"_27997":57615,"_3043":57798},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3587":2384,"_30795":2312,"_21329":57800,"_5":14664,"_27997":57615,"_3043":57801},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3587":2385,"_30795":2312,"_21329":57803,"_5":14664,"_27997":57615,"_3043":57804},[],"**Tags**: labels for organization and search.",{"_3587":2386,"_30795":2312,"_21329":57806,"_5":14664,"_27997":57615,"_3043":57807},[],"**Metadata**: additional optional information.",{"_3587":2387,"_30795":2312,"_21329":57809,"_5":14664,"_27997":57615,"_3043":57810},[],"**Private Key (PEM)**: private key in PEM format.",{"_3587":2388,"_30795":2312,"_21329":57812,"_5":14664,"_27997":57615,"_3043":57813},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3587":2389,"_30795":2312,"_21329":57815,"_5":14664,"_27997":57619,"_3043":57816},[],"Each registered key has a detail view and several operational actions.",{"_3587":2390,"_30795":2312,"_21329":57818,"_5":14664,"_27997":57623,"_3043":57819},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3587":2391,"_30795":2312,"_21329":57821,"_5":14664,"_27997":57623,"_3043":57822},[],"The **Overview** tab shows, among others, these fields:",{"_3587":2392,"_30795":2312,"_21329":57824,"_5":14664,"_27997":57623,"_3043":57825},[],"**Key Name**: descriptive name.",{"_3587":2393,"_30795":2312,"_21329":57827,"_5":14664,"_27997":57623,"_3043":57828},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3587":2394,"_30795":2312,"_21329":57830,"_5":14664,"_27997":57623,"_3043":57831},[],"**Tags**: associated labels.",{"_3587":2395,"_30795":2312,"_21329":57833,"_5":14664,"_27997":57623,"_3043":57834},[],"**Aliases**: alternative names.",{"_3587":2396,"_30795":2312,"_21329":57836,"_5":14664,"_27997":57623,"_3043":57837},[],"**Crypto Engine**: engine where the key resides.",{"_3587":2397,"_30795":2312,"_21329":57839,"_5":14664,"_27997":57623,"_3043":57840},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3587":2398,"_30795":2312,"_21329":57842,"_5":14664,"_27997":57623,"_3043":57843},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3587":2399,"_30795":2312,"_21329":57845,"_5":14664,"_27997":57623,"_3043":57846},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3587":2400,"_30795":2312,"_21329":57848,"_5":14664,"_27997":57627,"_3043":57849},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3587":2401,"_30795":2312,"_21329":57851,"_5":14664,"_27997":57627,"_3043":57852},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3587":2402,"_30795":2312,"_21329":57854,"_5":14664,"_27997":57627,"_3043":57855},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3587":2403,"_30795":2312,"_21329":57857,"_5":14664,"_27997":57631,"_3043":57858},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3587":2404,"_30795":2312,"_21329":57860,"_5":14664,"_27997":57631,"_3043":57861},[],"Main fields:",{"_3587":2405,"_30795":2312,"_21329":57863,"_5":14664,"_27997":57631,"_3043":57864},[],"**Algorithm**: signing algorithm available for the key type.",{"_3587":2406,"_30795":2312,"_21329":57866,"_5":14664,"_27997":57631,"_3043":57867},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3587":2407,"_30795":2312,"_21329":57869,"_5":14664,"_27997":57631,"_3043":57870},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3587":2408,"_30795":2312,"_21329":57872,"_5":14664,"_27997":57631,"_3043":57873},[],"**Message**: content to sign.",{"_3587":2409,"_30795":2312,"_21329":57875,"_5":14664,"_27997":57631,"_3043":57876},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3587":2410,"_30795":2312,"_21329":57878,"_5":14664,"_27997":57635,"_3043":57879},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3587":2411,"_30795":2312,"_21329":57881,"_5":14664,"_27997":57635,"_3043":57861},[],{"_3587":2412,"_30795":2312,"_21329":57883,"_5":14664,"_27997":57635,"_3043":57884},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3587":2413,"_30795":2312,"_21329":57886,"_5":14664,"_27997":57635,"_3043":57887},[],"**Message Type**: `Raw` or `Digest`.",{"_3587":2414,"_30795":2312,"_21329":57889,"_5":14664,"_27997":57635,"_3043":57890},[],"**Payload Encoding**: encoding of the message.",{"_3587":2415,"_30795":2312,"_21329":57892,"_5":14664,"_27997":57635,"_3043":57893},[],"**Message**: original message or hash.",{"_3587":2416,"_30795":2312,"_21329":57895,"_5":14664,"_27997":57635,"_3043":57896},[],"**Signature**: signature to check.",{"_3587":2417,"_30795":2312,"_21329":57898,"_5":14664,"_27997":57635,"_3043":57899},[],"**Result**: indicator of the validation result.",{"_3587":2418,"_30795":2312,"_21329":57901,"_5":14664,"_27997":57639,"_3043":57902},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3587":2419,"_30795":2312,"_21329":57904,"_5":14664,"_27997":57639,"_3043":57905},[],"This flow is useful for:",{"_3587":2420,"_30795":2312,"_21329":57907,"_5":14664,"_27997":57639,"_3043":57908},[],"Requesting certificates from an external CA.",{"_3587":2421,"_30795":2312,"_21329":57910,"_5":14664,"_27997":57639,"_3043":57911},[],"Renewing an identity while keeping the same key.",{"_3587":2422,"_30795":2312,"_21329":57913,"_5":14664,"_27997":57639,"_3043":57914},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3587":2423,"_30795":2312,"_21329":57916,"_5":14664,"_27997":57639,"_3043":57917},[],"**Common Name (CN)**: main name of the identity.",{"_3587":2424,"_30795":2312,"_21329":57919,"_5":14664,"_27997":57639,"_3043":57920},[],"**Organization (O)**: organization or company.",{"_3587":2425,"_30795":2312,"_21329":57922,"_5":14664,"_27997":57639,"_3043":57923},[],"**Organizational Unit (OU)**: department or unit.",{"_3587":2426,"_30795":2312,"_21329":57925,"_5":14664,"_27997":57639,"_3043":57926},[],"**Country (C)**: two-letter country code.",{"_3587":2427,"_30795":2312,"_21329":57928,"_5":14664,"_27997":57639,"_3043":57929},[],"**State / Province (ST)**: state or province.",{"_3587":2428,"_30795":2312,"_21329":57931,"_5":14664,"_27997":57639,"_3043":57932},[],"**Locality (L)**: city or locality.",{"_3587":2429,"_30795":2312,"_21329":57934,"_5":14664,"_27997":57639,"_3043":57935},[],"**Email Address**: contact email.",{"_3587":2430,"_30795":2312,"_21329":57937,"_5":14664,"_27997":57639,"_3043":57938},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3587":2431,"_30795":2312,"_21329":57940,"_5":14664,"_27997":57639,"_3043":57941},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3587":2432,"_30795":2312,"_21329":57943,"_5":14664,"_27997":57643,"_3043":57944},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3587":2433,"_30795":2312,"_21329":57946,"_5":14664,"_27997":57643,"_3043":57947},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3587":2434,"_30795":2312,"_21329":57949,"_5":14664,"_27997":57647,"_3043":57950},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3587":2435,"_30795":2312,"_21329":57952,"_5":14664,"_27997":57647,"_3043":57953},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3587":2436,"_30795":2436,"_5":15024,"_3043":57955,"_31154":57956,"_21329":57957,"_27997":2436},"Online validation with OCSP",[50381,51893,56044,56686],[],{"_3587":2437,"_30795":2436,"_21329":57959,"_5":14664,"_27997":2436,"_3043":57960},[],"Query signed status and verify the responder’s response.",{"_3587":2438,"_30795":2436,"_5":31151,"_21329":57962,"_27997":57963,"_3043":57964},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3587":2439,"_30795":2436,"_5":31151,"_21329":57966,"_27997":57967,"_3043":57968},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3587":2440,"_30795":2436,"_5":31151,"_21329":57970,"_27997":57971,"_3043":57972},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3587":2441,"_30795":2436,"_5":31151,"_21329":57974,"_27997":57975,"_3043":57976},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3587":2442,"_30795":2436,"_5":31151,"_21329":57978,"_27997":57979,"_3043":57980},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3587":2443,"_30795":2436,"_5":31151,"_21329":57982,"_27997":57983,"_3043":57251},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#references",{"_3587":2444,"_30795":2436,"_21329":57985,"_5":14664,"_27997":2436,"_3043":57986},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3587":2445,"_30795":2436,"_21329":57988,"_5":14664,"_27997":57963,"_3043":57989},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3587":2446,"_30795":2436,"_21329":57991,"_5":14664,"_27997":57963,"_3043":57992},[],"Record status",{"_3587":2447,"_30795":2436,"_21329":57994,"_5":14664,"_27997":57963,"_3043":57995},[],"Signed response",{"_3587":2448,"_30795":2436,"_21329":57997,"_5":14664,"_27997":57963,"_3043":55181},[],{"_3587":2449,"_30795":2436,"_21329":57999,"_5":14664,"_27997":57963,"_3043":58000},[],"`Good`.",{"_3587":2450,"_30795":2436,"_21329":58002,"_5":14664,"_27997":57963,"_3043":55198},[],{"_3587":2451,"_30795":2436,"_21329":58004,"_5":14664,"_27997":57963,"_3043":58005},[],"`Revoked`, with revocation reason and timestamp.",{"_3587":2452,"_30795":2436,"_21329":58007,"_5":14664,"_27997":57963,"_3043":58008},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3587":2453,"_30795":2436,"_21329":58010,"_5":14664,"_27997":57963,"_3043":58011},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3587":2454,"_30795":2436,"_21329":58013,"_5":14664,"_27997":57963,"_3043":58014},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3587":2455,"_30795":2436,"_21329":58016,"_5":14664,"_27997":57963,"_3043":58017},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3587":2456,"_30795":2436,"_21329":58019,"_5":14664,"_27997":57963,"_3043":58020},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3587":2457,"_30795":2436,"_21329":58022,"_5":14664,"_27997":57967,"_3043":58023},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3587":2458,"_30795":2436,"_21329":58025,"_5":14664,"_27997":57967,"_3043":58026},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3587":2459,"_30795":2436,"_21329":58028,"_5":14664,"_27997":57971,"_3043":58029},[],"The service accepts:",{"_3587":2460,"_30795":2436,"_21329":58031,"_5":14664,"_27997":57971,"_3043":53809},[],{"_3587":2461,"_30795":2436,"_21329":58033,"_5":14664,"_27997":57971,"_3043":58034},[],"VA service path",{"_3587":2462,"_30795":2436,"_21329":58036,"_5":14664,"_27997":57971,"_3043":58037},[],"Format",{"_3587":2463,"_30795":2436,"_21329":58039,"_5":14664,"_27997":57971,"_3043":58040},[],"`POST`",{"_3587":2464,"_30795":2436,"_21329":58042,"_5":14664,"_27997":57971,"_3043":58043},[],"`/ocsp`",{"_3587":2465,"_30795":2436,"_21329":58045,"_5":14664,"_27997":57971,"_3043":58046},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3587":2466,"_30795":2436,"_21329":58048,"_5":14664,"_27997":57971,"_3043":57435},[],{"_3587":2467,"_30795":2436,"_21329":58050,"_5":14664,"_27997":57971,"_3043":58051},[],"`/ocsp/{ocsp_request}`",{"_3587":2468,"_30795":2436,"_21329":58053,"_5":14664,"_27997":57971,"_3043":58054},[],"DER request encoded using padded URL Base64.",{"_3587":2469,"_30795":2436,"_21329":58056,"_5":14664,"_27997":57971,"_3043":58057},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3587":2470,"_30795":2436,"_21329":58059,"_5":14664,"_27997":57975,"_3043":58060},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3587":2471,"_30795":2436,"_21329":58062,"_5":14664,"_27997":57975,"_3043":58063},[],"Generate the request:",{"_3587":2472,"_30795":2436,"_21329":58065,"_5":14664,"_27997":57975,"_3043":58066},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3587":2473,"_30795":2436,"_21329":58068,"_5":14664,"_27997":57975,"_3043":58069},[],"Replace the example URL with the inspected endpoint:",{"_3587":2474,"_30795":2436,"_21329":58071,"_5":14664,"_27997":57975,"_3043":58072},[],"Verify the returned DER:",{"_3587":2475,"_30795":2436,"_21329":58074,"_5":14664,"_27997":57975,"_3043":58075},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3587":2476,"_30795":2436,"_21329":58077,"_5":14664,"_27997":57979,"_3043":58078},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3587":2477,"_30795":2436,"_21329":58080,"_5":14664,"_27997":57979,"_3043":58081},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3587":2478,"_30795":2436,"_21329":58083,"_5":14664,"_27997":57983,"_3043":58084},[],"RFC 6960: OCSP.",{"_3587":2479,"_30795":2436,"_21329":58086,"_5":14664,"_27997":57983,"_3043":58087},[],"OpenSSL: openssl-ocsp.",{"_3587":2480,"_30795":2436,"_21329":58089,"_5":14664,"_27997":57983,"_3043":58090},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3587":2481,"_30795":2436,"_21329":58092,"_5":14664,"_27997":57983,"_3043":57561},[],{"_3587":2482,"_30795":2482,"_5":15024,"_3043":56044,"_31154":58094,"_21329":58095,"_27997":2482},[50381,51893,56044],[],{"_3587":2483,"_30795":2482,"_21329":58097,"_5":14664,"_27997":2482,"_3043":58098},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3587":2484,"_30795":2482,"_5":31151,"_21329":58100,"_27997":58101,"_3043":55356},[],"/docs/pr-preview/pr-70/platform/pki/overview#start-here",{"_3587":2485,"_30795":2482,"_5":31151,"_21329":58103,"_27997":58104,"_3043":58105},[],"/docs/pr-preview/pr-70/platform/pki/overview#what-you-need","What you need",{"_3587":2486,"_30795":2482,"_5":31151,"_21329":58107,"_27997":58108,"_3043":55888},[],"/docs/pr-preview/pr-70/platform/pki/overview#core-capabilities",{"_3587":2487,"_30795":2482,"_5":31151,"_21329":58110,"_27997":58111,"_3043":55892},[],"/docs/pr-preview/pr-70/platform/pki/overview#build-your-trust-hierarchy",{"_3587":2488,"_30795":2482,"_5":31151,"_21329":58113,"_27997":58114,"_3043":55896},[],"/docs/pr-preview/pr-70/platform/pki/overview#protect-cryptographic-keys",{"_3587":2489,"_30795":2482,"_5":31151,"_21329":58116,"_27997":58117,"_3043":55900},[],"/docs/pr-preview/pr-70/platform/pki/overview#issue-and-control-certificates",{"_3587":2490,"_30795":2482,"_5":31151,"_21329":58119,"_27997":58120,"_3043":55908},[],"/docs/pr-preview/pr-70/platform/pki/overview#publish-validation-status",{"_3587":2491,"_30795":2482,"_5":31151,"_21329":58122,"_27997":58123,"_3043":58124},[],"/docs/pr-preview/pr-70/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3587":2492,"_30795":2482,"_5":31151,"_21329":58126,"_27997":58127,"_3043":56853},[],"/docs/pr-preview/pr-70/platform/pki/overview#continue",{"_3587":2493,"_30795":2482,"_21329":58129,"_5":14664,"_27997":2482,"_3043":58130},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3587":2494,"_30795":2482,"_21329":58132,"_5":14664,"_27997":58101,"_3043":58133},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3587":2495,"_30795":2482,"_21329":58135,"_5":14664,"_27997":58101,"_3043":58136},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3587":2496,"_30795":2482,"_21329":58138,"_5":14664,"_27997":58104,"_3043":58139},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3587":2497,"_30795":2482,"_21329":58141,"_5":14664,"_27997":58104,"_3043":58142},[],"An available cryptographic engine to keep the authority's key.",{"_3587":2498,"_30795":2482,"_21329":58144,"_5":14664,"_27997":58104,"_3043":58145},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3587":2499,"_30795":2482,"_21329":58147,"_5":14664,"_27997":58104,"_3043":58148},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3587":2500,"_30795":2482,"_21329":58150,"_5":14664,"_27997":58104,"_3043":58151},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3587":2501,"_30795":2482,"_21329":58153,"_5":14664,"_27997":58111,"_3043":58154},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3587":2502,"_30795":2482,"_21329":58156,"_5":14664,"_27997":58114,"_3043":58157},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3587":2503,"_30795":2482,"_21329":58159,"_5":14664,"_27997":58117,"_3043":58160},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3587":2504,"_30795":2482,"_21329":58162,"_5":14664,"_27997":58120,"_3043":58163},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3587":2505,"_30795":2482,"_21329":58165,"_5":14664,"_27997":58123,"_3043":58166},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3587":2506,"_30795":2482,"_21329":58168,"_5":14664,"_27997":58123,"_3043":58169},[],"its subject and extensions identify the expected client;",{"_3587":2507,"_30795":2482,"_21329":58171,"_5":14664,"_27997":58123,"_3043":58172},[],"its public key matches the client's private key;",{"_3587":2508,"_30795":2482,"_21329":58174,"_5":14664,"_27997":58123,"_3043":58175},[],"its chain reaches a root trusted by the consumer;",{"_3587":2509,"_30795":2482,"_21329":58177,"_5":14664,"_27997":58123,"_3043":58178},[],"its dates and usages allow the operation;",{"_3587":2510,"_30795":2482,"_21329":58180,"_5":14664,"_27997":58123,"_3043":58181},[],"the consumer applies revocation checks and authorization.",{"_3587":2511,"_30795":2482,"_21329":58183,"_5":14664,"_27997":58123,"_3043":58184},[],"The issuance path includes the first independent checks.",{"_3587":2512,"_30795":2482,"_21329":58186,"_5":14664,"_27997":58127,"_3043":58187},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3587":2513,"_30795":2482,"_21329":58189,"_5":14664,"_27997":58127,"_3043":58190},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3587":2514,"_30795":2482,"_21329":58192,"_5":14664,"_27997":58127,"_3043":58193},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3587":2515,"_30795":2515,"_5":15024,"_3043":58195,"_31154":58196,"_21329":58197,"_27997":2515},"Create your first CA",[50381,51893,56044,55481],[],{"_3587":2516,"_30795":2515,"_21329":58199,"_5":14664,"_27997":2515,"_3043":58200},[],"Create an evaluation root and check its certificate before issuing.",{"_3587":2517,"_30795":2515,"_5":31151,"_21329":58202,"_27997":58203,"_3043":50391},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3587":2518,"_30795":2515,"_5":31151,"_21329":58205,"_27997":58206,"_3043":58207},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3587":2519,"_30795":2515,"_5":31151,"_21329":58209,"_27997":58210,"_3043":58211},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3587":2520,"_30795":2515,"_5":31151,"_21329":58213,"_27997":58214,"_3043":58215},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3587":2521,"_30795":2515,"_5":31151,"_21329":58217,"_27997":58218,"_3043":58219},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3587":2522,"_30795":2515,"_5":31151,"_21329":58221,"_27997":58222,"_3043":58223},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3587":2523,"_30795":2515,"_5":31151,"_21329":58225,"_27997":58226,"_3043":58227},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3587":2524,"_30795":2515,"_5":31151,"_21329":58229,"_27997":58230,"_3043":55738},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3587":2525,"_30795":2515,"_5":31151,"_21329":58232,"_27997":58233,"_3043":50415},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3587":2526,"_30795":2515,"_21329":58235,"_5":14664,"_27997":2515,"_3043":58236},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3587":2527,"_30795":2515,"_21329":58238,"_5":14664,"_27997":58203,"_3043":58239},[],"Console access and permission to create keys and authorities.",{"_3587":2528,"_30795":2515,"_21329":58241,"_5":14664,"_27997":58203,"_3043":58242},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3587":2529,"_30795":2515,"_21329":58244,"_5":14664,"_27997":58203,"_3043":58245},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3587":2530,"_30795":2515,"_21329":58247,"_5":14664,"_27997":58203,"_3043":58248},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3587":2531,"_30795":2515,"_21329":58250,"_5":14664,"_27997":58206,"_3043":58251},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3587":2532,"_30795":2515,"_21329":58253,"_5":14664,"_27997":58206,"_3043":58254},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3587":2533,"_30795":2515,"_21329":58256,"_5":14664,"_27997":58210,"_3043":58257},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3587":2534,"_30795":2515,"_21329":58259,"_5":14664,"_27997":58210,"_3043":58260},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3587":2535,"_30795":2515,"_21329":58262,"_5":14664,"_27997":58214,"_3043":58263},[],"Select **Root CA** and complete:",{"_3587":2536,"_30795":2515,"_21329":58265,"_5":14664,"_27997":58214,"_3043":58266},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3587":2537,"_30795":2515,"_21329":58268,"_5":14664,"_27997":58214,"_3043":58269},[],"**Subject**: organization and country details for your evaluation.",{"_3587":2538,"_30795":2515,"_21329":58271,"_5":14664,"_27997":58214,"_3043":58272},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3587":2539,"_30795":2515,"_21329":58274,"_5":14664,"_27997":58214,"_3043":58275},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3587":2540,"_30795":2515,"_21329":58277,"_5":14664,"_27997":58214,"_3043":58278},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3587":2541,"_30795":2515,"_21329":58280,"_5":14664,"_27997":58218,"_3043":58281},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3587":2542,"_30795":2515,"_21329":58283,"_5":14664,"_27997":58222,"_3043":58284},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3587":2543,"_30795":2515,"_21329":58286,"_5":14664,"_27997":58222,"_3043":58287},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3587":2544,"_30795":2515,"_21329":58289,"_5":14664,"_27997":58226,"_3043":58290},[],"Run from the directory where you saved `ca.pem`:",{"_3587":2545,"_30795":2515,"_21329":58292,"_5":14664,"_27997":58226,"_3043":58293},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3587":2546,"_30795":2515,"_21329":58295,"_5":14664,"_27997":58226,"_3043":58296},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3587":2547,"_30795":2515,"_21329":58298,"_5":14664,"_27997":58230,"_3043":58299},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3587":2548,"_30795":2515,"_21329":58301,"_5":14664,"_27997":58230,"_3043":58302},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3587":2549,"_30795":2515,"_21329":58304,"_5":14664,"_27997":58230,"_3043":58305},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3587":2550,"_30795":2515,"_21329":58307,"_5":14664,"_27997":58230,"_3043":58308},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3587":2551,"_30795":2515,"_21329":58310,"_5":14664,"_27997":58233,"_3043":58311},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3587":2552,"_30795":2552,"_5":15024,"_3043":58313,"_31154":58314,"_21329":58315,"_27997":2552},"Issue and verify a certificate",[50381,51893,56044,55481],[],{"_3587":2553,"_30795":2552,"_21329":58317,"_5":14664,"_27997":2552,"_3043":58318},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3587":2554,"_30795":2552,"_5":31151,"_21329":58320,"_27997":58321,"_3043":50391},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3587":2555,"_30795":2552,"_5":31151,"_21329":58323,"_27997":58324,"_3043":58325},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3587":2556,"_30795":2552,"_5":31151,"_21329":58327,"_27997":58328,"_3043":58329},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3587":2557,"_30795":2552,"_5":31151,"_21329":58331,"_27997":58332,"_3043":58333},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3587":2558,"_30795":2552,"_5":31151,"_21329":58335,"_27997":58336,"_3043":58337},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3587":2559,"_30795":2552,"_5":31151,"_21329":58339,"_27997":58340,"_3043":58341},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3587":2560,"_30795":2552,"_5":31151,"_21329":58343,"_27997":58344,"_3043":58345},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3587":2561,"_30795":2552,"_5":31151,"_21329":58347,"_27997":58348,"_3043":58349},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3587":2562,"_30795":2552,"_5":31151,"_21329":58351,"_27997":58352,"_3043":58353},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3587":2563,"_30795":2552,"_5":31151,"_21329":58355,"_27997":58356,"_3043":58357},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3587":2564,"_30795":2552,"_5":31151,"_21329":58359,"_27997":58360,"_3043":55738},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3587":2565,"_30795":2552,"_5":31151,"_21329":58362,"_27997":58363,"_3043":50415},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#next-step",{"_3587":2566,"_30795":2552,"_21329":58365,"_5":14664,"_27997":2552,"_3043":58366},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3587":2567,"_30795":2552,"_21329":58368,"_5":14664,"_27997":58321,"_3043":58369},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3587":2568,"_30795":2552,"_21329":58371,"_5":14664,"_27997":58321,"_3043":58372},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3587":2569,"_30795":2552,"_21329":58374,"_5":14664,"_27997":58321,"_3043":58375},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3587":2570,"_30795":2552,"_21329":58377,"_5":14664,"_27997":58321,"_3043":58378},[],"A client identifier: here we use `device-001`.",{"_3587":2571,"_30795":2552,"_21329":58380,"_5":14664,"_27997":58321,"_3043":58381},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3587":2572,"_30795":2552,"_21329":58383,"_5":14664,"_27997":58324,"_3043":58384},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3587":2573,"_30795":2552,"_21329":58386,"_5":14664,"_27997":58328,"_3043":58387},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3587":2574,"_30795":2552,"_21329":58389,"_5":14664,"_27997":58328,"_3043":58390},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3587":2575,"_30795":2552,"_21329":58392,"_5":14664,"_27997":58332,"_3043":58393},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3587":2576,"_30795":2552,"_21329":58395,"_5":14664,"_27997":58332,"_3043":58396},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3587":2577,"_30795":2552,"_21329":58398,"_5":14664,"_27997":58336,"_3043":58399},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3587":2578,"_30795":2552,"_21329":58401,"_5":14664,"_27997":58336,"_3043":58402},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3587":2579,"_30795":2552,"_21329":58404,"_5":14664,"_27997":58340,"_3043":58405},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3587":2580,"_30795":2552,"_21329":58407,"_5":14664,"_27997":58344,"_3043":58408},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3587":2581,"_30795":2552,"_21329":58410,"_5":14664,"_27997":58348,"_3043":58411},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3587":2582,"_30795":2552,"_21329":58413,"_5":14664,"_27997":58352,"_3043":58414},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3587":2583,"_30795":2552,"_21329":58416,"_5":14664,"_27997":58352,"_3043":58417},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3587":2584,"_30795":2552,"_21329":58419,"_5":14664,"_27997":58352,"_3043":58420},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3587":2585,"_30795":2552,"_21329":58422,"_5":14664,"_27997":58356,"_3043":58423},[],"In Bash, compare the two public-key digests:",{"_3587":2586,"_30795":2552,"_21329":58425,"_5":14664,"_27997":58356,"_3043":58426},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3587":2587,"_30795":2552,"_21329":58428,"_5":14664,"_27997":58356,"_3043":58429},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3587":2588,"_30795":2552,"_21329":58431,"_5":14664,"_27997":58360,"_3043":55822},[],{"_3587":2589,"_30795":2552,"_21329":58433,"_5":14664,"_27997":58360,"_3043":58434},[],"What to review",{"_3587":2590,"_30795":2552,"_21329":58436,"_5":14664,"_27997":58360,"_3043":58437},[],"The CA rejects issuance",{"_3587":2591,"_30795":2552,"_21329":58439,"_5":14664,"_27997":58360,"_3043":58440},[],"Permissions, CA state and key, algorithm and profile.",{"_3587":2592,"_30795":2552,"_21329":58442,"_5":14664,"_27997":58360,"_3043":58443},[],"Different subject or usages",{"_3587":2593,"_30795":2552,"_21329":58445,"_5":14664,"_27997":58360,"_3043":58446},[],"Applied profile and requested values.",{"_3587":2594,"_30795":2552,"_21329":58448,"_5":14664,"_27997":58360,"_3043":58449},[],"Issuer cannot be found",{"_3587":2595,"_30795":2552,"_21329":58451,"_5":14664,"_27997":58360,"_3043":58452},[],"Downloaded CA and required intermediate chain.",{"_3587":2596,"_30795":2552,"_21329":58454,"_5":14664,"_27997":58360,"_3043":58455},[],"Validity fails",{"_3587":2597,"_30795":2552,"_21329":58457,"_5":14664,"_27997":58360,"_3043":58458},[],"Certificate and CA dates, and the computer's clock.",{"_3587":2598,"_30795":2552,"_21329":58460,"_5":14664,"_27997":58360,"_3043":58461},[],"Public-key digests differ",{"_3587":2599,"_30795":2552,"_21329":58463,"_5":14664,"_27997":58360,"_3043":58464},[],"Certificate and key files from the same issuance.",{"_3587":2600,"_30795":2552,"_21329":58466,"_5":14664,"_27997":58360,"_3043":58467},[],"See PKI diagnostics to narrow an issuance failure.",{"_3587":2601,"_30795":2552,"_21329":58469,"_5":14664,"_27997":58363,"_3043":58470},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3587":2602,"_30795":2552,"_21329":58472,"_5":14664,"_27997":58363,"_3043":58473},[],"Manage certificates for inspection, status and revocation.",{"_3587":2603,"_30795":2552,"_21329":58475,"_5":14664,"_27997":58363,"_3043":58476},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3587":2604,"_30795":2552,"_21329":58478,"_5":14664,"_27997":58363,"_3043":58479},[],"Prepare EST for the device to request its next identities.",{"_3587":2605,"_30795":2552,"_21329":58481,"_5":14664,"_27997":58363,"_3043":58482},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3587":2606,"_30795":2606,"_5":15024,"_3043":58484,"_31154":58485,"_21329":58486,"_27997":2606},"PKI getting started",[50381,51893,56044,55481],[],{"_3587":2607,"_30795":2606,"_21329":58488,"_5":14664,"_27997":2606,"_3043":58489},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3587":2608,"_30795":2606,"_5":31151,"_21329":58491,"_27997":58492,"_3043":50391},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/overview#before-you-begin",{"_3587":2609,"_30795":2606,"_5":31151,"_21329":58494,"_27997":58495,"_3043":58496},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3587":2610,"_30795":2606,"_5":31151,"_21329":58498,"_27997":58499,"_3043":55673},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/overview#expected-result",{"_3587":2611,"_30795":2606,"_5":31151,"_21329":58501,"_27997":58502,"_3043":58503},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3587":2612,"_30795":2606,"_21329":58505,"_5":14664,"_27997":2606,"_3043":58506},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3587":2613,"_30795":2606,"_21329":58508,"_5":14664,"_27997":58492,"_3043":58509},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3587":2614,"_30795":2606,"_21329":58511,"_5":14664,"_27997":58492,"_3043":58512},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3587":2615,"_30795":2606,"_21329":58514,"_5":14664,"_27997":58492,"_3043":58515},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3587":2616,"_30795":2606,"_21329":58517,"_5":14664,"_27997":58492,"_3043":58518},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3587":2617,"_30795":2606,"_21329":58520,"_5":14664,"_27997":58492,"_3043":58521},[],"A working directory with restricted access for the downloaded key.",{"_3587":2618,"_30795":2606,"_21329":58523,"_5":14664,"_27997":58495,"_3043":58524},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3587":2619,"_30795":2606,"_21329":58526,"_5":14664,"_27997":58495,"_3043":58527},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3587":2620,"_30795":2606,"_21329":58529,"_5":14664,"_27997":58495,"_3043":58530},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3587":2621,"_30795":2606,"_21329":58532,"_5":14664,"_27997":58495,"_3043":58533},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3587":2622,"_30795":2606,"_21329":58535,"_5":14664,"_27997":58499,"_3043":58536},[],"File or resource",{"_3587":2623,"_30795":2606,"_21329":58538,"_5":14664,"_27997":58499,"_3043":55670},[],{"_3587":2624,"_30795":2606,"_21329":58540,"_5":14664,"_27997":58499,"_3043":58541},[],"Active root CA and `ca.pem`",{"_3587":2625,"_30795":2606,"_21329":58543,"_5":14664,"_27997":58499,"_3043":58544},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3587":2626,"_30795":2606,"_21329":58546,"_5":14664,"_27997":58499,"_3043":58547},[],"End-entity certificate and `device.crt`",{"_3587":2627,"_30795":2606,"_21329":58549,"_5":14664,"_27997":58499,"_3043":58550},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3587":2628,"_30795":2606,"_21329":58552,"_5":14664,"_27997":58499,"_3043":58553},[],"Private key `device.key`",{"_3587":2629,"_30795":2606,"_21329":58555,"_5":14664,"_27997":58499,"_3043":58556},[],"Its public key matches the one included in `device.crt`.",{"_3587":2630,"_30795":2606,"_21329":58558,"_5":14664,"_27997":58499,"_3043":58559},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3587":2631,"_30795":2606,"_21329":58561,"_5":14664,"_27997":58502,"_3043":58562},[],"To operate certificates, continue with Certificates and Validation.",{"_3587":2632,"_30795":2606,"_21329":58564,"_5":14664,"_27997":58502,"_3043":58565},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3587":2633,"_30795":2606,"_21329":58567,"_5":14664,"_27997":58502,"_3043":58568},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3587":2634,"_30795":2634,"_5":15024,"_3043":58570,"_31154":58571,"_21329":58572,"_27997":2634},"PKI troubleshooting",[50381,51893,56044,54619],[],{"_3587":2635,"_30795":2634,"_21329":58574,"_5":14664,"_27997":2634,"_3043":58575},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3587":2636,"_30795":2634,"_5":31151,"_21329":58577,"_27997":58578,"_3043":58579},[],"/docs/pr-preview/pr-70/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3587":2637,"_30795":2634,"_5":31151,"_21329":58581,"_27997":58582,"_3043":58583},[],"/docs/pr-preview/pr-70/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3587":2638,"_30795":2634,"_5":31151,"_21329":58585,"_27997":58586,"_3043":58587},[],"/docs/pr-preview/pr-70/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3587":2639,"_30795":2634,"_21329":58589,"_5":14664,"_27997":2634,"_3043":58590},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3587":2640,"_30795":2634,"_21329":58592,"_5":14664,"_27997":2634,"_3043":58593},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3587":2641,"_30795":2634,"_21329":58595,"_5":14664,"_27997":58578,"_3043":55670},[],{"_3587":2642,"_30795":2634,"_21329":58597,"_5":14664,"_27997":58578,"_3043":58598},[],"What to inspect",{"_3587":2643,"_30795":2634,"_21329":58600,"_5":14664,"_27997":58578,"_3043":50415},[],{"_3587":2644,"_30795":2634,"_21329":58602,"_5":14664,"_27997":58578,"_3043":54886},[],{"_3587":2645,"_30795":2634,"_21329":58604,"_5":14664,"_27997":58578,"_3043":58605},[],"Exists, is active and has usable dates.",{"_3587":2646,"_30795":2634,"_21329":58607,"_5":14664,"_27997":58578,"_3043":58608},[],"Authorities.",{"_3587":2647,"_30795":2634,"_21329":58610,"_5":14664,"_27997":58578,"_3043":58611},[],"Key",{"_3587":2648,"_30795":2634,"_21329":58613,"_5":14664,"_27997":58578,"_3043":58614},[],"The record has a usable private key and the engine can sign.",{"_3587":2649,"_30795":2634,"_21329":58616,"_5":14664,"_27997":58578,"_3043":58617},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3587":2650,"_30795":2634,"_21329":58619,"_5":14664,"_27997":58578,"_3043":58620},[],"CSR",{"_3587":2651,"_30795":2634,"_21329":58622,"_5":14664,"_27997":58578,"_3043":58623},[],"Correct PEM and verifiable signature.",{"_3587":2652,"_30795":2634,"_21329":58625,"_5":14664,"_27997":58578,"_3043":58626},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3587":2653,"_30795":2634,"_21329":58628,"_5":14664,"_27997":58578,"_3043":58629},[],"Profile",{"_3587":2654,"_30795":2634,"_21329":58631,"_5":14664,"_27997":58578,"_3043":58632},[],"Selected source, existing ID, allowed algorithm and size.",{"_3587":2655,"_30795":2634,"_21329":58634,"_5":14664,"_27997":58578,"_3043":58635},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3587":2656,"_30795":2634,"_21329":58637,"_5":14664,"_27997":58578,"_3043":55822},[],{"_3587":2657,"_30795":2634,"_21329":58639,"_5":14664,"_27997":58578,"_3043":58640},[],"Appropriate subject, SAN, usages and dates.",{"_3587":2658,"_30795":2634,"_21329":58642,"_5":14664,"_27997":58578,"_3043":58643},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3587":2659,"_30795":2634,"_21329":58645,"_5":14664,"_27997":58578,"_3043":58646},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3587":2660,"_30795":2634,"_21329":58648,"_5":14664,"_27997":58578,"_3043":58649},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3587":2661,"_30795":2634,"_21329":58651,"_5":14664,"_27997":58582,"_3043":58652},[],"Check each boundary independently:",{"_3587":2662,"_30795":2634,"_21329":58654,"_5":14664,"_27997":58582,"_3043":58655},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3587":2663,"_30795":2634,"_21329":58657,"_5":14664,"_27997":58582,"_3043":58658},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3587":2664,"_30795":2634,"_21329":58660,"_5":14664,"_27997":58582,"_3043":58661},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3587":2665,"_30795":2634,"_21329":58663,"_5":14664,"_27997":58582,"_3043":58664},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3587":2666,"_30795":2634,"_21329":58666,"_5":14664,"_27997":58582,"_3043":58667},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3587":2667,"_30795":2634,"_21329":58669,"_5":14664,"_27997":58582,"_3043":58670},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3587":2668,"_30795":2634,"_21329":58672,"_5":14664,"_27997":58586,"_3043":58673},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3587":2669,"_30795":2634,"_21329":58675,"_5":14664,"_27997":58586,"_3043":58676},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3587":2670,"_30795":2670,"_5":15024,"_3043":58678,"_31154":58679,"_21329":58680,"_27997":2670},"Security",[50381],[],{"_3587":2671,"_30795":2670,"_21329":58682,"_5":14664,"_27997":2670,"_3043":58683},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3587":2672,"_30795":2670,"_5":31151,"_21329":58685,"_27997":58686,"_3043":58687},[],"/docs/pr-preview/pr-70/security#report-a-vulnerability","Report a vulnerability",{"_3587":2673,"_30795":2670,"_5":31151,"_21329":58689,"_27997":58690,"_3043":58691},[],"/docs/pr-preview/pr-70/security#what-to-include-in-a-report","What to include in a report",{"_3587":2674,"_30795":2670,"_5":31151,"_21329":58693,"_27997":58694,"_3043":58695},[],"/docs/pr-preview/pr-70/security#supported-versions","Supported versions",{"_3587":2675,"_30795":2670,"_5":31151,"_21329":58697,"_27997":58698,"_3043":58699},[],"/docs/pr-preview/pr-70/security#responsible-disclosure","Responsible disclosure",{"_3587":2676,"_30795":2670,"_21329":58701,"_5":14664,"_27997":2670,"_3043":58702},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3587":2677,"_30795":2670,"_21329":58704,"_5":14664,"_27997":58686,"_3043":58705},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3587":2678,"_30795":2670,"_21329":58707,"_5":14664,"_27997":58686,"_3043":58708},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3587":2679,"_30795":2670,"_21329":58710,"_5":14664,"_27997":58686,"_3043":15301},[],{"_3587":2680,"_30795":2670,"_21329":58712,"_5":14664,"_27997":58686,"_3043":15231},[],{"_3587":2681,"_30795":2670,"_21329":58714,"_5":14664,"_27997":58686,"_3043":15288},[],{"_3587":2682,"_30795":2670,"_21329":58716,"_5":14664,"_27997":58686,"_3043":58717},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3587":2683,"_30795":2670,"_21329":58719,"_5":14664,"_27997":58686,"_3043":58720},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3587":2684,"_30795":2670,"_21329":58722,"_5":14664,"_27997":58690,"_3043":58723},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3587":2685,"_30795":2670,"_21329":58725,"_5":14664,"_27997":58690,"_3043":58726},[],"Do not include in the report:",{"_3587":2686,"_30795":2670,"_21329":58728,"_5":14664,"_27997":58690,"_3043":58729},[],"Credentials, tokens, or private keys",{"_3587":2687,"_30795":2670,"_21329":58731,"_5":14664,"_27997":58690,"_3043":58732},[],"Customer data or customer-identifiable information",{"_3587":2688,"_30795":2670,"_21329":58734,"_5":14664,"_27997":58690,"_3043":58735},[],"Confidential architecture or internal infrastructure details",{"_3587":2689,"_30795":2670,"_21329":58737,"_5":14664,"_27997":58694,"_3043":58738},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3587":2690,"_30795":2670,"_21329":58740,"_5":14664,"_27997":58694,"_3043":58741},[],"For upgrade guidance, see Upgrades.",{"_3587":2691,"_30795":2670,"_21329":58743,"_5":14664,"_27997":58698,"_3043":58744},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3587":2692,"_30795":2670,"_21329":58746,"_5":14664,"_27997":58698,"_3043":58747},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3587":2693,"_30795":2670,"_21329":58749,"_5":14664,"_27997":58698,"_3043":58750},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3587":2694,"_30795":2670,"_21329":58752,"_5":14664,"_27997":58698,"_3043":58753},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3587":2695,"_30795":2670,"_21329":58755,"_5":14664,"_27997":58698,"_3043":58756},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3587":2696,"_30795":2696,"_5":15024,"_3043":58758,"_31154":58759,"_21329":58761,"_27997":2696},"3.8.0 to 4.0.0",[50381,58760],"Upgrades",[],{"_3587":2697,"_30795":2696,"_21329":58763,"_5":14664,"_27997":2696,"_3043":58764},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3587":2698,"_30795":2696,"_5":31151,"_21329":58766,"_27997":58767,"_3043":58768},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3587":2699,"_30795":2696,"_5":31151,"_21329":58770,"_27997":58771,"_3043":58772},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3587":2700,"_30795":2696,"_5":31151,"_21329":58774,"_27997":58775,"_3043":58776},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3587":2701,"_30795":2696,"_5":31151,"_21329":58778,"_27997":58779,"_3043":58780},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3587":2702,"_30795":2696,"_5":31151,"_21329":58782,"_27997":58783,"_3043":58784},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3587":2703,"_30795":2696,"_5":31151,"_21329":58786,"_27997":58787,"_3043":58788},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3587":2704,"_30795":2696,"_5":31151,"_21329":58790,"_27997":58791,"_3043":58792},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3587":2705,"_30795":2696,"_5":31151,"_21329":58794,"_27997":58795,"_3043":58796},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3587":2706,"_30795":2696,"_5":31151,"_21329":58798,"_27997":58799,"_3043":58800},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3587":2707,"_30795":2696,"_5":31151,"_21329":58802,"_27997":58803,"_3043":58804},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3587":2708,"_30795":2696,"_5":31151,"_21329":58806,"_27997":58807,"_3043":51019},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3587":2709,"_30795":2696,"_5":31151,"_21329":58809,"_27997":58810,"_3043":58811},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3587":2710,"_30795":2696,"_5":31151,"_21329":58813,"_27997":58814,"_3043":58815},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3587":2711,"_30795":2696,"_5":31151,"_21329":58817,"_27997":58818,"_3043":58819},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3587":2712,"_30795":2696,"_5":31151,"_21329":58821,"_27997":58822,"_3043":58823},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3587":2713,"_30795":2696,"_5":31151,"_21329":58825,"_27997":58826,"_3043":58827},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3587":2714,"_30795":2696,"_5":31151,"_21329":58829,"_27997":58830,"_3043":58831},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3587":2715,"_30795":2696,"_5":31151,"_21329":58833,"_27997":58834,"_3043":58835},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3587":2716,"_30795":2696,"_5":31151,"_21329":58837,"_27997":58838,"_3043":58839},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3587":2717,"_30795":2696,"_5":31151,"_21329":58841,"_27997":58842,"_3043":58843},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3587":2718,"_30795":2696,"_5":31151,"_21329":58845,"_27997":58846,"_3043":58847},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3587":2719,"_30795":2696,"_5":31151,"_21329":58849,"_27997":58850,"_3043":58851},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3587":2720,"_30795":2696,"_5":31151,"_21329":58853,"_27997":58854,"_3043":58855},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3587":2721,"_30795":2696,"_5":31151,"_21329":58857,"_27997":58858,"_3043":58859},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3587":2722,"_30795":2696,"_5":31151,"_21329":58861,"_27997":58862,"_3043":58863},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3587":2723,"_30795":2696,"_5":31151,"_21329":58865,"_27997":58866,"_3043":58867},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3587":2724,"_30795":2696,"_5":31151,"_21329":58869,"_27997":58870,"_3043":58871},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3587":2725,"_30795":2696,"_5":31151,"_21329":58873,"_27997":58874,"_3043":58875},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3587":2726,"_30795":2696,"_5":31151,"_21329":58877,"_27997":58878,"_3043":58879},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3587":2727,"_30795":2696,"_5":31151,"_21329":58881,"_27997":58882,"_3043":58883},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3587":2728,"_30795":2696,"_5":31151,"_21329":58885,"_27997":58886,"_3043":58887},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3587":2729,"_30795":2696,"_5":31151,"_21329":58889,"_27997":58890,"_3043":58891},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3587":2730,"_30795":2696,"_5":31151,"_21329":58893,"_27997":58894,"_3043":58895},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3587":2731,"_30795":2696,"_5":31151,"_21329":58897,"_27997":58898,"_3043":58899},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3587":2732,"_30795":2696,"_5":31151,"_21329":58901,"_27997":58902,"_3043":58903},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3587":2733,"_30795":2696,"_5":31151,"_21329":58905,"_27997":58906,"_3043":58907},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3587":2734,"_30795":2696,"_5":31151,"_21329":58909,"_27997":58910,"_3043":58911},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3587":2735,"_30795":2696,"_5":31151,"_21329":58913,"_27997":58914,"_3043":58915},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3587":2736,"_30795":2696,"_5":31151,"_21329":58917,"_27997":58918,"_3043":58919},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3587":2737,"_30795":2696,"_5":31151,"_21329":58921,"_27997":58922,"_3043":58923},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3587":2738,"_30795":2696,"_5":31151,"_21329":58925,"_27997":58926,"_3043":58927},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3587":2739,"_30795":2696,"_5":31151,"_21329":58929,"_27997":58930,"_3043":54619},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3587":2740,"_30795":2696,"_5":31151,"_21329":58932,"_27997":58933,"_3043":58934},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3587":2741,"_30795":2696,"_5":31151,"_21329":58936,"_27997":58937,"_3043":58938},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3587":2742,"_30795":2696,"_21329":58940,"_5":14664,"_27997":2696,"_3043":58941},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3587":2743,"_30795":2696,"_21329":58943,"_5":14664,"_27997":2696,"_3043":58944},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3587":2744,"_30795":2696,"_21329":58946,"_5":14664,"_27997":2696,"_3043":58947},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3587":2745,"_30795":2696,"_21329":58949,"_5":14664,"_27997":2696,"_3043":58950},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3587":2746,"_30795":2696,"_21329":58952,"_5":14664,"_27997":2696,"_3043":58953},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3587":2747,"_30795":2696,"_21329":58955,"_5":14664,"_27997":2696,"_3043":58956},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3587":2748,"_30795":2696,"_21329":58958,"_5":14664,"_27997":2696,"_3043":58959},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3587":2749,"_30795":2696,"_21329":58961,"_5":14664,"_27997":58771,"_3043":58962},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3587":2750,"_30795":2696,"_21329":58964,"_5":14664,"_27997":58771,"_3043":58965},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3587":2751,"_30795":2696,"_21329":58967,"_5":14664,"_27997":58775,"_3043":58968},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3587":2752,"_30795":2696,"_21329":58970,"_5":14664,"_27997":58775,"_3043":58971},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3587":2753,"_30795":2696,"_21329":58973,"_5":14664,"_27997":58779,"_3043":58974},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3587":2754,"_30795":2696,"_21329":58976,"_5":14664,"_27997":58783,"_3043":58977},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3587":2755,"_30795":2696,"_21329":58979,"_5":14664,"_27997":58783,"_3043":58980},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3587":2756,"_30795":2696,"_21329":58982,"_5":14664,"_27997":58783,"_3043":58983},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3587":2757,"_30795":2696,"_21329":58985,"_5":14664,"_27997":58783,"_3043":58986},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3587":2758,"_30795":2696,"_21329":58988,"_5":14664,"_27997":58783,"_3043":58989},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3587":2759,"_30795":2696,"_21329":58991,"_5":14664,"_27997":58787,"_3043":58992},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3587":2760,"_30795":2696,"_21329":58994,"_5":14664,"_27997":58787,"_3043":58995},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3587":2761,"_30795":2696,"_21329":58997,"_5":14664,"_27997":58787,"_3043":58998},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3587":2762,"_30795":2696,"_21329":59000,"_5":14664,"_27997":58787,"_3043":59001},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3587":2763,"_30795":2696,"_21329":59003,"_5":14664,"_27997":58787,"_3043":59004},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3587":2764,"_30795":2696,"_21329":59006,"_5":14664,"_27997":58787,"_3043":59007},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3587":2765,"_30795":2696,"_21329":59009,"_5":14664,"_27997":58791,"_3043":59010},[],"Change",{"_3587":2766,"_30795":2696,"_21329":59012,"_5":14664,"_27997":58791,"_3043":59013},[],"Who is affected",{"_3587":2767,"_30795":2696,"_21329":59015,"_5":14664,"_27997":58791,"_3043":59016},[],"Severity",{"_3587":2768,"_30795":2696,"_21329":59018,"_5":14664,"_27997":58791,"_3043":57483},[],{"_3587":2769,"_30795":2696,"_21329":59020,"_5":14664,"_27997":58791,"_3043":58800},[],{"_3587":2770,"_30795":2696,"_21329":59022,"_5":14664,"_27997":58791,"_3043":59023},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3587":2771,"_30795":2696,"_21329":59025,"_5":14664,"_27997":58791,"_3043":59026},[],"High: KMS and VA start on empty volumes",{"_3587":2772,"_30795":2696,"_21329":59028,"_5":14664,"_27997":58791,"_3043":59029},[],"Copy the data into the new volumes",{"_3587":2773,"_30795":2696,"_21329":59031,"_5":14664,"_27997":58791,"_3043":58804},[],{"_3587":2774,"_30795":2696,"_21329":59033,"_5":14664,"_27997":58791,"_3043":59034},[],"Every Helm release",{"_3587":2775,"_30795":2696,"_21329":59036,"_5":14664,"_27997":58791,"_3043":59037},[],"High: `helm upgrade` fails",{"_3587":2776,"_30795":2696,"_21329":59039,"_5":14664,"_27997":58791,"_3043":59040},[],"Remove or rename legacy keys",{"_3587":2777,"_30795":2696,"_21329":59042,"_5":14664,"_27997":58791,"_3043":51019},[],{"_3587":2778,"_30795":2696,"_21329":59044,"_5":14664,"_27997":58791,"_3043":59034},[],{"_3587":2779,"_30795":2696,"_21329":59046,"_5":14664,"_27997":58791,"_3043":59047},[],"High: `helm upgrade` fails on inline credentials",{"_3587":2780,"_30795":2696,"_21329":59049,"_5":14664,"_27997":58791,"_3043":59050},[],"Create the Secrets first; see Step 2",{"_3587":2781,"_30795":2696,"_21329":59052,"_5":14664,"_27997":58791,"_3043":58811},[],{"_3587":2782,"_30795":2696,"_21329":59054,"_5":14664,"_27997":58791,"_3043":59055},[],"Every deployment",{"_3587":2783,"_30795":2696,"_21329":59057,"_5":14664,"_27997":58791,"_3043":59058},[],"High: without a bootstrap principal there is no administrator",{"_3587":2784,"_30795":2696,"_21329":59060,"_5":14664,"_27997":58791,"_3043":59061},[],"Configure `services.authz`",{"_3587":2785,"_30795":2696,"_21329":59063,"_5":14664,"_27997":58791,"_3043":58815},[],{"_3587":2786,"_30795":2696,"_21329":59065,"_5":14664,"_27997":58791,"_3043":59034},[],{"_3587":2787,"_30795":2696,"_21329":59067,"_5":14664,"_27997":58791,"_3043":59068},[],"High: `helm upgrade` fails on the old keys",{"_3587":2788,"_30795":2696,"_21329":59070,"_5":14664,"_27997":58791,"_3043":59071},[],"Move JWKS and roles into `services.authz`",{"_3587":2789,"_30795":2696,"_21329":59073,"_5":14664,"_27997":58791,"_3043":58835},[],{"_3587":2790,"_30795":2696,"_21329":59075,"_5":14664,"_27997":58791,"_3043":59076},[],"3.8.0 deployments with per-service databases",{"_3587":2791,"_30795":2696,"_21329":59078,"_5":14664,"_27997":58791,"_3043":59079},[],"High: services find no data, or a migration aborts",{"_3587":2792,"_30795":2696,"_21329":59081,"_5":14664,"_27997":58791,"_3043":59082},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3587":2793,"_30795":2696,"_21329":59084,"_5":14664,"_27997":58791,"_3043":58839},[],{"_3587":2794,"_30795":2696,"_21329":59086,"_5":14664,"_27997":58791,"_3043":59087},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3587":2795,"_30795":2696,"_21329":59089,"_5":14664,"_27997":58791,"_3043":59090},[],"High: the backend no longer starts with them",{"_3587":2796,"_30795":2696,"_21329":59092,"_5":14664,"_27997":58791,"_3043":59093},[],"Move to PostgreSQL before upgrading",{"_3587":2797,"_30795":2696,"_21329":59095,"_5":14664,"_27997":58791,"_3043":58883},[],{"_3587":2798,"_30795":2696,"_21329":59097,"_5":14664,"_27997":58791,"_3043":59098},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3587":2799,"_30795":2696,"_21329":59100,"_5":14664,"_27997":58791,"_3043":59101},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3587":2800,"_30795":2696,"_21329":59103,"_5":14664,"_27997":58791,"_3043":59104},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3587":2801,"_30795":2696,"_21329":59106,"_5":14664,"_27997":58791,"_3043":59107},[],"Webhooks with file references",{"_3587":2802,"_30795":2696,"_21329":59109,"_5":14664,"_27997":58791,"_3043":59110},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3587":2803,"_30795":2696,"_21329":59112,"_5":14664,"_27997":58791,"_3043":59113},[],"High: enrollments calling the webhook fail",{"_3587":2804,"_30795":2696,"_21329":59115,"_5":14664,"_27997":58791,"_3043":59116},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3587":2805,"_30795":2696,"_21329":59118,"_5":14664,"_27997":58791,"_3043":58819},[],{"_3587":2806,"_30795":2696,"_21329":59120,"_5":14664,"_27997":58791,"_3043":59121},[],"Releases with per-service identity overrides or mounted key material",{"_3587":2807,"_30795":2696,"_21329":59123,"_5":14664,"_27997":58791,"_3043":59124},[],"Medium: services cannot read their files",{"_3587":2808,"_30795":2696,"_21329":59126,"_5":14664,"_27997":58791,"_3043":59127},[],"Remove the overrides and fix volume ownership",{"_3587":2809,"_30795":2696,"_21329":59129,"_5":14664,"_27997":58791,"_3043":58823},[],{"_3587":2810,"_30795":2696,"_21329":59131,"_5":14664,"_27997":58791,"_3043":59132},[],"Releases that set `amqp.tls`",{"_3587":2811,"_30795":2696,"_21329":59134,"_5":14664,"_27997":58791,"_3043":59135},[],"Medium: clients connect to the wrong port",{"_3587":2812,"_30795":2696,"_21329":59137,"_5":14664,"_27997":58791,"_3043":59138},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3587":2813,"_30795":2696,"_21329":59140,"_5":14664,"_27997":58791,"_3043":58843},[],{"_3587":2814,"_30795":2696,"_21329":59142,"_5":14664,"_27997":58791,"_3043":59143},[],"Installations whose CA keys predate the KMS",{"_3587":2815,"_30795":2696,"_21329":59145,"_5":14664,"_27997":58791,"_3043":59146},[],"Medium: CA keys stay unmanaged",{"_3587":2816,"_30795":2696,"_21329":59148,"_5":14664,"_27997":58791,"_3043":59149},[],"Run the CA-to-KMS migration",{"_3587":2817,"_30795":2696,"_21329":59151,"_5":14664,"_27997":58791,"_3043":59152},[],"Receiver certificate verification",{"_3587":2818,"_30795":2696,"_21329":59154,"_5":14664,"_27997":58791,"_3043":59155},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3587":2819,"_30795":2696,"_21329":59157,"_5":14664,"_27997":58791,"_3043":59158},[],"Medium: credentials go to an unverified receiver",{"_3587":2820,"_30795":2696,"_21329":59160,"_5":14664,"_27997":58791,"_3043":59161},[],"Set `insecure_skip_verify` to `false`",{"_3587":2821,"_30795":2696,"_21329":59163,"_5":14664,"_27997":58791,"_3043":58859},[],{"_3587":2822,"_30795":2696,"_21329":59165,"_5":14664,"_27997":58791,"_3043":59166},[],"Scripts and consoles that edit DMSs through the API",{"_3587":2823,"_30795":2696,"_21329":59168,"_5":14664,"_27997":58791,"_3043":59169},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3587":2824,"_30795":2696,"_21329":59171,"_5":14664,"_27997":58791,"_3043":59172},[],"Read the DMS before editing and use the new field",{"_3587":2825,"_30795":2696,"_21329":59174,"_5":14664,"_27997":58791,"_3043":58879},[],{"_3587":2826,"_30795":2696,"_21329":59176,"_5":14664,"_27997":58791,"_3043":59177},[],"Clients that create or update CRL settings through the API",{"_3587":2827,"_30795":2696,"_21329":59179,"_5":14664,"_27997":58791,"_3043":59180},[],"Medium: requests with the old field return an error",{"_3587":2828,"_30795":2696,"_21329":59182,"_5":14664,"_27997":58791,"_3043":59183},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3587":2829,"_30795":2696,"_21329":59185,"_5":14664,"_27997":58791,"_3043":58887},[],{"_3587":2830,"_30795":2696,"_21329":59187,"_5":14664,"_27997":58791,"_3043":59188},[],"Alert subscriptions and consumers of the VA events",{"_3587":2831,"_30795":2696,"_21329":59190,"_5":14664,"_27997":58791,"_3043":59191},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3587":2832,"_30795":2696,"_21329":59193,"_5":14664,"_27997":58791,"_3043":59194},[],"Review conditions filtering on the old event payload or subject",{"_3587":2833,"_30795":2696,"_21329":59196,"_5":14664,"_27997":58791,"_3043":58875},[],{"_3587":2834,"_30795":2696,"_21329":59198,"_5":14664,"_27997":58791,"_3043":59199},[],"Consumers that read the device `events` field",{"_3587":2835,"_30795":2696,"_21329":59201,"_5":14664,"_27997":58791,"_3043":59202},[],"Medium: the field disappears",{"_3587":2836,"_30795":2696,"_21329":59204,"_5":14664,"_27997":58791,"_3043":59205},[],"Use the new event endpoints",{"_3587":2837,"_30795":2696,"_21329":59207,"_5":14664,"_27997":58791,"_3043":58895},[],{"_3587":2838,"_30795":2696,"_21329":59209,"_5":14664,"_27997":58791,"_3043":59210},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3587":2839,"_30795":2696,"_21329":59212,"_5":14664,"_27997":58791,"_3043":59213},[],"Medium: the VA migration aborts",{"_3587":2840,"_30795":2696,"_21329":59215,"_5":14664,"_27997":58791,"_3043":59216},[],"Fix the affected roles before upgrading",{"_3587":2841,"_30795":2696,"_21329":59218,"_5":14664,"_27997":58791,"_3043":58827},[],{"_3587":2842,"_30795":2696,"_21329":59220,"_5":14664,"_27997":58791,"_3043":59221},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3587":2843,"_30795":2696,"_21329":59223,"_5":14664,"_27997":58791,"_3043":59224},[],"Low to medium: validation errors or changed defaults",{"_3587":2844,"_30795":2696,"_21329":59226,"_5":14664,"_27997":58791,"_3043":59227},[],"Update the values file",{"_3587":2845,"_30795":2696,"_21329":59229,"_5":14664,"_27997":58791,"_3043":58867},[],{"_3587":2846,"_30795":2696,"_21329":59231,"_5":14664,"_27997":58791,"_3043":59232},[],"Clients that send the DMS ID in the update body",{"_3587":2847,"_30795":2696,"_21329":59234,"_5":14664,"_27997":58791,"_3043":59235},[],"Low: the ID in the URL wins",{"_3587":2848,"_30795":2696,"_21329":59237,"_5":14664,"_27997":58791,"_3043":59238},[],"Send the ID in the URL",{"_3587":2849,"_30795":2696,"_21329":59240,"_5":14664,"_27997":58791,"_3043":58891},[],{"_3587":2850,"_30795":2696,"_21329":59242,"_5":14664,"_27997":58791,"_3043":59243},[],"Clients that send an `id` when creating or importing CAs",{"_3587":2851,"_30795":2696,"_21329":59245,"_5":14664,"_27997":58791,"_3043":59246},[],"Low: the ID in the body is ignored, and the field is removed",{"_3587":2852,"_30795":2696,"_21329":59248,"_5":14664,"_27997":58791,"_3043":59249},[],"Let the backend assign the ID and use the returned one",{"_3587":2853,"_30795":2696,"_21329":59251,"_5":14664,"_27997":58791,"_3043":58871},[],{"_3587":2854,"_30795":2696,"_21329":59253,"_5":14664,"_27997":58791,"_3043":59254},[],"Consumers that match on certificate `type`",{"_3587":2855,"_30795":2696,"_21329":59256,"_5":14664,"_27997":58791,"_3043":59257},[],"Low: two values are renamed",{"_3587":2856,"_30795":2696,"_21329":59259,"_5":14664,"_27997":58791,"_3043":59260},[],"Adapt consumers",{"_3587":2857,"_30795":2696,"_21329":59262,"_5":14664,"_27997":58791,"_3043":58863},[],{"_3587":2858,"_30795":2696,"_21329":59264,"_5":14664,"_27997":58791,"_3043":59265},[],"Any DMS",{"_3587":2859,"_30795":2696,"_21329":59267,"_5":14664,"_27997":58791,"_3043":59268},[],"Low: informational",{"_3587":2860,"_30795":2696,"_21329":59270,"_5":14664,"_27997":58791,"_3043":59271},[],"Read both blocks before editing",{"_3587":2861,"_30795":2696,"_21329":59273,"_5":14664,"_27997":58799,"_3043":59274},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3587":2862,"_30795":2696,"_21329":59276,"_5":14664,"_27997":58799,"_3043":59277},[],"Step 4 of the migration guide copies the data.",{"_3587":2863,"_30795":2696,"_21329":59279,"_5":14664,"_27997":58803,"_3043":59280},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3587":2864,"_30795":2696,"_21329":59282,"_5":14664,"_27997":58807,"_3043":59283},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3587":2865,"_30795":2696,"_21329":59285,"_5":14664,"_27997":58807,"_3043":59286},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3587":2866,"_30795":2696,"_21329":59288,"_5":14664,"_27997":58810,"_3043":59289},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3587":2867,"_30795":2696,"_21329":59291,"_5":14664,"_27997":58814,"_3043":59292},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3587":2868,"_30795":2696,"_21329":59294,"_5":14664,"_27997":58818,"_3043":59295},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3587":2869,"_30795":2696,"_21329":59297,"_5":14664,"_27997":58818,"_3043":59298},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3587":2870,"_30795":2696,"_21329":59300,"_5":14664,"_27997":58822,"_3043":59301},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3587":2871,"_30795":2696,"_21329":59303,"_5":14664,"_27997":58826,"_3043":59304},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3587":2872,"_30795":2696,"_21329":59306,"_5":14664,"_27997":58826,"_3043":59307},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3587":2873,"_30795":2696,"_21329":59309,"_5":14664,"_27997":58826,"_3043":59310},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3587":2874,"_30795":2696,"_21329":59312,"_5":14664,"_27997":58826,"_3043":59313},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3587":2875,"_30795":2696,"_21329":59315,"_5":14664,"_27997":58826,"_3043":59316},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3587":2876,"_30795":2696,"_21329":59318,"_5":14664,"_27997":58826,"_3043":59319},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3587":2877,"_30795":2696,"_21329":59321,"_5":14664,"_27997":58834,"_3043":59322},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3587":2878,"_30795":2696,"_21329":59324,"_5":14664,"_27997":58834,"_3043":59325},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3587":2879,"_30795":2696,"_21329":59327,"_5":14664,"_27997":58834,"_3043":59328},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3587":2880,"_30795":2696,"_21329":59330,"_5":14664,"_27997":58834,"_3043":59331},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3587":2881,"_30795":2696,"_21329":59333,"_5":14664,"_27997":58834,"_3043":59334},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3587":2882,"_30795":2696,"_21329":59336,"_5":14664,"_27997":58838,"_3043":59337},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3587":2883,"_30795":2696,"_21329":59339,"_5":14664,"_27997":58842,"_3043":59340},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3587":2884,"_30795":2696,"_21329":59342,"_5":14664,"_27997":58842,"_3043":59343},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3587":2885,"_30795":2696,"_21329":59345,"_5":14664,"_27997":58842,"_3043":59346},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3587":2886,"_30795":2696,"_21329":59348,"_5":14664,"_27997":58842,"_3043":59349},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3587":2887,"_30795":2696,"_21329":59351,"_5":14664,"_27997":58842,"_3043":59352},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3587":2888,"_30795":2696,"_21329":59354,"_5":14664,"_27997":58842,"_3043":59355},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3587":2889,"_30795":2696,"_21329":59357,"_5":14664,"_27997":58842,"_3043":59358},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3587":2890,"_30795":2696,"_21329":59360,"_5":14664,"_27997":58842,"_3043":59361},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3587":2891,"_30795":2696,"_21329":59363,"_5":14664,"_27997":58846,"_3043":59364},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3587":2892,"_30795":2696,"_21329":59366,"_5":14664,"_27997":58854,"_3043":59367},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3587":2893,"_30795":2696,"_21329":59369,"_5":14664,"_27997":58854,"_3043":59370},[],"Field in 3.8.0",{"_3587":2894,"_30795":2696,"_21329":59372,"_5":14664,"_27997":58854,"_3043":59373},[],"Field in 4.0.0",{"_3587":2895,"_30795":2696,"_21329":59375,"_5":14664,"_27997":58854,"_3043":59376},[],"`validate_server_cert`",{"_3587":2896,"_30795":2696,"_21329":59378,"_5":14664,"_27997":58854,"_3043":59379},[],"`insecure_skip_verify` (value negated)",{"_3587":2897,"_30795":2696,"_21329":59381,"_5":14664,"_27997":58854,"_3043":59382},[],"`oidc`",{"_3587":2898,"_30795":2696,"_21329":59384,"_5":14664,"_27997":58854,"_3043":59385},[],"`jwt_options`",{"_3587":2899,"_30795":2696,"_21329":59387,"_5":14664,"_27997":58854,"_3043":59388},[],"`apikey`",{"_3587":2900,"_30795":2696,"_21329":59390,"_5":14664,"_27997":58854,"_3043":59391},[],"`apikey_options`",{"_3587":2901,"_30795":2696,"_21329":59393,"_5":14664,"_27997":58854,"_3043":59394},[],"`mtls`",{"_3587":2902,"_30795":2696,"_21329":59396,"_5":14664,"_27997":58854,"_3043":59397},[],"`mtls_options`",{"_3587":2903,"_30795":2696,"_21329":59399,"_5":14664,"_27997":58854,"_3043":59400},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3587":2904,"_30795":2696,"_21329":59402,"_5":14664,"_27997":58854,"_3043":59403},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3587":2905,"_30795":2696,"_21329":59405,"_5":14664,"_27997":58854,"_3043":59406},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3587":2906,"_30795":2696,"_21329":59408,"_5":14664,"_27997":58858,"_3043":59409},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3587":2907,"_30795":2696,"_21329":59411,"_5":14664,"_27997":58858,"_3043":59412},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3587":2908,"_30795":2696,"_21329":59414,"_5":14664,"_27997":58858,"_3043":59415},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3587":2909,"_30795":2696,"_21329":59417,"_5":14664,"_27997":58862,"_3043":59418},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3587":2910,"_30795":2696,"_21329":59420,"_5":14664,"_27997":58866,"_3043":59421},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3587":2911,"_30795":2696,"_21329":59423,"_5":14664,"_27997":58870,"_3043":59424},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3587":2912,"_30795":2696,"_21329":59426,"_5":14664,"_27997":58874,"_3043":59427},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3587":2913,"_30795":2696,"_21329":59429,"_5":14664,"_27997":58874,"_3043":59430},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3587":2914,"_30795":2696,"_21329":59432,"_5":14664,"_27997":58874,"_3043":59433},[],"`POST /v1/devices/:id/events` creates an event.",{"_3587":2915,"_30795":2696,"_21329":59435,"_5":14664,"_27997":58874,"_3043":59436},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3587":2916,"_30795":2696,"_21329":59438,"_5":14664,"_27997":58878,"_3043":59439},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3587":2917,"_30795":2696,"_21329":59441,"_5":14664,"_27997":58882,"_3043":59442},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3587":2918,"_30795":2696,"_21329":59444,"_5":14664,"_27997":58882,"_3043":59445},[],"Route",{"_3587":2919,"_30795":2696,"_21329":59447,"_5":14664,"_27997":58882,"_3043":53806},[],{"_3587":2920,"_30795":2696,"_21329":59449,"_5":14664,"_27997":58882,"_3043":59450},[],"`GET /v1/crl-settings`",{"_3587":2921,"_30795":2696,"_21329":59452,"_5":14664,"_27997":58882,"_3043":59453},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3587":2922,"_30795":2696,"_21329":59455,"_5":14664,"_27997":58882,"_3043":59456},[],"`GET /v1/crl-settings/{ca-id}`",{"_3587":2923,"_30795":2696,"_21329":59458,"_5":14664,"_27997":58882,"_3043":59459},[],"Reads the settings of a CA.",{"_3587":2924,"_30795":2696,"_21329":59461,"_5":14664,"_27997":58882,"_3043":59462},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3587":2925,"_30795":2696,"_21329":59464,"_5":14664,"_27997":58882,"_3043":59465},[],"Replaces `crl_options`.",{"_3587":2926,"_30795":2696,"_21329":59467,"_5":14664,"_27997":58882,"_3043":59468},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3587":2927,"_30795":2696,"_21329":59470,"_5":14664,"_27997":58882,"_3043":59471},[],"Removes the archived settings of a CA.",{"_3587":2928,"_30795":2696,"_21329":59473,"_5":14664,"_27997":58882,"_3043":59474},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3587":2929,"_30795":2696,"_21329":59476,"_5":14664,"_27997":58882,"_3043":59477},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3587":2930,"_30795":2696,"_21329":59479,"_5":14664,"_27997":58882,"_3043":59480},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3587":2931,"_30795":2696,"_21329":59482,"_5":14664,"_27997":58882,"_3043":59483},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3587":2932,"_30795":2696,"_21329":59485,"_5":14664,"_27997":58882,"_3043":59486},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3587":2933,"_30795":2696,"_21329":59488,"_5":14664,"_27997":58882,"_3043":59489},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3587":2934,"_30795":2696,"_21329":59491,"_5":14664,"_27997":58882,"_3043":59492},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3587":2935,"_30795":2696,"_21329":59494,"_5":14664,"_27997":58882,"_3043":59495},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3587":2936,"_30795":2696,"_21329":59497,"_5":14664,"_27997":58882,"_3043":59498},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3587":2937,"_30795":2696,"_21329":59500,"_5":14664,"_27997":58882,"_3043":59501},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3587":2938,"_30795":2696,"_21329":59503,"_5":14664,"_27997":58882,"_3043":59504},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3587":2939,"_30795":2696,"_21329":59506,"_5":14664,"_27997":58886,"_3043":59507},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3587":2940,"_30795":2696,"_21329":59509,"_5":14664,"_27997":58890,"_3043":59510},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3587":2941,"_30795":2696,"_21329":59512,"_5":14664,"_27997":58894,"_3043":59513},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3587":2942,"_30795":2696,"_21329":59515,"_5":14664,"_27997":58898,"_3043":59516},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3587":2943,"_30795":2696,"_21329":59518,"_5":14664,"_27997":58902,"_3043":59519},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3587":2944,"_30795":2696,"_21329":59521,"_5":14664,"_27997":58902,"_3043":59522},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3587":2945,"_30795":2696,"_21329":59524,"_5":14664,"_27997":58902,"_3043":59525},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3587":2946,"_30795":2696,"_21329":59527,"_5":14664,"_27997":58902,"_3043":59528},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3587":2947,"_30795":2696,"_21329":59530,"_5":14664,"_27997":58902,"_3043":59531},[],"Record the names of your local-storage PVCs:",{"_3587":2948,"_30795":2696,"_21329":59533,"_5":14664,"_27997":58902,"_3043":59534},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3587":2949,"_30795":2696,"_21329":59536,"_5":14664,"_27997":58906,"_3043":59537},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3587":2950,"_30795":2696,"_21329":59539,"_5":14664,"_27997":58906,"_3043":59540},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3587":2951,"_30795":2696,"_21329":59542,"_5":14664,"_27997":58906,"_3043":59543},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3587":2952,"_30795":2696,"_21329":59545,"_5":14664,"_27997":58906,"_3043":59546},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3587":2953,"_30795":2696,"_21329":59548,"_5":14664,"_27997":58906,"_3043":59549},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3587":2954,"_30795":2696,"_21329":59551,"_5":14664,"_27997":58910,"_3043":59552},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3587":2955,"_30795":2696,"_21329":59554,"_5":14664,"_27997":58910,"_3043":59555},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3587":2956,"_30795":2696,"_21329":59557,"_5":14664,"_27997":58910,"_3043":59558},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3587":2957,"_30795":2696,"_21329":59560,"_5":14664,"_27997":58910,"_3043":59561},[],"Secret (`existingSecret`)",{"_3587":2958,"_30795":2696,"_21329":59563,"_5":14664,"_27997":58910,"_3043":59564},[],"Required data keys",{"_3587":2959,"_30795":2696,"_21329":59566,"_5":14664,"_27997":58910,"_3043":59567},[],"When",{"_3587":2960,"_30795":2696,"_21329":59569,"_5":14664,"_27997":58910,"_3043":59570},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3587":2961,"_30795":2696,"_21329":59572,"_5":14664,"_27997":58910,"_3043":59573},[],"`username`, `password`",{"_3587":2962,"_30795":2696,"_21329":59575,"_5":14664,"_27997":58910,"_3043":59576},[],"Always",{"_3587":2963,"_30795":2696,"_21329":59578,"_5":14664,"_27997":58910,"_3043":59579},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3587":2964,"_30795":2696,"_21329":59581,"_5":14664,"_27997":58910,"_3043":59573},[],{"_3587":2965,"_30795":2696,"_21329":59583,"_5":14664,"_27997":58910,"_3043":59576},[],{"_3587":2966,"_30795":2696,"_21329":59585,"_5":14664,"_27997":58910,"_3043":59586},[],"`services.alerts.smtp_server.existingSecret`",{"_3587":2967,"_30795":2696,"_21329":59588,"_5":14664,"_27997":58910,"_3043":59573},[],{"_3587":2968,"_30795":2696,"_21329":59590,"_5":14664,"_27997":58910,"_3043":59591},[],"Only when SMTP authentication is enabled",{"_3587":2969,"_30795":2696,"_21329":59593,"_5":14664,"_27997":58910,"_3043":59594},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3587":2970,"_30795":2696,"_21329":59596,"_5":14664,"_27997":58910,"_3043":59597},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3587":2971,"_30795":2696,"_21329":59599,"_5":14664,"_27997":58910,"_3043":59600},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3587":2972,"_30795":2696,"_21329":59602,"_5":14664,"_27997":58910,"_3043":59603},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3587":2973,"_30795":2696,"_21329":59605,"_5":14664,"_27997":58910,"_3043":59606},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3587":2974,"_30795":2696,"_21329":59608,"_5":14664,"_27997":58910,"_3043":59609},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; the connection uses the global PostgreSQL credential Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3587":2975,"_30795":2696,"_21329":59611,"_5":14664,"_27997":58910,"_3043":59612},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3587":2976,"_30795":2696,"_21329":59614,"_5":14664,"_27997":58910,"_3043":59615},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3587":2977,"_30795":2696,"_21329":59617,"_5":14664,"_27997":58910,"_3043":59618},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3587":2978,"_30795":2696,"_21329":59620,"_5":14664,"_27997":58910,"_3043":59621},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3587":2979,"_30795":2696,"_21329":59623,"_5":14664,"_27997":58910,"_3043":59624},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3587":2980,"_30795":2696,"_21329":59626,"_5":14664,"_27997":58910,"_3043":59627},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3587":2981,"_30795":2696,"_21329":59629,"_5":14664,"_27997":58910,"_3043":59630},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3587":2982,"_30795":2696,"_21329":59632,"_5":14664,"_27997":58910,"_3043":59633},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3587":2983,"_30795":2696,"_21329":59635,"_5":14664,"_27997":58910,"_3043":59636},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3587":2984,"_30795":2696,"_21329":59638,"_5":14664,"_27997":58914,"_3043":59639},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3587":2985,"_30795":2696,"_21329":59641,"_5":14664,"_27997":58914,"_3043":59642},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3587":2986,"_30795":2696,"_21329":59644,"_5":14664,"_27997":58918,"_3043":59645},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3587":2987,"_30795":2696,"_21329":59647,"_5":14664,"_27997":58918,"_3043":59648},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3587":2988,"_30795":2696,"_21329":59650,"_5":14664,"_27997":58918,"_3043":59651},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3587":2989,"_30795":2696,"_21329":59653,"_5":14664,"_27997":58918,"_3043":59654},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3587":2990,"_30795":2696,"_21329":59656,"_5":14664,"_27997":58918,"_3043":59657},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3587":2991,"_30795":2696,"_21329":59659,"_5":14664,"_27997":58918,"_3043":59660},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3587":2992,"_30795":2696,"_21329":59662,"_5":14664,"_27997":58918,"_3043":59663},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3587":2993,"_30795":2696,"_21329":59665,"_5":14664,"_27997":58918,"_3043":59666},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3587":2994,"_30795":2696,"_21329":59668,"_5":14664,"_27997":58918,"_3043":59669},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3587":2995,"_30795":2696,"_21329":59671,"_5":14664,"_27997":58918,"_3043":59672},[],"**Remove the helper and restore the recorded replica counts:**",{"_3587":2996,"_30795":2696,"_21329":59674,"_5":14664,"_27997":58918,"_3043":59675},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3587":2997,"_30795":2696,"_21329":59677,"_5":14664,"_27997":58922,"_3043":59678},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3587":2998,"_30795":2696,"_21329":59680,"_5":14664,"_27997":58922,"_3043":59681},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3587":2999,"_30795":2696,"_21329":59683,"_5":14664,"_27997":58926,"_3043":59684},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3587":3000,"_30795":2696,"_21329":59686,"_5":14664,"_27997":58926,"_3043":59687},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3587":3001,"_30795":2696,"_21329":59689,"_5":14664,"_27997":58926,"_3043":59690},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3587":3002,"_30795":2696,"_21329":59692,"_5":14664,"_27997":58926,"_3043":59693},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3587":3003,"_30795":2696,"_21329":59695,"_5":14664,"_27997":58926,"_3043":59696},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3587":3004,"_30795":2696,"_21329":59698,"_5":14664,"_27997":58926,"_3043":59699},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3587":3005,"_30795":2696,"_21329":59701,"_5":14664,"_27997":58926,"_3043":59702},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3587":3006,"_30795":2696,"_21329":59704,"_5":14664,"_27997":58926,"_3043":59705},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3587":3007,"_30795":2696,"_21329":59707,"_5":14664,"_27997":58930,"_3043":59708},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3587":3008,"_30795":2696,"_21329":59710,"_5":14664,"_27997":58930,"_3043":59711},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3587":3009,"_30795":2696,"_21329":59713,"_5":14664,"_27997":58930,"_3043":59714},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3587":3010,"_30795":2696,"_21329":59716,"_5":14664,"_27997":58930,"_3043":59717},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3587":3011,"_30795":2696,"_21329":59719,"_5":14664,"_27997":58930,"_3043":59720},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3587":3012,"_30795":2696,"_21329":59722,"_5":14664,"_27997":58930,"_3043":59723},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3587":3013,"_30795":2696,"_21329":59725,"_5":14664,"_27997":58930,"_3043":59726},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3587":3014,"_30795":2696,"_21329":59728,"_5":14664,"_27997":58930,"_3043":59729},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3587":3015,"_30795":2696,"_21329":59731,"_5":14664,"_27997":58930,"_3043":59732},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3587":3016,"_30795":2696,"_21329":59734,"_5":14664,"_27997":58930,"_3043":59735},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3587":3017,"_30795":2696,"_21329":59737,"_5":14664,"_27997":58930,"_3043":59738},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3587":3018,"_30795":2696,"_21329":59740,"_5":14664,"_27997":58933,"_3043":59741},[],"After the upgrade, check in this order:",{"_3587":3019,"_30795":2696,"_21329":59743,"_5":14664,"_27997":58933,"_3043":59744},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3587":3020,"_30795":2696,"_21329":59746,"_5":14664,"_27997":58933,"_3043":59747},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3587":3021,"_30795":2696,"_21329":59749,"_5":14664,"_27997":58933,"_3043":59750},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3587":3022,"_30795":2696,"_21329":59752,"_5":14664,"_27997":58933,"_3043":59753},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3587":3023,"_30795":2696,"_21329":59755,"_5":14664,"_27997":58933,"_3043":59756},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3587":3024,"_30795":2696,"_21329":59758,"_5":14664,"_27997":58933,"_3043":59759},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3587":3025,"_30795":2696,"_21329":59761,"_5":14664,"_27997":58933,"_3043":59762},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3587":3026,"_30795":2696,"_21329":59764,"_5":14664,"_27997":58933,"_3043":59765},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3587":3027,"_30795":2696,"_21329":59767,"_5":14664,"_27997":58933,"_3043":59768},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3587":3028,"_30795":2696,"_21329":59770,"_5":14664,"_27997":58933,"_3043":59771},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3587":3029,"_30795":2696,"_21329":59773,"_5":14664,"_27997":58933,"_3043":59774},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3587":3030,"_30795":2696,"_21329":59776,"_5":14664,"_27997":58933,"_3043":59777},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3587":3031,"_30795":2696,"_21329":59779,"_5":14664,"_27997":58933,"_3043":59780},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3587":3032,"_30795":2696,"_21329":59782,"_5":14664,"_27997":58933,"_3043":59783},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3587":3033,"_30795":2696,"_21329":59785,"_5":14664,"_27997":58933,"_3043":59786},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3587":3034,"_30795":2696,"_21329":59788,"_5":14664,"_27997":58937,"_3043":59789},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3587":3035,"_30795":2696,"_21329":59791,"_5":14664,"_27997":58937,"_3043":59792},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3587":3036,"_30795":2696,"_21329":59794,"_5":14664,"_27997":58937,"_3043":59795},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3587":3037,"_30795":2696,"_21329":59797,"_5":14664,"_27997":58937,"_3043":59798},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3587":3038,"_30795":2696,"_21329":59800,"_5":14664,"_27997":58937,"_3043":59801},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_59804":59805,"_59806":59807,"_59808":59809,"_59810":59811,"_18469":3078,"_71921":3078},"language","english","sortableProperties",[3043,30795,5,27997],"sortablePropertiesWithTypes",{"_3043":25471,"_30795":25471,"_5":25471,"_27997":25471},"sorts",{"_3043":59812,"_30795":62840,"_5":65867,"_27997":68894},{"_4781":59813,"_59814":59815,"_5":25471},{"_14740":5271,"_15123":4521,"_15142":9808,"_29799":3927,"_15129":5994,"_20241":21553,"_14761":8062,"_14768":14704,"_29741":3230,"_30150":3766,"_30171":3256,"_29775":4627,"_35189":5744,"_29878":7718,"_30215":5077,"_35196":30386,"_35199":10416,"_35202":16915,"_35205":6139,"_30617":5819,"_35210":6245,"_35212":3925,"_30652":6360,"_15138":3331,"_35216":3430,"_35219":5033,"_35221":6374,"_30199":7164,"_30637":3467,"_30665":5134,"_35226":11232,"_35228":23201,"_35230":7609,"_29895":3143,"_35233":6898,"_35235":7763,"_35237":10718,"_35239":3768,"_35241":9809,"_29812":4904,"_35244":7862,"_35246":3650,"_29806":12948,"_30236":20745,"_35250":3293,"_35252":7399,"_35255":5318,"_29852":7507,"_35259":5106,"_29732":5895,"_35262":6012,"_29780":3459,"_35265":4762,"_35267":7810,"_35270":3460,"_15132":6318,"_35273":3547,"_35275":4909,"_35278":3458,"_35280":4743,"_35282":6182,"_35284":6685,"_35286":10354,"_20244":9436,"_35289":4119,"_35291":6110,"_29753":7180,"_30193":6550,"_35295":6145,"_30860":4335,"_35298":4190,"_30682":3156,"_35301":3757,"_35303":6206,"_35305":16623,"_30775":12559,"_30252":16089,"_35309":3210,"_35311":3349,"_29790":5404,"_35314":14162,"_35316":3763,"_35318":14436,"_30698":3336,"_29872":3353,"_29257":6011,"_35323":5362,"_35325":7147,"_35327":4442,"_29921":5092,"_35331":3380,"_30187":7798,"_35335":16105,"_35337":4443,"_35339":4419,"_35341":5312,"_35343":5199,"_35345":17565,"_29910":3295,"_30155":13322,"_35349":20546,"_35351":7179,"_35353":16090,"_35356":3498,"_35358":4930,"_35360":9290,"_35362":17150,"_35364":3312,"_35366":9054,"_35368":21278,"_35371":11852,"_35373":8172,"_35375":3378,"_35377":11033,"_35379":3799,"_35382":7140,"_35384":4303,"_35387":13265,"_35390":7194,"_35392":22017,"_35394":3815,"_35396":6166,"_35398":7104,"_35400":50371,"_35402":18333,"_35404":4809,"_35406":6142,"_30198":7855,"_35409":5080,"_35411":16088,"_35413":3215,"_35415":4091,"_35417":3958,"_35419":6829,"_35421":6464,"_35423":3507,"_35425":7685,"_35427":5166,"_35429":14294,"_35431":5306,"_35433":4808,"_35435":3919,"_35437":15574,"_35439":5968,"_35441":6097,"_35443":6398,"_35445":4089,"_35447":3080,"_35449":4197,"_35451":5126,"_3