0857":15,"_5":31213,"_21381":50457,"_28049":50458,"_3044":50459},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3588":18,"_30857":15,"_5":31213,"_21381":50461,"_28049":50462,"_3044":50463},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3588":19,"_30857":15,"_5":31213,"_21381":50465,"_28049":50466,"_3044":50467},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3588":20,"_30857":15,"_5":31213,"_21381":50469,"_28049":50470,"_3044":50471},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3588":21,"_30857":15,"_5":31213,"_21381":50473,"_28049":50474,"_3044":50475},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3588":22,"_30857":15,"_5":31213,"_21381":50477,"_28049":50478,"_3044":50479},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3588":23,"_30857":15,"_5":31213,"_21381":50481,"_28049":50482,"_3044":50483},[],"/docs/pr-preview/pr-70/deployment/aws-marketplace#next-step","Next step",{"_3588":24,"_30857":15,"_21381":50485,"_5":14694,"_28049":15,"_3044":50486},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3588":25,"_30857":15,"_21381":50488,"_5":14694,"_28049":50458,"_3044":50489},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3588":26,"_30857":15,"_21381":50491,"_5":14694,"_28049":50458,"_3044":50492},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3588":27,"_30857":15,"_21381":50494,"_5":14694,"_28049":50458,"_3044":50495},[],"A security group allowing the necessary endpoints.",{"_3588":28,"_30857":15,"_21381":50497,"_5":14694,"_28049":50462,"_3044":50498},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3588":29,"_30857":15,"_21381":50500,"_5":14694,"_28049":50462,"_3044":50501},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3588":30,"_30857":15,"_21381":50503,"_5":14694,"_28049":50462,"_3044":50504},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3588":31,"_30857":15,"_21381":50506,"_5":14694,"_28049":50466,"_3044":50507},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3588":32,"_30857":15,"_21381":50509,"_5":14694,"_28049":50470,"_3044":50510},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3588":33,"_30857":15,"_21381":50512,"_5":14694,"_28049":50474,"_3044":50513},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3588":34,"_30857":15,"_21381":50515,"_5":14694,"_28049":50478,"_3044":50516},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3588":35,"_30857":15,"_21381":50518,"_5":14694,"_28049":50482,"_3044":50519},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3588":36,"_30857":36,"_5":15054,"_3044":50521,"_31216":50522,"_21381":50523,"_28049":36},"Deploy Lamassu",[50449,50450],[],{"_3588":37,"_30857":36,"_21381":50525,"_5":14694,"_28049":36,"_3044":50526},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3588":38,"_30857":36,"_5":31213,"_21381":50528,"_28049":50529,"_3044":50530},[],"/docs/pr-preview/pr-70/deployment/overview#choose-a-model","Choose a model",{"_3588":39,"_30857":36,"_5":31213,"_21381":50532,"_28049":50533,"_3044":50534},[],"/docs/pr-preview/pr-70/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3588":40,"_30857":36,"_5":31213,"_21381":50536,"_28049":50537,"_3044":50538},[],"/docs/pr-preview/pr-70/deployment/overview#after-deployment","After deployment",{"_3588":41,"_30857":36,"_21381":50540,"_5":14694,"_28049":36,"_3044":50541},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3588":42,"_30857":36,"_21381":50543,"_5":14694,"_28049":50529,"_3044":50544},[],"Model",{"_3588":43,"_30857":36,"_21381":50546,"_5":14694,"_28049":50529,"_3044":50547},[],"Recommended for",{"_3588":44,"_30857":36,"_21381":50549,"_5":14694,"_28049":50529,"_3044":50550},[],"Who operates the infrastructure",{"_3588":45,"_30857":36,"_21381":50552,"_5":14694,"_28049":50529,"_3044":50553},[],"Starting point",{"_3588":46,"_30857":36,"_21381":50555,"_5":14694,"_28049":50529,"_3044":50556},[],"Kubernetes self-managed",{"_3588":47,"_30857":36,"_21381":50558,"_5":14694,"_28049":50529,"_3044":50559},[],"Production, regulated environments and custom deployments",{"_3588":48,"_30857":36,"_21381":50561,"_5":14694,"_28049":50529,"_3044":50562},[],"Your team",{"_3588":49,"_30857":36,"_21381":50564,"_5":14694,"_28049":50529,"_3044":50565},[],"Helm or Fastlane",{"_3588":50,"_30857":36,"_21381":50567,"_5":14694,"_28049":50529,"_3044":50568},[],"AWS Marketplace",{"_3588":51,"_30857":36,"_21381":50570,"_5":14694,"_28049":50529,"_3044":50571},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3588":52,"_30857":36,"_21381":50573,"_5":14694,"_28049":50529,"_3044":50562},[],{"_3588":53,"_30857":36,"_21381":50575,"_5":14694,"_28049":50529,"_3044":50576},[],"Preconfigured image on EC2",{"_3588":54,"_30857":36,"_21381":50578,"_5":14694,"_28049":50529,"_3044":50579},[],"SaaS",{"_3588":55,"_30857":36,"_21381":50581,"_5":14694,"_28049":50529,"_3044":50582},[],"Teams that want to use the platform without operating it",{"_3588":56,"_30857":36,"_21381":50584,"_5":14694,"_28049":50529,"_3044":50585},[],"Lamassu",{"_3588":57,"_30857":36,"_21381":50587,"_5":14694,"_28049":50529,"_3044":50588},[],"Managed subscription",{"_3588":58,"_30857":36,"_21381":50590,"_5":14694,"_28049":50529,"_3044":50591},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3588":59,"_30857":36,"_21381":50593,"_5":14694,"_28049":50529,"_3044":50594},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3588":60,"_30857":36,"_21381":50596,"_5":14694,"_28049":50529,"_3044":50597},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3588":61,"_30857":36,"_21381":50599,"_5":14694,"_28049":50533,"_3044":50600},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3588":62,"_30857":36,"_21381":50602,"_5":14694,"_28049":50537,"_3044":50603},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3588":63,"_30857":63,"_5":15054,"_3044":50605,"_31216":50606,"_21381":50607,"_28049":63},"Use Lamassu as SaaS",[50449,50450,50451],[],{"_3588":64,"_30857":63,"_21381":50609,"_5":14694,"_28049":63,"_3044":50610},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3588":65,"_30857":63,"_5":31213,"_21381":50612,"_28049":50613,"_3044":50614},[],"/docs/pr-preview/pr-70/deployment/saas#what-the-service-manages","What the service manages",{"_3588":66,"_30857":63,"_5":31213,"_21381":50616,"_28049":50617,"_3044":50618},[],"/docs/pr-preview/pr-70/deployment/saas#plans","Plans",{"_3588":67,"_30857":63,"_5":31213,"_21381":50620,"_28049":50621,"_3044":50622},[],"/docs/pr-preview/pr-70/deployment/saas#request-access","Request access",{"_3588":68,"_30857":63,"_21381":50624,"_5":14694,"_28049":63,"_3044":50625},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3588":69,"_30857":63,"_21381":50627,"_5":14694,"_28049":50613,"_3044":50628},[],"Platform availability and maintenance.",{"_3588":70,"_30857":63,"_21381":50630,"_5":14694,"_28049":50613,"_3044":50631},[],"Automatic backups.",{"_3588":71,"_30857":63,"_21381":50633,"_5":14694,"_28049":50613,"_3044":50634},[],"Version upgrades.",{"_3588":72,"_30857":63,"_21381":50636,"_5":14694,"_28049":50613,"_3044":50637},[],"Technical support and SLA according to your plan.",{"_3588":73,"_30857":63,"_21381":50639,"_5":14694,"_28049":50617,"_3044":50640},[],"Plan",{"_3588":74,"_30857":63,"_21381":50642,"_5":14694,"_28049":50617,"_3044":50643},[],"Devices",{"_3588":75,"_30857":63,"_21381":50645,"_5":14694,"_28049":50617,"_3044":50646},[],"Support",{"_3588":76,"_30857":63,"_21381":50648,"_5":14694,"_28049":50617,"_3044":50649},[],"SLA",{"_3588":77,"_30857":63,"_21381":50651,"_5":14694,"_28049":50617,"_3044":50652},[],"Starter",{"_3588":78,"_30857":63,"_21381":50654,"_5":14694,"_28049":50617,"_3044":50655},[],"Up to 1,000",{"_3588":79,"_30857":63,"_21381":50657,"_5":14694,"_28049":50617,"_3044":50658},[],"Email",{"_3588":80,"_30857":63,"_21381":50660,"_5":14694,"_28049":50617,"_3044":50661},[],"99.5 %",{"_3588":81,"_30857":63,"_21381":50663,"_5":14694,"_28049":50617,"_3044":50664},[],"Professional",{"_3588":82,"_30857":63,"_21381":50666,"_5":14694,"_28049":50617,"_3044":50667},[],"Up to 10,000",{"_3588":83,"_30857":63,"_21381":50669,"_5":14694,"_28049":50617,"_3044":50670},[],"Email and chat",{"_3588":84,"_30857":63,"_21381":50672,"_5":14694,"_28049":50617,"_3044":50673},[],"99.9 %",{"_3588":85,"_30857":63,"_21381":50675,"_5":14694,"_28049":50617,"_3044":50676},[],"Enterprise",{"_3588":86,"_30857":63,"_21381":50678,"_5":14694,"_28049":50617,"_3044":50679},[],"Unlimited",{"_3588":87,"_30857":63,"_21381":50681,"_5":14694,"_28049":50617,"_3044":50682},[],"Dedicated",{"_3588":88,"_30857":63,"_21381":50684,"_5":14694,"_28049":50617,"_3044":50685},[],"99.99 %",{"_3588":89,"_30857":63,"_21381":50687,"_5":14694,"_28049":50621,"_3044":50688},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3588":90,"_30857":63,"_21381":50690,"_5":14694,"_28049":50621,"_3044":50691},[],"When you receive your instance's credentials, continue with Get started.",{"_3588":91,"_30857":91,"_5":15054,"_3044":50693,"_31216":50694,"_21381":50695,"_28049":91},"Fastlane",[50449,50450,50556],[],{"_3588":92,"_30857":91,"_21381":50697,"_5":14694,"_28049":91,"_3044":50698},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3588":93,"_30857":91,"_5":31213,"_21381":50700,"_28049":50701,"_3044":50702},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3588":94,"_30857":91,"_5":31213,"_21381":50704,"_28049":50705,"_3044":50706},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3588":95,"_30857":91,"_5":31213,"_21381":50708,"_28049":50709,"_3044":50459},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#before-you-begin",{"_3588":96,"_30857":91,"_5":31213,"_21381":50711,"_28049":50712,"_3044":50713},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3588":97,"_30857":91,"_5":31213,"_21381":50715,"_28049":50716,"_3044":50717},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3588":98,"_30857":91,"_5":31213,"_21381":50719,"_28049":50720,"_3044":50721},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3588":99,"_30857":91,"_5":31213,"_21381":50723,"_28049":50724,"_3044":50725},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3588":100,"_30857":91,"_5":31213,"_21381":50727,"_28049":50728,"_3044":50729},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3588":101,"_30857":91,"_5":31213,"_21381":50731,"_28049":50732,"_3044":50733},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3588":102,"_30857":91,"_5":31213,"_21381":50735,"_28049":50736,"_3044":50737},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3588":103,"_30857":91,"_5":31213,"_21381":50739,"_28049":50740,"_3044":50741},[],"/docs/pr-preview/pr-70/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3588":104,"_30857":91,"_21381":50743,"_5":14694,"_28049":50701,"_3044":50744},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3588":105,"_30857":91,"_21381":50746,"_5":14694,"_28049":50701,"_3044":50747},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3588":106,"_30857":91,"_21381":50749,"_5":14694,"_28049":50705,"_3044":50750},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3588":107,"_30857":91,"_21381":50752,"_5":14694,"_28049":50705,"_3044":50753},[],"Fastlane installs or configures",{"_3588":108,"_30857":91,"_21381":50755,"_5":14694,"_28049":50705,"_3044":50756},[],"You still provide",{"_3588":109,"_30857":91,"_21381":50758,"_5":14694,"_28049":50705,"_3044":50759},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3588":110,"_30857":91,"_21381":50761,"_5":14694,"_28049":50705,"_3044":50762},[],"The Kubernetes cluster, nodes and persistent storage",{"_3588":111,"_30857":91,"_21381":50764,"_5":14694,"_28049":50705,"_3044":50765},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3588":112,"_30857":91,"_21381":50767,"_5":14694,"_28049":50705,"_3044":50768},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3588":113,"_30857":91,"_21381":50770,"_5":14694,"_28049":50705,"_3044":50771},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3588":114,"_30857":91,"_21381":50773,"_5":14694,"_28049":50705,"_3044":50774},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3588":115,"_30857":91,"_21381":50776,"_5":14694,"_28049":50705,"_3044":50777},[],"Optional observability and lab HSM components",{"_3588":116,"_30857":91,"_21381":50779,"_5":14694,"_28049":50705,"_3044":50780},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3588":117,"_30857":91,"_21381":50782,"_5":14694,"_28049":50705,"_3044":50783},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3588":118,"_30857":91,"_21381":50785,"_5":14694,"_28049":50709,"_3044":50786},[],"You need:",{"_3588":119,"_30857":91,"_21381":50788,"_5":14694,"_28049":50709,"_3044":50789},[],"an existing Kubernetes cluster",{"_3588":120,"_30857":91,"_21381":50791,"_5":14694,"_28049":50709,"_3044":50792},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3588":121,"_30857":91,"_21381":50794,"_5":14694,"_28049":50709,"_3044":50795},[],"`yq`",{"_3588":122,"_30857":91,"_21381":50797,"_5":14694,"_28049":50709,"_3044":24156},[],{"_3588":123,"_30857":91,"_21381":50799,"_5":14694,"_28049":50709,"_3044":50800},[],"`jq` only when using `--sample-data` or `--development`",{"_3588":124,"_30857":91,"_21381":50802,"_5":14694,"_28049":50709,"_3044":50803},[],"`ssh-keygen` only when using `--with-hsm`",{"_3588":125,"_30857":91,"_21381":50805,"_5":14694,"_28049":50709,"_3044":50806},[],"free external ports 80 and 443 on a single-node K3s host",{"_3588":126,"_30857":91,"_21381":50808,"_5":14694,"_28049":50709,"_3044":50809},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3588":127,"_30857":91,"_21381":50811,"_5":14694,"_28049":50709,"_3044":50812},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3588":128,"_30857":91,"_21381":50814,"_5":14694,"_28049":50712,"_3044":50815},[],"Run the script from a clone of the Helm repository:",{"_3588":129,"_30857":91,"_21381":50817,"_5":14694,"_28049":50712,"_3044":50818},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3588":130,"_30857":91,"_21381":50820,"_5":14694,"_28049":50716,"_3044":50821},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3588":131,"_30857":91,"_21381":50823,"_5":14694,"_28049":50716,"_3044":50824},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3588":132,"_30857":91,"_21381":50826,"_5":14694,"_28049":50716,"_3044":50827},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3588":133,"_30857":91,"_21381":50829,"_5":14694,"_28049":50716,"_3044":50830},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3588":134,"_30857":91,"_21381":50832,"_5":14694,"_28049":50720,"_3044":50833},[],"Option",{"_3588":135,"_30857":91,"_21381":50835,"_5":14694,"_28049":50720,"_3044":50836},[],"Default",{"_3588":136,"_30857":91,"_21381":50838,"_5":14694,"_28049":50720,"_3044":50839},[],"Purpose",{"_3588":137,"_30857":91,"_21381":50841,"_5":14694,"_28049":50720,"_3044":50842},[],"`-h`, `--help`",{"_3588":138,"_30857":91,"_21381":50844,"_5":14694,"_28049":50720,"_3044":50845},[],"—",{"_3588":139,"_30857":91,"_21381":50847,"_5":14694,"_28049":50720,"_3044":50848},[],"Show help",{"_3588":140,"_30857":91,"_21381":50850,"_5":14694,"_28049":50720,"_3044":50851},[],"`-c`, `--context`",{"_3588":141,"_30857":91,"_21381":50853,"_5":14694,"_28049":50720,"_3044":50854},[],"current context",{"_3588":142,"_30857":91,"_21381":50856,"_5":14694,"_28049":50720,"_3044":50857},[],"Select the kubeconfig context for kubectl and Helm",{"_3588":143,"_30857":91,"_21381":50859,"_5":14694,"_28049":50720,"_3044":50860},[],"`-n`, `--non-interactive`",{"_3588":144,"_30857":91,"_21381":50862,"_5":14694,"_28049":50720,"_3044":6730},[],{"_3588":145,"_30857":91,"_21381":50864,"_5":14694,"_28049":50720,"_3044":50865},[],"Skip prompts and generate dependency credentials",{"_3588":146,"_30857":91,"_21381":50867,"_5":14694,"_28049":50720,"_3044":50868},[],"`-ns`, `--namespace`",{"_3588":147,"_30857":91,"_21381":50870,"_5":14694,"_28049":50720,"_3044":50871},[],"`lamassu-dev`",{"_3588":148,"_30857":91,"_21381":50873,"_5":14694,"_28049":50720,"_3044":50874},[],"Namespace for the installation",{"_3588":149,"_30857":91,"_21381":50876,"_5":14694,"_28049":50720,"_3044":50877},[],"`-d`, `--domain`",{"_3588":150,"_30857":91,"_21381":50879,"_5":14694,"_28049":50720,"_3044":50880},[],"`dev.lamassu.io`",{"_3588":151,"_30857":91,"_21381":50882,"_5":14694,"_28049":50720,"_3044":50883},[],"Domain used by the UI, OIDC and certificate",{"_3588":152,"_30857":91,"_21381":50885,"_5":14694,"_28049":50720,"_3044":50886},[],"`-v`, `--version`",{"_3588":153,"_30857":91,"_21381":50888,"_5":14694,"_28049":50720,"_3044":15405},[],{"_3588":154,"_30857":91,"_21381":50890,"_5":14694,"_28049":50720,"_3044":50891},[],"Lamassu chart version",{"_3588":155,"_30857":91,"_21381":50893,"_5":14694,"_28049":50720,"_3044":50894},[],"`--https-port`",{"_3588":156,"_30857":91,"_21381":50896,"_5":14694,"_28049":50720,"_3044":50897},[],"`443`",{"_3588":157,"_30857":91,"_21381":50899,"_5":14694,"_28049":50720,"_3044":50900},[],"Gateway HTTPS listener port",{"_3588":158,"_30857":91,"_21381":50902,"_5":14694,"_28049":50720,"_3044":50903},[],"`--http-port`",{"_3588":159,"_30857":91,"_21381":50905,"_5":14694,"_28049":50720,"_3044":50906},[],"`80`",{"_3588":160,"_30857":91,"_21381":50908,"_5":14694,"_28049":50720,"_3044":50909},[],"Gateway HTTP listener port",{"_3588":161,"_30857":91,"_21381":50911,"_5":14694,"_28049":50720,"_3044":50912},[],"`--tls-crt`",{"_3588":162,"_30857":91,"_21381":50914,"_5":14694,"_28049":50720,"_3044":50845},[],{"_3588":163,"_30857":91,"_21381":50916,"_5":14694,"_28049":50720,"_3044":50917},[],"PEM certificate for downstream TLS",{"_3588":164,"_30857":91,"_21381":50919,"_5":14694,"_28049":50720,"_3044":50920},[],"`--tls-key`",{"_3588":165,"_30857":91,"_21381":50922,"_5":14694,"_28049":50720,"_3044":50845},[],{"_3588":166,"_30857":91,"_21381":50924,"_5":14694,"_28049":50720,"_3044":50925},[],"PEM private key for downstream TLS",{"_3588":167,"_30857":91,"_21381":50927,"_5":14694,"_28049":50720,"_3044":50928},[],"`-l`, `--local-chart-path`",{"_3588":168,"_30857":91,"_21381":50930,"_5":14694,"_28049":50720,"_3044":50931},[],"repository chart",{"_3588":169,"_30857":91,"_21381":50933,"_5":14694,"_28049":50720,"_3044":50934},[],"Use an unpacked local Lamassu chart",{"_3588":170,"_30857":91,"_21381":50936,"_5":14694,"_28049":50720,"_3044":50937},[],"`-ip`, `--gateway-ip`",{"_3588":171,"_30857":91,"_21381":50939,"_5":14694,"_28049":50720,"_3044":8983},[],{"_3588":172,"_30857":91,"_21381":50941,"_5":14694,"_28049":50720,"_3044":50942},[],"Override the address written to `gateway.addresses`",{"_3588":173,"_30857":91,"_21381":50944,"_5":14694,"_28049":50720,"_3044":50945},[],"`--otel`",{"_3588":174,"_30857":91,"_21381":50947,"_5":14694,"_28049":50720,"_3044":6730},[],{"_3588":175,"_30857":91,"_21381":50949,"_5":14694,"_28049":50720,"_3044":50950},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3588":176,"_30857":91,"_21381":50952,"_5":14694,"_28049":50720,"_3044":50953},[],"`--development`",{"_3588":177,"_30857":91,"_21381":50955,"_5":14694,"_28049":50720,"_3044":6730},[],{"_3588":178,"_30857":91,"_21381":50957,"_5":14694,"_28049":50720,"_3044":50958},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3588":179,"_30857":91,"_21381":50960,"_5":14694,"_28049":50720,"_3044":50961},[],"`--sample-data`",{"_3588":180,"_30857":91,"_21381":50963,"_5":14694,"_28049":50720,"_3044":6730},[],{"_3588":181,"_30857":91,"_21381":50965,"_5":14694,"_28049":50720,"_3044":50966},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3588":182,"_30857":91,"_21381":50968,"_5":14694,"_28049":50720,"_3044":50969},[],"`--with-hsm`",{"_3588":183,"_30857":91,"_21381":50971,"_5":14694,"_28049":50720,"_3044":6730},[],{"_3588":184,"_30857":91,"_21381":50973,"_5":14694,"_28049":50720,"_3044":50974},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3588":185,"_30857":91,"_21381":50976,"_5":14694,"_28049":50720,"_3044":50977},[],"`--softhsm-chart-path`",{"_3588":186,"_30857":91,"_21381":50979,"_5":14694,"_28049":50720,"_3044":50980},[],"`./charts/softhsm`",{"_3588":187,"_30857":91,"_21381":50982,"_5":14694,"_28049":50720,"_3044":50983},[],"Use a different local SoftHSM chart",{"_3588":188,"_30857":91,"_21381":50985,"_5":14694,"_28049":50720,"_3044":50986},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3588":189,"_30857":91,"_21381":50988,"_5":14694,"_28049":50724,"_3044":50989},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3588":190,"_30857":91,"_21381":50991,"_5":14694,"_28049":50724,"_3044":50992},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3588":191,"_30857":91,"_21381":50994,"_5":14694,"_28049":50724,"_3044":50995},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3588":192,"_30857":91,"_21381":50997,"_5":14694,"_28049":50724,"_3044":50998},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3588":193,"_30857":91,"_21381":51000,"_5":14694,"_28049":50724,"_3044":51001},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3588":194,"_30857":91,"_21381":51003,"_5":14694,"_28049":50724,"_3044":51004},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3588":195,"_30857":91,"_21381":51006,"_5":14694,"_28049":50728,"_3044":51007},[],"Fastlane:",{"_3588":196,"_30857":91,"_21381":51009,"_5":14694,"_28049":50728,"_3044":51010},[],"validates local tools and the selected cluster",{"_3588":197,"_30857":91,"_21381":51012,"_5":14694,"_28049":50728,"_3044":51013},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3588":198,"_30857":91,"_21381":51015,"_5":14694,"_28049":50728,"_3044":51016},[],"creates the namespace",{"_3588":199,"_30857":91,"_21381":51018,"_5":14694,"_28049":50728,"_3044":51019},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3588":200,"_30857":91,"_21381":51021,"_5":14694,"_28049":50728,"_3044":51022},[],"installs PostgreSQL and creates the required databases",{"_3588":201,"_30857":91,"_21381":51024,"_5":14694,"_28049":50728,"_3044":51025},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3588":202,"_30857":91,"_21381":51027,"_5":14694,"_28049":50728,"_3044":51028},[],"installs RabbitMQ",{"_3588":203,"_30857":91,"_21381":51030,"_5":14694,"_28049":50728,"_3044":51031},[],"optionally installs observability and lab HSM components",{"_3588":204,"_30857":91,"_21381":51033,"_5":14694,"_28049":50728,"_3044":51034},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3588":205,"_30857":91,"_21381":51036,"_5":14694,"_28049":50728,"_3044":51037},[],"optionally loads sample data",{"_3588":206,"_30857":91,"_21381":51039,"_5":14694,"_28049":50728,"_3044":51040},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3588":207,"_30857":91,"_21381":51042,"_5":14694,"_28049":50732,"_3044":51043},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3588":208,"_30857":91,"_21381":51045,"_5":14694,"_28049":50732,"_3044":51046},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3588":209,"_30857":91,"_21381":51048,"_5":14694,"_28049":50736,"_3044":51049},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3588":210,"_30857":91,"_21381":51051,"_5":14694,"_28049":50736,"_3044":51052},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3588":211,"_30857":91,"_21381":51054,"_5":14694,"_28049":50736,"_3044":51055},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3588":212,"_30857":91,"_21381":51057,"_5":14694,"_28049":50736,"_3044":51058},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3588":213,"_30857":91,"_21381":51060,"_5":14694,"_28049":50740,"_3044":51061},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3588":214,"_30857":214,"_5":15054,"_3044":51063,"_31216":51064,"_21381":51065,"_28049":214},"Install with Helm",[50449,50450,50556],[],{"_3588":215,"_30857":214,"_21381":51067,"_5":14694,"_28049":214,"_3044":51068},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3588":216,"_30857":214,"_5":31213,"_21381":51070,"_28049":51071,"_3044":51072},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3588":217,"_30857":214,"_5":31213,"_21381":51074,"_28049":51075,"_3044":50459},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#before-you-begin",{"_3588":218,"_30857":214,"_5":31213,"_21381":51077,"_28049":51078,"_3044":51079},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3588":219,"_30857":214,"_5":31213,"_21381":51081,"_28049":51082,"_3044":51083},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3588":220,"_30857":214,"_5":31213,"_21381":51085,"_28049":51086,"_3044":51087},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3588":221,"_30857":214,"_5":31213,"_21381":51089,"_28049":51090,"_3044":51091},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3588":222,"_30857":214,"_5":31213,"_21381":51093,"_28049":51094,"_3044":51095},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3588":223,"_30857":214,"_5":31213,"_21381":51097,"_28049":51098,"_3044":51099},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3588":224,"_30857":214,"_5":31213,"_21381":51101,"_28049":51102,"_3044":51103},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3588":225,"_30857":214,"_5":31213,"_21381":51105,"_28049":51106,"_3044":51107},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3588":226,"_30857":214,"_5":31213,"_21381":51109,"_28049":51110,"_3044":51111},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3588":227,"_30857":214,"_5":31213,"_21381":51113,"_28049":51114,"_3044":51115},[],"/docs/pr-preview/pr-70/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3588":228,"_30857":214,"_21381":51117,"_5":14694,"_28049":51071,"_3044":51118},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3588":229,"_30857":214,"_21381":51120,"_5":14694,"_28049":51075,"_3044":51121},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3588":230,"_30857":214,"_21381":51123,"_5":14694,"_28049":51075,"_3044":51124},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3588":231,"_30857":214,"_21381":51126,"_5":14694,"_28049":51075,"_3044":51127},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3588":232,"_30857":214,"_21381":51129,"_5":14694,"_28049":51075,"_3044":51130},[],"a reachable RabbitMQ broker and credentials",{"_3588":233,"_30857":214,"_21381":51132,"_5":14694,"_28049":51075,"_3044":51133},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3588":234,"_30857":214,"_21381":51135,"_5":14694,"_28049":51075,"_3044":51136},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3588":235,"_30857":214,"_21381":51138,"_5":14694,"_28049":51075,"_3044":51139},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3588":236,"_30857":214,"_21381":51141,"_5":14694,"_28049":51075,"_3044":51142},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3588":237,"_30857":214,"_21381":51144,"_5":14694,"_28049":51075,"_3044":51145},[],"a StorageClass and an external traffic design",{"_3588":238,"_30857":214,"_21381":51147,"_5":14694,"_28049":51075,"_3044":51148},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3588":239,"_30857":214,"_21381":51150,"_5":14694,"_28049":51075,"_3044":51151},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3588":240,"_30857":214,"_21381":51153,"_5":14694,"_28049":51075,"_3044":51154},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3588":241,"_30857":214,"_21381":51156,"_5":14694,"_28049":51078,"_3044":51157},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3588":242,"_30857":214,"_21381":51159,"_5":14694,"_28049":51078,"_3044":51160},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3588":243,"_30857":214,"_21381":51162,"_5":14694,"_28049":51078,"_3044":51163},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3588":244,"_30857":214,"_21381":51165,"_5":14694,"_28049":51082,"_3044":51166},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3588":245,"_30857":214,"_21381":51168,"_5":14694,"_28049":51082,"_3044":51169},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3588":246,"_30857":214,"_21381":51171,"_5":14694,"_28049":51082,"_3044":51172},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3588":247,"_30857":214,"_21381":51174,"_5":14694,"_28049":51082,"_3044":51175},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3588":248,"_30857":214,"_21381":51177,"_5":14694,"_28049":51086,"_3044":51178},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3588":249,"_30857":214,"_21381":51180,"_5":14694,"_28049":51086,"_3044":51181},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3588":250,"_30857":214,"_21381":51183,"_5":14694,"_28049":51086,"_3044":51184},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3588":251,"_30857":214,"_21381":51186,"_5":14694,"_28049":51086,"_3044":51187},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3588":252,"_30857":214,"_21381":51189,"_5":14694,"_28049":51086,"_3044":51190},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3588":253,"_30857":214,"_21381":51192,"_5":14694,"_28049":51086,"_3044":51193},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3588":254,"_30857":214,"_21381":51195,"_5":14694,"_28049":51086,"_3044":51196},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3588":255,"_30857":214,"_21381":51198,"_5":14694,"_28049":51086,"_3044":51199},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3588":256,"_30857":214,"_21381":51201,"_5":14694,"_28049":51090,"_3044":51202},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3588":257,"_30857":214,"_21381":51204,"_5":14694,"_28049":51094,"_3044":51205},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3588":258,"_30857":214,"_21381":51207,"_5":14694,"_28049":51094,"_3044":51208},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3588":259,"_30857":214,"_21381":51210,"_5":14694,"_28049":51094,"_3044":51211},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3588":260,"_30857":214,"_21381":51213,"_5":14694,"_28049":51094,"_3044":51214},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3588":261,"_30857":214,"_21381":51216,"_5":14694,"_28049":51094,"_3044":51217},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3588":262,"_30857":214,"_21381":51219,"_5":14694,"_28049":51094,"_3044":51220},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3588":263,"_30857":214,"_21381":51222,"_5":14694,"_28049":51094,"_3044":51223},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3588":264,"_30857":214,"_21381":51225,"_5":14694,"_28049":51098,"_3044":51226},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3588":265,"_30857":214,"_21381":51228,"_5":14694,"_28049":51098,"_3044":51229},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3588":266,"_30857":214,"_21381":51231,"_5":14694,"_28049":51098,"_3044":51232},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3588":267,"_30857":214,"_21381":51234,"_5":14694,"_28049":51098,"_3044":51235},[],"See Access control for the principal and policy model.",{"_3588":268,"_30857":214,"_21381":51237,"_5":14694,"_28049":51102,"_3044":51238},[],"To install a local checkout instead:",{"_3588":269,"_30857":214,"_21381":51240,"_5":14694,"_28049":51106,"_3044":51241},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3588":270,"_30857":214,"_21381":51243,"_5":14694,"_28049":51106,"_3044":51244},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3588":271,"_30857":214,"_21381":51246,"_5":14694,"_28049":51110,"_3044":51247},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3588":272,"_30857":214,"_21381":51249,"_5":14694,"_28049":51110,"_3044":51250},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3588":273,"_30857":214,"_21381":51252,"_5":14694,"_28049":51110,"_3044":51253},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3588":274,"_30857":214,"_21381":51255,"_5":14694,"_28049":51110,"_3044":51256},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3588":275,"_30857":214,"_21381":51258,"_5":14694,"_28049":51110,"_3044":51259},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3588":276,"_30857":214,"_21381":51261,"_5":14694,"_28049":51114,"_3044":51262},[],"Before going live, review:",{"_3588":277,"_30857":214,"_21381":51264,"_5":14694,"_28049":51114,"_3044":51265},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3588":278,"_30857":214,"_21381":51267,"_5":14694,"_28049":51114,"_3044":51268},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3588":279,"_30857":214,"_21381":51270,"_5":14694,"_28049":51114,"_3044":51271},[],"shared VA storage before increasing VA replicas",{"_3588":280,"_30857":214,"_21381":51273,"_5":14694,"_28049":51114,"_3044":51274},[],"managed OIDC roles and removal of evaluation credentials",{"_3588":281,"_30857":214,"_21381":51276,"_5":14694,"_28049":51114,"_3044":51277},[],"a trusted TLS issuer or externally managed certificate",{"_3588":282,"_30857":214,"_21381":51279,"_5":14694,"_28049":51114,"_3044":51280},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3588":283,"_30857":214,"_21381":51282,"_5":14694,"_28049":51114,"_3044":51283},[],"SMTP, observability and alert delivery",{"_3588":284,"_30857":214,"_21381":51285,"_5":14694,"_28049":51114,"_3044":51286},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3588":285,"_30857":214,"_21381":51288,"_5":14694,"_28049":51114,"_3044":51289},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3588":286,"_30857":286,"_5":15054,"_3044":51291,"_31216":51292,"_21381":51293,"_28049":286},"Expose the Gateway",[50449,50450,50556],[],{"_3588":287,"_30857":286,"_21381":51295,"_5":14694,"_28049":286,"_3044":51296},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3588":288,"_30857":286,"_5":31213,"_21381":51298,"_28049":51299,"_3044":51300},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3588":289,"_30857":286,"_5":31213,"_21381":51302,"_28049":51303,"_3044":51304},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3588":290,"_30857":286,"_5":31213,"_21381":51306,"_28049":51307,"_3044":51308},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3588":291,"_30857":286,"_5":31213,"_21381":51310,"_28049":51311,"_3044":51312},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#k3s","K3s",{"_3588":292,"_30857":286,"_5":31213,"_21381":51314,"_28049":51315,"_3044":51316},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3588":293,"_30857":286,"_5":31213,"_21381":51318,"_28049":51319,"_3044":51320},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3588":294,"_30857":286,"_5":31213,"_21381":51322,"_28049":51323,"_3044":51324},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3588":295,"_30857":286,"_5":31213,"_21381":51326,"_28049":51327,"_3044":51328},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3588":296,"_30857":286,"_5":31213,"_21381":51330,"_28049":51331,"_3044":51332},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3588":297,"_30857":286,"_5":31213,"_21381":51334,"_28049":51335,"_3044":51336},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3588":298,"_30857":286,"_5":31213,"_21381":51338,"_28049":51339,"_3044":51340},[],"/docs/pr-preview/pr-70/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3588":299,"_30857":286,"_21381":51342,"_5":14694,"_28049":51299,"_3044":51343},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3588":300,"_30857":286,"_21381":51345,"_5":14694,"_28049":51299,"_3044":51346},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3588":301,"_30857":286,"_21381":51348,"_5":14694,"_28049":51303,"_3044":51349},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3588":302,"_30857":286,"_21381":51351,"_5":14694,"_28049":51303,"_3044":51352},[],"Set it only when:",{"_3588":303,"_30857":286,"_21381":51354,"_5":14694,"_28049":51303,"_3044":51355},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3588":304,"_30857":286,"_21381":51357,"_5":14694,"_28049":51303,"_3044":51358},[],"that address is allocated to this Gateway",{"_3588":305,"_30857":286,"_21381":51360,"_5":14694,"_28049":51303,"_3044":51361},[],"the surrounding network already routes traffic for it to the cluster",{"_3588":306,"_30857":286,"_21381":51363,"_5":14694,"_28049":51303,"_3044":51364},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3588":307,"_30857":286,"_21381":51366,"_5":14694,"_28049":51303,"_3044":51367},[],"Keep these two settings separate:",{"_3588":308,"_30857":286,"_21381":51369,"_5":14694,"_28049":51303,"_3044":51370},[],"`gateway.addresses` requests an address for the Gateway.",{"_3588":309,"_30857":286,"_21381":51372,"_5":14694,"_28049":51303,"_3044":51373},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3588":310,"_30857":286,"_21381":51375,"_5":14694,"_28049":51303,"_3044":51376},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3588":311,"_30857":286,"_21381":51378,"_5":14694,"_28049":51307,"_3044":51379},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3588":312,"_30857":286,"_21381":51381,"_5":14694,"_28049":51307,"_3044":51382},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3588":313,"_30857":286,"_21381":51384,"_5":14694,"_28049":51311,"_3044":51385},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3588":314,"_30857":286,"_21381":51387,"_5":14694,"_28049":51311,"_3044":51388},[],"For the recommended design:",{"_3588":315,"_30857":286,"_21381":51390,"_5":14694,"_28049":51311,"_3044":51391},[],"Use only one externally exposed Lamassu Gateway.",{"_3588":316,"_30857":286,"_21381":51393,"_5":14694,"_28049":51311,"_3044":51394},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3588":317,"_30857":286,"_21381":51396,"_5":14694,"_28049":51311,"_3044":51397},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3588":318,"_30857":286,"_21381":51399,"_5":14694,"_28049":51311,"_3044":51400},[],"Point DNS at the VM's reachable address.",{"_3588":319,"_30857":286,"_21381":51402,"_5":14694,"_28049":51311,"_3044":51403},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3588":320,"_30857":286,"_21381":51405,"_5":14694,"_28049":51315,"_3044":51406},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3588":321,"_30857":286,"_21381":51408,"_5":14694,"_28049":51319,"_3044":51409},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3588":322,"_30857":286,"_21381":51411,"_5":14694,"_28049":51319,"_3044":51412},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3588":323,"_30857":286,"_21381":51414,"_5":14694,"_28049":51323,"_3044":51415},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3588":324,"_30857":286,"_21381":51417,"_5":14694,"_28049":51323,"_3044":51418},[],"Requirement",{"_3588":325,"_30857":286,"_21381":51420,"_5":14694,"_28049":51323,"_3044":51421},[],"Recommended design",{"_3588":326,"_30857":286,"_21381":51423,"_5":14694,"_28049":51323,"_3044":51424},[],"Consequence",{"_3588":327,"_30857":286,"_21381":51426,"_5":14694,"_28049":51323,"_3044":51427},[],"Several Lamassu URLs or services",{"_3588":328,"_30857":286,"_21381":51429,"_5":14694,"_28049":51323,"_3044":51430},[],"One Gateway with multiple routes",{"_3588":329,"_30857":286,"_21381":51432,"_5":14694,"_28049":51323,"_3044":51433},[],"One IP and one proxy fleet; this is the chart default",{"_3588":330,"_30857":286,"_21381":51435,"_5":14694,"_28049":51323,"_3044":51436},[],"Independent Gateways and separate external IPs",{"_3588":331,"_30857":286,"_21381":51438,"_5":14694,"_28049":51323,"_3044":51439},[],"One VIP per Gateway",{"_3588":332,"_30857":286,"_21381":51441,"_5":14694,"_28049":51323,"_3044":51442},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3588":333,"_30857":286,"_21381":51444,"_5":14694,"_28049":51323,"_3044":51445},[],"Independent Gateways on one node and one IP",{"_3588":334,"_30857":286,"_21381":51447,"_5":14694,"_28049":51323,"_3044":51448},[],"Use different external ports",{"_3588":335,"_30857":286,"_21381":51450,"_5":14694,"_28049":51323,"_3044":51451},[],"Clients must include non-standard ports",{"_3588":336,"_30857":286,"_21381":51453,"_5":14694,"_28049":51323,"_3044":51454},[],"Separate TLS/mTLS termination behind one IP",{"_3588":337,"_30857":286,"_21381":51456,"_5":14694,"_28049":51323,"_3044":51457},[],"Front-door SNI routing to internal Gateways",{"_3588":338,"_30857":286,"_21381":51459,"_5":14694,"_28049":51323,"_3044":51460},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3588":339,"_30857":286,"_21381":51462,"_5":14694,"_28049":51323,"_3044":51463},[],"Separate Gateway resources but shared proxy infrastructure",{"_3588":340,"_30857":286,"_21381":51465,"_5":14694,"_28049":51323,"_3044":51466},[],"Envoy merged-Gateway mode",{"_3588":341,"_30857":286,"_21381":51468,"_5":14694,"_28049":51323,"_3044":51469},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3588":342,"_30857":286,"_21381":51471,"_5":14694,"_28049":51323,"_3044":51472},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3588":343,"_30857":286,"_21381":51474,"_5":14694,"_28049":51323,"_3044":51475},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3588":344,"_30857":286,"_21381":51477,"_5":14694,"_28049":51323,"_3044":51478},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3588":345,"_30857":286,"_21381":51480,"_5":14694,"_28049":51323,"_3044":51481},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3588":346,"_30857":286,"_21381":51483,"_5":14694,"_28049":51327,"_3044":51484},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3588":347,"_30857":286,"_21381":51486,"_5":14694,"_28049":51331,"_3044":51487},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3588":348,"_30857":286,"_21381":51489,"_5":14694,"_28049":51331,"_3044":51490},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3588":349,"_30857":286,"_21381":51492,"_5":14694,"_28049":51331,"_3044":51493},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3588":350,"_30857":286,"_21381":51495,"_5":14694,"_28049":51331,"_3044":51496},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3588":351,"_30857":286,"_21381":51498,"_5":14694,"_28049":51331,"_3044":51499},[],"If none of those are possible, use different external ports or change the external network design.",{"_3588":352,"_30857":286,"_21381":51501,"_5":14694,"_28049":51335,"_3044":51502},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3588":353,"_30857":286,"_21381":51504,"_5":14694,"_28049":51335,"_3044":51505},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3588":354,"_30857":286,"_21381":51507,"_5":14694,"_28049":51339,"_3044":51508},[],"Check, in order:",{"_3588":355,"_30857":286,"_21381":51510,"_5":14694,"_28049":51339,"_3044":51511},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3588":356,"_30857":286,"_21381":51513,"_5":14694,"_28049":51339,"_3044":51514},[],"Its status contains the expected address.",{"_3588":357,"_30857":286,"_21381":51516,"_5":14694,"_28049":51339,"_3044":51517},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3588":358,"_30857":286,"_21381":51519,"_5":14694,"_28049":51339,"_3044":51520},[],"Port 443 reaches that address from the client network.",{"_3588":359,"_30857":286,"_21381":51522,"_5":14694,"_28049":51339,"_3044":51523},[],"DNS resolves to the externally reachable endpoint.",{"_3588":360,"_30857":286,"_21381":51525,"_5":14694,"_28049":51339,"_3044":51526},[],"The certificate contains the DNS name or IP used by the client.",{"_3588":361,"_30857":286,"_21381":51528,"_5":14694,"_28049":51339,"_3044":51529},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3588":362,"_30857":362,"_5":15054,"_3044":50556,"_31216":51531,"_21381":51532,"_28049":362},[50449,50450,50556],[],{"_3588":363,"_30857":362,"_21381":51534,"_5":14694,"_28049":362,"_3044":51535},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3588":364,"_30857":362,"_5":31213,"_21381":51537,"_28049":51538,"_3044":51539},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3588":365,"_30857":362,"_5":31213,"_21381":51541,"_28049":51542,"_3044":51543},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3588":366,"_30857":362,"_5":31213,"_21381":51545,"_28049":51546,"_3044":51547},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3588":367,"_30857":362,"_5":31213,"_21381":51549,"_28049":51550,"_3044":51551},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3588":368,"_30857":362,"_5":31213,"_21381":51553,"_28049":51554,"_3044":51555},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3588":369,"_30857":362,"_5":31213,"_21381":51557,"_28049":51558,"_3044":51559},[],"/docs/pr-preview/pr-70/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3588":370,"_30857":362,"_21381":51561,"_5":14694,"_28049":51538,"_3044":51562},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3588":371,"_30857":362,"_21381":51564,"_5":14694,"_28049":51542,"_3044":51565},[],"Workflow",{"_3588":372,"_30857":362,"_21381":51567,"_5":14694,"_28049":51542,"_3044":51568},[],"Use it for",{"_3588":373,"_30857":362,"_21381":51570,"_5":14694,"_28049":51542,"_3044":51571},[],"What it installs",{"_3588":374,"_30857":362,"_21381":51573,"_5":14694,"_28049":51542,"_3044":51574},[],"Helm",{"_3588":375,"_30857":362,"_21381":51576,"_5":14694,"_28049":51542,"_3044":51577},[],"Production and controlled environments",{"_3588":376,"_30857":362,"_21381":51579,"_5":14694,"_28049":51542,"_3044":51580},[],"Lamassu services and Gateway API resources",{"_3588":377,"_30857":362,"_21381":51582,"_5":14694,"_28049":51542,"_3044":50693},[],{"_3588":378,"_30857":362,"_21381":51584,"_5":14694,"_28049":51542,"_3044":51585},[],"Evaluation, demos, CI and small lab clusters",{"_3588":379,"_30857":362,"_21381":51587,"_5":14694,"_28049":51542,"_3044":51588},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3588":380,"_30857":362,"_21381":51590,"_5":14694,"_28049":51546,"_3044":51591},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3588":381,"_30857":362,"_21381":51593,"_5":14694,"_28049":51546,"_3044":51594},[],"Area",{"_3588":382,"_30857":362,"_21381":51596,"_5":14694,"_28049":51546,"_3044":51597},[],"The Lamassu chart provides",{"_3588":383,"_30857":362,"_21381":51599,"_5":14694,"_28049":51546,"_3044":51600},[],"You provide",{"_3588":384,"_30857":362,"_21381":51602,"_5":14694,"_28049":51546,"_3044":51603},[],"Lamassu applications",{"_3588":385,"_30857":362,"_21381":51605,"_5":14694,"_28049":51546,"_3044":51606},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3588":386,"_30857":362,"_21381":51608,"_5":14694,"_28049":51546,"_3044":51609},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3588":387,"_30857":362,"_21381":51611,"_5":14694,"_28049":51546,"_3044":51612},[],"PostgreSQL data",{"_3588":388,"_30857":362,"_21381":51614,"_5":14694,"_28049":51546,"_3044":51615},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3588":389,"_30857":362,"_21381":51617,"_5":14694,"_28049":51546,"_3044":51618},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3588":390,"_30857":362,"_21381":51620,"_5":14694,"_28049":51546,"_3044":51621},[],"Messaging",{"_3588":391,"_30857":362,"_21381":51623,"_5":14694,"_28049":51546,"_3044":51624},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3588":392,"_30857":362,"_21381":51626,"_5":14694,"_28049":51546,"_3044":51627},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3588":393,"_30857":362,"_21381":51629,"_5":14694,"_28049":51546,"_3044":51630},[],"Identity",{"_3588":394,"_30857":362,"_21381":51632,"_5":14694,"_28049":51546,"_3044":51633},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3588":395,"_30857":362,"_21381":51635,"_5":14694,"_28049":51546,"_3044":51636},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3588":396,"_30857":362,"_21381":51638,"_5":14694,"_28049":51546,"_3044":51639},[],"External routing",{"_3588":397,"_30857":362,"_21381":51641,"_5":14694,"_28049":51546,"_3044":51642},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3588":398,"_30857":362,"_21381":51644,"_5":14694,"_28049":51546,"_3044":51645},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3588":399,"_30857":362,"_21381":51647,"_5":14694,"_28049":51546,"_3044":51648},[],"TLS",{"_3588":400,"_30857":362,"_21381":51650,"_5":14694,"_28049":51546,"_3044":51651},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3588":401,"_30857":362,"_21381":51653,"_5":14694,"_28049":51546,"_3044":51654},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3588":402,"_30857":362,"_21381":51656,"_5":14694,"_28049":51546,"_3044":51657},[],"Persistent application data",{"_3588":403,"_30857":362,"_21381":51659,"_5":14694,"_28049":51546,"_3044":51660},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3588":404,"_30857":362,"_21381":51662,"_5":14694,"_28049":51546,"_3044":51663},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3588":405,"_30857":362,"_21381":51665,"_5":14694,"_28049":51546,"_3044":51666},[],"Optional integrations",{"_3588":406,"_30857":362,"_21381":51668,"_5":14694,"_28049":51546,"_3044":51669},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3588":407,"_30857":362,"_21381":51671,"_5":14694,"_28049":51546,"_3044":51672},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3588":408,"_30857":362,"_21381":51674,"_5":14694,"_28049":51546,"_3044":51675},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3588":409,"_30857":362,"_21381":51677,"_5":14694,"_28049":51546,"_3044":51678},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3588":410,"_30857":362,"_21381":51680,"_5":14694,"_28049":51550,"_3044":51681},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3588":411,"_30857":362,"_21381":51683,"_5":14694,"_28049":51550,"_3044":51684},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3588":412,"_30857":362,"_21381":51686,"_5":14694,"_28049":51554,"_3044":51687},[],"Kubernetes 1.24 or newer",{"_3588":413,"_30857":362,"_21381":51689,"_5":14694,"_28049":51554,"_3044":51690},[],"Helm 3.2 or newer",{"_3588":414,"_30857":362,"_21381":51692,"_5":14694,"_28049":51554,"_3044":51693},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3588":415,"_30857":362,"_21381":51695,"_5":14694,"_28049":51554,"_3044":51696},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3588":416,"_30857":362,"_21381":51698,"_5":14694,"_28049":51554,"_3044":51699},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3588":417,"_30857":362,"_21381":51701,"_5":14694,"_28049":51554,"_3044":51702},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3588":418,"_30857":362,"_21381":51704,"_5":14694,"_28049":51554,"_3044":51705},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3588":419,"_30857":362,"_21381":51707,"_5":14694,"_28049":51558,"_3044":51708},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3588":420,"_30857":362,"_21381":51710,"_5":14694,"_28049":51558,"_3044":51711},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3588":421,"_30857":362,"_21381":51713,"_5":14694,"_28049":51558,"_3044":51714},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3588":422,"_30857":362,"_21381":51716,"_5":14694,"_28049":51558,"_3044":51717},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3588":423,"_30857":423,"_5":15054,"_3044":51719,"_31216":51720,"_21381":51722,"_28049":423},"Deployment troubleshooting",[50449,50450,51721],"Operations",[],{"_3588":424,"_30857":423,"_21381":51724,"_5":14694,"_28049":423,"_3044":51725},[],"Diagnose access, service health and infrastructure dependencies.",{"_3588":425,"_30857":423,"_5":31213,"_21381":51727,"_28049":51728,"_3044":51729},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3588":426,"_30857":423,"_5":31213,"_21381":51731,"_28049":51732,"_3044":51733},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3588":427,"_30857":423,"_5":31213,"_21381":51735,"_28049":51736,"_3044":51737},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3588":428,"_30857":423,"_5":31213,"_21381":51739,"_28049":51740,"_3044":51741},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3588":429,"_30857":423,"_5":31213,"_21381":51743,"_28049":51744,"_3044":51745},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3588":430,"_30857":423,"_5":31213,"_21381":51747,"_28049":51748,"_3044":51749},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3588":431,"_30857":423,"_5":31213,"_21381":51751,"_28049":51752,"_3044":51753},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3588":432,"_30857":423,"_5":31213,"_21381":51755,"_28049":51756,"_3044":51757},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3588":433,"_30857":423,"_5":31213,"_21381":51759,"_28049":51760,"_3044":51761},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3588":434,"_30857":423,"_5":31213,"_21381":51763,"_28049":51764,"_3044":51765},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3588":435,"_30857":423,"_5":31213,"_21381":51767,"_28049":51768,"_3044":51769},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3588":436,"_30857":423,"_5":31213,"_21381":51771,"_28049":51772,"_3044":51773},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3588":437,"_30857":423,"_5":31213,"_21381":51775,"_28049":51776,"_3044":51777},[],"/docs/pr-preview/pr-70/deployment/troubleshooting#observability","Observability",{"_3588":438,"_30857":423,"_21381":51779,"_5":14694,"_28049":423,"_3044":51780},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3588":439,"_30857":423,"_21381":51782,"_5":14694,"_28049":51732,"_3044":51783},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3588":440,"_30857":423,"_21381":51785,"_5":14694,"_28049":51736,"_3044":51786},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3588":441,"_30857":423,"_21381":51788,"_5":14694,"_28049":51740,"_3044":51789},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3588":442,"_30857":423,"_21381":51791,"_5":14694,"_28049":51744,"_3044":51792},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3588":443,"_30857":423,"_21381":51794,"_5":14694,"_28049":51748,"_3044":51795},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3588":444,"_30857":423,"_21381":51797,"_5":14694,"_28049":51752,"_3044":51798},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3588":445,"_30857":423,"_21381":51800,"_5":14694,"_28049":51752,"_3044":51801},[],"Also run the chart's connectivity test:",{"_3588":446,"_30857":423,"_21381":51803,"_5":14694,"_28049":51752,"_3044":51804},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3588":447,"_30857":423,"_21381":51806,"_5":14694,"_28049":51752,"_3044":51807},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3588":448,"_30857":423,"_21381":51809,"_5":14694,"_28049":51756,"_3044":51810},[],"If you receive a 401:",{"_3588":449,"_30857":423,"_21381":51812,"_5":14694,"_28049":51756,"_3044":51813},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3588":450,"_30857":423,"_21381":51815,"_5":14694,"_28049":51756,"_3044":51816},[],"verify issuer, audience and expiration of the token;",{"_3588":451,"_30857":423,"_21381":51818,"_5":14694,"_28049":51756,"_3044":51819},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3588":452,"_30857":423,"_21381":51821,"_5":14694,"_28049":51756,"_3044":51822},[],"check that the provider's public and internal routes point to the same realm.",{"_3588":453,"_30857":423,"_21381":51824,"_5":14694,"_28049":51756,"_3044":51825},[],"If login succeeds but the APIs return 403:",{"_3588":454,"_30857":423,"_21381":51827,"_5":14694,"_28049":51756,"_3044":51828},[],"inspect the token's real claims;",{"_3588":455,"_30857":423,"_21381":51830,"_5":14694,"_28049":51756,"_3044":51831},[],"confirm they match an active principal;",{"_3588":456,"_30857":423,"_21381":51833,"_5":14694,"_28049":51756,"_3044":51834},[],"review the policies granted to that principal;",{"_3588":457,"_30857":423,"_21381":51836,"_5":14694,"_28049":51756,"_3044":51837},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3588":458,"_30857":423,"_21381":51839,"_5":14694,"_28049":51756,"_3044":51840},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3588":459,"_30857":423,"_21381":51842,"_5":14694,"_28049":51760,"_3044":51843},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3588":460,"_30857":423,"_21381":51845,"_5":14694,"_28049":51760,"_3044":51846},[],"Locate the authz pod and Service.",{"_3588":461,"_30857":423,"_21381":51848,"_5":14694,"_28049":51760,"_3044":51849},[],"Check /health, logs and its database connection.",{"_3588":462,"_30857":423,"_21381":51851,"_5":14694,"_28049":51760,"_3044":51852},[],"Verify the DNS and port configured in externalAuthorization.",{"_3588":463,"_30857":423,"_21381":51854,"_5":14694,"_28049":51760,"_3044":51855},[],"Check the check route is /v1/ext\\_authz/check.",{"_3588":464,"_30857":423,"_21381":51857,"_5":14694,"_28049":51760,"_3044":51858},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3588":465,"_30857":423,"_21381":51860,"_5":14694,"_28049":51764,"_3044":51861},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3588":466,"_30857":423,"_21381":51863,"_5":14694,"_28049":51768,"_3044":51864},[],"Review kubectl describe pod first. Common causes are:",{"_3588":467,"_30857":423,"_21381":51866,"_5":14694,"_28049":51768,"_3044":51867},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3588":468,"_30857":423,"_21381":51869,"_5":14694,"_28049":51768,"_3044":51870},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3588":469,"_30857":423,"_21381":51872,"_5":14694,"_28049":51768,"_3044":51873},[],"unbound persistent volume;",{"_3588":470,"_30857":423,"_21381":51875,"_5":14694,"_28049":51768,"_3044":51876},[],"inaccessible image or incorrect pull policy;",{"_3588":471,"_30857":423,"_21381":51878,"_5":14694,"_28049":51768,"_3044":51879},[],"invalid cryptographic engine configuration;",{"_3588":472,"_30857":423,"_21381":51881,"_5":14694,"_28049":51768,"_3044":51882},[],"CPU or memory limits set too low;",{"_3588":473,"_30857":423,"_21381":51884,"_5":14694,"_28049":51768,"_3044":51885},[],"an incomplete prior migration.",{"_3588":474,"_30857":423,"_21381":51887,"_5":14694,"_28049":51768,"_3044":51888},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3588":475,"_30857":423,"_21381":51890,"_5":14694,"_28049":51768,"_3044":51891},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3588":476,"_30857":423,"_21381":51893,"_5":14694,"_28049":51768,"_3044":51894},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3588":477,"_30857":423,"_21381":51896,"_5":14694,"_28049":51772,"_3044":51897},[],"Domain and audit events depend on the bus publisher:",{"_3588":478,"_30857":423,"_21381":51899,"_5":14694,"_28049":51772,"_3044":51900},[],"verify it is enabled in the emitting service;",{"_3588":479,"_30857":423,"_21381":51902,"_5":14694,"_28049":51772,"_3044":51903},[],"check AMQP connectivity and credentials;",{"_3588":480,"_30857":423,"_21381":51905,"_5":14694,"_28049":51772,"_3044":51906},[],"review exchange, routing key, queues and consumers;",{"_3588":481,"_30857":423,"_21381":51908,"_5":14694,"_28049":51772,"_3044":51909},[],"inspect dead-letter queues;",{"_3588":482,"_30857":423,"_21381":51911,"_5":14694,"_28049":51772,"_3044":51912},[],"alert on orphan durable queues and backlog growth.",{"_3588":483,"_30857":423,"_21381":51914,"_5":14694,"_28049":51772,"_3044":51915},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3588":484,"_30857":423,"_21381":51917,"_5":14694,"_28049":51772,"_3044":51918},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3588":485,"_30857":423,"_21381":51920,"_5":14694,"_28049":51772,"_3044":51921},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3588":486,"_30857":423,"_21381":51923,"_5":14694,"_28049":51772,"_3044":51924},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3588":487,"_30857":423,"_21381":51926,"_5":14694,"_28049":51772,"_3044":51927},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3588":488,"_30857":423,"_21381":51929,"_5":14694,"_28049":51772,"_3044":51930},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3588":489,"_30857":423,"_21381":51932,"_5":14694,"_28049":51772,"_3044":51933},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3588":490,"_30857":423,"_21381":51935,"_5":14694,"_28049":51776,"_3044":51936},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3588":491,"_30857":423,"_21381":51938,"_5":14694,"_28049":51776,"_3044":51939},[],"Before closing an incident, record:",{"_3588":492,"_30857":423,"_21381":51941,"_5":14694,"_28049":51776,"_3044":51942},[],"the confirmed cause;",{"_3588":493,"_30857":423,"_21381":51944,"_5":14694,"_28049":51776,"_3044":51945},[],"the time scope and affected resources;",{"_3588":494,"_30857":423,"_21381":51947,"_5":14694,"_28049":51776,"_3044":51948},[],"the commands or queries used;",{"_3588":495,"_30857":423,"_21381":51950,"_5":14694,"_28049":51776,"_3044":51951},[],"the applied change and how to revert it;",{"_3588":496,"_30857":423,"_21381":51953,"_5":14694,"_28049":51776,"_3044":51954},[],"validation from a consumer;",{"_3588":497,"_30857":423,"_21381":51956,"_5":14694,"_28049":51776,"_3044":51957},[],"the preventive action and its owner.",{"_3588":498,"_30857":498,"_5":15054,"_3044":51959,"_31216":51960,"_21381":51964,"_28049":498},"Data model",[50449,51961,51962,51963],"Platform","Administration","Access control",[],{"_3588":499,"_30857":498,"_21381":51966,"_5":14694,"_28049":498,"_3044":51967},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3588":500,"_30857":498,"_5":31213,"_21381":51969,"_28049":51970,"_3044":51971},[],"/docs/pr-preview/pr-70/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3588":501,"_30857":498,"_5":31213,"_21381":51973,"_28049":51974,"_3044":51975},[],"/docs/pr-preview/pr-70/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3588":502,"_30857":498,"_21381":51977,"_5":14694,"_28049":498,"_3044":51978},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3588":503,"_30857":498,"_21381":51980,"_5":14694,"_28049":51970,"_3044":51981},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3588":504,"_30857":498,"_21381":51983,"_5":14694,"_28049":51970,"_3044":51984},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3588":505,"_30857":498,"_21381":51986,"_5":14694,"_28049":51970,"_3044":51987},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3588":506,"_30857":498,"_21381":51989,"_5":14694,"_28049":51974,"_3044":51990},[],"Entity (`schema_name.entity_type`)",{"_3588":507,"_30857":498,"_21381":51992,"_5":14694,"_28049":51974,"_3044":51993},[],"Table (`table_name`)",{"_3588":508,"_30857":498,"_21381":51995,"_5":14694,"_28049":51974,"_3044":51996},[],"Key (`primary_key`)",{"_3588":509,"_30857":498,"_21381":51998,"_5":14694,"_28049":51974,"_3044":51999},[],"`alerts.event`",{"_3588":510,"_30857":498,"_21381":52001,"_5":14694,"_28049":51974,"_3044":52002},[],"`events`",{"_3588":511,"_30857":498,"_21381":52004,"_5":14694,"_28049":51974,"_3044":52005},[],"`event_type`",{"_3588":512,"_30857":498,"_21381":52007,"_5":14694,"_28049":51974,"_3044":52008},[],"`alerts.subscription`",{"_3588":513,"_30857":498,"_21381":52010,"_5":14694,"_28049":51974,"_3044":52011},[],"`subscriptions`",{"_3588":514,"_30857":498,"_21381":52013,"_5":14694,"_28049":51974,"_3044":52014},[],"`id`",{"_3588":515,"_30857":498,"_21381":52016,"_5":14694,"_28049":51974,"_3044":52017},[],"`ca.ca_certificate`",{"_3588":516,"_30857":498,"_21381":52019,"_5":14694,"_28049":51974,"_3044":52020},[],"`ca_certificates`",{"_3588":517,"_30857":498,"_21381":52022,"_5":14694,"_28049":51974,"_3044":52014},[],{"_3588":518,"_30857":498,"_21381":52024,"_5":14694,"_28049":51974,"_3044":52025},[],"`ca.certificate`",{"_3588":519,"_30857":498,"_21381":52027,"_5":14694,"_28049":51974,"_3044":52028},[],"`certificates`",{"_3588":520,"_30857":498,"_21381":52030,"_5":14694,"_28049":51974,"_3044":52031},[],"`serial_number`",{"_3588":521,"_30857":498,"_21381":52033,"_5":14694,"_28049":51974,"_3044":52034},[],"`ca.issuance_profile`",{"_3588":522,"_30857":498,"_21381":52036,"_5":14694,"_28049":51974,"_3044":52037},[],"`issuance_profiles`",{"_3588":523,"_30857":498,"_21381":52039,"_5":14694,"_28049":51974,"_3044":52014},[],{"_3588":524,"_30857":498,"_21381":52041,"_5":14694,"_28049":51974,"_3044":52042},[],"`devicemanager.device_group`",{"_3588":525,"_30857":498,"_21381":52044,"_5":14694,"_28049":51974,"_3044":52045},[],"`device_groups`",{"_3588":526,"_30857":498,"_21381":52047,"_5":14694,"_28049":51974,"_3044":52014},[],{"_3588":527,"_30857":498,"_21381":52049,"_5":14694,"_28049":51974,"_3044":52050},[],"`devicemanager.device`",{"_3588":528,"_30857":498,"_21381":52052,"_5":14694,"_28049":51974,"_3044":52053},[],"`devices`",{"_3588":529,"_30857":498,"_21381":52055,"_5":14694,"_28049":51974,"_3044":52014},[],{"_3588":530,"_30857":498,"_21381":52057,"_5":14694,"_28049":51974,"_3044":52058},[],"`dmsmanager.dms`",{"_3588":531,"_30857":498,"_21381":52060,"_5":14694,"_28049":51974,"_3044":52061},[],"`dms`",{"_3588":532,"_30857":498,"_21381":52063,"_5":14694,"_28049":51974,"_3044":52014},[],{"_3588":533,"_30857":498,"_21381":52065,"_5":14694,"_28049":51974,"_3044":52066},[],"`kms.kms_key`",{"_3588":534,"_30857":498,"_21381":52068,"_5":14694,"_28049":51974,"_3044":52069},[],"`kms_keys`",{"_3588":535,"_30857":498,"_21381":52071,"_5":14694,"_28049":51974,"_3044":52072},[],"`key_id`, `engine_id`",{"_3588":536,"_30857":498,"_21381":52074,"_5":14694,"_28049":51974,"_3044":52075},[],"`va.crl_settings`",{"_3588":537,"_30857":498,"_21381":52077,"_5":14694,"_28049":51974,"_3044":52078},[],"`crl_settings`",{"_3588":538,"_30857":498,"_21381":52080,"_5":14694,"_28049":51974,"_3044":52081},[],"`ca_id`",{"_3588":539,"_30857":498,"_21381":52083,"_5":14694,"_28049":51974,"_3044":52084},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3588":540,"_30857":498,"_21381":52086,"_5":14694,"_28049":51974,"_3044":52087},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3588":541,"_30857":498,"_21381":52089,"_5":14694,"_28049":51974,"_3044":52090},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3588":542,"_30857":542,"_5":15054,"_3044":52092,"_31216":52093,"_21381":52094,"_28049":542},"Access control overview",[50449,51961,51962,51963],[],{"_3588":543,"_30857":542,"_21381":52096,"_5":14694,"_28049":542,"_3044":52097},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3588":544,"_30857":542,"_5":31213,"_21381":52099,"_28049":52100,"_3044":52101},[],"/docs/pr-preview/pr-70/platform/administration/access-control#essential-concepts","Essential concepts",{"_3588":545,"_30857":542,"_5":31213,"_21381":52103,"_28049":52104,"_3044":52105},[],"/docs/pr-preview/pr-70/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3588":546,"_30857":542,"_5":31213,"_21381":52107,"_28049":52108,"_3044":52109},[],"/docs/pr-preview/pr-70/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3588":547,"_30857":542,"_5":31213,"_21381":52111,"_28049":52112,"_3044":52113},[],"/docs/pr-preview/pr-70/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3588":548,"_30857":542,"_5":31213,"_21381":52115,"_28049":52116,"_3044":52117},[],"/docs/pr-preview/pr-70/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3588":549,"_30857":542,"_5":31213,"_21381":52119,"_28049":52120,"_3044":52121},[],"/docs/pr-preview/pr-70/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3588":550,"_30857":542,"_5":31213,"_21381":52123,"_28049":52124,"_3044":52125},[],"/docs/pr-preview/pr-70/platform/administration/access-control#oidc-principals","OIDC principals",{"_3588":551,"_30857":542,"_5":31213,"_21381":52127,"_28049":52128,"_3044":52129},[],"/docs/pr-preview/pr-70/platform/administration/access-control#x509-principals","X.509 principals",{"_3588":552,"_30857":542,"_5":31213,"_21381":52131,"_28049":52132,"_3044":52133},[],"/docs/pr-preview/pr-70/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3588":553,"_30857":542,"_5":31213,"_21381":52135,"_28049":52136,"_3044":52137},[],"/docs/pr-preview/pr-70/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3588":554,"_30857":542,"_5":31213,"_21381":52139,"_28049":52140,"_3044":52141},[],"/docs/pr-preview/pr-70/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3588":555,"_30857":542,"_5":31213,"_21381":52143,"_28049":52144,"_3044":52145},[],"/docs/pr-preview/pr-70/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3588":556,"_30857":542,"_5":31213,"_21381":52147,"_28049":52148,"_3044":52149},[],"/docs/pr-preview/pr-70/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3588":557,"_30857":542,"_5":31213,"_21381":52151,"_28049":52152,"_3044":52153},[],"/docs/pr-preview/pr-70/platform/administration/access-control#http-rules","HTTP rules",{"_3588":558,"_30857":542,"_5":31213,"_21381":52155,"_28049":52156,"_3044":52157},[],"/docs/pr-preview/pr-70/platform/administration/access-control#included-policies","Included policies",{"_3588":559,"_30857":542,"_5":31213,"_21381":52159,"_28049":52160,"_3044":51099},[],"/docs/pr-preview/pr-70/platform/administration/access-control#provision-the-first-administrator",{"_3588":560,"_30857":542,"_5":31213,"_21381":52162,"_28049":52163,"_3044":52164},[],"/docs/pr-preview/pr-70/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3588":561,"_30857":542,"_5":31213,"_21381":52166,"_28049":52167,"_3044":52168},[],"/docs/pr-preview/pr-70/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3588":562,"_30857":542,"_5":31213,"_21381":52170,"_28049":52171,"_3044":52172},[],"/docs/pr-preview/pr-70/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3588":563,"_30857":542,"_5":31213,"_21381":52174,"_28049":52175,"_3044":52176},[],"/docs/pr-preview/pr-70/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3588":564,"_30857":542,"_5":31213,"_21381":52178,"_28049":52179,"_3044":52180},[],"/docs/pr-preview/pr-70/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3588":565,"_30857":542,"_5":31213,"_21381":52182,"_28049":52183,"_3044":52184},[],"/docs/pr-preview/pr-70/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3588":566,"_30857":542,"_5":31213,"_21381":52186,"_28049":52187,"_3044":52188},[],"/docs/pr-preview/pr-70/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3588":567,"_30857":542,"_5":31213,"_21381":52190,"_28049":52191,"_3044":52192},[],"/docs/pr-preview/pr-70/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3588":568,"_30857":542,"_5":31213,"_21381":52194,"_28049":52195,"_3044":52196},[],"/docs/pr-preview/pr-70/platform/administration/access-control#operational-checklist","Operational checklist",{"_3588":569,"_30857":542,"_5":31213,"_21381":52198,"_28049":52199,"_3044":52200},[],"/docs/pr-preview/pr-70/platform/administration/access-control#diagnostics","Diagnostics",{"_3588":570,"_30857":542,"_5":31213,"_21381":52202,"_28049":52203,"_3044":52204},[],"/docs/pr-preview/pr-70/platform/administration/access-control#the-response-is-401","The response is 401",{"_3588":571,"_30857":542,"_5":31213,"_21381":52206,"_28049":52207,"_3044":52208},[],"/docs/pr-preview/pr-70/platform/administration/access-control#the-response-is-403","The response is 403",{"_3588":572,"_30857":542,"_5":31213,"_21381":52210,"_28049":52211,"_3044":52212},[],"/docs/pr-preview/pr-70/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3588":573,"_30857":542,"_5":31213,"_21381":52214,"_28049":52215,"_3044":52216},[],"/docs/pr-preview/pr-70/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3588":574,"_30857":542,"_5":31213,"_21381":52218,"_28049":52219,"_3044":52220},[],"/docs/pr-preview/pr-70/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3588":575,"_30857":542,"_21381":52222,"_5":14694,"_28049":542,"_3044":52223},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3588":576,"_30857":542,"_21381":52225,"_5":14694,"_28049":542,"_3044":52226},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3588":577,"_30857":542,"_21381":52228,"_5":14694,"_28049":542,"_3044":52229},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3588":578,"_30857":542,"_21381":52231,"_5":14694,"_28049":52100,"_3044":52232},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3588":579,"_30857":542,"_21381":52234,"_5":14694,"_28049":52100,"_3044":52235},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3588":580,"_30857":542,"_21381":52237,"_5":14694,"_28049":52100,"_3044":52238},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3588":581,"_30857":542,"_21381":52240,"_5":14694,"_28049":52100,"_3044":52241},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3588":582,"_30857":542,"_21381":52243,"_5":14694,"_28049":52100,"_3044":52244},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3588":583,"_30857":542,"_21381":52246,"_5":14694,"_28049":52100,"_3044":52247},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3588":584,"_30857":542,"_21381":52249,"_5":14694,"_28049":52104,"_3044":52250},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3588":585,"_30857":542,"_21381":52252,"_5":14694,"_28049":52104,"_3044":52253},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3588":586,"_30857":542,"_21381":52255,"_5":14694,"_28049":52108,"_3044":52256},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3588":587,"_30857":542,"_21381":52258,"_5":14694,"_28049":52108,"_3044":52259},[],"The decision is made **before forwarding the request to the service**:",{"_3588":588,"_30857":542,"_21381":52261,"_5":14694,"_28049":52108,"_3044":52262},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3588":589,"_30857":542,"_21381":52264,"_5":14694,"_28049":52108,"_3044":52265},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3588":590,"_30857":542,"_21381":52267,"_5":14694,"_28049":52108,"_3044":52268},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3588":591,"_30857":542,"_21381":52270,"_5":14694,"_28049":52108,"_3044":52271},[],"It separately loads the policies granted to each principal.",{"_3588":592,"_30857":542,"_21381":52273,"_5":14694,"_28049":52108,"_3044":52274},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3588":593,"_30857":542,"_21381":52276,"_5":14694,"_28049":52108,"_3044":52277},[],"`authz` looks for an HTTP rule granting that action.",{"_3588":594,"_30857":542,"_21381":52279,"_5":14694,"_28049":52108,"_3044":52280},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3588":595,"_30857":542,"_21381":52282,"_5":14694,"_28049":52108,"_3044":52283},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3588":596,"_30857":542,"_21381":52285,"_5":14694,"_28049":52108,"_3044":52286},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3588":597,"_30857":542,"_21381":52288,"_5":14694,"_28049":52108,"_3044":52289},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3588":598,"_30857":542,"_21381":52291,"_5":14694,"_28049":52112,"_3044":52292},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3588":599,"_30857":542,"_21381":52294,"_5":14694,"_28049":52112,"_3044":52295},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3588":600,"_30857":542,"_21381":52297,"_5":14694,"_28049":52112,"_3044":52298},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3588":601,"_30857":542,"_21381":52300,"_5":14694,"_28049":52112,"_3044":52301},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3588":602,"_30857":542,"_21381":52303,"_5":14694,"_28049":52112,"_3044":52304},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3588":603,"_30857":542,"_21381":52306,"_5":14694,"_28049":52112,"_3044":52307},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3588":604,"_30857":542,"_21381":52309,"_5":14694,"_28049":52112,"_3044":52310},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3588":605,"_30857":542,"_21381":52312,"_5":14694,"_28049":52112,"_3044":52313},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3588":606,"_30857":542,"_21381":52315,"_5":14694,"_28049":52116,"_3044":52316},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3588":607,"_30857":542,"_21381":52318,"_5":14694,"_28049":52116,"_3044":52319},[],"The decision is made with the domain operation context:",{"_3588":608,"_30857":542,"_21381":52321,"_5":14694,"_28049":52116,"_3044":52322},[],"The middleware extracts the credential and resolves the matching principals.",{"_3588":609,"_30857":542,"_21381":52324,"_5":14694,"_28049":52116,"_3044":52325},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3588":610,"_30857":542,"_21381":52327,"_5":14694,"_28049":52116,"_3044":52328},[],"`authz` gathers the entity rules of the granted policies.",{"_3588":611,"_30857":542,"_21381":52330,"_5":14694,"_28049":52116,"_3044":52331},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3588":612,"_30857":542,"_21381":52333,"_5":14694,"_28049":52116,"_3044":52334},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3588":613,"_30857":542,"_21381":52336,"_5":14694,"_28049":52116,"_3044":52337},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3588":614,"_30857":542,"_21381":52339,"_5":14694,"_28049":52116,"_3044":52340},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3588":615,"_30857":542,"_21381":52342,"_5":14694,"_28049":52116,"_3044":52343},[],"Actions fall into two groups:",{"_3588":616,"_30857":542,"_21381":52345,"_5":14694,"_28049":52116,"_3044":52346},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3588":617,"_30857":542,"_21381":52348,"_5":14694,"_28049":52116,"_3044":52349},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3588":618,"_30857":542,"_21381":52351,"_5":14694,"_28049":52116,"_3044":52352},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3588":619,"_30857":542,"_21381":52354,"_5":14694,"_28049":52120,"_3044":52355},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3588":620,"_30857":542,"_21381":52357,"_5":14694,"_28049":52120,"_3044":52358},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3588":621,"_30857":542,"_21381":52360,"_5":14694,"_28049":52120,"_3044":52361},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3588":622,"_30857":542,"_21381":52363,"_5":14694,"_28049":52124,"_3044":52364},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3588":623,"_30857":542,"_21381":52366,"_5":14694,"_28049":52124,"_3044":52367},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3588":624,"_30857":542,"_21381":52369,"_5":14694,"_28049":52124,"_3044":52370},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3588":625,"_30857":542,"_21381":52372,"_5":14694,"_28049":52124,"_3044":52373},[],"The implemented operators are:",{"_3588":626,"_30857":542,"_21381":52375,"_5":14694,"_28049":52124,"_3044":52376},[],"`equals`, for exact equality;",{"_3588":627,"_30857":542,"_21381":52378,"_5":14694,"_28049":52124,"_3044":52379},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3588":628,"_30857":542,"_21381":52381,"_5":14694,"_28049":52124,"_3044":52382},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3588":629,"_30857":542,"_21381":52384,"_5":14694,"_28049":52124,"_3044":52385},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3588":630,"_30857":542,"_21381":52387,"_5":14694,"_28049":52128,"_3044":52388},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3588":631,"_30857":542,"_21381":52390,"_5":14694,"_28049":52128,"_3044":52391},[],"The available modes are:",{"_3588":632,"_30857":542,"_21381":52393,"_5":14694,"_28049":52128,"_3044":52394},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3588":633,"_30857":542,"_21381":52396,"_5":14694,"_28049":52128,"_3044":52397},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3588":634,"_30857":542,"_21381":52399,"_5":14694,"_28049":52128,"_3044":52400},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3588":635,"_30857":542,"_21381":52402,"_5":14694,"_28049":52128,"_3044":52403},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3588":636,"_30857":542,"_21381":52405,"_5":14694,"_28049":52128,"_3044":52406},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3588":637,"_30857":542,"_21381":52408,"_5":14694,"_28049":52128,"_3044":52409},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3588":638,"_30857":542,"_21381":52411,"_5":14694,"_28049":52132,"_3044":52412},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3588":639,"_30857":542,"_21381":52414,"_5":14694,"_28049":52132,"_3044":52415},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3588":640,"_30857":542,"_21381":52417,"_5":14694,"_28049":52132,"_3044":52418},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3588":641,"_30857":542,"_21381":52420,"_5":14694,"_28049":52132,"_3044":52421},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3588":642,"_30857":542,"_21381":52423,"_5":14694,"_28049":52140,"_3044":52424},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3588":643,"_30857":542,"_21381":52426,"_5":14694,"_28049":52140,"_3044":52427},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3588":644,"_30857":542,"_21381":52429,"_5":14694,"_28049":52144,"_3044":52430},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3588":645,"_30857":542,"_21381":52432,"_5":14694,"_28049":52144,"_3044":52433},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3588":646,"_30857":542,"_21381":52435,"_5":14694,"_28049":52144,"_3044":52436},[],"The data model shows how the resources used in entity rules are connected.",{"_3588":647,"_30857":542,"_21381":52438,"_5":14694,"_28049":52144,"_3044":52439},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3588":648,"_30857":542,"_21381":52441,"_5":14694,"_28049":52144,"_3044":52442},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3588":649,"_30857":542,"_21381":52444,"_5":14694,"_28049":52148,"_3044":52445},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3588":650,"_30857":542,"_21381":52447,"_5":14694,"_28049":52148,"_3044":52448},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3588":651,"_30857":542,"_21381":52450,"_5":14694,"_28049":52148,"_3044":52451},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3588":652,"_30857":542,"_21381":52453,"_5":14694,"_28049":52152,"_3044":52454},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3588":653,"_30857":542,"_21381":52456,"_5":14694,"_28049":52152,"_3044":52457},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3588":654,"_30857":542,"_21381":52459,"_5":14694,"_28049":52152,"_3044":52460},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3588":655,"_30857":542,"_21381":52462,"_5":14694,"_28049":52152,"_3044":52463},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3588":656,"_30857":542,"_21381":52465,"_5":14694,"_28049":52152,"_3044":52466},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3588":657,"_30857":542,"_21381":52468,"_5":14694,"_28049":52152,"_3044":52469},[],"Note that:",{"_3588":658,"_30857":542,"_21381":52471,"_5":14694,"_28049":52152,"_3044":52472},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3588":659,"_30857":542,"_21381":52474,"_5":14694,"_28049":52152,"_3044":52475},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3588":660,"_30857":542,"_21381":52477,"_5":14694,"_28049":52152,"_3044":52478},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3588":661,"_30857":542,"_21381":52480,"_5":14694,"_28049":52156,"_3044":52481},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3588":662,"_30857":542,"_21381":52483,"_5":14694,"_28049":52156,"_3044":52484},[],"full and read-only access to certificates and authorities;",{"_3588":663,"_30857":542,"_21381":52486,"_5":14694,"_28049":52156,"_3044":52487},[],"full and read-only access to the KMS;",{"_3588":664,"_30857":542,"_21381":52489,"_5":14694,"_28049":52156,"_3044":52490},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3588":665,"_30857":542,"_21381":52492,"_5":14694,"_28049":52156,"_3044":52493},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3588":666,"_30857":542,"_21381":52495,"_5":14694,"_28049":52156,"_3044":52496},[],"console access;",{"_3588":667,"_30857":542,"_21381":52498,"_5":14694,"_28049":52156,"_3044":52499},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3588":668,"_30857":542,"_21381":52501,"_5":14694,"_28049":52156,"_3044":52502},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3588":669,"_30857":542,"_21381":52504,"_5":14694,"_28049":52156,"_3044":52505},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3588":670,"_30857":542,"_21381":52507,"_5":14694,"_28049":52160,"_3044":52508},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3588":671,"_30857":542,"_21381":52510,"_5":14694,"_28049":52160,"_3044":52511},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3588":672,"_30857":542,"_21381":52513,"_5":14694,"_28049":52160,"_3044":52514},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3588":673,"_30857":542,"_21381":52516,"_5":14694,"_28049":52163,"_3044":52517},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3588":674,"_30857":542,"_21381":52519,"_5":14694,"_28049":52167,"_3044":52520},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3588":675,"_30857":542,"_21381":52522,"_5":14694,"_28049":52167,"_3044":52523},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3588":676,"_30857":542,"_21381":52525,"_5":14694,"_28049":52171,"_3044":52526},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3588":677,"_30857":542,"_21381":52528,"_5":14694,"_28049":52175,"_3044":52529},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3588":678,"_30857":542,"_21381":52531,"_5":14694,"_28049":52179,"_3044":52532},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3588":679,"_30857":542,"_21381":52534,"_5":14694,"_28049":52183,"_3044":52535},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3588":680,"_30857":542,"_21381":52537,"_5":14694,"_28049":52183,"_3044":52538},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3588":681,"_30857":542,"_21381":52540,"_5":14694,"_28049":52187,"_3044":52541},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3588":682,"_30857":542,"_21381":52543,"_5":14694,"_28049":52187,"_3044":52544},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3588":683,"_30857":542,"_21381":52546,"_5":14694,"_28049":52187,"_3044":52547},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3588":684,"_30857":542,"_21381":52549,"_5":14694,"_28049":52187,"_3044":52550},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3588":685,"_30857":542,"_21381":52552,"_5":14694,"_28049":52187,"_3044":52553},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3588":686,"_30857":542,"_21381":52555,"_5":14694,"_28049":52187,"_3044":52556},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3588":687,"_30857":542,"_21381":52558,"_5":14694,"_28049":52187,"_3044":52559},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3588":688,"_30857":542,"_21381":52561,"_5":14694,"_28049":52187,"_3044":52562},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3588":689,"_30857":542,"_21381":52564,"_5":14694,"_28049":52191,"_3044":52565},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3588":690,"_30857":542,"_21381":52567,"_5":14694,"_28049":52191,"_3044":52568},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3588":691,"_30857":542,"_21381":52570,"_5":14694,"_28049":52191,"_3044":52571},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3588":692,"_30857":542,"_21381":52573,"_5":14694,"_28049":52195,"_3044":52574},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3588":693,"_30857":542,"_21381":52576,"_5":14694,"_28049":52195,"_3044":52577},[],"Use groups or stable roles for people and independent identities for automations.",{"_3588":694,"_30857":542,"_21381":52579,"_5":14694,"_28049":52195,"_3044":52580},[],"Keep at least two recovery administrators and test their access periodically.",{"_3588":695,"_30857":542,"_21381":52582,"_5":14694,"_28049":52195,"_3044":52583},[],"Review active principals, their matches and their grants after IdP changes.",{"_3588":696,"_30857":542,"_21381":52585,"_5":14694,"_28049":52195,"_3044":52586},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3588":697,"_30857":542,"_21381":52588,"_5":14694,"_28049":52195,"_3044":52589},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3588":698,"_30857":542,"_21381":52591,"_5":14694,"_28049":52195,"_3044":52592},[],"Always test one allowed and one denied operation for each role.",{"_3588":699,"_30857":542,"_21381":52594,"_5":14694,"_28049":52195,"_3044":52595},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3588":700,"_30857":542,"_21381":52597,"_5":14694,"_28049":52203,"_3044":52598},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3588":701,"_30857":542,"_21381":52600,"_5":14694,"_28049":52207,"_3044":52601},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3588":702,"_30857":542,"_21381":52603,"_5":14694,"_28049":52207,"_3044":52604},[],"that an active principal of the correct type exists;",{"_3588":703,"_30857":542,"_21381":52606,"_5":14694,"_28049":52207,"_3044":52607},[],"that the claim paths and values match the real token exactly;",{"_3588":704,"_30857":542,"_21381":52609,"_5":14694,"_28049":52207,"_3044":52610},[],"that all of the principal's conditions hold;",{"_3588":705,"_30857":542,"_21381":52612,"_5":14694,"_28049":52207,"_3044":52613},[],"that the principal has the expected policy granted;",{"_3588":706,"_30857":542,"_21381":52615,"_5":14694,"_28049":52207,"_3044":52616},[],"that the policy includes the action and the requested resource type or route;",{"_3588":707,"_30857":542,"_21381":52618,"_5":14694,"_28049":52207,"_3044":52619},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3588":708,"_30857":542,"_21381":52621,"_5":14694,"_28049":52207,"_3044":52622},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3588":709,"_30857":542,"_21381":52624,"_5":14694,"_28049":52207,"_3044":52625},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3588":710,"_30857":542,"_21381":52627,"_5":14694,"_28049":52211,"_3044":52628},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3588":711,"_30857":542,"_21381":52630,"_5":14694,"_28049":52215,"_3044":52631},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3588":712,"_30857":542,"_21381":52633,"_5":14694,"_28049":52219,"_3044":52634},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3588":713,"_30857":542,"_21381":52636,"_5":14694,"_28049":52219,"_3044":52637},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3588":714,"_30857":714,"_5":15054,"_3044":52639,"_31216":52640,"_21381":52641,"_28049":714},"Alerts and subscriptions",[50449,51961,51962],[],{"_3588":715,"_30857":714,"_21381":52643,"_5":14694,"_28049":714,"_3044":52644},[],"Send PKI events to people and external systems.",{"_3588":716,"_30857":714,"_5":31213,"_21381":52646,"_28049":52647,"_3044":52648},[],"/docs/pr-preview/pr-70/platform/administration/alerts#how-it-works","How it works",{"_3588":717,"_30857":714,"_5":31213,"_21381":52650,"_28049":52651,"_3044":52652},[],"/docs/pr-preview/pr-70/platform/administration/alerts#available-channels","Available channels",{"_3588":718,"_30857":714,"_5":31213,"_21381":52654,"_28049":52655,"_3044":52656},[],"/docs/pr-preview/pr-70/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3588":719,"_30857":714,"_5":31213,"_21381":52658,"_28049":52659,"_3044":52660},[],"/docs/pr-preview/pr-70/platform/administration/alerts#choose-the-event","Choose the event",{"_3588":720,"_30857":714,"_5":31213,"_21381":52662,"_28049":52663,"_3044":52664},[],"/docs/pr-preview/pr-70/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3588":721,"_30857":714,"_5":31213,"_21381":52666,"_28049":52667,"_3044":52668},[],"/docs/pr-preview/pr-70/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3588":722,"_30857":714,"_5":31213,"_21381":52670,"_28049":52671,"_3044":52672},[],"/docs/pr-preview/pr-70/platform/administration/alerts#review-and-activate","Review and activate",{"_3588":723,"_30857":714,"_5":31213,"_21381":52674,"_28049":52675,"_3044":52676},[],"/docs/pr-preview/pr-70/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3588":724,"_30857":714,"_5":31213,"_21381":52678,"_28049":52679,"_3044":52680},[],"/docs/pr-preview/pr-70/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3588":725,"_30857":714,"_5":31213,"_21381":52682,"_28049":52683,"_3044":52684},[],"/docs/pr-preview/pr-70/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3588":726,"_30857":714,"_5":31213,"_21381":52686,"_28049":52687,"_3044":52688},[],"/docs/pr-preview/pr-70/platform/administration/alerts#event-families","Event families",{"_3588":727,"_30857":714,"_21381":52690,"_5":14694,"_28049":714,"_3044":52691},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3588":728,"_30857":714,"_21381":52693,"_5":14694,"_28049":52647,"_3044":52694},[],"A service publishes a domain event.",{"_3588":729,"_30857":714,"_21381":52696,"_5":14694,"_28049":52647,"_3044":52697},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3588":730,"_30857":714,"_21381":52699,"_5":14694,"_28049":52647,"_3044":52700},[],"Each subscription's filter decides whether it should be notified.",{"_3588":731,"_30857":714,"_21381":52702,"_5":14694,"_28049":52647,"_3044":52703},[],"Lamassu delivers the event to the configured channel.",{"_3588":732,"_30857":714,"_21381":52705,"_5":14694,"_28049":52647,"_3044":52706},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3588":733,"_30857":714,"_21381":52708,"_5":14694,"_28049":52651,"_3044":52709},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3588":734,"_30857":714,"_21381":52711,"_5":14694,"_28049":52651,"_3044":52712},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3588":735,"_30857":714,"_21381":52714,"_5":14694,"_28049":52651,"_3044":52715},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3588":736,"_30857":714,"_21381":52717,"_5":14694,"_28049":52651,"_3044":52718},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3588":737,"_30857":714,"_21381":52720,"_5":14694,"_28049":52651,"_3044":52721},[],"`apikey_options` requires `header` and `key`.",{"_3588":738,"_30857":714,"_21381":52723,"_5":14694,"_28049":52651,"_3044":52724},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3588":739,"_30857":714,"_21381":52726,"_5":14694,"_28049":52651,"_3044":52727},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3588":740,"_30857":714,"_21381":52729,"_5":14694,"_28049":52651,"_3044":52730},[],"The alerts API reference documents the full `http_client` schema.",{"_3588":741,"_30857":714,"_21381":52732,"_5":14694,"_28049":52659,"_3044":52733},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3588":742,"_30857":714,"_21381":52735,"_5":14694,"_28049":52663,"_3044":52736},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3588":743,"_30857":714,"_21381":52738,"_5":14694,"_28049":52667,"_3044":52739},[],"Add a filter if you don't want to receive every instance of the event.",{"_3588":744,"_30857":714,"_21381":52741,"_5":14694,"_28049":52667,"_3044":52742},[],"**None** notifies all instances of the event.",{"_3588":745,"_30857":714,"_21381":52744,"_5":14694,"_28049":52667,"_3044":52745},[],"**JSON Path** evaluates one or more specific fields.",{"_3588":746,"_30857":714,"_21381":52747,"_5":14694,"_28049":52667,"_3044":52748},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3588":747,"_30857":714,"_21381":52750,"_5":14694,"_28049":52667,"_3044":52751},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3588":748,"_30857":714,"_21381":52753,"_5":14694,"_28049":52667,"_3044":52754},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3588":749,"_30857":714,"_21381":52756,"_5":14694,"_28049":52667,"_3044":52757},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3588":750,"_30857":714,"_21381":52759,"_5":14694,"_28049":52671,"_3044":52760},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3588":751,"_30857":714,"_21381":52762,"_5":14694,"_28049":52675,"_3044":52763},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3588":752,"_30857":714,"_21381":52765,"_5":14694,"_28049":52675,"_3044":52766},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3588":753,"_30857":714,"_21381":52768,"_5":14694,"_28049":52675,"_3044":52769},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3588":754,"_30857":714,"_21381":52771,"_5":14694,"_28049":52675,"_3044":52772},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3588":755,"_30857":714,"_21381":52774,"_5":14694,"_28049":52675,"_3044":52775},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3588":756,"_30857":714,"_21381":52777,"_5":14694,"_28049":52675,"_3044":52778},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3588":757,"_30857":714,"_21381":52780,"_5":14694,"_28049":52675,"_3044":52781},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3588":758,"_30857":714,"_21381":52783,"_5":14694,"_28049":52675,"_3044":52784},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3588":759,"_30857":714,"_21381":52786,"_5":14694,"_28049":52679,"_3044":52787},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3588":760,"_30857":714,"_21381":52789,"_5":14694,"_28049":52679,"_3044":52790},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3588":761,"_30857":714,"_21381":52792,"_5":14694,"_28049":52679,"_3044":52793},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3588":762,"_30857":714,"_21381":52795,"_5":14694,"_28049":52679,"_3044":52796},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3588":763,"_30857":714,"_21381":52798,"_5":14694,"_28049":52679,"_3044":52799},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3588":764,"_30857":714,"_21381":52801,"_5":14694,"_28049":52679,"_3044":52802},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3588":765,"_30857":714,"_21381":52804,"_5":14694,"_28049":52679,"_3044":52805},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3588":766,"_30857":714,"_21381":52807,"_5":14694,"_28049":52679,"_3044":52808},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3588":767,"_30857":714,"_21381":52810,"_5":14694,"_28049":52683,"_3044":52811},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3588":768,"_30857":714,"_21381":52813,"_5":14694,"_28049":52683,"_3044":52814},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3588":769,"_30857":714,"_21381":52816,"_5":14694,"_28049":52687,"_3044":52817},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3588":770,"_30857":714,"_21381":52819,"_5":14694,"_28049":52687,"_3044":52820},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3588":771,"_30857":714,"_21381":52822,"_5":14694,"_28049":52687,"_3044":52823},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3588":772,"_30857":714,"_21381":52825,"_5":14694,"_28049":52687,"_3044":52826},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3588":773,"_30857":714,"_21381":52828,"_5":14694,"_28049":52687,"_3044":52829},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3588":774,"_30857":714,"_21381":52831,"_5":14694,"_28049":52687,"_3044":52832},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3588":775,"_30857":714,"_21381":52834,"_5":14694,"_28049":52687,"_3044":52835},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3588":776,"_30857":714,"_21381":52837,"_5":14694,"_28049":52687,"_3044":52838},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3588":777,"_30857":714,"_21381":52840,"_5":14694,"_28049":52687,"_3044":52841},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3588":778,"_30857":714,"_21381":52843,"_5":14694,"_28049":52687,"_3044":52844},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3588":779,"_30857":779,"_5":15054,"_3044":52846,"_31216":52847,"_21381":52848,"_28049":779},"Audit logs",[50449,51961,51962],[],{"_3588":780,"_30857":779,"_21381":52850,"_5":14694,"_28049":779,"_3044":52851},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3588":781,"_30857":779,"_5":31213,"_21381":52853,"_28049":52854,"_3044":52855},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3588":782,"_30857":779,"_5":31213,"_21381":52857,"_28049":52858,"_3044":52859},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#coverage","Coverage",{"_3588":783,"_30857":779,"_5":31213,"_21381":52861,"_28049":52862,"_3044":52863},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3588":784,"_30857":779,"_5":31213,"_21381":52865,"_28049":52866,"_3044":52867},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3588":785,"_30857":779,"_5":31213,"_21381":52869,"_28049":52870,"_3044":52871},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3588":786,"_30857":779,"_5":31213,"_21381":52873,"_28049":52874,"_3044":52875},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3588":787,"_30857":779,"_5":31213,"_21381":52877,"_28049":52878,"_3044":52879},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3588":788,"_30857":779,"_5":31213,"_21381":52881,"_28049":52882,"_3044":52883},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3588":789,"_30857":779,"_5":31213,"_21381":52885,"_28049":52886,"_3044":52887},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3588":790,"_30857":779,"_5":31213,"_21381":52889,"_28049":52890,"_3044":52891},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3588":791,"_30857":779,"_5":31213,"_21381":52893,"_28049":52894,"_3044":52895},[],"/docs/pr-preview/pr-70/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3588":792,"_30857":779,"_21381":52897,"_5":14694,"_28049":779,"_3044":52898},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3588":793,"_30857":779,"_21381":52900,"_5":14694,"_28049":52854,"_3044":52901},[],"The audit body includes:",{"_3588":794,"_30857":779,"_21381":52903,"_5":14694,"_28049":52854,"_3044":52904},[],"input: data received by the operation;",{"_3588":795,"_30857":779,"_21381":52906,"_5":14694,"_28049":52854,"_3044":52907},[],"has\\_error: whether the service returned an error;",{"_3588":796,"_30857":779,"_21381":52909,"_5":14694,"_28049":52854,"_3044":52910},[],"output: produced result or error message;",{"_3588":797,"_30857":779,"_21381":52912,"_5":14694,"_28049":52854,"_3044":52913},[],"principals: identifiers of the principals that matched the request.",{"_3588":798,"_30857":779,"_21381":52915,"_5":14694,"_28049":52854,"_3044":52916},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3588":799,"_30857":779,"_21381":52918,"_5":14694,"_28049":52854,"_3044":52919},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3588":800,"_30857":779,"_21381":52921,"_5":14694,"_28049":52858,"_3044":52922},[],"The backend applies auditing to mutations of:",{"_3588":801,"_30857":779,"_21381":52924,"_5":14694,"_28049":52858,"_3044":52925},[],"authorities, certificates and issuance profiles;",{"_3588":802,"_30857":779,"_21381":52927,"_5":14694,"_28049":52858,"_3044":52928},[],"keys and KMS engines;",{"_3588":803,"_30857":779,"_21381":52930,"_5":14694,"_28049":52858,"_3044":52931},[],"devices and identities;",{"_3588":804,"_30857":779,"_21381":52933,"_5":14694,"_28049":52858,"_3044":52934},[],"DMSs and enrollment operations;",{"_3588":805,"_30857":779,"_21381":52936,"_5":14694,"_28049":52858,"_3044":52937},[],"validation functions and CRL;",{"_3588":806,"_30857":779,"_21381":52939,"_5":14694,"_28049":52858,"_3044":52940},[],"principals, policies and authorization grants.",{"_3588":807,"_30857":779,"_21381":52942,"_5":14694,"_28049":52858,"_3044":52943},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3588":808,"_30857":779,"_21381":52945,"_5":14694,"_28049":52862,"_3044":52946},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3588":809,"_30857":779,"_21381":52948,"_5":14694,"_28049":52862,"_3044":52949},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3588":810,"_30857":779,"_21381":52951,"_5":14694,"_28049":52862,"_3044":52952},[],"Design the consumer to:",{"_3588":811,"_30857":779,"_21381":52954,"_5":14694,"_28049":52862,"_3044":52955},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3588":812,"_30857":779,"_21381":52957,"_5":14694,"_28049":52862,"_3044":52958},[],"keep the complete CloudEvent unmodified;",{"_3588":813,"_30857":779,"_21381":52960,"_5":14694,"_28049":52862,"_3044":52961},[],"record the ingestion time and detect duplicates by ID;",{"_3588":814,"_30857":779,"_21381":52963,"_5":14694,"_28049":52862,"_3044":52964},[],"encrypt in transit and at rest;",{"_3588":815,"_30857":779,"_21381":52966,"_5":14694,"_28049":52862,"_3044":52967},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3588":816,"_30857":779,"_21381":52969,"_5":14694,"_28049":52862,"_3044":52970},[],"apply an explicit retention and legal hold policy;",{"_3588":817,"_30857":779,"_21381":52972,"_5":14694,"_28049":52862,"_3044":52973},[],"alert if it stops consuming or the pending queue grows.",{"_3588":818,"_30857":779,"_21381":52975,"_5":14694,"_28049":52866,"_3044":52976},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3588":819,"_30857":779,"_21381":52978,"_5":14694,"_28049":52866,"_3044":52979},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3588":820,"_30857":779,"_21381":52981,"_5":14694,"_28049":52874,"_3044":52982},[],"Start from the reported time and normalize every source to UTC.",{"_3588":821,"_30857":779,"_21381":52984,"_5":14694,"_28049":52878,"_3044":52985},[],"Filter by event type, service source and resource identifier.",{"_3588":822,"_30857":779,"_21381":52987,"_5":14694,"_28049":52882,"_3044":52988},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3588":823,"_30857":779,"_21381":52990,"_5":14694,"_28049":52886,"_3044":52991},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3588":824,"_30857":779,"_21381":52993,"_5":14694,"_28049":52890,"_3044":52994},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3588":825,"_30857":779,"_21381":52996,"_5":14694,"_28049":52894,"_3044":52997},[],"Generate a controlled mutation in a test environment and check that:",{"_3588":826,"_30857":779,"_21381":52999,"_5":14694,"_28049":52894,"_3044":53000},[],"a successful audit event appears;",{"_3588":827,"_30857":779,"_21381":53002,"_5":14694,"_28049":52894,"_3044":53003},[],"the principal matches the identity used;",{"_3588":828,"_30857":779,"_21381":53005,"_5":14694,"_28049":52894,"_3044":53006},[],"the consumer persists it exactly once;",{"_3588":829,"_30857":779,"_21381":53008,"_5":14694,"_28049":52894,"_3044":53009},[],"it can be retrieved by resource, actor and period;",{"_3588":830,"_30857":779,"_21381":53011,"_5":14694,"_28049":52894,"_3044":53012},[],"a consumer outage raises an alert.",{"_3588":831,"_30857":779,"_21381":53014,"_5":14694,"_28049":52894,"_3044":53015},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3588":832,"_30857":832,"_5":15054,"_3044":53017,"_31216":53018,"_21381":53019,"_28049":832},"Platform architecture",[50449,51961],[],{"_3588":833,"_30857":832,"_21381":53021,"_5":14694,"_28049":832,"_3044":53022},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3588":834,"_30857":832,"_5":31213,"_21381":53024,"_28049":53025,"_3044":53026},[],"/docs/pr-preview/pr-70/platform/concepts/architecture#control-plane","Control plane",{"_3588":835,"_30857":832,"_5":31213,"_21381":53028,"_28049":53029,"_3044":53030},[],"/docs/pr-preview/pr-70/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3588":836,"_30857":832,"_5":31213,"_21381":53032,"_28049":53033,"_3044":53034},[],"/docs/pr-preview/pr-70/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3588":837,"_30857":832,"_5":31213,"_21381":53036,"_28049":53037,"_3044":53038},[],"/docs/pr-preview/pr-70/platform/concepts/architecture#status-and-validation","Status and validation",{"_3588":838,"_30857":832,"_5":31213,"_21381":53040,"_28049":53041,"_3044":53042},[],"/docs/pr-preview/pr-70/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3588":839,"_30857":832,"_21381":53044,"_5":14694,"_28049":832,"_3044":53045},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3588":840,"_30857":832,"_21381":53047,"_5":14694,"_28049":832,"_3044":53048},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3588":841,"_30857":832,"_21381":53050,"_5":14694,"_28049":53025,"_3044":53051},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3588":842,"_30857":832,"_21381":53053,"_5":14694,"_28049":53029,"_3044":53054},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3588":843,"_30857":832,"_21381":53056,"_5":14694,"_28049":53033,"_3044":53057},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3588":844,"_30857":832,"_21381":53059,"_5":14694,"_28049":53037,"_3044":53060},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3588":845,"_30857":832,"_21381":53062,"_5":14694,"_28049":53041,"_3044":53063},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3588":846,"_30857":846,"_5":15054,"_3044":53065,"_31216":53066,"_21381":53067,"_28049":846},"How Lamassu works",[50449,51961],[],{"_3588":847,"_30857":846,"_21381":53069,"_5":14694,"_28049":846,"_3044":53070},[],"The mental model of trust, keys, certificates and devices.",{"_3588":848,"_30857":846,"_5":31213,"_21381":53072,"_28049":53073,"_3044":53074},[],"/docs/pr-preview/pr-70/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3588":849,"_30857":846,"_5":31213,"_21381":53076,"_28049":53077,"_3044":53078},[],"/docs/pr-preview/pr-70/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3588":850,"_30857":846,"_21381":53080,"_5":14694,"_28049":846,"_3044":53081},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3588":851,"_30857":846,"_21381":53083,"_5":14694,"_28049":53073,"_3044":53084},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3588":852,"_30857":846,"_21381":53086,"_5":14694,"_28049":53073,"_3044":53087},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3588":853,"_30857":846,"_21381":53089,"_5":14694,"_28049":53073,"_3044":53090},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3588":854,"_30857":846,"_21381":53092,"_5":14694,"_28049":53073,"_3044":53093},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3588":855,"_30857":846,"_21381":53095,"_5":14694,"_28049":53073,"_3044":53096},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3588":856,"_30857":846,"_21381":53098,"_5":14694,"_28049":53077,"_3044":53099},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3588":857,"_30857":846,"_21381":53101,"_5":14694,"_28049":53077,"_3044":53102},[],"A DMS relates that CA to an enrollment policy.",{"_3588":858,"_30857":846,"_21381":53104,"_5":14694,"_28049":53077,"_3044":53105},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3588":859,"_30857":846,"_21381":53107,"_5":14694,"_28049":53077,"_3044":53108},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3588":860,"_30857":846,"_21381":53110,"_5":14694,"_28049":53077,"_3044":53111},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3588":861,"_30857":846,"_21381":53113,"_5":14694,"_28049":53077,"_3044":53114},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3588":862,"_30857":846,"_21381":53116,"_5":14694,"_28049":53077,"_3044":53117},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3588":863,"_30857":863,"_5":15054,"_3044":53119,"_31216":53120,"_21381":53122,"_28049":863},"Devices and identities",[50449,51961,53121,53119],"IoT Fleets",[],{"_3588":864,"_30857":863,"_21381":53124,"_5":14694,"_28049":863,"_3044":53125},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3588":865,"_30857":863,"_5":31213,"_21381":53127,"_28049":53128,"_3044":53129},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#device-states","Device states",{"_3588":866,"_30857":863,"_5":31213,"_21381":53131,"_28049":53132,"_3044":53133},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3588":867,"_30857":863,"_5":31213,"_21381":53135,"_28049":53136,"_3044":53137},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3588":868,"_30857":863,"_5":31213,"_21381":53139,"_28049":53140,"_3044":53141},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3588":869,"_30857":863,"_5":31213,"_21381":53143,"_28049":53144,"_3044":53145},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3588":870,"_30857":863,"_5":31213,"_21381":53147,"_28049":53148,"_3044":53149},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3588":871,"_30857":863,"_5":31213,"_21381":53151,"_28049":53152,"_3044":53153},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3588":872,"_30857":863,"_5":31213,"_21381":53155,"_28049":53156,"_3044":53157},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3588":873,"_30857":863,"_5":31213,"_21381":53159,"_28049":53160,"_3044":53161},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3588":874,"_30857":863,"_5":31213,"_21381":53163,"_28049":53164,"_3044":53165},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3588":875,"_30857":863,"_5":31213,"_21381":53167,"_28049":53168,"_3044":53169},[],"/docs/pr-preview/pr-70/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3588":876,"_30857":863,"_21381":53171,"_5":14694,"_28049":863,"_3044":53172},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3588":877,"_30857":863,"_21381":53174,"_5":14694,"_28049":863,"_3044":53175},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3588":878,"_30857":863,"_21381":53177,"_5":14694,"_28049":53128,"_3044":53178},[],"Operational view",{"_3588":879,"_30857":863,"_21381":53180,"_5":14694,"_28049":53128,"_3044":53181},[],"Meaning",{"_3588":880,"_30857":863,"_21381":53183,"_5":14694,"_28049":53128,"_3044":53184},[],"**No Identity**",{"_3588":881,"_30857":863,"_21381":53186,"_5":14694,"_28049":53128,"_3044":53187},[],"A record exists without an associated identity.",{"_3588":882,"_30857":863,"_21381":53189,"_5":14694,"_28049":53128,"_3044":53190},[],"**Active**",{"_3588":883,"_30857":863,"_21381":53192,"_5":14694,"_28049":53128,"_3044":53193},[],"The slot is active; also check certificate dates, status and usages.",{"_3588":884,"_30857":863,"_21381":53195,"_5":14694,"_28049":53128,"_3044":53196},[],"**Renewal Pending**",{"_3588":885,"_30857":863,"_21381":53198,"_5":14694,"_28049":53128,"_3044":53199},[],"The identity is in the operational renewal window.",{"_3588":886,"_30857":863,"_21381":53201,"_5":14694,"_28049":53128,"_3044":53202},[],"**Expiring Soon**",{"_3588":887,"_30857":863,"_21381":53204,"_5":14694,"_28049":53128,"_3044":53205},[],"Expiration is approaching according to configured thresholds.",{"_3588":888,"_30857":863,"_21381":53207,"_5":14694,"_28049":53128,"_3044":53208},[],"**Expired**",{"_3588":889,"_30857":863,"_21381":53210,"_5":14694,"_28049":53128,"_3044":53211},[],"The identity has expired.",{"_3588":890,"_30857":863,"_21381":53213,"_5":14694,"_28049":53128,"_3044":53214},[],"**Revoked**",{"_3588":891,"_30857":863,"_21381":53216,"_5":14694,"_28049":53128,"_3044":53217},[],"The identity is marked revoked.",{"_3588":892,"_30857":863,"_21381":53219,"_5":14694,"_28049":53128,"_3044":53220},[],"**Decommissioned**",{"_3588":893,"_30857":863,"_21381":53222,"_5":14694,"_28049":53128,"_3044":53223},[],"The record is retired and ordinary updates do not restore operation.",{"_3588":894,"_30857":863,"_21381":53225,"_5":14694,"_28049":53128,"_3044":53226},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3588":895,"_30857":863,"_21381":53228,"_5":14694,"_28049":53132,"_3044":53229},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3588":896,"_30857":863,"_21381":53231,"_5":14694,"_28049":53132,"_3044":53232},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3588":897,"_30857":863,"_21381":53234,"_5":14694,"_28049":53132,"_3044":53235},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3588":898,"_30857":863,"_21381":53237,"_5":14694,"_28049":53132,"_3044":53238},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3588":899,"_30857":863,"_21381":53240,"_5":14694,"_28049":53136,"_3044":53241},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3588":900,"_30857":863,"_21381":53243,"_5":14694,"_28049":53140,"_3044":53244},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3588":901,"_30857":863,"_21381":53246,"_5":14694,"_28049":53144,"_3044":53247},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3588":902,"_30857":863,"_21381":53249,"_5":14694,"_28049":53148,"_3044":53250},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3588":903,"_30857":863,"_21381":53252,"_5":14694,"_28049":53152,"_3044":53253},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3588":904,"_30857":863,"_21381":53255,"_5":14694,"_28049":53152,"_3044":53256},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3588":905,"_30857":863,"_21381":53258,"_5":14694,"_28049":53156,"_3044":53259},[],"From **No Identity**, use **Assign Identity**:",{"_3588":906,"_30857":863,"_21381":53261,"_5":14694,"_28049":53156,"_3044":53262},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3588":907,"_30857":863,"_21381":53264,"_5":14694,"_28049":53156,"_3044":53265},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3588":908,"_30857":863,"_21381":53267,"_5":14694,"_28049":53156,"_3044":53268},[],"Confirm and read the serial, active version and history again.",{"_3588":909,"_30857":863,"_21381":53270,"_5":14694,"_28049":53156,"_3044":53271},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3588":910,"_30857":863,"_21381":53273,"_5":14694,"_28049":53156,"_3044":53274},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3588":911,"_30857":863,"_21381":53276,"_5":14694,"_28049":53160,"_3044":53277},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3588":912,"_30857":863,"_21381":53279,"_5":14694,"_28049":53160,"_3044":53280},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3588":913,"_30857":863,"_21381":53282,"_5":14694,"_28049":53164,"_3044":53283},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3588":914,"_30857":863,"_21381":53285,"_5":14694,"_28049":53164,"_3044":53286},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3588":915,"_30857":863,"_21381":53288,"_5":14694,"_28049":53164,"_3044":53289},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3588":916,"_30857":863,"_21381":53291,"_5":14694,"_28049":53164,"_3044":53292},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3588":917,"_30857":863,"_21381":53294,"_5":14694,"_28049":53168,"_3044":53295},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3588":918,"_30857":863,"_21381":53297,"_5":14694,"_28049":53168,"_3044":53298},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3588":919,"_30857":919,"_5":15054,"_3044":53300,"_31216":53301,"_21381":53303,"_28049":919},"Bootstrap identity and authentication",[50449,51961,53121,53119,53302],"Enrollment with PKI",[],{"_3588":920,"_30857":919,"_21381":53305,"_5":14694,"_28049":919,"_3044":53306},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3588":921,"_30857":919,"_5":31213,"_21381":53308,"_28049":53309,"_3044":53310},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3588":922,"_30857":919,"_5":31213,"_21381":53312,"_28049":53313,"_3044":53314},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3588":923,"_30857":919,"_5":31213,"_21381":53316,"_28049":53317,"_3044":53318},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3588":924,"_30857":919,"_5":31213,"_21381":53320,"_28049":53321,"_3044":53322},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3588":925,"_30857":919,"_5":31213,"_21381":53324,"_28049":53325,"_3044":53326},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3588":926,"_30857":919,"_21381":53328,"_5":14694,"_28049":919,"_3044":53329},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3588":927,"_30857":919,"_21381":53331,"_5":14694,"_28049":53309,"_3044":53332},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3588":928,"_30857":919,"_21381":53334,"_5":14694,"_28049":53309,"_3044":53335},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3588":929,"_30857":919,"_21381":53337,"_5":14694,"_28049":53313,"_3044":53338},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3588":930,"_30857":919,"_21381":53340,"_5":14694,"_28049":53313,"_3044":53341},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3588":931,"_30857":919,"_21381":53343,"_5":14694,"_28049":53313,"_3044":53344},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3588":932,"_30857":919,"_21381":53346,"_5":14694,"_28049":53317,"_3044":53347},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3588":933,"_30857":919,"_21381":53349,"_5":14694,"_28049":53317,"_3044":53350},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3588":934,"_30857":919,"_21381":53352,"_5":14694,"_28049":53321,"_3044":53353},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3588":935,"_30857":919,"_21381":53355,"_5":14694,"_28049":53321,"_3044":53356},[],"Example body:",{"_3588":936,"_30857":919,"_21381":53358,"_5":14694,"_28049":53321,"_3044":53359},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3588":937,"_30857":919,"_21381":53361,"_5":14694,"_28049":53321,"_3044":53362},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3588":938,"_30857":919,"_21381":53364,"_5":14694,"_28049":53321,"_3044":53365},[],"Continuation requires a successful HTTP response and JSON:",{"_3588":939,"_30857":919,"_21381":53367,"_5":14694,"_28049":53321,"_3044":53368},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3588":940,"_30857":919,"_21381":53370,"_5":14694,"_28049":53325,"_3044":53371},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3588":941,"_30857":919,"_21381":53373,"_5":14694,"_28049":53325,"_3044":53374},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3588":942,"_30857":942,"_5":15054,"_3044":53376,"_31216":53377,"_21381":53378,"_28049":942},"Configure and operate the DMS",[50449,51961,53121,53119,53302],[],{"_3588":943,"_30857":942,"_21381":53380,"_5":14694,"_28049":942,"_3044":53381},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3588":944,"_30857":942,"_5":31213,"_21381":53383,"_28049":53384,"_3044":50459},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3588":945,"_30857":942,"_5":31213,"_21381":53386,"_28049":53387,"_3044":53388},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3588":946,"_30857":942,"_5":31213,"_21381":53390,"_28049":53391,"_3044":53392},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3588":947,"_30857":942,"_5":31213,"_21381":53394,"_28049":53395,"_3044":53396},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3588":948,"_30857":942,"_5":31213,"_21381":53398,"_28049":53399,"_3044":53400},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3588":949,"_30857":942,"_5":31213,"_21381":53402,"_28049":53403,"_3044":53404},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3588":950,"_30857":942,"_5":31213,"_21381":53406,"_28049":53407,"_3044":53408},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3588":951,"_30857":942,"_5":31213,"_21381":53410,"_28049":53411,"_3044":53412},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3588":952,"_30857":942,"_5":31213,"_21381":53414,"_28049":53415,"_3044":53416},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3588":953,"_30857":942,"_5":31213,"_21381":53418,"_28049":53419,"_3044":53420},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3588":954,"_30857":942,"_5":31213,"_21381":53422,"_28049":53423,"_3044":53424},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3588":955,"_30857":942,"_5":31213,"_21381":53426,"_28049":53427,"_3044":53428},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3588":956,"_30857":942,"_5":31213,"_21381":53430,"_28049":53431,"_3044":53432},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3588":957,"_30857":942,"_5":31213,"_21381":53434,"_28049":53435,"_3044":53436},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3588":958,"_30857":942,"_5":31213,"_21381":53438,"_28049":53439,"_3044":53440},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3588":959,"_30857":942,"_5":31213,"_21381":53442,"_28049":53443,"_3044":53444},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3588":960,"_30857":942,"_5":31213,"_21381":53446,"_28049":53447,"_3044":53448},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3588":961,"_30857":942,"_5":31213,"_21381":53450,"_28049":53451,"_3044":53452},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3588":962,"_30857":942,"_21381":53454,"_5":14694,"_28049":942,"_3044":53455},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3588":963,"_30857":942,"_21381":53457,"_5":14694,"_28049":53384,"_3044":53458},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3588":964,"_30857":942,"_21381":53460,"_5":14694,"_28049":53384,"_3044":53461},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3588":965,"_30857":942,"_21381":53463,"_5":14694,"_28049":53391,"_3044":53464},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3588":966,"_30857":942,"_21381":53466,"_5":14694,"_28049":53395,"_3044":53467},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3588":967,"_30857":942,"_21381":53469,"_5":14694,"_28049":53399,"_3044":53470},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3588":968,"_30857":942,"_21381":53472,"_5":14694,"_28049":53403,"_3044":53473},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3588":969,"_30857":942,"_21381":53475,"_5":14694,"_28049":53407,"_3044":53476},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3588":970,"_30857":942,"_21381":53478,"_5":14694,"_28049":53415,"_3044":53479},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3588":971,"_30857":942,"_21381":53481,"_5":14694,"_28049":53415,"_3044":53482},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3588":972,"_30857":942,"_21381":53484,"_5":14694,"_28049":53419,"_3044":53485},[],"`settings.enrollment_settings` field",{"_3588":973,"_30857":942,"_21381":53487,"_5":14694,"_28049":53419,"_3044":53488},[],"Decision",{"_3588":974,"_30857":942,"_21381":53490,"_5":14694,"_28049":53419,"_3044":53491},[],"`protocol`",{"_3588":975,"_30857":942,"_21381":53493,"_5":14694,"_28049":53419,"_3044":53494},[],"`EST_RFC7030` for these operations.",{"_3588":976,"_30857":942,"_21381":53496,"_5":14694,"_28049":53419,"_3044":53497},[],"`enrollment_ca`",{"_3588":977,"_30857":942,"_21381":53499,"_5":14694,"_28049":53419,"_3044":53500},[],"ID of the signing CA.",{"_3588":978,"_30857":942,"_21381":53502,"_5":14694,"_28049":53419,"_3044":53503},[],"`verify_csr_signature`",{"_3588":979,"_30857":942,"_21381":53505,"_5":14694,"_28049":53419,"_3044":53506},[],"Keep `true` to verify CSR key possession.",{"_3588":980,"_30857":942,"_21381":53508,"_5":14694,"_28049":53419,"_3044":53509},[],"`enable_replaceable_enrollment`",{"_3588":981,"_30857":942,"_21381":53511,"_5":14694,"_28049":53419,"_3044":53512},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3588":982,"_30857":942,"_21381":53514,"_5":14694,"_28049":53419,"_3044":53515},[],"`est_rfc7030_settings.auth_mode`",{"_3588":983,"_30857":942,"_21381":53517,"_5":14694,"_28049":53419,"_3044":53518},[],"One of the four authentication modes.",{"_3588":984,"_30857":942,"_21381":53520,"_5":14694,"_28049":53419,"_3044":53521},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3588":985,"_30857":942,"_21381":53523,"_5":14694,"_28049":53423,"_3044":53524},[],"The blocks are independent:",{"_3588":986,"_30857":942,"_21381":53526,"_5":14694,"_28049":53423,"_3044":53527},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3588":987,"_30857":942,"_21381":53529,"_5":14694,"_28049":53423,"_3044":53530},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3588":988,"_30857":942,"_21381":53532,"_5":14694,"_28049":53423,"_3044":53533},[],"`auth_mode`",{"_3588":989,"_30857":942,"_21381":53535,"_5":14694,"_28049":53423,"_3044":53536},[],"Control applied in the configured operation",{"_3588":990,"_30857":942,"_21381":53538,"_5":14694,"_28049":53423,"_3044":53539},[],"`CLIENT_CERTIFICATE`",{"_3588":991,"_30857":942,"_21381":53541,"_5":14694,"_28049":53423,"_3044":53542},[],"Presented certificate validation.",{"_3588":992,"_30857":942,"_21381":53544,"_5":14694,"_28049":53423,"_3044":53545},[],"`EXTERNAL_WEBHOOK`",{"_3588":993,"_30857":942,"_21381":53547,"_5":14694,"_28049":53423,"_3044":53548},[],"Configured webhook authorization.",{"_3588":994,"_30857":942,"_21381":53550,"_5":14694,"_28049":53423,"_3044":53551},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3588":995,"_30857":942,"_21381":53553,"_5":14694,"_28049":53423,"_3044":53554},[],"Certificate validation followed by webhook approval.",{"_3588":996,"_30857":942,"_21381":53556,"_5":14694,"_28049":53423,"_3044":53557},[],"`NO_AUTH`",{"_3588":997,"_30857":942,"_21381":53559,"_5":14694,"_28049":53423,"_3044":53560},[],"No DMS requester authentication.",{"_3588":998,"_30857":942,"_21381":53562,"_5":14694,"_28049":53423,"_3044":53563},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3588":999,"_30857":942,"_21381":53565,"_5":14694,"_28049":53423,"_3044":53566},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3588":1000,"_30857":942,"_21381":53568,"_5":14694,"_28049":53423,"_3044":53569},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3588":1001,"_30857":942,"_21381":53571,"_5":14694,"_28049":53423,"_3044":53572},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3588":1002,"_30857":942,"_21381":53574,"_5":14694,"_28049":53427,"_3044":53575},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3588":1003,"_30857":942,"_21381":53577,"_5":14694,"_28049":53427,"_3044":53578},[],"`external_webhook_settings` field",{"_3588":1004,"_30857":942,"_21381":53580,"_5":14694,"_28049":53427,"_3044":53488},[],{"_3588":1005,"_30857":942,"_21381":53582,"_5":14694,"_28049":53427,"_3044":53583},[],"`url`",{"_3588":1006,"_30857":942,"_21381":53585,"_5":14694,"_28049":53427,"_3044":53586},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3588":1007,"_30857":942,"_21381":53588,"_5":14694,"_28049":53427,"_3044":53589},[],"`method`",{"_3588":1008,"_30857":942,"_21381":53591,"_5":14694,"_28049":53427,"_3044":53592},[],"`POST` or `PUT`; `POST` by default.",{"_3588":1009,"_30857":942,"_21381":53594,"_5":14694,"_28049":53427,"_3044":53595},[],"`name`",{"_3588":1010,"_30857":942,"_21381":53597,"_5":14694,"_28049":53427,"_3044":53598},[],"Label used in service logs.",{"_3588":1011,"_30857":942,"_21381":53600,"_5":14694,"_28049":53427,"_3044":53601},[],"`config.auth_mode`",{"_3588":1012,"_30857":942,"_21381":53603,"_5":14694,"_28049":53427,"_3044":53604},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3588":1013,"_30857":942,"_21381":53606,"_5":14694,"_28049":53427,"_3044":53607},[],"`config.log_level`",{"_3588":1014,"_30857":942,"_21381":53609,"_5":14694,"_28049":53427,"_3044":53610},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3588":1015,"_30857":942,"_21381":53612,"_5":14694,"_28049":53427,"_3044":53613},[],"`config.apikey_options`",{"_3588":1016,"_30857":942,"_21381":53615,"_5":14694,"_28049":53427,"_3044":53616},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3588":1017,"_30857":942,"_21381":53618,"_5":14694,"_28049":53427,"_3044":53619},[],"`config.jwt_options`",{"_3588":1018,"_30857":942,"_21381":53621,"_5":14694,"_28049":53427,"_3044":53622},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3588":1019,"_30857":942,"_21381":53624,"_5":14694,"_28049":53427,"_3044":53625},[],"`config.mtls_options`",{"_3588":1020,"_30857":942,"_21381":53627,"_5":14694,"_28049":53427,"_3044":53628},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3588":1021,"_30857":942,"_21381":53630,"_5":14694,"_28049":53427,"_3044":53631},[],"`config.insecure_skip_verify`",{"_3588":1022,"_30857":942,"_21381":53633,"_5":14694,"_28049":53427,"_3044":53634},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3588":1023,"_30857":942,"_21381":53636,"_5":14694,"_28049":53427,"_3044":53637},[],"`config.call_timeout`",{"_3588":1024,"_30857":942,"_21381":53639,"_5":14694,"_28049":53427,"_3044":53640},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3588":1025,"_30857":942,"_21381":53642,"_5":14694,"_28049":53427,"_3044":53643},[],"Rules for that configuration:",{"_3588":1026,"_30857":942,"_21381":53645,"_5":14694,"_28049":53427,"_3044":53646},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3588":1027,"_30857":942,"_21381":53648,"_5":14694,"_28049":53427,"_3044":53649},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3588":1028,"_30857":942,"_21381":53651,"_5":14694,"_28049":53427,"_3044":53652},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3588":1029,"_30857":942,"_21381":53654,"_5":14694,"_28049":53427,"_3044":53655},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3588":1030,"_30857":942,"_21381":53657,"_5":14694,"_28049":53427,"_3044":53658},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3588":1031,"_30857":942,"_21381":53660,"_5":14694,"_28049":53427,"_3044":53661},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3588":1032,"_30857":942,"_21381":53663,"_5":14694,"_28049":53427,"_3044":53664},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3588":1033,"_30857":942,"_21381":53666,"_5":14694,"_28049":53427,"_3044":53667},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3588":1034,"_30857":942,"_21381":53669,"_5":14694,"_28049":53427,"_3044":53670},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3588":1035,"_30857":942,"_21381":53672,"_5":14694,"_28049":53431,"_3044":53673},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3588":1036,"_30857":942,"_21381":53675,"_5":14694,"_28049":53435,"_3044":53676},[],"`settings.reenrollment_settings` field",{"_3588":1037,"_30857":942,"_21381":53678,"_5":14694,"_28049":53435,"_3044":50839},[],{"_3588":1038,"_30857":942,"_21381":53680,"_5":14694,"_28049":53435,"_3044":53681},[],"`reenrollment_delta`",{"_3588":1039,"_30857":942,"_21381":53683,"_5":14694,"_28049":53435,"_3044":53684},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3588":1040,"_30857":942,"_21381":53686,"_5":14694,"_28049":53435,"_3044":53687},[],"`preventive_delta`",{"_3588":1041,"_30857":942,"_21381":53689,"_5":14694,"_28049":53435,"_3044":53690},[],"Preventive operational monitoring threshold.",{"_3588":1042,"_30857":942,"_21381":53692,"_5":14694,"_28049":53435,"_3044":53693},[],"`critical_delta`",{"_3588":1043,"_30857":942,"_21381":53695,"_5":14694,"_28049":53435,"_3044":53696},[],"Critical operational monitoring threshold.",{"_3588":1044,"_30857":942,"_21381":53698,"_5":14694,"_28049":53435,"_3044":53699},[],"`enable_expired_renewal`",{"_3588":1045,"_30857":942,"_21381":53701,"_5":14694,"_28049":53435,"_3044":53702},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3588":1046,"_30857":942,"_21381":53704,"_5":14694,"_28049":53435,"_3044":53705},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3588":1047,"_30857":942,"_21381":53707,"_5":14694,"_28049":53435,"_3044":53708},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3588":1048,"_30857":942,"_21381":53710,"_5":14694,"_28049":53435,"_3044":53711},[],"`revoke_on_reenrollment`",{"_3588":1049,"_30857":942,"_21381":53713,"_5":14694,"_28049":53435,"_3044":53714},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3588":1050,"_30857":942,"_21381":53716,"_5":14694,"_28049":53435,"_3044":53717},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3588":1051,"_30857":942,"_21381":53719,"_5":14694,"_28049":53439,"_3044":53720},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3588":1052,"_30857":942,"_21381":53722,"_5":14694,"_28049":53443,"_3044":50833},[],{"_3588":1053,"_30857":942,"_21381":53724,"_5":14694,"_28049":53443,"_3044":53725},[],"Published material",{"_3588":1054,"_30857":942,"_21381":53727,"_5":14694,"_28049":53443,"_3044":53728},[],"**Include Lamassu System CA**",{"_3588":1055,"_30857":942,"_21381":53730,"_5":14694,"_28049":53443,"_3044":53731},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3588":1056,"_30857":942,"_21381":53733,"_5":14694,"_28049":53443,"_3044":53734},[],"**Include Enrollment CA**",{"_3588":1057,"_30857":942,"_21381":53736,"_5":14694,"_28049":53443,"_3044":53737},[],"Selected issuing CA certificate.",{"_3588":1058,"_30857":942,"_21381":53739,"_5":14694,"_28049":53443,"_3044":53740},[],"**Managed CAs**",{"_3588":1059,"_30857":942,"_21381":53742,"_5":14694,"_28049":53443,"_3044":53743},[],"Explicitly selected CA certificates.",{"_3588":1060,"_30857":942,"_21381":53745,"_5":14694,"_28049":53443,"_3044":53746},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3588":1061,"_30857":942,"_21381":53748,"_5":14694,"_28049":53447,"_3044":53749},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3588":1062,"_30857":942,"_21381":53751,"_5":14694,"_28049":53447,"_3044":53752},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3588":1063,"_30857":942,"_21381":53754,"_5":14694,"_28049":53447,"_3044":53755},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3588":1064,"_30857":942,"_21381":53757,"_5":14694,"_28049":53451,"_3044":53758},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3588":1065,"_30857":1065,"_5":15054,"_3044":53760,"_31216":53761,"_21381":53762,"_28049":1065},"Integrate the EST client",[50449,51961,53121,53119,53302],[],{"_3588":1066,"_30857":1065,"_21381":53764,"_5":14694,"_28049":1065,"_3044":53765},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3588":1067,"_30857":1065,"_5":31213,"_21381":53767,"_28049":53768,"_3044":50459},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3588":1068,"_30857":1065,"_5":31213,"_21381":53770,"_28049":53771,"_3044":53772},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3588":1069,"_30857":1065,"_5":31213,"_21381":53774,"_28049":53775,"_3044":53776},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3588":1070,"_30857":1065,"_5":31213,"_21381":53778,"_28049":53779,"_3044":53780},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3588":1071,"_30857":1065,"_5":31213,"_21381":53782,"_28049":53783,"_3044":53784},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3588":1072,"_30857":1065,"_5":31213,"_21381":53786,"_28049":53787,"_3044":53788},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3588":1073,"_30857":1065,"_21381":53790,"_5":14694,"_28049":1065,"_3044":53791},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3588":1074,"_30857":1065,"_21381":53793,"_5":14694,"_28049":53768,"_3044":53794},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3588":1075,"_30857":1065,"_21381":53796,"_5":14694,"_28049":53768,"_3044":53797},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3588":1076,"_30857":1065,"_21381":53799,"_5":14694,"_28049":53768,"_3044":53800},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3588":1077,"_30857":1065,"_21381":53802,"_5":14694,"_28049":53771,"_3044":53803},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3588":1078,"_30857":1065,"_21381":53805,"_5":14694,"_28049":53771,"_3044":53806},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3588":1079,"_30857":1065,"_21381":53808,"_5":14694,"_28049":53775,"_3044":53809},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3588":1080,"_30857":1065,"_21381":53811,"_5":14694,"_28049":53775,"_3044":53812},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3588":1081,"_30857":1065,"_21381":53814,"_5":14694,"_28049":53779,"_3044":53815},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3588":1082,"_30857":1065,"_21381":53817,"_5":14694,"_28049":53779,"_3044":53818},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3588":1083,"_30857":1065,"_21381":53820,"_5":14694,"_28049":53783,"_3044":53821},[],"For a root that issues directly:",{"_3588":1084,"_30857":1065,"_21381":53823,"_5":14694,"_28049":53783,"_3044":53824},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3588":1085,"_30857":1065,"_21381":53826,"_5":14694,"_28049":53783,"_3044":53827},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3588":1086,"_30857":1065,"_21381":53829,"_5":14694,"_28049":53787,"_3044":53830},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3588":1087,"_30857":1087,"_5":15054,"_3044":53832,"_31216":53833,"_21381":53834,"_28049":1087},"EST reference",[50449,51961,53121,53119,53302],[],{"_3588":1088,"_30857":1087,"_21381":53836,"_5":14694,"_28049":1087,"_3044":53837},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3588":1089,"_30857":1087,"_5":31213,"_21381":53839,"_28049":53840,"_3044":53841},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3588":1090,"_30857":1087,"_5":31213,"_21381":53843,"_28049":53844,"_3044":23162},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3588":1091,"_30857":1087,"_5":31213,"_21381":53846,"_28049":53847,"_3044":26605},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3588":1092,"_30857":1087,"_5":31213,"_21381":53849,"_28049":53850,"_3044":26612},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3588":1093,"_30857":1087,"_5":31213,"_21381":53852,"_28049":53853,"_3044":25898},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3588":1094,"_30857":1087,"_5":31213,"_21381":53855,"_28049":53856,"_3044":53857},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3588":1095,"_30857":1087,"_5":31213,"_21381":53859,"_28049":53860,"_3044":53861},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3588":1096,"_30857":1087,"_5":31213,"_21381":53863,"_28049":53864,"_3044":53865},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3588":1097,"_30857":1087,"_21381":53867,"_5":14694,"_28049":1087,"_3044":53868},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3588":1098,"_30857":1087,"_21381":53870,"_5":14694,"_28049":53840,"_3044":53871},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3588":1099,"_30857":1087,"_21381":53873,"_5":14694,"_28049":53840,"_3044":53874},[],"Operation",{"_3588":1100,"_30857":1087,"_21381":53876,"_5":14694,"_28049":53840,"_3044":53877},[],"Method",{"_3588":1101,"_30857":1087,"_21381":53879,"_5":14694,"_28049":53840,"_3044":53880},[],"Authentication and condition",{"_3588":1102,"_30857":1087,"_21381":53882,"_5":14694,"_28049":53840,"_3044":53883},[],"`/cacerts`",{"_3588":1103,"_30857":1087,"_21381":53885,"_5":14694,"_28049":53840,"_3044":53886},[],"GET",{"_3588":1104,"_30857":1087,"_21381":53888,"_5":14694,"_28049":53840,"_3044":53889},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3588":1105,"_30857":1087,"_21381":53891,"_5":14694,"_28049":53840,"_3044":53892},[],"`/simpleenroll`",{"_3588":1106,"_30857":1087,"_21381":53894,"_5":14694,"_28049":53840,"_3044":53895},[],"POST",{"_3588":1107,"_30857":1087,"_21381":53897,"_5":14694,"_28049":53840,"_3044":53898},[],"Initial authentication and DMS registration/replacement policy.",{"_3588":1108,"_30857":1087,"_21381":53900,"_5":14694,"_28049":53840,"_3044":53901},[],"`/simplereenroll`",{"_3588":1109,"_30857":1087,"_21381":53903,"_5":14694,"_28049":53840,"_3044":53895},[],{"_3588":1110,"_30857":1087,"_21381":53905,"_5":14694,"_28049":53840,"_3044":53906},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3588":1111,"_30857":1087,"_21381":53908,"_5":14694,"_28049":53840,"_3044":53909},[],"`/serverkeygen`",{"_3588":1112,"_30857":1087,"_21381":53911,"_5":14694,"_28049":53840,"_3044":53895},[],{"_3588":1113,"_30857":1087,"_21381":53913,"_5":14694,"_28049":53840,"_3044":53914},[],"Initial authentication and admission; server generation enabled.",{"_3588":1114,"_30857":1087,"_21381":53916,"_5":14694,"_28049":53840,"_3044":53917},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3588":1115,"_30857":1087,"_21381":53919,"_5":14694,"_28049":53844,"_3044":53920},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3588":1116,"_30857":1087,"_21381":53922,"_5":14694,"_28049":53844,"_3044":53923},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3588":1117,"_30857":1087,"_21381":53925,"_5":14694,"_28049":53847,"_3044":53926},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3588":1118,"_30857":1087,"_21381":53928,"_5":14694,"_28049":53847,"_3044":53929},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3588":1119,"_30857":1087,"_21381":53931,"_5":14694,"_28049":53850,"_3044":53932},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3588":1120,"_30857":1087,"_21381":53934,"_5":14694,"_28049":53850,"_3044":53935},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3588":1121,"_30857":1087,"_21381":53937,"_5":14694,"_28049":53853,"_3044":53938},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3588":1122,"_30857":1087,"_21381":53940,"_5":14694,"_28049":53853,"_3044":53941},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3588":1123,"_30857":1087,"_21381":53943,"_5":14694,"_28049":53856,"_3044":53944},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3588":1124,"_30857":1087,"_21381":53946,"_5":14694,"_28049":53856,"_3044":53947},[],"Part",{"_3588":1125,"_30857":1087,"_21381":53949,"_5":14694,"_28049":53856,"_3044":53950},[],"Content after decoding its Base64",{"_3588":1126,"_30857":1087,"_21381":53952,"_5":14694,"_28049":53856,"_3044":53953},[],"`application/pkcs8`",{"_3588":1127,"_30857":1087,"_21381":53955,"_5":14694,"_28049":53856,"_3044":53956},[],"Unencrypted DER PKCS#8 private key.",{"_3588":1128,"_30857":1087,"_21381":53958,"_5":14694,"_28049":53856,"_3044":53959},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3588":1129,"_30857":1087,"_21381":53961,"_5":14694,"_28049":53856,"_3044":53962},[],"DER PKCS#7 containing the issued certificate.",{"_3588":1130,"_30857":1087,"_21381":53964,"_5":14694,"_28049":53856,"_3044":53965},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3588":1131,"_30857":1087,"_21381":53967,"_5":14694,"_28049":53860,"_3044":53968},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3588":1132,"_30857":1087,"_21381":53970,"_5":14694,"_28049":53860,"_3044":53971},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3588":1133,"_30857":1087,"_21381":53973,"_5":14694,"_28049":53860,"_3044":53974},[],"Convert and check the result:",{"_3588":1134,"_30857":1087,"_21381":53976,"_5":14694,"_28049":53860,"_3044":53977},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3588":1135,"_30857":1087,"_21381":53979,"_5":14694,"_28049":53864,"_3044":53980},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3588":1136,"_30857":1087,"_21381":53982,"_5":14694,"_28049":53864,"_3044":53983},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3588":1137,"_30857":1137,"_5":15054,"_3044":53302,"_31216":53985,"_21381":53986,"_28049":1137},[50449,51961,53121,53119,53302],[],{"_3588":1138,"_30857":1137,"_21381":53988,"_5":14694,"_28049":1137,"_3044":53989},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3588":1139,"_30857":1137,"_5":31213,"_21381":53991,"_28049":53992,"_3044":53993},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3588":1140,"_30857":1137,"_5":31213,"_21381":53995,"_28049":53996,"_3044":53997},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3588":1141,"_30857":1137,"_5":31213,"_21381":53999,"_28049":54000,"_3044":54001},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3588":1142,"_30857":1137,"_5":31213,"_21381":54003,"_28049":54004,"_3044":54005},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3588":1143,"_30857":1137,"_21381":54007,"_5":14694,"_28049":1137,"_3044":54008},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3588":1144,"_30857":1137,"_21381":54010,"_5":14694,"_28049":53992,"_3044":54011},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3588":1145,"_30857":1137,"_21381":54013,"_5":14694,"_28049":53992,"_3044":54014},[],"The integrator installs initial EST server trust and an admission credential.",{"_3588":1146,"_30857":1137,"_21381":54016,"_5":14694,"_28049":53992,"_3044":54017},[],"The client requests an identity for its `Device ID` through EST.",{"_3588":1147,"_30857":1137,"_21381":54019,"_5":14694,"_28049":53992,"_3044":54020},[],"Certificate, device binding and key/certificate installation are checked.",{"_3588":1148,"_30857":1137,"_21381":54022,"_5":14694,"_28049":53992,"_3044":54023},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3588":1149,"_30857":1137,"_21381":54025,"_5":14694,"_28049":53992,"_3044":54026},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3588":1150,"_30857":1137,"_21381":54028,"_5":14694,"_28049":53996,"_3044":54029},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3588":1151,"_30857":1137,"_21381":54031,"_5":14694,"_28049":53996,"_3044":54032},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3588":1152,"_30857":1137,"_21381":54034,"_5":14694,"_28049":53996,"_3044":54035},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3588":1153,"_30857":1137,"_21381":54037,"_5":14694,"_28049":53996,"_3044":54038},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3588":1154,"_30857":1137,"_21381":54040,"_5":14694,"_28049":54000,"_3044":54041},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3588":1155,"_30857":1137,"_21381":54043,"_5":14694,"_28049":54000,"_3044":54044},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3588":1156,"_30857":1137,"_21381":54046,"_5":14694,"_28049":54000,"_3044":54047},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3588":1157,"_30857":1137,"_21381":54049,"_5":14694,"_28049":54000,"_3044":54050},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3588":1158,"_30857":1137,"_21381":54052,"_5":14694,"_28049":54004,"_3044":54053},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3588":1159,"_30857":1137,"_21381":54055,"_5":14694,"_28049":54004,"_3044":54056},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3588":1160,"_30857":1160,"_5":15054,"_3044":54058,"_31216":54059,"_21381":54060,"_28049":1160},"Provisioning strategies",[50449,51961,53121,53119,53302],[],{"_3588":1161,"_30857":1160,"_21381":54062,"_5":14694,"_28049":1160,"_3044":54063},[],"Choose device registration, identity authorization and key generation.",{"_3588":1162,"_30857":1160,"_5":31213,"_21381":54065,"_28049":54066,"_3044":54067},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3588":1163,"_30857":1160,"_5":31213,"_21381":54069,"_28049":54070,"_3044":54071},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3588":1164,"_30857":1160,"_5":31213,"_21381":54073,"_28049":54074,"_3044":54075},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3588":1165,"_30857":1160,"_5":31213,"_21381":54077,"_28049":54078,"_3044":54079},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3588":1166,"_30857":1160,"_5":31213,"_21381":54081,"_28049":54082,"_3044":54083},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3588":1167,"_30857":1160,"_21381":54085,"_5":14694,"_28049":1160,"_3044":54086},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3588":1168,"_30857":1160,"_21381":54088,"_5":14694,"_28049":54066,"_3044":54089},[],"Path",{"_3588":1169,"_30857":1160,"_21381":54091,"_5":14694,"_28049":54066,"_3044":54092},[],"When the device exists",{"_3588":1170,"_30857":1160,"_21381":54094,"_5":14694,"_28049":54066,"_3044":54095},[],"What to check",{"_3588":1171,"_30857":1160,"_21381":54097,"_5":14694,"_28049":54066,"_3044":54098},[],"Manual assignment",{"_3588":1172,"_30857":1160,"_21381":54100,"_5":14694,"_28049":54066,"_3044":54101},[],"An operator creates it before associating a certificate.",{"_3588":1173,"_30857":1160,"_21381":54103,"_5":14694,"_28049":54066,"_3044":54104},[],"ID, owning DMS, certificate CN and bound serial.",{"_3588":1174,"_30857":1160,"_21381":54106,"_5":14694,"_28049":54066,"_3044":54107},[],"EST with `JITP`",{"_3588":1175,"_30857":1160,"_21381":54109,"_5":14694,"_28049":54066,"_3044":54110},[],"Created for an unknown CN during `/simpleenroll`.",{"_3588":1176,"_30857":1160,"_21381":54112,"_5":14694,"_28049":54066,"_3044":54113},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3588":1177,"_30857":1160,"_21381":54115,"_5":14694,"_28049":54066,"_3044":54116},[],"EST with `PRE_REGISTRATION`",{"_3588":1178,"_30857":1160,"_21381":54118,"_5":14694,"_28049":54066,"_3044":54119},[],"Must exist before `/simpleenroll`.",{"_3588":1179,"_30857":1160,"_21381":54121,"_5":14694,"_28049":54066,"_3044":54122},[],"Approved record, same DMS and replacement conditions for your version.",{"_3588":1180,"_30857":1160,"_21381":54124,"_5":14694,"_28049":54066,"_3044":54125},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3588":1181,"_30857":1160,"_21381":54127,"_5":14694,"_28049":54066,"_3044":54128},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3588":1182,"_30857":1160,"_21381":54130,"_5":14694,"_28049":54070,"_3044":54131},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3588":1183,"_30857":1160,"_21381":54133,"_5":14694,"_28049":54070,"_3044":54134},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3588":1184,"_30857":1160,"_21381":54136,"_5":14694,"_28049":54070,"_3044":54137},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3588":1185,"_30857":1160,"_21381":54139,"_5":14694,"_28049":54074,"_3044":54140},[],"Decide initial enrollment and re-enrollment separately:",{"_3588":1186,"_30857":1160,"_21381":54142,"_5":14694,"_28049":54074,"_3044":54143},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3588":1187,"_30857":1160,"_21381":54145,"_5":14694,"_28049":54074,"_3044":54146},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3588":1188,"_30857":1160,"_21381":54148,"_5":14694,"_28049":54074,"_3044":54149},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3588":1189,"_30857":1160,"_21381":54151,"_5":14694,"_28049":54074,"_3044":54152},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3588":1190,"_30857":1160,"_21381":54154,"_5":14694,"_28049":54074,"_3044":54155},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3588":1191,"_30857":1160,"_21381":54157,"_5":14694,"_28049":54078,"_3044":50833},[],{"_3588":1192,"_30857":1160,"_21381":54159,"_5":14694,"_28049":54078,"_3044":54160},[],"Material crossing EST",{"_3588":1193,"_30857":1160,"_21381":54162,"_5":14694,"_28049":54078,"_3044":54163},[],"Device-generated key",{"_3588":1194,"_30857":1160,"_21381":54165,"_5":14694,"_28049":54078,"_3044":54166},[],"Public CSR and certificate; the key stays on the client.",{"_3588":1195,"_30857":1160,"_21381":54168,"_5":14694,"_28049":54078,"_3044":54169},[],"Existing device key",{"_3588":1196,"_30857":1160,"_21381":54171,"_5":14694,"_28049":54078,"_3044":54172},[],"CSR signed with that key and a new certificate.",{"_3588":1197,"_30857":1160,"_21381":54174,"_5":14694,"_28049":54078,"_3044":53440},[],{"_3588":1198,"_30857":1160,"_21381":54176,"_5":14694,"_28049":54078,"_3044":54177},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3588":1199,"_30857":1160,"_21381":54179,"_5":14694,"_28049":54078,"_3044":54180},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3588":1200,"_30857":1160,"_21381":54182,"_5":14694,"_28049":54082,"_3044":54183},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3588":1201,"_30857":1201,"_5":15054,"_3044":54185,"_31216":54186,"_21381":54187,"_28049":1201},"Renewal and recovery",[50449,51961,53121,53119,53302],[],{"_3588":1202,"_30857":1201,"_21381":54189,"_5":14694,"_28049":1201,"_3044":54190},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3588":1203,"_30857":1201,"_5":31213,"_21381":54192,"_28049":54193,"_3044":54194},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3588":1204,"_30857":1201,"_5":31213,"_21381":54196,"_28049":54197,"_3044":54198},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3588":1205,"_30857":1201,"_5":31213,"_21381":54200,"_28049":54201,"_3044":54202},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3588":1206,"_30857":1201,"_5":31213,"_21381":54204,"_28049":54205,"_3044":54206},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3588":1207,"_30857":1201,"_5":31213,"_21381":54208,"_28049":54209,"_3044":54210},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3588":1208,"_30857":1201,"_21381":54212,"_5":14694,"_28049":1201,"_3044":54213},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3588":1209,"_30857":1201,"_21381":54215,"_5":14694,"_28049":54193,"_3044":54216},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3588":1210,"_30857":1201,"_21381":54218,"_5":14694,"_28049":54193,"_3044":54219},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3588":1211,"_30857":1201,"_21381":54221,"_5":14694,"_28049":54193,"_3044":54222},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3588":1212,"_30857":1201,"_21381":54224,"_5":14694,"_28049":54193,"_3044":54225},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3588":1213,"_30857":1201,"_21381":54227,"_5":14694,"_28049":54197,"_3044":54228},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3588":1214,"_30857":1201,"_21381":54230,"_5":14694,"_28049":54197,"_3044":54231},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3588":1215,"_30857":1201,"_21381":54233,"_5":14694,"_28049":54201,"_3044":54234},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3588":1216,"_30857":1201,"_21381":54236,"_5":14694,"_28049":54201,"_3044":54237},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3588":1217,"_30857":1201,"_21381":54239,"_5":14694,"_28049":54201,"_3044":54240},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3588":1218,"_30857":1201,"_21381":54242,"_5":14694,"_28049":54205,"_3044":54243},[],"Situation",{"_3588":1219,"_30857":1201,"_21381":54245,"_5":14694,"_28049":54205,"_3044":54246},[],"Procedure",{"_3588":1220,"_30857":1201,"_21381":54248,"_5":14694,"_28049":54205,"_3044":54249},[],"Valid certificate, outside the window",{"_3588":1221,"_30857":1201,"_21381":54251,"_5":14694,"_28049":54205,"_3044":54252},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3588":1222,"_30857":1201,"_21381":54254,"_5":14694,"_28049":54205,"_3044":54255},[],"Expired certificate, key available",{"_3588":1223,"_30857":1201,"_21381":54257,"_5":14694,"_28049":54205,"_3044":54258},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3588":1224,"_30857":1201,"_21381":54260,"_5":14694,"_28049":54205,"_3044":54261},[],"Renewal through webhook or `NO_AUTH`",{"_3588":1225,"_30857":1201,"_21381":54263,"_5":14694,"_28049":54205,"_3044":54264},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3588":1226,"_30857":1201,"_21381":54266,"_5":14694,"_28049":54205,"_3044":54267},[],"Lost or inaccessible key",{"_3588":1227,"_30857":1201,"_21381":54269,"_5":14694,"_28049":54205,"_3044":54270},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3588":1228,"_30857":1201,"_21381":54272,"_5":14694,"_28049":54205,"_3044":54273},[],"Current identity revoked",{"_3588":1229,"_30857":1201,"_21381":54275,"_5":14694,"_28049":54205,"_3044":54276},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3588":1230,"_30857":1201,"_21381":54278,"_5":14694,"_28049":54205,"_3044":54279},[],"Device without an identity",{"_3588":1231,"_30857":1201,"_21381":54281,"_5":14694,"_28049":54205,"_3044":54282},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3588":1232,"_30857":1201,"_21381":54284,"_5":14694,"_28049":54205,"_3044":54285},[],"Retired device",{"_3588":1233,"_30857":1201,"_21381":54287,"_5":14694,"_28049":54205,"_3044":54288},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3588":1234,"_30857":1201,"_21381":54290,"_5":14694,"_28049":54205,"_3044":54291},[],"Timeout, HTTP 500 or installation failure",{"_3588":1235,"_30857":1201,"_21381":54293,"_5":14694,"_28049":54205,"_3044":54294},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3588":1236,"_30857":1201,"_21381":54296,"_5":14694,"_28049":54209,"_3044":54297},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3588":1237,"_30857":1201,"_21381":54299,"_5":14694,"_28049":54209,"_3044":54300},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3588":1238,"_30857":1238,"_5":15054,"_3044":54302,"_31216":54303,"_21381":54304,"_28049":1238},"Enrollment troubleshooting",[50449,51961,53121,53119,53302],[],{"_3588":1239,"_30857":1238,"_21381":54306,"_5":14694,"_28049":1238,"_3044":54307},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3588":1240,"_30857":1238,"_5":31213,"_21381":54309,"_28049":54310,"_3044":54311},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3588":1241,"_30857":1238,"_5":31213,"_21381":54313,"_28049":54314,"_3044":54315},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3588":1242,"_30857":1238,"_5":31213,"_21381":54317,"_28049":54318,"_3044":53865},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3588":1243,"_30857":1238,"_5":31213,"_21381":54320,"_28049":54321,"_3044":54322},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3588":1244,"_30857":1238,"_21381":54324,"_5":14694,"_28049":1238,"_3044":54325},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3588":1245,"_30857":1238,"_21381":54327,"_5":14694,"_28049":54314,"_3044":54328},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3588":1246,"_30857":1238,"_21381":54330,"_5":14694,"_28049":54314,"_3044":54331},[],"Symptom or message",{"_3588":1247,"_30857":1238,"_21381":54333,"_5":14694,"_28049":54314,"_3044":54095},[],{"_3588":1248,"_30857":1238,"_21381":54335,"_5":14694,"_28049":54314,"_3044":54336},[],"curl rejects TLS, name or issuer",{"_3588":1249,"_30857":1238,"_21381":54338,"_5":14694,"_28049":54314,"_3044":54339},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3588":1250,"_30857":1238,"_21381":54341,"_5":14694,"_28049":54314,"_3044":54342},[],"404 or missing APS",{"_3588":1251,"_30857":1238,"_21381":54344,"_5":14694,"_28049":54314,"_3044":54345},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3588":1252,"_30857":1238,"_21381":54347,"_5":14694,"_28049":54314,"_3044":54348},[],"400, CSR or format error",{"_3588":1253,"_30857":1238,"_21381":54350,"_5":14694,"_28049":54314,"_3044":54351},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3588":1254,"_30857":1238,"_21381":54353,"_5":14694,"_28049":54314,"_3044":54354},[],"Missing credential or invalid certificate",{"_3588":1255,"_30857":1238,"_21381":54356,"_5":14694,"_28049":54314,"_3044":54357},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3588":1256,"_30857":1238,"_21381":54359,"_5":14694,"_28049":54314,"_3044":54360},[],"Webhook denies, times out or responds without authorization",{"_3588":1257,"_30857":1238,"_21381":54362,"_5":14694,"_28049":54314,"_3044":54363},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3588":1258,"_30857":1238,"_21381":54365,"_5":14694,"_28049":54314,"_3044":54366},[],"`unexpected status code: <n>: redirects are not followed`",{"_3588":1259,"_30857":1238,"_21381":54368,"_5":14694,"_28049":54314,"_3044":54369},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3588":1260,"_30857":1238,"_21381":54371,"_5":14694,"_28049":54314,"_3044":54372},[],"`webhook response exceeds 1048576 bytes`",{"_3588":1261,"_30857":1238,"_21381":54374,"_5":14694,"_28049":54314,"_3044":54375},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3588":1262,"_30857":1238,"_21381":54377,"_5":14694,"_28049":54314,"_3044":54378},[],"`webhook config must not reference files`",{"_3588":1263,"_30857":1238,"_21381":54380,"_5":14694,"_28049":54314,"_3044":54381},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3588":1264,"_30857":1238,"_21381":54383,"_5":14694,"_28049":54314,"_3044":54384},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3588":1265,"_30857":1238,"_21381":54386,"_5":14694,"_28049":54314,"_3044":54387},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3588":1266,"_30857":1238,"_21381":54389,"_5":14694,"_28049":54314,"_3044":54390},[],"`webhook mTLS certificate and key are invalid: …`",{"_3588":1267,"_30857":1238,"_21381":54392,"_5":14694,"_28049":54314,"_3044":54393},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3588":1268,"_30857":1238,"_21381":54395,"_5":14694,"_28049":54314,"_3044":54396},[],"400 `struct validation error` creating or updating a DMS",{"_3588":1269,"_30857":1238,"_21381":54398,"_5":14694,"_28049":54314,"_3044":54399},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3588":1270,"_30857":1238,"_21381":54401,"_5":14694,"_28049":54314,"_3044":54402},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3588":1271,"_30857":1238,"_21381":54404,"_5":14694,"_28049":54314,"_3044":54405},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3588":1272,"_30857":1238,"_21381":54407,"_5":14694,"_28049":54314,"_3044":54408},[],"`device not preregistered`",{"_3588":1273,"_30857":1238,"_21381":54410,"_5":14694,"_28049":54314,"_3044":54411},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3588":1274,"_30857":1238,"_21381":54413,"_5":14694,"_28049":54314,"_3044":54414},[],"`forbiddenNewEnrollment`",{"_3588":1275,"_30857":1238,"_21381":54416,"_5":14694,"_28049":54314,"_3044":54417},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3588":1276,"_30857":1238,"_21381":54419,"_5":14694,"_28049":54314,"_3044":54420},[],"Different owning DMS",{"_3588":1277,"_30857":1238,"_21381":54422,"_5":14694,"_28049":54314,"_3044":54423},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3588":1278,"_30857":1238,"_21381":54425,"_5":14694,"_28049":54314,"_3044":54426},[],"`invalid RawSubject bytes`",{"_3588":1279,"_30857":1238,"_21381":54428,"_5":14694,"_28049":54314,"_3044":54429},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3588":1280,"_30857":1238,"_21381":54431,"_5":14694,"_28049":54314,"_3044":54432},[],"`invalid reenroll window`",{"_3588":1281,"_30857":1238,"_21381":54434,"_5":14694,"_28049":54314,"_3044":54435},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3588":1282,"_30857":1238,"_21381":54437,"_5":14694,"_28049":54314,"_3044":54438},[],"Current certificate revoked",{"_3588":1283,"_30857":1238,"_21381":54440,"_5":14694,"_28049":54314,"_3044":54441},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3588":1284,"_30857":1238,"_21381":54443,"_5":14694,"_28049":54314,"_3044":54444},[],"CA, profile or signing error",{"_3588":1285,"_30857":1238,"_21381":54446,"_5":14694,"_28049":54314,"_3044":54447},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3588":1286,"_30857":1238,"_21381":54449,"_5":14694,"_28049":54314,"_3044":54450},[],"HTTP 200 without a device connection",{"_3588":1287,"_30857":1238,"_21381":54452,"_5":14694,"_28049":54314,"_3044":54453},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3588":1288,"_30857":1238,"_21381":54455,"_5":14694,"_28049":54314,"_3044":54456},[],"Timeout or error after issuance",{"_3588":1289,"_30857":1238,"_21381":54458,"_5":14694,"_28049":54314,"_3044":54459},[],"New certificates, current slot and previous identity's state before retrying.",{"_3588":1290,"_30857":1238,"_21381":54461,"_5":14694,"_28049":54318,"_3044":54462},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3588":1291,"_30857":1238,"_21381":54464,"_5":14694,"_28049":54318,"_3044":54465},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3588":1292,"_30857":1238,"_21381":54467,"_5":14694,"_28049":54321,"_3044":54468},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3588":1293,"_30857":1238,"_21381":54470,"_5":14694,"_28049":54321,"_3044":54471},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3588":1294,"_30857":1238,"_21381":54473,"_5":14694,"_28049":54321,"_3044":54474},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3588":1295,"_30857":1238,"_21381":54476,"_5":14694,"_28049":54321,"_3044":54477},[],"Make one request, save headers/body and query the device and certificates.",{"_3588":1296,"_30857":1238,"_21381":54479,"_5":14694,"_28049":54321,"_3044":54480},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3588":1297,"_30857":1238,"_21381":54482,"_5":14694,"_28049":54321,"_3044":54483},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3588":1298,"_30857":1238,"_21381":54485,"_5":14694,"_28049":54321,"_3044":54486},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3588":1299,"_30857":1299,"_5":15054,"_3044":54488,"_31216":54489,"_21381":54490,"_28049":1299},"Trust distribution and updates",[50449,51961,53121,53119,53302],[],{"_3588":1300,"_30857":1299,"_21381":54492,"_5":14694,"_28049":1299,"_3044":54493},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3588":1301,"_30857":1299,"_5":31213,"_21381":54495,"_28049":54496,"_3044":54497},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3588":1302,"_30857":1299,"_5":31213,"_21381":54499,"_28049":54500,"_3044":54501},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3588":1303,"_30857":1299,"_5":31213,"_21381":54503,"_28049":54504,"_3044":54505},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3588":1304,"_30857":1299,"_5":31213,"_21381":54507,"_28049":54508,"_3044":54509},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3588":1305,"_30857":1299,"_5":31213,"_21381":54511,"_28049":54512,"_3044":54513},[],"/docs/pr-preview/pr-70/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3588":1306,"_30857":1299,"_21381":54515,"_5":14694,"_28049":1299,"_3044":54516},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3588":1307,"_30857":1299,"_21381":54518,"_5":14694,"_28049":54496,"_3044":54519},[],"Relationship",{"_3588":1308,"_30857":1299,"_21381":54521,"_5":14694,"_28049":54496,"_3044":54522},[],"Material prepared by its owner",{"_3588":1309,"_30857":1299,"_21381":54524,"_5":14694,"_28049":54496,"_3044":54525},[],"Device → EST server",{"_3588":1310,"_30857":1299,"_21381":54527,"_5":14694,"_28049":54496,"_3044":54528},[],"Previously verified server root, chain or pin and TLS name.",{"_3588":1311,"_30857":1299,"_21381":54530,"_5":14694,"_28049":54496,"_3044":54531},[],"DMS → requester",{"_3588":1312,"_30857":1299,"_21381":54533,"_5":14694,"_28049":54496,"_3044":54534},[],"CAs and rules authorizing initial or renewal credentials.",{"_3588":1313,"_30857":1299,"_21381":54536,"_5":14694,"_28049":54496,"_3044":54537},[],"Consumer → device",{"_3588":1314,"_30857":1299,"_21381":54539,"_5":14694,"_28049":54496,"_3044":54540},[],"Operational identity roots, intermediates, validation and permissions.",{"_3588":1315,"_30857":1299,"_21381":54542,"_5":14694,"_28049":54496,"_3044":54543},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3588":1316,"_30857":1299,"_21381":54545,"_5":14694,"_28049":54500,"_3044":54546},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3588":1317,"_30857":1299,"_21381":54548,"_5":14694,"_28049":54500,"_3044":54549},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3588":1318,"_30857":1299,"_21381":54551,"_5":14694,"_28049":54504,"_3044":54552},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3588":1319,"_30857":1299,"_21381":54554,"_5":14694,"_28049":54504,"_3044":54555},[],"Select policy-approved roots as anchors.",{"_3588":1320,"_30857":1299,"_21381":54557,"_5":14694,"_28049":54504,"_3044":54558},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3588":1321,"_30857":1299,"_21381":54560,"_5":14694,"_28049":54504,"_3044":54561},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3588":1322,"_30857":1299,"_21381":54563,"_5":14694,"_28049":54504,"_3044":54564},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3588":1323,"_30857":1299,"_21381":54566,"_5":14694,"_28049":54504,"_3044":54567},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3588":1324,"_30857":1299,"_21381":54569,"_5":14694,"_28049":54508,"_3044":54570},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3588":1325,"_30857":1299,"_21381":54572,"_5":14694,"_28049":54508,"_3044":54573},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3588":1326,"_30857":1299,"_21381":54575,"_5":14694,"_28049":54508,"_3044":54576},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3588":1327,"_30857":1299,"_21381":54578,"_5":14694,"_28049":54512,"_3044":54579},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3588":1328,"_30857":1328,"_5":15054,"_3044":54581,"_31216":54582,"_21381":54584,"_28049":1328},"AWS IoT Core",[50449,51961,53121,53119,54583],"Integrations",[],{"_3588":1329,"_30857":1328,"_21381":54586,"_5":14694,"_28049":1328,"_3044":54587},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3588":1330,"_30857":1328,"_5":31213,"_21381":54589,"_28049":54590,"_3044":54591},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3588":1331,"_30857":1328,"_5":31213,"_21381":54593,"_28049":54594,"_3044":54595},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3588":1332,"_30857":1328,"_5":31213,"_21381":54597,"_28049":54598,"_3044":54599},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3588":1333,"_30857":1328,"_5":31213,"_21381":54601,"_28049":54602,"_3044":54603},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3588":1334,"_30857":1328,"_5":31213,"_21381":54605,"_28049":54606,"_3044":54607},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3588":1335,"_30857":1328,"_5":31213,"_21381":54609,"_28049":54610,"_3044":54611},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3588":1336,"_30857":1328,"_5":31213,"_21381":54613,"_28049":54614,"_3044":54615},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3588":1337,"_30857":1328,"_5":31213,"_21381":54617,"_28049":54618,"_3044":54619},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3588":1338,"_30857":1328,"_5":31213,"_21381":54621,"_28049":54622,"_3044":54623},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3588":1339,"_30857":1328,"_5":31213,"_21381":54625,"_28049":54626,"_3044":54627},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3588":1340,"_30857":1328,"_5":31213,"_21381":54629,"_28049":54630,"_3044":54631},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3588":1341,"_30857":1328,"_5":31213,"_21381":54633,"_28049":54634,"_3044":54635},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3588":1342,"_30857":1328,"_5":31213,"_21381":54637,"_28049":54638,"_3044":54639},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3588":1343,"_30857":1328,"_5":31213,"_21381":54641,"_28049":54642,"_3044":54643},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3588":1344,"_30857":1328,"_5":31213,"_21381":54645,"_28049":54646,"_3044":54647},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3588":1345,"_30857":1328,"_5":31213,"_21381":54649,"_28049":54650,"_3044":54651},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3588":1346,"_30857":1328,"_5":31213,"_21381":54653,"_28049":54654,"_3044":54655},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3588":1347,"_30857":1328,"_5":31213,"_21381":54657,"_28049":54658,"_3044":54659},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3588":1348,"_30857":1328,"_5":31213,"_21381":54661,"_28049":54662,"_3044":54663},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3588":1349,"_30857":1328,"_5":31213,"_21381":54665,"_28049":54666,"_3044":54667},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3588":1350,"_30857":1328,"_5":31213,"_21381":54669,"_28049":54670,"_3044":54671},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3588":1351,"_30857":1328,"_5":31213,"_21381":54673,"_28049":54674,"_3044":54675},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3588":1352,"_30857":1328,"_5":31213,"_21381":54677,"_28049":54678,"_3044":54679},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3588":1353,"_30857":1328,"_5":31213,"_21381":54681,"_28049":54682,"_3044":54683},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3588":1354,"_30857":1328,"_5":31213,"_21381":54685,"_28049":54686,"_3044":54687},[],"/docs/pr-preview/pr-70/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3588":1355,"_30857":1328,"_21381":54689,"_5":14694,"_28049":1328,"_3044":54690},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3588":1356,"_30857":1328,"_21381":54692,"_5":14694,"_28049":1328,"_3044":54693},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3588":1357,"_30857":1328,"_21381":54695,"_5":14694,"_28049":1328,"_3044":54696},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3588":1358,"_30857":1328,"_21381":54698,"_5":14694,"_28049":54590,"_3044":54699},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3588":1359,"_30857":1328,"_21381":54701,"_5":14694,"_28049":54590,"_3044":54702},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3588":1360,"_30857":1328,"_21381":54704,"_5":14694,"_28049":54590,"_3044":54705},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3588":1361,"_30857":1328,"_21381":54707,"_5":14694,"_28049":54590,"_3044":54708},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3588":1362,"_30857":1328,"_21381":54710,"_5":14694,"_28049":54594,"_3044":54711},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3588":1363,"_30857":1328,"_21381":54713,"_5":14694,"_28049":54598,"_3044":54714},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3588":1364,"_30857":1328,"_21381":54716,"_5":14694,"_28049":54598,"_3044":54717},[],"IAM action",{"_3588":1365,"_30857":1328,"_21381":54719,"_5":14694,"_28049":54598,"_3044":50839},[],{"_3588":1366,"_30857":1328,"_21381":54721,"_5":14694,"_28049":54598,"_3044":54722},[],"`iot:GetRegistrationCode`",{"_3588":1367,"_30857":1328,"_21381":54724,"_5":14694,"_28049":54598,"_3044":54725},[],"Obtain the verification code for CA registration in the Primary Account",{"_3588":1368,"_30857":1328,"_21381":54727,"_5":14694,"_28049":54598,"_3044":54728},[],"`iot:RegisterCACertificate`",{"_3588":1369,"_30857":1328,"_21381":54730,"_5":14694,"_28049":54598,"_3044":54731},[],"Register the CA in AWS IoT",{"_3588":1370,"_30857":1328,"_21381":54733,"_5":14694,"_28049":54598,"_3044":54734},[],"`iot:DescribeCACertificate`",{"_3588":1371,"_30857":1328,"_21381":54736,"_5":14694,"_28049":54598,"_3044":54737},[],"Check the CA registration status",{"_3588":1372,"_30857":1328,"_21381":54739,"_5":14694,"_28049":54598,"_3044":54740},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3588":1373,"_30857":1328,"_21381":54742,"_5":14694,"_28049":54598,"_3044":54743},[],"Create or update Things in IoT Core",{"_3588":1374,"_30857":1328,"_21381":54745,"_5":14694,"_28049":54598,"_3044":54746},[],"`iot:RegisterThing`",{"_3588":1375,"_30857":1328,"_21381":54748,"_5":14694,"_28049":54598,"_3044":54749},[],"Provision Things through a template",{"_3588":1376,"_30857":1328,"_21381":54751,"_5":14694,"_28049":54598,"_3044":54752},[],"`iot:RegisterCertificate`",{"_3588":1377,"_30857":1328,"_21381":54754,"_5":14694,"_28049":54598,"_3044":54755},[],"Register device certificates",{"_3588":1378,"_30857":1328,"_21381":54757,"_5":14694,"_28049":54598,"_3044":54758},[],"`iot:UpdateCertificate`",{"_3588":1379,"_30857":1328,"_21381":54760,"_5":14694,"_28049":54598,"_3044":54761},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3588":1380,"_30857":1328,"_21381":54763,"_5":14694,"_28049":54598,"_3044":54764},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3588":1381,"_30857":1328,"_21381":54766,"_5":14694,"_28049":54598,"_3044":54767},[],"Create and attach IoT policies",{"_3588":1382,"_30857":1328,"_21381":54769,"_5":14694,"_28049":54598,"_3044":54770},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3588":1383,"_30857":1328,"_21381":54772,"_5":14694,"_28049":54598,"_3044":54773},[],"Manage Thing groups",{"_3588":1384,"_30857":1328,"_21381":54775,"_5":14694,"_28049":54598,"_3044":54776},[],"`iot:CreateProvisioningTemplate`",{"_3588":1385,"_30857":1328,"_21381":54778,"_5":14694,"_28049":54598,"_3044":54779},[],"Create JITP templates",{"_3588":1386,"_30857":1328,"_21381":54781,"_5":14694,"_28049":54598,"_3044":54782},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3588":1387,"_30857":1328,"_21381":54784,"_5":14694,"_28049":54598,"_3044":54785},[],"Read and write the Device Shadow",{"_3588":1388,"_30857":1328,"_21381":54787,"_5":14694,"_28049":54598,"_3044":54788},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3588":1389,"_30857":1328,"_21381":54790,"_5":14694,"_28049":54602,"_3044":54791},[],"Parameter",{"_3588":1390,"_30857":1328,"_21381":54793,"_5":14694,"_28049":54602,"_3044":54794},[],"Type",{"_3588":1391,"_30857":1328,"_21381":54796,"_5":14694,"_28049":54602,"_3044":54797},[],"Required",{"_3588":1392,"_30857":1328,"_21381":54799,"_5":14694,"_28049":54602,"_3044":54800},[],"Description",{"_3588":1393,"_30857":1328,"_21381":54802,"_5":14694,"_28049":54602,"_3044":54803},[],"`connector_id`",{"_3588":1394,"_30857":1328,"_21381":54805,"_5":14694,"_28049":54602,"_3044":25523},[],{"_3588":1395,"_30857":1328,"_21381":54807,"_5":14694,"_28049":54602,"_3044":54808},[],"Yes",{"_3588":1396,"_30857":1328,"_21381":54810,"_5":14694,"_28049":54602,"_3044":54811},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3588":1397,"_30857":1328,"_21381":54813,"_5":14694,"_28049":54602,"_3044":54814},[],"`aws_config.region`",{"_3588":1398,"_30857":1328,"_21381":54816,"_5":14694,"_28049":54602,"_3044":25523},[],{"_3588":1399,"_30857":1328,"_21381":54818,"_5":14694,"_28049":54602,"_3044":54808},[],{"_3588":1400,"_30857":1328,"_21381":54820,"_5":14694,"_28049":54602,"_3044":54821},[],"AWS region where the connector operates.",{"_3588":1401,"_30857":1328,"_21381":54823,"_5":14694,"_28049":54602,"_3044":54824},[],"`aws_config.auth_method`",{"_3588":1402,"_30857":1328,"_21381":54826,"_5":14694,"_28049":54602,"_3044":25523},[],{"_3588":1403,"_30857":1328,"_21381":54828,"_5":14694,"_28049":54602,"_3044":54808},[],{"_3588":1404,"_30857":1328,"_21381":54830,"_5":14694,"_28049":54602,"_3044":54831},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3588":1405,"_30857":1328,"_21381":54833,"_5":14694,"_28049":54602,"_3044":54834},[],"`aws_config.access_key_id`",{"_3588":1406,"_30857":1328,"_21381":54836,"_5":14694,"_28049":54602,"_3044":25523},[],{"_3588":1407,"_30857":1328,"_21381":54838,"_5":14694,"_28049":54602,"_3044":54839},[],"Only with `auth_method=static`",{"_3588":1408,"_30857":1328,"_21381":54841,"_5":14694,"_28049":54602,"_3044":54842},[],"AWS access key.",{"_3588":1409,"_30857":1328,"_21381":54844,"_5":14694,"_28049":54602,"_3044":54845},[],"`aws_config.secret_access_key`",{"_3588":1410,"_30857":1328,"_21381":54847,"_5":14694,"_28049":54602,"_3044":25523},[],{"_3588":1411,"_30857":1328,"_21381":54849,"_5":14694,"_28049":54602,"_3044":54839},[],{"_3588":1412,"_30857":1328,"_21381":54851,"_5":14694,"_28049":54602,"_3044":54852},[],"AWS secret key.",{"_3588":1413,"_30857":1328,"_21381":54854,"_5":14694,"_28049":54602,"_3044":54855},[],"`aws_config.session_token`",{"_3588":1414,"_30857":1328,"_21381":54857,"_5":14694,"_28049":54602,"_3044":25523},[],{"_3588":1415,"_30857":1328,"_21381":54859,"_5":14694,"_28049":54602,"_3044":54860},[],"No",{"_3588":1416,"_30857":1328,"_21381":54862,"_5":14694,"_28049":54602,"_3044":54863},[],"Session token (with `auth_method=static`).",{"_3588":1417,"_30857":1328,"_21381":54865,"_5":14694,"_28049":54602,"_3044":54866},[],"`aws_config.role_arn`",{"_3588":1418,"_30857":1328,"_21381":54868,"_5":14694,"_28049":54602,"_3044":25523},[],{"_3588":1419,"_30857":1328,"_21381":54870,"_5":14694,"_28049":54602,"_3044":54871},[],"Only with `auth_method=role`",{"_3588":1420,"_30857":1328,"_21381":54873,"_5":14694,"_28049":54602,"_3044":54874},[],"ARN of the role to assume.",{"_3588":1421,"_30857":1328,"_21381":54876,"_5":14694,"_28049":54602,"_3044":54877},[],"`aws_config.endpoint_url`",{"_3588":1422,"_30857":1328,"_21381":54879,"_5":14694,"_28049":54602,"_3044":25523},[],{"_3588":1423,"_30857":1328,"_21381":54881,"_5":14694,"_28049":54602,"_3044":54860},[],{"_3588":1424,"_30857":1328,"_21381":54883,"_5":14694,"_28049":54602,"_3044":54884},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3588":1425,"_30857":1328,"_21381":54886,"_5":14694,"_28049":54602,"_3044":54887},[],"`subscriber_event_bus`",{"_3588":1426,"_30857":1328,"_21381":54889,"_5":14694,"_28049":54602,"_3044":17992},[],{"_3588":1427,"_30857":1328,"_21381":54891,"_5":14694,"_28049":54602,"_3044":54808},[],{"_3588":1428,"_30857":1328,"_21381":54893,"_5":14694,"_28049":54602,"_3044":54894},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3588":1429,"_30857":1328,"_21381":54896,"_5":14694,"_28049":54602,"_3044":54897},[],"`dms_manager_client`",{"_3588":1430,"_30857":1328,"_21381":54899,"_5":14694,"_28049":54602,"_3044":25523},[],{"_3588":1431,"_30857":1328,"_21381":54901,"_5":14694,"_28049":54602,"_3044":54808},[],{"_3588":1432,"_30857":1328,"_21381":54903,"_5":14694,"_28049":54602,"_3044":54904},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3588":1433,"_30857":1328,"_21381":54906,"_5":14694,"_28049":54602,"_3044":54907},[],"`device_manager_client`",{"_3588":1434,"_30857":1328,"_21381":54909,"_5":14694,"_28049":54602,"_3044":25523},[],{"_3588":1435,"_30857":1328,"_21381":54911,"_5":14694,"_28049":54602,"_3044":54808},[],{"_3588":1436,"_30857":1328,"_21381":54913,"_5":14694,"_28049":54602,"_3044":54914},[],"HTTP URL of Lamassu's Device Manager.",{"_3588":1437,"_30857":1328,"_21381":54916,"_5":14694,"_28049":54602,"_3044":54917},[],"`ca_client`",{"_3588":1438,"_30857":1328,"_21381":54919,"_5":14694,"_28049":54602,"_3044":25523},[],{"_3588":1439,"_30857":1328,"_21381":54921,"_5":14694,"_28049":54602,"_3044":54808},[],{"_3588":1440,"_30857":1328,"_21381":54923,"_5":14694,"_28049":54602,"_3044":54924},[],"HTTP URL of Lamassu's CA service.",{"_3588":1441,"_30857":1328,"_21381":54926,"_5":14694,"_28049":54606,"_3044":54927},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3588":1442,"_30857":1328,"_21381":54929,"_5":14694,"_28049":54606,"_3044":54930},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3588":1443,"_30857":1328,"_21381":54932,"_5":14694,"_28049":54606,"_3044":54933},[],"CloudEvent type",{"_3588":1444,"_30857":1328,"_21381":54935,"_5":14694,"_28049":54606,"_3044":54936},[],"Lamassu resource",{"_3588":1445,"_30857":1328,"_21381":54938,"_5":14694,"_28049":54606,"_3044":54939},[],"AWS Resource",{"_3588":1446,"_30857":1328,"_21381":54941,"_5":14694,"_28049":54606,"_3044":54942},[],"IAM actions",{"_3588":1447,"_30857":1328,"_21381":54944,"_5":14694,"_28049":54606,"_3044":54945},[],"AWS calls and effect",{"_3588":1448,"_30857":1328,"_21381":54947,"_5":14694,"_28049":54606,"_3044":54948},[],"Where in this page",{"_3588":1449,"_30857":1328,"_21381":54950,"_5":14694,"_28049":54606,"_3044":54951},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3588":1450,"_30857":1328,"_21381":54953,"_5":14694,"_28049":54606,"_3044":54954},[],"CA",{"_3588":1451,"_30857":1328,"_21381":54956,"_5":14694,"_28049":54606,"_3044":54957},[],"`IoTCore/CACertificate`",{"_3588":1452,"_30857":1328,"_21381":54959,"_5":14694,"_28049":54606,"_3044":54960},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3588":1453,"_30857":1328,"_21381":54962,"_5":14694,"_28049":54606,"_3044":54963},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3588":1454,"_30857":1328,"_21381":54965,"_5":14694,"_28049":54606,"_3044":54619},[],{"_3588":1455,"_30857":1328,"_21381":54967,"_5":14694,"_28049":54606,"_3044":54968},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3588":1456,"_30857":1328,"_21381":54970,"_5":14694,"_28049":54606,"_3044":54971},[],"DMS",{"_3588":1457,"_30857":1328,"_21381":54973,"_5":14694,"_28049":54606,"_3044":54974},[],"`IoTCore/ProvisioningTemplate`",{"_3588":1458,"_30857":1328,"_21381":54976,"_5":14694,"_28049":54606,"_3044":54977},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3588":1459,"_30857":1328,"_21381":54979,"_5":14694,"_28049":54606,"_3044":54980},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3588":1460,"_30857":1328,"_21381":54982,"_5":14694,"_28049":54606,"_3044":54647},[],{"_3588":1461,"_30857":1328,"_21381":54984,"_5":14694,"_28049":54606,"_3044":54985},[],"`EventBindDeviceIdentityKey`",{"_3588":1462,"_30857":1328,"_21381":54987,"_5":14694,"_28049":54606,"_3044":54988},[],"Device",{"_3588":1463,"_30857":1328,"_21381":54990,"_5":14694,"_28049":54606,"_3044":54991},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3588":1464,"_30857":1328,"_21381":54993,"_5":14694,"_28049":54606,"_3044":54994},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3588":1465,"_30857":1328,"_21381":54996,"_5":14694,"_28049":54606,"_3044":54997},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3588":1466,"_30857":1328,"_21381":54999,"_5":14694,"_28049":54606,"_3044":54655},[],{"_3588":1467,"_30857":1328,"_21381":55001,"_5":14694,"_28049":54606,"_3044":55002},[],"`EventUpdateCertificateStatusKey`",{"_3588":1468,"_30857":1328,"_21381":55004,"_5":14694,"_28049":54606,"_3044":55005},[],"Certificate",{"_3588":1469,"_30857":1328,"_21381":55007,"_5":14694,"_28049":54606,"_3044":55008},[],"`IoTCore/Certificate`",{"_3588":1470,"_30857":1328,"_21381":55010,"_5":14694,"_28049":54606,"_3044":55011},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3588":1471,"_30857":1328,"_21381":55013,"_5":14694,"_28049":54606,"_3044":55014},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3588":1472,"_30857":1328,"_21381":55016,"_5":14694,"_28049":54606,"_3044":54667},[],{"_3588":1473,"_30857":1328,"_21381":55018,"_5":14694,"_28049":54606,"_3044":55019},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3588":1474,"_30857":1328,"_21381":55021,"_5":14694,"_28049":54606,"_3044":55022},[],"Certificate / Device",{"_3588":1475,"_30857":1328,"_21381":55024,"_5":14694,"_28049":54606,"_3044":55025},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3588":1476,"_30857":1328,"_21381":55027,"_5":14694,"_28049":54606,"_3044":50845},[],{"_3588":1477,"_30857":1328,"_21381":55029,"_5":14694,"_28049":54606,"_3044":55030},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3588":1478,"_30857":1328,"_21381":55032,"_5":14694,"_28049":54606,"_3044":54675},[],{"_3588":1479,"_30857":1328,"_21381":55034,"_5":14694,"_28049":54610,"_3044":55035},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3588":1480,"_30857":1328,"_21381":55037,"_5":14694,"_28049":54614,"_3044":55038},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3588":1481,"_30857":1328,"_21381":55040,"_5":14694,"_28049":54614,"_3044":55041},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3588":1482,"_30857":1328,"_21381":55043,"_5":14694,"_28049":54618,"_3044":55044},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3588":1483,"_30857":1328,"_21381":55046,"_5":14694,"_28049":54618,"_3044":55047},[],"Transition",{"_3588":1484,"_30857":1328,"_21381":55049,"_5":14694,"_28049":54618,"_3044":55050},[],"AWS calls",{"_3588":1485,"_30857":1328,"_21381":55052,"_5":14694,"_28049":54618,"_3044":55053},[],"`NotRegistered` → `Requested`",{"_3588":1486,"_30857":1328,"_21381":55055,"_5":14694,"_28049":54618,"_3044":55056},[],"none (metadata write only)",{"_3588":1487,"_30857":1328,"_21381":55058,"_5":14694,"_28049":54618,"_3044":55059},[],"`Requested` → `Registering`",{"_3588":1488,"_30857":1328,"_21381":55061,"_5":14694,"_28049":54618,"_3044":55062},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3588":1489,"_30857":1328,"_21381":55064,"_5":14694,"_28049":54618,"_3044":55065},[],"`Registering` → `Succeeded`",{"_3588":1490,"_30857":1328,"_21381":55067,"_5":14694,"_28049":54618,"_3044":55068},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3588":1491,"_30857":1328,"_21381":55070,"_5":14694,"_28049":54618,"_3044":55071},[],"`Registering` → `Failed`",{"_3588":1492,"_30857":1328,"_21381":55073,"_5":14694,"_28049":54618,"_3044":55074},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3588":1493,"_30857":1328,"_21381":55076,"_5":14694,"_28049":54618,"_3044":55077},[],"`Failed` / `Succeeded` → `Requested`",{"_3588":1494,"_30857":1328,"_21381":55079,"_5":14694,"_28049":54618,"_3044":55080},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3588":1495,"_30857":1328,"_21381":55082,"_5":14694,"_28049":54622,"_3044":55083},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3588":1496,"_30857":1328,"_21381":55085,"_5":14694,"_28049":54622,"_3044":55086},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3588":1497,"_30857":1328,"_21381":55088,"_5":14694,"_28049":54622,"_3044":55089},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3588":1498,"_30857":1328,"_21381":55091,"_5":14694,"_28049":54622,"_3044":55092},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3588":1499,"_30857":1328,"_21381":55094,"_5":14694,"_28049":54622,"_3044":55095},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3588":1500,"_30857":1328,"_21381":55097,"_5":14694,"_28049":54622,"_3044":55098},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3588":1501,"_30857":1328,"_21381":55100,"_5":14694,"_28049":54626,"_3044":55101},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3588":1502,"_30857":1328,"_21381":55103,"_5":14694,"_28049":54630,"_3044":55104},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3588":1503,"_30857":1328,"_21381":55106,"_5":14694,"_28049":54630,"_3044":55107},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3588":1504,"_30857":1328,"_21381":55109,"_5":14694,"_28049":54634,"_3044":55110},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3588":1505,"_30857":1328,"_21381":55112,"_5":14694,"_28049":54638,"_3044":55113},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3588":1506,"_30857":1328,"_21381":55115,"_5":14694,"_28049":54638,"_3044":55116},[],"Creates or updates the IoT policies configured in the DMS.",{"_3588":1507,"_30857":1328,"_21381":55118,"_5":14694,"_28049":54638,"_3044":55119},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3588":1508,"_30857":1328,"_21381":55121,"_5":14694,"_28049":54638,"_3044":55122},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3588":1509,"_30857":1328,"_21381":55124,"_5":14694,"_28049":54638,"_3044":55125},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3588":1510,"_30857":1328,"_21381":55127,"_5":14694,"_28049":54638,"_3044":55128},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3588":1511,"_30857":1328,"_21381":55130,"_5":14694,"_28049":54638,"_3044":55131},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3588":1512,"_30857":1328,"_21381":55133,"_5":14694,"_28049":54642,"_3044":55134},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3588":1513,"_30857":1328,"_21381":55136,"_5":14694,"_28049":54642,"_3044":55137},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3588":1514,"_30857":1328,"_21381":55139,"_5":14694,"_28049":54642,"_3044":55140},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3588":1515,"_30857":1328,"_21381":55142,"_5":14694,"_28049":54642,"_3044":55143},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3588":1516,"_30857":1328,"_21381":55145,"_5":14694,"_28049":54642,"_3044":55146},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3588":1517,"_30857":1328,"_21381":55148,"_5":14694,"_28049":54646,"_3044":55149},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3588":1518,"_30857":1328,"_21381":55151,"_5":14694,"_28049":54646,"_3044":55047},[],{"_3588":1519,"_30857":1328,"_21381":55153,"_5":14694,"_28049":54646,"_3044":55050},[],{"_3588":1520,"_30857":1328,"_21381":55155,"_5":14694,"_28049":54646,"_3044":55156},[],"`Unconfigured` → `None` / `Auto`",{"_3588":1521,"_30857":1328,"_21381":55158,"_5":14694,"_28049":54646,"_3044":55159},[],"none (configuration only)",{"_3588":1522,"_30857":1328,"_21381":55161,"_5":14694,"_28049":54646,"_3044":55162},[],"`None` ↔ `Auto`",{"_3588":1523,"_30857":1328,"_21381":55164,"_5":14694,"_28049":54646,"_3044":55159},[],{"_3588":1524,"_30857":1328,"_21381":55166,"_5":14694,"_28049":54646,"_3044":55167},[],"Any → `Jitp`",{"_3588":1525,"_30857":1328,"_21381":55169,"_5":14694,"_28049":54646,"_3044":55170},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3588":1526,"_30857":1328,"_21381":55172,"_5":14694,"_28049":54646,"_3044":55173},[],"`Jitp` → `None` / `Auto`",{"_3588":1527,"_30857":1328,"_21381":55175,"_5":14694,"_28049":54646,"_3044":55176},[],"none (the template stays in the AWS account)",{"_3588":1528,"_30857":1328,"_21381":55178,"_5":14694,"_28049":54650,"_3044":55179},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3588":1529,"_30857":1328,"_21381":55181,"_5":14694,"_28049":54650,"_3044":55182},[],"The full flow from the device's perspective is:",{"_3588":1530,"_30857":1328,"_21381":55184,"_5":14694,"_28049":54650,"_3044":55185},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3588":1531,"_30857":1328,"_21381":55187,"_5":14694,"_28049":54654,"_3044":55188},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3588":1532,"_30857":1328,"_21381":55190,"_5":14694,"_28049":54654,"_3044":55047},[],{"_3588":1533,"_30857":1328,"_21381":55192,"_5":14694,"_28049":54654,"_3044":55050},[],{"_3588":1534,"_30857":1328,"_21381":55194,"_5":14694,"_28049":54654,"_3044":55195},[],"`Absent` → `Provisioned`",{"_3588":1535,"_30857":1328,"_21381":55197,"_5":14694,"_28049":54654,"_3044":55198},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3588":1536,"_30857":1328,"_21381":55200,"_5":14694,"_28049":54654,"_3044":55201},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3588":1537,"_30857":1328,"_21381":55203,"_5":14694,"_28049":54654,"_3044":55204},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3588":1538,"_30857":1328,"_21381":55206,"_5":14694,"_28049":54654,"_3044":55207},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3588":1539,"_30857":1328,"_21381":55209,"_5":14694,"_28049":54658,"_3044":55210},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3588":1540,"_30857":1328,"_21381":55212,"_5":14694,"_28049":54658,"_3044":55213},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3588":1541,"_30857":1328,"_21381":55215,"_5":14694,"_28049":54658,"_3044":55216},[],"For the JITP flow to work correctly:",{"_3588":1542,"_30857":1328,"_21381":55218,"_5":14694,"_28049":54658,"_3044":55219},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3588":1543,"_30857":1328,"_21381":55221,"_5":14694,"_28049":54658,"_3044":55222},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3588":1544,"_30857":1328,"_21381":55224,"_5":14694,"_28049":54658,"_3044":55225},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3588":1545,"_30857":1328,"_21381":55227,"_5":14694,"_28049":54658,"_3044":55228},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3588":1546,"_30857":1328,"_21381":55230,"_5":14694,"_28049":54662,"_3044":55231},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3588":1547,"_30857":1328,"_21381":55233,"_5":14694,"_28049":54662,"_3044":55234},[],"Status in Lamassu",{"_3588":1548,"_30857":1328,"_21381":55236,"_5":14694,"_28049":54662,"_3044":55237},[],"Revocation reason",{"_3588":1549,"_30857":1328,"_21381":55239,"_5":14694,"_28049":54662,"_3044":55240},[],"Status in AWS IoT Core",{"_3588":1550,"_30857":1328,"_21381":55242,"_5":14694,"_28049":54662,"_3044":55243},[],"`Active`",{"_3588":1551,"_30857":1328,"_21381":55245,"_5":14694,"_28049":54662,"_3044":55246},[],"None",{"_3588":1552,"_30857":1328,"_21381":55248,"_5":14694,"_28049":54662,"_3044":55249},[],"`ACTIVE`",{"_3588":1553,"_30857":1328,"_21381":55251,"_5":14694,"_28049":54662,"_3044":55252},[],"`Revoked`",{"_3588":1554,"_30857":1328,"_21381":55254,"_5":14694,"_28049":54662,"_3044":55255},[],"`certificateHold`",{"_3588":1555,"_30857":1328,"_21381":55257,"_5":14694,"_28049":54662,"_3044":55258},[],"`INACTIVE`",{"_3588":1556,"_30857":1328,"_21381":55260,"_5":14694,"_28049":54662,"_3044":55252},[],{"_3588":1557,"_30857":1328,"_21381":55262,"_5":14694,"_28049":54662,"_3044":55263},[],"Any other reason",{"_3588":1558,"_30857":1328,"_21381":55265,"_5":14694,"_28049":54662,"_3044":55266},[],"`REVOKED`",{"_3588":1559,"_30857":1328,"_21381":55268,"_5":14694,"_28049":54662,"_3044":55269},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3588":1560,"_30857":1328,"_21381":55271,"_5":14694,"_28049":54666,"_3044":55272},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3588":1561,"_30857":1328,"_21381":55274,"_5":14694,"_28049":54666,"_3044":55047},[],{"_3588":1562,"_30857":1328,"_21381":55276,"_5":14694,"_28049":54666,"_3044":55050},[],{"_3588":1563,"_30857":1328,"_21381":55278,"_5":14694,"_28049":54666,"_3044":55279},[],"`NotSynced` → `Active`",{"_3588":1564,"_30857":1328,"_21381":55281,"_5":14694,"_28049":54666,"_3044":54758},[],{"_3588":1565,"_30857":1328,"_21381":55283,"_5":14694,"_28049":54666,"_3044":55284},[],"`Active` → `Inactive`",{"_3588":1566,"_30857":1328,"_21381":55286,"_5":14694,"_28049":54666,"_3044":55287},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3588":1567,"_30857":1328,"_21381":55289,"_5":14694,"_28049":54666,"_3044":55290},[],"`Active` → `Revoked`",{"_3588":1568,"_30857":1328,"_21381":55292,"_5":14694,"_28049":54666,"_3044":55287},[],{"_3588":1569,"_30857":1328,"_21381":55294,"_5":14694,"_28049":54666,"_3044":55295},[],"`Inactive` / `Revoked` → `Active`",{"_3588":1570,"_30857":1328,"_21381":55297,"_5":14694,"_28049":54666,"_3044":54758},[],{"_3588":1571,"_30857":1328,"_21381":55299,"_5":14694,"_28049":54666,"_3044":55300},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3588":1572,"_30857":1328,"_21381":55302,"_5":14694,"_28049":54666,"_3044":55303},[],"none (these states are not synced to AWS)",{"_3588":1573,"_30857":1328,"_21381":55305,"_5":14694,"_28049":54670,"_3044":55306},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3588":1574,"_30857":1328,"_21381":55308,"_5":14694,"_28049":54670,"_3044":55309},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3588":1575,"_30857":1328,"_21381":55311,"_5":14694,"_28049":54670,"_3044":55312},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3588":1576,"_30857":1328,"_21381":55314,"_5":14694,"_28049":54674,"_3044":55315},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3588":1577,"_30857":1328,"_21381":55317,"_5":14694,"_28049":54674,"_3044":55318},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3588":1578,"_30857":1328,"_21381":55320,"_5":14694,"_28049":54678,"_3044":55321},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3588":1579,"_30857":1328,"_21381":55323,"_5":14694,"_28049":54678,"_3044":55324},[],"There are two action types:",{"_3588":1580,"_30857":1328,"_21381":55326,"_5":14694,"_28049":54678,"_3044":55327},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3588":1581,"_30857":1328,"_21381":55329,"_5":14694,"_28049":54678,"_3044":55330},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3588":1582,"_30857":1328,"_21381":55332,"_5":14694,"_28049":54678,"_3044":55333},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3588":1583,"_30857":1328,"_21381":55335,"_5":14694,"_28049":54682,"_3044":55336},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3588":1584,"_30857":1328,"_21381":55338,"_5":14694,"_28049":54682,"_3044":55339},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3588":1585,"_30857":1328,"_21381":55341,"_5":14694,"_28049":54682,"_3044":55342},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3588":1586,"_30857":1328,"_21381":55344,"_5":14694,"_28049":54686,"_3044":55345},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3588":1587,"_30857":1328,"_21381":55347,"_5":14694,"_28049":54686,"_3044":55348},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3588":1588,"_30857":1328,"_21381":55350,"_5":14694,"_28049":54686,"_3044":55351},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3588":1589,"_30857":1328,"_21381":55353,"_5":14694,"_28049":54686,"_3044":55354},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3588":1590,"_30857":1328,"_21381":55356,"_5":14694,"_28049":54686,"_3044":55357},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3588":1591,"_30857":1328,"_21381":55359,"_5":14694,"_28049":54686,"_3044":55360},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3588":1592,"_30857":1328,"_21381":55362,"_5":14694,"_28049":54686,"_3044":55363},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3588":1593,"_30857":1328,"_21381":55365,"_5":14694,"_28049":54686,"_3044":55366},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3588":1594,"_30857":1328,"_21381":55368,"_5":14694,"_28049":54686,"_3044":55369},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3588":1595,"_30857":1328,"_21381":55371,"_5":14694,"_28049":54686,"_3044":55372},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3588":1596,"_30857":1328,"_21381":55374,"_5":14694,"_28049":54686,"_3044":55375},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3588":1597,"_30857":1328,"_21381":55377,"_5":14694,"_28049":54686,"_3044":55378},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3588":1598,"_30857":1328,"_21381":55380,"_5":14694,"_28049":54686,"_3044":55381},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3588":1599,"_30857":1328,"_21381":55383,"_5":14694,"_28049":54686,"_3044":55384},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3588":1600,"_30857":1328,"_21381":55386,"_5":14694,"_28049":54686,"_3044":55387},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3588":1601,"_30857":1328,"_21381":55389,"_5":14694,"_28049":54686,"_3044":55390},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3588":1602,"_30857":1328,"_21381":55392,"_5":14694,"_28049":54686,"_3044":55393},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3588":1603,"_30857":1328,"_21381":55395,"_5":14694,"_28049":54686,"_3044":55396},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3588":1604,"_30857":1328,"_21381":55398,"_5":14694,"_28049":54686,"_3044":55399},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3588":1605,"_30857":1328,"_21381":55401,"_5":14694,"_28049":54686,"_3044":55402},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3588":1606,"_30857":1328,"_21381":55404,"_5":14694,"_28049":54686,"_3044":55405},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3588":1607,"_30857":1328,"_21381":55407,"_5":14694,"_28049":54686,"_3044":55408},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3588":1608,"_30857":1328,"_21381":55410,"_5":14694,"_28049":54686,"_3044":55411},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3588":1609,"_30857":1328,"_21381":55413,"_5":14694,"_28049":54686,"_3044":55414},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3588":1610,"_30857":1610,"_5":15054,"_3044":53121,"_31216":55416,"_21381":55417,"_28049":1610},[50449,51961,53121],[],{"_3588":1611,"_30857":1610,"_21381":55419,"_5":14694,"_28049":1610,"_3044":55420},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3588":1612,"_30857":1610,"_5":31213,"_21381":55422,"_28049":55423,"_3044":55424},[],"/docs/pr-preview/pr-70/platform/iot-fleets/overview#start-here","Start here",{"_3588":1613,"_30857":1610,"_5":31213,"_21381":55426,"_28049":55427,"_3044":53119},[],"/docs/pr-preview/pr-70/platform/iot-fleets/overview#devices-and-identities",{"_3588":1614,"_30857":1610,"_5":31213,"_21381":55429,"_28049":55430,"_3044":53302},[],"/docs/pr-preview/pr-70/platform/iot-fleets/overview#enrollment-with-pki",{"_3588":1615,"_30857":1610,"_5":31213,"_21381":55432,"_28049":55433,"_3044":54583},[],"/docs/pr-preview/pr-70/platform/iot-fleets/overview#integrations",{"_3588":1616,"_30857":1610,"_5":31213,"_21381":55435,"_28049":55436,"_3044":55437},[],"/docs/pr-preview/pr-70/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3588":1617,"_30857":1610,"_21381":55439,"_5":14694,"_28049":1610,"_3044":55440},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3588":1618,"_30857":1610,"_21381":55442,"_5":14694,"_28049":55423,"_3044":55443},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3588":1619,"_30857":1610,"_21381":55445,"_5":14694,"_28049":55423,"_3044":55446},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3588":1620,"_30857":1610,"_21381":55448,"_5":14694,"_28049":55427,"_3044":55449},[],"Resource",{"_3588":1621,"_30857":1610,"_21381":55451,"_5":14694,"_28049":55427,"_3044":55452},[],"What it represents",{"_3588":1622,"_30857":1610,"_21381":55454,"_5":14694,"_28049":55427,"_3044":55455},[],"**Device**",{"_3588":1623,"_30857":1610,"_21381":55457,"_5":14694,"_28049":55427,"_3044":55458},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3588":1624,"_30857":1610,"_21381":55460,"_5":14694,"_28049":55427,"_3044":55461},[],"**Identity**",{"_3588":1625,"_30857":1610,"_21381":55463,"_5":14694,"_28049":55427,"_3044":55464},[],"The device's association with its certificates: an active version and a history.",{"_3588":1626,"_30857":1610,"_21381":55466,"_5":14694,"_28049":55427,"_3044":55467},[],"**DMS**",{"_3588":1627,"_30857":1610,"_21381":55469,"_5":14694,"_28049":55427,"_3044":55470},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3588":1628,"_30857":1610,"_21381":55472,"_5":14694,"_28049":55427,"_3044":55473},[],"**Fleet**",{"_3588":1629,"_30857":1610,"_21381":55475,"_5":14694,"_28049":55427,"_3044":55476},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3588":1630,"_30857":1610,"_21381":55478,"_5":14694,"_28049":55427,"_3044":55479},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3588":1631,"_30857":1610,"_21381":55481,"_5":14694,"_28049":55427,"_3044":55482},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3588":1632,"_30857":1610,"_21381":55484,"_5":14694,"_28049":55430,"_3044":55485},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3588":1633,"_30857":1610,"_21381":55487,"_5":14694,"_28049":55430,"_3044":55488},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3588":1634,"_30857":1610,"_21381":55490,"_5":14694,"_28049":55430,"_3044":55491},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3588":1635,"_30857":1610,"_21381":55493,"_5":14694,"_28049":55430,"_3044":55494},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3588":1636,"_30857":1610,"_21381":55496,"_5":14694,"_28049":55430,"_3044":55497},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3588":1637,"_30857":1610,"_21381":55499,"_5":14694,"_28049":55430,"_3044":55500},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3588":1638,"_30857":1610,"_21381":55502,"_5":14694,"_28049":55430,"_3044":55503},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3588":1639,"_30857":1610,"_21381":55505,"_5":14694,"_28049":55430,"_3044":55506},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3588":1640,"_30857":1610,"_21381":55508,"_5":14694,"_28049":55433,"_3044":55509},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3588":1641,"_30857":1610,"_21381":55511,"_5":14694,"_28049":55433,"_3044":55512},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3588":1642,"_30857":1610,"_21381":55514,"_5":14694,"_28049":55436,"_3044":55515},[],"Participant",{"_3588":1643,"_30857":1610,"_21381":55517,"_5":14694,"_28049":55436,"_3044":55518},[],"Responsibility",{"_3588":1644,"_30857":1610,"_21381":55520,"_5":14694,"_28049":55436,"_3044":55521},[],"PKI administrator",{"_3588":1645,"_30857":1610,"_21381":55523,"_5":14694,"_28049":55436,"_3044":55524},[],"CA, issuance profile, chain and revocation publication.",{"_3588":1646,"_30857":1610,"_21381":55526,"_5":14694,"_28049":55436,"_3044":55527},[],"Provisioning administrator",{"_3588":1647,"_30857":1610,"_21381":55529,"_5":14694,"_28049":55436,"_3044":55530},[],"DMS, admission, authentication per operation and inventory.",{"_3588":1648,"_30857":1610,"_21381":55532,"_5":14694,"_28049":55436,"_3044":55533},[],"Device integrator",{"_3588":1649,"_30857":1610,"_21381":55535,"_5":14694,"_28049":55436,"_3044":55536},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3588":1650,"_30857":1610,"_21381":55538,"_5":14694,"_28049":55436,"_3044":55539},[],"Consumer integrator",{"_3588":1651,"_30857":1610,"_21381":55541,"_5":14694,"_28049":55436,"_3044":55542},[],"Trusted issuers, validation and device permissions in the destination.",{"_3588":1652,"_30857":1610,"_21381":55544,"_5":14694,"_28049":55436,"_3044":55545},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3588":1653,"_30857":1653,"_5":15054,"_3044":55547,"_31216":55548,"_21381":55550,"_28049":1653},"Enroll and connect your first device",[50449,51961,53121,55549],"Getting started",[],{"_3588":1654,"_30857":1653,"_21381":55552,"_5":14694,"_28049":1653,"_3044":55553},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3588":1655,"_30857":1653,"_5":31213,"_21381":55555,"_28049":55556,"_3044":50459},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3588":1656,"_30857":1653,"_5":31213,"_21381":55558,"_28049":55559,"_3044":55560},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3588":1657,"_30857":1653,"_5":31213,"_21381":55562,"_28049":55563,"_3044":55564},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3588":1658,"_30857":1653,"_5":31213,"_21381":55566,"_28049":55567,"_3044":55568},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3588":1659,"_30857":1653,"_5":31213,"_21381":55570,"_28049":55571,"_3044":55572},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3588":1660,"_30857":1653,"_5":31213,"_21381":55574,"_28049":55575,"_3044":55576},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3588":1661,"_30857":1653,"_5":31213,"_21381":55578,"_28049":55579,"_3044":55580},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3588":1662,"_30857":1653,"_5":31213,"_21381":55582,"_28049":55583,"_3044":55584},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3588":1663,"_30857":1653,"_21381":55586,"_5":14694,"_28049":1653,"_3044":55587},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3588":1664,"_30857":1653,"_21381":55589,"_5":14694,"_28049":55556,"_3044":55590},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3588":1665,"_30857":1653,"_21381":55592,"_5":14694,"_28049":55556,"_3044":55593},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3588":1666,"_30857":1653,"_21381":55595,"_5":14694,"_28049":55556,"_3044":55596},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3588":1667,"_30857":1653,"_21381":55598,"_5":14694,"_28049":55556,"_3044":55599},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3588":1668,"_30857":1653,"_21381":55601,"_5":14694,"_28049":55556,"_3044":55602},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3588":1669,"_30857":1653,"_21381":55604,"_5":14694,"_28049":55559,"_3044":55605},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3588":1670,"_30857":1653,"_21381":55607,"_5":14694,"_28049":55559,"_3044":55608},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3588":1671,"_30857":1653,"_21381":55610,"_5":14694,"_28049":55563,"_3044":55611},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3588":1672,"_30857":1653,"_21381":55613,"_5":14694,"_28049":55563,"_3044":55614},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3588":1673,"_30857":1653,"_21381":55616,"_5":14694,"_28049":55563,"_3044":55617},[],"Setting",{"_3588":1674,"_30857":1653,"_21381":55619,"_5":14694,"_28049":55563,"_3044":55620},[],"Evaluation value",{"_3588":1675,"_30857":1653,"_21381":55622,"_5":14694,"_28049":55563,"_3044":55623},[],"Enrollment CA",{"_3588":1676,"_30857":1653,"_21381":55625,"_5":14694,"_28049":55563,"_3044":55626},[],"Issuing root from `device-root.pem`.",{"_3588":1677,"_30857":1653,"_21381":55628,"_5":14694,"_28049":55563,"_3044":53432},[],{"_3588":1678,"_30857":1653,"_21381":55630,"_5":14694,"_28049":55563,"_3044":55631},[],"The 1-hour leaf profile you just prepared.",{"_3588":1679,"_30857":1653,"_21381":55633,"_5":14694,"_28049":55563,"_3044":55634},[],"Protocol / Registration Mode",{"_3588":1680,"_30857":1653,"_21381":55636,"_5":14694,"_28049":55563,"_3044":55637},[],"`EST_RFC7030` / `JITP`.",{"_3588":1681,"_30857":1653,"_21381":55639,"_5":14694,"_28049":55563,"_3044":55640},[],"Verify CSR Signature",{"_3588":1682,"_30857":1653,"_21381":55642,"_5":14694,"_28049":55563,"_3044":55643},[],"Enabled.",{"_3588":1683,"_30857":1653,"_21381":55645,"_5":14694,"_28049":55563,"_3044":55646},[],"Enable Replaceable Enrollment",{"_3588":1684,"_30857":1653,"_21381":55648,"_5":14694,"_28049":55563,"_3044":55649},[],"Disabled; the ID must be new.",{"_3588":1685,"_30857":1653,"_21381":55651,"_5":14694,"_28049":55563,"_3044":55652},[],"Initial authentication",{"_3588":1686,"_30857":1653,"_21381":55654,"_5":14694,"_28049":55563,"_3044":55655},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3588":1687,"_30857":1653,"_21381":55657,"_5":14694,"_28049":55563,"_3044":55658},[],"Renewal authentication",{"_3588":1688,"_30857":1653,"_21381":55660,"_5":14694,"_28049":55563,"_3044":55661},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3588":1689,"_30857":1653,"_21381":55663,"_5":14694,"_28049":55563,"_3044":55664},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3588":1690,"_30857":1653,"_21381":55666,"_5":14694,"_28049":55563,"_3044":55667},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3588":1691,"_30857":1653,"_21381":55669,"_5":14694,"_28049":55563,"_3044":55670},[],"Re-enrollment Delta",{"_3588":1692,"_30857":1653,"_21381":55672,"_5":14694,"_28049":55563,"_3044":55673},[],"1 hour.",{"_3588":1693,"_30857":1653,"_21381":55675,"_5":14694,"_28049":55563,"_3044":55676},[],"Preventive / Critical Delta",{"_3588":1694,"_30857":1653,"_21381":55678,"_5":14694,"_28049":55563,"_3044":55679},[],"30 minutes / 10 minutes.",{"_3588":1695,"_30857":1653,"_21381":55681,"_5":14694,"_28049":55563,"_3044":55682},[],"Revoke on Re-enrollment",{"_3588":1696,"_30857":1653,"_21381":55684,"_5":14694,"_28049":55563,"_3044":55685},[],"Disabled to test the successor before retiring the previous identity.",{"_3588":1697,"_30857":1653,"_21381":55687,"_5":14694,"_28049":55563,"_3044":53440},[],{"_3588":1698,"_30857":1653,"_21381":55689,"_5":14694,"_28049":55563,"_3044":55690},[],"Disabled; the operational key is generated in the client.",{"_3588":1699,"_30857":1653,"_21381":55692,"_5":14694,"_28049":55563,"_3044":55693},[],"CA Distribution",{"_3588":1700,"_30857":1653,"_21381":55695,"_5":14694,"_28049":55563,"_3044":55696},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3588":1701,"_30857":1653,"_21381":55698,"_5":14694,"_28049":55563,"_3044":55699},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3588":1702,"_30857":1653,"_21381":55701,"_5":14694,"_28049":55567,"_3044":55702},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3588":1703,"_30857":1653,"_21381":55704,"_5":14694,"_28049":55567,"_3044":55705},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3588":1704,"_30857":1653,"_21381":55707,"_5":14694,"_28049":55571,"_3044":55708},[],"Generate a new key and CSR with the selected identifier:",{"_3588":1705,"_30857":1653,"_21381":55710,"_5":14694,"_28049":55571,"_3044":55711},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3588":1706,"_30857":1653,"_21381":55713,"_5":14694,"_28049":55571,"_3044":55714},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3588":1707,"_30857":1653,"_21381":55716,"_5":14694,"_28049":55575,"_3044":55717},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3588":1708,"_30857":1653,"_21381":55719,"_5":14694,"_28049":55575,"_3044":55720},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3588":1709,"_30857":1653,"_21381":55722,"_5":14694,"_28049":55579,"_3044":55723},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3588":1710,"_30857":1653,"_21381":55725,"_5":14694,"_28049":55579,"_3044":55726},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3588":1711,"_30857":1653,"_21381":55728,"_5":14694,"_28049":55579,"_3044":55729},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3588":1712,"_30857":1653,"_21381":55731,"_5":14694,"_28049":55579,"_3044":55732},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3588":1713,"_30857":1653,"_21381":55734,"_5":14694,"_28049":55579,"_3044":55735},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3588":1714,"_30857":1653,"_21381":55737,"_5":14694,"_28049":55583,"_3044":55738},[],"Check",{"_3588":1715,"_30857":1653,"_21381":55740,"_5":14694,"_28049":55583,"_3044":55741},[],"Expected result",{"_3588":1716,"_30857":1653,"_21381":55743,"_5":14694,"_28049":55583,"_3044":55744},[],"Registration",{"_3588":1717,"_30857":1653,"_21381":55746,"_5":14694,"_28049":55583,"_3044":55747},[],"ID created automatically and correct DMS.",{"_3588":1718,"_30857":1653,"_21381":55749,"_5":14694,"_28049":55583,"_3044":55005},[],{"_3588":1719,"_30857":1653,"_21381":55751,"_5":14694,"_28049":55583,"_3044":55752},[],"CN, profile, serial and key verified.",{"_3588":1720,"_30857":1653,"_21381":55754,"_5":14694,"_28049":55583,"_3044":55755},[],"Inventory",{"_3588":1721,"_30857":1653,"_21381":55757,"_5":14694,"_28049":55583,"_3044":55758},[],"Received serial visible as the current identity and in history.",{"_3588":1722,"_30857":1653,"_21381":55760,"_5":14694,"_28049":55583,"_3044":55761},[],"Consumer",{"_3588":1723,"_30857":1653,"_21381":55763,"_5":14694,"_28049":55583,"_3044":55764},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3588":1724,"_30857":1653,"_21381":55766,"_5":14694,"_28049":55583,"_3044":55767},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3588":1725,"_30857":1653,"_21381":55769,"_5":14694,"_28049":55583,"_3044":55770},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3588":1726,"_30857":1726,"_5":15054,"_3044":53137,"_31216":55772,"_21381":55773,"_28049":1726},[50449,51961,53121,55549],[],{"_3588":1727,"_30857":1726,"_21381":55775,"_5":14694,"_28049":1726,"_3044":55776},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3588":1728,"_30857":1726,"_5":31213,"_21381":55778,"_28049":55779,"_3044":50459},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3588":1729,"_30857":1726,"_5":31213,"_21381":55781,"_28049":55782,"_3044":55783},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3588":1730,"_30857":1726,"_5":31213,"_21381":55785,"_28049":55786,"_3044":55787},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3588":1731,"_30857":1726,"_5":31213,"_21381":55789,"_28049":55790,"_3044":55791},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3588":1732,"_30857":1726,"_5":31213,"_21381":55793,"_28049":55794,"_3044":55795},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3588":1733,"_30857":1726,"_5":31213,"_21381":55797,"_28049":55798,"_3044":55799},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3588":1734,"_30857":1726,"_5":31213,"_21381":55801,"_28049":55802,"_3044":55741},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3588":1735,"_30857":1726,"_5":31213,"_21381":55804,"_28049":55805,"_3044":55806},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3588":1736,"_30857":1726,"_5":31213,"_21381":55808,"_28049":55809,"_3044":55810},[],"/docs/pr-preview/pr-70/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3588":1737,"_30857":1726,"_21381":55812,"_5":14694,"_28049":1726,"_3044":55813},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3588":1738,"_30857":1726,"_21381":55815,"_5":14694,"_28049":1726,"_3044":55816},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3588":1739,"_30857":1726,"_21381":55818,"_5":14694,"_28049":55779,"_3044":55819},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3588":1740,"_30857":1726,"_21381":55821,"_5":14694,"_28049":55779,"_3044":55822},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3588":1741,"_30857":1726,"_21381":55824,"_5":14694,"_28049":55779,"_3044":55825},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3588":1742,"_30857":1726,"_21381":55827,"_5":14694,"_28049":55779,"_3044":55828},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3588":1743,"_30857":1726,"_21381":55830,"_5":14694,"_28049":55782,"_3044":55831},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3588":1744,"_30857":1726,"_21381":55833,"_5":14694,"_28049":55782,"_3044":55834},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3588":1745,"_30857":1726,"_21381":55836,"_5":14694,"_28049":55782,"_3044":55837},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3588":1746,"_30857":1726,"_21381":55839,"_5":14694,"_28049":55782,"_3044":55840},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3588":1747,"_30857":1726,"_21381":55842,"_5":14694,"_28049":55782,"_3044":55843},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3588":1748,"_30857":1726,"_21381":55845,"_5":14694,"_28049":55782,"_3044":55846},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3588":1749,"_30857":1726,"_21381":55848,"_5":14694,"_28049":55782,"_3044":55849},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3588":1750,"_30857":1726,"_21381":55851,"_5":14694,"_28049":55782,"_3044":55852},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3588":1751,"_30857":1726,"_21381":55854,"_5":14694,"_28049":55786,"_3044":55855},[],"Open **Managed Devices** and the registration action. Complete:",{"_3588":1752,"_30857":1726,"_21381":55857,"_5":14694,"_28049":55786,"_3044":55858},[],"**Device ID**: `device-001`.",{"_3588":1753,"_30857":1726,"_21381":55860,"_5":14694,"_28049":55786,"_3044":55861},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3588":1754,"_30857":1726,"_21381":55863,"_5":14694,"_28049":55786,"_3044":55864},[],"**Icon** and **Tags**: optional classification.",{"_3588":1755,"_30857":1726,"_21381":55866,"_5":14694,"_28049":55786,"_3044":55867},[],"Confirm registration.",{"_3588":1756,"_30857":1726,"_21381":55869,"_5":14694,"_28049":55790,"_3044":55870},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3588":1757,"_30857":1726,"_21381":55872,"_5":14694,"_28049":55790,"_3044":55873},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3588":1758,"_30857":1726,"_21381":55875,"_5":14694,"_28049":55794,"_3044":55876},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3588":1759,"_30857":1726,"_21381":55878,"_5":14694,"_28049":55794,"_3044":55879},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3588":1760,"_30857":1726,"_21381":55881,"_5":14694,"_28049":55798,"_3044":55882},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3588":1761,"_30857":1726,"_21381":55884,"_5":14694,"_28049":55798,"_3044":55885},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3588":1762,"_30857":1726,"_21381":55887,"_5":14694,"_28049":55802,"_3044":55738},[],{"_3588":1763,"_30857":1726,"_21381":55889,"_5":14694,"_28049":55802,"_3044":55890},[],"Result",{"_3588":1764,"_30857":1726,"_21381":55892,"_5":14694,"_28049":55802,"_3044":54988},[],{"_3588":1765,"_30857":1726,"_21381":55894,"_5":14694,"_28049":55802,"_3044":55895},[],"`device-001` appears in inventory with the expected DMS.",{"_3588":1766,"_30857":1726,"_21381":55897,"_5":14694,"_28049":55802,"_3044":55898},[],"Current identity",{"_3588":1767,"_30857":1726,"_21381":55900,"_5":14694,"_28049":55802,"_3044":55901},[],"The associated certificate matches the one you verified in PKI.",{"_3588":1768,"_30857":1726,"_21381":55903,"_5":14694,"_28049":55802,"_3044":55904},[],"History",{"_3588":1769,"_30857":1726,"_21381":55906,"_5":14694,"_28049":55802,"_3044":55907},[],"The associated issuance appears with its serial number and dates.",{"_3588":1770,"_30857":1726,"_21381":55909,"_5":14694,"_28049":55802,"_3044":55910},[],"Key and certificate",{"_3588":1771,"_30857":1726,"_21381":55912,"_5":14694,"_28049":55802,"_3044":55913},[],"You have the verified pair ready to install on the device.",{"_3588":1772,"_30857":1726,"_21381":55915,"_5":14694,"_28049":55805,"_3044":55916},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3588":1773,"_30857":1726,"_21381":55918,"_5":14694,"_28049":55805,"_3044":55919},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3588":1774,"_30857":1726,"_21381":55921,"_5":14694,"_28049":55805,"_3044":55922},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3588":1775,"_30857":1726,"_21381":55924,"_5":14694,"_28049":55805,"_3044":55925},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3588":1776,"_30857":1726,"_21381":55927,"_5":14694,"_28049":55809,"_3044":55928},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3588":1777,"_30857":1726,"_21381":55930,"_5":14694,"_28049":55809,"_3044":55931},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3588":1778,"_30857":1726,"_21381":55933,"_5":14694,"_28049":55809,"_3044":55934},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3588":1779,"_30857":1779,"_5":15054,"_3044":55936,"_31216":55937,"_21381":55938,"_28049":1779},"Lamassu IoT Platform",[50449,51961],[],{"_3588":1780,"_30857":1779,"_21381":55940,"_5":14694,"_28049":1779,"_3044":55941},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3588":1781,"_30857":1779,"_5":31213,"_21381":55943,"_28049":55944,"_3044":55424},[],"/docs/pr-preview/pr-70/platform/overview#start-here",{"_3588":1782,"_30857":1779,"_5":31213,"_21381":55946,"_28049":55947,"_3044":55948},[],"/docs/pr-preview/pr-70/platform/overview#choose-your-path","Choose your path",{"_3588":1783,"_30857":1779,"_5":31213,"_21381":55950,"_28049":55951,"_3044":55952},[],"/docs/pr-preview/pr-70/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3588":1784,"_30857":1779,"_5":31213,"_21381":55954,"_28049":55955,"_3044":55956},[],"/docs/pr-preview/pr-70/platform/overview#core-capabilities","Core capabilities",{"_3588":1785,"_30857":1779,"_5":31213,"_21381":55958,"_28049":55959,"_3044":55960},[],"/docs/pr-preview/pr-70/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3588":1786,"_30857":1779,"_5":31213,"_21381":55962,"_28049":55963,"_3044":55964},[],"/docs/pr-preview/pr-70/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3588":1787,"_30857":1779,"_5":31213,"_21381":55966,"_28049":55967,"_3044":55968},[],"/docs/pr-preview/pr-70/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3588":1788,"_30857":1779,"_5":31213,"_21381":55970,"_28049":55971,"_3044":55972},[],"/docs/pr-preview/pr-70/platform/overview#automate-device-identities","Automate device identities",{"_3588":1789,"_30857":1779,"_5":31213,"_21381":55974,"_28049":55975,"_3044":55976},[],"/docs/pr-preview/pr-70/platform/overview#publish-validation-status","Publish validation status",{"_3588":1790,"_30857":1779,"_5":31213,"_21381":55978,"_28049":55979,"_3044":55980},[],"/docs/pr-preview/pr-70/platform/overview#react-to-events","React to events",{"_3588":1791,"_30857":1779,"_5":31213,"_21381":55982,"_28049":55983,"_3044":55984},[],"/docs/pr-preview/pr-70/platform/overview#operational-reference","Operational reference",{"_3588":1792,"_30857":1779,"_21381":55986,"_5":14694,"_28049":1779,"_3044":55987},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3588":1793,"_30857":1779,"_21381":55989,"_5":14694,"_28049":55944,"_3044":55990},[],"Choose the result you need:",{"_3588":1794,"_30857":1779,"_21381":55992,"_5":14694,"_28049":55944,"_3044":55993},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3588":1795,"_30857":1779,"_21381":55995,"_5":14694,"_28049":55944,"_3044":55996},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3588":1796,"_30857":1779,"_21381":55998,"_5":14694,"_28049":55944,"_3044":55999},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3588":1797,"_30857":1779,"_21381":56001,"_5":14694,"_28049":55947,"_3044":56002},[],"Section",{"_3588":1798,"_30857":1779,"_21381":56004,"_5":14694,"_28049":55947,"_3044":56005},[],"What you manage",{"_3588":1799,"_30857":1779,"_21381":56007,"_5":14694,"_28049":55947,"_3044":56008},[],"Entry point",{"_3588":1800,"_30857":1779,"_21381":56010,"_5":14694,"_28049":55947,"_3044":56011},[],"**PKI**",{"_3588":1801,"_30857":1779,"_21381":56013,"_5":14694,"_28049":55947,"_3044":56014},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3588":1802,"_30857":1779,"_21381":56016,"_5":14694,"_28049":55947,"_3044":56017},[],"PKI overview",{"_3588":1803,"_30857":1779,"_21381":56019,"_5":14694,"_28049":55947,"_3044":56020},[],"**IoT Fleets**",{"_3588":1804,"_30857":1779,"_21381":56022,"_5":14694,"_28049":55947,"_3044":56023},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3588":1805,"_30857":1779,"_21381":56025,"_5":14694,"_28049":55947,"_3044":56026},[],"IoT Fleets overview",{"_3588":1806,"_30857":1779,"_21381":56028,"_5":14694,"_28049":55947,"_3044":56029},[],"**Administration**",{"_3588":1807,"_30857":1779,"_21381":56031,"_5":14694,"_28049":55947,"_3044":56032},[],"Operator permissions, audit and event subscriptions.",{"_3588":1808,"_30857":1779,"_21381":56034,"_5":14694,"_28049":55947,"_3044":51963},[],{"_3588":1809,"_30857":1779,"_21381":56036,"_5":14694,"_28049":55947,"_3044":56037},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3588":1810,"_30857":1779,"_21381":56039,"_5":14694,"_28049":55951,"_3044":56040},[],"An identity's journey connects four responsibilities:",{"_3588":1811,"_30857":1779,"_21381":56042,"_5":14694,"_28049":55951,"_3044":56043},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3588":1812,"_30857":1779,"_21381":56045,"_5":14694,"_28049":55951,"_3044":56046},[],"The provisioning administrator configures the DMS and initial trust.",{"_3588":1813,"_30857":1779,"_21381":56048,"_5":14694,"_28049":55951,"_3044":56049},[],"The device client requests a certificate and installs it with the matching key.",{"_3588":1814,"_30857":1779,"_21381":56051,"_5":14694,"_28049":55951,"_3044":56052},[],"The consumer validates the identity and applies its access permissions.",{"_3588":1815,"_30857":1779,"_21381":56054,"_5":14694,"_28049":55951,"_3044":56055},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3588":1816,"_30857":1779,"_21381":56057,"_5":14694,"_28049":55959,"_3044":56058},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3588":1817,"_30857":1779,"_21381":56060,"_5":14694,"_28049":55963,"_3044":56061},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3588":1818,"_30857":1779,"_21381":56063,"_5":14694,"_28049":55967,"_3044":56064},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3588":1819,"_30857":1779,"_21381":56066,"_5":14694,"_28049":55971,"_3044":56067},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3588":1820,"_30857":1779,"_21381":56069,"_5":14694,"_28049":55975,"_3044":56070},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3588":1821,"_30857":1779,"_21381":56072,"_5":14694,"_28049":55979,"_3044":56073},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3588":1822,"_30857":1779,"_21381":56075,"_5":14694,"_28049":55983,"_3044":55518},[],{"_3588":1823,"_30857":1779,"_21381":56077,"_5":14694,"_28049":55983,"_3044":56078},[],"What it prepares or checks",{"_3588":1824,"_30857":1779,"_21381":56080,"_5":14694,"_28049":55983,"_3044":55521},[],{"_3588":1825,"_30857":1779,"_21381":56082,"_5":14694,"_28049":55983,"_3044":56083},[],"Key custody, CA hierarchy, profiles and validation.",{"_3588":1826,"_30857":1779,"_21381":56085,"_5":14694,"_28049":55983,"_3044":56086},[],"Fleet administrator",{"_3588":1827,"_30857":1779,"_21381":56088,"_5":14694,"_28049":55983,"_3044":56089},[],"DMS, device admission, renewal policy and inventory.",{"_3588":1828,"_30857":1779,"_21381":56091,"_5":14694,"_28049":55983,"_3044":55533},[],{"_3588":1829,"_30857":1779,"_21381":56093,"_5":14694,"_28049":55983,"_3044":56094},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3588":1830,"_30857":1779,"_21381":56096,"_5":14694,"_28049":55983,"_3044":55539},[],{"_3588":1831,"_30857":1779,"_21381":56098,"_5":14694,"_28049":55983,"_3044":56099},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3588":1832,"_30857":1779,"_21381":56101,"_5":14694,"_28049":55983,"_3044":56102},[],"Infrastructure operator",{"_3588":1833,"_30857":1779,"_21381":56104,"_5":14694,"_28049":55983,"_3044":56105},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3588":1834,"_30857":1779,"_21381":56107,"_5":14694,"_28049":55983,"_3044":56108},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3588":1835,"_30857":1835,"_5":15054,"_3044":56110,"_31216":56111,"_21381":56114,"_28049":1835},"CA hierarchy and rotation",[50449,51961,56112,56113],"PKI","Keys, authorities and certificates",[],{"_3588":1836,"_30857":1835,"_21381":56116,"_5":14694,"_28049":1835,"_3044":56117},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3588":1837,"_30857":1835,"_5":31213,"_21381":56119,"_28049":56120,"_3044":56121},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3588":1838,"_30857":1835,"_5":31213,"_21381":56123,"_28049":56124,"_3044":56125},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3588":1839,"_30857":1835,"_5":31213,"_21381":56127,"_28049":56128,"_3044":56129},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3588":1840,"_30857":1835,"_5":31213,"_21381":56131,"_28049":56132,"_3044":56133},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3588":1841,"_30857":1835,"_5":31213,"_21381":56135,"_28049":56136,"_3044":56137},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3588":1842,"_30857":1835,"_5":31213,"_21381":56139,"_28049":56140,"_3044":56141},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3588":1843,"_30857":1835,"_5":31213,"_21381":56143,"_28049":56144,"_3044":56145},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3588":1844,"_30857":1835,"_5":31213,"_21381":56147,"_28049":56148,"_3044":56149},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3588":1845,"_30857":1835,"_5":31213,"_21381":56151,"_28049":56152,"_3044":56153},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3588":1846,"_30857":1835,"_5":31213,"_21381":56155,"_28049":56156,"_3044":56157},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3588":1847,"_30857":1835,"_5":31213,"_21381":56159,"_28049":56160,"_3044":56161},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3588":1848,"_30857":1835,"_5":31213,"_21381":56163,"_28049":56164,"_3044":56165},[],"/docs/pr-preview/pr-70/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3588":1849,"_30857":1835,"_21381":56167,"_5":14694,"_28049":1835,"_3044":56168},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3588":1850,"_30857":1835,"_21381":56170,"_5":14694,"_28049":1835,"_3044":56171},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3588":1851,"_30857":1835,"_21381":56173,"_5":14694,"_28049":56120,"_3044":56174},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3588":1852,"_30857":1835,"_21381":56176,"_5":14694,"_28049":56120,"_3044":56177},[],"environment, such as production and preproduction;",{"_3588":1853,"_30857":1835,"_21381":56179,"_5":14694,"_28049":56120,"_3044":56180},[],"owner or operating team;",{"_3588":1854,"_30857":1835,"_21381":56182,"_5":14694,"_28049":56120,"_3044":56183},[],"device family or manufacturing process;",{"_3588":1855,"_30857":1835,"_21381":56185,"_5":14694,"_28049":56120,"_3044":56186},[],"region or regulatory requirement;",{"_3588":1856,"_30857":1835,"_21381":56188,"_5":14694,"_28049":56120,"_3044":56189},[],"cryptographic engine or key policy;",{"_3588":1857,"_30857":1835,"_21381":56191,"_5":14694,"_28049":56120,"_3044":56192},[],"maintenance window and renewal cadence.",{"_3588":1858,"_30857":1835,"_21381":56194,"_5":14694,"_28049":56120,"_3044":56195},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3588":1859,"_30857":1835,"_21381":56197,"_5":14694,"_28049":56120,"_3044":56198},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3588":1860,"_30857":1835,"_21381":56200,"_5":14694,"_28049":56124,"_3044":56201},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3588":1861,"_30857":1835,"_21381":56203,"_5":14694,"_28049":56124,"_3044":56204},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3588":1862,"_30857":1835,"_21381":56206,"_5":14694,"_28049":56124,"_3044":56207},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3588":1863,"_30857":1835,"_21381":56209,"_5":14694,"_28049":56124,"_3044":56210},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3588":1864,"_30857":1835,"_21381":56212,"_5":14694,"_28049":56128,"_3044":56213},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3588":1865,"_30857":1835,"_21381":56215,"_5":14694,"_28049":56128,"_3044":56216},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3588":1866,"_30857":1835,"_21381":56218,"_5":14694,"_28049":56128,"_3044":56219},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3588":1867,"_30857":1835,"_21381":56221,"_5":14694,"_28049":56128,"_3044":56222},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3588":1868,"_30857":1835,"_21381":56224,"_5":14694,"_28049":56136,"_3044":56225},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3588":1869,"_30857":1835,"_21381":56227,"_5":14694,"_28049":56140,"_3044":56228},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3588":1870,"_30857":1835,"_21381":56230,"_5":14694,"_28049":56144,"_3044":56231},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3588":1871,"_30857":1835,"_21381":56233,"_5":14694,"_28049":56148,"_3044":56234},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3588":1872,"_30857":1835,"_21381":56236,"_5":14694,"_28049":56152,"_3044":56237},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3588":1873,"_30857":1835,"_21381":56239,"_5":14694,"_28049":56156,"_3044":56240},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3588":1874,"_30857":1835,"_21381":56242,"_5":14694,"_28049":56160,"_3044":56243},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3588":1875,"_30857":1835,"_21381":56245,"_5":14694,"_28049":56160,"_3044":56246},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3588":1876,"_30857":1835,"_21381":56248,"_5":14694,"_28049":56160,"_3044":56249},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3588":1877,"_30857":1835,"_21381":56251,"_5":14694,"_28049":56160,"_3044":56252},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3588":1878,"_30857":1835,"_21381":56254,"_5":14694,"_28049":56164,"_3044":56255},[],"The new chain ends in an anchor installed by the consumer.",{"_3588":1879,"_30857":1835,"_21381":56257,"_5":14694,"_28049":56164,"_3044":56258},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3588":1880,"_30857":1835,"_21381":56260,"_5":14694,"_28049":56164,"_3044":56261},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3588":1881,"_30857":1835,"_21381":56263,"_5":14694,"_28049":56164,"_3044":56264},[],"Re-enrollment accepts the old identity during the planned period.",{"_3588":1882,"_30857":1835,"_21381":56266,"_5":14694,"_28049":56164,"_3044":56267},[],"OCSP and CRL respond for the authorities that remain active.",{"_3588":1883,"_30857":1835,"_21381":56269,"_5":14694,"_28049":56164,"_3044":56270},[],"No DMS is left accidentally issuing from the old CA.",{"_3588":1884,"_30857":1835,"_21381":56272,"_5":14694,"_28049":56164,"_3044":56273},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3588":1885,"_30857":1885,"_5":15054,"_3044":56275,"_31216":56276,"_21381":56277,"_28049":1885},"Certification authorities",[50449,51961,56112,56113],[],{"_3588":1886,"_30857":1885,"_21381":56279,"_5":14694,"_28049":1885,"_3044":56280},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3588":1887,"_30857":1885,"_5":31213,"_21381":56282,"_28049":56283,"_3044":56284},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3588":1888,"_30857":1885,"_5":31213,"_21381":56286,"_28049":56287,"_3044":56288},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3588":1889,"_30857":1885,"_5":31213,"_21381":56290,"_28049":56291,"_3044":50459},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#before-you-begin",{"_3588":1890,"_30857":1885,"_5":31213,"_21381":56293,"_28049":56294,"_3044":56295},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3588":1891,"_30857":1885,"_5":31213,"_21381":56297,"_28049":56298,"_3044":56299},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3588":1892,"_30857":1885,"_5":31213,"_21381":56301,"_28049":56302,"_3044":56303},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3588":1893,"_30857":1885,"_5":31213,"_21381":56305,"_28049":56306,"_3044":56307},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3588":1894,"_30857":1885,"_5":31213,"_21381":56309,"_28049":56310,"_3044":56311},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3588":1895,"_30857":1885,"_5":31213,"_21381":56313,"_28049":56314,"_3044":56315},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3588":1896,"_30857":1885,"_5":31213,"_21381":56317,"_28049":56318,"_3044":56319},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3588":1897,"_30857":1885,"_5":31213,"_21381":56321,"_28049":56322,"_3044":56323},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3588":1898,"_30857":1885,"_5":31213,"_21381":56325,"_28049":56326,"_3044":56327},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3588":1899,"_30857":1885,"_5":31213,"_21381":56329,"_28049":56330,"_3044":56331},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3588":1900,"_30857":1885,"_5":31213,"_21381":56333,"_28049":56334,"_3044":56335},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3588":1901,"_30857":1885,"_5":31213,"_21381":56337,"_28049":56338,"_3044":56339},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3588":1902,"_30857":1885,"_5":31213,"_21381":56341,"_28049":56342,"_3044":56343},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3588":1903,"_30857":1885,"_5":31213,"_21381":56345,"_28049":56346,"_3044":56347},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3588":1904,"_30857":1885,"_5":31213,"_21381":56349,"_28049":56350,"_3044":56351},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3588":1905,"_30857":1885,"_5":31213,"_21381":56353,"_28049":56354,"_3044":56355},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3588":1906,"_30857":1885,"_5":31213,"_21381":56357,"_28049":56358,"_3044":56359},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3588":1907,"_30857":1885,"_5":31213,"_21381":56361,"_28049":56362,"_3044":56363},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3588":1908,"_30857":1885,"_5":31213,"_21381":56365,"_28049":56366,"_3044":56367},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3588":1909,"_30857":1885,"_5":31213,"_21381":56369,"_28049":56370,"_3044":56371},[],"/docs/pr-preview/pr-70/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3588":1910,"_30857":1885,"_21381":56373,"_5":14694,"_28049":1885,"_3044":56374},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3588":1911,"_30857":1885,"_21381":56376,"_5":14694,"_28049":1885,"_3044":56377},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3588":1912,"_30857":1885,"_21381":56379,"_5":14694,"_28049":1885,"_3044":56380},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3588":1913,"_30857":1885,"_21381":56382,"_5":14694,"_28049":56283,"_3044":56383},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3588":1914,"_30857":1885,"_21381":56385,"_5":14694,"_28049":56283,"_3044":56386},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3588":1915,"_30857":1885,"_21381":56388,"_5":14694,"_28049":56283,"_3044":56389},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3588":1916,"_30857":1885,"_21381":56391,"_5":14694,"_28049":56283,"_3044":56392},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3588":1917,"_30857":1885,"_21381":56394,"_5":14694,"_28049":56283,"_3044":56395},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3588":1918,"_30857":1885,"_21381":56397,"_5":14694,"_28049":56291,"_3044":56398},[],"Decide whether the CA will be a root or an intermediate.",{"_3588":1919,"_30857":1885,"_21381":56400,"_5":14694,"_28049":56291,"_3044":56401},[],"Choose the engine that will keep the key.",{"_3588":1920,"_30857":1885,"_21381":56403,"_5":14694,"_28049":56291,"_3044":56404},[],"Define a validity longer than that of the certificates it will issue.",{"_3588":1921,"_30857":1885,"_21381":56406,"_5":14694,"_28049":56291,"_3044":56407},[],"For an intermediate CA, make sure the parent CA is active.",{"_3588":1922,"_30857":1885,"_21381":56409,"_5":14694,"_28049":56294,"_3044":56410},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3588":1923,"_30857":1885,"_21381":56412,"_5":14694,"_28049":56298,"_3044":56413},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3588":1924,"_30857":1885,"_21381":56415,"_5":14694,"_28049":56298,"_3044":56416},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3588":1925,"_30857":1885,"_21381":56418,"_5":14694,"_28049":56302,"_3044":56419},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3588":1926,"_30857":1885,"_21381":56421,"_5":14694,"_28049":56306,"_3044":56422},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3588":1927,"_30857":1885,"_21381":56424,"_5":14694,"_28049":56306,"_3044":56425},[],"`C`: two-letter ISO 3166-1 country code.",{"_3588":1928,"_30857":1885,"_21381":56427,"_5":14694,"_28049":56306,"_3044":56428},[],"`ST`: state or province.",{"_3588":1929,"_30857":1885,"_21381":56430,"_5":14694,"_28049":56306,"_3044":56431},[],"`L`: locality.",{"_3588":1930,"_30857":1885,"_21381":56433,"_5":14694,"_28049":56306,"_3044":56434},[],"`O`: organization.",{"_3588":1931,"_30857":1885,"_21381":56436,"_5":14694,"_28049":56306,"_3044":56437},[],"`OU`: organizational unit.",{"_3588":1932,"_30857":1885,"_21381":56439,"_5":14694,"_28049":56306,"_3044":56440},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3588":1933,"_30857":1885,"_21381":56442,"_5":14694,"_28049":56310,"_3044":56443},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3588":1934,"_30857":1885,"_21381":56445,"_5":14694,"_28049":56310,"_3044":56446},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3588":1935,"_30857":1885,"_21381":56448,"_5":14694,"_28049":56314,"_3044":56449},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3588":1936,"_30857":1885,"_21381":56451,"_5":14694,"_28049":56314,"_3044":56452},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3588":1937,"_30857":1885,"_21381":56454,"_5":14694,"_28049":56318,"_3044":56455},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3588":1938,"_30857":1885,"_21381":56457,"_5":14694,"_28049":56318,"_3044":56458},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3588":1939,"_30857":1885,"_21381":56460,"_5":14694,"_28049":56322,"_3044":56461},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3588":1940,"_30857":1885,"_21381":56463,"_5":14694,"_28049":56322,"_3044":56464},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3588":1941,"_30857":1885,"_21381":56466,"_5":14694,"_28049":56322,"_3044":56467},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3588":1942,"_30857":1885,"_21381":56469,"_5":14694,"_28049":56326,"_3044":56470},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3588":1943,"_30857":1885,"_21381":56472,"_5":14694,"_28049":56330,"_3044":56473},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3588":1944,"_30857":1885,"_21381":56475,"_5":14694,"_28049":56330,"_3044":56476},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3588":1945,"_30857":1885,"_21381":56478,"_5":14694,"_28049":56334,"_3044":56479},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3588":1946,"_30857":1885,"_21381":56481,"_5":14694,"_28049":56338,"_3044":56482},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3588":1947,"_30857":1885,"_21381":56484,"_5":14694,"_28049":56338,"_3044":56485},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3588":1948,"_30857":1885,"_21381":56487,"_5":14694,"_28049":56342,"_3044":56488},[],"Open a CA from the inventory to review:",{"_3588":1949,"_30857":1885,"_21381":56490,"_5":14694,"_28049":56342,"_3044":56491},[],"Status and validity period.",{"_3588":1950,"_30857":1885,"_21381":56493,"_5":14694,"_28049":56342,"_3044":56494},[],"Certificate and chain in PEM format.",{"_3588":1951,"_30857":1885,"_21381":56496,"_5":14694,"_28049":56342,"_3044":56497},[],"Number of active, expired and revoked certificates.",{"_3588":1952,"_30857":1885,"_21381":56499,"_5":14694,"_28049":56342,"_3044":56500},[],"Certificates issued in **Issued Certificates**.",{"_3588":1953,"_30857":1885,"_21381":56502,"_5":14694,"_28049":56342,"_3044":56503},[],"The CRL linked to the authority.",{"_3588":1954,"_30857":1885,"_21381":56505,"_5":14694,"_28049":56342,"_3044":56506},[],"Metadata and the associated cryptographic engine.",{"_3588":1955,"_30857":1885,"_21381":56508,"_5":14694,"_28049":56342,"_3044":56509},[],"You can filter the inventory by name, status and CA type.",{"_3588":1956,"_30857":1885,"_21381":56511,"_5":14694,"_28049":56346,"_3044":56512},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3588":1957,"_30857":1885,"_21381":56514,"_5":14694,"_28049":56346,"_3044":56515},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3588":1958,"_30857":1885,"_21381":56517,"_5":14694,"_28049":56346,"_3044":56518},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3588":1959,"_30857":1885,"_21381":56520,"_5":14694,"_28049":56346,"_3044":56521},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3588":1960,"_30857":1885,"_21381":56523,"_5":14694,"_28049":56350,"_3044":56524},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3588":1961,"_30857":1885,"_21381":56526,"_5":14694,"_28049":56354,"_3044":56527},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3588":1962,"_30857":1885,"_21381":56529,"_5":14694,"_28049":56358,"_3044":56530},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3588":1963,"_30857":1885,"_21381":56532,"_5":14694,"_28049":56362,"_3044":56533},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3588":1964,"_30857":1885,"_21381":56535,"_5":14694,"_28049":56366,"_3044":56536},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3588":1965,"_30857":1885,"_21381":56538,"_5":14694,"_28049":56370,"_3044":56539},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3588":1966,"_30857":1885,"_21381":56541,"_5":14694,"_28049":56370,"_3044":56542},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3588":1967,"_30857":1885,"_21381":56544,"_5":14694,"_28049":56370,"_3044":56545},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3588":1968,"_30857":1885,"_21381":56547,"_5":14694,"_28049":56370,"_3044":56548},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3588":1969,"_30857":1969,"_5":15054,"_3044":56550,"_31216":56551,"_21381":56552,"_28049":1969},"Certificate profiles",[50449,51961,56112,56113],[],{"_3588":1970,"_30857":1969,"_21381":56554,"_5":14694,"_28049":1969,"_3044":56555},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3588":1971,"_30857":1969,"_5":31213,"_21381":56557,"_28049":56558,"_3044":56559},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3588":1972,"_30857":1969,"_5":31213,"_21381":56561,"_28049":56562,"_3044":56563},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#validity","Validity",{"_3588":1973,"_30857":1969,"_5":31213,"_21381":56565,"_28049":56566,"_3044":56567},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3588":1974,"_30857":1969,"_5":31213,"_21381":56569,"_28049":56570,"_3044":56571},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3588":1975,"_30857":1969,"_5":31213,"_21381":56573,"_28049":56574,"_3044":56575},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#subject","Subject",{"_3588":1976,"_30857":1969,"_5":31213,"_21381":56577,"_28049":56578,"_3044":56579},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3588":1977,"_30857":1969,"_5":31213,"_21381":56581,"_28049":56582,"_3044":56583},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3588":1978,"_30857":1969,"_5":31213,"_21381":56585,"_28049":56586,"_3044":56587},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3588":1979,"_30857":1969,"_5":31213,"_21381":56589,"_28049":56590,"_3044":56591},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3588":1980,"_30857":1969,"_5":31213,"_21381":56593,"_28049":56594,"_3044":56595},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3588":1981,"_30857":1969,"_5":31213,"_21381":56597,"_28049":56598,"_3044":56599},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3588":1982,"_30857":1969,"_5":31213,"_21381":56601,"_28049":56602,"_3044":56603},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3588":1983,"_30857":1969,"_5":31213,"_21381":56605,"_28049":56606,"_3044":56607},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3588":1984,"_30857":1969,"_5":31213,"_21381":56609,"_28049":56610,"_3044":56611},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3588":1985,"_30857":1969,"_5":31213,"_21381":56613,"_28049":56614,"_3044":56615},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#design-examples","Design examples",{"_3588":1986,"_30857":1969,"_5":31213,"_21381":56617,"_28049":56618,"_3044":56619},[],"/docs/pr-preview/pr-70/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3588":1987,"_30857":1969,"_21381":56621,"_5":14694,"_28049":1969,"_3044":56622},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3588":1988,"_30857":1969,"_21381":56624,"_5":14694,"_28049":1969,"_3044":56625},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3588":1989,"_30857":1969,"_21381":56627,"_5":14694,"_28049":56562,"_3044":56628},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3588":1990,"_30857":1969,"_21381":56630,"_5":14694,"_28049":56562,"_3044":56631},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3588":1991,"_30857":1969,"_21381":56633,"_5":14694,"_28049":56566,"_3044":56634},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3588":1992,"_30857":1969,"_21381":56636,"_5":14694,"_28049":56570,"_3044":56637},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3588":1993,"_30857":1969,"_21381":56639,"_5":14694,"_28049":56570,"_3044":56640},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3588":1994,"_30857":1969,"_21381":56642,"_5":14694,"_28049":56570,"_3044":56643},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3588":1995,"_30857":1969,"_21381":56645,"_5":14694,"_28049":56574,"_3044":56646},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3588":1996,"_30857":1969,"_21381":56648,"_5":14694,"_28049":56578,"_3044":56649},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3588":1997,"_30857":1969,"_21381":56651,"_5":14694,"_28049":56578,"_3044":56652},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3588":1998,"_30857":1969,"_21381":56654,"_5":14694,"_28049":56582,"_3044":56655},[],"The cryptographic enforcement can:",{"_3588":1999,"_30857":1969,"_21381":56657,"_5":14694,"_28049":56582,"_3044":56658},[],"allow or block RSA keys;",{"_3588":2000,"_30857":1969,"_21381":56660,"_5":14694,"_28049":56582,"_3044":56661},[],"limit the supported RSA sizes;",{"_3588":2001,"_30857":1969,"_21381":56663,"_5":14694,"_28049":56582,"_3044":56664},[],"allow or block ECDSA keys;",{"_3588":2002,"_30857":1969,"_21381":56666,"_5":14694,"_28049":56582,"_3044":56667},[],"limit the supported ECDSA sizes or curves.",{"_3588":2003,"_30857":1969,"_21381":56669,"_5":14694,"_28049":56582,"_3044":56670},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3588":2004,"_30857":1969,"_21381":56672,"_5":14694,"_28049":56586,"_3044":56673},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3588":2005,"_30857":1969,"_21381":56675,"_5":14694,"_28049":56586,"_3044":53874},[],{"_3588":2006,"_30857":1969,"_21381":56677,"_5":14694,"_28049":56586,"_3044":56678},[],"First choice",{"_3588":2007,"_30857":1969,"_21381":56680,"_5":14694,"_28049":56586,"_3044":56681},[],"Second choice",{"_3588":2008,"_30857":1969,"_21381":56683,"_5":14694,"_28049":56586,"_3044":56684},[],"If neither is supplied",{"_3588":2009,"_30857":1969,"_21381":56686,"_5":14694,"_28049":56586,"_3044":56687},[],"Direct signing with a CA",{"_3588":2010,"_30857":1969,"_21381":56689,"_5":14694,"_28049":56586,"_3044":56690},[],"`issuance_profile` embedded in the request",{"_3588":2011,"_30857":1969,"_21381":56692,"_5":14694,"_28049":56586,"_3044":56693},[],"Request `issuance_profile_id`",{"_3588":2012,"_30857":1969,"_21381":56695,"_5":14694,"_28049":56586,"_3044":56696},[],"CA default profile (`profile_id`).",{"_3588":2013,"_30857":1969,"_21381":56698,"_5":14694,"_28049":56586,"_3044":56699},[],"Issuance through a DMS",{"_3588":2014,"_30857":1969,"_21381":56701,"_5":14694,"_28049":56586,"_3044":56702},[],"`settings.issuance_profile_id`",{"_3588":2015,"_30857":1969,"_21381":56704,"_5":14694,"_28049":56586,"_3044":56705},[],"`settings.issuance_profile` embedded in the DMS",{"_3588":2016,"_30857":1969,"_21381":56707,"_5":14694,"_28049":56586,"_3044":56708},[],"Enrollment CA default profile.",{"_3588":2017,"_30857":1969,"_21381":56710,"_5":14694,"_28049":56586,"_3044":56711},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3588":2018,"_30857":1969,"_21381":56713,"_5":14694,"_28049":56586,"_3044":56714},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3588":2019,"_30857":1969,"_21381":56716,"_5":14694,"_28049":56594,"_3044":56717},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3588":2020,"_30857":1969,"_21381":56719,"_5":14694,"_28049":56598,"_3044":56720},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3588":2021,"_30857":1969,"_21381":56722,"_5":14694,"_28049":56602,"_3044":56723},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3588":2022,"_30857":1969,"_21381":56725,"_5":14694,"_28049":56606,"_3044":56726},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3588":2023,"_30857":1969,"_21381":56728,"_5":14694,"_28049":56610,"_3044":56729},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3588":2024,"_30857":1969,"_21381":56731,"_5":14694,"_28049":56610,"_3044":56732},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3588":2025,"_30857":1969,"_21381":56734,"_5":14694,"_28049":56614,"_3044":56735},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3588":2026,"_30857":1969,"_21381":56737,"_5":14694,"_28049":56614,"_3044":56738},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3588":2027,"_30857":1969,"_21381":56740,"_5":14694,"_28049":56614,"_3044":56741},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3588":2028,"_30857":1969,"_21381":56743,"_5":14694,"_28049":56614,"_3044":56744},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3588":2029,"_30857":1969,"_21381":56746,"_5":14694,"_28049":56618,"_3044":56747},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3588":2030,"_30857":1969,"_21381":56749,"_5":14694,"_28049":56618,"_3044":56750},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3588":2031,"_30857":2031,"_5":15054,"_3044":56752,"_31216":56753,"_21381":56755,"_28049":2031},"Certificate validation",[50449,51961,56112,56754],"Validation",[],{"_3588":2032,"_30857":2031,"_21381":56757,"_5":14694,"_28049":2031,"_3044":56758},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3588":2033,"_30857":2031,"_5":31213,"_21381":56760,"_28049":56761,"_3044":56762},[],"/docs/pr-preview/pr-70/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3588":2034,"_30857":2031,"_5":31213,"_21381":56764,"_28049":56765,"_3044":56766},[],"/docs/pr-preview/pr-70/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3588":2035,"_30857":2031,"_5":31213,"_21381":56768,"_28049":56769,"_3044":56770},[],"/docs/pr-preview/pr-70/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3588":2036,"_30857":2031,"_21381":56772,"_5":14694,"_28049":2031,"_3044":56773},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3588":2037,"_30857":2031,"_21381":56775,"_5":14694,"_28049":56761,"_3044":56776},[],"Verify these criteria together:",{"_3588":2038,"_30857":2031,"_21381":56778,"_5":14694,"_28049":56761,"_3044":55738},[],{"_3588":2039,"_30857":2031,"_21381":56780,"_5":14694,"_28049":56761,"_3044":56781},[],"Required result",{"_3588":2040,"_30857":2031,"_21381":56783,"_5":14694,"_28049":56761,"_3044":56784},[],"Chain and signature",{"_3588":2041,"_30857":2031,"_21381":56786,"_5":14694,"_28049":56761,"_3044":56787},[],"Valid chain to a root deliberately installed in the consumer.",{"_3588":2042,"_30857":2031,"_21381":56789,"_5":14694,"_28049":56761,"_3044":56790},[],"Dates",{"_3588":2043,"_30857":2031,"_21381":56792,"_5":14694,"_28049":56761,"_3044":56793},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3588":2044,"_30857":2031,"_21381":56795,"_5":14694,"_28049":56761,"_3044":51630},[],{"_3588":2045,"_30857":2031,"_21381":56797,"_5":14694,"_28049":56761,"_3044":56798},[],"Name, SAN or identifier matches the expected peer.",{"_3588":2046,"_30857":2031,"_21381":56800,"_5":14694,"_28049":56761,"_3044":50839},[],{"_3588":2047,"_30857":2031,"_21381":56802,"_5":14694,"_28049":56761,"_3044":56803},[],"KU, EKU and constraints permit the specific operation.",{"_3588":2048,"_30857":2031,"_21381":56805,"_5":14694,"_28049":56761,"_3044":56806},[],"Revocation",{"_3588":2049,"_30857":2031,"_21381":56808,"_5":14694,"_28049":56761,"_3044":56809},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3588":2050,"_30857":2031,"_21381":56811,"_5":14694,"_28049":56761,"_3044":56812},[],"Authorization",{"_3588":2051,"_30857":2031,"_21381":56814,"_5":14694,"_28049":56761,"_3044":56815},[],"The application permits that identity to perform the action.",{"_3588":2052,"_30857":2031,"_21381":56817,"_5":14694,"_28049":56761,"_3044":56818},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3588":2053,"_30857":2031,"_21381":56820,"_5":14694,"_28049":56765,"_3044":56821},[],"Mechanism",{"_3588":2054,"_30857":2031,"_21381":56823,"_5":14694,"_28049":56765,"_3044":56824},[],"When to use it",{"_3588":2055,"_30857":2031,"_21381":56826,"_5":14694,"_28049":56765,"_3044":56827},[],"What you must maintain",{"_3588":2056,"_30857":2031,"_21381":56829,"_5":14694,"_28049":56765,"_3044":56830},[],"OCSP",{"_3588":2057,"_30857":2031,"_21381":56832,"_5":14694,"_28049":56765,"_3044":56833},[],"Status query for a specific certificate.",{"_3588":2058,"_30857":2031,"_21381":56835,"_5":14694,"_28049":56765,"_3044":56836},[],"Responder access, signature verification and cache/freshness policy.",{"_3588":2059,"_30857":2031,"_21381":56838,"_5":14694,"_28049":56765,"_3044":56839},[],"CRL",{"_3588":2060,"_30857":2031,"_21381":56841,"_5":14694,"_28049":56765,"_3044":56842},[],"Local checks for many certificates or offline operation.",{"_3588":2061,"_30857":2031,"_21381":56844,"_5":14694,"_28049":56765,"_3044":56845},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3588":2062,"_30857":2031,"_21381":56847,"_5":14694,"_28049":56765,"_3044":56848},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3588":2063,"_30857":2031,"_21381":56850,"_5":14694,"_28049":56765,"_3044":56851},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3588":2064,"_30857":2031,"_21381":56853,"_5":14694,"_28049":56769,"_3044":56854},[],"Accept a current, authorized certificate with a known chain.",{"_3588":2065,"_30857":2031,"_21381":56856,"_5":14694,"_28049":56769,"_3044":56857},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3588":2066,"_30857":2031,"_21381":56859,"_5":14694,"_28049":56769,"_3044":56860},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3588":2067,"_30857":2031,"_21381":56862,"_5":14694,"_28049":56769,"_3044":56863},[],"Check that a new connection with that identity is rejected.",{"_3588":2068,"_30857":2031,"_21381":56865,"_5":14694,"_28049":56769,"_3044":56866},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3588":2069,"_30857":2031,"_21381":56868,"_5":14694,"_28049":56769,"_3044":56869},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3588":2070,"_30857":2031,"_21381":56871,"_5":14694,"_28049":56769,"_3044":56872},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3588":2071,"_30857":2031,"_21381":56874,"_5":14694,"_28049":56769,"_3044":56875},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3588":2072,"_30857":2031,"_21381":56877,"_5":14694,"_28049":56769,"_3044":56878},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3588":2073,"_30857":2073,"_5":15054,"_3044":56880,"_31216":56881,"_21381":56882,"_28049":2073},"Certificates",[50449,51961,56112,56113],[],{"_3588":2074,"_30857":2073,"_21381":56884,"_5":14694,"_28049":2073,"_3044":56885},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3588":2075,"_30857":2073,"_5":31213,"_21381":56887,"_28049":56888,"_3044":56889},[],"/docs/pr-preview/pr-70/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3588":2076,"_30857":2073,"_5":31213,"_21381":56891,"_28049":56892,"_3044":56893},[],"/docs/pr-preview/pr-70/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3588":2077,"_30857":2073,"_5":31213,"_21381":56895,"_28049":56896,"_3044":56897},[],"/docs/pr-preview/pr-70/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3588":2078,"_30857":2073,"_5":31213,"_21381":56899,"_28049":56900,"_3044":56901},[],"/docs/pr-preview/pr-70/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3588":2079,"_30857":2073,"_5":31213,"_21381":56903,"_28049":56904,"_3044":56905},[],"/docs/pr-preview/pr-70/platform/pki/certificates#open-the-action","Open the action",{"_3588":2080,"_30857":2073,"_5":31213,"_21381":56907,"_28049":56908,"_3044":56909},[],"/docs/pr-preview/pr-70/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3588":2081,"_30857":2073,"_5":31213,"_21381":56911,"_28049":56912,"_3044":56913},[],"/docs/pr-preview/pr-70/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3588":2082,"_30857":2073,"_5":31213,"_21381":56915,"_28049":56916,"_3044":56917},[],"/docs/pr-preview/pr-70/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3588":2083,"_30857":2073,"_5":31213,"_21381":56919,"_28049":56920,"_3044":56921},[],"/docs/pr-preview/pr-70/platform/pki/certificates#continue","Continue",{"_3588":2084,"_30857":2073,"_21381":56923,"_5":14694,"_28049":2073,"_3044":56924},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3588":2085,"_30857":2073,"_21381":56926,"_5":14694,"_28049":56888,"_3044":56927},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3588":2086,"_30857":2073,"_21381":56929,"_5":14694,"_28049":56888,"_3044":56930},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3588":2087,"_30857":2073,"_21381":56932,"_5":14694,"_28049":56888,"_3044":56933},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3588":2088,"_30857":2073,"_21381":56935,"_5":14694,"_28049":56888,"_3044":56936},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3588":2089,"_30857":2073,"_21381":56938,"_5":14694,"_28049":56888,"_3044":56939},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3588":2090,"_30857":2073,"_21381":56941,"_5":14694,"_28049":56888,"_3044":56942},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3588":2091,"_30857":2073,"_21381":56944,"_5":14694,"_28049":56888,"_3044":56945},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3588":2092,"_30857":2073,"_21381":56947,"_5":14694,"_28049":56892,"_3044":56948},[],"Download the PEM and inspect it:",{"_3588":2093,"_30857":2073,"_21381":56950,"_5":14694,"_28049":56892,"_3044":56951},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3588":2094,"_30857":2073,"_21381":56953,"_5":14694,"_28049":56896,"_3044":56954},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3588":2095,"_30857":2073,"_21381":56956,"_5":14694,"_28049":56896,"_3044":56957},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3588":2096,"_30857":2073,"_21381":56959,"_5":14694,"_28049":56896,"_3044":56960},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3588":2097,"_30857":2073,"_21381":56962,"_5":14694,"_28049":56896,"_3044":56963},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3588":2098,"_30857":2073,"_21381":56965,"_5":14694,"_28049":56896,"_3044":56966},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3588":2099,"_30857":2073,"_21381":56968,"_5":14694,"_28049":56896,"_3044":56969},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3588":2100,"_30857":2073,"_21381":56971,"_5":14694,"_28049":56896,"_3044":56972},[],"For browser key generation, follow Issue your first certificate.",{"_3588":2101,"_30857":2073,"_21381":56974,"_5":14694,"_28049":56900,"_3044":56975},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3588":2102,"_30857":2073,"_21381":56977,"_5":14694,"_28049":56904,"_3044":56978},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3588":2103,"_30857":2073,"_21381":56980,"_5":14694,"_28049":56908,"_3044":56981},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3588":2104,"_30857":2073,"_21381":56983,"_5":14694,"_28049":56912,"_3044":56984},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3588":2105,"_30857":2073,"_21381":56986,"_5":14694,"_28049":56912,"_3044":56987},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3588":2106,"_30857":2073,"_21381":56989,"_5":14694,"_28049":56912,"_3044":56990},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3588":2107,"_30857":2073,"_21381":56992,"_5":14694,"_28049":56916,"_3044":56993},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3588":2108,"_30857":2073,"_21381":56995,"_5":14694,"_28049":56916,"_3044":56996},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3588":2109,"_30857":2073,"_21381":56998,"_5":14694,"_28049":56916,"_3044":56999},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3588":2110,"_30857":2073,"_21381":57001,"_5":14694,"_28049":56920,"_3044":57002},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3588":2111,"_30857":2073,"_21381":57004,"_5":14694,"_28049":56920,"_3044":57005},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3588":2112,"_30857":2112,"_5":15054,"_3044":57007,"_31216":57008,"_21381":57010,"_28049":2112},"Certificate lifecycle",[50449,51961,56112,57009],"Concepts",[],{"_3588":2113,"_30857":2112,"_21381":57012,"_5":14694,"_28049":2112,"_3044":57013},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3588":2114,"_30857":2112,"_5":31213,"_21381":57015,"_28049":57016,"_3044":57017},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3588":2115,"_30857":2112,"_5":31213,"_21381":57019,"_28049":57020,"_3044":57021},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3588":2116,"_30857":2112,"_5":31213,"_21381":57023,"_28049":57024,"_3044":57025},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3588":2117,"_30857":2112,"_5":31213,"_21381":57027,"_28049":57028,"_3044":57029},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3588":2118,"_30857":2112,"_5":31213,"_21381":57031,"_28049":57032,"_3044":57033},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3588":2119,"_30857":2112,"_5":31213,"_21381":57035,"_28049":57036,"_3044":57037},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3588":2120,"_30857":2112,"_5":31213,"_21381":57039,"_28049":57040,"_3044":57041},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3588":2121,"_30857":2112,"_5":31213,"_21381":57043,"_28049":57044,"_3044":57045},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3588":2122,"_30857":2112,"_5":31213,"_21381":57047,"_28049":57048,"_3044":57049},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3588":2123,"_30857":2112,"_5":31213,"_21381":57051,"_28049":57052,"_3044":57053},[],"/docs/pr-preview/pr-70/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3588":2124,"_30857":2112,"_21381":57055,"_5":14694,"_28049":2112,"_3044":57056},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3588":2125,"_30857":2112,"_21381":57058,"_5":14694,"_28049":57020,"_3044":57059},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3588":2126,"_30857":2112,"_21381":57061,"_5":14694,"_28049":57024,"_3044":57062},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3588":2127,"_30857":2112,"_21381":57064,"_5":14694,"_28049":57028,"_3044":57065},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3588":2128,"_30857":2112,"_21381":57067,"_5":14694,"_28049":57032,"_3044":57068},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3588":2129,"_30857":2112,"_21381":57070,"_5":14694,"_28049":57036,"_3044":57071},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3588":2130,"_30857":2112,"_21381":57073,"_5":14694,"_28049":57040,"_3044":57074},[],"Lamassu persists four X.509 states:",{"_3588":2131,"_30857":2112,"_21381":57076,"_5":14694,"_28049":57040,"_3044":57077},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3588":2132,"_30857":2112,"_21381":57079,"_5":14694,"_28049":57040,"_3044":57080},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3588":2133,"_30857":2112,"_21381":57082,"_5":14694,"_28049":57040,"_3044":57083},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3588":2134,"_30857":2112,"_21381":57085,"_5":14694,"_28049":57040,"_3044":57086},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3588":2135,"_30857":2112,"_21381":57088,"_5":14694,"_28049":57040,"_3044":57089},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3588":2136,"_30857":2112,"_21381":57091,"_5":14694,"_28049":57044,"_3044":57092},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3588":2137,"_30857":2112,"_21381":57094,"_5":14694,"_28049":57044,"_3044":57095},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3588":2138,"_30857":2112,"_21381":57097,"_5":14694,"_28049":57044,"_3044":57098},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3588":2139,"_30857":2112,"_21381":57100,"_5":14694,"_28049":57048,"_3044":57101},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3588":2140,"_30857":2112,"_21381":57103,"_5":14694,"_28049":57048,"_3044":57104},[],"Before confirming:",{"_3588":2141,"_30857":2112,"_21381":57106,"_5":14694,"_28049":57048,"_3044":57107},[],"Identify DMSs, devices and services that trust that chain.",{"_3588":2142,"_30857":2112,"_21381":57109,"_5":14694,"_28049":57048,"_3044":57110},[],"Distribute the new chain of trust.",{"_3588":2143,"_30857":2112,"_21381":57112,"_5":14694,"_28049":57048,"_3044":57113},[],"Reissue the necessary identities.",{"_3588":2144,"_30857":2112,"_21381":57115,"_5":14694,"_28049":57048,"_3044":57116},[],"Check OCSP and CRL from a real consumer.",{"_3588":2145,"_30857":2112,"_21381":57118,"_5":14694,"_28049":57048,"_3044":57119},[],"Revoke the old CA once no legitimate traffic remains.",{"_3588":2146,"_30857":2112,"_21381":57121,"_5":14694,"_28049":57048,"_3044":57122},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3588":2147,"_30857":2112,"_21381":57124,"_5":14694,"_28049":57052,"_3044":57125},[],"Certificates entering the preventive or critical renewal window.",{"_3588":2148,"_30857":2112,"_21381":57127,"_5":14694,"_28049":57052,"_3044":57128},[],"Repeated enrollment or re-enrollment failures.",{"_3588":2149,"_30857":2112,"_21381":57130,"_5":14694,"_28049":57052,"_3044":57131},[],"Status changes and revocation reasons.",{"_3588":2150,"_30857":2112,"_21381":57133,"_5":14694,"_28049":57052,"_3044":57134},[],"OCSP and CRL publication and validity.",{"_3588":2151,"_30857":2112,"_21381":57136,"_5":14694,"_28049":57052,"_3044":57137},[],"Dependencies still presenting a replaced certificate.",{"_3588":2152,"_30857":2112,"_21381":57139,"_5":14694,"_28049":57052,"_3044":57140},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3588":2153,"_30857":2153,"_5":15054,"_3044":57142,"_31216":57143,"_21381":57144,"_28049":2153},"Trust model",[50449,51961,56112,57009],[],{"_3588":2154,"_30857":2153,"_21381":57146,"_5":14694,"_28049":2153,"_3044":57147},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3588":2155,"_30857":2153,"_5":31213,"_21381":57149,"_28049":57150,"_3044":57151},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3588":2156,"_30857":2153,"_5":31213,"_21381":57153,"_28049":57154,"_3044":57155},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3588":2157,"_30857":2153,"_5":31213,"_21381":57157,"_28049":57158,"_3044":57159},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3588":2158,"_30857":2153,"_5":31213,"_21381":57161,"_28049":57162,"_3044":57163},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3588":2159,"_30857":2153,"_5":31213,"_21381":57165,"_28049":57166,"_3044":57167},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3588":2160,"_30857":2153,"_5":31213,"_21381":57169,"_28049":57170,"_3044":57171},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3588":2161,"_30857":2153,"_5":31213,"_21381":57173,"_28049":57174,"_3044":57175},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3588":2162,"_30857":2153,"_5":31213,"_21381":57177,"_28049":57178,"_3044":57179},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3588":2163,"_30857":2153,"_5":31213,"_21381":57181,"_28049":57182,"_3044":57183},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3588":2164,"_30857":2153,"_5":31213,"_21381":57185,"_28049":57186,"_3044":57187},[],"/docs/pr-preview/pr-70/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3588":2165,"_30857":2153,"_21381":57189,"_5":14694,"_28049":2153,"_3044":57190},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3588":2166,"_30857":2153,"_21381":57192,"_5":14694,"_28049":57154,"_3044":57193},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3588":2167,"_30857":2153,"_21381":57195,"_5":14694,"_28049":57158,"_3044":57196},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3588":2168,"_30857":2153,"_21381":57198,"_5":14694,"_28049":57162,"_3044":57199},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3588":2169,"_30857":2153,"_21381":57201,"_5":14694,"_28049":57166,"_3044":57202},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3588":2170,"_30857":2153,"_21381":57204,"_5":14694,"_28049":57170,"_3044":57205},[],"The device proves it can enroll according to the DMS policy.",{"_3588":2171,"_30857":2153,"_21381":57207,"_5":14694,"_28049":57170,"_3044":57208},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3588":2172,"_30857":2153,"_21381":57210,"_5":14694,"_28049":57170,"_3044":57211},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3588":2173,"_30857":2153,"_21381":57213,"_5":14694,"_28049":57170,"_3044":57214},[],"The device installs the certificate and the chain it needs.",{"_3588":2174,"_30857":2153,"_21381":57216,"_5":14694,"_28049":57170,"_3044":57217},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3588":2175,"_30857":2153,"_21381":57219,"_5":14694,"_28049":57170,"_3044":57220},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3588":2176,"_30857":2153,"_21381":57222,"_5":14694,"_28049":57174,"_3044":57223},[],"A DMS relates three sets that are worth designing separately:",{"_3588":2177,"_30857":2153,"_21381":57225,"_5":14694,"_28049":57174,"_3044":57226},[],"**Enrollment CA:** signs the new identities.",{"_3588":2178,"_30857":2153,"_21381":57228,"_5":14694,"_28049":57174,"_3044":57229},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3588":2179,"_30857":2153,"_21381":57231,"_5":14694,"_28049":57174,"_3044":57232},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3588":2180,"_30857":2153,"_21381":57234,"_5":14694,"_28049":57174,"_3044":57235},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3588":2181,"_30857":2153,"_21381":57237,"_5":14694,"_28049":57178,"_3044":57238},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3588":2182,"_30857":2153,"_21381":57240,"_5":14694,"_28049":57178,"_3044":57241},[],"that the current date is between `Not Before` and `Not After`;",{"_3588":2183,"_30857":2153,"_21381":57243,"_5":14694,"_28049":57178,"_3044":57244},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3588":2184,"_30857":2153,"_21381":57246,"_5":14694,"_28049":57178,"_3044":57247},[],"that names, SANs and subject match the expected identity;",{"_3588":2185,"_30857":2153,"_21381":57249,"_5":14694,"_28049":57178,"_3044":57250},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3588":2186,"_30857":2153,"_21381":57252,"_5":14694,"_28049":57178,"_3044":57253},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3588":2187,"_30857":2153,"_21381":57255,"_5":14694,"_28049":57178,"_3044":57256},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3588":2188,"_30857":2153,"_21381":57258,"_5":14694,"_28049":57182,"_3044":57259},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3588":2189,"_30857":2153,"_21381":57261,"_5":14694,"_28049":57186,"_3044":57262},[],"Keep the root out of daily operations, or with very restricted access.",{"_3588":2190,"_30857":2153,"_21381":57264,"_5":14694,"_28049":57186,"_3044":57265},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3588":2191,"_30857":2153,"_21381":57267,"_5":14694,"_28049":57186,"_3044":57268},[],"Assign explicit profiles to every use case.",{"_3588":2192,"_30857":2153,"_21381":57270,"_5":14694,"_28049":57186,"_3044":57271},[],"Distribute the new trust before starting a rotation.",{"_3588":2193,"_30857":2153,"_21381":57273,"_5":14694,"_28049":57186,"_3044":57274},[],"Keep enough overlap to renew a disconnected fleet.",{"_3588":2194,"_30857":2153,"_21381":57276,"_5":14694,"_28049":57186,"_3044":57277},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3588":2195,"_30857":2153,"_21381":57279,"_5":14694,"_28049":57186,"_3044":57280},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3588":2196,"_30857":2196,"_5":15054,"_3044":57282,"_31216":57283,"_21381":57284,"_28049":2196},"Revocation lists (CRL)",[50449,51961,56112,56754],[],{"_3588":2197,"_30857":2196,"_21381":57286,"_5":14694,"_28049":2196,"_3044":57287},[],"Generate and distribute signed lists to validate certificates offline.",{"_3588":2198,"_30857":2196,"_5":31213,"_21381":57289,"_28049":57290,"_3044":57291},[],"/docs/pr-preview/pr-70/platform/pki/crl#crl-settings","CRL settings",{"_3588":2199,"_30857":2196,"_5":31213,"_21381":57293,"_28049":57294,"_3044":57295},[],"/docs/pr-preview/pr-70/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3588":2200,"_30857":2196,"_5":31213,"_21381":57297,"_28049":57298,"_3044":57299},[],"/docs/pr-preview/pr-70/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3588":2201,"_30857":2196,"_5":31213,"_21381":57301,"_28049":57302,"_3044":57303},[],"/docs/pr-preview/pr-70/platform/pki/crl#crl-contents","CRL contents",{"_3588":2202,"_30857":2196,"_5":31213,"_21381":57305,"_28049":57306,"_3044":57307},[],"/docs/pr-preview/pr-70/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3588":2203,"_30857":2196,"_5":31213,"_21381":57309,"_28049":57310,"_3044":57311},[],"/docs/pr-preview/pr-70/platform/pki/crl#crl-settings-api","CRL settings API",{"_3588":2204,"_30857":2196,"_5":31213,"_21381":57313,"_28049":57314,"_3044":57315},[],"/docs/pr-preview/pr-70/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3588":2205,"_30857":2196,"_5":31213,"_21381":57317,"_28049":57318,"_3044":57319},[],"/docs/pr-preview/pr-70/platform/pki/crl#references","References",{"_3588":2206,"_30857":2196,"_21381":57321,"_5":14694,"_28049":2196,"_3044":57322},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3588":2207,"_30857":2196,"_21381":57324,"_5":14694,"_28049":57290,"_3044":57325},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3588":2208,"_30857":2196,"_21381":57327,"_5":14694,"_28049":57290,"_3044":57328},[],"Field",{"_3588":2209,"_30857":2196,"_21381":57330,"_5":14694,"_28049":57290,"_3044":50839},[],{"_3588":2210,"_30857":2196,"_21381":57332,"_5":14694,"_28049":57290,"_3044":52081},[],{"_3588":2211,"_30857":2196,"_21381":57334,"_5":14694,"_28049":57290,"_3044":57335},[],"ID of the CA the settings belong to.",{"_3588":2212,"_30857":2196,"_21381":57337,"_5":14694,"_28049":57290,"_3044":57338},[],"`status`",{"_3588":2213,"_30857":2196,"_21381":57340,"_5":14694,"_28049":57290,"_3044":57341},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3588":2214,"_30857":2196,"_21381":57343,"_5":14694,"_28049":57290,"_3044":57344},[],"`legacy_ski`",{"_3588":2215,"_30857":2196,"_21381":57346,"_5":14694,"_28049":57290,"_3044":57347},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3588":2216,"_30857":2196,"_21381":57349,"_5":14694,"_28049":57290,"_3044":57350},[],"`latest_crl`",{"_3588":2217,"_30857":2196,"_21381":57352,"_5":14694,"_28049":57290,"_3044":57353},[],"Version, validity start and end of the last published list. Read-only.",{"_3588":2218,"_30857":2196,"_21381":57355,"_5":14694,"_28049":57290,"_3044":57356},[],"`crl_options` field",{"_3588":2219,"_30857":2196,"_21381":57358,"_5":14694,"_28049":57290,"_3044":50839},[],{"_3588":2220,"_30857":2196,"_21381":57360,"_5":14694,"_28049":57290,"_3044":57361},[],"Initial value",{"_3588":2221,"_30857":2196,"_21381":57363,"_5":14694,"_28049":57290,"_3044":57364},[],"`validity`",{"_3588":2222,"_30857":2196,"_21381":57366,"_5":14694,"_28049":57290,"_3044":57367},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3588":2223,"_30857":2196,"_21381":57369,"_5":14694,"_28049":57290,"_3044":57370},[],"7 days.",{"_3588":2224,"_30857":2196,"_21381":57372,"_5":14694,"_28049":57290,"_3044":57373},[],"`refresh_interval`",{"_3588":2225,"_30857":2196,"_21381":57375,"_5":14694,"_28049":57290,"_3044":57376},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3588":2226,"_30857":2196,"_21381":57378,"_5":14694,"_28049":57290,"_3044":57379},[],"6 days and 23 hours.",{"_3588":2227,"_30857":2196,"_21381":57381,"_5":14694,"_28049":57290,"_3044":57382},[],"`regenerate_on_revoke`",{"_3588":2228,"_30857":2196,"_21381":57384,"_5":14694,"_28049":57290,"_3044":57385},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3588":2229,"_30857":2196,"_21381":57387,"_5":14694,"_28049":57290,"_3044":57388},[],"`true`.",{"_3588":2230,"_30857":2196,"_21381":57390,"_5":14694,"_28049":57290,"_3044":57391},[],"`signer_serial_number`",{"_3588":2231,"_30857":2196,"_21381":57393,"_5":14694,"_28049":57290,"_3044":57394},[],"Serial number of the existing certificate that signs the CRL.",{"_3588":2232,"_30857":2196,"_21381":57396,"_5":14694,"_28049":57290,"_3044":57397},[],"Serial number of the CA’s current certificate.",{"_3588":2233,"_30857":2196,"_21381":57399,"_5":14694,"_28049":57290,"_3044":57400},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3588":2234,"_30857":2196,"_21381":57402,"_5":14694,"_28049":57290,"_3044":57403},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3588":2235,"_30857":2196,"_21381":57405,"_5":14694,"_28049":57290,"_3044":57406},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3588":2236,"_30857":2196,"_21381":57408,"_5":14694,"_28049":57290,"_3044":57409},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3588":2237,"_30857":2196,"_21381":57411,"_5":14694,"_28049":57290,"_3044":57412},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3588":2238,"_30857":2196,"_21381":57414,"_5":14694,"_28049":57290,"_3044":57415},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3588":2239,"_30857":2196,"_21381":57417,"_5":14694,"_28049":57290,"_3044":57418},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3588":2240,"_30857":2196,"_21381":57420,"_5":14694,"_28049":57290,"_3044":57421},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3588":2241,"_30857":2196,"_21381":57423,"_5":14694,"_28049":57290,"_3044":57424},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3588":2242,"_30857":2196,"_21381":57426,"_5":14694,"_28049":57290,"_3044":57427},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3588":2243,"_30857":2196,"_21381":57429,"_5":14694,"_28049":57290,"_3044":57430},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3588":2244,"_30857":2196,"_21381":57432,"_5":14694,"_28049":57294,"_3044":57433},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3588":2245,"_30857":2196,"_21381":57435,"_5":14694,"_28049":57294,"_3044":57436},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3588":2246,"_30857":2196,"_21381":57438,"_5":14694,"_28049":57294,"_3044":57439},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3588":2247,"_30857":2196,"_21381":57441,"_5":14694,"_28049":57294,"_3044":57442},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3588":2248,"_30857":2196,"_21381":57444,"_5":14694,"_28049":57298,"_3044":57445},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3588":2249,"_30857":2196,"_21381":57447,"_5":14694,"_28049":57298,"_3044":57448},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3588":2250,"_30857":2196,"_21381":57450,"_5":14694,"_28049":57298,"_3044":57451},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3588":2251,"_30857":2196,"_21381":57453,"_5":14694,"_28049":57298,"_3044":57454},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3588":2252,"_30857":2196,"_21381":57456,"_5":14694,"_28049":57298,"_3044":57457},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3588":2253,"_30857":2196,"_21381":57459,"_5":14694,"_28049":57298,"_3044":57460},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3588":2254,"_30857":2196,"_21381":57462,"_5":14694,"_28049":57298,"_3044":57463},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3588":2255,"_30857":2196,"_21381":57465,"_5":14694,"_28049":57298,"_3044":57466},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3588":2256,"_30857":2196,"_21381":57468,"_5":14694,"_28049":57298,"_3044":57469},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3588":2257,"_30857":2196,"_21381":57471,"_5":14694,"_28049":57302,"_3044":57472},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3588":2258,"_30857":2196,"_21381":57474,"_5":14694,"_28049":57302,"_3044":57475},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3588":2259,"_30857":2196,"_21381":57477,"_5":14694,"_28049":57306,"_3044":57478},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3588":2260,"_30857":2196,"_21381":57480,"_5":14694,"_28049":57306,"_3044":57481},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3588":2261,"_30857":2196,"_21381":57483,"_5":14694,"_28049":57306,"_3044":57484},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3588":2262,"_30857":2196,"_21381":57486,"_5":14694,"_28049":57306,"_3044":57487},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3588":2263,"_30857":2196,"_21381":57489,"_5":14694,"_28049":57306,"_3044":57490},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3588":2264,"_30857":2196,"_21381":57492,"_5":14694,"_28049":57310,"_3044":57493},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3588":2265,"_30857":2196,"_21381":57495,"_5":14694,"_28049":57310,"_3044":53877},[],{"_3588":2266,"_30857":2196,"_21381":57497,"_5":14694,"_28049":57310,"_3044":57498},[],"Relative path",{"_3588":2267,"_30857":2196,"_21381":57500,"_5":14694,"_28049":57310,"_3044":53874},[],{"_3588":2268,"_30857":2196,"_21381":57502,"_5":14694,"_28049":57310,"_3044":57503},[],"`GET`",{"_3588":2269,"_30857":2196,"_21381":57505,"_5":14694,"_28049":57310,"_3044":57506},[],"`/v1/crl-settings`",{"_3588":2270,"_30857":2196,"_21381":57508,"_5":14694,"_28049":57310,"_3044":57509},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3588":2271,"_30857":2196,"_21381":57511,"_5":14694,"_28049":57310,"_3044":57503},[],{"_3588":2272,"_30857":2196,"_21381":57513,"_5":14694,"_28049":57310,"_3044":57514},[],"`/v1/crl-settings/{ca-id}`",{"_3588":2273,"_30857":2196,"_21381":57516,"_5":14694,"_28049":57310,"_3044":57517},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3588":2274,"_30857":2196,"_21381":57519,"_5":14694,"_28049":57310,"_3044":57520},[],"`PUT`",{"_3588":2275,"_30857":2196,"_21381":57522,"_5":14694,"_28049":57310,"_3044":57514},[],{"_3588":2276,"_30857":2196,"_21381":57524,"_5":14694,"_28049":57310,"_3044":57525},[],"Replace the CRL configuration of a CA.",{"_3588":2277,"_30857":2196,"_21381":57527,"_5":14694,"_28049":57310,"_3044":57528},[],"`DELETE`",{"_3588":2278,"_30857":2196,"_21381":57530,"_5":14694,"_28049":57310,"_3044":57514},[],{"_3588":2279,"_30857":2196,"_21381":57532,"_5":14694,"_28049":57310,"_3044":57533},[],"Remove the archived CRL settings of a CA.",{"_3588":2280,"_30857":2196,"_21381":57535,"_5":14694,"_28049":57310,"_3044":57536},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3588":2281,"_30857":2196,"_21381":57538,"_5":14694,"_28049":57310,"_3044":57539},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3588":2282,"_30857":2196,"_21381":57541,"_5":14694,"_28049":57310,"_3044":57542},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3588":2283,"_30857":2196,"_21381":57544,"_5":14694,"_28049":57314,"_3044":57545},[],"Symptom",{"_3588":2284,"_30857":2196,"_21381":57547,"_5":14694,"_28049":57314,"_3044":57548},[],"Cause",{"_3588":2285,"_30857":2196,"_21381":57550,"_5":14694,"_28049":57314,"_3044":57551},[],"Action",{"_3588":2286,"_30857":2196,"_21381":57553,"_5":14694,"_28049":57314,"_3044":57554},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3588":2287,"_30857":2196,"_21381":57556,"_5":14694,"_28049":57314,"_3044":57557},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3588":2288,"_30857":2196,"_21381":57559,"_5":14694,"_28049":57314,"_3044":57560},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3588":2289,"_30857":2196,"_21381":57562,"_5":14694,"_28049":57314,"_3044":57563},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3588":2290,"_30857":2196,"_21381":57565,"_5":14694,"_28049":57314,"_3044":57566},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3588":2291,"_30857":2196,"_21381":57568,"_5":14694,"_28049":57314,"_3044":57569},[],"Delete the CA first; deleting it archives its settings.",{"_3588":2292,"_30857":2196,"_21381":57571,"_5":14694,"_28049":57314,"_3044":57572},[],"`PUT` returns 400.",{"_3588":2293,"_30857":2196,"_21381":57574,"_5":14694,"_28049":57314,"_3044":57575},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3588":2294,"_30857":2196,"_21381":57577,"_5":14694,"_28049":57314,"_3044":57578},[],"Set the serial number of a valid certificate of that CA.",{"_3588":2295,"_30857":2196,"_21381":57580,"_5":14694,"_28049":57314,"_3044":57581},[],"`PUT` returns 404.",{"_3588":2296,"_30857":2196,"_21381":57583,"_5":14694,"_28049":57314,"_3044":57584},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3588":2297,"_30857":2196,"_21381":57586,"_5":14694,"_28049":57314,"_3044":57587},[],"Check the CA ID and the signer serial number.",{"_3588":2298,"_30857":2196,"_21381":57589,"_5":14694,"_28049":57314,"_3044":57590},[],"`PUT` returns 400 from a 3.x client.",{"_3588":2299,"_30857":2196,"_21381":57592,"_5":14694,"_28049":57314,"_3044":57593},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3588":2300,"_30857":2196,"_21381":57595,"_5":14694,"_28049":57314,"_3044":57596},[],"Update the client to send the new field.",{"_3588":2301,"_30857":2196,"_21381":57598,"_5":14694,"_28049":57314,"_3044":57599},[],"The CRL does not change after revoking a certificate.",{"_3588":2302,"_30857":2196,"_21381":57601,"_5":14694,"_28049":57314,"_3044":57602},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3588":2303,"_30857":2196,"_21381":57604,"_5":14694,"_28049":57314,"_3044":57605},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3588":2304,"_30857":2196,"_21381":57607,"_5":14694,"_28049":57314,"_3044":57608},[],"A verifier rejects the CRL because of the issuer.",{"_3588":2305,"_30857":2196,"_21381":57610,"_5":14694,"_28049":57314,"_3044":57611},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3588":2306,"_30857":2196,"_21381":57613,"_5":14694,"_28049":57314,"_3044":57614},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3588":2307,"_30857":2196,"_21381":57616,"_5":14694,"_28049":57318,"_3044":57617},[],"RFC 5280: X.509 and CRL profile.",{"_3588":2308,"_30857":2196,"_21381":57619,"_5":14694,"_28049":57318,"_3044":57620},[],"OpenSSL: openssl-crl.",{"_3588":2309,"_30857":2196,"_21381":57622,"_5":14694,"_28049":57318,"_3044":57623},[],"OpenSSL: openssl-verify.",{"_3588":2310,"_30857":2196,"_21381":57625,"_5":14694,"_28049":57318,"_3044":57626},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3588":2311,"_30857":2196,"_21381":57628,"_5":14694,"_28049":57318,"_3044":57629},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3588":2312,"_30857":2312,"_5":15054,"_3044":57631,"_31216":57632,"_21381":57633,"_28049":2312},"Keys and cryptographic engines",[50449,51961,56112,56113],[],{"_3588":2313,"_30857":2312,"_21381":57635,"_5":14694,"_28049":2312,"_3044":57636},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3588":2314,"_30857":2312,"_5":31213,"_21381":57638,"_28049":57639,"_3044":57640},[],"/docs/pr-preview/pr-70/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3588":2315,"_30857":2312,"_5":31213,"_21381":57642,"_28049":57643,"_3044":57644},[],"/docs/pr-preview/pr-70/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3588":2316,"_30857":2312,"_5":31213,"_21381":57646,"_28049":57647,"_3044":57648},[],"/docs/pr-preview/pr-70/platform/pki/key-management#file-system","File System",{"_3588":2317,"_30857":2312,"_5":31213,"_21381":57650,"_28049":57651,"_3044":57652},[],"/docs/pr-preview/pr-70/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3588":2318,"_30857":2312,"_5":31213,"_21381":57654,"_28049":57655,"_3044":57656},[],"/docs/pr-preview/pr-70/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3588":2319,"_30857":2312,"_5":31213,"_21381":57658,"_28049":57659,"_3044":57660},[],"/docs/pr-preview/pr-70/platform/pki/key-management#aws-kms","AWS KMS",{"_3588":2320,"_30857":2312,"_5":31213,"_21381":57662,"_28049":57663,"_3044":57664},[],"/docs/pr-preview/pr-70/platform/pki/key-management#pkcs11","PKCS#11",{"_3588":2321,"_30857":2312,"_5":31213,"_21381":57666,"_28049":57667,"_3044":57668},[],"/docs/pr-preview/pr-70/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3588":2322,"_30857":2312,"_5":31213,"_21381":57670,"_28049":57671,"_3044":57672},[],"/docs/pr-preview/pr-70/platform/pki/key-management#key-inventory","Key inventory",{"_3588":2323,"_30857":2312,"_5":31213,"_21381":57674,"_28049":57675,"_3044":57676},[],"/docs/pr-preview/pr-70/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3588":2324,"_30857":2312,"_5":31213,"_21381":57678,"_28049":57679,"_3044":57680},[],"/docs/pr-preview/pr-70/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3588":2325,"_30857":2312,"_5":31213,"_21381":57682,"_28049":57683,"_3044":57684},[],"/docs/pr-preview/pr-70/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3588":2326,"_30857":2312,"_5":31213,"_21381":57686,"_28049":57687,"_3044":57688},[],"/docs/pr-preview/pr-70/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3588":2327,"_30857":2312,"_5":31213,"_21381":57690,"_28049":57691,"_3044":57692},[],"/docs/pr-preview/pr-70/platform/pki/key-management#view-details","View details",{"_3588":2328,"_30857":2312,"_5":31213,"_21381":57694,"_28049":57695,"_3044":57696},[],"/docs/pr-preview/pr-70/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3588":2329,"_30857":2312,"_5":31213,"_21381":57698,"_28049":57699,"_3044":57700},[],"/docs/pr-preview/pr-70/platform/pki/key-management#sign","Sign",{"_3588":2330,"_30857":2312,"_5":31213,"_21381":57702,"_28049":57703,"_3044":57704},[],"/docs/pr-preview/pr-70/platform/pki/key-management#verify","Verify",{"_3588":2331,"_30857":2312,"_5":31213,"_21381":57706,"_28049":57707,"_3044":57708},[],"/docs/pr-preview/pr-70/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3588":2332,"_30857":2312,"_5":31213,"_21381":57710,"_28049":57711,"_3044":57712},[],"/docs/pr-preview/pr-70/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3588":2333,"_30857":2312,"_5":31213,"_21381":57714,"_28049":57715,"_3044":57716},[],"/docs/pr-preview/pr-70/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3588":2334,"_30857":2312,"_21381":57718,"_5":14694,"_28049":2312,"_3044":57719},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3588":2335,"_30857":2312,"_21381":57721,"_5":14694,"_28049":2312,"_3044":57722},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3588":2336,"_30857":2312,"_21381":57724,"_5":14694,"_28049":57639,"_3044":57725},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3588":2337,"_30857":2312,"_21381":57727,"_5":14694,"_28049":57639,"_3044":57728},[],"In practice, it lets you:",{"_3588":2338,"_30857":2312,"_21381":57730,"_5":14694,"_28049":57639,"_3044":57731},[],"Generate new key pairs from Lamassu IoT.",{"_3588":2339,"_30857":2312,"_21381":57733,"_5":14694,"_28049":57639,"_3044":57734},[],"Import keys created externally.",{"_3588":2340,"_30857":2312,"_21381":57736,"_5":14694,"_28049":57639,"_3044":57737},[],"Delegate custody and cryptographic operations to external engines.",{"_3588":2341,"_30857":2312,"_21381":57739,"_5":14694,"_28049":57639,"_3044":57740},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3588":2342,"_30857":2312,"_21381":57742,"_5":14694,"_28049":57643,"_3044":57743},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3588":2343,"_30857":2312,"_21381":57745,"_5":14694,"_28049":57643,"_3044":57746},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3588":2344,"_30857":2312,"_21381":57748,"_5":14694,"_28049":57643,"_3044":57749},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3588":2345,"_30857":2312,"_21381":57751,"_5":14694,"_28049":57647,"_3044":57752},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3588":2346,"_30857":2312,"_21381":57754,"_5":14694,"_28049":57651,"_3044":57755},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3588":2347,"_30857":2312,"_21381":57757,"_5":14694,"_28049":57651,"_3044":57758},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3588":2348,"_30857":2312,"_21381":57760,"_5":14694,"_28049":57655,"_3044":57761},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3588":2349,"_30857":2312,"_21381":57763,"_5":14694,"_28049":57659,"_3044":57764},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3588":2350,"_30857":2312,"_21381":57766,"_5":14694,"_28049":57663,"_3044":57767},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3588":2351,"_30857":2312,"_21381":57769,"_5":14694,"_28049":57667,"_3044":57770},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3588":2352,"_30857":2312,"_21381":57772,"_5":14694,"_28049":57667,"_3044":57773},[],"Lamassu shows the enabled engines in the console.",{"_3588":2353,"_30857":2312,"_21381":57775,"_5":14694,"_28049":57667,"_3044":57776},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3588":2354,"_30857":2312,"_21381":57778,"_5":14694,"_28049":57667,"_3044":57779},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3588":2355,"_30857":2312,"_21381":57781,"_5":14694,"_28049":57671,"_3044":57782},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3588":2356,"_30857":2312,"_21381":57784,"_5":14694,"_28049":57671,"_3044":57785},[],"The table includes the following fields:",{"_3588":2357,"_30857":2312,"_21381":57787,"_5":14694,"_28049":57671,"_3044":57788},[],"**Name**: descriptive name of the key.",{"_3588":2358,"_30857":2312,"_21381":57790,"_5":14694,"_28049":57671,"_3044":57791},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3588":2359,"_30857":2312,"_21381":57793,"_5":14694,"_28049":57671,"_3044":57794},[],"**Strength**: visual indicator of cryptographic strength.",{"_3588":2360,"_30857":2312,"_21381":57796,"_5":14694,"_28049":57671,"_3044":57797},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3588":2361,"_30857":2312,"_21381":57799,"_5":14694,"_28049":57671,"_3044":57800},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3588":2362,"_30857":2312,"_21381":57802,"_5":14694,"_28049":57671,"_3044":57803},[],"**Aliases**: alternative names associated with the key.",{"_3588":2363,"_30857":2312,"_21381":57805,"_5":14694,"_28049":57671,"_3044":57806},[],"**Tags**: labels for classification and search.",{"_3588":2364,"_30857":2312,"_21381":57808,"_5":14694,"_28049":57671,"_3044":57809},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3588":2365,"_30857":2312,"_21381":57811,"_5":14694,"_28049":57671,"_3044":57812},[],"From this view you also reach the most common actions:",{"_3588":2366,"_30857":2312,"_21381":57814,"_5":14694,"_28049":57671,"_3044":57815},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3588":2367,"_30857":2312,"_21381":57817,"_5":14694,"_28049":57671,"_3044":57818},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3588":2368,"_30857":2312,"_21381":57820,"_5":14694,"_28049":57671,"_3044":57821},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3588":2369,"_30857":2312,"_21381":57823,"_5":14694,"_28049":57671,"_3044":57824},[],"**Delete Key** to remove the key from the system.",{"_3588":2370,"_30857":2312,"_21381":57826,"_5":14694,"_28049":57675,"_3044":57827},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3588":2371,"_30857":2312,"_21381":57829,"_5":14694,"_28049":57679,"_3044":57830},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3588":2372,"_30857":2312,"_21381":57832,"_5":14694,"_28049":57679,"_3044":57833},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3588":2373,"_30857":2312,"_21381":57835,"_5":14694,"_28049":57679,"_3044":57836},[],"**Key Name**: unique and descriptive name.",{"_3588":2374,"_30857":2312,"_21381":57838,"_5":14694,"_28049":57679,"_3044":57839},[],"**Crypto Engine**: engine that will keep the key.",{"_3588":2375,"_30857":2312,"_21381":57841,"_5":14694,"_28049":57679,"_3044":57842},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3588":2376,"_30857":2312,"_21381":57844,"_5":14694,"_28049":57679,"_3044":57845},[],"**Tags**: metadata to classify the key.",{"_3588":2377,"_30857":2312,"_21381":57847,"_5":14694,"_28049":57679,"_3044":57848},[],"**Metadata**: additional information for advanced uses.",{"_3588":2378,"_30857":2312,"_21381":57850,"_5":14694,"_28049":57683,"_3044":57851},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3588":2379,"_30857":2312,"_21381":57853,"_5":14694,"_28049":57683,"_3044":57854},[],"When you have an exportable private key and the destination engine supports import.",{"_3588":2380,"_30857":2312,"_21381":57856,"_5":14694,"_28049":57683,"_3044":57857},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3588":2381,"_30857":2312,"_21381":57859,"_5":14694,"_28049":57683,"_3044":57860},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3588":2382,"_30857":2312,"_21381":57862,"_5":14694,"_28049":57683,"_3044":57863},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3588":2383,"_30857":2312,"_21381":57865,"_5":14694,"_28049":57683,"_3044":57866},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3588":2384,"_30857":2312,"_21381":57868,"_5":14694,"_28049":57683,"_3044":57869},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3588":2385,"_30857":2312,"_21381":57871,"_5":14694,"_28049":57683,"_3044":57872},[],"**Tags**: labels for organization and search.",{"_3588":2386,"_30857":2312,"_21381":57874,"_5":14694,"_28049":57683,"_3044":57875},[],"**Metadata**: additional optional information.",{"_3588":2387,"_30857":2312,"_21381":57877,"_5":14694,"_28049":57683,"_3044":57878},[],"**Private Key (PEM)**: private key in PEM format.",{"_3588":2388,"_30857":2312,"_21381":57880,"_5":14694,"_28049":57683,"_3044":57881},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3588":2389,"_30857":2312,"_21381":57883,"_5":14694,"_28049":57687,"_3044":57884},[],"Each registered key has a detail view and several operational actions.",{"_3588":2390,"_30857":2312,"_21381":57886,"_5":14694,"_28049":57691,"_3044":57887},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3588":2391,"_30857":2312,"_21381":57889,"_5":14694,"_28049":57691,"_3044":57890},[],"The **Overview** tab shows, among others, these fields:",{"_3588":2392,"_30857":2312,"_21381":57892,"_5":14694,"_28049":57691,"_3044":57893},[],"**Key Name**: descriptive name.",{"_3588":2393,"_30857":2312,"_21381":57895,"_5":14694,"_28049":57691,"_3044":57896},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3588":2394,"_30857":2312,"_21381":57898,"_5":14694,"_28049":57691,"_3044":57899},[],"**Tags**: associated labels.",{"_3588":2395,"_30857":2312,"_21381":57901,"_5":14694,"_28049":57691,"_3044":57902},[],"**Aliases**: alternative names.",{"_3588":2396,"_30857":2312,"_21381":57904,"_5":14694,"_28049":57691,"_3044":57905},[],"**Crypto Engine**: engine where the key resides.",{"_3588":2397,"_30857":2312,"_21381":57907,"_5":14694,"_28049":57691,"_3044":57908},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3588":2398,"_30857":2312,"_21381":57910,"_5":14694,"_28049":57691,"_3044":57911},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3588":2399,"_30857":2312,"_21381":57913,"_5":14694,"_28049":57691,"_3044":57914},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3588":2400,"_30857":2312,"_21381":57916,"_5":14694,"_28049":57695,"_3044":57917},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3588":2401,"_30857":2312,"_21381":57919,"_5":14694,"_28049":57695,"_3044":57920},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3588":2402,"_30857":2312,"_21381":57922,"_5":14694,"_28049":57695,"_3044":57923},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3588":2403,"_30857":2312,"_21381":57925,"_5":14694,"_28049":57699,"_3044":57926},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3588":2404,"_30857":2312,"_21381":57928,"_5":14694,"_28049":57699,"_3044":57929},[],"Main fields:",{"_3588":2405,"_30857":2312,"_21381":57931,"_5":14694,"_28049":57699,"_3044":57932},[],"**Algorithm**: signing algorithm available for the key type.",{"_3588":2406,"_30857":2312,"_21381":57934,"_5":14694,"_28049":57699,"_3044":57935},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3588":2407,"_30857":2312,"_21381":57937,"_5":14694,"_28049":57699,"_3044":57938},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3588":2408,"_30857":2312,"_21381":57940,"_5":14694,"_28049":57699,"_3044":57941},[],"**Message**: content to sign.",{"_3588":2409,"_30857":2312,"_21381":57943,"_5":14694,"_28049":57699,"_3044":57944},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3588":2410,"_30857":2312,"_21381":57946,"_5":14694,"_28049":57703,"_3044":57947},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3588":2411,"_30857":2312,"_21381":57949,"_5":14694,"_28049":57703,"_3044":57929},[],{"_3588":2412,"_30857":2312,"_21381":57951,"_5":14694,"_28049":57703,"_3044":57952},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3588":2413,"_30857":2312,"_21381":57954,"_5":14694,"_28049":57703,"_3044":57955},[],"**Message Type**: `Raw` or `Digest`.",{"_3588":2414,"_30857":2312,"_21381":57957,"_5":14694,"_28049":57703,"_3044":57958},[],"**Payload Encoding**: encoding of the message.",{"_3588":2415,"_30857":2312,"_21381":57960,"_5":14694,"_28049":57703,"_3044":57961},[],"**Message**: original message or hash.",{"_3588":2416,"_30857":2312,"_21381":57963,"_5":14694,"_28049":57703,"_3044":57964},[],"**Signature**: signature to check.",{"_3588":2417,"_30857":2312,"_21381":57966,"_5":14694,"_28049":57703,"_3044":57967},[],"**Result**: indicator of the validation result.",{"_3588":2418,"_30857":2312,"_21381":57969,"_5":14694,"_28049":57707,"_3044":57970},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3588":2419,"_30857":2312,"_21381":57972,"_5":14694,"_28049":57707,"_3044":57973},[],"This flow is useful for:",{"_3588":2420,"_30857":2312,"_21381":57975,"_5":14694,"_28049":57707,"_3044":57976},[],"Requesting certificates from an external CA.",{"_3588":2421,"_30857":2312,"_21381":57978,"_5":14694,"_28049":57707,"_3044":57979},[],"Renewing an identity while keeping the same key.",{"_3588":2422,"_30857":2312,"_21381":57981,"_5":14694,"_28049":57707,"_3044":57982},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3588":2423,"_30857":2312,"_21381":57984,"_5":14694,"_28049":57707,"_3044":57985},[],"**Common Name (CN)**: main name of the identity.",{"_3588":2424,"_30857":2312,"_21381":57987,"_5":14694,"_28049":57707,"_3044":57988},[],"**Organization (O)**: organization or company.",{"_3588":2425,"_30857":2312,"_21381":57990,"_5":14694,"_28049":57707,"_3044":57991},[],"**Organizational Unit (OU)**: department or unit.",{"_3588":2426,"_30857":2312,"_21381":57993,"_5":14694,"_28049":57707,"_3044":57994},[],"**Country (C)**: two-letter country code.",{"_3588":2427,"_30857":2312,"_21381":57996,"_5":14694,"_28049":57707,"_3044":57997},[],"**State / Province (ST)**: state or province.",{"_3588":2428,"_30857":2312,"_21381":57999,"_5":14694,"_28049":57707,"_3044":58000},[],"**Locality (L)**: city or locality.",{"_3588":2429,"_30857":2312,"_21381":58002,"_5":14694,"_28049":57707,"_3044":58003},[],"**Email Address**: contact email.",{"_3588":2430,"_30857":2312,"_21381":58005,"_5":14694,"_28049":57707,"_3044":58006},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3588":2431,"_30857":2312,"_21381":58008,"_5":14694,"_28049":57707,"_3044":58009},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3588":2432,"_30857":2312,"_21381":58011,"_5":14694,"_28049":57711,"_3044":58012},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3588":2433,"_30857":2312,"_21381":58014,"_5":14694,"_28049":57711,"_3044":58015},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3588":2434,"_30857":2312,"_21381":58017,"_5":14694,"_28049":57715,"_3044":58018},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3588":2435,"_30857":2312,"_21381":58020,"_5":14694,"_28049":57715,"_3044":58021},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3588":2436,"_30857":2436,"_5":15054,"_3044":58023,"_31216":58024,"_21381":58025,"_28049":2436},"Online validation with OCSP",[50449,51961,56112,56754],[],{"_3588":2437,"_30857":2436,"_21381":58027,"_5":14694,"_28049":2436,"_3044":58028},[],"Query signed status and verify the responder’s response.",{"_3588":2438,"_30857":2436,"_5":31213,"_21381":58030,"_28049":58031,"_3044":58032},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3588":2439,"_30857":2436,"_5":31213,"_21381":58034,"_28049":58035,"_3044":58036},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3588":2440,"_30857":2436,"_5":31213,"_21381":58038,"_28049":58039,"_3044":58040},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3588":2441,"_30857":2436,"_5":31213,"_21381":58042,"_28049":58043,"_3044":58044},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3588":2442,"_30857":2436,"_5":31213,"_21381":58046,"_28049":58047,"_3044":58048},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3588":2443,"_30857":2436,"_5":31213,"_21381":58050,"_28049":58051,"_3044":57319},[],"/docs/pr-preview/pr-70/platform/pki/ocsp#references",{"_3588":2444,"_30857":2436,"_21381":58053,"_5":14694,"_28049":2436,"_3044":58054},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3588":2445,"_30857":2436,"_21381":58056,"_5":14694,"_28049":58031,"_3044":58057},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3588":2446,"_30857":2436,"_21381":58059,"_5":14694,"_28049":58031,"_3044":58060},[],"Record status",{"_3588":2447,"_30857":2436,"_21381":58062,"_5":14694,"_28049":58031,"_3044":58063},[],"Signed response",{"_3588":2448,"_30857":2436,"_21381":58065,"_5":14694,"_28049":58031,"_3044":55249},[],{"_3588":2449,"_30857":2436,"_21381":58067,"_5":14694,"_28049":58031,"_3044":58068},[],"`Good`.",{"_3588":2450,"_30857":2436,"_21381":58070,"_5":14694,"_28049":58031,"_3044":55266},[],{"_3588":2451,"_30857":2436,"_21381":58072,"_5":14694,"_28049":58031,"_3044":58073},[],"`Revoked`, with revocation reason and timestamp.",{"_3588":2452,"_30857":2436,"_21381":58075,"_5":14694,"_28049":58031,"_3044":58076},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3588":2453,"_30857":2436,"_21381":58078,"_5":14694,"_28049":58031,"_3044":58079},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3588":2454,"_30857":2436,"_21381":58081,"_5":14694,"_28049":58031,"_3044":58082},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3588":2455,"_30857":2436,"_21381":58084,"_5":14694,"_28049":58031,"_3044":58085},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3588":2456,"_30857":2436,"_21381":58087,"_5":14694,"_28049":58031,"_3044":58088},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3588":2457,"_30857":2436,"_21381":58090,"_5":14694,"_28049":58035,"_3044":58091},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3588":2458,"_30857":2436,"_21381":58093,"_5":14694,"_28049":58035,"_3044":58094},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3588":2459,"_30857":2436,"_21381":58096,"_5":14694,"_28049":58039,"_3044":58097},[],"The service accepts:",{"_3588":2460,"_30857":2436,"_21381":58099,"_5":14694,"_28049":58039,"_3044":53877},[],{"_3588":2461,"_30857":2436,"_21381":58101,"_5":14694,"_28049":58039,"_3044":58102},[],"VA service path",{"_3588":2462,"_30857":2436,"_21381":58104,"_5":14694,"_28049":58039,"_3044":58105},[],"Format",{"_3588":2463,"_30857":2436,"_21381":58107,"_5":14694,"_28049":58039,"_3044":58108},[],"`POST`",{"_3588":2464,"_30857":2436,"_21381":58110,"_5":14694,"_28049":58039,"_3044":58111},[],"`/ocsp`",{"_3588":2465,"_30857":2436,"_21381":58113,"_5":14694,"_28049":58039,"_3044":58114},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3588":2466,"_30857":2436,"_21381":58116,"_5":14694,"_28049":58039,"_3044":57503},[],{"_3588":2467,"_30857":2436,"_21381":58118,"_5":14694,"_28049":58039,"_3044":58119},[],"`/ocsp/{ocsp_request}`",{"_3588":2468,"_30857":2436,"_21381":58121,"_5":14694,"_28049":58039,"_3044":58122},[],"DER request encoded using padded URL Base64.",{"_3588":2469,"_30857":2436,"_21381":58124,"_5":14694,"_28049":58039,"_3044":58125},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3588":2470,"_30857":2436,"_21381":58127,"_5":14694,"_28049":58043,"_3044":58128},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3588":2471,"_30857":2436,"_21381":58130,"_5":14694,"_28049":58043,"_3044":58131},[],"Generate the request:",{"_3588":2472,"_30857":2436,"_21381":58133,"_5":14694,"_28049":58043,"_3044":58134},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3588":2473,"_30857":2436,"_21381":58136,"_5":14694,"_28049":58043,"_3044":58137},[],"Replace the example URL with the inspected endpoint:",{"_3588":2474,"_30857":2436,"_21381":58139,"_5":14694,"_28049":58043,"_3044":58140},[],"Verify the returned DER:",{"_3588":2475,"_30857":2436,"_21381":58142,"_5":14694,"_28049":58043,"_3044":58143},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3588":2476,"_30857":2436,"_21381":58145,"_5":14694,"_28049":58047,"_3044":58146},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3588":2477,"_30857":2436,"_21381":58148,"_5":14694,"_28049":58047,"_3044":58149},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3588":2478,"_30857":2436,"_21381":58151,"_5":14694,"_28049":58051,"_3044":58152},[],"RFC 6960: OCSP.",{"_3588":2479,"_30857":2436,"_21381":58154,"_5":14694,"_28049":58051,"_3044":58155},[],"OpenSSL: openssl-ocsp.",{"_3588":2480,"_30857":2436,"_21381":58157,"_5":14694,"_28049":58051,"_3044":58158},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3588":2481,"_30857":2436,"_21381":58160,"_5":14694,"_28049":58051,"_3044":57629},[],{"_3588":2482,"_30857":2482,"_5":15054,"_3044":56112,"_31216":58162,"_21381":58163,"_28049":2482},[50449,51961,56112],[],{"_3588":2483,"_30857":2482,"_21381":58165,"_5":14694,"_28049":2482,"_3044":58166},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3588":2484,"_30857":2482,"_5":31213,"_21381":58168,"_28049":58169,"_3044":55424},[],"/docs/pr-preview/pr-70/platform/pki/overview#start-here",{"_3588":2485,"_30857":2482,"_5":31213,"_21381":58171,"_28049":58172,"_3044":58173},[],"/docs/pr-preview/pr-70/platform/pki/overview#what-you-need","What you need",{"_3588":2486,"_30857":2482,"_5":31213,"_21381":58175,"_28049":58176,"_3044":55956},[],"/docs/pr-preview/pr-70/platform/pki/overview#core-capabilities",{"_3588":2487,"_30857":2482,"_5":31213,"_21381":58178,"_28049":58179,"_3044":55960},[],"/docs/pr-preview/pr-70/platform/pki/overview#build-your-trust-hierarchy",{"_3588":2488,"_30857":2482,"_5":31213,"_21381":58181,"_28049":58182,"_3044":55964},[],"/docs/pr-preview/pr-70/platform/pki/overview#protect-cryptographic-keys",{"_3588":2489,"_30857":2482,"_5":31213,"_21381":58184,"_28049":58185,"_3044":55968},[],"/docs/pr-preview/pr-70/platform/pki/overview#issue-and-control-certificates",{"_3588":2490,"_30857":2482,"_5":31213,"_21381":58187,"_28049":58188,"_3044":55976},[],"/docs/pr-preview/pr-70/platform/pki/overview#publish-validation-status",{"_3588":2491,"_30857":2482,"_5":31213,"_21381":58190,"_28049":58191,"_3044":58192},[],"/docs/pr-preview/pr-70/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3588":2492,"_30857":2482,"_5":31213,"_21381":58194,"_28049":58195,"_3044":56921},[],"/docs/pr-preview/pr-70/platform/pki/overview#continue",{"_3588":2493,"_30857":2482,"_21381":58197,"_5":14694,"_28049":2482,"_3044":58198},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3588":2494,"_30857":2482,"_21381":58200,"_5":14694,"_28049":58169,"_3044":58201},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3588":2495,"_30857":2482,"_21381":58203,"_5":14694,"_28049":58169,"_3044":58204},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3588":2496,"_30857":2482,"_21381":58206,"_5":14694,"_28049":58172,"_3044":58207},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3588":2497,"_30857":2482,"_21381":58209,"_5":14694,"_28049":58172,"_3044":58210},[],"An available cryptographic engine to keep the authority's key.",{"_3588":2498,"_30857":2482,"_21381":58212,"_5":14694,"_28049":58172,"_3044":58213},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3588":2499,"_30857":2482,"_21381":58215,"_5":14694,"_28049":58172,"_3044":58216},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3588":2500,"_30857":2482,"_21381":58218,"_5":14694,"_28049":58172,"_3044":58219},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3588":2501,"_30857":2482,"_21381":58221,"_5":14694,"_28049":58179,"_3044":58222},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3588":2502,"_30857":2482,"_21381":58224,"_5":14694,"_28049":58182,"_3044":58225},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3588":2503,"_30857":2482,"_21381":58227,"_5":14694,"_28049":58185,"_3044":58228},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3588":2504,"_30857":2482,"_21381":58230,"_5":14694,"_28049":58188,"_3044":58231},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3588":2505,"_30857":2482,"_21381":58233,"_5":14694,"_28049":58191,"_3044":58234},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3588":2506,"_30857":2482,"_21381":58236,"_5":14694,"_28049":58191,"_3044":58237},[],"its subject and extensions identify the expected client;",{"_3588":2507,"_30857":2482,"_21381":58239,"_5":14694,"_28049":58191,"_3044":58240},[],"its public key matches the client's private key;",{"_3588":2508,"_30857":2482,"_21381":58242,"_5":14694,"_28049":58191,"_3044":58243},[],"its chain reaches a root trusted by the consumer;",{"_3588":2509,"_30857":2482,"_21381":58245,"_5":14694,"_28049":58191,"_3044":58246},[],"its dates and usages allow the operation;",{"_3588":2510,"_30857":2482,"_21381":58248,"_5":14694,"_28049":58191,"_3044":58249},[],"the consumer applies revocation checks and authorization.",{"_3588":2511,"_30857":2482,"_21381":58251,"_5":14694,"_28049":58191,"_3044":58252},[],"The issuance path includes the first independent checks.",{"_3588":2512,"_30857":2482,"_21381":58254,"_5":14694,"_28049":58195,"_3044":58255},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3588":2513,"_30857":2482,"_21381":58257,"_5":14694,"_28049":58195,"_3044":58258},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3588":2514,"_30857":2482,"_21381":58260,"_5":14694,"_28049":58195,"_3044":58261},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3588":2515,"_30857":2515,"_5":15054,"_3044":58263,"_31216":58264,"_21381":58265,"_28049":2515},"Create your first CA",[50449,51961,56112,55549],[],{"_3588":2516,"_30857":2515,"_21381":58267,"_5":14694,"_28049":2515,"_3044":58268},[],"Create an evaluation root and check its certificate before issuing.",{"_3588":2517,"_30857":2515,"_5":31213,"_21381":58270,"_28049":58271,"_3044":50459},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3588":2518,"_30857":2515,"_5":31213,"_21381":58273,"_28049":58274,"_3044":58275},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3588":2519,"_30857":2515,"_5":31213,"_21381":58277,"_28049":58278,"_3044":58279},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3588":2520,"_30857":2515,"_5":31213,"_21381":58281,"_28049":58282,"_3044":58283},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3588":2521,"_30857":2515,"_5":31213,"_21381":58285,"_28049":58286,"_3044":58287},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3588":2522,"_30857":2515,"_5":31213,"_21381":58289,"_28049":58290,"_3044":58291},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3588":2523,"_30857":2515,"_5":31213,"_21381":58293,"_28049":58294,"_3044":58295},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3588":2524,"_30857":2515,"_5":31213,"_21381":58297,"_28049":58298,"_3044":55806},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3588":2525,"_30857":2515,"_5":31213,"_21381":58300,"_28049":58301,"_3044":50483},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3588":2526,"_30857":2515,"_21381":58303,"_5":14694,"_28049":2515,"_3044":58304},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3588":2527,"_30857":2515,"_21381":58306,"_5":14694,"_28049":58271,"_3044":58307},[],"Console access and permission to create keys and authorities.",{"_3588":2528,"_30857":2515,"_21381":58309,"_5":14694,"_28049":58271,"_3044":58310},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3588":2529,"_30857":2515,"_21381":58312,"_5":14694,"_28049":58271,"_3044":58313},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3588":2530,"_30857":2515,"_21381":58315,"_5":14694,"_28049":58271,"_3044":58316},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3588":2531,"_30857":2515,"_21381":58318,"_5":14694,"_28049":58274,"_3044":58319},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3588":2532,"_30857":2515,"_21381":58321,"_5":14694,"_28049":58274,"_3044":58322},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3588":2533,"_30857":2515,"_21381":58324,"_5":14694,"_28049":58278,"_3044":58325},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3588":2534,"_30857":2515,"_21381":58327,"_5":14694,"_28049":58278,"_3044":58328},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3588":2535,"_30857":2515,"_21381":58330,"_5":14694,"_28049":58282,"_3044":58331},[],"Select **Root CA** and complete:",{"_3588":2536,"_30857":2515,"_21381":58333,"_5":14694,"_28049":58282,"_3044":58334},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3588":2537,"_30857":2515,"_21381":58336,"_5":14694,"_28049":58282,"_3044":58337},[],"**Subject**: organization and country details for your evaluation.",{"_3588":2538,"_30857":2515,"_21381":58339,"_5":14694,"_28049":58282,"_3044":58340},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3588":2539,"_30857":2515,"_21381":58342,"_5":14694,"_28049":58282,"_3044":58343},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3588":2540,"_30857":2515,"_21381":58345,"_5":14694,"_28049":58282,"_3044":58346},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3588":2541,"_30857":2515,"_21381":58348,"_5":14694,"_28049":58286,"_3044":58349},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3588":2542,"_30857":2515,"_21381":58351,"_5":14694,"_28049":58290,"_3044":58352},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3588":2543,"_30857":2515,"_21381":58354,"_5":14694,"_28049":58290,"_3044":58355},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3588":2544,"_30857":2515,"_21381":58357,"_5":14694,"_28049":58294,"_3044":58358},[],"Run from the directory where you saved `ca.pem`:",{"_3588":2545,"_30857":2515,"_21381":58360,"_5":14694,"_28049":58294,"_3044":58361},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3588":2546,"_30857":2515,"_21381":58363,"_5":14694,"_28049":58294,"_3044":58364},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3588":2547,"_30857":2515,"_21381":58366,"_5":14694,"_28049":58298,"_3044":58367},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3588":2548,"_30857":2515,"_21381":58369,"_5":14694,"_28049":58298,"_3044":58370},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3588":2549,"_30857":2515,"_21381":58372,"_5":14694,"_28049":58298,"_3044":58373},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3588":2550,"_30857":2515,"_21381":58375,"_5":14694,"_28049":58298,"_3044":58376},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3588":2551,"_30857":2515,"_21381":58378,"_5":14694,"_28049":58301,"_3044":58379},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3588":2552,"_30857":2552,"_5":15054,"_3044":58381,"_31216":58382,"_21381":58383,"_28049":2552},"Issue and verify a certificate",[50449,51961,56112,55549],[],{"_3588":2553,"_30857":2552,"_21381":58385,"_5":14694,"_28049":2552,"_3044":58386},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3588":2554,"_30857":2552,"_5":31213,"_21381":58388,"_28049":58389,"_3044":50459},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3588":2555,"_30857":2552,"_5":31213,"_21381":58391,"_28049":58392,"_3044":58393},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3588":2556,"_30857":2552,"_5":31213,"_21381":58395,"_28049":58396,"_3044":58397},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3588":2557,"_30857":2552,"_5":31213,"_21381":58399,"_28049":58400,"_3044":58401},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3588":2558,"_30857":2552,"_5":31213,"_21381":58403,"_28049":58404,"_3044":58405},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3588":2559,"_30857":2552,"_5":31213,"_21381":58407,"_28049":58408,"_3044":58409},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3588":2560,"_30857":2552,"_5":31213,"_21381":58411,"_28049":58412,"_3044":58413},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3588":2561,"_30857":2552,"_5":31213,"_21381":58415,"_28049":58416,"_3044":58417},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3588":2562,"_30857":2552,"_5":31213,"_21381":58419,"_28049":58420,"_3044":58421},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3588":2563,"_30857":2552,"_5":31213,"_21381":58423,"_28049":58424,"_3044":58425},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3588":2564,"_30857":2552,"_5":31213,"_21381":58427,"_28049":58428,"_3044":55806},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3588":2565,"_30857":2552,"_5":31213,"_21381":58430,"_28049":58431,"_3044":50483},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/issue-certificate#next-step",{"_3588":2566,"_30857":2552,"_21381":58433,"_5":14694,"_28049":2552,"_3044":58434},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3588":2567,"_30857":2552,"_21381":58436,"_5":14694,"_28049":58389,"_3044":58437},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3588":2568,"_30857":2552,"_21381":58439,"_5":14694,"_28049":58389,"_3044":58440},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3588":2569,"_30857":2552,"_21381":58442,"_5":14694,"_28049":58389,"_3044":58443},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3588":2570,"_30857":2552,"_21381":58445,"_5":14694,"_28049":58389,"_3044":58446},[],"A client identifier: here we use `device-001`.",{"_3588":2571,"_30857":2552,"_21381":58448,"_5":14694,"_28049":58389,"_3044":58449},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3588":2572,"_30857":2552,"_21381":58451,"_5":14694,"_28049":58392,"_3044":58452},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3588":2573,"_30857":2552,"_21381":58454,"_5":14694,"_28049":58396,"_3044":58455},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3588":2574,"_30857":2552,"_21381":58457,"_5":14694,"_28049":58396,"_3044":58458},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3588":2575,"_30857":2552,"_21381":58460,"_5":14694,"_28049":58400,"_3044":58461},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3588":2576,"_30857":2552,"_21381":58463,"_5":14694,"_28049":58400,"_3044":58464},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3588":2577,"_30857":2552,"_21381":58466,"_5":14694,"_28049":58404,"_3044":58467},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3588":2578,"_30857":2552,"_21381":58469,"_5":14694,"_28049":58404,"_3044":58470},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3588":2579,"_30857":2552,"_21381":58472,"_5":14694,"_28049":58408,"_3044":58473},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3588":2580,"_30857":2552,"_21381":58475,"_5":14694,"_28049":58412,"_3044":58476},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3588":2581,"_30857":2552,"_21381":58478,"_5":14694,"_28049":58416,"_3044":58479},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3588":2582,"_30857":2552,"_21381":58481,"_5":14694,"_28049":58420,"_3044":58482},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3588":2583,"_30857":2552,"_21381":58484,"_5":14694,"_28049":58420,"_3044":58485},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3588":2584,"_30857":2552,"_21381":58487,"_5":14694,"_28049":58420,"_3044":58488},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3588":2585,"_30857":2552,"_21381":58490,"_5":14694,"_28049":58424,"_3044":58491},[],"In Bash, compare the two public-key digests:",{"_3588":2586,"_30857":2552,"_21381":58493,"_5":14694,"_28049":58424,"_3044":58494},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3588":2587,"_30857":2552,"_21381":58496,"_5":14694,"_28049":58424,"_3044":58497},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3588":2588,"_30857":2552,"_21381":58499,"_5":14694,"_28049":58428,"_3044":55890},[],{"_3588":2589,"_30857":2552,"_21381":58501,"_5":14694,"_28049":58428,"_3044":58502},[],"What to review",{"_3588":2590,"_30857":2552,"_21381":58504,"_5":14694,"_28049":58428,"_3044":58505},[],"The CA rejects issuance",{"_3588":2591,"_30857":2552,"_21381":58507,"_5":14694,"_28049":58428,"_3044":58508},[],"Permissions, CA state and key, algorithm and profile.",{"_3588":2592,"_30857":2552,"_21381":58510,"_5":14694,"_28049":58428,"_3044":58511},[],"Different subject or usages",{"_3588":2593,"_30857":2552,"_21381":58513,"_5":14694,"_28049":58428,"_3044":58514},[],"Applied profile and requested values.",{"_3588":2594,"_30857":2552,"_21381":58516,"_5":14694,"_28049":58428,"_3044":58517},[],"Issuer cannot be found",{"_3588":2595,"_30857":2552,"_21381":58519,"_5":14694,"_28049":58428,"_3044":58520},[],"Downloaded CA and required intermediate chain.",{"_3588":2596,"_30857":2552,"_21381":58522,"_5":14694,"_28049":58428,"_3044":58523},[],"Validity fails",{"_3588":2597,"_30857":2552,"_21381":58525,"_5":14694,"_28049":58428,"_3044":58526},[],"Certificate and CA dates, and the computer's clock.",{"_3588":2598,"_30857":2552,"_21381":58528,"_5":14694,"_28049":58428,"_3044":58529},[],"Public-key digests differ",{"_3588":2599,"_30857":2552,"_21381":58531,"_5":14694,"_28049":58428,"_3044":58532},[],"Certificate and key files from the same issuance.",{"_3588":2600,"_30857":2552,"_21381":58534,"_5":14694,"_28049":58428,"_3044":58535},[],"See PKI diagnostics to narrow an issuance failure.",{"_3588":2601,"_30857":2552,"_21381":58537,"_5":14694,"_28049":58431,"_3044":58538},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3588":2602,"_30857":2552,"_21381":58540,"_5":14694,"_28049":58431,"_3044":58541},[],"Manage certificates for inspection, status and revocation.",{"_3588":2603,"_30857":2552,"_21381":58543,"_5":14694,"_28049":58431,"_3044":58544},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3588":2604,"_30857":2552,"_21381":58546,"_5":14694,"_28049":58431,"_3044":58547},[],"Prepare EST for the device to request its next identities.",{"_3588":2605,"_30857":2552,"_21381":58549,"_5":14694,"_28049":58431,"_3044":58550},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3588":2606,"_30857":2606,"_5":15054,"_3044":58552,"_31216":58553,"_21381":58554,"_28049":2606},"PKI getting started",[50449,51961,56112,55549],[],{"_3588":2607,"_30857":2606,"_21381":58556,"_5":14694,"_28049":2606,"_3044":58557},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3588":2608,"_30857":2606,"_5":31213,"_21381":58559,"_28049":58560,"_3044":50459},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/overview#before-you-begin",{"_3588":2609,"_30857":2606,"_5":31213,"_21381":58562,"_28049":58563,"_3044":58564},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3588":2610,"_30857":2606,"_5":31213,"_21381":58566,"_28049":58567,"_3044":55741},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/overview#expected-result",{"_3588":2611,"_30857":2606,"_5":31213,"_21381":58569,"_28049":58570,"_3044":58571},[],"/docs/pr-preview/pr-70/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3588":2612,"_30857":2606,"_21381":58573,"_5":14694,"_28049":2606,"_3044":58574},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3588":2613,"_30857":2606,"_21381":58576,"_5":14694,"_28049":58560,"_3044":58577},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3588":2614,"_30857":2606,"_21381":58579,"_5":14694,"_28049":58560,"_3044":58580},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3588":2615,"_30857":2606,"_21381":58582,"_5":14694,"_28049":58560,"_3044":58583},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3588":2616,"_30857":2606,"_21381":58585,"_5":14694,"_28049":58560,"_3044":58586},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3588":2617,"_30857":2606,"_21381":58588,"_5":14694,"_28049":58560,"_3044":58589},[],"A working directory with restricted access for the downloaded key.",{"_3588":2618,"_30857":2606,"_21381":58591,"_5":14694,"_28049":58563,"_3044":58592},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3588":2619,"_30857":2606,"_21381":58594,"_5":14694,"_28049":58563,"_3044":58595},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3588":2620,"_30857":2606,"_21381":58597,"_5":14694,"_28049":58563,"_3044":58598},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3588":2621,"_30857":2606,"_21381":58600,"_5":14694,"_28049":58563,"_3044":58601},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3588":2622,"_30857":2606,"_21381":58603,"_5":14694,"_28049":58567,"_3044":58604},[],"File or resource",{"_3588":2623,"_30857":2606,"_21381":58606,"_5":14694,"_28049":58567,"_3044":55738},[],{"_3588":2624,"_30857":2606,"_21381":58608,"_5":14694,"_28049":58567,"_3044":58609},[],"Active root CA and `ca.pem`",{"_3588":2625,"_30857":2606,"_21381":58611,"_5":14694,"_28049":58567,"_3044":58612},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3588":2626,"_30857":2606,"_21381":58614,"_5":14694,"_28049":58567,"_3044":58615},[],"End-entity certificate and `device.crt`",{"_3588":2627,"_30857":2606,"_21381":58617,"_5":14694,"_28049":58567,"_3044":58618},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3588":2628,"_30857":2606,"_21381":58620,"_5":14694,"_28049":58567,"_3044":58621},[],"Private key `device.key`",{"_3588":2629,"_30857":2606,"_21381":58623,"_5":14694,"_28049":58567,"_3044":58624},[],"Its public key matches the one included in `device.crt`.",{"_3588":2630,"_30857":2606,"_21381":58626,"_5":14694,"_28049":58567,"_3044":58627},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3588":2631,"_30857":2606,"_21381":58629,"_5":14694,"_28049":58570,"_3044":58630},[],"To operate certificates, continue with Certificates and Validation.",{"_3588":2632,"_30857":2606,"_21381":58632,"_5":14694,"_28049":58570,"_3044":58633},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3588":2633,"_30857":2606,"_21381":58635,"_5":14694,"_28049":58570,"_3044":58636},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3588":2634,"_30857":2634,"_5":15054,"_3044":58638,"_31216":58639,"_21381":58640,"_28049":2634},"PKI troubleshooting",[50449,51961,56112,54687],[],{"_3588":2635,"_30857":2634,"_21381":58642,"_5":14694,"_28049":2634,"_3044":58643},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3588":2636,"_30857":2634,"_5":31213,"_21381":58645,"_28049":58646,"_3044":58647},[],"/docs/pr-preview/pr-70/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3588":2637,"_30857":2634,"_5":31213,"_21381":58649,"_28049":58650,"_3044":58651},[],"/docs/pr-preview/pr-70/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3588":2638,"_30857":2634,"_5":31213,"_21381":58653,"_28049":58654,"_3044":58655},[],"/docs/pr-preview/pr-70/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3588":2639,"_30857":2634,"_21381":58657,"_5":14694,"_28049":2634,"_3044":58658},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3588":2640,"_30857":2634,"_21381":58660,"_5":14694,"_28049":2634,"_3044":58661},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3588":2641,"_30857":2634,"_21381":58663,"_5":14694,"_28049":58646,"_3044":55738},[],{"_3588":2642,"_30857":2634,"_21381":58665,"_5":14694,"_28049":58646,"_3044":58666},[],"What to inspect",{"_3588":2643,"_30857":2634,"_21381":58668,"_5":14694,"_28049":58646,"_3044":50483},[],{"_3588":2644,"_30857":2634,"_21381":58670,"_5":14694,"_28049":58646,"_3044":54954},[],{"_3588":2645,"_30857":2634,"_21381":58672,"_5":14694,"_28049":58646,"_3044":58673},[],"Exists, is active and has usable dates.",{"_3588":2646,"_30857":2634,"_21381":58675,"_5":14694,"_28049":58646,"_3044":58676},[],"Authorities.",{"_3588":2647,"_30857":2634,"_21381":58678,"_5":14694,"_28049":58646,"_3044":58679},[],"Key",{"_3588":2648,"_30857":2634,"_21381":58681,"_5":14694,"_28049":58646,"_3044":58682},[],"The record has a usable private key and the engine can sign.",{"_3588":2649,"_30857":2634,"_21381":58684,"_5":14694,"_28049":58646,"_3044":58685},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3588":2650,"_30857":2634,"_21381":58687,"_5":14694,"_28049":58646,"_3044":58688},[],"CSR",{"_3588":2651,"_30857":2634,"_21381":58690,"_5":14694,"_28049":58646,"_3044":58691},[],"Correct PEM and verifiable signature.",{"_3588":2652,"_30857":2634,"_21381":58693,"_5":14694,"_28049":58646,"_3044":58694},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3588":2653,"_30857":2634,"_21381":58696,"_5":14694,"_28049":58646,"_3044":58697},[],"Profile",{"_3588":2654,"_30857":2634,"_21381":58699,"_5":14694,"_28049":58646,"_3044":58700},[],"Selected source, existing ID, allowed algorithm and size.",{"_3588":2655,"_30857":2634,"_21381":58702,"_5":14694,"_28049":58646,"_3044":58703},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3588":2656,"_30857":2634,"_21381":58705,"_5":14694,"_28049":58646,"_3044":55890},[],{"_3588":2657,"_30857":2634,"_21381":58707,"_5":14694,"_28049":58646,"_3044":58708},[],"Appropriate subject, SAN, usages and dates.",{"_3588":2658,"_30857":2634,"_21381":58710,"_5":14694,"_28049":58646,"_3044":58711},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3588":2659,"_30857":2634,"_21381":58713,"_5":14694,"_28049":58646,"_3044":58714},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3588":2660,"_30857":2634,"_21381":58716,"_5":14694,"_28049":58646,"_3044":58717},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3588":2661,"_30857":2634,"_21381":58719,"_5":14694,"_28049":58650,"_3044":58720},[],"Check each boundary independently:",{"_3588":2662,"_30857":2634,"_21381":58722,"_5":14694,"_28049":58650,"_3044":58723},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3588":2663,"_30857":2634,"_21381":58725,"_5":14694,"_28049":58650,"_3044":58726},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3588":2664,"_30857":2634,"_21381":58728,"_5":14694,"_28049":58650,"_3044":58729},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3588":2665,"_30857":2634,"_21381":58731,"_5":14694,"_28049":58650,"_3044":58732},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3588":2666,"_30857":2634,"_21381":58734,"_5":14694,"_28049":58650,"_3044":58735},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3588":2667,"_30857":2634,"_21381":58737,"_5":14694,"_28049":58650,"_3044":58738},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3588":2668,"_30857":2634,"_21381":58740,"_5":14694,"_28049":58654,"_3044":58741},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3588":2669,"_30857":2634,"_21381":58743,"_5":14694,"_28049":58654,"_3044":58744},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3588":2670,"_30857":2670,"_5":15054,"_3044":58746,"_31216":58747,"_21381":58748,"_28049":2670},"Security",[50449],[],{"_3588":2671,"_30857":2670,"_21381":58750,"_5":14694,"_28049":2670,"_3044":58751},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3588":2672,"_30857":2670,"_5":31213,"_21381":58753,"_28049":58754,"_3044":58755},[],"/docs/pr-preview/pr-70/security#report-a-vulnerability","Report a vulnerability",{"_3588":2673,"_30857":2670,"_5":31213,"_21381":58757,"_28049":58758,"_3044":58759},[],"/docs/pr-preview/pr-70/security#what-to-include-in-a-report","What to include in a report",{"_3588":2674,"_30857":2670,"_5":31213,"_21381":58761,"_28049":58762,"_3044":58763},[],"/docs/pr-preview/pr-70/security#supported-versions","Supported versions",{"_3588":2675,"_30857":2670,"_5":31213,"_21381":58765,"_28049":58766,"_3044":58767},[],"/docs/pr-preview/pr-70/security#responsible-disclosure","Responsible disclosure",{"_3588":2676,"_30857":2670,"_21381":58769,"_5":14694,"_28049":2670,"_3044":58770},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3588":2677,"_30857":2670,"_21381":58772,"_5":14694,"_28049":58754,"_3044":58773},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3588":2678,"_30857":2670,"_21381":58775,"_5":14694,"_28049":58754,"_3044":58776},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3588":2679,"_30857":2670,"_21381":58778,"_5":14694,"_28049":58754,"_3044":15332},[],{"_3588":2680,"_30857":2670,"_21381":58780,"_5":14694,"_28049":58754,"_3044":15261},[],{"_3588":2681,"_30857":2670,"_21381":58782,"_5":14694,"_28049":58754,"_3044":15319},[],{"_3588":2682,"_30857":2670,"_21381":58784,"_5":14694,"_28049":58754,"_3044":58785},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3588":2683,"_30857":2670,"_21381":58787,"_5":14694,"_28049":58754,"_3044":58788},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3588":2684,"_30857":2670,"_21381":58790,"_5":14694,"_28049":58758,"_3044":58791},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3588":2685,"_30857":2670,"_21381":58793,"_5":14694,"_28049":58758,"_3044":58794},[],"Do not include in the report:",{"_3588":2686,"_30857":2670,"_21381":58796,"_5":14694,"_28049":58758,"_3044":58797},[],"Credentials, tokens, or private keys",{"_3588":2687,"_30857":2670,"_21381":58799,"_5":14694,"_28049":58758,"_3044":58800},[],"Customer data or customer-identifiable information",{"_3588":2688,"_30857":2670,"_21381":58802,"_5":14694,"_28049":58758,"_3044":58803},[],"Confidential architecture or internal infrastructure details",{"_3588":2689,"_30857":2670,"_21381":58805,"_5":14694,"_28049":58762,"_3044":58806},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3588":2690,"_30857":2670,"_21381":58808,"_5":14694,"_28049":58762,"_3044":58809},[],"For upgrade guidance, see Upgrades.",{"_3588":2691,"_30857":2670,"_21381":58811,"_5":14694,"_28049":58766,"_3044":58812},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3588":2692,"_30857":2670,"_21381":58814,"_5":14694,"_28049":58766,"_3044":58815},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3588":2693,"_30857":2670,"_21381":58817,"_5":14694,"_28049":58766,"_3044":58818},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3588":2694,"_30857":2670,"_21381":58820,"_5":14694,"_28049":58766,"_3044":58821},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3588":2695,"_30857":2670,"_21381":58823,"_5":14694,"_28049":58766,"_3044":58824},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3588":2696,"_30857":2696,"_5":15054,"_3044":58826,"_31216":58827,"_21381":58829,"_28049":2696},"3.8.0 to 4.0.0",[50449,58828],"Upgrades",[],{"_3588":2697,"_30857":2696,"_21381":58831,"_5":14694,"_28049":2696,"_3044":58832},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3588":2698,"_30857":2696,"_5":31213,"_21381":58834,"_28049":58835,"_3044":58836},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3588":2699,"_30857":2696,"_5":31213,"_21381":58838,"_28049":58839,"_3044":58840},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3588":2700,"_30857":2696,"_5":31213,"_21381":58842,"_28049":58843,"_3044":58844},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3588":2701,"_30857":2696,"_5":31213,"_21381":58846,"_28049":58847,"_3044":58848},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3588":2702,"_30857":2696,"_5":31213,"_21381":58850,"_28049":58851,"_3044":58852},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3588":2703,"_30857":2696,"_5":31213,"_21381":58854,"_28049":58855,"_3044":58856},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3588":2704,"_30857":2696,"_5":31213,"_21381":58858,"_28049":58859,"_3044":58860},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3588":2705,"_30857":2696,"_5":31213,"_21381":58862,"_28049":58863,"_3044":58864},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3588":2706,"_30857":2696,"_5":31213,"_21381":58866,"_28049":58867,"_3044":58868},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3588":2707,"_30857":2696,"_5":31213,"_21381":58870,"_28049":58871,"_3044":58872},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3588":2708,"_30857":2696,"_5":31213,"_21381":58874,"_28049":58875,"_3044":51087},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3588":2709,"_30857":2696,"_5":31213,"_21381":58877,"_28049":58878,"_3044":58879},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3588":2710,"_30857":2696,"_5":31213,"_21381":58881,"_28049":58882,"_3044":58883},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3588":2711,"_30857":2696,"_5":31213,"_21381":58885,"_28049":58886,"_3044":58887},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3588":2712,"_30857":2696,"_5":31213,"_21381":58889,"_28049":58890,"_3044":58891},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3588":2713,"_30857":2696,"_5":31213,"_21381":58893,"_28049":58894,"_3044":58895},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3588":2714,"_30857":2696,"_5":31213,"_21381":58897,"_28049":58898,"_3044":58899},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3588":2715,"_30857":2696,"_5":31213,"_21381":58901,"_28049":58902,"_3044":58903},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3588":2716,"_30857":2696,"_5":31213,"_21381":58905,"_28049":58906,"_3044":58907},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3588":2717,"_30857":2696,"_5":31213,"_21381":58909,"_28049":58910,"_3044":58911},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3588":2718,"_30857":2696,"_5":31213,"_21381":58913,"_28049":58914,"_3044":58915},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3588":2719,"_30857":2696,"_5":31213,"_21381":58917,"_28049":58918,"_3044":58919},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3588":2720,"_30857":2696,"_5":31213,"_21381":58921,"_28049":58922,"_3044":58923},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3588":2721,"_30857":2696,"_5":31213,"_21381":58925,"_28049":58926,"_3044":58927},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3588":2722,"_30857":2696,"_5":31213,"_21381":58929,"_28049":58930,"_3044":58931},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3588":2723,"_30857":2696,"_5":31213,"_21381":58933,"_28049":58934,"_3044":58935},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3588":2724,"_30857":2696,"_5":31213,"_21381":58937,"_28049":58938,"_3044":58939},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3588":2725,"_30857":2696,"_5":31213,"_21381":58941,"_28049":58942,"_3044":58943},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3588":2726,"_30857":2696,"_5":31213,"_21381":58945,"_28049":58946,"_3044":58947},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3588":2727,"_30857":2696,"_5":31213,"_21381":58949,"_28049":58950,"_3044":58951},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3588":2728,"_30857":2696,"_5":31213,"_21381":58953,"_28049":58954,"_3044":58955},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3588":2729,"_30857":2696,"_5":31213,"_21381":58957,"_28049":58958,"_3044":58959},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3588":2730,"_30857":2696,"_5":31213,"_21381":58961,"_28049":58962,"_3044":58963},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3588":2731,"_30857":2696,"_5":31213,"_21381":58965,"_28049":58966,"_3044":58967},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3588":2732,"_30857":2696,"_5":31213,"_21381":58969,"_28049":58970,"_3044":58971},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3588":2733,"_30857":2696,"_5":31213,"_21381":58973,"_28049":58974,"_3044":58975},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3588":2734,"_30857":2696,"_5":31213,"_21381":58977,"_28049":58978,"_3044":58979},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3588":2735,"_30857":2696,"_5":31213,"_21381":58981,"_28049":58982,"_3044":58983},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3588":2736,"_30857":2696,"_5":31213,"_21381":58985,"_28049":58986,"_3044":58987},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3588":2737,"_30857":2696,"_5":31213,"_21381":58989,"_28049":58990,"_3044":58991},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3588":2738,"_30857":2696,"_5":31213,"_21381":58993,"_28049":58994,"_3044":58995},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3588":2739,"_30857":2696,"_5":31213,"_21381":58997,"_28049":58998,"_3044":54687},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3588":2740,"_30857":2696,"_5":31213,"_21381":59000,"_28049":59001,"_3044":59002},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3588":2741,"_30857":2696,"_5":31213,"_21381":59004,"_28049":59005,"_3044":59006},[],"/docs/pr-preview/pr-70/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3588":2742,"_30857":2696,"_21381":59008,"_5":14694,"_28049":2696,"_3044":59009},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3588":2743,"_30857":2696,"_21381":59011,"_5":14694,"_28049":2696,"_3044":59012},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3588":2744,"_30857":2696,"_21381":59014,"_5":14694,"_28049":2696,"_3044":59015},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3588":2745,"_30857":2696,"_21381":59017,"_5":14694,"_28049":2696,"_3044":59018},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3588":2746,"_30857":2696,"_21381":59020,"_5":14694,"_28049":2696,"_3044":59021},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3588":2747,"_30857":2696,"_21381":59023,"_5":14694,"_28049":2696,"_3044":59024},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3588":2748,"_30857":2696,"_21381":59026,"_5":14694,"_28049":2696,"_3044":59027},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3588":2749,"_30857":2696,"_21381":59029,"_5":14694,"_28049":58839,"_3044":59030},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3588":2750,"_30857":2696,"_21381":59032,"_5":14694,"_28049":58839,"_3044":59033},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3588":2751,"_30857":2696,"_21381":59035,"_5":14694,"_28049":58843,"_3044":59036},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3588":2752,"_30857":2696,"_21381":59038,"_5":14694,"_28049":58843,"_3044":59039},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3588":2753,"_30857":2696,"_21381":59041,"_5":14694,"_28049":58847,"_3044":59042},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3588":2754,"_30857":2696,"_21381":59044,"_5":14694,"_28049":58851,"_3044":59045},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3588":2755,"_30857":2696,"_21381":59047,"_5":14694,"_28049":58851,"_3044":59048},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3588":2756,"_30857":2696,"_21381":59050,"_5":14694,"_28049":58851,"_3044":59051},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3588":2757,"_30857":2696,"_21381":59053,"_5":14694,"_28049":58851,"_3044":59054},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3588":2758,"_30857":2696,"_21381":59056,"_5":14694,"_28049":58851,"_3044":59057},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3588":2759,"_30857":2696,"_21381":59059,"_5":14694,"_28049":58855,"_3044":59060},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3588":2760,"_30857":2696,"_21381":59062,"_5":14694,"_28049":58855,"_3044":59063},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3588":2761,"_30857":2696,"_21381":59065,"_5":14694,"_28049":58855,"_3044":59066},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3588":2762,"_30857":2696,"_21381":59068,"_5":14694,"_28049":58855,"_3044":59069},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3588":2763,"_30857":2696,"_21381":59071,"_5":14694,"_28049":58855,"_3044":59072},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3588":2764,"_30857":2696,"_21381":59074,"_5":14694,"_28049":58855,"_3044":59075},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3588":2765,"_30857":2696,"_21381":59077,"_5":14694,"_28049":58859,"_3044":59078},[],"Change",{"_3588":2766,"_30857":2696,"_21381":59080,"_5":14694,"_28049":58859,"_3044":59081},[],"Who is affected",{"_3588":2767,"_30857":2696,"_21381":59083,"_5":14694,"_28049":58859,"_3044":59084},[],"Severity",{"_3588":2768,"_30857":2696,"_21381":59086,"_5":14694,"_28049":58859,"_3044":57551},[],{"_3588":2769,"_30857":2696,"_21381":59088,"_5":14694,"_28049":58859,"_3044":58868},[],{"_3588":2770,"_30857":2696,"_21381":59090,"_5":14694,"_28049":58859,"_3044":59091},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3588":2771,"_30857":2696,"_21381":59093,"_5":14694,"_28049":58859,"_3044":59094},[],"High: KMS and VA start on empty volumes",{"_3588":2772,"_30857":2696,"_21381":59096,"_5":14694,"_28049":58859,"_3044":59097},[],"Copy the data into the new volumes",{"_3588":2773,"_30857":2696,"_21381":59099,"_5":14694,"_28049":58859,"_3044":58872},[],{"_3588":2774,"_30857":2696,"_21381":59101,"_5":14694,"_28049":58859,"_3044":59102},[],"Every Helm release",{"_3588":2775,"_30857":2696,"_21381":59104,"_5":14694,"_28049":58859,"_3044":59105},[],"High: `helm upgrade` fails",{"_3588":2776,"_30857":2696,"_21381":59107,"_5":14694,"_28049":58859,"_3044":59108},[],"Remove or rename legacy keys",{"_3588":2777,"_30857":2696,"_21381":59110,"_5":14694,"_28049":58859,"_3044":51087},[],{"_3588":2778,"_30857":2696,"_21381":59112,"_5":14694,"_28049":58859,"_3044":59102},[],{"_3588":2779,"_30857":2696,"_21381":59114,"_5":14694,"_28049":58859,"_3044":59115},[],"High: `helm upgrade` fails on inline credentials",{"_3588":2780,"_30857":2696,"_21381":59117,"_5":14694,"_28049":58859,"_3044":59118},[],"Create the Secrets first; see Step 2",{"_3588":2781,"_30857":2696,"_21381":59120,"_5":14694,"_28049":58859,"_3044":58879},[],{"_3588":2782,"_30857":2696,"_21381":59122,"_5":14694,"_28049":58859,"_3044":59123},[],"Every deployment",{"_3588":2783,"_30857":2696,"_21381":59125,"_5":14694,"_28049":58859,"_3044":59126},[],"High: without a bootstrap principal there is no administrator",{"_3588":2784,"_30857":2696,"_21381":59128,"_5":14694,"_28049":58859,"_3044":59129},[],"Configure `services.authz`",{"_3588":2785,"_30857":2696,"_21381":59131,"_5":14694,"_28049":58859,"_3044":58883},[],{"_3588":2786,"_30857":2696,"_21381":59133,"_5":14694,"_28049":58859,"_3044":59102},[],{"_3588":2787,"_30857":2696,"_21381":59135,"_5":14694,"_28049":58859,"_3044":59136},[],"High: `helm upgrade` fails on the old keys",{"_3588":2788,"_30857":2696,"_21381":59138,"_5":14694,"_28049":58859,"_3044":59139},[],"Move JWKS and roles into `services.authz`",{"_3588":2789,"_30857":2696,"_21381":59141,"_5":14694,"_28049":58859,"_3044":58903},[],{"_3588":2790,"_30857":2696,"_21381":59143,"_5":14694,"_28049":58859,"_3044":59144},[],"3.8.0 deployments with per-service databases",{"_3588":2791,"_30857":2696,"_21381":59146,"_5":14694,"_28049":58859,"_3044":59147},[],"High: services find no data, or a migration aborts",{"_3588":2792,"_30857":2696,"_21381":59149,"_5":14694,"_28049":58859,"_3044":59150},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3588":2793,"_30857":2696,"_21381":59152,"_5":14694,"_28049":58859,"_3044":58907},[],{"_3588":2794,"_30857":2696,"_21381":59154,"_5":14694,"_28049":58859,"_3044":59155},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3588":2795,"_30857":2696,"_21381":59157,"_5":14694,"_28049":58859,"_3044":59158},[],"High: the backend no longer starts with them",{"_3588":2796,"_30857":2696,"_21381":59160,"_5":14694,"_28049":58859,"_3044":59161},[],"Move to PostgreSQL before upgrading",{"_3588":2797,"_30857":2696,"_21381":59163,"_5":14694,"_28049":58859,"_3044":58951},[],{"_3588":2798,"_30857":2696,"_21381":59165,"_5":14694,"_28049":58859,"_3044":59166},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3588":2799,"_30857":2696,"_21381":59168,"_5":14694,"_28049":58859,"_3044":59169},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3588":2800,"_30857":2696,"_21381":59171,"_5":14694,"_28049":58859,"_3044":59172},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3588":2801,"_30857":2696,"_21381":59174,"_5":14694,"_28049":58859,"_3044":59175},[],"Webhooks with file references",{"_3588":2802,"_30857":2696,"_21381":59177,"_5":14694,"_28049":58859,"_3044":59178},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3588":2803,"_30857":2696,"_21381":59180,"_5":14694,"_28049":58859,"_3044":59181},[],"High: enrollments calling the webhook fail",{"_3588":2804,"_30857":2696,"_21381":59183,"_5":14694,"_28049":58859,"_3044":59184},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3588":2805,"_30857":2696,"_21381":59186,"_5":14694,"_28049":58859,"_3044":58887},[],{"_3588":2806,"_30857":2696,"_21381":59188,"_5":14694,"_28049":58859,"_3044":59189},[],"Releases with per-service identity overrides or mounted key material",{"_3588":2807,"_30857":2696,"_21381":59191,"_5":14694,"_28049":58859,"_3044":59192},[],"Medium: services cannot read their files",{"_3588":2808,"_30857":2696,"_21381":59194,"_5":14694,"_28049":58859,"_3044":59195},[],"Remove the overrides and fix volume ownership",{"_3588":2809,"_30857":2696,"_21381":59197,"_5":14694,"_28049":58859,"_3044":58891},[],{"_3588":2810,"_30857":2696,"_21381":59199,"_5":14694,"_28049":58859,"_3044":59200},[],"Releases that set `amqp.tls`",{"_3588":2811,"_30857":2696,"_21381":59202,"_5":14694,"_28049":58859,"_3044":59203},[],"Medium: clients connect to the wrong port",{"_3588":2812,"_30857":2696,"_21381":59205,"_5":14694,"_28049":58859,"_3044":59206},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3588":2813,"_30857":2696,"_21381":59208,"_5":14694,"_28049":58859,"_3044":58911},[],{"_3588":2814,"_30857":2696,"_21381":59210,"_5":14694,"_28049":58859,"_3044":59211},[],"Installations whose CA keys predate the KMS",{"_3588":2815,"_30857":2696,"_21381":59213,"_5":14694,"_28049":58859,"_3044":59214},[],"Medium: CA keys stay unmanaged",{"_3588":2816,"_30857":2696,"_21381":59216,"_5":14694,"_28049":58859,"_3044":59217},[],"Run the CA-to-KMS migration",{"_3588":2817,"_30857":2696,"_21381":59219,"_5":14694,"_28049":58859,"_3044":59220},[],"Receiver certificate verification",{"_3588":2818,"_30857":2696,"_21381":59222,"_5":14694,"_28049":58859,"_3044":59223},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3588":2819,"_30857":2696,"_21381":59225,"_5":14694,"_28049":58859,"_3044":59226},[],"Medium: credentials go to an unverified receiver",{"_3588":2820,"_30857":2696,"_21381":59228,"_5":14694,"_28049":58859,"_3044":59229},[],"Set `insecure_skip_verify` to `false`",{"_3588":2821,"_30857":2696,"_21381":59231,"_5":14694,"_28049":58859,"_3044":58927},[],{"_3588":2822,"_30857":2696,"_21381":59233,"_5":14694,"_28049":58859,"_3044":59234},[],"Scripts and consoles that edit DMSs through the API",{"_3588":2823,"_30857":2696,"_21381":59236,"_5":14694,"_28049":58859,"_3044":59237},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3588":2824,"_30857":2696,"_21381":59239,"_5":14694,"_28049":58859,"_3044":59240},[],"Read the DMS before editing and use the new field",{"_3588":2825,"_30857":2696,"_21381":59242,"_5":14694,"_28049":58859,"_3044":58947},[],{"_3588":2826,"_30857":2696,"_21381":59244,"_5":14694,"_28049":58859,"_3044":59245},[],"Clients that create or update CRL settings through the API",{"_3588":2827,"_30857":2696,"_21381":59247,"_5":14694,"_28049":58859,"_3044":59248},[],"Medium: requests with the old field return an error",{"_3588":2828,"_30857":2696,"_21381":59250,"_5":14694,"_28049":58859,"_3044":59251},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3588":2829,"_30857":2696,"_21381":59253,"_5":14694,"_28049":58859,"_3044":58955},[],{"_3588":2830,"_30857":2696,"_21381":59255,"_5":14694,"_28049":58859,"_3044":59256},[],"Alert subscriptions and consumers of the VA events",{"_3588":2831,"_30857":2696,"_21381":59258,"_5":14694,"_28049":58859,"_3044":59259},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3588":2832,"_30857":2696,"_21381":59261,"_5":14694,"_28049":58859,"_3044":59262},[],"Review conditions filtering on the old event payload or subject",{"_3588":2833,"_30857":2696,"_21381":59264,"_5":14694,"_28049":58859,"_3044":58943},[],{"_3588":2834,"_30857":2696,"_21381":59266,"_5":14694,"_28049":58859,"_3044":59267},[],"Consumers that read the device `events` field",{"_3588":2835,"_30857":2696,"_21381":59269,"_5":14694,"_28049":58859,"_3044":59270},[],"Medium: the field disappears",{"_3588":2836,"_30857":2696,"_21381":59272,"_5":14694,"_28049":58859,"_3044":59273},[],"Use the new event endpoints",{"_3588":2837,"_30857":2696,"_21381":59275,"_5":14694,"_28049":58859,"_3044":58963},[],{"_3588":2838,"_30857":2696,"_21381":59277,"_5":14694,"_28049":58859,"_3044":59278},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3588":2839,"_30857":2696,"_21381":59280,"_5":14694,"_28049":58859,"_3044":59281},[],"Medium: the VA migration aborts",{"_3588":2840,"_30857":2696,"_21381":59283,"_5":14694,"_28049":58859,"_3044":59284},[],"Fix the affected roles before upgrading",{"_3588":2841,"_30857":2696,"_21381":59286,"_5":14694,"_28049":58859,"_3044":58895},[],{"_3588":2842,"_30857":2696,"_21381":59288,"_5":14694,"_28049":58859,"_3044":59289},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3588":2843,"_30857":2696,"_21381":59291,"_5":14694,"_28049":58859,"_3044":59292},[],"Low to medium: validation errors or changed defaults",{"_3588":2844,"_30857":2696,"_21381":59294,"_5":14694,"_28049":58859,"_3044":59295},[],"Update the values file",{"_3588":2845,"_30857":2696,"_21381":59297,"_5":14694,"_28049":58859,"_3044":58935},[],{"_3588":2846,"_30857":2696,"_21381":59299,"_5":14694,"_28049":58859,"_3044":59300},[],"Clients that send the DMS ID in the update body",{"_3588":2847,"_30857":2696,"_21381":59302,"_5":14694,"_28049":58859,"_3044":59303},[],"Low: the ID in the URL wins",{"_3588":2848,"_30857":2696,"_21381":59305,"_5":14694,"_28049":58859,"_3044":59306},[],"Send the ID in the URL",{"_3588":2849,"_30857":2696,"_21381":59308,"_5":14694,"_28049":58859,"_3044":58959},[],{"_3588":2850,"_30857":2696,"_21381":59310,"_5":14694,"_28049":58859,"_3044":59311},[],"Clients that send an `id` when creating or importing CAs",{"_3588":2851,"_30857":2696,"_21381":59313,"_5":14694,"_28049":58859,"_3044":59314},[],"Low: the ID in the body is ignored, and the field is removed",{"_3588":2852,"_30857":2696,"_21381":59316,"_5":14694,"_28049":58859,"_3044":59317},[],"Let the backend assign the ID and use the returned one",{"_3588":2853,"_30857":2696,"_21381":59319,"_5":14694,"_28049":58859,"_3044":58939},[],{"_3588":2854,"_30857":2696,"_21381":59321,"_5":14694,"_28049":58859,"_3044":59322},[],"Consumers that match on certificate `type`",{"_3588":2855,"_30857":2696,"_21381":59324,"_5":14694,"_28049":58859,"_3044":59325},[],"Low: two values are renamed",{"_3588":2856,"_30857":2696,"_21381":59327,"_5":14694,"_28049":58859,"_3044":59328},[],"Adapt consumers",{"_3588":2857,"_30857":2696,"_21381":59330,"_5":14694,"_28049":58859,"_3044":58931},[],{"_3588":2858,"_30857":2696,"_21381":59332,"_5":14694,"_28049":58859,"_3044":59333},[],"Any DMS",{"_3588":2859,"_30857":2696,"_21381":59335,"_5":14694,"_28049":58859,"_3044":59336},[],"Low: informational",{"_3588":2860,"_30857":2696,"_21381":59338,"_5":14694,"_28049":58859,"_3044":59339},[],"Read both blocks before editing",{"_3588":2861,"_30857":2696,"_21381":59341,"_5":14694,"_28049":58867,"_3044":59342},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3588":2862,"_30857":2696,"_21381":59344,"_5":14694,"_28049":58867,"_3044":59345},[],"Step 4 of the migration guide copies the data.",{"_3588":2863,"_30857":2696,"_21381":59347,"_5":14694,"_28049":58871,"_3044":59348},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3588":2864,"_30857":2696,"_21381":59350,"_5":14694,"_28049":58875,"_3044":59351},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3588":2865,"_30857":2696,"_21381":59353,"_5":14694,"_28049":58875,"_3044":59354},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3588":2866,"_30857":2696,"_21381":59356,"_5":14694,"_28049":58878,"_3044":59357},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3588":2867,"_30857":2696,"_21381":59359,"_5":14694,"_28049":58882,"_3044":59360},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3588":2868,"_30857":2696,"_21381":59362,"_5":14694,"_28049":58886,"_3044":59363},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3588":2869,"_30857":2696,"_21381":59365,"_5":14694,"_28049":58886,"_3044":59366},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3588":2870,"_30857":2696,"_21381":59368,"_5":14694,"_28049":58886,"_3044":59369},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3588":2871,"_30857":2696,"_21381":59371,"_5":14694,"_28049":58890,"_3044":59372},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3588":2872,"_30857":2696,"_21381":59374,"_5":14694,"_28049":58894,"_3044":59375},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3588":2873,"_30857":2696,"_21381":59377,"_5":14694,"_28049":58894,"_3044":59378},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3588":2874,"_30857":2696,"_21381":59380,"_5":14694,"_28049":58894,"_3044":59381},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3588":2875,"_30857":2696,"_21381":59383,"_5":14694,"_28049":58894,"_3044":59384},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3588":2876,"_30857":2696,"_21381":59386,"_5":14694,"_28049":58894,"_3044":59387},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3588":2877,"_30857":2696,"_21381":59389,"_5":14694,"_28049":58894,"_3044":59390},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3588":2878,"_30857":2696,"_21381":59392,"_5":14694,"_28049":58902,"_3044":59393},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3588":2879,"_30857":2696,"_21381":59395,"_5":14694,"_28049":58902,"_3044":59396},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3588":2880,"_30857":2696,"_21381":59398,"_5":14694,"_28049":58902,"_3044":59399},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3588":2881,"_30857":2696,"_21381":59401,"_5":14694,"_28049":58902,"_3044":59402},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3588":2882,"_30857":2696,"_21381":59404,"_5":14694,"_28049":58902,"_3044":59405},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3588":2883,"_30857":2696,"_21381":59407,"_5":14694,"_28049":58906,"_3044":59408},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3588":2884,"_30857":2696,"_21381":59410,"_5":14694,"_28049":58910,"_3044":59411},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3588":2885,"_30857":2696,"_21381":59413,"_5":14694,"_28049":58910,"_3044":59414},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3588":2886,"_30857":2696,"_21381":59416,"_5":14694,"_28049":58910,"_3044":59417},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3588":2887,"_30857":2696,"_21381":59419,"_5":14694,"_28049":58910,"_3044":59420},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3588":2888,"_30857":2696,"_21381":59422,"_5":14694,"_28049":58910,"_3044":59423},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3588":2889,"_30857":2696,"_21381":59425,"_5":14694,"_28049":58910,"_3044":59426},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3588":2890,"_30857":2696,"_21381":59428,"_5":14694,"_28049":58910,"_3044":59429},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3588":2891,"_30857":2696,"_21381":59431,"_5":14694,"_28049":58910,"_3044":59432},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3588":2892,"_30857":2696,"_21381":59434,"_5":14694,"_28049":58914,"_3044":59435},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3588":2893,"_30857":2696,"_21381":59437,"_5":14694,"_28049":58922,"_3044":59438},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3588":2894,"_30857":2696,"_21381":59440,"_5":14694,"_28049":58922,"_3044":59441},[],"Field in 3.8.0",{"_3588":2895,"_30857":2696,"_21381":59443,"_5":14694,"_28049":58922,"_3044":59444},[],"Field in 4.0.0",{"_3588":2896,"_30857":2696,"_21381":59446,"_5":14694,"_28049":58922,"_3044":59447},[],"`validate_server_cert`",{"_3588":2897,"_30857":2696,"_21381":59449,"_5":14694,"_28049":58922,"_3044":59450},[],"`insecure_skip_verify` (value negated)",{"_3588":2898,"_30857":2696,"_21381":59452,"_5":14694,"_28049":58922,"_3044":59453},[],"`oidc`",{"_3588":2899,"_30857":2696,"_21381":59455,"_5":14694,"_28049":58922,"_3044":59456},[],"`jwt_options`",{"_3588":2900,"_30857":2696,"_21381":59458,"_5":14694,"_28049":58922,"_3044":59459},[],"`apikey`",{"_3588":2901,"_30857":2696,"_21381":59461,"_5":14694,"_28049":58922,"_3044":59462},[],"`apikey_options`",{"_3588":2902,"_30857":2696,"_21381":59464,"_5":14694,"_28049":58922,"_3044":59465},[],"`mtls`",{"_3588":2903,"_30857":2696,"_21381":59467,"_5":14694,"_28049":58922,"_3044":59468},[],"`mtls_options`",{"_3588":2904,"_30857":2696,"_21381":59470,"_5":14694,"_28049":58922,"_3044":59471},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3588":2905,"_30857":2696,"_21381":59473,"_5":14694,"_28049":58922,"_3044":59474},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3588":2906,"_30857":2696,"_21381":59476,"_5":14694,"_28049":58922,"_3044":59477},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3588":2907,"_30857":2696,"_21381":59479,"_5":14694,"_28049":58926,"_3044":59480},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3588":2908,"_30857":2696,"_21381":59482,"_5":14694,"_28049":58926,"_3044":59483},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3588":2909,"_30857":2696,"_21381":59485,"_5":14694,"_28049":58926,"_3044":59486},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3588":2910,"_30857":2696,"_21381":59488,"_5":14694,"_28049":58930,"_3044":59489},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3588":2911,"_30857":2696,"_21381":59491,"_5":14694,"_28049":58934,"_3044":59492},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3588":2912,"_30857":2696,"_21381":59494,"_5":14694,"_28049":58938,"_3044":59495},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3588":2913,"_30857":2696,"_21381":59497,"_5":14694,"_28049":58942,"_3044":59498},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3588":2914,"_30857":2696,"_21381":59500,"_5":14694,"_28049":58942,"_3044":59501},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3588":2915,"_30857":2696,"_21381":59503,"_5":14694,"_28049":58942,"_3044":59504},[],"`POST /v1/devices/:id/events` creates an event.",{"_3588":2916,"_30857":2696,"_21381":59506,"_5":14694,"_28049":58942,"_3044":59507},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3588":2917,"_30857":2696,"_21381":59509,"_5":14694,"_28049":58946,"_3044":59510},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3588":2918,"_30857":2696,"_21381":59512,"_5":14694,"_28049":58950,"_3044":59513},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3588":2919,"_30857":2696,"_21381":59515,"_5":14694,"_28049":58950,"_3044":59516},[],"Route",{"_3588":2920,"_30857":2696,"_21381":59518,"_5":14694,"_28049":58950,"_3044":53874},[],{"_3588":2921,"_30857":2696,"_21381":59520,"_5":14694,"_28049":58950,"_3044":59521},[],"`GET /v1/crl-settings`",{"_3588":2922,"_30857":2696,"_21381":59523,"_5":14694,"_28049":58950,"_3044":59524},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3588":2923,"_30857":2696,"_21381":59526,"_5":14694,"_28049":58950,"_3044":59527},[],"`GET /v1/crl-settings/{ca-id}`",{"_3588":2924,"_30857":2696,"_21381":59529,"_5":14694,"_28049":58950,"_3044":59530},[],"Reads the settings of a CA.",{"_3588":2925,"_30857":2696,"_21381":59532,"_5":14694,"_28049":58950,"_3044":59533},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3588":2926,"_30857":2696,"_21381":59535,"_5":14694,"_28049":58950,"_3044":59536},[],"Replaces `crl_options`.",{"_3588":2927,"_30857":2696,"_21381":59538,"_5":14694,"_28049":58950,"_3044":59539},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3588":2928,"_30857":2696,"_21381":59541,"_5":14694,"_28049":58950,"_3044":59542},[],"Removes the archived settings of a CA.",{"_3588":2929,"_30857":2696,"_21381":59544,"_5":14694,"_28049":58950,"_3044":59545},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3588":2930,"_30857":2696,"_21381":59547,"_5":14694,"_28049":58950,"_3044":59548},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3588":2931,"_30857":2696,"_21381":59550,"_5":14694,"_28049":58950,"_3044":59551},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3588":2932,"_30857":2696,"_21381":59553,"_5":14694,"_28049":58950,"_3044":59554},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3588":2933,"_30857":2696,"_21381":59556,"_5":14694,"_28049":58950,"_3044":59557},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3588":2934,"_30857":2696,"_21381":59559,"_5":14694,"_28049":58950,"_3044":59560},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3588":2935,"_30857":2696,"_21381":59562,"_5":14694,"_28049":58950,"_3044":59563},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3588":2936,"_30857":2696,"_21381":59565,"_5":14694,"_28049":58950,"_3044":59566},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3588":2937,"_30857":2696,"_21381":59568,"_5":14694,"_28049":58950,"_3044":59569},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3588":2938,"_30857":2696,"_21381":59571,"_5":14694,"_28049":58950,"_3044":59572},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3588":2939,"_30857":2696,"_21381":59574,"_5":14694,"_28049":58950,"_3044":59575},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3588":2940,"_30857":2696,"_21381":59577,"_5":14694,"_28049":58954,"_3044":59578},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3588":2941,"_30857":2696,"_21381":59580,"_5":14694,"_28049":58958,"_3044":59581},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3588":2942,"_30857":2696,"_21381":59583,"_5":14694,"_28049":58962,"_3044":59584},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3588":2943,"_30857":2696,"_21381":59586,"_5":14694,"_28049":58966,"_3044":59587},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3588":2944,"_30857":2696,"_21381":59589,"_5":14694,"_28049":58970,"_3044":59590},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3588":2945,"_30857":2696,"_21381":59592,"_5":14694,"_28049":58970,"_3044":59593},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3588":2946,"_30857":2696,"_21381":59595,"_5":14694,"_28049":58970,"_3044":59596},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3588":2947,"_30857":2696,"_21381":59598,"_5":14694,"_28049":58970,"_3044":59599},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3588":2948,"_30857":2696,"_21381":59601,"_5":14694,"_28049":58970,"_3044":59602},[],"Record the names of your local-storage PVCs:",{"_3588":2949,"_30857":2696,"_21381":59604,"_5":14694,"_28049":58970,"_3044":59605},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3588":2950,"_30857":2696,"_21381":59607,"_5":14694,"_28049":58974,"_3044":59608},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3588":2951,"_30857":2696,"_21381":59610,"_5":14694,"_28049":58974,"_3044":59611},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3588":2952,"_30857":2696,"_21381":59613,"_5":14694,"_28049":58974,"_3044":59614},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3588":2953,"_30857":2696,"_21381":59616,"_5":14694,"_28049":58974,"_3044":59617},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3588":2954,"_30857":2696,"_21381":59619,"_5":14694,"_28049":58974,"_3044":59620},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3588":2955,"_30857":2696,"_21381":59622,"_5":14694,"_28049":58978,"_3044":59623},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3588":2956,"_30857":2696,"_21381":59625,"_5":14694,"_28049":58978,"_3044":59626},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3588":2957,"_30857":2696,"_21381":59628,"_5":14694,"_28049":58978,"_3044":59629},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3588":2958,"_30857":2696,"_21381":59631,"_5":14694,"_28049":58978,"_3044":59632},[],"Secret (`existingSecret`)",{"_3588":2959,"_30857":2696,"_21381":59634,"_5":14694,"_28049":58978,"_3044":59635},[],"Required data keys",{"_3588":2960,"_30857":2696,"_21381":59637,"_5":14694,"_28049":58978,"_3044":59638},[],"When",{"_3588":2961,"_30857":2696,"_21381":59640,"_5":14694,"_28049":58978,"_3044":59641},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3588":2962,"_30857":2696,"_21381":59643,"_5":14694,"_28049":58978,"_3044":59644},[],"`username`, `password`",{"_3588":2963,"_30857":2696,"_21381":59646,"_5":14694,"_28049":58978,"_3044":59647},[],"Always",{"_3588":2964,"_30857":2696,"_21381":59649,"_5":14694,"_28049":58978,"_3044":59650},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3588":2965,"_30857":2696,"_21381":59652,"_5":14694,"_28049":58978,"_3044":59644},[],{"_3588":2966,"_30857":2696,"_21381":59654,"_5":14694,"_28049":58978,"_3044":59647},[],{"_3588":2967,"_30857":2696,"_21381":59656,"_5":14694,"_28049":58978,"_3044":59657},[],"`services.alerts.smtp_server.existingSecret`",{"_3588":2968,"_30857":2696,"_21381":59659,"_5":14694,"_28049":58978,"_3044":59644},[],{"_3588":2969,"_30857":2696,"_21381":59661,"_5":14694,"_28049":58978,"_3044":59662},[],"Only when SMTP authentication is enabled",{"_3588":2970,"_30857":2696,"_21381":59664,"_5":14694,"_28049":58978,"_3044":59665},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3588":2971,"_30857":2696,"_21381":59667,"_5":14694,"_28049":58978,"_3044":59668},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3588":2972,"_30857":2696,"_21381":59670,"_5":14694,"_28049":58978,"_3044":59671},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3588":2973,"_30857":2696,"_21381":59673,"_5":14694,"_28049":58978,"_3044":59674},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3588":2974,"_30857":2696,"_21381":59676,"_5":14694,"_28049":58978,"_3044":59677},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3588":2975,"_30857":2696,"_21381":59679,"_5":14694,"_28049":58978,"_3044":59680},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3588":2976,"_30857":2696,"_21381":59682,"_5":14694,"_28049":58978,"_3044":59683},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3588":2977,"_30857":2696,"_21381":59685,"_5":14694,"_28049":58978,"_3044":59686},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3588":2978,"_30857":2696,"_21381":59688,"_5":14694,"_28049":58978,"_3044":59689},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3588":2979,"_30857":2696,"_21381":59691,"_5":14694,"_28049":58978,"_3044":59692},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3588":2980,"_30857":2696,"_21381":59694,"_5":14694,"_28049":58978,"_3044":59695},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3588":2981,"_30857":2696,"_21381":59697,"_5":14694,"_28049":58978,"_3044":59698},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3588":2982,"_30857":2696,"_21381":59700,"_5":14694,"_28049":58978,"_3044":59701},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3588":2983,"_30857":2696,"_21381":59703,"_5":14694,"_28049":58978,"_3044":59704},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3588":2984,"_30857":2696,"_21381":59706,"_5":14694,"_28049":58978,"_3044":59707},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3588":2985,"_30857":2696,"_21381":59709,"_5":14694,"_28049":58982,"_3044":59710},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3588":2986,"_30857":2696,"_21381":59712,"_5":14694,"_28049":58982,"_3044":59713},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3588":2987,"_30857":2696,"_21381":59715,"_5":14694,"_28049":58986,"_3044":59716},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3588":2988,"_30857":2696,"_21381":59718,"_5":14694,"_28049":58986,"_3044":59719},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3588":2989,"_30857":2696,"_21381":59721,"_5":14694,"_28049":58986,"_3044":59722},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3588":2990,"_30857":2696,"_21381":59724,"_5":14694,"_28049":58986,"_3044":59725},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3588":2991,"_30857":2696,"_21381":59727,"_5":14694,"_28049":58986,"_3044":59728},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3588":2992,"_30857":2696,"_21381":59730,"_5":14694,"_28049":58986,"_3044":59731},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3588":2993,"_30857":2696,"_21381":59733,"_5":14694,"_28049":58986,"_3044":59734},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3588":2994,"_30857":2696,"_21381":59736,"_5":14694,"_28049":58986,"_3044":59737},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3588":2995,"_30857":2696,"_21381":59739,"_5":14694,"_28049":58986,"_3044":59740},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3588":2996,"_30857":2696,"_21381":59742,"_5":14694,"_28049":58986,"_3044":59743},[],"**Remove the helper and restore the recorded replica counts:**",{"_3588":2997,"_30857":2696,"_21381":59745,"_5":14694,"_28049":58986,"_3044":59746},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3588":2998,"_30857":2696,"_21381":59748,"_5":14694,"_28049":58990,"_3044":59749},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3588":2999,"_30857":2696,"_21381":59751,"_5":14694,"_28049":58990,"_3044":59752},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3588":3000,"_30857":2696,"_21381":59754,"_5":14694,"_28049":58994,"_3044":59755},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3588":3001,"_30857":2696,"_21381":59757,"_5":14694,"_28049":58994,"_3044":59758},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3588":3002,"_30857":2696,"_21381":59760,"_5":14694,"_28049":58994,"_3044":59761},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3588":3003,"_30857":2696,"_21381":59763,"_5":14694,"_28049":58994,"_3044":59764},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3588":3004,"_30857":2696,"_21381":59766,"_5":14694,"_28049":58994,"_3044":59767},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3588":3005,"_30857":2696,"_21381":59769,"_5":14694,"_28049":58994,"_3044":59770},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3588":3006,"_30857":2696,"_21381":59772,"_5":14694,"_28049":58994,"_3044":59773},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3588":3007,"_30857":2696,"_21381":59775,"_5":14694,"_28049":58994,"_3044":59776},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3588":3008,"_30857":2696,"_21381":59778,"_5":14694,"_28049":58998,"_3044":59779},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3588":3009,"_30857":2696,"_21381":59781,"_5":14694,"_28049":58998,"_3044":59782},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3588":3010,"_30857":2696,"_21381":59784,"_5":14694,"_28049":58998,"_3044":59785},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3588":3011,"_30857":2696,"_21381":59787,"_5":14694,"_28049":58998,"_3044":59788},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3588":3012,"_30857":2696,"_21381":59790,"_5":14694,"_28049":58998,"_3044":59791},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3588":3013,"_30857":2696,"_21381":59793,"_5":14694,"_28049":58998,"_3044":59794},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3588":3014,"_30857":2696,"_21381":59796,"_5":14694,"_28049":58998,"_3044":59797},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3588":3015,"_30857":2696,"_21381":59799,"_5":14694,"_28049":58998,"_3044":59800},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3588":3016,"_30857":2696,"_21381":59802,"_5":14694,"_28049":58998,"_3044":59803},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3588":3017,"_30857":2696,"_21381":59805,"_5":14694,"_28049":58998,"_3044":59806},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3588":3018,"_30857":2696,"_21381":59808,"_5":14694,"_28049":58998,"_3044":59809},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3588":3019,"_30857":2696,"_21381":59811,"_5":14694,"_28049":59001,"_3044":59812},[],"After the upgrade, check in this order:",{"_3588":3020,"_30857":2696,"_21381":59814,"_5":14694,"_28049":59001,"_3044":59815},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3588":3021,"_30857":2696,"_21381":59817,"_5":14694,"_28049":59001,"_3044":59818},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3588":3022,"_30857":2696,"_21381":59820,"_5":14694,"_28049":59001,"_3044":59821},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3588":3023,"_30857":2696,"_21381":59823,"_5":14694,"_28049":59001,"_3044":59824},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3588":3024,"_30857":2696,"_21381":59826,"_5":14694,"_28049":59001,"_3044":59827},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3588":3025,"_30857":2696,"_21381":59829,"_5":14694,"_28049":59001,"_3044":59830},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3588":3026,"_30857":2696,"_21381":59832,"_5":14694,"_28049":59001,"_3044":59833},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3588":3027,"_30857":2696,"_21381":59835,"_5":14694,"_28049":59001,"_3044":59836},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3588":3028,"_30857":2696,"_21381":59838,"_5":14694,"_28049":59001,"_3044":59839},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3588":3029,"_30857":2696,"_21381":59841,"_5":14694,"_28049":59001,"_3044":59842},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3588":3030,"_30857":2696,"_21381":59844,"_5":14694,"_28049":59001,"_3044":59845},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3588":3031,"_30857":2696,"_21381":59847,"_5":14694,"_28049":59001,"_3044":59848},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3588":3032,"_30857":2696,"_21381":59850,"_5":14694,"_28049":59001,"_3044":59851},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3588":3033,"_30857":2696,"_21381":59853,"_5":14694,"_28049":59001,"_3044":59854},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3588":3034,"_30857":2696,"_21381":59856,"_5":14694,"_28049":59001,"_3044":59857},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3588":3035,"_30857":2696,"_21381":59859,"_5":14694,"_28049":59005,"_3044":59860},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3588":3036,"_30857":2696,"_21381":59862,"_5":14694,"_28049":59005,"_3044":59863},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3588":3037,"_30857":2696,"_21381":59865,"_5":14694,"_28049":59005,"_3044":59866},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3588":3038,"_30857":2696,"_21381":59868,"_5":14694,"_28049":59005,"_3044":59869},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3588":3039,"_30857":2696,"_21381":59871,"_5":14694,"_28049":59005,"_3044":59872},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_59875":59876,"_59877":59878,"_59879":59880,"_59881":59882,"_18516":3079,"_71996":3079},"language","english","sortableProperties",[3044,30857,5,28049],"sortablePropertiesWithTypes",{"_3044":25523,"_30857":25523,"_5":25523,"_28049":25523},"sorts",{"_3044":59883,"_30857":62912,"_5":65940,"_28049":68968},{"_4782":59884,"_59885":59886,"_5":25523},{"_14770":5272,"_15153":4539,"_15172":9816,"_29861":3928,"_15159":5996,"_20287":21605,"_14791":8070,"_14798":14734,"_29803":3231,"_30212":6404,"_30233":3257,"_29837":4628,"_35251":5746,"_29940":7726,"_30277":5078,"_35258":30448,"_35261":10424,"_35264":7203,"_35267":6141,"_30679":6688,"_35272":6247,"_35274":3926,"_30714":6362,"_15168":3332,"_35278":3431,"_35281":5034,"_35283":6376,"_30261":7172,"_30699":6170,"_30727":5135,"_35288":7209,"_35290":23253,"_35292":7188,"_29957":3144,"_35295":6900,"_35297":7771,"_35299":10726,"_35301":3769,"_35303":14618,"_29874":7859,"_35306":4910,"_35308":3651,"_29868":12961,"_30298":20791,"_35312":3294,"_35314":7407,"_35317":15924,"_29914":7515,"_35321":6797,"_29794":5897,"_35324":6014,"_29842":3460,"_35327":6669,"_35329":7818,"_35332":3461,"_15162":6320,"_35335":3548,"_35337":4577,"_35340":3459,"_35342":4744,"_35344":6351,"_35346":3781,"_35348":11240,"_20290":6552,"_35351":4120,"_35353":6112,"_29815":7845,"_30255":7896,"_35357":6147,"_30922":4336,"_35360":4191,"_30744":9444,"_35363":3758,"_35365":6208,"_35367":16654,"_30837":12572,"_30314":16120,"_35371":3211,"_35373":3350,"_29852":5406,"_35376":14175,"_35378":3765,"_35380":14466,"_30760":3337,"_29934":3354,"_29314":6013,"_35385":6774,"_35387":7155,"_35389":4443,"_29983":5093,"_35393":3381,"_30249":7806,"_35397":16136,"_35399":4444,"_35401":5204,"_35403":11247,"_35405":5200,"_35407":17602,"_29972":3296,"_30217":13335,"_35411":20592,"_35413":7617,"_35415":16121,"_35418":3499,"_35420":4931,"_35422":9298,"_35424":17181,"_35426":3313,"_35428":9062,"_35430":21330,"_35433":11865,"_35435":8180,"_35437":3379,"_35439":4905,"_35441":3800,"_35444":7148,"_35446":4304,"_35449":6470,"_35452":20594,"_35454":22069,"_35456":3816,"_35458":7467,"_35460":7112,"_35462":50439,"_35464":7864,"_35466":4810,"_35468":6144,"_30260":5733,"_35471":5081,"_35473":16119,"_35475":4049,"_35477":4092,"_35479":3959,"_35481":6831,"_35483":6466,"_35485":3508,"_35487":7693,"_35489":5167,"_35491":14318,"_35493":5307,"_35495":4809,"_35497":3920,"_35499":15605,"_35501":5970,"_35503":6099,"_35505":6400,"_35507":4090,"_35509":3081,"_35511":4198,"_35513":5127,"_35515":7101,"_35517":5469,"_35519":5080,"_355