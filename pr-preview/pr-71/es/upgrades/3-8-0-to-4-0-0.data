ets/integrations/aws-iot-core",{"_69":316},"platform/iot-fleets/integrations/aws-iot-core.mdx","es:platform/iot-fleets/integrations",{"_200":319},"platform/iot-fleets/integrations/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud shrink-0\" aria-hidden=\"true\"><path d=\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z\"></path></svg>","es:platform/iot-fleets",{"_200":323},"platform/iot-fleets/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cpu shrink-0\" aria-hidden=\"true\"><path d=\"M12 20v2\"></path><path d=\"M12 2v2\"></path><path d=\"M17 20v2\"></path><path d=\"M17 2v2\"></path><path d=\"M2 12h2\"></path><path d=\"M2 17h2\"></path><path d=\"M2 7h2\"></path><path d=\"M20 12h2\"></path><path d=\"M20 17h2\"></path><path d=\"M20 7h2\"></path><path d=\"M7 20v2\"></path><path d=\"M7 2v2\"></path><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"></rect><rect x=\"8\" y=\"8\" width=\"8\" height=\"8\" rx=\"1\"></rect></svg>",{"_43":326,"_50":62,"_45":211,"_56":327,"_65":-7,"_11":328,"_67":329},"es:platform/iot-fleets/overview.mdx","Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.","/docs/pr-preview/pr-71/es/platform/iot-fleets/overview",{"_69":330},"platform/iot-fleets/overview.mdx",{"_50":51,"_45":332,"_53":-7,"_55":-7,"_56":-7,"_58":-7,"_47":333,"_43":368,"_67":369,"_65":-7},"Administración",[334,354,361],{"_50":51,"_45":335,"_53":-7,"_55":-7,"_56":-7,"_58":-7,"_47":336,"_43":351,"_67":352,"_65":-7},"Control de acceso",[337,344],{"_43":338,"_50":62,"_45":339,"_56":340,"_65":-7,"_11":341,"_67":342},"es:platform/administration/access-control/index.m