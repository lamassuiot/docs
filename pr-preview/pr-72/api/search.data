1,"_41496":128994,"_41498":128997},{"_3608":72406,"_31008":72406,"_5":15126,"_3064":119755,"_31366":119756,"_21483":119759,"_28195":72406},"Despliega desde AWS Marketplace",[50713,119757,119758],"Despliegue","Otros modelos",[],{"_3608":72407,"_31008":72406,"_21483":119761,"_5":14766,"_28195":72406,"_3064":119762},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3608":72408,"_31008":72406,"_5":31363,"_21483":119764,"_28195":119765,"_3064":119766},[],"/docs/pr-preview/pr-72/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3608":72409,"_31008":72406,"_5":31363,"_21483":119768,"_28195":119769,"_3064":119770},[],"/docs/pr-preview/pr-72/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3608":72410,"_31008":72406,"_5":31363,"_21483":119772,"_28195":119773,"_3064":119774},[],"/docs/pr-preview/pr-72/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3608":72411,"_31008":72406,"_5":31363,"_21483":119776,"_28195":119777,"_3064":119778},[],"/docs/pr-preview/pr-72/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3608":72412,"_31008":72406,"_5":31363,"_21483":119780,"_28195":119781,"_3064":119782},[],"/docs/pr-preview/pr-72/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3608":72413,"_31008":72406,"_5":31363,"_21483":119784,"_28195":119785,"_3064":119786},[],"/docs/pr-preview/pr-72/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3608":72414,"_31008":72406,"_5":31363,"_21483":119788,"_28195":119789,"_3064":119790},[],"/docs/pr-preview/pr-72/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3608":72415,"_31008":72406,"_21483":119792,"_5":14766,"_28195":72406,"_3064":119793},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3608":72416,"_31008":72406,"_21483":119795,"_5":14766,"_28195":119765,"_3064":119796},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3608":72417,"_31008":72406,"_21483":119798,"_5":14766,"_28195":119765,"_3064":119799},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3608":72418,"_31008":72406,"_21483":119801,"_5":14766,"_28195":119765,"_3064":119802},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3608":72419,"_31008":72406,"_21483":119804,"_5":14766,"_28195":119769,"_3064":119805},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3608":72420,"_31008":72406,"_21483":119807,"_5":14766,"_28195":119769,"_3064":119808},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3608":72421,"_31008":72406,"_21483":119810,"_5":14766,"_28195":119769,"_3064":119811},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3608":72422,"_31008":72406,"_21483":119813,"_5":14766,"_28195":119773,"_3064":119814},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3608":72423,"_31008":72406,"_21483":119816,"_5":14766,"_28195":119777,"_3064":119817},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3608":72424,"_31008":72406,"_21483":119819,"_5":14766,"_28195":119781,"_3064":119820},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3608":72425,"_31008":72406,"_21483":119822,"_5":14766,"_28195":119785,"_3064":119823},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3608":72426,"_31008":72406,"_21483":119825,"_5":14766,"_28195":119789,"_3064":119826},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3608":72427,"_31008":72427,"_5":15126,"_3064":119828,"_31366":119829,"_21483":119830,"_28195":72427},"Despliega Lamassu",[50713,119757],[],{"_3608":72428,"_31008":72427,"_21483":119832,"_5":14766,"_28195":72427,"_3064":119833},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3608":72429,"_31008":72427,"_5":31363,"_21483":119835,"_28195":119836,"_3064":119837},[],"/docs/pr-preview/pr-72/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3608":72430,"_31008":72427,"_5":31363,"_21483":119839,"_28195":119840,"_3064":119841},[],"/docs/pr-preview/pr-72/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3608":72431,"_31008":72427,"_5":31363,"_21483":119843,"_28195":119844,"_3064":119845},[],"/docs/pr-preview/pr-72/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3608":72432,"_31008":72427,"_21483":119847,"_5":14766,"_28195":72427,"_3064":119848},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3608":72433,"_31008":72427,"_21483":119850,"_5":14766,"_28195":119836,"_3064":119851},[],"Modelo",{"_3608":72434,"_31008":72427,"_21483":119853,"_5":14766,"_28195":119836,"_3064":119854},[],"Recomendado para",{"_3608":72435,"_31008":72427,"_21483":119856,"_5":14766,"_28195":119836,"_3064":119857},[],"Quién opera la infraestructura",{"_3608":72436,"_31008":72427,"_21483":119859,"_5":14766,"_28195":119836,"_3064":119860},[],"Punto de partida",{"_3608":72437,"_31008":72427,"_21483":119862,"_5":14766,"_28195":119836,"_3064":50820},[],{"_3608":72438,"_31008":72427,"_21483":119864,"_5":14766,"_28195":119836,"_3064":119865},[],"Producción, entornos regulados y despliegues personalizados",{"_3608":72439,"_31008":72427,"_21483":119867,"_5":14766,"_28195":119836,"_3064":119868},[],"Tu equipo",{"_3608":72440,"_31008":72427,"_21483":119870,"_5":14766,"_28195":119836,"_3064":119871},[],"Helm o Fastlane",{"_3608":72441,"_31008":72427,"_21483":119873,"_5":14766,"_28195":119836,"_3064":50832},[],{"_3608":72442,"_31008":72427,"_21483":119875,"_5":14766,"_28195":119836,"_3064":119876},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3608":72443,"_31008":72427,"_21483":119878,"_5":14766,"_28195":119836,"_3064":119868},[],{"_3608":72444,"_31008":72427,"_21483":119880,"_5":14766,"_28195":119836,"_3064":119881},[],"Imagen preconfigurada en EC2",{"_3608":72445,"_31008":72427,"_21483":119883,"_5":14766,"_28195":119836,"_3064":50843},[],{"_3608":72446,"_31008":72427,"_21483":119885,"_5":14766,"_28195":119836,"_3064":119886},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3608":72447,"_31008":72427,"_21483":119888,"_5":14766,"_28195":119836,"_3064":50849},[],{"_3608":72448,"_31008":72427,"_21483":119890,"_5":14766,"_28195":119836,"_3064":119891},[],"Suscripción gestionada",{"_3608":72449,"_31008":72427,"_21483":119893,"_5":14766,"_28195":119836,"_3064":119894},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3608":72450,"_31008":72427,"_21483":119896,"_5":14766,"_28195":119836,"_3064":119897},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3608":72451,"_31008":72427,"_21483":119899,"_5":14766,"_28195":119836,"_3064":119900},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3608":72452,"_31008":72427,"_21483":119902,"_5":14766,"_28195":119840,"_3064":119903},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3608":72453,"_31008":72427,"_21483":119905,"_5":14766,"_28195":119844,"_3064":119906},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3608":72454,"_31008":72454,"_5":15126,"_3064":119908,"_31366":119909,"_21483":119910,"_28195":72454},"Utiliza Lamassu como SaaS",[50713,119757,119758],[],{"_3608":72455,"_31008":72454,"_21483":119912,"_5":14766,"_28195":72454,"_3064":119913},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3608":72456,"_31008":72454,"_5":31363,"_21483":119915,"_28195":119916,"_3064":119917},[],"/docs/pr-preview/pr-72/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3608":72457,"_31008":72454,"_5":31363,"_21483":119919,"_28195":119920,"_3064":119921},[],"/docs/pr-preview/pr-72/es/deployment/saas#planes","Planes",{"_3608":72458,"_31008":72454,"_5":31363,"_21483":119923,"_28195":119924,"_3064":119925},[],"/docs/pr-preview/pr-72/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3608":72459,"_31008":72454,"_21483":119927,"_5":14766,"_28195":72454,"_3064":119928},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3608":72460,"_31008":72454,"_21483":119930,"_5":14766,"_28195":119916,"_3064":119931},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3608":72461,"_31008":72454,"_21483":119933,"_5":14766,"_28195":119916,"_3064":119934},[],"Copias de seguridad automáticas.",{"_3608":72462,"_31008":72454,"_21483":119936,"_5":14766,"_28195":119916,"_3064":119937},[],"Actualizaciones de versión.",{"_3608":72463,"_31008":72454,"_21483":119939,"_5":14766,"_28195":119916,"_3064":119940},[],"Soporte técnico y SLA según el plan contratado.",{"_3608":72464,"_31008":72454,"_21483":119942,"_5":14766,"_28195":119920,"_3064":50904},[],{"_3608":72465,"_31008":72454,"_21483":119944,"_5":14766,"_28195":119920,"_3064":119945},[],"Dispositivos",{"_3608":72466,"_31008":72454,"_21483":119947,"_5":14766,"_28195":119920,"_3064":119948},[],"Soporte",{"_3608":72467,"_31008":72454,"_21483":119950,"_5":14766,"_28195":119920,"_3064":50913},[],{"_3608":72468,"_31008":72454,"_21483":119952,"_5":14766,"_28195":119920,"_3064":50916},[],{"_3608":72469,"_31008":72454,"_21483":119954,"_5":14766,"_28195":119920,"_3064":119955},[],"Hasta 1.000",{"_3608":72470,"_31008":72454,"_21483":119957,"_5":14766,"_28195":119920,"_3064":50922},[],{"_3608":72471,"_31008":72454,"_21483":119959,"_5":14766,"_28195":119920,"_3064":119960},[],"99,5 %",{"_3608":72472,"_31008":72454,"_21483":119962,"_5":14766,"_28195":119920,"_3064":50928},[],{"_3608":72473,"_31008":72454,"_21483":119964,"_5":14766,"_28195":119920,"_3064":119965},[],"Hasta 10.000",{"_3608":72474,"_31008":72454,"_21483":119967,"_5":14766,"_28195":119920,"_3064":119968},[],"Email y chat",{"_3608":72475,"_31008":72454,"_21483":119970,"_5":14766,"_28195":119920,"_3064":119971},[],"99,9 %",{"_3608":72476,"_31008":72454,"_21483":119973,"_5":14766,"_28195":119920,"_3064":50940},[],{"_3608":72477,"_31008":72454,"_21483":119975,"_5":14766,"_28195":119920,"_3064":119976},[],"Ilimitados",{"_3608":72478,"_31008":72454,"_21483":119978,"_5":14766,"_28195":119920,"_3064":119979},[],"Dedicado",{"_3608":72479,"_31008":72454,"_21483":119981,"_5":14766,"_28195":119920,"_3064":119982},[],"99,99 %",{"_3608":72480,"_31008":72454,"_21483":119984,"_5":14766,"_28195":119924,"_3064":119985},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3608":72481,"_31008":72454,"_21483":119987,"_5":14766,"_28195":119924,"_3064":119988},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3608":72482,"_31008":72482,"_5":15126,"_3064":50957,"_31366":119990,"_21483":119992,"_28195":72482},[50713,119757,119991],"Kubernetes autogestionado",[],{"_3608":72483,"_31008":72482,"_21483":119994,"_5":14766,"_28195":72482,"_3064":119995},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3608":72484,"_31008":72482,"_5":31363,"_21483":119997,"_28195":119998,"_3064":119999},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3608":72485,"_31008":72482,"_5":31363,"_21483":120001,"_28195":120002,"_3064":120003},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3608":72486,"_31008":72482,"_5":31363,"_21483":120005,"_28195":120006,"_3064":120007},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3608":72487,"_31008":72482,"_5":31363,"_21483":120009,"_28195":120010,"_3064":120011},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3608":72488,"_31008":72482,"_5":31363,"_21483":120013,"_28195":120014,"_3064":120015},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3608":72489,"_31008":72482,"_5":31363,"_21483":120017,"_28195":120018,"_3064":120019},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3608":72490,"_31008":72482,"_5":31363,"_21483":120021,"_28195":120022,"_3064":120023},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3608":72491,"_31008":72482,"_5":31363,"_21483":120025,"_28195":120026,"_3064":120027},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3608":72492,"_31008":72482,"_5":31363,"_21483":120029,"_28195":120030,"_3064":120031},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3608":72493,"_31008":72482,"_5":31363,"_21483":120033,"_28195":120034,"_3064":120035},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3608":72494,"_31008":72482,"_5":31363,"_21483":120037,"_28195":120038,"_3064":120039},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3608":72495,"_31008":72482,"_21483":120041,"_5":14766,"_28195":119998,"_3064":120042},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3608":72496,"_31008":72482,"_21483":120044,"_5":14766,"_28195":119998,"_3064":120045},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3608":72497,"_31008":72482,"_21483":120047,"_5":14766,"_28195":120002,"_3064":120048},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3608":72498,"_31008":72482,"_21483":120050,"_5":14766,"_28195":120002,"_3064":120051},[],"Fastlane instala o configura",{"_3608":72499,"_31008":72482,"_21483":120053,"_5":14766,"_28195":120002,"_3064":120054},[],"Tú sigues proporcionando",{"_3608":72500,"_31008":72482,"_21483":120056,"_5":14766,"_28195":120002,"_3064":120057},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3608":72501,"_31008":72482,"_21483":120059,"_5":14766,"_28195":120002,"_3064":120060},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3608":72502,"_31008":72482,"_21483":120062,"_5":14766,"_28195":120002,"_3064":120063},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3608":72503,"_31008":72482,"_21483":120065,"_5":14766,"_28195":120002,"_3064":120066},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3608":72504,"_31008":72482,"_21483":120068,"_5":14766,"_28195":120002,"_3064":120069},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3608":72505,"_31008":72482,"_21483":120071,"_5":14766,"_28195":120002,"_3064":120072},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3608":72506,"_31008":72482,"_21483":120074,"_5":14766,"_28195":120002,"_3064":120075},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3608":72507,"_31008":72482,"_21483":120077,"_5":14766,"_28195":120002,"_3064":120078},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3608":72508,"_31008":72482,"_21483":120080,"_5":14766,"_28195":120002,"_3064":120081},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3608":72509,"_31008":72482,"_21483":120083,"_5":14766,"_28195":120006,"_3064":120084},[],"Necesitas:",{"_3608":72510,"_31008":72482,"_21483":120086,"_5":14766,"_28195":120006,"_3064":120087},[],"un clúster Kubernetes existente",{"_3608":72511,"_31008":72482,"_21483":120089,"_5":14766,"_28195":120006,"_3064":120090},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3608":72512,"_31008":72482,"_21483":120092,"_5":14766,"_28195":120006,"_3064":51059},[],{"_3608":72513,"_31008":72482,"_21483":120094,"_5":14766,"_28195":120006,"_3064":24284},[],{"_3608":72514,"_31008":72482,"_21483":120096,"_5":14766,"_28195":120006,"_3064":120097},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3608":72515,"_31008":72482,"_21483":120099,"_5":14766,"_28195":120006,"_3064":120100},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3608":72516,"_31008":72482,"_21483":120102,"_5":14766,"_28195":120006,"_3064":120103},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3608":72517,"_31008":72482,"_21483":120105,"_5":14766,"_28195":120006,"_3064":120106},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3608":72518,"_31008":72482,"_21483":120108,"_5":14766,"_28195":120006,"_3064":120109},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3608":72519,"_31008":72482,"_21483":120111,"_5":14766,"_28195":120010,"_3064":120112},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3608":72520,"_31008":72482,"_21483":120114,"_5":14766,"_28195":120010,"_3064":120115},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3608":72521,"_31008":72482,"_21483":120117,"_5":14766,"_28195":120014,"_3064":120118},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3608":72522,"_31008":72482,"_21483":120120,"_5":14766,"_28195":120014,"_3064":120121},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3608":72523,"_31008":72482,"_21483":120123,"_5":14766,"_28195":120014,"_3064":120124},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3608":72524,"_31008":72482,"_21483":120126,"_5":14766,"_28195":120014,"_3064":120127},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3608":72525,"_31008":72482,"_21483":120129,"_5":14766,"_28195":120018,"_3064":120130},[],"Opción",{"_3608":72526,"_31008":72482,"_21483":120132,"_5":14766,"_28195":120018,"_3064":120133},[],"Valor predeterminado",{"_3608":72527,"_31008":72482,"_21483":120135,"_5":14766,"_28195":120018,"_3064":120136},[],"Propósito",{"_3608":72528,"_31008":72482,"_21483":120138,"_5":14766,"_28195":120018,"_3064":51106},[],{"_3608":72529,"_31008":72482,"_21483":120140,"_5":14766,"_28195":120018,"_3064":51109},[],{"_3608":72530,"_31008":72482,"_21483":120142,"_5":14766,"_28195":120018,"_3064":120143},[],"Muestra la ayuda",{"_3608":72531,"_31008":72482,"_21483":120145,"_5":14766,"_28195":120018,"_3064":51115},[],{"_3608":72532,"_31008":72482,"_21483":120147,"_5":14766,"_28195":120018,"_3064":120148},[],"contexto actual",{"_3608":72533,"_31008":72482,"_21483":120150,"_5":14766,"_28195":120018,"_3064":120151},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3608":72534,"_31008":72482,"_21483":120153,"_5":14766,"_28195":120018,"_3064":51124},[],{"_3608":72535,"_31008":72482,"_21483":120155,"_5":14766,"_28195":120018,"_3064":6767},[],{"_3608":72536,"_31008":72482,"_21483":120157,"_5":14766,"_28195":120018,"_3064":120158},[],"Omite prompts y genera credenciales para las dependencias",{"_3608":72537,"_31008":72482,"_21483":120160,"_5":14766,"_28195":120018,"_3064":51132},[],{"_3608":72538,"_31008":72482,"_21483":120162,"_5":14766,"_28195":120018,"_3064":51135},[],{"_3608":72539,"_31008":72482,"_21483":120164,"_5":14766,"_28195":120018,"_3064":120165},[],"Namespace de la instalación",{"_3608":72540,"_31008":72482,"_21483":120167,"_5":14766,"_28195":120018,"_3064":51141},[],{"_3608":72541,"_31008":72482,"_21483":120169,"_5":14766,"_28195":120018,"_3064":51144},[],{"_3608":72542,"_31008":72482,"_21483":120171,"_5":14766,"_28195":120018,"_3064":120172},[],"Dominio usado por la UI, OIDC y el certificado",{"_3608":72543,"_31008":72482,"_21483":120174,"_5":14766,"_28195":120018,"_3064":51150},[],{"_3608":72544,"_31008":72482,"_21483":120176,"_5":14766,"_28195":120018,"_3064":15477},[],{"_3608":72545,"_31008":72482,"_21483":120178,"_5":14766,"_28195":120018,"_3064":120179},[],"Versión del chart de Lamassu",{"_3608":72546,"_31008":72482,"_21483":120181,"_5":14766,"_28195":120018,"_3064":51158},[],{"_3608":72547,"_31008":72482,"_21483":120183,"_5":14766,"_28195":120018,"_3064":51161},[],{"_3608":72548,"_31008":72482,"_21483":120185,"_5":14766,"_28195":120018,"_3064":120186},[],"Puerto del listener HTTPS",{"_3608":72549,"_31008":72482,"_21483":120188,"_5":14766,"_28195":120018,"_3064":51167},[],{"_3608":72550,"_31008":72482,"_21483":120190,"_5":14766,"_28195":120018,"_3064":51170},[],{"_3608":72551,"_31008":72482,"_21483":120192,"_5":14766,"_28195":120018,"_3064":120193},[],"Puerto del listener HTTP",{"_3608":72552,"_31008":72482,"_21483":120195,"_5":14766,"_28195":120018,"_3064":51176},[],{"_3608":72553,"_31008":72482,"_21483":120197,"_5":14766,"_28195":120018,"_3064":51109},[],{"_3608":72554,"_31008":72482,"_21483":120199,"_5":14766,"_28195":120018,"_3064":120200},[],"Certificado PEM para TLS downstream",{"_3608":72555,"_31008":72482,"_21483":120202,"_5":14766,"_28195":120018,"_3064":51184},[],{"_3608":72556,"_31008":72482,"_21483":120204,"_5":14766,"_28195":120018,"_3064":51109},[],{"_3608":72557,"_31008":72482,"_21483":120206,"_5":14766,"_28195":120018,"_3064":120207},[],"Clave privada PEM para TLS downstream",{"_3608":72558,"_31008":72482,"_21483":120209,"_5":14766,"_28195":120018,"_3064":51192},[],{"_3608":72559,"_31008":72482,"_21483":120211,"_5":14766,"_28195":120018,"_3064":120212},[],"chart del repositorio",{"_3608":72560,"_31008":72482,"_21483":120214,"_5":14766,"_28195":120018,"_3064":120215},[],"Usa un chart local de Lamassu sin empaquetar",{"_3608":72561,"_31008":72482,"_21483":120217,"_5":14766,"_28195":120018,"_3064":51201},[],{"_3608":72562,"_31008":72482,"_21483":120219,"_5":14766,"_28195":120018,"_3064":120220},[],"detección automática",{"_3608":72563,"_31008":72482,"_21483":120222,"_5":14766,"_28195":120018,"_3064":120223},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3608":72564,"_31008":72482,"_21483":120225,"_5":14766,"_28195":120018,"_3064":51209},[],{"_3608":72565,"_31008":72482,"_21483":120227,"_5":14766,"_28195":120018,"_3064":6767},[],{"_3608":72566,"_31008":72482,"_21483":120229,"_5":14766,"_28195":120018,"_3064":120230},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3608":72567,"_31008":72482,"_21483":120232,"_5":14766,"_28195":120018,"_3064":51217},[],{"_3608":72568,"_31008":72482,"_21483":120234,"_5":14766,"_28195":120018,"_3064":6767},[],{"_3608":72569,"_31008":72482,"_21483":120236,"_5":14766,"_28195":120018,"_3064":120237},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3608":72570,"_31008":72482,"_21483":120239,"_5":14766,"_28195":120018,"_3064":51225},[],{"_3608":72571,"_31008":72482,"_21483":120241,"_5":14766,"_28195":120018,"_3064":6767},[],{"_3608":72572,"_31008":72482,"_21483":120243,"_5":14766,"_28195":120018,"_3064":120244},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3608":72573,"_31008":72482,"_21483":120246,"_5":14766,"_28195":120018,"_3064":51233},[],{"_3608":72574,"_31008":72482,"_21483":120248,"_5":14766,"_28195":120018,"_3064":6767},[],{"_3608":72575,"_31008":72482,"_21483":120250,"_5":14766,"_28195":120018,"_3064":120251},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3608":72576,"_31008":72482,"_21483":120253,"_5":14766,"_28195":120018,"_3064":51241},[],{"_3608":72577,"_31008":72482,"_21483":120255,"_5":14766,"_28195":120018,"_3064":51244},[],{"_3608":72578,"_31008":72482,"_21483":120257,"_5":14766,"_28195":120018,"_3064":120258},[],"Usa otro chart local de SoftHSM",{"_3608":72579,"_31008":72482,"_21483":120260,"_5":14766,"_28195":120018,"_3064":120261},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3608":72580,"_31008":72482,"_21483":120263,"_5":14766,"_28195":120022,"_3064":120264},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3608":72581,"_31008":72482,"_21483":120266,"_5":14766,"_28195":120022,"_3064":120267},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3608":72582,"_31008":72482,"_21483":120269,"_5":14766,"_28195":120022,"_3064":120270},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3608":72583,"_31008":72482,"_21483":120272,"_5":14766,"_28195":120022,"_3064":120273},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3608":72584,"_31008":72482,"_21483":120275,"_5":14766,"_28195":120022,"_3064":120276},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3608":72585,"_31008":72482,"_21483":120278,"_5":14766,"_28195":120022,"_3064":120279},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3608":72586,"_31008":72482,"_21483":120281,"_5":14766,"_28195":120026,"_3064":51271},[],{"_3608":72587,"_31008":72482,"_21483":120283,"_5":14766,"_28195":120026,"_3064":120284},[],"valida las herramientas locales y el clúster seleccionado",{"_3608":72588,"_31008":72482,"_21483":120286,"_5":14766,"_28195":120026,"_3064":120287},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3608":72589,"_31008":72482,"_21483":120289,"_5":14766,"_28195":120026,"_3064":120290},[],"crea el namespace",{"_3608":72590,"_31008":72482,"_21483":120292,"_5":14766,"_28195":120026,"_3064":120293},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3608":72591,"_31008":72482,"_21483":120295,"_5":14766,"_28195":120026,"_3064":120296},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3608":72592,"_31008":72482,"_21483":120298,"_5":14766,"_28195":120026,"_3064":120299},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3608":72593,"_31008":72482,"_21483":120301,"_5":14766,"_28195":120026,"_3064":120302},[],"instala RabbitMQ",{"_3608":72594,"_31008":72482,"_21483":120304,"_5":14766,"_28195":120026,"_3064":120305},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3608":72595,"_31008":72482,"_21483":120307,"_5":14766,"_28195":120026,"_3064":120308},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3608":72596,"_31008":72482,"_21483":120310,"_5":14766,"_28195":120026,"_3064":120311},[],"carga datos de ejemplo opcionalmente",{"_3608":72597,"_31008":72482,"_21483":120313,"_5":14766,"_28195":120026,"_3064":120314},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3608":72598,"_31008":72482,"_21483":120316,"_5":14766,"_28195":120030,"_3064":120317},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3608":72599,"_31008":72482,"_21483":120319,"_5":14766,"_28195":120030,"_3064":120320},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3608":72600,"_31008":72482,"_21483":120322,"_5":14766,"_28195":120034,"_3064":120323},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3608":72601,"_31008":72482,"_21483":120325,"_5":14766,"_28195":120034,"_3064":120326},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3608":72602,"_31008":72482,"_21483":120328,"_5":14766,"_28195":120034,"_3064":120329},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3608":72603,"_31008":72482,"_21483":120331,"_5":14766,"_28195":120034,"_3064":120332},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3608":72604,"_31008":72482,"_21483":120334,"_5":14766,"_28195":120038,"_3064":120335},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3608":72605,"_31008":72605,"_5":15126,"_3064":120337,"_31366":120338,"_21483":120339,"_28195":72605},"Instala con Helm",[50713,119757,119991],[],{"_3608":72606,"_31008":72605,"_21483":120341,"_5":14766,"_28195":72605,"_3064":120342},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3608":72607,"_31008":72605,"_5":31363,"_21483":120344,"_28195":120345,"_3064":120346},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3608":72608,"_31008":72605,"_5":31363,"_21483":120348,"_28195":120349,"_3064":120007},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3608":72609,"_31008":72605,"_5":31363,"_21483":120351,"_28195":120352,"_3064":120353},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3608":72610,"_31008":72605,"_5":31363,"_21483":120355,"_28195":120356,"_3064":120357},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3608":72611,"_31008":72605,"_5":31363,"_21483":120359,"_28195":120360,"_3064":120361},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3608":72612,"_31008":72605,"_5":31363,"_21483":120363,"_28195":120364,"_3064":120365},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3608":72613,"_31008":72605,"_5":31363,"_21483":120367,"_28195":120368,"_3064":120369},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3608":72614,"_31008":72605,"_5":31363,"_21483":120371,"_28195":120372,"_3064":120373},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3608":72615,"_31008":72605,"_5":31363,"_21483":120375,"_28195":120376,"_3064":120377},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3608":72616,"_31008":72605,"_5":31363,"_21483":120379,"_28195":120380,"_3064":120381},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3608":72617,"_31008":72605,"_5":31363,"_21483":120383,"_28195":120384,"_3064":120385},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3608":72618,"_31008":72605,"_5":31363,"_21483":120387,"_28195":120388,"_3064":120389},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3608":72619,"_31008":72605,"_21483":120391,"_5":14766,"_28195":120345,"_3064":120392},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3608":72620,"_31008":72605,"_21483":120394,"_5":14766,"_28195":120349,"_3064":120395},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3608":72621,"_31008":72605,"_21483":120397,"_5":14766,"_28195":120349,"_3064":120398},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3608":72622,"_31008":72605,"_21483":120400,"_5":14766,"_28195":120349,"_3064":120401},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3608":72623,"_31008":72605,"_21483":120403,"_5":14766,"_28195":120349,"_3064":120404},[],"un broker RabbitMQ accesible y sus credenciales",{"_3608":72624,"_31008":72605,"_21483":120406,"_5":14766,"_28195":120349,"_3064":120407},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3608":72625,"_31008":72605,"_21483":120409,"_5":14766,"_28195":120349,"_3064":120410},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3608":72626,"_31008":72605,"_21483":120412,"_5":14766,"_28195":120349,"_3064":120413},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3608":72627,"_31008":72605,"_21483":120415,"_5":14766,"_28195":120349,"_3064":120416},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3608":72628,"_31008":72605,"_21483":120418,"_5":14766,"_28195":120349,"_3064":120419},[],"una StorageClass y un diseño de tráfico externo",{"_3608":72629,"_31008":72605,"_21483":120421,"_5":14766,"_28195":120349,"_3064":120422},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3608":72630,"_31008":72605,"_21483":120424,"_5":14766,"_28195":120349,"_3064":120425},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3608":72631,"_31008":72605,"_21483":120427,"_5":14766,"_28195":120349,"_3064":120428},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3608":72632,"_31008":72605,"_21483":120430,"_5":14766,"_28195":120352,"_3064":120431},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3608":72633,"_31008":72605,"_21483":120433,"_5":14766,"_28195":120352,"_3064":120434},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3608":72634,"_31008":72605,"_21483":120436,"_5":14766,"_28195":120352,"_3064":120437},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3608":72635,"_31008":72605,"_21483":120439,"_5":14766,"_28195":120356,"_3064":120440},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3608":72636,"_31008":72605,"_21483":120442,"_5":14766,"_28195":120356,"_3064":120443},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3608":72637,"_31008":72605,"_21483":120445,"_5":14766,"_28195":120356,"_3064":120446},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3608":72638,"_31008":72605,"_21483":120448,"_5":14766,"_28195":120356,"_3064":120449},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3608":72639,"_31008":72605,"_21483":120451,"_5":14766,"_28195":120360,"_3064":120452},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3608":72640,"_31008":72605,"_21483":120454,"_5":14766,"_28195":120360,"_3064":120455},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3608":72641,"_31008":72605,"_21483":120457,"_5":14766,"_28195":120360,"_3064":120458},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3608":72642,"_31008":72605,"_21483":120460,"_5":14766,"_28195":120360,"_3064":120461},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3608":72643,"_31008":72605,"_21483":120463,"_5":14766,"_28195":120360,"_3064":120464},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3608":72644,"_31008":72605,"_21483":120466,"_5":14766,"_28195":120360,"_3064":120467},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3608":72645,"_31008":72605,"_21483":120469,"_5":14766,"_28195":120360,"_3064":120470},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3608":72646,"_31008":72605,"_21483":120472,"_5":14766,"_28195":120360,"_3064":120473},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3608":72647,"_31008":72605,"_21483":120475,"_5":14766,"_28195":120364,"_3064":120476},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3608":72648,"_31008":72605,"_21483":120478,"_5":14766,"_28195":120368,"_3064":120479},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3608":72649,"_31008":72605,"_21483":120481,"_5":14766,"_28195":120368,"_3064":120482},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3608":72650,"_31008":72605,"_21483":120484,"_5":14766,"_28195":120368,"_3064":120485},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3608":72651,"_31008":72605,"_21483":120487,"_5":14766,"_28195":120368,"_3064":120488},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3608":72652,"_31008":72605,"_21483":120490,"_5":14766,"_28195":120368,"_3064":120491},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3608":72653,"_31008":72605,"_21483":120493,"_5":14766,"_28195":120368,"_3064":120494},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3608":72654,"_31008":72605,"_21483":120496,"_5":14766,"_28195":120368,"_3064":120497},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3608":72655,"_31008":72605,"_21483":120499,"_5":14766,"_28195":120372,"_3064":120500},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3608":72656,"_31008":72605,"_21483":120502,"_5":14766,"_28195":120372,"_3064":120503},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3608":72657,"_31008":72605,"_21483":120505,"_5":14766,"_28195":120372,"_3064":120506},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3608":72658,"_31008":72605,"_21483":120508,"_5":14766,"_28195":120372,"_3064":120509},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3608":72659,"_31008":72605,"_21483":120511,"_5":14766,"_28195":120376,"_3064":120512},[],"Para instalar un checkout local:",{"_3608":72660,"_31008":72605,"_21483":120514,"_5":14766,"_28195":120380,"_3064":120515},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3608":72661,"_31008":72605,"_21483":120517,"_5":14766,"_28195":120380,"_3064":120518},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3608":72662,"_31008":72605,"_21483":120520,"_5":14766,"_28195":120384,"_3064":120521},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3608":72663,"_31008":72605,"_21483":120523,"_5":14766,"_28195":120384,"_3064":120524},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3608":72664,"_31008":72605,"_21483":120526,"_5":14766,"_28195":120384,"_3064":120527},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3608":72665,"_31008":72605,"_21483":120529,"_5":14766,"_28195":120384,"_3064":120530},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3608":72666,"_31008":72605,"_21483":120532,"_5":14766,"_28195":120384,"_3064":120533},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3608":72667,"_31008":72605,"_21483":120535,"_5":14766,"_28195":120388,"_3064":120536},[],"Antes de pasar a producción, revisa:",{"_3608":72668,"_31008":72605,"_21483":120538,"_5":14766,"_28195":120388,"_3064":120539},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3608":72669,"_31008":72605,"_21483":120541,"_5":14766,"_28195":120388,"_3064":120542},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3608":72670,"_31008":72605,"_21483":120544,"_5":14766,"_28195":120388,"_3064":120545},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3608":72671,"_31008":72605,"_21483":120547,"_5":14766,"_28195":120388,"_3064":120548},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3608":72672,"_31008":72605,"_21483":120550,"_5":14766,"_28195":120388,"_3064":120551},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3608":72673,"_31008":72605,"_21483":120553,"_5":14766,"_28195":120388,"_3064":120554},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3608":72674,"_31008":72605,"_21483":120556,"_5":14766,"_28195":120388,"_3064":120557},[],"SMTP, observabilidad y entrega de alertas",{"_3608":72675,"_31008":72605,"_21483":120559,"_5":14766,"_28195":120388,"_3064":120560},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3608":72676,"_31008":72605,"_21483":120562,"_5":14766,"_28195":120388,"_3064":120563},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3608":72677,"_31008":72677,"_5":15126,"_3064":120565,"_31366":120566,"_21483":120567,"_28195":72677},"Expón el Gateway",[50713,119757,119991],[],{"_3608":72678,"_31008":72677,"_21483":120569,"_5":14766,"_28195":72677,"_3064":120570},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3608":72679,"_31008":72677,"_5":31363,"_21483":120572,"_28195":120573,"_3064":120574},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3608":72680,"_31008":72677,"_5":31363,"_21483":120576,"_28195":120577,"_3064":120578},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3608":72681,"_31008":72677,"_5":31363,"_21483":120580,"_28195":120581,"_3064":120582},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3608":72682,"_31008":72677,"_5":31363,"_21483":120584,"_28195":120585,"_3064":51576},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/networking#k3s",{"_3608":72683,"_31008":72677,"_5":31363,"_21483":120587,"_28195":120588,"_3064":120589},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3608":72684,"_31008":72677,"_5":31363,"_21483":120591,"_28195":120592,"_3064":120593},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3608":72685,"_31008":72677,"_5":31363,"_21483":120595,"_28195":120596,"_3064":120597},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3608":72686,"_31008":72677,"_5":31363,"_21483":120599,"_28195":120600,"_3064":120601},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3608":72687,"_31008":72677,"_5":31363,"_21483":120603,"_28195":120604,"_3064":120605},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3608":72688,"_31008":72677,"_5":31363,"_21483":120607,"_28195":120608,"_3064":120609},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3608":72689,"_31008":72677,"_5":31363,"_21483":120611,"_28195":120612,"_3064":120613},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3608":72690,"_31008":72677,"_21483":120615,"_5":14766,"_28195":120573,"_3064":120616},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3608":72691,"_31008":72677,"_21483":120618,"_5":14766,"_28195":120573,"_3064":120619},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3608":72692,"_31008":72677,"_21483":120621,"_5":14766,"_28195":120577,"_3064":120622},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3608":72693,"_31008":72677,"_21483":120624,"_5":14766,"_28195":120577,"_3064":120625},[],"Defínelo únicamente cuando:",{"_3608":72694,"_31008":72677,"_21483":120627,"_5":14766,"_28195":120577,"_3064":120628},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3608":72695,"_31008":72677,"_21483":120630,"_5":14766,"_28195":120577,"_3064":120631},[],"esa dirección está asignada a este Gateway",{"_3608":72696,"_31008":72677,"_21483":120633,"_5":14766,"_28195":120577,"_3064":120634},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3608":72697,"_31008":72677,"_21483":120636,"_5":14766,"_28195":120577,"_3064":120637},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3608":72698,"_31008":72677,"_21483":120639,"_5":14766,"_28195":120577,"_3064":120640},[],"No confundas estos valores:",{"_3608":72699,"_31008":72677,"_21483":120642,"_5":14766,"_28195":120577,"_3064":120643},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3608":72700,"_31008":72677,"_21483":120645,"_5":14766,"_28195":120577,"_3064":120646},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3608":72701,"_31008":72677,"_21483":120648,"_5":14766,"_28195":120577,"_3064":120649},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3608":72702,"_31008":72677,"_21483":120651,"_5":14766,"_28195":120581,"_3064":120652},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3608":72703,"_31008":72677,"_21483":120654,"_5":14766,"_28195":120581,"_3064":120655},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3608":72704,"_31008":72677,"_21483":120657,"_5":14766,"_28195":120585,"_3064":120658},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3608":72705,"_31008":72677,"_21483":120660,"_5":14766,"_28195":120585,"_3064":120661},[],"Para el diseño recomendado:",{"_3608":72706,"_31008":72677,"_21483":120663,"_5":14766,"_28195":120585,"_3064":120664},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3608":72707,"_31008":72677,"_21483":120666,"_5":14766,"_28195":120585,"_3064":120667},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3608":72708,"_31008":72677,"_21483":120669,"_5":14766,"_28195":120585,"_3064":120670},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3608":72709,"_31008":72677,"_21483":120672,"_5":14766,"_28195":120585,"_3064":120673},[],"Apunta DNS a la dirección accesible de la VM.",{"_3608":72710,"_31008":72677,"_21483":120675,"_5":14766,"_28195":120585,"_3064":120676},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3608":72711,"_31008":72677,"_21483":120678,"_5":14766,"_28195":120588,"_3064":120679},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3608":72712,"_31008":72677,"_21483":120681,"_5":14766,"_28195":120592,"_3064":120682},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3608":72713,"_31008":72677,"_21483":120684,"_5":14766,"_28195":120592,"_3064":120685},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3608":72714,"_31008":72677,"_21483":120687,"_5":14766,"_28195":120596,"_3064":120688},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3608":72715,"_31008":72677,"_21483":120690,"_5":14766,"_28195":120596,"_3064":120691},[],"Requisito",{"_3608":72716,"_31008":72677,"_21483":120693,"_5":14766,"_28195":120596,"_3064":120694},[],"Diseño recomendado",{"_3608":72717,"_31008":72677,"_21483":120696,"_5":14766,"_28195":120596,"_3064":120697},[],"Consecuencia",{"_3608":72718,"_31008":72677,"_21483":120699,"_5":14766,"_28195":120596,"_3064":120700},[],"Varias URL o servicios de Lamassu",{"_3608":72719,"_31008":72677,"_21483":120702,"_5":14766,"_28195":120596,"_3064":120703},[],"Un Gateway con varias rutas",{"_3608":72720,"_31008":72677,"_21483":120705,"_5":14766,"_28195":120596,"_3064":120706},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3608":72721,"_31008":72677,"_21483":120708,"_5":14766,"_28195":120596,"_3064":120709},[],"Gateways independientes e IP externas distintas",{"_3608":72722,"_31008":72677,"_21483":120711,"_5":14766,"_28195":120596,"_3064":120712},[],"Una VIP por Gateway",{"_3608":72723,"_31008":72677,"_21483":120714,"_5":14766,"_28195":120596,"_3064":120715},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3608":72724,"_31008":72677,"_21483":120717,"_5":14766,"_28195":120596,"_3064":120718},[],"Gateways independientes, un nodo y una IP",{"_3608":72725,"_31008":72677,"_21483":120720,"_5":14766,"_28195":120596,"_3064":120721},[],"Puertos externos diferentes",{"_3608":72726,"_31008":72677,"_21483":120723,"_5":14766,"_28195":120596,"_3064":120724},[],"Los clientes deben indicar puertos no estándar",{"_3608":72727,"_31008":72677,"_21483":120726,"_5":14766,"_28195":120596,"_3064":120727},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3608":72728,"_31008":72677,"_21483":120729,"_5":14766,"_28195":120596,"_3064":120730},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3608":72729,"_31008":72677,"_21483":120732,"_5":14766,"_28195":120596,"_3064":120733},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3608":72730,"_31008":72677,"_21483":120735,"_5":14766,"_28195":120596,"_3064":120736},[],"Recursos Gateway separados pero proxy compartido",{"_3608":72731,"_31008":72677,"_21483":120738,"_5":14766,"_28195":120596,"_3064":120739},[],"Modo merged Gateway de Envoy",{"_3608":72732,"_31008":72677,"_21483":120741,"_5":14766,"_28195":120596,"_3064":120742},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3608":72733,"_31008":72677,"_21483":120744,"_5":14766,"_28195":120596,"_3064":120745},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3608":72734,"_31008":72677,"_21483":120747,"_5":14766,"_28195":120596,"_3064":120748},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3608":72735,"_31008":72677,"_21483":120750,"_5":14766,"_28195":120596,"_3064":120751},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3608":72736,"_31008":72677,"_21483":120753,"_5":14766,"_28195":120596,"_3064":120754},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3608":72737,"_31008":72677,"_21483":120756,"_5":14766,"_28195":120600,"_3064":120757},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3608":72738,"_31008":72677,"_21483":120759,"_5":14766,"_28195":120604,"_3064":120760},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3608":72739,"_31008":72677,"_21483":120762,"_5":14766,"_28195":120604,"_3064":120763},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3608":72740,"_31008":72677,"_21483":120765,"_5":14766,"_28195":120604,"_3064":120766},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3608":72741,"_31008":72677,"_21483":120768,"_5":14766,"_28195":120604,"_3064":120769},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3608":72742,"_31008":72677,"_21483":120771,"_5":14766,"_28195":120604,"_3064":120772},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3608":72743,"_31008":72677,"_21483":120774,"_5":14766,"_28195":120608,"_3064":120775},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3608":72744,"_31008":72677,"_21483":120777,"_5":14766,"_28195":120608,"_3064":120778},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3608":72745,"_31008":72677,"_21483":120780,"_5":14766,"_28195":120612,"_3064":120781},[],"Comprueba, en orden:",{"_3608":72746,"_31008":72677,"_21483":120783,"_5":14766,"_28195":120612,"_3064":120784},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3608":72747,"_31008":72677,"_21483":120786,"_5":14766,"_28195":120612,"_3064":120787},[],"Su estado contiene la dirección esperada.",{"_3608":72748,"_31008":72677,"_21483":120789,"_5":14766,"_28195":120612,"_3064":120790},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3608":72749,"_31008":72677,"_21483":120792,"_5":14766,"_28195":120612,"_3064":120793},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3608":72750,"_31008":72677,"_21483":120795,"_5":14766,"_28195":120612,"_3064":120796},[],"DNS resuelve al endpoint accesible externamente.",{"_3608":72751,"_31008":72677,"_21483":120798,"_5":14766,"_28195":120612,"_3064":120799},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3608":72752,"_31008":72677,"_21483":120801,"_5":14766,"_28195":120612,"_3064":120802},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3608":72753,"_31008":72753,"_5":15126,"_3064":50820,"_31366":120804,"_21483":120805,"_28195":72753},[50713,119757,119991],[],{"_3608":72754,"_31008":72753,"_21483":120807,"_5":14766,"_28195":72753,"_3064":120808},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3608":72755,"_31008":72753,"_5":31363,"_21483":120810,"_28195":120811,"_3064":120812},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3608":72756,"_31008":72753,"_5":31363,"_21483":120814,"_28195":120815,"_3064":120816},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3608":72757,"_31008":72753,"_5":31363,"_21483":120818,"_28195":120819,"_3064":120820},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3608":72758,"_31008":72753,"_5":31363,"_21483":120822,"_28195":120823,"_3064":120824},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3608":72759,"_31008":72753,"_5":31363,"_21483":120826,"_28195":120827,"_3064":120828},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3608":72760,"_31008":72753,"_5":31363,"_21483":120830,"_28195":120831,"_3064":120832},[],"/docs/pr-preview/pr-72/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3608":72761,"_31008":72753,"_21483":120834,"_5":14766,"_28195":120811,"_3064":120835},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3608":72762,"_31008":72753,"_21483":120837,"_5":14766,"_28195":120815,"_3064":120838},[],"Flujo",{"_3608":72763,"_31008":72753,"_21483":120840,"_5":14766,"_28195":120815,"_3064":120841},[],"Úsalo para",{"_3608":72764,"_31008":72753,"_21483":120843,"_5":14766,"_28195":120815,"_3064":120844},[],"Qué instala",{"_3608":72765,"_31008":72753,"_21483":120846,"_5":14766,"_28195":120815,"_3064":51838},[],{"_3608":72766,"_31008":72753,"_21483":120848,"_5":14766,"_28195":120815,"_3064":120849},[],"Producción y entornos controlados",{"_3608":72767,"_31008":72753,"_21483":120851,"_5":14766,"_28195":120815,"_3064":120852},[],"Servicios de Lamassu y recursos de Gateway API",{"_3608":72768,"_31008":72753,"_21483":120854,"_5":14766,"_28195":120815,"_3064":50957},[],{"_3608":72769,"_31008":72753,"_21483":120856,"_5":14766,"_28195":120815,"_3064":120857},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3608":72770,"_31008":72753,"_21483":120859,"_5":14766,"_28195":120815,"_3064":120860},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3608":72771,"_31008":72753,"_21483":120862,"_5":14766,"_28195":120819,"_3064":120863},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3608":72772,"_31008":72753,"_21483":120865,"_5":14766,"_28195":120819,"_3064":120866},[],"Área",{"_3608":72773,"_31008":72753,"_21483":120868,"_5":14766,"_28195":120819,"_3064":120869},[],"El chart de Lamassu proporciona",{"_3608":72774,"_31008":72753,"_21483":120871,"_5":14766,"_28195":120819,"_3064":120872},[],"Tú proporcionas",{"_3608":72775,"_31008":72753,"_21483":120874,"_5":14766,"_28195":120819,"_3064":120875},[],"Aplicaciones Lamassu",{"_3608":72776,"_31008":72753,"_21483":120877,"_5":14766,"_28195":120819,"_3064":120878},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3608":72777,"_31008":72753,"_21483":120880,"_5":14766,"_28195":120819,"_3064":120881},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3608":72778,"_31008":72753,"_21483":120883,"_5":14766,"_28195":120819,"_3064":120884},[],"Datos PostgreSQL",{"_3608":72779,"_31008":72753,"_21483":120886,"_5":14766,"_28195":120819,"_3064":120887},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3608":72780,"_31008":72753,"_21483":120889,"_5":14766,"_28195":120819,"_3064":120890},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3608":72781,"_31008":72753,"_21483":120892,"_5":14766,"_28195":120819,"_3064":120893},[],"Mensajería",{"_3608":72782,"_31008":72753,"_21483":120895,"_5":14766,"_28195":120819,"_3064":120896},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3608":72783,"_31008":72753,"_21483":120898,"_5":14766,"_28195":120819,"_3064":120899},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3608":72784,"_31008":72753,"_21483":120901,"_5":14766,"_28195":120819,"_3064":120902},[],"Identidad",{"_3608":72785,"_31008":72753,"_21483":120904,"_5":14766,"_28195":120819,"_3064":120905},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3608":72786,"_31008":72753,"_21483":120907,"_5":14766,"_28195":120819,"_3064":120908},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3608":72787,"_31008":72753,"_21483":120910,"_5":14766,"_28195":120819,"_3064":120911},[],"Enrutamiento externo",{"_3608":72788,"_31008":72753,"_21483":120913,"_5":14766,"_28195":120819,"_3064":120914},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3608":72789,"_31008":72753,"_21483":120916,"_5":14766,"_28195":120819,"_3064":120917},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3608":72790,"_31008":72753,"_21483":120919,"_5":14766,"_28195":120819,"_3064":51912},[],{"_3608":72791,"_31008":72753,"_21483":120921,"_5":14766,"_28195":120819,"_3064":120922},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3608":72792,"_31008":72753,"_21483":120924,"_5":14766,"_28195":120819,"_3064":120925},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3608":72793,"_31008":72753,"_21483":120927,"_5":14766,"_28195":120819,"_3064":120928},[],"Datos persistentes de la aplicación",{"_3608":72794,"_31008":72753,"_21483":120930,"_5":14766,"_28195":120819,"_3064":120931},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3608":72795,"_31008":72753,"_21483":120933,"_5":14766,"_28195":120819,"_3064":120934},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3608":72796,"_31008":72753,"_21483":120936,"_5":14766,"_28195":120819,"_3064":120937},[],"Integraciones opcionales",{"_3608":72797,"_31008":72753,"_21483":120939,"_5":14766,"_28195":120819,"_3064":120940},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3608":72798,"_31008":72753,"_21483":120942,"_5":14766,"_28195":120819,"_3064":120943},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3608":72799,"_31008":72753,"_21483":120945,"_5":14766,"_28195":120819,"_3064":120946},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3608":72800,"_31008":72753,"_21483":120948,"_5":14766,"_28195":120819,"_3064":120949},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3608":72801,"_31008":72753,"_21483":120951,"_5":14766,"_28195":120823,"_3064":120952},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3608":72802,"_31008":72753,"_21483":120954,"_5":14766,"_28195":120823,"_3064":120955},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3608":72803,"_31008":72753,"_21483":120957,"_5":14766,"_28195":120827,"_3064":120958},[],"Kubernetes 1.24 o posterior",{"_3608":72804,"_31008":72753,"_21483":120960,"_5":14766,"_28195":120827,"_3064":120961},[],"Helm 3.2 o posterior",{"_3608":72805,"_31008":72753,"_21483":120963,"_5":14766,"_28195":120827,"_3064":120964},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3608":72806,"_31008":72753,"_21483":120966,"_5":14766,"_28195":120827,"_3064":120967},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3608":72807,"_31008":72753,"_21483":120969,"_5":14766,"_28195":120827,"_3064":120970},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3608":72808,"_31008":72753,"_21483":120972,"_5":14766,"_28195":120827,"_3064":120973},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3608":72809,"_31008":72753,"_21483":120975,"_5":14766,"_28195":120827,"_3064":120976},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3608":72810,"_31008":72753,"_21483":120978,"_5":14766,"_28195":120831,"_3064":120979},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3608":72811,"_31008":72753,"_21483":120981,"_5":14766,"_28195":120831,"_3064":120982},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3608":72812,"_31008":72753,"_21483":120984,"_5":14766,"_28195":120831,"_3064":120985},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3608":72813,"_31008":72753,"_21483":120987,"_5":14766,"_28195":120831,"_3064":120988},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3608":72814,"_31008":72814,"_5":15126,"_3064":120990,"_31366":120991,"_21483":120993,"_28195":72814},"Resolución de problemas de despliegue",[50713,119757,120992],"Operación",[],{"_3608":72815,"_31008":72814,"_21483":120995,"_5":14766,"_28195":72814,"_3064":120996},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3608":72816,"_31008":72814,"_5":31363,"_21483":120998,"_28195":120999,"_3064":121000},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3608":72817,"_31008":72814,"_5":31363,"_21483":121002,"_28195":121003,"_3064":121004},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3608":72818,"_31008":72814,"_5":31363,"_21483":121006,"_28195":121007,"_3064":121008},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3608":72819,"_31008":72814,"_5":31363,"_21483":121010,"_28195":121011,"_3064":121012},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3608":72820,"_31008":72814,"_5":31363,"_21483":121014,"_28195":121015,"_3064":121016},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3608":72821,"_31008":72814,"_5":31363,"_21483":121018,"_28195":121019,"_3064":121020},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3608":72822,"_31008":72814,"_5":31363,"_21483":121022,"_28195":121023,"_3064":121024},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3608":72823,"_31008":72814,"_5":31363,"_21483":121026,"_28195":121027,"_3064":121028},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3608":72824,"_31008":72814,"_5":31363,"_21483":121030,"_28195":121031,"_3064":121032},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3608":72825,"_31008":72814,"_5":31363,"_21483":121034,"_28195":121035,"_3064":121036},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3608":72826,"_31008":72814,"_5":31363,"_21483":121038,"_28195":121039,"_3064":121040},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3608":72827,"_31008":72814,"_5":31363,"_21483":121042,"_28195":121043,"_3064":121044},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3608":72828,"_31008":72814,"_5":31363,"_21483":121046,"_28195":121047,"_3064":121048},[],"/docs/pr-preview/pr-72/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3608":72829,"_31008":72814,"_21483":121050,"_5":14766,"_28195":72814,"_3064":121051},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3608":72830,"_31008":72814,"_21483":121053,"_5":14766,"_28195":121003,"_3064":121054},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3608":72831,"_31008":72814,"_21483":121056,"_5":14766,"_28195":121007,"_3064":121057},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3608":72832,"_31008":72814,"_21483":121059,"_5":14766,"_28195":121011,"_3064":121060},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3608":72833,"_31008":72814,"_21483":121062,"_5":14766,"_28195":121015,"_3064":121063},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3608":72834,"_31008":72814,"_21483":121065,"_5":14766,"_28195":121019,"_3064":121066},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3608":72835,"_31008":72814,"_21483":121068,"_5":14766,"_28195":121023,"_3064":121069},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3608":72836,"_31008":72814,"_21483":121071,"_5":14766,"_28195":121023,"_3064":121072},[],"Ejecuta también la prueba de conectividad del chart:",{"_3608":72837,"_31008":72814,"_21483":121074,"_5":14766,"_28195":121023,"_3064":121075},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3608":72838,"_31008":72814,"_21483":121077,"_5":14766,"_28195":121023,"_3064":121078},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3608":72839,"_31008":72814,"_21483":121080,"_5":14766,"_28195":121027,"_3064":121081},[],"Si recibes un 401:",{"_3608":72840,"_31008":72814,"_21483":121083,"_5":14766,"_28195":121027,"_3064":121084},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3608":72841,"_31008":72814,"_21483":121086,"_5":14766,"_28195":121027,"_3064":121087},[],"verifica emisor, audiencia y expiración del token;",{"_3608":72842,"_31008":72814,"_21483":121089,"_5":14766,"_28195":121027,"_3064":121090},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3608":72843,"_31008":72814,"_21483":121092,"_5":14766,"_28195":121027,"_3064":121093},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3608":72844,"_31008":72814,"_21483":121095,"_5":14766,"_28195":121027,"_3064":121096},[],"Si el login termina pero las APIs devuelven 403:",{"_3608":72845,"_31008":72814,"_21483":121098,"_5":14766,"_28195":121027,"_3064":121099},[],"inspecciona los claims reales del token;",{"_3608":72846,"_31008":72814,"_21483":121101,"_5":14766,"_28195":121027,"_3064":121102},[],"confirma que coinciden con un principal activo;",{"_3608":72847,"_31008":72814,"_21483":121104,"_5":14766,"_28195":121027,"_3064":121105},[],"revisa las políticas concedidas al principal;",{"_3608":72848,"_31008":72814,"_21483":121107,"_5":14766,"_28195":121027,"_3064":121108},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3608":72849,"_31008":72814,"_21483":121110,"_5":14766,"_28195":121027,"_3064":121111},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3608":72850,"_31008":72814,"_21483":121113,"_5":14766,"_28195":121031,"_3064":121114},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3608":72851,"_31008":72814,"_21483":121116,"_5":14766,"_28195":121031,"_3064":121117},[],"Localiza el pod y Service de authz.",{"_3608":72852,"_31008":72814,"_21483":121119,"_5":14766,"_28195":121031,"_3064":121120},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3608":72853,"_31008":72814,"_21483":121122,"_5":14766,"_28195":121031,"_3064":121123},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3608":72854,"_31008":72814,"_21483":121125,"_5":14766,"_28195":121031,"_3064":121126},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3608":72855,"_31008":72814,"_21483":121128,"_5":14766,"_28195":121031,"_3064":121129},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3608":72856,"_31008":72814,"_21483":121131,"_5":14766,"_28195":121035,"_3064":121132},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3608":72857,"_31008":72814,"_21483":121134,"_5":14766,"_28195":121039,"_3064":121135},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3608":72858,"_31008":72814,"_21483":121137,"_5":14766,"_28195":121039,"_3064":121138},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3608":72859,"_31008":72814,"_21483":121140,"_5":14766,"_28195":121039,"_3064":121141},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3608":72860,"_31008":72814,"_21483":121143,"_5":14766,"_28195":121039,"_3064":121144},[],"volumen persistente sin enlazar;",{"_3608":72861,"_31008":72814,"_21483":121146,"_5":14766,"_28195":121039,"_3064":121147},[],"imagen inaccesible o política de pull incorrecta;",{"_3608":72862,"_31008":72814,"_21483":121149,"_5":14766,"_28195":121039,"_3064":121150},[],"configuración inválida del motor criptográfico;",{"_3608":72863,"_31008":72814,"_21483":121152,"_5":14766,"_28195":121039,"_3064":121153},[],"límites de CPU o memoria demasiado bajos;",{"_3608":72864,"_31008":72814,"_21483":121155,"_5":14766,"_28195":121039,"_3064":121156},[],"migración previa incompleta.",{"_3608":72865,"_31008":72814,"_21483":121158,"_5":14766,"_28195":121039,"_3064":121159},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3608":72866,"_31008":72814,"_21483":121161,"_5":14766,"_28195":121039,"_3064":121162},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3608":72867,"_31008":72814,"_21483":121164,"_5":14766,"_28195":121039,"_3064":121165},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3608":72868,"_31008":72814,"_21483":121167,"_5":14766,"_28195":121043,"_3064":121168},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3608":72869,"_31008":72814,"_21483":121170,"_5":14766,"_28195":121043,"_3064":121171},[],"verifica que esté habilitado en el servicio emisor;",{"_3608":72870,"_31008":72814,"_21483":121173,"_5":14766,"_28195":121043,"_3064":121174},[],"comprueba conectividad y credenciales AMQP;",{"_3608":72871,"_31008":72814,"_21483":121176,"_5":14766,"_28195":121043,"_3064":121177},[],"revisa exchange, routing key, colas y consumidores;",{"_3608":72872,"_31008":72814,"_21483":121179,"_5":14766,"_28195":121043,"_3064":121180},[],"inspecciona dead-letter queues;",{"_3608":72873,"_31008":72814,"_21483":121182,"_5":14766,"_28195":121043,"_3064":121183},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3608":72874,"_31008":72814,"_21483":121185,"_5":14766,"_28195":121043,"_3064":121186},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3608":72875,"_31008":72814,"_21483":121188,"_5":14766,"_28195":121043,"_3064":121189},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3608":72876,"_31008":72814,"_21483":121191,"_5":14766,"_28195":121043,"_3064":121192},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3608":72877,"_31008":72814,"_21483":121194,"_5":14766,"_28195":121043,"_3064":121195},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3608":72878,"_31008":72814,"_21483":121197,"_5":14766,"_28195":121043,"_3064":121198},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3608":72879,"_31008":72814,"_21483":121200,"_5":14766,"_28195":121043,"_3064":121201},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3608":72880,"_31008":72814,"_21483":121203,"_5":14766,"_28195":121043,"_3064":121204},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3608":72881,"_31008":72814,"_21483":121206,"_5":14766,"_28195":121047,"_3064":121207},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3608":72882,"_31008":72814,"_21483":121209,"_5":14766,"_28195":121047,"_3064":121210},[],"Antes de cerrar una incidencia, guarda:",{"_3608":72883,"_31008":72814,"_21483":121212,"_5":14766,"_28195":121047,"_3064":121213},[],"causa confirmada;",{"_3608":72884,"_31008":72814,"_21483":121215,"_5":14766,"_28195":121047,"_3064":121216},[],"alcance temporal y recursos afectados;",{"_3608":72885,"_31008":72814,"_21483":121218,"_5":14766,"_28195":121047,"_3064":121219},[],"comandos o consultas utilizados;",{"_3608":72886,"_31008":72814,"_21483":121221,"_5":14766,"_28195":121047,"_3064":121222},[],"cambio aplicado y forma de revertirlo;",{"_3608":72887,"_31008":72814,"_21483":121224,"_5":14766,"_28195":121047,"_3064":121225},[],"validación desde un consumidor;",{"_3608":72888,"_31008":72814,"_21483":121227,"_5":14766,"_28195":121047,"_3064":121228},[],"acción preventiva y propietario.",{"_3608":72889,"_31008":72889,"_5":15126,"_3064":121230,"_31366":121231,"_21483":121235,"_28195":72889},"Modelo de datos",[50713,121232,121233,121234],"Plataforma","Administración","Control de acceso",[],{"_3608":72890,"_31008":72889,"_21483":121237,"_5":14766,"_28195":72889,"_3064":121238},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3608":72891,"_31008":72889,"_5":31363,"_21483":121240,"_28195":121241,"_3064":121242},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3608":72892,"_31008":72889,"_5":31363,"_21483":121244,"_28195":121245,"_3064":121246},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3608":72893,"_31008":72889,"_21483":121248,"_5":14766,"_28195":72889,"_3064":121249},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3608":72894,"_31008":72889,"_21483":121251,"_5":14766,"_28195":121241,"_3064":121252},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3608":72895,"_31008":72889,"_21483":121254,"_5":14766,"_28195":121241,"_3064":121255},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3608":72896,"_31008":72889,"_21483":121257,"_5":14766,"_28195":121241,"_3064":121258},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3608":72897,"_31008":72889,"_21483":121260,"_5":14766,"_28195":121245,"_3064":121261},[],"Entidad (`schema_name.entity_type`)",{"_3608":72898,"_31008":72889,"_21483":121263,"_5":14766,"_28195":121245,"_3064":121264},[],"Tabla (`table_name`)",{"_3608":72899,"_31008":72889,"_21483":121266,"_5":14766,"_28195":121245,"_3064":121267},[],"Clave (`primary_key`)",{"_3608":72900,"_31008":72889,"_21483":121269,"_5":14766,"_28195":121245,"_3064":52263},[],{"_3608":72901,"_31008":72889,"_21483":121271,"_5":14766,"_28195":121245,"_3064":52266},[],{"_3608":72902,"_31008":72889,"_21483":121273,"_5":14766,"_28195":121245,"_3064":52269},[],{"_3608":72903,"_31008":72889,"_21483":121275,"_5":14766,"_28195":121245,"_3064":52272},[],{"_3608":72904,"_31008":72889,"_21483":121277,"_5":14766,"_28195":121245,"_3064":52275},[],{"_3608":72905,"_31008":72889,"_21483":121279,"_5":14766,"_28195":121245,"_3064":52278},[],{"_3608":72906,"_31008":72889,"_21483":121281,"_5":14766,"_28195":121245,"_3064":52281},[],{"_3608":72907,"_31008":72889,"_21483":121283,"_5":14766,"_28195":121245,"_3064":52284},[],{"_3608":72908,"_31008":72889,"_21483":121285,"_5":14766,"_28195":121245,"_3064":52278},[],{"_3608":72909,"_31008":72889,"_21483":121287,"_5":14766,"_28195":121245,"_3064":52289},[],{"_3608":72910,"_31008":72889,"_21483":121289,"_5":14766,"_28195":121245,"_3064":52292},[],{"_3608":72911,"_31008":72889,"_21483":121291,"_5":14766,"_28195":121245,"_3064":52295},[],{"_3608":72912,"_31008":72889,"_21483":121293,"_5":14766,"_28195":121245,"_3064":52298},[],{"_3608":72913,"_31008":72889,"_21483":121295,"_5":14766,"_28195":121245,"_3064":52301},[],{"_3608":72914,"_31008":72889,"_21483":121297,"_5":14766,"_28195":121245,"_3064":52278},[],{"_3608":72915,"_31008":72889,"_21483":121299,"_5":14766,"_28195":121245,"_3064":52306},[],{"_3608":72916,"_31008":72889,"_21483":121301,"_5":14766,"_28195":121245,"_3064":52309},[],{"_3608":72917,"_31008":72889,"_21483":121303,"_5":14766,"_28195":121245,"_3064":52278},[],{"_3608":72918,"_31008":72889,"_21483":121305,"_5":14766,"_28195":121245,"_3064":52314},[],{"_3608":72919,"_31008":72889,"_21483":121307,"_5":14766,"_28195":121245,"_3064":52317},[],{"_3608":72920,"_31008":72889,"_21483":121309,"_5":14766,"_28195":121245,"_3064":52278},[],{"_3608":72921,"_31008":72889,"_21483":121311,"_5":14766,"_28195":121245,"_3064":52322},[],{"_3608":72922,"_31008":72889,"_21483":121313,"_5":14766,"_28195":121245,"_3064":52325},[],{"_3608":72923,"_31008":72889,"_21483":121315,"_5":14766,"_28195":121245,"_3064":52278},[],{"_3608":72924,"_31008":72889,"_21483":121317,"_5":14766,"_28195":121245,"_3064":52330},[],{"_3608":72925,"_31008":72889,"_21483":121319,"_5":14766,"_28195":121245,"_3064":52333},[],{"_3608":72926,"_31008":72889,"_21483":121321,"_5":14766,"_28195":121245,"_3064":52336},[],{"_3608":72927,"_31008":72889,"_21483":121323,"_5":14766,"_28195":121245,"_3064":52339},[],{"_3608":72928,"_31008":72889,"_21483":121325,"_5":14766,"_28195":121245,"_3064":52342},[],{"_3608":72929,"_31008":72889,"_21483":121327,"_5":14766,"_28195":121245,"_3064":52345},[],{"_3608":72930,"_31008":72889,"_21483":121329,"_5":14766,"_28195":121245,"_3064":121330},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3608":72931,"_31008":72889,"_21483":121332,"_5":14766,"_28195":121245,"_3064":121333},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3608":72932,"_31008":72889,"_21483":121335,"_5":14766,"_28195":121245,"_3064":121336},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3608":72933,"_31008":72933,"_5":15126,"_3064":121338,"_31366":121339,"_21483":121340,"_28195":72933},"Visión general del control de acceso",[50713,121232,121233,121234],[],{"_3608":72934,"_31008":72933,"_21483":121342,"_5":14766,"_28195":72933,"_3064":121343},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3608":72935,"_31008":72933,"_5":31363,"_21483":121345,"_28195":121346,"_3064":121347},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3608":72936,"_31008":72933,"_5":31363,"_21483":121349,"_28195":121350,"_3064":121351},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3608":72937,"_31008":72933,"_5":31363,"_21483":121353,"_28195":121354,"_3064":121355},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3608":72938,"_31008":72933,"_5":31363,"_21483":121357,"_28195":121358,"_3064":121359},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3608":72939,"_31008":72933,"_5":31363,"_21483":121361,"_28195":121362,"_3064":121363},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3608":72940,"_31008":72933,"_5":31363,"_21483":121365,"_28195":121366,"_3064":121367},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3608":72941,"_31008":72933,"_5":31363,"_21483":121369,"_28195":121370,"_3064":121371},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3608":72942,"_31008":72933,"_5":31363,"_21483":121373,"_28195":121374,"_3064":121375},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3608":72943,"_31008":72933,"_5":31363,"_21483":121377,"_28195":121378,"_3064":121379},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3608":72944,"_31008":72933,"_5":31363,"_21483":121381,"_28195":121382,"_3064":121383},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3608":72945,"_31008":72933,"_5":31363,"_21483":121385,"_28195":121386,"_3064":121387},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3608":72946,"_31008":72933,"_5":31363,"_21483":121389,"_28195":121390,"_3064":121391},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3608":72947,"_31008":72933,"_5":31363,"_21483":121393,"_28195":121394,"_3064":121395},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3608":72948,"_31008":72933,"_5":31363,"_21483":121397,"_28195":121398,"_3064":121399},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3608":72949,"_31008":72933,"_5":31363,"_21483":121401,"_28195":121402,"_3064":121403},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3608":72950,"_31008":72933,"_5":31363,"_21483":121405,"_28195":121406,"_3064":120373},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3608":72951,"_31008":72933,"_5":31363,"_21483":121408,"_28195":121409,"_3064":121410},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3608":72952,"_31008":72933,"_5":31363,"_21483":121412,"_28195":121413,"_3064":121414},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3608":72953,"_31008":72933,"_5":31363,"_21483":121416,"_28195":121417,"_3064":121418},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3608":72954,"_31008":72933,"_5":31363,"_21483":121420,"_28195":121421,"_3064":121422},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3608":72955,"_31008":72933,"_5":31363,"_21483":121424,"_28195":121425,"_3064":121426},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3608":72956,"_31008":72933,"_5":31363,"_21483":121428,"_28195":121429,"_3064":121430},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3608":72957,"_31008":72933,"_5":31363,"_21483":121432,"_28195":121433,"_3064":121434},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3608":72958,"_31008":72933,"_5":31363,"_21483":121436,"_28195":121437,"_3064":121438},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3608":72959,"_31008":72933,"_5":31363,"_21483":121440,"_28195":121441,"_3064":121442},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3608":72960,"_31008":72933,"_5":31363,"_21483":121444,"_28195":121445,"_3064":121446},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3608":72961,"_31008":72933,"_5":31363,"_21483":121448,"_28195":121449,"_3064":121450},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3608":72962,"_31008":72933,"_5":31363,"_21483":121452,"_28195":121453,"_3064":121454},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3608":72963,"_31008":72933,"_5":31363,"_21483":121456,"_28195":121457,"_3064":121458},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3608":72964,"_31008":72933,"_5":31363,"_21483":121460,"_28195":121461,"_3064":121462},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3608":72965,"_31008":72933,"_5":31363,"_21483":121464,"_28195":121465,"_3064":121466},[],"/docs/pr-preview/pr-72/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3608":72966,"_31008":72933,"_21483":121468,"_5":14766,"_28195":72933,"_3064":121469},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3608":72967,"_31008":72933,"_21483":121471,"_5":14766,"_28195":72933,"_3064":121472},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3608":72968,"_31008":72933,"_21483":121474,"_5":14766,"_28195":72933,"_3064":121475},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3608":72969,"_31008":72933,"_21483":121477,"_5":14766,"_28195":121346,"_3064":121478},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3608":72970,"_31008":72933,"_21483":121480,"_5":14766,"_28195":121346,"_3064":121481},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3608":72971,"_31008":72933,"_21483":121483,"_5":14766,"_28195":121346,"_3064":121484},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3608":72972,"_31008":72933,"_21483":121486,"_5":14766,"_28195":121346,"_3064":121487},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3608":72973,"_31008":72933,"_21483":121489,"_5":14766,"_28195":121346,"_3064":121490},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3608":72974,"_31008":72933,"_21483":121492,"_5":14766,"_28195":121346,"_3064":121493},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3608":72975,"_31008":72933,"_21483":121495,"_5":14766,"_28195":121350,"_3064":121496},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3608":72976,"_31008":72933,"_21483":121498,"_5":14766,"_28195":121350,"_3064":121499},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3608":72977,"_31008":72933,"_21483":121501,"_5":14766,"_28195":121354,"_3064":121502},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3608":72978,"_31008":72933,"_21483":121504,"_5":14766,"_28195":121354,"_3064":121505},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3608":72979,"_31008":72933,"_21483":121507,"_5":14766,"_28195":121354,"_3064":121508},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3608":72980,"_31008":72933,"_21483":121510,"_5":14766,"_28195":121354,"_3064":121511},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3608":72981,"_31008":72933,"_21483":121513,"_5":14766,"_28195":121354,"_3064":121514},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3608":72982,"_31008":72933,"_21483":121516,"_5":14766,"_28195":121354,"_3064":121517},[],"Carga por separado las políticas concedidas a cada principal.",{"_3608":72983,"_31008":72933,"_21483":121519,"_5":14766,"_28195":121354,"_3064":121520},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3608":72984,"_31008":72933,"_21483":121522,"_5":14766,"_28195":121354,"_3064":121523},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3608":72985,"_31008":72933,"_21483":121525,"_5":14766,"_28195":121354,"_3064":121526},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3608":72986,"_31008":72933,"_21483":121528,"_5":14766,"_28195":121354,"_3064":121529},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3608":72987,"_31008":72933,"_21483":121531,"_5":14766,"_28195":121354,"_3064":121532},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3608":72988,"_31008":72933,"_21483":121534,"_5":14766,"_28195":121354,"_3064":121535},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3608":72989,"_31008":72933,"_21483":121537,"_5":14766,"_28195":121358,"_3064":121538},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3608":72990,"_31008":72933,"_21483":121540,"_5":14766,"_28195":121358,"_3064":121541},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3608":72991,"_31008":72933,"_21483":121543,"_5":14766,"_28195":121358,"_3064":121544},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3608":72992,"_31008":72933,"_21483":121546,"_5":14766,"_28195":121358,"_3064":121547},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3608":72993,"_31008":72933,"_21483":121549,"_5":14766,"_28195":121358,"_3064":121550},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3608":72994,"_31008":72933,"_21483":121552,"_5":14766,"_28195":121358,"_3064":121553},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3608":72995,"_31008":72933,"_21483":121555,"_5":14766,"_28195":121358,"_3064":121556},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3608":72996,"_31008":72933,"_21483":121558,"_5":14766,"_28195":121358,"_3064":121559},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3608":72997,"_31008":72933,"_21483":121561,"_5":14766,"_28195":121358,"_3064":121562},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3608":72998,"_31008":72933,"_21483":121564,"_5":14766,"_28195":121358,"_3064":121565},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3608":72999,"_31008":72933,"_21483":121567,"_5":14766,"_28195":121362,"_3064":121568},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3608":73000,"_31008":72933,"_21483":121570,"_5":14766,"_28195":121362,"_3064":121571},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3608":73001,"_31008":72933,"_21483":121573,"_5":14766,"_28195":121362,"_3064":121574},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3608":73002,"_31008":72933,"_21483":121576,"_5":14766,"_28195":121362,"_3064":121577},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3608":73003,"_31008":72933,"_21483":121579,"_5":14766,"_28195":121362,"_3064":121580},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3608":73004,"_31008":72933,"_21483":121582,"_5":14766,"_28195":121362,"_3064":121583},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3608":73005,"_31008":72933,"_21483":121585,"_5":14766,"_28195":121362,"_3064":121586},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3608":73006,"_31008":72933,"_21483":121588,"_5":14766,"_28195":121362,"_3064":121589},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3608":73007,"_31008":72933,"_21483":121591,"_5":14766,"_28195":121362,"_3064":121592},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3608":73008,"_31008":72933,"_21483":121594,"_5":14766,"_28195":121362,"_3064":121595},[],"Las acciones se dividen en dos grupos:",{"_3608":73009,"_31008":72933,"_21483":121597,"_5":14766,"_28195":121362,"_3064":121598},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3608":73010,"_31008":72933,"_21483":121600,"_5":14766,"_28195":121362,"_3064":121601},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3608":73011,"_31008":72933,"_21483":121603,"_5":14766,"_28195":121362,"_3064":121604},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3608":73012,"_31008":72933,"_21483":121606,"_5":14766,"_28195":121366,"_3064":121607},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3608":73013,"_31008":72933,"_21483":121609,"_5":14766,"_28195":121366,"_3064":121610},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3608":73014,"_31008":72933,"_21483":121612,"_5":14766,"_28195":121366,"_3064":121613},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3608":73015,"_31008":72933,"_21483":121615,"_5":14766,"_28195":121370,"_3064":121616},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3608":73016,"_31008":72933,"_21483":121618,"_5":14766,"_28195":121370,"_3064":121619},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3608":73017,"_31008":72933,"_21483":121621,"_5":14766,"_28195":121370,"_3064":121622},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3608":73018,"_31008":72933,"_21483":121624,"_5":14766,"_28195":121370,"_3064":121625},[],"Los operadores implementados son:",{"_3608":73019,"_31008":72933,"_21483":121627,"_5":14766,"_28195":121370,"_3064":121628},[],"`equals`, para igualdad exacta;",{"_3608":73020,"_31008":72933,"_21483":121630,"_5":14766,"_28195":121370,"_3064":121631},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3608":73021,"_31008":72933,"_21483":121633,"_5":14766,"_28195":121370,"_3064":121634},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3608":73022,"_31008":72933,"_21483":121636,"_5":14766,"_28195":121370,"_3064":121637},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3608":73023,"_31008":72933,"_21483":121639,"_5":14766,"_28195":121374,"_3064":121640},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3608":73024,"_31008":72933,"_21483":121642,"_5":14766,"_28195":121374,"_3064":121643},[],"Los modos disponibles son:",{"_3608":73025,"_31008":72933,"_21483":121645,"_5":14766,"_28195":121374,"_3064":121646},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3608":73026,"_31008":72933,"_21483":121648,"_5":14766,"_28195":121374,"_3064":121649},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3608":73027,"_31008":72933,"_21483":121651,"_5":14766,"_28195":121374,"_3064":121652},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3608":73028,"_31008":72933,"_21483":121654,"_5":14766,"_28195":121374,"_3064":121655},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3608":73029,"_31008":72933,"_21483":121657,"_5":14766,"_28195":121374,"_3064":121658},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3608":73030,"_31008":72933,"_21483":121660,"_5":14766,"_28195":121374,"_3064":121661},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3608":73031,"_31008":72933,"_21483":121663,"_5":14766,"_28195":121378,"_3064":121664},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3608":73032,"_31008":72933,"_21483":121666,"_5":14766,"_28195":121378,"_3064":121667},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3608":73033,"_31008":72933,"_21483":121669,"_5":14766,"_28195":121378,"_3064":121670},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3608":73034,"_31008":72933,"_21483":121672,"_5":14766,"_28195":121378,"_3064":121673},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3608":73035,"_31008":72933,"_21483":121675,"_5":14766,"_28195":121386,"_3064":121676},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3608":73036,"_31008":72933,"_21483":121678,"_5":14766,"_28195":121386,"_3064":121679},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3608":73037,"_31008":72933,"_21483":121681,"_5":14766,"_28195":121390,"_3064":121682},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3608":73038,"_31008":72933,"_21483":121684,"_5":14766,"_28195":121390,"_3064":121685},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3608":73039,"_31008":72933,"_21483":121687,"_5":14766,"_28195":121390,"_3064":121688},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3608":73040,"_31008":72933,"_21483":121690,"_5":14766,"_28195":121390,"_3064":121691},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3608":73041,"_31008":72933,"_21483":121693,"_5":14766,"_28195":121390,"_3064":121694},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3608":73042,"_31008":72933,"_21483":121696,"_5":14766,"_28195":121394,"_3064":121697},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3608":73043,"_31008":72933,"_21483":121699,"_5":14766,"_28195":121394,"_3064":121700},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3608":73044,"_31008":72933,"_21483":121702,"_5":14766,"_28195":121394,"_3064":121703},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3608":73045,"_31008":72933,"_21483":121705,"_5":14766,"_28195":121398,"_3064":121706},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3608":73046,"_31008":72933,"_21483":121708,"_5":14766,"_28195":121398,"_3064":121709},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3608":73047,"_31008":72933,"_21483":121711,"_5":14766,"_28195":121398,"_3064":121712},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3608":73048,"_31008":72933,"_21483":121714,"_5":14766,"_28195":121398,"_3064":121715},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3608":73049,"_31008":72933,"_21483":121717,"_5":14766,"_28195":121398,"_3064":121718},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3608":73050,"_31008":72933,"_21483":121720,"_5":14766,"_28195":121398,"_3064":121721},[],"Ten en cuenta que:",{"_3608":73051,"_31008":72933,"_21483":121723,"_5":14766,"_28195":121398,"_3064":121724},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3608":73052,"_31008":72933,"_21483":121726,"_5":14766,"_28195":121398,"_3064":121727},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3608":73053,"_31008":72933,"_21483":121729,"_5":14766,"_28195":121398,"_3064":121730},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3608":73054,"_31008":72933,"_21483":121732,"_5":14766,"_28195":121402,"_3064":121733},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3608":73055,"_31008":72933,"_21483":121735,"_5":14766,"_28195":121402,"_3064":121736},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3608":73056,"_31008":72933,"_21483":121738,"_5":14766,"_28195":121402,"_3064":121739},[],"acceso completo y de solo lectura a KMS;",{"_3608":73057,"_31008":72933,"_21483":121741,"_5":14766,"_28195":121402,"_3064":121742},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3608":73058,"_31008":72933,"_21483":121744,"_5":14766,"_28195":121402,"_3064":121745},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3608":73059,"_31008":72933,"_21483":121747,"_5":14766,"_28195":121402,"_3064":121748},[],"acceso a la interfaz;",{"_3608":73060,"_31008":72933,"_21483":121750,"_5":14766,"_28195":121402,"_3064":121751},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3608":73061,"_31008":72933,"_21483":121753,"_5":14766,"_28195":121402,"_3064":121754},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3608":73062,"_31008":72933,"_21483":121756,"_5":14766,"_28195":121402,"_3064":121757},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3608":73063,"_31008":72933,"_21483":121759,"_5":14766,"_28195":121402,"_3064":121760},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3608":73064,"_31008":72933,"_21483":121762,"_5":14766,"_28195":121402,"_3064":121763},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3608":73065,"_31008":72933,"_21483":121765,"_5":14766,"_28195":121406,"_3064":121766},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3608":73066,"_31008":72933,"_21483":121768,"_5":14766,"_28195":121406,"_3064":121769},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3608":73067,"_31008":72933,"_21483":121771,"_5":14766,"_28195":121406,"_3064":121772},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3608":73068,"_31008":72933,"_21483":121774,"_5":14766,"_28195":121409,"_3064":121775},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3608":73069,"_31008":72933,"_21483":121777,"_5":14766,"_28195":121413,"_3064":121778},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3608":73070,"_31008":72933,"_21483":121780,"_5":14766,"_28195":121413,"_3064":121781},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3608":73071,"_31008":72933,"_21483":121783,"_5":14766,"_28195":121417,"_3064":121784},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3608":73072,"_31008":72933,"_21483":121786,"_5":14766,"_28195":121421,"_3064":121787},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3608":73073,"_31008":72933,"_21483":121789,"_5":14766,"_28195":121425,"_3064":121790},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3608":73074,"_31008":72933,"_21483":121792,"_5":14766,"_28195":121429,"_3064":121793},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3608":73075,"_31008":72933,"_21483":121795,"_5":14766,"_28195":121429,"_3064":121796},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3608":73076,"_31008":72933,"_21483":121798,"_5":14766,"_28195":121433,"_3064":121799},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3608":73077,"_31008":72933,"_21483":121801,"_5":14766,"_28195":121433,"_3064":121802},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3608":73078,"_31008":72933,"_21483":121804,"_5":14766,"_28195":121433,"_3064":121805},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3608":73079,"_31008":72933,"_21483":121807,"_5":14766,"_28195":121433,"_3064":121808},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3608":73080,"_31008":72933,"_21483":121810,"_5":14766,"_28195":121433,"_3064":121811},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3608":73081,"_31008":72933,"_21483":121813,"_5":14766,"_28195":121433,"_3064":121814},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3608":73082,"_31008":72933,"_21483":121816,"_5":14766,"_28195":121433,"_3064":121817},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3608":73083,"_31008":72933,"_21483":121819,"_5":14766,"_28195":121433,"_3064":121820},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3608":73084,"_31008":72933,"_21483":121822,"_5":14766,"_28195":121437,"_3064":121823},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3608":73085,"_31008":72933,"_21483":121825,"_5":14766,"_28195":121437,"_3064":121826},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3608":73086,"_31008":72933,"_21483":121828,"_5":14766,"_28195":121437,"_3064":121829},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3608":73087,"_31008":72933,"_21483":121831,"_5":14766,"_28195":121441,"_3064":121832},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3608":73088,"_31008":72933,"_21483":121834,"_5":14766,"_28195":121441,"_3064":121835},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3608":73089,"_31008":72933,"_21483":121837,"_5":14766,"_28195":121441,"_3064":121838},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3608":73090,"_31008":72933,"_21483":121840,"_5":14766,"_28195":121441,"_3064":121841},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3608":73091,"_31008":72933,"_21483":121843,"_5":14766,"_28195":121441,"_3064":121844},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3608":73092,"_31008":72933,"_21483":121846,"_5":14766,"_28195":121441,"_3064":121847},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3608":73093,"_31008":72933,"_21483":121849,"_5":14766,"_28195":121441,"_3064":121850},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3608":73094,"_31008":72933,"_21483":121852,"_5":14766,"_28195":121441,"_3064":121853},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3608":73095,"_31008":72933,"_21483":121855,"_5":14766,"_28195":121449,"_3064":121856},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3608":73096,"_31008":72933,"_21483":121858,"_5":14766,"_28195":121453,"_3064":121859},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3608":73097,"_31008":72933,"_21483":121861,"_5":14766,"_28195":121453,"_3064":121862},[],"que exista un principal activo del tipo correcto;",{"_3608":73098,"_31008":72933,"_21483":121864,"_5":14766,"_28195":121453,"_3064":121865},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3608":73099,"_31008":72933,"_21483":121867,"_5":14766,"_28195":121453,"_3064":121868},[],"que todas las condiciones del principal se cumplan;",{"_3608":73100,"_31008":72933,"_21483":121870,"_5":14766,"_28195":121453,"_3064":121871},[],"que el principal tenga concedida la política esperada;",{"_3608":73101,"_31008":72933,"_21483":121873,"_5":14766,"_28195":121453,"_3064":121874},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3608":73102,"_31008":72933,"_21483":121876,"_5":14766,"_28195":121453,"_3064":121877},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3608":73103,"_31008":72933,"_21483":121879,"_5":14766,"_28195":121453,"_3064":121880},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3608":73104,"_31008":72933,"_21483":121882,"_5":14766,"_28195":121453,"_3064":121883},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3608":73105,"_31008":72933,"_21483":121885,"_5":14766,"_28195":121457,"_3064":121886},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3608":73106,"_31008":72933,"_21483":121888,"_5":14766,"_28195":121461,"_3064":121889},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3608":73107,"_31008":72933,"_21483":121891,"_5":14766,"_28195":121465,"_3064":121892},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3608":73108,"_31008":72933,"_21483":121894,"_5":14766,"_28195":121465,"_3064":121895},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3608":73109,"_31008":73109,"_5":15126,"_3064":121897,"_31366":121898,"_21483":121899,"_28195":73109},"Alertas y suscripciones",[50713,121232,121233],[],{"_3608":73110,"_31008":73109,"_21483":121901,"_5":14766,"_28195":73109,"_3064":121902},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3608":73111,"_31008":73109,"_5":31363,"_21483":121904,"_28195":121905,"_3064":121906},[],"/docs/pr-preview/pr-72/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3608":73112,"_31008":73109,"_5":31363,"_21483":121908,"_28195":121909,"_3064":121910},[],"/docs/pr-preview/pr-72/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3608":73113,"_31008":73109,"_5":31363,"_21483":121912,"_28195":121913,"_3064":121914},[],"/docs/pr-preview/pr-72/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3608":73114,"_31008":73109,"_5":31363,"_21483":121916,"_28195":121917,"_3064":121918},[],"/docs/pr-preview/pr-72/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3608":73115,"_31008":73109,"_5":31363,"_21483":121920,"_28195":121921,"_3064":121922},[],"/docs/pr-preview/pr-72/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3608":73116,"_31008":73109,"_5":31363,"_21483":121924,"_28195":121925,"_3064":121926},[],"/docs/pr-preview/pr-72/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3608":73117,"_31008":73109,"_5":31363,"_21483":121928,"_28195":121929,"_3064":121930},[],"/docs/pr-preview/pr-72/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3608":73118,"_31008":73109,"_5":31363,"_21483":121932,"_28195":121933,"_3064":121934},[],"/docs/pr-preview/pr-72/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3608":73119,"_31008":73109,"_5":31363,"_21483":121936,"_28195":121937,"_3064":121938},[],"/docs/pr-preview/pr-72/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3608":73120,"_31008":73109,"_5":31363,"_21483":121940,"_28195":121941,"_3064":121942},[],"/docs/pr-preview/pr-72/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3608":73121,"_31008":73109,"_5":31363,"_21483":121944,"_28195":121945,"_3064":121946},[],"/docs/pr-preview/pr-72/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3608":73122,"_31008":73109,"_21483":121948,"_5":14766,"_28195":73109,"_3064":121949},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3608":73123,"_31008":73109,"_21483":121951,"_5":14766,"_28195":121905,"_3064":121952},[],"Un servicio publica un evento de dominio.",{"_3608":73124,"_31008":73109,"_21483":121954,"_5":14766,"_28195":121905,"_3064":121955},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3608":73125,"_31008":73109,"_21483":121957,"_5":14766,"_28195":121905,"_3064":121958},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3608":73126,"_31008":73109,"_21483":121960,"_5":14766,"_28195":121905,"_3064":121961},[],"Lamassu entrega el evento al canal configurado.",{"_3608":73127,"_31008":73109,"_21483":121963,"_5":14766,"_28195":121905,"_3064":121964},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3608":73128,"_31008":73109,"_21483":121966,"_5":14766,"_28195":121909,"_3064":121967},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3608":73129,"_31008":73109,"_21483":121969,"_5":14766,"_28195":121909,"_3064":121970},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3608":73130,"_31008":73109,"_21483":121972,"_5":14766,"_28195":121909,"_3064":121973},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3608":73131,"_31008":73109,"_21483":121975,"_5":14766,"_28195":121909,"_3064":121976},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3608":73132,"_31008":73109,"_21483":121978,"_5":14766,"_28195":121909,"_3064":121979},[],"`apikey_options` necesita `header` y `key`.",{"_3608":73133,"_31008":73109,"_21483":121981,"_5":14766,"_28195":121909,"_3064":121982},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3608":73134,"_31008":73109,"_21483":121984,"_5":14766,"_28195":121909,"_3064":121985},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3608":73135,"_31008":73109,"_21483":121987,"_5":14766,"_28195":121909,"_3064":121988},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3608":73136,"_31008":73109,"_21483":121990,"_5":14766,"_28195":121917,"_3064":121991},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3608":73137,"_31008":73109,"_21483":121993,"_5":14766,"_28195":121921,"_3064":121994},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3608":73138,"_31008":73109,"_21483":121996,"_5":14766,"_28195":121925,"_3064":121997},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3608":73139,"_31008":73109,"_21483":121999,"_5":14766,"_28195":121925,"_3064":122000},[],"**None** notifica todas las instancias del evento.",{"_3608":73140,"_31008":73109,"_21483":122002,"_5":14766,"_28195":121925,"_3064":122003},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3608":73141,"_31008":73109,"_21483":122005,"_5":14766,"_28195":121925,"_3064":122006},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3608":73142,"_31008":73109,"_21483":122008,"_5":14766,"_28195":121925,"_3064":122009},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3608":73143,"_31008":73109,"_21483":122011,"_5":14766,"_28195":121925,"_3064":122012},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3608":73144,"_31008":73109,"_21483":122014,"_5":14766,"_28195":121925,"_3064":122015},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3608":73145,"_31008":73109,"_21483":122017,"_5":14766,"_28195":121929,"_3064":122018},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3608":73146,"_31008":73109,"_21483":122020,"_5":14766,"_28195":121933,"_3064":122021},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3608":73147,"_31008":73109,"_21483":122023,"_5":14766,"_28195":121933,"_3064":122024},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3608":73148,"_31008":73109,"_21483":122026,"_5":14766,"_28195":121933,"_3064":122027},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3608":73149,"_31008":73109,"_21483":122029,"_5":14766,"_28195":121933,"_3064":122030},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3608":73150,"_31008":73109,"_21483":122032,"_5":14766,"_28195":121933,"_3064":122033},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3608":73151,"_31008":73109,"_21483":122035,"_5":14766,"_28195":121933,"_3064":122036},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3608":73152,"_31008":73109,"_21483":122038,"_5":14766,"_28195":121933,"_3064":122039},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3608":73153,"_31008":73109,"_21483":122041,"_5":14766,"_28195":121933,"_3064":122042},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3608":73154,"_31008":73109,"_21483":122044,"_5":14766,"_28195":121937,"_3064":122045},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3608":73155,"_31008":73109,"_21483":122047,"_5":14766,"_28195":121937,"_3064":122048},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3608":73156,"_31008":73109,"_21483":122050,"_5":14766,"_28195":121937,"_3064":122051},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3608":73157,"_31008":73109,"_21483":122053,"_5":14766,"_28195":121937,"_3064":122054},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3608":73158,"_31008":73109,"_21483":122056,"_5":14766,"_28195":121937,"_3064":122057},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3608":73159,"_31008":73109,"_21483":122059,"_5":14766,"_28195":121937,"_3064":122060},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3608":73160,"_31008":73109,"_21483":122062,"_5":14766,"_28195":121937,"_3064":122063},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3608":73161,"_31008":73109,"_21483":122065,"_5":14766,"_28195":121937,"_3064":122066},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3608":73162,"_31008":73109,"_21483":122068,"_5":14766,"_28195":121941,"_3064":122069},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3608":73163,"_31008":73109,"_21483":122071,"_5":14766,"_28195":121941,"_3064":122072},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3608":73164,"_31008":73109,"_21483":122074,"_5":14766,"_28195":121945,"_3064":122075},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3608":73165,"_31008":73109,"_21483":122077,"_5":14766,"_28195":121945,"_3064":122078},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3608":73166,"_31008":73109,"_21483":122080,"_5":14766,"_28195":121945,"_3064":122081},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3608":73167,"_31008":73109,"_21483":122083,"_5":14766,"_28195":121945,"_3064":122084},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3608":73168,"_31008":73109,"_21483":122086,"_5":14766,"_28195":121945,"_3064":122087},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3608":73169,"_31008":73109,"_21483":122089,"_5":14766,"_28195":121945,"_3064":122090},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3608":73170,"_31008":73109,"_21483":122092,"_5":14766,"_28195":121945,"_3064":122093},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3608":73171,"_31008":73109,"_21483":122095,"_5":14766,"_28195":121945,"_3064":122096},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3608":73172,"_31008":73109,"_21483":122098,"_5":14766,"_28195":121945,"_3064":122099},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3608":73173,"_31008":73109,"_21483":122101,"_5":14766,"_28195":121945,"_3064":122102},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3608":73174,"_31008":73174,"_5":15126,"_3064":122104,"_31366":122105,"_21483":122106,"_28195":73174},"Registros de auditoría",[50713,121232,121233],[],{"_3608":73175,"_31008":73174,"_21483":122108,"_5":14766,"_28195":73174,"_3064":122109},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3608":73176,"_31008":73174,"_5":31363,"_21483":122111,"_28195":122112,"_3064":122113},[],"/docs/pr-preview/pr-72/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3608":73177,"_31008":73174,"_5":31363,"_21483":122115,"_28195":122116,"_3064":122117},[],"/docs/pr-preview/pr-72/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3608":73178,"_31008":73174,"_5":31363,"_21483":122119,"_28195":122120,"_3064":122121},[],"/docs/pr-preview/pr-72/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3608":73179,"_31008":73174,"_5":31363,"_21483":122123,"_28195":122124,"_3064":122125},[],"/docs/pr-preview/pr-72/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3608":73180,"_31008":73174,"_5":31363,"_21483":122127,"_28195":122128,"_3064":122129},[],"/docs/pr-preview/pr-72/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3608":73181,"_31008":73174,"_5":31363,"_21483":122131,"_28195":122132,"_3064":122133},[],"/docs/pr-preview/pr-72/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3608":73182,"_31008":73174,"_5":31363,"_21483":122135,"_28195":122136,"_3064":122137},[],"/docs/pr-preview/pr-72/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3608":73183,"_31008":73174,"_5":31363,"_21483":122139,"_28195":122140,"_3064":122141},[],"/docs/pr-preview/pr-72/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3608":73184,"_31008":73174,"_5":31363,"_21483":122143,"_28195":122144,"_3064":122145},[],"/docs/pr-preview/pr-72/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3608":73185,"_31008":73174,"_5":31363,"_21483":122147,"_28195":122148,"_3064":122149},[],"/docs/pr-preview/pr-72/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3608":73186,"_31008":73174,"_5":31363,"_21483":122151,"_28195":122152,"_3064":122153},[],"/docs/pr-preview/pr-72/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3608":73187,"_31008":73174,"_21483":122155,"_5":14766,"_28195":73174,"_3064":122156},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3608":73188,"_31008":73174,"_21483":122158,"_5":14766,"_28195":122112,"_3064":122159},[],"El cuerpo de auditoría incluye:",{"_3608":73189,"_31008":73174,"_21483":122161,"_5":14766,"_28195":122112,"_3064":122162},[],"input: datos recibidos por la operación;",{"_3608":73190,"_31008":73174,"_21483":122164,"_5":14766,"_28195":122112,"_3064":122165},[],"has\\_error: indica si el servicio devolvió un error;",{"_3608":73191,"_31008":73174,"_21483":122167,"_5":14766,"_28195":122112,"_3064":122168},[],"output: resultado producido o mensaje de error;",{"_3608":73192,"_31008":73174,"_21483":122170,"_5":14766,"_28195":122112,"_3064":122171},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3608":73193,"_31008":73174,"_21483":122173,"_5":14766,"_28195":122112,"_3064":122174},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3608":73194,"_31008":73174,"_21483":122176,"_5":14766,"_28195":122112,"_3064":122177},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3608":73195,"_31008":73174,"_21483":122179,"_5":14766,"_28195":122116,"_3064":122180},[],"El backend aplica auditoría a mutaciones de:",{"_3608":73196,"_31008":73174,"_21483":122182,"_5":14766,"_28195":122116,"_3064":122183},[],"autoridades, certificados y perfiles de emisión;",{"_3608":73197,"_31008":73174,"_21483":122185,"_5":14766,"_28195":122116,"_3064":122186},[],"claves y motores KMS;",{"_3608":73198,"_31008":73174,"_21483":122188,"_5":14766,"_28195":122116,"_3064":122189},[],"dispositivos e identidades;",{"_3608":73199,"_31008":73174,"_21483":122191,"_5":14766,"_28195":122116,"_3064":122192},[],"DMS y operaciones de enrolamiento;",{"_3608":73200,"_31008":73174,"_21483":122194,"_5":14766,"_28195":122116,"_3064":122195},[],"funciones de validación y CRL;",{"_3608":73201,"_31008":73174,"_21483":122197,"_5":14766,"_28195":122116,"_3064":122198},[],"principales, políticas y concesiones de autorización.",{"_3608":73202,"_31008":73174,"_21483":122200,"_5":14766,"_28195":122116,"_3064":122201},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3608":73203,"_31008":73174,"_21483":122203,"_5":14766,"_28195":122120,"_3064":122204},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3608":73204,"_31008":73174,"_21483":122206,"_5":14766,"_28195":122120,"_3064":122207},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3608":73205,"_31008":73174,"_21483":122209,"_5":14766,"_28195":122120,"_3064":122210},[],"Diseña el consumidor para:",{"_3608":73206,"_31008":73174,"_21483":122212,"_5":14766,"_28195":122120,"_3064":122213},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3608":73207,"_31008":73174,"_21483":122215,"_5":14766,"_28195":122120,"_3064":122216},[],"conservar el CloudEvent completo sin modificar;",{"_3608":73208,"_31008":73174,"_21483":122218,"_5":14766,"_28195":122120,"_3064":122219},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3608":73209,"_31008":73174,"_21483":122221,"_5":14766,"_28195":122120,"_3064":122222},[],"cifrar en tránsito y en reposo;",{"_3608":73210,"_31008":73174,"_21483":122224,"_5":14766,"_28195":122120,"_3064":122225},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3608":73211,"_31008":73174,"_21483":122227,"_5":14766,"_28195":122120,"_3064":122228},[],"aplicar una política explícita de retención y legal hold;",{"_3608":73212,"_31008":73174,"_21483":122230,"_5":14766,"_28195":122120,"_3064":122231},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3608":73213,"_31008":73174,"_21483":122233,"_5":14766,"_28195":122124,"_3064":122234},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3608":73214,"_31008":73174,"_21483":122236,"_5":14766,"_28195":122124,"_3064":122237},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3608":73215,"_31008":73174,"_21483":122239,"_5":14766,"_28195":122132,"_3064":122240},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3608":73216,"_31008":73174,"_21483":122242,"_5":14766,"_28195":122136,"_3064":122243},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3608":73217,"_31008":73174,"_21483":122245,"_5":14766,"_28195":122140,"_3064":122246},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3608":73218,"_31008":73174,"_21483":122248,"_5":14766,"_28195":122144,"_3064":122249},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3608":73219,"_31008":73174,"_21483":122251,"_5":14766,"_28195":122148,"_3064":122252},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3608":73220,"_31008":73174,"_21483":122254,"_5":14766,"_28195":122152,"_3064":122255},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3608":73221,"_31008":73174,"_21483":122257,"_5":14766,"_28195":122152,"_3064":122258},[],"aparece un evento de auditoría correcto;",{"_3608":73222,"_31008":73174,"_21483":122260,"_5":14766,"_28195":122152,"_3064":122261},[],"el principal coincide con la identidad utilizada;",{"_3608":73223,"_31008":73174,"_21483":122263,"_5":14766,"_28195":122152,"_3064":122264},[],"el consumidor lo persiste una sola vez;",{"_3608":73224,"_31008":73174,"_21483":122266,"_5":14766,"_28195":122152,"_3064":122267},[],"puede recuperarse por recurso, actor y periodo;",{"_3608":73225,"_31008":73174,"_21483":122269,"_5":14766,"_28195":122152,"_3064":122270},[],"una interrupción del consumidor produce una alerta.",{"_3608":73226,"_31008":73174,"_21483":122272,"_5":14766,"_28195":122152,"_3064":122273},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3608":73227,"_31008":73227,"_5":15126,"_3064":122275,"_31366":122276,"_21483":122277,"_28195":73227},"Arquitectura de la plataforma",[50713,121232],[],{"_3608":73228,"_31008":73227,"_21483":122279,"_5":14766,"_28195":73227,"_3064":122280},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3608":73229,"_31008":73227,"_5":31363,"_21483":122282,"_28195":122283,"_3064":122284},[],"/docs/pr-preview/pr-72/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3608":73230,"_31008":73227,"_5":31363,"_21483":122286,"_28195":122287,"_3064":122288},[],"/docs/pr-preview/pr-72/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3608":73231,"_31008":73227,"_5":31363,"_21483":122290,"_28195":122291,"_3064":122292},[],"/docs/pr-preview/pr-72/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3608":73232,"_31008":73227,"_5":31363,"_21483":122294,"_28195":122295,"_3064":122296},[],"/docs/pr-preview/pr-72/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3608":73233,"_31008":73227,"_5":31363,"_21483":122298,"_28195":122299,"_3064":122300},[],"/docs/pr-preview/pr-72/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3608":73234,"_31008":73227,"_21483":122302,"_5":14766,"_28195":73227,"_3064":122303},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3608":73235,"_31008":73227,"_21483":122305,"_5":14766,"_28195":73227,"_3064":122306},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3608":73236,"_31008":73227,"_21483":122308,"_5":14766,"_28195":122283,"_3064":122309},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3608":73237,"_31008":73227,"_21483":122311,"_5":14766,"_28195":122287,"_3064":122312},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3608":73238,"_31008":73227,"_21483":122314,"_5":14766,"_28195":122291,"_3064":122315},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3608":73239,"_31008":73227,"_21483":122317,"_5":14766,"_28195":122295,"_3064":122318},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3608":73240,"_31008":73227,"_21483":122320,"_5":14766,"_28195":122299,"_3064":122321},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3608":73241,"_31008":73241,"_5":15126,"_3064":122323,"_31366":122324,"_21483":122325,"_28195":73241},"Cómo funciona Lamassu",[50713,121232],[],{"_3608":73242,"_31008":73241,"_21483":122327,"_5":14766,"_28195":73241,"_3064":122328},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3608":73243,"_31008":73241,"_5":31363,"_21483":122330,"_28195":122331,"_3064":122332},[],"/docs/pr-preview/pr-72/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3608":73244,"_31008":73241,"_5":31363,"_21483":122334,"_28195":122335,"_3064":122336},[],"/docs/pr-preview/pr-72/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3608":73245,"_31008":73241,"_21483":122338,"_5":14766,"_28195":73241,"_3064":122339},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3608":73246,"_31008":73241,"_21483":122341,"_5":14766,"_28195":122331,"_3064":122342},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3608":73247,"_31008":73241,"_21483":122344,"_5":14766,"_28195":122331,"_3064":122345},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3608":73248,"_31008":73241,"_21483":122347,"_5":14766,"_28195":122331,"_3064":122348},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3608":73249,"_31008":73241,"_21483":122350,"_5":14766,"_28195":122331,"_3064":122351},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3608":73250,"_31008":73241,"_21483":122353,"_5":14766,"_28195":122331,"_3064":122354},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3608":73251,"_31008":73241,"_21483":122356,"_5":14766,"_28195":122335,"_3064":122357},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3608":73252,"_31008":73241,"_21483":122359,"_5":14766,"_28195":122335,"_3064":122360},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3608":73253,"_31008":73241,"_21483":122362,"_5":14766,"_28195":122335,"_3064":122363},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3608":73254,"_31008":73241,"_21483":122365,"_5":14766,"_28195":122335,"_3064":122366},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3608":73255,"_31008":73241,"_21483":122368,"_5":14766,"_28195":122335,"_3064":122369},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3608":73256,"_31008":73241,"_21483":122371,"_5":14766,"_28195":122335,"_3064":122372},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3608":73257,"_31008":73241,"_21483":122374,"_5":14766,"_28195":122335,"_3064":122375},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3608":73258,"_31008":73258,"_5":15126,"_3064":122377,"_31366":122378,"_21483":122379,"_28195":73258},"Dispositivos e identidades",[50713,121232,53397,122377],[],{"_3608":73259,"_31008":73258,"_21483":122381,"_5":14766,"_28195":73258,"_3064":122382},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3608":73260,"_31008":73258,"_5":31363,"_21483":122384,"_28195":122385,"_3064":122386},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3608":73261,"_31008":73258,"_5":31363,"_21483":122388,"_28195":122389,"_3064":122390},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3608":73262,"_31008":73258,"_5":31363,"_21483":122392,"_28195":122393,"_3064":122394},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3608":73263,"_31008":73258,"_5":31363,"_21483":122396,"_28195":122397,"_3064":122398},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3608":73264,"_31008":73258,"_5":31363,"_21483":122400,"_28195":122401,"_3064":122402},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3608":73265,"_31008":73258,"_5":31363,"_21483":122404,"_28195":122405,"_3064":122406},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3608":73266,"_31008":73258,"_5":31363,"_21483":122408,"_28195":122409,"_3064":122410},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3608":73267,"_31008":73258,"_5":31363,"_21483":122412,"_28195":122413,"_3064":122414},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3608":73268,"_31008":73258,"_5":31363,"_21483":122416,"_28195":122417,"_3064":122418},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3608":73269,"_31008":73258,"_5":31363,"_21483":122420,"_28195":122421,"_3064":122422},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3608":73270,"_31008":73258,"_5":31363,"_21483":122424,"_28195":122425,"_3064":122426},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3608":73271,"_31008":73258,"_21483":122428,"_5":14766,"_28195":73258,"_3064":122429},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3608":73272,"_31008":73258,"_21483":122431,"_5":14766,"_28195":73258,"_3064":122432},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3608":73273,"_31008":73258,"_21483":122434,"_5":14766,"_28195":122385,"_3064":122435},[],"Vista operativa",{"_3608":73274,"_31008":73258,"_21483":122437,"_5":14766,"_28195":122385,"_3064":122438},[],"Interpretación",{"_3608":73275,"_31008":73258,"_21483":122440,"_5":14766,"_28195":122385,"_3064":53460},[],{"_3608":73276,"_31008":73258,"_21483":122442,"_5":14766,"_28195":122385,"_3064":122443},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3608":73277,"_31008":73258,"_21483":122445,"_5":14766,"_28195":122385,"_3064":53466},[],{"_3608":73278,"_31008":73258,"_21483":122447,"_5":14766,"_28195":122385,"_3064":122448},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3608":73279,"_31008":73258,"_21483":122450,"_5":14766,"_28195":122385,"_3064":53472},[],{"_3608":73280,"_31008":73258,"_21483":122452,"_5":14766,"_28195":122385,"_3064":122453},[],"La identidad está en la ventana operativa de renovación.",{"_3608":73281,"_31008":73258,"_21483":122455,"_5":14766,"_28195":122385,"_3064":53478},[],{"_3608":73282,"_31008":73258,"_21483":122457,"_5":14766,"_28195":122385,"_3064":122458},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3608":73283,"_31008":73258,"_21483":122460,"_5":14766,"_28195":122385,"_3064":53484},[],{"_3608":73284,"_31008":73258,"_21483":122462,"_5":14766,"_28195":122385,"_3064":122463},[],"La identidad ha vencido.",{"_3608":73285,"_31008":73258,"_21483":122465,"_5":14766,"_28195":122385,"_3064":53490},[],{"_3608":73286,"_31008":73258,"_21483":122467,"_5":14766,"_28195":122385,"_3064":122468},[],"La identidad está marcada como revocada.",{"_3608":73287,"_31008":73258,"_21483":122470,"_5":14766,"_28195":122385,"_3064":53496},[],{"_3608":73288,"_31008":73258,"_21483":122472,"_5":14766,"_28195":122385,"_3064":122473},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3608":73289,"_31008":73258,"_21483":122475,"_5":14766,"_28195":122385,"_3064":122476},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3608":73290,"_31008":73258,"_21483":122478,"_5":14766,"_28195":122389,"_3064":122479},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3608":73291,"_31008":73258,"_21483":122481,"_5":14766,"_28195":122389,"_3064":122482},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3608":73292,"_31008":73258,"_21483":122484,"_5":14766,"_28195":122389,"_3064":122485},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3608":73293,"_31008":73258,"_21483":122487,"_5":14766,"_28195":122389,"_3064":122488},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3608":73294,"_31008":73258,"_21483":122490,"_5":14766,"_28195":122393,"_3064":122491},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3608":73295,"_31008":73258,"_21483":122493,"_5":14766,"_28195":122397,"_3064":122494},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3608":73296,"_31008":73258,"_21483":122496,"_5":14766,"_28195":122401,"_3064":122497},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3608":73297,"_31008":73258,"_21483":122499,"_5":14766,"_28195":122405,"_3064":122500},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3608":73298,"_31008":73258,"_21483":122502,"_5":14766,"_28195":122409,"_3064":122503},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3608":73299,"_31008":73258,"_21483":122505,"_5":14766,"_28195":122409,"_3064":122506},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3608":73300,"_31008":73258,"_21483":122508,"_5":14766,"_28195":122413,"_3064":122509},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3608":73301,"_31008":73258,"_21483":122511,"_5":14766,"_28195":122413,"_3064":122512},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3608":73302,"_31008":73258,"_21483":122514,"_5":14766,"_28195":122413,"_3064":122515},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3608":73303,"_31008":73258,"_21483":122517,"_5":14766,"_28195":122413,"_3064":122518},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3608":73304,"_31008":73258,"_21483":122520,"_5":14766,"_28195":122413,"_3064":122521},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3608":73305,"_31008":73258,"_21483":122523,"_5":14766,"_28195":122413,"_3064":122524},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3608":73306,"_31008":73258,"_21483":122526,"_5":14766,"_28195":122417,"_3064":122527},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3608":73307,"_31008":73258,"_21483":122529,"_5":14766,"_28195":122417,"_3064":122530},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3608":73308,"_31008":73258,"_21483":122532,"_5":14766,"_28195":122421,"_3064":122533},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3608":73309,"_31008":73258,"_21483":122535,"_5":14766,"_28195":122421,"_3064":122536},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3608":73310,"_31008":73258,"_21483":122538,"_5":14766,"_28195":122421,"_3064":122539},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3608":73311,"_31008":73258,"_21483":122541,"_5":14766,"_28195":122421,"_3064":122542},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3608":73312,"_31008":73258,"_21483":122544,"_5":14766,"_28195":122425,"_3064":122545},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3608":73313,"_31008":73258,"_21483":122547,"_5":14766,"_28195":122425,"_3064":122548},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3608":73314,"_31008":73314,"_5":15126,"_3064":122550,"_31366":122551,"_21483":122553,"_28195":73314},"Identidad inicial y autenticación",[50713,121232,53397,122377,122552],"Enrolamiento con PKI",[],{"_3608":73315,"_31008":73314,"_21483":122555,"_5":14766,"_28195":73314,"_3064":122556},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3608":73316,"_31008":73314,"_5":31363,"_21483":122558,"_28195":122559,"_3064":122560},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3608":73317,"_31008":73314,"_5":31363,"_21483":122562,"_28195":122563,"_3064":122564},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3608":73318,"_31008":73314,"_5":31363,"_21483":122566,"_28195":122567,"_3064":122568},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3608":73319,"_31008":73314,"_5":31363,"_21483":122570,"_28195":122571,"_3064":122572},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3608":73320,"_31008":73314,"_5":31363,"_21483":122574,"_28195":122575,"_3064":122576},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3608":73321,"_31008":73314,"_21483":122578,"_5":14766,"_28195":73314,"_3064":122579},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3608":73322,"_31008":73314,"_21483":122581,"_5":14766,"_28195":122559,"_3064":122582},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3608":73323,"_31008":73314,"_21483":122584,"_5":14766,"_28195":122559,"_3064":122585},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3608":73324,"_31008":73314,"_21483":122587,"_5":14766,"_28195":122563,"_3064":122588},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3608":73325,"_31008":73314,"_21483":122590,"_5":14766,"_28195":122563,"_3064":122591},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3608":73326,"_31008":73314,"_21483":122593,"_5":14766,"_28195":122563,"_3064":122594},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3608":73327,"_31008":73314,"_21483":122596,"_5":14766,"_28195":122567,"_3064":122597},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3608":73328,"_31008":73314,"_21483":122599,"_5":14766,"_28195":122567,"_3064":122600},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3608":73329,"_31008":73314,"_21483":122602,"_5":14766,"_28195":122571,"_3064":122603},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3608":73330,"_31008":73314,"_21483":122605,"_5":14766,"_28195":122571,"_3064":122606},[],"Ejemplo de cuerpo:",{"_3608":73331,"_31008":73314,"_21483":122608,"_5":14766,"_28195":122571,"_3064":122609},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3608":73332,"_31008":73314,"_21483":122611,"_5":14766,"_28195":122571,"_3064":122612},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3608":73333,"_31008":73314,"_21483":122614,"_5":14766,"_28195":122571,"_3064":122615},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3608":73334,"_31008":73314,"_21483":122617,"_5":14766,"_28195":122571,"_3064":122618},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3608":73335,"_31008":73314,"_21483":122620,"_5":14766,"_28195":122575,"_3064":122621},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3608":73336,"_31008":73314,"_21483":122623,"_5":14766,"_28195":122575,"_3064":122624},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3608":73337,"_31008":73337,"_5":15126,"_3064":122626,"_31366":122627,"_21483":122628,"_28195":73337},"Configura y opera el DMS",[50713,121232,53397,122377,122552],[],{"_3608":73338,"_31008":73337,"_21483":122630,"_5":14766,"_28195":73337,"_3064":122631},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3608":73339,"_31008":73337,"_5":31363,"_21483":122633,"_28195":122634,"_3064":119766},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3608":73340,"_31008":73337,"_5":31363,"_21483":122636,"_28195":122637,"_3064":122638},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3608":73341,"_31008":73337,"_5":31363,"_21483":122640,"_28195":122641,"_3064":122642},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3608":73342,"_31008":73337,"_5":31363,"_21483":122644,"_28195":122645,"_3064":122646},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3608":73343,"_31008":73337,"_5":31363,"_21483":122648,"_28195":122649,"_3064":122650},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3608":73344,"_31008":73337,"_5":31363,"_21483":122652,"_28195":122653,"_3064":122654},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3608":73345,"_31008":73337,"_5":31363,"_21483":122656,"_28195":122657,"_3064":122658},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3608":73346,"_31008":73337,"_5":31363,"_21483":122660,"_28195":122661,"_3064":122662},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3608":73347,"_31008":73337,"_5":31363,"_21483":122664,"_28195":122665,"_3064":53692},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3608":73348,"_31008":73337,"_5":31363,"_21483":122667,"_28195":122668,"_3064":53696},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3608":73349,"_31008":73337,"_5":31363,"_21483":122670,"_28195":122671,"_3064":122672},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3608":73350,"_31008":73337,"_5":31363,"_21483":122674,"_28195":122675,"_3064":122676},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3608":73351,"_31008":73337,"_5":31363,"_21483":122678,"_28195":122679,"_3064":122680},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3608":73352,"_31008":73337,"_5":31363,"_21483":122682,"_28195":122683,"_3064":122684},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3608":73353,"_31008":73337,"_5":31363,"_21483":122686,"_28195":122687,"_3064":53716},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3608":73354,"_31008":73337,"_5":31363,"_21483":122689,"_28195":122690,"_3064":122691},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3608":73355,"_31008":73337,"_5":31363,"_21483":122693,"_28195":122694,"_3064":122695},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3608":73356,"_31008":73337,"_5":31363,"_21483":122697,"_28195":122698,"_3064":122699},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3608":73357,"_31008":73337,"_21483":122701,"_5":14766,"_28195":73337,"_3064":122702},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3608":73358,"_31008":73337,"_21483":122704,"_5":14766,"_28195":122634,"_3064":122705},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3608":73359,"_31008":73337,"_21483":122707,"_5":14766,"_28195":122634,"_3064":122708},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3608":73360,"_31008":73337,"_21483":122710,"_5":14766,"_28195":122641,"_3064":122711},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3608":73361,"_31008":73337,"_21483":122713,"_5":14766,"_28195":122645,"_3064":122714},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3608":73362,"_31008":73337,"_21483":122716,"_5":14766,"_28195":122649,"_3064":122717},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3608":73363,"_31008":73337,"_21483":122719,"_5":14766,"_28195":122653,"_3064":122720},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3608":73364,"_31008":73337,"_21483":122722,"_5":14766,"_28195":122657,"_3064":122723},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3608":73365,"_31008":73337,"_21483":122725,"_5":14766,"_28195":122665,"_3064":122726},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3608":73366,"_31008":73337,"_21483":122728,"_5":14766,"_28195":122665,"_3064":122729},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3608":73367,"_31008":73337,"_21483":122731,"_5":14766,"_28195":122668,"_3064":122732},[],"Campo de `settings.enrollment_settings`",{"_3608":73368,"_31008":73337,"_21483":122734,"_5":14766,"_28195":122668,"_3064":122735},[],"Decisión",{"_3608":73369,"_31008":73337,"_21483":122737,"_5":14766,"_28195":122668,"_3064":53767},[],{"_3608":73370,"_31008":73337,"_21483":122739,"_5":14766,"_28195":122668,"_3064":122740},[],"`EST_RFC7030` para estas operaciones.",{"_3608":73371,"_31008":73337,"_21483":122742,"_5":14766,"_28195":122668,"_3064":53773},[],{"_3608":73372,"_31008":73337,"_21483":122744,"_5":14766,"_28195":122668,"_3064":122745},[],"ID de la CA que firmará.",{"_3608":73373,"_31008":73337,"_21483":122747,"_5":14766,"_28195":122668,"_3064":53779},[],{"_3608":73374,"_31008":73337,"_21483":122749,"_5":14766,"_28195":122668,"_3064":122750},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3608":73375,"_31008":73337,"_21483":122752,"_5":14766,"_28195":122668,"_3064":53785},[],{"_3608":73376,"_31008":73337,"_21483":122754,"_5":14766,"_28195":122668,"_3064":122755},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3608":73377,"_31008":73337,"_21483":122757,"_5":14766,"_28195":122668,"_3064":53791},[],{"_3608":73378,"_31008":73337,"_21483":122759,"_5":14766,"_28195":122668,"_3064":122760},[],"Uno de los cuatro modos de autenticación.",{"_3608":73379,"_31008":73337,"_21483":122762,"_5":14766,"_28195":122668,"_3064":122763},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3608":73380,"_31008":73337,"_21483":122765,"_5":14766,"_28195":122671,"_3064":122766},[],"Los bloques son independientes:",{"_3608":73381,"_31008":73337,"_21483":122768,"_5":14766,"_28195":122671,"_3064":122769},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3608":73382,"_31008":73337,"_21483":122771,"_5":14766,"_28195":122671,"_3064":122772},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3608":73383,"_31008":73337,"_21483":122774,"_5":14766,"_28195":122671,"_3064":53809},[],{"_3608":73384,"_31008":73337,"_21483":122776,"_5":14766,"_28195":122671,"_3064":122777},[],"Control aplicado en la operación configurada",{"_3608":73385,"_31008":73337,"_21483":122779,"_5":14766,"_28195":122671,"_3064":53815},[],{"_3608":73386,"_31008":73337,"_21483":122781,"_5":14766,"_28195":122671,"_3064":122782},[],"Validación del certificado presentado.",{"_3608":73387,"_31008":73337,"_21483":122784,"_5":14766,"_28195":122671,"_3064":53821},[],{"_3608":73388,"_31008":73337,"_21483":122786,"_5":14766,"_28195":122671,"_3064":122787},[],"Autorización del webhook configurado.",{"_3608":73389,"_31008":73337,"_21483":122789,"_5":14766,"_28195":122671,"_3064":53827},[],{"_3608":73390,"_31008":73337,"_21483":122791,"_5":14766,"_28195":122671,"_3064":122792},[],"Validación del certificado y, después, aprobación del webhook.",{"_3608":73391,"_31008":73337,"_21483":122794,"_5":14766,"_28195":122671,"_3064":53833},[],{"_3608":73392,"_31008":73337,"_21483":122796,"_5":14766,"_28195":122671,"_3064":122797},[],"Sin autenticación del solicitante por el DMS.",{"_3608":73393,"_31008":73337,"_21483":122799,"_5":14766,"_28195":122671,"_3064":122800},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3608":73394,"_31008":73337,"_21483":122802,"_5":14766,"_28195":122671,"_3064":122803},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3608":73395,"_31008":73337,"_21483":122805,"_5":14766,"_28195":122671,"_3064":122806},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3608":73396,"_31008":73337,"_21483":122808,"_5":14766,"_28195":122671,"_3064":122809},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3608":73397,"_31008":73337,"_21483":122811,"_5":14766,"_28195":122675,"_3064":122812},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3608":73398,"_31008":73337,"_21483":122814,"_5":14766,"_28195":122675,"_3064":122815},[],"Campo de `external_webhook_settings`",{"_3608":73399,"_31008":73337,"_21483":122817,"_5":14766,"_28195":122675,"_3064":122735},[],{"_3608":73400,"_31008":73337,"_21483":122819,"_5":14766,"_28195":122675,"_3064":53859},[],{"_3608":73401,"_31008":73337,"_21483":122821,"_5":14766,"_28195":122675,"_3064":122822},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3608":73402,"_31008":73337,"_21483":122824,"_5":14766,"_28195":122675,"_3064":53865},[],{"_3608":73403,"_31008":73337,"_21483":122826,"_5":14766,"_28195":122675,"_3064":122827},[],"`POST` o `PUT`; `POST` por defecto.",{"_3608":73404,"_31008":73337,"_21483":122829,"_5":14766,"_28195":122675,"_3064":53871},[],{"_3608":73405,"_31008":73337,"_21483":122831,"_5":14766,"_28195":122675,"_3064":122832},[],"Etiqueta usada en los logs del servicio.",{"_3608":73406,"_31008":73337,"_21483":122834,"_5":14766,"_28195":122675,"_3064":53877},[],{"_3608":73407,"_31008":73337,"_21483":122836,"_5":14766,"_28195":122675,"_3064":122837},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3608":73408,"_31008":73337,"_21483":122839,"_5":14766,"_28195":122675,"_3064":53883},[],{"_3608":73409,"_31008":73337,"_21483":122841,"_5":14766,"_28195":122675,"_3064":122842},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3608":73410,"_31008":73337,"_21483":122844,"_5":14766,"_28195":122675,"_3064":53889},[],{"_3608":73411,"_31008":73337,"_21483":122846,"_5":14766,"_28195":122675,"_3064":122847},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3608":73412,"_31008":73337,"_21483":122849,"_5":14766,"_28195":122675,"_3064":53895},[],{"_3608":73413,"_31008":73337,"_21483":122851,"_5":14766,"_28195":122675,"_3064":122852},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3608":73414,"_31008":73337,"_21483":122854,"_5":14766,"_28195":122675,"_3064":53901},[],{"_3608":73415,"_31008":73337,"_21483":122856,"_5":14766,"_28195":122675,"_3064":122857},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3608":73416,"_31008":73337,"_21483":122859,"_5":14766,"_28195":122675,"_3064":53907},[],{"_3608":73417,"_31008":73337,"_21483":122861,"_5":14766,"_28195":122675,"_3064":122862},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3608":73418,"_31008":73337,"_21483":122864,"_5":14766,"_28195":122675,"_3064":53913},[],{"_3608":73419,"_31008":73337,"_21483":122866,"_5":14766,"_28195":122675,"_3064":122867},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3608":73420,"_31008":73337,"_21483":122869,"_5":14766,"_28195":122675,"_3064":122870},[],"Reglas de esa configuración:",{"_3608":73421,"_31008":73337,"_21483":122872,"_5":14766,"_28195":122675,"_3064":122873},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3608":73422,"_31008":73337,"_21483":122875,"_5":14766,"_28195":122675,"_3064":122876},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3608":73423,"_31008":73337,"_21483":122878,"_5":14766,"_28195":122675,"_3064":122879},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3608":73424,"_31008":73337,"_21483":122881,"_5":14766,"_28195":122675,"_3064":122882},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3608":73425,"_31008":73337,"_21483":122884,"_5":14766,"_28195":122675,"_3064":122885},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3608":73426,"_31008":73337,"_21483":122887,"_5":14766,"_28195":122675,"_3064":122888},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3608":73427,"_31008":73337,"_21483":122890,"_5":14766,"_28195":122675,"_3064":122891},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3608":73428,"_31008":73337,"_21483":122893,"_5":14766,"_28195":122675,"_3064":122894},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3608":73429,"_31008":73337,"_21483":122896,"_5":14766,"_28195":122675,"_3064":122897},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3608":73430,"_31008":73337,"_21483":122899,"_5":14766,"_28195":122679,"_3064":122900},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3608":73431,"_31008":73337,"_21483":122902,"_5":14766,"_28195":122683,"_3064":122903},[],"Campo de `settings.reenrollment_settings`",{"_3608":73432,"_31008":73337,"_21483":122905,"_5":14766,"_28195":122683,"_3064":122906},[],"Función",{"_3608":73433,"_31008":73337,"_21483":122908,"_5":14766,"_28195":122683,"_3064":53957},[],{"_3608":73434,"_31008":73337,"_21483":122910,"_5":14766,"_28195":122683,"_3064":122911},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3608":73435,"_31008":73337,"_21483":122913,"_5":14766,"_28195":122683,"_3064":53963},[],{"_3608":73436,"_31008":73337,"_21483":122915,"_5":14766,"_28195":122683,"_3064":122916},[],"Umbral operativo preventivo de monitorización.",{"_3608":73437,"_31008":73337,"_21483":122918,"_5":14766,"_28195":122683,"_3064":53969},[],{"_3608":73438,"_31008":73337,"_21483":122920,"_5":14766,"_28195":122683,"_3064":122921},[],"Umbral operativo crítico de monitorización.",{"_3608":73439,"_31008":73337,"_21483":122923,"_5":14766,"_28195":122683,"_3064":53975},[],{"_3608":73440,"_31008":73337,"_21483":122925,"_5":14766,"_28195":122683,"_3064":122926},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3608":73441,"_31008":73337,"_21483":122928,"_5":14766,"_28195":122683,"_3064":53981},[],{"_3608":73442,"_31008":73337,"_21483":122930,"_5":14766,"_28195":122683,"_3064":122931},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3608":73443,"_31008":73337,"_21483":122933,"_5":14766,"_28195":122683,"_3064":53987},[],{"_3608":73444,"_31008":73337,"_21483":122935,"_5":14766,"_28195":122683,"_3064":122936},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3608":73445,"_31008":73337,"_21483":122938,"_5":14766,"_28195":122683,"_3064":122939},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3608":73446,"_31008":73337,"_21483":122941,"_5":14766,"_28195":122687,"_3064":122942},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3608":73447,"_31008":73337,"_21483":122944,"_5":14766,"_28195":122690,"_3064":120130},[],{"_3608":73448,"_31008":73337,"_21483":122946,"_5":14766,"_28195":122690,"_3064":122947},[],"Qué publica",{"_3608":73449,"_31008":73337,"_21483":122949,"_5":14766,"_28195":122690,"_3064":54004},[],{"_3608":73450,"_31008":73337,"_21483":122951,"_5":14766,"_28195":122690,"_3064":122952},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3608":73451,"_31008":73337,"_21483":122954,"_5":14766,"_28195":122690,"_3064":54010},[],{"_3608":73452,"_31008":73337,"_21483":122956,"_5":14766,"_28195":122690,"_3064":122957},[],"Certificado de la CA emisora seleccionada.",{"_3608":73453,"_31008":73337,"_21483":122959,"_5":14766,"_28195":122690,"_3064":54016},[],{"_3608":73454,"_31008":73337,"_21483":122961,"_5":14766,"_28195":122690,"_3064":122962},[],"Certificados de las CAs elegidas explícitamente.",{"_3608":73455,"_31008":73337,"_21483":122964,"_5":14766,"_28195":122690,"_3064":122965},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3608":73456,"_31008":73337,"_21483":122967,"_5":14766,"_28195":122694,"_3064":122968},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3608":73457,"_31008":73337,"_21483":122970,"_5":14766,"_28195":122694,"_3064":122971},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3608":73458,"_31008":73337,"_21483":122973,"_5":14766,"_28195":122694,"_3064":122974},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3608":73459,"_31008":73337,"_21483":122976,"_5":14766,"_28195":122698,"_3064":122977},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3608":73460,"_31008":73460,"_5":15126,"_3064":122979,"_31366":122980,"_21483":122981,"_28195":73460},"Integra el cliente EST",[50713,121232,53397,122377,122552],[],{"_3608":73461,"_31008":73460,"_21483":122983,"_5":14766,"_28195":73460,"_3064":122984},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3608":73462,"_31008":73460,"_5":31363,"_21483":122986,"_28195":122987,"_3064":119766},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3608":73463,"_31008":73460,"_5":31363,"_21483":122989,"_28195":122990,"_3064":122991},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3608":73464,"_31008":73460,"_5":31363,"_21483":122993,"_28195":122994,"_3064":122995},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3608":73465,"_31008":73460,"_5":31363,"_21483":122997,"_28195":122998,"_3064":122999},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3608":73466,"_31008":73460,"_5":31363,"_21483":123001,"_28195":123002,"_3064":123003},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3608":73467,"_31008":73460,"_5":31363,"_21483":123005,"_28195":123006,"_3064":123007},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3608":73468,"_31008":73460,"_21483":123009,"_5":14766,"_28195":73460,"_3064":123010},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3608":73469,"_31008":73460,"_21483":123012,"_5":14766,"_28195":122987,"_3064":123013},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3608":73470,"_31008":73460,"_21483":123015,"_5":14766,"_28195":122987,"_3064":123016},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3608":73471,"_31008":73460,"_21483":123018,"_5":14766,"_28195":122987,"_3064":123019},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3608":73472,"_31008":73460,"_21483":123021,"_5":14766,"_28195":122990,"_3064":123022},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3608":73473,"_31008":73460,"_21483":123024,"_5":14766,"_28195":122990,"_3064":123025},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3608":73474,"_31008":73460,"_21483":123027,"_5":14766,"_28195":122994,"_3064":123028},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3608":73475,"_31008":73460,"_21483":123030,"_5":14766,"_28195":122994,"_3064":123031},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3608":73476,"_31008":73460,"_21483":123033,"_5":14766,"_28195":122998,"_3064":123034},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3608":73477,"_31008":73460,"_21483":123036,"_5":14766,"_28195":122998,"_3064":123037},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3608":73478,"_31008":73460,"_21483":123039,"_5":14766,"_28195":123002,"_3064":123040},[],"Para el caso de una raíz que emite directamente:",{"_3608":73479,"_31008":73460,"_21483":123042,"_5":14766,"_28195":123002,"_3064":123043},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3608":73480,"_31008":73460,"_21483":123045,"_5":14766,"_28195":123002,"_3064":123046},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3608":73481,"_31008":73460,"_21483":123048,"_5":14766,"_28195":123006,"_3064":123049},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3608":73482,"_31008":73482,"_5":15126,"_3064":123051,"_31366":123052,"_21483":123053,"_28195":73482},"Referencia EST",[50713,121232,53397,122377,122552],[],{"_3608":73483,"_31008":73482,"_21483":123055,"_5":14766,"_28195":73482,"_3064":123056},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3608":73484,"_31008":73482,"_5":31363,"_21483":123058,"_28195":123059,"_3064":123060},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3608":73485,"_31008":73482,"_5":31363,"_21483":123062,"_28195":123063,"_3064":23280},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3608":73486,"_31008":73482,"_5":31363,"_21483":123065,"_28195":123066,"_3064":26746},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3608":73487,"_31008":73482,"_5":31363,"_21483":123068,"_28195":123069,"_3064":26753},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3608":73488,"_31008":73482,"_5":31363,"_21483":123071,"_28195":123072,"_3064":26031},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3608":73489,"_31008":73482,"_5":31363,"_21483":123074,"_28195":123075,"_3064":123076},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3608":73490,"_31008":73482,"_5":31363,"_21483":123078,"_28195":123079,"_3064":123080},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3608":73491,"_31008":73482,"_5":31363,"_21483":123082,"_28195":123083,"_3064":123084},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3608":73492,"_31008":73482,"_21483":123086,"_5":14766,"_28195":73482,"_3064":123087},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3608":73493,"_31008":73482,"_21483":123089,"_5":14766,"_28195":123059,"_3064":123090},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3608":73494,"_31008":73482,"_21483":123092,"_5":14766,"_28195":123059,"_3064":120992},[],{"_3608":73495,"_31008":73482,"_21483":123094,"_5":14766,"_28195":123059,"_3064":123095},[],"Método",{"_3608":73496,"_31008":73482,"_21483":123097,"_5":14766,"_28195":123059,"_3064":123098},[],"Autenticación y condición",{"_3608":73497,"_31008":73482,"_21483":123100,"_5":14766,"_28195":123059,"_3064":54159},[],{"_3608":73498,"_31008":73482,"_21483":123102,"_5":14766,"_28195":123059,"_3064":54162},[],{"_3608":73499,"_31008":73482,"_21483":123104,"_5":14766,"_28195":123059,"_3064":123105},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3608":73500,"_31008":73482,"_21483":123107,"_5":14766,"_28195":123059,"_3064":54168},[],{"_3608":73501,"_31008":73482,"_21483":123109,"_5":14766,"_28195":123059,"_3064":54171},[],{"_3608":73502,"_31008":73482,"_21483":123111,"_5":14766,"_28195":123059,"_3064":123112},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3608":73503,"_31008":73482,"_21483":123114,"_5":14766,"_28195":123059,"_3064":54177},[],{"_3608":73504,"_31008":73482,"_21483":123116,"_5":14766,"_28195":123059,"_3064":54171},[],{"_3608":73505,"_31008":73482,"_21483":123118,"_5":14766,"_28195":123059,"_3064":123119},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3608":73506,"_31008":73482,"_21483":123121,"_5":14766,"_28195":123059,"_3064":54185},[],{"_3608":73507,"_31008":73482,"_21483":123123,"_5":14766,"_28195":123059,"_3064":54171},[],{"_3608":73508,"_31008":73482,"_21483":123125,"_5":14766,"_28195":123059,"_3064":123126},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3608":73509,"_31008":73482,"_21483":123128,"_5":14766,"_28195":123059,"_3064":123129},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3608":73510,"_31008":73482,"_21483":123131,"_5":14766,"_28195":123063,"_3064":123132},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3608":73511,"_31008":73482,"_21483":123134,"_5":14766,"_28195":123063,"_3064":123135},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3608":73512,"_31008":73482,"_21483":123137,"_5":14766,"_28195":123066,"_3064":123138},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3608":73513,"_31008":73482,"_21483":123140,"_5":14766,"_28195":123066,"_3064":123141},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3608":73514,"_31008":73482,"_21483":123143,"_5":14766,"_28195":123069,"_3064":123144},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3608":73515,"_31008":73482,"_21483":123146,"_5":14766,"_28195":123069,"_3064":123147},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3608":73516,"_31008":73482,"_21483":123149,"_5":14766,"_28195":123072,"_3064":123150},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3608":73517,"_31008":73482,"_21483":123152,"_5":14766,"_28195":123072,"_3064":123153},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3608":73518,"_31008":73482,"_21483":123155,"_5":14766,"_28195":123075,"_3064":123156},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3608":73519,"_31008":73482,"_21483":123158,"_5":14766,"_28195":123075,"_3064":123159},[],"Parte",{"_3608":73520,"_31008":73482,"_21483":123161,"_5":14766,"_28195":123075,"_3064":123162},[],"Contenido tras decodificar su Base64",{"_3608":73521,"_31008":73482,"_21483":123164,"_5":14766,"_28195":123075,"_3064":54229},[],{"_3608":73522,"_31008":73482,"_21483":123166,"_5":14766,"_28195":123075,"_3064":123167},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3608":73523,"_31008":73482,"_21483":123169,"_5":14766,"_28195":123075,"_3064":54235},[],{"_3608":73524,"_31008":73482,"_21483":123171,"_5":14766,"_28195":123075,"_3064":123172},[],"PKCS#7 DER con el certificado emitido.",{"_3608":73525,"_31008":73482,"_21483":123174,"_5":14766,"_28195":123075,"_3064":123175},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3608":73526,"_31008":73482,"_21483":123177,"_5":14766,"_28195":123079,"_3064":123178},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3608":73527,"_31008":73482,"_21483":123180,"_5":14766,"_28195":123079,"_3064":123181},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3608":73528,"_31008":73482,"_21483":123183,"_5":14766,"_28195":123079,"_3064":123184},[],"Convierte y comprueba el resultado:",{"_3608":73529,"_31008":73482,"_21483":123186,"_5":14766,"_28195":123079,"_3064":123187},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3608":73530,"_31008":73482,"_21483":123189,"_5":14766,"_28195":123083,"_3064":123190},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3608":73531,"_31008":73482,"_21483":123192,"_5":14766,"_28195":123083,"_3064":123193},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3608":73532,"_31008":73532,"_5":15126,"_3064":122552,"_31366":123195,"_21483":123196,"_28195":73532},[50713,121232,53397,122377,122552],[],{"_3608":73533,"_31008":73532,"_21483":123198,"_5":14766,"_28195":73532,"_3064":123199},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3608":73534,"_31008":73532,"_5":31363,"_21483":123201,"_28195":123202,"_3064":123203},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3608":73535,"_31008":73532,"_5":31363,"_21483":123205,"_28195":123206,"_3064":123207},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3608":73536,"_31008":73532,"_5":31363,"_21483":123209,"_28195":123210,"_3064":123211},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3608":73537,"_31008":73532,"_5":31363,"_21483":123213,"_28195":123214,"_3064":123215},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3608":73538,"_31008":73532,"_21483":123217,"_5":14766,"_28195":73532,"_3064":123218},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3608":73539,"_31008":73532,"_21483":123220,"_5":14766,"_28195":123202,"_3064":123221},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3608":73540,"_31008":73532,"_21483":123223,"_5":14766,"_28195":123202,"_3064":123224},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3608":73541,"_31008":73532,"_21483":123226,"_5":14766,"_28195":123202,"_3064":123227},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3608":73542,"_31008":73532,"_21483":123229,"_5":14766,"_28195":123202,"_3064":123230},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3608":73543,"_31008":73532,"_21483":123232,"_5":14766,"_28195":123202,"_3064":123233},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3608":73544,"_31008":73532,"_21483":123235,"_5":14766,"_28195":123202,"_3064":123236},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3608":73545,"_31008":73532,"_21483":123238,"_5":14766,"_28195":123206,"_3064":123239},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3608":73546,"_31008":73532,"_21483":123241,"_5":14766,"_28195":123206,"_3064":123242},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3608":73547,"_31008":73532,"_21483":123244,"_5":14766,"_28195":123206,"_3064":123245},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3608":73548,"_31008":73532,"_21483":123247,"_5":14766,"_28195":123206,"_3064":123248},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3608":73549,"_31008":73532,"_21483":123250,"_5":14766,"_28195":123210,"_3064":123251},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3608":73550,"_31008":73532,"_21483":123253,"_5":14766,"_28195":123210,"_3064":123254},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3608":73551,"_31008":73532,"_21483":123256,"_5":14766,"_28195":123210,"_3064":123257},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3608":73552,"_31008":73532,"_21483":123259,"_5":14766,"_28195":123210,"_3064":123260},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3608":73553,"_31008":73532,"_21483":123262,"_5":14766,"_28195":123214,"_3064":123263},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3608":73554,"_31008":73532,"_21483":123265,"_5":14766,"_28195":123214,"_3064":123266},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3608":73555,"_31008":73555,"_5":15126,"_3064":123268,"_31366":123269,"_21483":123270,"_28195":73555},"Estrategias de aprovisionamiento",[50713,121232,53397,122377,122552],[],{"_3608":73556,"_31008":73555,"_21483":123272,"_5":14766,"_28195":73555,"_3064":123273},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3608":73557,"_31008":73555,"_5":31363,"_21483":123275,"_28195":123276,"_3064":123277},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3608":73558,"_31008":73555,"_5":31363,"_21483":123279,"_28195":123280,"_3064":123281},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3608":73559,"_31008":73555,"_5":31363,"_21483":123283,"_28195":123284,"_3064":123285},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3608":73560,"_31008":73555,"_5":31363,"_21483":123287,"_28195":123288,"_3064":123289},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3608":73561,"_31008":73555,"_5":31363,"_21483":123291,"_28195":123292,"_3064":123293},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3608":73562,"_31008":73555,"_21483":123295,"_5":14766,"_28195":73555,"_3064":123296},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3608":73563,"_31008":73555,"_21483":123298,"_5":14766,"_28195":123276,"_3064":123299},[],"Recorrido",{"_3608":73564,"_31008":73555,"_21483":123301,"_5":14766,"_28195":123276,"_3064":123302},[],"Cuándo existe el dispositivo",{"_3608":73565,"_31008":73555,"_21483":123304,"_5":14766,"_28195":123276,"_3064":123305},[],"Qué compruebas",{"_3608":73566,"_31008":73555,"_21483":123307,"_5":14766,"_28195":123276,"_3064":123308},[],"Asignación manual",{"_3608":73567,"_31008":73555,"_21483":123310,"_5":14766,"_28195":123276,"_3064":123311},[],"El operador lo crea antes de asociar un certificado.",{"_3608":73568,"_31008":73555,"_21483":123313,"_5":14766,"_28195":123276,"_3064":123314},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3608":73569,"_31008":73555,"_21483":123316,"_5":14766,"_28195":123276,"_3064":123317},[],"EST con `JITP`",{"_3608":73570,"_31008":73555,"_21483":123319,"_5":14766,"_28195":123276,"_3064":123320},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3608":73571,"_31008":73555,"_21483":123322,"_5":14766,"_28195":123276,"_3064":123323},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3608":73572,"_31008":73555,"_21483":123325,"_5":14766,"_28195":123276,"_3064":123326},[],"EST con `PRE_REGISTRATION`",{"_3608":73573,"_31008":73555,"_21483":123328,"_5":14766,"_28195":123276,"_3064":123329},[],"Debe existir antes de `/simpleenroll`.",{"_3608":73574,"_31008":73555,"_21483":123331,"_5":14766,"_28195":123276,"_3064":123332},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3608":73575,"_31008":73555,"_21483":123334,"_5":14766,"_28195":123276,"_3064":123335},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3608":73576,"_31008":73555,"_21483":123337,"_5":14766,"_28195":123276,"_3064":123338},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3608":73577,"_31008":73555,"_21483":123340,"_5":14766,"_28195":123280,"_3064":123341},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3608":73578,"_31008":73555,"_21483":123343,"_5":14766,"_28195":123280,"_3064":123344},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3608":73579,"_31008":73555,"_21483":123346,"_5":14766,"_28195":123280,"_3064":123347},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3608":73580,"_31008":73555,"_21483":123349,"_5":14766,"_28195":123284,"_3064":123350},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3608":73581,"_31008":73555,"_21483":123352,"_5":14766,"_28195":123284,"_3064":123353},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3608":73582,"_31008":73555,"_21483":123355,"_5":14766,"_28195":123284,"_3064":123356},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3608":73583,"_31008":73555,"_21483":123358,"_5":14766,"_28195":123284,"_3064":123359},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3608":73584,"_31008":73555,"_21483":123361,"_5":14766,"_28195":123284,"_3064":123362},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3608":73585,"_31008":73555,"_21483":123364,"_5":14766,"_28195":123284,"_3064":123365},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3608":73586,"_31008":73555,"_21483":123367,"_5":14766,"_28195":123288,"_3064":120130},[],{"_3608":73587,"_31008":73555,"_21483":123369,"_5":14766,"_28195":123288,"_3064":123370},[],"Material que atraviesa EST",{"_3608":73588,"_31008":73555,"_21483":123372,"_5":14766,"_28195":123288,"_3064":123373},[],"Clave generada por el dispositivo",{"_3608":73589,"_31008":73555,"_21483":123375,"_5":14766,"_28195":123288,"_3064":123376},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3608":73590,"_31008":73555,"_21483":123378,"_5":14766,"_28195":123288,"_3064":123379},[],"Clave ya disponible en el dispositivo",{"_3608":73591,"_31008":73555,"_21483":123381,"_5":14766,"_28195":123288,"_3064":123382},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3608":73592,"_31008":73555,"_21483":123384,"_5":14766,"_28195":123288,"_3064":53716},[],{"_3608":73593,"_31008":73555,"_21483":123386,"_5":14766,"_28195":123288,"_3064":123387},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3608":73594,"_31008":73555,"_21483":123389,"_5":14766,"_28195":123288,"_3064":123390},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3608":73595,"_31008":73555,"_21483":123392,"_5":14766,"_28195":123292,"_3064":123393},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3608":73596,"_31008":73596,"_5":15126,"_3064":123395,"_31366":123396,"_21483":123397,"_28195":73596},"Renovación y recuperación",[50713,121232,53397,122377,122552],[],{"_3608":73597,"_31008":73596,"_21483":123399,"_5":14766,"_28195":73596,"_3064":123400},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3608":73598,"_31008":73596,"_5":31363,"_21483":123402,"_28195":123403,"_3064":123404},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3608":73599,"_31008":73596,"_5":31363,"_21483":123406,"_28195":123407,"_3064":123408},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3608":73600,"_31008":73596,"_5":31363,"_21483":123410,"_28195":123411,"_3064":123412},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3608":73601,"_31008":73596,"_5":31363,"_21483":123414,"_28195":123415,"_3064":123416},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3608":73602,"_31008":73596,"_5":31363,"_21483":123418,"_28195":123419,"_3064":123420},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3608":73603,"_31008":73596,"_21483":123422,"_5":14766,"_28195":73596,"_3064":123423},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3608":73604,"_31008":73596,"_21483":123425,"_5":14766,"_28195":123403,"_3064":123426},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3608":73605,"_31008":73596,"_21483":123428,"_5":14766,"_28195":123403,"_3064":123429},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3608":73606,"_31008":73596,"_21483":123431,"_5":14766,"_28195":123403,"_3064":123432},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3608":73607,"_31008":73596,"_21483":123434,"_5":14766,"_28195":123403,"_3064":123435},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3608":73608,"_31008":73596,"_21483":123437,"_5":14766,"_28195":123407,"_3064":123438},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3608":73609,"_31008":73596,"_21483":123440,"_5":14766,"_28195":123407,"_3064":123441},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3608":73610,"_31008":73596,"_21483":123443,"_5":14766,"_28195":123411,"_3064":123444},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3608":73611,"_31008":73596,"_21483":123446,"_5":14766,"_28195":123411,"_3064":123447},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3608":73612,"_31008":73596,"_21483":123449,"_5":14766,"_28195":123411,"_3064":123450},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3608":73613,"_31008":73596,"_21483":123452,"_5":14766,"_28195":123415,"_3064":123453},[],"Situación",{"_3608":73614,"_31008":73596,"_21483":123455,"_5":14766,"_28195":123415,"_3064":123456},[],"Procedimiento",{"_3608":73615,"_31008":73596,"_21483":123458,"_5":14766,"_28195":123415,"_3064":123459},[],"Certificado vigente, fuera de ventana",{"_3608":73616,"_31008":73596,"_21483":123461,"_5":14766,"_28195":123415,"_3064":123462},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3608":73617,"_31008":73596,"_21483":123464,"_5":14766,"_28195":123415,"_3064":123465},[],"Certificado vencido, clave disponible",{"_3608":73618,"_31008":73596,"_21483":123467,"_5":14766,"_28195":123415,"_3064":123468},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3608":73619,"_31008":73596,"_21483":123470,"_5":14766,"_28195":123415,"_3064":123471},[],"Renovación por webhook o `NO_AUTH`",{"_3608":73620,"_31008":73596,"_21483":123473,"_5":14766,"_28195":123415,"_3064":123474},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3608":73621,"_31008":73596,"_21483":123476,"_5":14766,"_28195":123415,"_3064":123477},[],"Clave perdida o inaccesible",{"_3608":73622,"_31008":73596,"_21483":123479,"_5":14766,"_28195":123415,"_3064":123480},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3608":73623,"_31008":73596,"_21483":123482,"_5":14766,"_28195":123415,"_3064":123483},[],"Identidad actual revocada",{"_3608":73624,"_31008":73596,"_21483":123485,"_5":14766,"_28195":123415,"_3064":123486},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3608":73625,"_31008":73596,"_21483":123488,"_5":14766,"_28195":123415,"_3064":123489},[],"Dispositivo sin identidad",{"_3608":73626,"_31008":73596,"_21483":123491,"_5":14766,"_28195":123415,"_3064":123492},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3608":73627,"_31008":73596,"_21483":123494,"_5":14766,"_28195":123415,"_3064":123495},[],"Dispositivo retirado",{"_3608":73628,"_31008":73596,"_21483":123497,"_5":14766,"_28195":123415,"_3064":123498},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3608":73629,"_31008":73596,"_21483":123500,"_5":14766,"_28195":123415,"_3064":123501},[],"Timeout, HTTP 500 o fallo de instalación",{"_3608":73630,"_31008":73596,"_21483":123503,"_5":14766,"_28195":123415,"_3064":123504},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3608":73631,"_31008":73596,"_21483":123506,"_5":14766,"_28195":123419,"_3064":123507},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3608":73632,"_31008":73596,"_21483":123509,"_5":14766,"_28195":123419,"_3064":123510},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3608":73633,"_31008":73633,"_5":15126,"_3064":123512,"_31366":123513,"_21483":123514,"_28195":73633},"Diagnóstico de enrolamiento",[50713,121232,53397,122377,122552],[],{"_3608":73634,"_31008":73633,"_21483":123516,"_5":14766,"_28195":73633,"_3064":123517},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3608":73635,"_31008":73633,"_5":31363,"_21483":123519,"_28195":123520,"_3064":123521},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3608":73636,"_31008":73633,"_5":31363,"_21483":123523,"_28195":123524,"_3064":123525},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3608":73637,"_31008":73633,"_5":31363,"_21483":123527,"_28195":123528,"_3064":123084},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3608":73638,"_31008":73633,"_5":31363,"_21483":123530,"_28195":123531,"_3064":123532},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3608":73639,"_31008":73633,"_21483":123534,"_5":14766,"_28195":73633,"_3064":123535},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3608":73640,"_31008":73633,"_21483":123537,"_5":14766,"_28195":123524,"_3064":123538},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3608":73641,"_31008":73633,"_21483":123540,"_5":14766,"_28195":123524,"_3064":123541},[],"Síntoma o mensaje",{"_3608":73642,"_31008":73633,"_21483":123543,"_5":14766,"_28195":123524,"_3064":123544},[],"Qué revisar",{"_3608":73643,"_31008":73633,"_21483":123546,"_5":14766,"_28195":123524,"_3064":123547},[],"curl rechaza TLS, nombre o emisor",{"_3608":73644,"_31008":73633,"_21483":123549,"_5":14766,"_28195":123524,"_3064":123550},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3608":73645,"_31008":73633,"_21483":123552,"_5":14766,"_28195":123524,"_3064":123553},[],"404 o APS ausente",{"_3608":73646,"_31008":73633,"_21483":123555,"_5":14766,"_28195":123524,"_3064":123556},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3608":73647,"_31008":73633,"_21483":123558,"_5":14766,"_28195":123524,"_3064":123559},[],"400, error de CSR o formato",{"_3608":73648,"_31008":73633,"_21483":123561,"_5":14766,"_28195":123524,"_3064":123562},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3608":73649,"_31008":73633,"_21483":123564,"_5":14766,"_28195":123524,"_3064":123565},[],"Credencial ausente o certificado no válido",{"_3608":73650,"_31008":73633,"_21483":123567,"_5":14766,"_28195":123524,"_3064":123568},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3608":73651,"_31008":73633,"_21483":123570,"_5":14766,"_28195":123524,"_3064":123571},[],"Webhook deniega, expira o responde sin autorización",{"_3608":73652,"_31008":73633,"_21483":123573,"_5":14766,"_28195":123524,"_3064":123574},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3608":73653,"_31008":73633,"_21483":123576,"_5":14766,"_28195":123524,"_3064":54642},[],{"_3608":73654,"_31008":73633,"_21483":123578,"_5":14766,"_28195":123524,"_3064":123579},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3608":73655,"_31008":73633,"_21483":123581,"_5":14766,"_28195":123524,"_3064":54648},[],{"_3608":73656,"_31008":73633,"_21483":123583,"_5":14766,"_28195":123524,"_3064":123584},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3608":73657,"_31008":73633,"_21483":123586,"_5":14766,"_28195":123524,"_3064":54654},[],{"_3608":73658,"_31008":73633,"_21483":123588,"_5":14766,"_28195":123524,"_3064":123589},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3608":73659,"_31008":73633,"_21483":123591,"_5":14766,"_28195":123524,"_3064":54660},[],{"_3608":73660,"_31008":73633,"_21483":123593,"_5":14766,"_28195":123524,"_3064":123594},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3608":73661,"_31008":73633,"_21483":123596,"_5":14766,"_28195":123524,"_3064":54666},[],{"_3608":73662,"_31008":73633,"_21483":123598,"_5":14766,"_28195":123524,"_3064":123599},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3608":73663,"_31008":73633,"_21483":123601,"_5":14766,"_28195":123524,"_3064":123602},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3608":73664,"_31008":73633,"_21483":123604,"_5":14766,"_28195":123524,"_3064":123605},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3608":73665,"_31008":73633,"_21483":123607,"_5":14766,"_28195":123524,"_3064":123608},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3608":73666,"_31008":73633,"_21483":123610,"_5":14766,"_28195":123524,"_3064":123611},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3608":73667,"_31008":73633,"_21483":123613,"_5":14766,"_28195":123524,"_3064":54684},[],{"_3608":73668,"_31008":73633,"_21483":123615,"_5":14766,"_28195":123524,"_3064":123616},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3608":73669,"_31008":73633,"_21483":123618,"_5":14766,"_28195":123524,"_3064":54690},[],{"_3608":73670,"_31008":73633,"_21483":123620,"_5":14766,"_28195":123524,"_3064":123621},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3608":73671,"_31008":73633,"_21483":123623,"_5":14766,"_28195":123524,"_3064":123624},[],"DMS propietario distinto",{"_3608":73672,"_31008":73633,"_21483":123626,"_5":14766,"_28195":123524,"_3064":123627},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3608":73673,"_31008":73633,"_21483":123629,"_5":14766,"_28195":123524,"_3064":54702},[],{"_3608":73674,"_31008":73633,"_21483":123631,"_5":14766,"_28195":123524,"_3064":123632},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3608":73675,"_31008":73633,"_21483":123634,"_5":14766,"_28195":123524,"_3064":54708},[],{"_3608":73676,"_31008":73633,"_21483":123636,"_5":14766,"_28195":123524,"_3064":123637},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3608":73677,"_31008":73633,"_21483":123639,"_5":14766,"_28195":123524,"_3064":123640},[],"Certificado actual revocado",{"_3608":73678,"_31008":73633,"_21483":123642,"_5":14766,"_28195":123524,"_3064":123643},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3608":73679,"_31008":73633,"_21483":123645,"_5":14766,"_28195":123524,"_3064":123646},[],"Error de CA, perfil o firma",{"_3608":73680,"_31008":73633,"_21483":123648,"_5":14766,"_28195":123524,"_3064":123649},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3608":73681,"_31008":73633,"_21483":123651,"_5":14766,"_28195":123524,"_3064":123652},[],"HTTP 200 sin conexión del dispositivo",{"_3608":73682,"_31008":73633,"_21483":123654,"_5":14766,"_28195":123524,"_3064":123655},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3608":73683,"_31008":73633,"_21483":123657,"_5":14766,"_28195":123524,"_3064":123658},[],"Timeout o error después de emitir",{"_3608":73684,"_31008":73633,"_21483":123660,"_5":14766,"_28195":123524,"_3064":123661},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3608":73685,"_31008":73633,"_21483":123663,"_5":14766,"_28195":123528,"_3064":123664},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3608":73686,"_31008":73633,"_21483":123666,"_5":14766,"_28195":123528,"_3064":123667},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3608":73687,"_31008":73633,"_21483":123669,"_5":14766,"_28195":123531,"_3064":123670},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3608":73688,"_31008":73633,"_21483":123672,"_5":14766,"_28195":123531,"_3064":123673},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3608":73689,"_31008":73633,"_21483":123675,"_5":14766,"_28195":123531,"_3064":123676},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3608":73690,"_31008":73633,"_21483":123678,"_5":14766,"_28195":123531,"_3064":123679},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3608":73691,"_31008":73633,"_21483":123681,"_5":14766,"_28195":123531,"_3064":123682},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3608":73692,"_31008":73633,"_21483":123684,"_5":14766,"_28195":123531,"_3064":123685},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3608":73693,"_31008":73633,"_21483":123687,"_5":14766,"_28195":123531,"_3064":123688},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3608":73694,"_31008":73694,"_5":15126,"_3064":123690,"_31366":123691,"_21483":123692,"_28195":73694},"Distribución y actualización de confianza",[50713,121232,53397,122377,122552],[],{"_3608":73695,"_31008":73694,"_21483":123694,"_5":14766,"_28195":73694,"_3064":123695},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3608":73696,"_31008":73694,"_5":31363,"_21483":123697,"_28195":123698,"_3064":123699},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3608":73697,"_31008":73694,"_5":31363,"_21483":123701,"_28195":123702,"_3064":123703},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3608":73698,"_31008":73694,"_5":31363,"_21483":123705,"_28195":123706,"_3064":123707},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3608":73699,"_31008":73694,"_5":31363,"_21483":123709,"_28195":123710,"_3064":123711},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3608":73700,"_31008":73694,"_5":31363,"_21483":123713,"_28195":123714,"_3064":123715},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3608":73701,"_31008":73694,"_21483":123717,"_5":14766,"_28195":73694,"_3064":123718},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3608":73702,"_31008":73694,"_21483":123720,"_5":14766,"_28195":123698,"_3064":123721},[],"Relación",{"_3608":73703,"_31008":73694,"_21483":123723,"_5":14766,"_28195":123698,"_3064":123724},[],"Material que prepara el responsable",{"_3608":73704,"_31008":73694,"_21483":123726,"_5":14766,"_28195":123698,"_3064":123727},[],"Dispositivo → servidor EST",{"_3608":73705,"_31008":73694,"_21483":123729,"_5":14766,"_28195":123698,"_3064":123730},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3608":73706,"_31008":73694,"_21483":123732,"_5":14766,"_28195":123698,"_3064":123733},[],"DMS → solicitante",{"_3608":73707,"_31008":73694,"_21483":123735,"_5":14766,"_28195":123698,"_3064":123736},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3608":73708,"_31008":73694,"_21483":123738,"_5":14766,"_28195":123698,"_3064":123739},[],"Consumidor → dispositivo",{"_3608":73709,"_31008":73694,"_21483":123741,"_5":14766,"_28195":123698,"_3064":123742},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3608":73710,"_31008":73694,"_21483":123744,"_5":14766,"_28195":123698,"_3064":123745},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3608":73711,"_31008":73694,"_21483":123747,"_5":14766,"_28195":123702,"_3064":123748},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3608":73712,"_31008":73694,"_21483":123750,"_5":14766,"_28195":123702,"_3064":123751},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3608":73713,"_31008":73694,"_21483":123753,"_5":14766,"_28195":123706,"_3064":123754},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3608":73714,"_31008":73694,"_21483":123756,"_5":14766,"_28195":123706,"_3064":123757},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3608":73715,"_31008":73694,"_21483":123759,"_5":14766,"_28195":123706,"_3064":123760},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3608":73716,"_31008":73694,"_21483":123762,"_5":14766,"_28195":123706,"_3064":123763},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3608":73717,"_31008":73694,"_21483":123765,"_5":14766,"_28195":123706,"_3064":123766},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3608":73718,"_31008":73694,"_21483":123768,"_5":14766,"_28195":123706,"_3064":123769},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3608":73719,"_31008":73694,"_21483":123771,"_5":14766,"_28195":123710,"_3064":123772},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3608":73720,"_31008":73694,"_21483":123774,"_5":14766,"_28195":123710,"_3064":123775},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3608":73721,"_31008":73694,"_21483":123777,"_5":14766,"_28195":123710,"_3064":123778},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3608":73722,"_31008":73694,"_21483":123780,"_5":14766,"_28195":123714,"_3064":123781},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3608":73723,"_31008":73723,"_5":15126,"_3064":54857,"_31366":123783,"_21483":123785,"_28195":73723},[50713,121232,53397,122377,123784],"Integraciones",[],{"_3608":73724,"_31008":73723,"_21483":123787,"_5":14766,"_28195":73723,"_3064":123788},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3608":73725,"_31008":73723,"_5":31363,"_21483":123790,"_28195":123791,"_3064":123792},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3608":73726,"_31008":73723,"_5":31363,"_21483":123794,"_28195":123795,"_3064":123796},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3608":73727,"_31008":73723,"_5":31363,"_21483":123798,"_28195":123799,"_3064":123800},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3608":73728,"_31008":73723,"_5":31363,"_21483":123802,"_28195":123803,"_3064":123804},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3608":73729,"_31008":73723,"_5":31363,"_21483":123806,"_28195":123807,"_3064":123808},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3608":73730,"_31008":73723,"_5":31363,"_21483":123810,"_28195":123811,"_3064":123812},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3608":73731,"_31008":73723,"_5":31363,"_21483":123814,"_28195":123815,"_3064":123816},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3608":73732,"_31008":73723,"_5":31363,"_21483":123818,"_28195":123819,"_3064":123820},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3608":73733,"_31008":73723,"_5":31363,"_21483":123822,"_28195":123823,"_3064":54899},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3608":73734,"_31008":73723,"_5":31363,"_21483":123825,"_28195":123826,"_3064":54903},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3608":73735,"_31008":73723,"_5":31363,"_21483":123828,"_28195":123829,"_3064":123830},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3608":73736,"_31008":73723,"_5":31363,"_21483":123832,"_28195":123833,"_3064":123834},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3608":73737,"_31008":73723,"_5":31363,"_21483":123836,"_28195":123837,"_3064":123838},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3608":73738,"_31008":73723,"_5":31363,"_21483":123840,"_28195":123841,"_3064":123842},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3608":73739,"_31008":73723,"_5":31363,"_21483":123844,"_28195":123845,"_3064":123846},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3608":73740,"_31008":73723,"_5":31363,"_21483":123848,"_28195":123849,"_3064":123850},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3608":73741,"_31008":73723,"_5":31363,"_21483":123852,"_28195":123853,"_3064":123854},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3608":73742,"_31008":73723,"_5":31363,"_21483":123856,"_28195":123857,"_3064":123858},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3608":73743,"_31008":73723,"_5":31363,"_21483":123860,"_28195":123861,"_3064":123862},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3608":73744,"_31008":73723,"_5":31363,"_21483":123864,"_28195":123865,"_3064":123866},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3608":73745,"_31008":73723,"_5":31363,"_21483":123868,"_28195":123869,"_3064":123870},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3608":73746,"_31008":73723,"_5":31363,"_21483":123872,"_28195":123873,"_3064":123874},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3608":73747,"_31008":73723,"_5":31363,"_21483":123876,"_28195":123877,"_3064":123878},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3608":73748,"_31008":73723,"_5":31363,"_21483":123880,"_28195":123881,"_3064":123882},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3608":73749,"_31008":73723,"_5":31363,"_21483":123884,"_28195":123885,"_3064":123886},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3608":73750,"_31008":73723,"_21483":123888,"_5":14766,"_28195":73723,"_3064":123889},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3608":73751,"_31008":73723,"_21483":123891,"_5":14766,"_28195":73723,"_3064":123892},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3608":73752,"_31008":73723,"_21483":123894,"_5":14766,"_28195":73723,"_3064":123895},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3608":73753,"_31008":73723,"_21483":123897,"_5":14766,"_28195":123791,"_3064":123898},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3608":73754,"_31008":73723,"_21483":123900,"_5":14766,"_28195":123791,"_3064":123901},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3608":73755,"_31008":73723,"_21483":123903,"_5":14766,"_28195":123791,"_3064":123904},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3608":73756,"_31008":73723,"_21483":123906,"_5":14766,"_28195":123791,"_3064":123907},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3608":73757,"_31008":73723,"_21483":123909,"_5":14766,"_28195":123795,"_3064":123910},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3608":73758,"_31008":73723,"_21483":123912,"_5":14766,"_28195":123799,"_3064":123913},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3608":73759,"_31008":73723,"_21483":123915,"_5":14766,"_28195":123799,"_3064":123916},[],"Acción IAM",{"_3608":73760,"_31008":73723,"_21483":123918,"_5":14766,"_28195":123799,"_3064":120136},[],{"_3608":73761,"_31008":73723,"_21483":123920,"_5":14766,"_28195":123799,"_3064":54998},[],{"_3608":73762,"_31008":73723,"_21483":123922,"_5":14766,"_28195":123799,"_3064":123923},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3608":73763,"_31008":73723,"_21483":123925,"_5":14766,"_28195":123799,"_3064":55004},[],{"_3608":73764,"_31008":73723,"_21483":123927,"_5":14766,"_28195":123799,"_3064":123928},[],"Registrar la CA en AWS IoT",{"_3608":73765,"_31008":73723,"_21483":123930,"_5":14766,"_28195":123799,"_3064":55010},[],{"_3608":73766,"_31008":73723,"_21483":123932,"_5":14766,"_28195":123799,"_3064":123933},[],"Consultar el estado del registro de la CA",{"_3608":73767,"_31008":73723,"_21483":123935,"_5":14766,"_28195":123799,"_3064":55016},[],{"_3608":73768,"_31008":73723,"_21483":123937,"_5":14766,"_28195":123799,"_3064":123938},[],"Crear o actualizar Things en IoT Core",{"_3608":73769,"_31008":73723,"_21483":123940,"_5":14766,"_28195":123799,"_3064":55022},[],{"_3608":73770,"_31008":73723,"_21483":123942,"_5":14766,"_28195":123799,"_3064":123943},[],"Aprovisionar Things mediante plantilla",{"_3608":73771,"_31008":73723,"_21483":123945,"_5":14766,"_28195":123799,"_3064":55028},[],{"_3608":73772,"_31008":73723,"_21483":123947,"_5":14766,"_28195":123799,"_3064":123948},[],"Registrar certificados de dispositivo",{"_3608":73773,"_31008":73723,"_21483":123950,"_5":14766,"_28195":123799,"_3064":55034},[],{"_3608":73774,"_31008":73723,"_21483":123952,"_5":14766,"_28195":123799,"_3064":123953},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3608":73775,"_31008":73723,"_21483":123955,"_5":14766,"_28195":123799,"_3064":55040},[],{"_3608":73776,"_31008":73723,"_21483":123957,"_5":14766,"_28195":123799,"_3064":123958},[],"Crear y adjuntar políticas IoT",{"_3608":73777,"_31008":73723,"_21483":123960,"_5":14766,"_28195":123799,"_3064":55046},[],{"_3608":73778,"_31008":73723,"_21483":123962,"_5":14766,"_28195":123799,"_3064":123963},[],"Gestionar grupos de Things",{"_3608":73779,"_31008":73723,"_21483":123965,"_5":14766,"_28195":123799,"_3064":55052},[],{"_3608":73780,"_31008":73723,"_21483":123967,"_5":14766,"_28195":123799,"_3064":123968},[],"Crear plantillas JITP",{"_3608":73781,"_31008":73723,"_21483":123970,"_5":14766,"_28195":123799,"_3064":55058},[],{"_3608":73782,"_31008":73723,"_21483":123972,"_5":14766,"_28195":123799,"_3064":123973},[],"Leer y escribir el Device Shadow",{"_3608":73783,"_31008":73723,"_21483":123975,"_5":14766,"_28195":123799,"_3064":123976},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3608":73784,"_31008":73723,"_21483":123978,"_5":14766,"_28195":123803,"_3064":123979},[],"Parámetro",{"_3608":73785,"_31008":73723,"_21483":123981,"_5":14766,"_28195":123803,"_3064":123982},[],"Tipo",{"_3608":73786,"_31008":73723,"_21483":123984,"_5":14766,"_28195":123803,"_3064":123985},[],"Requerido",{"_3608":73787,"_31008":73723,"_21483":123987,"_5":14766,"_28195":123803,"_3064":123988},[],"Descripción",{"_3608":73788,"_31008":73723,"_21483":123990,"_5":14766,"_28195":123803,"_3064":55079},[],{"_3608":73789,"_31008":73723,"_21483":123992,"_5":14766,"_28195":123803,"_3064":25641},[],{"_3608":73790,"_31008":73723,"_21483":123994,"_5":14766,"_28195":123803,"_3064":123995},[],"Sí",{"_3608":73791,"_31008":73723,"_21483":123997,"_5":14766,"_28195":123803,"_3064":123998},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3608":73792,"_31008":73723,"_21483":124000,"_5":14766,"_28195":123803,"_3064":55090},[],{"_3608":73793,"_31008":73723,"_21483":124002,"_5":14766,"_28195":123803,"_3064":25641},[],{"_3608":73794,"_31008":73723,"_21483":124004,"_5":14766,"_28195":123803,"_3064":123995},[],{"_3608":73795,"_31008":73723,"_21483":124006,"_5":14766,"_28195":123803,"_3064":124007},[],"Región AWS donde opera el conector.",{"_3608":73796,"_31008":73723,"_21483":124009,"_5":14766,"_28195":123803,"_3064":55100},[],{"_3608":73797,"_31008":73723,"_21483":124011,"_5":14766,"_28195":123803,"_3064":25641},[],{"_3608":73798,"_31008":73723,"_21483":124013,"_5":14766,"_28195":123803,"_3064":123995},[],{"_3608":73799,"_31008":73723,"_21483":124015,"_5":14766,"_28195":123803,"_3064":124016},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3608":73800,"_31008":73723,"_21483":124018,"_5":14766,"_28195":123803,"_3064":55110},[],{"_3608":73801,"_31008":73723,"_21483":124020,"_5":14766,"_28195":123803,"_3064":25641},[],{"_3608":73802,"_31008":73723,"_21483":124022,"_5":14766,"_28195":123803,"_3064":124023},[],"Solo con `auth_method=static`",{"_3608":73803,"_31008":73723,"_21483":124025,"_5":14766,"_28195":123803,"_3064":124026},[],"Clave de acceso AWS.",{"_3608":73804,"_31008":73723,"_21483":124028,"_5":14766,"_28195":123803,"_3064":55121},[],{"_3608":73805,"_31008":73723,"_21483":124030,"_5":14766,"_28195":123803,"_3064":25641},[],{"_3608":73806,"_31008":73723,"_21483":124032,"_5":14766,"_28195":123803,"_3064":124023},[],{"_3608":73807,"_31008":73723,"_21483":124034,"_5":14766,"_28195":123803,"_3064":124035},[],"Clave secreta AWS.",{"_3608":73808,"_31008":73723,"_21483":124037,"_5":14766,"_28195":123803,"_3064":55131},[],{"_3608":73809,"_31008":73723,"_21483":124039,"_5":14766,"_28195":123803,"_3064":25641},[],{"_3608":73810,"_31008":73723,"_21483":124041,"_5":14766,"_28195":123803,"_3064":55136},[],{"_3608":73811,"_31008":73723,"_21483":124043,"_5":14766,"_28195":123803,"_3064":124044},[],"Token de sesión (con `auth_method=static`).",{"_3608":73812,"_31008":73723,"_21483":124046,"_5":14766,"_28195":123803,"_3064":55142},[],{"_3608":73813,"_31008":73723,"_21483":124048,"_5":14766,"_28195":123803,"_3064":25641},[],{"_3608":73814,"_31008":73723,"_21483":124050,"_5":14766,"_28195":123803,"_3064":124051},[],"Solo con `auth_method=role`",{"_3608":73815,"_31008":73723,"_21483":124053,"_5":14766,"_28195":123803,"_3064":124054},[],"ARN del rol a asumir.",{"_3608":73816,"_31008":73723,"_21483":124056,"_5":14766,"_28195":123803,"_3064":55153},[],{"_3608":73817,"_31008":73723,"_21483":124058,"_5":14766,"_28195":123803,"_3064":25641},[],{"_3608":73818,"_31008":73723,"_21483":124060,"_5":14766,"_28195":123803,"_3064":55136},[],{"_3608":73819,"_31008":73723,"_21483":124062,"_5":14766,"_28195":123803,"_3064":124063},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3608":73820,"_31008":73723,"_21483":124065,"_5":14766,"_28195":123803,"_3064":55163},[],{"_3608":73821,"_31008":73723,"_21483":124067,"_5":14766,"_28195":123803,"_3064":92491},[],{"_3608":73822,"_31008":73723,"_21483":124069,"_5":14766,"_28195":123803,"_3064":123995},[],{"_3608":73823,"_31008":73723,"_21483":124071,"_5":14766,"_28195":123803,"_3064":124072},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3608":73824,"_31008":73723,"_21483":124074,"_5":14766,"_28195":123803,"_3064":55173},[],{"_3608":73825,"_31008":73723,"_21483":124076,"_5":14766,"_28195":123803,"_3064":25641},[],{"_3608":73826,"_31008":73723,"_21483":124078,"_5":14766,"_28195":123803,"_3064":123995},[],{"_3608":73827,"_31008":73723,"_21483":124080,"_5":14766,"_28195":123803,"_3064":124081},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3608":73828,"_31008":73723,"_21483":124083,"_5":14766,"_28195":123803,"_3064":55183},[],{"_3608":73829,"_31008":73723,"_21483":124085,"_5":14766,"_28195":123803,"_3064":25641},[],{"_3608":73830,"_31008":73723,"_21483":124087,"_5":14766,"_28195":123803,"_3064":123995},[],{"_3608":73831,"_31008":73723,"_21483":124089,"_5":14766,"_28195":123803,"_3064":124090},[],"URL HTTP del Device Manager de Lamassu.",{"_3608":73832,"_31008":73723,"_21483":124092,"_5":14766,"_28195":123803,"_3064":55193},[],{"_3608":73833,"_31008":73723,"_21483":124094,"_5":14766,"_28195":123803,"_3064":25641},[],{"_3608":73834,"_31008":73723,"_21483":124096,"_5":14766,"_28195":123803,"_3064":123995},[],{"_3608":73835,"_31008":73723,"_21483":124098,"_5":14766,"_28195":123803,"_3064":124099},[],"URL HTTP del servicio de CA de Lamassu.",{"_3608":73836,"_31008":73723,"_21483":124101,"_5":14766,"_28195":123807,"_3064":124102},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3608":73837,"_31008":73723,"_21483":124104,"_5":14766,"_28195":123807,"_3064":124105},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3608":73838,"_31008":73723,"_21483":124107,"_5":14766,"_28195":123807,"_3064":124108},[],"Tipo de CloudEvent",{"_3608":73839,"_31008":73723,"_21483":124110,"_5":14766,"_28195":123807,"_3064":124111},[],"Recurso en Lamassu",{"_3608":73840,"_31008":73723,"_21483":124113,"_5":14766,"_28195":123807,"_3064":124114},[],"Recurso AWS",{"_3608":73841,"_31008":73723,"_21483":124116,"_5":14766,"_28195":123807,"_3064":124117},[],"Acciones IAM",{"_3608":73842,"_31008":73723,"_21483":124119,"_5":14766,"_28195":123807,"_3064":124120},[],"Llamadas AWS y efecto",{"_3608":73843,"_31008":73723,"_21483":124122,"_5":14766,"_28195":123807,"_3064":124123},[],"Dónde en esta página",{"_3608":73844,"_31008":73723,"_21483":124125,"_5":14766,"_28195":123807,"_3064":55227},[],{"_3608":73845,"_31008":73723,"_21483":124127,"_5":14766,"_28195":123807,"_3064":55230},[],{"_3608":73846,"_31008":73723,"_21483":124129,"_5":14766,"_28195":123807,"_3064":55233},[],{"_3608":73847,"_31008":73723,"_21483":124131,"_5":14766,"_28195":123807,"_3064":55236},[],{"_3608":73848,"_31008":73723,"_21483":124133,"_5":14766,"_28195":123807,"_3064":124134},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3608":73849,"_31008":73723,"_21483":124136,"_5":14766,"_28195":123807,"_3064":123820},[],{"_3608":73850,"_31008":73723,"_21483":124138,"_5":14766,"_28195":123807,"_3064":55244},[],{"_3608":73851,"_31008":73723,"_21483":124140,"_5":14766,"_28195":123807,"_3064":55247},[],{"_3608":73852,"_31008":73723,"_21483":124142,"_5":14766,"_28195":123807,"_3064":55250},[],{"_3608":73853,"_31008":73723,"_21483":124144,"_5":14766,"_28195":123807,"_3064":55253},[],{"_3608":73854,"_31008":73723,"_21483":124146,"_5":14766,"_28195":123807,"_3064":124147},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3608":73855,"_31008":73723,"_21483":124149,"_5":14766,"_28195":123807,"_3064":123846},[],{"_3608":73856,"_31008":73723,"_21483":124151,"_5":14766,"_28195":123807,"_3064":55261},[],{"_3608":73857,"_31008":73723,"_21483":124153,"_5":14766,"_28195":123807,"_3064":124154},[],"Dispositivo",{"_3608":73858,"_31008":73723,"_21483":124156,"_5":14766,"_28195":123807,"_3064":55267},[],{"_3608":73859,"_31008":73723,"_21483":124158,"_5":14766,"_28195":123807,"_3064":55270},[],{"_3608":73860,"_31008":73723,"_21483":124160,"_5":14766,"_28195":123807,"_3064":124161},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3608":73861,"_31008":73723,"_21483":124163,"_5":14766,"_28195":123807,"_3064":123854},[],{"_3608":73862,"_31008":73723,"_21483":124165,"_5":14766,"_28195":123807,"_3064":55278},[],{"_3608":73863,"_31008":73723,"_21483":124167,"_5":14766,"_28195":123807,"_3064":124168},[],"Certificado",{"_3608":73864,"_31008":73723,"_21483":124170,"_5":14766,"_28195":123807,"_3064":55284},[],{"_3608":73865,"_31008":73723,"_21483":124172,"_5":14766,"_28195":123807,"_3064":124173},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3608":73866,"_31008":73723,"_21483":124175,"_5":14766,"_28195":123807,"_3064":124176},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3608":73867,"_31008":73723,"_21483":124178,"_5":14766,"_28195":123807,"_3064":123866},[],{"_3608":73868,"_31008":73723,"_21483":124180,"_5":14766,"_28195":123807,"_3064":55295},[],{"_3608":73869,"_31008":73723,"_21483":124182,"_5":14766,"_28195":123807,"_3064":124183},[],"Certificado / Dispositivo",{"_3608":73870,"_31008":73723,"_21483":124185,"_5":14766,"_28195":123807,"_3064":55301},[],{"_3608":73871,"_31008":73723,"_21483":124187,"_5":14766,"_28195":123807,"_3064":51109},[],{"_3608":73872,"_31008":73723,"_21483":124189,"_5":14766,"_28195":123807,"_3064":124190},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3608":73873,"_31008":73723,"_21483":124192,"_5":14766,"_28195":123807,"_3064":123874},[],{"_3608":73874,"_31008":73723,"_21483":124194,"_5":14766,"_28195":123811,"_3064":124195},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3608":73875,"_31008":73723,"_21483":124197,"_5":14766,"_28195":123815,"_3064":124198},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3608":73876,"_31008":73723,"_21483":124200,"_5":14766,"_28195":123815,"_3064":124201},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3608":73877,"_31008":73723,"_21483":124203,"_5":14766,"_28195":123819,"_3064":124204},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3608":73878,"_31008":73723,"_21483":124206,"_5":14766,"_28195":123819,"_3064":124207},[],"Transición",{"_3608":73879,"_31008":73723,"_21483":124209,"_5":14766,"_28195":123819,"_3064":124210},[],"Llamadas AWS",{"_3608":73880,"_31008":73723,"_21483":124212,"_5":14766,"_28195":123819,"_3064":124213},[],"`NoRegistrada` → `Solicitada`",{"_3608":73881,"_31008":73723,"_21483":124215,"_5":14766,"_28195":123819,"_3064":124216},[],"ninguna (solo escritura de metadatos)",{"_3608":73882,"_31008":73723,"_21483":124218,"_5":14766,"_28195":123819,"_3064":124219},[],"`Solicitada` → `Registrando`",{"_3608":73883,"_31008":73723,"_21483":124221,"_5":14766,"_28195":123819,"_3064":124222},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3608":73884,"_31008":73723,"_21483":124224,"_5":14766,"_28195":123819,"_3064":124225},[],"`Registrando` → `Completada`",{"_3608":73885,"_31008":73723,"_21483":124227,"_5":14766,"_28195":123819,"_3064":124228},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3608":73886,"_31008":73723,"_21483":124230,"_5":14766,"_28195":123819,"_3064":124231},[],"`Registrando` → `Fallida`",{"_3608":73887,"_31008":73723,"_21483":124233,"_5":14766,"_28195":123819,"_3064":124234},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3608":73888,"_31008":73723,"_21483":124236,"_5":14766,"_28195":123819,"_3064":124237},[],"`Fallida` / `Completada` → `Solicitada`",{"_3608":73889,"_31008":73723,"_21483":124239,"_5":14766,"_28195":123819,"_3064":124240},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3608":73890,"_31008":73723,"_21483":124242,"_5":14766,"_28195":123823,"_3064":124243},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3608":73891,"_31008":73723,"_21483":124245,"_5":14766,"_28195":123823,"_3064":124246},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3608":73892,"_31008":73723,"_21483":124248,"_5":14766,"_28195":123823,"_3064":124249},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3608":73893,"_31008":73723,"_21483":124251,"_5":14766,"_28195":123823,"_3064":124252},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3608":73894,"_31008":73723,"_21483":124254,"_5":14766,"_28195":123823,"_3064":124255},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3608":73895,"_31008":73723,"_21483":124257,"_5":14766,"_28195":123823,"_3064":124258},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3608":73896,"_31008":73723,"_21483":124260,"_5":14766,"_28195":123826,"_3064":124261},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3608":73897,"_31008":73723,"_21483":124263,"_5":14766,"_28195":123829,"_3064":124264},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3608":73898,"_31008":73723,"_21483":124266,"_5":14766,"_28195":123829,"_3064":124267},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3608":73899,"_31008":73723,"_21483":124269,"_5":14766,"_28195":123833,"_3064":124270},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3608":73900,"_31008":73723,"_21483":124272,"_5":14766,"_28195":123837,"_3064":124273},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3608":73901,"_31008":73723,"_21483":124275,"_5":14766,"_28195":123837,"_3064":124276},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3608":73902,"_31008":73723,"_21483":124278,"_5":14766,"_28195":123837,"_3064":124279},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3608":73903,"_31008":73723,"_21483":124281,"_5":14766,"_28195":123837,"_3064":124282},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3608":73904,"_31008":73723,"_21483":124284,"_5":14766,"_28195":123837,"_3064":124285},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3608":73905,"_31008":73723,"_21483":124287,"_5":14766,"_28195":123837,"_3064":124288},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3608":73906,"_31008":73723,"_21483":124290,"_5":14766,"_28195":123841,"_3064":124291},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3608":73907,"_31008":73723,"_21483":124293,"_5":14766,"_28195":123841,"_3064":124294},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3608":73908,"_31008":73723,"_21483":124296,"_5":14766,"_28195":123841,"_3064":124297},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3608":73909,"_31008":73723,"_21483":124299,"_5":14766,"_28195":123841,"_3064":124300},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3608":73910,"_31008":73723,"_21483":124302,"_5":14766,"_28195":123841,"_3064":124303},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3608":73911,"_31008":73723,"_21483":124305,"_5":14766,"_28195":123845,"_3064":124306},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3608":73912,"_31008":73723,"_21483":124308,"_5":14766,"_28195":123845,"_3064":124207},[],{"_3608":73913,"_31008":73723,"_21483":124310,"_5":14766,"_28195":123845,"_3064":124210},[],{"_3608":73914,"_31008":73723,"_21483":124312,"_5":14766,"_28195":123845,"_3064":124313},[],"`SinConfigurar` → `None` / `Auto`",{"_3608":73915,"_31008":73723,"_21483":124315,"_5":14766,"_28195":123845,"_3064":124316},[],"ninguna (solo configuración)",{"_3608":73916,"_31008":73723,"_21483":124318,"_5":14766,"_28195":123845,"_3064":55438},[],{"_3608":73917,"_31008":73723,"_21483":124320,"_5":14766,"_28195":123845,"_3064":124316},[],{"_3608":73918,"_31008":73723,"_21483":124322,"_5":14766,"_28195":123845,"_3064":124323},[],"Cualquiera → `Jitp`",{"_3608":73919,"_31008":73723,"_21483":124325,"_5":14766,"_28195":123845,"_3064":124326},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3608":73920,"_31008":73723,"_21483":124328,"_5":14766,"_28195":123845,"_3064":55449},[],{"_3608":73921,"_31008":73723,"_21483":124330,"_5":14766,"_28195":123845,"_3064":124331},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3608":73922,"_31008":73723,"_21483":124333,"_5":14766,"_28195":123849,"_3064":124334},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3608":73923,"_31008":73723,"_21483":124336,"_5":14766,"_28195":123849,"_3064":124337},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3608":73924,"_31008":73723,"_21483":124339,"_5":14766,"_28195":123849,"_3064":124340},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3608":73925,"_31008":73723,"_21483":124342,"_5":14766,"_28195":123853,"_3064":124343},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3608":73926,"_31008":73723,"_21483":124345,"_5":14766,"_28195":123853,"_3064":124207},[],{"_3608":73927,"_31008":73723,"_21483":124347,"_5":14766,"_28195":123853,"_3064":124210},[],{"_3608":73928,"_31008":73723,"_21483":124349,"_5":14766,"_28195":123853,"_3064":124350},[],"`Ausente` → `Aprovisionado`",{"_3608":73929,"_31008":73723,"_21483":124352,"_5":14766,"_28195":123853,"_3064":124353},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3608":73930,"_31008":73723,"_21483":124355,"_5":14766,"_28195":123853,"_3064":124356},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3608":73931,"_31008":73723,"_21483":124358,"_5":14766,"_28195":123853,"_3064":124359},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3608":73932,"_31008":73723,"_21483":124361,"_5":14766,"_28195":123853,"_3064":124362},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3608":73933,"_31008":73723,"_21483":124364,"_5":14766,"_28195":123857,"_3064":124365},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3608":73934,"_31008":73723,"_21483":124367,"_5":14766,"_28195":123857,"_3064":124368},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3608":73935,"_31008":73723,"_21483":124370,"_5":14766,"_28195":123857,"_3064":124371},[],"Para que el flujo JITP funcione correctamente:",{"_3608":73936,"_31008":73723,"_21483":124373,"_5":14766,"_28195":123857,"_3064":124374},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3608":73937,"_31008":73723,"_21483":124376,"_5":14766,"_28195":123857,"_3064":124377},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3608":73938,"_31008":73723,"_21483":124379,"_5":14766,"_28195":123857,"_3064":124380},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3608":73939,"_31008":73723,"_21483":124382,"_5":14766,"_28195":123857,"_3064":124383},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3608":73940,"_31008":73723,"_21483":124385,"_5":14766,"_28195":123861,"_3064":124386},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3608":73941,"_31008":73723,"_21483":124388,"_5":14766,"_28195":123861,"_3064":124389},[],"Estado en Lamassu",{"_3608":73942,"_31008":73723,"_21483":124391,"_5":14766,"_28195":123861,"_3064":124392},[],"Razón de revocación",{"_3608":73943,"_31008":73723,"_21483":124394,"_5":14766,"_28195":123861,"_3064":124395},[],"Estado en AWS IoT Core",{"_3608":73944,"_31008":73723,"_21483":124397,"_5":14766,"_28195":123861,"_3064":55519},[],{"_3608":73945,"_31008":73723,"_21483":124399,"_5":14766,"_28195":123861,"_3064":124400},[],"Ninguna",{"_3608":73946,"_31008":73723,"_21483":124402,"_5":14766,"_28195":123861,"_3064":55525},[],{"_3608":73947,"_31008":73723,"_21483":124404,"_5":14766,"_28195":123861,"_3064":55528},[],{"_3608":73948,"_31008":73723,"_21483":124406,"_5":14766,"_28195":123861,"_3064":55531},[],{"_3608":73949,"_31008":73723,"_21483":124408,"_5":14766,"_28195":123861,"_3064":55534},[],{"_3608":73950,"_31008":73723,"_21483":124410,"_5":14766,"_28195":123861,"_3064":55528},[],{"_3608":73951,"_31008":73723,"_21483":124412,"_5":14766,"_28195":123861,"_3064":124413},[],"Cualquier otra razón",{"_3608":73952,"_31008":73723,"_21483":124415,"_5":14766,"_28195":123861,"_3064":55542},[],{"_3608":73953,"_31008":73723,"_21483":124417,"_5":14766,"_28195":123861,"_3064":124418},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3608":73954,"_31008":73723,"_21483":124420,"_5":14766,"_28195":123865,"_3064":124421},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3608":73955,"_31008":73723,"_21483":124423,"_5":14766,"_28195":123865,"_3064":124207},[],{"_3608":73956,"_31008":73723,"_21483":124425,"_5":14766,"_28195":123865,"_3064":124210},[],{"_3608":73957,"_31008":73723,"_21483":124427,"_5":14766,"_28195":123865,"_3064":124428},[],"`NoSincronizado` → `Active`",{"_3608":73958,"_31008":73723,"_21483":124430,"_5":14766,"_28195":123865,"_3064":55034},[],{"_3608":73959,"_31008":73723,"_21483":124432,"_5":14766,"_28195":123865,"_3064":55560},[],{"_3608":73960,"_31008":73723,"_21483":124434,"_5":14766,"_28195":123865,"_3064":124435},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3608":73961,"_31008":73723,"_21483":124437,"_5":14766,"_28195":123865,"_3064":55566},[],{"_3608":73962,"_31008":73723,"_21483":124439,"_5":14766,"_28195":123865,"_3064":124435},[],{"_3608":73963,"_31008":73723,"_21483":124441,"_5":14766,"_28195":123865,"_3064":55571},[],{"_3608":73964,"_31008":73723,"_21483":124443,"_5":14766,"_28195":123865,"_3064":55034},[],{"_3608":73965,"_31008":73723,"_21483":124445,"_5":14766,"_28195":123865,"_3064":55576},[],{"_3608":73966,"_31008":73723,"_21483":124447,"_5":14766,"_28195":123865,"_3064":124448},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3608":73967,"_31008":73723,"_21483":124450,"_5":14766,"_28195":123869,"_3064":124451},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3608":73968,"_31008":73723,"_21483":124453,"_5":14766,"_28195":123869,"_3064":124454},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3608":73969,"_31008":73723,"_21483":124456,"_5":14766,"_28195":123869,"_3064":124457},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3608":73970,"_31008":73723,"_21483":124459,"_5":14766,"_28195":123873,"_3064":124460},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3608":73971,"_31008":73723,"_21483":124462,"_5":14766,"_28195":123873,"_3064":124463},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3608":73972,"_31008":73723,"_21483":124465,"_5":14766,"_28195":123877,"_3064":124466},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3608":73973,"_31008":73723,"_21483":124468,"_5":14766,"_28195":123877,"_3064":124469},[],"Existen dos tipos de acciones:",{"_3608":73974,"_31008":73723,"_21483":124471,"_5":14766,"_28195":123877,"_3064":124472},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3608":73975,"_31008":73723,"_21483":124474,"_5":14766,"_28195":123877,"_3064":124475},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3608":73976,"_31008":73723,"_21483":124477,"_5":14766,"_28195":123877,"_3064":124478},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3608":73977,"_31008":73723,"_21483":124480,"_5":14766,"_28195":123881,"_3064":124481},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3608":73978,"_31008":73723,"_21483":124483,"_5":14766,"_28195":123881,"_3064":124484},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3608":73979,"_31008":73723,"_21483":124486,"_5":14766,"_28195":123881,"_3064":124487},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3608":73980,"_31008":73723,"_21483":124489,"_5":14766,"_28195":123885,"_3064":124490},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3608":73981,"_31008":73723,"_21483":124492,"_5":14766,"_28195":123885,"_3064":124493},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3608":73982,"_31008":73723,"_21483":124495,"_5":14766,"_28195":123885,"_3064":124496},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3608":73983,"_31008":73723,"_21483":124498,"_5":14766,"_28195":123885,"_3064":124499},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3608":73984,"_31008":73723,"_21483":124501,"_5":14766,"_28195":123885,"_3064":124502},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3608":73985,"_31008":73723,"_21483":124504,"_5":14766,"_28195":123885,"_3064":124505},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3608":73986,"_31008":73723,"_21483":124507,"_5":14766,"_28195":123885,"_3064":124508},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3608":73987,"_31008":73723,"_21483":124510,"_5":14766,"_28195":123885,"_3064":124511},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3608":73988,"_31008":73723,"_21483":124513,"_5":14766,"_28195":123885,"_3064":124514},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3608":73989,"_31008":73723,"_21483":124516,"_5":14766,"_28195":123885,"_3064":124517},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3608":73990,"_31008":73723,"_21483":124519,"_5":14766,"_28195":123885,"_3064":124520},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3608":73991,"_31008":73723,"_21483":124522,"_5":14766,"_28195":123885,"_3064":124523},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3608":73992,"_31008":73723,"_21483":124525,"_5":14766,"_28195":123885,"_3064":124526},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3608":73993,"_31008":73723,"_21483":124528,"_5":14766,"_28195":123885,"_3064":124529},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3608":73994,"_31008":73723,"_21483":124531,"_5":14766,"_28195":123885,"_3064":124532},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3608":73995,"_31008":73723,"_21483":124534,"_5":14766,"_28195":123885,"_3064":124535},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3608":73996,"_31008":73723,"_21483":124537,"_5":14766,"_28195":123885,"_3064":124538},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3608":73997,"_31008":73723,"_21483":124540,"_5":14766,"_28195":123885,"_3064":124541},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3608":73998,"_31008":73723,"_21483":124543,"_5":14766,"_28195":123885,"_3064":124544},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3608":73999,"_31008":73723,"_21483":124546,"_5":14766,"_28195":123885,"_3064":124547},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3608":74000,"_31008":73723,"_21483":124549,"_5":14766,"_28195":123885,"_3064":124550},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3608":74001,"_31008":73723,"_21483":124552,"_5":14766,"_28195":123885,"_3064":124553},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3608":74002,"_31008":73723,"_21483":124555,"_5":14766,"_28195":123885,"_3064":124556},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3608":74003,"_31008":73723,"_21483":124558,"_5":14766,"_28195":123885,"_3064":124559},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3608":74004,"_31008":74004,"_5":15126,"_3064":53397,"_31366":124561,"_21483":124562,"_28195":74004},[50713,121232,53397],[],{"_3608":74005,"_31008":74004,"_21483":124564,"_5":14766,"_28195":74004,"_3064":124565},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3608":74006,"_31008":74004,"_5":31363,"_21483":124567,"_28195":124568,"_3064":124569},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3608":74007,"_31008":74004,"_5":31363,"_21483":124571,"_28195":124572,"_3064":122377},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3608":74008,"_31008":74004,"_5":31363,"_21483":124574,"_28195":124575,"_3064":122552},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3608":74009,"_31008":74004,"_5":31363,"_21483":124577,"_28195":124578,"_3064":123784},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/overview#integraciones",{"_3608":74010,"_31008":74004,"_5":31363,"_21483":124580,"_28195":124581,"_3064":124582},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3608":74011,"_31008":74004,"_21483":124584,"_5":14766,"_28195":74004,"_3064":124585},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3608":74012,"_31008":74004,"_21483":124587,"_5":14766,"_28195":124568,"_3064":124588},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3608":74013,"_31008":74004,"_21483":124590,"_5":14766,"_28195":124568,"_3064":124591},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3608":74014,"_31008":74004,"_21483":124593,"_5":14766,"_28195":124572,"_3064":124594},[],"Recurso",{"_3608":74015,"_31008":74004,"_21483":124596,"_5":14766,"_28195":124572,"_3064":124597},[],"Qué representa",{"_3608":74016,"_31008":74004,"_21483":124599,"_5":14766,"_28195":124572,"_3064":124600},[],"**Dispositivo**",{"_3608":74017,"_31008":74004,"_21483":124602,"_5":14766,"_28195":124572,"_3064":124603},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3608":74018,"_31008":74004,"_21483":124605,"_5":14766,"_28195":124572,"_3064":124606},[],"**Identidad**",{"_3608":74019,"_31008":74004,"_21483":124608,"_5":14766,"_28195":124572,"_3064":124609},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3608":74020,"_31008":74004,"_21483":124611,"_5":14766,"_28195":124572,"_3064":55743},[],{"_3608":74021,"_31008":74004,"_21483":124613,"_5":14766,"_28195":124572,"_3064":124614},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3608":74022,"_31008":74004,"_21483":124616,"_5":14766,"_28195":124572,"_3064":124617},[],"**Flota**",{"_3608":74023,"_31008":74004,"_21483":124619,"_5":14766,"_28195":124572,"_3064":124620},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3608":74024,"_31008":74004,"_21483":124622,"_5":14766,"_28195":124572,"_3064":124623},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3608":74025,"_31008":74004,"_21483":124625,"_5":14766,"_28195":124572,"_3064":124626},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3608":74026,"_31008":74004,"_21483":124628,"_5":14766,"_28195":124575,"_3064":124629},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3608":74027,"_31008":74004,"_21483":124631,"_5":14766,"_28195":124575,"_3064":124632},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3608":74028,"_31008":74004,"_21483":124634,"_5":14766,"_28195":124575,"_3064":124635},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3608":74029,"_31008":74004,"_21483":124637,"_5":14766,"_28195":124575,"_3064":124638},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3608":74030,"_31008":74004,"_21483":124640,"_5":14766,"_28195":124575,"_3064":124641},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3608":74031,"_31008":74004,"_21483":124643,"_5":14766,"_28195":124575,"_3064":124644},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3608":74032,"_31008":74004,"_21483":124646,"_5":14766,"_28195":124575,"_3064":124647},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3608":74033,"_31008":74004,"_21483":124649,"_5":14766,"_28195":124575,"_3064":124650},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3608":74034,"_31008":74004,"_21483":124652,"_5":14766,"_28195":124578,"_3064":124653},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3608":74035,"_31008":74004,"_21483":124655,"_5":14766,"_28195":124578,"_3064":124656},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3608":74036,"_31008":74004,"_21483":124658,"_5":14766,"_28195":124581,"_3064":124659},[],"Participante",{"_3608":74037,"_31008":74004,"_21483":124661,"_5":14766,"_28195":124581,"_3064":124662},[],"Responsabilidad",{"_3608":74038,"_31008":74004,"_21483":124664,"_5":14766,"_28195":124581,"_3064":124665},[],"Administrador PKI",{"_3608":74039,"_31008":74004,"_21483":124667,"_5":14766,"_28195":124581,"_3064":124668},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3608":74040,"_31008":74004,"_21483":124670,"_5":14766,"_28195":124581,"_3064":124671},[],"Administrador del aprovisionamiento",{"_3608":74041,"_31008":74004,"_21483":124673,"_5":14766,"_28195":124581,"_3064":124674},[],"DMS, admisión, autenticación por operación e inventario.",{"_3608":74042,"_31008":74004,"_21483":124676,"_5":14766,"_28195":124581,"_3064":124677},[],"Integrador del dispositivo",{"_3608":74043,"_31008":74004,"_21483":124679,"_5":14766,"_28195":124581,"_3064":124680},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3608":74044,"_31008":74004,"_21483":124682,"_5":14766,"_28195":124581,"_3064":124683},[],"Integrador del consumidor",{"_3608":74045,"_31008":74004,"_21483":124685,"_5":14766,"_28195":124581,"_3064":124686},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3608":74046,"_31008":74004,"_21483":124688,"_5":14766,"_28195":124581,"_3064":124689},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3608":74047,"_31008":74047,"_5":15126,"_3064":124691,"_31366":124692,"_21483":124694,"_28195":74047},"Enrola y conecta tu primer dispositivo",[50713,121232,53397,124693],"Primeros pasos",[],{"_3608":74048,"_31008":74047,"_21483":124696,"_5":14766,"_28195":74047,"_3064":124697},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3608":74049,"_31008":74047,"_5":31363,"_21483":124699,"_28195":124700,"_3064":119766},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3608":74050,"_31008":74047,"_5":31363,"_21483":124702,"_28195":124703,"_3064":124704},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3608":74051,"_31008":74047,"_5":31363,"_21483":124706,"_28195":124707,"_3064":124708},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3608":74052,"_31008":74047,"_5":31363,"_21483":124710,"_28195":124711,"_3064":124712},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3608":74053,"_31008":74047,"_5":31363,"_21483":124714,"_28195":124715,"_3064":124716},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3608":74054,"_31008":74047,"_5":31363,"_21483":124718,"_28195":124719,"_3064":124720},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3608":74055,"_31008":74047,"_5":31363,"_21483":124722,"_28195":124723,"_3064":124724},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3608":74056,"_31008":74047,"_5":31363,"_21483":124726,"_28195":124727,"_3064":124728},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3608":74057,"_31008":74047,"_21483":124730,"_5":14766,"_28195":74047,"_3064":124731},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3608":74058,"_31008":74047,"_21483":124733,"_5":14766,"_28195":124700,"_3064":124734},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3608":74059,"_31008":74047,"_21483":124736,"_5":14766,"_28195":124700,"_3064":124737},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3608":74060,"_31008":74047,"_21483":124739,"_5":14766,"_28195":124700,"_3064":124740},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3608":74061,"_31008":74047,"_21483":124742,"_5":14766,"_28195":124700,"_3064":124743},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3608":74062,"_31008":74047,"_21483":124745,"_5":14766,"_28195":124700,"_3064":124746},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3608":74063,"_31008":74047,"_21483":124748,"_5":14766,"_28195":124703,"_3064":124749},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3608":74064,"_31008":74047,"_21483":124751,"_5":14766,"_28195":124703,"_3064":124752},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3608":74065,"_31008":74047,"_21483":124754,"_5":14766,"_28195":124707,"_3064":124755},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3608":74066,"_31008":74047,"_21483":124757,"_5":14766,"_28195":124707,"_3064":124758},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3608":74067,"_31008":74047,"_21483":124760,"_5":14766,"_28195":124707,"_3064":124761},[],"Ajuste",{"_3608":74068,"_31008":74047,"_21483":124763,"_5":14766,"_28195":124707,"_3064":124764},[],"Valor de evaluación",{"_3608":74069,"_31008":74047,"_21483":124766,"_5":14766,"_28195":124707,"_3064":55899},[],{"_3608":74070,"_31008":74047,"_21483":124768,"_5":14766,"_28195":124707,"_3064":124769},[],"Raíz emisora de `device-root.pem`.",{"_3608":74071,"_31008":74047,"_21483":124771,"_5":14766,"_28195":124707,"_3064":122680},[],{"_3608":74072,"_31008":74047,"_21483":124773,"_5":14766,"_28195":124707,"_3064":124774},[],"Perfil final de 1 hora que acabas de preparar.",{"_3608":74073,"_31008":74047,"_21483":124776,"_5":14766,"_28195":124707,"_3064":55910},[],{"_3608":74074,"_31008":74047,"_21483":124778,"_5":14766,"_28195":124707,"_3064":55913},[],{"_3608":74075,"_31008":74047,"_21483":124780,"_5":14766,"_28195":124707,"_3064":55916},[],{"_3608":74076,"_31008":74047,"_21483":124782,"_5":14766,"_28195":124707,"_3064":124783},[],"Habilitado.",{"_3608":74077,"_31008":74047,"_21483":124785,"_5":14766,"_28195":124707,"_3064":55922},[],{"_3608":74078,"_31008":74047,"_21483":124787,"_5":14766,"_28195":124707,"_3064":124788},[],"Deshabilitado; el ID debe ser nuevo.",{"_3608":74079,"_31008":74047,"_21483":124790,"_5":14766,"_28195":124707,"_3064":124791},[],"Autenticación inicial",{"_3608":74080,"_31008":74047,"_21483":124793,"_5":14766,"_28195":124707,"_3064":124794},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3608":74081,"_31008":74047,"_21483":124796,"_5":14766,"_28195":124707,"_3064":124797},[],"Autenticación de renovación",{"_3608":74082,"_31008":74047,"_21483":124799,"_5":14766,"_28195":124707,"_3064":124800},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3608":74083,"_31008":74047,"_21483":124802,"_5":14766,"_28195":124707,"_3064":55940},[],{"_3608":74084,"_31008":74047,"_21483":124804,"_5":14766,"_28195":124707,"_3064":124805},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3608":74085,"_31008":74047,"_21483":124807,"_5":14766,"_28195":124707,"_3064":55946},[],{"_3608":74086,"_31008":74047,"_21483":124809,"_5":14766,"_28195":124707,"_3064":124810},[],"1 hora.",{"_3608":74087,"_31008":74047,"_21483":124812,"_5":14766,"_28195":124707,"_3064":55952},[],{"_3608":74088,"_31008":74047,"_21483":124814,"_5":14766,"_28195":124707,"_3064":124815},[],"30 minutos / 10 minutos.",{"_3608":74089,"_31008":74047,"_21483":124817,"_5":14766,"_28195":124707,"_3064":55958},[],{"_3608":74090,"_31008":74047,"_21483":124819,"_5":14766,"_28195":124707,"_3064":124820},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3608":74091,"_31008":74047,"_21483":124822,"_5":14766,"_28195":124707,"_3064":53716},[],{"_3608":74092,"_31008":74047,"_21483":124824,"_5":14766,"_28195":124707,"_3064":124825},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3608":74093,"_31008":74047,"_21483":124827,"_5":14766,"_28195":124707,"_3064":55969},[],{"_3608":74094,"_31008":74047,"_21483":124829,"_5":14766,"_28195":124707,"_3064":124830},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3608":74095,"_31008":74047,"_21483":124832,"_5":14766,"_28195":124707,"_3064":124833},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3608":74096,"_31008":74047,"_21483":124835,"_5":14766,"_28195":124711,"_3064":124836},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3608":74097,"_31008":74047,"_21483":124838,"_5":14766,"_28195":124711,"_3064":124839},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3608":74098,"_31008":74047,"_21483":124841,"_5":14766,"_28195":124715,"_3064":124842},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3608":74099,"_31008":74047,"_21483":124844,"_5":14766,"_28195":124715,"_3064":124845},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3608":74100,"_31008":74047,"_21483":124847,"_5":14766,"_28195":124715,"_3064":124848},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3608":74101,"_31008":74047,"_21483":124850,"_5":14766,"_28195":124719,"_3064":124851},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3608":74102,"_31008":74047,"_21483":124853,"_5":14766,"_28195":124719,"_3064":124854},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3608":74103,"_31008":74047,"_21483":124856,"_5":14766,"_28195":124723,"_3064":124857},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3608":74104,"_31008":74047,"_21483":124859,"_5":14766,"_28195":124723,"_3064":124860},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3608":74105,"_31008":74047,"_21483":124862,"_5":14766,"_28195":124723,"_3064":124863},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3608":74106,"_31008":74047,"_21483":124865,"_5":14766,"_28195":124723,"_3064":124866},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3608":74107,"_31008":74047,"_21483":124868,"_5":14766,"_28195":124723,"_3064":124869},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3608":74108,"_31008":74047,"_21483":124871,"_5":14766,"_28195":124727,"_3064":124872},[],"Comprobación",{"_3608":74109,"_31008":74047,"_21483":124874,"_5":14766,"_28195":124727,"_3064":124875},[],"Resultado esperado",{"_3608":74110,"_31008":74047,"_21483":124877,"_5":14766,"_28195":124727,"_3064":124878},[],"Registro",{"_3608":74111,"_31008":74047,"_21483":124880,"_5":14766,"_28195":124727,"_3064":124881},[],"ID creado automáticamente y DMS correcto.",{"_3608":74112,"_31008":74047,"_21483":124883,"_5":14766,"_28195":124727,"_3064":124168},[],{"_3608":74113,"_31008":74047,"_21483":124885,"_5":14766,"_28195":124727,"_3064":124886},[],"CN, perfil, serie y clave verificados.",{"_3608":74114,"_31008":74047,"_21483":124888,"_5":14766,"_28195":124727,"_3064":124889},[],"Inventario",{"_3608":74115,"_31008":74047,"_21483":124891,"_5":14766,"_28195":124727,"_3064":124892},[],"Serie recibida visible como identidad actual y en el historial.",{"_3608":74116,"_31008":74047,"_21483":124894,"_5":14766,"_28195":124727,"_3064":124895},[],"Consumidor",{"_3608":74117,"_31008":74047,"_21483":124897,"_5":14766,"_28195":124727,"_3064":124898},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3608":74118,"_31008":74047,"_21483":124900,"_5":14766,"_28195":124727,"_3064":124901},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3608":74119,"_31008":74047,"_21483":124903,"_5":14766,"_28195":124727,"_3064":124904},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3608":74120,"_31008":74120,"_5":15126,"_3064":122394,"_31366":124906,"_21483":124907,"_28195":74120},[50713,121232,53397,124693],[],{"_3608":74121,"_31008":74120,"_21483":124909,"_5":14766,"_28195":74120,"_3064":124910},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3608":74122,"_31008":74120,"_5":31363,"_21483":124912,"_28195":124913,"_3064":119766},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3608":74123,"_31008":74120,"_5":31363,"_21483":124915,"_28195":124916,"_3064":124917},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3608":74124,"_31008":74120,"_5":31363,"_21483":124919,"_28195":124920,"_3064":124921},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3608":74125,"_31008":74120,"_5":31363,"_21483":124923,"_28195":124924,"_3064":124925},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3608":74126,"_31008":74120,"_5":31363,"_21483":124927,"_28195":124928,"_3064":124929},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3608":74127,"_31008":74120,"_5":31363,"_21483":124931,"_28195":124932,"_3064":124933},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3608":74128,"_31008":74120,"_5":31363,"_21483":124935,"_28195":124936,"_3064":124875},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3608":74129,"_31008":74120,"_5":31363,"_21483":124938,"_28195":124939,"_3064":124940},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3608":74130,"_31008":74120,"_5":31363,"_21483":124942,"_28195":124943,"_3064":124944},[],"/docs/pr-preview/pr-72/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3608":74131,"_31008":74120,"_21483":124946,"_5":14766,"_28195":74120,"_3064":124947},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3608":74132,"_31008":74120,"_21483":124949,"_5":14766,"_28195":74120,"_3064":124950},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3608":74133,"_31008":74120,"_21483":124952,"_5":14766,"_28195":124913,"_3064":124953},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3608":74134,"_31008":74120,"_21483":124955,"_5":14766,"_28195":124913,"_3064":124956},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3608":74135,"_31008":74120,"_21483":124958,"_5":14766,"_28195":124913,"_3064":124959},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3608":74136,"_31008":74120,"_21483":124961,"_5":14766,"_28195":124913,"_3064":124962},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3608":74137,"_31008":74120,"_21483":124964,"_5":14766,"_28195":124916,"_3064":124965},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3608":74138,"_31008":74120,"_21483":124967,"_5":14766,"_28195":124916,"_3064":124968},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3608":74139,"_31008":74120,"_21483":124970,"_5":14766,"_28195":124916,"_3064":124971},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3608":74140,"_31008":74120,"_21483":124973,"_5":14766,"_28195":124916,"_3064":124974},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3608":74141,"_31008":74120,"_21483":124976,"_5":14766,"_28195":124916,"_3064":124977},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3608":74142,"_31008":74120,"_21483":124979,"_5":14766,"_28195":124916,"_3064":124980},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3608":74143,"_31008":74120,"_21483":124982,"_5":14766,"_28195":124916,"_3064":124983},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3608":74144,"_31008":74120,"_21483":124985,"_5":14766,"_28195":124916,"_3064":124986},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3608":74145,"_31008":74120,"_21483":124988,"_5":14766,"_28195":124920,"_3064":124989},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3608":74146,"_31008":74120,"_21483":124991,"_5":14766,"_28195":124920,"_3064":56134},[],{"_3608":74147,"_31008":74120,"_21483":124993,"_5":14766,"_28195":124920,"_3064":124994},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3608":74148,"_31008":74120,"_21483":124996,"_5":14766,"_28195":124920,"_3064":124997},[],"**Icon** y **Tags**: clasificación opcional.",{"_3608":74149,"_31008":74120,"_21483":124999,"_5":14766,"_28195":124920,"_3064":125000},[],"Confirma el registro.",{"_3608":74150,"_31008":74120,"_21483":125002,"_5":14766,"_28195":124924,"_3064":125003},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3608":74151,"_31008":74120,"_21483":125005,"_5":14766,"_28195":124924,"_3064":125006},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3608":74152,"_31008":74120,"_21483":125008,"_5":14766,"_28195":124928,"_3064":125009},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3608":74153,"_31008":74120,"_21483":125011,"_5":14766,"_28195":124928,"_3064":125012},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3608":74154,"_31008":74120,"_21483":125014,"_5":14766,"_28195":124932,"_3064":125015},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3608":74155,"_31008":74120,"_21483":125017,"_5":14766,"_28195":124932,"_3064":125018},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3608":74156,"_31008":74120,"_21483":125020,"_5":14766,"_28195":124936,"_3064":124872},[],{"_3608":74157,"_31008":74120,"_21483":125022,"_5":14766,"_28195":124936,"_3064":125023},[],"Resultado",{"_3608":74158,"_31008":74120,"_21483":125025,"_5":14766,"_28195":124936,"_3064":124154},[],{"_3608":74159,"_31008":74120,"_21483":125027,"_5":14766,"_28195":124936,"_3064":125028},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3608":74160,"_31008":74120,"_21483":125030,"_5":14766,"_28195":124936,"_3064":125031},[],"Identidad actual",{"_3608":74161,"_31008":74120,"_21483":125033,"_5":14766,"_28195":124936,"_3064":125034},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3608":74162,"_31008":74120,"_21483":125036,"_5":14766,"_28195":124936,"_3064":125037},[],"Historial",{"_3608":74163,"_31008":74120,"_21483":125039,"_5":14766,"_28195":124936,"_3064":125040},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3608":74164,"_31008":74120,"_21483":125042,"_5":14766,"_28195":124936,"_3064":125043},[],"Clave y certificado",{"_3608":74165,"_31008":74120,"_21483":125045,"_5":14766,"_28195":124936,"_3064":125046},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3608":74166,"_31008":74120,"_21483":125048,"_5":14766,"_28195":124939,"_3064":125049},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3608":74167,"_31008":74120,"_21483":125051,"_5":14766,"_28195":124939,"_3064":125052},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3608":74168,"_31008":74120,"_21483":125054,"_5":14766,"_28195":124939,"_3064":125055},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3608":74169,"_31008":74120,"_21483":125057,"_5":14766,"_28195":124939,"_3064":125058},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3608":74170,"_31008":74120,"_21483":125060,"_5":14766,"_28195":124943,"_3064":125061},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3608":74171,"_31008":74120,"_21483":125063,"_5":14766,"_28195":124943,"_3064":125064},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3608":74172,"_31008":74120,"_21483":125066,"_5":14766,"_28195":124943,"_3064":125067},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3608":74173,"_31008":74173,"_5":15126,"_3064":125069,"_31366":125070,"_21483":125071,"_28195":74173},"Plataforma Lamassu IoT",[50713,121232],[],{"_3608":74174,"_31008":74173,"_21483":125073,"_5":14766,"_28195":74173,"_3064":125074},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3608":74175,"_31008":74173,"_5":31363,"_21483":125076,"_28195":125077,"_3064":124569},[],"/docs/pr-preview/pr-72/es/platform/overview#empieza-aquí",{"_3608":74176,"_31008":74173,"_5":31363,"_21483":125079,"_28195":125080,"_3064":125081},[],"/docs/pr-preview/pr-72/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3608":74177,"_31008":74173,"_5":31363,"_21483":125083,"_28195":125084,"_3064":125085},[],"/docs/pr-preview/pr-72/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3608":74178,"_31008":74173,"_5":31363,"_21483":125087,"_28195":125088,"_3064":125089},[],"/docs/pr-preview/pr-72/es/platform/overview#capacidades-principales","Capacidades principales",{"_3608":74179,"_31008":74173,"_5":31363,"_21483":125091,"_28195":125092,"_3064":125093},[],"/docs/pr-preview/pr-72/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3608":74180,"_31008":74173,"_5":31363,"_21483":125095,"_28195":125096,"_3064":125097},[],"/docs/pr-preview/pr-72/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3608":74181,"_31008":74173,"_5":31363,"_21483":125099,"_28195":125100,"_3064":125101},[],"/docs/pr-preview/pr-72/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3608":74182,"_31008":74173,"_5":31363,"_21483":125103,"_28195":125104,"_3064":125105},[],"/docs/pr-preview/pr-72/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3608":74183,"_31008":74173,"_5":31363,"_21483":125107,"_28195":125108,"_3064":125109},[],"/docs/pr-preview/pr-72/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3608":74184,"_31008":74173,"_5":31363,"_21483":125111,"_28195":125112,"_3064":125113},[],"/docs/pr-preview/pr-72/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3608":74185,"_31008":74173,"_5":31363,"_21483":125115,"_28195":125116,"_3064":125117},[],"/docs/pr-preview/pr-72/es/platform/overview#referencia-operativa","Referencia operativa",{"_3608":74186,"_31008":74173,"_21483":125119,"_5":14766,"_28195":74173,"_3064":125120},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3608":74187,"_31008":74173,"_21483":125122,"_5":14766,"_28195":125077,"_3064":125123},[],"Elige el resultado que necesitas obtener:",{"_3608":74188,"_31008":74173,"_21483":125125,"_5":14766,"_28195":125077,"_3064":125126},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3608":74189,"_31008":74173,"_21483":125128,"_5":14766,"_28195":125077,"_3064":125129},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3608":74190,"_31008":74173,"_21483":125131,"_5":14766,"_28195":125077,"_3064":125132},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3608":74191,"_31008":74173,"_21483":125134,"_5":14766,"_28195":125080,"_3064":125135},[],"Bloque",{"_3608":74192,"_31008":74173,"_21483":125137,"_5":14766,"_28195":125080,"_3064":125138},[],"Qué gestionas",{"_3608":74193,"_31008":74173,"_21483":125140,"_5":14766,"_28195":125080,"_3064":125141},[],"Punto de entrada",{"_3608":74194,"_31008":74173,"_21483":125143,"_5":14766,"_28195":125080,"_3064":56287},[],{"_3608":74195,"_31008":74173,"_21483":125145,"_5":14766,"_28195":125080,"_3064":125146},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3608":74196,"_31008":74173,"_21483":125148,"_5":14766,"_28195":125080,"_3064":125149},[],"Visión general de PKI",{"_3608":74197,"_31008":74173,"_21483":125151,"_5":14766,"_28195":125080,"_3064":56296},[],{"_3608":74198,"_31008":74173,"_21483":125153,"_5":14766,"_28195":125080,"_3064":125154},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3608":74199,"_31008":74173,"_21483":125156,"_5":14766,"_28195":125080,"_3064":125157},[],"Visión general de IoT Fleets",{"_3608":74200,"_31008":74173,"_21483":125159,"_5":14766,"_28195":125080,"_3064":125160},[],"**Administración**",{"_3608":74201,"_31008":74173,"_21483":125162,"_5":14766,"_28195":125080,"_3064":125163},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3608":74202,"_31008":74173,"_21483":125165,"_5":14766,"_28195":125080,"_3064":121234},[],{"_3608":74203,"_31008":74173,"_21483":125167,"_5":14766,"_28195":125080,"_3064":125168},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3608":74204,"_31008":74173,"_21483":125170,"_5":14766,"_28195":125084,"_3064":125171},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3608":74205,"_31008":74173,"_21483":125173,"_5":14766,"_28195":125084,"_3064":125174},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3608":74206,"_31008":74173,"_21483":125176,"_5":14766,"_28195":125084,"_3064":125177},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3608":74207,"_31008":74173,"_21483":125179,"_5":14766,"_28195":125084,"_3064":125180},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3608":74208,"_31008":74173,"_21483":125182,"_5":14766,"_28195":125084,"_3064":125183},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3608":74209,"_31008":74173,"_21483":125185,"_5":14766,"_28195":125084,"_3064":125186},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3608":74210,"_31008":74173,"_21483":125188,"_5":14766,"_28195":125092,"_3064":125189},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3608":74211,"_31008":74173,"_21483":125191,"_5":14766,"_28195":125096,"_3064":125192},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3608":74212,"_31008":74173,"_21483":125194,"_5":14766,"_28195":125100,"_3064":125195},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3608":74213,"_31008":74173,"_21483":125197,"_5":14766,"_28195":125104,"_3064":125198},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3608":74214,"_31008":74173,"_21483":125200,"_5":14766,"_28195":125108,"_3064":125201},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3608":74215,"_31008":74173,"_21483":125203,"_5":14766,"_28195":125112,"_3064":125204},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3608":74216,"_31008":74173,"_21483":125206,"_5":14766,"_28195":125116,"_3064":124662},[],{"_3608":74217,"_31008":74173,"_21483":125208,"_5":14766,"_28195":125116,"_3064":125209},[],"Qué prepara o comprueba",{"_3608":74218,"_31008":74173,"_21483":125211,"_5":14766,"_28195":125116,"_3064":124665},[],{"_3608":74219,"_31008":74173,"_21483":125213,"_5":14766,"_28195":125116,"_3064":125214},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3608":74220,"_31008":74173,"_21483":125216,"_5":14766,"_28195":125116,"_3064":125217},[],"Administrador de la flota",{"_3608":74221,"_31008":74173,"_21483":125219,"_5":14766,"_28195":125116,"_3064":125220},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3608":74222,"_31008":74173,"_21483":125222,"_5":14766,"_28195":125116,"_3064":124677},[],{"_3608":74223,"_31008":74173,"_21483":125224,"_5":14766,"_28195":125116,"_3064":125225},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3608":74224,"_31008":74173,"_21483":125227,"_5":14766,"_28195":125116,"_3064":124683},[],{"_3608":74225,"_31008":74173,"_21483":125229,"_5":14766,"_28195":125116,"_3064":125230},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3608":74226,"_31008":74173,"_21483":125232,"_5":14766,"_28195":125116,"_3064":125233},[],"Operador de infraestructura",{"_3608":74227,"_31008":74173,"_21483":125235,"_5":14766,"_28195":125116,"_3064":125236},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3608":74228,"_31008":74173,"_21483":125238,"_5":14766,"_28195":125116,"_3064":125239},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3608":74229,"_31008":74229,"_5":15126,"_3064":125241,"_31366":125242,"_21483":125244,"_28195":74229},"Jerarquía y rotación de CAs",[50713,121232,56388,125243],"Claves, autoridades y certificados",[],{"_3608":74230,"_31008":74229,"_21483":125246,"_5":14766,"_28195":74229,"_3064":125247},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3608":74231,"_31008":74229,"_5":31363,"_21483":125249,"_28195":125250,"_3064":125251},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3608":74232,"_31008":74229,"_5":31363,"_21483":125253,"_28195":125254,"_3064":125255},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3608":74233,"_31008":74229,"_5":31363,"_21483":125257,"_28195":125258,"_3064":125259},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3608":74234,"_31008":74229,"_5":31363,"_21483":125261,"_28195":125262,"_3064":125263},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3608":74235,"_31008":74229,"_5":31363,"_21483":125265,"_28195":125266,"_3064":125267},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3608":74236,"_31008":74229,"_5":31363,"_21483":125269,"_28195":125270,"_3064":125271},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3608":74237,"_31008":74229,"_5":31363,"_21483":125273,"_28195":125274,"_3064":125275},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3608":74238,"_31008":74229,"_5":31363,"_21483":125277,"_28195":125278,"_3064":125279},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3608":74239,"_31008":74229,"_5":31363,"_21483":125281,"_28195":125282,"_3064":125283},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3608":74240,"_31008":74229,"_5":31363,"_21483":125285,"_28195":125286,"_3064":125287},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3608":74241,"_31008":74229,"_5":31363,"_21483":125289,"_28195":125290,"_3064":125291},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3608":74242,"_31008":74229,"_5":31363,"_21483":125293,"_28195":125294,"_3064":125295},[],"/docs/pr-preview/pr-72/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3608":74243,"_31008":74229,"_21483":125297,"_5":14766,"_28195":74229,"_3064":125298},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3608":74244,"_31008":74229,"_21483":125300,"_5":14766,"_28195":74229,"_3064":125301},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3608":74245,"_31008":74229,"_21483":125303,"_5":14766,"_28195":125250,"_3064":125304},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3608":74246,"_31008":74229,"_21483":125306,"_5":14766,"_28195":125250,"_3064":125307},[],"entorno, como producción y preproducción;",{"_3608":74247,"_31008":74229,"_21483":125309,"_5":14766,"_28195":125250,"_3064":125310},[],"propietario o equipo operador;",{"_3608":74248,"_31008":74229,"_21483":125312,"_5":14766,"_28195":125250,"_3064":125313},[],"familia de dispositivos o proceso de fabricación;",{"_3608":74249,"_31008":74229,"_21483":125315,"_5":14766,"_28195":125250,"_3064":125316},[],"región o requisito regulatorio;",{"_3608":74250,"_31008":74229,"_21483":125318,"_5":14766,"_28195":125250,"_3064":125319},[],"motor criptográfico o política de clave;",{"_3608":74251,"_31008":74229,"_21483":125321,"_5":14766,"_28195":125250,"_3064":125322},[],"ventana de mantenimiento y ritmo de renovación.",{"_3608":74252,"_31008":74229,"_21483":125324,"_5":14766,"_28195":125250,"_3064":125325},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3608":74253,"_31008":74229,"_21483":125327,"_5":14766,"_28195":125250,"_3064":125328},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3608":74254,"_31008":74229,"_21483":125330,"_5":14766,"_28195":125254,"_3064":125331},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3608":74255,"_31008":74229,"_21483":125333,"_5":14766,"_28195":125254,"_3064":125334},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3608":74256,"_31008":74229,"_21483":125336,"_5":14766,"_28195":125254,"_3064":125337},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3608":74257,"_31008":74229,"_21483":125339,"_5":14766,"_28195":125254,"_3064":125340},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3608":74258,"_31008":74229,"_21483":125342,"_5":14766,"_28195":125258,"_3064":125343},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3608":74259,"_31008":74229,"_21483":125345,"_5":14766,"_28195":125258,"_3064":125346},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3608":74260,"_31008":74229,"_21483":125348,"_5":14766,"_28195":125258,"_3064":125349},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3608":74261,"_31008":74229,"_21483":125351,"_5":14766,"_28195":125258,"_3064":125352},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3608":74262,"_31008":74229,"_21483":125354,"_5":14766,"_28195":125266,"_3064":125355},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3608":74263,"_31008":74229,"_21483":125357,"_5":14766,"_28195":125270,"_3064":125358},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3608":74264,"_31008":74229,"_21483":125360,"_5":14766,"_28195":125274,"_3064":125361},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3608":74265,"_31008":74229,"_21483":125363,"_5":14766,"_28195":125278,"_3064":125364},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3608":74266,"_31008":74229,"_21483":125366,"_5":14766,"_28195":125282,"_3064":125367},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3608":74267,"_31008":74229,"_21483":125369,"_5":14766,"_28195":125286,"_3064":125370},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3608":74268,"_31008":74229,"_21483":125372,"_5":14766,"_28195":125290,"_3064":125373},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3608":74269,"_31008":74229,"_21483":125375,"_5":14766,"_28195":125290,"_3064":125376},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3608":74270,"_31008":74229,"_21483":125378,"_5":14766,"_28195":125290,"_3064":125379},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3608":74271,"_31008":74229,"_21483":125381,"_5":14766,"_28195":125290,"_3064":125382},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3608":74272,"_31008":74229,"_21483":125384,"_5":14766,"_28195":125294,"_3064":125385},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3608":74273,"_31008":74229,"_21483":125387,"_5":14766,"_28195":125294,"_3064":125388},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3608":74274,"_31008":74229,"_21483":125390,"_5":14766,"_28195":125294,"_3064":125391},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3608":74275,"_31008":74229,"_21483":125393,"_5":14766,"_28195":125294,"_3064":125394},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3608":74276,"_31008":74229,"_21483":125396,"_5":14766,"_28195":125294,"_3064":125397},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3608":74277,"_31008":74229,"_21483":125399,"_5":14766,"_28195":125294,"_3064":125400},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3608":74278,"_31008":74229,"_21483":125402,"_5":14766,"_28195":125294,"_3064":125403},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3608":74279,"_31008":74279,"_5":15126,"_3064":125405,"_31366":125406,"_21483":125407,"_28195":74279},"Autoridades de certificación",[50713,121232,56388,125243],[],{"_3608":74280,"_31008":74279,"_21483":125409,"_5":14766,"_28195":74279,"_3064":125410},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3608":74281,"_31008":74279,"_5":31363,"_21483":125412,"_28195":125413,"_3064":125414},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3608":74282,"_31008":74279,"_5":31363,"_21483":125416,"_28195":125417,"_3064":125418},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3608":74283,"_31008":74279,"_5":31363,"_21483":125420,"_28195":125421,"_3064":119766},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3608":74284,"_31008":74279,"_5":31363,"_21483":125423,"_28195":125424,"_3064":125425},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3608":74285,"_31008":74279,"_5":31363,"_21483":125427,"_28195":125428,"_3064":125429},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3608":74286,"_31008":74279,"_5":31363,"_21483":125431,"_28195":125432,"_3064":125433},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3608":74287,"_31008":74279,"_5":31363,"_21483":125435,"_28195":125436,"_3064":125437},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3608":74288,"_31008":74279,"_5":31363,"_21483":125439,"_28195":125440,"_3064":125441},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3608":74289,"_31008":74279,"_5":31363,"_21483":125443,"_28195":125444,"_3064":125445},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3608":74290,"_31008":74279,"_5":31363,"_21483":125447,"_28195":125448,"_3064":125449},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3608":74291,"_31008":74279,"_5":31363,"_21483":125451,"_28195":125452,"_3064":125453},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3608":74292,"_31008":74279,"_5":31363,"_21483":125455,"_28195":125456,"_3064":125457},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3608":74293,"_31008":74279,"_5":31363,"_21483":125459,"_28195":125460,"_3064":125461},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3608":74294,"_31008":74279,"_5":31363,"_21483":125463,"_28195":125464,"_3064":125465},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3608":74295,"_31008":74279,"_5":31363,"_21483":125467,"_28195":125468,"_3064":125469},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3608":74296,"_31008":74279,"_5":31363,"_21483":125471,"_28195":125472,"_3064":125473},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3608":74297,"_31008":74279,"_5":31363,"_21483":125475,"_28195":125476,"_3064":125477},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3608":74298,"_31008":74279,"_5":31363,"_21483":125479,"_28195":125480,"_3064":125481},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3608":74299,"_31008":74279,"_5":31363,"_21483":125483,"_28195":125484,"_3064":125485},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3608":74300,"_31008":74279,"_5":31363,"_21483":125487,"_28195":125488,"_3064":125489},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3608":74301,"_31008":74279,"_5":31363,"_21483":125491,"_28195":125492,"_3064":125493},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3608":74302,"_31008":74279,"_5":31363,"_21483":125495,"_28195":125496,"_3064":125497},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3608":74303,"_31008":74279,"_5":31363,"_21483":125499,"_28195":125500,"_3064":125501},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3608":74304,"_31008":74279,"_21483":125503,"_5":14766,"_28195":74279,"_3064":125504},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3608":74305,"_31008":74279,"_21483":125506,"_5":14766,"_28195":74279,"_3064":125507},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3608":74306,"_31008":74279,"_21483":125509,"_5":14766,"_28195":74279,"_3064":125510},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3608":74307,"_31008":74279,"_21483":125512,"_5":14766,"_28195":125413,"_3064":125513},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3608":74308,"_31008":74279,"_21483":125515,"_5":14766,"_28195":125413,"_3064":125516},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3608":74309,"_31008":74279,"_21483":125518,"_5":14766,"_28195":125413,"_3064":125519},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3608":74310,"_31008":74279,"_21483":125521,"_5":14766,"_28195":125413,"_3064":125522},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3608":74311,"_31008":74279,"_21483":125524,"_5":14766,"_28195":125413,"_3064":125525},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3608":74312,"_31008":74279,"_21483":125527,"_5":14766,"_28195":125421,"_3064":125528},[],"Decide si la CA será raíz o intermedia.",{"_3608":74313,"_31008":74279,"_21483":125530,"_5":14766,"_28195":125421,"_3064":125531},[],"Elige el motor que custodiará la clave.",{"_3608":74314,"_31008":74279,"_21483":125533,"_5":14766,"_28195":125421,"_3064":125534},[],"Define una validez superior a la de los certificados que emitirá.",{"_3608":74315,"_31008":74279,"_21483":125536,"_5":14766,"_28195":125421,"_3064":125537},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3608":74316,"_31008":74279,"_21483":125539,"_5":14766,"_28195":125424,"_3064":125540},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3608":74317,"_31008":74279,"_21483":125542,"_5":14766,"_28195":125428,"_3064":125543},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3608":74318,"_31008":74279,"_21483":125545,"_5":14766,"_28195":125428,"_3064":125546},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3608":74319,"_31008":74279,"_21483":125548,"_5":14766,"_28195":125432,"_3064":125549},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3608":74320,"_31008":74279,"_21483":125551,"_5":14766,"_28195":125436,"_3064":125552},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3608":74321,"_31008":74279,"_21483":125554,"_5":14766,"_28195":125436,"_3064":125555},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3608":74322,"_31008":74279,"_21483":125557,"_5":14766,"_28195":125436,"_3064":125558},[],"`ST`: estado o provincia.",{"_3608":74323,"_31008":74279,"_21483":125560,"_5":14766,"_28195":125436,"_3064":125561},[],"`L`: localidad.",{"_3608":74324,"_31008":74279,"_21483":125563,"_5":14766,"_28195":125436,"_3064":125564},[],"`O`: organización.",{"_3608":74325,"_31008":74279,"_21483":125566,"_5":14766,"_28195":125436,"_3064":125567},[],"`OU`: unidad organizativa.",{"_3608":74326,"_31008":74279,"_21483":125569,"_5":14766,"_28195":125436,"_3064":125570},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3608":74327,"_31008":74279,"_21483":125572,"_5":14766,"_28195":125440,"_3064":125573},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3608":74328,"_31008":74279,"_21483":125575,"_5":14766,"_28195":125440,"_3064":125576},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3608":74329,"_31008":74279,"_21483":125578,"_5":14766,"_28195":125444,"_3064":125579},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3608":74330,"_31008":74279,"_21483":125581,"_5":14766,"_28195":125444,"_3064":125582},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3608":74331,"_31008":74279,"_21483":125584,"_5":14766,"_28195":125448,"_3064":125585},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3608":74332,"_31008":74279,"_21483":125587,"_5":14766,"_28195":125448,"_3064":125588},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3608":74333,"_31008":74279,"_21483":125590,"_5":14766,"_28195":125452,"_3064":125591},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3608":74334,"_31008":74279,"_21483":125593,"_5":14766,"_28195":125452,"_3064":125594},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3608":74335,"_31008":74279,"_21483":125596,"_5":14766,"_28195":125452,"_3064":125597},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3608":74336,"_31008":74279,"_21483":125599,"_5":14766,"_28195":125456,"_3064":125600},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3608":74337,"_31008":74279,"_21483":125602,"_5":14766,"_28195":125460,"_3064":125603},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3608":74338,"_31008":74279,"_21483":125605,"_5":14766,"_28195":125460,"_3064":125606},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3608":74339,"_31008":74279,"_21483":125608,"_5":14766,"_28195":125464,"_3064":125609},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3608":74340,"_31008":74279,"_21483":125611,"_5":14766,"_28195":125468,"_3064":125612},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3608":74341,"_31008":74279,"_21483":125614,"_5":14766,"_28195":125468,"_3064":125615},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3608":74342,"_31008":74279,"_21483":125617,"_5":14766,"_28195":125472,"_3064":125618},[],"Abre una CA desde el inventario para consultar:",{"_3608":74343,"_31008":74279,"_21483":125620,"_5":14766,"_28195":125472,"_3064":125621},[],"Estado y periodo de validez.",{"_3608":74344,"_31008":74279,"_21483":125623,"_5":14766,"_28195":125472,"_3064":125624},[],"Certificado y cadena en formato PEM.",{"_3608":74345,"_31008":74279,"_21483":125626,"_5":14766,"_28195":125472,"_3064":125627},[],"Número de certificados activos, expirados y revocados.",{"_3608":74346,"_31008":74279,"_21483":125629,"_5":14766,"_28195":125472,"_3064":125630},[],"Certificados emitidos en **Issued Certificates**.",{"_3608":74347,"_31008":74279,"_21483":125632,"_5":14766,"_28195":125472,"_3064":125633},[],"CRL vinculada a la autoridad.",{"_3608":74348,"_31008":74279,"_21483":125635,"_5":14766,"_28195":125472,"_3064":125636},[],"Metadatos y motor criptográfico asociado.",{"_3608":74349,"_31008":74279,"_21483":125638,"_5":14766,"_28195":125472,"_3064":125639},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3608":74350,"_31008":74279,"_21483":125641,"_5":14766,"_28195":125476,"_3064":125642},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3608":74351,"_31008":74279,"_21483":125644,"_5":14766,"_28195":125476,"_3064":125645},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3608":74352,"_31008":74279,"_21483":125647,"_5":14766,"_28195":125476,"_3064":125648},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3608":74353,"_31008":74279,"_21483":125650,"_5":14766,"_28195":125476,"_3064":125651},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3608":74354,"_31008":74279,"_21483":125653,"_5":14766,"_28195":125476,"_3064":125654},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3608":74355,"_31008":74279,"_21483":125656,"_5":14766,"_28195":125476,"_3064":125657},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3608":74356,"_31008":74279,"_21483":125659,"_5":14766,"_28195":125480,"_3064":125660},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3608":74357,"_31008":74279,"_21483":125662,"_5":14766,"_28195":125484,"_3064":125663},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3608":74358,"_31008":74279,"_21483":125665,"_5":14766,"_28195":125488,"_3064":125666},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3608":74359,"_31008":74279,"_21483":125668,"_5":14766,"_28195":125492,"_3064":125669},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3608":74360,"_31008":74279,"_21483":125671,"_5":14766,"_28195":125496,"_3064":125672},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3608":74361,"_31008":74279,"_21483":125674,"_5":14766,"_28195":125500,"_3064":125675},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3608":74362,"_31008":74279,"_21483":125677,"_5":14766,"_28195":125500,"_3064":125678},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3608":74363,"_31008":74279,"_21483":125680,"_5":14766,"_28195":125500,"_3064":125681},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3608":74364,"_31008":74279,"_21483":125683,"_5":14766,"_28195":125500,"_3064":125684},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3608":74365,"_31008":74365,"_5":15126,"_3064":125686,"_31366":125687,"_21483":125688,"_28195":74365},"Perfiles de certificado",[50713,121232,56388,125243],[],{"_3608":74366,"_31008":74365,"_21483":125690,"_5":14766,"_28195":74365,"_3064":125691},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3608":74367,"_31008":74365,"_5":31363,"_21483":125693,"_28195":125694,"_3064":125695},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3608":74368,"_31008":74365,"_5":31363,"_21483":125697,"_28195":125698,"_3064":125699},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#validez","Validez",{"_3608":74369,"_31008":74365,"_5":31363,"_21483":125701,"_28195":125702,"_3064":125703},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3608":74370,"_31008":74365,"_5":31363,"_21483":125705,"_28195":125706,"_3064":125707},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3608":74371,"_31008":74365,"_5":31363,"_21483":125709,"_28195":125710,"_3064":125711},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3608":74372,"_31008":74365,"_5":31363,"_21483":125713,"_28195":125714,"_3064":125715},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3608":74373,"_31008":74365,"_5":31363,"_21483":125717,"_28195":125718,"_3064":125719},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3608":74374,"_31008":74365,"_5":31363,"_21483":125721,"_28195":125722,"_3064":125723},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3608":74375,"_31008":74365,"_5":31363,"_21483":125725,"_28195":125726,"_3064":125727},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3608":74376,"_31008":74365,"_5":31363,"_21483":125729,"_28195":125730,"_3064":125731},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3608":74377,"_31008":74365,"_5":31363,"_21483":125733,"_28195":125734,"_3064":125735},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3608":74378,"_31008":74365,"_5":31363,"_21483":125737,"_28195":125738,"_3064":125739},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3608":74379,"_31008":74365,"_5":31363,"_21483":125741,"_28195":125742,"_3064":125743},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3608":74380,"_31008":74365,"_5":31363,"_21483":125745,"_28195":125746,"_3064":125747},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3608":74381,"_31008":74365,"_5":31363,"_21483":125749,"_28195":125750,"_3064":125751},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3608":74382,"_31008":74365,"_5":31363,"_21483":125753,"_28195":125754,"_3064":125755},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3608":74383,"_31008":74365,"_21483":125757,"_5":14766,"_28195":74365,"_3064":125758},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3608":74384,"_31008":74365,"_21483":125760,"_5":14766,"_28195":74365,"_3064":125761},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3608":74385,"_31008":74365,"_21483":125763,"_5":14766,"_28195":125698,"_3064":125764},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3608":74386,"_31008":74365,"_21483":125766,"_5":14766,"_28195":125698,"_3064":125767},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3608":74387,"_31008":74365,"_21483":125769,"_5":14766,"_28195":125702,"_3064":125770},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3608":74388,"_31008":74365,"_21483":125772,"_5":14766,"_28195":125706,"_3064":125773},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3608":74389,"_31008":74365,"_21483":125775,"_5":14766,"_28195":125706,"_3064":125776},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3608":74390,"_31008":74365,"_21483":125778,"_5":14766,"_28195":125706,"_3064":125779},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3608":74391,"_31008":74365,"_21483":125781,"_5":14766,"_28195":125710,"_3064":125782},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3608":74392,"_31008":74365,"_21483":125784,"_5":14766,"_28195":125714,"_3064":125785},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3608":74393,"_31008":74365,"_21483":125787,"_5":14766,"_28195":125714,"_3064":125788},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3608":74394,"_31008":74365,"_21483":125790,"_5":14766,"_28195":125718,"_3064":125791},[],"La aplicación criptográfica puede:",{"_3608":74395,"_31008":74365,"_21483":125793,"_5":14766,"_28195":125718,"_3064":125794},[],"permitir o bloquear claves RSA;",{"_3608":74396,"_31008":74365,"_21483":125796,"_5":14766,"_28195":125718,"_3064":125797},[],"limitar los tamaños RSA admitidos;",{"_3608":74397,"_31008":74365,"_21483":125799,"_5":14766,"_28195":125718,"_3064":125800},[],"permitir o bloquear claves ECDSA;",{"_3608":74398,"_31008":74365,"_21483":125802,"_5":14766,"_28195":125718,"_3064":125803},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3608":74399,"_31008":74365,"_21483":125805,"_5":14766,"_28195":125718,"_3064":125806},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3608":74400,"_31008":74365,"_21483":125808,"_5":14766,"_28195":125722,"_3064":125809},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3608":74401,"_31008":74365,"_21483":125811,"_5":14766,"_28195":125722,"_3064":120992},[],{"_3608":74402,"_31008":74365,"_21483":125813,"_5":14766,"_28195":125722,"_3064":125814},[],"Primera opción",{"_3608":74403,"_31008":74365,"_21483":125816,"_5":14766,"_28195":125722,"_3064":125817},[],"Segunda opción",{"_3608":74404,"_31008":74365,"_21483":125819,"_5":14766,"_28195":125722,"_3064":125820},[],"Si no hay ninguna",{"_3608":74405,"_31008":74365,"_21483":125822,"_5":14766,"_28195":125722,"_3064":125823},[],"Firma directa con una CA",{"_3608":74406,"_31008":74365,"_21483":125825,"_5":14766,"_28195":125722,"_3064":125826},[],"`issuance_profile` incluido en la solicitud",{"_3608":74407,"_31008":74365,"_21483":125828,"_5":14766,"_28195":125722,"_3064":125829},[],"`issuance_profile_id` de la solicitud",{"_3608":74408,"_31008":74365,"_21483":125831,"_5":14766,"_28195":125722,"_3064":125832},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3608":74409,"_31008":74365,"_21483":125834,"_5":14766,"_28195":125722,"_3064":125835},[],"Emisión mediante DMS",{"_3608":74410,"_31008":74365,"_21483":125837,"_5":14766,"_28195":125722,"_3064":56984},[],{"_3608":74411,"_31008":74365,"_21483":125839,"_5":14766,"_28195":125722,"_3064":125840},[],"`settings.issuance_profile` incluido en el DMS",{"_3608":74412,"_31008":74365,"_21483":125842,"_5":14766,"_28195":125722,"_3064":125843},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3608":74413,"_31008":74365,"_21483":125845,"_5":14766,"_28195":125722,"_3064":125846},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3608":74414,"_31008":74365,"_21483":125848,"_5":14766,"_28195":125722,"_3064":125849},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3608":74415,"_31008":74365,"_21483":125851,"_5":14766,"_28195":125730,"_3064":125852},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3608":74416,"_31008":74365,"_21483":125854,"_5":14766,"_28195":125734,"_3064":125855},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3608":74417,"_31008":74365,"_21483":125857,"_5":14766,"_28195":125738,"_3064":125858},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3608":74418,"_31008":74365,"_21483":125860,"_5":14766,"_28195":125742,"_3064":125861},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3608":74419,"_31008":74365,"_21483":125863,"_5":14766,"_28195":125746,"_3064":125864},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3608":74420,"_31008":74365,"_21483":125866,"_5":14766,"_28195":125746,"_3064":125867},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3608":74421,"_31008":74365,"_21483":125869,"_5":14766,"_28195":125750,"_3064":125870},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3608":74422,"_31008":74365,"_21483":125872,"_5":14766,"_28195":125750,"_3064":125873},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3608":74423,"_31008":74365,"_21483":125875,"_5":14766,"_28195":125750,"_3064":125876},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3608":74424,"_31008":74365,"_21483":125878,"_5":14766,"_28195":125750,"_3064":125879},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3608":74425,"_31008":74365,"_21483":125881,"_5":14766,"_28195":125754,"_3064":125882},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3608":74426,"_31008":74365,"_21483":125884,"_5":14766,"_28195":125754,"_3064":125885},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3608":74427,"_31008":74427,"_5":15126,"_3064":125887,"_31366":125888,"_21483":125890,"_28195":74427},"Validación de certificados",[50713,121232,56388,125889],"Validación",[],{"_3608":74428,"_31008":74427,"_21483":125892,"_5":14766,"_28195":74427,"_3064":125893},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3608":74429,"_31008":74427,"_5":31363,"_21483":125895,"_28195":125896,"_3064":125897},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3608":74430,"_31008":74427,"_5":31363,"_21483":125899,"_28195":125900,"_3064":125901},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3608":74431,"_31008":74427,"_5":31363,"_21483":125903,"_28195":125904,"_3064":125905},[],"/docs/pr-preview/pr-72/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3608":74432,"_31008":74427,"_21483":125907,"_5":14766,"_28195":74427,"_3064":125908},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3608":74433,"_31008":74427,"_21483":125910,"_5":14766,"_28195":125896,"_3064":125911},[],"Verifica estos criterios juntos:",{"_3608":74434,"_31008":74427,"_21483":125913,"_5":14766,"_28195":125896,"_3064":124872},[],{"_3608":74435,"_31008":74427,"_21483":125915,"_5":14766,"_28195":125896,"_3064":125916},[],"Resultado necesario",{"_3608":74436,"_31008":74427,"_21483":125918,"_5":14766,"_28195":125896,"_3064":125919},[],"Cadena y firma",{"_3608":74437,"_31008":74427,"_21483":125921,"_5":14766,"_28195":125896,"_3064":125922},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3608":74438,"_31008":74427,"_21483":125924,"_5":14766,"_28195":125896,"_3064":125925},[],"Fechas",{"_3608":74439,"_31008":74427,"_21483":125927,"_5":14766,"_28195":125896,"_3064":125928},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3608":74440,"_31008":74427,"_21483":125930,"_5":14766,"_28195":125896,"_3064":120902},[],{"_3608":74441,"_31008":74427,"_21483":125932,"_5":14766,"_28195":125896,"_3064":125933},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3608":74442,"_31008":74427,"_21483":125935,"_5":14766,"_28195":125896,"_3064":125936},[],"Uso",{"_3608":74443,"_31008":74427,"_21483":125938,"_5":14766,"_28195":125896,"_3064":125939},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3608":74444,"_31008":74427,"_21483":125941,"_5":14766,"_28195":125896,"_3064":125942},[],"Revocación",{"_3608":74445,"_31008":74427,"_21483":125944,"_5":14766,"_28195":125896,"_3064":125945},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3608":74446,"_31008":74427,"_21483":125947,"_5":14766,"_28195":125896,"_3064":125948},[],"Autorización",{"_3608":74447,"_31008":74427,"_21483":125950,"_5":14766,"_28195":125896,"_3064":125951},[],"La aplicación permite la acción a esa identidad.",{"_3608":74448,"_31008":74427,"_21483":125953,"_5":14766,"_28195":125896,"_3064":125954},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3608":74449,"_31008":74427,"_21483":125956,"_5":14766,"_28195":125900,"_3064":125957},[],"Mecanismo",{"_3608":74450,"_31008":74427,"_21483":125959,"_5":14766,"_28195":125900,"_3064":125960},[],"Cuándo utilizarlo",{"_3608":74451,"_31008":74427,"_21483":125962,"_5":14766,"_28195":125900,"_3064":125963},[],"Qué debes mantener",{"_3608":74452,"_31008":74427,"_21483":125965,"_5":14766,"_28195":125900,"_3064":57112},[],{"_3608":74453,"_31008":74427,"_21483":125967,"_5":14766,"_28195":125900,"_3064":125968},[],"Consulta del estado de un certificado concreto.",{"_3608":74454,"_31008":74427,"_21483":125970,"_5":14766,"_28195":125900,"_3064":125971},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3608":74455,"_31008":74427,"_21483":125973,"_5":14766,"_28195":125900,"_3064":57121},[],{"_3608":74456,"_31008":74427,"_21483":125975,"_5":14766,"_28195":125900,"_3064":125976},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3608":74457,"_31008":74427,"_21483":125978,"_5":14766,"_28195":125900,"_3064":125979},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3608":74458,"_31008":74427,"_21483":125981,"_5":14766,"_28195":125900,"_3064":125982},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3608":74459,"_31008":74427,"_21483":125984,"_5":14766,"_28195":125900,"_3064":125985},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3608":74460,"_31008":74427,"_21483":125987,"_5":14766,"_28195":125904,"_3064":125988},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3608":74461,"_31008":74427,"_21483":125990,"_5":14766,"_28195":125904,"_3064":125991},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3608":74462,"_31008":74427,"_21483":125993,"_5":14766,"_28195":125904,"_3064":125994},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3608":74463,"_31008":74427,"_21483":125996,"_5":14766,"_28195":125904,"_3064":125997},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3608":74464,"_31008":74427,"_21483":125999,"_5":14766,"_28195":125904,"_3064":126000},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3608":74465,"_31008":74427,"_21483":126002,"_5":14766,"_28195":125904,"_3064":126003},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3608":74466,"_31008":74427,"_21483":126005,"_5":14766,"_28195":125904,"_3064":126006},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3608":74467,"_31008":74427,"_21483":126008,"_5":14766,"_28195":125904,"_3064":126009},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3608":74468,"_31008":74427,"_21483":126011,"_5":14766,"_28195":125904,"_3064":126012},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3608":74469,"_31008":74469,"_5":15126,"_3064":126014,"_31366":126015,"_21483":126016,"_28195":74469},"Certificados",[50713,121232,56388,125243],[],{"_3608":74470,"_31008":74469,"_21483":126018,"_5":14766,"_28195":74469,"_3064":126019},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3608":74471,"_31008":74469,"_5":31363,"_21483":126021,"_28195":126022,"_3064":126023},[],"/docs/pr-preview/pr-72/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3608":74472,"_31008":74469,"_5":31363,"_21483":126025,"_28195":126026,"_3064":126027},[],"/docs/pr-preview/pr-72/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3608":74473,"_31008":74469,"_5":31363,"_21483":126029,"_28195":126030,"_3064":126031},[],"/docs/pr-preview/pr-72/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3608":74474,"_31008":74469,"_5":31363,"_21483":126033,"_28195":126034,"_3064":126035},[],"/docs/pr-preview/pr-72/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3608":74475,"_31008":74469,"_5":31363,"_21483":126037,"_28195":126038,"_3064":126039},[],"/docs/pr-preview/pr-72/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3608":74476,"_31008":74469,"_5":31363,"_21483":126041,"_28195":126042,"_3064":126043},[],"/docs/pr-preview/pr-72/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3608":74477,"_31008":74469,"_5":31363,"_21483":126045,"_28195":126046,"_3064":126047},[],"/docs/pr-preview/pr-72/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3608":74478,"_31008":74469,"_5":31363,"_21483":126049,"_28195":126050,"_3064":126051},[],"/docs/pr-preview/pr-72/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3608":74479,"_31008":74469,"_5":31363,"_21483":126053,"_28195":126054,"_3064":126055},[],"/docs/pr-preview/pr-72/es/platform/pki/certificates#continúa","Continúa",{"_3608":74480,"_31008":74469,"_21483":126057,"_5":14766,"_28195":74469,"_3064":126058},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3608":74481,"_31008":74469,"_21483":126060,"_5":14766,"_28195":126022,"_3064":126061},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3608":74482,"_31008":74469,"_21483":126063,"_5":14766,"_28195":126022,"_3064":126064},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3608":74483,"_31008":74469,"_21483":126066,"_5":14766,"_28195":126022,"_3064":126067},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3608":74484,"_31008":74469,"_21483":126069,"_5":14766,"_28195":126022,"_3064":126070},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3608":74485,"_31008":74469,"_21483":126072,"_5":14766,"_28195":126022,"_3064":126073},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3608":74486,"_31008":74469,"_21483":126075,"_5":14766,"_28195":126022,"_3064":126076},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3608":74487,"_31008":74469,"_21483":126078,"_5":14766,"_28195":126022,"_3064":126079},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3608":74488,"_31008":74469,"_21483":126081,"_5":14766,"_28195":126026,"_3064":126082},[],"Descarga el PEM e inspecciónalo:",{"_3608":74489,"_31008":74469,"_21483":126084,"_5":14766,"_28195":126026,"_3064":126085},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3608":74490,"_31008":74469,"_21483":126087,"_5":14766,"_28195":126030,"_3064":126088},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3608":74491,"_31008":74469,"_21483":126090,"_5":14766,"_28195":126030,"_3064":126091},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3608":74492,"_31008":74469,"_21483":126093,"_5":14766,"_28195":126030,"_3064":126094},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3608":74493,"_31008":74469,"_21483":126096,"_5":14766,"_28195":126030,"_3064":126097},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3608":74494,"_31008":74469,"_21483":126099,"_5":14766,"_28195":126030,"_3064":126100},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3608":74495,"_31008":74469,"_21483":126102,"_5":14766,"_28195":126030,"_3064":126103},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3608":74496,"_31008":74469,"_21483":126105,"_5":14766,"_28195":126030,"_3064":126106},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3608":74497,"_31008":74469,"_21483":126108,"_5":14766,"_28195":126034,"_3064":126109},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3608":74498,"_31008":74469,"_21483":126111,"_5":14766,"_28195":126038,"_3064":126112},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3608":74499,"_31008":74469,"_21483":126114,"_5":14766,"_28195":126042,"_3064":126115},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3608":74500,"_31008":74469,"_21483":126117,"_5":14766,"_28195":126046,"_3064":126118},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3608":74501,"_31008":74469,"_21483":126120,"_5":14766,"_28195":126046,"_3064":126121},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3608":74502,"_31008":74469,"_21483":126123,"_5":14766,"_28195":126046,"_3064":126124},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3608":74503,"_31008":74469,"_21483":126126,"_5":14766,"_28195":126050,"_3064":126127},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3608":74504,"_31008":74469,"_21483":126129,"_5":14766,"_28195":126050,"_3064":126130},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3608":74505,"_31008":74469,"_21483":126132,"_5":14766,"_28195":126050,"_3064":126133},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3608":74506,"_31008":74469,"_21483":126135,"_5":14766,"_28195":126054,"_3064":126136},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3608":74507,"_31008":74469,"_21483":126138,"_5":14766,"_28195":126054,"_3064":126139},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3608":74508,"_31008":74508,"_5":15126,"_3064":126141,"_31366":126142,"_21483":126144,"_28195":74508},"Ciclo de vida de un certificado",[50713,121232,56388,126143],"Conceptos",[],{"_3608":74509,"_31008":74508,"_21483":126146,"_5":14766,"_28195":74508,"_3064":126147},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3608":74510,"_31008":74508,"_5":31363,"_21483":126149,"_28195":126150,"_3064":126151},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3608":74511,"_31008":74508,"_5":31363,"_21483":126153,"_28195":126154,"_3064":126155},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3608":74512,"_31008":74508,"_5":31363,"_21483":126157,"_28195":126158,"_3064":126159},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3608":74513,"_31008":74508,"_5":31363,"_21483":126161,"_28195":126162,"_3064":126163},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3608":74514,"_31008":74508,"_5":31363,"_21483":126165,"_28195":126166,"_3064":126167},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3608":74515,"_31008":74508,"_5":31363,"_21483":126169,"_28195":126170,"_3064":126171},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3608":74516,"_31008":74508,"_5":31363,"_21483":126173,"_28195":126174,"_3064":123866},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3608":74517,"_31008":74508,"_5":31363,"_21483":126176,"_28195":126177,"_3064":126178},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3608":74518,"_31008":74508,"_5":31363,"_21483":126180,"_28195":126181,"_3064":126182},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3608":74519,"_31008":74508,"_5":31363,"_21483":126184,"_28195":126185,"_3064":126186},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3608":74520,"_31008":74508,"_21483":126188,"_5":14766,"_28195":74508,"_3064":126189},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3608":74521,"_31008":74508,"_21483":126191,"_5":14766,"_28195":126154,"_3064":126192},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3608":74522,"_31008":74508,"_21483":126194,"_5":14766,"_28195":126158,"_3064":126195},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3608":74523,"_31008":74508,"_21483":126197,"_5":14766,"_28195":126162,"_3064":126198},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3608":74524,"_31008":74508,"_21483":126200,"_5":14766,"_28195":126166,"_3064":126201},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3608":74525,"_31008":74508,"_21483":126203,"_5":14766,"_28195":126170,"_3064":126204},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3608":74526,"_31008":74508,"_21483":126206,"_5":14766,"_28195":126174,"_3064":126207},[],"Lamassu persiste cuatro estados X.509:",{"_3608":74527,"_31008":74508,"_21483":126209,"_5":14766,"_28195":126174,"_3064":126210},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3608":74528,"_31008":74508,"_21483":126212,"_5":14766,"_28195":126174,"_3064":126213},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3608":74529,"_31008":74508,"_21483":126215,"_5":14766,"_28195":126174,"_3064":126216},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3608":74530,"_31008":74508,"_21483":126218,"_5":14766,"_28195":126174,"_3064":126219},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3608":74531,"_31008":74508,"_21483":126221,"_5":14766,"_28195":126174,"_3064":126222},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3608":74532,"_31008":74508,"_21483":126224,"_5":14766,"_28195":126177,"_3064":126225},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3608":74533,"_31008":74508,"_21483":126227,"_5":14766,"_28195":126177,"_3064":126228},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3608":74534,"_31008":74508,"_21483":126230,"_5":14766,"_28195":126177,"_3064":126231},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3608":74535,"_31008":74508,"_21483":126233,"_5":14766,"_28195":126181,"_3064":126234},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3608":74536,"_31008":74508,"_21483":126236,"_5":14766,"_28195":126181,"_3064":126237},[],"Antes de confirmar:",{"_3608":74537,"_31008":74508,"_21483":126239,"_5":14766,"_28195":126181,"_3064":126240},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3608":74538,"_31008":74508,"_21483":126242,"_5":14766,"_28195":126181,"_3064":126243},[],"Distribuye la nueva cadena de confianza.",{"_3608":74539,"_31008":74508,"_21483":126245,"_5":14766,"_28195":126181,"_3064":126246},[],"Reemite las identidades necesarias.",{"_3608":74540,"_31008":74508,"_21483":126248,"_5":14766,"_28195":126181,"_3064":126249},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3608":74541,"_31008":74508,"_21483":126251,"_5":14766,"_28195":126181,"_3064":126252},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3608":74542,"_31008":74508,"_21483":126254,"_5":14766,"_28195":126181,"_3064":126255},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3608":74543,"_31008":74508,"_21483":126257,"_5":14766,"_28195":126185,"_3064":126258},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3608":74544,"_31008":74508,"_21483":126260,"_5":14766,"_28195":126185,"_3064":126261},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3608":74545,"_31008":74508,"_21483":126263,"_5":14766,"_28195":126185,"_3064":126264},[],"Cambios de estado y razones de revocación.",{"_3608":74546,"_31008":74508,"_21483":126266,"_5":14766,"_28195":126185,"_3064":126267},[],"Publicación y vigencia de OCSP y CRLs.",{"_3608":74547,"_31008":74508,"_21483":126269,"_5":14766,"_28195":126185,"_3064":126270},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3608":74548,"_31008":74508,"_21483":126272,"_5":14766,"_28195":126185,"_3064":126273},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3608":74549,"_31008":74549,"_5":15126,"_3064":126275,"_31366":126276,"_21483":126277,"_28195":74549},"Modelo de confianza",[50713,121232,56388,126143],[],{"_3608":74550,"_31008":74549,"_21483":126279,"_5":14766,"_28195":74549,"_3064":126280},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3608":74551,"_31008":74549,"_5":31363,"_21483":126282,"_28195":126283,"_3064":126284},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3608":74552,"_31008":74549,"_5":31363,"_21483":126286,"_28195":126287,"_3064":126288},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3608":74553,"_31008":74549,"_5":31363,"_21483":126290,"_28195":126291,"_3064":126292},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3608":74554,"_31008":74549,"_5":31363,"_21483":126294,"_28195":126295,"_3064":126296},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3608":74555,"_31008":74549,"_5":31363,"_21483":126298,"_28195":126299,"_3064":126300},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3608":74556,"_31008":74549,"_5":31363,"_21483":126302,"_28195":126303,"_3064":126304},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3608":74557,"_31008":74549,"_5":31363,"_21483":126306,"_28195":126307,"_3064":126308},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3608":74558,"_31008":74549,"_5":31363,"_21483":126310,"_28195":126311,"_3064":126312},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3608":74559,"_31008":74549,"_5":31363,"_21483":126314,"_28195":126315,"_3064":126316},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3608":74560,"_31008":74549,"_5":31363,"_21483":126318,"_28195":126319,"_3064":126320},[],"/docs/pr-preview/pr-72/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3608":74561,"_31008":74549,"_21483":126322,"_5":14766,"_28195":74549,"_3064":126323},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3608":74562,"_31008":74549,"_21483":126325,"_5":14766,"_28195":126287,"_3064":126326},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3608":74563,"_31008":74549,"_21483":126328,"_5":14766,"_28195":126291,"_3064":126329},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3608":74564,"_31008":74549,"_21483":126331,"_5":14766,"_28195":126295,"_3064":126332},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3608":74565,"_31008":74549,"_21483":126334,"_5":14766,"_28195":126299,"_3064":126335},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3608":74566,"_31008":74549,"_21483":126337,"_5":14766,"_28195":126303,"_3064":126338},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3608":74567,"_31008":74549,"_21483":126340,"_5":14766,"_28195":126303,"_3064":126341},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3608":74568,"_31008":74549,"_21483":126343,"_5":14766,"_28195":126303,"_3064":126344},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3608":74569,"_31008":74549,"_21483":126346,"_5":14766,"_28195":126303,"_3064":126347},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3608":74570,"_31008":74549,"_21483":126349,"_5":14766,"_28195":126303,"_3064":126350},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3608":74571,"_31008":74549,"_21483":126352,"_5":14766,"_28195":126303,"_3064":126353},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3608":74572,"_31008":74549,"_21483":126355,"_5":14766,"_28195":126307,"_3064":126356},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3608":74573,"_31008":74549,"_21483":126358,"_5":14766,"_28195":126307,"_3064":126359},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3608":74574,"_31008":74549,"_21483":126361,"_5":14766,"_28195":126307,"_3064":126362},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3608":74575,"_31008":74549,"_21483":126364,"_5":14766,"_28195":126307,"_3064":126365},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3608":74576,"_31008":74549,"_21483":126367,"_5":14766,"_28195":126307,"_3064":126368},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3608":74577,"_31008":74549,"_21483":126370,"_5":14766,"_28195":126311,"_3064":126371},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3608":74578,"_31008":74549,"_21483":126373,"_5":14766,"_28195":126311,"_3064":126374},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3608":74579,"_31008":74549,"_21483":126376,"_5":14766,"_28195":126311,"_3064":126377},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3608":74580,"_31008":74549,"_21483":126379,"_5":14766,"_28195":126311,"_3064":126380},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3608":74581,"_31008":74549,"_21483":126382,"_5":14766,"_28195":126311,"_3064":126383},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3608":74582,"_31008":74549,"_21483":126385,"_5":14766,"_28195":126311,"_3064":126386},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3608":74583,"_31008":74549,"_21483":126388,"_5":14766,"_28195":126311,"_3064":126389},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3608":74584,"_31008":74549,"_21483":126391,"_5":14766,"_28195":126315,"_3064":126392},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3608":74585,"_31008":74549,"_21483":126394,"_5":14766,"_28195":126319,"_3064":126395},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3608":74586,"_31008":74549,"_21483":126397,"_5":14766,"_28195":126319,"_3064":126398},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3608":74587,"_31008":74549,"_21483":126400,"_5":14766,"_28195":126319,"_3064":126401},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3608":74588,"_31008":74549,"_21483":126403,"_5":14766,"_28195":126319,"_3064":126404},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3608":74589,"_31008":74549,"_21483":126406,"_5":14766,"_28195":126319,"_3064":126407},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3608":74590,"_31008":74549,"_21483":126409,"_5":14766,"_28195":126319,"_3064":126410},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3608":74591,"_31008":74549,"_21483":126412,"_5":14766,"_28195":126319,"_3064":126413},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3608":74592,"_31008":74592,"_5":15126,"_3064":126415,"_31366":126416,"_21483":126417,"_28195":74592},"Listas de revocación (CRL)",[50713,121232,56388,125889],[],{"_3608":74593,"_31008":74592,"_21483":126419,"_5":14766,"_28195":74592,"_3064":126420},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3608":74594,"_31008":74592,"_5":31363,"_21483":126422,"_28195":126423,"_3064":126424},[],"/docs/pr-preview/pr-72/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3608":74595,"_31008":74592,"_5":31363,"_21483":126426,"_28195":126427,"_3064":126428},[],"/docs/pr-preview/pr-72/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3608":74596,"_31008":74592,"_5":31363,"_21483":126430,"_28195":126431,"_3064":126432},[],"/docs/pr-preview/pr-72/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3608":74597,"_31008":74592,"_5":31363,"_21483":126434,"_28195":126435,"_3064":126436},[],"/docs/pr-preview/pr-72/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3608":74598,"_31008":74592,"_5":31363,"_21483":126438,"_28195":126439,"_3064":126440},[],"/docs/pr-preview/pr-72/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3608":74599,"_31008":74592,"_5":31363,"_21483":126442,"_28195":126443,"_3064":126444},[],"/docs/pr-preview/pr-72/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3608":74600,"_31008":74592,"_5":31363,"_21483":126446,"_28195":126447,"_3064":126448},[],"/docs/pr-preview/pr-72/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3608":74601,"_31008":74592,"_5":31363,"_21483":126450,"_28195":126451,"_3064":126452},[],"/docs/pr-preview/pr-72/es/platform/pki/crl#referencias","Referencias",{"_3608":74602,"_31008":74592,"_21483":126454,"_5":14766,"_28195":74592,"_3064":126455},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3608":74603,"_31008":74592,"_21483":126457,"_5":14766,"_28195":126423,"_3064":126458},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3608":74604,"_31008":74592,"_21483":126460,"_5":14766,"_28195":126423,"_3064":126461},[],"Campo",{"_3608":74605,"_31008":74592,"_21483":126463,"_5":14766,"_28195":126423,"_3064":122906},[],{"_3608":74606,"_31008":74592,"_21483":126465,"_5":14766,"_28195":126423,"_3064":52345},[],{"_3608":74607,"_31008":74592,"_21483":126467,"_5":14766,"_28195":126423,"_3064":126468},[],"ID de la CA a la que pertenecen los ajustes.",{"_3608":74608,"_31008":74592,"_21483":126470,"_5":14766,"_28195":126423,"_3064":57620},[],{"_3608":74609,"_31008":74592,"_21483":126472,"_5":14766,"_28195":126423,"_3064":126473},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3608":74610,"_31008":74592,"_21483":126475,"_5":14766,"_28195":126423,"_3064":57626},[],{"_3608":74611,"_31008":74592,"_21483":126477,"_5":14766,"_28195":126423,"_3064":126478},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3608":74612,"_31008":74592,"_21483":126480,"_5":14766,"_28195":126423,"_3064":57632},[],{"_3608":74613,"_31008":74592,"_21483":126482,"_5":14766,"_28195":126423,"_3064":126483},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3608":74614,"_31008":74592,"_21483":126485,"_5":14766,"_28195":126423,"_3064":126486},[],"Campo de `crl_options`",{"_3608":74615,"_31008":74592,"_21483":126488,"_5":14766,"_28195":126423,"_3064":122906},[],{"_3608":74616,"_31008":74592,"_21483":126490,"_5":14766,"_28195":126423,"_3064":126491},[],"Valor inicial",{"_3608":74617,"_31008":74592,"_21483":126493,"_5":14766,"_28195":126423,"_3064":57646},[],{"_3608":74618,"_31008":74592,"_21483":126495,"_5":14766,"_28195":126423,"_3064":126496},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3608":74619,"_31008":74592,"_21483":126498,"_5":14766,"_28195":126423,"_3064":126499},[],"7 días.",{"_3608":74620,"_31008":74592,"_21483":126501,"_5":14766,"_28195":126423,"_3064":57655},[],{"_3608":74621,"_31008":74592,"_21483":126503,"_5":14766,"_28195":126423,"_3064":126504},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3608":74622,"_31008":74592,"_21483":126506,"_5":14766,"_28195":126423,"_3064":126507},[],"6 días y 23 horas.",{"_3608":74623,"_31008":74592,"_21483":126509,"_5":14766,"_28195":126423,"_3064":57664},[],{"_3608":74624,"_31008":74592,"_21483":126511,"_5":14766,"_28195":126423,"_3064":126512},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3608":74625,"_31008":74592,"_21483":126514,"_5":14766,"_28195":126423,"_3064":57670},[],{"_3608":74626,"_31008":74592,"_21483":126516,"_5":14766,"_28195":126423,"_3064":57673},[],{"_3608":74627,"_31008":74592,"_21483":126518,"_5":14766,"_28195":126423,"_3064":126519},[],"Número de serie del certificado existente que firma la CRL.",{"_3608":74628,"_31008":74592,"_21483":126521,"_5":14766,"_28195":126423,"_3064":126522},[],"Número de serie del certificado actual de la CA.",{"_3608":74629,"_31008":74592,"_21483":126524,"_5":14766,"_28195":126423,"_3064":126525},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3608":74630,"_31008":74592,"_21483":126527,"_5":14766,"_28195":126423,"_3064":126528},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3608":74631,"_31008":74592,"_21483":126530,"_5":14766,"_28195":126423,"_3064":126531},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3608":74632,"_31008":74592,"_21483":126533,"_5":14766,"_28195":126423,"_3064":126534},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3608":74633,"_31008":74592,"_21483":126536,"_5":14766,"_28195":126423,"_3064":126537},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3608":74634,"_31008":74592,"_21483":126539,"_5":14766,"_28195":126423,"_3064":126540},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3608":74635,"_31008":74592,"_21483":126542,"_5":14766,"_28195":126423,"_3064":126543},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3608":74636,"_31008":74592,"_21483":126545,"_5":14766,"_28195":126423,"_3064":126546},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3608":74637,"_31008":74592,"_21483":126548,"_5":14766,"_28195":126423,"_3064":126549},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3608":74638,"_31008":74592,"_21483":126551,"_5":14766,"_28195":126423,"_3064":126552},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3608":74639,"_31008":74592,"_21483":126554,"_5":14766,"_28195":126423,"_3064":126555},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3608":74640,"_31008":74592,"_21483":126557,"_5":14766,"_28195":126427,"_3064":126558},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3608":74641,"_31008":74592,"_21483":126560,"_5":14766,"_28195":126427,"_3064":126561},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3608":74642,"_31008":74592,"_21483":126563,"_5":14766,"_28195":126427,"_3064":126564},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3608":74643,"_31008":74592,"_21483":126566,"_5":14766,"_28195":126427,"_3064":126567},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3608":74644,"_31008":74592,"_21483":126569,"_5":14766,"_28195":126431,"_3064":126570},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3608":74645,"_31008":74592,"_21483":126572,"_5":14766,"_28195":126431,"_3064":126573},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3608":74646,"_31008":74592,"_21483":126575,"_5":14766,"_28195":126431,"_3064":126576},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3608":74647,"_31008":74592,"_21483":126578,"_5":14766,"_28195":126431,"_3064":126579},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3608":74648,"_31008":74592,"_21483":126581,"_5":14766,"_28195":126431,"_3064":126582},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3608":74649,"_31008":74592,"_21483":126584,"_5":14766,"_28195":126431,"_3064":126585},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3608":74650,"_31008":74592,"_21483":126587,"_5":14766,"_28195":126431,"_3064":126588},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3608":74651,"_31008":74592,"_21483":126590,"_5":14766,"_28195":126431,"_3064":126591},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3608":74652,"_31008":74592,"_21483":126593,"_5":14766,"_28195":126431,"_3064":126594},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3608":74653,"_31008":74592,"_21483":126596,"_5":14766,"_28195":126435,"_3064":126597},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3608":74654,"_31008":74592,"_21483":126599,"_5":14766,"_28195":126435,"_3064":126600},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3608":74655,"_31008":74592,"_21483":126602,"_5":14766,"_28195":126439,"_3064":126603},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3608":74656,"_31008":74592,"_21483":126605,"_5":14766,"_28195":126439,"_3064":126606},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3608":74657,"_31008":74592,"_21483":126608,"_5":14766,"_28195":126439,"_3064":126609},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3608":74658,"_31008":74592,"_21483":126611,"_5":14766,"_28195":126439,"_3064":126612},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3608":74659,"_31008":74592,"_21483":126614,"_5":14766,"_28195":126439,"_3064":126615},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3608":74660,"_31008":74592,"_21483":126617,"_5":14766,"_28195":126443,"_3064":126618},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3608":74661,"_31008":74592,"_21483":126620,"_5":14766,"_28195":126443,"_3064":123095},[],{"_3608":74662,"_31008":74592,"_21483":126622,"_5":14766,"_28195":126443,"_3064":126623},[],"Path relativo",{"_3608":74663,"_31008":74592,"_21483":126625,"_5":14766,"_28195":126443,"_3064":120992},[],{"_3608":74664,"_31008":74592,"_21483":126627,"_5":14766,"_28195":126443,"_3064":57785},[],{"_3608":74665,"_31008":74592,"_21483":126629,"_5":14766,"_28195":126443,"_3064":57788},[],{"_3608":74666,"_31008":74592,"_21483":126631,"_5":14766,"_28195":126443,"_3064":126632},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3608":74667,"_31008":74592,"_21483":126634,"_5":14766,"_28195":126443,"_3064":57785},[],{"_3608":74668,"_31008":74592,"_21483":126636,"_5":14766,"_28195":126443,"_3064":57796},[],{"_3608":74669,"_31008":74592,"_21483":126638,"_5":14766,"_28195":126443,"_3064":126639},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3608":74670,"_31008":74592,"_21483":126641,"_5":14766,"_28195":126443,"_3064":57802},[],{"_3608":74671,"_31008":74592,"_21483":126643,"_5":14766,"_28195":126443,"_3064":57796},[],{"_3608":74672,"_31008":74592,"_21483":126645,"_5":14766,"_28195":126443,"_3064":126646},[],"Sustituir la configuración de CRL de una CA.",{"_3608":74673,"_31008":74592,"_21483":126648,"_5":14766,"_28195":126443,"_3064":57810},[],{"_3608":74674,"_31008":74592,"_21483":126650,"_5":14766,"_28195":126443,"_3064":57796},[],{"_3608":74675,"_31008":74592,"_21483":126652,"_5":14766,"_28195":126443,"_3064":126653},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3608":74676,"_31008":74592,"_21483":126655,"_5":14766,"_28195":126443,"_3064":126656},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3608":74677,"_31008":74592,"_21483":126658,"_5":14766,"_28195":126443,"_3064":126659},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3608":74678,"_31008":74592,"_21483":126661,"_5":14766,"_28195":126443,"_3064":126662},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3608":74679,"_31008":74592,"_21483":126664,"_5":14766,"_28195":126447,"_3064":126665},[],"Síntoma",{"_3608":74680,"_31008":74592,"_21483":126667,"_5":14766,"_28195":126447,"_3064":126668},[],"Causa",{"_3608":74681,"_31008":74592,"_21483":126670,"_5":14766,"_28195":126447,"_3064":126671},[],"Acción",{"_3608":74682,"_31008":74592,"_21483":126673,"_5":14766,"_28195":126447,"_3064":126674},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3608":74683,"_31008":74592,"_21483":126676,"_5":14766,"_28195":126447,"_3064":126677},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3608":74684,"_31008":74592,"_21483":126679,"_5":14766,"_28195":126447,"_3064":126680},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3608":74685,"_31008":74592,"_21483":126682,"_5":14766,"_28195":126447,"_3064":126683},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3608":74686,"_31008":74592,"_21483":126685,"_5":14766,"_28195":126447,"_3064":126686},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3608":74687,"_31008":74592,"_21483":126688,"_5":14766,"_28195":126447,"_3064":126689},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3608":74688,"_31008":74592,"_21483":126691,"_5":14766,"_28195":126447,"_3064":126692},[],"`PUT` devuelve 400.",{"_3608":74689,"_31008":74592,"_21483":126694,"_5":14766,"_28195":126447,"_3064":126695},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3608":74690,"_31008":74592,"_21483":126697,"_5":14766,"_28195":126447,"_3064":126698},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3608":74691,"_31008":74592,"_21483":126700,"_5":14766,"_28195":126447,"_3064":126701},[],"`PUT` devuelve 404.",{"_3608":74692,"_31008":74592,"_21483":126703,"_5":14766,"_28195":126447,"_3064":126704},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3608":74693,"_31008":74592,"_21483":126706,"_5":14766,"_28195":126447,"_3064":126707},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3608":74694,"_31008":74592,"_21483":126709,"_5":14766,"_28195":126447,"_3064":126710},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3608":74695,"_31008":74592,"_21483":126712,"_5":14766,"_28195":126447,"_3064":126713},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3608":74696,"_31008":74592,"_21483":126715,"_5":14766,"_28195":126447,"_3064":126716},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3608":74697,"_31008":74592,"_21483":126718,"_5":14766,"_28195":126447,"_3064":126719},[],"La CRL no cambia tras revocar un certificado.",{"_3608":74698,"_31008":74592,"_21483":126721,"_5":14766,"_28195":126447,"_3064":126722},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3608":74699,"_31008":74592,"_21483":126724,"_5":14766,"_28195":126447,"_3064":126725},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3608":74700,"_31008":74592,"_21483":126727,"_5":14766,"_28195":126447,"_3064":126728},[],"Un verificador rechaza la CRL por el emisor.",{"_3608":74701,"_31008":74592,"_21483":126730,"_5":14766,"_28195":126447,"_3064":126731},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3608":74702,"_31008":74592,"_21483":126733,"_5":14766,"_28195":126447,"_3064":126734},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3608":74703,"_31008":74592,"_21483":126736,"_5":14766,"_28195":126451,"_3064":126737},[],"RFC 5280: perfil X.509 y CRL.",{"_3608":74704,"_31008":74592,"_21483":126739,"_5":14766,"_28195":126451,"_3064":57902},[],{"_3608":74705,"_31008":74592,"_21483":126741,"_5":14766,"_28195":126451,"_3064":57905},[],{"_3608":74706,"_31008":74592,"_21483":126743,"_5":14766,"_28195":126451,"_3064":126744},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3608":74707,"_31008":74592,"_21483":126746,"_5":14766,"_28195":126451,"_3064":126747},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3608":74708,"_31008":74708,"_5":15126,"_3064":126749,"_31366":126750,"_21483":126751,"_28195":74708},"Claves y motores criptográficos",[50713,121232,56388,125243],[],{"_3608":74709,"_31008":74708,"_21483":126753,"_5":14766,"_28195":74708,"_3064":126754},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3608":74710,"_31008":74708,"_5":31363,"_21483":126756,"_28195":126757,"_3064":126758},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3608":74711,"_31008":74708,"_5":31363,"_21483":126760,"_28195":126761,"_3064":126762},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3608":74712,"_31008":74708,"_5":31363,"_21483":126764,"_28195":126765,"_3064":57930},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#file-system",{"_3608":74713,"_31008":74708,"_5":31363,"_21483":126767,"_28195":126768,"_3064":57934},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#hashicorp-vault",{"_3608":74714,"_31008":74708,"_5":31363,"_21483":126770,"_28195":126771,"_3064":57938},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#aws-secrets-manager",{"_3608":74715,"_31008":74708,"_5":31363,"_21483":126773,"_28195":126774,"_3064":57942},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#aws-kms",{"_3608":74716,"_31008":74708,"_5":31363,"_21483":126776,"_28195":126777,"_3064":57946},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#pkcs11",{"_3608":74717,"_31008":74708,"_5":31363,"_21483":126779,"_28195":126780,"_3064":57950},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#azure-key-vault",{"_3608":74718,"_31008":74708,"_5":31363,"_21483":126782,"_28195":126783,"_3064":126784},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3608":74719,"_31008":74708,"_5":31363,"_21483":126786,"_28195":126787,"_3064":126788},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3608":74720,"_31008":74708,"_5":31363,"_21483":126790,"_28195":126791,"_3064":126792},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3608":74721,"_31008":74708,"_5":31363,"_21483":126794,"_28195":126795,"_3064":126796},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3608":74722,"_31008":74708,"_5":31363,"_21483":126798,"_28195":126799,"_3064":126800},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3608":74723,"_31008":74708,"_5":31363,"_21483":126802,"_28195":126803,"_3064":126804},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3608":74724,"_31008":74708,"_5":31363,"_21483":126806,"_28195":126807,"_3064":126808},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3608":74725,"_31008":74708,"_5":31363,"_21483":126810,"_28195":126811,"_3064":57982},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#sign",{"_3608":74726,"_31008":74708,"_5":31363,"_21483":126813,"_28195":126814,"_3064":57986},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#verify",{"_3608":74727,"_31008":74708,"_5":31363,"_21483":126816,"_28195":126817,"_3064":126818},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3608":74728,"_31008":74708,"_5":31363,"_21483":126820,"_28195":126821,"_3064":126822},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3608":74729,"_31008":74708,"_5":31363,"_21483":126824,"_28195":126825,"_3064":126826},[],"/docs/pr-preview/pr-72/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3608":74730,"_31008":74708,"_21483":126828,"_5":14766,"_28195":74708,"_3064":126829},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3608":74731,"_31008":74708,"_21483":126831,"_5":14766,"_28195":74708,"_3064":126832},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3608":74732,"_31008":74708,"_21483":126834,"_5":14766,"_28195":126757,"_3064":126835},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3608":74733,"_31008":74708,"_21483":126837,"_5":14766,"_28195":126757,"_3064":126838},[],"En la práctica, permite:",{"_3608":74734,"_31008":74708,"_21483":126840,"_5":14766,"_28195":126757,"_3064":126841},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3608":74735,"_31008":74708,"_21483":126843,"_5":14766,"_28195":126757,"_3064":126844},[],"Importar claves creadas externamente.",{"_3608":74736,"_31008":74708,"_21483":126846,"_5":14766,"_28195":126757,"_3064":126847},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3608":74737,"_31008":74708,"_21483":126849,"_5":14766,"_28195":126757,"_3064":126850},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3608":74738,"_31008":74708,"_21483":126852,"_5":14766,"_28195":126761,"_3064":126853},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3608":74739,"_31008":74708,"_21483":126855,"_5":14766,"_28195":126761,"_3064":126856},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3608":74740,"_31008":74708,"_21483":126858,"_5":14766,"_28195":126761,"_3064":126859},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3608":74741,"_31008":74708,"_21483":126861,"_5":14766,"_28195":126765,"_3064":126862},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3608":74742,"_31008":74708,"_21483":126864,"_5":14766,"_28195":126768,"_3064":126865},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3608":74743,"_31008":74708,"_21483":126867,"_5":14766,"_28195":126768,"_3064":126868},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3608":74744,"_31008":74708,"_21483":126870,"_5":14766,"_28195":126771,"_3064":126871},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3608":74745,"_31008":74708,"_21483":126873,"_5":14766,"_28195":126774,"_3064":126874},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3608":74746,"_31008":74708,"_21483":126876,"_5":14766,"_28195":126777,"_3064":126877},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3608":74747,"_31008":74708,"_21483":126879,"_5":14766,"_28195":126780,"_3064":126880},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3608":74748,"_31008":74708,"_21483":126882,"_5":14766,"_28195":126780,"_3064":126883},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3608":74749,"_31008":74708,"_21483":126885,"_5":14766,"_28195":126780,"_3064":126886},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3608":74750,"_31008":74708,"_21483":126888,"_5":14766,"_28195":126780,"_3064":126889},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3608":74751,"_31008":74708,"_21483":126891,"_5":14766,"_28195":126783,"_3064":126892},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3608":74752,"_31008":74708,"_21483":126894,"_5":14766,"_28195":126783,"_3064":126895},[],"La tabla incluye los siguientes campos:",{"_3608":74753,"_31008":74708,"_21483":126897,"_5":14766,"_28195":126783,"_3064":126898},[],"**Name**: nombre descriptivo de la clave.",{"_3608":74754,"_31008":74708,"_21483":126900,"_5":14766,"_28195":126783,"_3064":126901},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3608":74755,"_31008":74708,"_21483":126903,"_5":14766,"_28195":126783,"_3064":126904},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3608":74756,"_31008":74708,"_21483":126906,"_5":14766,"_28195":126783,"_3064":126907},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3608":74757,"_31008":74708,"_21483":126909,"_5":14766,"_28195":126783,"_3064":126910},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3608":74758,"_31008":74708,"_21483":126912,"_5":14766,"_28195":126783,"_3064":126913},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3608":74759,"_31008":74708,"_21483":126915,"_5":14766,"_28195":126783,"_3064":126916},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3608":74760,"_31008":74708,"_21483":126918,"_5":14766,"_28195":126783,"_3064":126919},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3608":74761,"_31008":74708,"_21483":126921,"_5":14766,"_28195":126783,"_3064":126922},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3608":74762,"_31008":74708,"_21483":126924,"_5":14766,"_28195":126783,"_3064":126925},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3608":74763,"_31008":74708,"_21483":126927,"_5":14766,"_28195":126783,"_3064":126928},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3608":74764,"_31008":74708,"_21483":126930,"_5":14766,"_28195":126783,"_3064":126931},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3608":74765,"_31008":74708,"_21483":126933,"_5":14766,"_28195":126783,"_3064":126934},[],"**Delete Key** para eliminar la clave del sistema.",{"_3608":74766,"_31008":74708,"_21483":126936,"_5":14766,"_28195":126787,"_3064":126937},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3608":74767,"_31008":74708,"_21483":126939,"_5":14766,"_28195":126791,"_3064":126940},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3608":74768,"_31008":74708,"_21483":126942,"_5":14766,"_28195":126791,"_3064":126943},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3608":74769,"_31008":74708,"_21483":126945,"_5":14766,"_28195":126791,"_3064":126946},[],"**Key Name**: nombre único y descriptivo.",{"_3608":74770,"_31008":74708,"_21483":126948,"_5":14766,"_28195":126791,"_3064":126949},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3608":74771,"_31008":74708,"_21483":126951,"_5":14766,"_28195":126791,"_3064":126952},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3608":74772,"_31008":74708,"_21483":126954,"_5":14766,"_28195":126791,"_3064":126955},[],"**Tags**: metadatos para clasificar la clave.",{"_3608":74773,"_31008":74708,"_21483":126957,"_5":14766,"_28195":126791,"_3064":126958},[],"**Metadata**: información adicional para usos avanzados.",{"_3608":74774,"_31008":74708,"_21483":126960,"_5":14766,"_28195":126795,"_3064":126961},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3608":74775,"_31008":74708,"_21483":126963,"_5":14766,"_28195":126795,"_3064":126964},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3608":74776,"_31008":74708,"_21483":126966,"_5":14766,"_28195":126795,"_3064":126967},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3608":74777,"_31008":74708,"_21483":126969,"_5":14766,"_28195":126795,"_3064":126970},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3608":74778,"_31008":74708,"_21483":126972,"_5":14766,"_28195":126795,"_3064":126973},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3608":74779,"_31008":74708,"_21483":126975,"_5":14766,"_28195":126795,"_3064":126976},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3608":74780,"_31008":74708,"_21483":126978,"_5":14766,"_28195":126795,"_3064":126979},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3608":74781,"_31008":74708,"_21483":126981,"_5":14766,"_28195":126795,"_3064":126982},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3608":74782,"_31008":74708,"_21483":126984,"_5":14766,"_28195":126795,"_3064":126985},[],"**Metadata**: información adicional opcional.",{"_3608":74783,"_31008":74708,"_21483":126987,"_5":14766,"_28195":126795,"_3064":126988},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3608":74784,"_31008":74708,"_21483":126990,"_5":14766,"_28195":126795,"_3064":126991},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3608":74785,"_31008":74708,"_21483":126993,"_5":14766,"_28195":126799,"_3064":126994},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3608":74786,"_31008":74708,"_21483":126996,"_5":14766,"_28195":126803,"_3064":126997},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3608":74787,"_31008":74708,"_21483":126999,"_5":14766,"_28195":126803,"_3064":127000},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3608":74788,"_31008":74708,"_21483":127002,"_5":14766,"_28195":126803,"_3064":127003},[],"**Key Name**: nombre descriptivo.",{"_3608":74789,"_31008":74708,"_21483":127005,"_5":14766,"_28195":126803,"_3064":127006},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3608":74790,"_31008":74708,"_21483":127008,"_5":14766,"_28195":126803,"_3064":127009},[],"**Tags**: etiquetas asociadas.",{"_3608":74791,"_31008":74708,"_21483":127011,"_5":14766,"_28195":126803,"_3064":127012},[],"**Aliases**: nombres alternativos.",{"_3608":74792,"_31008":74708,"_21483":127014,"_5":14766,"_28195":126803,"_3064":127015},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3608":74793,"_31008":74708,"_21483":127017,"_5":14766,"_28195":126803,"_3064":127018},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3608":74794,"_31008":74708,"_21483":127020,"_5":14766,"_28195":126803,"_3064":127021},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3608":74795,"_31008":74708,"_21483":127023,"_5":14766,"_28195":126803,"_3064":127024},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3608":74796,"_31008":74708,"_21483":127026,"_5":14766,"_28195":126807,"_3064":127027},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3608":74797,"_31008":74708,"_21483":127029,"_5":14766,"_28195":126807,"_3064":127030},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3608":74798,"_31008":74708,"_21483":127032,"_5":14766,"_28195":126807,"_3064":127033},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3608":74799,"_31008":74708,"_21483":127035,"_5":14766,"_28195":126811,"_3064":127036},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3608":74800,"_31008":74708,"_21483":127038,"_5":14766,"_28195":126811,"_3064":127039},[],"Campos principales:",{"_3608":74801,"_31008":74708,"_21483":127041,"_5":14766,"_28195":126811,"_3064":127042},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3608":74802,"_31008":74708,"_21483":127044,"_5":14766,"_28195":126811,"_3064":127045},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3608":74803,"_31008":74708,"_21483":127047,"_5":14766,"_28195":126811,"_3064":127048},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3608":74804,"_31008":74708,"_21483":127050,"_5":14766,"_28195":126811,"_3064":127051},[],"**Message**: contenido que se va a firmar.",{"_3608":74805,"_31008":74708,"_21483":127053,"_5":14766,"_28195":126811,"_3064":127054},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3608":74806,"_31008":74708,"_21483":127056,"_5":14766,"_28195":126814,"_3064":127057},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3608":74807,"_31008":74708,"_21483":127059,"_5":14766,"_28195":126814,"_3064":127039},[],{"_3608":74808,"_31008":74708,"_21483":127061,"_5":14766,"_28195":126814,"_3064":127062},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3608":74809,"_31008":74708,"_21483":127064,"_5":14766,"_28195":126814,"_3064":127065},[],"**Message Type**: `Raw` o `Digest`.",{"_3608":74810,"_31008":74708,"_21483":127067,"_5":14766,"_28195":126814,"_3064":127068},[],"**Payload Encoding**: codificación del mensaje.",{"_3608":74811,"_31008":74708,"_21483":127070,"_5":14766,"_28195":126814,"_3064":127071},[],"**Message**: mensaje original o hash.",{"_3608":74812,"_31008":74708,"_21483":127073,"_5":14766,"_28195":126814,"_3064":127074},[],"**Signature**: firma que se desea comprobar.",{"_3608":74813,"_31008":74708,"_21483":127076,"_5":14766,"_28195":126814,"_3064":127077},[],"**Result**: indicador del resultado de la validación.",{"_3608":74814,"_31008":74708,"_21483":127079,"_5":14766,"_28195":126817,"_3064":127080},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3608":74815,"_31008":74708,"_21483":127082,"_5":14766,"_28195":126817,"_3064":127083},[],"Este flujo es útil para:",{"_3608":74816,"_31008":74708,"_21483":127085,"_5":14766,"_28195":126817,"_3064":127086},[],"Solicitar certificados a una CA externa.",{"_3608":74817,"_31008":74708,"_21483":127088,"_5":14766,"_28195":126817,"_3064":127089},[],"Renovar una identidad manteniendo la misma clave.",{"_3608":74818,"_31008":74708,"_21483":127091,"_5":14766,"_28195":126817,"_3064":127092},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3608":74819,"_31008":74708,"_21483":127094,"_5":14766,"_28195":126817,"_3064":127095},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3608":74820,"_31008":74708,"_21483":127097,"_5":14766,"_28195":126817,"_3064":127098},[],"**Organization (O)**: organización o empresa.",{"_3608":74821,"_31008":74708,"_21483":127100,"_5":14766,"_28195":126817,"_3064":127101},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3608":74822,"_31008":74708,"_21483":127103,"_5":14766,"_28195":126817,"_3064":127104},[],"**Country (C)**: código de país de dos letras.",{"_3608":74823,"_31008":74708,"_21483":127106,"_5":14766,"_28195":126817,"_3064":127107},[],"**State / Province (ST)**: estado o provincia.",{"_3608":74824,"_31008":74708,"_21483":127109,"_5":14766,"_28195":126817,"_3064":127110},[],"**Locality (L)**: ciudad o localidad.",{"_3608":74825,"_31008":74708,"_21483":127112,"_5":14766,"_28195":126817,"_3064":127113},[],"**Email Address**: correo de contacto.",{"_3608":74826,"_31008":74708,"_21483":127115,"_5":14766,"_28195":126817,"_3064":127116},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3608":74827,"_31008":74708,"_21483":127118,"_5":14766,"_28195":126817,"_3064":127119},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3608":74828,"_31008":74708,"_21483":127121,"_5":14766,"_28195":126821,"_3064":127122},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3608":74829,"_31008":74708,"_21483":127124,"_5":14766,"_28195":126821,"_3064":127125},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3608":74830,"_31008":74708,"_21483":127127,"_5":14766,"_28195":126825,"_3064":127128},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3608":74831,"_31008":74708,"_21483":127130,"_5":14766,"_28195":126825,"_3064":127131},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3608":74832,"_31008":74832,"_5":15126,"_3064":127133,"_31366":127134,"_21483":127135,"_28195":74832},"Validación online con OCSP",[50713,121232,56388,125889],[],{"_3608":74833,"_31008":74832,"_21483":127137,"_5":14766,"_28195":74832,"_3064":127138},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3608":74834,"_31008":74832,"_5":31363,"_21483":127140,"_28195":127141,"_3064":127142},[],"/docs/pr-preview/pr-72/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3608":74835,"_31008":74832,"_5":31363,"_21483":127144,"_28195":127145,"_3064":127146},[],"/docs/pr-preview/pr-72/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3608":74836,"_31008":74832,"_5":31363,"_21483":127148,"_28195":127149,"_3064":127150},[],"/docs/pr-preview/pr-72/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3608":74837,"_31008":74832,"_5":31363,"_21483":127152,"_28195":127153,"_3064":127154},[],"/docs/pr-preview/pr-72/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3608":74838,"_31008":74832,"_5":31363,"_21483":127156,"_28195":127157,"_3064":127158},[],"/docs/pr-preview/pr-72/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3608":74839,"_31008":74832,"_5":31363,"_21483":127160,"_28195":127161,"_3064":126452},[],"/docs/pr-preview/pr-72/es/platform/pki/ocsp#referencias",{"_3608":74840,"_31008":74832,"_21483":127163,"_5":14766,"_28195":74832,"_3064":127164},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3608":74841,"_31008":74832,"_21483":127166,"_5":14766,"_28195":127141,"_3064":127167},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3608":74842,"_31008":74832,"_21483":127169,"_5":14766,"_28195":127141,"_3064":127170},[],"Estado del registro",{"_3608":74843,"_31008":74832,"_21483":127172,"_5":14766,"_28195":127141,"_3064":127173},[],"Respuesta firmada",{"_3608":74844,"_31008":74832,"_21483":127175,"_5":14766,"_28195":127141,"_3064":55525},[],{"_3608":74845,"_31008":74832,"_21483":127177,"_5":14766,"_28195":127141,"_3064":58350},[],{"_3608":74846,"_31008":74832,"_21483":127179,"_5":14766,"_28195":127141,"_3064":55542},[],{"_3608":74847,"_31008":74832,"_21483":127181,"_5":14766,"_28195":127141,"_3064":127182},[],"`Revoked`, con razón y fecha de revocación.",{"_3608":74848,"_31008":74832,"_21483":127184,"_5":14766,"_28195":127141,"_3064":127185},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3608":74849,"_31008":74832,"_21483":127187,"_5":14766,"_28195":127141,"_3064":127188},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3608":74850,"_31008":74832,"_21483":127190,"_5":14766,"_28195":127141,"_3064":127191},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3608":74851,"_31008":74832,"_21483":127193,"_5":14766,"_28195":127141,"_3064":127194},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3608":74852,"_31008":74832,"_21483":127196,"_5":14766,"_28195":127141,"_3064":127197},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3608":74853,"_31008":74832,"_21483":127199,"_5":14766,"_28195":127145,"_3064":127200},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3608":74854,"_31008":74832,"_21483":127202,"_5":14766,"_28195":127145,"_3064":127203},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3608":74855,"_31008":74832,"_21483":127205,"_5":14766,"_28195":127149,"_3064":127206},[],"El servicio acepta:",{"_3608":74856,"_31008":74832,"_21483":127208,"_5":14766,"_28195":127149,"_3064":123095},[],{"_3608":74857,"_31008":74832,"_21483":127210,"_5":14766,"_28195":127149,"_3064":127211},[],"Ruta del servicio VA",{"_3608":74858,"_31008":74832,"_21483":127213,"_5":14766,"_28195":127149,"_3064":127214},[],"Formato",{"_3608":74859,"_31008":74832,"_21483":127216,"_5":14766,"_28195":127149,"_3064":58390},[],{"_3608":74860,"_31008":74832,"_21483":127218,"_5":14766,"_28195":127149,"_3064":58393},[],{"_3608":74861,"_31008":74832,"_21483":127220,"_5":14766,"_28195":127149,"_3064":127221},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3608":74862,"_31008":74832,"_21483":127223,"_5":14766,"_28195":127149,"_3064":57785},[],{"_3608":74863,"_31008":74832,"_21483":127225,"_5":14766,"_28195":127149,"_3064":58401},[],{"_3608":74864,"_31008":74832,"_21483":127227,"_5":14766,"_28195":127149,"_3064":127228},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3608":74865,"_31008":74832,"_21483":127230,"_5":14766,"_28195":127149,"_3064":127231},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3608":74866,"_31008":74832,"_21483":127233,"_5":14766,"_28195":127153,"_3064":127234},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3608":74867,"_31008":74832,"_21483":127236,"_5":14766,"_28195":127153,"_3064":127237},[],"Genera la solicitud:",{"_3608":74868,"_31008":74832,"_21483":127239,"_5":14766,"_28195":127153,"_3064":127240},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3608":74869,"_31008":74832,"_21483":127242,"_5":14766,"_28195":127153,"_3064":127243},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3608":74870,"_31008":74832,"_21483":127245,"_5":14766,"_28195":127153,"_3064":127246},[],"Verifica el DER recibido:",{"_3608":74871,"_31008":74832,"_21483":127248,"_5":14766,"_28195":127153,"_3064":127249},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3608":74872,"_31008":74832,"_21483":127251,"_5":14766,"_28195":127157,"_3064":127252},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3608":74873,"_31008":74832,"_21483":127254,"_5":14766,"_28195":127157,"_3064":127255},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3608":74874,"_31008":74832,"_21483":127257,"_5":14766,"_28195":127161,"_3064":58434},[],{"_3608":74875,"_31008":74832,"_21483":127259,"_5":14766,"_28195":127161,"_3064":58437},[],{"_3608":74876,"_31008":74832,"_21483":127261,"_5":14766,"_28195":127161,"_3064":127262},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3608":74877,"_31008":74832,"_21483":127264,"_5":14766,"_28195":127161,"_3064":126747},[],{"_3608":74878,"_31008":74878,"_5":15126,"_3064":56388,"_31366":127266,"_21483":127267,"_28195":74878},[50713,121232,56388],[],{"_3608":74879,"_31008":74878,"_21483":127269,"_5":14766,"_28195":74878,"_3064":127270},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3608":74880,"_31008":74878,"_5":31363,"_21483":127272,"_28195":127273,"_3064":124569},[],"/docs/pr-preview/pr-72/es/platform/pki/overview#empieza-aquí",{"_3608":74881,"_31008":74878,"_5":31363,"_21483":127275,"_28195":127276,"_3064":127277},[],"/docs/pr-preview/pr-72/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3608":74882,"_31008":74878,"_5":31363,"_21483":127279,"_28195":127280,"_3064":125089},[],"/docs/pr-preview/pr-72/es/platform/pki/overview#capacidades-principales",{"_3608":74883,"_31008":74878,"_5":31363,"_21483":127282,"_28195":127283,"_3064":125093},[],"/docs/pr-preview/pr-72/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3608":74884,"_31008":74878,"_5":31363,"_21483":127285,"_28195":127286,"_3064":125097},[],"/docs/pr-preview/pr-72/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3608":74885,"_31008":74878,"_5":31363,"_21483":127288,"_28195":127289,"_3064":125101},[],"/docs/pr-preview/pr-72/es/platform/pki/overview#emite-y-controla-certificados",{"_3608":74886,"_31008":74878,"_5":31363,"_21483":127291,"_28195":127292,"_3064":125109},[],"/docs/pr-preview/pr-72/es/platform/pki/overview#publica-el-estado-de-validación",{"_3608":74887,"_31008":74878,"_5":31363,"_21483":127294,"_28195":127295,"_3064":127296},[],"/docs/pr-preview/pr-72/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3608":74888,"_31008":74878,"_5":31363,"_21483":127298,"_28195":127299,"_3064":126055},[],"/docs/pr-preview/pr-72/es/platform/pki/overview#continúa",{"_3608":74889,"_31008":74878,"_21483":127301,"_5":14766,"_28195":74878,"_3064":127302},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3608":74890,"_31008":74878,"_21483":127304,"_5":14766,"_28195":127273,"_3064":127305},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3608":74891,"_31008":74878,"_21483":127307,"_5":14766,"_28195":127273,"_3064":127308},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3608":74892,"_31008":74878,"_21483":127310,"_5":14766,"_28195":127276,"_3064":127311},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3608":74893,"_31008":74878,"_21483":127313,"_5":14766,"_28195":127276,"_3064":127314},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3608":74894,"_31008":74878,"_21483":127316,"_5":14766,"_28195":127276,"_3064":127317},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3608":74895,"_31008":74878,"_21483":127319,"_5":14766,"_28195":127276,"_3064":127320},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3608":74896,"_31008":74878,"_21483":127322,"_5":14766,"_28195":127276,"_3064":127323},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3608":74897,"_31008":74878,"_21483":127325,"_5":14766,"_28195":127283,"_3064":127326},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3608":74898,"_31008":74878,"_21483":127328,"_5":14766,"_28195":127286,"_3064":127329},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3608":74899,"_31008":74878,"_21483":127331,"_5":14766,"_28195":127289,"_3064":127332},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3608":74900,"_31008":74878,"_21483":127334,"_5":14766,"_28195":127292,"_3064":127335},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3608":74901,"_31008":74878,"_21483":127337,"_5":14766,"_28195":127295,"_3064":127338},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3608":74902,"_31008":74878,"_21483":127340,"_5":14766,"_28195":127295,"_3064":127341},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3608":74903,"_31008":74878,"_21483":127343,"_5":14766,"_28195":127295,"_3064":127344},[],"su clave pública corresponda a la clave privada del cliente;",{"_3608":74904,"_31008":74878,"_21483":127346,"_5":14766,"_28195":127295,"_3064":127347},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3608":74905,"_31008":74878,"_21483":127349,"_5":14766,"_28195":127295,"_3064":127350},[],"sus fechas y usos permitan la operación;",{"_3608":74906,"_31008":74878,"_21483":127352,"_5":14766,"_28195":127295,"_3064":127353},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3608":74907,"_31008":74878,"_21483":127355,"_5":14766,"_28195":127295,"_3064":127356},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3608":74908,"_31008":74878,"_21483":127358,"_5":14766,"_28195":127299,"_3064":127359},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3608":74909,"_31008":74878,"_21483":127361,"_5":14766,"_28195":127299,"_3064":127362},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3608":74910,"_31008":74878,"_21483":127364,"_5":14766,"_28195":127299,"_3064":127365},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3608":74911,"_31008":74911,"_5":15126,"_3064":127367,"_31366":127368,"_21483":127369,"_28195":74911},"Crea tu primera CA",[50713,121232,56388,124693],[],{"_3608":74912,"_31008":74911,"_21483":127371,"_5":14766,"_28195":74911,"_3064":127372},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3608":74913,"_31008":74911,"_5":31363,"_21483":127374,"_28195":127375,"_3064":119766},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3608":74914,"_31008":74911,"_5":31363,"_21483":127377,"_28195":127378,"_3064":127379},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3608":74915,"_31008":74911,"_5":31363,"_21483":127381,"_28195":127382,"_3064":127383},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3608":74916,"_31008":74911,"_5":31363,"_21483":127385,"_28195":127386,"_3064":127387},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3608":74917,"_31008":74911,"_5":31363,"_21483":127389,"_28195":127390,"_3064":127391},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3608":74918,"_31008":74911,"_5":31363,"_21483":127393,"_28195":127394,"_3064":127395},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3608":74919,"_31008":74911,"_5":31363,"_21483":127397,"_28195":127398,"_3064":127399},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3608":74920,"_31008":74911,"_5":31363,"_21483":127401,"_28195":127402,"_3064":124940},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3608":74921,"_31008":74911,"_5":31363,"_21483":127404,"_28195":127405,"_3064":119790},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3608":74922,"_31008":74911,"_21483":127407,"_5":14766,"_28195":74911,"_3064":127408},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3608":74923,"_31008":74911,"_21483":127410,"_5":14766,"_28195":127375,"_3064":127411},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3608":74924,"_31008":74911,"_21483":127413,"_5":14766,"_28195":127375,"_3064":127414},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3608":74925,"_31008":74911,"_21483":127416,"_5":14766,"_28195":127375,"_3064":127417},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3608":74926,"_31008":74911,"_21483":127419,"_5":14766,"_28195":127375,"_3064":127420},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3608":74927,"_31008":74911,"_21483":127422,"_5":14766,"_28195":127378,"_3064":127423},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3608":74928,"_31008":74911,"_21483":127425,"_5":14766,"_28195":127378,"_3064":127426},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3608":74929,"_31008":74911,"_21483":127428,"_5":14766,"_28195":127382,"_3064":127429},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3608":74930,"_31008":74911,"_21483":127431,"_5":14766,"_28195":127382,"_3064":127432},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3608":74931,"_31008":74911,"_21483":127434,"_5":14766,"_28195":127386,"_3064":127435},[],"Selecciona **Root CA** y completa:",{"_3608":74932,"_31008":74911,"_21483":127437,"_5":14766,"_28195":127386,"_3064":58616},[],{"_3608":74933,"_31008":74911,"_21483":127439,"_5":14766,"_28195":127386,"_3064":127440},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3608":74934,"_31008":74911,"_21483":127442,"_5":14766,"_28195":127386,"_3064":127443},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3608":74935,"_31008":74911,"_21483":127445,"_5":14766,"_28195":127386,"_3064":127446},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3608":74936,"_31008":74911,"_21483":127448,"_5":14766,"_28195":127386,"_3064":127449},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3608":74937,"_31008":74911,"_21483":127451,"_5":14766,"_28195":127390,"_3064":127452},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3608":74938,"_31008":74911,"_21483":127454,"_5":14766,"_28195":127394,"_3064":127455},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3608":74939,"_31008":74911,"_21483":127457,"_5":14766,"_28195":127394,"_3064":127458},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3608":74940,"_31008":74911,"_21483":127460,"_5":14766,"_28195":127398,"_3064":127461},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3608":74941,"_31008":74911,"_21483":127463,"_5":14766,"_28195":127398,"_3064":127464},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3608":74942,"_31008":74911,"_21483":127466,"_5":14766,"_28195":127398,"_3064":127467},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3608":74943,"_31008":74911,"_21483":127469,"_5":14766,"_28195":127402,"_3064":127470},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3608":74944,"_31008":74911,"_21483":127472,"_5":14766,"_28195":127402,"_3064":127473},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3608":74945,"_31008":74911,"_21483":127475,"_5":14766,"_28195":127402,"_3064":127476},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3608":74946,"_31008":74911,"_21483":127478,"_5":14766,"_28195":127402,"_3064":127479},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3608":74947,"_31008":74911,"_21483":127481,"_5":14766,"_28195":127405,"_3064":127482},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3608":74948,"_31008":74948,"_5":15126,"_3064":127484,"_31366":127485,"_21483":127486,"_28195":74948},"Emite y verifica un certificado",[50713,121232,56388,124693],[],{"_3608":74949,"_31008":74948,"_21483":127488,"_5":14766,"_28195":74948,"_3064":127489},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3608":74950,"_31008":74948,"_5":31363,"_21483":127491,"_28195":127492,"_3064":119766},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3608":74951,"_31008":74948,"_5":31363,"_21483":127494,"_28195":127495,"_3064":127496},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3608":74952,"_31008":74948,"_5":31363,"_21483":127498,"_28195":127499,"_3064":127500},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3608":74953,"_31008":74948,"_5":31363,"_21483":127502,"_28195":127503,"_3064":127504},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3608":74954,"_31008":74948,"_5":31363,"_21483":127506,"_28195":127507,"_3064":127508},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3608":74955,"_31008":74948,"_5":31363,"_21483":127510,"_28195":127511,"_3064":127512},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3608":74956,"_31008":74948,"_5":31363,"_21483":127514,"_28195":127515,"_3064":127516},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3608":74957,"_31008":74948,"_5":31363,"_21483":127518,"_28195":127519,"_3064":127520},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3608":74958,"_31008":74948,"_5":31363,"_21483":127522,"_28195":127523,"_3064":127524},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3608":74959,"_31008":74948,"_5":31363,"_21483":127526,"_28195":127527,"_3064":127528},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3608":74960,"_31008":74948,"_5":31363,"_21483":127530,"_28195":127531,"_3064":124940},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3608":74961,"_31008":74948,"_5":31363,"_21483":127533,"_28195":127534,"_3064":119790},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3608":74962,"_31008":74948,"_21483":127536,"_5":14766,"_28195":74948,"_3064":127537},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3608":74963,"_31008":74948,"_21483":127539,"_5":14766,"_28195":127492,"_3064":127540},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3608":74964,"_31008":74948,"_21483":127542,"_5":14766,"_28195":127492,"_3064":127543},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3608":74965,"_31008":74948,"_21483":127545,"_5":14766,"_28195":127492,"_3064":127546},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3608":74966,"_31008":74948,"_21483":127548,"_5":14766,"_28195":127492,"_3064":127549},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3608":74967,"_31008":74948,"_21483":127551,"_5":14766,"_28195":127492,"_3064":127552},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3608":74968,"_31008":74948,"_21483":127554,"_5":14766,"_28195":127495,"_3064":127555},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3608":74969,"_31008":74948,"_21483":127557,"_5":14766,"_28195":127499,"_3064":127558},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3608":74970,"_31008":74948,"_21483":127560,"_5":14766,"_28195":127499,"_3064":127561},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3608":74971,"_31008":74948,"_21483":127563,"_5":14766,"_28195":127503,"_3064":127564},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3608":74972,"_31008":74948,"_21483":127566,"_5":14766,"_28195":127503,"_3064":127567},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3608":74973,"_31008":74948,"_21483":127569,"_5":14766,"_28195":127507,"_3064":127570},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3608":74974,"_31008":74948,"_21483":127572,"_5":14766,"_28195":127507,"_3064":127573},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3608":74975,"_31008":74948,"_21483":127575,"_5":14766,"_28195":127511,"_3064":127576},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3608":74976,"_31008":74948,"_21483":127578,"_5":14766,"_28195":127515,"_3064":127579},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3608":74977,"_31008":74948,"_21483":127581,"_5":14766,"_28195":127519,"_3064":127582},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3608":74978,"_31008":74948,"_21483":127584,"_5":14766,"_28195":127523,"_3064":127585},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3608":74979,"_31008":74948,"_21483":127587,"_5":14766,"_28195":127523,"_3064":127588},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3608":74980,"_31008":74948,"_21483":127590,"_5":14766,"_28195":127523,"_3064":127591},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3608":74981,"_31008":74948,"_21483":127593,"_5":14766,"_28195":127527,"_3064":127594},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3608":74982,"_31008":74948,"_21483":127596,"_5":14766,"_28195":127527,"_3064":127597},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3608":74983,"_31008":74948,"_21483":127599,"_5":14766,"_28195":127527,"_3064":127600},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3608":74984,"_31008":74948,"_21483":127602,"_5":14766,"_28195":127531,"_3064":125023},[],{"_3608":74985,"_31008":74948,"_21483":127604,"_5":14766,"_28195":127531,"_3064":123544},[],{"_3608":74986,"_31008":74948,"_21483":127606,"_5":14766,"_28195":127531,"_3064":127607},[],"La CA rechaza la emisión",{"_3608":74987,"_31008":74948,"_21483":127609,"_5":14766,"_28195":127531,"_3064":127610},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3608":74988,"_31008":74948,"_21483":127612,"_5":14766,"_28195":127531,"_3064":127613},[],"Sujeto o usos diferentes",{"_3608":74989,"_31008":74948,"_21483":127615,"_5":14766,"_28195":127531,"_3064":127616},[],"Perfil aplicado y valores solicitados.",{"_3608":74990,"_31008":74948,"_21483":127618,"_5":14766,"_28195":127531,"_3064":127619},[],"No se encuentra el emisor",{"_3608":74991,"_31008":74948,"_21483":127621,"_5":14766,"_28195":127531,"_3064":127622},[],"CA descargada y cadena intermedia necesaria.",{"_3608":74992,"_31008":74948,"_21483":127624,"_5":14766,"_28195":127531,"_3064":127625},[],"Falla la vigencia",{"_3608":74993,"_31008":74948,"_21483":127627,"_5":14766,"_28195":127531,"_3064":127628},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3608":74994,"_31008":74948,"_21483":127630,"_5":14766,"_28195":127531,"_3064":127631},[],"Los resúmenes de clave difieren",{"_3608":74995,"_31008":74948,"_21483":127633,"_5":14766,"_28195":127531,"_3064":127634},[],"Archivos de certificado y clave de la misma emisión.",{"_3608":74996,"_31008":74948,"_21483":127636,"_5":14766,"_28195":127531,"_3064":127637},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3608":74997,"_31008":74948,"_21483":127639,"_5":14766,"_28195":127534,"_3064":127640},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3608":74998,"_31008":74948,"_21483":127642,"_5":14766,"_28195":127534,"_3064":127643},[],"Gestionar certificados para inspección, estado y revocación.",{"_3608":74999,"_31008":74948,"_21483":127645,"_5":14766,"_28195":127534,"_3064":127646},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3608":75000,"_31008":74948,"_21483":127648,"_5":14766,"_28195":127534,"_3064":127649},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3608":75001,"_31008":74948,"_21483":127651,"_5":14766,"_28195":127534,"_3064":127652},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3608":75002,"_31008":75002,"_5":15126,"_3064":127654,"_31366":127655,"_21483":127656,"_28195":75002},"Primeros pasos de PKI",[50713,121232,56388,124693],[],{"_3608":75003,"_31008":75002,"_21483":127658,"_5":14766,"_28195":75002,"_3064":127659},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3608":75004,"_31008":75002,"_5":31363,"_21483":127661,"_28195":127662,"_3064":119766},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3608":75005,"_31008":75002,"_5":31363,"_21483":127664,"_28195":127665,"_3064":127666},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3608":75006,"_31008":75002,"_5":31363,"_21483":127668,"_28195":127669,"_3064":124875},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3608":75007,"_31008":75002,"_5":31363,"_21483":127671,"_28195":127672,"_3064":127673},[],"/docs/pr-preview/pr-72/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3608":75008,"_31008":75002,"_21483":127675,"_5":14766,"_28195":75002,"_3064":127676},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3608":75009,"_31008":75002,"_21483":127678,"_5":14766,"_28195":127662,"_3064":127679},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3608":75010,"_31008":75002,"_21483":127681,"_5":14766,"_28195":127662,"_3064":127682},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3608":75011,"_31008":75002,"_21483":127684,"_5":14766,"_28195":127662,"_3064":127685},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3608":75012,"_31008":75002,"_21483":127687,"_5":14766,"_28195":127662,"_3064":127688},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3608":75013,"_31008":75002,"_21483":127690,"_5":14766,"_28195":127662,"_3064":127691},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3608":75014,"_31008":75002,"_21483":127693,"_5":14766,"_28195":127665,"_3064":127694},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3608":75015,"_31008":75002,"_21483":127696,"_5":14766,"_28195":127665,"_3064":127697},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3608":75016,"_31008":75002,"_21483":127699,"_5":14766,"_28195":127665,"_3064":127700},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3608":75017,"_31008":75002,"_21483":127702,"_5":14766,"_28195":127665,"_3064":127703},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3608":75018,"_31008":75002,"_21483":127705,"_5":14766,"_28195":127669,"_3064":127706},[],"Archivo o recurso",{"_3608":75019,"_31008":75002,"_21483":127708,"_5":14766,"_28195":127669,"_3064":124872},[],{"_3608":75020,"_31008":75002,"_21483":127710,"_5":14766,"_28195":127669,"_3064":127711},[],"CA raíz activa y `ca.pem`",{"_3608":75021,"_31008":75002,"_21483":127713,"_5":14766,"_28195":127669,"_3064":127714},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3608":75022,"_31008":75002,"_21483":127716,"_5":14766,"_28195":127669,"_3064":127717},[],"Certificado final y `device.crt`",{"_3608":75023,"_31008":75002,"_21483":127719,"_5":14766,"_28195":127669,"_3064":127720},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3608":75024,"_31008":75002,"_21483":127722,"_5":14766,"_28195":127669,"_3064":127723},[],"Clave privada `device.key`",{"_3608":75025,"_31008":75002,"_21483":127725,"_5":14766,"_28195":127669,"_3064":127726},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3608":75026,"_31008":75002,"_21483":127728,"_5":14766,"_28195":127669,"_3064":127729},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3608":75027,"_31008":75002,"_21483":127731,"_5":14766,"_28195":127672,"_3064":127732},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3608":75028,"_31008":75002,"_21483":127734,"_5":14766,"_28195":127672,"_3064":127735},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3608":75029,"_31008":75002,"_21483":127737,"_5":14766,"_28195":127672,"_3064":127738},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3608":75030,"_31008":75030,"_5":15126,"_3064":127740,"_31366":127741,"_21483":127743,"_28195":75030},"Resolución de problemas PKI",[50713,121232,56388,127742],"Resolución de problemas",[],{"_3608":75031,"_31008":75030,"_21483":127745,"_5":14766,"_28195":75030,"_3064":127746},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3608":75032,"_31008":75030,"_5":31363,"_21483":127748,"_28195":127749,"_3064":127750},[],"/docs/pr-preview/pr-72/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3608":75033,"_31008":75030,"_5":31363,"_21483":127752,"_28195":127753,"_3064":127754},[],"/docs/pr-preview/pr-72/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3608":75034,"_31008":75030,"_5":31363,"_21483":127756,"_28195":127757,"_3064":127758},[],"/docs/pr-preview/pr-72/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3608":75035,"_31008":75030,"_21483":127760,"_5":14766,"_28195":75030,"_3064":127761},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3608":75036,"_31008":75030,"_21483":127763,"_5":14766,"_28195":75030,"_3064":127764},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3608":75037,"_31008":75030,"_21483":127766,"_5":14766,"_28195":127749,"_3064":124872},[],{"_3608":75038,"_31008":75030,"_21483":127768,"_5":14766,"_28195":127749,"_3064":123544},[],{"_3608":75039,"_31008":75030,"_21483":127770,"_5":14766,"_28195":127749,"_3064":119790},[],{"_3608":75040,"_31008":75030,"_21483":127772,"_5":14766,"_28195":127749,"_3064":55230},[],{"_3608":75041,"_31008":75030,"_21483":127774,"_5":14766,"_28195":127749,"_3064":127775},[],"Existe, está activa y sus fechas son utilizables.",{"_3608":75042,"_31008":75030,"_21483":127777,"_5":14766,"_28195":127749,"_3064":127778},[],"Autoridades.",{"_3608":75043,"_31008":75030,"_21483":127780,"_5":14766,"_28195":127749,"_3064":127781},[],"Clave",{"_3608":75044,"_31008":75030,"_21483":127783,"_5":14766,"_28195":127749,"_3064":127784},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3608":75045,"_31008":75030,"_21483":127786,"_5":14766,"_28195":127749,"_3064":127787},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3608":75046,"_31008":75030,"_21483":127789,"_5":14766,"_28195":127749,"_3064":58970},[],{"_3608":75047,"_31008":75030,"_21483":127791,"_5":14766,"_28195":127749,"_3064":127792},[],"PEM correcto y firma verificable.",{"_3608":75048,"_31008":75030,"_21483":127794,"_5":14766,"_28195":127749,"_3064":58976},[],{"_3608":75049,"_31008":75030,"_21483":127796,"_5":14766,"_28195":127749,"_3064":127797},[],"Perfil",{"_3608":75050,"_31008":75030,"_21483":127799,"_5":14766,"_28195":127749,"_3064":127800},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3608":75051,"_31008":75030,"_21483":127802,"_5":14766,"_28195":127749,"_3064":127803},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3608":75052,"_31008":75030,"_21483":127805,"_5":14766,"_28195":127749,"_3064":125023},[],{"_3608":75053,"_31008":75030,"_21483":127807,"_5":14766,"_28195":127749,"_3064":127808},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3608":75054,"_31008":75030,"_21483":127810,"_5":14766,"_28195":127749,"_3064":127811},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3608":75055,"_31008":75030,"_21483":127813,"_5":14766,"_28195":127749,"_3064":127814},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3608":75056,"_31008":75030,"_21483":127816,"_5":14766,"_28195":127749,"_3064":127817},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3608":75057,"_31008":75030,"_21483":127819,"_5":14766,"_28195":127749,"_3064":127820},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3608":75058,"_31008":75030,"_21483":127822,"_5":14766,"_28195":127753,"_3064":127823},[],"Revisa cada frontera por separado:",{"_3608":75059,"_31008":75030,"_21483":127825,"_5":14766,"_28195":127753,"_3064":127826},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3608":75060,"_31008":75030,"_21483":127828,"_5":14766,"_28195":127753,"_3064":127829},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3608":75061,"_31008":75030,"_21483":127831,"_5":14766,"_28195":127753,"_3064":127832},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3608":75062,"_31008":75030,"_21483":127834,"_5":14766,"_28195":127753,"_3064":127835},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3608":75063,"_31008":75030,"_21483":127837,"_5":14766,"_28195":127753,"_3064":127838},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3608":75064,"_31008":75030,"_21483":127840,"_5":14766,"_28195":127753,"_3064":127841},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3608":75065,"_31008":75030,"_21483":127843,"_5":14766,"_28195":127757,"_3064":127844},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3608":75066,"_31008":75030,"_21483":127846,"_5":14766,"_28195":127757,"_3064":127847},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3608":75067,"_31008":75067,"_5":15126,"_3064":127849,"_31366":127850,"_21483":127851,"_28195":75067},"Seguridad",[50713],[],{"_3608":75068,"_31008":75067,"_21483":127853,"_5":14766,"_28195":75067,"_3064":127854},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3608":75069,"_31008":75067,"_5":31363,"_21483":127856,"_28195":127857,"_3064":127858},[],"/docs/pr-preview/pr-72/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3608":75070,"_31008":75067,"_5":31363,"_21483":127860,"_28195":127861,"_3064":127862},[],"/docs/pr-preview/pr-72/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3608":75071,"_31008":75067,"_5":31363,"_21483":127864,"_28195":127865,"_3064":127866},[],"/docs/pr-preview/pr-72/es/security#versiones-soportadas","Versiones soportadas",{"_3608":75072,"_31008":75067,"_5":31363,"_21483":127868,"_28195":127869,"_3064":127870},[],"/docs/pr-preview/pr-72/es/security#divulgación-responsable","Divulgación responsable",{"_3608":75073,"_31008":75067,"_21483":127872,"_5":14766,"_28195":75067,"_3064":127873},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3608":75074,"_31008":75067,"_21483":127875,"_5":14766,"_28195":127857,"_3064":127876},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3608":75075,"_31008":75067,"_21483":127878,"_5":14766,"_28195":127857,"_3064":127879},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3608":75076,"_31008":75067,"_21483":127881,"_5":14766,"_28195":127857,"_3064":15404},[],{"_3608":75077,"_31008":75067,"_21483":127883,"_5":14766,"_28195":127857,"_3064":15333},[],{"_3608":75078,"_31008":75067,"_21483":127885,"_5":14766,"_28195":127857,"_3064":15391},[],{"_3608":75079,"_31008":75067,"_21483":127887,"_5":14766,"_28195":127857,"_3064":127888},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3608":75080,"_31008":75067,"_21483":127890,"_5":14766,"_28195":127857,"_3064":127891},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3608":75081,"_31008":75067,"_21483":127893,"_5":14766,"_28195":127861,"_3064":127894},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3608":75082,"_31008":75067,"_21483":127896,"_5":14766,"_28195":127861,"_3064":127897},[],"No incluyas en el reporte:",{"_3608":75083,"_31008":75067,"_21483":127899,"_5":14766,"_28195":127861,"_3064":127900},[],"Credenciales, tokens o claves privadas",{"_3608":75084,"_31008":75067,"_21483":127902,"_5":14766,"_28195":127861,"_3064":127903},[],"Datos de clientes o información identificable de clientes",{"_3608":75085,"_31008":75067,"_21483":127905,"_5":14766,"_28195":127861,"_3064":127906},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3608":75086,"_31008":75067,"_21483":127908,"_5":14766,"_28195":127865,"_3064":127909},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3608":75087,"_31008":75067,"_21483":127911,"_5":14766,"_28195":127865,"_3064":127912},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3608":75088,"_31008":75067,"_21483":127914,"_5":14766,"_28195":127869,"_3064":127915},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3608":75089,"_31008":75067,"_21483":127917,"_5":14766,"_28195":127869,"_3064":127918},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3608":75090,"_31008":75067,"_21483":127920,"_5":14766,"_28195":127869,"_3064":127921},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3608":75091,"_31008":75067,"_21483":127923,"_5":14766,"_28195":127869,"_3064":127924},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3608":75092,"_31008":75067,"_21483":127926,"_5":14766,"_28195":127869,"_3064":127927},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3608":75093,"_31008":75093,"_5":15126,"_3064":127929,"_31366":127930,"_21483":127932,"_28195":75093},"3.8.0 a 4.0.0",[50713,127931],"Actualizaciones",[],{"_3608":75094,"_31008":75093,"_21483":127934,"_5":14766,"_28195":75093,"_3064":127935},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3608":75095,"_31008":75093,"_5":31363,"_21483":127937,"_28195":127938,"_3064":127939},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3608":75096,"_31008":75093,"_5":31363,"_21483":127941,"_28195":127942,"_3064":127943},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3608":75097,"_31008":75093,"_5":31363,"_21483":127945,"_28195":127946,"_3064":127947},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3608":75098,"_31008":75093,"_5":31363,"_21483":127949,"_28195":127950,"_3064":127951},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3608":75099,"_31008":75093,"_5":31363,"_21483":127953,"_28195":127954,"_3064":127955},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3608":75100,"_31008":75093,"_5":31363,"_21483":127957,"_28195":127958,"_3064":127959},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3608":75101,"_31008":75093,"_5":31363,"_21483":127961,"_28195":127962,"_3064":59145},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3608":75102,"_31008":75093,"_5":31363,"_21483":127964,"_28195":127965,"_3064":127966},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3608":75103,"_31008":75093,"_5":31363,"_21483":127968,"_28195":127969,"_3064":127970},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3608":75104,"_31008":75093,"_5":31363,"_21483":127972,"_28195":127973,"_3064":127974},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3608":75105,"_31008":75093,"_5":31363,"_21483":127976,"_28195":127977,"_3064":120361},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3608":75106,"_31008":75093,"_5":31363,"_21483":127979,"_28195":127980,"_3064":127981},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3608":75107,"_31008":75093,"_5":31363,"_21483":127983,"_28195":127984,"_3064":127985},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3608":75108,"_31008":75093,"_5":31363,"_21483":127987,"_28195":127988,"_3064":127989},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3608":75109,"_31008":75093,"_5":31363,"_21483":127991,"_28195":127992,"_3064":127993},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3608":75110,"_31008":75093,"_5":31363,"_21483":127995,"_28195":127996,"_3064":127997},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3608":75111,"_31008":75093,"_5":31363,"_21483":127999,"_28195":128000,"_3064":128001},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3608":75112,"_31008":75093,"_5":31363,"_21483":128003,"_28195":128004,"_3064":128005},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3608":75113,"_31008":75093,"_5":31363,"_21483":128007,"_28195":128008,"_3064":128009},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3608":75114,"_31008":75093,"_5":31363,"_21483":128011,"_28195":128012,"_3064":128013},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3608":75115,"_31008":75093,"_5":31363,"_21483":128015,"_28195":128016,"_3064":128017},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3608":75116,"_31008":75093,"_5":31363,"_21483":128019,"_28195":128020,"_3064":128021},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3608":75117,"_31008":75093,"_5":31363,"_21483":128023,"_28195":128024,"_3064":128025},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3608":75118,"_31008":75093,"_5":31363,"_21483":128027,"_28195":128028,"_3064":128029},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3608":75119,"_31008":75093,"_5":31363,"_21483":128031,"_28195":128032,"_3064":128033},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3608":75120,"_31008":75093,"_5":31363,"_21483":128035,"_28195":128036,"_3064":128037},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3608":75121,"_31008":75093,"_5":31363,"_21483":128039,"_28195":128040,"_3064":128041},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3608":75122,"_31008":75093,"_5":31363,"_21483":128043,"_28195":128044,"_3064":128045},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3608":75123,"_31008":75093,"_5":31363,"_21483":128047,"_28195":128048,"_3064":128049},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3608":75124,"_31008":75093,"_5":31363,"_21483":128051,"_28195":128052,"_3064":128053},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3608":75125,"_31008":75093,"_5":31363,"_21483":128055,"_28195":128056,"_3064":128057},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3608":75126,"_31008":75093,"_5":31363,"_21483":128059,"_28195":128060,"_3064":128061},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3608":75127,"_31008":75093,"_5":31363,"_21483":128063,"_28195":128064,"_3064":128065},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3608":75128,"_31008":75093,"_5":31363,"_21483":128067,"_28195":128068,"_3064":128069},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3608":75129,"_31008":75093,"_5":31363,"_21483":128071,"_28195":128072,"_3064":128073},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3608":75130,"_31008":75093,"_5":31363,"_21483":128075,"_28195":128076,"_3064":128077},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3608":75131,"_31008":75093,"_5":31363,"_21483":128079,"_28195":128080,"_3064":128081},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3608":75132,"_31008":75093,"_5":31363,"_21483":128083,"_28195":128084,"_3064":128085},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3608":75133,"_31008":75093,"_5":31363,"_21483":128087,"_28195":128088,"_3064":128089},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3608":75134,"_31008":75093,"_5":31363,"_21483":128091,"_28195":128092,"_3064":128093},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3608":75135,"_31008":75093,"_5":31363,"_21483":128095,"_28195":128096,"_3064":128097},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3608":75136,"_31008":75093,"_5":31363,"_21483":128099,"_28195":128100,"_3064":128101},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3608":75137,"_31008":75093,"_5":31363,"_21483":128103,"_28195":128104,"_3064":128105},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3608":75138,"_31008":75093,"_5":31363,"_21483":128107,"_28195":128108,"_3064":123886},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3608":75139,"_31008":75093,"_5":31363,"_21483":128110,"_28195":128111,"_3064":128112},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3608":75140,"_31008":75093,"_5":31363,"_21483":128114,"_28195":128115,"_3064":128116},[],"/docs/pr-preview/pr-72/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3608":75141,"_31008":75093,"_21483":128118,"_5":14766,"_28195":75093,"_3064":128119},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3608":75142,"_31008":75093,"_21483":128121,"_5":14766,"_28195":75093,"_3064":128122},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3608":75143,"_31008":75093,"_21483":128124,"_5":14766,"_28195":75093,"_3064":128125},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3608":75144,"_31008":75093,"_21483":128127,"_5":14766,"_28195":75093,"_3064":128128},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3608":75145,"_31008":75093,"_21483":128130,"_5":14766,"_28195":75093,"_3064":128131},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3608":75146,"_31008":75093,"_21483":128133,"_5":14766,"_28195":75093,"_3064":128134},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3608":75147,"_31008":75093,"_21483":128136,"_5":14766,"_28195":75093,"_3064":128137},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3608":75148,"_31008":75093,"_21483":128139,"_5":14766,"_28195":127942,"_3064":128140},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3608":75149,"_31008":75093,"_21483":128142,"_5":14766,"_28195":127942,"_3064":128143},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3608":75150,"_31008":75093,"_21483":128145,"_5":14766,"_28195":127946,"_3064":128146},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3608":75151,"_31008":75093,"_21483":128148,"_5":14766,"_28195":127946,"_3064":128149},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3608":75152,"_31008":75093,"_21483":128151,"_5":14766,"_28195":127950,"_3064":128152},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3608":75153,"_31008":75093,"_21483":128154,"_5":14766,"_28195":127954,"_3064":128155},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3608":75154,"_31008":75093,"_21483":128157,"_5":14766,"_28195":127954,"_3064":128158},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3608":75155,"_31008":75093,"_21483":128160,"_5":14766,"_28195":127954,"_3064":128161},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3608":75156,"_31008":75093,"_21483":128163,"_5":14766,"_28195":127954,"_3064":128164},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3608":75157,"_31008":75093,"_21483":128166,"_5":14766,"_28195":127954,"_3064":128167},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3608":75158,"_31008":75093,"_21483":128169,"_5":14766,"_28195":127958,"_3064":128170},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3608":75159,"_31008":75093,"_21483":128172,"_5":14766,"_28195":127958,"_3064":128173},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3608":75160,"_31008":75093,"_21483":128175,"_5":14766,"_28195":127958,"_3064":128176},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3608":75161,"_31008":75093,"_21483":128178,"_5":14766,"_28195":127958,"_3064":128179},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3608":75162,"_31008":75093,"_21483":128181,"_5":14766,"_28195":127958,"_3064":128182},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3608":75163,"_31008":75093,"_21483":128184,"_5":14766,"_28195":127958,"_3064":128185},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3608":75164,"_31008":75093,"_21483":128187,"_5":14766,"_28195":127962,"_3064":128188},[],"Cambio",{"_3608":75165,"_31008":75093,"_21483":128190,"_5":14766,"_28195":127962,"_3064":128191},[],"A quién afecta",{"_3608":75166,"_31008":75093,"_21483":128193,"_5":14766,"_28195":127962,"_3064":128194},[],"Gravedad",{"_3608":75167,"_31008":75093,"_21483":128196,"_5":14766,"_28195":127962,"_3064":126671},[],{"_3608":75168,"_31008":75093,"_21483":128198,"_5":14766,"_28195":127962,"_3064":127970},[],{"_3608":75169,"_31008":75093,"_21483":128200,"_5":14766,"_28195":127962,"_3064":128201},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3608":75170,"_31008":75093,"_21483":128203,"_5":14766,"_28195":127962,"_3064":128204},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3608":75171,"_31008":75093,"_21483":128206,"_5":14766,"_28195":127962,"_3064":128207},[],"Copiar los datos a los volúmenes nuevos",{"_3608":75172,"_31008":75093,"_21483":128209,"_5":14766,"_28195":127962,"_3064":127974},[],{"_3608":75173,"_31008":75093,"_21483":128211,"_5":14766,"_28195":127962,"_3064":128212},[],"Todas las releases de Helm",{"_3608":75174,"_31008":75093,"_21483":128214,"_5":14766,"_28195":127962,"_3064":128215},[],"Alta: `helm upgrade` falla",{"_3608":75175,"_31008":75093,"_21483":128217,"_5":14766,"_28195":127962,"_3064":128218},[],"Eliminar o renombrar las claves heredadas",{"_3608":75176,"_31008":75093,"_21483":128220,"_5":14766,"_28195":127962,"_3064":120361},[],{"_3608":75177,"_31008":75093,"_21483":128222,"_5":14766,"_28195":127962,"_3064":128212},[],{"_3608":75178,"_31008":75093,"_21483":128224,"_5":14766,"_28195":127962,"_3064":128225},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3608":75179,"_31008":75093,"_21483":128227,"_5":14766,"_28195":127962,"_3064":128228},[],"Crear primero los Secrets; consulta el paso 2",{"_3608":75180,"_31008":75093,"_21483":128230,"_5":14766,"_28195":127962,"_3064":127981},[],{"_3608":75181,"_31008":75093,"_21483":128232,"_5":14766,"_28195":127962,"_3064":128233},[],"Todos los despliegues",{"_3608":75182,"_31008":75093,"_21483":128235,"_5":14766,"_28195":127962,"_3064":128236},[],"Alta: sin principal de bootstrap no hay administrador",{"_3608":75183,"_31008":75093,"_21483":128238,"_5":14766,"_28195":127962,"_3064":128239},[],"Configurar `services.authz`",{"_3608":75184,"_31008":75093,"_21483":128241,"_5":14766,"_28195":127962,"_3064":127985},[],{"_3608":75185,"_31008":75093,"_21483":128243,"_5":14766,"_28195":127962,"_3064":128212},[],{"_3608":75186,"_31008":75093,"_21483":128245,"_5":14766,"_28195":127962,"_3064":128246},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3608":75187,"_31008":75093,"_21483":128248,"_5":14766,"_28195":127962,"_3064":128249},[],"Mover JWKS y roles a `services.authz`",{"_3608":75188,"_31008":75093,"_21483":128251,"_5":14766,"_28195":127962,"_3064":128005},[],{"_3608":75189,"_31008":75093,"_21483":128253,"_5":14766,"_28195":127962,"_3064":128254},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3608":75190,"_31008":75093,"_21483":128256,"_5":14766,"_28195":127962,"_3064":128257},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3608":75191,"_31008":75093,"_21483":128259,"_5":14766,"_28195":127962,"_3064":128260},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3608":75192,"_31008":75093,"_21483":128262,"_5":14766,"_28195":127962,"_3064":128009},[],{"_3608":75193,"_31008":75093,"_21483":128264,"_5":14766,"_28195":127962,"_3064":128265},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3608":75194,"_31008":75093,"_21483":128267,"_5":14766,"_28195":127962,"_3064":128268},[],"Alta: el backend ya no arranca con ellos",{"_3608":75195,"_31008":75093,"_21483":128270,"_5":14766,"_28195":127962,"_3064":128271},[],"Pasar a PostgreSQL antes de actualizar",{"_3608":75196,"_31008":75093,"_21483":128273,"_5":14766,"_28195":127962,"_3064":128053},[],{"_3608":75197,"_31008":75093,"_21483":128275,"_5":14766,"_28195":127962,"_3064":128276},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3608":75198,"_31008":75093,"_21483":128278,"_5":14766,"_28195":127962,"_3064":128279},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3608":75199,"_31008":75093,"_21483":128281,"_5":14766,"_28195":127962,"_3064":128282},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3608":75200,"_31008":75093,"_21483":128284,"_5":14766,"_28195":127962,"_3064":128285},[],"Webhooks con referencias a archivos",{"_3608":75201,"_31008":75093,"_21483":128287,"_5":14766,"_28195":127962,"_3064":128288},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3608":75202,"_31008":75093,"_21483":128290,"_5":14766,"_28195":127962,"_3064":128291},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3608":75203,"_31008":75093,"_21483":128293,"_5":14766,"_28195":127962,"_3064":128294},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3608":75204,"_31008":75093,"_21483":128296,"_5":14766,"_28195":127962,"_3064":127989},[],{"_3608":75205,"_31008":75093,"_21483":128298,"_5":14766,"_28195":127962,"_3064":128299},[],"Releases con identidades por servicio o material de claves montado",{"_3608":75206,"_31008":75093,"_21483":128301,"_5":14766,"_28195":127962,"_3064":128302},[],"Media: los servicios no pueden leer sus archivos",{"_3608":75207,"_31008":75093,"_21483":128304,"_5":14766,"_28195":127962,"_3064":128305},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3608":75208,"_31008":75093,"_21483":128307,"_5":14766,"_28195":127962,"_3064":127993},[],{"_3608":75209,"_31008":75093,"_21483":128309,"_5":14766,"_28195":127962,"_3064":128310},[],"Releases que definen `amqp.tls`",{"_3608":75210,"_31008":75093,"_21483":128312,"_5":14766,"_28195":127962,"_3064":128313},[],"Media: los clientes se conectan al puerto equivocado",{"_3608":75211,"_31008":75093,"_21483":128315,"_5":14766,"_28195":127962,"_3064":128316},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3608":75212,"_31008":75093,"_21483":128318,"_5":14766,"_28195":127962,"_3064":128013},[],{"_3608":75213,"_31008":75093,"_21483":128320,"_5":14766,"_28195":127962,"_3064":128321},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3608":75214,"_31008":75093,"_21483":128323,"_5":14766,"_28195":127962,"_3064":128324},[],"Media: las claves de CA quedan sin gestionar",{"_3608":75215,"_31008":75093,"_21483":128326,"_5":14766,"_28195":127962,"_3064":128327},[],"Ejecutar la migración de CA a KMS",{"_3608":75216,"_31008":75093,"_21483":128329,"_5":14766,"_28195":127962,"_3064":128330},[],"Verificación del certificado del receptor",{"_3608":75217,"_31008":75093,"_21483":128332,"_5":14766,"_28195":127962,"_3064":128333},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3608":75218,"_31008":75093,"_21483":128335,"_5":14766,"_28195":127962,"_3064":128336},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3608":75219,"_31008":75093,"_21483":128338,"_5":14766,"_28195":127962,"_3064":128339},[],"Poner `insecure_skip_verify` a `false`",{"_3608":75220,"_31008":75093,"_21483":128341,"_5":14766,"_28195":127962,"_3064":128029},[],{"_3608":75221,"_31008":75093,"_21483":128343,"_5":14766,"_28195":127962,"_3064":128344},[],"Scripts y consolas que editan DMS por API",{"_3608":75222,"_31008":75093,"_21483":128346,"_5":14766,"_28195":127962,"_3064":128347},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3608":75223,"_31008":75093,"_21483":128349,"_5":14766,"_28195":127962,"_3064":128350},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3608":75224,"_31008":75093,"_21483":128352,"_5":14766,"_28195":127962,"_3064":128049},[],{"_3608":75225,"_31008":75093,"_21483":128354,"_5":14766,"_28195":127962,"_3064":128355},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3608":75226,"_31008":75093,"_21483":128357,"_5":14766,"_28195":127962,"_3064":128358},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3608":75227,"_31008":75093,"_21483":128360,"_5":14766,"_28195":127962,"_3064":128361},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3608":75228,"_31008":75093,"_21483":128363,"_5":14766,"_28195":127962,"_3064":128057},[],{"_3608":75229,"_31008":75093,"_21483":128365,"_5":14766,"_28195":127962,"_3064":128366},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3608":75230,"_31008":75093,"_21483":128368,"_5":14766,"_28195":127962,"_3064":128369},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3608":75231,"_31008":75093,"_21483":128371,"_5":14766,"_28195":127962,"_3064":128372},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3608":75232,"_31008":75093,"_21483":128374,"_5":14766,"_28195":127962,"_3064":128061},[],{"_3608":75233,"_31008":75093,"_21483":128376,"_5":14766,"_28195":127962,"_3064":128377},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3608":75234,"_31008":75093,"_21483":128379,"_5":14766,"_28195":127962,"_3064":128380},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3608":75235,"_31008":75093,"_21483":128382,"_5":14766,"_28195":127962,"_3064":128383},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3608":75236,"_31008":75093,"_21483":128385,"_5":14766,"_28195":127962,"_3064":128045},[],{"_3608":75237,"_31008":75093,"_21483":128387,"_5":14766,"_28195":127962,"_3064":128388},[],"Consumidores que leen el campo `events` del dispositivo",{"_3608":75238,"_31008":75093,"_21483":128390,"_5":14766,"_28195":127962,"_3064":128391},[],"Media: el campo desaparece",{"_3608":75239,"_31008":75093,"_21483":128393,"_5":14766,"_28195":127962,"_3064":128394},[],"Usar los nuevos endpoints de eventos",{"_3608":75240,"_31008":75093,"_21483":128396,"_5":14766,"_28195":127962,"_3064":128073},[],{"_3608":75241,"_31008":75093,"_21483":128398,"_5":14766,"_28195":127962,"_3064":128399},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3608":75242,"_31008":75093,"_21483":128401,"_5":14766,"_28195":127962,"_3064":128402},[],"Media: la migración de la VA aborta",{"_3608":75243,"_31008":75093,"_21483":128404,"_5":14766,"_28195":127962,"_3064":128405},[],"Corregir los roles afectados antes de actualizar",{"_3608":75244,"_31008":75093,"_21483":128407,"_5":14766,"_28195":127962,"_3064":127997},[],{"_3608":75245,"_31008":75093,"_21483":128409,"_5":14766,"_28195":127962,"_3064":128410},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3608":75246,"_31008":75093,"_21483":128412,"_5":14766,"_28195":127962,"_3064":128413},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3608":75247,"_31008":75093,"_21483":128415,"_5":14766,"_28195":127962,"_3064":128416},[],"Actualizar el archivo de values",{"_3608":75248,"_31008":75093,"_21483":128418,"_5":14766,"_28195":127962,"_3064":128037},[],{"_3608":75249,"_31008":75093,"_21483":128420,"_5":14766,"_28195":127962,"_3064":128421},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3608":75250,"_31008":75093,"_21483":128423,"_5":14766,"_28195":127962,"_3064":128424},[],"Baja: prevalece el ID de la URL",{"_3608":75251,"_31008":75093,"_21483":128426,"_5":14766,"_28195":127962,"_3064":128427},[],"Enviar el ID en la URL",{"_3608":75252,"_31008":75093,"_21483":128429,"_5":14766,"_28195":127962,"_3064":128065},[],{"_3608":75253,"_31008":75093,"_21483":128431,"_5":14766,"_28195":127962,"_3064":128432},[],"Clientes que envían un `id` al crear o importar CAs",{"_3608":75254,"_31008":75093,"_21483":128434,"_5":14766,"_28195":127962,"_3064":128435},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3608":75255,"_31008":75093,"_21483":128437,"_5":14766,"_28195":127962,"_3064":128438},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3608":75256,"_31008":75093,"_21483":128440,"_5":14766,"_28195":127962,"_3064":128069},[],{"_3608":75257,"_31008":75093,"_21483":128442,"_5":14766,"_28195":127962,"_3064":128443},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3608":75258,"_31008":75093,"_21483":128445,"_5":14766,"_28195":127962,"_3064":128446},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3608":75259,"_31008":75093,"_21483":128448,"_5":14766,"_28195":127962,"_3064":128449},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3608":75260,"_31008":75093,"_21483":128451,"_5":14766,"_28195":127962,"_3064":128041},[],{"_3608":75261,"_31008":75093,"_21483":128453,"_5":14766,"_28195":127962,"_3064":128454},[],"Consumidores que comparan el `type` del certificado",{"_3608":75262,"_31008":75093,"_21483":128456,"_5":14766,"_28195":127962,"_3064":128457},[],"Baja: dos valores cambian de nombre",{"_3608":75263,"_31008":75093,"_21483":128459,"_5":14766,"_28195":127962,"_3064":128460},[],"Adaptar los consumidores",{"_3608":75264,"_31008":75093,"_21483":128462,"_5":14766,"_28195":127962,"_3064":128033},[],{"_3608":75265,"_31008":75093,"_21483":128464,"_5":14766,"_28195":127962,"_3064":128465},[],"Cualquier DMS",{"_3608":75266,"_31008":75093,"_21483":128467,"_5":14766,"_28195":127962,"_3064":128468},[],"Baja: solo informativo",{"_3608":75267,"_31008":75093,"_21483":128470,"_5":14766,"_28195":127962,"_3064":128471},[],"Revisar ambos bloques antes de editar",{"_3608":75268,"_31008":75093,"_21483":128473,"_5":14766,"_28195":127969,"_3064":128474},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3608":75269,"_31008":75093,"_21483":128476,"_5":14766,"_28195":127969,"_3064":128477},[],"El paso 4 de la guía de migración copia los datos.",{"_3608":75270,"_31008":75093,"_21483":128479,"_5":14766,"_28195":127973,"_3064":128480},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3608":75271,"_31008":75093,"_21483":128482,"_5":14766,"_28195":127977,"_3064":128483},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3608":75272,"_31008":75093,"_21483":128485,"_5":14766,"_28195":127977,"_3064":128486},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3608":75273,"_31008":75093,"_21483":128488,"_5":14766,"_28195":127980,"_3064":128489},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3608":75274,"_31008":75093,"_21483":128491,"_5":14766,"_28195":127984,"_3064":128492},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3608":75275,"_31008":75093,"_21483":128494,"_5":14766,"_28195":127988,"_3064":128495},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3608":75276,"_31008":75093,"_21483":128497,"_5":14766,"_28195":127988,"_3064":128498},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3608":75277,"_31008":75093,"_21483":128500,"_5":14766,"_28195":127988,"_3064":128501},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3608":75278,"_31008":75093,"_21483":128503,"_5":14766,"_28195":127992,"_3064":128504},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3608":75279,"_31008":75093,"_21483":128506,"_5":14766,"_28195":127996,"_3064":128507},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3608":75280,"_31008":75093,"_21483":128509,"_5":14766,"_28195":127996,"_3064":128510},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3608":75281,"_31008":75093,"_21483":128512,"_5":14766,"_28195":127996,"_3064":128513},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3608":75282,"_31008":75093,"_21483":128515,"_5":14766,"_28195":127996,"_3064":128516},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3608":75283,"_31008":75093,"_21483":128518,"_5":14766,"_28195":127996,"_3064":128519},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3608":75284,"_31008":75093,"_21483":128521,"_5":14766,"_28195":127996,"_3064":128522},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3608":75285,"_31008":75093,"_21483":128524,"_5":14766,"_28195":128004,"_3064":128525},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3608":75286,"_31008":75093,"_21483":128527,"_5":14766,"_28195":128004,"_3064":128528},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3608":75287,"_31008":75093,"_21483":128530,"_5":14766,"_28195":128004,"_3064":128531},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3608":75288,"_31008":75093,"_21483":128533,"_5":14766,"_28195":128004,"_3064":128534},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3608":75289,"_31008":75093,"_21483":128536,"_5":14766,"_28195":128004,"_3064":128537},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3608":75290,"_31008":75093,"_21483":128539,"_5":14766,"_28195":128008,"_3064":128540},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3608":75291,"_31008":75093,"_21483":128542,"_5":14766,"_28195":128012,"_3064":128543},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3608":75292,"_31008":75093,"_21483":128545,"_5":14766,"_28195":128012,"_3064":128546},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3608":75293,"_31008":75093,"_21483":128548,"_5":14766,"_28195":128012,"_3064":128549},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3608":75294,"_31008":75093,"_21483":128551,"_5":14766,"_28195":128012,"_3064":128552},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3608":75295,"_31008":75093,"_21483":128554,"_5":14766,"_28195":128012,"_3064":128555},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3608":75296,"_31008":75093,"_21483":128557,"_5":14766,"_28195":128012,"_3064":128558},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3608":75297,"_31008":75093,"_21483":128560,"_5":14766,"_28195":128012,"_3064":128561},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3608":75298,"_31008":75093,"_21483":128563,"_5":14766,"_28195":128012,"_3064":128564},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3608":75299,"_31008":75093,"_21483":128566,"_5":14766,"_28195":128016,"_3064":128567},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3608":75300,"_31008":75093,"_21483":128569,"_5":14766,"_28195":128024,"_3064":128570},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3608":75301,"_31008":75093,"_21483":128572,"_5":14766,"_28195":128024,"_3064":128573},[],"Campo en 3.8.0",{"_3608":75302,"_31008":75093,"_21483":128575,"_5":14766,"_28195":128024,"_3064":128576},[],"Campo en 4.0.0",{"_3608":75303,"_31008":75093,"_21483":128578,"_5":14766,"_28195":128024,"_3064":59761},[],{"_3608":75304,"_31008":75093,"_21483":128580,"_5":14766,"_28195":128024,"_3064":128581},[],"`insecure_skip_verify` (con el valor negado)",{"_3608":75305,"_31008":75093,"_21483":128583,"_5":14766,"_28195":128024,"_3064":59767},[],{"_3608":75306,"_31008":75093,"_21483":128585,"_5":14766,"_28195":128024,"_3064":59770},[],{"_3608":75307,"_31008":75093,"_21483":128587,"_5":14766,"_28195":128024,"_3064":59773},[],{"_3608":75308,"_31008":75093,"_21483":128589,"_5":14766,"_28195":128024,"_3064":59776},[],{"_3608":75309,"_31008":75093,"_21483":128591,"_5":14766,"_28195":128024,"_3064":59779},[],{"_3608":75310,"_31008":75093,"_21483":128593,"_5":14766,"_28195":128024,"_3064":59782},[],{"_3608":75311,"_31008":75093,"_21483":128595,"_5":14766,"_28195":128024,"_3064":128596},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3608":75312,"_31008":75093,"_21483":128598,"_5":14766,"_28195":128024,"_3064":128599},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3608":75313,"_31008":75093,"_21483":128601,"_5":14766,"_28195":128024,"_3064":128602},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3608":75314,"_31008":75093,"_21483":128604,"_5":14766,"_28195":128028,"_3064":128605},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3608":75315,"_31008":75093,"_21483":128607,"_5":14766,"_28195":128028,"_3064":128608},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3608":75316,"_31008":75093,"_21483":128610,"_5":14766,"_28195":128028,"_3064":128611},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3608":75317,"_31008":75093,"_21483":128613,"_5":14766,"_28195":128032,"_3064":128614},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3608":75318,"_31008":75093,"_21483":128616,"_5":14766,"_28195":128036,"_3064":128617},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3608":75319,"_31008":75093,"_21483":128619,"_5":14766,"_28195":128040,"_3064":128620},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3608":75320,"_31008":75093,"_21483":128622,"_5":14766,"_28195":128044,"_3064":128623},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3608":75321,"_31008":75093,"_21483":128625,"_5":14766,"_28195":128044,"_3064":128626},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3608":75322,"_31008":75093,"_21483":128628,"_5":14766,"_28195":128044,"_3064":128629},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3608":75323,"_31008":75093,"_21483":128631,"_5":14766,"_28195":128044,"_3064":128632},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3608":75324,"_31008":75093,"_21483":128634,"_5":14766,"_28195":128048,"_3064":128635},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3608":75325,"_31008":75093,"_21483":128637,"_5":14766,"_28195":128052,"_3064":128638},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3608":75326,"_31008":75093,"_21483":128640,"_5":14766,"_28195":128052,"_3064":128641},[],"Ruta",{"_3608":75327,"_31008":75093,"_21483":128643,"_5":14766,"_28195":128052,"_3064":120992},[],{"_3608":75328,"_31008":75093,"_21483":128645,"_5":14766,"_28195":128052,"_3064":59835},[],{"_3608":75329,"_31008":75093,"_21483":128647,"_5":14766,"_28195":128052,"_3064":128648},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3608":75330,"_31008":75093,"_21483":128650,"_5":14766,"_28195":128052,"_3064":59841},[],{"_3608":75331,"_31008":75093,"_21483":128652,"_5":14766,"_28195":128052,"_3064":128653},[],"Lee los ajustes de una CA.",{"_3608":75332,"_31008":75093,"_21483":128655,"_5":14766,"_28195":128052,"_3064":59847},[],{"_3608":75333,"_31008":75093,"_21483":128657,"_5":14766,"_28195":128052,"_3064":128658},[],"Sustituye los `crl_options`.",{"_3608":75334,"_31008":75093,"_21483":128660,"_5":14766,"_28195":128052,"_3064":59853},[],{"_3608":75335,"_31008":75093,"_21483":128662,"_5":14766,"_28195":128052,"_3064":128663},[],"Elimina los ajustes archivados de una CA.",{"_3608":75336,"_31008":75093,"_21483":128665,"_5":14766,"_28195":128052,"_3064":128666},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3608":75337,"_31008":75093,"_21483":128668,"_5":14766,"_28195":128052,"_3064":128669},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3608":75338,"_31008":75093,"_21483":128671,"_5":14766,"_28195":128052,"_3064":128672},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3608":75339,"_31008":75093,"_21483":128674,"_5":14766,"_28195":128052,"_3064":128675},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3608":75340,"_31008":75093,"_21483":128677,"_5":14766,"_28195":128052,"_3064":128678},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3608":75341,"_31008":75093,"_21483":128680,"_5":14766,"_28195":128052,"_3064":128681},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3608":75342,"_31008":75093,"_21483":128683,"_5":14766,"_28195":128052,"_3064":128684},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3608":75343,"_31008":75093,"_21483":128686,"_5":14766,"_28195":128052,"_3064":128687},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3608":75344,"_31008":75093,"_21483":128689,"_5":14766,"_28195":128052,"_3064":128690},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3608":75345,"_31008":75093,"_21483":128692,"_5":14766,"_28195":128052,"_3064":128693},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3608":75346,"_31008":75093,"_21483":128695,"_5":14766,"_28195":128052,"_3064":128696},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3608":75347,"_31008":75093,"_21483":128698,"_5":14766,"_28195":128056,"_3064":128699},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3608":75348,"_31008":75093,"_21483":128701,"_5":14766,"_28195":128060,"_3064":128702},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS; consulta Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3608":75349,"_31008":75093,"_21483":128704,"_5":14766,"_28195":128064,"_3064":128705},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3608":75350,"_31008":75093,"_21483":128707,"_5":14766,"_28195":128068,"_3064":128708},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3608":75351,"_31008":75093,"_21483":128710,"_5":14766,"_28195":128068,"_3064":128711},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3608":75352,"_31008":75093,"_21483":128713,"_5":14766,"_28195":128072,"_3064":128714},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3608":75353,"_31008":75093,"_21483":128716,"_5":14766,"_28195":128076,"_3064":128717},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3608":75354,"_31008":75093,"_21483":128719,"_5":14766,"_28195":128080,"_3064":128720},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3608":75355,"_31008":75093,"_21483":128722,"_5":14766,"_28195":128080,"_3064":128723},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3608":75356,"_31008":75093,"_21483":128725,"_5":14766,"_28195":128080,"_3064":128726},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3608":75357,"_31008":75093,"_21483":128728,"_5":14766,"_28195":128080,"_3064":128729},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3608":75358,"_31008":75093,"_21483":128731,"_5":14766,"_28195":128080,"_3064":128732},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3608":75359,"_31008":75093,"_21483":128734,"_5":14766,"_28195":128080,"_3064":128735},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3608":75360,"_31008":75093,"_21483":128737,"_5":14766,"_28195":128084,"_3064":128738},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3608":75361,"_31008":75093,"_21483":128740,"_5":14766,"_28195":128084,"_3064":128741},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3608":75362,"_31008":75093,"_21483":128743,"_5":14766,"_28195":128084,"_3064":128744},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3608":75363,"_31008":75093,"_21483":128746,"_5":14766,"_28195":128084,"_3064":128747},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3608":75364,"_31008":75093,"_21483":128749,"_5":14766,"_28195":128084,"_3064":128750},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3608":75365,"_31008":75093,"_21483":128752,"_5":14766,"_28195":128088,"_3064":128753},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3608":75366,"_31008":75093,"_21483":128755,"_5":14766,"_28195":128088,"_3064":128756},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3608":75367,"_31008":75093,"_21483":128758,"_5":14766,"_28195":128088,"_3064":128759},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3608":75368,"_31008":75093,"_21483":128761,"_5":14766,"_28195":128088,"_3064":59955},[],{"_3608":75369,"_31008":75093,"_21483":128763,"_5":14766,"_28195":128088,"_3064":128764},[],"Claves de datos obligatorias",{"_3608":75370,"_31008":75093,"_21483":128766,"_5":14766,"_28195":128088,"_3064":128767},[],"Cuándo",{"_3608":75371,"_31008":75093,"_21483":128769,"_5":14766,"_28195":128088,"_3064":128770},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3608":75372,"_31008":75093,"_21483":128772,"_5":14766,"_28195":128088,"_3064":59967},[],{"_3608":75373,"_31008":75093,"_21483":128774,"_5":14766,"_28195":128088,"_3064":128775},[],"Siempre",{"_3608":75374,"_31008":75093,"_21483":128777,"_5":14766,"_28195":128088,"_3064":128778},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3608":75375,"_31008":75093,"_21483":128780,"_5":14766,"_28195":128088,"_3064":59967},[],{"_3608":75376,"_31008":75093,"_21483":128782,"_5":14766,"_28195":128088,"_3064":128775},[],{"_3608":75377,"_31008":75093,"_21483":128784,"_5":14766,"_28195":128088,"_3064":59980},[],{"_3608":75378,"_31008":75093,"_21483":128786,"_5":14766,"_28195":128088,"_3064":59967},[],{"_3608":75379,"_31008":75093,"_21483":128788,"_5":14766,"_28195":128088,"_3064":128789},[],"Solo cuando hay autenticación SMTP",{"_3608":75380,"_31008":75093,"_21483":128791,"_5":14766,"_28195":128088,"_3064":128792},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3608":75381,"_31008":75093,"_21483":128794,"_5":14766,"_28195":128088,"_3064":128795},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3608":75382,"_31008":75093,"_21483":128797,"_5":14766,"_28195":128088,"_3064":128798},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3608":75383,"_31008":75093,"_21483":128800,"_5":14766,"_28195":128088,"_3064":128801},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3608":75384,"_31008":75093,"_21483":128803,"_5":14766,"_28195":128088,"_3064":128804},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3608":75385,"_31008":75093,"_21483":128806,"_5":14766,"_28195":128088,"_3064":128807},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3608":75386,"_31008":75093,"_21483":128809,"_5":14766,"_28195":128088,"_3064":128810},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3608":75387,"_31008":75093,"_21483":128812,"_5":14766,"_28195":128088,"_3064":128813},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3608":75388,"_31008":75093,"_21483":128815,"_5":14766,"_28195":128088,"_3064":128816},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3608":75389,"_31008":75093,"_21483":128818,"_5":14766,"_28195":128088,"_3064":128819},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3608":75390,"_31008":75093,"_21483":128821,"_5":14766,"_28195":128088,"_3064":128822},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3608":75391,"_31008":75093,"_21483":128824,"_5":14766,"_28195":128088,"_3064":128825},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3608":75392,"_31008":75093,"_21483":128827,"_5":14766,"_28195":128088,"_3064":128828},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3608":75393,"_31008":75093,"_21483":128830,"_5":14766,"_28195":128088,"_3064":128831},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3608":75394,"_31008":75093,"_21483":128833,"_5":14766,"_28195":128088,"_3064":128834},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3608":75395,"_31008":75093,"_21483":128836,"_5":14766,"_28195":128092,"_3064":128837},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3608":75396,"_31008":75093,"_21483":128839,"_5":14766,"_28195":128092,"_3064":128840},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3608":75397,"_31008":75093,"_21483":128842,"_5":14766,"_28195":128096,"_3064":128843},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3608":75398,"_31008":75093,"_21483":128845,"_5":14766,"_28195":128096,"_3064":128846},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3608":75399,"_31008":75093,"_21483":128848,"_5":14766,"_28195":128096,"_3064":128849},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3608":75400,"_31008":75093,"_21483":128851,"_5":14766,"_28195":128096,"_3064":128852},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3608":75401,"_31008":75093,"_21483":128854,"_5":14766,"_28195":128096,"_3064":128855},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3608":75402,"_31008":75093,"_21483":128857,"_5":14766,"_28195":128096,"_3064":128858},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3608":75403,"_31008":75093,"_21483":128860,"_5":14766,"_28195":128096,"_3064":128861},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3608":75404,"_31008":75093,"_21483":128863,"_5":14766,"_28195":128096,"_3064":128864},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3608":75405,"_31008":75093,"_21483":128866,"_5":14766,"_28195":128096,"_3064":128867},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3608":75406,"_31008":75093,"_21483":128869,"_5":14766,"_28195":128096,"_3064":128870},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3608":75407,"_31008":75093,"_21483":128872,"_5":14766,"_28195":128096,"_3064":128873},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3608":75408,"_31008":75093,"_21483":128875,"_5":14766,"_28195":128100,"_3064":128876},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3608":75409,"_31008":75093,"_21483":128878,"_5":14766,"_28195":128100,"_3064":128879},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3608":75410,"_31008":75093,"_21483":128881,"_5":14766,"_28195":128104,"_3064":128882},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3608":75411,"_31008":75093,"_21483":128884,"_5":14766,"_28195":128104,"_3064":128885},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3608":75412,"_31008":75093,"_21483":128887,"_5":14766,"_28195":128104,"_3064":128888},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3608":75413,"_31008":75093,"_21483":128890,"_5":14766,"_28195":128104,"_3064":128891},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3608":75414,"_31008":75093,"_21483":128893,"_5":14766,"_28195":128104,"_3064":128894},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3608":75415,"_31008":75093,"_21483":128896,"_5":14766,"_28195":128104,"_3064":128897},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3608":75416,"_31008":75093,"_21483":128899,"_5":14766,"_28195":128104,"_3064":128900},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3608":75417,"_31008":75093,"_21483":128902,"_5":14766,"_28195":128104,"_3064":128903},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3608":75418,"_31008":75093,"_21483":128905,"_5":14766,"_28195":128108,"_3064":128906},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3608":75419,"_31008":75093,"_21483":128908,"_5":14766,"_28195":128108,"_3064":128909},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3608":75420,"_31008":75093,"_21483":128911,"_5":14766,"_28195":128108,"_3064":128912},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3608":75421,"_31008":75093,"_21483":128914,"_5":14766,"_28195":128108,"_3064":128915},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3608":75422,"_31008":75093,"_21483":128917,"_5":14766,"_28195":128108,"_3064":128918},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3608":75423,"_31008":75093,"_21483":128920,"_5":14766,"_28195":128108,"_3064":128921},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3608":75424,"_31008":75093,"_21483":128923,"_5":14766,"_28195":128108,"_3064":128924},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3608":75425,"_31008":75093,"_21483":128926,"_5":14766,"_28195":128108,"_3064":128927},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3608":75426,"_31008":75093,"_21483":128929,"_5":14766,"_28195":128108,"_3064":128930},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3608":75427,"_31008":75093,"_21483":128932,"_5":14766,"_28195":128108,"_3064":128933},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3608":75428,"_31008":75093,"_21483":128935,"_5":14766,"_28195":128108,"_3064":128936},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3608":75429,"_31008":75093,"_21483":128938,"_5":14766,"_28195":128111,"_3064":128939},[],"Tras la actualización, comprueba en este orden:",{"_3608":75430,"_31008":75093,"_21483":128941,"_5":14766,"_28195":128111,"_3064":128942},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3608":75431,"_31008":75093,"_21483":128944,"_5":14766,"_28195":128111,"_3064":128945},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3608":75432,"_31008":75093,"_21483":128947,"_5":14766,"_28195":128111,"_3064":128948},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3608":75433,"_31008":75093,"_21483":128950,"_5":14766,"_28195":128111,"_3064":128951},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3608":75434,"_31008":75093,"_21483":128953,"_5":14766,"_28195":128111,"_3064":128954},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3608":75435,"_31008":75093,"_21483":128956,"_5":14766,"_28195":128111,"_3064":128957},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3608":75436,"_31008":75093,"_21483":128959,"_5":14766,"_28195":128111,"_3064":128960},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3608":75437,"_31008":75093,"_21483":128962,"_5":14766,"_28195":128111,"_3064":128963},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3608":75438,"_31008":75093,"_21483":128965,"_5":14766,"_28195":128111,"_3064":128966},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3608":75439,"_31008":75093,"_21483":128968,"_5":14766,"_28195":128111,"_3064":128969},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3608":75440,"_31008":75093,"_21483":128971,"_5":14766,"_28195":128111,"_3064":128972},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3608":75441,"_31008":75093,"_21483":128974,"_5":14766,"_28195":128111,"_3064":128975},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3608":75442,"_31008":75093,"_21483":128977,"_5":14766,"_28195":128111,"_3064":128978},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3608":75443,"_31008":75093,"_21483":128980,"_5":14766,"_28195":128111,"_3064":128981},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3608":75444,"_31008":75093,"_21483":128983,"_5":14766,"_28195":128111,"_3064":128984},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3608":75445,"_31008":75093,"_21483":128986,"_5":14766,"_28195":128115,"_3064":128987},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3608":75446,"_31008":75093,"_21483":128989,"_5":14766,"_28195":128115,"_3064":128990},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3608":75447,"_31008":75093,"_21483":128992,"_5":14766,"_28195":128115,"_3064":128993},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3608":75448,"_31008":75093,"_21483":128995,"_5":14766,"_28195":128115,"_3064":128996},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3608":75449,"_31008":75093,"_21483":128998,"_5":14766,"_28195":128115,"_3064":128999},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60198":129001,"_60200":129002,"_60202":129003,"_60204":129004,"_18608":3099,"_72399":3099},"spanish",[3064,31008,5,28195],{"_3064":25641,"_31008":25641,"_5":25641,"_28195":25641},{"_3064":129005,"_31008":132052,"_5":135099,"_28195":138146},{"_4806":129006,"_60208":129007,"_5":25641},{"_14842":3374,"_15225":5313,"_15244":4643,"_30007":6046,"_15231":4193,"_20390":4301,"_14863":3562,"_14870":3906,"_29949":17267,"_30363":5678,"_30384":7241,"_29983":4548,"_35413":5134,"_30086":20876,"_30428":10176,"_35420":5430,"_35423":4194,"_35426":3510,"_35429":3354,"_30830":3470,"_35434":11653,"_35436":3948,"_30865":13737,"_15240":31024,"_35440":7771,"_35443":17669,"_35445":7757,"_30412":12680,"_30850":4814,"_30878":18240,"_35450":8178,"_35452":6193,"_35454":3801,"_30103":3515,"_35457":3670,"_3545