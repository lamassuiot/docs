50721,"_28195":50722,"_3064":50723},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3608":18,"_31008":15,"_5":31363,"_21483":50725,"_28195":50726,"_3064":50727},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3608":19,"_31008":15,"_5":31363,"_21483":50729,"_28195":50730,"_3064":50731},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3608":20,"_31008":15,"_5":31363,"_21483":50733,"_28195":50734,"_3064":50735},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3608":21,"_31008":15,"_5":31363,"_21483":50737,"_28195":50738,"_3064":50739},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3608":22,"_31008":15,"_5":31363,"_21483":50741,"_28195":50742,"_3064":50743},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3608":23,"_31008":15,"_5":31363,"_21483":50745,"_28195":50746,"_3064":50747},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#next-step","Next step",{"_3608":24,"_31008":15,"_21483":50749,"_5":14766,"_28195":15,"_3064":50750},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3608":25,"_31008":15,"_21483":50752,"_5":14766,"_28195":50722,"_3064":50753},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3608":26,"_31008":15,"_21483":50755,"_5":14766,"_28195":50722,"_3064":50756},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3608":27,"_31008":15,"_21483":50758,"_5":14766,"_28195":50722,"_3064":50759},[],"A security group allowing the necessary endpoints.",{"_3608":28,"_31008":15,"_21483":50761,"_5":14766,"_28195":50726,"_3064":50762},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3608":29,"_31008":15,"_21483":50764,"_5":14766,"_28195":50726,"_3064":50765},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3608":30,"_31008":15,"_21483":50767,"_5":14766,"_28195":50726,"_3064":50768},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3608":31,"_31008":15,"_21483":50770,"_5":14766,"_28195":50730,"_3064":50771},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3608":32,"_31008":15,"_21483":50773,"_5":14766,"_28195":50734,"_3064":50774},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3608":33,"_31008":15,"_21483":50776,"_5":14766,"_28195":50738,"_3064":50777},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3608":34,"_31008":15,"_21483":50779,"_5":14766,"_28195":50742,"_3064":50780},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3608":35,"_31008":15,"_21483":50782,"_5":14766,"_28195":50746,"_3064":50783},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3608":36,"_31008":36,"_5":15126,"_3064":50785,"_31366":50786,"_21483":50787,"_28195":36},"Deploy Lamassu",[50713,50714],[],{"_3608":37,"_31008":36,"_21483":50789,"_5":14766,"_28195":36,"_3064":50790},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3608":38,"_31008":36,"_5":31363,"_21483":50792,"_28195":50793,"_3064":50794},[],"/docs/pr-preview/pr-72/deployment/overview#choose-a-model","Choose a model",{"_3608":39,"_31008":36,"_5":31363,"_21483":50796,"_28195":50797,"_3064":50798},[],"/docs/pr-preview/pr-72/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3608":40,"_31008":36,"_5":31363,"_21483":50800,"_28195":50801,"_3064":50802},[],"/docs/pr-preview/pr-72/deployment/overview#after-deployment","After deployment",{"_3608":41,"_31008":36,"_21483":50804,"_5":14766,"_28195":36,"_3064":50805},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3608":42,"_31008":36,"_21483":50807,"_5":14766,"_28195":50793,"_3064":50808},[],"Model",{"_3608":43,"_31008":36,"_21483":50810,"_5":14766,"_28195":50793,"_3064":50811},[],"Recommended for",{"_3608":44,"_31008":36,"_21483":50813,"_5":14766,"_28195":50793,"_3064":50814},[],"Who operates the infrastructure",{"_3608":45,"_31008":36,"_21483":50816,"_5":14766,"_28195":50793,"_3064":50817},[],"Starting point",{"_3608":46,"_31008":36,"_21483":50819,"_5":14766,"_28195":50793,"_3064":50820},[],"Kubernetes self-managed",{"_3608":47,"_31008":36,"_21483":50822,"_5":14766,"_28195":50793,"_3064":50823},[],"Production, regulated environments and custom deployments",{"_3608":48,"_31008":36,"_21483":50825,"_5":14766,"_28195":50793,"_3064":50826},[],"Your team",{"_3608":49,"_31008":36,"_21483":50828,"_5":14766,"_28195":50793,"_3064":50829},[],"Helm or Fastlane",{"_3608":50,"_31008":36,"_21483":50831,"_5":14766,"_28195":50793,"_3064":50832},[],"AWS Marketplace",{"_3608":51,"_31008":36,"_21483":50834,"_5":14766,"_28195":50793,"_3064":50835},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3608":52,"_31008":36,"_21483":50837,"_5":14766,"_28195":50793,"_3064":50826},[],{"_3608":53,"_31008":36,"_21483":50839,"_5":14766,"_28195":50793,"_3064":50840},[],"Preconfigured image on EC2",{"_3608":54,"_31008":36,"_21483":50842,"_5":14766,"_28195":50793,"_3064":50843},[],"SaaS",{"_3608":55,"_31008":36,"_21483":50845,"_5":14766,"_28195":50793,"_3064":50846},[],"Teams that want to use the platform without operating it",{"_3608":56,"_31008":36,"_21483":50848,"_5":14766,"_28195":50793,"_3064":50849},[],"Lamassu",{"_3608":57,"_31008":36,"_21483":50851,"_5":14766,"_28195":50793,"_3064":50852},[],"Managed subscription",{"_3608":58,"_31008":36,"_21483":50854,"_5":14766,"_28195":50793,"_3064":50855},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3608":59,"_31008":36,"_21483":50857,"_5":14766,"_28195":50793,"_3064":50858},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3608":60,"_31008":36,"_21483":50860,"_5":14766,"_28195":50793,"_3064":50861},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3608":61,"_31008":36,"_21483":50863,"_5":14766,"_28195":50797,"_3064":50864},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3608":62,"_31008":36,"_21483":50866,"_5":14766,"_28195":50801,"_3064":50867},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3608":63,"_31008":63,"_5":15126,"_3064":50869,"_31366":50870,"_21483":50871,"_28195":63},"Use Lamassu as SaaS",[50713,50714,50715],[],{"_3608":64,"_31008":63,"_21483":50873,"_5":14766,"_28195":63,"_3064":50874},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3608":65,"_31008":63,"_5":31363,"_21483":50876,"_28195":50877,"_3064":50878},[],"/docs/pr-preview/pr-72/deployment/saas#what-the-service-manages","What the service manages",{"_3608":66,"_31008":63,"_5":31363,"_21483":50880,"_28195":50881,"_3064":50882},[],"/docs/pr-preview/pr-72/deployment/saas#plans","Plans",{"_3608":67,"_31008":63,"_5":31363,"_21483":50884,"_28195":50885,"_3064":50886},[],"/docs/pr-preview/pr-72/deployment/saas#request-access","Request access",{"_3608":68,"_31008":63,"_21483":50888,"_5":14766,"_28195":63,"_3064":50889},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3608":69,"_31008":63,"_21483":50891,"_5":14766,"_28195":50877,"_3064":50892},[],"Platform availability and maintenance.",{"_3608":70,"_31008":63,"_21483":50894,"_5":14766,"_28195":50877,"_3064":50895},[],"Automatic backups.",{"_3608":71,"_31008":63,"_21483":50897,"_5":14766,"_28195":50877,"_3064":50898},[],"Version upgrades.",{"_3608":72,"_31008":63,"_21483":50900,"_5":14766,"_28195":50877,"_3064":50901},[],"Technical support and SLA according to your plan.",{"_3608":73,"_31008":63,"_21483":50903,"_5":14766,"_28195":50881,"_3064":50904},[],"Plan",{"_3608":74,"_31008":63,"_21483":50906,"_5":14766,"_28195":50881,"_3064":50907},[],"Devices",{"_3608":75,"_31008":63,"_21483":50909,"_5":14766,"_28195":50881,"_3064":50910},[],"Support",{"_3608":76,"_31008":63,"_21483":50912,"_5":14766,"_28195":50881,"_3064":50913},[],"SLA",{"_3608":77,"_31008":63,"_21483":50915,"_5":14766,"_28195":50881,"_3064":50916},[],"Starter",{"_3608":78,"_31008":63,"_21483":50918,"_5":14766,"_28195":50881,"_3064":50919},[],"Up to 1,000",{"_3608":79,"_31008":63,"_21483":50921,"_5":14766,"_28195":50881,"_3064":50922},[],"Email",{"_3608":80,"_31008":63,"_21483":50924,"_5":14766,"_28195":50881,"_3064":50925},[],"99.5 %",{"_3608":81,"_31008":63,"_21483":50927,"_5":14766,"_28195":50881,"_3064":50928},[],"Professional",{"_3608":82,"_31008":63,"_21483":50930,"_5":14766,"_28195":50881,"_3064":50931},[],"Up to 10,000",{"_3608":83,"_31008":63,"_21483":50933,"_5":14766,"_28195":50881,"_3064":50934},[],"Email and chat",{"_3608":84,"_31008":63,"_21483":50936,"_5":14766,"_28195":50881,"_3064":50937},[],"99.9 %",{"_3608":85,"_31008":63,"_21483":50939,"_5":14766,"_28195":50881,"_3064":50940},[],"Enterprise",{"_3608":86,"_31008":63,"_21483":50942,"_5":14766,"_28195":50881,"_3064":50943},[],"Unlimited",{"_3608":87,"_31008":63,"_21483":50945,"_5":14766,"_28195":50881,"_3064":50946},[],"Dedicated",{"_3608":88,"_31008":63,"_21483":50948,"_5":14766,"_28195":50881,"_3064":50949},[],"99.99 %",{"_3608":89,"_31008":63,"_21483":50951,"_5":14766,"_28195":50885,"_3064":50952},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3608":90,"_31008":63,"_21483":50954,"_5":14766,"_28195":50885,"_3064":50955},[],"When you receive your instance's credentials, continue with Get started.",{"_3608":91,"_31008":91,"_5":15126,"_3064":50957,"_31366":50958,"_21483":50959,"_28195":91},"Fastlane",[50713,50714,50820],[],{"_3608":92,"_31008":91,"_21483":50961,"_5":14766,"_28195":91,"_3064":50962},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3608":93,"_31008":91,"_5":31363,"_21483":50964,"_28195":50965,"_3064":50966},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3608":94,"_31008":91,"_5":31363,"_21483":50968,"_28195":50969,"_3064":50970},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3608":95,"_31008":91,"_5":31363,"_21483":50972,"_28195":50973,"_3064":50723},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#before-you-begin",{"_3608":96,"_31008":91,"_5":31363,"_21483":50975,"_28195":50976,"_3064":50977},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3608":97,"_31008":91,"_5":31363,"_21483":50979,"_28195":50980,"_3064":50981},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3608":98,"_31008":91,"_5":31363,"_21483":50983,"_28195":50984,"_3064":50985},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3608":99,"_31008":91,"_5":31363,"_21483":50987,"_28195":50988,"_3064":50989},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3608":100,"_31008":91,"_5":31363,"_21483":50991,"_28195":50992,"_3064":50993},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3608":101,"_31008":91,"_5":31363,"_21483":50995,"_28195":50996,"_3064":50997},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3608":102,"_31008":91,"_5":31363,"_21483":50999,"_28195":51000,"_3064":51001},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3608":103,"_31008":91,"_5":31363,"_21483":51003,"_28195":51004,"_3064":51005},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3608":104,"_31008":91,"_21483":51007,"_5":14766,"_28195":50965,"_3064":51008},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3608":105,"_31008":91,"_21483":51010,"_5":14766,"_28195":50965,"_3064":51011},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3608":106,"_31008":91,"_21483":51013,"_5":14766,"_28195":50969,"_3064":51014},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3608":107,"_31008":91,"_21483":51016,"_5":14766,"_28195":50969,"_3064":51017},[],"Fastlane installs or configures",{"_3608":108,"_31008":91,"_21483":51019,"_5":14766,"_28195":50969,"_3064":51020},[],"You still provide",{"_3608":109,"_31008":91,"_21483":51022,"_5":14766,"_28195":50969,"_3064":51023},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3608":110,"_31008":91,"_21483":51025,"_5":14766,"_28195":50969,"_3064":51026},[],"The Kubernetes cluster, nodes and persistent storage",{"_3608":111,"_31008":91,"_21483":51028,"_5":14766,"_28195":50969,"_3064":51029},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3608":112,"_31008":91,"_21483":51031,"_5":14766,"_28195":50969,"_3064":51032},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3608":113,"_31008":91,"_21483":51034,"_5":14766,"_28195":50969,"_3064":51035},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3608":114,"_31008":91,"_21483":51037,"_5":14766,"_28195":50969,"_3064":51038},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3608":115,"_31008":91,"_21483":51040,"_5":14766,"_28195":50969,"_3064":51041},[],"Optional observability and lab HSM components",{"_3608":116,"_31008":91,"_21483":51043,"_5":14766,"_28195":50969,"_3064":51044},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3608":117,"_31008":91,"_21483":51046,"_5":14766,"_28195":50969,"_3064":51047},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3608":118,"_31008":91,"_21483":51049,"_5":14766,"_28195":50973,"_3064":51050},[],"You need:",{"_3608":119,"_31008":91,"_21483":51052,"_5":14766,"_28195":50973,"_3064":51053},[],"an existing Kubernetes cluster",{"_3608":120,"_31008":91,"_21483":51055,"_5":14766,"_28195":50973,"_3064":51056},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3608":121,"_31008":91,"_21483":51058,"_5":14766,"_28195":50973,"_3064":51059},[],"`yq`",{"_3608":122,"_31008":91,"_21483":51061,"_5":14766,"_28195":50973,"_3064":24284},[],{"_3608":123,"_31008":91,"_21483":51063,"_5":14766,"_28195":50973,"_3064":51064},[],"`jq` only when using `--sample-data` or `--development`",{"_3608":124,"_31008":91,"_21483":51066,"_5":14766,"_28195":50973,"_3064":51067},[],"`ssh-keygen` only when using `--with-hsm`",{"_3608":125,"_31008":91,"_21483":51069,"_5":14766,"_28195":50973,"_3064":51070},[],"free external ports 80 and 443 on a single-node K3s host",{"_3608":126,"_31008":91,"_21483":51072,"_5":14766,"_28195":50973,"_3064":51073},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3608":127,"_31008":91,"_21483":51075,"_5":14766,"_28195":50973,"_3064":51076},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3608":128,"_31008":91,"_21483":51078,"_5":14766,"_28195":50976,"_3064":51079},[],"Run the script from a clone of the Helm repository:",{"_3608":129,"_31008":91,"_21483":51081,"_5":14766,"_28195":50976,"_3064":51082},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3608":130,"_31008":91,"_21483":51084,"_5":14766,"_28195":50980,"_3064":51085},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3608":131,"_31008":91,"_21483":51087,"_5":14766,"_28195":50980,"_3064":51088},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3608":132,"_31008":91,"_21483":51090,"_5":14766,"_28195":50980,"_3064":51091},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3608":133,"_31008":91,"_21483":51093,"_5":14766,"_28195":50980,"_3064":51094},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3608":134,"_31008":91,"_21483":51096,"_5":14766,"_28195":50984,"_3064":51097},[],"Option",{"_3608":135,"_31008":91,"_21483":51099,"_5":14766,"_28195":50984,"_3064":51100},[],"Default",{"_3608":136,"_31008":91,"_21483":51102,"_5":14766,"_28195":50984,"_3064":51103},[],"Purpose",{"_3608":137,"_31008":91,"_21483":51105,"_5":14766,"_28195":50984,"_3064":51106},[],"`-h`, `--help`",{"_3608":138,"_31008":91,"_21483":51108,"_5":14766,"_28195":50984,"_3064":51109},[],"—",{"_3608":139,"_31008":91,"_21483":51111,"_5":14766,"_28195":50984,"_3064":51112},[],"Show help",{"_3608":140,"_31008":91,"_21483":51114,"_5":14766,"_28195":50984,"_3064":51115},[],"`-c`, `--context`",{"_3608":141,"_31008":91,"_21483":51117,"_5":14766,"_28195":50984,"_3064":51118},[],"current context",{"_3608":142,"_31008":91,"_21483":51120,"_5":14766,"_28195":50984,"_3064":51121},[],"Select the kubeconfig context for kubectl and Helm",{"_3608":143,"_31008":91,"_21483":51123,"_5":14766,"_28195":50984,"_3064":51124},[],"`-n`, `--non-interactive`",{"_3608":144,"_31008":91,"_21483":51126,"_5":14766,"_28195":50984,"_3064":6767},[],{"_3608":145,"_31008":91,"_21483":51128,"_5":14766,"_28195":50984,"_3064":51129},[],"Skip prompts and generate dependency credentials",{"_3608":146,"_31008":91,"_21483":51131,"_5":14766,"_28195":50984,"_3064":51132},[],"`-ns`, `--namespace`",{"_3608":147,"_31008":91,"_21483":51134,"_5":14766,"_28195":50984,"_3064":51135},[],"`lamassu-dev`",{"_3608":148,"_31008":91,"_21483":51137,"_5":14766,"_28195":50984,"_3064":51138},[],"Namespace for the installation",{"_3608":149,"_31008":91,"_21483":51140,"_5":14766,"_28195":50984,"_3064":51141},[],"`-d`, `--domain`",{"_3608":150,"_31008":91,"_21483":51143,"_5":14766,"_28195":50984,"_3064":51144},[],"`dev.lamassu.io`",{"_3608":151,"_31008":91,"_21483":51146,"_5":14766,"_28195":50984,"_3064":51147},[],"Domain used by the UI, OIDC and certificate",{"_3608":152,"_31008":91,"_21483":51149,"_5":14766,"_28195":50984,"_3064":51150},[],"`-v`, `--version`",{"_3608":153,"_31008":91,"_21483":51152,"_5":14766,"_28195":50984,"_3064":15477},[],{"_3608":154,"_31008":91,"_21483":51154,"_5":14766,"_28195":50984,"_3064":51155},[],"Lamassu chart version",{"_3608":155,"_31008":91,"_21483":51157,"_5":14766,"_28195":50984,"_3064":51158},[],"`--https-port`",{"_3608":156,"_31008":91,"_21483":51160,"_5":14766,"_28195":50984,"_3064":51161},[],"`443`",{"_3608":157,"_31008":91,"_21483":51163,"_5":14766,"_28195":50984,"_3064":51164},[],"Gateway HTTPS listener port",{"_3608":158,"_31008":91,"_21483":51166,"_5":14766,"_28195":50984,"_3064":51167},[],"`--http-port`",{"_3608":159,"_31008":91,"_21483":51169,"_5":14766,"_28195":50984,"_3064":51170},[],"`80`",{"_3608":160,"_31008":91,"_21483":51172,"_5":14766,"_28195":50984,"_3064":51173},[],"Gateway HTTP listener port",{"_3608":161,"_31008":91,"_21483":51175,"_5":14766,"_28195":50984,"_3064":51176},[],"`--tls-crt`",{"_3608":162,"_31008":91,"_21483":51178,"_5":14766,"_28195":50984,"_3064":51109},[],{"_3608":163,"_31008":91,"_21483":51180,"_5":14766,"_28195":50984,"_3064":51181},[],"PEM certificate for downstream TLS",{"_3608":164,"_31008":91,"_21483":51183,"_5":14766,"_28195":50984,"_3064":51184},[],"`--tls-key`",{"_3608":165,"_31008":91,"_21483":51186,"_5":14766,"_28195":50984,"_3064":51109},[],{"_3608":166,"_31008":91,"_21483":51188,"_5":14766,"_28195":50984,"_3064":51189},[],"PEM private key for downstream TLS",{"_3608":167,"_31008":91,"_21483":51191,"_5":14766,"_28195":50984,"_3064":51192},[],"`-l`, `--local-chart-path`",{"_3608":168,"_31008":91,"_21483":51194,"_5":14766,"_28195":50984,"_3064":51195},[],"repository chart",{"_3608":169,"_31008":91,"_21483":51197,"_5":14766,"_28195":50984,"_3064":51198},[],"Use an unpacked local Lamassu chart",{"_3608":170,"_31008":91,"_21483":51200,"_5":14766,"_28195":50984,"_3064":51201},[],"`-ip`, `--gateway-ip`",{"_3608":171,"_31008":91,"_21483":51203,"_5":14766,"_28195":50984,"_3064":9037},[],{"_3608":172,"_31008":91,"_21483":51205,"_5":14766,"_28195":50984,"_3064":51206},[],"Override the address written to `gateway.addresses`",{"_3608":173,"_31008":91,"_21483":51208,"_5":14766,"_28195":50984,"_3064":51209},[],"`--otel`",{"_3608":174,"_31008":91,"_21483":51211,"_5":14766,"_28195":50984,"_3064":6767},[],{"_3608":175,"_31008":91,"_21483":51213,"_5":14766,"_28195":50984,"_3064":51214},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3608":176,"_31008":91,"_21483":51216,"_5":14766,"_28195":50984,"_3064":51217},[],"`--development`",{"_3608":177,"_31008":91,"_21483":51219,"_5":14766,"_28195":50984,"_3064":6767},[],{"_3608":178,"_31008":91,"_21483":51221,"_5":14766,"_28195":50984,"_3064":51222},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3608":179,"_31008":91,"_21483":51224,"_5":14766,"_28195":50984,"_3064":51225},[],"`--sample-data`",{"_3608":180,"_31008":91,"_21483":51227,"_5":14766,"_28195":50984,"_3064":6767},[],{"_3608":181,"_31008":91,"_21483":51229,"_5":14766,"_28195":50984,"_3064":51230},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3608":182,"_31008":91,"_21483":51232,"_5":14766,"_28195":50984,"_3064":51233},[],"`--with-hsm`",{"_3608":183,"_31008":91,"_21483":51235,"_5":14766,"_28195":50984,"_3064":6767},[],{"_3608":184,"_31008":91,"_21483":51237,"_5":14766,"_28195":50984,"_3064":51238},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3608":185,"_31008":91,"_21483":51240,"_5":14766,"_28195":50984,"_3064":51241},[],"`--softhsm-chart-path`",{"_3608":186,"_31008":91,"_21483":51243,"_5":14766,"_28195":50984,"_3064":51244},[],"`./charts/softhsm`",{"_3608":187,"_31008":91,"_21483":51246,"_5":14766,"_28195":50984,"_3064":51247},[],"Use a different local SoftHSM chart",{"_3608":188,"_31008":91,"_21483":51249,"_5":14766,"_28195":50984,"_3064":51250},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3608":189,"_31008":91,"_21483":51252,"_5":14766,"_28195":50988,"_3064":51253},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3608":190,"_31008":91,"_21483":51255,"_5":14766,"_28195":50988,"_3064":51256},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3608":191,"_31008":91,"_21483":51258,"_5":14766,"_28195":50988,"_3064":51259},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3608":192,"_31008":91,"_21483":51261,"_5":14766,"_28195":50988,"_3064":51262},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3608":193,"_31008":91,"_21483":51264,"_5":14766,"_28195":50988,"_3064":51265},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3608":194,"_31008":91,"_21483":51267,"_5":14766,"_28195":50988,"_3064":51268},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3608":195,"_31008":91,"_21483":51270,"_5":14766,"_28195":50992,"_3064":51271},[],"Fastlane:",{"_3608":196,"_31008":91,"_21483":51273,"_5":14766,"_28195":50992,"_3064":51274},[],"validates local tools and the selected cluster",{"_3608":197,"_31008":91,"_21483":51276,"_5":14766,"_28195":50992,"_3064":51277},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3608":198,"_31008":91,"_21483":51279,"_5":14766,"_28195":50992,"_3064":51280},[],"creates the namespace",{"_3608":199,"_31008":91,"_21483":51282,"_5":14766,"_28195":50992,"_3064":51283},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3608":200,"_31008":91,"_21483":51285,"_5":14766,"_28195":50992,"_3064":51286},[],"installs PostgreSQL and creates the required databases",{"_3608":201,"_31008":91,"_21483":51288,"_5":14766,"_28195":50992,"_3064":51289},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3608":202,"_31008":91,"_21483":51291,"_5":14766,"_28195":50992,"_3064":51292},[],"installs RabbitMQ",{"_3608":203,"_31008":91,"_21483":51294,"_5":14766,"_28195":50992,"_3064":51295},[],"optionally installs observability and lab HSM components",{"_3608":204,"_31008":91,"_21483":51297,"_5":14766,"_28195":50992,"_3064":51298},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3608":205,"_31008":91,"_21483":51300,"_5":14766,"_28195":50992,"_3064":51301},[],"optionally loads sample data",{"_3608":206,"_31008":91,"_21483":51303,"_5":14766,"_28195":50992,"_3064":51304},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3608":207,"_31008":91,"_21483":51306,"_5":14766,"_28195":50996,"_3064":51307},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3608":208,"_31008":91,"_21483":51309,"_5":14766,"_28195":50996,"_3064":51310},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3608":209,"_31008":91,"_21483":51312,"_5":14766,"_28195":51000,"_3064":51313},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3608":210,"_31008":91,"_21483":51315,"_5":14766,"_28195":51000,"_3064":51316},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3608":211,"_31008":91,"_21483":51318,"_5":14766,"_28195":51000,"_3064":51319},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3608":212,"_31008":91,"_21483":51321,"_5":14766,"_28195":51000,"_3064":51322},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3608":213,"_31008":91,"_21483":51324,"_5":14766,"_28195":51004,"_3064":51325},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3608":214,"_31008":214,"_5":15126,"_3064":51327,"_31366":51328,"_21483":51329,"_28195":214},"Install with Helm",[50713,50714,50820],[],{"_3608":215,"_31008":214,"_21483":51331,"_5":14766,"_28195":214,"_3064":51332},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3608":216,"_31008":214,"_5":31363,"_21483":51334,"_28195":51335,"_3064":51336},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3608":217,"_31008":214,"_5":31363,"_21483":51338,"_28195":51339,"_3064":50723},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#before-you-begin",{"_3608":218,"_31008":214,"_5":31363,"_21483":51341,"_28195":51342,"_3064":51343},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3608":219,"_31008":214,"_5":31363,"_21483":51345,"_28195":51346,"_3064":51347},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3608":220,"_31008":214,"_5":31363,"_21483":51349,"_28195":51350,"_3064":51351},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3608":221,"_31008":214,"_5":31363,"_21483":51353,"_28195":51354,"_3064":51355},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3608":222,"_31008":214,"_5":31363,"_21483":51357,"_28195":51358,"_3064":51359},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3608":223,"_31008":214,"_5":31363,"_21483":51361,"_28195":51362,"_3064":51363},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3608":224,"_31008":214,"_5":31363,"_21483":51365,"_28195":51366,"_3064":51367},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3608":225,"_31008":214,"_5":31363,"_21483":51369,"_28195":51370,"_3064":51371},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3608":226,"_31008":214,"_5":31363,"_21483":51373,"_28195":51374,"_3064":51375},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3608":227,"_31008":214,"_5":31363,"_21483":51377,"_28195":51378,"_3064":51379},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3608":228,"_31008":214,"_21483":51381,"_5":14766,"_28195":51335,"_3064":51382},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3608":229,"_31008":214,"_21483":51384,"_5":14766,"_28195":51339,"_3064":51385},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3608":230,"_31008":214,"_21483":51387,"_5":14766,"_28195":51339,"_3064":51388},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3608":231,"_31008":214,"_21483":51390,"_5":14766,"_28195":51339,"_3064":51391},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3608":232,"_31008":214,"_21483":51393,"_5":14766,"_28195":51339,"_3064":51394},[],"a reachable RabbitMQ broker and credentials",{"_3608":233,"_31008":214,"_21483":51396,"_5":14766,"_28195":51339,"_3064":51397},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3608":234,"_31008":214,"_21483":51399,"_5":14766,"_28195":51339,"_3064":51400},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3608":235,"_31008":214,"_21483":51402,"_5":14766,"_28195":51339,"_3064":51403},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3608":236,"_31008":214,"_21483":51405,"_5":14766,"_28195":51339,"_3064":51406},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3608":237,"_31008":214,"_21483":51408,"_5":14766,"_28195":51339,"_3064":51409},[],"a StorageClass and an external traffic design",{"_3608":238,"_31008":214,"_21483":51411,"_5":14766,"_28195":51339,"_3064":51412},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3608":239,"_31008":214,"_21483":51414,"_5":14766,"_28195":51339,"_3064":51415},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3608":240,"_31008":214,"_21483":51417,"_5":14766,"_28195":51339,"_3064":51418},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3608":241,"_31008":214,"_21483":51420,"_5":14766,"_28195":51342,"_3064":51421},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3608":242,"_31008":214,"_21483":51423,"_5":14766,"_28195":51342,"_3064":51424},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3608":243,"_31008":214,"_21483":51426,"_5":14766,"_28195":51342,"_3064":51427},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3608":244,"_31008":214,"_21483":51429,"_5":14766,"_28195":51346,"_3064":51430},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3608":245,"_31008":214,"_21483":51432,"_5":14766,"_28195":51346,"_3064":51433},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3608":246,"_31008":214,"_21483":51435,"_5":14766,"_28195":51346,"_3064":51436},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3608":247,"_31008":214,"_21483":51438,"_5":14766,"_28195":51346,"_3064":51439},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3608":248,"_31008":214,"_21483":51441,"_5":14766,"_28195":51350,"_3064":51442},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3608":249,"_31008":214,"_21483":51444,"_5":14766,"_28195":51350,"_3064":51445},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3608":250,"_31008":214,"_21483":51447,"_5":14766,"_28195":51350,"_3064":51448},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3608":251,"_31008":214,"_21483":51450,"_5":14766,"_28195":51350,"_3064":51451},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3608":252,"_31008":214,"_21483":51453,"_5":14766,"_28195":51350,"_3064":51454},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3608":253,"_31008":214,"_21483":51456,"_5":14766,"_28195":51350,"_3064":51457},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3608":254,"_31008":214,"_21483":51459,"_5":14766,"_28195":51350,"_3064":51460},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3608":255,"_31008":214,"_21483":51462,"_5":14766,"_28195":51350,"_3064":51463},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3608":256,"_31008":214,"_21483":51465,"_5":14766,"_28195":51354,"_3064":51466},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3608":257,"_31008":214,"_21483":51468,"_5":14766,"_28195":51358,"_3064":51469},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3608":258,"_31008":214,"_21483":51471,"_5":14766,"_28195":51358,"_3064":51472},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3608":259,"_31008":214,"_21483":51474,"_5":14766,"_28195":51358,"_3064":51475},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3608":260,"_31008":214,"_21483":51477,"_5":14766,"_28195":51358,"_3064":51478},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3608":261,"_31008":214,"_21483":51480,"_5":14766,"_28195":51358,"_3064":51481},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3608":262,"_31008":214,"_21483":51483,"_5":14766,"_28195":51358,"_3064":51484},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3608":263,"_31008":214,"_21483":51486,"_5":14766,"_28195":51358,"_3064":51487},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3608":264,"_31008":214,"_21483":51489,"_5":14766,"_28195":51362,"_3064":51490},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3608":265,"_31008":214,"_21483":51492,"_5":14766,"_28195":51362,"_3064":51493},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3608":266,"_31008":214,"_21483":51495,"_5":14766,"_28195":51362,"_3064":51496},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3608":267,"_31008":214,"_21483":51498,"_5":14766,"_28195":51362,"_3064":51499},[],"See Access control for the principal and policy model.",{"_3608":268,"_31008":214,"_21483":51501,"_5":14766,"_28195":51366,"_3064":51502},[],"To install a local checkout instead:",{"_3608":269,"_31008":214,"_21483":51504,"_5":14766,"_28195":51370,"_3064":51505},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3608":270,"_31008":214,"_21483":51507,"_5":14766,"_28195":51370,"_3064":51508},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3608":271,"_31008":214,"_21483":51510,"_5":14766,"_28195":51374,"_3064":51511},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3608":272,"_31008":214,"_21483":51513,"_5":14766,"_28195":51374,"_3064":51514},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3608":273,"_31008":214,"_21483":51516,"_5":14766,"_28195":51374,"_3064":51517},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3608":274,"_31008":214,"_21483":51519,"_5":14766,"_28195":51374,"_3064":51520},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3608":275,"_31008":214,"_21483":51522,"_5":14766,"_28195":51374,"_3064":51523},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3608":276,"_31008":214,"_21483":51525,"_5":14766,"_28195":51378,"_3064":51526},[],"Before going live, review:",{"_3608":277,"_31008":214,"_21483":51528,"_5":14766,"_28195":51378,"_3064":51529},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3608":278,"_31008":214,"_21483":51531,"_5":14766,"_28195":51378,"_3064":51532},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3608":279,"_31008":214,"_21483":51534,"_5":14766,"_28195":51378,"_3064":51535},[],"shared VA storage before increasing VA replicas",{"_3608":280,"_31008":214,"_21483":51537,"_5":14766,"_28195":51378,"_3064":51538},[],"managed OIDC roles and removal of evaluation credentials",{"_3608":281,"_31008":214,"_21483":51540,"_5":14766,"_28195":51378,"_3064":51541},[],"a trusted TLS issuer or externally managed certificate",{"_3608":282,"_31008":214,"_21483":51543,"_5":14766,"_28195":51378,"_3064":51544},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3608":283,"_31008":214,"_21483":51546,"_5":14766,"_28195":51378,"_3064":51547},[],"SMTP, observability and alert delivery",{"_3608":284,"_31008":214,"_21483":51549,"_5":14766,"_28195":51378,"_3064":51550},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3608":285,"_31008":214,"_21483":51552,"_5":14766,"_28195":51378,"_3064":51553},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3608":286,"_31008":286,"_5":15126,"_3064":51555,"_31366":51556,"_21483":51557,"_28195":286},"Expose the Gateway",[50713,50714,50820],[],{"_3608":287,"_31008":286,"_21483":51559,"_5":14766,"_28195":286,"_3064":51560},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3608":288,"_31008":286,"_5":31363,"_21483":51562,"_28195":51563,"_3064":51564},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3608":289,"_31008":286,"_5":31363,"_21483":51566,"_28195":51567,"_3064":51568},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3608":290,"_31008":286,"_5":31363,"_21483":51570,"_28195":51571,"_3064":51572},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3608":291,"_31008":286,"_5":31363,"_21483":51574,"_28195":51575,"_3064":51576},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#k3s","K3s",{"_3608":292,"_31008":286,"_5":31363,"_21483":51578,"_28195":51579,"_3064":51580},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3608":293,"_31008":286,"_5":31363,"_21483":51582,"_28195":51583,"_3064":51584},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3608":294,"_31008":286,"_5":31363,"_21483":51586,"_28195":51587,"_3064":51588},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3608":295,"_31008":286,"_5":31363,"_21483":51590,"_28195":51591,"_3064":51592},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3608":296,"_31008":286,"_5":31363,"_21483":51594,"_28195":51595,"_3064":51596},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3608":297,"_31008":286,"_5":31363,"_21483":51598,"_28195":51599,"_3064":51600},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3608":298,"_31008":286,"_5":31363,"_21483":51602,"_28195":51603,"_3064":51604},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3608":299,"_31008":286,"_21483":51606,"_5":14766,"_28195":51563,"_3064":51607},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3608":300,"_31008":286,"_21483":51609,"_5":14766,"_28195":51563,"_3064":51610},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3608":301,"_31008":286,"_21483":51612,"_5":14766,"_28195":51567,"_3064":51613},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3608":302,"_31008":286,"_21483":51615,"_5":14766,"_28195":51567,"_3064":51616},[],"Set it only when:",{"_3608":303,"_31008":286,"_21483":51618,"_5":14766,"_28195":51567,"_3064":51619},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3608":304,"_31008":286,"_21483":51621,"_5":14766,"_28195":51567,"_3064":51622},[],"that address is allocated to this Gateway",{"_3608":305,"_31008":286,"_21483":51624,"_5":14766,"_28195":51567,"_3064":51625},[],"the surrounding network already routes traffic for it to the cluster",{"_3608":306,"_31008":286,"_21483":51627,"_5":14766,"_28195":51567,"_3064":51628},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3608":307,"_31008":286,"_21483":51630,"_5":14766,"_28195":51567,"_3064":51631},[],"Keep these two settings separate:",{"_3608":308,"_31008":286,"_21483":51633,"_5":14766,"_28195":51567,"_3064":51634},[],"`gateway.addresses` requests an address for the Gateway.",{"_3608":309,"_31008":286,"_21483":51636,"_5":14766,"_28195":51567,"_3064":51637},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3608":310,"_31008":286,"_21483":51639,"_5":14766,"_28195":51567,"_3064":51640},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3608":311,"_31008":286,"_21483":51642,"_5":14766,"_28195":51571,"_3064":51643},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3608":312,"_31008":286,"_21483":51645,"_5":14766,"_28195":51571,"_3064":51646},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3608":313,"_31008":286,"_21483":51648,"_5":14766,"_28195":51575,"_3064":51649},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3608":314,"_31008":286,"_21483":51651,"_5":14766,"_28195":51575,"_3064":51652},[],"For the recommended design:",{"_3608":315,"_31008":286,"_21483":51654,"_5":14766,"_28195":51575,"_3064":51655},[],"Use only one externally exposed Lamassu Gateway.",{"_3608":316,"_31008":286,"_21483":51657,"_5":14766,"_28195":51575,"_3064":51658},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3608":317,"_31008":286,"_21483":51660,"_5":14766,"_28195":51575,"_3064":51661},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3608":318,"_31008":286,"_21483":51663,"_5":14766,"_28195":51575,"_3064":51664},[],"Point DNS at the VM's reachable address.",{"_3608":319,"_31008":286,"_21483":51666,"_5":14766,"_28195":51575,"_3064":51667},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3608":320,"_31008":286,"_21483":51669,"_5":14766,"_28195":51579,"_3064":51670},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3608":321,"_31008":286,"_21483":51672,"_5":14766,"_28195":51583,"_3064":51673},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3608":322,"_31008":286,"_21483":51675,"_5":14766,"_28195":51583,"_3064":51676},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3608":323,"_31008":286,"_21483":51678,"_5":14766,"_28195":51587,"_3064":51679},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3608":324,"_31008":286,"_21483":51681,"_5":14766,"_28195":51587,"_3064":51682},[],"Requirement",{"_3608":325,"_31008":286,"_21483":51684,"_5":14766,"_28195":51587,"_3064":51685},[],"Recommended design",{"_3608":326,"_31008":286,"_21483":51687,"_5":14766,"_28195":51587,"_3064":51688},[],"Consequence",{"_3608":327,"_31008":286,"_21483":51690,"_5":14766,"_28195":51587,"_3064":51691},[],"Several Lamassu URLs or services",{"_3608":328,"_31008":286,"_21483":51693,"_5":14766,"_28195":51587,"_3064":51694},[],"One Gateway with multiple routes",{"_3608":329,"_31008":286,"_21483":51696,"_5":14766,"_28195":51587,"_3064":51697},[],"One IP and one proxy fleet; this is the chart default",{"_3608":330,"_31008":286,"_21483":51699,"_5":14766,"_28195":51587,"_3064":51700},[],"Independent Gateways and separate external IPs",{"_3608":331,"_31008":286,"_21483":51702,"_5":14766,"_28195":51587,"_3064":51703},[],"One VIP per Gateway",{"_3608":332,"_31008":286,"_21483":51705,"_5":14766,"_28195":51587,"_3064":51706},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3608":333,"_31008":286,"_21483":51708,"_5":14766,"_28195":51587,"_3064":51709},[],"Independent Gateways on one node and one IP",{"_3608":334,"_31008":286,"_21483":51711,"_5":14766,"_28195":51587,"_3064":51712},[],"Use different external ports",{"_3608":335,"_31008":286,"_21483":51714,"_5":14766,"_28195":51587,"_3064":51715},[],"Clients must include non-standard ports",{"_3608":336,"_31008":286,"_21483":51717,"_5":14766,"_28195":51587,"_3064":51718},[],"Separate TLS/mTLS termination behind one IP",{"_3608":337,"_31008":286,"_21483":51720,"_5":14766,"_28195":51587,"_3064":51721},[],"Front-door SNI routing to internal Gateways",{"_3608":338,"_31008":286,"_21483":51723,"_5":14766,"_28195":51587,"_3064":51724},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3608":339,"_31008":286,"_21483":51726,"_5":14766,"_28195":51587,"_3064":51727},[],"Separate Gateway resources but shared proxy infrastructure",{"_3608":340,"_31008":286,"_21483":51729,"_5":14766,"_28195":51587,"_3064":51730},[],"Envoy merged-Gateway mode",{"_3608":341,"_31008":286,"_21483":51732,"_5":14766,"_28195":51587,"_3064":51733},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3608":342,"_31008":286,"_21483":51735,"_5":14766,"_28195":51587,"_3064":51736},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3608":343,"_31008":286,"_21483":51738,"_5":14766,"_28195":51587,"_3064":51739},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3608":344,"_31008":286,"_21483":51741,"_5":14766,"_28195":51587,"_3064":51742},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3608":345,"_31008":286,"_21483":51744,"_5":14766,"_28195":51587,"_3064":51745},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3608":346,"_31008":286,"_21483":51747,"_5":14766,"_28195":51591,"_3064":51748},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3608":347,"_31008":286,"_21483":51750,"_5":14766,"_28195":51595,"_3064":51751},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3608":348,"_31008":286,"_21483":51753,"_5":14766,"_28195":51595,"_3064":51754},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3608":349,"_31008":286,"_21483":51756,"_5":14766,"_28195":51595,"_3064":51757},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3608":350,"_31008":286,"_21483":51759,"_5":14766,"_28195":51595,"_3064":51760},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3608":351,"_31008":286,"_21483":51762,"_5":14766,"_28195":51595,"_3064":51763},[],"If none of those are possible, use different external ports or change the external network design.",{"_3608":352,"_31008":286,"_21483":51765,"_5":14766,"_28195":51599,"_3064":51766},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3608":353,"_31008":286,"_21483":51768,"_5":14766,"_28195":51599,"_3064":51769},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3608":354,"_31008":286,"_21483":51771,"_5":14766,"_28195":51603,"_3064":51772},[],"Check, in order:",{"_3608":355,"_31008":286,"_21483":51774,"_5":14766,"_28195":51603,"_3064":51775},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3608":356,"_31008":286,"_21483":51777,"_5":14766,"_28195":51603,"_3064":51778},[],"Its status contains the expected address.",{"_3608":357,"_31008":286,"_21483":51780,"_5":14766,"_28195":51603,"_3064":51781},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3608":358,"_31008":286,"_21483":51783,"_5":14766,"_28195":51603,"_3064":51784},[],"Port 443 reaches that address from the client network.",{"_3608":359,"_31008":286,"_21483":51786,"_5":14766,"_28195":51603,"_3064":51787},[],"DNS resolves to the externally reachable endpoint.",{"_3608":360,"_31008":286,"_21483":51789,"_5":14766,"_28195":51603,"_3064":51790},[],"The certificate contains the DNS name or IP used by the client.",{"_3608":361,"_31008":286,"_21483":51792,"_5":14766,"_28195":51603,"_3064":51793},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3608":362,"_31008":362,"_5":15126,"_3064":50820,"_31366":51795,"_21483":51796,"_28195":362},[50713,50714,50820],[],{"_3608":363,"_31008":362,"_21483":51798,"_5":14766,"_28195":362,"_3064":51799},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3608":364,"_31008":362,"_5":31363,"_21483":51801,"_28195":51802,"_3064":51803},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3608":365,"_31008":362,"_5":31363,"_21483":51805,"_28195":51806,"_3064":51807},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3608":366,"_31008":362,"_5":31363,"_21483":51809,"_28195":51810,"_3064":51811},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3608":367,"_31008":362,"_5":31363,"_21483":51813,"_28195":51814,"_3064":51815},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3608":368,"_31008":362,"_5":31363,"_21483":51817,"_28195":51818,"_3064":51819},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3608":369,"_31008":362,"_5":31363,"_21483":51821,"_28195":51822,"_3064":51823},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3608":370,"_31008":362,"_21483":51825,"_5":14766,"_28195":51802,"_3064":51826},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3608":371,"_31008":362,"_21483":51828,"_5":14766,"_28195":51806,"_3064":51829},[],"Workflow",{"_3608":372,"_31008":362,"_21483":51831,"_5":14766,"_28195":51806,"_3064":51832},[],"Use it for",{"_3608":373,"_31008":362,"_21483":51834,"_5":14766,"_28195":51806,"_3064":51835},[],"What it installs",{"_3608":374,"_31008":362,"_21483":51837,"_5":14766,"_28195":51806,"_3064":51838},[],"Helm",{"_3608":375,"_31008":362,"_21483":51840,"_5":14766,"_28195":51806,"_3064":51841},[],"Production and controlled environments",{"_3608":376,"_31008":362,"_21483":51843,"_5":14766,"_28195":51806,"_3064":51844},[],"Lamassu services and Gateway API resources",{"_3608":377,"_31008":362,"_21483":51846,"_5":14766,"_28195":51806,"_3064":50957},[],{"_3608":378,"_31008":362,"_21483":51848,"_5":14766,"_28195":51806,"_3064":51849},[],"Evaluation, demos, CI and small lab clusters",{"_3608":379,"_31008":362,"_21483":51851,"_5":14766,"_28195":51806,"_3064":51852},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3608":380,"_31008":362,"_21483":51854,"_5":14766,"_28195":51810,"_3064":51855},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3608":381,"_31008":362,"_21483":51857,"_5":14766,"_28195":51810,"_3064":51858},[],"Area",{"_3608":382,"_31008":362,"_21483":51860,"_5":14766,"_28195":51810,"_3064":51861},[],"The Lamassu chart provides",{"_3608":383,"_31008":362,"_21483":51863,"_5":14766,"_28195":51810,"_3064":51864},[],"You provide",{"_3608":384,"_31008":362,"_21483":51866,"_5":14766,"_28195":51810,"_3064":51867},[],"Lamassu applications",{"_3608":385,"_31008":362,"_21483":51869,"_5":14766,"_28195":51810,"_3064":51870},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3608":386,"_31008":362,"_21483":51872,"_5":14766,"_28195":51810,"_3064":51873},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3608":387,"_31008":362,"_21483":51875,"_5":14766,"_28195":51810,"_3064":51876},[],"PostgreSQL data",{"_3608":388,"_31008":362,"_21483":51878,"_5":14766,"_28195":51810,"_3064":51879},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3608":389,"_31008":362,"_21483":51881,"_5":14766,"_28195":51810,"_3064":51882},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3608":390,"_31008":362,"_21483":51884,"_5":14766,"_28195":51810,"_3064":51885},[],"Messaging",{"_3608":391,"_31008":362,"_21483":51887,"_5":14766,"_28195":51810,"_3064":51888},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3608":392,"_31008":362,"_21483":51890,"_5":14766,"_28195":51810,"_3064":51891},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3608":393,"_31008":362,"_21483":51893,"_5":14766,"_28195":51810,"_3064":51894},[],"Identity",{"_3608":394,"_31008":362,"_21483":51896,"_5":14766,"_28195":51810,"_3064":51897},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3608":395,"_31008":362,"_21483":51899,"_5":14766,"_28195":51810,"_3064":51900},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3608":396,"_31008":362,"_21483":51902,"_5":14766,"_28195":51810,"_3064":51903},[],"External routing",{"_3608":397,"_31008":362,"_21483":51905,"_5":14766,"_28195":51810,"_3064":51906},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3608":398,"_31008":362,"_21483":51908,"_5":14766,"_28195":51810,"_3064":51909},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3608":399,"_31008":362,"_21483":51911,"_5":14766,"_28195":51810,"_3064":51912},[],"TLS",{"_3608":400,"_31008":362,"_21483":51914,"_5":14766,"_28195":51810,"_3064":51915},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3608":401,"_31008":362,"_21483":51917,"_5":14766,"_28195":51810,"_3064":51918},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3608":402,"_31008":362,"_21483":51920,"_5":14766,"_28195":51810,"_3064":51921},[],"Persistent application data",{"_3608":403,"_31008":362,"_21483":51923,"_5":14766,"_28195":51810,"_3064":51924},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3608":404,"_31008":362,"_21483":51926,"_5":14766,"_28195":51810,"_3064":51927},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3608":405,"_31008":362,"_21483":51929,"_5":14766,"_28195":51810,"_3064":51930},[],"Optional integrations",{"_3608":406,"_31008":362,"_21483":51932,"_5":14766,"_28195":51810,"_3064":51933},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3608":407,"_31008":362,"_21483":51935,"_5":14766,"_28195":51810,"_3064":51936},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3608":408,"_31008":362,"_21483":51938,"_5":14766,"_28195":51810,"_3064":51939},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3608":409,"_31008":362,"_21483":51941,"_5":14766,"_28195":51810,"_3064":51942},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3608":410,"_31008":362,"_21483":51944,"_5":14766,"_28195":51814,"_3064":51945},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3608":411,"_31008":362,"_21483":51947,"_5":14766,"_28195":51814,"_3064":51948},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3608":412,"_31008":362,"_21483":51950,"_5":14766,"_28195":51818,"_3064":51951},[],"Kubernetes 1.24 or newer",{"_3608":413,"_31008":362,"_21483":51953,"_5":14766,"_28195":51818,"_3064":51954},[],"Helm 3.2 or newer",{"_3608":414,"_31008":362,"_21483":51956,"_5":14766,"_28195":51818,"_3064":51957},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3608":415,"_31008":362,"_21483":51959,"_5":14766,"_28195":51818,"_3064":51960},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3608":416,"_31008":362,"_21483":51962,"_5":14766,"_28195":51818,"_3064":51963},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3608":417,"_31008":362,"_21483":51965,"_5":14766,"_28195":51818,"_3064":51966},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3608":418,"_31008":362,"_21483":51968,"_5":14766,"_28195":51818,"_3064":51969},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3608":419,"_31008":362,"_21483":51971,"_5":14766,"_28195":51822,"_3064":51972},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3608":420,"_31008":362,"_21483":51974,"_5":14766,"_28195":51822,"_3064":51975},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3608":421,"_31008":362,"_21483":51977,"_5":14766,"_28195":51822,"_3064":51978},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3608":422,"_31008":362,"_21483":51980,"_5":14766,"_28195":51822,"_3064":51981},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3608":423,"_31008":423,"_5":15126,"_3064":51983,"_31366":51984,"_21483":51986,"_28195":423},"Deployment troubleshooting",[50713,50714,51985],"Operations",[],{"_3608":424,"_31008":423,"_21483":51988,"_5":14766,"_28195":423,"_3064":51989},[],"Diagnose access, service health and infrastructure dependencies.",{"_3608":425,"_31008":423,"_5":31363,"_21483":51991,"_28195":51992,"_3064":51993},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3608":426,"_31008":423,"_5":31363,"_21483":51995,"_28195":51996,"_3064":51997},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3608":427,"_31008":423,"_5":31363,"_21483":51999,"_28195":52000,"_3064":52001},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3608":428,"_31008":423,"_5":31363,"_21483":52003,"_28195":52004,"_3064":52005},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3608":429,"_31008":423,"_5":31363,"_21483":52007,"_28195":52008,"_3064":52009},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3608":430,"_31008":423,"_5":31363,"_21483":52011,"_28195":52012,"_3064":52013},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3608":431,"_31008":423,"_5":31363,"_21483":52015,"_28195":52016,"_3064":52017},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3608":432,"_31008":423,"_5":31363,"_21483":52019,"_28195":52020,"_3064":52021},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3608":433,"_31008":423,"_5":31363,"_21483":52023,"_28195":52024,"_3064":52025},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3608":434,"_31008":423,"_5":31363,"_21483":52027,"_28195":52028,"_3064":52029},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3608":435,"_31008":423,"_5":31363,"_21483":52031,"_28195":52032,"_3064":52033},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3608":436,"_31008":423,"_5":31363,"_21483":52035,"_28195":52036,"_3064":52037},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3608":437,"_31008":423,"_5":31363,"_21483":52039,"_28195":52040,"_3064":52041},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#observability","Observability",{"_3608":438,"_31008":423,"_21483":52043,"_5":14766,"_28195":423,"_3064":52044},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3608":439,"_31008":423,"_21483":52046,"_5":14766,"_28195":51996,"_3064":52047},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3608":440,"_31008":423,"_21483":52049,"_5":14766,"_28195":52000,"_3064":52050},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3608":441,"_31008":423,"_21483":52052,"_5":14766,"_28195":52004,"_3064":52053},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3608":442,"_31008":423,"_21483":52055,"_5":14766,"_28195":52008,"_3064":52056},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3608":443,"_31008":423,"_21483":52058,"_5":14766,"_28195":52012,"_3064":52059},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3608":444,"_31008":423,"_21483":52061,"_5":14766,"_28195":52016,"_3064":52062},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3608":445,"_31008":423,"_21483":52064,"_5":14766,"_28195":52016,"_3064":52065},[],"Also run the chart's connectivity test:",{"_3608":446,"_31008":423,"_21483":52067,"_5":14766,"_28195":52016,"_3064":52068},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3608":447,"_31008":423,"_21483":52070,"_5":14766,"_28195":52016,"_3064":52071},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3608":448,"_31008":423,"_21483":52073,"_5":14766,"_28195":52020,"_3064":52074},[],"If you receive a 401:",{"_3608":449,"_31008":423,"_21483":52076,"_5":14766,"_28195":52020,"_3064":52077},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3608":450,"_31008":423,"_21483":52079,"_5":14766,"_28195":52020,"_3064":52080},[],"verify issuer, audience and expiration of the token;",{"_3608":451,"_31008":423,"_21483":52082,"_5":14766,"_28195":52020,"_3064":52083},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3608":452,"_31008":423,"_21483":52085,"_5":14766,"_28195":52020,"_3064":52086},[],"check that the provider's public and internal routes point to the same realm.",{"_3608":453,"_31008":423,"_21483":52088,"_5":14766,"_28195":52020,"_3064":52089},[],"If login succeeds but the APIs return 403:",{"_3608":454,"_31008":423,"_21483":52091,"_5":14766,"_28195":52020,"_3064":52092},[],"inspect the token's real claims;",{"_3608":455,"_31008":423,"_21483":52094,"_5":14766,"_28195":52020,"_3064":52095},[],"confirm they match an active principal;",{"_3608":456,"_31008":423,"_21483":52097,"_5":14766,"_28195":52020,"_3064":52098},[],"review the policies granted to that principal;",{"_3608":457,"_31008":423,"_21483":52100,"_5":14766,"_28195":52020,"_3064":52101},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3608":458,"_31008":423,"_21483":52103,"_5":14766,"_28195":52020,"_3064":52104},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3608":459,"_31008":423,"_21483":52106,"_5":14766,"_28195":52024,"_3064":52107},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3608":460,"_31008":423,"_21483":52109,"_5":14766,"_28195":52024,"_3064":52110},[],"Locate the authz pod and Service.",{"_3608":461,"_31008":423,"_21483":52112,"_5":14766,"_28195":52024,"_3064":52113},[],"Check /health, logs and its database connection.",{"_3608":462,"_31008":423,"_21483":52115,"_5":14766,"_28195":52024,"_3064":52116},[],"Verify the DNS and port configured in externalAuthorization.",{"_3608":463,"_31008":423,"_21483":52118,"_5":14766,"_28195":52024,"_3064":52119},[],"Check the check route is /v1/ext\\_authz/check.",{"_3608":464,"_31008":423,"_21483":52121,"_5":14766,"_28195":52024,"_3064":52122},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3608":465,"_31008":423,"_21483":52124,"_5":14766,"_28195":52028,"_3064":52125},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3608":466,"_31008":423,"_21483":52127,"_5":14766,"_28195":52032,"_3064":52128},[],"Review kubectl describe pod first. Common causes are:",{"_3608":467,"_31008":423,"_21483":52130,"_5":14766,"_28195":52032,"_3064":52131},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3608":468,"_31008":423,"_21483":52133,"_5":14766,"_28195":52032,"_3064":52134},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3608":469,"_31008":423,"_21483":52136,"_5":14766,"_28195":52032,"_3064":52137},[],"unbound persistent volume;",{"_3608":470,"_31008":423,"_21483":52139,"_5":14766,"_28195":52032,"_3064":52140},[],"inaccessible image or incorrect pull policy;",{"_3608":471,"_31008":423,"_21483":52142,"_5":14766,"_28195":52032,"_3064":52143},[],"invalid cryptographic engine configuration;",{"_3608":472,"_31008":423,"_21483":52145,"_5":14766,"_28195":52032,"_3064":52146},[],"CPU or memory limits set too low;",{"_3608":473,"_31008":423,"_21483":52148,"_5":14766,"_28195":52032,"_3064":52149},[],"an incomplete prior migration.",{"_3608":474,"_31008":423,"_21483":52151,"_5":14766,"_28195":52032,"_3064":52152},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3608":475,"_31008":423,"_21483":52154,"_5":14766,"_28195":52032,"_3064":52155},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3608":476,"_31008":423,"_21483":52157,"_5":14766,"_28195":52032,"_3064":52158},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3608":477,"_31008":423,"_21483":52160,"_5":14766,"_28195":52036,"_3064":52161},[],"Domain and audit events depend on the bus publisher:",{"_3608":478,"_31008":423,"_21483":52163,"_5":14766,"_28195":52036,"_3064":52164},[],"verify it is enabled in the emitting service;",{"_3608":479,"_31008":423,"_21483":52166,"_5":14766,"_28195":52036,"_3064":52167},[],"check AMQP connectivity and credentials;",{"_3608":480,"_31008":423,"_21483":52169,"_5":14766,"_28195":52036,"_3064":52170},[],"review exchange, routing key, queues and consumers;",{"_3608":481,"_31008":423,"_21483":52172,"_5":14766,"_28195":52036,"_3064":52173},[],"inspect dead-letter queues;",{"_3608":482,"_31008":423,"_21483":52175,"_5":14766,"_28195":52036,"_3064":52176},[],"alert on orphan durable queues and backlog growth.",{"_3608":483,"_31008":423,"_21483":52178,"_5":14766,"_28195":52036,"_3064":52179},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3608":484,"_31008":423,"_21483":52181,"_5":14766,"_28195":52036,"_3064":52182},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3608":485,"_31008":423,"_21483":52184,"_5":14766,"_28195":52036,"_3064":52185},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3608":486,"_31008":423,"_21483":52187,"_5":14766,"_28195":52036,"_3064":52188},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3608":487,"_31008":423,"_21483":52190,"_5":14766,"_28195":52036,"_3064":52191},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3608":488,"_31008":423,"_21483":52193,"_5":14766,"_28195":52036,"_3064":52194},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3608":489,"_31008":423,"_21483":52196,"_5":14766,"_28195":52036,"_3064":52197},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3608":490,"_31008":423,"_21483":52199,"_5":14766,"_28195":52040,"_3064":52200},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3608":491,"_31008":423,"_21483":52202,"_5":14766,"_28195":52040,"_3064":52203},[],"Before closing an incident, record:",{"_3608":492,"_31008":423,"_21483":52205,"_5":14766,"_28195":52040,"_3064":52206},[],"the confirmed cause;",{"_3608":493,"_31008":423,"_21483":52208,"_5":14766,"_28195":52040,"_3064":52209},[],"the time scope and affected resources;",{"_3608":494,"_31008":423,"_21483":52211,"_5":14766,"_28195":52040,"_3064":52212},[],"the commands or queries used;",{"_3608":495,"_31008":423,"_21483":52214,"_5":14766,"_28195":52040,"_3064":52215},[],"the applied change and how to revert it;",{"_3608":496,"_31008":423,"_21483":52217,"_5":14766,"_28195":52040,"_3064":52218},[],"validation from a consumer;",{"_3608":497,"_31008":423,"_21483":52220,"_5":14766,"_28195":52040,"_3064":52221},[],"the preventive action and its owner.",{"_3608":498,"_31008":498,"_5":15126,"_3064":52223,"_31366":52224,"_21483":52228,"_28195":498},"Data model",[50713,52225,52226,52227],"Platform","Administration","Access control",[],{"_3608":499,"_31008":498,"_21483":52230,"_5":14766,"_28195":498,"_3064":52231},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3608":500,"_31008":498,"_5":31363,"_21483":52233,"_28195":52234,"_3064":52235},[],"/docs/pr-preview/pr-72/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3608":501,"_31008":498,"_5":31363,"_21483":52237,"_28195":52238,"_3064":52239},[],"/docs/pr-preview/pr-72/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3608":502,"_31008":498,"_21483":52241,"_5":14766,"_28195":498,"_3064":52242},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3608":503,"_31008":498,"_21483":52244,"_5":14766,"_28195":52234,"_3064":52245},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3608":504,"_31008":498,"_21483":52247,"_5":14766,"_28195":52234,"_3064":52248},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3608":505,"_31008":498,"_21483":52250,"_5":14766,"_28195":52234,"_3064":52251},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3608":506,"_31008":498,"_21483":52253,"_5":14766,"_28195":52238,"_3064":52254},[],"Entity (`schema_name.entity_type`)",{"_3608":507,"_31008":498,"_21483":52256,"_5":14766,"_28195":52238,"_3064":52257},[],"Table (`table_name`)",{"_3608":508,"_31008":498,"_21483":52259,"_5":14766,"_28195":52238,"_3064":52260},[],"Key (`primary_key`)",{"_3608":509,"_31008":498,"_21483":52262,"_5":14766,"_28195":52238,"_3064":52263},[],"`alerts.event`",{"_3608":510,"_31008":498,"_21483":52265,"_5":14766,"_28195":52238,"_3064":52266},[],"`events`",{"_3608":511,"_31008":498,"_21483":52268,"_5":14766,"_28195":52238,"_3064":52269},[],"`event_type`",{"_3608":512,"_31008":498,"_21483":52271,"_5":14766,"_28195":52238,"_3064":52272},[],"`alerts.subscription`",{"_3608":513,"_31008":498,"_21483":52274,"_5":14766,"_28195":52238,"_3064":52275},[],"`subscriptions`",{"_3608":514,"_31008":498,"_21483":52277,"_5":14766,"_28195":52238,"_3064":52278},[],"`id`",{"_3608":515,"_31008":498,"_21483":52280,"_5":14766,"_28195":52238,"_3064":52281},[],"`ca.ca_certificate`",{"_3608":516,"_31008":498,"_21483":52283,"_5":14766,"_28195":52238,"_3064":52284},[],"`ca_certificates`",{"_3608":517,"_31008":498,"_21483":52286,"_5":14766,"_28195":52238,"_3064":52278},[],{"_3608":518,"_31008":498,"_21483":52288,"_5":14766,"_28195":52238,"_3064":52289},[],"`ca.certificate`",{"_3608":519,"_31008":498,"_21483":52291,"_5":14766,"_28195":52238,"_3064":52292},[],"`certificates`",{"_3608":520,"_31008":498,"_21483":52294,"_5":14766,"_28195":52238,"_3064":52295},[],"`serial_number`",{"_3608":521,"_31008":498,"_21483":52297,"_5":14766,"_28195":52238,"_3064":52298},[],"`ca.issuance_profile`",{"_3608":522,"_31008":498,"_21483":52300,"_5":14766,"_28195":52238,"_3064":52301},[],"`issuance_profiles`",{"_3608":523,"_31008":498,"_21483":52303,"_5":14766,"_28195":52238,"_3064":52278},[],{"_3608":524,"_31008":498,"_21483":52305,"_5":14766,"_28195":52238,"_3064":52306},[],"`devicemanager.device_group`",{"_3608":525,"_31008":498,"_21483":52308,"_5":14766,"_28195":52238,"_3064":52309},[],"`device_groups`",{"_3608":526,"_31008":498,"_21483":52311,"_5":14766,"_28195":52238,"_3064":52278},[],{"_3608":527,"_31008":498,"_21483":52313,"_5":14766,"_28195":52238,"_3064":52314},[],"`devicemanager.device`",{"_3608":528,"_31008":498,"_21483":52316,"_5":14766,"_28195":52238,"_3064":52317},[],"`devices`",{"_3608":529,"_31008":498,"_21483":52319,"_5":14766,"_28195":52238,"_3064":52278},[],{"_3608":530,"_31008":498,"_21483":52321,"_5":14766,"_28195":52238,"_3064":52322},[],"`dmsmanager.dms`",{"_3608":531,"_31008":498,"_21483":52324,"_5":14766,"_28195":52238,"_3064":52325},[],"`dms`",{"_3608":532,"_31008":498,"_21483":52327,"_5":14766,"_28195":52238,"_3064":52278},[],{"_3608":533,"_31008":498,"_21483":52329,"_5":14766,"_28195":52238,"_3064":52330},[],"`kms.kms_key`",{"_3608":534,"_31008":498,"_21483":52332,"_5":14766,"_28195":52238,"_3064":52333},[],"`kms_keys`",{"_3608":535,"_31008":498,"_21483":52335,"_5":14766,"_28195":52238,"_3064":52336},[],"`key_id`, `engine_id`",{"_3608":536,"_31008":498,"_21483":52338,"_5":14766,"_28195":52238,"_3064":52339},[],"`va.crl_settings`",{"_3608":537,"_31008":498,"_21483":52341,"_5":14766,"_28195":52238,"_3064":52342},[],"`crl_settings`",{"_3608":538,"_31008":498,"_21483":52344,"_5":14766,"_28195":52238,"_3064":52345},[],"`ca_id`",{"_3608":539,"_31008":498,"_21483":52347,"_5":14766,"_28195":52238,"_3064":52348},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3608":540,"_31008":498,"_21483":52350,"_5":14766,"_28195":52238,"_3064":52351},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3608":541,"_31008":498,"_21483":52353,"_5":14766,"_28195":52238,"_3064":52354},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3608":542,"_31008":542,"_5":15126,"_3064":52356,"_31366":52357,"_21483":52358,"_28195":542},"Access control overview",[50713,52225,52226,52227],[],{"_3608":543,"_31008":542,"_21483":52360,"_5":14766,"_28195":542,"_3064":52361},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3608":544,"_31008":542,"_5":31363,"_21483":52363,"_28195":52364,"_3064":52365},[],"/docs/pr-preview/pr-72/platform/administration/access-control#essential-concepts","Essential concepts",{"_3608":545,"_31008":542,"_5":31363,"_21483":52367,"_28195":52368,"_3064":52369},[],"/docs/pr-preview/pr-72/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3608":546,"_31008":542,"_5":31363,"_21483":52371,"_28195":52372,"_3064":52373},[],"/docs/pr-preview/pr-72/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3608":547,"_31008":542,"_5":31363,"_21483":52375,"_28195":52376,"_3064":52377},[],"/docs/pr-preview/pr-72/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3608":548,"_31008":542,"_5":31363,"_21483":52379,"_28195":52380,"_3064":52381},[],"/docs/pr-preview/pr-72/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3608":549,"_31008":542,"_5":31363,"_21483":52383,"_28195":52384,"_3064":52385},[],"/docs/pr-preview/pr-72/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3608":550,"_31008":542,"_5":31363,"_21483":52387,"_28195":52388,"_3064":52389},[],"/docs/pr-preview/pr-72/platform/administration/access-control#oidc-principals","OIDC principals",{"_3608":551,"_31008":542,"_5":31363,"_21483":52391,"_28195":52392,"_3064":52393},[],"/docs/pr-preview/pr-72/platform/administration/access-control#x509-principals","X.509 principals",{"_3608":552,"_31008":542,"_5":31363,"_21483":52395,"_28195":52396,"_3064":52397},[],"/docs/pr-preview/pr-72/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3608":553,"_31008":542,"_5":31363,"_21483":52399,"_28195":52400,"_3064":52401},[],"/docs/pr-preview/pr-72/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3608":554,"_31008":542,"_5":31363,"_21483":52403,"_28195":52404,"_3064":52405},[],"/docs/pr-preview/pr-72/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3608":555,"_31008":542,"_5":31363,"_21483":52407,"_28195":52408,"_3064":52409},[],"/docs/pr-preview/pr-72/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3608":556,"_31008":542,"_5":31363,"_21483":52411,"_28195":52412,"_3064":52413},[],"/docs/pr-preview/pr-72/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3608":557,"_31008":542,"_5":31363,"_21483":52415,"_28195":52416,"_3064":52417},[],"/docs/pr-preview/pr-72/platform/administration/access-control#http-rules","HTTP rules",{"_3608":558,"_31008":542,"_5":31363,"_21483":52419,"_28195":52420,"_3064":52421},[],"/docs/pr-preview/pr-72/platform/administration/access-control#included-policies","Included policies",{"_3608":559,"_31008":542,"_5":31363,"_21483":52423,"_28195":52424,"_3064":51363},[],"/docs/pr-preview/pr-72/platform/administration/access-control#provision-the-first-administrator",{"_3608":560,"_31008":542,"_5":31363,"_21483":52426,"_28195":52427,"_3064":52428},[],"/docs/pr-preview/pr-72/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3608":561,"_31008":542,"_5":31363,"_21483":52430,"_28195":52431,"_3064":52432},[],"/docs/pr-preview/pr-72/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3608":562,"_31008":542,"_5":31363,"_21483":52434,"_28195":52435,"_3064":52436},[],"/docs/pr-preview/pr-72/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3608":563,"_31008":542,"_5":31363,"_21483":52438,"_28195":52439,"_3064":52440},[],"/docs/pr-preview/pr-72/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3608":564,"_31008":542,"_5":31363,"_21483":52442,"_28195":52443,"_3064":52444},[],"/docs/pr-preview/pr-72/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3608":565,"_31008":542,"_5":31363,"_21483":52446,"_28195":52447,"_3064":52448},[],"/docs/pr-preview/pr-72/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3608":566,"_31008":542,"_5":31363,"_21483":52450,"_28195":52451,"_3064":52452},[],"/docs/pr-preview/pr-72/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3608":567,"_31008":542,"_5":31363,"_21483":52454,"_28195":52455,"_3064":52456},[],"/docs/pr-preview/pr-72/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3608":568,"_31008":542,"_5":31363,"_21483":52458,"_28195":52459,"_3064":52460},[],"/docs/pr-preview/pr-72/platform/administration/access-control#operational-checklist","Operational checklist",{"_3608":569,"_31008":542,"_5":31363,"_21483":52462,"_28195":52463,"_3064":52464},[],"/docs/pr-preview/pr-72/platform/administration/access-control#diagnostics","Diagnostics",{"_3608":570,"_31008":542,"_5":31363,"_21483":52466,"_28195":52467,"_3064":52468},[],"/docs/pr-preview/pr-72/platform/administration/access-control#the-response-is-401","The response is 401",{"_3608":571,"_31008":542,"_5":31363,"_21483":52470,"_28195":52471,"_3064":52472},[],"/docs/pr-preview/pr-72/platform/administration/access-control#the-response-is-403","The response is 403",{"_3608":572,"_31008":542,"_5":31363,"_21483":52474,"_28195":52475,"_3064":52476},[],"/docs/pr-preview/pr-72/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3608":573,"_31008":542,"_5":31363,"_21483":52478,"_28195":52479,"_3064":52480},[],"/docs/pr-preview/pr-72/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3608":574,"_31008":542,"_5":31363,"_21483":52482,"_28195":52483,"_3064":52484},[],"/docs/pr-preview/pr-72/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3608":575,"_31008":542,"_21483":52486,"_5":14766,"_28195":542,"_3064":52487},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3608":576,"_31008":542,"_21483":52489,"_5":14766,"_28195":542,"_3064":52490},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3608":577,"_31008":542,"_21483":52492,"_5":14766,"_28195":542,"_3064":52493},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3608":578,"_31008":542,"_21483":52495,"_5":14766,"_28195":52364,"_3064":52496},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3608":579,"_31008":542,"_21483":52498,"_5":14766,"_28195":52364,"_3064":52499},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3608":580,"_31008":542,"_21483":52501,"_5":14766,"_28195":52364,"_3064":52502},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3608":581,"_31008":542,"_21483":52504,"_5":14766,"_28195":52364,"_3064":52505},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3608":582,"_31008":542,"_21483":52507,"_5":14766,"_28195":52364,"_3064":52508},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3608":583,"_31008":542,"_21483":52510,"_5":14766,"_28195":52364,"_3064":52511},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3608":584,"_31008":542,"_21483":52513,"_5":14766,"_28195":52368,"_3064":52514},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3608":585,"_31008":542,"_21483":52516,"_5":14766,"_28195":52368,"_3064":52517},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3608":586,"_31008":542,"_21483":52519,"_5":14766,"_28195":52372,"_3064":52520},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3608":587,"_31008":542,"_21483":52522,"_5":14766,"_28195":52372,"_3064":52523},[],"The decision is made **before forwarding the request to the service**:",{"_3608":588,"_31008":542,"_21483":52525,"_5":14766,"_28195":52372,"_3064":52526},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3608":589,"_31008":542,"_21483":52528,"_5":14766,"_28195":52372,"_3064":52529},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3608":590,"_31008":542,"_21483":52531,"_5":14766,"_28195":52372,"_3064":52532},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3608":591,"_31008":542,"_21483":52534,"_5":14766,"_28195":52372,"_3064":52535},[],"It separately loads the policies granted to each principal.",{"_3608":592,"_31008":542,"_21483":52537,"_5":14766,"_28195":52372,"_3064":52538},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3608":593,"_31008":542,"_21483":52540,"_5":14766,"_28195":52372,"_3064":52541},[],"`authz` looks for an HTTP rule granting that action.",{"_3608":594,"_31008":542,"_21483":52543,"_5":14766,"_28195":52372,"_3064":52544},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3608":595,"_31008":542,"_21483":52546,"_5":14766,"_28195":52372,"_3064":52547},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3608":596,"_31008":542,"_21483":52549,"_5":14766,"_28195":52372,"_3064":52550},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3608":597,"_31008":542,"_21483":52552,"_5":14766,"_28195":52372,"_3064":52553},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3608":598,"_31008":542,"_21483":52555,"_5":14766,"_28195":52376,"_3064":52556},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3608":599,"_31008":542,"_21483":52558,"_5":14766,"_28195":52376,"_3064":52559},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3608":600,"_31008":542,"_21483":52561,"_5":14766,"_28195":52376,"_3064":52562},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3608":601,"_31008":542,"_21483":52564,"_5":14766,"_28195":52376,"_3064":52565},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3608":602,"_31008":542,"_21483":52567,"_5":14766,"_28195":52376,"_3064":52568},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3608":603,"_31008":542,"_21483":52570,"_5":14766,"_28195":52376,"_3064":52571},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3608":604,"_31008":542,"_21483":52573,"_5":14766,"_28195":52376,"_3064":52574},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3608":605,"_31008":542,"_21483":52576,"_5":14766,"_28195":52376,"_3064":52577},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3608":606,"_31008":542,"_21483":52579,"_5":14766,"_28195":52376,"_3064":52580},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3608":607,"_31008":542,"_21483":52582,"_5":14766,"_28195":52376,"_3064":52583},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3608":608,"_31008":542,"_21483":52585,"_5":14766,"_28195":52380,"_3064":52586},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3608":609,"_31008":542,"_21483":52588,"_5":14766,"_28195":52380,"_3064":52589},[],"The decision is made with the domain operation context:",{"_3608":610,"_31008":542,"_21483":52591,"_5":14766,"_28195":52380,"_3064":52592},[],"The middleware extracts the credential and resolves the matching principals.",{"_3608":611,"_31008":542,"_21483":52594,"_5":14766,"_28195":52380,"_3064":52595},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3608":612,"_31008":542,"_21483":52597,"_5":14766,"_28195":52380,"_3064":52598},[],"`authz` gathers the entity rules of the granted policies.",{"_3608":613,"_31008":542,"_21483":52600,"_5":14766,"_28195":52380,"_3064":52601},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3608":614,"_31008":542,"_21483":52603,"_5":14766,"_28195":52380,"_3064":52604},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3608":615,"_31008":542,"_21483":52606,"_5":14766,"_28195":52380,"_3064":52607},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3608":616,"_31008":542,"_21483":52609,"_5":14766,"_28195":52380,"_3064":52610},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3608":617,"_31008":542,"_21483":52612,"_5":14766,"_28195":52380,"_3064":52613},[],"Actions fall into two groups:",{"_3608":618,"_31008":542,"_21483":52615,"_5":14766,"_28195":52380,"_3064":52616},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3608":619,"_31008":542,"_21483":52618,"_5":14766,"_28195":52380,"_3064":52619},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3608":620,"_31008":542,"_21483":52621,"_5":14766,"_28195":52380,"_3064":52622},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3608":621,"_31008":542,"_21483":52624,"_5":14766,"_28195":52384,"_3064":52625},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3608":622,"_31008":542,"_21483":52627,"_5":14766,"_28195":52384,"_3064":52628},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3608":623,"_31008":542,"_21483":52630,"_5":14766,"_28195":52384,"_3064":52631},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3608":624,"_31008":542,"_21483":52633,"_5":14766,"_28195":52388,"_3064":52634},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3608":625,"_31008":542,"_21483":52636,"_5":14766,"_28195":52388,"_3064":52637},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3608":626,"_31008":542,"_21483":52639,"_5":14766,"_28195":52388,"_3064":52640},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3608":627,"_31008":542,"_21483":52642,"_5":14766,"_28195":52388,"_3064":52643},[],"The implemented operators are:",{"_3608":628,"_31008":542,"_21483":52645,"_5":14766,"_28195":52388,"_3064":52646},[],"`equals`, for exact equality;",{"_3608":629,"_31008":542,"_21483":52648,"_5":14766,"_28195":52388,"_3064":52649},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3608":630,"_31008":542,"_21483":52651,"_5":14766,"_28195":52388,"_3064":52652},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3608":631,"_31008":542,"_21483":52654,"_5":14766,"_28195":52388,"_3064":52655},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3608":632,"_31008":542,"_21483":52657,"_5":14766,"_28195":52392,"_3064":52658},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3608":633,"_31008":542,"_21483":52660,"_5":14766,"_28195":52392,"_3064":52661},[],"The available modes are:",{"_3608":634,"_31008":542,"_21483":52663,"_5":14766,"_28195":52392,"_3064":52664},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3608":635,"_31008":542,"_21483":52666,"_5":14766,"_28195":52392,"_3064":52667},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3608":636,"_31008":542,"_21483":52669,"_5":14766,"_28195":52392,"_3064":52670},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3608":637,"_31008":542,"_21483":52672,"_5":14766,"_28195":52392,"_3064":52673},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3608":638,"_31008":542,"_21483":52675,"_5":14766,"_28195":52392,"_3064":52676},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3608":639,"_31008":542,"_21483":52678,"_5":14766,"_28195":52392,"_3064":52679},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3608":640,"_31008":542,"_21483":52681,"_5":14766,"_28195":52396,"_3064":52682},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3608":641,"_31008":542,"_21483":52684,"_5":14766,"_28195":52396,"_3064":52685},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3608":642,"_31008":542,"_21483":52687,"_5":14766,"_28195":52396,"_3064":52688},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3608":643,"_31008":542,"_21483":52690,"_5":14766,"_28195":52396,"_3064":52691},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3608":644,"_31008":542,"_21483":52693,"_5":14766,"_28195":52404,"_3064":52694},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3608":645,"_31008":542,"_21483":52696,"_5":14766,"_28195":52404,"_3064":52697},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3608":646,"_31008":542,"_21483":52699,"_5":14766,"_28195":52408,"_3064":52700},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3608":647,"_31008":542,"_21483":52702,"_5":14766,"_28195":52408,"_3064":52703},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3608":648,"_31008":542,"_21483":52705,"_5":14766,"_28195":52408,"_3064":52706},[],"The data model shows how the resources used in entity rules are connected.",{"_3608":649,"_31008":542,"_21483":52708,"_5":14766,"_28195":52408,"_3064":52709},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3608":650,"_31008":542,"_21483":52711,"_5":14766,"_28195":52408,"_3064":52712},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3608":651,"_31008":542,"_21483":52714,"_5":14766,"_28195":52412,"_3064":52715},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3608":652,"_31008":542,"_21483":52717,"_5":14766,"_28195":52412,"_3064":52718},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3608":653,"_31008":542,"_21483":52720,"_5":14766,"_28195":52412,"_3064":52721},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3608":654,"_31008":542,"_21483":52723,"_5":14766,"_28195":52416,"_3064":52724},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3608":655,"_31008":542,"_21483":52726,"_5":14766,"_28195":52416,"_3064":52727},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3608":656,"_31008":542,"_21483":52729,"_5":14766,"_28195":52416,"_3064":52730},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3608":657,"_31008":542,"_21483":52732,"_5":14766,"_28195":52416,"_3064":52733},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3608":658,"_31008":542,"_21483":52735,"_5":14766,"_28195":52416,"_3064":52736},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3608":659,"_31008":542,"_21483":52738,"_5":14766,"_28195":52416,"_3064":52739},[],"Note that:",{"_3608":660,"_31008":542,"_21483":52741,"_5":14766,"_28195":52416,"_3064":52742},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3608":661,"_31008":542,"_21483":52744,"_5":14766,"_28195":52416,"_3064":52745},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3608":662,"_31008":542,"_21483":52747,"_5":14766,"_28195":52416,"_3064":52748},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3608":663,"_31008":542,"_21483":52750,"_5":14766,"_28195":52420,"_3064":52751},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3608":664,"_31008":542,"_21483":52753,"_5":14766,"_28195":52420,"_3064":52754},[],"full and read-only access to certificates and authorities;",{"_3608":665,"_31008":542,"_21483":52756,"_5":14766,"_28195":52420,"_3064":52757},[],"full and read-only access to the KMS;",{"_3608":666,"_31008":542,"_21483":52759,"_5":14766,"_28195":52420,"_3064":52760},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3608":667,"_31008":542,"_21483":52762,"_5":14766,"_28195":52420,"_3064":52763},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3608":668,"_31008":542,"_21483":52765,"_5":14766,"_28195":52420,"_3064":52766},[],"console access;",{"_3608":669,"_31008":542,"_21483":52768,"_5":14766,"_28195":52420,"_3064":52769},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3608":670,"_31008":542,"_21483":52771,"_5":14766,"_28195":52420,"_3064":52772},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3608":671,"_31008":542,"_21483":52774,"_5":14766,"_28195":52420,"_3064":52775},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3608":672,"_31008":542,"_21483":52777,"_5":14766,"_28195":52420,"_3064":52778},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3608":673,"_31008":542,"_21483":52780,"_5":14766,"_28195":52420,"_3064":52781},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3608":674,"_31008":542,"_21483":52783,"_5":14766,"_28195":52424,"_3064":52784},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3608":675,"_31008":542,"_21483":52786,"_5":14766,"_28195":52424,"_3064":52787},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3608":676,"_31008":542,"_21483":52789,"_5":14766,"_28195":52424,"_3064":52790},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3608":677,"_31008":542,"_21483":52792,"_5":14766,"_28195":52427,"_3064":52793},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3608":678,"_31008":542,"_21483":52795,"_5":14766,"_28195":52431,"_3064":52796},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3608":679,"_31008":542,"_21483":52798,"_5":14766,"_28195":52431,"_3064":52799},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3608":680,"_31008":542,"_21483":52801,"_5":14766,"_28195":52435,"_3064":52802},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3608":681,"_31008":542,"_21483":52804,"_5":14766,"_28195":52439,"_3064":52805},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3608":682,"_31008":542,"_21483":52807,"_5":14766,"_28195":52443,"_3064":52808},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3608":683,"_31008":542,"_21483":52810,"_5":14766,"_28195":52447,"_3064":52811},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3608":684,"_31008":542,"_21483":52813,"_5":14766,"_28195":52447,"_3064":52814},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3608":685,"_31008":542,"_21483":52816,"_5":14766,"_28195":52451,"_3064":52817},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3608":686,"_31008":542,"_21483":52819,"_5":14766,"_28195":52451,"_3064":52820},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3608":687,"_31008":542,"_21483":52822,"_5":14766,"_28195":52451,"_3064":52823},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3608":688,"_31008":542,"_21483":52825,"_5":14766,"_28195":52451,"_3064":52826},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3608":689,"_31008":542,"_21483":52828,"_5":14766,"_28195":52451,"_3064":52829},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3608":690,"_31008":542,"_21483":52831,"_5":14766,"_28195":52451,"_3064":52832},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3608":691,"_31008":542,"_21483":52834,"_5":14766,"_28195":52451,"_3064":52835},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3608":692,"_31008":542,"_21483":52837,"_5":14766,"_28195":52451,"_3064":52838},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3608":693,"_31008":542,"_21483":52840,"_5":14766,"_28195":52455,"_3064":52841},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3608":694,"_31008":542,"_21483":52843,"_5":14766,"_28195":52455,"_3064":52844},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3608":695,"_31008":542,"_21483":52846,"_5":14766,"_28195":52455,"_3064":52847},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3608":696,"_31008":542,"_21483":52849,"_5":14766,"_28195":52459,"_3064":52850},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3608":697,"_31008":542,"_21483":52852,"_5":14766,"_28195":52459,"_3064":52853},[],"Use groups or stable roles for people and independent identities for automations.",{"_3608":698,"_31008":542,"_21483":52855,"_5":14766,"_28195":52459,"_3064":52856},[],"Keep at least two recovery administrators and test their access periodically.",{"_3608":699,"_31008":542,"_21483":52858,"_5":14766,"_28195":52459,"_3064":52859},[],"Review active principals, their matches and their grants after IdP changes.",{"_3608":700,"_31008":542,"_21483":52861,"_5":14766,"_28195":52459,"_3064":52862},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3608":701,"_31008":542,"_21483":52864,"_5":14766,"_28195":52459,"_3064":52865},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3608":702,"_31008":542,"_21483":52867,"_5":14766,"_28195":52459,"_3064":52868},[],"Always test one allowed and one denied operation for each role.",{"_3608":703,"_31008":542,"_21483":52870,"_5":14766,"_28195":52459,"_3064":52871},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3608":704,"_31008":542,"_21483":52873,"_5":14766,"_28195":52467,"_3064":52874},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3608":705,"_31008":542,"_21483":52876,"_5":14766,"_28195":52471,"_3064":52877},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3608":706,"_31008":542,"_21483":52879,"_5":14766,"_28195":52471,"_3064":52880},[],"that an active principal of the correct type exists;",{"_3608":707,"_31008":542,"_21483":52882,"_5":14766,"_28195":52471,"_3064":52883},[],"that the claim paths and values match the real token exactly;",{"_3608":708,"_31008":542,"_21483":52885,"_5":14766,"_28195":52471,"_3064":52886},[],"that all of the principal's conditions hold;",{"_3608":709,"_31008":542,"_21483":52888,"_5":14766,"_28195":52471,"_3064":52889},[],"that the principal has the expected policy granted;",{"_3608":710,"_31008":542,"_21483":52891,"_5":14766,"_28195":52471,"_3064":52892},[],"that the policy includes the action and the requested resource type or route;",{"_3608":711,"_31008":542,"_21483":52894,"_5":14766,"_28195":52471,"_3064":52895},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3608":712,"_31008":542,"_21483":52897,"_5":14766,"_28195":52471,"_3064":52898},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3608":713,"_31008":542,"_21483":52900,"_5":14766,"_28195":52471,"_3064":52901},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3608":714,"_31008":542,"_21483":52903,"_5":14766,"_28195":52475,"_3064":52904},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3608":715,"_31008":542,"_21483":52906,"_5":14766,"_28195":52479,"_3064":52907},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3608":716,"_31008":542,"_21483":52909,"_5":14766,"_28195":52483,"_3064":52910},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3608":717,"_31008":542,"_21483":52912,"_5":14766,"_28195":52483,"_3064":52913},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3608":718,"_31008":718,"_5":15126,"_3064":52915,"_31366":52916,"_21483":52917,"_28195":718},"Alerts and subscriptions",[50713,52225,52226],[],{"_3608":719,"_31008":718,"_21483":52919,"_5":14766,"_28195":718,"_3064":52920},[],"Send PKI events to people and external systems.",{"_3608":720,"_31008":718,"_5":31363,"_21483":52922,"_28195":52923,"_3064":52924},[],"/docs/pr-preview/pr-72/platform/administration/alerts#how-it-works","How it works",{"_3608":721,"_31008":718,"_5":31363,"_21483":52926,"_28195":52927,"_3064":52928},[],"/docs/pr-preview/pr-72/platform/administration/alerts#available-channels","Available channels",{"_3608":722,"_31008":718,"_5":31363,"_21483":52930,"_28195":52931,"_3064":52932},[],"/docs/pr-preview/pr-72/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3608":723,"_31008":718,"_5":31363,"_21483":52934,"_28195":52935,"_3064":52936},[],"/docs/pr-preview/pr-72/platform/administration/alerts#choose-the-event","Choose the event",{"_3608":724,"_31008":718,"_5":31363,"_21483":52938,"_28195":52939,"_3064":52940},[],"/docs/pr-preview/pr-72/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3608":725,"_31008":718,"_5":31363,"_21483":52942,"_28195":52943,"_3064":52944},[],"/docs/pr-preview/pr-72/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3608":726,"_31008":718,"_5":31363,"_21483":52946,"_28195":52947,"_3064":52948},[],"/docs/pr-preview/pr-72/platform/administration/alerts#review-and-activate","Review and activate",{"_3608":727,"_31008":718,"_5":31363,"_21483":52950,"_28195":52951,"_3064":52952},[],"/docs/pr-preview/pr-72/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3608":728,"_31008":718,"_5":31363,"_21483":52954,"_28195":52955,"_3064":52956},[],"/docs/pr-preview/pr-72/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3608":729,"_31008":718,"_5":31363,"_21483":52958,"_28195":52959,"_3064":52960},[],"/docs/pr-preview/pr-72/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3608":730,"_31008":718,"_5":31363,"_21483":52962,"_28195":52963,"_3064":52964},[],"/docs/pr-preview/pr-72/platform/administration/alerts#event-families","Event families",{"_3608":731,"_31008":718,"_21483":52966,"_5":14766,"_28195":718,"_3064":52967},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3608":732,"_31008":718,"_21483":52969,"_5":14766,"_28195":52923,"_3064":52970},[],"A service publishes a domain event.",{"_3608":733,"_31008":718,"_21483":52972,"_5":14766,"_28195":52923,"_3064":52973},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3608":734,"_31008":718,"_21483":52975,"_5":14766,"_28195":52923,"_3064":52976},[],"Each subscription's filter decides whether it should be notified.",{"_3608":735,"_31008":718,"_21483":52978,"_5":14766,"_28195":52923,"_3064":52979},[],"Lamassu delivers the event to the configured channel.",{"_3608":736,"_31008":718,"_21483":52981,"_5":14766,"_28195":52923,"_3064":52982},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3608":737,"_31008":718,"_21483":52984,"_5":14766,"_28195":52927,"_3064":52985},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3608":738,"_31008":718,"_21483":52987,"_5":14766,"_28195":52927,"_3064":52988},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3608":739,"_31008":718,"_21483":52990,"_5":14766,"_28195":52927,"_3064":52991},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3608":740,"_31008":718,"_21483":52993,"_5":14766,"_28195":52927,"_3064":52994},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3608":741,"_31008":718,"_21483":52996,"_5":14766,"_28195":52927,"_3064":52997},[],"`apikey_options` requires `header` and `key`.",{"_3608":742,"_31008":718,"_21483":52999,"_5":14766,"_28195":52927,"_3064":53000},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3608":743,"_31008":718,"_21483":53002,"_5":14766,"_28195":52927,"_3064":53003},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3608":744,"_31008":718,"_21483":53005,"_5":14766,"_28195":52927,"_3064":53006},[],"The alerts API reference documents the full `http_client` schema.",{"_3608":745,"_31008":718,"_21483":53008,"_5":14766,"_28195":52935,"_3064":53009},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3608":746,"_31008":718,"_21483":53011,"_5":14766,"_28195":52939,"_3064":53012},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3608":747,"_31008":718,"_21483":53014,"_5":14766,"_28195":52943,"_3064":53015},[],"Add a filter if you don't want to receive every instance of the event.",{"_3608":748,"_31008":718,"_21483":53017,"_5":14766,"_28195":52943,"_3064":53018},[],"**None** notifies all instances of the event.",{"_3608":749,"_31008":718,"_21483":53020,"_5":14766,"_28195":52943,"_3064":53021},[],"**JSON Path** evaluates one or more specific fields.",{"_3608":750,"_31008":718,"_21483":53023,"_5":14766,"_28195":52943,"_3064":53024},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3608":751,"_31008":718,"_21483":53026,"_5":14766,"_28195":52943,"_3064":53027},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3608":752,"_31008":718,"_21483":53029,"_5":14766,"_28195":52943,"_3064":53030},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3608":753,"_31008":718,"_21483":53032,"_5":14766,"_28195":52943,"_3064":53033},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3608":754,"_31008":718,"_21483":53035,"_5":14766,"_28195":52947,"_3064":53036},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3608":755,"_31008":718,"_21483":53038,"_5":14766,"_28195":52951,"_3064":53039},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3608":756,"_31008":718,"_21483":53041,"_5":14766,"_28195":52951,"_3064":53042},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3608":757,"_31008":718,"_21483":53044,"_5":14766,"_28195":52951,"_3064":53045},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3608":758,"_31008":718,"_21483":53047,"_5":14766,"_28195":52951,"_3064":53048},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3608":759,"_31008":718,"_21483":53050,"_5":14766,"_28195":52951,"_3064":53051},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3608":760,"_31008":718,"_21483":53053,"_5":14766,"_28195":52951,"_3064":53054},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3608":761,"_31008":718,"_21483":53056,"_5":14766,"_28195":52951,"_3064":53057},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3608":762,"_31008":718,"_21483":53059,"_5":14766,"_28195":52951,"_3064":53060},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3608":763,"_31008":718,"_21483":53062,"_5":14766,"_28195":52955,"_3064":53063},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3608":764,"_31008":718,"_21483":53065,"_5":14766,"_28195":52955,"_3064":53066},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3608":765,"_31008":718,"_21483":53068,"_5":14766,"_28195":52955,"_3064":53069},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3608":766,"_31008":718,"_21483":53071,"_5":14766,"_28195":52955,"_3064":53072},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3608":767,"_31008":718,"_21483":53074,"_5":14766,"_28195":52955,"_3064":53075},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3608":768,"_31008":718,"_21483":53077,"_5":14766,"_28195":52955,"_3064":53078},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3608":769,"_31008":718,"_21483":53080,"_5":14766,"_28195":52955,"_3064":53081},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3608":770,"_31008":718,"_21483":53083,"_5":14766,"_28195":52955,"_3064":53084},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3608":771,"_31008":718,"_21483":53086,"_5":14766,"_28195":52959,"_3064":53087},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3608":772,"_31008":718,"_21483":53089,"_5":14766,"_28195":52959,"_3064":53090},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3608":773,"_31008":718,"_21483":53092,"_5":14766,"_28195":52963,"_3064":53093},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3608":774,"_31008":718,"_21483":53095,"_5":14766,"_28195":52963,"_3064":53096},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3608":775,"_31008":718,"_21483":53098,"_5":14766,"_28195":52963,"_3064":53099},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3608":776,"_31008":718,"_21483":53101,"_5":14766,"_28195":52963,"_3064":53102},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3608":777,"_31008":718,"_21483":53104,"_5":14766,"_28195":52963,"_3064":53105},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3608":778,"_31008":718,"_21483":53107,"_5":14766,"_28195":52963,"_3064":53108},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3608":779,"_31008":718,"_21483":53110,"_5":14766,"_28195":52963,"_3064":53111},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3608":780,"_31008":718,"_21483":53113,"_5":14766,"_28195":52963,"_3064":53114},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3608":781,"_31008":718,"_21483":53116,"_5":14766,"_28195":52963,"_3064":53117},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3608":782,"_31008":718,"_21483":53119,"_5":14766,"_28195":52963,"_3064":53120},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3608":783,"_31008":783,"_5":15126,"_3064":53122,"_31366":53123,"_21483":53124,"_28195":783},"Audit logs",[50713,52225,52226],[],{"_3608":784,"_31008":783,"_21483":53126,"_5":14766,"_28195":783,"_3064":53127},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3608":785,"_31008":783,"_5":31363,"_21483":53129,"_28195":53130,"_3064":53131},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3608":786,"_31008":783,"_5":31363,"_21483":53133,"_28195":53134,"_3064":53135},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#coverage","Coverage",{"_3608":787,"_31008":783,"_5":31363,"_21483":53137,"_28195":53138,"_3064":53139},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3608":788,"_31008":783,"_5":31363,"_21483":53141,"_28195":53142,"_3064":53143},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3608":789,"_31008":783,"_5":31363,"_21483":53145,"_28195":53146,"_3064":53147},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3608":790,"_31008":783,"_5":31363,"_21483":53149,"_28195":53150,"_3064":53151},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3608":791,"_31008":783,"_5":31363,"_21483":53153,"_28195":53154,"_3064":53155},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3608":792,"_31008":783,"_5":31363,"_21483":53157,"_28195":53158,"_3064":53159},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3608":793,"_31008":783,"_5":31363,"_21483":53161,"_28195":53162,"_3064":53163},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3608":794,"_31008":783,"_5":31363,"_21483":53165,"_28195":53166,"_3064":53167},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3608":795,"_31008":783,"_5":31363,"_21483":53169,"_28195":53170,"_3064":53171},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3608":796,"_31008":783,"_21483":53173,"_5":14766,"_28195":783,"_3064":53174},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3608":797,"_31008":783,"_21483":53176,"_5":14766,"_28195":53130,"_3064":53177},[],"The audit body includes:",{"_3608":798,"_31008":783,"_21483":53179,"_5":14766,"_28195":53130,"_3064":53180},[],"input: data received by the operation;",{"_3608":799,"_31008":783,"_21483":53182,"_5":14766,"_28195":53130,"_3064":53183},[],"has\\_error: whether the service returned an error;",{"_3608":800,"_31008":783,"_21483":53185,"_5":14766,"_28195":53130,"_3064":53186},[],"output: produced result or error message;",{"_3608":801,"_31008":783,"_21483":53188,"_5":14766,"_28195":53130,"_3064":53189},[],"principals: identifiers of the principals that matched the request.",{"_3608":802,"_31008":783,"_21483":53191,"_5":14766,"_28195":53130,"_3064":53192},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3608":803,"_31008":783,"_21483":53194,"_5":14766,"_28195":53130,"_3064":53195},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3608":804,"_31008":783,"_21483":53197,"_5":14766,"_28195":53134,"_3064":53198},[],"The backend applies auditing to mutations of:",{"_3608":805,"_31008":783,"_21483":53200,"_5":14766,"_28195":53134,"_3064":53201},[],"authorities, certificates and issuance profiles;",{"_3608":806,"_31008":783,"_21483":53203,"_5":14766,"_28195":53134,"_3064":53204},[],"keys and KMS engines;",{"_3608":807,"_31008":783,"_21483":53206,"_5":14766,"_28195":53134,"_3064":53207},[],"devices and identities;",{"_3608":808,"_31008":783,"_21483":53209,"_5":14766,"_28195":53134,"_3064":53210},[],"DMSs and enrollment operations;",{"_3608":809,"_31008":783,"_21483":53212,"_5":14766,"_28195":53134,"_3064":53213},[],"validation functions and CRL;",{"_3608":810,"_31008":783,"_21483":53215,"_5":14766,"_28195":53134,"_3064":53216},[],"principals, policies and authorization grants.",{"_3608":811,"_31008":783,"_21483":53218,"_5":14766,"_28195":53134,"_3064":53219},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3608":812,"_31008":783,"_21483":53221,"_5":14766,"_28195":53138,"_3064":53222},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3608":813,"_31008":783,"_21483":53224,"_5":14766,"_28195":53138,"_3064":53225},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3608":814,"_31008":783,"_21483":53227,"_5":14766,"_28195":53138,"_3064":53228},[],"Design the consumer to:",{"_3608":815,"_31008":783,"_21483":53230,"_5":14766,"_28195":53138,"_3064":53231},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3608":816,"_31008":783,"_21483":53233,"_5":14766,"_28195":53138,"_3064":53234},[],"keep the complete CloudEvent unmodified;",{"_3608":817,"_31008":783,"_21483":53236,"_5":14766,"_28195":53138,"_3064":53237},[],"record the ingestion time and detect duplicates by ID;",{"_3608":818,"_31008":783,"_21483":53239,"_5":14766,"_28195":53138,"_3064":53240},[],"encrypt in transit and at rest;",{"_3608":819,"_31008":783,"_21483":53242,"_5":14766,"_28195":53138,"_3064":53243},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3608":820,"_31008":783,"_21483":53245,"_5":14766,"_28195":53138,"_3064":53246},[],"apply an explicit retention and legal hold policy;",{"_3608":821,"_31008":783,"_21483":53248,"_5":14766,"_28195":53138,"_3064":53249},[],"alert if it stops consuming or the pending queue grows.",{"_3608":822,"_31008":783,"_21483":53251,"_5":14766,"_28195":53142,"_3064":53252},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3608":823,"_31008":783,"_21483":53254,"_5":14766,"_28195":53142,"_3064":53255},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3608":824,"_31008":783,"_21483":53257,"_5":14766,"_28195":53150,"_3064":53258},[],"Start from the reported time and normalize every source to UTC.",{"_3608":825,"_31008":783,"_21483":53260,"_5":14766,"_28195":53154,"_3064":53261},[],"Filter by event type, service source and resource identifier.",{"_3608":826,"_31008":783,"_21483":53263,"_5":14766,"_28195":53158,"_3064":53264},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3608":827,"_31008":783,"_21483":53266,"_5":14766,"_28195":53162,"_3064":53267},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3608":828,"_31008":783,"_21483":53269,"_5":14766,"_28195":53166,"_3064":53270},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3608":829,"_31008":783,"_21483":53272,"_5":14766,"_28195":53170,"_3064":53273},[],"Generate a controlled mutation in a test environment and check that:",{"_3608":830,"_31008":783,"_21483":53275,"_5":14766,"_28195":53170,"_3064":53276},[],"a successful audit event appears;",{"_3608":831,"_31008":783,"_21483":53278,"_5":14766,"_28195":53170,"_3064":53279},[],"the principal matches the identity used;",{"_3608":832,"_31008":783,"_21483":53281,"_5":14766,"_28195":53170,"_3064":53282},[],"the consumer persists it exactly once;",{"_3608":833,"_31008":783,"_21483":53284,"_5":14766,"_28195":53170,"_3064":53285},[],"it can be retrieved by resource, actor and period;",{"_3608":834,"_31008":783,"_21483":53287,"_5":14766,"_28195":53170,"_3064":53288},[],"a consumer outage raises an alert.",{"_3608":835,"_31008":783,"_21483":53290,"_5":14766,"_28195":53170,"_3064":53291},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3608":836,"_31008":836,"_5":15126,"_3064":53293,"_31366":53294,"_21483":53295,"_28195":836},"Platform architecture",[50713,52225],[],{"_3608":837,"_31008":836,"_21483":53297,"_5":14766,"_28195":836,"_3064":53298},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3608":838,"_31008":836,"_5":31363,"_21483":53300,"_28195":53301,"_3064":53302},[],"/docs/pr-preview/pr-72/platform/concepts/architecture#control-plane","Control plane",{"_3608":839,"_31008":836,"_5":31363,"_21483":53304,"_28195":53305,"_3064":53306},[],"/docs/pr-preview/pr-72/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3608":840,"_31008":836,"_5":31363,"_21483":53308,"_28195":53309,"_3064":53310},[],"/docs/pr-preview/pr-72/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3608":841,"_31008":836,"_5":31363,"_21483":53312,"_28195":53313,"_3064":53314},[],"/docs/pr-preview/pr-72/platform/concepts/architecture#status-and-validation","Status and validation",{"_3608":842,"_31008":836,"_5":31363,"_21483":53316,"_28195":53317,"_3064":53318},[],"/docs/pr-preview/pr-72/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3608":843,"_31008":836,"_21483":53320,"_5":14766,"_28195":836,"_3064":53321},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3608":844,"_31008":836,"_21483":53323,"_5":14766,"_28195":836,"_3064":53324},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3608":845,"_31008":836,"_21483":53326,"_5":14766,"_28195":53301,"_3064":53327},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3608":846,"_31008":836,"_21483":53329,"_5":14766,"_28195":53305,"_3064":53330},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3608":847,"_31008":836,"_21483":53332,"_5":14766,"_28195":53309,"_3064":53333},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3608":848,"_31008":836,"_21483":53335,"_5":14766,"_28195":53313,"_3064":53336},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3608":849,"_31008":836,"_21483":53338,"_5":14766,"_28195":53317,"_3064":53339},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3608":850,"_31008":850,"_5":15126,"_3064":53341,"_31366":53342,"_21483":53343,"_28195":850},"How Lamassu works",[50713,52225],[],{"_3608":851,"_31008":850,"_21483":53345,"_5":14766,"_28195":850,"_3064":53346},[],"The mental model of trust, keys, certificates and devices.",{"_3608":852,"_31008":850,"_5":31363,"_21483":53348,"_28195":53349,"_3064":53350},[],"/docs/pr-preview/pr-72/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3608":853,"_31008":850,"_5":31363,"_21483":53352,"_28195":53353,"_3064":53354},[],"/docs/pr-preview/pr-72/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3608":854,"_31008":850,"_21483":53356,"_5":14766,"_28195":850,"_3064":53357},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3608":855,"_31008":850,"_21483":53359,"_5":14766,"_28195":53349,"_3064":53360},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3608":856,"_31008":850,"_21483":53362,"_5":14766,"_28195":53349,"_3064":53363},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3608":857,"_31008":850,"_21483":53365,"_5":14766,"_28195":53349,"_3064":53366},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3608":858,"_31008":850,"_21483":53368,"_5":14766,"_28195":53349,"_3064":53369},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3608":859,"_31008":850,"_21483":53371,"_5":14766,"_28195":53349,"_3064":53372},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3608":860,"_31008":850,"_21483":53374,"_5":14766,"_28195":53353,"_3064":53375},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3608":861,"_31008":850,"_21483":53377,"_5":14766,"_28195":53353,"_3064":53378},[],"A DMS relates that CA to an enrollment policy.",{"_3608":862,"_31008":850,"_21483":53380,"_5":14766,"_28195":53353,"_3064":53381},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3608":863,"_31008":850,"_21483":53383,"_5":14766,"_28195":53353,"_3064":53384},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3608":864,"_31008":850,"_21483":53386,"_5":14766,"_28195":53353,"_3064":53387},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3608":865,"_31008":850,"_21483":53389,"_5":14766,"_28195":53353,"_3064":53390},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3608":866,"_31008":850,"_21483":53392,"_5":14766,"_28195":53353,"_3064":53393},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3608":867,"_31008":867,"_5":15126,"_3064":53395,"_31366":53396,"_21483":53398,"_28195":867},"Devices and identities",[50713,52225,53397,53395],"IoT Fleets",[],{"_3608":868,"_31008":867,"_21483":53400,"_5":14766,"_28195":867,"_3064":53401},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3608":869,"_31008":867,"_5":31363,"_21483":53403,"_28195":53404,"_3064":53405},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#device-states","Device states",{"_3608":870,"_31008":867,"_5":31363,"_21483":53407,"_28195":53408,"_3064":53409},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3608":871,"_31008":867,"_5":31363,"_21483":53411,"_28195":53412,"_3064":53413},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3608":872,"_31008":867,"_5":31363,"_21483":53415,"_28195":53416,"_3064":53417},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3608":873,"_31008":867,"_5":31363,"_21483":53419,"_28195":53420,"_3064":53421},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3608":874,"_31008":867,"_5":31363,"_21483":53423,"_28195":53424,"_3064":53425},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3608":875,"_31008":867,"_5":31363,"_21483":53427,"_28195":53428,"_3064":53429},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3608":876,"_31008":867,"_5":31363,"_21483":53431,"_28195":53432,"_3064":53433},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3608":877,"_31008":867,"_5":31363,"_21483":53435,"_28195":53436,"_3064":53437},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3608":878,"_31008":867,"_5":31363,"_21483":53439,"_28195":53440,"_3064":53441},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3608":879,"_31008":867,"_5":31363,"_21483":53443,"_28195":53444,"_3064":53445},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3608":880,"_31008":867,"_21483":53447,"_5":14766,"_28195":867,"_3064":53448},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3608":881,"_31008":867,"_21483":53450,"_5":14766,"_28195":867,"_3064":53451},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3608":882,"_31008":867,"_21483":53453,"_5":14766,"_28195":53404,"_3064":53454},[],"Operational view",{"_3608":883,"_31008":867,"_21483":53456,"_5":14766,"_28195":53404,"_3064":53457},[],"Meaning",{"_3608":884,"_31008":867,"_21483":53459,"_5":14766,"_28195":53404,"_3064":53460},[],"**No Identity**",{"_3608":885,"_31008":867,"_21483":53462,"_5":14766,"_28195":53404,"_3064":53463},[],"A record exists without an associated identity.",{"_3608":886,"_31008":867,"_21483":53465,"_5":14766,"_28195":53404,"_3064":53466},[],"**Active**",{"_3608":887,"_31008":867,"_21483":53468,"_5":14766,"_28195":53404,"_3064":53469},[],"The slot is active; also check certificate dates, status and usages.",{"_3608":888,"_31008":867,"_21483":53471,"_5":14766,"_28195":53404,"_3064":53472},[],"**Renewal Pending**",{"_3608":889,"_31008":867,"_21483":53474,"_5":14766,"_28195":53404,"_3064":53475},[],"The identity is in the operational renewal window.",{"_3608":890,"_31008":867,"_21483":53477,"_5":14766,"_28195":53404,"_3064":53478},[],"**Expiring Soon**",{"_3608":891,"_31008":867,"_21483":53480,"_5":14766,"_28195":53404,"_3064":53481},[],"Expiration is approaching according to configured thresholds.",{"_3608":892,"_31008":867,"_21483":53483,"_5":14766,"_28195":53404,"_3064":53484},[],"**Expired**",{"_3608":893,"_31008":867,"_21483":53486,"_5":14766,"_28195":53404,"_3064":53487},[],"The identity has expired.",{"_3608":894,"_31008":867,"_21483":53489,"_5":14766,"_28195":53404,"_3064":53490},[],"**Revoked**",{"_3608":895,"_31008":867,"_21483":53492,"_5":14766,"_28195":53404,"_3064":53493},[],"The identity is marked revoked.",{"_3608":896,"_31008":867,"_21483":53495,"_5":14766,"_28195":53404,"_3064":53496},[],"**Decommissioned**",{"_3608":897,"_31008":867,"_21483":53498,"_5":14766,"_28195":53404,"_3064":53499},[],"The record is retired and ordinary updates do not restore operation.",{"_3608":898,"_31008":867,"_21483":53501,"_5":14766,"_28195":53404,"_3064":53502},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3608":899,"_31008":867,"_21483":53504,"_5":14766,"_28195":53408,"_3064":53505},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3608":900,"_31008":867,"_21483":53507,"_5":14766,"_28195":53408,"_3064":53508},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3608":901,"_31008":867,"_21483":53510,"_5":14766,"_28195":53408,"_3064":53511},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3608":902,"_31008":867,"_21483":53513,"_5":14766,"_28195":53408,"_3064":53514},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3608":903,"_31008":867,"_21483":53516,"_5":14766,"_28195":53412,"_3064":53517},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3608":904,"_31008":867,"_21483":53519,"_5":14766,"_28195":53416,"_3064":53520},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3608":905,"_31008":867,"_21483":53522,"_5":14766,"_28195":53420,"_3064":53523},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3608":906,"_31008":867,"_21483":53525,"_5":14766,"_28195":53424,"_3064":53526},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3608":907,"_31008":867,"_21483":53528,"_5":14766,"_28195":53428,"_3064":53529},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3608":908,"_31008":867,"_21483":53531,"_5":14766,"_28195":53428,"_3064":53532},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3608":909,"_31008":867,"_21483":53534,"_5":14766,"_28195":53432,"_3064":53535},[],"From **No Identity**, use **Assign Identity**:",{"_3608":910,"_31008":867,"_21483":53537,"_5":14766,"_28195":53432,"_3064":53538},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3608":911,"_31008":867,"_21483":53540,"_5":14766,"_28195":53432,"_3064":53541},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3608":912,"_31008":867,"_21483":53543,"_5":14766,"_28195":53432,"_3064":53544},[],"Confirm and read the serial, active version and history again.",{"_3608":913,"_31008":867,"_21483":53546,"_5":14766,"_28195":53432,"_3064":53547},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3608":914,"_31008":867,"_21483":53549,"_5":14766,"_28195":53432,"_3064":53550},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3608":915,"_31008":867,"_21483":53552,"_5":14766,"_28195":53436,"_3064":53553},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3608":916,"_31008":867,"_21483":53555,"_5":14766,"_28195":53436,"_3064":53556},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3608":917,"_31008":867,"_21483":53558,"_5":14766,"_28195":53440,"_3064":53559},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3608":918,"_31008":867,"_21483":53561,"_5":14766,"_28195":53440,"_3064":53562},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3608":919,"_31008":867,"_21483":53564,"_5":14766,"_28195":53440,"_3064":53565},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3608":920,"_31008":867,"_21483":53567,"_5":14766,"_28195":53440,"_3064":53568},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3608":921,"_31008":867,"_21483":53570,"_5":14766,"_28195":53444,"_3064":53571},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3608":922,"_31008":867,"_21483":53573,"_5":14766,"_28195":53444,"_3064":53574},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3608":923,"_31008":923,"_5":15126,"_3064":53576,"_31366":53577,"_21483":53579,"_28195":923},"Bootstrap identity and authentication",[50713,52225,53397,53395,53578],"Enrollment with PKI",[],{"_3608":924,"_31008":923,"_21483":53581,"_5":14766,"_28195":923,"_3064":53582},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3608":925,"_31008":923,"_5":31363,"_21483":53584,"_28195":53585,"_3064":53586},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3608":926,"_31008":923,"_5":31363,"_21483":53588,"_28195":53589,"_3064":53590},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3608":927,"_31008":923,"_5":31363,"_21483":53592,"_28195":53593,"_3064":53594},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3608":928,"_31008":923,"_5":31363,"_21483":53596,"_28195":53597,"_3064":53598},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3608":929,"_31008":923,"_5":31363,"_21483":53600,"_28195":53601,"_3064":53602},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3608":930,"_31008":923,"_21483":53604,"_5":14766,"_28195":923,"_3064":53605},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3608":931,"_31008":923,"_21483":53607,"_5":14766,"_28195":53585,"_3064":53608},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3608":932,"_31008":923,"_21483":53610,"_5":14766,"_28195":53585,"_3064":53611},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3608":933,"_31008":923,"_21483":53613,"_5":14766,"_28195":53589,"_3064":53614},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3608":934,"_31008":923,"_21483":53616,"_5":14766,"_28195":53589,"_3064":53617},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3608":935,"_31008":923,"_21483":53619,"_5":14766,"_28195":53589,"_3064":53620},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3608":936,"_31008":923,"_21483":53622,"_5":14766,"_28195":53593,"_3064":53623},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3608":937,"_31008":923,"_21483":53625,"_5":14766,"_28195":53593,"_3064":53626},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3608":938,"_31008":923,"_21483":53628,"_5":14766,"_28195":53597,"_3064":53629},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3608":939,"_31008":923,"_21483":53631,"_5":14766,"_28195":53597,"_3064":53632},[],"Example body:",{"_3608":940,"_31008":923,"_21483":53634,"_5":14766,"_28195":53597,"_3064":53635},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3608":941,"_31008":923,"_21483":53637,"_5":14766,"_28195":53597,"_3064":53638},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3608":942,"_31008":923,"_21483":53640,"_5":14766,"_28195":53597,"_3064":53641},[],"Continuation requires a successful HTTP response and JSON:",{"_3608":943,"_31008":923,"_21483":53643,"_5":14766,"_28195":53597,"_3064":53644},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3608":944,"_31008":923,"_21483":53646,"_5":14766,"_28195":53601,"_3064":53647},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3608":945,"_31008":923,"_21483":53649,"_5":14766,"_28195":53601,"_3064":53650},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3608":946,"_31008":946,"_5":15126,"_3064":53652,"_31366":53653,"_21483":53654,"_28195":946},"Configure and operate the DMS",[50713,52225,53397,53395,53578],[],{"_3608":947,"_31008":946,"_21483":53656,"_5":14766,"_28195":946,"_3064":53657},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3608":948,"_31008":946,"_5":31363,"_21483":53659,"_28195":53660,"_3064":50723},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3608":949,"_31008":946,"_5":31363,"_21483":53662,"_28195":53663,"_3064":53664},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3608":950,"_31008":946,"_5":31363,"_21483":53666,"_28195":53667,"_3064":53668},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3608":951,"_31008":946,"_5":31363,"_21483":53670,"_28195":53671,"_3064":53672},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3608":952,"_31008":946,"_5":31363,"_21483":53674,"_28195":53675,"_3064":53676},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3608":953,"_31008":946,"_5":31363,"_21483":53678,"_28195":53679,"_3064":53680},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3608":954,"_31008":946,"_5":31363,"_21483":53682,"_28195":53683,"_3064":53684},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3608":955,"_31008":946,"_5":31363,"_21483":53686,"_28195":53687,"_3064":53688},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3608":956,"_31008":946,"_5":31363,"_21483":53690,"_28195":53691,"_3064":53692},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3608":957,"_31008":946,"_5":31363,"_21483":53694,"_28195":53695,"_3064":53696},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3608":958,"_31008":946,"_5":31363,"_21483":53698,"_28195":53699,"_3064":53700},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3608":959,"_31008":946,"_5":31363,"_21483":53702,"_28195":53703,"_3064":53704},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3608":960,"_31008":946,"_5":31363,"_21483":53706,"_28195":53707,"_3064":53708},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3608":961,"_31008":946,"_5":31363,"_21483":53710,"_28195":53711,"_3064":53712},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3608":962,"_31008":946,"_5":31363,"_21483":53714,"_28195":53715,"_3064":53716},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3608":963,"_31008":946,"_5":31363,"_21483":53718,"_28195":53719,"_3064":53720},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3608":964,"_31008":946,"_5":31363,"_21483":53722,"_28195":53723,"_3064":53724},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3608":965,"_31008":946,"_5":31363,"_21483":53726,"_28195":53727,"_3064":53728},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3608":966,"_31008":946,"_21483":53730,"_5":14766,"_28195":946,"_3064":53731},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3608":967,"_31008":946,"_21483":53733,"_5":14766,"_28195":53660,"_3064":53734},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3608":968,"_31008":946,"_21483":53736,"_5":14766,"_28195":53660,"_3064":53737},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3608":969,"_31008":946,"_21483":53739,"_5":14766,"_28195":53667,"_3064":53740},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3608":970,"_31008":946,"_21483":53742,"_5":14766,"_28195":53671,"_3064":53743},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3608":971,"_31008":946,"_21483":53745,"_5":14766,"_28195":53675,"_3064":53746},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3608":972,"_31008":946,"_21483":53748,"_5":14766,"_28195":53679,"_3064":53749},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3608":973,"_31008":946,"_21483":53751,"_5":14766,"_28195":53683,"_3064":53752},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3608":974,"_31008":946,"_21483":53754,"_5":14766,"_28195":53691,"_3064":53755},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3608":975,"_31008":946,"_21483":53757,"_5":14766,"_28195":53691,"_3064":53758},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3608":976,"_31008":946,"_21483":53760,"_5":14766,"_28195":53695,"_3064":53761},[],"`settings.enrollment_settings` field",{"_3608":977,"_31008":946,"_21483":53763,"_5":14766,"_28195":53695,"_3064":53764},[],"Decision",{"_3608":978,"_31008":946,"_21483":53766,"_5":14766,"_28195":53695,"_3064":53767},[],"`protocol`",{"_3608":979,"_31008":946,"_21483":53769,"_5":14766,"_28195":53695,"_3064":53770},[],"`EST_RFC7030` for these operations.",{"_3608":980,"_31008":946,"_21483":53772,"_5":14766,"_28195":53695,"_3064":53773},[],"`enrollment_ca`",{"_3608":981,"_31008":946,"_21483":53775,"_5":14766,"_28195":53695,"_3064":53776},[],"ID of the signing CA.",{"_3608":982,"_31008":946,"_21483":53778,"_5":14766,"_28195":53695,"_3064":53779},[],"`verify_csr_signature`",{"_3608":983,"_31008":946,"_21483":53781,"_5":14766,"_28195":53695,"_3064":53782},[],"Keep `true` to verify CSR key possession.",{"_3608":984,"_31008":946,"_21483":53784,"_5":14766,"_28195":53695,"_3064":53785},[],"`enable_replaceable_enrollment`",{"_3608":985,"_31008":946,"_21483":53787,"_5":14766,"_28195":53695,"_3064":53788},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3608":986,"_31008":946,"_21483":53790,"_5":14766,"_28195":53695,"_3064":53791},[],"`est_rfc7030_settings.auth_mode`",{"_3608":987,"_31008":946,"_21483":53793,"_5":14766,"_28195":53695,"_3064":53794},[],"One of the four authentication modes.",{"_3608":988,"_31008":946,"_21483":53796,"_5":14766,"_28195":53695,"_3064":53797},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3608":989,"_31008":946,"_21483":53799,"_5":14766,"_28195":53699,"_3064":53800},[],"The blocks are independent:",{"_3608":990,"_31008":946,"_21483":53802,"_5":14766,"_28195":53699,"_3064":53803},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3608":991,"_31008":946,"_21483":53805,"_5":14766,"_28195":53699,"_3064":53806},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3608":992,"_31008":946,"_21483":53808,"_5":14766,"_28195":53699,"_3064":53809},[],"`auth_mode`",{"_3608":993,"_31008":946,"_21483":53811,"_5":14766,"_28195":53699,"_3064":53812},[],"Control applied in the configured operation",{"_3608":994,"_31008":946,"_21483":53814,"_5":14766,"_28195":53699,"_3064":53815},[],"`CLIENT_CERTIFICATE`",{"_3608":995,"_31008":946,"_21483":53817,"_5":14766,"_28195":53699,"_3064":53818},[],"Presented certificate validation.",{"_3608":996,"_31008":946,"_21483":53820,"_5":14766,"_28195":53699,"_3064":53821},[],"`EXTERNAL_WEBHOOK`",{"_3608":997,"_31008":946,"_21483":53823,"_5":14766,"_28195":53699,"_3064":53824},[],"Configured webhook authorization.",{"_3608":998,"_31008":946,"_21483":53826,"_5":14766,"_28195":53699,"_3064":53827},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3608":999,"_31008":946,"_21483":53829,"_5":14766,"_28195":53699,"_3064":53830},[],"Certificate validation followed by webhook approval.",{"_3608":1000,"_31008":946,"_21483":53832,"_5":14766,"_28195":53699,"_3064":53833},[],"`NO_AUTH`",{"_3608":1001,"_31008":946,"_21483":53835,"_5":14766,"_28195":53699,"_3064":53836},[],"No DMS requester authentication.",{"_3608":1002,"_31008":946,"_21483":53838,"_5":14766,"_28195":53699,"_3064":53839},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3608":1003,"_31008":946,"_21483":53841,"_5":14766,"_28195":53699,"_3064":53842},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3608":1004,"_31008":946,"_21483":53844,"_5":14766,"_28195":53699,"_3064":53845},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3608":1005,"_31008":946,"_21483":53847,"_5":14766,"_28195":53699,"_3064":53848},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3608":1006,"_31008":946,"_21483":53850,"_5":14766,"_28195":53703,"_3064":53851},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3608":1007,"_31008":946,"_21483":53853,"_5":14766,"_28195":53703,"_3064":53854},[],"`external_webhook_settings` field",{"_3608":1008,"_31008":946,"_21483":53856,"_5":14766,"_28195":53703,"_3064":53764},[],{"_3608":1009,"_31008":946,"_21483":53858,"_5":14766,"_28195":53703,"_3064":53859},[],"`url`",{"_3608":1010,"_31008":946,"_21483":53861,"_5":14766,"_28195":53703,"_3064":53862},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3608":1011,"_31008":946,"_21483":53864,"_5":14766,"_28195":53703,"_3064":53865},[],"`method`",{"_3608":1012,"_31008":946,"_21483":53867,"_5":14766,"_28195":53703,"_3064":53868},[],"`POST` or `PUT`; `POST` by default.",{"_3608":1013,"_31008":946,"_21483":53870,"_5":14766,"_28195":53703,"_3064":53871},[],"`name`",{"_3608":1014,"_31008":946,"_21483":53873,"_5":14766,"_28195":53703,"_3064":53874},[],"Label used in service logs.",{"_3608":1015,"_31008":946,"_21483":53876,"_5":14766,"_28195":53703,"_3064":53877},[],"`config.auth_mode`",{"_3608":1016,"_31008":946,"_21483":53879,"_5":14766,"_28195":53703,"_3064":53880},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3608":1017,"_31008":946,"_21483":53882,"_5":14766,"_28195":53703,"_3064":53883},[],"`config.log_level`",{"_3608":1018,"_31008":946,"_21483":53885,"_5":14766,"_28195":53703,"_3064":53886},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3608":1019,"_31008":946,"_21483":53888,"_5":14766,"_28195":53703,"_3064":53889},[],"`config.apikey_options`",{"_3608":1020,"_31008":946,"_21483":53891,"_5":14766,"_28195":53703,"_3064":53892},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3608":1021,"_31008":946,"_21483":53894,"_5":14766,"_28195":53703,"_3064":53895},[],"`config.jwt_options`",{"_3608":1022,"_31008":946,"_21483":53897,"_5":14766,"_28195":53703,"_3064":53898},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3608":1023,"_31008":946,"_21483":53900,"_5":14766,"_28195":53703,"_3064":53901},[],"`config.mtls_options`",{"_3608":1024,"_31008":946,"_21483":53903,"_5":14766,"_28195":53703,"_3064":53904},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3608":1025,"_31008":946,"_21483":53906,"_5":14766,"_28195":53703,"_3064":53907},[],"`config.insecure_skip_verify`",{"_3608":1026,"_31008":946,"_21483":53909,"_5":14766,"_28195":53703,"_3064":53910},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3608":1027,"_31008":946,"_21483":53912,"_5":14766,"_28195":53703,"_3064":53913},[],"`config.call_timeout`",{"_3608":1028,"_31008":946,"_21483":53915,"_5":14766,"_28195":53703,"_3064":53916},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3608":1029,"_31008":946,"_21483":53918,"_5":14766,"_28195":53703,"_3064":53919},[],"Rules for that configuration:",{"_3608":1030,"_31008":946,"_21483":53921,"_5":14766,"_28195":53703,"_3064":53922},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3608":1031,"_31008":946,"_21483":53924,"_5":14766,"_28195":53703,"_3064":53925},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3608":1032,"_31008":946,"_21483":53927,"_5":14766,"_28195":53703,"_3064":53928},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3608":1033,"_31008":946,"_21483":53930,"_5":14766,"_28195":53703,"_3064":53931},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3608":1034,"_31008":946,"_21483":53933,"_5":14766,"_28195":53703,"_3064":53934},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3608":1035,"_31008":946,"_21483":53936,"_5":14766,"_28195":53703,"_3064":53937},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3608":1036,"_31008":946,"_21483":53939,"_5":14766,"_28195":53703,"_3064":53940},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3608":1037,"_31008":946,"_21483":53942,"_5":14766,"_28195":53703,"_3064":53943},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3608":1038,"_31008":946,"_21483":53945,"_5":14766,"_28195":53703,"_3064":53946},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3608":1039,"_31008":946,"_21483":53948,"_5":14766,"_28195":53707,"_3064":53949},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3608":1040,"_31008":946,"_21483":53951,"_5":14766,"_28195":53711,"_3064":53952},[],"`settings.reenrollment_settings` field",{"_3608":1041,"_31008":946,"_21483":53954,"_5":14766,"_28195":53711,"_3064":51103},[],{"_3608":1042,"_31008":946,"_21483":53956,"_5":14766,"_28195":53711,"_3064":53957},[],"`reenrollment_delta`",{"_3608":1043,"_31008":946,"_21483":53959,"_5":14766,"_28195":53711,"_3064":53960},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3608":1044,"_31008":946,"_21483":53962,"_5":14766,"_28195":53711,"_3064":53963},[],"`preventive_delta`",{"_3608":1045,"_31008":946,"_21483":53965,"_5":14766,"_28195":53711,"_3064":53966},[],"Preventive operational monitoring threshold.",{"_3608":1046,"_31008":946,"_21483":53968,"_5":14766,"_28195":53711,"_3064":53969},[],"`critical_delta`",{"_3608":1047,"_31008":946,"_21483":53971,"_5":14766,"_28195":53711,"_3064":53972},[],"Critical operational monitoring threshold.",{"_3608":1048,"_31008":946,"_21483":53974,"_5":14766,"_28195":53711,"_3064":53975},[],"`enable_expired_renewal`",{"_3608":1049,"_31008":946,"_21483":53977,"_5":14766,"_28195":53711,"_3064":53978},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3608":1050,"_31008":946,"_21483":53980,"_5":14766,"_28195":53711,"_3064":53981},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3608":1051,"_31008":946,"_21483":53983,"_5":14766,"_28195":53711,"_3064":53984},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3608":1052,"_31008":946,"_21483":53986,"_5":14766,"_28195":53711,"_3064":53987},[],"`revoke_on_reenrollment`",{"_3608":1053,"_31008":946,"_21483":53989,"_5":14766,"_28195":53711,"_3064":53990},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3608":1054,"_31008":946,"_21483":53992,"_5":14766,"_28195":53711,"_3064":53993},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3608":1055,"_31008":946,"_21483":53995,"_5":14766,"_28195":53715,"_3064":53996},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3608":1056,"_31008":946,"_21483":53998,"_5":14766,"_28195":53719,"_3064":51097},[],{"_3608":1057,"_31008":946,"_21483":54000,"_5":14766,"_28195":53719,"_3064":54001},[],"Published material",{"_3608":1058,"_31008":946,"_21483":54003,"_5":14766,"_28195":53719,"_3064":54004},[],"**Include Lamassu System CA**",{"_3608":1059,"_31008":946,"_21483":54006,"_5":14766,"_28195":53719,"_3064":54007},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3608":1060,"_31008":946,"_21483":54009,"_5":14766,"_28195":53719,"_3064":54010},[],"**Include Enrollment CA**",{"_3608":1061,"_31008":946,"_21483":54012,"_5":14766,"_28195":53719,"_3064":54013},[],"Selected issuing CA certificate.",{"_3608":1062,"_31008":946,"_21483":54015,"_5":14766,"_28195":53719,"_3064":54016},[],"**Managed CAs**",{"_3608":1063,"_31008":946,"_21483":54018,"_5":14766,"_28195":53719,"_3064":54019},[],"Explicitly selected CA certificates.",{"_3608":1064,"_31008":946,"_21483":54021,"_5":14766,"_28195":53719,"_3064":54022},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3608":1065,"_31008":946,"_21483":54024,"_5":14766,"_28195":53723,"_3064":54025},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3608":1066,"_31008":946,"_21483":54027,"_5":14766,"_28195":53723,"_3064":54028},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3608":1067,"_31008":946,"_21483":54030,"_5":14766,"_28195":53723,"_3064":54031},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3608":1068,"_31008":946,"_21483":54033,"_5":14766,"_28195":53727,"_3064":54034},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3608":1069,"_31008":1069,"_5":15126,"_3064":54036,"_31366":54037,"_21483":54038,"_28195":1069},"Integrate the EST client",[50713,52225,53397,53395,53578],[],{"_3608":1070,"_31008":1069,"_21483":54040,"_5":14766,"_28195":1069,"_3064":54041},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3608":1071,"_31008":1069,"_5":31363,"_21483":54043,"_28195":54044,"_3064":50723},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3608":1072,"_31008":1069,"_5":31363,"_21483":54046,"_28195":54047,"_3064":54048},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3608":1073,"_31008":1069,"_5":31363,"_21483":54050,"_28195":54051,"_3064":54052},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3608":1074,"_31008":1069,"_5":31363,"_21483":54054,"_28195":54055,"_3064":54056},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3608":1075,"_31008":1069,"_5":31363,"_21483":54058,"_28195":54059,"_3064":54060},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3608":1076,"_31008":1069,"_5":31363,"_21483":54062,"_28195":54063,"_3064":54064},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3608":1077,"_31008":1069,"_21483":54066,"_5":14766,"_28195":1069,"_3064":54067},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3608":1078,"_31008":1069,"_21483":54069,"_5":14766,"_28195":54044,"_3064":54070},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3608":1079,"_31008":1069,"_21483":54072,"_5":14766,"_28195":54044,"_3064":54073},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3608":1080,"_31008":1069,"_21483":54075,"_5":14766,"_28195":54044,"_3064":54076},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3608":1081,"_31008":1069,"_21483":54078,"_5":14766,"_28195":54047,"_3064":54079},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3608":1082,"_31008":1069,"_21483":54081,"_5":14766,"_28195":54047,"_3064":54082},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3608":1083,"_31008":1069,"_21483":54084,"_5":14766,"_28195":54051,"_3064":54085},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3608":1084,"_31008":1069,"_21483":54087,"_5":14766,"_28195":54051,"_3064":54088},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3608":1085,"_31008":1069,"_21483":54090,"_5":14766,"_28195":54055,"_3064":54091},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3608":1086,"_31008":1069,"_21483":54093,"_5":14766,"_28195":54055,"_3064":54094},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3608":1087,"_31008":1069,"_21483":54096,"_5":14766,"_28195":54059,"_3064":54097},[],"For a root that issues directly:",{"_3608":1088,"_31008":1069,"_21483":54099,"_5":14766,"_28195":54059,"_3064":54100},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3608":1089,"_31008":1069,"_21483":54102,"_5":14766,"_28195":54059,"_3064":54103},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3608":1090,"_31008":1069,"_21483":54105,"_5":14766,"_28195":54063,"_3064":54106},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3608":1091,"_31008":1091,"_5":15126,"_3064":54108,"_31366":54109,"_21483":54110,"_28195":1091},"EST reference",[50713,52225,53397,53395,53578],[],{"_3608":1092,"_31008":1091,"_21483":54112,"_5":14766,"_28195":1091,"_3064":54113},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3608":1093,"_31008":1091,"_5":31363,"_21483":54115,"_28195":54116,"_3064":54117},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3608":1094,"_31008":1091,"_5":31363,"_21483":54119,"_28195":54120,"_3064":23280},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3608":1095,"_31008":1091,"_5":31363,"_21483":54122,"_28195":54123,"_3064":26746},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3608":1096,"_31008":1091,"_5":31363,"_21483":54125,"_28195":54126,"_3064":26753},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3608":1097,"_31008":1091,"_5":31363,"_21483":54128,"_28195":54129,"_3064":26031},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3608":1098,"_31008":1091,"_5":31363,"_21483":54131,"_28195":54132,"_3064":54133},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3608":1099,"_31008":1091,"_5":31363,"_21483":54135,"_28195":54136,"_3064":54137},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3608":1100,"_31008":1091,"_5":31363,"_21483":54139,"_28195":54140,"_3064":54141},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3608":1101,"_31008":1091,"_21483":54143,"_5":14766,"_28195":1091,"_3064":54144},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3608":1102,"_31008":1091,"_21483":54146,"_5":14766,"_28195":54116,"_3064":54147},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3608":1103,"_31008":1091,"_21483":54149,"_5":14766,"_28195":54116,"_3064":54150},[],"Operation",{"_3608":1104,"_31008":1091,"_21483":54152,"_5":14766,"_28195":54116,"_3064":54153},[],"Method",{"_3608":1105,"_31008":1091,"_21483":54155,"_5":14766,"_28195":54116,"_3064":54156},[],"Authentication and condition",{"_3608":1106,"_31008":1091,"_21483":54158,"_5":14766,"_28195":54116,"_3064":54159},[],"`/cacerts`",{"_3608":1107,"_31008":1091,"_21483":54161,"_5":14766,"_28195":54116,"_3064":54162},[],"GET",{"_3608":1108,"_31008":1091,"_21483":54164,"_5":14766,"_28195":54116,"_3064":54165},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3608":1109,"_31008":1091,"_21483":54167,"_5":14766,"_28195":54116,"_3064":54168},[],"`/simpleenroll`",{"_3608":1110,"_31008":1091,"_21483":54170,"_5":14766,"_28195":54116,"_3064":54171},[],"POST",{"_3608":1111,"_31008":1091,"_21483":54173,"_5":14766,"_28195":54116,"_3064":54174},[],"Initial authentication and DMS registration/replacement policy.",{"_3608":1112,"_31008":1091,"_21483":54176,"_5":14766,"_28195":54116,"_3064":54177},[],"`/simplereenroll`",{"_3608":1113,"_31008":1091,"_21483":54179,"_5":14766,"_28195":54116,"_3064":54171},[],{"_3608":1114,"_31008":1091,"_21483":54181,"_5":14766,"_28195":54116,"_3064":54182},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3608":1115,"_31008":1091,"_21483":54184,"_5":14766,"_28195":54116,"_3064":54185},[],"`/serverkeygen`",{"_3608":1116,"_31008":1091,"_21483":54187,"_5":14766,"_28195":54116,"_3064":54171},[],{"_3608":1117,"_31008":1091,"_21483":54189,"_5":14766,"_28195":54116,"_3064":54190},[],"Initial authentication and admission; server generation enabled.",{"_3608":1118,"_31008":1091,"_21483":54192,"_5":14766,"_28195":54116,"_3064":54193},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3608":1119,"_31008":1091,"_21483":54195,"_5":14766,"_28195":54120,"_3064":54196},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3608":1120,"_31008":1091,"_21483":54198,"_5":14766,"_28195":54120,"_3064":54199},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3608":1121,"_31008":1091,"_21483":54201,"_5":14766,"_28195":54123,"_3064":54202},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3608":1122,"_31008":1091,"_21483":54204,"_5":14766,"_28195":54123,"_3064":54205},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3608":1123,"_31008":1091,"_21483":54207,"_5":14766,"_28195":54126,"_3064":54208},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3608":1124,"_31008":1091,"_21483":54210,"_5":14766,"_28195":54126,"_3064":54211},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3608":1125,"_31008":1091,"_21483":54213,"_5":14766,"_28195":54129,"_3064":54214},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3608":1126,"_31008":1091,"_21483":54216,"_5":14766,"_28195":54129,"_3064":54217},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3608":1127,"_31008":1091,"_21483":54219,"_5":14766,"_28195":54132,"_3064":54220},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3608":1128,"_31008":1091,"_21483":54222,"_5":14766,"_28195":54132,"_3064":54223},[],"Part",{"_3608":1129,"_31008":1091,"_21483":54225,"_5":14766,"_28195":54132,"_3064":54226},[],"Content after decoding its Base64",{"_3608":1130,"_31008":1091,"_21483":54228,"_5":14766,"_28195":54132,"_3064":54229},[],"`application/pkcs8`",{"_3608":1131,"_31008":1091,"_21483":54231,"_5":14766,"_28195":54132,"_3064":54232},[],"Unencrypted DER PKCS#8 private key.",{"_3608":1132,"_31008":1091,"_21483":54234,"_5":14766,"_28195":54132,"_3064":54235},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3608":1133,"_31008":1091,"_21483":54237,"_5":14766,"_28195":54132,"_3064":54238},[],"DER PKCS#7 containing the issued certificate.",{"_3608":1134,"_31008":1091,"_21483":54240,"_5":14766,"_28195":54132,"_3064":54241},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3608":1135,"_31008":1091,"_21483":54243,"_5":14766,"_28195":54136,"_3064":54244},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3608":1136,"_31008":1091,"_21483":54246,"_5":14766,"_28195":54136,"_3064":54247},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3608":1137,"_31008":1091,"_21483":54249,"_5":14766,"_28195":54136,"_3064":54250},[],"Convert and check the result:",{"_3608":1138,"_31008":1091,"_21483":54252,"_5":14766,"_28195":54136,"_3064":54253},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3608":1139,"_31008":1091,"_21483":54255,"_5":14766,"_28195":54140,"_3064":54256},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3608":1140,"_31008":1091,"_21483":54258,"_5":14766,"_28195":54140,"_3064":54259},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3608":1141,"_31008":1141,"_5":15126,"_3064":53578,"_31366":54261,"_21483":54262,"_28195":1141},[50713,52225,53397,53395,53578],[],{"_3608":1142,"_31008":1141,"_21483":54264,"_5":14766,"_28195":1141,"_3064":54265},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3608":1143,"_31008":1141,"_5":31363,"_21483":54267,"_28195":54268,"_3064":54269},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3608":1144,"_31008":1141,"_5":31363,"_21483":54271,"_28195":54272,"_3064":54273},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3608":1145,"_31008":1141,"_5":31363,"_21483":54275,"_28195":54276,"_3064":54277},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3608":1146,"_31008":1141,"_5":31363,"_21483":54279,"_28195":54280,"_3064":54281},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3608":1147,"_31008":1141,"_21483":54283,"_5":14766,"_28195":1141,"_3064":54284},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3608":1148,"_31008":1141,"_21483":54286,"_5":14766,"_28195":54268,"_3064":54287},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3608":1149,"_31008":1141,"_21483":54289,"_5":14766,"_28195":54268,"_3064":54290},[],"The integrator installs initial EST server trust and an admission credential.",{"_3608":1150,"_31008":1141,"_21483":54292,"_5":14766,"_28195":54268,"_3064":54293},[],"The client requests an identity for its `Device ID` through EST.",{"_3608":1151,"_31008":1141,"_21483":54295,"_5":14766,"_28195":54268,"_3064":54296},[],"Certificate, device binding and key/certificate installation are checked.",{"_3608":1152,"_31008":1141,"_21483":54298,"_5":14766,"_28195":54268,"_3064":54299},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3608":1153,"_31008":1141,"_21483":54301,"_5":14766,"_28195":54268,"_3064":54302},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3608":1154,"_31008":1141,"_21483":54304,"_5":14766,"_28195":54272,"_3064":54305},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3608":1155,"_31008":1141,"_21483":54307,"_5":14766,"_28195":54272,"_3064":54308},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3608":1156,"_31008":1141,"_21483":54310,"_5":14766,"_28195":54272,"_3064":54311},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3608":1157,"_31008":1141,"_21483":54313,"_5":14766,"_28195":54272,"_3064":54314},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3608":1158,"_31008":1141,"_21483":54316,"_5":14766,"_28195":54276,"_3064":54317},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3608":1159,"_31008":1141,"_21483":54319,"_5":14766,"_28195":54276,"_3064":54320},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3608":1160,"_31008":1141,"_21483":54322,"_5":14766,"_28195":54276,"_3064":54323},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3608":1161,"_31008":1141,"_21483":54325,"_5":14766,"_28195":54276,"_3064":54326},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3608":1162,"_31008":1141,"_21483":54328,"_5":14766,"_28195":54280,"_3064":54329},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3608":1163,"_31008":1141,"_21483":54331,"_5":14766,"_28195":54280,"_3064":54332},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3608":1164,"_31008":1164,"_5":15126,"_3064":54334,"_31366":54335,"_21483":54336,"_28195":1164},"Provisioning strategies",[50713,52225,53397,53395,53578],[],{"_3608":1165,"_31008":1164,"_21483":54338,"_5":14766,"_28195":1164,"_3064":54339},[],"Choose device registration, identity authorization and key generation.",{"_3608":1166,"_31008":1164,"_5":31363,"_21483":54341,"_28195":54342,"_3064":54343},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3608":1167,"_31008":1164,"_5":31363,"_21483":54345,"_28195":54346,"_3064":54347},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3608":1168,"_31008":1164,"_5":31363,"_21483":54349,"_28195":54350,"_3064":54351},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3608":1169,"_31008":1164,"_5":31363,"_21483":54353,"_28195":54354,"_3064":54355},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3608":1170,"_31008":1164,"_5":31363,"_21483":54357,"_28195":54358,"_3064":54359},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3608":1171,"_31008":1164,"_21483":54361,"_5":14766,"_28195":1164,"_3064":54362},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3608":1172,"_31008":1164,"_21483":54364,"_5":14766,"_28195":54342,"_3064":54365},[],"Path",{"_3608":1173,"_31008":1164,"_21483":54367,"_5":14766,"_28195":54342,"_3064":54368},[],"When the device exists",{"_3608":1174,"_31008":1164,"_21483":54370,"_5":14766,"_28195":54342,"_3064":54371},[],"What to check",{"_3608":1175,"_31008":1164,"_21483":54373,"_5":14766,"_28195":54342,"_3064":54374},[],"Manual assignment",{"_3608":1176,"_31008":1164,"_21483":54376,"_5":14766,"_28195":54342,"_3064":54377},[],"An operator creates it before associating a certificate.",{"_3608":1177,"_31008":1164,"_21483":54379,"_5":14766,"_28195":54342,"_3064":54380},[],"ID, owning DMS, certificate CN and bound serial.",{"_3608":1178,"_31008":1164,"_21483":54382,"_5":14766,"_28195":54342,"_3064":54383},[],"EST with `JITP`",{"_3608":1179,"_31008":1164,"_21483":54385,"_5":14766,"_28195":54342,"_3064":54386},[],"Created for an unknown CN during `/simpleenroll`.",{"_3608":1180,"_31008":1164,"_21483":54388,"_5":14766,"_28195":54342,"_3064":54389},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3608":1181,"_31008":1164,"_21483":54391,"_5":14766,"_28195":54342,"_3064":54392},[],"EST with `PRE_REGISTRATION`",{"_3608":1182,"_31008":1164,"_21483":54394,"_5":14766,"_28195":54342,"_3064":54395},[],"Must exist before `/simpleenroll`.",{"_3608":1183,"_31008":1164,"_21483":54397,"_5":14766,"_28195":54342,"_3064":54398},[],"Approved record, same DMS and replacement conditions for your version.",{"_3608":1184,"_31008":1164,"_21483":54400,"_5":14766,"_28195":54342,"_3064":54401},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3608":1185,"_31008":1164,"_21483":54403,"_5":14766,"_28195":54342,"_3064":54404},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3608":1186,"_31008":1164,"_21483":54406,"_5":14766,"_28195":54346,"_3064":54407},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3608":1187,"_31008":1164,"_21483":54409,"_5":14766,"_28195":54346,"_3064":54410},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3608":1188,"_31008":1164,"_21483":54412,"_5":14766,"_28195":54346,"_3064":54413},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3608":1189,"_31008":1164,"_21483":54415,"_5":14766,"_28195":54350,"_3064":54416},[],"Decide initial enrollment and re-enrollment separately:",{"_3608":1190,"_31008":1164,"_21483":54418,"_5":14766,"_28195":54350,"_3064":54419},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3608":1191,"_31008":1164,"_21483":54421,"_5":14766,"_28195":54350,"_3064":54422},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3608":1192,"_31008":1164,"_21483":54424,"_5":14766,"_28195":54350,"_3064":54425},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3608":1193,"_31008":1164,"_21483":54427,"_5":14766,"_28195":54350,"_3064":54428},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3608":1194,"_31008":1164,"_21483":54430,"_5":14766,"_28195":54350,"_3064":54431},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3608":1195,"_31008":1164,"_21483":54433,"_5":14766,"_28195":54354,"_3064":51097},[],{"_3608":1196,"_31008":1164,"_21483":54435,"_5":14766,"_28195":54354,"_3064":54436},[],"Material crossing EST",{"_3608":1197,"_31008":1164,"_21483":54438,"_5":14766,"_28195":54354,"_3064":54439},[],"Device-generated key",{"_3608":1198,"_31008":1164,"_21483":54441,"_5":14766,"_28195":54354,"_3064":54442},[],"Public CSR and certificate; the key stays on the client.",{"_3608":1199,"_31008":1164,"_21483":54444,"_5":14766,"_28195":54354,"_3064":54445},[],"Existing device key",{"_3608":1200,"_31008":1164,"_21483":54447,"_5":14766,"_28195":54354,"_3064":54448},[],"CSR signed with that key and a new certificate.",{"_3608":1201,"_31008":1164,"_21483":54450,"_5":14766,"_28195":54354,"_3064":53716},[],{"_3608":1202,"_31008":1164,"_21483":54452,"_5":14766,"_28195":54354,"_3064":54453},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3608":1203,"_31008":1164,"_21483":54455,"_5":14766,"_28195":54354,"_3064":54456},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3608":1204,"_31008":1164,"_21483":54458,"_5":14766,"_28195":54358,"_3064":54459},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3608":1205,"_31008":1205,"_5":15126,"_3064":54461,"_31366":54462,"_21483":54463,"_28195":1205},"Renewal and recovery",[50713,52225,53397,53395,53578],[],{"_3608":1206,"_31008":1205,"_21483":54465,"_5":14766,"_28195":1205,"_3064":54466},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3608":1207,"_31008":1205,"_5":31363,"_21483":54468,"_28195":54469,"_3064":54470},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3608":1208,"_31008":1205,"_5":31363,"_21483":54472,"_28195":54473,"_3064":54474},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3608":1209,"_31008":1205,"_5":31363,"_21483":54476,"_28195":54477,"_3064":54478},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3608":1210,"_31008":1205,"_5":31363,"_21483":54480,"_28195":54481,"_3064":54482},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3608":1211,"_31008":1205,"_5":31363,"_21483":54484,"_28195":54485,"_3064":54486},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3608":1212,"_31008":1205,"_21483":54488,"_5":14766,"_28195":1205,"_3064":54489},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3608":1213,"_31008":1205,"_21483":54491,"_5":14766,"_28195":54469,"_3064":54492},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3608":1214,"_31008":1205,"_21483":54494,"_5":14766,"_28195":54469,"_3064":54495},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3608":1215,"_31008":1205,"_21483":54497,"_5":14766,"_28195":54469,"_3064":54498},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3608":1216,"_31008":1205,"_21483":54500,"_5":14766,"_28195":54469,"_3064":54501},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3608":1217,"_31008":1205,"_21483":54503,"_5":14766,"_28195":54473,"_3064":54504},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3608":1218,"_31008":1205,"_21483":54506,"_5":14766,"_28195":54473,"_3064":54507},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3608":1219,"_31008":1205,"_21483":54509,"_5":14766,"_28195":54477,"_3064":54510},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3608":1220,"_31008":1205,"_21483":54512,"_5":14766,"_28195":54477,"_3064":54513},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3608":1221,"_31008":1205,"_21483":54515,"_5":14766,"_28195":54477,"_3064":54516},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3608":1222,"_31008":1205,"_21483":54518,"_5":14766,"_28195":54481,"_3064":54519},[],"Situation",{"_3608":1223,"_31008":1205,"_21483":54521,"_5":14766,"_28195":54481,"_3064":54522},[],"Procedure",{"_3608":1224,"_31008":1205,"_21483":54524,"_5":14766,"_28195":54481,"_3064":54525},[],"Valid certificate, outside the window",{"_3608":1225,"_31008":1205,"_21483":54527,"_5":14766,"_28195":54481,"_3064":54528},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3608":1226,"_31008":1205,"_21483":54530,"_5":14766,"_28195":54481,"_3064":54531},[],"Expired certificate, key available",{"_3608":1227,"_31008":1205,"_21483":54533,"_5":14766,"_28195":54481,"_3064":54534},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3608":1228,"_31008":1205,"_21483":54536,"_5":14766,"_28195":54481,"_3064":54537},[],"Renewal through webhook or `NO_AUTH`",{"_3608":1229,"_31008":1205,"_21483":54539,"_5":14766,"_28195":54481,"_3064":54540},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3608":1230,"_31008":1205,"_21483":54542,"_5":14766,"_28195":54481,"_3064":54543},[],"Lost or inaccessible key",{"_3608":1231,"_31008":1205,"_21483":54545,"_5":14766,"_28195":54481,"_3064":54546},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3608":1232,"_31008":1205,"_21483":54548,"_5":14766,"_28195":54481,"_3064":54549},[],"Current identity revoked",{"_3608":1233,"_31008":1205,"_21483":54551,"_5":14766,"_28195":54481,"_3064":54552},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3608":1234,"_31008":1205,"_21483":54554,"_5":14766,"_28195":54481,"_3064":54555},[],"Device without an identity",{"_3608":1235,"_31008":1205,"_21483":54557,"_5":14766,"_28195":54481,"_3064":54558},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3608":1236,"_31008":1205,"_21483":54560,"_5":14766,"_28195":54481,"_3064":54561},[],"Retired device",{"_3608":1237,"_31008":1205,"_21483":54563,"_5":14766,"_28195":54481,"_3064":54564},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3608":1238,"_31008":1205,"_21483":54566,"_5":14766,"_28195":54481,"_3064":54567},[],"Timeout, HTTP 500 or installation failure",{"_3608":1239,"_31008":1205,"_21483":54569,"_5":14766,"_28195":54481,"_3064":54570},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3608":1240,"_31008":1205,"_21483":54572,"_5":14766,"_28195":54485,"_3064":54573},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3608":1241,"_31008":1205,"_21483":54575,"_5":14766,"_28195":54485,"_3064":54576},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3608":1242,"_31008":1242,"_5":15126,"_3064":54578,"_31366":54579,"_21483":54580,"_28195":1242},"Enrollment troubleshooting",[50713,52225,53397,53395,53578],[],{"_3608":1243,"_31008":1242,"_21483":54582,"_5":14766,"_28195":1242,"_3064":54583},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3608":1244,"_31008":1242,"_5":31363,"_21483":54585,"_28195":54586,"_3064":54587},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3608":1245,"_31008":1242,"_5":31363,"_21483":54589,"_28195":54590,"_3064":54591},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3608":1246,"_31008":1242,"_5":31363,"_21483":54593,"_28195":54594,"_3064":54141},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3608":1247,"_31008":1242,"_5":31363,"_21483":54596,"_28195":54597,"_3064":54598},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3608":1248,"_31008":1242,"_21483":54600,"_5":14766,"_28195":1242,"_3064":54601},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3608":1249,"_31008":1242,"_21483":54603,"_5":14766,"_28195":54590,"_3064":54604},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3608":1250,"_31008":1242,"_21483":54606,"_5":14766,"_28195":54590,"_3064":54607},[],"Symptom or message",{"_3608":1251,"_31008":1242,"_21483":54609,"_5":14766,"_28195":54590,"_3064":54371},[],{"_3608":1252,"_31008":1242,"_21483":54611,"_5":14766,"_28195":54590,"_3064":54612},[],"curl rejects TLS, name or issuer",{"_3608":1253,"_31008":1242,"_21483":54614,"_5":14766,"_28195":54590,"_3064":54615},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3608":1254,"_31008":1242,"_21483":54617,"_5":14766,"_28195":54590,"_3064":54618},[],"404 or missing APS",{"_3608":1255,"_31008":1242,"_21483":54620,"_5":14766,"_28195":54590,"_3064":54621},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3608":1256,"_31008":1242,"_21483":54623,"_5":14766,"_28195":54590,"_3064":54624},[],"400, CSR or format error",{"_3608":1257,"_31008":1242,"_21483":54626,"_5":14766,"_28195":54590,"_3064":54627},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3608":1258,"_31008":1242,"_21483":54629,"_5":14766,"_28195":54590,"_3064":54630},[],"Missing credential or invalid certificate",{"_3608":1259,"_31008":1242,"_21483":54632,"_5":14766,"_28195":54590,"_3064":54633},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3608":1260,"_31008":1242,"_21483":54635,"_5":14766,"_28195":54590,"_3064":54636},[],"Webhook denies, times out or responds without authorization",{"_3608":1261,"_31008":1242,"_21483":54638,"_5":14766,"_28195":54590,"_3064":54639},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3608":1262,"_31008":1242,"_21483":54641,"_5":14766,"_28195":54590,"_3064":54642},[],"`unexpected status code: <n>: redirects are not followed`",{"_3608":1263,"_31008":1242,"_21483":54644,"_5":14766,"_28195":54590,"_3064":54645},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3608":1264,"_31008":1242,"_21483":54647,"_5":14766,"_28195":54590,"_3064":54648},[],"`webhook response exceeds 1048576 bytes`",{"_3608":1265,"_31008":1242,"_21483":54650,"_5":14766,"_28195":54590,"_3064":54651},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3608":1266,"_31008":1242,"_21483":54653,"_5":14766,"_28195":54590,"_3064":54654},[],"`webhook config must not reference files`",{"_3608":1267,"_31008":1242,"_21483":54656,"_5":14766,"_28195":54590,"_3064":54657},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3608":1268,"_31008":1242,"_21483":54659,"_5":14766,"_28195":54590,"_3064":54660},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3608":1269,"_31008":1242,"_21483":54662,"_5":14766,"_28195":54590,"_3064":54663},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3608":1270,"_31008":1242,"_21483":54665,"_5":14766,"_28195":54590,"_3064":54666},[],"`webhook mTLS certificate and key are invalid: …`",{"_3608":1271,"_31008":1242,"_21483":54668,"_5":14766,"_28195":54590,"_3064":54669},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3608":1272,"_31008":1242,"_21483":54671,"_5":14766,"_28195":54590,"_3064":54672},[],"400 `struct validation error` creating or updating a DMS",{"_3608":1273,"_31008":1242,"_21483":54674,"_5":14766,"_28195":54590,"_3064":54675},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3608":1274,"_31008":1242,"_21483":54677,"_5":14766,"_28195":54590,"_3064":54678},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3608":1275,"_31008":1242,"_21483":54680,"_5":14766,"_28195":54590,"_3064":54681},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3608":1276,"_31008":1242,"_21483":54683,"_5":14766,"_28195":54590,"_3064":54684},[],"`device not preregistered`",{"_3608":1277,"_31008":1242,"_21483":54686,"_5":14766,"_28195":54590,"_3064":54687},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3608":1278,"_31008":1242,"_21483":54689,"_5":14766,"_28195":54590,"_3064":54690},[],"`forbiddenNewEnrollment`",{"_3608":1279,"_31008":1242,"_21483":54692,"_5":14766,"_28195":54590,"_3064":54693},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3608":1280,"_31008":1242,"_21483":54695,"_5":14766,"_28195":54590,"_3064":54696},[],"Different owning DMS",{"_3608":1281,"_31008":1242,"_21483":54698,"_5":14766,"_28195":54590,"_3064":54699},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3608":1282,"_31008":1242,"_21483":54701,"_5":14766,"_28195":54590,"_3064":54702},[],"`invalid RawSubject bytes`",{"_3608":1283,"_31008":1242,"_21483":54704,"_5":14766,"_28195":54590,"_3064":54705},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3608":1284,"_31008":1242,"_21483":54707,"_5":14766,"_28195":54590,"_3064":54708},[],"`invalid reenroll window`",{"_3608":1285,"_31008":1242,"_21483":54710,"_5":14766,"_28195":54590,"_3064":54711},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3608":1286,"_31008":1242,"_21483":54713,"_5":14766,"_28195":54590,"_3064":54714},[],"Current certificate revoked",{"_3608":1287,"_31008":1242,"_21483":54716,"_5":14766,"_28195":54590,"_3064":54717},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3608":1288,"_31008":1242,"_21483":54719,"_5":14766,"_28195":54590,"_3064":54720},[],"CA, profile or signing error",{"_3608":1289,"_31008":1242,"_21483":54722,"_5":14766,"_28195":54590,"_3064":54723},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3608":1290,"_31008":1242,"_21483":54725,"_5":14766,"_28195":54590,"_3064":54726},[],"HTTP 200 without a device connection",{"_3608":1291,"_31008":1242,"_21483":54728,"_5":14766,"_28195":54590,"_3064":54729},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3608":1292,"_31008":1242,"_21483":54731,"_5":14766,"_28195":54590,"_3064":54732},[],"Timeout or error after issuance",{"_3608":1293,"_31008":1242,"_21483":54734,"_5":14766,"_28195":54590,"_3064":54735},[],"New certificates, current slot and previous identity's state before retrying.",{"_3608":1294,"_31008":1242,"_21483":54737,"_5":14766,"_28195":54594,"_3064":54738},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3608":1295,"_31008":1242,"_21483":54740,"_5":14766,"_28195":54594,"_3064":54741},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3608":1296,"_31008":1242,"_21483":54743,"_5":14766,"_28195":54597,"_3064":54744},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3608":1297,"_31008":1242,"_21483":54746,"_5":14766,"_28195":54597,"_3064":54747},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3608":1298,"_31008":1242,"_21483":54749,"_5":14766,"_28195":54597,"_3064":54750},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3608":1299,"_31008":1242,"_21483":54752,"_5":14766,"_28195":54597,"_3064":54753},[],"Make one request, save headers/body and query the device and certificates.",{"_3608":1300,"_31008":1242,"_21483":54755,"_5":14766,"_28195":54597,"_3064":54756},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3608":1301,"_31008":1242,"_21483":54758,"_5":14766,"_28195":54597,"_3064":54759},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3608":1302,"_31008":1242,"_21483":54761,"_5":14766,"_28195":54597,"_3064":54762},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3608":1303,"_31008":1303,"_5":15126,"_3064":54764,"_31366":54765,"_21483":54766,"_28195":1303},"Trust distribution and updates",[50713,52225,53397,53395,53578],[],{"_3608":1304,"_31008":1303,"_21483":54768,"_5":14766,"_28195":1303,"_3064":54769},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3608":1305,"_31008":1303,"_5":31363,"_21483":54771,"_28195":54772,"_3064":54773},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3608":1306,"_31008":1303,"_5":31363,"_21483":54775,"_28195":54776,"_3064":54777},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3608":1307,"_31008":1303,"_5":31363,"_21483":54779,"_28195":54780,"_3064":54781},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3608":1308,"_31008":1303,"_5":31363,"_21483":54783,"_28195":54784,"_3064":54785},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3608":1309,"_31008":1303,"_5":31363,"_21483":54787,"_28195":54788,"_3064":54789},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3608":1310,"_31008":1303,"_21483":54791,"_5":14766,"_28195":1303,"_3064":54792},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3608":1311,"_31008":1303,"_21483":54794,"_5":14766,"_28195":54772,"_3064":54795},[],"Relationship",{"_3608":1312,"_31008":1303,"_21483":54797,"_5":14766,"_28195":54772,"_3064":54798},[],"Material prepared by its owner",{"_3608":1313,"_31008":1303,"_21483":54800,"_5":14766,"_28195":54772,"_3064":54801},[],"Device → EST server",{"_3608":1314,"_31008":1303,"_21483":54803,"_5":14766,"_28195":54772,"_3064":54804},[],"Previously verified server root, chain or pin and TLS name.",{"_3608":1315,"_31008":1303,"_21483":54806,"_5":14766,"_28195":54772,"_3064":54807},[],"DMS → requester",{"_3608":1316,"_31008":1303,"_21483":54809,"_5":14766,"_28195":54772,"_3064":54810},[],"CAs and rules authorizing initial or renewal credentials.",{"_3608":1317,"_31008":1303,"_21483":54812,"_5":14766,"_28195":54772,"_3064":54813},[],"Consumer → device",{"_3608":1318,"_31008":1303,"_21483":54815,"_5":14766,"_28195":54772,"_3064":54816},[],"Operational identity roots, intermediates, validation and permissions.",{"_3608":1319,"_31008":1303,"_21483":54818,"_5":14766,"_28195":54772,"_3064":54819},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3608":1320,"_31008":1303,"_21483":54821,"_5":14766,"_28195":54776,"_3064":54822},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3608":1321,"_31008":1303,"_21483":54824,"_5":14766,"_28195":54776,"_3064":54825},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3608":1322,"_31008":1303,"_21483":54827,"_5":14766,"_28195":54780,"_3064":54828},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3608":1323,"_31008":1303,"_21483":54830,"_5":14766,"_28195":54780,"_3064":54831},[],"Select policy-approved roots as anchors.",{"_3608":1324,"_31008":1303,"_21483":54833,"_5":14766,"_28195":54780,"_3064":54834},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3608":1325,"_31008":1303,"_21483":54836,"_5":14766,"_28195":54780,"_3064":54837},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3608":1326,"_31008":1303,"_21483":54839,"_5":14766,"_28195":54780,"_3064":54840},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3608":1327,"_31008":1303,"_21483":54842,"_5":14766,"_28195":54780,"_3064":54843},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3608":1328,"_31008":1303,"_21483":54845,"_5":14766,"_28195":54784,"_3064":54846},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3608":1329,"_31008":1303,"_21483":54848,"_5":14766,"_28195":54784,"_3064":54849},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3608":1330,"_31008":1303,"_21483":54851,"_5":14766,"_28195":54784,"_3064":54852},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3608":1331,"_31008":1303,"_21483":54854,"_5":14766,"_28195":54788,"_3064":54855},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3608":1332,"_31008":1332,"_5":15126,"_3064":54857,"_31366":54858,"_21483":54860,"_28195":1332},"AWS IoT Core",[50713,52225,53397,53395,54859],"Integrations",[],{"_3608":1333,"_31008":1332,"_21483":54862,"_5":14766,"_28195":1332,"_3064":54863},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3608":1334,"_31008":1332,"_5":31363,"_21483":54865,"_28195":54866,"_3064":54867},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3608":1335,"_31008":1332,"_5":31363,"_21483":54869,"_28195":54870,"_3064":54871},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3608":1336,"_31008":1332,"_5":31363,"_21483":54873,"_28195":54874,"_3064":54875},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3608":1337,"_31008":1332,"_5":31363,"_21483":54877,"_28195":54878,"_3064":54879},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3608":1338,"_31008":1332,"_5":31363,"_21483":54881,"_28195":54882,"_3064":54883},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3608":1339,"_31008":1332,"_5":31363,"_21483":54885,"_28195":54886,"_3064":54887},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3608":1340,"_31008":1332,"_5":31363,"_21483":54889,"_28195":54890,"_3064":54891},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3608":1341,"_31008":1332,"_5":31363,"_21483":54893,"_28195":54894,"_3064":54895},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3608":1342,"_31008":1332,"_5":31363,"_21483":54897,"_28195":54898,"_3064":54899},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3608":1343,"_31008":1332,"_5":31363,"_21483":54901,"_28195":54902,"_3064":54903},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3608":1344,"_31008":1332,"_5":31363,"_21483":54905,"_28195":54906,"_3064":54907},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3608":1345,"_31008":1332,"_5":31363,"_21483":54909,"_28195":54910,"_3064":54911},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3608":1346,"_31008":1332,"_5":31363,"_21483":54913,"_28195":54914,"_3064":54915},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3608":1347,"_31008":1332,"_5":31363,"_21483":54917,"_28195":54918,"_3064":54919},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3608":1348,"_31008":1332,"_5":31363,"_21483":54921,"_28195":54922,"_3064":54923},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3608":1349,"_31008":1332,"_5":31363,"_21483":54925,"_28195":54926,"_3064":54927},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3608":1350,"_31008":1332,"_5":31363,"_21483":54929,"_28195":54930,"_3064":54931},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3608":1351,"_31008":1332,"_5":31363,"_21483":54933,"_28195":54934,"_3064":54935},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3608":1352,"_31008":1332,"_5":31363,"_21483":54937,"_28195":54938,"_3064":54939},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3608":1353,"_31008":1332,"_5":31363,"_21483":54941,"_28195":54942,"_3064":54943},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3608":1354,"_31008":1332,"_5":31363,"_21483":54945,"_28195":54946,"_3064":54947},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3608":1355,"_31008":1332,"_5":31363,"_21483":54949,"_28195":54950,"_3064":54951},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3608":1356,"_31008":1332,"_5":31363,"_21483":54953,"_28195":54954,"_3064":54955},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3608":1357,"_31008":1332,"_5":31363,"_21483":54957,"_28195":54958,"_3064":54959},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3608":1358,"_31008":1332,"_5":31363,"_21483":54961,"_28195":54962,"_3064":54963},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3608":1359,"_31008":1332,"_21483":54965,"_5":14766,"_28195":1332,"_3064":54966},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3608":1360,"_31008":1332,"_21483":54968,"_5":14766,"_28195":1332,"_3064":54969},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3608":1361,"_31008":1332,"_21483":54971,"_5":14766,"_28195":1332,"_3064":54972},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3608":1362,"_31008":1332,"_21483":54974,"_5":14766,"_28195":54866,"_3064":54975},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3608":1363,"_31008":1332,"_21483":54977,"_5":14766,"_28195":54866,"_3064":54978},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3608":1364,"_31008":1332,"_21483":54980,"_5":14766,"_28195":54866,"_3064":54981},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3608":1365,"_31008":1332,"_21483":54983,"_5":14766,"_28195":54866,"_3064":54984},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3608":1366,"_31008":1332,"_21483":54986,"_5":14766,"_28195":54870,"_3064":54987},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3608":1367,"_31008":1332,"_21483":54989,"_5":14766,"_28195":54874,"_3064":54990},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3608":1368,"_31008":1332,"_21483":54992,"_5":14766,"_28195":54874,"_3064":54993},[],"IAM action",{"_3608":1369,"_31008":1332,"_21483":54995,"_5":14766,"_28195":54874,"_3064":51103},[],{"_3608":1370,"_31008":1332,"_21483":54997,"_5":14766,"_28195":54874,"_3064":54998},[],"`iot:GetRegistrationCode`",{"_3608":1371,"_31008":1332,"_21483":55000,"_5":14766,"_28195":54874,"_3064":55001},[],"Obtain the verification code for CA registration in the Primary Account",{"_3608":1372,"_31008":1332,"_21483":55003,"_5":14766,"_28195":54874,"_3064":55004},[],"`iot:RegisterCACertificate`",{"_3608":1373,"_31008":1332,"_21483":55006,"_5":14766,"_28195":54874,"_3064":55007},[],"Register the CA in AWS IoT",{"_3608":1374,"_31008":1332,"_21483":55009,"_5":14766,"_28195":54874,"_3064":55010},[],"`iot:DescribeCACertificate`",{"_3608":1375,"_31008":1332,"_21483":55012,"_5":14766,"_28195":54874,"_3064":55013},[],"Check the CA registration status",{"_3608":1376,"_31008":1332,"_21483":55015,"_5":14766,"_28195":54874,"_3064":55016},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3608":1377,"_31008":1332,"_21483":55018,"_5":14766,"_28195":54874,"_3064":55019},[],"Create or update Things in IoT Core",{"_3608":1378,"_31008":1332,"_21483":55021,"_5":14766,"_28195":54874,"_3064":55022},[],"`iot:RegisterThing`",{"_3608":1379,"_31008":1332,"_21483":55024,"_5":14766,"_28195":54874,"_3064":55025},[],"Provision Things through a template",{"_3608":1380,"_31008":1332,"_21483":55027,"_5":14766,"_28195":54874,"_3064":55028},[],"`iot:RegisterCertificate`",{"_3608":1381,"_31008":1332,"_21483":55030,"_5":14766,"_28195":54874,"_3064":55031},[],"Register device certificates",{"_3608":1382,"_31008":1332,"_21483":55033,"_5":14766,"_28195":54874,"_3064":55034},[],"`iot:UpdateCertificate`",{"_3608":1383,"_31008":1332,"_21483":55036,"_5":14766,"_28195":54874,"_3064":55037},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3608":1384,"_31008":1332,"_21483":55039,"_5":14766,"_28195":54874,"_3064":55040},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3608":1385,"_31008":1332,"_21483":55042,"_5":14766,"_28195":54874,"_3064":55043},[],"Create and attach IoT policies",{"_3608":1386,"_31008":1332,"_21483":55045,"_5":14766,"_28195":54874,"_3064":55046},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3608":1387,"_31008":1332,"_21483":55048,"_5":14766,"_28195":54874,"_3064":55049},[],"Manage Thing groups",{"_3608":1388,"_31008":1332,"_21483":55051,"_5":14766,"_28195":54874,"_3064":55052},[],"`iot:CreateProvisioningTemplate`",{"_3608":1389,"_31008":1332,"_21483":55054,"_5":14766,"_28195":54874,"_3064":55055},[],"Create JITP templates",{"_3608":1390,"_31008":1332,"_21483":55057,"_5":14766,"_28195":54874,"_3064":55058},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3608":1391,"_31008":1332,"_21483":55060,"_5":14766,"_28195":54874,"_3064":55061},[],"Read and write the Device Shadow",{"_3608":1392,"_31008":1332,"_21483":55063,"_5":14766,"_28195":54874,"_3064":55064},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3608":1393,"_31008":1332,"_21483":55066,"_5":14766,"_28195":54878,"_3064":55067},[],"Parameter",{"_3608":1394,"_31008":1332,"_21483":55069,"_5":14766,"_28195":54878,"_3064":55070},[],"Type",{"_3608":1395,"_31008":1332,"_21483":55072,"_5":14766,"_28195":54878,"_3064":55073},[],"Required",{"_3608":1396,"_31008":1332,"_21483":55075,"_5":14766,"_28195":54878,"_3064":55076},[],"Description",{"_3608":1397,"_31008":1332,"_21483":55078,"_5":14766,"_28195":54878,"_3064":55079},[],"`connector_id`",{"_3608":1398,"_31008":1332,"_21483":55081,"_5":14766,"_28195":54878,"_3064":25641},[],{"_3608":1399,"_31008":1332,"_21483":55083,"_5":14766,"_28195":54878,"_3064":55084},[],"Yes",{"_3608":1400,"_31008":1332,"_21483":55086,"_5":14766,"_28195":54878,"_3064":55087},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3608":1401,"_31008":1332,"_21483":55089,"_5":14766,"_28195":54878,"_3064":55090},[],"`aws_config.region`",{"_3608":1402,"_31008":1332,"_21483":55092,"_5":14766,"_28195":54878,"_3064":25641},[],{"_3608":1403,"_31008":1332,"_21483":55094,"_5":14766,"_28195":54878,"_3064":55084},[],{"_3608":1404,"_31008":1332,"_21483":55096,"_5":14766,"_28195":54878,"_3064":55097},[],"AWS region where the connector operates.",{"_3608":1405,"_31008":1332,"_21483":55099,"_5":14766,"_28195":54878,"_3064":55100},[],"`aws_config.auth_method`",{"_3608":1406,"_31008":1332,"_21483":55102,"_5":14766,"_28195":54878,"_3064":25641},[],{"_3608":1407,"_31008":1332,"_21483":55104,"_5":14766,"_28195":54878,"_3064":55084},[],{"_3608":1408,"_31008":1332,"_21483":55106,"_5":14766,"_28195":54878,"_3064":55107},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3608":1409,"_31008":1332,"_21483":55109,"_5":14766,"_28195":54878,"_3064":55110},[],"`aws_config.access_key_id`",{"_3608":1410,"_31008":1332,"_21483":55112,"_5":14766,"_28195":54878,"_3064":25641},[],{"_3608":1411,"_31008":1332,"_21483":55114,"_5":14766,"_28195":54878,"_3064":55115},[],"Only with `auth_method=static`",{"_3608":1412,"_31008":1332,"_21483":55117,"_5":14766,"_28195":54878,"_3064":55118},[],"AWS access key.",{"_3608":1413,"_31008":1332,"_21483":55120,"_5":14766,"_28195":54878,"_3064":55121},[],"`aws_config.secret_access_key`",{"_3608":1414,"_31008":1332,"_21483":55123,"_5":14766,"_28195":54878,"_3064":25641},[],{"_3608":1415,"_31008":1332,"_21483":55125,"_5":14766,"_28195":54878,"_3064":55115},[],{"_3608":1416,"_31008":1332,"_21483":55127,"_5":14766,"_28195":54878,"_3064":55128},[],"AWS secret key.",{"_3608":1417,"_31008":1332,"_21483":55130,"_5":14766,"_28195":54878,"_3064":55131},[],"`aws_config.session_token`",{"_3608":1418,"_31008":1332,"_21483":55133,"_5":14766,"_28195":54878,"_3064":25641},[],{"_3608":1419,"_31008":1332,"_21483":55135,"_5":14766,"_28195":54878,"_3064":55136},[],"No",{"_3608":1420,"_31008":1332,"_21483":55138,"_5":14766,"_28195":54878,"_3064":55139},[],"Session token (with `auth_method=static`).",{"_3608":1421,"_31008":1332,"_21483":55141,"_5":14766,"_28195":54878,"_3064":55142},[],"`aws_config.role_arn`",{"_3608":1422,"_31008":1332,"_21483":55144,"_5":14766,"_28195":54878,"_3064":25641},[],{"_3608":1423,"_31008":1332,"_21483":55146,"_5":14766,"_28195":54878,"_3064":55147},[],"Only with `auth_method=role`",{"_3608":1424,"_31008":1332,"_21483":55149,"_5":14766,"_28195":54878,"_3064":55150},[],"ARN of the role to assume.",{"_3608":1425,"_31008":1332,"_21483":55152,"_5":14766,"_28195":54878,"_3064":55153},[],"`aws_config.endpoint_url`",{"_3608":1426,"_31008":1332,"_21483":55155,"_5":14766,"_28195":54878,"_3064":25641},[],{"_3608":1427,"_31008":1332,"_21483":55157,"_5":14766,"_28195":54878,"_3064":55136},[],{"_3608":1428,"_31008":1332,"_21483":55159,"_5":14766,"_28195":54878,"_3064":55160},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3608":1429,"_31008":1332,"_21483":55162,"_5":14766,"_28195":54878,"_3064":55163},[],"`subscriber_event_bus`",{"_3608":1430,"_31008":1332,"_21483":55165,"_5":14766,"_28195":54878,"_3064":18084},[],{"_3608":1431,"_31008":1332,"_21483":55167,"_5":14766,"_28195":54878,"_3064":55084},[],{"_3608":1432,"_31008":1332,"_21483":55169,"_5":14766,"_28195":54878,"_3064":55170},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3608":1433,"_31008":1332,"_21483":55172,"_5":14766,"_28195":54878,"_3064":55173},[],"`dms_manager_client`",{"_3608":1434,"_31008":1332,"_21483":55175,"_5":14766,"_28195":54878,"_3064":25641},[],{"_3608":1435,"_31008":1332,"_21483":55177,"_5":14766,"_28195":54878,"_3064":55084},[],{"_3608":1436,"_31008":1332,"_21483":55179,"_5":14766,"_28195":54878,"_3064":55180},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3608":1437,"_31008":1332,"_21483":55182,"_5":14766,"_28195":54878,"_3064":55183},[],"`device_manager_client`",{"_3608":1438,"_31008":1332,"_21483":55185,"_5":14766,"_28195":54878,"_3064":25641},[],{"_3608":1439,"_31008":1332,"_21483":55187,"_5":14766,"_28195":54878,"_3064":55084},[],{"_3608":1440,"_31008":1332,"_21483":55189,"_5":14766,"_28195":54878,"_3064":55190},[],"HTTP URL of Lamassu's Device Manager.",{"_3608":1441,"_31008":1332,"_21483":55192,"_5":14766,"_28195":54878,"_3064":55193},[],"`ca_client`",{"_3608":1442,"_31008":1332,"_21483":55195,"_5":14766,"_28195":54878,"_3064":25641},[],{"_3608":1443,"_31008":1332,"_21483":55197,"_5":14766,"_28195":54878,"_3064":55084},[],{"_3608":1444,"_31008":1332,"_21483":55199,"_5":14766,"_28195":54878,"_3064":55200},[],"HTTP URL of Lamassu's CA service.",{"_3608":1445,"_31008":1332,"_21483":55202,"_5":14766,"_28195":54882,"_3064":55203},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3608":1446,"_31008":1332,"_21483":55205,"_5":14766,"_28195":54882,"_3064":55206},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3608":1447,"_31008":1332,"_21483":55208,"_5":14766,"_28195":54882,"_3064":55209},[],"CloudEvent type",{"_3608":1448,"_31008":1332,"_21483":55211,"_5":14766,"_28195":54882,"_3064":55212},[],"Lamassu resource",{"_3608":1449,"_31008":1332,"_21483":55214,"_5":14766,"_28195":54882,"_3064":55215},[],"AWS Resource",{"_3608":1450,"_31008":1332,"_21483":55217,"_5":14766,"_28195":54882,"_3064":55218},[],"IAM actions",{"_3608":1451,"_31008":1332,"_21483":55220,"_5":14766,"_28195":54882,"_3064":55221},[],"AWS calls and effect",{"_3608":1452,"_31008":1332,"_21483":55223,"_5":14766,"_28195":54882,"_3064":55224},[],"Where in this page",{"_3608":1453,"_31008":1332,"_21483":55226,"_5":14766,"_28195":54882,"_3064":55227},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3608":1454,"_31008":1332,"_21483":55229,"_5":14766,"_28195":54882,"_3064":55230},[],"CA",{"_3608":1455,"_31008":1332,"_21483":55232,"_5":14766,"_28195":54882,"_3064":55233},[],"`IoTCore/CACertificate`",{"_3608":1456,"_31008":1332,"_21483":55235,"_5":14766,"_28195":54882,"_3064":55236},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3608":1457,"_31008":1332,"_21483":55238,"_5":14766,"_28195":54882,"_3064":55239},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3608":1458,"_31008":1332,"_21483":55241,"_5":14766,"_28195":54882,"_3064":54895},[],{"_3608":1459,"_31008":1332,"_21483":55243,"_5":14766,"_28195":54882,"_3064":55244},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3608":1460,"_31008":1332,"_21483":55246,"_5":14766,"_28195":54882,"_3064":55247},[],"DMS",{"_3608":1461,"_31008":1332,"_21483":55249,"_5":14766,"_28195":54882,"_3064":55250},[],"`IoTCore/ProvisioningTemplate`",{"_3608":1462,"_31008":1332,"_21483":55252,"_5":14766,"_28195":54882,"_3064":55253},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3608":1463,"_31008":1332,"_21483":55255,"_5":14766,"_28195":54882,"_3064":55256},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3608":1464,"_31008":1332,"_21483":55258,"_5":14766,"_28195":54882,"_3064":54923},[],{"_3608":1465,"_31008":1332,"_21483":55260,"_5":14766,"_28195":54882,"_3064":55261},[],"`EventBindDeviceIdentityKey`",{"_3608":1466,"_31008":1332,"_21483":55263,"_5":14766,"_28195":54882,"_3064":55264},[],"Device",{"_3608":1467,"_31008":1332,"_21483":55266,"_5":14766,"_28195":54882,"_3064":55267},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3608":1468,"_31008":1332,"_21483":55269,"_5":14766,"_28195":54882,"_3064":55270},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3608":1469,"_31008":1332,"_21483":55272,"_5":14766,"_28195":54882,"_3064":55273},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3608":1470,"_31008":1332,"_21483":55275,"_5":14766,"_28195":54882,"_3064":54931},[],{"_3608":1471,"_31008":1332,"_21483":55277,"_5":14766,"_28195":54882,"_3064":55278},[],"`EventUpdateCertificateStatusKey`",{"_3608":1472,"_31008":1332,"_21483":55280,"_5":14766,"_28195":54882,"_3064":55281},[],"Certificate",{"_3608":1473,"_31008":1332,"_21483":55283,"_5":14766,"_28195":54882,"_3064":55284},[],"`IoTCore/Certificate`",{"_3608":1474,"_31008":1332,"_21483":55286,"_5":14766,"_28195":54882,"_3064":55287},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3608":1475,"_31008":1332,"_21483":55289,"_5":14766,"_28195":54882,"_3064":55290},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3608":1476,"_31008":1332,"_21483":55292,"_5":14766,"_28195":54882,"_3064":54943},[],{"_3608":1477,"_31008":1332,"_21483":55294,"_5":14766,"_28195":54882,"_3064":55295},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3608":1478,"_31008":1332,"_21483":55297,"_5":14766,"_28195":54882,"_3064":55298},[],"Certificate / Device",{"_3608":1479,"_31008":1332,"_21483":55300,"_5":14766,"_28195":54882,"_3064":55301},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3608":1480,"_31008":1332,"_21483":55303,"_5":14766,"_28195":54882,"_3064":51109},[],{"_3608":1481,"_31008":1332,"_21483":55305,"_5":14766,"_28195":54882,"_3064":55306},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3608":1482,"_31008":1332,"_21483":55308,"_5":14766,"_28195":54882,"_3064":54951},[],{"_3608":1483,"_31008":1332,"_21483":55310,"_5":14766,"_28195":54886,"_3064":55311},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3608":1484,"_31008":1332,"_21483":55313,"_5":14766,"_28195":54890,"_3064":55314},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3608":1485,"_31008":1332,"_21483":55316,"_5":14766,"_28195":54890,"_3064":55317},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3608":1486,"_31008":1332,"_21483":55319,"_5":14766,"_28195":54894,"_3064":55320},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3608":1487,"_31008":1332,"_21483":55322,"_5":14766,"_28195":54894,"_3064":55323},[],"Transition",{"_3608":1488,"_31008":1332,"_21483":55325,"_5":14766,"_28195":54894,"_3064":55326},[],"AWS calls",{"_3608":1489,"_31008":1332,"_21483":55328,"_5":14766,"_28195":54894,"_3064":55329},[],"`NotRegistered` → `Requested`",{"_3608":1490,"_31008":1332,"_21483":55331,"_5":14766,"_28195":54894,"_3064":55332},[],"none (metadata write only)",{"_3608":1491,"_31008":1332,"_21483":55334,"_5":14766,"_28195":54894,"_3064":55335},[],"`Requested` → `Registering`",{"_3608":1492,"_31008":1332,"_21483":55337,"_5":14766,"_28195":54894,"_3064":55338},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3608":1493,"_31008":1332,"_21483":55340,"_5":14766,"_28195":54894,"_3064":55341},[],"`Registering` → `Succeeded`",{"_3608":1494,"_31008":1332,"_21483":55343,"_5":14766,"_28195":54894,"_3064":55344},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3608":1495,"_31008":1332,"_21483":55346,"_5":14766,"_28195":54894,"_3064":55347},[],"`Registering` → `Failed`",{"_3608":1496,"_31008":1332,"_21483":55349,"_5":14766,"_28195":54894,"_3064":55350},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3608":1497,"_31008":1332,"_21483":55352,"_5":14766,"_28195":54894,"_3064":55353},[],"`Failed` / `Succeeded` → `Requested`",{"_3608":1498,"_31008":1332,"_21483":55355,"_5":14766,"_28195":54894,"_3064":55356},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3608":1499,"_31008":1332,"_21483":55358,"_5":14766,"_28195":54898,"_3064":55359},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3608":1500,"_31008":1332,"_21483":55361,"_5":14766,"_28195":54898,"_3064":55362},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3608":1501,"_31008":1332,"_21483":55364,"_5":14766,"_28195":54898,"_3064":55365},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3608":1502,"_31008":1332,"_21483":55367,"_5":14766,"_28195":54898,"_3064":55368},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3608":1503,"_31008":1332,"_21483":55370,"_5":14766,"_28195":54898,"_3064":55371},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3608":1504,"_31008":1332,"_21483":55373,"_5":14766,"_28195":54898,"_3064":55374},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3608":1505,"_31008":1332,"_21483":55376,"_5":14766,"_28195":54902,"_3064":55377},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3608":1506,"_31008":1332,"_21483":55379,"_5":14766,"_28195":54906,"_3064":55380},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3608":1507,"_31008":1332,"_21483":55382,"_5":14766,"_28195":54906,"_3064":55383},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3608":1508,"_31008":1332,"_21483":55385,"_5":14766,"_28195":54910,"_3064":55386},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3608":1509,"_31008":1332,"_21483":55388,"_5":14766,"_28195":54914,"_3064":55389},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3608":1510,"_31008":1332,"_21483":55391,"_5":14766,"_28195":54914,"_3064":55392},[],"Creates or updates the IoT policies configured in the DMS.",{"_3608":1511,"_31008":1332,"_21483":55394,"_5":14766,"_28195":54914,"_3064":55395},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3608":1512,"_31008":1332,"_21483":55397,"_5":14766,"_28195":54914,"_3064":55398},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3608":1513,"_31008":1332,"_21483":55400,"_5":14766,"_28195":54914,"_3064":55401},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3608":1514,"_31008":1332,"_21483":55403,"_5":14766,"_28195":54914,"_3064":55404},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3608":1515,"_31008":1332,"_21483":55406,"_5":14766,"_28195":54914,"_3064":55407},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3608":1516,"_31008":1332,"_21483":55409,"_5":14766,"_28195":54918,"_3064":55410},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3608":1517,"_31008":1332,"_21483":55412,"_5":14766,"_28195":54918,"_3064":55413},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3608":1518,"_31008":1332,"_21483":55415,"_5":14766,"_28195":54918,"_3064":55416},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3608":1519,"_31008":1332,"_21483":55418,"_5":14766,"_28195":54918,"_3064":55419},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3608":1520,"_31008":1332,"_21483":55421,"_5":14766,"_28195":54918,"_3064":55422},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3608":1521,"_31008":1332,"_21483":55424,"_5":14766,"_28195":54922,"_3064":55425},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3608":1522,"_31008":1332,"_21483":55427,"_5":14766,"_28195":54922,"_3064":55323},[],{"_3608":1523,"_31008":1332,"_21483":55429,"_5":14766,"_28195":54922,"_3064":55326},[],{"_3608":1524,"_31008":1332,"_21483":55431,"_5":14766,"_28195":54922,"_3064":55432},[],"`Unconfigured` → `None` / `Auto`",{"_3608":1525,"_31008":1332,"_21483":55434,"_5":14766,"_28195":54922,"_3064":55435},[],"none (configuration only)",{"_3608":1526,"_31008":1332,"_21483":55437,"_5":14766,"_28195":54922,"_3064":55438},[],"`None` ↔ `Auto`",{"_3608":1527,"_31008":1332,"_21483":55440,"_5":14766,"_28195":54922,"_3064":55435},[],{"_3608":1528,"_31008":1332,"_21483":55442,"_5":14766,"_28195":54922,"_3064":55443},[],"Any → `Jitp`",{"_3608":1529,"_31008":1332,"_21483":55445,"_5":14766,"_28195":54922,"_3064":55446},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3608":1530,"_31008":1332,"_21483":55448,"_5":14766,"_28195":54922,"_3064":55449},[],"`Jitp` → `None` / `Auto`",{"_3608":1531,"_31008":1332,"_21483":55451,"_5":14766,"_28195":54922,"_3064":55452},[],"none (the template stays in the AWS account)",{"_3608":1532,"_31008":1332,"_21483":55454,"_5":14766,"_28195":54926,"_3064":55455},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3608":1533,"_31008":1332,"_21483":55457,"_5":14766,"_28195":54926,"_3064":55458},[],"The full flow from the device's perspective is:",{"_3608":1534,"_31008":1332,"_21483":55460,"_5":14766,"_28195":54926,"_3064":55461},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3608":1535,"_31008":1332,"_21483":55463,"_5":14766,"_28195":54930,"_3064":55464},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3608":1536,"_31008":1332,"_21483":55466,"_5":14766,"_28195":54930,"_3064":55323},[],{"_3608":1537,"_31008":1332,"_21483":55468,"_5":14766,"_28195":54930,"_3064":55326},[],{"_3608":1538,"_31008":1332,"_21483":55470,"_5":14766,"_28195":54930,"_3064":55471},[],"`Absent` → `Provisioned`",{"_3608":1539,"_31008":1332,"_21483":55473,"_5":14766,"_28195":54930,"_3064":55474},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3608":1540,"_31008":1332,"_21483":55476,"_5":14766,"_28195":54930,"_3064":55477},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3608":1541,"_31008":1332,"_21483":55479,"_5":14766,"_28195":54930,"_3064":55480},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3608":1542,"_31008":1332,"_21483":55482,"_5":14766,"_28195":54930,"_3064":55483},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3608":1543,"_31008":1332,"_21483":55485,"_5":14766,"_28195":54934,"_3064":55486},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3608":1544,"_31008":1332,"_21483":55488,"_5":14766,"_28195":54934,"_3064":55489},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3608":1545,"_31008":1332,"_21483":55491,"_5":14766,"_28195":54934,"_3064":55492},[],"For the JITP flow to work correctly:",{"_3608":1546,"_31008":1332,"_21483":55494,"_5":14766,"_28195":54934,"_3064":55495},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3608":1547,"_31008":1332,"_21483":55497,"_5":14766,"_28195":54934,"_3064":55498},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3608":1548,"_31008":1332,"_21483":55500,"_5":14766,"_28195":54934,"_3064":55501},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3608":1549,"_31008":1332,"_21483":55503,"_5":14766,"_28195":54934,"_3064":55504},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3608":1550,"_31008":1332,"_21483":55506,"_5":14766,"_28195":54938,"_3064":55507},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3608":1551,"_31008":1332,"_21483":55509,"_5":14766,"_28195":54938,"_3064":55510},[],"Status in Lamassu",{"_3608":1552,"_31008":1332,"_21483":55512,"_5":14766,"_28195":54938,"_3064":55513},[],"Revocation reason",{"_3608":1553,"_31008":1332,"_21483":55515,"_5":14766,"_28195":54938,"_3064":55516},[],"Status in AWS IoT Core",{"_3608":1554,"_31008":1332,"_21483":55518,"_5":14766,"_28195":54938,"_3064":55519},[],"`Active`",{"_3608":1555,"_31008":1332,"_21483":55521,"_5":14766,"_28195":54938,"_3064":55522},[],"None",{"_3608":1556,"_31008":1332,"_21483":55524,"_5":14766,"_28195":54938,"_3064":55525},[],"`ACTIVE`",{"_3608":1557,"_31008":1332,"_21483":55527,"_5":14766,"_28195":54938,"_3064":55528},[],"`Revoked`",{"_3608":1558,"_31008":1332,"_21483":55530,"_5":14766,"_28195":54938,"_3064":55531},[],"`certificateHold`",{"_3608":1559,"_31008":1332,"_21483":55533,"_5":14766,"_28195":54938,"_3064":55534},[],"`INACTIVE`",{"_3608":1560,"_31008":1332,"_21483":55536,"_5":14766,"_28195":54938,"_3064":55528},[],{"_3608":1561,"_31008":1332,"_21483":55538,"_5":14766,"_28195":54938,"_3064":55539},[],"Any other reason",{"_3608":1562,"_31008":1332,"_21483":55541,"_5":14766,"_28195":54938,"_3064":55542},[],"`REVOKED`",{"_3608":1563,"_31008":1332,"_21483":55544,"_5":14766,"_28195":54938,"_3064":55545},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3608":1564,"_31008":1332,"_21483":55547,"_5":14766,"_28195":54942,"_3064":55548},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3608":1565,"_31008":1332,"_21483":55550,"_5":14766,"_28195":54942,"_3064":55323},[],{"_3608":1566,"_31008":1332,"_21483":55552,"_5":14766,"_28195":54942,"_3064":55326},[],{"_3608":1567,"_31008":1332,"_21483":55554,"_5":14766,"_28195":54942,"_3064":55555},[],"`NotSynced` → `Active`",{"_3608":1568,"_31008":1332,"_21483":55557,"_5":14766,"_28195":54942,"_3064":55034},[],{"_3608":1569,"_31008":1332,"_21483":55559,"_5":14766,"_28195":54942,"_3064":55560},[],"`Active` → `Inactive`",{"_3608":1570,"_31008":1332,"_21483":55562,"_5":14766,"_28195":54942,"_3064":55563},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3608":1571,"_31008":1332,"_21483":55565,"_5":14766,"_28195":54942,"_3064":55566},[],"`Active` → `Revoked`",{"_3608":1572,"_31008":1332,"_21483":55568,"_5":14766,"_28195":54942,"_3064":55563},[],{"_3608":1573,"_31008":1332,"_21483":55570,"_5":14766,"_28195":54942,"_3064":55571},[],"`Inactive` / `Revoked` → `Active`",{"_3608":1574,"_31008":1332,"_21483":55573,"_5":14766,"_28195":54942,"_3064":55034},[],{"_3608":1575,"_31008":1332,"_21483":55575,"_5":14766,"_28195":54942,"_3064":55576},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3608":1576,"_31008":1332,"_21483":55578,"_5":14766,"_28195":54942,"_3064":55579},[],"none (these states are not synced to AWS)",{"_3608":1577,"_31008":1332,"_21483":55581,"_5":14766,"_28195":54946,"_3064":55582},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3608":1578,"_31008":1332,"_21483":55584,"_5":14766,"_28195":54946,"_3064":55585},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3608":1579,"_31008":1332,"_21483":55587,"_5":14766,"_28195":54946,"_3064":55588},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3608":1580,"_31008":1332,"_21483":55590,"_5":14766,"_28195":54950,"_3064":55591},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3608":1581,"_31008":1332,"_21483":55593,"_5":14766,"_28195":54950,"_3064":55594},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3608":1582,"_31008":1332,"_21483":55596,"_5":14766,"_28195":54954,"_3064":55597},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3608":1583,"_31008":1332,"_21483":55599,"_5":14766,"_28195":54954,"_3064":55600},[],"There are two action types:",{"_3608":1584,"_31008":1332,"_21483":55602,"_5":14766,"_28195":54954,"_3064":55603},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3608":1585,"_31008":1332,"_21483":55605,"_5":14766,"_28195":54954,"_3064":55606},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3608":1586,"_31008":1332,"_21483":55608,"_5":14766,"_28195":54954,"_3064":55609},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3608":1587,"_31008":1332,"_21483":55611,"_5":14766,"_28195":54958,"_3064":55612},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3608":1588,"_31008":1332,"_21483":55614,"_5":14766,"_28195":54958,"_3064":55615},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3608":1589,"_31008":1332,"_21483":55617,"_5":14766,"_28195":54958,"_3064":55618},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3608":1590,"_31008":1332,"_21483":55620,"_5":14766,"_28195":54962,"_3064":55621},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3608":1591,"_31008":1332,"_21483":55623,"_5":14766,"_28195":54962,"_3064":55624},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3608":1592,"_31008":1332,"_21483":55626,"_5":14766,"_28195":54962,"_3064":55627},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3608":1593,"_31008":1332,"_21483":55629,"_5":14766,"_28195":54962,"_3064":55630},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3608":1594,"_31008":1332,"_21483":55632,"_5":14766,"_28195":54962,"_3064":55633},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3608":1595,"_31008":1332,"_21483":55635,"_5":14766,"_28195":54962,"_3064":55636},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3608":1596,"_31008":1332,"_21483":55638,"_5":14766,"_28195":54962,"_3064":55639},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3608":1597,"_31008":1332,"_21483":55641,"_5":14766,"_28195":54962,"_3064":55642},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3608":1598,"_31008":1332,"_21483":55644,"_5":14766,"_28195":54962,"_3064":55645},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3608":1599,"_31008":1332,"_21483":55647,"_5":14766,"_28195":54962,"_3064":55648},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3608":1600,"_31008":1332,"_21483":55650,"_5":14766,"_28195":54962,"_3064":55651},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3608":1601,"_31008":1332,"_21483":55653,"_5":14766,"_28195":54962,"_3064":55654},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3608":1602,"_31008":1332,"_21483":55656,"_5":14766,"_28195":54962,"_3064":55657},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3608":1603,"_31008":1332,"_21483":55659,"_5":14766,"_28195":54962,"_3064":55660},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3608":1604,"_31008":1332,"_21483":55662,"_5":14766,"_28195":54962,"_3064":55663},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3608":1605,"_31008":1332,"_21483":55665,"_5":14766,"_28195":54962,"_3064":55666},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3608":1606,"_31008":1332,"_21483":55668,"_5":14766,"_28195":54962,"_3064":55669},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3608":1607,"_31008":1332,"_21483":55671,"_5":14766,"_28195":54962,"_3064":55672},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3608":1608,"_31008":1332,"_21483":55674,"_5":14766,"_28195":54962,"_3064":55675},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3608":1609,"_31008":1332,"_21483":55677,"_5":14766,"_28195":54962,"_3064":55678},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3608":1610,"_31008":1332,"_21483":55680,"_5":14766,"_28195":54962,"_3064":55681},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3608":1611,"_31008":1332,"_21483":55683,"_5":14766,"_28195":54962,"_3064":55684},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3608":1612,"_31008":1332,"_21483":55686,"_5":14766,"_28195":54962,"_3064":55687},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3608":1613,"_31008":1332,"_21483":55689,"_5":14766,"_28195":54962,"_3064":55690},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3608":1614,"_31008":1614,"_5":15126,"_3064":53397,"_31366":55692,"_21483":55693,"_28195":1614},[50713,52225,53397],[],{"_3608":1615,"_31008":1614,"_21483":55695,"_5":14766,"_28195":1614,"_3064":55696},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3608":1616,"_31008":1614,"_5":31363,"_21483":55698,"_28195":55699,"_3064":55700},[],"/docs/pr-preview/pr-72/platform/iot-fleets/overview#start-here","Start here",{"_3608":1617,"_31008":1614,"_5":31363,"_21483":55702,"_28195":55703,"_3064":53395},[],"/docs/pr-preview/pr-72/platform/iot-fleets/overview#devices-and-identities",{"_3608":1618,"_31008":1614,"_5":31363,"_21483":55705,"_28195":55706,"_3064":53578},[],"/docs/pr-preview/pr-72/platform/iot-fleets/overview#enrollment-with-pki",{"_3608":1619,"_31008":1614,"_5":31363,"_21483":55708,"_28195":55709,"_3064":54859},[],"/docs/pr-preview/pr-72/platform/iot-fleets/overview#integrations",{"_3608":1620,"_31008":1614,"_5":31363,"_21483":55711,"_28195":55712,"_3064":55713},[],"/docs/pr-preview/pr-72/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3608":1621,"_31008":1614,"_21483":55715,"_5":14766,"_28195":1614,"_3064":55716},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3608":1622,"_31008":1614,"_21483":55718,"_5":14766,"_28195":55699,"_3064":55719},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3608":1623,"_31008":1614,"_21483":55721,"_5":14766,"_28195":55699,"_3064":55722},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3608":1624,"_31008":1614,"_21483":55724,"_5":14766,"_28195":55703,"_3064":55725},[],"Resource",{"_3608":1625,"_31008":1614,"_21483":55727,"_5":14766,"_28195":55703,"_3064":55728},[],"What it represents",{"_3608":1626,"_31008":1614,"_21483":55730,"_5":14766,"_28195":55703,"_3064":55731},[],"**Device**",{"_3608":1627,"_31008":1614,"_21483":55733,"_5":14766,"_28195":55703,"_3064":55734},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3608":1628,"_31008":1614,"_21483":55736,"_5":14766,"_28195":55703,"_3064":55737},[],"**Identity**",{"_3608":1629,"_31008":1614,"_21483":55739,"_5":14766,"_28195":55703,"_3064":55740},[],"The device's association with its certificates: an active version and a history.",{"_3608":1630,"_31008":1614,"_21483":55742,"_5":14766,"_28195":55703,"_3064":55743},[],"**DMS**",{"_3608":1631,"_31008":1614,"_21483":55745,"_5":14766,"_28195":55703,"_3064":55746},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3608":1632,"_31008":1614,"_21483":55748,"_5":14766,"_28195":55703,"_3064":55749},[],"**Fleet**",{"_3608":1633,"_31008":1614,"_21483":55751,"_5":14766,"_28195":55703,"_3064":55752},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3608":1634,"_31008":1614,"_21483":55754,"_5":14766,"_28195":55703,"_3064":55755},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3608":1635,"_31008":1614,"_21483":55757,"_5":14766,"_28195":55703,"_3064":55758},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3608":1636,"_31008":1614,"_21483":55760,"_5":14766,"_28195":55706,"_3064":55761},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3608":1637,"_31008":1614,"_21483":55763,"_5":14766,"_28195":55706,"_3064":55764},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3608":1638,"_31008":1614,"_21483":55766,"_5":14766,"_28195":55706,"_3064":55767},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3608":1639,"_31008":1614,"_21483":55769,"_5":14766,"_28195":55706,"_3064":55770},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3608":1640,"_31008":1614,"_21483":55772,"_5":14766,"_28195":55706,"_3064":55773},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3608":1641,"_31008":1614,"_21483":55775,"_5":14766,"_28195":55706,"_3064":55776},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3608":1642,"_31008":1614,"_21483":55778,"_5":14766,"_28195":55706,"_3064":55779},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3608":1643,"_31008":1614,"_21483":55781,"_5":14766,"_28195":55706,"_3064":55782},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3608":1644,"_31008":1614,"_21483":55784,"_5":14766,"_28195":55709,"_3064":55785},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3608":1645,"_31008":1614,"_21483":55787,"_5":14766,"_28195":55709,"_3064":55788},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3608":1646,"_31008":1614,"_21483":55790,"_5":14766,"_28195":55712,"_3064":55791},[],"Participant",{"_3608":1647,"_31008":1614,"_21483":55793,"_5":14766,"_28195":55712,"_3064":55794},[],"Responsibility",{"_3608":1648,"_31008":1614,"_21483":55796,"_5":14766,"_28195":55712,"_3064":55797},[],"PKI administrator",{"_3608":1649,"_31008":1614,"_21483":55799,"_5":14766,"_28195":55712,"_3064":55800},[],"CA, issuance profile, chain and revocation publication.",{"_3608":1650,"_31008":1614,"_21483":55802,"_5":14766,"_28195":55712,"_3064":55803},[],"Provisioning administrator",{"_3608":1651,"_31008":1614,"_21483":55805,"_5":14766,"_28195":55712,"_3064":55806},[],"DMS, admission, authentication per operation and inventory.",{"_3608":1652,"_31008":1614,"_21483":55808,"_5":14766,"_28195":55712,"_3064":55809},[],"Device integrator",{"_3608":1653,"_31008":1614,"_21483":55811,"_5":14766,"_28195":55712,"_3064":55812},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3608":1654,"_31008":1614,"_21483":55814,"_5":14766,"_28195":55712,"_3064":55815},[],"Consumer integrator",{"_3608":1655,"_31008":1614,"_21483":55817,"_5":14766,"_28195":55712,"_3064":55818},[],"Trusted issuers, validation and device permissions in the destination.",{"_3608":1656,"_31008":1614,"_21483":55820,"_5":14766,"_28195":55712,"_3064":55821},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3608":1657,"_31008":1657,"_5":15126,"_3064":55823,"_31366":55824,"_21483":55826,"_28195":1657},"Enroll and connect your first device",[50713,52225,53397,55825],"Getting started",[],{"_3608":1658,"_31008":1657,"_21483":55828,"_5":14766,"_28195":1657,"_3064":55829},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3608":1659,"_31008":1657,"_5":31363,"_21483":55831,"_28195":55832,"_3064":50723},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3608":1660,"_31008":1657,"_5":31363,"_21483":55834,"_28195":55835,"_3064":55836},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3608":1661,"_31008":1657,"_5":31363,"_21483":55838,"_28195":55839,"_3064":55840},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3608":1662,"_31008":1657,"_5":31363,"_21483":55842,"_28195":55843,"_3064":55844},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3608":1663,"_31008":1657,"_5":31363,"_21483":55846,"_28195":55847,"_3064":55848},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3608":1664,"_31008":1657,"_5":31363,"_21483":55850,"_28195":55851,"_3064":55852},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3608":1665,"_31008":1657,"_5":31363,"_21483":55854,"_28195":55855,"_3064":55856},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3608":1666,"_31008":1657,"_5":31363,"_21483":55858,"_28195":55859,"_3064":55860},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3608":1667,"_31008":1657,"_21483":55862,"_5":14766,"_28195":1657,"_3064":55863},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3608":1668,"_31008":1657,"_21483":55865,"_5":14766,"_28195":55832,"_3064":55866},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3608":1669,"_31008":1657,"_21483":55868,"_5":14766,"_28195":55832,"_3064":55869},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3608":1670,"_31008":1657,"_21483":55871,"_5":14766,"_28195":55832,"_3064":55872},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3608":1671,"_31008":1657,"_21483":55874,"_5":14766,"_28195":55832,"_3064":55875},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3608":1672,"_31008":1657,"_21483":55877,"_5":14766,"_28195":55832,"_3064":55878},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3608":1673,"_31008":1657,"_21483":55880,"_5":14766,"_28195":55835,"_3064":55881},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3608":1674,"_31008":1657,"_21483":55883,"_5":14766,"_28195":55835,"_3064":55884},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3608":1675,"_31008":1657,"_21483":55886,"_5":14766,"_28195":55839,"_3064":55887},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3608":1676,"_31008":1657,"_21483":55889,"_5":14766,"_28195":55839,"_3064":55890},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3608":1677,"_31008":1657,"_21483":55892,"_5":14766,"_28195":55839,"_3064":55893},[],"Setting",{"_3608":1678,"_31008":1657,"_21483":55895,"_5":14766,"_28195":55839,"_3064":55896},[],"Evaluation value",{"_3608":1679,"_31008":1657,"_21483":55898,"_5":14766,"_28195":55839,"_3064":55899},[],"Enrollment CA",{"_3608":1680,"_31008":1657,"_21483":55901,"_5":14766,"_28195":55839,"_3064":55902},[],"Issuing root from `device-root.pem`.",{"_3608":1681,"_31008":1657,"_21483":55904,"_5":14766,"_28195":55839,"_3064":53708},[],{"_3608":1682,"_31008":1657,"_21483":55906,"_5":14766,"_28195":55839,"_3064":55907},[],"The 1-hour leaf profile you just prepared.",{"_3608":1683,"_31008":1657,"_21483":55909,"_5":14766,"_28195":55839,"_3064":55910},[],"Protocol / Registration Mode",{"_3608":1684,"_31008":1657,"_21483":55912,"_5":14766,"_28195":55839,"_3064":55913},[],"`EST_RFC7030` / `JITP`.",{"_3608":1685,"_31008":1657,"_21483":55915,"_5":14766,"_28195":55839,"_3064":55916},[],"Verify CSR Signature",{"_3608":1686,"_31008":1657,"_21483":55918,"_5":14766,"_28195":55839,"_3064":55919},[],"Enabled.",{"_3608":1687,"_31008":1657,"_21483":55921,"_5":14766,"_28195":55839,"_3064":55922},[],"Enable Replaceable Enrollment",{"_3608":1688,"_31008":1657,"_21483":55924,"_5":14766,"_28195":55839,"_3064":55925},[],"Disabled; the ID must be new.",{"_3608":1689,"_31008":1657,"_21483":55927,"_5":14766,"_28195":55839,"_3064":55928},[],"Initial authentication",{"_3608":1690,"_31008":1657,"_21483":55930,"_5":14766,"_28195":55839,"_3064":55931},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3608":1691,"_31008":1657,"_21483":55933,"_5":14766,"_28195":55839,"_3064":55934},[],"Renewal authentication",{"_3608":1692,"_31008":1657,"_21483":55936,"_5":14766,"_28195":55839,"_3064":55937},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3608":1693,"_31008":1657,"_21483":55939,"_5":14766,"_28195":55839,"_3064":55940},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3608":1694,"_31008":1657,"_21483":55942,"_5":14766,"_28195":55839,"_3064":55943},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3608":1695,"_31008":1657,"_21483":55945,"_5":14766,"_28195":55839,"_3064":55946},[],"Re-enrollment Delta",{"_3608":1696,"_31008":1657,"_21483":55948,"_5":14766,"_28195":55839,"_3064":55949},[],"1 hour.",{"_3608":1697,"_31008":1657,"_21483":55951,"_5":14766,"_28195":55839,"_3064":55952},[],"Preventive / Critical Delta",{"_3608":1698,"_31008":1657,"_21483":55954,"_5":14766,"_28195":55839,"_3064":55955},[],"30 minutes / 10 minutes.",{"_3608":1699,"_31008":1657,"_21483":55957,"_5":14766,"_28195":55839,"_3064":55958},[],"Revoke on Re-enrollment",{"_3608":1700,"_31008":1657,"_21483":55960,"_5":14766,"_28195":55839,"_3064":55961},[],"Disabled to test the successor before retiring the previous identity.",{"_3608":1701,"_31008":1657,"_21483":55963,"_5":14766,"_28195":55839,"_3064":53716},[],{"_3608":1702,"_31008":1657,"_21483":55965,"_5":14766,"_28195":55839,"_3064":55966},[],"Disabled; the operational key is generated in the client.",{"_3608":1703,"_31008":1657,"_21483":55968,"_5":14766,"_28195":55839,"_3064":55969},[],"CA Distribution",{"_3608":1704,"_31008":1657,"_21483":55971,"_5":14766,"_28195":55839,"_3064":55972},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3608":1705,"_31008":1657,"_21483":55974,"_5":14766,"_28195":55839,"_3064":55975},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3608":1706,"_31008":1657,"_21483":55977,"_5":14766,"_28195":55843,"_3064":55978},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3608":1707,"_31008":1657,"_21483":55980,"_5":14766,"_28195":55843,"_3064":55981},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3608":1708,"_31008":1657,"_21483":55983,"_5":14766,"_28195":55847,"_3064":55984},[],"Generate a new key and CSR with the selected identifier:",{"_3608":1709,"_31008":1657,"_21483":55986,"_5":14766,"_28195":55847,"_3064":55987},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3608":1710,"_31008":1657,"_21483":55989,"_5":14766,"_28195":55847,"_3064":55990},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3608":1711,"_31008":1657,"_21483":55992,"_5":14766,"_28195":55851,"_3064":55993},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3608":1712,"_31008":1657,"_21483":55995,"_5":14766,"_28195":55851,"_3064":55996},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3608":1713,"_31008":1657,"_21483":55998,"_5":14766,"_28195":55855,"_3064":55999},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3608":1714,"_31008":1657,"_21483":56001,"_5":14766,"_28195":55855,"_3064":56002},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3608":1715,"_31008":1657,"_21483":56004,"_5":14766,"_28195":55855,"_3064":56005},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3608":1716,"_31008":1657,"_21483":56007,"_5":14766,"_28195":55855,"_3064":56008},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3608":1717,"_31008":1657,"_21483":56010,"_5":14766,"_28195":55855,"_3064":56011},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3608":1718,"_31008":1657,"_21483":56013,"_5":14766,"_28195":55859,"_3064":56014},[],"Check",{"_3608":1719,"_31008":1657,"_21483":56016,"_5":14766,"_28195":55859,"_3064":56017},[],"Expected result",{"_3608":1720,"_31008":1657,"_21483":56019,"_5":14766,"_28195":55859,"_3064":56020},[],"Registration",{"_3608":1721,"_31008":1657,"_21483":56022,"_5":14766,"_28195":55859,"_3064":56023},[],"ID created automatically and correct DMS.",{"_3608":1722,"_31008":1657,"_21483":56025,"_5":14766,"_28195":55859,"_3064":55281},[],{"_3608":1723,"_31008":1657,"_21483":56027,"_5":14766,"_28195":55859,"_3064":56028},[],"CN, profile, serial and key verified.",{"_3608":1724,"_31008":1657,"_21483":56030,"_5":14766,"_28195":55859,"_3064":56031},[],"Inventory",{"_3608":1725,"_31008":1657,"_21483":56033,"_5":14766,"_28195":55859,"_3064":56034},[],"Received serial visible as the current identity and in history.",{"_3608":1726,"_31008":1657,"_21483":56036,"_5":14766,"_28195":55859,"_3064":56037},[],"Consumer",{"_3608":1727,"_31008":1657,"_21483":56039,"_5":14766,"_28195":55859,"_3064":56040},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3608":1728,"_31008":1657,"_21483":56042,"_5":14766,"_28195":55859,"_3064":56043},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3608":1729,"_31008":1657,"_21483":56045,"_5":14766,"_28195":55859,"_3064":56046},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3608":1730,"_31008":1730,"_5":15126,"_3064":53413,"_31366":56048,"_21483":56049,"_28195":1730},[50713,52225,53397,55825],[],{"_3608":1731,"_31008":1730,"_21483":56051,"_5":14766,"_28195":1730,"_3064":56052},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3608":1732,"_31008":1730,"_5":31363,"_21483":56054,"_28195":56055,"_3064":50723},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3608":1733,"_31008":1730,"_5":31363,"_21483":56057,"_28195":56058,"_3064":56059},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3608":1734,"_31008":1730,"_5":31363,"_21483":56061,"_28195":56062,"_3064":56063},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3608":1735,"_31008":1730,"_5":31363,"_21483":56065,"_28195":56066,"_3064":56067},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3608":1736,"_31008":1730,"_5":31363,"_21483":56069,"_28195":56070,"_3064":56071},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3608":1737,"_31008":1730,"_5":31363,"_21483":56073,"_28195":56074,"_3064":56075},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3608":1738,"_31008":1730,"_5":31363,"_21483":56077,"_28195":56078,"_3064":56017},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3608":1739,"_31008":1730,"_5":31363,"_21483":56080,"_28195":56081,"_3064":56082},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3608":1740,"_31008":1730,"_5":31363,"_21483":56084,"_28195":56085,"_3064":56086},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3608":1741,"_31008":1730,"_21483":56088,"_5":14766,"_28195":1730,"_3064":56089},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3608":1742,"_31008":1730,"_21483":56091,"_5":14766,"_28195":1730,"_3064":56092},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3608":1743,"_31008":1730,"_21483":56094,"_5":14766,"_28195":56055,"_3064":56095},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3608":1744,"_31008":1730,"_21483":56097,"_5":14766,"_28195":56055,"_3064":56098},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3608":1745,"_31008":1730,"_21483":56100,"_5":14766,"_28195":56055,"_3064":56101},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3608":1746,"_31008":1730,"_21483":56103,"_5":14766,"_28195":56055,"_3064":56104},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3608":1747,"_31008":1730,"_21483":56106,"_5":14766,"_28195":56058,"_3064":56107},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3608":1748,"_31008":1730,"_21483":56109,"_5":14766,"_28195":56058,"_3064":56110},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3608":1749,"_31008":1730,"_21483":56112,"_5":14766,"_28195":56058,"_3064":56113},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3608":1750,"_31008":1730,"_21483":56115,"_5":14766,"_28195":56058,"_3064":56116},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3608":1751,"_31008":1730,"_21483":56118,"_5":14766,"_28195":56058,"_3064":56119},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3608":1752,"_31008":1730,"_21483":56121,"_5":14766,"_28195":56058,"_3064":56122},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3608":1753,"_31008":1730,"_21483":56124,"_5":14766,"_28195":56058,"_3064":56125},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3608":1754,"_31008":1730,"_21483":56127,"_5":14766,"_28195":56058,"_3064":56128},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3608":1755,"_31008":1730,"_21483":56130,"_5":14766,"_28195":56062,"_3064":56131},[],"Open **Managed Devices** and the registration action. Complete:",{"_3608":1756,"_31008":1730,"_21483":56133,"_5":14766,"_28195":56062,"_3064":56134},[],"**Device ID**: `device-001`.",{"_3608":1757,"_31008":1730,"_21483":56136,"_5":14766,"_28195":56062,"_3064":56137},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3608":1758,"_31008":1730,"_21483":56139,"_5":14766,"_28195":56062,"_3064":56140},[],"**Icon** and **Tags**: optional classification.",{"_3608":1759,"_31008":1730,"_21483":56142,"_5":14766,"_28195":56062,"_3064":56143},[],"Confirm registration.",{"_3608":1760,"_31008":1730,"_21483":56145,"_5":14766,"_28195":56066,"_3064":56146},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3608":1761,"_31008":1730,"_21483":56148,"_5":14766,"_28195":56066,"_3064":56149},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3608":1762,"_31008":1730,"_21483":56151,"_5":14766,"_28195":56070,"_3064":56152},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3608":1763,"_31008":1730,"_21483":56154,"_5":14766,"_28195":56070,"_3064":56155},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3608":1764,"_31008":1730,"_21483":56157,"_5":14766,"_28195":56074,"_3064":56158},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3608":1765,"_31008":1730,"_21483":56160,"_5":14766,"_28195":56074,"_3064":56161},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3608":1766,"_31008":1730,"_21483":56163,"_5":14766,"_28195":56078,"_3064":56014},[],{"_3608":1767,"_31008":1730,"_21483":56165,"_5":14766,"_28195":56078,"_3064":56166},[],"Result",{"_3608":1768,"_31008":1730,"_21483":56168,"_5":14766,"_28195":56078,"_3064":55264},[],{"_3608":1769,"_31008":1730,"_21483":56170,"_5":14766,"_28195":56078,"_3064":56171},[],"`device-001` appears in inventory with the expected DMS.",{"_3608":1770,"_31008":1730,"_21483":56173,"_5":14766,"_28195":56078,"_3064":56174},[],"Current identity",{"_3608":1771,"_31008":1730,"_21483":56176,"_5":14766,"_28195":56078,"_3064":56177},[],"The associated certificate matches the one you verified in PKI.",{"_3608":1772,"_31008":1730,"_21483":56179,"_5":14766,"_28195":56078,"_3064":56180},[],"History",{"_3608":1773,"_31008":1730,"_21483":56182,"_5":14766,"_28195":56078,"_3064":56183},[],"The associated issuance appears with its serial number and dates.",{"_3608":1774,"_31008":1730,"_21483":56185,"_5":14766,"_28195":56078,"_3064":56186},[],"Key and certificate",{"_3608":1775,"_31008":1730,"_21483":56188,"_5":14766,"_28195":56078,"_3064":56189},[],"You have the verified pair ready to install on the device.",{"_3608":1776,"_31008":1730,"_21483":56191,"_5":14766,"_28195":56081,"_3064":56192},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3608":1777,"_31008":1730,"_21483":56194,"_5":14766,"_28195":56081,"_3064":56195},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3608":1778,"_31008":1730,"_21483":56197,"_5":14766,"_28195":56081,"_3064":56198},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3608":1779,"_31008":1730,"_21483":56200,"_5":14766,"_28195":56081,"_3064":56201},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3608":1780,"_31008":1730,"_21483":56203,"_5":14766,"_28195":56085,"_3064":56204},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3608":1781,"_31008":1730,"_21483":56206,"_5":14766,"_28195":56085,"_3064":56207},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3608":1782,"_31008":1730,"_21483":56209,"_5":14766,"_28195":56085,"_3064":56210},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3608":1783,"_31008":1783,"_5":15126,"_3064":56212,"_31366":56213,"_21483":56214,"_28195":1783},"Lamassu IoT Platform",[50713,52225],[],{"_3608":1784,"_31008":1783,"_21483":56216,"_5":14766,"_28195":1783,"_3064":56217},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3608":1785,"_31008":1783,"_5":31363,"_21483":56219,"_28195":56220,"_3064":55700},[],"/docs/pr-preview/pr-72/platform/overview#start-here",{"_3608":1786,"_31008":1783,"_5":31363,"_21483":56222,"_28195":56223,"_3064":56224},[],"/docs/pr-preview/pr-72/platform/overview#choose-your-path","Choose your path",{"_3608":1787,"_31008":1783,"_5":31363,"_21483":56226,"_28195":56227,"_3064":56228},[],"/docs/pr-preview/pr-72/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3608":1788,"_31008":1783,"_5":31363,"_21483":56230,"_28195":56231,"_3064":56232},[],"/docs/pr-preview/pr-72/platform/overview#core-capabilities","Core capabilities",{"_3608":1789,"_31008":1783,"_5":31363,"_21483":56234,"_28195":56235,"_3064":56236},[],"/docs/pr-preview/pr-72/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3608":1790,"_31008":1783,"_5":31363,"_21483":56238,"_28195":56239,"_3064":56240},[],"/docs/pr-preview/pr-72/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3608":1791,"_31008":1783,"_5":31363,"_21483":56242,"_28195":56243,"_3064":56244},[],"/docs/pr-preview/pr-72/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3608":1792,"_31008":1783,"_5":31363,"_21483":56246,"_28195":56247,"_3064":56248},[],"/docs/pr-preview/pr-72/platform/overview#automate-device-identities","Automate device identities",{"_3608":1793,"_31008":1783,"_5":31363,"_21483":56250,"_28195":56251,"_3064":56252},[],"/docs/pr-preview/pr-72/platform/overview#publish-validation-status","Publish validation status",{"_3608":1794,"_31008":1783,"_5":31363,"_21483":56254,"_28195":56255,"_3064":56256},[],"/docs/pr-preview/pr-72/platform/overview#react-to-events","React to events",{"_3608":1795,"_31008":1783,"_5":31363,"_21483":56258,"_28195":56259,"_3064":56260},[],"/docs/pr-preview/pr-72/platform/overview#operational-reference","Operational reference",{"_3608":1796,"_31008":1783,"_21483":56262,"_5":14766,"_28195":1783,"_3064":56263},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3608":1797,"_31008":1783,"_21483":56265,"_5":14766,"_28195":56220,"_3064":56266},[],"Choose the result you need:",{"_3608":1798,"_31008":1783,"_21483":56268,"_5":14766,"_28195":56220,"_3064":56269},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3608":1799,"_31008":1783,"_21483":56271,"_5":14766,"_28195":56220,"_3064":56272},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3608":1800,"_31008":1783,"_21483":56274,"_5":14766,"_28195":56220,"_3064":56275},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3608":1801,"_31008":1783,"_21483":56277,"_5":14766,"_28195":56223,"_3064":56278},[],"Section",{"_3608":1802,"_31008":1783,"_21483":56280,"_5":14766,"_28195":56223,"_3064":56281},[],"What you manage",{"_3608":1803,"_31008":1783,"_21483":56283,"_5":14766,"_28195":56223,"_3064":56284},[],"Entry point",{"_3608":1804,"_31008":1783,"_21483":56286,"_5":14766,"_28195":56223,"_3064":56287},[],"**PKI**",{"_3608":1805,"_31008":1783,"_21483":56289,"_5":14766,"_28195":56223,"_3064":56290},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3608":1806,"_31008":1783,"_21483":56292,"_5":14766,"_28195":56223,"_3064":56293},[],"PKI overview",{"_3608":1807,"_31008":1783,"_21483":56295,"_5":14766,"_28195":56223,"_3064":56296},[],"**IoT Fleets**",{"_3608":1808,"_31008":1783,"_21483":56298,"_5":14766,"_28195":56223,"_3064":56299},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3608":1809,"_31008":1783,"_21483":56301,"_5":14766,"_28195":56223,"_3064":56302},[],"IoT Fleets overview",{"_3608":1810,"_31008":1783,"_21483":56304,"_5":14766,"_28195":56223,"_3064":56305},[],"**Administration**",{"_3608":1811,"_31008":1783,"_21483":56307,"_5":14766,"_28195":56223,"_3064":56308},[],"Operator permissions, audit and event subscriptions.",{"_3608":1812,"_31008":1783,"_21483":56310,"_5":14766,"_28195":56223,"_3064":52227},[],{"_3608":1813,"_31008":1783,"_21483":56312,"_5":14766,"_28195":56223,"_3064":56313},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3608":1814,"_31008":1783,"_21483":56315,"_5":14766,"_28195":56227,"_3064":56316},[],"An identity's journey connects four responsibilities:",{"_3608":1815,"_31008":1783,"_21483":56318,"_5":14766,"_28195":56227,"_3064":56319},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3608":1816,"_31008":1783,"_21483":56321,"_5":14766,"_28195":56227,"_3064":56322},[],"The provisioning administrator configures the DMS and initial trust.",{"_3608":1817,"_31008":1783,"_21483":56324,"_5":14766,"_28195":56227,"_3064":56325},[],"The device client requests a certificate and installs it with the matching key.",{"_3608":1818,"_31008":1783,"_21483":56327,"_5":14766,"_28195":56227,"_3064":56328},[],"The consumer validates the identity and applies its access permissions.",{"_3608":1819,"_31008":1783,"_21483":56330,"_5":14766,"_28195":56227,"_3064":56331},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3608":1820,"_31008":1783,"_21483":56333,"_5":14766,"_28195":56235,"_3064":56334},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3608":1821,"_31008":1783,"_21483":56336,"_5":14766,"_28195":56239,"_3064":56337},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3608":1822,"_31008":1783,"_21483":56339,"_5":14766,"_28195":56243,"_3064":56340},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3608":1823,"_31008":1783,"_21483":56342,"_5":14766,"_28195":56247,"_3064":56343},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3608":1824,"_31008":1783,"_21483":56345,"_5":14766,"_28195":56251,"_3064":56346},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3608":1825,"_31008":1783,"_21483":56348,"_5":14766,"_28195":56255,"_3064":56349},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3608":1826,"_31008":1783,"_21483":56351,"_5":14766,"_28195":56259,"_3064":55794},[],{"_3608":1827,"_31008":1783,"_21483":56353,"_5":14766,"_28195":56259,"_3064":56354},[],"What it prepares or checks",{"_3608":1828,"_31008":1783,"_21483":56356,"_5":14766,"_28195":56259,"_3064":55797},[],{"_3608":1829,"_31008":1783,"_21483":56358,"_5":14766,"_28195":56259,"_3064":56359},[],"Key custody, CA hierarchy, profiles and validation.",{"_3608":1830,"_31008":1783,"_21483":56361,"_5":14766,"_28195":56259,"_3064":56362},[],"Fleet administrator",{"_3608":1831,"_31008":1783,"_21483":56364,"_5":14766,"_28195":56259,"_3064":56365},[],"DMS, device admission, renewal policy and inventory.",{"_3608":1832,"_31008":1783,"_21483":56367,"_5":14766,"_28195":56259,"_3064":55809},[],{"_3608":1833,"_31008":1783,"_21483":56369,"_5":14766,"_28195":56259,"_3064":56370},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3608":1834,"_31008":1783,"_21483":56372,"_5":14766,"_28195":56259,"_3064":55815},[],{"_3608":1835,"_31008":1783,"_21483":56374,"_5":14766,"_28195":56259,"_3064":56375},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3608":1836,"_31008":1783,"_21483":56377,"_5":14766,"_28195":56259,"_3064":56378},[],"Infrastructure operator",{"_3608":1837,"_31008":1783,"_21483":56380,"_5":14766,"_28195":56259,"_3064":56381},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3608":1838,"_31008":1783,"_21483":56383,"_5":14766,"_28195":56259,"_3064":56384},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3608":1839,"_31008":1839,"_5":15126,"_3064":56386,"_31366":56387,"_21483":56390,"_28195":1839},"CA hierarchy and rotation",[50713,52225,56388,56389],"PKI","Keys, authorities and certificates",[],{"_3608":1840,"_31008":1839,"_21483":56392,"_5":14766,"_28195":1839,"_3064":56393},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3608":1841,"_31008":1839,"_5":31363,"_21483":56395,"_28195":56396,"_3064":56397},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3608":1842,"_31008":1839,"_5":31363,"_21483":56399,"_28195":56400,"_3064":56401},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3608":1843,"_31008":1839,"_5":31363,"_21483":56403,"_28195":56404,"_3064":56405},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3608":1844,"_31008":1839,"_5":31363,"_21483":56407,"_28195":56408,"_3064":56409},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3608":1845,"_31008":1839,"_5":31363,"_21483":56411,"_28195":56412,"_3064":56413},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3608":1846,"_31008":1839,"_5":31363,"_21483":56415,"_28195":56416,"_3064":56417},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3608":1847,"_31008":1839,"_5":31363,"_21483":56419,"_28195":56420,"_3064":56421},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3608":1848,"_31008":1839,"_5":31363,"_21483":56423,"_28195":56424,"_3064":56425},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3608":1849,"_31008":1839,"_5":31363,"_21483":56427,"_28195":56428,"_3064":56429},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3608":1850,"_31008":1839,"_5":31363,"_21483":56431,"_28195":56432,"_3064":56433},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3608":1851,"_31008":1839,"_5":31363,"_21483":56435,"_28195":56436,"_3064":56437},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3608":1852,"_31008":1839,"_5":31363,"_21483":56439,"_28195":56440,"_3064":56441},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3608":1853,"_31008":1839,"_21483":56443,"_5":14766,"_28195":1839,"_3064":56444},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3608":1854,"_31008":1839,"_21483":56446,"_5":14766,"_28195":1839,"_3064":56447},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3608":1855,"_31008":1839,"_21483":56449,"_5":14766,"_28195":56396,"_3064":56450},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3608":1856,"_31008":1839,"_21483":56452,"_5":14766,"_28195":56396,"_3064":56453},[],"environment, such as production and preproduction;",{"_3608":1857,"_31008":1839,"_21483":56455,"_5":14766,"_28195":56396,"_3064":56456},[],"owner or operating team;",{"_3608":1858,"_31008":1839,"_21483":56458,"_5":14766,"_28195":56396,"_3064":56459},[],"device family or manufacturing process;",{"_3608":1859,"_31008":1839,"_21483":56461,"_5":14766,"_28195":56396,"_3064":56462},[],"region or regulatory requirement;",{"_3608":1860,"_31008":1839,"_21483":56464,"_5":14766,"_28195":56396,"_3064":56465},[],"cryptographic engine or key policy;",{"_3608":1861,"_31008":1839,"_21483":56467,"_5":14766,"_28195":56396,"_3064":56468},[],"maintenance window and renewal cadence.",{"_3608":1862,"_31008":1839,"_21483":56470,"_5":14766,"_28195":56396,"_3064":56471},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3608":1863,"_31008":1839,"_21483":56473,"_5":14766,"_28195":56396,"_3064":56474},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3608":1864,"_31008":1839,"_21483":56476,"_5":14766,"_28195":56400,"_3064":56477},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3608":1865,"_31008":1839,"_21483":56479,"_5":14766,"_28195":56400,"_3064":56480},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3608":1866,"_31008":1839,"_21483":56482,"_5":14766,"_28195":56400,"_3064":56483},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3608":1867,"_31008":1839,"_21483":56485,"_5":14766,"_28195":56400,"_3064":56486},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3608":1868,"_31008":1839,"_21483":56488,"_5":14766,"_28195":56404,"_3064":56489},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3608":1869,"_31008":1839,"_21483":56491,"_5":14766,"_28195":56404,"_3064":56492},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3608":1870,"_31008":1839,"_21483":56494,"_5":14766,"_28195":56404,"_3064":56495},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3608":1871,"_31008":1839,"_21483":56497,"_5":14766,"_28195":56404,"_3064":56498},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3608":1872,"_31008":1839,"_21483":56500,"_5":14766,"_28195":56412,"_3064":56501},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3608":1873,"_31008":1839,"_21483":56503,"_5":14766,"_28195":56416,"_3064":56504},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3608":1874,"_31008":1839,"_21483":56506,"_5":14766,"_28195":56420,"_3064":56507},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3608":1875,"_31008":1839,"_21483":56509,"_5":14766,"_28195":56424,"_3064":56510},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3608":1876,"_31008":1839,"_21483":56512,"_5":14766,"_28195":56428,"_3064":56513},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3608":1877,"_31008":1839,"_21483":56515,"_5":14766,"_28195":56432,"_3064":56516},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3608":1878,"_31008":1839,"_21483":56518,"_5":14766,"_28195":56436,"_3064":56519},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3608":1879,"_31008":1839,"_21483":56521,"_5":14766,"_28195":56436,"_3064":56522},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3608":1880,"_31008":1839,"_21483":56524,"_5":14766,"_28195":56436,"_3064":56525},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3608":1881,"_31008":1839,"_21483":56527,"_5":14766,"_28195":56436,"_3064":56528},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3608":1882,"_31008":1839,"_21483":56530,"_5":14766,"_28195":56440,"_3064":56531},[],"The new chain ends in an anchor installed by the consumer.",{"_3608":1883,"_31008":1839,"_21483":56533,"_5":14766,"_28195":56440,"_3064":56534},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3608":1884,"_31008":1839,"_21483":56536,"_5":14766,"_28195":56440,"_3064":56537},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3608":1885,"_31008":1839,"_21483":56539,"_5":14766,"_28195":56440,"_3064":56540},[],"Re-enrollment accepts the old identity during the planned period.",{"_3608":1886,"_31008":1839,"_21483":56542,"_5":14766,"_28195":56440,"_3064":56543},[],"OCSP and CRL respond for the authorities that remain active.",{"_3608":1887,"_31008":1839,"_21483":56545,"_5":14766,"_28195":56440,"_3064":56546},[],"No DMS is left accidentally issuing from the old CA.",{"_3608":1888,"_31008":1839,"_21483":56548,"_5":14766,"_28195":56440,"_3064":56549},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3608":1889,"_31008":1889,"_5":15126,"_3064":56551,"_31366":56552,"_21483":56553,"_28195":1889},"Certification authorities",[50713,52225,56388,56389],[],{"_3608":1890,"_31008":1889,"_21483":56555,"_5":14766,"_28195":1889,"_3064":56556},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3608":1891,"_31008":1889,"_5":31363,"_21483":56558,"_28195":56559,"_3064":56560},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3608":1892,"_31008":1889,"_5":31363,"_21483":56562,"_28195":56563,"_3064":56564},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3608":1893,"_31008":1889,"_5":31363,"_21483":56566,"_28195":56567,"_3064":50723},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#before-you-begin",{"_3608":1894,"_31008":1889,"_5":31363,"_21483":56569,"_28195":56570,"_3064":56571},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3608":1895,"_31008":1889,"_5":31363,"_21483":56573,"_28195":56574,"_3064":56575},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3608":1896,"_31008":1889,"_5":31363,"_21483":56577,"_28195":56578,"_3064":56579},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3608":1897,"_31008":1889,"_5":31363,"_21483":56581,"_28195":56582,"_3064":56583},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3608":1898,"_31008":1889,"_5":31363,"_21483":56585,"_28195":56586,"_3064":56587},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3608":1899,"_31008":1889,"_5":31363,"_21483":56589,"_28195":56590,"_3064":56591},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3608":1900,"_31008":1889,"_5":31363,"_21483":56593,"_28195":56594,"_3064":56595},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3608":1901,"_31008":1889,"_5":31363,"_21483":56597,"_28195":56598,"_3064":56599},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3608":1902,"_31008":1889,"_5":31363,"_21483":56601,"_28195":56602,"_3064":56603},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3608":1903,"_31008":1889,"_5":31363,"_21483":56605,"_28195":56606,"_3064":56607},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3608":1904,"_31008":1889,"_5":31363,"_21483":56609,"_28195":56610,"_3064":56611},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3608":1905,"_31008":1889,"_5":31363,"_21483":56613,"_28195":56614,"_3064":56615},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3608":1906,"_31008":1889,"_5":31363,"_21483":56617,"_28195":56618,"_3064":56619},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3608":1907,"_31008":1889,"_5":31363,"_21483":56621,"_28195":56622,"_3064":56623},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3608":1908,"_31008":1889,"_5":31363,"_21483":56625,"_28195":56626,"_3064":56627},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3608":1909,"_31008":1889,"_5":31363,"_21483":56629,"_28195":56630,"_3064":56631},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3608":1910,"_31008":1889,"_5":31363,"_21483":56633,"_28195":56634,"_3064":56635},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3608":1911,"_31008":1889,"_5":31363,"_21483":56637,"_28195":56638,"_3064":56639},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3608":1912,"_31008":1889,"_5":31363,"_21483":56641,"_28195":56642,"_3064":56643},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3608":1913,"_31008":1889,"_5":31363,"_21483":56645,"_28195":56646,"_3064":56647},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3608":1914,"_31008":1889,"_21483":56649,"_5":14766,"_28195":1889,"_3064":56650},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3608":1915,"_31008":1889,"_21483":56652,"_5":14766,"_28195":1889,"_3064":56653},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3608":1916,"_31008":1889,"_21483":56655,"_5":14766,"_28195":1889,"_3064":56656},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3608":1917,"_31008":1889,"_21483":56658,"_5":14766,"_28195":56559,"_3064":56659},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3608":1918,"_31008":1889,"_21483":56661,"_5":14766,"_28195":56559,"_3064":56662},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3608":1919,"_31008":1889,"_21483":56664,"_5":14766,"_28195":56559,"_3064":56665},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3608":1920,"_31008":1889,"_21483":56667,"_5":14766,"_28195":56559,"_3064":56668},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3608":1921,"_31008":1889,"_21483":56670,"_5":14766,"_28195":56559,"_3064":56671},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3608":1922,"_31008":1889,"_21483":56673,"_5":14766,"_28195":56567,"_3064":56674},[],"Decide whether the CA will be a root or an intermediate.",{"_3608":1923,"_31008":1889,"_21483":56676,"_5":14766,"_28195":56567,"_3064":56677},[],"Choose the engine that will keep the key.",{"_3608":1924,"_31008":1889,"_21483":56679,"_5":14766,"_28195":56567,"_3064":56680},[],"Define a validity longer than that of the certificates it will issue.",{"_3608":1925,"_31008":1889,"_21483":56682,"_5":14766,"_28195":56567,"_3064":56683},[],"For an intermediate CA, make sure the parent CA is active.",{"_3608":1926,"_31008":1889,"_21483":56685,"_5":14766,"_28195":56570,"_3064":56686},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3608":1927,"_31008":1889,"_21483":56688,"_5":14766,"_28195":56574,"_3064":56689},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3608":1928,"_31008":1889,"_21483":56691,"_5":14766,"_28195":56574,"_3064":56692},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3608":1929,"_31008":1889,"_21483":56694,"_5":14766,"_28195":56578,"_3064":56695},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3608":1930,"_31008":1889,"_21483":56697,"_5":14766,"_28195":56582,"_3064":56698},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3608":1931,"_31008":1889,"_21483":56700,"_5":14766,"_28195":56582,"_3064":56701},[],"`C`: two-letter ISO 3166-1 country code.",{"_3608":1932,"_31008":1889,"_21483":56703,"_5":14766,"_28195":56582,"_3064":56704},[],"`ST`: state or province.",{"_3608":1933,"_31008":1889,"_21483":56706,"_5":14766,"_28195":56582,"_3064":56707},[],"`L`: locality.",{"_3608":1934,"_31008":1889,"_21483":56709,"_5":14766,"_28195":56582,"_3064":56710},[],"`O`: organization.",{"_3608":1935,"_31008":1889,"_21483":56712,"_5":14766,"_28195":56582,"_3064":56713},[],"`OU`: organizational unit.",{"_3608":1936,"_31008":1889,"_21483":56715,"_5":14766,"_28195":56582,"_3064":56716},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3608":1937,"_31008":1889,"_21483":56718,"_5":14766,"_28195":56586,"_3064":56719},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3608":1938,"_31008":1889,"_21483":56721,"_5":14766,"_28195":56586,"_3064":56722},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3608":1939,"_31008":1889,"_21483":56724,"_5":14766,"_28195":56590,"_3064":56725},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3608":1940,"_31008":1889,"_21483":56727,"_5":14766,"_28195":56590,"_3064":56728},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3608":1941,"_31008":1889,"_21483":56730,"_5":14766,"_28195":56594,"_3064":56731},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3608":1942,"_31008":1889,"_21483":56733,"_5":14766,"_28195":56594,"_3064":56734},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3608":1943,"_31008":1889,"_21483":56736,"_5":14766,"_28195":56598,"_3064":56737},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3608":1944,"_31008":1889,"_21483":56739,"_5":14766,"_28195":56598,"_3064":56740},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3608":1945,"_31008":1889,"_21483":56742,"_5":14766,"_28195":56598,"_3064":56743},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3608":1946,"_31008":1889,"_21483":56745,"_5":14766,"_28195":56602,"_3064":56746},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3608":1947,"_31008":1889,"_21483":56748,"_5":14766,"_28195":56606,"_3064":56749},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3608":1948,"_31008":1889,"_21483":56751,"_5":14766,"_28195":56606,"_3064":56752},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3608":1949,"_31008":1889,"_21483":56754,"_5":14766,"_28195":56610,"_3064":56755},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3608":1950,"_31008":1889,"_21483":56757,"_5":14766,"_28195":56614,"_3064":56758},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3608":1951,"_31008":1889,"_21483":56760,"_5":14766,"_28195":56614,"_3064":56761},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3608":1952,"_31008":1889,"_21483":56763,"_5":14766,"_28195":56618,"_3064":56764},[],"Open a CA from the inventory to review:",{"_3608":1953,"_31008":1889,"_21483":56766,"_5":14766,"_28195":56618,"_3064":56767},[],"Status and validity period.",{"_3608":1954,"_31008":1889,"_21483":56769,"_5":14766,"_28195":56618,"_3064":56770},[],"Certificate and chain in PEM format.",{"_3608":1955,"_31008":1889,"_21483":56772,"_5":14766,"_28195":56618,"_3064":56773},[],"Number of active, expired and revoked certificates.",{"_3608":1956,"_31008":1889,"_21483":56775,"_5":14766,"_28195":56618,"_3064":56776},[],"Certificates issued in **Issued Certificates**.",{"_3608":1957,"_31008":1889,"_21483":56778,"_5":14766,"_28195":56618,"_3064":56779},[],"The CRL linked to the authority.",{"_3608":1958,"_31008":1889,"_21483":56781,"_5":14766,"_28195":56618,"_3064":56782},[],"Metadata and the associated cryptographic engine.",{"_3608":1959,"_31008":1889,"_21483":56784,"_5":14766,"_28195":56618,"_3064":56785},[],"You can filter the inventory by name, status and CA type.",{"_3608":1960,"_31008":1889,"_21483":56787,"_5":14766,"_28195":56622,"_3064":56788},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3608":1961,"_31008":1889,"_21483":56790,"_5":14766,"_28195":56622,"_3064":56791},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3608":1962,"_31008":1889,"_21483":56793,"_5":14766,"_28195":56622,"_3064":56794},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3608":1963,"_31008":1889,"_21483":56796,"_5":14766,"_28195":56622,"_3064":56797},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3608":1964,"_31008":1889,"_21483":56799,"_5":14766,"_28195":56622,"_3064":56800},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3608":1965,"_31008":1889,"_21483":56802,"_5":14766,"_28195":56622,"_3064":56803},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3608":1966,"_31008":1889,"_21483":56805,"_5":14766,"_28195":56626,"_3064":56806},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3608":1967,"_31008":1889,"_21483":56808,"_5":14766,"_28195":56630,"_3064":56809},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3608":1968,"_31008":1889,"_21483":56811,"_5":14766,"_28195":56634,"_3064":56812},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3608":1969,"_31008":1889,"_21483":56814,"_5":14766,"_28195":56638,"_3064":56815},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3608":1970,"_31008":1889,"_21483":56817,"_5":14766,"_28195":56642,"_3064":56818},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3608":1971,"_31008":1889,"_21483":56820,"_5":14766,"_28195":56646,"_3064":56821},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3608":1972,"_31008":1889,"_21483":56823,"_5":14766,"_28195":56646,"_3064":56824},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3608":1973,"_31008":1889,"_21483":56826,"_5":14766,"_28195":56646,"_3064":56827},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3608":1974,"_31008":1889,"_21483":56829,"_5":14766,"_28195":56646,"_3064":56830},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3608":1975,"_31008":1975,"_5":15126,"_3064":56832,"_31366":56833,"_21483":56834,"_28195":1975},"Certificate profiles",[50713,52225,56388,56389],[],{"_3608":1976,"_31008":1975,"_21483":56836,"_5":14766,"_28195":1975,"_3064":56837},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3608":1977,"_31008":1975,"_5":31363,"_21483":56839,"_28195":56840,"_3064":56841},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3608":1978,"_31008":1975,"_5":31363,"_21483":56843,"_28195":56844,"_3064":56845},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#validity","Validity",{"_3608":1979,"_31008":1975,"_5":31363,"_21483":56847,"_28195":56848,"_3064":56849},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3608":1980,"_31008":1975,"_5":31363,"_21483":56851,"_28195":56852,"_3064":56853},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3608":1981,"_31008":1975,"_5":31363,"_21483":56855,"_28195":56856,"_3064":56857},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#subject","Subject",{"_3608":1982,"_31008":1975,"_5":31363,"_21483":56859,"_28195":56860,"_3064":56861},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3608":1983,"_31008":1975,"_5":31363,"_21483":56863,"_28195":56864,"_3064":56865},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3608":1984,"_31008":1975,"_5":31363,"_21483":56867,"_28195":56868,"_3064":56869},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3608":1985,"_31008":1975,"_5":31363,"_21483":56871,"_28195":56872,"_3064":56873},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3608":1986,"_31008":1975,"_5":31363,"_21483":56875,"_28195":56876,"_3064":56877},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3608":1987,"_31008":1975,"_5":31363,"_21483":56879,"_28195":56880,"_3064":56881},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3608":1988,"_31008":1975,"_5":31363,"_21483":56883,"_28195":56884,"_3064":56885},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3608":1989,"_31008":1975,"_5":31363,"_21483":56887,"_28195":56888,"_3064":56889},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3608":1990,"_31008":1975,"_5":31363,"_21483":56891,"_28195":56892,"_3064":56893},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3608":1991,"_31008":1975,"_5":31363,"_21483":56895,"_28195":56896,"_3064":56897},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#design-examples","Design examples",{"_3608":1992,"_31008":1975,"_5":31363,"_21483":56899,"_28195":56900,"_3064":56901},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3608":1993,"_31008":1975,"_21483":56903,"_5":14766,"_28195":1975,"_3064":56904},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3608":1994,"_31008":1975,"_21483":56906,"_5":14766,"_28195":1975,"_3064":56907},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3608":1995,"_31008":1975,"_21483":56909,"_5":14766,"_28195":56844,"_3064":56910},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3608":1996,"_31008":1975,"_21483":56912,"_5":14766,"_28195":56844,"_3064":56913},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3608":1997,"_31008":1975,"_21483":56915,"_5":14766,"_28195":56848,"_3064":56916},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3608":1998,"_31008":1975,"_21483":56918,"_5":14766,"_28195":56852,"_3064":56919},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3608":1999,"_31008":1975,"_21483":56921,"_5":14766,"_28195":56852,"_3064":56922},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3608":2000,"_31008":1975,"_21483":56924,"_5":14766,"_28195":56852,"_3064":56925},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3608":2001,"_31008":1975,"_21483":56927,"_5":14766,"_28195":56856,"_3064":56928},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3608":2002,"_31008":1975,"_21483":56930,"_5":14766,"_28195":56860,"_3064":56931},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3608":2003,"_31008":1975,"_21483":56933,"_5":14766,"_28195":56860,"_3064":56934},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3608":2004,"_31008":1975,"_21483":56936,"_5":14766,"_28195":56864,"_3064":56937},[],"The cryptographic enforcement can:",{"_3608":2005,"_31008":1975,"_21483":56939,"_5":14766,"_28195":56864,"_3064":56940},[],"allow or block RSA keys;",{"_3608":2006,"_31008":1975,"_21483":56942,"_5":14766,"_28195":56864,"_3064":56943},[],"limit the supported RSA sizes;",{"_3608":2007,"_31008":1975,"_21483":56945,"_5":14766,"_28195":56864,"_3064":56946},[],"allow or block ECDSA keys;",{"_3608":2008,"_31008":1975,"_21483":56948,"_5":14766,"_28195":56864,"_3064":56949},[],"limit the supported ECDSA sizes or curves.",{"_3608":2009,"_31008":1975,"_21483":56951,"_5":14766,"_28195":56864,"_3064":56952},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3608":2010,"_31008":1975,"_21483":56954,"_5":14766,"_28195":56868,"_3064":56955},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3608":2011,"_31008":1975,"_21483":56957,"_5":14766,"_28195":56868,"_3064":54150},[],{"_3608":2012,"_31008":1975,"_21483":56959,"_5":14766,"_28195":56868,"_3064":56960},[],"First choice",{"_3608":2013,"_31008":1975,"_21483":56962,"_5":14766,"_28195":56868,"_3064":56963},[],"Second choice",{"_3608":2014,"_31008":1975,"_21483":56965,"_5":14766,"_28195":56868,"_3064":56966},[],"If neither is supplied",{"_3608":2015,"_31008":1975,"_21483":56968,"_5":14766,"_28195":56868,"_3064":56969},[],"Direct signing with a CA",{"_3608":2016,"_31008":1975,"_21483":56971,"_5":14766,"_28195":56868,"_3064":56972},[],"`issuance_profile` embedded in the request",{"_3608":2017,"_31008":1975,"_21483":56974,"_5":14766,"_28195":56868,"_3064":56975},[],"Request `issuance_profile_id`",{"_3608":2018,"_31008":1975,"_21483":56977,"_5":14766,"_28195":56868,"_3064":56978},[],"CA default profile (`profile_id`).",{"_3608":2019,"_31008":1975,"_21483":56980,"_5":14766,"_28195":56868,"_3064":56981},[],"Issuance through a DMS",{"_3608":2020,"_31008":1975,"_21483":56983,"_5":14766,"_28195":56868,"_3064":56984},[],"`settings.issuance_profile_id`",{"_3608":2021,"_31008":1975,"_21483":56986,"_5":14766,"_28195":56868,"_3064":56987},[],"`settings.issuance_profile` embedded in the DMS",{"_3608":2022,"_31008":1975,"_21483":56989,"_5":14766,"_28195":56868,"_3064":56990},[],"Enrollment CA default profile.",{"_3608":2023,"_31008":1975,"_21483":56992,"_5":14766,"_28195":56868,"_3064":56993},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3608":2024,"_31008":1975,"_21483":56995,"_5":14766,"_28195":56868,"_3064":56996},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3608":2025,"_31008":1975,"_21483":56998,"_5":14766,"_28195":56876,"_3064":56999},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3608":2026,"_31008":1975,"_21483":57001,"_5":14766,"_28195":56880,"_3064":57002},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3608":2027,"_31008":1975,"_21483":57004,"_5":14766,"_28195":56884,"_3064":57005},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3608":2028,"_31008":1975,"_21483":57007,"_5":14766,"_28195":56888,"_3064":57008},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3608":2029,"_31008":1975,"_21483":57010,"_5":14766,"_28195":56892,"_3064":57011},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3608":2030,"_31008":1975,"_21483":57013,"_5":14766,"_28195":56892,"_3064":57014},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3608":2031,"_31008":1975,"_21483":57016,"_5":14766,"_28195":56896,"_3064":57017},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3608":2032,"_31008":1975,"_21483":57019,"_5":14766,"_28195":56896,"_3064":57020},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3608":2033,"_31008":1975,"_21483":57022,"_5":14766,"_28195":56896,"_3064":57023},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3608":2034,"_31008":1975,"_21483":57025,"_5":14766,"_28195":56896,"_3064":57026},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3608":2035,"_31008":1975,"_21483":57028,"_5":14766,"_28195":56900,"_3064":57029},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3608":2036,"_31008":1975,"_21483":57031,"_5":14766,"_28195":56900,"_3064":57032},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3608":2037,"_31008":2037,"_5":15126,"_3064":57034,"_31366":57035,"_21483":57037,"_28195":2037},"Certificate validation",[50713,52225,56388,57036],"Validation",[],{"_3608":2038,"_31008":2037,"_21483":57039,"_5":14766,"_28195":2037,"_3064":57040},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3608":2039,"_31008":2037,"_5":31363,"_21483":57042,"_28195":57043,"_3064":57044},[],"/docs/pr-preview/pr-72/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3608":2040,"_31008":2037,"_5":31363,"_21483":57046,"_28195":57047,"_3064":57048},[],"/docs/pr-preview/pr-72/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3608":2041,"_31008":2037,"_5":31363,"_21483":57050,"_28195":57051,"_3064":57052},[],"/docs/pr-preview/pr-72/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3608":2042,"_31008":2037,"_21483":57054,"_5":14766,"_28195":2037,"_3064":57055},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3608":2043,"_31008":2037,"_21483":57057,"_5":14766,"_28195":57043,"_3064":57058},[],"Verify these criteria together:",{"_3608":2044,"_31008":2037,"_21483":57060,"_5":14766,"_28195":57043,"_3064":56014},[],{"_3608":2045,"_31008":2037,"_21483":57062,"_5":14766,"_28195":57043,"_3064":57063},[],"Required result",{"_3608":2046,"_31008":2037,"_21483":57065,"_5":14766,"_28195":57043,"_3064":57066},[],"Chain and signature",{"_3608":2047,"_31008":2037,"_21483":57068,"_5":14766,"_28195":57043,"_3064":57069},[],"Valid chain to a root deliberately installed in the consumer.",{"_3608":2048,"_31008":2037,"_21483":57071,"_5":14766,"_28195":57043,"_3064":57072},[],"Dates",{"_3608":2049,"_31008":2037,"_21483":57074,"_5":14766,"_28195":57043,"_3064":57075},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3608":2050,"_31008":2037,"_21483":57077,"_5":14766,"_28195":57043,"_3064":51894},[],{"_3608":2051,"_31008":2037,"_21483":57079,"_5":14766,"_28195":57043,"_3064":57080},[],"Name, SAN or identifier matches the expected peer.",{"_3608":2052,"_31008":2037,"_21483":57082,"_5":14766,"_28195":57043,"_3064":51103},[],{"_3608":2053,"_31008":2037,"_21483":57084,"_5":14766,"_28195":57043,"_3064":57085},[],"KU, EKU and constraints permit the specific operation.",{"_3608":2054,"_31008":2037,"_21483":57087,"_5":14766,"_28195":57043,"_3064":57088},[],"Revocation",{"_3608":2055,"_31008":2037,"_21483":57090,"_5":14766,"_28195":57043,"_3064":57091},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3608":2056,"_31008":2037,"_21483":57093,"_5":14766,"_28195":57043,"_3064":57094},[],"Authorization",{"_3608":2057,"_31008":2037,"_21483":57096,"_5":14766,"_28195":57043,"_3064":57097},[],"The application permits that identity to perform the action.",{"_3608":2058,"_31008":2037,"_21483":57099,"_5":14766,"_28195":57043,"_3064":57100},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3608":2059,"_31008":2037,"_21483":57102,"_5":14766,"_28195":57047,"_3064":57103},[],"Mechanism",{"_3608":2060,"_31008":2037,"_21483":57105,"_5":14766,"_28195":57047,"_3064":57106},[],"When to use it",{"_3608":2061,"_31008":2037,"_21483":57108,"_5":14766,"_28195":57047,"_3064":57109},[],"What you must maintain",{"_3608":2062,"_31008":2037,"_21483":57111,"_5":14766,"_28195":57047,"_3064":57112},[],"OCSP",{"_3608":2063,"_31008":2037,"_21483":57114,"_5":14766,"_28195":57047,"_3064":57115},[],"Status query for a specific certificate.",{"_3608":2064,"_31008":2037,"_21483":57117,"_5":14766,"_28195":57047,"_3064":57118},[],"Responder access, signature verification and cache/freshness policy.",{"_3608":2065,"_31008":2037,"_21483":57120,"_5":14766,"_28195":57047,"_3064":57121},[],"CRL",{"_3608":2066,"_31008":2037,"_21483":57123,"_5":14766,"_28195":57047,"_3064":57124},[],"Local checks for many certificates or offline operation.",{"_3608":2067,"_31008":2037,"_21483":57126,"_5":14766,"_28195":57047,"_3064":57127},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3608":2068,"_31008":2037,"_21483":57129,"_5":14766,"_28195":57047,"_3064":57130},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3608":2069,"_31008":2037,"_21483":57132,"_5":14766,"_28195":57047,"_3064":57133},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3608":2070,"_31008":2037,"_21483":57135,"_5":14766,"_28195":57051,"_3064":57136},[],"Accept a current, authorized certificate with a known chain.",{"_3608":2071,"_31008":2037,"_21483":57138,"_5":14766,"_28195":57051,"_3064":57139},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3608":2072,"_31008":2037,"_21483":57141,"_5":14766,"_28195":57051,"_3064":57142},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3608":2073,"_31008":2037,"_21483":57144,"_5":14766,"_28195":57051,"_3064":57145},[],"Check that a new connection with that identity is rejected.",{"_3608":2074,"_31008":2037,"_21483":57147,"_5":14766,"_28195":57051,"_3064":57148},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3608":2075,"_31008":2037,"_21483":57150,"_5":14766,"_28195":57051,"_3064":57151},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3608":2076,"_31008":2037,"_21483":57153,"_5":14766,"_28195":57051,"_3064":57154},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3608":2077,"_31008":2037,"_21483":57156,"_5":14766,"_28195":57051,"_3064":57157},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3608":2078,"_31008":2037,"_21483":57159,"_5":14766,"_28195":57051,"_3064":57160},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3608":2079,"_31008":2079,"_5":15126,"_3064":57162,"_31366":57163,"_21483":57164,"_28195":2079},"Certificates",[50713,52225,56388,56389],[],{"_3608":2080,"_31008":2079,"_21483":57166,"_5":14766,"_28195":2079,"_3064":57167},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3608":2081,"_31008":2079,"_5":31363,"_21483":57169,"_28195":57170,"_3064":57171},[],"/docs/pr-preview/pr-72/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3608":2082,"_31008":2079,"_5":31363,"_21483":57173,"_28195":57174,"_3064":57175},[],"/docs/pr-preview/pr-72/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3608":2083,"_31008":2079,"_5":31363,"_21483":57177,"_28195":57178,"_3064":57179},[],"/docs/pr-preview/pr-72/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3608":2084,"_31008":2079,"_5":31363,"_21483":57181,"_28195":57182,"_3064":57183},[],"/docs/pr-preview/pr-72/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3608":2085,"_31008":2079,"_5":31363,"_21483":57185,"_28195":57186,"_3064":57187},[],"/docs/pr-preview/pr-72/platform/pki/certificates#open-the-action","Open the action",{"_3608":2086,"_31008":2079,"_5":31363,"_21483":57189,"_28195":57190,"_3064":57191},[],"/docs/pr-preview/pr-72/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3608":2087,"_31008":2079,"_5":31363,"_21483":57193,"_28195":57194,"_3064":57195},[],"/docs/pr-preview/pr-72/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3608":2088,"_31008":2079,"_5":31363,"_21483":57197,"_28195":57198,"_3064":57199},[],"/docs/pr-preview/pr-72/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3608":2089,"_31008":2079,"_5":31363,"_21483":57201,"_28195":57202,"_3064":57203},[],"/docs/pr-preview/pr-72/platform/pki/certificates#continue","Continue",{"_3608":2090,"_31008":2079,"_21483":57205,"_5":14766,"_28195":2079,"_3064":57206},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3608":2091,"_31008":2079,"_21483":57208,"_5":14766,"_28195":57170,"_3064":57209},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3608":2092,"_31008":2079,"_21483":57211,"_5":14766,"_28195":57170,"_3064":57212},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3608":2093,"_31008":2079,"_21483":57214,"_5":14766,"_28195":57170,"_3064":57215},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3608":2094,"_31008":2079,"_21483":57217,"_5":14766,"_28195":57170,"_3064":57218},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3608":2095,"_31008":2079,"_21483":57220,"_5":14766,"_28195":57170,"_3064":57221},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3608":2096,"_31008":2079,"_21483":57223,"_5":14766,"_28195":57170,"_3064":57224},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3608":2097,"_31008":2079,"_21483":57226,"_5":14766,"_28195":57170,"_3064":57227},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3608":2098,"_31008":2079,"_21483":57229,"_5":14766,"_28195":57174,"_3064":57230},[],"Download the PEM and inspect it:",{"_3608":2099,"_31008":2079,"_21483":57232,"_5":14766,"_28195":57174,"_3064":57233},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3608":2100,"_31008":2079,"_21483":57235,"_5":14766,"_28195":57178,"_3064":57236},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3608":2101,"_31008":2079,"_21483":57238,"_5":14766,"_28195":57178,"_3064":57239},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3608":2102,"_31008":2079,"_21483":57241,"_5":14766,"_28195":57178,"_3064":57242},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3608":2103,"_31008":2079,"_21483":57244,"_5":14766,"_28195":57178,"_3064":57245},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3608":2104,"_31008":2079,"_21483":57247,"_5":14766,"_28195":57178,"_3064":57248},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3608":2105,"_31008":2079,"_21483":57250,"_5":14766,"_28195":57178,"_3064":57251},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3608":2106,"_31008":2079,"_21483":57253,"_5":14766,"_28195":57178,"_3064":57254},[],"For browser key generation, follow Issue your first certificate.",{"_3608":2107,"_31008":2079,"_21483":57256,"_5":14766,"_28195":57182,"_3064":57257},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3608":2108,"_31008":2079,"_21483":57259,"_5":14766,"_28195":57186,"_3064":57260},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3608":2109,"_31008":2079,"_21483":57262,"_5":14766,"_28195":57190,"_3064":57263},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3608":2110,"_31008":2079,"_21483":57265,"_5":14766,"_28195":57194,"_3064":57266},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3608":2111,"_31008":2079,"_21483":57268,"_5":14766,"_28195":57194,"_3064":57269},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3608":2112,"_31008":2079,"_21483":57271,"_5":14766,"_28195":57194,"_3064":57272},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3608":2113,"_31008":2079,"_21483":57274,"_5":14766,"_28195":57198,"_3064":57275},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3608":2114,"_31008":2079,"_21483":57277,"_5":14766,"_28195":57198,"_3064":57278},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3608":2115,"_31008":2079,"_21483":57280,"_5":14766,"_28195":57198,"_3064":57281},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3608":2116,"_31008":2079,"_21483":57283,"_5":14766,"_28195":57202,"_3064":57284},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3608":2117,"_31008":2079,"_21483":57286,"_5":14766,"_28195":57202,"_3064":57287},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3608":2118,"_31008":2118,"_5":15126,"_3064":57289,"_31366":57290,"_21483":57292,"_28195":2118},"Certificate lifecycle",[50713,52225,56388,57291],"Concepts",[],{"_3608":2119,"_31008":2118,"_21483":57294,"_5":14766,"_28195":2118,"_3064":57295},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3608":2120,"_31008":2118,"_5":31363,"_21483":57297,"_28195":57298,"_3064":57299},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3608":2121,"_31008":2118,"_5":31363,"_21483":57301,"_28195":57302,"_3064":57303},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3608":2122,"_31008":2118,"_5":31363,"_21483":57305,"_28195":57306,"_3064":57307},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3608":2123,"_31008":2118,"_5":31363,"_21483":57309,"_28195":57310,"_3064":57311},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3608":2124,"_31008":2118,"_5":31363,"_21483":57313,"_28195":57314,"_3064":57315},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3608":2125,"_31008":2118,"_5":31363,"_21483":57317,"_28195":57318,"_3064":57319},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3608":2126,"_31008":2118,"_5":31363,"_21483":57321,"_28195":57322,"_3064":57323},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3608":2127,"_31008":2118,"_5":31363,"_21483":57325,"_28195":57326,"_3064":57327},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3608":2128,"_31008":2118,"_5":31363,"_21483":57329,"_28195":57330,"_3064":57331},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3608":2129,"_31008":2118,"_5":31363,"_21483":57333,"_28195":57334,"_3064":57335},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3608":2130,"_31008":2118,"_21483":57337,"_5":14766,"_28195":2118,"_3064":57338},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3608":2131,"_31008":2118,"_21483":57340,"_5":14766,"_28195":57302,"_3064":57341},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3608":2132,"_31008":2118,"_21483":57343,"_5":14766,"_28195":57306,"_3064":57344},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3608":2133,"_31008":2118,"_21483":57346,"_5":14766,"_28195":57310,"_3064":57347},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3608":2134,"_31008":2118,"_21483":57349,"_5":14766,"_28195":57314,"_3064":57350},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3608":2135,"_31008":2118,"_21483":57352,"_5":14766,"_28195":57318,"_3064":57353},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3608":2136,"_31008":2118,"_21483":57355,"_5":14766,"_28195":57322,"_3064":57356},[],"Lamassu persists four X.509 states:",{"_3608":2137,"_31008":2118,"_21483":57358,"_5":14766,"_28195":57322,"_3064":57359},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3608":2138,"_31008":2118,"_21483":57361,"_5":14766,"_28195":57322,"_3064":57362},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3608":2139,"_31008":2118,"_21483":57364,"_5":14766,"_28195":57322,"_3064":57365},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3608":2140,"_31008":2118,"_21483":57367,"_5":14766,"_28195":57322,"_3064":57368},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3608":2141,"_31008":2118,"_21483":57370,"_5":14766,"_28195":57322,"_3064":57371},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3608":2142,"_31008":2118,"_21483":57373,"_5":14766,"_28195":57326,"_3064":57374},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3608":2143,"_31008":2118,"_21483":57376,"_5":14766,"_28195":57326,"_3064":57377},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3608":2144,"_31008":2118,"_21483":57379,"_5":14766,"_28195":57326,"_3064":57380},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3608":2145,"_31008":2118,"_21483":57382,"_5":14766,"_28195":57330,"_3064":57383},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3608":2146,"_31008":2118,"_21483":57385,"_5":14766,"_28195":57330,"_3064":57386},[],"Before confirming:",{"_3608":2147,"_31008":2118,"_21483":57388,"_5":14766,"_28195":57330,"_3064":57389},[],"Identify DMSs, devices and services that trust that chain.",{"_3608":2148,"_31008":2118,"_21483":57391,"_5":14766,"_28195":57330,"_3064":57392},[],"Distribute the new chain of trust.",{"_3608":2149,"_31008":2118,"_21483":57394,"_5":14766,"_28195":57330,"_3064":57395},[],"Reissue the necessary identities.",{"_3608":2150,"_31008":2118,"_21483":57397,"_5":14766,"_28195":57330,"_3064":57398},[],"Check OCSP and CRL from a real consumer.",{"_3608":2151,"_31008":2118,"_21483":57400,"_5":14766,"_28195":57330,"_3064":57401},[],"Revoke the old CA once no legitimate traffic remains.",{"_3608":2152,"_31008":2118,"_21483":57403,"_5":14766,"_28195":57330,"_3064":57404},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3608":2153,"_31008":2118,"_21483":57406,"_5":14766,"_28195":57334,"_3064":57407},[],"Certificates entering the preventive or critical renewal window.",{"_3608":2154,"_31008":2118,"_21483":57409,"_5":14766,"_28195":57334,"_3064":57410},[],"Repeated enrollment or re-enrollment failures.",{"_3608":2155,"_31008":2118,"_21483":57412,"_5":14766,"_28195":57334,"_3064":57413},[],"Status changes and revocation reasons.",{"_3608":2156,"_31008":2118,"_21483":57415,"_5":14766,"_28195":57334,"_3064":57416},[],"OCSP and CRL publication and validity.",{"_3608":2157,"_31008":2118,"_21483":57418,"_5":14766,"_28195":57334,"_3064":57419},[],"Dependencies still presenting a replaced certificate.",{"_3608":2158,"_31008":2118,"_21483":57421,"_5":14766,"_28195":57334,"_3064":57422},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3608":2159,"_31008":2159,"_5":15126,"_3064":57424,"_31366":57425,"_21483":57426,"_28195":2159},"Trust model",[50713,52225,56388,57291],[],{"_3608":2160,"_31008":2159,"_21483":57428,"_5":14766,"_28195":2159,"_3064":57429},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3608":2161,"_31008":2159,"_5":31363,"_21483":57431,"_28195":57432,"_3064":57433},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3608":2162,"_31008":2159,"_5":31363,"_21483":57435,"_28195":57436,"_3064":57437},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3608":2163,"_31008":2159,"_5":31363,"_21483":57439,"_28195":57440,"_3064":57441},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3608":2164,"_31008":2159,"_5":31363,"_21483":57443,"_28195":57444,"_3064":57445},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3608":2165,"_31008":2159,"_5":31363,"_21483":57447,"_28195":57448,"_3064":57449},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3608":2166,"_31008":2159,"_5":31363,"_21483":57451,"_28195":57452,"_3064":57453},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3608":2167,"_31008":2159,"_5":31363,"_21483":57455,"_28195":57456,"_3064":57457},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3608":2168,"_31008":2159,"_5":31363,"_21483":57459,"_28195":57460,"_3064":57461},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3608":2169,"_31008":2159,"_5":31363,"_21483":57463,"_28195":57464,"_3064":57465},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3608":2170,"_31008":2159,"_5":31363,"_21483":57467,"_28195":57468,"_3064":57469},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3608":2171,"_31008":2159,"_21483":57471,"_5":14766,"_28195":2159,"_3064":57472},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3608":2172,"_31008":2159,"_21483":57474,"_5":14766,"_28195":57436,"_3064":57475},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3608":2173,"_31008":2159,"_21483":57477,"_5":14766,"_28195":57440,"_3064":57478},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3608":2174,"_31008":2159,"_21483":57480,"_5":14766,"_28195":57444,"_3064":57481},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3608":2175,"_31008":2159,"_21483":57483,"_5":14766,"_28195":57448,"_3064":57484},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3608":2176,"_31008":2159,"_21483":57486,"_5":14766,"_28195":57452,"_3064":57487},[],"The device proves it can enroll according to the DMS policy.",{"_3608":2177,"_31008":2159,"_21483":57489,"_5":14766,"_28195":57452,"_3064":57490},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3608":2178,"_31008":2159,"_21483":57492,"_5":14766,"_28195":57452,"_3064":57493},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3608":2179,"_31008":2159,"_21483":57495,"_5":14766,"_28195":57452,"_3064":57496},[],"The device installs the certificate and the chain it needs.",{"_3608":2180,"_31008":2159,"_21483":57498,"_5":14766,"_28195":57452,"_3064":57499},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3608":2181,"_31008":2159,"_21483":57501,"_5":14766,"_28195":57452,"_3064":57502},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3608":2182,"_31008":2159,"_21483":57504,"_5":14766,"_28195":57456,"_3064":57505},[],"A DMS relates three sets that are worth designing separately:",{"_3608":2183,"_31008":2159,"_21483":57507,"_5":14766,"_28195":57456,"_3064":57508},[],"**Enrollment CA:** signs the new identities.",{"_3608":2184,"_31008":2159,"_21483":57510,"_5":14766,"_28195":57456,"_3064":57511},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3608":2185,"_31008":2159,"_21483":57513,"_5":14766,"_28195":57456,"_3064":57514},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3608":2186,"_31008":2159,"_21483":57516,"_5":14766,"_28195":57456,"_3064":57517},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3608":2187,"_31008":2159,"_21483":57519,"_5":14766,"_28195":57460,"_3064":57520},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3608":2188,"_31008":2159,"_21483":57522,"_5":14766,"_28195":57460,"_3064":57523},[],"that the current date is between `Not Before` and `Not After`;",{"_3608":2189,"_31008":2159,"_21483":57525,"_5":14766,"_28195":57460,"_3064":57526},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3608":2190,"_31008":2159,"_21483":57528,"_5":14766,"_28195":57460,"_3064":57529},[],"that names, SANs and subject match the expected identity;",{"_3608":2191,"_31008":2159,"_21483":57531,"_5":14766,"_28195":57460,"_3064":57532},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3608":2192,"_31008":2159,"_21483":57534,"_5":14766,"_28195":57460,"_3064":57535},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3608":2193,"_31008":2159,"_21483":57537,"_5":14766,"_28195":57460,"_3064":57538},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3608":2194,"_31008":2159,"_21483":57540,"_5":14766,"_28195":57464,"_3064":57541},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3608":2195,"_31008":2159,"_21483":57543,"_5":14766,"_28195":57468,"_3064":57544},[],"Keep the root out of daily operations, or with very restricted access.",{"_3608":2196,"_31008":2159,"_21483":57546,"_5":14766,"_28195":57468,"_3064":57547},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3608":2197,"_31008":2159,"_21483":57549,"_5":14766,"_28195":57468,"_3064":57550},[],"Assign explicit profiles to every use case.",{"_3608":2198,"_31008":2159,"_21483":57552,"_5":14766,"_28195":57468,"_3064":57553},[],"Distribute the new trust before starting a rotation.",{"_3608":2199,"_31008":2159,"_21483":57555,"_5":14766,"_28195":57468,"_3064":57556},[],"Keep enough overlap to renew a disconnected fleet.",{"_3608":2200,"_31008":2159,"_21483":57558,"_5":14766,"_28195":57468,"_3064":57559},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3608":2201,"_31008":2159,"_21483":57561,"_5":14766,"_28195":57468,"_3064":57562},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3608":2202,"_31008":2202,"_5":15126,"_3064":57564,"_31366":57565,"_21483":57566,"_28195":2202},"Revocation lists (CRL)",[50713,52225,56388,57036],[],{"_3608":2203,"_31008":2202,"_21483":57568,"_5":14766,"_28195":2202,"_3064":57569},[],"Generate and distribute signed lists to validate certificates offline.",{"_3608":2204,"_31008":2202,"_5":31363,"_21483":57571,"_28195":57572,"_3064":57573},[],"/docs/pr-preview/pr-72/platform/pki/crl#crl-settings","CRL settings",{"_3608":2205,"_31008":2202,"_5":31363,"_21483":57575,"_28195":57576,"_3064":57577},[],"/docs/pr-preview/pr-72/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3608":2206,"_31008":2202,"_5":31363,"_21483":57579,"_28195":57580,"_3064":57581},[],"/docs/pr-preview/pr-72/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3608":2207,"_31008":2202,"_5":31363,"_21483":57583,"_28195":57584,"_3064":57585},[],"/docs/pr-preview/pr-72/platform/pki/crl#crl-contents","CRL contents",{"_3608":2208,"_31008":2202,"_5":31363,"_21483":57587,"_28195":57588,"_3064":57589},[],"/docs/pr-preview/pr-72/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3608":2209,"_31008":2202,"_5":31363,"_21483":57591,"_28195":57592,"_3064":57593},[],"/docs/pr-preview/pr-72/platform/pki/crl#crl-settings-api","CRL settings API",{"_3608":2210,"_31008":2202,"_5":31363,"_21483":57595,"_28195":57596,"_3064":57597},[],"/docs/pr-preview/pr-72/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3608":2211,"_31008":2202,"_5":31363,"_21483":57599,"_28195":57600,"_3064":57601},[],"/docs/pr-preview/pr-72/platform/pki/crl#references","References",{"_3608":2212,"_31008":2202,"_21483":57603,"_5":14766,"_28195":2202,"_3064":57604},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3608":2213,"_31008":2202,"_21483":57606,"_5":14766,"_28195":57572,"_3064":57607},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3608":2214,"_31008":2202,"_21483":57609,"_5":14766,"_28195":57572,"_3064":57610},[],"Field",{"_3608":2215,"_31008":2202,"_21483":57612,"_5":14766,"_28195":57572,"_3064":51103},[],{"_3608":2216,"_31008":2202,"_21483":57614,"_5":14766,"_28195":57572,"_3064":52345},[],{"_3608":2217,"_31008":2202,"_21483":57616,"_5":14766,"_28195":57572,"_3064":57617},[],"ID of the CA the settings belong to.",{"_3608":2218,"_31008":2202,"_21483":57619,"_5":14766,"_28195":57572,"_3064":57620},[],"`status`",{"_3608":2219,"_31008":2202,"_21483":57622,"_5":14766,"_28195":57572,"_3064":57623},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3608":2220,"_31008":2202,"_21483":57625,"_5":14766,"_28195":57572,"_3064":57626},[],"`legacy_ski`",{"_3608":2221,"_31008":2202,"_21483":57628,"_5":14766,"_28195":57572,"_3064":57629},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3608":2222,"_31008":2202,"_21483":57631,"_5":14766,"_28195":57572,"_3064":57632},[],"`latest_crl`",{"_3608":2223,"_31008":2202,"_21483":57634,"_5":14766,"_28195":57572,"_3064":57635},[],"Version, validity start and end of the last published list. Read-only.",{"_3608":2224,"_31008":2202,"_21483":57637,"_5":14766,"_28195":57572,"_3064":57638},[],"`crl_options` field",{"_3608":2225,"_31008":2202,"_21483":57640,"_5":14766,"_28195":57572,"_3064":51103},[],{"_3608":2226,"_31008":2202,"_21483":57642,"_5":14766,"_28195":57572,"_3064":57643},[],"Initial value",{"_3608":2227,"_31008":2202,"_21483":57645,"_5":14766,"_28195":57572,"_3064":57646},[],"`validity`",{"_3608":2228,"_31008":2202,"_21483":57648,"_5":14766,"_28195":57572,"_3064":57649},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3608":2229,"_31008":2202,"_21483":57651,"_5":14766,"_28195":57572,"_3064":57652},[],"7 days.",{"_3608":2230,"_31008":2202,"_21483":57654,"_5":14766,"_28195":57572,"_3064":57655},[],"`refresh_interval`",{"_3608":2231,"_31008":2202,"_21483":57657,"_5":14766,"_28195":57572,"_3064":57658},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3608":2232,"_31008":2202,"_21483":57660,"_5":14766,"_28195":57572,"_3064":57661},[],"6 days and 23 hours.",{"_3608":2233,"_31008":2202,"_21483":57663,"_5":14766,"_28195":57572,"_3064":57664},[],"`regenerate_on_revoke`",{"_3608":2234,"_31008":2202,"_21483":57666,"_5":14766,"_28195":57572,"_3064":57667},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3608":2235,"_31008":2202,"_21483":57669,"_5":14766,"_28195":57572,"_3064":57670},[],"`true`.",{"_3608":2236,"_31008":2202,"_21483":57672,"_5":14766,"_28195":57572,"_3064":57673},[],"`signer_serial_number`",{"_3608":2237,"_31008":2202,"_21483":57675,"_5":14766,"_28195":57572,"_3064":57676},[],"Serial number of the existing certificate that signs the CRL.",{"_3608":2238,"_31008":2202,"_21483":57678,"_5":14766,"_28195":57572,"_3064":57679},[],"Serial number of the CA’s current certificate.",{"_3608":2239,"_31008":2202,"_21483":57681,"_5":14766,"_28195":57572,"_3064":57682},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3608":2240,"_31008":2202,"_21483":57684,"_5":14766,"_28195":57572,"_3064":57685},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3608":2241,"_31008":2202,"_21483":57687,"_5":14766,"_28195":57572,"_3064":57688},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3608":2242,"_31008":2202,"_21483":57690,"_5":14766,"_28195":57572,"_3064":57691},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3608":2243,"_31008":2202,"_21483":57693,"_5":14766,"_28195":57572,"_3064":57694},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3608":2244,"_31008":2202,"_21483":57696,"_5":14766,"_28195":57572,"_3064":57697},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3608":2245,"_31008":2202,"_21483":57699,"_5":14766,"_28195":57572,"_3064":57700},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3608":2246,"_31008":2202,"_21483":57702,"_5":14766,"_28195":57572,"_3064":57703},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3608":2247,"_31008":2202,"_21483":57705,"_5":14766,"_28195":57572,"_3064":57706},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3608":2248,"_31008":2202,"_21483":57708,"_5":14766,"_28195":57572,"_3064":57709},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3608":2249,"_31008":2202,"_21483":57711,"_5":14766,"_28195":57572,"_3064":57712},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3608":2250,"_31008":2202,"_21483":57714,"_5":14766,"_28195":57576,"_3064":57715},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3608":2251,"_31008":2202,"_21483":57717,"_5":14766,"_28195":57576,"_3064":57718},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3608":2252,"_31008":2202,"_21483":57720,"_5":14766,"_28195":57576,"_3064":57721},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3608":2253,"_31008":2202,"_21483":57723,"_5":14766,"_28195":57576,"_3064":57724},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3608":2254,"_31008":2202,"_21483":57726,"_5":14766,"_28195":57580,"_3064":57727},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3608":2255,"_31008":2202,"_21483":57729,"_5":14766,"_28195":57580,"_3064":57730},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3608":2256,"_31008":2202,"_21483":57732,"_5":14766,"_28195":57580,"_3064":57733},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3608":2257,"_31008":2202,"_21483":57735,"_5":14766,"_28195":57580,"_3064":57736},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3608":2258,"_31008":2202,"_21483":57738,"_5":14766,"_28195":57580,"_3064":57739},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3608":2259,"_31008":2202,"_21483":57741,"_5":14766,"_28195":57580,"_3064":57742},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3608":2260,"_31008":2202,"_21483":57744,"_5":14766,"_28195":57580,"_3064":57745},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3608":2261,"_31008":2202,"_21483":57747,"_5":14766,"_28195":57580,"_3064":57748},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3608":2262,"_31008":2202,"_21483":57750,"_5":14766,"_28195":57580,"_3064":57751},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3608":2263,"_31008":2202,"_21483":57753,"_5":14766,"_28195":57584,"_3064":57754},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3608":2264,"_31008":2202,"_21483":57756,"_5":14766,"_28195":57584,"_3064":57757},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3608":2265,"_31008":2202,"_21483":57759,"_5":14766,"_28195":57588,"_3064":57760},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3608":2266,"_31008":2202,"_21483":57762,"_5":14766,"_28195":57588,"_3064":57763},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3608":2267,"_31008":2202,"_21483":57765,"_5":14766,"_28195":57588,"_3064":57766},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3608":2268,"_31008":2202,"_21483":57768,"_5":14766,"_28195":57588,"_3064":57769},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3608":2269,"_31008":2202,"_21483":57771,"_5":14766,"_28195":57588,"_3064":57772},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3608":2270,"_31008":2202,"_21483":57774,"_5":14766,"_28195":57592,"_3064":57775},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3608":2271,"_31008":2202,"_21483":57777,"_5":14766,"_28195":57592,"_3064":54153},[],{"_3608":2272,"_31008":2202,"_21483":57779,"_5":14766,"_28195":57592,"_3064":57780},[],"Relative path",{"_3608":2273,"_31008":2202,"_21483":57782,"_5":14766,"_28195":57592,"_3064":54150},[],{"_3608":2274,"_31008":2202,"_21483":57784,"_5":14766,"_28195":57592,"_3064":57785},[],"`GET`",{"_3608":2275,"_31008":2202,"_21483":57787,"_5":14766,"_28195":57592,"_3064":57788},[],"`/v1/crl-settings`",{"_3608":2276,"_31008":2202,"_21483":57790,"_5":14766,"_28195":57592,"_3064":57791},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3608":2277,"_31008":2202,"_21483":57793,"_5":14766,"_28195":57592,"_3064":57785},[],{"_3608":2278,"_31008":2202,"_21483":57795,"_5":14766,"_28195":57592,"_3064":57796},[],"`/v1/crl-settings/{ca-id}`",{"_3608":2279,"_31008":2202,"_21483":57798,"_5":14766,"_28195":57592,"_3064":57799},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3608":2280,"_31008":2202,"_21483":57801,"_5":14766,"_28195":57592,"_3064":57802},[],"`PUT`",{"_3608":2281,"_31008":2202,"_21483":57804,"_5":14766,"_28195":57592,"_3064":57796},[],{"_3608":2282,"_31008":2202,"_21483":57806,"_5":14766,"_28195":57592,"_3064":57807},[],"Replace the CRL configuration of a CA.",{"_3608":2283,"_31008":2202,"_21483":57809,"_5":14766,"_28195":57592,"_3064":57810},[],"`DELETE`",{"_3608":2284,"_31008":2202,"_21483":57812,"_5":14766,"_28195":57592,"_3064":57796},[],{"_3608":2285,"_31008":2202,"_21483":57814,"_5":14766,"_28195":57592,"_3064":57815},[],"Remove the archived CRL settings of a CA.",{"_3608":2286,"_31008":2202,"_21483":57817,"_5":14766,"_28195":57592,"_3064":57818},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3608":2287,"_31008":2202,"_21483":57820,"_5":14766,"_28195":57592,"_3064":57821},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3608":2288,"_31008":2202,"_21483":57823,"_5":14766,"_28195":57592,"_3064":57824},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3608":2289,"_31008":2202,"_21483":57826,"_5":14766,"_28195":57596,"_3064":57827},[],"Symptom",{"_3608":2290,"_31008":2202,"_21483":57829,"_5":14766,"_28195":57596,"_3064":57830},[],"Cause",{"_3608":2291,"_31008":2202,"_21483":57832,"_5":14766,"_28195":57596,"_3064":57833},[],"Action",{"_3608":2292,"_31008":2202,"_21483":57835,"_5":14766,"_28195":57596,"_3064":57836},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3608":2293,"_31008":2202,"_21483":57838,"_5":14766,"_28195":57596,"_3064":57839},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3608":2294,"_31008":2202,"_21483":57841,"_5":14766,"_28195":57596,"_3064":57842},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3608":2295,"_31008":2202,"_21483":57844,"_5":14766,"_28195":57596,"_3064":57845},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3608":2296,"_31008":2202,"_21483":57847,"_5":14766,"_28195":57596,"_3064":57848},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3608":2297,"_31008":2202,"_21483":57850,"_5":14766,"_28195":57596,"_3064":57851},[],"Delete the CA first; deleting it archives its settings.",{"_3608":2298,"_31008":2202,"_21483":57853,"_5":14766,"_28195":57596,"_3064":57854},[],"`PUT` returns 400.",{"_3608":2299,"_31008":2202,"_21483":57856,"_5":14766,"_28195":57596,"_3064":57857},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3608":2300,"_31008":2202,"_21483":57859,"_5":14766,"_28195":57596,"_3064":57860},[],"Set the serial number of a valid certificate of that CA.",{"_3608":2301,"_31008":2202,"_21483":57862,"_5":14766,"_28195":57596,"_3064":57863},[],"`PUT` returns 404.",{"_3608":2302,"_31008":2202,"_21483":57865,"_5":14766,"_28195":57596,"_3064":57866},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3608":2303,"_31008":2202,"_21483":57868,"_5":14766,"_28195":57596,"_3064":57869},[],"Check the CA ID and the signer serial number.",{"_3608":2304,"_31008":2202,"_21483":57871,"_5":14766,"_28195":57596,"_3064":57872},[],"`PUT` returns 400 from a 3.x client.",{"_3608":2305,"_31008":2202,"_21483":57874,"_5":14766,"_28195":57596,"_3064":57875},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3608":2306,"_31008":2202,"_21483":57877,"_5":14766,"_28195":57596,"_3064":57878},[],"Update the client to send the new field.",{"_3608":2307,"_31008":2202,"_21483":57880,"_5":14766,"_28195":57596,"_3064":57881},[],"The CRL does not change after revoking a certificate.",{"_3608":2308,"_31008":2202,"_21483":57883,"_5":14766,"_28195":57596,"_3064":57884},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3608":2309,"_31008":2202,"_21483":57886,"_5":14766,"_28195":57596,"_3064":57887},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3608":2310,"_31008":2202,"_21483":57889,"_5":14766,"_28195":57596,"_3064":57890},[],"A verifier rejects the CRL because of the issuer.",{"_3608":2311,"_31008":2202,"_21483":57892,"_5":14766,"_28195":57596,"_3064":57893},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3608":2312,"_31008":2202,"_21483":57895,"_5":14766,"_28195":57596,"_3064":57896},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3608":2313,"_31008":2202,"_21483":57898,"_5":14766,"_28195":57600,"_3064":57899},[],"RFC 5280: X.509 and CRL profile.",{"_3608":2314,"_31008":2202,"_21483":57901,"_5":14766,"_28195":57600,"_3064":57902},[],"OpenSSL: openssl-crl.",{"_3608":2315,"_31008":2202,"_21483":57904,"_5":14766,"_28195":57600,"_3064":57905},[],"OpenSSL: openssl-verify.",{"_3608":2316,"_31008":2202,"_21483":57907,"_5":14766,"_28195":57600,"_3064":57908},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3608":2317,"_31008":2202,"_21483":57910,"_5":14766,"_28195":57600,"_3064":57911},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3608":2318,"_31008":2318,"_5":15126,"_3064":57913,"_31366":57914,"_21483":57915,"_28195":2318},"Keys and cryptographic engines",[50713,52225,56388,56389],[],{"_3608":2319,"_31008":2318,"_21483":57917,"_5":14766,"_28195":2318,"_3064":57918},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3608":2320,"_31008":2318,"_5":31363,"_21483":57920,"_28195":57921,"_3064":57922},[],"/docs/pr-preview/pr-72/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3608":2321,"_31008":2318,"_5":31363,"_21483":57924,"_28195":57925,"_3064":57926},[],"/docs/pr-preview/pr-72/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3608":2322,"_31008":2318,"_5":31363,"_21483":57928,"_28195":57929,"_3064":57930},[],"/docs/pr-preview/pr-72/platform/pki/key-management#file-system","File System",{"_3608":2323,"_31008":2318,"_5":31363,"_21483":57932,"_28195":57933,"_3064":57934},[],"/docs/pr-preview/pr-72/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3608":2324,"_31008":2318,"_5":31363,"_21483":57936,"_28195":57937,"_3064":57938},[],"/docs/pr-preview/pr-72/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3608":2325,"_31008":2318,"_5":31363,"_21483":57940,"_28195":57941,"_3064":57942},[],"/docs/pr-preview/pr-72/platform/pki/key-management#aws-kms","AWS KMS",{"_3608":2326,"_31008":2318,"_5":31363,"_21483":57944,"_28195":57945,"_3064":57946},[],"/docs/pr-preview/pr-72/platform/pki/key-management#pkcs11","PKCS#11",{"_3608":2327,"_31008":2318,"_5":31363,"_21483":57948,"_28195":57949,"_3064":57950},[],"/docs/pr-preview/pr-72/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3608":2328,"_31008":2318,"_5":31363,"_21483":57952,"_28195":57953,"_3064":57954},[],"/docs/pr-preview/pr-72/platform/pki/key-management#key-inventory","Key inventory",{"_3608":2329,"_31008":2318,"_5":31363,"_21483":57956,"_28195":57957,"_3064":57958},[],"/docs/pr-preview/pr-72/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3608":2330,"_31008":2318,"_5":31363,"_21483":57960,"_28195":57961,"_3064":57962},[],"/docs/pr-preview/pr-72/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3608":2331,"_31008":2318,"_5":31363,"_21483":57964,"_28195":57965,"_3064":57966},[],"/docs/pr-preview/pr-72/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3608":2332,"_31008":2318,"_5":31363,"_21483":57968,"_28195":57969,"_3064":57970},[],"/docs/pr-preview/pr-72/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3608":2333,"_31008":2318,"_5":31363,"_21483":57972,"_28195":57973,"_3064":57974},[],"/docs/pr-preview/pr-72/platform/pki/key-management#view-details","View details",{"_3608":2334,"_31008":2318,"_5":31363,"_21483":57976,"_28195":57977,"_3064":57978},[],"/docs/pr-preview/pr-72/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3608":2335,"_31008":2318,"_5":31363,"_21483":57980,"_28195":57981,"_3064":57982},[],"/docs/pr-preview/pr-72/platform/pki/key-management#sign","Sign",{"_3608":2336,"_31008":2318,"_5":31363,"_21483":57984,"_28195":57985,"_3064":57986},[],"/docs/pr-preview/pr-72/platform/pki/key-management#verify","Verify",{"_3608":2337,"_31008":2318,"_5":31363,"_21483":57988,"_28195":57989,"_3064":57990},[],"/docs/pr-preview/pr-72/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3608":2338,"_31008":2318,"_5":31363,"_21483":57992,"_28195":57993,"_3064":57994},[],"/docs/pr-preview/pr-72/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3608":2339,"_31008":2318,"_5":31363,"_21483":57996,"_28195":57997,"_3064":57998},[],"/docs/pr-preview/pr-72/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3608":2340,"_31008":2318,"_21483":58000,"_5":14766,"_28195":2318,"_3064":58001},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3608":2341,"_31008":2318,"_21483":58003,"_5":14766,"_28195":2318,"_3064":58004},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3608":2342,"_31008":2318,"_21483":58006,"_5":14766,"_28195":57921,"_3064":58007},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3608":2343,"_31008":2318,"_21483":58009,"_5":14766,"_28195":57921,"_3064":58010},[],"In practice, it lets you:",{"_3608":2344,"_31008":2318,"_21483":58012,"_5":14766,"_28195":57921,"_3064":58013},[],"Generate new key pairs from Lamassu IoT.",{"_3608":2345,"_31008":2318,"_21483":58015,"_5":14766,"_28195":57921,"_3064":58016},[],"Import keys created externally.",{"_3608":2346,"_31008":2318,"_21483":58018,"_5":14766,"_28195":57921,"_3064":58019},[],"Delegate custody and cryptographic operations to external engines.",{"_3608":2347,"_31008":2318,"_21483":58021,"_5":14766,"_28195":57921,"_3064":58022},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3608":2348,"_31008":2318,"_21483":58024,"_5":14766,"_28195":57925,"_3064":58025},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3608":2349,"_31008":2318,"_21483":58027,"_5":14766,"_28195":57925,"_3064":58028},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3608":2350,"_31008":2318,"_21483":58030,"_5":14766,"_28195":57925,"_3064":58031},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3608":2351,"_31008":2318,"_21483":58033,"_5":14766,"_28195":57929,"_3064":58034},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3608":2352,"_31008":2318,"_21483":58036,"_5":14766,"_28195":57933,"_3064":58037},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3608":2353,"_31008":2318,"_21483":58039,"_5":14766,"_28195":57933,"_3064":58040},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3608":2354,"_31008":2318,"_21483":58042,"_5":14766,"_28195":57937,"_3064":58043},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3608":2355,"_31008":2318,"_21483":58045,"_5":14766,"_28195":57941,"_3064":58046},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3608":2356,"_31008":2318,"_21483":58048,"_5":14766,"_28195":57945,"_3064":58049},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3608":2357,"_31008":2318,"_21483":58051,"_5":14766,"_28195":57949,"_3064":58052},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3608":2358,"_31008":2318,"_21483":58054,"_5":14766,"_28195":57949,"_3064":58055},[],"Lamassu shows the enabled engines in the console.",{"_3608":2359,"_31008":2318,"_21483":58057,"_5":14766,"_28195":57949,"_3064":58058},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3608":2360,"_31008":2318,"_21483":58060,"_5":14766,"_28195":57949,"_3064":58061},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3608":2361,"_31008":2318,"_21483":58063,"_5":14766,"_28195":57953,"_3064":58064},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3608":2362,"_31008":2318,"_21483":58066,"_5":14766,"_28195":57953,"_3064":58067},[],"The table includes the following fields:",{"_3608":2363,"_31008":2318,"_21483":58069,"_5":14766,"_28195":57953,"_3064":58070},[],"**Name**: descriptive name of the key.",{"_3608":2364,"_31008":2318,"_21483":58072,"_5":14766,"_28195":57953,"_3064":58073},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3608":2365,"_31008":2318,"_21483":58075,"_5":14766,"_28195":57953,"_3064":58076},[],"**Strength**: visual indicator of cryptographic strength.",{"_3608":2366,"_31008":2318,"_21483":58078,"_5":14766,"_28195":57953,"_3064":58079},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3608":2367,"_31008":2318,"_21483":58081,"_5":14766,"_28195":57953,"_3064":58082},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3608":2368,"_31008":2318,"_21483":58084,"_5":14766,"_28195":57953,"_3064":58085},[],"**Aliases**: alternative names associated with the key.",{"_3608":2369,"_31008":2318,"_21483":58087,"_5":14766,"_28195":57953,"_3064":58088},[],"**Tags**: labels for classification and search.",{"_3608":2370,"_31008":2318,"_21483":58090,"_5":14766,"_28195":57953,"_3064":58091},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3608":2371,"_31008":2318,"_21483":58093,"_5":14766,"_28195":57953,"_3064":58094},[],"From this view you also reach the most common actions:",{"_3608":2372,"_31008":2318,"_21483":58096,"_5":14766,"_28195":57953,"_3064":58097},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3608":2373,"_31008":2318,"_21483":58099,"_5":14766,"_28195":57953,"_3064":58100},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3608":2374,"_31008":2318,"_21483":58102,"_5":14766,"_28195":57953,"_3064":58103},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3608":2375,"_31008":2318,"_21483":58105,"_5":14766,"_28195":57953,"_3064":58106},[],"**Delete Key** to remove the key from the system.",{"_3608":2376,"_31008":2318,"_21483":58108,"_5":14766,"_28195":57957,"_3064":58109},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3608":2377,"_31008":2318,"_21483":58111,"_5":14766,"_28195":57961,"_3064":58112},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3608":2378,"_31008":2318,"_21483":58114,"_5":14766,"_28195":57961,"_3064":58115},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3608":2379,"_31008":2318,"_21483":58117,"_5":14766,"_28195":57961,"_3064":58118},[],"**Key Name**: unique and descriptive name.",{"_3608":2380,"_31008":2318,"_21483":58120,"_5":14766,"_28195":57961,"_3064":58121},[],"**Crypto Engine**: engine that will keep the key.",{"_3608":2381,"_31008":2318,"_21483":58123,"_5":14766,"_28195":57961,"_3064":58124},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3608":2382,"_31008":2318,"_21483":58126,"_5":14766,"_28195":57961,"_3064":58127},[],"**Tags**: metadata to classify the key.",{"_3608":2383,"_31008":2318,"_21483":58129,"_5":14766,"_28195":57961,"_3064":58130},[],"**Metadata**: additional information for advanced uses.",{"_3608":2384,"_31008":2318,"_21483":58132,"_5":14766,"_28195":57965,"_3064":58133},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3608":2385,"_31008":2318,"_21483":58135,"_5":14766,"_28195":57965,"_3064":58136},[],"When you have an exportable private key and the destination engine supports import.",{"_3608":2386,"_31008":2318,"_21483":58138,"_5":14766,"_28195":57965,"_3064":58139},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3608":2387,"_31008":2318,"_21483":58141,"_5":14766,"_28195":57965,"_3064":58142},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3608":2388,"_31008":2318,"_21483":58144,"_5":14766,"_28195":57965,"_3064":58145},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3608":2389,"_31008":2318,"_21483":58147,"_5":14766,"_28195":57965,"_3064":58148},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3608":2390,"_31008":2318,"_21483":58150,"_5":14766,"_28195":57965,"_3064":58151},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3608":2391,"_31008":2318,"_21483":58153,"_5":14766,"_28195":57965,"_3064":58154},[],"**Tags**: labels for organization and search.",{"_3608":2392,"_31008":2318,"_21483":58156,"_5":14766,"_28195":57965,"_3064":58157},[],"**Metadata**: additional optional information.",{"_3608":2393,"_31008":2318,"_21483":58159,"_5":14766,"_28195":57965,"_3064":58160},[],"**Private Key (PEM)**: private key in PEM format.",{"_3608":2394,"_31008":2318,"_21483":58162,"_5":14766,"_28195":57965,"_3064":58163},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3608":2395,"_31008":2318,"_21483":58165,"_5":14766,"_28195":57969,"_3064":58166},[],"Each registered key has a detail view and several operational actions.",{"_3608":2396,"_31008":2318,"_21483":58168,"_5":14766,"_28195":57973,"_3064":58169},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3608":2397,"_31008":2318,"_21483":58171,"_5":14766,"_28195":57973,"_3064":58172},[],"The **Overview** tab shows, among others, these fields:",{"_3608":2398,"_31008":2318,"_21483":58174,"_5":14766,"_28195":57973,"_3064":58175},[],"**Key Name**: descriptive name.",{"_3608":2399,"_31008":2318,"_21483":58177,"_5":14766,"_28195":57973,"_3064":58178},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3608":2400,"_31008":2318,"_21483":58180,"_5":14766,"_28195":57973,"_3064":58181},[],"**Tags**: associated labels.",{"_3608":2401,"_31008":2318,"_21483":58183,"_5":14766,"_28195":57973,"_3064":58184},[],"**Aliases**: alternative names.",{"_3608":2402,"_31008":2318,"_21483":58186,"_5":14766,"_28195":57973,"_3064":58187},[],"**Crypto Engine**: engine where the key resides.",{"_3608":2403,"_31008":2318,"_21483":58189,"_5":14766,"_28195":57973,"_3064":58190},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3608":2404,"_31008":2318,"_21483":58192,"_5":14766,"_28195":57973,"_3064":58193},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3608":2405,"_31008":2318,"_21483":58195,"_5":14766,"_28195":57973,"_3064":58196},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3608":2406,"_31008":2318,"_21483":58198,"_5":14766,"_28195":57977,"_3064":58199},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3608":2407,"_31008":2318,"_21483":58201,"_5":14766,"_28195":57977,"_3064":58202},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3608":2408,"_31008":2318,"_21483":58204,"_5":14766,"_28195":57977,"_3064":58205},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3608":2409,"_31008":2318,"_21483":58207,"_5":14766,"_28195":57981,"_3064":58208},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3608":2410,"_31008":2318,"_21483":58210,"_5":14766,"_28195":57981,"_3064":58211},[],"Main fields:",{"_3608":2411,"_31008":2318,"_21483":58213,"_5":14766,"_28195":57981,"_3064":58214},[],"**Algorithm**: signing algorithm available for the key type.",{"_3608":2412,"_31008":2318,"_21483":58216,"_5":14766,"_28195":57981,"_3064":58217},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3608":2413,"_31008":2318,"_21483":58219,"_5":14766,"_28195":57981,"_3064":58220},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3608":2414,"_31008":2318,"_21483":58222,"_5":14766,"_28195":57981,"_3064":58223},[],"**Message**: content to sign.",{"_3608":2415,"_31008":2318,"_21483":58225,"_5":14766,"_28195":57981,"_3064":58226},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3608":2416,"_31008":2318,"_21483":58228,"_5":14766,"_28195":57985,"_3064":58229},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3608":2417,"_31008":2318,"_21483":58231,"_5":14766,"_28195":57985,"_3064":58211},[],{"_3608":2418,"_31008":2318,"_21483":58233,"_5":14766,"_28195":57985,"_3064":58234},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3608":2419,"_31008":2318,"_21483":58236,"_5":14766,"_28195":57985,"_3064":58237},[],"**Message Type**: `Raw` or `Digest`.",{"_3608":2420,"_31008":2318,"_21483":58239,"_5":14766,"_28195":57985,"_3064":58240},[],"**Payload Encoding**: encoding of the message.",{"_3608":2421,"_31008":2318,"_21483":58242,"_5":14766,"_28195":57985,"_3064":58243},[],"**Message**: original message or hash.",{"_3608":2422,"_31008":2318,"_21483":58245,"_5":14766,"_28195":57985,"_3064":58246},[],"**Signature**: signature to check.",{"_3608":2423,"_31008":2318,"_21483":58248,"_5":14766,"_28195":57985,"_3064":58249},[],"**Result**: indicator of the validation result.",{"_3608":2424,"_31008":2318,"_21483":58251,"_5":14766,"_28195":57989,"_3064":58252},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3608":2425,"_31008":2318,"_21483":58254,"_5":14766,"_28195":57989,"_3064":58255},[],"This flow is useful for:",{"_3608":2426,"_31008":2318,"_21483":58257,"_5":14766,"_28195":57989,"_3064":58258},[],"Requesting certificates from an external CA.",{"_3608":2427,"_31008":2318,"_21483":58260,"_5":14766,"_28195":57989,"_3064":58261},[],"Renewing an identity while keeping the same key.",{"_3608":2428,"_31008":2318,"_21483":58263,"_5":14766,"_28195":57989,"_3064":58264},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3608":2429,"_31008":2318,"_21483":58266,"_5":14766,"_28195":57989,"_3064":58267},[],"**Common Name (CN)**: main name of the identity.",{"_3608":2430,"_31008":2318,"_21483":58269,"_5":14766,"_28195":57989,"_3064":58270},[],"**Organization (O)**: organization or company.",{"_3608":2431,"_31008":2318,"_21483":58272,"_5":14766,"_28195":57989,"_3064":58273},[],"**Organizational Unit (OU)**: department or unit.",{"_3608":2432,"_31008":2318,"_21483":58275,"_5":14766,"_28195":57989,"_3064":58276},[],"**Country (C)**: two-letter country code.",{"_3608":2433,"_31008":2318,"_21483":58278,"_5":14766,"_28195":57989,"_3064":58279},[],"**State / Province (ST)**: state or province.",{"_3608":2434,"_31008":2318,"_21483":58281,"_5":14766,"_28195":57989,"_3064":58282},[],"**Locality (L)**: city or locality.",{"_3608":2435,"_31008":2318,"_21483":58284,"_5":14766,"_28195":57989,"_3064":58285},[],"**Email Address**: contact email.",{"_3608":2436,"_31008":2318,"_21483":58287,"_5":14766,"_28195":57989,"_3064":58288},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3608":2437,"_31008":2318,"_21483":58290,"_5":14766,"_28195":57989,"_3064":58291},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3608":2438,"_31008":2318,"_21483":58293,"_5":14766,"_28195":57993,"_3064":58294},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3608":2439,"_31008":2318,"_21483":58296,"_5":14766,"_28195":57993,"_3064":58297},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3608":2440,"_31008":2318,"_21483":58299,"_5":14766,"_28195":57997,"_3064":58300},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3608":2441,"_31008":2318,"_21483":58302,"_5":14766,"_28195":57997,"_3064":58303},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3608":2442,"_31008":2442,"_5":15126,"_3064":58305,"_31366":58306,"_21483":58307,"_28195":2442},"Online validation with OCSP",[50713,52225,56388,57036],[],{"_3608":2443,"_31008":2442,"_21483":58309,"_5":14766,"_28195":2442,"_3064":58310},[],"Query signed status and verify the responder’s response.",{"_3608":2444,"_31008":2442,"_5":31363,"_21483":58312,"_28195":58313,"_3064":58314},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3608":2445,"_31008":2442,"_5":31363,"_21483":58316,"_28195":58317,"_3064":58318},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3608":2446,"_31008":2442,"_5":31363,"_21483":58320,"_28195":58321,"_3064":58322},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3608":2447,"_31008":2442,"_5":31363,"_21483":58324,"_28195":58325,"_3064":58326},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3608":2448,"_31008":2442,"_5":31363,"_21483":58328,"_28195":58329,"_3064":58330},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3608":2449,"_31008":2442,"_5":31363,"_21483":58332,"_28195":58333,"_3064":57601},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#references",{"_3608":2450,"_31008":2442,"_21483":58335,"_5":14766,"_28195":2442,"_3064":58336},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3608":2451,"_31008":2442,"_21483":58338,"_5":14766,"_28195":58313,"_3064":58339},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3608":2452,"_31008":2442,"_21483":58341,"_5":14766,"_28195":58313,"_3064":58342},[],"Record status",{"_3608":2453,"_31008":2442,"_21483":58344,"_5":14766,"_28195":58313,"_3064":58345},[],"Signed response",{"_3608":2454,"_31008":2442,"_21483":58347,"_5":14766,"_28195":58313,"_3064":55525},[],{"_3608":2455,"_31008":2442,"_21483":58349,"_5":14766,"_28195":58313,"_3064":58350},[],"`Good`.",{"_3608":2456,"_31008":2442,"_21483":58352,"_5":14766,"_28195":58313,"_3064":55542},[],{"_3608":2457,"_31008":2442,"_21483":58354,"_5":14766,"_28195":58313,"_3064":58355},[],"`Revoked`, with revocation reason and timestamp.",{"_3608":2458,"_31008":2442,"_21483":58357,"_5":14766,"_28195":58313,"_3064":58358},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3608":2459,"_31008":2442,"_21483":58360,"_5":14766,"_28195":58313,"_3064":58361},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3608":2460,"_31008":2442,"_21483":58363,"_5":14766,"_28195":58313,"_3064":58364},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3608":2461,"_31008":2442,"_21483":58366,"_5":14766,"_28195":58313,"_3064":58367},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3608":2462,"_31008":2442,"_21483":58369,"_5":14766,"_28195":58313,"_3064":58370},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3608":2463,"_31008":2442,"_21483":58372,"_5":14766,"_28195":58317,"_3064":58373},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3608":2464,"_31008":2442,"_21483":58375,"_5":14766,"_28195":58317,"_3064":58376},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3608":2465,"_31008":2442,"_21483":58378,"_5":14766,"_28195":58321,"_3064":58379},[],"The service accepts:",{"_3608":2466,"_31008":2442,"_21483":58381,"_5":14766,"_28195":58321,"_3064":54153},[],{"_3608":2467,"_31008":2442,"_21483":58383,"_5":14766,"_28195":58321,"_3064":58384},[],"VA service path",{"_3608":2468,"_31008":2442,"_21483":58386,"_5":14766,"_28195":58321,"_3064":58387},[],"Format",{"_3608":2469,"_31008":2442,"_21483":58389,"_5":14766,"_28195":58321,"_3064":58390},[],"`POST`",{"_3608":2470,"_31008":2442,"_21483":58392,"_5":14766,"_28195":58321,"_3064":58393},[],"`/ocsp`",{"_3608":2471,"_31008":2442,"_21483":58395,"_5":14766,"_28195":58321,"_3064":58396},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3608":2472,"_31008":2442,"_21483":58398,"_5":14766,"_28195":58321,"_3064":57785},[],{"_3608":2473,"_31008":2442,"_21483":58400,"_5":14766,"_28195":58321,"_3064":58401},[],"`/ocsp/{ocsp_request}`",{"_3608":2474,"_31008":2442,"_21483":58403,"_5":14766,"_28195":58321,"_3064":58404},[],"DER request encoded using padded URL Base64.",{"_3608":2475,"_31008":2442,"_21483":58406,"_5":14766,"_28195":58321,"_3064":58407},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3608":2476,"_31008":2442,"_21483":58409,"_5":14766,"_28195":58325,"_3064":58410},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3608":2477,"_31008":2442,"_21483":58412,"_5":14766,"_28195":58325,"_3064":58413},[],"Generate the request:",{"_3608":2478,"_31008":2442,"_21483":58415,"_5":14766,"_28195":58325,"_3064":58416},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3608":2479,"_31008":2442,"_21483":58418,"_5":14766,"_28195":58325,"_3064":58419},[],"Replace the example URL with the inspected endpoint:",{"_3608":2480,"_31008":2442,"_21483":58421,"_5":14766,"_28195":58325,"_3064":58422},[],"Verify the returned DER:",{"_3608":2481,"_31008":2442,"_21483":58424,"_5":14766,"_28195":58325,"_3064":58425},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3608":2482,"_31008":2442,"_21483":58427,"_5":14766,"_28195":58329,"_3064":58428},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3608":2483,"_31008":2442,"_21483":58430,"_5":14766,"_28195":58329,"_3064":58431},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3608":2484,"_31008":2442,"_21483":58433,"_5":14766,"_28195":58333,"_3064":58434},[],"RFC 6960: OCSP.",{"_3608":2485,"_31008":2442,"_21483":58436,"_5":14766,"_28195":58333,"_3064":58437},[],"OpenSSL: openssl-ocsp.",{"_3608":2486,"_31008":2442,"_21483":58439,"_5":14766,"_28195":58333,"_3064":58440},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3608":2487,"_31008":2442,"_21483":58442,"_5":14766,"_28195":58333,"_3064":57911},[],{"_3608":2488,"_31008":2488,"_5":15126,"_3064":56388,"_31366":58444,"_21483":58445,"_28195":2488},[50713,52225,56388],[],{"_3608":2489,"_31008":2488,"_21483":58447,"_5":14766,"_28195":2488,"_3064":58448},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3608":2490,"_31008":2488,"_5":31363,"_21483":58450,"_28195":58451,"_3064":55700},[],"/docs/pr-preview/pr-72/platform/pki/overview#start-here",{"_3608":2491,"_31008":2488,"_5":31363,"_21483":58453,"_28195":58454,"_3064":58455},[],"/docs/pr-preview/pr-72/platform/pki/overview#what-you-need","What you need",{"_3608":2492,"_31008":2488,"_5":31363,"_21483":58457,"_28195":58458,"_3064":56232},[],"/docs/pr-preview/pr-72/platform/pki/overview#core-capabilities",{"_3608":2493,"_31008":2488,"_5":31363,"_21483":58460,"_28195":58461,"_3064":56236},[],"/docs/pr-preview/pr-72/platform/pki/overview#build-your-trust-hierarchy",{"_3608":2494,"_31008":2488,"_5":31363,"_21483":58463,"_28195":58464,"_3064":56240},[],"/docs/pr-preview/pr-72/platform/pki/overview#protect-cryptographic-keys",{"_3608":2495,"_31008":2488,"_5":31363,"_21483":58466,"_28195":58467,"_3064":56244},[],"/docs/pr-preview/pr-72/platform/pki/overview#issue-and-control-certificates",{"_3608":2496,"_31008":2488,"_5":31363,"_21483":58469,"_28195":58470,"_3064":56252},[],"/docs/pr-preview/pr-72/platform/pki/overview#publish-validation-status",{"_3608":2497,"_31008":2488,"_5":31363,"_21483":58472,"_28195":58473,"_3064":58474},[],"/docs/pr-preview/pr-72/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3608":2498,"_31008":2488,"_5":31363,"_21483":58476,"_28195":58477,"_3064":57203},[],"/docs/pr-preview/pr-72/platform/pki/overview#continue",{"_3608":2499,"_31008":2488,"_21483":58479,"_5":14766,"_28195":2488,"_3064":58480},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3608":2500,"_31008":2488,"_21483":58482,"_5":14766,"_28195":58451,"_3064":58483},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3608":2501,"_31008":2488,"_21483":58485,"_5":14766,"_28195":58451,"_3064":58486},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3608":2502,"_31008":2488,"_21483":58488,"_5":14766,"_28195":58454,"_3064":58489},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3608":2503,"_31008":2488,"_21483":58491,"_5":14766,"_28195":58454,"_3064":58492},[],"An available cryptographic engine to keep the authority's key.",{"_3608":2504,"_31008":2488,"_21483":58494,"_5":14766,"_28195":58454,"_3064":58495},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3608":2505,"_31008":2488,"_21483":58497,"_5":14766,"_28195":58454,"_3064":58498},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3608":2506,"_31008":2488,"_21483":58500,"_5":14766,"_28195":58454,"_3064":58501},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3608":2507,"_31008":2488,"_21483":58503,"_5":14766,"_28195":58461,"_3064":58504},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3608":2508,"_31008":2488,"_21483":58506,"_5":14766,"_28195":58464,"_3064":58507},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3608":2509,"_31008":2488,"_21483":58509,"_5":14766,"_28195":58467,"_3064":58510},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3608":2510,"_31008":2488,"_21483":58512,"_5":14766,"_28195":58470,"_3064":58513},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3608":2511,"_31008":2488,"_21483":58515,"_5":14766,"_28195":58473,"_3064":58516},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3608":2512,"_31008":2488,"_21483":58518,"_5":14766,"_28195":58473,"_3064":58519},[],"its subject and extensions identify the expected client;",{"_3608":2513,"_31008":2488,"_21483":58521,"_5":14766,"_28195":58473,"_3064":58522},[],"its public key matches the client's private key;",{"_3608":2514,"_31008":2488,"_21483":58524,"_5":14766,"_28195":58473,"_3064":58525},[],"its chain reaches a root trusted by the consumer;",{"_3608":2515,"_31008":2488,"_21483":58527,"_5":14766,"_28195":58473,"_3064":58528},[],"its dates and usages allow the operation;",{"_3608":2516,"_31008":2488,"_21483":58530,"_5":14766,"_28195":58473,"_3064":58531},[],"the consumer applies revocation checks and authorization.",{"_3608":2517,"_31008":2488,"_21483":58533,"_5":14766,"_28195":58473,"_3064":58534},[],"The issuance path includes the first independent checks.",{"_3608":2518,"_31008":2488,"_21483":58536,"_5":14766,"_28195":58477,"_3064":58537},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3608":2519,"_31008":2488,"_21483":58539,"_5":14766,"_28195":58477,"_3064":58540},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3608":2520,"_31008":2488,"_21483":58542,"_5":14766,"_28195":58477,"_3064":58543},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3608":2521,"_31008":2521,"_5":15126,"_3064":58545,"_31366":58546,"_21483":58547,"_28195":2521},"Create your first CA",[50713,52225,56388,55825],[],{"_3608":2522,"_31008":2521,"_21483":58549,"_5":14766,"_28195":2521,"_3064":58550},[],"Create an evaluation root and check its certificate before issuing.",{"_3608":2523,"_31008":2521,"_5":31363,"_21483":58552,"_28195":58553,"_3064":50723},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3608":2524,"_31008":2521,"_5":31363,"_21483":58555,"_28195":58556,"_3064":58557},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3608":2525,"_31008":2521,"_5":31363,"_21483":58559,"_28195":58560,"_3064":58561},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3608":2526,"_31008":2521,"_5":31363,"_21483":58563,"_28195":58564,"_3064":58565},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3608":2527,"_31008":2521,"_5":31363,"_21483":58567,"_28195":58568,"_3064":58569},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3608":2528,"_31008":2521,"_5":31363,"_21483":58571,"_28195":58572,"_3064":58573},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3608":2529,"_31008":2521,"_5":31363,"_21483":58575,"_28195":58576,"_3064":58577},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3608":2530,"_31008":2521,"_5":31363,"_21483":58579,"_28195":58580,"_3064":56082},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3608":2531,"_31008":2521,"_5":31363,"_21483":58582,"_28195":58583,"_3064":50747},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3608":2532,"_31008":2521,"_21483":58585,"_5":14766,"_28195":2521,"_3064":58586},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3608":2533,"_31008":2521,"_21483":58588,"_5":14766,"_28195":58553,"_3064":58589},[],"Console access and permission to create keys and authorities.",{"_3608":2534,"_31008":2521,"_21483":58591,"_5":14766,"_28195":58553,"_3064":58592},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3608":2535,"_31008":2521,"_21483":58594,"_5":14766,"_28195":58553,"_3064":58595},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3608":2536,"_31008":2521,"_21483":58597,"_5":14766,"_28195":58553,"_3064":58598},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3608":2537,"_31008":2521,"_21483":58600,"_5":14766,"_28195":58556,"_3064":58601},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3608":2538,"_31008":2521,"_21483":58603,"_5":14766,"_28195":58556,"_3064":58604},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3608":2539,"_31008":2521,"_21483":58606,"_5":14766,"_28195":58560,"_3064":58607},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3608":2540,"_31008":2521,"_21483":58609,"_5":14766,"_28195":58560,"_3064":58610},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3608":2541,"_31008":2521,"_21483":58612,"_5":14766,"_28195":58564,"_3064":58613},[],"Select **Root CA** and complete:",{"_3608":2542,"_31008":2521,"_21483":58615,"_5":14766,"_28195":58564,"_3064":58616},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3608":2543,"_31008":2521,"_21483":58618,"_5":14766,"_28195":58564,"_3064":58619},[],"**Subject**: organization and country details for your evaluation.",{"_3608":2544,"_31008":2521,"_21483":58621,"_5":14766,"_28195":58564,"_3064":58622},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3608":2545,"_31008":2521,"_21483":58624,"_5":14766,"_28195":58564,"_3064":58625},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3608":2546,"_31008":2521,"_21483":58627,"_5":14766,"_28195":58564,"_3064":58628},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3608":2547,"_31008":2521,"_21483":58630,"_5":14766,"_28195":58568,"_3064":58631},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3608":2548,"_31008":2521,"_21483":58633,"_5":14766,"_28195":58572,"_3064":58634},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3608":2549,"_31008":2521,"_21483":58636,"_5":14766,"_28195":58572,"_3064":58637},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3608":2550,"_31008":2521,"_21483":58639,"_5":14766,"_28195":58576,"_3064":58640},[],"Run from the directory where you saved `ca.pem`:",{"_3608":2551,"_31008":2521,"_21483":58642,"_5":14766,"_28195":58576,"_3064":58643},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3608":2552,"_31008":2521,"_21483":58645,"_5":14766,"_28195":58576,"_3064":58646},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3608":2553,"_31008":2521,"_21483":58648,"_5":14766,"_28195":58580,"_3064":58649},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3608":2554,"_31008":2521,"_21483":58651,"_5":14766,"_28195":58580,"_3064":58652},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3608":2555,"_31008":2521,"_21483":58654,"_5":14766,"_28195":58580,"_3064":58655},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3608":2556,"_31008":2521,"_21483":58657,"_5":14766,"_28195":58580,"_3064":58658},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3608":2557,"_31008":2521,"_21483":58660,"_5":14766,"_28195":58583,"_3064":58661},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3608":2558,"_31008":2558,"_5":15126,"_3064":58663,"_31366":58664,"_21483":58665,"_28195":2558},"Issue and verify a certificate",[50713,52225,56388,55825],[],{"_3608":2559,"_31008":2558,"_21483":58667,"_5":14766,"_28195":2558,"_3064":58668},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3608":2560,"_31008":2558,"_5":31363,"_21483":58670,"_28195":58671,"_3064":50723},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3608":2561,"_31008":2558,"_5":31363,"_21483":58673,"_28195":58674,"_3064":58675},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3608":2562,"_31008":2558,"_5":31363,"_21483":58677,"_28195":58678,"_3064":58679},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3608":2563,"_31008":2558,"_5":31363,"_21483":58681,"_28195":58682,"_3064":58683},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3608":2564,"_31008":2558,"_5":31363,"_21483":58685,"_28195":58686,"_3064":58687},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3608":2565,"_31008":2558,"_5":31363,"_21483":58689,"_28195":58690,"_3064":58691},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3608":2566,"_31008":2558,"_5":31363,"_21483":58693,"_28195":58694,"_3064":58695},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3608":2567,"_31008":2558,"_5":31363,"_21483":58697,"_28195":58698,"_3064":58699},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3608":2568,"_31008":2558,"_5":31363,"_21483":58701,"_28195":58702,"_3064":58703},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3608":2569,"_31008":2558,"_5":31363,"_21483":58705,"_28195":58706,"_3064":58707},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3608":2570,"_31008":2558,"_5":31363,"_21483":58709,"_28195":58710,"_3064":56082},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3608":2571,"_31008":2558,"_5":31363,"_21483":58712,"_28195":58713,"_3064":50747},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#next-step",{"_3608":2572,"_31008":2558,"_21483":58715,"_5":14766,"_28195":2558,"_3064":58716},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3608":2573,"_31008":2558,"_21483":58718,"_5":14766,"_28195":58671,"_3064":58719},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3608":2574,"_31008":2558,"_21483":58721,"_5":14766,"_28195":58671,"_3064":58722},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3608":2575,"_31008":2558,"_21483":58724,"_5":14766,"_28195":58671,"_3064":58725},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3608":2576,"_31008":2558,"_21483":58727,"_5":14766,"_28195":58671,"_3064":58728},[],"A client identifier: here we use `device-001`.",{"_3608":2577,"_31008":2558,"_21483":58730,"_5":14766,"_28195":58671,"_3064":58731},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3608":2578,"_31008":2558,"_21483":58733,"_5":14766,"_28195":58674,"_3064":58734},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3608":2579,"_31008":2558,"_21483":58736,"_5":14766,"_28195":58678,"_3064":58737},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3608":2580,"_31008":2558,"_21483":58739,"_5":14766,"_28195":58678,"_3064":58740},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3608":2581,"_31008":2558,"_21483":58742,"_5":14766,"_28195":58682,"_3064":58743},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3608":2582,"_31008":2558,"_21483":58745,"_5":14766,"_28195":58682,"_3064":58746},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3608":2583,"_31008":2558,"_21483":58748,"_5":14766,"_28195":58686,"_3064":58749},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3608":2584,"_31008":2558,"_21483":58751,"_5":14766,"_28195":58686,"_3064":58752},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3608":2585,"_31008":2558,"_21483":58754,"_5":14766,"_28195":58690,"_3064":58755},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3608":2586,"_31008":2558,"_21483":58757,"_5":14766,"_28195":58694,"_3064":58758},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3608":2587,"_31008":2558,"_21483":58760,"_5":14766,"_28195":58698,"_3064":58761},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3608":2588,"_31008":2558,"_21483":58763,"_5":14766,"_28195":58702,"_3064":58764},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3608":2589,"_31008":2558,"_21483":58766,"_5":14766,"_28195":58702,"_3064":58767},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3608":2590,"_31008":2558,"_21483":58769,"_5":14766,"_28195":58702,"_3064":58770},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3608":2591,"_31008":2558,"_21483":58772,"_5":14766,"_28195":58706,"_3064":58773},[],"In Bash, compare the two public-key digests:",{"_3608":2592,"_31008":2558,"_21483":58775,"_5":14766,"_28195":58706,"_3064":58776},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3608":2593,"_31008":2558,"_21483":58778,"_5":14766,"_28195":58706,"_3064":58779},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3608":2594,"_31008":2558,"_21483":58781,"_5":14766,"_28195":58710,"_3064":56166},[],{"_3608":2595,"_31008":2558,"_21483":58783,"_5":14766,"_28195":58710,"_3064":58784},[],"What to review",{"_3608":2596,"_31008":2558,"_21483":58786,"_5":14766,"_28195":58710,"_3064":58787},[],"The CA rejects issuance",{"_3608":2597,"_31008":2558,"_21483":58789,"_5":14766,"_28195":58710,"_3064":58790},[],"Permissions, CA state and key, algorithm and profile.",{"_3608":2598,"_31008":2558,"_21483":58792,"_5":14766,"_28195":58710,"_3064":58793},[],"Different subject or usages",{"_3608":2599,"_31008":2558,"_21483":58795,"_5":14766,"_28195":58710,"_3064":58796},[],"Applied profile and requested values.",{"_3608":2600,"_31008":2558,"_21483":58798,"_5":14766,"_28195":58710,"_3064":58799},[],"Issuer cannot be found",{"_3608":2601,"_31008":2558,"_21483":58801,"_5":14766,"_28195":58710,"_3064":58802},[],"Downloaded CA and required intermediate chain.",{"_3608":2602,"_31008":2558,"_21483":58804,"_5":14766,"_28195":58710,"_3064":58805},[],"Validity fails",{"_3608":2603,"_31008":2558,"_21483":58807,"_5":14766,"_28195":58710,"_3064":58808},[],"Certificate and CA dates, and the computer's clock.",{"_3608":2604,"_31008":2558,"_21483":58810,"_5":14766,"_28195":58710,"_3064":58811},[],"Public-key digests differ",{"_3608":2605,"_31008":2558,"_21483":58813,"_5":14766,"_28195":58710,"_3064":58814},[],"Certificate and key files from the same issuance.",{"_3608":2606,"_31008":2558,"_21483":58816,"_5":14766,"_28195":58710,"_3064":58817},[],"See PKI diagnostics to narrow an issuance failure.",{"_3608":2607,"_31008":2558,"_21483":58819,"_5":14766,"_28195":58713,"_3064":58820},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3608":2608,"_31008":2558,"_21483":58822,"_5":14766,"_28195":58713,"_3064":58823},[],"Manage certificates for inspection, status and revocation.",{"_3608":2609,"_31008":2558,"_21483":58825,"_5":14766,"_28195":58713,"_3064":58826},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3608":2610,"_31008":2558,"_21483":58828,"_5":14766,"_28195":58713,"_3064":58829},[],"Prepare EST for the device to request its next identities.",{"_3608":2611,"_31008":2558,"_21483":58831,"_5":14766,"_28195":58713,"_3064":58832},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3608":2612,"_31008":2612,"_5":15126,"_3064":58834,"_31366":58835,"_21483":58836,"_28195":2612},"PKI getting started",[50713,52225,56388,55825],[],{"_3608":2613,"_31008":2612,"_21483":58838,"_5":14766,"_28195":2612,"_3064":58839},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3608":2614,"_31008":2612,"_5":31363,"_21483":58841,"_28195":58842,"_3064":50723},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/overview#before-you-begin",{"_3608":2615,"_31008":2612,"_5":31363,"_21483":58844,"_28195":58845,"_3064":58846},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3608":2616,"_31008":2612,"_5":31363,"_21483":58848,"_28195":58849,"_3064":56017},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/overview#expected-result",{"_3608":2617,"_31008":2612,"_5":31363,"_21483":58851,"_28195":58852,"_3064":58853},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3608":2618,"_31008":2612,"_21483":58855,"_5":14766,"_28195":2612,"_3064":58856},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3608":2619,"_31008":2612,"_21483":58858,"_5":14766,"_28195":58842,"_3064":58859},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3608":2620,"_31008":2612,"_21483":58861,"_5":14766,"_28195":58842,"_3064":58862},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3608":2621,"_31008":2612,"_21483":58864,"_5":14766,"_28195":58842,"_3064":58865},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3608":2622,"_31008":2612,"_21483":58867,"_5":14766,"_28195":58842,"_3064":58868},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3608":2623,"_31008":2612,"_21483":58870,"_5":14766,"_28195":58842,"_3064":58871},[],"A working directory with restricted access for the downloaded key.",{"_3608":2624,"_31008":2612,"_21483":58873,"_5":14766,"_28195":58845,"_3064":58874},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3608":2625,"_31008":2612,"_21483":58876,"_5":14766,"_28195":58845,"_3064":58877},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3608":2626,"_31008":2612,"_21483":58879,"_5":14766,"_28195":58845,"_3064":58880},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3608":2627,"_31008":2612,"_21483":58882,"_5":14766,"_28195":58845,"_3064":58883},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3608":2628,"_31008":2612,"_21483":58885,"_5":14766,"_28195":58849,"_3064":58886},[],"File or resource",{"_3608":2629,"_31008":2612,"_21483":58888,"_5":14766,"_28195":58849,"_3064":56014},[],{"_3608":2630,"_31008":2612,"_21483":58890,"_5":14766,"_28195":58849,"_3064":58891},[],"Active root CA and `ca.pem`",{"_3608":2631,"_31008":2612,"_21483":58893,"_5":14766,"_28195":58849,"_3064":58894},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3608":2632,"_31008":2612,"_21483":58896,"_5":14766,"_28195":58849,"_3064":58897},[],"End-entity certificate and `device.crt`",{"_3608":2633,"_31008":2612,"_21483":58899,"_5":14766,"_28195":58849,"_3064":58900},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3608":2634,"_31008":2612,"_21483":58902,"_5":14766,"_28195":58849,"_3064":58903},[],"Private key `device.key`",{"_3608":2635,"_31008":2612,"_21483":58905,"_5":14766,"_28195":58849,"_3064":58906},[],"Its public key matches the one included in `device.crt`.",{"_3608":2636,"_31008":2612,"_21483":58908,"_5":14766,"_28195":58849,"_3064":58909},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3608":2637,"_31008":2612,"_21483":58911,"_5":14766,"_28195":58852,"_3064":58912},[],"To operate certificates, continue with Certificates and Validation.",{"_3608":2638,"_31008":2612,"_21483":58914,"_5":14766,"_28195":58852,"_3064":58915},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3608":2639,"_31008":2612,"_21483":58917,"_5":14766,"_28195":58852,"_3064":58918},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3608":2640,"_31008":2640,"_5":15126,"_3064":58920,"_31366":58921,"_21483":58922,"_28195":2640},"PKI troubleshooting",[50713,52225,56388,54963],[],{"_3608":2641,"_31008":2640,"_21483":58924,"_5":14766,"_28195":2640,"_3064":58925},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3608":2642,"_31008":2640,"_5":31363,"_21483":58927,"_28195":58928,"_3064":58929},[],"/docs/pr-preview/pr-72/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3608":2643,"_31008":2640,"_5":31363,"_21483":58931,"_28195":58932,"_3064":58933},[],"/docs/pr-preview/pr-72/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3608":2644,"_31008":2640,"_5":31363,"_21483":58935,"_28195":58936,"_3064":58937},[],"/docs/pr-preview/pr-72/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3608":2645,"_31008":2640,"_21483":58939,"_5":14766,"_28195":2640,"_3064":58940},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3608":2646,"_31008":2640,"_21483":58942,"_5":14766,"_28195":2640,"_3064":58943},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3608":2647,"_31008":2640,"_21483":58945,"_5":14766,"_28195":58928,"_3064":56014},[],{"_3608":2648,"_31008":2640,"_21483":58947,"_5":14766,"_28195":58928,"_3064":58948},[],"What to inspect",{"_3608":2649,"_31008":2640,"_21483":58950,"_5":14766,"_28195":58928,"_3064":50747},[],{"_3608":2650,"_31008":2640,"_21483":58952,"_5":14766,"_28195":58928,"_3064":55230},[],{"_3608":2651,"_31008":2640,"_21483":58954,"_5":14766,"_28195":58928,"_3064":58955},[],"Exists, is active and has usable dates.",{"_3608":2652,"_31008":2640,"_21483":58957,"_5":14766,"_28195":58928,"_3064":58958},[],"Authorities.",{"_3608":2653,"_31008":2640,"_21483":58960,"_5":14766,"_28195":58928,"_3064":58961},[],"Key",{"_3608":2654,"_31008":2640,"_21483":58963,"_5":14766,"_28195":58928,"_3064":58964},[],"The record has a usable private key and the engine can sign.",{"_3608":2655,"_31008":2640,"_21483":58966,"_5":14766,"_28195":58928,"_3064":58967},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3608":2656,"_31008":2640,"_21483":58969,"_5":14766,"_28195":58928,"_3064":58970},[],"CSR",{"_3608":2657,"_31008":2640,"_21483":58972,"_5":14766,"_28195":58928,"_3064":58973},[],"Correct PEM and verifiable signature.",{"_3608":2658,"_31008":2640,"_21483":58975,"_5":14766,"_28195":58928,"_3064":58976},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3608":2659,"_31008":2640,"_21483":58978,"_5":14766,"_28195":58928,"_3064":58979},[],"Profile",{"_3608":2660,"_31008":2640,"_21483":58981,"_5":14766,"_28195":58928,"_3064":58982},[],"Selected source, existing ID, allowed algorithm and size.",{"_3608":2661,"_31008":2640,"_21483":58984,"_5":14766,"_28195":58928,"_3064":58985},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3608":2662,"_31008":2640,"_21483":58987,"_5":14766,"_28195":58928,"_3064":56166},[],{"_3608":2663,"_31008":2640,"_21483":58989,"_5":14766,"_28195":58928,"_3064":58990},[],"Appropriate subject, SAN, usages and dates.",{"_3608":2664,"_31008":2640,"_21483":58992,"_5":14766,"_28195":58928,"_3064":58993},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3608":2665,"_31008":2640,"_21483":58995,"_5":14766,"_28195":58928,"_3064":58996},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3608":2666,"_31008":2640,"_21483":58998,"_5":14766,"_28195":58928,"_3064":58999},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3608":2667,"_31008":2640,"_21483":59001,"_5":14766,"_28195":58928,"_3064":59002},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3608":2668,"_31008":2640,"_21483":59004,"_5":14766,"_28195":58932,"_3064":59005},[],"Check each boundary independently:",{"_3608":2669,"_31008":2640,"_21483":59007,"_5":14766,"_28195":58932,"_3064":59008},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3608":2670,"_31008":2640,"_21483":59010,"_5":14766,"_28195":58932,"_3064":59011},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3608":2671,"_31008":2640,"_21483":59013,"_5":14766,"_28195":58932,"_3064":59014},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3608":2672,"_31008":2640,"_21483":59016,"_5":14766,"_28195":58932,"_3064":59017},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3608":2673,"_31008":2640,"_21483":59019,"_5":14766,"_28195":58932,"_3064":59020},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3608":2674,"_31008":2640,"_21483":59022,"_5":14766,"_28195":58932,"_3064":59023},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3608":2675,"_31008":2640,"_21483":59025,"_5":14766,"_28195":58936,"_3064":59026},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3608":2676,"_31008":2640,"_21483":59028,"_5":14766,"_28195":58936,"_3064":59029},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3608":2677,"_31008":2677,"_5":15126,"_3064":59031,"_31366":59032,"_21483":59033,"_28195":2677},"Security",[50713],[],{"_3608":2678,"_31008":2677,"_21483":59035,"_5":14766,"_28195":2677,"_3064":59036},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3608":2679,"_31008":2677,"_5":31363,"_21483":59038,"_28195":59039,"_3064":59040},[],"/docs/pr-preview/pr-72/security#report-a-vulnerability","Report a vulnerability",{"_3608":2680,"_31008":2677,"_5":31363,"_21483":59042,"_28195":59043,"_3064":59044},[],"/docs/pr-preview/pr-72/security#what-to-include-in-a-report","What to include in a report",{"_3608":2681,"_31008":2677,"_5":31363,"_21483":59046,"_28195":59047,"_3064":59048},[],"/docs/pr-preview/pr-72/security#supported-versions","Supported versions",{"_3608":2682,"_31008":2677,"_5":31363,"_21483":59050,"_28195":59051,"_3064":59052},[],"/docs/pr-preview/pr-72/security#responsible-disclosure","Responsible disclosure",{"_3608":2683,"_31008":2677,"_21483":59054,"_5":14766,"_28195":2677,"_3064":59055},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3608":2684,"_31008":2677,"_21483":59057,"_5":14766,"_28195":59039,"_3064":59058},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3608":2685,"_31008":2677,"_21483":59060,"_5":14766,"_28195":59039,"_3064":59061},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3608":2686,"_31008":2677,"_21483":59063,"_5":14766,"_28195":59039,"_3064":15404},[],{"_3608":2687,"_31008":2677,"_21483":59065,"_5":14766,"_28195":59039,"_3064":15333},[],{"_3608":2688,"_31008":2677,"_21483":59067,"_5":14766,"_28195":59039,"_3064":15391},[],{"_3608":2689,"_31008":2677,"_21483":59069,"_5":14766,"_28195":59039,"_3064":59070},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3608":2690,"_31008":2677,"_21483":59072,"_5":14766,"_28195":59039,"_3064":59073},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3608":2691,"_31008":2677,"_21483":59075,"_5":14766,"_28195":59043,"_3064":59076},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3608":2692,"_31008":2677,"_21483":59078,"_5":14766,"_28195":59043,"_3064":59079},[],"Do not include in the report:",{"_3608":2693,"_31008":2677,"_21483":59081,"_5":14766,"_28195":59043,"_3064":59082},[],"Credentials, tokens, or private keys",{"_3608":2694,"_31008":2677,"_21483":59084,"_5":14766,"_28195":59043,"_3064":59085},[],"Customer data or customer-identifiable information",{"_3608":2695,"_31008":2677,"_21483":59087,"_5":14766,"_28195":59043,"_3064":59088},[],"Confidential architecture or internal infrastructure details",{"_3608":2696,"_31008":2677,"_21483":59090,"_5":14766,"_28195":59047,"_3064":59091},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3608":2697,"_31008":2677,"_21483":59093,"_5":14766,"_28195":59047,"_3064":59094},[],"For upgrade guidance, see Upgrades.",{"_3608":2698,"_31008":2677,"_21483":59096,"_5":14766,"_28195":59051,"_3064":59097},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3608":2699,"_31008":2677,"_21483":59099,"_5":14766,"_28195":59051,"_3064":59100},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3608":2700,"_31008":2677,"_21483":59102,"_5":14766,"_28195":59051,"_3064":59103},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3608":2701,"_31008":2677,"_21483":59105,"_5":14766,"_28195":59051,"_3064":59106},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3608":2702,"_31008":2677,"_21483":59108,"_5":14766,"_28195":59051,"_3064":59109},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3608":2703,"_31008":2703,"_5":15126,"_3064":59111,"_31366":59112,"_21483":59114,"_28195":2703},"3.8.0 to 4.0.0",[50713,59113],"Upgrades",[],{"_3608":2704,"_31008":2703,"_21483":59116,"_5":14766,"_28195":2703,"_3064":59117},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3608":2705,"_31008":2703,"_5":31363,"_21483":59119,"_28195":59120,"_3064":59121},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3608":2706,"_31008":2703,"_5":31363,"_21483":59123,"_28195":59124,"_3064":59125},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3608":2707,"_31008":2703,"_5":31363,"_21483":59127,"_28195":59128,"_3064":59129},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3608":2708,"_31008":2703,"_5":31363,"_21483":59131,"_28195":59132,"_3064":59133},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3608":2709,"_31008":2703,"_5":31363,"_21483":59135,"_28195":59136,"_3064":59137},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3608":2710,"_31008":2703,"_5":31363,"_21483":59139,"_28195":59140,"_3064":59141},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3608":2711,"_31008":2703,"_5":31363,"_21483":59143,"_28195":59144,"_3064":59145},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3608":2712,"_31008":2703,"_5":31363,"_21483":59147,"_28195":59148,"_3064":59149},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3608":2713,"_31008":2703,"_5":31363,"_21483":59151,"_28195":59152,"_3064":59153},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3608":2714,"_31008":2703,"_5":31363,"_21483":59155,"_28195":59156,"_3064":59157},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3608":2715,"_31008":2703,"_5":31363,"_21483":59159,"_28195":59160,"_3064":51351},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3608":2716,"_31008":2703,"_5":31363,"_21483":59162,"_28195":59163,"_3064":59164},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3608":2717,"_31008":2703,"_5":31363,"_21483":59166,"_28195":59167,"_3064":59168},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3608":2718,"_31008":2703,"_5":31363,"_21483":59170,"_28195":59171,"_3064":59172},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3608":2719,"_31008":2703,"_5":31363,"_21483":59174,"_28195":59175,"_3064":59176},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3608":2720,"_31008":2703,"_5":31363,"_21483":59178,"_28195":59179,"_3064":59180},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3608":2721,"_31008":2703,"_5":31363,"_21483":59182,"_28195":59183,"_3064":59184},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3608":2722,"_31008":2703,"_5":31363,"_21483":59186,"_28195":59187,"_3064":59188},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3608":2723,"_31008":2703,"_5":31363,"_21483":59190,"_28195":59191,"_3064":59192},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3608":2724,"_31008":2703,"_5":31363,"_21483":59194,"_28195":59195,"_3064":59196},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3608":2725,"_31008":2703,"_5":31363,"_21483":59198,"_28195":59199,"_3064":59200},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3608":2726,"_31008":2703,"_5":31363,"_21483":59202,"_28195":59203,"_3064":59204},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3608":2727,"_31008":2703,"_5":31363,"_21483":59206,"_28195":59207,"_3064":59208},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3608":2728,"_31008":2703,"_5":31363,"_21483":59210,"_28195":59211,"_3064":59212},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3608":2729,"_31008":2703,"_5":31363,"_21483":59214,"_28195":59215,"_3064":59216},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3608":2730,"_31008":2703,"_5":31363,"_21483":59218,"_28195":59219,"_3064":59220},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3608":2731,"_31008":2703,"_5":31363,"_21483":59222,"_28195":59223,"_3064":59224},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3608":2732,"_31008":2703,"_5":31363,"_21483":59226,"_28195":59227,"_3064":59228},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3608":2733,"_31008":2703,"_5":31363,"_21483":59230,"_28195":59231,"_3064":59232},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3608":2734,"_31008":2703,"_5":31363,"_21483":59234,"_28195":59235,"_3064":59236},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3608":2735,"_31008":2703,"_5":31363,"_21483":59238,"_28195":59239,"_3064":59240},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3608":2736,"_31008":2703,"_5":31363,"_21483":59242,"_28195":59243,"_3064":59244},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3608":2737,"_31008":2703,"_5":31363,"_21483":59246,"_28195":59247,"_3064":59248},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3608":2738,"_31008":2703,"_5":31363,"_21483":59250,"_28195":59251,"_3064":59244},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3608":2739,"_31008":2703,"_5":31363,"_21483":59253,"_28195":59254,"_3064":59255},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3608":2740,"_31008":2703,"_5":31363,"_21483":59257,"_28195":59258,"_3064":59259},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3608":2741,"_31008":2703,"_5":31363,"_21483":59261,"_28195":59262,"_3064":59263},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3608":2742,"_31008":2703,"_5":31363,"_21483":59265,"_28195":59266,"_3064":59267},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3608":2743,"_31008":2703,"_5":31363,"_21483":59269,"_28195":59270,"_3064":59271},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3608":2744,"_31008":2703,"_5":31363,"_21483":59273,"_28195":59274,"_3064":59275},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3608":2745,"_31008":2703,"_5":31363,"_21483":59277,"_28195":59278,"_3064":59279},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3608":2746,"_31008":2703,"_5":31363,"_21483":59281,"_28195":59282,"_3064":59283},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3608":2747,"_31008":2703,"_5":31363,"_21483":59285,"_28195":59286,"_3064":59287},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3608":2748,"_31008":2703,"_5":31363,"_21483":59289,"_28195":59290,"_3064":54963},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3608":2749,"_31008":2703,"_5":31363,"_21483":59292,"_28195":59293,"_3064":59294},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3608":2750,"_31008":2703,"_5":31363,"_21483":59296,"_28195":59297,"_3064":59298},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3608":2751,"_31008":2703,"_21483":59300,"_5":14766,"_28195":2703,"_3064":59301},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3608":2752,"_31008":2703,"_21483":59303,"_5":14766,"_28195":2703,"_3064":59304},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3608":2753,"_31008":2703,"_21483":59306,"_5":14766,"_28195":2703,"_3064":59307},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3608":2754,"_31008":2703,"_21483":59309,"_5":14766,"_28195":2703,"_3064":59310},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3608":2755,"_31008":2703,"_21483":59312,"_5":14766,"_28195":2703,"_3064":59313},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3608":2756,"_31008":2703,"_21483":59315,"_5":14766,"_28195":2703,"_3064":59316},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3608":2757,"_31008":2703,"_21483":59318,"_5":14766,"_28195":2703,"_3064":59319},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3608":2758,"_31008":2703,"_21483":59321,"_5":14766,"_28195":59124,"_3064":59322},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3608":2759,"_31008":2703,"_21483":59324,"_5":14766,"_28195":59124,"_3064":59325},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3608":2760,"_31008":2703,"_21483":59327,"_5":14766,"_28195":59128,"_3064":59328},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3608":2761,"_31008":2703,"_21483":59330,"_5":14766,"_28195":59128,"_3064":59331},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3608":2762,"_31008":2703,"_21483":59333,"_5":14766,"_28195":59132,"_3064":59334},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3608":2763,"_31008":2703,"_21483":59336,"_5":14766,"_28195":59136,"_3064":59337},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3608":2764,"_31008":2703,"_21483":59339,"_5":14766,"_28195":59136,"_3064":59340},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3608":2765,"_31008":2703,"_21483":59342,"_5":14766,"_28195":59136,"_3064":59343},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3608":2766,"_31008":2703,"_21483":59345,"_5":14766,"_28195":59136,"_3064":59346},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3608":2767,"_31008":2703,"_21483":59348,"_5":14766,"_28195":59136,"_3064":59349},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3608":2768,"_31008":2703,"_21483":59351,"_5":14766,"_28195":59140,"_3064":59352},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3608":2769,"_31008":2703,"_21483":59354,"_5":14766,"_28195":59140,"_3064":59355},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3608":2770,"_31008":2703,"_21483":59357,"_5":14766,"_28195":59140,"_3064":59358},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3608":2771,"_31008":2703,"_21483":59360,"_5":14766,"_28195":59140,"_3064":59361},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3608":2772,"_31008":2703,"_21483":59363,"_5":14766,"_28195":59140,"_3064":59364},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3608":2773,"_31008":2703,"_21483":59366,"_5":14766,"_28195":59140,"_3064":59367},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3608":2774,"_31008":2703,"_21483":59369,"_5":14766,"_28195":59144,"_3064":59370},[],"Change",{"_3608":2775,"_31008":2703,"_21483":59372,"_5":14766,"_28195":59144,"_3064":59373},[],"Who is affected",{"_3608":2776,"_31008":2703,"_21483":59375,"_5":14766,"_28195":59144,"_3064":59376},[],"Severity",{"_3608":2777,"_31008":2703,"_21483":59378,"_5":14766,"_28195":59144,"_3064":57833},[],{"_3608":2778,"_31008":2703,"_21483":59380,"_5":14766,"_28195":59144,"_3064":59153},[],{"_3608":2779,"_31008":2703,"_21483":59382,"_5":14766,"_28195":59144,"_3064":59383},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3608":2780,"_31008":2703,"_21483":59385,"_5":14766,"_28195":59144,"_3064":59386},[],"High: KMS and VA start on empty volumes",{"_3608":2781,"_31008":2703,"_21483":59388,"_5":14766,"_28195":59144,"_3064":59389},[],"Copy the data into the new volumes",{"_3608":2782,"_31008":2703,"_21483":59391,"_5":14766,"_28195":59144,"_3064":59157},[],{"_3608":2783,"_31008":2703,"_21483":59393,"_5":14766,"_28195":59144,"_3064":59394},[],"Every Helm release",{"_3608":2784,"_31008":2703,"_21483":59396,"_5":14766,"_28195":59144,"_3064":59397},[],"High: `helm upgrade` fails",{"_3608":2785,"_31008":2703,"_21483":59399,"_5":14766,"_28195":59144,"_3064":59400},[],"Remove or rename legacy keys",{"_3608":2786,"_31008":2703,"_21483":59402,"_5":14766,"_28195":59144,"_3064":51351},[],{"_3608":2787,"_31008":2703,"_21483":59404,"_5":14766,"_28195":59144,"_3064":59394},[],{"_3608":2788,"_31008":2703,"_21483":59406,"_5":14766,"_28195":59144,"_3064":59407},[],"High: `helm upgrade` fails on inline credentials",{"_3608":2789,"_31008":2703,"_21483":59409,"_5":14766,"_28195":59144,"_3064":59410},[],"Create the Secrets first; see Step 2",{"_3608":2790,"_31008":2703,"_21483":59412,"_5":14766,"_28195":59144,"_3064":59164},[],{"_3608":2791,"_31008":2703,"_21483":59414,"_5":14766,"_28195":59144,"_3064":59415},[],"Every deployment",{"_3608":2792,"_31008":2703,"_21483":59417,"_5":14766,"_28195":59144,"_3064":59418},[],"High: without a bootstrap principal there is no administrator",{"_3608":2793,"_31008":2703,"_21483":59420,"_5":14766,"_28195":59144,"_3064":59421},[],"Configure `services.authz`",{"_3608":2794,"_31008":2703,"_21483":59423,"_5":14766,"_28195":59144,"_3064":59168},[],{"_3608":2795,"_31008":2703,"_21483":59425,"_5":14766,"_28195":59144,"_3064":59394},[],{"_3608":2796,"_31008":2703,"_21483":59427,"_5":14766,"_28195":59144,"_3064":59428},[],"High: `helm upgrade` fails on the old keys",{"_3608":2797,"_31008":2703,"_21483":59430,"_5":14766,"_28195":59144,"_3064":59431},[],"Move JWKS and roles into `services.authz`",{"_3608":2798,"_31008":2703,"_21483":59433,"_5":14766,"_28195":59144,"_3064":59188},[],{"_3608":2799,"_31008":2703,"_21483":59435,"_5":14766,"_28195":59144,"_3064":59436},[],"3.8.0 deployments with per-service databases",{"_3608":2800,"_31008":2703,"_21483":59438,"_5":14766,"_28195":59144,"_3064":59439},[],"High: services find no data, or a migration aborts",{"_3608":2801,"_31008":2703,"_21483":59441,"_5":14766,"_28195":59144,"_3064":59442},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3608":2802,"_31008":2703,"_21483":59444,"_5":14766,"_28195":59144,"_3064":59192},[],{"_3608":2803,"_31008":2703,"_21483":59446,"_5":14766,"_28195":59144,"_3064":59447},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3608":2804,"_31008":2703,"_21483":59449,"_5":14766,"_28195":59144,"_3064":59450},[],"High: the backend no longer starts with them",{"_3608":2805,"_31008":2703,"_21483":59452,"_5":14766,"_28195":59144,"_3064":59453},[],"Move to PostgreSQL before upgrading",{"_3608":2806,"_31008":2703,"_21483":59455,"_5":14766,"_28195":59144,"_3064":59236},[],{"_3608":2807,"_31008":2703,"_21483":59457,"_5":14766,"_28195":59144,"_3064":59458},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3608":2808,"_31008":2703,"_21483":59460,"_5":14766,"_28195":59144,"_3064":59461},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3608":2809,"_31008":2703,"_21483":59463,"_5":14766,"_28195":59144,"_3064":59464},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3608":2810,"_31008":2703,"_21483":59466,"_5":14766,"_28195":59144,"_3064":59467},[],"Webhooks with file references",{"_3608":2811,"_31008":2703,"_21483":59469,"_5":14766,"_28195":59144,"_3064":59470},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3608":2812,"_31008":2703,"_21483":59472,"_5":14766,"_28195":59144,"_3064":59473},[],"High: enrollments calling the webhook fail",{"_3608":2813,"_31008":2703,"_21483":59475,"_5":14766,"_28195":59144,"_3064":59476},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3608":2814,"_31008":2703,"_21483":59478,"_5":14766,"_28195":59144,"_3064":59172},[],{"_3608":2815,"_31008":2703,"_21483":59480,"_5":14766,"_28195":59144,"_3064":59481},[],"Releases with per-service identity overrides or mounted key material",{"_3608":2816,"_31008":2703,"_21483":59483,"_5":14766,"_28195":59144,"_3064":59484},[],"Medium: services cannot read their files",{"_3608":2817,"_31008":2703,"_21483":59486,"_5":14766,"_28195":59144,"_3064":59487},[],"Remove the overrides and fix volume ownership",{"_3608":2818,"_31008":2703,"_21483":59489,"_5":14766,"_28195":59144,"_3064":59176},[],{"_3608":2819,"_31008":2703,"_21483":59491,"_5":14766,"_28195":59144,"_3064":59492},[],"Releases that set `amqp.tls`",{"_3608":2820,"_31008":2703,"_21483":59494,"_5":14766,"_28195":59144,"_3064":59495},[],"Medium: clients connect to the wrong port",{"_3608":2821,"_31008":2703,"_21483":59497,"_5":14766,"_28195":59144,"_3064":59498},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3608":2822,"_31008":2703,"_21483":59500,"_5":14766,"_28195":59144,"_3064":59196},[],{"_3608":2823,"_31008":2703,"_21483":59502,"_5":14766,"_28195":59144,"_3064":59503},[],"Installations whose CA keys predate the KMS",{"_3608":2824,"_31008":2703,"_21483":59505,"_5":14766,"_28195":59144,"_3064":59506},[],"Medium: CA keys stay unmanaged",{"_3608":2825,"_31008":2703,"_21483":59508,"_5":14766,"_28195":59144,"_3064":59509},[],"Run the CA-to-KMS migration",{"_3608":2826,"_31008":2703,"_21483":59511,"_5":14766,"_28195":59144,"_3064":59512},[],"Receiver certificate verification",{"_3608":2827,"_31008":2703,"_21483":59514,"_5":14766,"_28195":59144,"_3064":59515},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3608":2828,"_31008":2703,"_21483":59517,"_5":14766,"_28195":59144,"_3064":59518},[],"Medium: credentials go to an unverified receiver",{"_3608":2829,"_31008":2703,"_21483":59520,"_5":14766,"_28195":59144,"_3064":59521},[],"Set `insecure_skip_verify` to `false`",{"_3608":2830,"_31008":2703,"_21483":59523,"_5":14766,"_28195":59144,"_3064":59212},[],{"_3608":2831,"_31008":2703,"_21483":59525,"_5":14766,"_28195":59144,"_3064":59526},[],"Scripts and consoles that edit DMSs through the API",{"_3608":2832,"_31008":2703,"_21483":59528,"_5":14766,"_28195":59144,"_3064":59529},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3608":2833,"_31008":2703,"_21483":59531,"_5":14766,"_28195":59144,"_3064":59532},[],"Read the DMS before editing and use the new field",{"_3608":2834,"_31008":2703,"_21483":59534,"_5":14766,"_28195":59144,"_3064":59232},[],{"_3608":2835,"_31008":2703,"_21483":59536,"_5":14766,"_28195":59144,"_3064":59537},[],"Clients that create or update CRL settings through the API",{"_3608":2836,"_31008":2703,"_21483":59539,"_5":14766,"_28195":59144,"_3064":59540},[],"Medium: requests with the old field return an error",{"_3608":2837,"_31008":2703,"_21483":59542,"_5":14766,"_28195":59144,"_3064":59543},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3608":2838,"_31008":2703,"_21483":59545,"_5":14766,"_28195":59144,"_3064":59240},[],{"_3608":2839,"_31008":2703,"_21483":59547,"_5":14766,"_28195":59144,"_3064":59548},[],"Alert subscriptions and consumers of the VA events",{"_3608":2840,"_31008":2703,"_21483":59550,"_5":14766,"_28195":59144,"_3064":59551},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3608":2841,"_31008":2703,"_21483":59553,"_5":14766,"_28195":59144,"_3064":59554},[],"Review conditions filtering on the old event payload or subject",{"_3608":2842,"_31008":2703,"_21483":59556,"_5":14766,"_28195":59144,"_3064":59244},[],{"_3608":2843,"_31008":2703,"_21483":59558,"_5":14766,"_28195":59144,"_3064":59559},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3608":2844,"_31008":2703,"_21483":59561,"_5":14766,"_28195":59144,"_3064":59562},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3608":2845,"_31008":2703,"_21483":59564,"_5":14766,"_28195":59144,"_3064":59565},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3608":2846,"_31008":2703,"_21483":59567,"_5":14766,"_28195":59144,"_3064":59228},[],{"_3608":2847,"_31008":2703,"_21483":59569,"_5":14766,"_28195":59144,"_3064":59570},[],"Consumers that read the device `events` field",{"_3608":2848,"_31008":2703,"_21483":59572,"_5":14766,"_28195":59144,"_3064":59573},[],"Medium: the field disappears",{"_3608":2849,"_31008":2703,"_21483":59575,"_5":14766,"_28195":59144,"_3064":59576},[],"Use the new event endpoints",{"_3608":2850,"_31008":2703,"_21483":59578,"_5":14766,"_28195":59144,"_3064":59255},[],{"_3608":2851,"_31008":2703,"_21483":59580,"_5":14766,"_28195":59144,"_3064":59581},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3608":2852,"_31008":2703,"_21483":59583,"_5":14766,"_28195":59144,"_3064":59584},[],"Medium: the VA migration aborts",{"_3608":2853,"_31008":2703,"_21483":59586,"_5":14766,"_28195":59144,"_3064":59587},[],"Fix the affected roles before upgrading",{"_3608":2854,"_31008":2703,"_21483":59589,"_5":14766,"_28195":59144,"_3064":59180},[],{"_3608":2855,"_31008":2703,"_21483":59591,"_5":14766,"_28195":59144,"_3064":59592},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3608":2856,"_31008":2703,"_21483":59594,"_5":14766,"_28195":59144,"_3064":59595},[],"Low to medium: validation errors or changed defaults",{"_3608":2857,"_31008":2703,"_21483":59597,"_5":14766,"_28195":59144,"_3064":59598},[],"Update the values file",{"_3608":2858,"_31008":2703,"_21483":59600,"_5":14766,"_28195":59144,"_3064":59220},[],{"_3608":2859,"_31008":2703,"_21483":59602,"_5":14766,"_28195":59144,"_3064":59603},[],"Clients that send the DMS ID in the update body",{"_3608":2860,"_31008":2703,"_21483":59605,"_5":14766,"_28195":59144,"_3064":59606},[],"Low: the ID in the URL wins",{"_3608":2861,"_31008":2703,"_21483":59608,"_5":14766,"_28195":59144,"_3064":59609},[],"Send the ID in the URL",{"_3608":2862,"_31008":2703,"_21483":59611,"_5":14766,"_28195":59144,"_3064":59248},[],{"_3608":2863,"_31008":2703,"_21483":59613,"_5":14766,"_28195":59144,"_3064":59614},[],"Clients that send an `id` when creating or importing CAs",{"_3608":2864,"_31008":2703,"_21483":59616,"_5":14766,"_28195":59144,"_3064":59617},[],"Low: the ID in the body is ignored, and the field is removed",{"_3608":2865,"_31008":2703,"_21483":59619,"_5":14766,"_28195":59144,"_3064":59620},[],"Let the backend assign the ID and use the returned one",{"_3608":2866,"_31008":2703,"_21483":59622,"_5":14766,"_28195":59144,"_3064":59244},[],{"_3608":2867,"_31008":2703,"_21483":59624,"_5":14766,"_28195":59144,"_3064":59625},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3608":2868,"_31008":2703,"_21483":59627,"_5":14766,"_28195":59144,"_3064":59628},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3608":2869,"_31008":2703,"_21483":59630,"_5":14766,"_28195":59144,"_3064":59631},[],"Use the KMS `sign` and `verify` operations",{"_3608":2870,"_31008":2703,"_21483":59633,"_5":14766,"_28195":59144,"_3064":59224},[],{"_3608":2871,"_31008":2703,"_21483":59635,"_5":14766,"_28195":59144,"_3064":59636},[],"Consumers that match on certificate `type`",{"_3608":2872,"_31008":2703,"_21483":59638,"_5":14766,"_28195":59144,"_3064":59639},[],"Low: two values are renamed",{"_3608":2873,"_31008":2703,"_21483":59641,"_5":14766,"_28195":59144,"_3064":59642},[],"Adapt consumers",{"_3608":2874,"_31008":2703,"_21483":59644,"_5":14766,"_28195":59144,"_3064":59216},[],{"_3608":2875,"_31008":2703,"_21483":59646,"_5":14766,"_28195":59144,"_3064":59647},[],"Any DMS",{"_3608":2876,"_31008":2703,"_21483":59649,"_5":14766,"_28195":59144,"_3064":59650},[],"Low: informational",{"_3608":2877,"_31008":2703,"_21483":59652,"_5":14766,"_28195":59144,"_3064":59653},[],"Read both blocks before editing",{"_3608":2878,"_31008":2703,"_21483":59655,"_5":14766,"_28195":59152,"_3064":59656},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3608":2879,"_31008":2703,"_21483":59658,"_5":14766,"_28195":59152,"_3064":59659},[],"Step 4 of the migration guide copies the data.",{"_3608":2880,"_31008":2703,"_21483":59661,"_5":14766,"_28195":59156,"_3064":59662},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3608":2881,"_31008":2703,"_21483":59664,"_5":14766,"_28195":59160,"_3064":59665},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3608":2882,"_31008":2703,"_21483":59667,"_5":14766,"_28195":59160,"_3064":59668},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3608":2883,"_31008":2703,"_21483":59670,"_5":14766,"_28195":59163,"_3064":59671},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3608":2884,"_31008":2703,"_21483":59673,"_5":14766,"_28195":59167,"_3064":59674},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3608":2885,"_31008":2703,"_21483":59676,"_5":14766,"_28195":59171,"_3064":59677},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3608":2886,"_31008":2703,"_21483":59679,"_5":14766,"_28195":59171,"_3064":59680},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3608":2887,"_31008":2703,"_21483":59682,"_5":14766,"_28195":59171,"_3064":59683},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3608":2888,"_31008":2703,"_21483":59685,"_5":14766,"_28195":59175,"_3064":59686},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3608":2889,"_31008":2703,"_21483":59688,"_5":14766,"_28195":59179,"_3064":59689},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3608":2890,"_31008":2703,"_21483":59691,"_5":14766,"_28195":59179,"_3064":59692},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3608":2891,"_31008":2703,"_21483":59694,"_5":14766,"_28195":59179,"_3064":59695},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3608":2892,"_31008":2703,"_21483":59697,"_5":14766,"_28195":59179,"_3064":59698},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3608":2893,"_31008":2703,"_21483":59700,"_5":14766,"_28195":59179,"_3064":59701},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3608":2894,"_31008":2703,"_21483":59703,"_5":14766,"_28195":59179,"_3064":59704},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3608":2895,"_31008":2703,"_21483":59706,"_5":14766,"_28195":59187,"_3064":59707},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3608":2896,"_31008":2703,"_21483":59709,"_5":14766,"_28195":59187,"_3064":59710},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3608":2897,"_31008":2703,"_21483":59712,"_5":14766,"_28195":59187,"_3064":59713},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3608":2898,"_31008":2703,"_21483":59715,"_5":14766,"_28195":59187,"_3064":59716},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3608":2899,"_31008":2703,"_21483":59718,"_5":14766,"_28195":59187,"_3064":59719},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3608":2900,"_31008":2703,"_21483":59721,"_5":14766,"_28195":59191,"_3064":59722},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3608":2901,"_31008":2703,"_21483":59724,"_5":14766,"_28195":59195,"_3064":59725},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3608":2902,"_31008":2703,"_21483":59727,"_5":14766,"_28195":59195,"_3064":59728},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3608":2903,"_31008":2703,"_21483":59730,"_5":14766,"_28195":59195,"_3064":59731},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3608":2904,"_31008":2703,"_21483":59733,"_5":14766,"_28195":59195,"_3064":59734},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3608":2905,"_31008":2703,"_21483":59736,"_5":14766,"_28195":59195,"_3064":59737},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3608":2906,"_31008":2703,"_21483":59739,"_5":14766,"_28195":59195,"_3064":59740},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3608":2907,"_31008":2703,"_21483":59742,"_5":14766,"_28195":59195,"_3064":59743},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3608":2908,"_31008":2703,"_21483":59745,"_5":14766,"_28195":59195,"_3064":59746},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3608":2909,"_31008":2703,"_21483":59748,"_5":14766,"_28195":59199,"_3064":59749},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3608":2910,"_31008":2703,"_21483":59751,"_5":14766,"_28195":59207,"_3064":59752},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3608":2911,"_31008":2703,"_21483":59754,"_5":14766,"_28195":59207,"_3064":59755},[],"Field in 3.8.0",{"_3608":2912,"_31008":2703,"_21483":59757,"_5":14766,"_28195":59207,"_3064":59758},[],"Field in 4.0.0",{"_3608":2913,"_31008":2703,"_21483":59760,"_5":14766,"_28195":59207,"_3064":59761},[],"`validate_server_cert`",{"_3608":2914,"_31008":2703,"_21483":59763,"_5":14766,"_28195":59207,"_3064":59764},[],"`insecure_skip_verify` (value negated)",{"_3608":2915,"_31008":2703,"_21483":59766,"_5":14766,"_28195":59207,"_3064":59767},[],"`oidc`",{"_3608":2916,"_31008":2703,"_21483":59769,"_5":14766,"_28195":59207,"_3064":59770},[],"`jwt_options`",{"_3608":2917,"_31008":2703,"_21483":59772,"_5":14766,"_28195":59207,"_3064":59773},[],"`apikey`",{"_3608":2918,"_31008":2703,"_21483":59775,"_5":14766,"_28195":59207,"_3064":59776},[],"`apikey_options`",{"_3608":2919,"_31008":2703,"_21483":59778,"_5":14766,"_28195":59207,"_3064":59779},[],"`mtls`",{"_3608":2920,"_31008":2703,"_21483":59781,"_5":14766,"_28195":59207,"_3064":59782},[],"`mtls_options`",{"_3608":2921,"_31008":2703,"_21483":59784,"_5":14766,"_28195":59207,"_3064":59785},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3608":2922,"_31008":2703,"_21483":59787,"_5":14766,"_28195":59207,"_3064":59788},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3608":2923,"_31008":2703,"_21483":59790,"_5":14766,"_28195":59207,"_3064":59791},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3608":2924,"_31008":2703,"_21483":59793,"_5":14766,"_28195":59211,"_3064":59794},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3608":2925,"_31008":2703,"_21483":59796,"_5":14766,"_28195":59211,"_3064":59797},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3608":2926,"_31008":2703,"_21483":59799,"_5":14766,"_28195":59211,"_3064":59800},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3608":2927,"_31008":2703,"_21483":59802,"_5":14766,"_28195":59215,"_3064":59803},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3608":2928,"_31008":2703,"_21483":59805,"_5":14766,"_28195":59219,"_3064":59806},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3608":2929,"_31008":2703,"_21483":59808,"_5":14766,"_28195":59223,"_3064":59809},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3608":2930,"_31008":2703,"_21483":59811,"_5":14766,"_28195":59227,"_3064":59812},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3608":2931,"_31008":2703,"_21483":59814,"_5":14766,"_28195":59227,"_3064":59815},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3608":2932,"_31008":2703,"_21483":59817,"_5":14766,"_28195":59227,"_3064":59818},[],"`POST /v1/devices/:id/events` creates an event.",{"_3608":2933,"_31008":2703,"_21483":59820,"_5":14766,"_28195":59227,"_3064":59821},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3608":2934,"_31008":2703,"_21483":59823,"_5":14766,"_28195":59231,"_3064":59824},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3608":2935,"_31008":2703,"_21483":59826,"_5":14766,"_28195":59235,"_3064":59827},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3608":2936,"_31008":2703,"_21483":59829,"_5":14766,"_28195":59235,"_3064":59830},[],"Route",{"_3608":2937,"_31008":2703,"_21483":59832,"_5":14766,"_28195":59235,"_3064":54150},[],{"_3608":2938,"_31008":2703,"_21483":59834,"_5":14766,"_28195":59235,"_3064":59835},[],"`GET /v1/crl-settings`",{"_3608":2939,"_31008":2703,"_21483":59837,"_5":14766,"_28195":59235,"_3064":59838},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3608":2940,"_31008":2703,"_21483":59840,"_5":14766,"_28195":59235,"_3064":59841},[],"`GET /v1/crl-settings/{ca-id}`",{"_3608":2941,"_31008":2703,"_21483":59843,"_5":14766,"_28195":59235,"_3064":59844},[],"Reads the settings of a CA.",{"_3608":2942,"_31008":2703,"_21483":59846,"_5":14766,"_28195":59235,"_3064":59847},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3608":2943,"_31008":2703,"_21483":59849,"_5":14766,"_28195":59235,"_3064":59850},[],"Replaces `crl_options`.",{"_3608":2944,"_31008":2703,"_21483":59852,"_5":14766,"_28195":59235,"_3064":59853},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3608":2945,"_31008":2703,"_21483":59855,"_5":14766,"_28195":59235,"_3064":59856},[],"Removes the archived settings of a CA.",{"_3608":2946,"_31008":2703,"_21483":59858,"_5":14766,"_28195":59235,"_3064":59859},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3608":2947,"_31008":2703,"_21483":59861,"_5":14766,"_28195":59235,"_3064":59862},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3608":2948,"_31008":2703,"_21483":59864,"_5":14766,"_28195":59235,"_3064":59865},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3608":2949,"_31008":2703,"_21483":59867,"_5":14766,"_28195":59235,"_3064":59868},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3608":2950,"_31008":2703,"_21483":59870,"_5":14766,"_28195":59235,"_3064":59871},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3608":2951,"_31008":2703,"_21483":59873,"_5":14766,"_28195":59235,"_3064":59874},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3608":2952,"_31008":2703,"_21483":59876,"_5":14766,"_28195":59235,"_3064":59877},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3608":2953,"_31008":2703,"_21483":59879,"_5":14766,"_28195":59235,"_3064":59880},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3608":2954,"_31008":2703,"_21483":59882,"_5":14766,"_28195":59235,"_3064":59883},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3608":2955,"_31008":2703,"_21483":59885,"_5":14766,"_28195":59235,"_3064":59886},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3608":2956,"_31008":2703,"_21483":59888,"_5":14766,"_28195":59235,"_3064":59889},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3608":2957,"_31008":2703,"_21483":59891,"_5":14766,"_28195":59239,"_3064":59892},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3608":2958,"_31008":2703,"_21483":59894,"_5":14766,"_28195":59243,"_3064":59895},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead; see Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3608":2959,"_31008":2703,"_21483":59897,"_5":14766,"_28195":59247,"_3064":59898},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3608":2960,"_31008":2703,"_21483":59900,"_5":14766,"_28195":59251,"_3064":59901},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3608":2961,"_31008":2703,"_21483":59903,"_5":14766,"_28195":59251,"_3064":59904},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3608":2962,"_31008":2703,"_21483":59906,"_5":14766,"_28195":59254,"_3064":59907},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3608":2963,"_31008":2703,"_21483":59909,"_5":14766,"_28195":59258,"_3064":59910},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3608":2964,"_31008":2703,"_21483":59912,"_5":14766,"_28195":59262,"_3064":59913},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3608":2965,"_31008":2703,"_21483":59915,"_5":14766,"_28195":59262,"_3064":59916},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3608":2966,"_31008":2703,"_21483":59918,"_5":14766,"_28195":59262,"_3064":59919},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3608":2967,"_31008":2703,"_21483":59921,"_5":14766,"_28195":59262,"_3064":59922},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3608":2968,"_31008":2703,"_21483":59924,"_5":14766,"_28195":59262,"_3064":59925},[],"Record the names of your local-storage PVCs:",{"_3608":2969,"_31008":2703,"_21483":59927,"_5":14766,"_28195":59262,"_3064":59928},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3608":2970,"_31008":2703,"_21483":59930,"_5":14766,"_28195":59266,"_3064":59931},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3608":2971,"_31008":2703,"_21483":59933,"_5":14766,"_28195":59266,"_3064":59934},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3608":2972,"_31008":2703,"_21483":59936,"_5":14766,"_28195":59266,"_3064":59937},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3608":2973,"_31008":2703,"_21483":59939,"_5":14766,"_28195":59266,"_3064":59940},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3608":2974,"_31008":2703,"_21483":59942,"_5":14766,"_28195":59266,"_3064":59943},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3608":2975,"_31008":2703,"_21483":59945,"_5":14766,"_28195":59270,"_3064":59946},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3608":2976,"_31008":2703,"_21483":59948,"_5":14766,"_28195":59270,"_3064":59949},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3608":2977,"_31008":2703,"_21483":59951,"_5":14766,"_28195":59270,"_3064":59952},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3608":2978,"_31008":2703,"_21483":59954,"_5":14766,"_28195":59270,"_3064":59955},[],"Secret (`existingSecret`)",{"_3608":2979,"_31008":2703,"_21483":59957,"_5":14766,"_28195":59270,"_3064":59958},[],"Required data keys",{"_3608":2980,"_31008":2703,"_21483":59960,"_5":14766,"_28195":59270,"_3064":59961},[],"When",{"_3608":2981,"_31008":2703,"_21483":59963,"_5":14766,"_28195":59270,"_3064":59964},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3608":2982,"_31008":2703,"_21483":59966,"_5":14766,"_28195":59270,"_3064":59967},[],"`username`, `password`",{"_3608":2983,"_31008":2703,"_21483":59969,"_5":14766,"_28195":59270,"_3064":59970},[],"Always",{"_3608":2984,"_31008":2703,"_21483":59972,"_5":14766,"_28195":59270,"_3064":59973},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3608":2985,"_31008":2703,"_21483":59975,"_5":14766,"_28195":59270,"_3064":59967},[],{"_3608":2986,"_31008":2703,"_21483":59977,"_5":14766,"_28195":59270,"_3064":59970},[],{"_3608":2987,"_31008":2703,"_21483":59979,"_5":14766,"_28195":59270,"_3064":59980},[],"`services.alerts.smtp_server.existingSecret`",{"_3608":2988,"_31008":2703,"_21483":59982,"_5":14766,"_28195":59270,"_3064":59967},[],{"_3608":2989,"_31008":2703,"_21483":59984,"_5":14766,"_28195":59270,"_3064":59985},[],"Only when SMTP authentication is enabled",{"_3608":2990,"_31008":2703,"_21483":59987,"_5":14766,"_28195":59270,"_3064":59988},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3608":2991,"_31008":2703,"_21483":59990,"_5":14766,"_28195":59270,"_3064":59991},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3608":2992,"_31008":2703,"_21483":59993,"_5":14766,"_28195":59270,"_3064":59994},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3608":2993,"_31008":2703,"_21483":59996,"_5":14766,"_28195":59270,"_3064":59997},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3608":2994,"_31008":2703,"_21483":59999,"_5":14766,"_28195":59270,"_3064":60000},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3608":2995,"_31008":2703,"_21483":60002,"_5":14766,"_28195":59270,"_3064":60003},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3608":2996,"_31008":2703,"_21483":60005,"_5":14766,"_28195":59270,"_3064":60006},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3608":2997,"_31008":2703,"_21483":60008,"_5":14766,"_28195":59270,"_3064":60009},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3608":2998,"_31008":2703,"_21483":60011,"_5":14766,"_28195":59270,"_3064":60012},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3608":2999,"_31008":2703,"_21483":60014,"_5":14766,"_28195":59270,"_3064":60015},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3608":3000,"_31008":2703,"_21483":60017,"_5":14766,"_28195":59270,"_3064":60018},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3608":3001,"_31008":2703,"_21483":60020,"_5":14766,"_28195":59270,"_3064":60021},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3608":3002,"_31008":2703,"_21483":60023,"_5":14766,"_28195":59270,"_3064":60024},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3608":3003,"_31008":2703,"_21483":60026,"_5":14766,"_28195":59270,"_3064":60027},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3608":3004,"_31008":2703,"_21483":60029,"_5":14766,"_28195":59270,"_3064":60030},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3608":3005,"_31008":2703,"_21483":60032,"_5":14766,"_28195":59274,"_3064":60033},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3608":3006,"_31008":2703,"_21483":60035,"_5":14766,"_28195":59274,"_3064":60036},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3608":3007,"_31008":2703,"_21483":60038,"_5":14766,"_28195":59278,"_3064":60039},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3608":3008,"_31008":2703,"_21483":60041,"_5":14766,"_28195":59278,"_3064":60042},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3608":3009,"_31008":2703,"_21483":60044,"_5":14766,"_28195":59278,"_3064":60045},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3608":3010,"_31008":2703,"_21483":60047,"_5":14766,"_28195":59278,"_3064":60048},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3608":3011,"_31008":2703,"_21483":60050,"_5":14766,"_28195":59278,"_3064":60051},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3608":3012,"_31008":2703,"_21483":60053,"_5":14766,"_28195":59278,"_3064":60054},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3608":3013,"_31008":2703,"_21483":60056,"_5":14766,"_28195":59278,"_3064":60057},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3608":3014,"_31008":2703,"_21483":60059,"_5":14766,"_28195":59278,"_3064":60060},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3608":3015,"_31008":2703,"_21483":60062,"_5":14766,"_28195":59278,"_3064":60063},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3608":3016,"_31008":2703,"_21483":60065,"_5":14766,"_28195":59278,"_3064":60066},[],"**Remove the helper and restore the recorded replica counts:**",{"_3608":3017,"_31008":2703,"_21483":60068,"_5":14766,"_28195":59278,"_3064":60069},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3608":3018,"_31008":2703,"_21483":60071,"_5":14766,"_28195":59282,"_3064":60072},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3608":3019,"_31008":2703,"_21483":60074,"_5":14766,"_28195":59282,"_3064":60075},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3608":3020,"_31008":2703,"_21483":60077,"_5":14766,"_28195":59286,"_3064":60078},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3608":3021,"_31008":2703,"_21483":60080,"_5":14766,"_28195":59286,"_3064":60081},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3608":3022,"_31008":2703,"_21483":60083,"_5":14766,"_28195":59286,"_3064":60084},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3608":3023,"_31008":2703,"_21483":60086,"_5":14766,"_28195":59286,"_3064":60087},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3608":3024,"_31008":2703,"_21483":60089,"_5":14766,"_28195":59286,"_3064":60090},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3608":3025,"_31008":2703,"_21483":60092,"_5":14766,"_28195":59286,"_3064":60093},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3608":3026,"_31008":2703,"_21483":60095,"_5":14766,"_28195":59286,"_3064":60096},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3608":3027,"_31008":2703,"_21483":60098,"_5":14766,"_28195":59286,"_3064":60099},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3608":3028,"_31008":2703,"_21483":60101,"_5":14766,"_28195":59290,"_3064":60102},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3608":3029,"_31008":2703,"_21483":60104,"_5":14766,"_28195":59290,"_3064":60105},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3608":3030,"_31008":2703,"_21483":60107,"_5":14766,"_28195":59290,"_3064":60108},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3608":3031,"_31008":2703,"_21483":60110,"_5":14766,"_28195":59290,"_3064":60111},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3608":3032,"_31008":2703,"_21483":60113,"_5":14766,"_28195":59290,"_3064":60114},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3608":3033,"_31008":2703,"_21483":60116,"_5":14766,"_28195":59290,"_3064":60117},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3608":3034,"_31008":2703,"_21483":60119,"_5":14766,"_28195":59290,"_3064":60120},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3608":3035,"_31008":2703,"_21483":60122,"_5":14766,"_28195":59290,"_3064":60123},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3608":3036,"_31008":2703,"_21483":60125,"_5":14766,"_28195":59290,"_3064":60126},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3608":3037,"_31008":2703,"_21483":60128,"_5":14766,"_28195":59290,"_3064":60129},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3608":3038,"_31008":2703,"_21483":60131,"_5":14766,"_28195":59290,"_3064":60132},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3608":3039,"_31008":2703,"_21483":60134,"_5":14766,"_28195":59293,"_3064":60135},[],"After the upgrade, check in this order:",{"_3608":3040,"_31008":2703,"_21483":60137,"_5":14766,"_28195":59293,"_3064":60138},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3608":3041,"_31008":2703,"_21483":60140,"_5":14766,"_28195":59293,"_3064":60141},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3608":3042,"_31008":2703,"_21483":60143,"_5":14766,"_28195":59293,"_3064":60144},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3608":3043,"_31008":2703,"_21483":60146,"_5":14766,"_28195":59293,"_3064":60147},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3608":3044,"_31008":2703,"_21483":60149,"_5":14766,"_28195":59293,"_3064":60150},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3608":3045,"_31008":2703,"_21483":60152,"_5":14766,"_28195":59293,"_3064":60153},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3608":3046,"_31008":2703,"_21483":60155,"_5":14766,"_28195":59293,"_3064":60156},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3608":3047,"_31008":2703,"_21483":60158,"_5":14766,"_28195":59293,"_3064":60159},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3608":3048,"_31008":2703,"_21483":60161,"_5":14766,"_28195":59293,"_3064":60162},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3608":3049,"_31008":2703,"_21483":60164,"_5":14766,"_28195":59293,"_3064":60165},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3608":3050,"_31008":2703,"_21483":60167,"_5":14766,"_28195":59293,"_3064":60168},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3608":3051,"_31008":2703,"_21483":60170,"_5":14766,"_28195":59293,"_3064":60171},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3608":3052,"_31008":2703,"_21483":60173,"_5":14766,"_28195":59293,"_3064":60174},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3608":3053,"_31008":2703,"_21483":60176,"_5":14766,"_28195":59293,"_3064":60177},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3608":3054,"_31008":2703,"_21483":60179,"_5":14766,"_28195":59293,"_3064":60180},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3608":3055,"_31008":2703,"_21483":60182,"_5":14766,"_28195":59297,"_3064":60183},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3608":3056,"_31008":2703,"_21483":60185,"_5":14766,"_28195":59297,"_3064":60186},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3608":3057,"_31008":2703,"_21483":60188,"_5":14766,"_28195":59297,"_3064":60189},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3608":3058,"_31008":2703,"_21483":60191,"_5":14766,"_28195":59297,"_3064":60192},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3608":3059,"_31008":2703,"_21483":60194,"_5":14766,"_28195":59297,"_3064":60195},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60198":60199,"_60200":60201,"_60202":60203,"_60204":60205,"_18608":3099,"_72399":3099},"language","engli