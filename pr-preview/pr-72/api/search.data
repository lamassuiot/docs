7":60168,"_41489":60171,"_41491":60174,"_41493":60177,"_41495":60180,"_41497":60183,"_41499":60186,"_41501":60189,"_41503":60192,"_41505":60195,"_41508":60198,"_41510":60201,"_41512":60204,"_41514":60207},{"_3608":15,"_31023":15,"_5":15126,"_3064":50725,"_31381":50726,"_21483":50730,"_28210":15},"Deploy from AWS Marketplace",[50727,50728,50729],"Docs","Deployment","Other models",[],{"_3608":16,"_31023":15,"_21483":50732,"_5":14766,"_28210":15,"_3064":50733},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3608":17,"_31023":15,"_5":31378,"_21483":50735,"_28210":50736,"_3064":50737},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3608":18,"_31023":15,"_5":31378,"_21483":50739,"_28210":50740,"_3064":50741},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3608":19,"_31023":15,"_5":31378,"_21483":50743,"_28210":50744,"_3064":50745},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3608":20,"_31023":15,"_5":31378,"_21483":50747,"_28210":50748,"_3064":50749},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3608":21,"_31023":15,"_5":31378,"_21483":50751,"_28210":50752,"_3064":50753},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3608":22,"_31023":15,"_5":31378,"_21483":50755,"_28210":50756,"_3064":50757},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3608":23,"_31023":15,"_5":31378,"_21483":50759,"_28210":50760,"_3064":50761},[],"/docs/pr-preview/pr-72/deployment/aws-marketplace#next-step","Next step",{"_3608":24,"_31023":15,"_21483":50763,"_5":14766,"_28210":15,"_3064":50764},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3608":25,"_31023":15,"_21483":50766,"_5":14766,"_28210":50736,"_3064":50767},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3608":26,"_31023":15,"_21483":50769,"_5":14766,"_28210":50736,"_3064":50770},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3608":27,"_31023":15,"_21483":50772,"_5":14766,"_28210":50736,"_3064":50773},[],"A security group allowing the necessary endpoints.",{"_3608":28,"_31023":15,"_21483":50775,"_5":14766,"_28210":50740,"_3064":50776},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3608":29,"_31023":15,"_21483":50778,"_5":14766,"_28210":50740,"_3064":50779},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3608":30,"_31023":15,"_21483":50781,"_5":14766,"_28210":50740,"_3064":50782},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3608":31,"_31023":15,"_21483":50784,"_5":14766,"_28210":50744,"_3064":50785},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3608":32,"_31023":15,"_21483":50787,"_5":14766,"_28210":50748,"_3064":50788},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3608":33,"_31023":15,"_21483":50790,"_5":14766,"_28210":50752,"_3064":50791},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3608":34,"_31023":15,"_21483":50793,"_5":14766,"_28210":50756,"_3064":50794},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3608":35,"_31023":15,"_21483":50796,"_5":14766,"_28210":50760,"_3064":50797},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3608":36,"_31023":36,"_5":15126,"_3064":50799,"_31381":50800,"_21483":50801,"_28210":36},"Deploy Lamassu",[50727,50728],[],{"_3608":37,"_31023":36,"_21483":50803,"_5":14766,"_28210":36,"_3064":50804},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3608":38,"_31023":36,"_5":31378,"_21483":50806,"_28210":50807,"_3064":50808},[],"/docs/pr-preview/pr-72/deployment/overview#choose-a-model","Choose a model",{"_3608":39,"_31023":36,"_5":31378,"_21483":50810,"_28210":50811,"_3064":50812},[],"/docs/pr-preview/pr-72/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3608":40,"_31023":36,"_5":31378,"_21483":50814,"_28210":50815,"_3064":50816},[],"/docs/pr-preview/pr-72/deployment/overview#after-deployment","After deployment",{"_3608":41,"_31023":36,"_21483":50818,"_5":14766,"_28210":36,"_3064":50819},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3608":42,"_31023":36,"_21483":50821,"_5":14766,"_28210":50807,"_3064":50822},[],"Model",{"_3608":43,"_31023":36,"_21483":50824,"_5":14766,"_28210":50807,"_3064":50825},[],"Recommended for",{"_3608":44,"_31023":36,"_21483":50827,"_5":14766,"_28210":50807,"_3064":50828},[],"Who operates the infrastructure",{"_3608":45,"_31023":36,"_21483":50830,"_5":14766,"_28210":50807,"_3064":50831},[],"Starting point",{"_3608":46,"_31023":36,"_21483":50833,"_5":14766,"_28210":50807,"_3064":50834},[],"Kubernetes self-managed",{"_3608":47,"_31023":36,"_21483":50836,"_5":14766,"_28210":50807,"_3064":50837},[],"Production, regulated environments and custom deployments",{"_3608":48,"_31023":36,"_21483":50839,"_5":14766,"_28210":50807,"_3064":50840},[],"Your team",{"_3608":49,"_31023":36,"_21483":50842,"_5":14766,"_28210":50807,"_3064":50843},[],"Helm or Fastlane",{"_3608":50,"_31023":36,"_21483":50845,"_5":14766,"_28210":50807,"_3064":50846},[],"AWS Marketplace",{"_3608":51,"_31023":36,"_21483":50848,"_5":14766,"_28210":50807,"_3064":50849},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3608":52,"_31023":36,"_21483":50851,"_5":14766,"_28210":50807,"_3064":50840},[],{"_3608":53,"_31023":36,"_21483":50853,"_5":14766,"_28210":50807,"_3064":50854},[],"Preconfigured image on EC2",{"_3608":54,"_31023":36,"_21483":50856,"_5":14766,"_28210":50807,"_3064":50857},[],"SaaS",{"_3608":55,"_31023":36,"_21483":50859,"_5":14766,"_28210":50807,"_3064":50860},[],"Teams that want to use the platform without operating it",{"_3608":56,"_31023":36,"_21483":50862,"_5":14766,"_28210":50807,"_3064":50863},[],"Lamassu",{"_3608":57,"_31023":36,"_21483":50865,"_5":14766,"_28210":50807,"_3064":50866},[],"Managed subscription",{"_3608":58,"_31023":36,"_21483":50868,"_5":14766,"_28210":50807,"_3064":50869},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3608":59,"_31023":36,"_21483":50871,"_5":14766,"_28210":50807,"_3064":50872},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3608":60,"_31023":36,"_21483":50874,"_5":14766,"_28210":50807,"_3064":50875},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3608":61,"_31023":36,"_21483":50877,"_5":14766,"_28210":50811,"_3064":50878},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3608":62,"_31023":36,"_21483":50880,"_5":14766,"_28210":50815,"_3064":50881},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3608":63,"_31023":63,"_5":15126,"_3064":50883,"_31381":50884,"_21483":50885,"_28210":63},"Use Lamassu as SaaS",[50727,50728,50729],[],{"_3608":64,"_31023":63,"_21483":50887,"_5":14766,"_28210":63,"_3064":50888},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3608":65,"_31023":63,"_5":31378,"_21483":50890,"_28210":50891,"_3064":50892},[],"/docs/pr-preview/pr-72/deployment/saas#what-the-service-manages","What the service manages",{"_3608":66,"_31023":63,"_5":31378,"_21483":50894,"_28210":50895,"_3064":50896},[],"/docs/pr-preview/pr-72/deployment/saas#plans","Plans",{"_3608":67,"_31023":63,"_5":31378,"_21483":50898,"_28210":50899,"_3064":50900},[],"/docs/pr-preview/pr-72/deployment/saas#request-access","Request access",{"_3608":68,"_31023":63,"_21483":50902,"_5":14766,"_28210":63,"_3064":50903},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3608":69,"_31023":63,"_21483":50905,"_5":14766,"_28210":50891,"_3064":50906},[],"Platform availability and maintenance.",{"_3608":70,"_31023":63,"_21483":50908,"_5":14766,"_28210":50891,"_3064":50909},[],"Automatic backups.",{"_3608":71,"_31023":63,"_21483":50911,"_5":14766,"_28210":50891,"_3064":50912},[],"Version upgrades.",{"_3608":72,"_31023":63,"_21483":50914,"_5":14766,"_28210":50891,"_3064":50915},[],"Technical support and SLA according to your plan.",{"_3608":73,"_31023":63,"_21483":50917,"_5":14766,"_28210":50895,"_3064":50918},[],"Plan",{"_3608":74,"_31023":63,"_21483":50920,"_5":14766,"_28210":50895,"_3064":50921},[],"Devices",{"_3608":75,"_31023":63,"_21483":50923,"_5":14766,"_28210":50895,"_3064":50924},[],"Support",{"_3608":76,"_31023":63,"_21483":50926,"_5":14766,"_28210":50895,"_3064":50927},[],"SLA",{"_3608":77,"_31023":63,"_21483":50929,"_5":14766,"_28210":50895,"_3064":50930},[],"Starter",{"_3608":78,"_31023":63,"_21483":50932,"_5":14766,"_28210":50895,"_3064":50933},[],"Up to 1,000",{"_3608":79,"_31023":63,"_21483":50935,"_5":14766,"_28210":50895,"_3064":50936},[],"Email",{"_3608":80,"_31023":63,"_21483":50938,"_5":14766,"_28210":50895,"_3064":50939},[],"99.5 %",{"_3608":81,"_31023":63,"_21483":50941,"_5":14766,"_28210":50895,"_3064":50942},[],"Professional",{"_3608":82,"_31023":63,"_21483":50944,"_5":14766,"_28210":50895,"_3064":50945},[],"Up to 10,000",{"_3608":83,"_31023":63,"_21483":50947,"_5":14766,"_28210":50895,"_3064":50948},[],"Email and chat",{"_3608":84,"_31023":63,"_21483":50950,"_5":14766,"_28210":50895,"_3064":50951},[],"99.9 %",{"_3608":85,"_31023":63,"_21483":50953,"_5":14766,"_28210":50895,"_3064":50954},[],"Enterprise",{"_3608":86,"_31023":63,"_21483":50956,"_5":14766,"_28210":50895,"_3064":50957},[],"Unlimited",{"_3608":87,"_31023":63,"_21483":50959,"_5":14766,"_28210":50895,"_3064":50960},[],"Dedicated",{"_3608":88,"_31023":63,"_21483":50962,"_5":14766,"_28210":50895,"_3064":50963},[],"99.99 %",{"_3608":89,"_31023":63,"_21483":50965,"_5":14766,"_28210":50899,"_3064":50966},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3608":90,"_31023":63,"_21483":50968,"_5":14766,"_28210":50899,"_3064":50969},[],"When you receive your instance's credentials, continue with Get started.",{"_3608":91,"_31023":91,"_5":15126,"_3064":50971,"_31381":50972,"_21483":50973,"_28210":91},"Fastlane",[50727,50728,50834],[],{"_3608":92,"_31023":91,"_21483":50975,"_5":14766,"_28210":91,"_3064":50976},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3608":93,"_31023":91,"_5":31378,"_21483":50978,"_28210":50979,"_3064":50980},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3608":94,"_31023":91,"_5":31378,"_21483":50982,"_28210":50983,"_3064":50984},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3608":95,"_31023":91,"_5":31378,"_21483":50986,"_28210":50987,"_3064":50737},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#before-you-begin",{"_3608":96,"_31023":91,"_5":31378,"_21483":50989,"_28210":50990,"_3064":50991},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3608":97,"_31023":91,"_5":31378,"_21483":50993,"_28210":50994,"_3064":50995},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3608":98,"_31023":91,"_5":31378,"_21483":50997,"_28210":50998,"_3064":50999},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3608":99,"_31023":91,"_5":31378,"_21483":51001,"_28210":51002,"_3064":51003},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3608":100,"_31023":91,"_5":31378,"_21483":51005,"_28210":51006,"_3064":51007},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3608":101,"_31023":91,"_5":31378,"_21483":51009,"_28210":51010,"_3064":51011},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3608":102,"_31023":91,"_5":31378,"_21483":51013,"_28210":51014,"_3064":51015},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3608":103,"_31023":91,"_5":31378,"_21483":51017,"_28210":51018,"_3064":51019},[],"/docs/pr-preview/pr-72/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3608":104,"_31023":91,"_21483":51021,"_5":14766,"_28210":50979,"_3064":51022},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3608":105,"_31023":91,"_21483":51024,"_5":14766,"_28210":50979,"_3064":51025},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3608":106,"_31023":91,"_21483":51027,"_5":14766,"_28210":50983,"_3064":51028},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3608":107,"_31023":91,"_21483":51030,"_5":14766,"_28210":50983,"_3064":51031},[],"Fastlane installs or configures",{"_3608":108,"_31023":91,"_21483":51033,"_5":14766,"_28210":50983,"_3064":51034},[],"You still provide",{"_3608":109,"_31023":91,"_21483":51036,"_5":14766,"_28210":50983,"_3064":51037},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3608":110,"_31023":91,"_21483":51039,"_5":14766,"_28210":50983,"_3064":51040},[],"The Kubernetes cluster, nodes and persistent storage",{"_3608":111,"_31023":91,"_21483":51042,"_5":14766,"_28210":50983,"_3064":51043},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3608":112,"_31023":91,"_21483":51045,"_5":14766,"_28210":50983,"_3064":51046},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3608":113,"_31023":91,"_21483":51048,"_5":14766,"_28210":50983,"_3064":51049},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3608":114,"_31023":91,"_21483":51051,"_5":14766,"_28210":50983,"_3064":51052},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3608":115,"_31023":91,"_21483":51054,"_5":14766,"_28210":50983,"_3064":51055},[],"Optional observability and lab HSM components",{"_3608":116,"_31023":91,"_21483":51057,"_5":14766,"_28210":50983,"_3064":51058},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3608":117,"_31023":91,"_21483":51060,"_5":14766,"_28210":50983,"_3064":51061},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3608":118,"_31023":91,"_21483":51063,"_5":14766,"_28210":50987,"_3064":51064},[],"You need:",{"_3608":119,"_31023":91,"_21483":51066,"_5":14766,"_28210":50987,"_3064":51067},[],"an existing Kubernetes cluster",{"_3608":120,"_31023":91,"_21483":51069,"_5":14766,"_28210":50987,"_3064":51070},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3608":121,"_31023":91,"_21483":51072,"_5":14766,"_28210":50987,"_3064":51073},[],"`yq`",{"_3608":122,"_31023":91,"_21483":51075,"_5":14766,"_28210":50987,"_3064":24284},[],{"_3608":123,"_31023":91,"_21483":51077,"_5":14766,"_28210":50987,"_3064":51078},[],"`jq` only when using `--sample-data` or `--development`",{"_3608":124,"_31023":91,"_21483":51080,"_5":14766,"_28210":50987,"_3064":51081},[],"`ssh-keygen` only when using `--with-hsm`",{"_3608":125,"_31023":91,"_21483":51083,"_5":14766,"_28210":50987,"_3064":51084},[],"free external ports 80 and 443 on a single-node K3s host",{"_3608":126,"_31023":91,"_21483":51086,"_5":14766,"_28210":50987,"_3064":51087},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3608":127,"_31023":91,"_21483":51089,"_5":14766,"_28210":50987,"_3064":51090},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3608":128,"_31023":91,"_21483":51092,"_5":14766,"_28210":50990,"_3064":51093},[],"Run the script from a clone of the Helm repository:",{"_3608":129,"_31023":91,"_21483":51095,"_5":14766,"_28210":50990,"_3064":51096},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3608":130,"_31023":91,"_21483":51098,"_5":14766,"_28210":50994,"_3064":51099},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3608":131,"_31023":91,"_21483":51101,"_5":14766,"_28210":50994,"_3064":51102},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3608":132,"_31023":91,"_21483":51104,"_5":14766,"_28210":50994,"_3064":51105},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3608":133,"_31023":91,"_21483":51107,"_5":14766,"_28210":50994,"_3064":51108},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3608":134,"_31023":91,"_21483":51110,"_5":14766,"_28210":50998,"_3064":51111},[],"Option",{"_3608":135,"_31023":91,"_21483":51113,"_5":14766,"_28210":50998,"_3064":51114},[],"Default",{"_3608":136,"_31023":91,"_21483":51116,"_5":14766,"_28210":50998,"_3064":51117},[],"Purpose",{"_3608":137,"_31023":91,"_21483":51119,"_5":14766,"_28210":50998,"_3064":51120},[],"`-h`, `--help`",{"_3608":138,"_31023":91,"_21483":51122,"_5":14766,"_28210":50998,"_3064":51123},[],"—",{"_3608":139,"_31023":91,"_21483":51125,"_5":14766,"_28210":50998,"_3064":51126},[],"Show help",{"_3608":140,"_31023":91,"_21483":51128,"_5":14766,"_28210":50998,"_3064":51129},[],"`-c`, `--context`",{"_3608":141,"_31023":91,"_21483":51131,"_5":14766,"_28210":50998,"_3064":51132},[],"current context",{"_3608":142,"_31023":91,"_21483":51134,"_5":14766,"_28210":50998,"_3064":51135},[],"Select the kubeconfig context for kubectl and Helm",{"_3608":143,"_31023":91,"_21483":51137,"_5":14766,"_28210":50998,"_3064":51138},[],"`-n`, `--non-interactive`",{"_3608":144,"_31023":91,"_21483":51140,"_5":14766,"_28210":50998,"_3064":6767},[],{"_3608":145,"_31023":91,"_21483":51142,"_5":14766,"_28210":50998,"_3064":51143},[],"Skip prompts and generate dependency credentials",{"_3608":146,"_31023":91,"_21483":51145,"_5":14766,"_28210":50998,"_3064":51146},[],"`-ns`, `--namespace`",{"_3608":147,"_31023":91,"_21483":51148,"_5":14766,"_28210":50998,"_3064":51149},[],"`lamassu-dev`",{"_3608":148,"_31023":91,"_21483":51151,"_5":14766,"_28210":50998,"_3064":51152},[],"Namespace for the installation",{"_3608":149,"_31023":91,"_21483":51154,"_5":14766,"_28210":50998,"_3064":51155},[],"`-d`, `--domain`",{"_3608":150,"_31023":91,"_21483":51157,"_5":14766,"_28210":50998,"_3064":51158},[],"`dev.lamassu.io`",{"_3608":151,"_31023":91,"_21483":51160,"_5":14766,"_28210":50998,"_3064":51161},[],"Domain used by the UI, OIDC and certificate",{"_3608":152,"_31023":91,"_21483":51163,"_5":14766,"_28210":50998,"_3064":51164},[],"`-v`, `--version`",{"_3608":153,"_31023":91,"_21483":51166,"_5":14766,"_28210":50998,"_3064":15477},[],{"_3608":154,"_31023":91,"_21483":51168,"_5":14766,"_28210":50998,"_3064":51169},[],"Lamassu chart version",{"_3608":155,"_31023":91,"_21483":51171,"_5":14766,"_28210":50998,"_3064":51172},[],"`--https-port`",{"_3608":156,"_31023":91,"_21483":51174,"_5":14766,"_28210":50998,"_3064":51175},[],"`443`",{"_3608":157,"_31023":91,"_21483":51177,"_5":14766,"_28210":50998,"_3064":51178},[],"Gateway HTTPS listener port",{"_3608":158,"_31023":91,"_21483":51180,"_5":14766,"_28210":50998,"_3064":51181},[],"`--http-port`",{"_3608":159,"_31023":91,"_21483":51183,"_5":14766,"_28210":50998,"_3064":51184},[],"`80`",{"_3608":160,"_31023":91,"_21483":51186,"_5":14766,"_28210":50998,"_3064":51187},[],"Gateway HTTP listener port",{"_3608":161,"_31023":91,"_21483":51189,"_5":14766,"_28210":50998,"_3064":51190},[],"`--tls-crt`",{"_3608":162,"_31023":91,"_21483":51192,"_5":14766,"_28210":50998,"_3064":51123},[],{"_3608":163,"_31023":91,"_21483":51194,"_5":14766,"_28210":50998,"_3064":51195},[],"PEM certificate for downstream TLS",{"_3608":164,"_31023":91,"_21483":51197,"_5":14766,"_28210":50998,"_3064":51198},[],"`--tls-key`",{"_3608":165,"_31023":91,"_21483":51200,"_5":14766,"_28210":50998,"_3064":51123},[],{"_3608":166,"_31023":91,"_21483":51202,"_5":14766,"_28210":50998,"_3064":51203},[],"PEM private key for downstream TLS",{"_3608":167,"_31023":91,"_21483":51205,"_5":14766,"_28210":50998,"_3064":51206},[],"`-l`, `--local-chart-path`",{"_3608":168,"_31023":91,"_21483":51208,"_5":14766,"_28210":50998,"_3064":51209},[],"repository chart",{"_3608":169,"_31023":91,"_21483":51211,"_5":14766,"_28210":50998,"_3064":51212},[],"Use an unpacked local Lamassu chart",{"_3608":170,"_31023":91,"_21483":51214,"_5":14766,"_28210":50998,"_3064":51215},[],"`-ip`, `--gateway-ip`",{"_3608":171,"_31023":91,"_21483":51217,"_5":14766,"_28210":50998,"_3064":9037},[],{"_3608":172,"_31023":91,"_21483":51219,"_5":14766,"_28210":50998,"_3064":51220},[],"Override the address written to `gateway.addresses`",{"_3608":173,"_31023":91,"_21483":51222,"_5":14766,"_28210":50998,"_3064":51223},[],"`--otel`",{"_3608":174,"_31023":91,"_21483":51225,"_5":14766,"_28210":50998,"_3064":6767},[],{"_3608":175,"_31023":91,"_21483":51227,"_5":14766,"_28210":50998,"_3064":51228},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3608":176,"_31023":91,"_21483":51230,"_5":14766,"_28210":50998,"_3064":51231},[],"`--development`",{"_3608":177,"_31023":91,"_21483":51233,"_5":14766,"_28210":50998,"_3064":6767},[],{"_3608":178,"_31023":91,"_21483":51235,"_5":14766,"_28210":50998,"_3064":51236},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3608":179,"_31023":91,"_21483":51238,"_5":14766,"_28210":50998,"_3064":51239},[],"`--sample-data`",{"_3608":180,"_31023":91,"_21483":51241,"_5":14766,"_28210":50998,"_3064":6767},[],{"_3608":181,"_31023":91,"_21483":51243,"_5":14766,"_28210":50998,"_3064":51244},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3608":182,"_31023":91,"_21483":51246,"_5":14766,"_28210":50998,"_3064":51247},[],"`--with-hsm`",{"_3608":183,"_31023":91,"_21483":51249,"_5":14766,"_28210":50998,"_3064":6767},[],{"_3608":184,"_31023":91,"_21483":51251,"_5":14766,"_28210":50998,"_3064":51252},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3608":185,"_31023":91,"_21483":51254,"_5":14766,"_28210":50998,"_3064":51255},[],"`--softhsm-chart-path`",{"_3608":186,"_31023":91,"_21483":51257,"_5":14766,"_28210":50998,"_3064":51258},[],"`./charts/softhsm`",{"_3608":187,"_31023":91,"_21483":51260,"_5":14766,"_28210":50998,"_3064":51261},[],"Use a different local SoftHSM chart",{"_3608":188,"_31023":91,"_21483":51263,"_5":14766,"_28210":50998,"_3064":51264},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3608":189,"_31023":91,"_21483":51266,"_5":14766,"_28210":51002,"_3064":51267},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3608":190,"_31023":91,"_21483":51269,"_5":14766,"_28210":51002,"_3064":51270},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3608":191,"_31023":91,"_21483":51272,"_5":14766,"_28210":51002,"_3064":51273},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3608":192,"_31023":91,"_21483":51275,"_5":14766,"_28210":51002,"_3064":51276},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3608":193,"_31023":91,"_21483":51278,"_5":14766,"_28210":51002,"_3064":51279},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3608":194,"_31023":91,"_21483":51281,"_5":14766,"_28210":51002,"_3064":51282},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3608":195,"_31023":91,"_21483":51284,"_5":14766,"_28210":51006,"_3064":51285},[],"Fastlane:",{"_3608":196,"_31023":91,"_21483":51287,"_5":14766,"_28210":51006,"_3064":51288},[],"validates local tools and the selected cluster",{"_3608":197,"_31023":91,"_21483":51290,"_5":14766,"_28210":51006,"_3064":51291},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3608":198,"_31023":91,"_21483":51293,"_5":14766,"_28210":51006,"_3064":51294},[],"creates the namespace",{"_3608":199,"_31023":91,"_21483":51296,"_5":14766,"_28210":51006,"_3064":51297},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3608":200,"_31023":91,"_21483":51299,"_5":14766,"_28210":51006,"_3064":51300},[],"installs PostgreSQL and creates the required databases",{"_3608":201,"_31023":91,"_21483":51302,"_5":14766,"_28210":51006,"_3064":51303},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3608":202,"_31023":91,"_21483":51305,"_5":14766,"_28210":51006,"_3064":51306},[],"installs RabbitMQ",{"_3608":203,"_31023":91,"_21483":51308,"_5":14766,"_28210":51006,"_3064":51309},[],"optionally installs observability and lab HSM components",{"_3608":204,"_31023":91,"_21483":51311,"_5":14766,"_28210":51006,"_3064":51312},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3608":205,"_31023":91,"_21483":51314,"_5":14766,"_28210":51006,"_3064":51315},[],"optionally loads sample data",{"_3608":206,"_31023":91,"_21483":51317,"_5":14766,"_28210":51006,"_3064":51318},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3608":207,"_31023":91,"_21483":51320,"_5":14766,"_28210":51010,"_3064":51321},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3608":208,"_31023":91,"_21483":51323,"_5":14766,"_28210":51010,"_3064":51324},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3608":209,"_31023":91,"_21483":51326,"_5":14766,"_28210":51014,"_3064":51327},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3608":210,"_31023":91,"_21483":51329,"_5":14766,"_28210":51014,"_3064":51330},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3608":211,"_31023":91,"_21483":51332,"_5":14766,"_28210":51014,"_3064":51333},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3608":212,"_31023":91,"_21483":51335,"_5":14766,"_28210":51014,"_3064":51336},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3608":213,"_31023":91,"_21483":51338,"_5":14766,"_28210":51018,"_3064":51339},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3608":214,"_31023":214,"_5":15126,"_3064":51341,"_31381":51342,"_21483":51343,"_28210":214},"Install with Helm",[50727,50728,50834],[],{"_3608":215,"_31023":214,"_21483":51345,"_5":14766,"_28210":214,"_3064":51346},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3608":216,"_31023":214,"_5":31378,"_21483":51348,"_28210":51349,"_3064":51350},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3608":217,"_31023":214,"_5":31378,"_21483":51352,"_28210":51353,"_3064":50737},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#before-you-begin",{"_3608":218,"_31023":214,"_5":31378,"_21483":51355,"_28210":51356,"_3064":51357},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3608":219,"_31023":214,"_5":31378,"_21483":51359,"_28210":51360,"_3064":51361},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3608":220,"_31023":214,"_5":31378,"_21483":51363,"_28210":51364,"_3064":51365},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3608":221,"_31023":214,"_5":31378,"_21483":51367,"_28210":51368,"_3064":51369},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3608":222,"_31023":214,"_5":31378,"_21483":51371,"_28210":51372,"_3064":51373},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3608":223,"_31023":214,"_5":31378,"_21483":51375,"_28210":51376,"_3064":51377},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3608":224,"_31023":214,"_5":31378,"_21483":51379,"_28210":51380,"_3064":51381},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3608":225,"_31023":214,"_5":31378,"_21483":51383,"_28210":51384,"_3064":51385},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3608":226,"_31023":214,"_5":31378,"_21483":51387,"_28210":51388,"_3064":51389},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3608":227,"_31023":214,"_5":31378,"_21483":51391,"_28210":51392,"_3064":51393},[],"/docs/pr-preview/pr-72/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3608":228,"_31023":214,"_21483":51395,"_5":14766,"_28210":51349,"_3064":51396},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3608":229,"_31023":214,"_21483":51398,"_5":14766,"_28210":51353,"_3064":51399},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3608":230,"_31023":214,"_21483":51401,"_5":14766,"_28210":51353,"_3064":51402},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3608":231,"_31023":214,"_21483":51404,"_5":14766,"_28210":51353,"_3064":51405},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3608":232,"_31023":214,"_21483":51407,"_5":14766,"_28210":51353,"_3064":51408},[],"a reachable RabbitMQ broker and credentials",{"_3608":233,"_31023":214,"_21483":51410,"_5":14766,"_28210":51353,"_3064":51411},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3608":234,"_31023":214,"_21483":51413,"_5":14766,"_28210":51353,"_3064":51414},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3608":235,"_31023":214,"_21483":51416,"_5":14766,"_28210":51353,"_3064":51417},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3608":236,"_31023":214,"_21483":51419,"_5":14766,"_28210":51353,"_3064":51420},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3608":237,"_31023":214,"_21483":51422,"_5":14766,"_28210":51353,"_3064":51423},[],"a StorageClass and an external traffic design",{"_3608":238,"_31023":214,"_21483":51425,"_5":14766,"_28210":51353,"_3064":51426},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3608":239,"_31023":214,"_21483":51428,"_5":14766,"_28210":51353,"_3064":51429},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3608":240,"_31023":214,"_21483":51431,"_5":14766,"_28210":51353,"_3064":51432},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3608":241,"_31023":214,"_21483":51434,"_5":14766,"_28210":51356,"_3064":51435},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3608":242,"_31023":214,"_21483":51437,"_5":14766,"_28210":51356,"_3064":51438},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3608":243,"_31023":214,"_21483":51440,"_5":14766,"_28210":51356,"_3064":51441},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3608":244,"_31023":214,"_21483":51443,"_5":14766,"_28210":51360,"_3064":51444},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3608":245,"_31023":214,"_21483":51446,"_5":14766,"_28210":51360,"_3064":51447},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3608":246,"_31023":214,"_21483":51449,"_5":14766,"_28210":51360,"_3064":51450},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3608":247,"_31023":214,"_21483":51452,"_5":14766,"_28210":51360,"_3064":51453},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3608":248,"_31023":214,"_21483":51455,"_5":14766,"_28210":51364,"_3064":51456},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3608":249,"_31023":214,"_21483":51458,"_5":14766,"_28210":51364,"_3064":51459},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3608":250,"_31023":214,"_21483":51461,"_5":14766,"_28210":51364,"_3064":51462},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3608":251,"_31023":214,"_21483":51464,"_5":14766,"_28210":51364,"_3064":51465},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3608":252,"_31023":214,"_21483":51467,"_5":14766,"_28210":51364,"_3064":51468},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3608":253,"_31023":214,"_21483":51470,"_5":14766,"_28210":51364,"_3064":51471},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3608":254,"_31023":214,"_21483":51473,"_5":14766,"_28210":51364,"_3064":51474},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3608":255,"_31023":214,"_21483":51476,"_5":14766,"_28210":51364,"_3064":51477},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3608":256,"_31023":214,"_21483":51479,"_5":14766,"_28210":51368,"_3064":51480},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3608":257,"_31023":214,"_21483":51482,"_5":14766,"_28210":51372,"_3064":51483},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3608":258,"_31023":214,"_21483":51485,"_5":14766,"_28210":51372,"_3064":51486},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3608":259,"_31023":214,"_21483":51488,"_5":14766,"_28210":51372,"_3064":51489},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3608":260,"_31023":214,"_21483":51491,"_5":14766,"_28210":51372,"_3064":51492},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3608":261,"_31023":214,"_21483":51494,"_5":14766,"_28210":51372,"_3064":51495},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3608":262,"_31023":214,"_21483":51497,"_5":14766,"_28210":51372,"_3064":51498},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3608":263,"_31023":214,"_21483":51500,"_5":14766,"_28210":51372,"_3064":51501},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3608":264,"_31023":214,"_21483":51503,"_5":14766,"_28210":51376,"_3064":51504},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3608":265,"_31023":214,"_21483":51506,"_5":14766,"_28210":51376,"_3064":51507},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3608":266,"_31023":214,"_21483":51509,"_5":14766,"_28210":51376,"_3064":51510},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3608":267,"_31023":214,"_21483":51512,"_5":14766,"_28210":51376,"_3064":51513},[],"See Access control for the principal and policy model.",{"_3608":268,"_31023":214,"_21483":51515,"_5":14766,"_28210":51380,"_3064":51516},[],"To install a local checkout instead:",{"_3608":269,"_31023":214,"_21483":51518,"_5":14766,"_28210":51384,"_3064":51519},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3608":270,"_31023":214,"_21483":51521,"_5":14766,"_28210":51384,"_3064":51522},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3608":271,"_31023":214,"_21483":51524,"_5":14766,"_28210":51388,"_3064":51525},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3608":272,"_31023":214,"_21483":51527,"_5":14766,"_28210":51388,"_3064":51528},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3608":273,"_31023":214,"_21483":51530,"_5":14766,"_28210":51388,"_3064":51531},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3608":274,"_31023":214,"_21483":51533,"_5":14766,"_28210":51388,"_3064":51534},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3608":275,"_31023":214,"_21483":51536,"_5":14766,"_28210":51388,"_3064":51537},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3608":276,"_31023":214,"_21483":51539,"_5":14766,"_28210":51392,"_3064":51540},[],"Before going live, review:",{"_3608":277,"_31023":214,"_21483":51542,"_5":14766,"_28210":51392,"_3064":51543},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3608":278,"_31023":214,"_21483":51545,"_5":14766,"_28210":51392,"_3064":51546},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3608":279,"_31023":214,"_21483":51548,"_5":14766,"_28210":51392,"_3064":51549},[],"shared VA storage before increasing VA replicas",{"_3608":280,"_31023":214,"_21483":51551,"_5":14766,"_28210":51392,"_3064":51552},[],"managed OIDC roles and removal of evaluation credentials",{"_3608":281,"_31023":214,"_21483":51554,"_5":14766,"_28210":51392,"_3064":51555},[],"a trusted TLS issuer or externally managed certificate",{"_3608":282,"_31023":214,"_21483":51557,"_5":14766,"_28210":51392,"_3064":51558},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3608":283,"_31023":214,"_21483":51560,"_5":14766,"_28210":51392,"_3064":51561},[],"SMTP, observability and alert delivery",{"_3608":284,"_31023":214,"_21483":51563,"_5":14766,"_28210":51392,"_3064":51564},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3608":285,"_31023":214,"_21483":51566,"_5":14766,"_28210":51392,"_3064":51567},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3608":286,"_31023":286,"_5":15126,"_3064":51569,"_31381":51570,"_21483":51571,"_28210":286},"Expose the Gateway",[50727,50728,50834],[],{"_3608":287,"_31023":286,"_21483":51573,"_5":14766,"_28210":286,"_3064":51574},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3608":288,"_31023":286,"_5":31378,"_21483":51576,"_28210":51577,"_3064":51578},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3608":289,"_31023":286,"_5":31378,"_21483":51580,"_28210":51581,"_3064":51582},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3608":290,"_31023":286,"_5":31378,"_21483":51584,"_28210":51585,"_3064":51586},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3608":291,"_31023":286,"_5":31378,"_21483":51588,"_28210":51589,"_3064":51590},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#k3s","K3s",{"_3608":292,"_31023":286,"_5":31378,"_21483":51592,"_28210":51593,"_3064":51594},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3608":293,"_31023":286,"_5":31378,"_21483":51596,"_28210":51597,"_3064":51598},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3608":294,"_31023":286,"_5":31378,"_21483":51600,"_28210":51601,"_3064":51602},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3608":295,"_31023":286,"_5":31378,"_21483":51604,"_28210":51605,"_3064":51606},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3608":296,"_31023":286,"_5":31378,"_21483":51608,"_28210":51609,"_3064":51610},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3608":297,"_31023":286,"_5":31378,"_21483":51612,"_28210":51613,"_3064":51614},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3608":298,"_31023":286,"_5":31378,"_21483":51616,"_28210":51617,"_3064":51618},[],"/docs/pr-preview/pr-72/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3608":299,"_31023":286,"_21483":51620,"_5":14766,"_28210":51577,"_3064":51621},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3608":300,"_31023":286,"_21483":51623,"_5":14766,"_28210":51577,"_3064":51624},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3608":301,"_31023":286,"_21483":51626,"_5":14766,"_28210":51581,"_3064":51627},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3608":302,"_31023":286,"_21483":51629,"_5":14766,"_28210":51581,"_3064":51630},[],"Set it only when:",{"_3608":303,"_31023":286,"_21483":51632,"_5":14766,"_28210":51581,"_3064":51633},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3608":304,"_31023":286,"_21483":51635,"_5":14766,"_28210":51581,"_3064":51636},[],"that address is allocated to this Gateway",{"_3608":305,"_31023":286,"_21483":51638,"_5":14766,"_28210":51581,"_3064":51639},[],"the surrounding network already routes traffic for it to the cluster",{"_3608":306,"_31023":286,"_21483":51641,"_5":14766,"_28210":51581,"_3064":51642},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3608":307,"_31023":286,"_21483":51644,"_5":14766,"_28210":51581,"_3064":51645},[],"Keep these two settings separate:",{"_3608":308,"_31023":286,"_21483":51647,"_5":14766,"_28210":51581,"_3064":51648},[],"`gateway.addresses` requests an address for the Gateway.",{"_3608":309,"_31023":286,"_21483":51650,"_5":14766,"_28210":51581,"_3064":51651},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3608":310,"_31023":286,"_21483":51653,"_5":14766,"_28210":51581,"_3064":51654},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3608":311,"_31023":286,"_21483":51656,"_5":14766,"_28210":51585,"_3064":51657},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3608":312,"_31023":286,"_21483":51659,"_5":14766,"_28210":51585,"_3064":51660},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3608":313,"_31023":286,"_21483":51662,"_5":14766,"_28210":51589,"_3064":51663},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3608":314,"_31023":286,"_21483":51665,"_5":14766,"_28210":51589,"_3064":51666},[],"For the recommended design:",{"_3608":315,"_31023":286,"_21483":51668,"_5":14766,"_28210":51589,"_3064":51669},[],"Use only one externally exposed Lamassu Gateway.",{"_3608":316,"_31023":286,"_21483":51671,"_5":14766,"_28210":51589,"_3064":51672},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3608":317,"_31023":286,"_21483":51674,"_5":14766,"_28210":51589,"_3064":51675},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3608":318,"_31023":286,"_21483":51677,"_5":14766,"_28210":51589,"_3064":51678},[],"Point DNS at the VM's reachable address.",{"_3608":319,"_31023":286,"_21483":51680,"_5":14766,"_28210":51589,"_3064":51681},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3608":320,"_31023":286,"_21483":51683,"_5":14766,"_28210":51593,"_3064":51684},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3608":321,"_31023":286,"_21483":51686,"_5":14766,"_28210":51597,"_3064":51687},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3608":322,"_31023":286,"_21483":51689,"_5":14766,"_28210":51597,"_3064":51690},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3608":323,"_31023":286,"_21483":51692,"_5":14766,"_28210":51601,"_3064":51693},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3608":324,"_31023":286,"_21483":51695,"_5":14766,"_28210":51601,"_3064":51696},[],"Requirement",{"_3608":325,"_31023":286,"_21483":51698,"_5":14766,"_28210":51601,"_3064":51699},[],"Recommended design",{"_3608":326,"_31023":286,"_21483":51701,"_5":14766,"_28210":51601,"_3064":51702},[],"Consequence",{"_3608":327,"_31023":286,"_21483":51704,"_5":14766,"_28210":51601,"_3064":51705},[],"Several Lamassu URLs or services",{"_3608":328,"_31023":286,"_21483":51707,"_5":14766,"_28210":51601,"_3064":51708},[],"One Gateway with multiple routes",{"_3608":329,"_31023":286,"_21483":51710,"_5":14766,"_28210":51601,"_3064":51711},[],"One IP and one proxy fleet; this is the chart default",{"_3608":330,"_31023":286,"_21483":51713,"_5":14766,"_28210":51601,"_3064":51714},[],"Independent Gateways and separate external IPs",{"_3608":331,"_31023":286,"_21483":51716,"_5":14766,"_28210":51601,"_3064":51717},[],"One VIP per Gateway",{"_3608":332,"_31023":286,"_21483":51719,"_5":14766,"_28210":51601,"_3064":51720},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3608":333,"_31023":286,"_21483":51722,"_5":14766,"_28210":51601,"_3064":51723},[],"Independent Gateways on one node and one IP",{"_3608":334,"_31023":286,"_21483":51725,"_5":14766,"_28210":51601,"_3064":51726},[],"Use different external ports",{"_3608":335,"_31023":286,"_21483":51728,"_5":14766,"_28210":51601,"_3064":51729},[],"Clients must include non-standard ports",{"_3608":336,"_31023":286,"_21483":51731,"_5":14766,"_28210":51601,"_3064":51732},[],"Separate TLS/mTLS termination behind one IP",{"_3608":337,"_31023":286,"_21483":51734,"_5":14766,"_28210":51601,"_3064":51735},[],"Front-door SNI routing to internal Gateways",{"_3608":338,"_31023":286,"_21483":51737,"_5":14766,"_28210":51601,"_3064":51738},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3608":339,"_31023":286,"_21483":51740,"_5":14766,"_28210":51601,"_3064":51741},[],"Separate Gateway resources but shared proxy infrastructure",{"_3608":340,"_31023":286,"_21483":51743,"_5":14766,"_28210":51601,"_3064":51744},[],"Envoy merged-Gateway mode",{"_3608":341,"_31023":286,"_21483":51746,"_5":14766,"_28210":51601,"_3064":51747},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3608":342,"_31023":286,"_21483":51749,"_5":14766,"_28210":51601,"_3064":51750},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3608":343,"_31023":286,"_21483":51752,"_5":14766,"_28210":51601,"_3064":51753},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3608":344,"_31023":286,"_21483":51755,"_5":14766,"_28210":51601,"_3064":51756},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3608":345,"_31023":286,"_21483":51758,"_5":14766,"_28210":51601,"_3064":51759},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3608":346,"_31023":286,"_21483":51761,"_5":14766,"_28210":51605,"_3064":51762},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3608":347,"_31023":286,"_21483":51764,"_5":14766,"_28210":51609,"_3064":51765},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3608":348,"_31023":286,"_21483":51767,"_5":14766,"_28210":51609,"_3064":51768},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3608":349,"_31023":286,"_21483":51770,"_5":14766,"_28210":51609,"_3064":51771},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3608":350,"_31023":286,"_21483":51773,"_5":14766,"_28210":51609,"_3064":51774},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3608":351,"_31023":286,"_21483":51776,"_5":14766,"_28210":51609,"_3064":51777},[],"If none of those are possible, use different external ports or change the external network design.",{"_3608":352,"_31023":286,"_21483":51779,"_5":14766,"_28210":51613,"_3064":51780},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3608":353,"_31023":286,"_21483":51782,"_5":14766,"_28210":51613,"_3064":51783},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3608":354,"_31023":286,"_21483":51785,"_5":14766,"_28210":51617,"_3064":51786},[],"Check, in order:",{"_3608":355,"_31023":286,"_21483":51788,"_5":14766,"_28210":51617,"_3064":51789},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3608":356,"_31023":286,"_21483":51791,"_5":14766,"_28210":51617,"_3064":51792},[],"Its status contains the expected address.",{"_3608":357,"_31023":286,"_21483":51794,"_5":14766,"_28210":51617,"_3064":51795},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3608":358,"_31023":286,"_21483":51797,"_5":14766,"_28210":51617,"_3064":51798},[],"Port 443 reaches that address from the client network.",{"_3608":359,"_31023":286,"_21483":51800,"_5":14766,"_28210":51617,"_3064":51801},[],"DNS resolves to the externally reachable endpoint.",{"_3608":360,"_31023":286,"_21483":51803,"_5":14766,"_28210":51617,"_3064":51804},[],"The certificate contains the DNS name or IP used by the client.",{"_3608":361,"_31023":286,"_21483":51806,"_5":14766,"_28210":51617,"_3064":51807},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3608":362,"_31023":362,"_5":15126,"_3064":50834,"_31381":51809,"_21483":51810,"_28210":362},[50727,50728,50834],[],{"_3608":363,"_31023":362,"_21483":51812,"_5":14766,"_28210":362,"_3064":51813},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3608":364,"_31023":362,"_5":31378,"_21483":51815,"_28210":51816,"_3064":51817},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3608":365,"_31023":362,"_5":31378,"_21483":51819,"_28210":51820,"_3064":51821},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3608":366,"_31023":362,"_5":31378,"_21483":51823,"_28210":51824,"_3064":51825},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3608":367,"_31023":362,"_5":31378,"_21483":51827,"_28210":51828,"_3064":51829},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3608":368,"_31023":362,"_5":31378,"_21483":51831,"_28210":51832,"_3064":51833},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3608":369,"_31023":362,"_5":31378,"_21483":51835,"_28210":51836,"_3064":51837},[],"/docs/pr-preview/pr-72/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3608":370,"_31023":362,"_21483":51839,"_5":14766,"_28210":51816,"_3064":51840},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3608":371,"_31023":362,"_21483":51842,"_5":14766,"_28210":51820,"_3064":51843},[],"Workflow",{"_3608":372,"_31023":362,"_21483":51845,"_5":14766,"_28210":51820,"_3064":51846},[],"Use it for",{"_3608":373,"_31023":362,"_21483":51848,"_5":14766,"_28210":51820,"_3064":51849},[],"What it installs",{"_3608":374,"_31023":362,"_21483":51851,"_5":14766,"_28210":51820,"_3064":51852},[],"Helm",{"_3608":375,"_31023":362,"_21483":51854,"_5":14766,"_28210":51820,"_3064":51855},[],"Production and controlled environments",{"_3608":376,"_31023":362,"_21483":51857,"_5":14766,"_28210":51820,"_3064":51858},[],"Lamassu services and Gateway API resources",{"_3608":377,"_31023":362,"_21483":51860,"_5":14766,"_28210":51820,"_3064":50971},[],{"_3608":378,"_31023":362,"_21483":51862,"_5":14766,"_28210":51820,"_3064":51863},[],"Evaluation, demos, CI and small lab clusters",{"_3608":379,"_31023":362,"_21483":51865,"_5":14766,"_28210":51820,"_3064":51866},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3608":380,"_31023":362,"_21483":51868,"_5":14766,"_28210":51824,"_3064":51869},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3608":381,"_31023":362,"_21483":51871,"_5":14766,"_28210":51824,"_3064":51872},[],"Area",{"_3608":382,"_31023":362,"_21483":51874,"_5":14766,"_28210":51824,"_3064":51875},[],"The Lamassu chart provides",{"_3608":383,"_31023":362,"_21483":51877,"_5":14766,"_28210":51824,"_3064":51878},[],"You provide",{"_3608":384,"_31023":362,"_21483":51880,"_5":14766,"_28210":51824,"_3064":51881},[],"Lamassu applications",{"_3608":385,"_31023":362,"_21483":51883,"_5":14766,"_28210":51824,"_3064":51884},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3608":386,"_31023":362,"_21483":51886,"_5":14766,"_28210":51824,"_3064":51887},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3608":387,"_31023":362,"_21483":51889,"_5":14766,"_28210":51824,"_3064":51890},[],"PostgreSQL data",{"_3608":388,"_31023":362,"_21483":51892,"_5":14766,"_28210":51824,"_3064":51893},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3608":389,"_31023":362,"_21483":51895,"_5":14766,"_28210":51824,"_3064":51896},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3608":390,"_31023":362,"_21483":51898,"_5":14766,"_28210":51824,"_3064":51899},[],"Messaging",{"_3608":391,"_31023":362,"_21483":51901,"_5":14766,"_28210":51824,"_3064":51902},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3608":392,"_31023":362,"_21483":51904,"_5":14766,"_28210":51824,"_3064":51905},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3608":393,"_31023":362,"_21483":51907,"_5":14766,"_28210":51824,"_3064":51908},[],"Identity",{"_3608":394,"_31023":362,"_21483":51910,"_5":14766,"_28210":51824,"_3064":51911},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3608":395,"_31023":362,"_21483":51913,"_5":14766,"_28210":51824,"_3064":51914},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3608":396,"_31023":362,"_21483":51916,"_5":14766,"_28210":51824,"_3064":51917},[],"External routing",{"_3608":397,"_31023":362,"_21483":51919,"_5":14766,"_28210":51824,"_3064":51920},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3608":398,"_31023":362,"_21483":51922,"_5":14766,"_28210":51824,"_3064":51923},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3608":399,"_31023":362,"_21483":51925,"_5":14766,"_28210":51824,"_3064":51926},[],"TLS",{"_3608":400,"_31023":362,"_21483":51928,"_5":14766,"_28210":51824,"_3064":51929},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3608":401,"_31023":362,"_21483":51931,"_5":14766,"_28210":51824,"_3064":51932},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3608":402,"_31023":362,"_21483":51934,"_5":14766,"_28210":51824,"_3064":51935},[],"Persistent application data",{"_3608":403,"_31023":362,"_21483":51937,"_5":14766,"_28210":51824,"_3064":51938},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3608":404,"_31023":362,"_21483":51940,"_5":14766,"_28210":51824,"_3064":51941},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3608":405,"_31023":362,"_21483":51943,"_5":14766,"_28210":51824,"_3064":51944},[],"Optional integrations",{"_3608":406,"_31023":362,"_21483":51946,"_5":14766,"_28210":51824,"_3064":51947},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3608":407,"_31023":362,"_21483":51949,"_5":14766,"_28210":51824,"_3064":51950},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3608":408,"_31023":362,"_21483":51952,"_5":14766,"_28210":51824,"_3064":51953},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3608":409,"_31023":362,"_21483":51955,"_5":14766,"_28210":51824,"_3064":51956},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3608":410,"_31023":362,"_21483":51958,"_5":14766,"_28210":51828,"_3064":51959},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3608":411,"_31023":362,"_21483":51961,"_5":14766,"_28210":51828,"_3064":51962},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3608":412,"_31023":362,"_21483":51964,"_5":14766,"_28210":51832,"_3064":51965},[],"Kubernetes 1.24 or newer",{"_3608":413,"_31023":362,"_21483":51967,"_5":14766,"_28210":51832,"_3064":51968},[],"Helm 3.2 or newer",{"_3608":414,"_31023":362,"_21483":51970,"_5":14766,"_28210":51832,"_3064":51971},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3608":415,"_31023":362,"_21483":51973,"_5":14766,"_28210":51832,"_3064":51974},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3608":416,"_31023":362,"_21483":51976,"_5":14766,"_28210":51832,"_3064":51977},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3608":417,"_31023":362,"_21483":51979,"_5":14766,"_28210":51832,"_3064":51980},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3608":418,"_31023":362,"_21483":51982,"_5":14766,"_28210":51832,"_3064":51983},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3608":419,"_31023":362,"_21483":51985,"_5":14766,"_28210":51836,"_3064":51986},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3608":420,"_31023":362,"_21483":51988,"_5":14766,"_28210":51836,"_3064":51989},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3608":421,"_31023":362,"_21483":51991,"_5":14766,"_28210":51836,"_3064":51992},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3608":422,"_31023":362,"_21483":51994,"_5":14766,"_28210":51836,"_3064":51995},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3608":423,"_31023":423,"_5":15126,"_3064":51997,"_31381":51998,"_21483":52000,"_28210":423},"Deployment troubleshooting",[50727,50728,51999],"Operations",[],{"_3608":424,"_31023":423,"_21483":52002,"_5":14766,"_28210":423,"_3064":52003},[],"Diagnose access, service health and infrastructure dependencies.",{"_3608":425,"_31023":423,"_5":31378,"_21483":52005,"_28210":52006,"_3064":52007},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3608":426,"_31023":423,"_5":31378,"_21483":52009,"_28210":52010,"_3064":52011},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3608":427,"_31023":423,"_5":31378,"_21483":52013,"_28210":52014,"_3064":52015},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3608":428,"_31023":423,"_5":31378,"_21483":52017,"_28210":52018,"_3064":52019},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3608":429,"_31023":423,"_5":31378,"_21483":52021,"_28210":52022,"_3064":52023},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3608":430,"_31023":423,"_5":31378,"_21483":52025,"_28210":52026,"_3064":52027},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3608":431,"_31023":423,"_5":31378,"_21483":52029,"_28210":52030,"_3064":52031},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3608":432,"_31023":423,"_5":31378,"_21483":52033,"_28210":52034,"_3064":52035},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3608":433,"_31023":423,"_5":31378,"_21483":52037,"_28210":52038,"_3064":52039},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3608":434,"_31023":423,"_5":31378,"_21483":52041,"_28210":52042,"_3064":52043},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3608":435,"_31023":423,"_5":31378,"_21483":52045,"_28210":52046,"_3064":52047},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3608":436,"_31023":423,"_5":31378,"_21483":52049,"_28210":52050,"_3064":52051},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3608":437,"_31023":423,"_5":31378,"_21483":52053,"_28210":52054,"_3064":52055},[],"/docs/pr-preview/pr-72/deployment/troubleshooting#observability","Observability",{"_3608":438,"_31023":423,"_21483":52057,"_5":14766,"_28210":423,"_3064":52058},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3608":439,"_31023":423,"_21483":52060,"_5":14766,"_28210":52010,"_3064":52061},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3608":440,"_31023":423,"_21483":52063,"_5":14766,"_28210":52014,"_3064":52064},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3608":441,"_31023":423,"_21483":52066,"_5":14766,"_28210":52018,"_3064":52067},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3608":442,"_31023":423,"_21483":52069,"_5":14766,"_28210":52022,"_3064":52070},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3608":443,"_31023":423,"_21483":52072,"_5":14766,"_28210":52026,"_3064":52073},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3608":444,"_31023":423,"_21483":52075,"_5":14766,"_28210":52030,"_3064":52076},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3608":445,"_31023":423,"_21483":52078,"_5":14766,"_28210":52030,"_3064":52079},[],"Also run the chart's connectivity test:",{"_3608":446,"_31023":423,"_21483":52081,"_5":14766,"_28210":52030,"_3064":52082},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3608":447,"_31023":423,"_21483":52084,"_5":14766,"_28210":52030,"_3064":52085},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3608":448,"_31023":423,"_21483":52087,"_5":14766,"_28210":52034,"_3064":52088},[],"If you receive a 401:",{"_3608":449,"_31023":423,"_21483":52090,"_5":14766,"_28210":52034,"_3064":52091},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3608":450,"_31023":423,"_21483":52093,"_5":14766,"_28210":52034,"_3064":52094},[],"verify issuer, audience and expiration of the token;",{"_3608":451,"_31023":423,"_21483":52096,"_5":14766,"_28210":52034,"_3064":52097},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3608":452,"_31023":423,"_21483":52099,"_5":14766,"_28210":52034,"_3064":52100},[],"check that the provider's public and internal routes point to the same realm.",{"_3608":453,"_31023":423,"_21483":52102,"_5":14766,"_28210":52034,"_3064":52103},[],"If login succeeds but the APIs return 403:",{"_3608":454,"_31023":423,"_21483":52105,"_5":14766,"_28210":52034,"_3064":52106},[],"inspect the token's real claims;",{"_3608":455,"_31023":423,"_21483":52108,"_5":14766,"_28210":52034,"_3064":52109},[],"confirm they match an active principal;",{"_3608":456,"_31023":423,"_21483":52111,"_5":14766,"_28210":52034,"_3064":52112},[],"review the policies granted to that principal;",{"_3608":457,"_31023":423,"_21483":52114,"_5":14766,"_28210":52034,"_3064":52115},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3608":458,"_31023":423,"_21483":52117,"_5":14766,"_28210":52034,"_3064":52118},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3608":459,"_31023":423,"_21483":52120,"_5":14766,"_28210":52038,"_3064":52121},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3608":460,"_31023":423,"_21483":52123,"_5":14766,"_28210":52038,"_3064":52124},[],"Locate the authz pod and Service.",{"_3608":461,"_31023":423,"_21483":52126,"_5":14766,"_28210":52038,"_3064":52127},[],"Check /health, logs and its database connection.",{"_3608":462,"_31023":423,"_21483":52129,"_5":14766,"_28210":52038,"_3064":52130},[],"Verify the DNS and port configured in externalAuthorization.",{"_3608":463,"_31023":423,"_21483":52132,"_5":14766,"_28210":52038,"_3064":52133},[],"Check the check route is /v1/ext\\_authz/check.",{"_3608":464,"_31023":423,"_21483":52135,"_5":14766,"_28210":52038,"_3064":52136},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3608":465,"_31023":423,"_21483":52138,"_5":14766,"_28210":52042,"_3064":52139},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3608":466,"_31023":423,"_21483":52141,"_5":14766,"_28210":52046,"_3064":52142},[],"Review kubectl describe pod first. Common causes are:",{"_3608":467,"_31023":423,"_21483":52144,"_5":14766,"_28210":52046,"_3064":52145},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3608":468,"_31023":423,"_21483":52147,"_5":14766,"_28210":52046,"_3064":52148},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3608":469,"_31023":423,"_21483":52150,"_5":14766,"_28210":52046,"_3064":52151},[],"unbound persistent volume;",{"_3608":470,"_31023":423,"_21483":52153,"_5":14766,"_28210":52046,"_3064":52154},[],"inaccessible image or incorrect pull policy;",{"_3608":471,"_31023":423,"_21483":52156,"_5":14766,"_28210":52046,"_3064":52157},[],"invalid cryptographic engine configuration;",{"_3608":472,"_31023":423,"_21483":52159,"_5":14766,"_28210":52046,"_3064":52160},[],"CPU or memory limits set too low;",{"_3608":473,"_31023":423,"_21483":52162,"_5":14766,"_28210":52046,"_3064":52163},[],"an incomplete prior migration.",{"_3608":474,"_31023":423,"_21483":52165,"_5":14766,"_28210":52046,"_3064":52166},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3608":475,"_31023":423,"_21483":52168,"_5":14766,"_28210":52046,"_3064":52169},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3608":476,"_31023":423,"_21483":52171,"_5":14766,"_28210":52046,"_3064":52172},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3608":477,"_31023":423,"_21483":52174,"_5":14766,"_28210":52050,"_3064":52175},[],"Domain and audit events depend on the bus publisher:",{"_3608":478,"_31023":423,"_21483":52177,"_5":14766,"_28210":52050,"_3064":52178},[],"verify it is enabled in the emitting service;",{"_3608":479,"_31023":423,"_21483":52180,"_5":14766,"_28210":52050,"_3064":52181},[],"check AMQP connectivity and credentials;",{"_3608":480,"_31023":423,"_21483":52183,"_5":14766,"_28210":52050,"_3064":52184},[],"review exchange, routing key, queues and consumers;",{"_3608":481,"_31023":423,"_21483":52186,"_5":14766,"_28210":52050,"_3064":52187},[],"inspect dead-letter queues;",{"_3608":482,"_31023":423,"_21483":52189,"_5":14766,"_28210":52050,"_3064":52190},[],"alert on orphan durable queues and backlog growth.",{"_3608":483,"_31023":423,"_21483":52192,"_5":14766,"_28210":52050,"_3064":52193},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3608":484,"_31023":423,"_21483":52195,"_5":14766,"_28210":52050,"_3064":52196},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3608":485,"_31023":423,"_21483":52198,"_5":14766,"_28210":52050,"_3064":52199},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3608":486,"_31023":423,"_21483":52201,"_5":14766,"_28210":52050,"_3064":52202},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3608":487,"_31023":423,"_21483":52204,"_5":14766,"_28210":52050,"_3064":52205},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3608":488,"_31023":423,"_21483":52207,"_5":14766,"_28210":52050,"_3064":52208},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3608":489,"_31023":423,"_21483":52210,"_5":14766,"_28210":52050,"_3064":52211},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3608":490,"_31023":423,"_21483":52213,"_5":14766,"_28210":52054,"_3064":52214},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3608":491,"_31023":423,"_21483":52216,"_5":14766,"_28210":52054,"_3064":52217},[],"Before closing an incident, record:",{"_3608":492,"_31023":423,"_21483":52219,"_5":14766,"_28210":52054,"_3064":52220},[],"the confirmed cause;",{"_3608":493,"_31023":423,"_21483":52222,"_5":14766,"_28210":52054,"_3064":52223},[],"the time scope and affected resources;",{"_3608":494,"_31023":423,"_21483":52225,"_5":14766,"_28210":52054,"_3064":52226},[],"the commands or queries used;",{"_3608":495,"_31023":423,"_21483":52228,"_5":14766,"_28210":52054,"_3064":52229},[],"the applied change and how to revert it;",{"_3608":496,"_31023":423,"_21483":52231,"_5":14766,"_28210":52054,"_3064":52232},[],"validation from a consumer;",{"_3608":497,"_31023":423,"_21483":52234,"_5":14766,"_28210":52054,"_3064":52235},[],"the preventive action and its owner.",{"_3608":498,"_31023":498,"_5":15126,"_3064":52237,"_31381":52238,"_21483":52242,"_28210":498},"Data model",[50727,52239,52240,52241],"Platform","Administration","Access control",[],{"_3608":499,"_31023":498,"_21483":52244,"_5":14766,"_28210":498,"_3064":52245},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3608":500,"_31023":498,"_5":31378,"_21483":52247,"_28210":52248,"_3064":52249},[],"/docs/pr-preview/pr-72/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3608":501,"_31023":498,"_5":31378,"_21483":52251,"_28210":52252,"_3064":52253},[],"/docs/pr-preview/pr-72/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3608":502,"_31023":498,"_21483":52255,"_5":14766,"_28210":498,"_3064":52256},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3608":503,"_31023":498,"_21483":52258,"_5":14766,"_28210":52248,"_3064":52259},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3608":504,"_31023":498,"_21483":52261,"_5":14766,"_28210":52248,"_3064":52262},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3608":505,"_31023":498,"_21483":52264,"_5":14766,"_28210":52248,"_3064":52265},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3608":506,"_31023":498,"_21483":52267,"_5":14766,"_28210":52252,"_3064":52268},[],"Entity (`schema_name.entity_type`)",{"_3608":507,"_31023":498,"_21483":52270,"_5":14766,"_28210":52252,"_3064":52271},[],"Table (`table_name`)",{"_3608":508,"_31023":498,"_21483":52273,"_5":14766,"_28210":52252,"_3064":52274},[],"Key (`primary_key`)",{"_3608":509,"_31023":498,"_21483":52276,"_5":14766,"_28210":52252,"_3064":52277},[],"`alerts.event`",{"_3608":510,"_31023":498,"_21483":52279,"_5":14766,"_28210":52252,"_3064":52280},[],"`events`",{"_3608":511,"_31023":498,"_21483":52282,"_5":14766,"_28210":52252,"_3064":52283},[],"`event_type`",{"_3608":512,"_31023":498,"_21483":52285,"_5":14766,"_28210":52252,"_3064":52286},[],"`alerts.subscription`",{"_3608":513,"_31023":498,"_21483":52288,"_5":14766,"_28210":52252,"_3064":52289},[],"`subscriptions`",{"_3608":514,"_31023":498,"_21483":52291,"_5":14766,"_28210":52252,"_3064":52292},[],"`id`",{"_3608":515,"_31023":498,"_21483":52294,"_5":14766,"_28210":52252,"_3064":52295},[],"`ca.ca_certificate`",{"_3608":516,"_31023":498,"_21483":52297,"_5":14766,"_28210":52252,"_3064":52298},[],"`ca_certificates`",{"_3608":517,"_31023":498,"_21483":52300,"_5":14766,"_28210":52252,"_3064":52292},[],{"_3608":518,"_31023":498,"_21483":52302,"_5":14766,"_28210":52252,"_3064":52303},[],"`ca.certificate`",{"_3608":519,"_31023":498,"_21483":52305,"_5":14766,"_28210":52252,"_3064":52306},[],"`certificates`",{"_3608":520,"_31023":498,"_21483":52308,"_5":14766,"_28210":52252,"_3064":52309},[],"`serial_number`",{"_3608":521,"_31023":498,"_21483":52311,"_5":14766,"_28210":52252,"_3064":52312},[],"`ca.issuance_profile`",{"_3608":522,"_31023":498,"_21483":52314,"_5":14766,"_28210":52252,"_3064":52315},[],"`issuance_profiles`",{"_3608":523,"_31023":498,"_21483":52317,"_5":14766,"_28210":52252,"_3064":52292},[],{"_3608":524,"_31023":498,"_21483":52319,"_5":14766,"_28210":52252,"_3064":52320},[],"`devicemanager.device_group`",{"_3608":525,"_31023":498,"_21483":52322,"_5":14766,"_28210":52252,"_3064":52323},[],"`device_groups`",{"_3608":526,"_31023":498,"_21483":52325,"_5":14766,"_28210":52252,"_3064":52292},[],{"_3608":527,"_31023":498,"_21483":52327,"_5":14766,"_28210":52252,"_3064":52328},[],"`devicemanager.device`",{"_3608":528,"_31023":498,"_21483":52330,"_5":14766,"_28210":52252,"_3064":52331},[],"`devices`",{"_3608":529,"_31023":498,"_21483":52333,"_5":14766,"_28210":52252,"_3064":52292},[],{"_3608":530,"_31023":498,"_21483":52335,"_5":14766,"_28210":52252,"_3064":52336},[],"`dmsmanager.dms`",{"_3608":531,"_31023":498,"_21483":52338,"_5":14766,"_28210":52252,"_3064":52339},[],"`dms`",{"_3608":532,"_31023":498,"_21483":52341,"_5":14766,"_28210":52252,"_3064":52292},[],{"_3608":533,"_31023":498,"_21483":52343,"_5":14766,"_28210":52252,"_3064":52344},[],"`kms.kms_key`",{"_3608":534,"_31023":498,"_21483":52346,"_5":14766,"_28210":52252,"_3064":52347},[],"`kms_keys`",{"_3608":535,"_31023":498,"_21483":52349,"_5":14766,"_28210":52252,"_3064":52350},[],"`key_id`, `engine_id`",{"_3608":536,"_31023":498,"_21483":52352,"_5":14766,"_28210":52252,"_3064":52353},[],"`va.crl_settings`",{"_3608":537,"_31023":498,"_21483":52355,"_5":14766,"_28210":52252,"_3064":52356},[],"`crl_settings`",{"_3608":538,"_31023":498,"_21483":52358,"_5":14766,"_28210":52252,"_3064":52359},[],"`ca_id`",{"_3608":539,"_31023":498,"_21483":52361,"_5":14766,"_28210":52252,"_3064":52362},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3608":540,"_31023":498,"_21483":52364,"_5":14766,"_28210":52252,"_3064":52365},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3608":541,"_31023":498,"_21483":52367,"_5":14766,"_28210":52252,"_3064":52368},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3608":542,"_31023":542,"_5":15126,"_3064":52370,"_31381":52371,"_21483":52372,"_28210":542},"Access control overview",[50727,52239,52240,52241],[],{"_3608":543,"_31023":542,"_21483":52374,"_5":14766,"_28210":542,"_3064":52375},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3608":544,"_31023":542,"_5":31378,"_21483":52377,"_28210":52378,"_3064":52379},[],"/docs/pr-preview/pr-72/platform/administration/access-control#essential-concepts","Essential concepts",{"_3608":545,"_31023":542,"_5":31378,"_21483":52381,"_28210":52382,"_3064":52383},[],"/docs/pr-preview/pr-72/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3608":546,"_31023":542,"_5":31378,"_21483":52385,"_28210":52386,"_3064":52387},[],"/docs/pr-preview/pr-72/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3608":547,"_31023":542,"_5":31378,"_21483":52389,"_28210":52390,"_3064":52391},[],"/docs/pr-preview/pr-72/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3608":548,"_31023":542,"_5":31378,"_21483":52393,"_28210":52394,"_3064":52395},[],"/docs/pr-preview/pr-72/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3608":549,"_31023":542,"_5":31378,"_21483":52397,"_28210":52398,"_3064":52399},[],"/docs/pr-preview/pr-72/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3608":550,"_31023":542,"_5":31378,"_21483":52401,"_28210":52402,"_3064":52403},[],"/docs/pr-preview/pr-72/platform/administration/access-control#oidc-principals","OIDC principals",{"_3608":551,"_31023":542,"_5":31378,"_21483":52405,"_28210":52406,"_3064":52407},[],"/docs/pr-preview/pr-72/platform/administration/access-control#x509-principals","X.509 principals",{"_3608":552,"_31023":542,"_5":31378,"_21483":52409,"_28210":52410,"_3064":52411},[],"/docs/pr-preview/pr-72/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3608":553,"_31023":542,"_5":31378,"_21483":52413,"_28210":52414,"_3064":52415},[],"/docs/pr-preview/pr-72/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3608":554,"_31023":542,"_5":31378,"_21483":52417,"_28210":52418,"_3064":52419},[],"/docs/pr-preview/pr-72/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3608":555,"_31023":542,"_5":31378,"_21483":52421,"_28210":52422,"_3064":52423},[],"/docs/pr-preview/pr-72/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3608":556,"_31023":542,"_5":31378,"_21483":52425,"_28210":52426,"_3064":52427},[],"/docs/pr-preview/pr-72/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3608":557,"_31023":542,"_5":31378,"_21483":52429,"_28210":52430,"_3064":52431},[],"/docs/pr-preview/pr-72/platform/administration/access-control#http-rules","HTTP rules",{"_3608":558,"_31023":542,"_5":31378,"_21483":52433,"_28210":52434,"_3064":52435},[],"/docs/pr-preview/pr-72/platform/administration/access-control#included-policies","Included policies",{"_3608":559,"_31023":542,"_5":31378,"_21483":52437,"_28210":52438,"_3064":51377},[],"/docs/pr-preview/pr-72/platform/administration/access-control#provision-the-first-administrator",{"_3608":560,"_31023":542,"_5":31378,"_21483":52440,"_28210":52441,"_3064":52442},[],"/docs/pr-preview/pr-72/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3608":561,"_31023":542,"_5":31378,"_21483":52444,"_28210":52445,"_3064":52446},[],"/docs/pr-preview/pr-72/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3608":562,"_31023":542,"_5":31378,"_21483":52448,"_28210":52449,"_3064":52450},[],"/docs/pr-preview/pr-72/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3608":563,"_31023":542,"_5":31378,"_21483":52452,"_28210":52453,"_3064":52454},[],"/docs/pr-preview/pr-72/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3608":564,"_31023":542,"_5":31378,"_21483":52456,"_28210":52457,"_3064":52458},[],"/docs/pr-preview/pr-72/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3608":565,"_31023":542,"_5":31378,"_21483":52460,"_28210":52461,"_3064":52462},[],"/docs/pr-preview/pr-72/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3608":566,"_31023":542,"_5":31378,"_21483":52464,"_28210":52465,"_3064":52466},[],"/docs/pr-preview/pr-72/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3608":567,"_31023":542,"_5":31378,"_21483":52468,"_28210":52469,"_3064":52470},[],"/docs/pr-preview/pr-72/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3608":568,"_31023":542,"_5":31378,"_21483":52472,"_28210":52473,"_3064":52474},[],"/docs/pr-preview/pr-72/platform/administration/access-control#operational-checklist","Operational checklist",{"_3608":569,"_31023":542,"_5":31378,"_21483":52476,"_28210":52477,"_3064":52478},[],"/docs/pr-preview/pr-72/platform/administration/access-control#diagnostics","Diagnostics",{"_3608":570,"_31023":542,"_5":31378,"_21483":52480,"_28210":52481,"_3064":52482},[],"/docs/pr-preview/pr-72/platform/administration/access-control#the-response-is-401","The response is 401",{"_3608":571,"_31023":542,"_5":31378,"_21483":52484,"_28210":52485,"_3064":52486},[],"/docs/pr-preview/pr-72/platform/administration/access-control#the-response-is-403","The response is 403",{"_3608":572,"_31023":542,"_5":31378,"_21483":52488,"_28210":52489,"_3064":52490},[],"/docs/pr-preview/pr-72/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3608":573,"_31023":542,"_5":31378,"_21483":52492,"_28210":52493,"_3064":52494},[],"/docs/pr-preview/pr-72/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3608":574,"_31023":542,"_5":31378,"_21483":52496,"_28210":52497,"_3064":52498},[],"/docs/pr-preview/pr-72/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3608":575,"_31023":542,"_21483":52500,"_5":14766,"_28210":542,"_3064":52501},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3608":576,"_31023":542,"_21483":52503,"_5":14766,"_28210":542,"_3064":52504},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3608":577,"_31023":542,"_21483":52506,"_5":14766,"_28210":542,"_3064":52507},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3608":578,"_31023":542,"_21483":52509,"_5":14766,"_28210":52378,"_3064":52510},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3608":579,"_31023":542,"_21483":52512,"_5":14766,"_28210":52378,"_3064":52513},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3608":580,"_31023":542,"_21483":52515,"_5":14766,"_28210":52378,"_3064":52516},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3608":581,"_31023":542,"_21483":52518,"_5":14766,"_28210":52378,"_3064":52519},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3608":582,"_31023":542,"_21483":52521,"_5":14766,"_28210":52378,"_3064":52522},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3608":583,"_31023":542,"_21483":52524,"_5":14766,"_28210":52378,"_3064":52525},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3608":584,"_31023":542,"_21483":52527,"_5":14766,"_28210":52382,"_3064":52528},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3608":585,"_31023":542,"_21483":52530,"_5":14766,"_28210":52382,"_3064":52531},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3608":586,"_31023":542,"_21483":52533,"_5":14766,"_28210":52386,"_3064":52534},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3608":587,"_31023":542,"_21483":52536,"_5":14766,"_28210":52386,"_3064":52537},[],"The decision is made **before forwarding the request to the service**:",{"_3608":588,"_31023":542,"_21483":52539,"_5":14766,"_28210":52386,"_3064":52540},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3608":589,"_31023":542,"_21483":52542,"_5":14766,"_28210":52386,"_3064":52543},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3608":590,"_31023":542,"_21483":52545,"_5":14766,"_28210":52386,"_3064":52546},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3608":591,"_31023":542,"_21483":52548,"_5":14766,"_28210":52386,"_3064":52549},[],"It separately loads the policies granted to each principal.",{"_3608":592,"_31023":542,"_21483":52551,"_5":14766,"_28210":52386,"_3064":52552},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3608":593,"_31023":542,"_21483":52554,"_5":14766,"_28210":52386,"_3064":52555},[],"`authz` looks for an HTTP rule granting that action.",{"_3608":594,"_31023":542,"_21483":52557,"_5":14766,"_28210":52386,"_3064":52558},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3608":595,"_31023":542,"_21483":52560,"_5":14766,"_28210":52386,"_3064":52561},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3608":596,"_31023":542,"_21483":52563,"_5":14766,"_28210":52386,"_3064":52564},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3608":597,"_31023":542,"_21483":52566,"_5":14766,"_28210":52386,"_3064":52567},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3608":598,"_31023":542,"_21483":52569,"_5":14766,"_28210":52390,"_3064":52570},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3608":599,"_31023":542,"_21483":52572,"_5":14766,"_28210":52390,"_3064":52573},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3608":600,"_31023":542,"_21483":52575,"_5":14766,"_28210":52390,"_3064":52576},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3608":601,"_31023":542,"_21483":52578,"_5":14766,"_28210":52390,"_3064":52579},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3608":602,"_31023":542,"_21483":52581,"_5":14766,"_28210":52390,"_3064":52582},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3608":603,"_31023":542,"_21483":52584,"_5":14766,"_28210":52390,"_3064":52585},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3608":604,"_31023":542,"_21483":52587,"_5":14766,"_28210":52390,"_3064":52588},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3608":605,"_31023":542,"_21483":52590,"_5":14766,"_28210":52390,"_3064":52591},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3608":606,"_31023":542,"_21483":52593,"_5":14766,"_28210":52390,"_3064":52594},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3608":607,"_31023":542,"_21483":52596,"_5":14766,"_28210":52390,"_3064":52597},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3608":608,"_31023":542,"_21483":52599,"_5":14766,"_28210":52394,"_3064":52600},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3608":609,"_31023":542,"_21483":52602,"_5":14766,"_28210":52394,"_3064":52603},[],"The decision is made with the domain operation context:",{"_3608":610,"_31023":542,"_21483":52605,"_5":14766,"_28210":52394,"_3064":52606},[],"The middleware extracts the credential and resolves the matching principals.",{"_3608":611,"_31023":542,"_21483":52608,"_5":14766,"_28210":52394,"_3064":52609},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3608":612,"_31023":542,"_21483":52611,"_5":14766,"_28210":52394,"_3064":52612},[],"`authz` gathers the entity rules of the granted policies.",{"_3608":613,"_31023":542,"_21483":52614,"_5":14766,"_28210":52394,"_3064":52615},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3608":614,"_31023":542,"_21483":52617,"_5":14766,"_28210":52394,"_3064":52618},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3608":615,"_31023":542,"_21483":52620,"_5":14766,"_28210":52394,"_3064":52621},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3608":616,"_31023":542,"_21483":52623,"_5":14766,"_28210":52394,"_3064":52624},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3608":617,"_31023":542,"_21483":52626,"_5":14766,"_28210":52394,"_3064":52627},[],"Actions fall into two groups:",{"_3608":618,"_31023":542,"_21483":52629,"_5":14766,"_28210":52394,"_3064":52630},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3608":619,"_31023":542,"_21483":52632,"_5":14766,"_28210":52394,"_3064":52633},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3608":620,"_31023":542,"_21483":52635,"_5":14766,"_28210":52394,"_3064":52636},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3608":621,"_31023":542,"_21483":52638,"_5":14766,"_28210":52398,"_3064":52639},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3608":622,"_31023":542,"_21483":52641,"_5":14766,"_28210":52398,"_3064":52642},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3608":623,"_31023":542,"_21483":52644,"_5":14766,"_28210":52398,"_3064":52645},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3608":624,"_31023":542,"_21483":52647,"_5":14766,"_28210":52402,"_3064":52648},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3608":625,"_31023":542,"_21483":52650,"_5":14766,"_28210":52402,"_3064":52651},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3608":626,"_31023":542,"_21483":52653,"_5":14766,"_28210":52402,"_3064":52654},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3608":627,"_31023":542,"_21483":52656,"_5":14766,"_28210":52402,"_3064":52657},[],"The implemented operators are:",{"_3608":628,"_31023":542,"_21483":52659,"_5":14766,"_28210":52402,"_3064":52660},[],"`equals`, for exact equality;",{"_3608":629,"_31023":542,"_21483":52662,"_5":14766,"_28210":52402,"_3064":52663},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3608":630,"_31023":542,"_21483":52665,"_5":14766,"_28210":52402,"_3064":52666},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3608":631,"_31023":542,"_21483":52668,"_5":14766,"_28210":52402,"_3064":52669},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3608":632,"_31023":542,"_21483":52671,"_5":14766,"_28210":52406,"_3064":52672},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3608":633,"_31023":542,"_21483":52674,"_5":14766,"_28210":52406,"_3064":52675},[],"The available modes are:",{"_3608":634,"_31023":542,"_21483":52677,"_5":14766,"_28210":52406,"_3064":52678},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3608":635,"_31023":542,"_21483":52680,"_5":14766,"_28210":52406,"_3064":52681},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3608":636,"_31023":542,"_21483":52683,"_5":14766,"_28210":52406,"_3064":52684},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3608":637,"_31023":542,"_21483":52686,"_5":14766,"_28210":52406,"_3064":52687},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3608":638,"_31023":542,"_21483":52689,"_5":14766,"_28210":52406,"_3064":52690},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3608":639,"_31023":542,"_21483":52692,"_5":14766,"_28210":52406,"_3064":52693},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3608":640,"_31023":542,"_21483":52695,"_5":14766,"_28210":52410,"_3064":52696},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3608":641,"_31023":542,"_21483":52698,"_5":14766,"_28210":52410,"_3064":52699},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3608":642,"_31023":542,"_21483":52701,"_5":14766,"_28210":52410,"_3064":52702},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3608":643,"_31023":542,"_21483":52704,"_5":14766,"_28210":52410,"_3064":52705},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3608":644,"_31023":542,"_21483":52707,"_5":14766,"_28210":52418,"_3064":52708},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3608":645,"_31023":542,"_21483":52710,"_5":14766,"_28210":52418,"_3064":52711},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3608":646,"_31023":542,"_21483":52713,"_5":14766,"_28210":52422,"_3064":52714},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3608":647,"_31023":542,"_21483":52716,"_5":14766,"_28210":52422,"_3064":52717},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3608":648,"_31023":542,"_21483":52719,"_5":14766,"_28210":52422,"_3064":52720},[],"The data model shows how the resources used in entity rules are connected.",{"_3608":649,"_31023":542,"_21483":52722,"_5":14766,"_28210":52422,"_3064":52723},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3608":650,"_31023":542,"_21483":52725,"_5":14766,"_28210":52422,"_3064":52726},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3608":651,"_31023":542,"_21483":52728,"_5":14766,"_28210":52426,"_3064":52729},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3608":652,"_31023":542,"_21483":52731,"_5":14766,"_28210":52426,"_3064":52732},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3608":653,"_31023":542,"_21483":52734,"_5":14766,"_28210":52426,"_3064":52735},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3608":654,"_31023":542,"_21483":52737,"_5":14766,"_28210":52430,"_3064":52738},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3608":655,"_31023":542,"_21483":52740,"_5":14766,"_28210":52430,"_3064":52741},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3608":656,"_31023":542,"_21483":52743,"_5":14766,"_28210":52430,"_3064":52744},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3608":657,"_31023":542,"_21483":52746,"_5":14766,"_28210":52430,"_3064":52747},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3608":658,"_31023":542,"_21483":52749,"_5":14766,"_28210":52430,"_3064":52750},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3608":659,"_31023":542,"_21483":52752,"_5":14766,"_28210":52430,"_3064":52753},[],"Note that:",{"_3608":660,"_31023":542,"_21483":52755,"_5":14766,"_28210":52430,"_3064":52756},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3608":661,"_31023":542,"_21483":52758,"_5":14766,"_28210":52430,"_3064":52759},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3608":662,"_31023":542,"_21483":52761,"_5":14766,"_28210":52430,"_3064":52762},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3608":663,"_31023":542,"_21483":52764,"_5":14766,"_28210":52434,"_3064":52765},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3608":664,"_31023":542,"_21483":52767,"_5":14766,"_28210":52434,"_3064":52768},[],"full and read-only access to certificates and authorities;",{"_3608":665,"_31023":542,"_21483":52770,"_5":14766,"_28210":52434,"_3064":52771},[],"full and read-only access to the KMS;",{"_3608":666,"_31023":542,"_21483":52773,"_5":14766,"_28210":52434,"_3064":52774},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3608":667,"_31023":542,"_21483":52776,"_5":14766,"_28210":52434,"_3064":52777},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3608":668,"_31023":542,"_21483":52779,"_5":14766,"_28210":52434,"_3064":52780},[],"console access;",{"_3608":669,"_31023":542,"_21483":52782,"_5":14766,"_28210":52434,"_3064":52783},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3608":670,"_31023":542,"_21483":52785,"_5":14766,"_28210":52434,"_3064":52786},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3608":671,"_31023":542,"_21483":52788,"_5":14766,"_28210":52434,"_3064":52789},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3608":672,"_31023":542,"_21483":52791,"_5":14766,"_28210":52434,"_3064":52792},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3608":673,"_31023":542,"_21483":52794,"_5":14766,"_28210":52434,"_3064":52795},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3608":674,"_31023":542,"_21483":52797,"_5":14766,"_28210":52438,"_3064":52798},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3608":675,"_31023":542,"_21483":52800,"_5":14766,"_28210":52438,"_3064":52801},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3608":676,"_31023":542,"_21483":52803,"_5":14766,"_28210":52438,"_3064":52804},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3608":677,"_31023":542,"_21483":52806,"_5":14766,"_28210":52441,"_3064":52807},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3608":678,"_31023":542,"_21483":52809,"_5":14766,"_28210":52445,"_3064":52810},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3608":679,"_31023":542,"_21483":52812,"_5":14766,"_28210":52445,"_3064":52813},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3608":680,"_31023":542,"_21483":52815,"_5":14766,"_28210":52449,"_3064":52816},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3608":681,"_31023":542,"_21483":52818,"_5":14766,"_28210":52453,"_3064":52819},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3608":682,"_31023":542,"_21483":52821,"_5":14766,"_28210":52457,"_3064":52822},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3608":683,"_31023":542,"_21483":52824,"_5":14766,"_28210":52461,"_3064":52825},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3608":684,"_31023":542,"_21483":52827,"_5":14766,"_28210":52461,"_3064":52828},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3608":685,"_31023":542,"_21483":52830,"_5":14766,"_28210":52465,"_3064":52831},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3608":686,"_31023":542,"_21483":52833,"_5":14766,"_28210":52465,"_3064":52834},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3608":687,"_31023":542,"_21483":52836,"_5":14766,"_28210":52465,"_3064":52837},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3608":688,"_31023":542,"_21483":52839,"_5":14766,"_28210":52465,"_3064":52840},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3608":689,"_31023":542,"_21483":52842,"_5":14766,"_28210":52465,"_3064":52843},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3608":690,"_31023":542,"_21483":52845,"_5":14766,"_28210":52465,"_3064":52846},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3608":691,"_31023":542,"_21483":52848,"_5":14766,"_28210":52465,"_3064":52849},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3608":692,"_31023":542,"_21483":52851,"_5":14766,"_28210":52465,"_3064":52852},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3608":693,"_31023":542,"_21483":52854,"_5":14766,"_28210":52469,"_3064":52855},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3608":694,"_31023":542,"_21483":52857,"_5":14766,"_28210":52469,"_3064":52858},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3608":695,"_31023":542,"_21483":52860,"_5":14766,"_28210":52469,"_3064":52861},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3608":696,"_31023":542,"_21483":52863,"_5":14766,"_28210":52473,"_3064":52864},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3608":697,"_31023":542,"_21483":52866,"_5":14766,"_28210":52473,"_3064":52867},[],"Use groups or stable roles for people and independent identities for automations.",{"_3608":698,"_31023":542,"_21483":52869,"_5":14766,"_28210":52473,"_3064":52870},[],"Keep at least two recovery administrators and test their access periodically.",{"_3608":699,"_31023":542,"_21483":52872,"_5":14766,"_28210":52473,"_3064":52873},[],"Review active principals, their matches and their grants after IdP changes.",{"_3608":700,"_31023":542,"_21483":52875,"_5":14766,"_28210":52473,"_3064":52876},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3608":701,"_31023":542,"_21483":52878,"_5":14766,"_28210":52473,"_3064":52879},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3608":702,"_31023":542,"_21483":52881,"_5":14766,"_28210":52473,"_3064":52882},[],"Always test one allowed and one denied operation for each role.",{"_3608":703,"_31023":542,"_21483":52884,"_5":14766,"_28210":52473,"_3064":52885},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3608":704,"_31023":542,"_21483":52887,"_5":14766,"_28210":52481,"_3064":52888},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3608":705,"_31023":542,"_21483":52890,"_5":14766,"_28210":52485,"_3064":52891},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3608":706,"_31023":542,"_21483":52893,"_5":14766,"_28210":52485,"_3064":52894},[],"that an active principal of the correct type exists;",{"_3608":707,"_31023":542,"_21483":52896,"_5":14766,"_28210":52485,"_3064":52897},[],"that the claim paths and values match the real token exactly;",{"_3608":708,"_31023":542,"_21483":52899,"_5":14766,"_28210":52485,"_3064":52900},[],"that all of the principal's conditions hold;",{"_3608":709,"_31023":542,"_21483":52902,"_5":14766,"_28210":52485,"_3064":52903},[],"that the principal has the expected policy granted;",{"_3608":710,"_31023":542,"_21483":52905,"_5":14766,"_28210":52485,"_3064":52906},[],"that the policy includes the action and the requested resource type or route;",{"_3608":711,"_31023":542,"_21483":52908,"_5":14766,"_28210":52485,"_3064":52909},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3608":712,"_31023":542,"_21483":52911,"_5":14766,"_28210":52485,"_3064":52912},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3608":713,"_31023":542,"_21483":52914,"_5":14766,"_28210":52485,"_3064":52915},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3608":714,"_31023":542,"_21483":52917,"_5":14766,"_28210":52489,"_3064":52918},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3608":715,"_31023":542,"_21483":52920,"_5":14766,"_28210":52493,"_3064":52921},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3608":716,"_31023":542,"_21483":52923,"_5":14766,"_28210":52497,"_3064":52924},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3608":717,"_31023":542,"_21483":52926,"_5":14766,"_28210":52497,"_3064":52927},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3608":718,"_31023":718,"_5":15126,"_3064":52929,"_31381":52930,"_21483":52931,"_28210":718},"Alerts and subscriptions",[50727,52239,52240],[],{"_3608":719,"_31023":718,"_21483":52933,"_5":14766,"_28210":718,"_3064":52934},[],"Send PKI events to people and external systems.",{"_3608":720,"_31023":718,"_5":31378,"_21483":52936,"_28210":52937,"_3064":52938},[],"/docs/pr-preview/pr-72/platform/administration/alerts#how-it-works","How it works",{"_3608":721,"_31023":718,"_5":31378,"_21483":52940,"_28210":52941,"_3064":52942},[],"/docs/pr-preview/pr-72/platform/administration/alerts#available-channels","Available channels",{"_3608":722,"_31023":718,"_5":31378,"_21483":52944,"_28210":52945,"_3064":52946},[],"/docs/pr-preview/pr-72/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3608":723,"_31023":718,"_5":31378,"_21483":52948,"_28210":52949,"_3064":52950},[],"/docs/pr-preview/pr-72/platform/administration/alerts#choose-the-event","Choose the event",{"_3608":724,"_31023":718,"_5":31378,"_21483":52952,"_28210":52953,"_3064":52954},[],"/docs/pr-preview/pr-72/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3608":725,"_31023":718,"_5":31378,"_21483":52956,"_28210":52957,"_3064":52958},[],"/docs/pr-preview/pr-72/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3608":726,"_31023":718,"_5":31378,"_21483":52960,"_28210":52961,"_3064":52962},[],"/docs/pr-preview/pr-72/platform/administration/alerts#review-and-activate","Review and activate",{"_3608":727,"_31023":718,"_5":31378,"_21483":52964,"_28210":52965,"_3064":52966},[],"/docs/pr-preview/pr-72/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3608":728,"_31023":718,"_5":31378,"_21483":52968,"_28210":52969,"_3064":52970},[],"/docs/pr-preview/pr-72/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3608":729,"_31023":718,"_5":31378,"_21483":52972,"_28210":52973,"_3064":52974},[],"/docs/pr-preview/pr-72/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3608":730,"_31023":718,"_5":31378,"_21483":52976,"_28210":52977,"_3064":52978},[],"/docs/pr-preview/pr-72/platform/administration/alerts#event-families","Event families",{"_3608":731,"_31023":718,"_21483":52980,"_5":14766,"_28210":718,"_3064":52981},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3608":732,"_31023":718,"_21483":52983,"_5":14766,"_28210":52937,"_3064":52984},[],"A service publishes a domain event.",{"_3608":733,"_31023":718,"_21483":52986,"_5":14766,"_28210":52937,"_3064":52987},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3608":734,"_31023":718,"_21483":52989,"_5":14766,"_28210":52937,"_3064":52990},[],"Each subscription's filter decides whether it should be notified.",{"_3608":735,"_31023":718,"_21483":52992,"_5":14766,"_28210":52937,"_3064":52993},[],"Lamassu delivers the event to the configured channel.",{"_3608":736,"_31023":718,"_21483":52995,"_5":14766,"_28210":52937,"_3064":52996},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3608":737,"_31023":718,"_21483":52998,"_5":14766,"_28210":52941,"_3064":52999},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3608":738,"_31023":718,"_21483":53001,"_5":14766,"_28210":52941,"_3064":53002},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3608":739,"_31023":718,"_21483":53004,"_5":14766,"_28210":52941,"_3064":53005},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3608":740,"_31023":718,"_21483":53007,"_5":14766,"_28210":52941,"_3064":53008},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3608":741,"_31023":718,"_21483":53010,"_5":14766,"_28210":52941,"_3064":53011},[],"`apikey_options` requires `header` and `key`.",{"_3608":742,"_31023":718,"_21483":53013,"_5":14766,"_28210":52941,"_3064":53014},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3608":743,"_31023":718,"_21483":53016,"_5":14766,"_28210":52941,"_3064":53017},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3608":744,"_31023":718,"_21483":53019,"_5":14766,"_28210":52941,"_3064":53020},[],"The alerts API reference documents the full `http_client` schema.",{"_3608":745,"_31023":718,"_21483":53022,"_5":14766,"_28210":52949,"_3064":53023},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3608":746,"_31023":718,"_21483":53025,"_5":14766,"_28210":52953,"_3064":53026},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3608":747,"_31023":718,"_21483":53028,"_5":14766,"_28210":52957,"_3064":53029},[],"Add a filter if you don't want to receive every instance of the event.",{"_3608":748,"_31023":718,"_21483":53031,"_5":14766,"_28210":52957,"_3064":53032},[],"**None** notifies all instances of the event.",{"_3608":749,"_31023":718,"_21483":53034,"_5":14766,"_28210":52957,"_3064":53035},[],"**JSON Path** evaluates one or more specific fields.",{"_3608":750,"_31023":718,"_21483":53037,"_5":14766,"_28210":52957,"_3064":53038},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3608":751,"_31023":718,"_21483":53040,"_5":14766,"_28210":52957,"_3064":53041},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3608":752,"_31023":718,"_21483":53043,"_5":14766,"_28210":52957,"_3064":53044},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3608":753,"_31023":718,"_21483":53046,"_5":14766,"_28210":52957,"_3064":53047},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3608":754,"_31023":718,"_21483":53049,"_5":14766,"_28210":52961,"_3064":53050},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3608":755,"_31023":718,"_21483":53052,"_5":14766,"_28210":52965,"_3064":53053},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3608":756,"_31023":718,"_21483":53055,"_5":14766,"_28210":52965,"_3064":53056},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3608":757,"_31023":718,"_21483":53058,"_5":14766,"_28210":52965,"_3064":53059},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3608":758,"_31023":718,"_21483":53061,"_5":14766,"_28210":52965,"_3064":53062},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3608":759,"_31023":718,"_21483":53064,"_5":14766,"_28210":52965,"_3064":53065},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3608":760,"_31023":718,"_21483":53067,"_5":14766,"_28210":52965,"_3064":53068},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3608":761,"_31023":718,"_21483":53070,"_5":14766,"_28210":52965,"_3064":53071},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3608":762,"_31023":718,"_21483":53073,"_5":14766,"_28210":52965,"_3064":53074},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3608":763,"_31023":718,"_21483":53076,"_5":14766,"_28210":52969,"_3064":53077},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3608":764,"_31023":718,"_21483":53079,"_5":14766,"_28210":52969,"_3064":53080},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3608":765,"_31023":718,"_21483":53082,"_5":14766,"_28210":52969,"_3064":53083},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3608":766,"_31023":718,"_21483":53085,"_5":14766,"_28210":52969,"_3064":53086},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3608":767,"_31023":718,"_21483":53088,"_5":14766,"_28210":52969,"_3064":53089},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3608":768,"_31023":718,"_21483":53091,"_5":14766,"_28210":52969,"_3064":53092},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3608":769,"_31023":718,"_21483":53094,"_5":14766,"_28210":52969,"_3064":53095},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3608":770,"_31023":718,"_21483":53097,"_5":14766,"_28210":52969,"_3064":53098},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3608":771,"_31023":718,"_21483":53100,"_5":14766,"_28210":52973,"_3064":53101},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3608":772,"_31023":718,"_21483":53103,"_5":14766,"_28210":52973,"_3064":53104},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3608":773,"_31023":718,"_21483":53106,"_5":14766,"_28210":52977,"_3064":53107},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3608":774,"_31023":718,"_21483":53109,"_5":14766,"_28210":52977,"_3064":53110},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3608":775,"_31023":718,"_21483":53112,"_5":14766,"_28210":52977,"_3064":53113},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3608":776,"_31023":718,"_21483":53115,"_5":14766,"_28210":52977,"_3064":53116},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3608":777,"_31023":718,"_21483":53118,"_5":14766,"_28210":52977,"_3064":53119},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3608":778,"_31023":718,"_21483":53121,"_5":14766,"_28210":52977,"_3064":53122},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3608":779,"_31023":718,"_21483":53124,"_5":14766,"_28210":52977,"_3064":53125},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3608":780,"_31023":718,"_21483":53127,"_5":14766,"_28210":52977,"_3064":53128},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3608":781,"_31023":718,"_21483":53130,"_5":14766,"_28210":52977,"_3064":53131},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3608":782,"_31023":718,"_21483":53133,"_5":14766,"_28210":52977,"_3064":53134},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3608":783,"_31023":783,"_5":15126,"_3064":53136,"_31381":53137,"_21483":53138,"_28210":783},"Audit logs",[50727,52239,52240],[],{"_3608":784,"_31023":783,"_21483":53140,"_5":14766,"_28210":783,"_3064":53141},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3608":785,"_31023":783,"_5":31378,"_21483":53143,"_28210":53144,"_3064":53145},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3608":786,"_31023":783,"_5":31378,"_21483":53147,"_28210":53148,"_3064":53149},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#coverage","Coverage",{"_3608":787,"_31023":783,"_5":31378,"_21483":53151,"_28210":53152,"_3064":53153},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3608":788,"_31023":783,"_5":31378,"_21483":53155,"_28210":53156,"_3064":53157},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3608":789,"_31023":783,"_5":31378,"_21483":53159,"_28210":53160,"_3064":53161},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3608":790,"_31023":783,"_5":31378,"_21483":53163,"_28210":53164,"_3064":53165},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3608":791,"_31023":783,"_5":31378,"_21483":53167,"_28210":53168,"_3064":53169},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3608":792,"_31023":783,"_5":31378,"_21483":53171,"_28210":53172,"_3064":53173},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3608":793,"_31023":783,"_5":31378,"_21483":53175,"_28210":53176,"_3064":53177},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3608":794,"_31023":783,"_5":31378,"_21483":53179,"_28210":53180,"_3064":53181},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3608":795,"_31023":783,"_5":31378,"_21483":53183,"_28210":53184,"_3064":53185},[],"/docs/pr-preview/pr-72/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3608":796,"_31023":783,"_21483":53187,"_5":14766,"_28210":783,"_3064":53188},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3608":797,"_31023":783,"_21483":53190,"_5":14766,"_28210":53144,"_3064":53191},[],"The audit body includes:",{"_3608":798,"_31023":783,"_21483":53193,"_5":14766,"_28210":53144,"_3064":53194},[],"input: data received by the operation;",{"_3608":799,"_31023":783,"_21483":53196,"_5":14766,"_28210":53144,"_3064":53197},[],"has\\_error: whether the service returned an error;",{"_3608":800,"_31023":783,"_21483":53199,"_5":14766,"_28210":53144,"_3064":53200},[],"output: produced result or error message;",{"_3608":801,"_31023":783,"_21483":53202,"_5":14766,"_28210":53144,"_3064":53203},[],"principals: identifiers of the principals that matched the request.",{"_3608":802,"_31023":783,"_21483":53205,"_5":14766,"_28210":53144,"_3064":53206},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3608":803,"_31023":783,"_21483":53208,"_5":14766,"_28210":53144,"_3064":53209},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3608":804,"_31023":783,"_21483":53211,"_5":14766,"_28210":53148,"_3064":53212},[],"The backend applies auditing to mutations of:",{"_3608":805,"_31023":783,"_21483":53214,"_5":14766,"_28210":53148,"_3064":53215},[],"authorities, certificates and issuance profiles;",{"_3608":806,"_31023":783,"_21483":53217,"_5":14766,"_28210":53148,"_3064":53218},[],"keys and KMS engines;",{"_3608":807,"_31023":783,"_21483":53220,"_5":14766,"_28210":53148,"_3064":53221},[],"devices and identities;",{"_3608":808,"_31023":783,"_21483":53223,"_5":14766,"_28210":53148,"_3064":53224},[],"DMSs and enrollment operations;",{"_3608":809,"_31023":783,"_21483":53226,"_5":14766,"_28210":53148,"_3064":53227},[],"validation functions and CRL;",{"_3608":810,"_31023":783,"_21483":53229,"_5":14766,"_28210":53148,"_3064":53230},[],"principals, policies and authorization grants.",{"_3608":811,"_31023":783,"_21483":53232,"_5":14766,"_28210":53148,"_3064":53233},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3608":812,"_31023":783,"_21483":53235,"_5":14766,"_28210":53152,"_3064":53236},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3608":813,"_31023":783,"_21483":53238,"_5":14766,"_28210":53152,"_3064":53239},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3608":814,"_31023":783,"_21483":53241,"_5":14766,"_28210":53152,"_3064":53242},[],"Design the consumer to:",{"_3608":815,"_31023":783,"_21483":53244,"_5":14766,"_28210":53152,"_3064":53245},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3608":816,"_31023":783,"_21483":53247,"_5":14766,"_28210":53152,"_3064":53248},[],"keep the complete CloudEvent unmodified;",{"_3608":817,"_31023":783,"_21483":53250,"_5":14766,"_28210":53152,"_3064":53251},[],"record the ingestion time and detect duplicates by ID;",{"_3608":818,"_31023":783,"_21483":53253,"_5":14766,"_28210":53152,"_3064":53254},[],"encrypt in transit and at rest;",{"_3608":819,"_31023":783,"_21483":53256,"_5":14766,"_28210":53152,"_3064":53257},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3608":820,"_31023":783,"_21483":53259,"_5":14766,"_28210":53152,"_3064":53260},[],"apply an explicit retention and legal hold policy;",{"_3608":821,"_31023":783,"_21483":53262,"_5":14766,"_28210":53152,"_3064":53263},[],"alert if it stops consuming or the pending queue grows.",{"_3608":822,"_31023":783,"_21483":53265,"_5":14766,"_28210":53156,"_3064":53266},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3608":823,"_31023":783,"_21483":53268,"_5":14766,"_28210":53156,"_3064":53269},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3608":824,"_31023":783,"_21483":53271,"_5":14766,"_28210":53164,"_3064":53272},[],"Start from the reported time and normalize every source to UTC.",{"_3608":825,"_31023":783,"_21483":53274,"_5":14766,"_28210":53168,"_3064":53275},[],"Filter by event type, service source and resource identifier.",{"_3608":826,"_31023":783,"_21483":53277,"_5":14766,"_28210":53172,"_3064":53278},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3608":827,"_31023":783,"_21483":53280,"_5":14766,"_28210":53176,"_3064":53281},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3608":828,"_31023":783,"_21483":53283,"_5":14766,"_28210":53180,"_3064":53284},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3608":829,"_31023":783,"_21483":53286,"_5":14766,"_28210":53184,"_3064":53287},[],"Generate a controlled mutation in a test environment and check that:",{"_3608":830,"_31023":783,"_21483":53289,"_5":14766,"_28210":53184,"_3064":53290},[],"a successful audit event appears;",{"_3608":831,"_31023":783,"_21483":53292,"_5":14766,"_28210":53184,"_3064":53293},[],"the principal matches the identity used;",{"_3608":832,"_31023":783,"_21483":53295,"_5":14766,"_28210":53184,"_3064":53296},[],"the consumer persists it exactly once;",{"_3608":833,"_31023":783,"_21483":53298,"_5":14766,"_28210":53184,"_3064":53299},[],"it can be retrieved by resource, actor and period;",{"_3608":834,"_31023":783,"_21483":53301,"_5":14766,"_28210":53184,"_3064":53302},[],"a consumer outage raises an alert.",{"_3608":835,"_31023":783,"_21483":53304,"_5":14766,"_28210":53184,"_3064":53305},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3608":836,"_31023":836,"_5":15126,"_3064":53307,"_31381":53308,"_21483":53309,"_28210":836},"Platform architecture",[50727,52239],[],{"_3608":837,"_31023":836,"_21483":53311,"_5":14766,"_28210":836,"_3064":53312},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3608":838,"_31023":836,"_5":31378,"_21483":53314,"_28210":53315,"_3064":53316},[],"/docs/pr-preview/pr-72/platform/concepts/architecture#control-plane","Control plane",{"_3608":839,"_31023":836,"_5":31378,"_21483":53318,"_28210":53319,"_3064":53320},[],"/docs/pr-preview/pr-72/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3608":840,"_31023":836,"_5":31378,"_21483":53322,"_28210":53323,"_3064":53324},[],"/docs/pr-preview/pr-72/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3608":841,"_31023":836,"_5":31378,"_21483":53326,"_28210":53327,"_3064":53328},[],"/docs/pr-preview/pr-72/platform/concepts/architecture#status-and-validation","Status and validation",{"_3608":842,"_31023":836,"_5":31378,"_21483":53330,"_28210":53331,"_3064":53332},[],"/docs/pr-preview/pr-72/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3608":843,"_31023":836,"_21483":53334,"_5":14766,"_28210":836,"_3064":53335},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3608":844,"_31023":836,"_21483":53337,"_5":14766,"_28210":836,"_3064":53338},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3608":845,"_31023":836,"_21483":53340,"_5":14766,"_28210":53315,"_3064":53341},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3608":846,"_31023":836,"_21483":53343,"_5":14766,"_28210":53319,"_3064":53344},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3608":847,"_31023":836,"_21483":53346,"_5":14766,"_28210":53323,"_3064":53347},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3608":848,"_31023":836,"_21483":53349,"_5":14766,"_28210":53327,"_3064":53350},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3608":849,"_31023":836,"_21483":53352,"_5":14766,"_28210":53331,"_3064":53353},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3608":850,"_31023":850,"_5":15126,"_3064":53355,"_31381":53356,"_21483":53357,"_28210":850},"How Lamassu works",[50727,52239],[],{"_3608":851,"_31023":850,"_21483":53359,"_5":14766,"_28210":850,"_3064":53360},[],"The mental model of trust, keys, certificates and devices.",{"_3608":852,"_31023":850,"_5":31378,"_21483":53362,"_28210":53363,"_3064":53364},[],"/docs/pr-preview/pr-72/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3608":853,"_31023":850,"_5":31378,"_21483":53366,"_28210":53367,"_3064":53368},[],"/docs/pr-preview/pr-72/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3608":854,"_31023":850,"_21483":53370,"_5":14766,"_28210":850,"_3064":53371},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3608":855,"_31023":850,"_21483":53373,"_5":14766,"_28210":53363,"_3064":53374},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3608":856,"_31023":850,"_21483":53376,"_5":14766,"_28210":53363,"_3064":53377},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3608":857,"_31023":850,"_21483":53379,"_5":14766,"_28210":53363,"_3064":53380},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3608":858,"_31023":850,"_21483":53382,"_5":14766,"_28210":53363,"_3064":53383},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3608":859,"_31023":850,"_21483":53385,"_5":14766,"_28210":53363,"_3064":53386},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3608":860,"_31023":850,"_21483":53388,"_5":14766,"_28210":53367,"_3064":53389},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3608":861,"_31023":850,"_21483":53391,"_5":14766,"_28210":53367,"_3064":53392},[],"A DMS relates that CA to an enrollment policy.",{"_3608":862,"_31023":850,"_21483":53394,"_5":14766,"_28210":53367,"_3064":53395},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3608":863,"_31023":850,"_21483":53397,"_5":14766,"_28210":53367,"_3064":53398},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3608":864,"_31023":850,"_21483":53400,"_5":14766,"_28210":53367,"_3064":53401},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3608":865,"_31023":850,"_21483":53403,"_5":14766,"_28210":53367,"_3064":53404},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3608":866,"_31023":850,"_21483":53406,"_5":14766,"_28210":53367,"_3064":53407},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3608":867,"_31023":867,"_5":15126,"_3064":53409,"_31381":53410,"_21483":53412,"_28210":867},"Devices and identities",[50727,52239,53411,53409],"IoT Fleets",[],{"_3608":868,"_31023":867,"_21483":53414,"_5":14766,"_28210":867,"_3064":53415},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3608":869,"_31023":867,"_5":31378,"_21483":53417,"_28210":53418,"_3064":53419},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#device-states","Device states",{"_3608":870,"_31023":867,"_5":31378,"_21483":53421,"_28210":53422,"_3064":53423},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3608":871,"_31023":867,"_5":31378,"_21483":53425,"_28210":53426,"_3064":53427},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3608":872,"_31023":867,"_5":31378,"_21483":53429,"_28210":53430,"_3064":53431},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3608":873,"_31023":867,"_5":31378,"_21483":53433,"_28210":53434,"_3064":53435},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3608":874,"_31023":867,"_5":31378,"_21483":53437,"_28210":53438,"_3064":53439},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3608":875,"_31023":867,"_5":31378,"_21483":53441,"_28210":53442,"_3064":53443},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3608":876,"_31023":867,"_5":31378,"_21483":53445,"_28210":53446,"_3064":53447},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3608":877,"_31023":867,"_5":31378,"_21483":53449,"_28210":53450,"_3064":53451},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3608":878,"_31023":867,"_5":31378,"_21483":53453,"_28210":53454,"_3064":53455},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3608":879,"_31023":867,"_5":31378,"_21483":53457,"_28210":53458,"_3064":53459},[],"/docs/pr-preview/pr-72/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3608":880,"_31023":867,"_21483":53461,"_5":14766,"_28210":867,"_3064":53462},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3608":881,"_31023":867,"_21483":53464,"_5":14766,"_28210":867,"_3064":53465},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3608":882,"_31023":867,"_21483":53467,"_5":14766,"_28210":53418,"_3064":53468},[],"Operational view",{"_3608":883,"_31023":867,"_21483":53470,"_5":14766,"_28210":53418,"_3064":53471},[],"Meaning",{"_3608":884,"_31023":867,"_21483":53473,"_5":14766,"_28210":53418,"_3064":53474},[],"**No Identity**",{"_3608":885,"_31023":867,"_21483":53476,"_5":14766,"_28210":53418,"_3064":53477},[],"A record exists without an associated identity.",{"_3608":886,"_31023":867,"_21483":53479,"_5":14766,"_28210":53418,"_3064":53480},[],"**Active**",{"_3608":887,"_31023":867,"_21483":53482,"_5":14766,"_28210":53418,"_3064":53483},[],"The slot is active; also check certificate dates, status and usages.",{"_3608":888,"_31023":867,"_21483":53485,"_5":14766,"_28210":53418,"_3064":53486},[],"**Renewal Pending**",{"_3608":889,"_31023":867,"_21483":53488,"_5":14766,"_28210":53418,"_3064":53489},[],"The identity is in the operational renewal window.",{"_3608":890,"_31023":867,"_21483":53491,"_5":14766,"_28210":53418,"_3064":53492},[],"**Expiring Soon**",{"_3608":891,"_31023":867,"_21483":53494,"_5":14766,"_28210":53418,"_3064":53495},[],"Expiration is approaching according to configured thresholds.",{"_3608":892,"_31023":867,"_21483":53497,"_5":14766,"_28210":53418,"_3064":53498},[],"**Expired**",{"_3608":893,"_31023":867,"_21483":53500,"_5":14766,"_28210":53418,"_3064":53501},[],"The identity has expired.",{"_3608":894,"_31023":867,"_21483":53503,"_5":14766,"_28210":53418,"_3064":53504},[],"**Revoked**",{"_3608":895,"_31023":867,"_21483":53506,"_5":14766,"_28210":53418,"_3064":53507},[],"The identity is marked revoked.",{"_3608":896,"_31023":867,"_21483":53509,"_5":14766,"_28210":53418,"_3064":53510},[],"**Decommissioned**",{"_3608":897,"_31023":867,"_21483":53512,"_5":14766,"_28210":53418,"_3064":53513},[],"The record is retired and ordinary updates do not restore operation.",{"_3608":898,"_31023":867,"_21483":53515,"_5":14766,"_28210":53418,"_3064":53516},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3608":899,"_31023":867,"_21483":53518,"_5":14766,"_28210":53422,"_3064":53519},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3608":900,"_31023":867,"_21483":53521,"_5":14766,"_28210":53422,"_3064":53522},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3608":901,"_31023":867,"_21483":53524,"_5":14766,"_28210":53422,"_3064":53525},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3608":902,"_31023":867,"_21483":53527,"_5":14766,"_28210":53422,"_3064":53528},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3608":903,"_31023":867,"_21483":53530,"_5":14766,"_28210":53426,"_3064":53531},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3608":904,"_31023":867,"_21483":53533,"_5":14766,"_28210":53430,"_3064":53534},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3608":905,"_31023":867,"_21483":53536,"_5":14766,"_28210":53434,"_3064":53537},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3608":906,"_31023":867,"_21483":53539,"_5":14766,"_28210":53438,"_3064":53540},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3608":907,"_31023":867,"_21483":53542,"_5":14766,"_28210":53442,"_3064":53543},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3608":908,"_31023":867,"_21483":53545,"_5":14766,"_28210":53442,"_3064":53546},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3608":909,"_31023":867,"_21483":53548,"_5":14766,"_28210":53446,"_3064":53549},[],"From **No Identity**, use **Assign Identity**:",{"_3608":910,"_31023":867,"_21483":53551,"_5":14766,"_28210":53446,"_3064":53552},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3608":911,"_31023":867,"_21483":53554,"_5":14766,"_28210":53446,"_3064":53555},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3608":912,"_31023":867,"_21483":53557,"_5":14766,"_28210":53446,"_3064":53558},[],"Confirm and read the serial, active version and history again.",{"_3608":913,"_31023":867,"_21483":53560,"_5":14766,"_28210":53446,"_3064":53561},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3608":914,"_31023":867,"_21483":53563,"_5":14766,"_28210":53446,"_3064":53564},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3608":915,"_31023":867,"_21483":53566,"_5":14766,"_28210":53450,"_3064":53567},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3608":916,"_31023":867,"_21483":53569,"_5":14766,"_28210":53450,"_3064":53570},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3608":917,"_31023":867,"_21483":53572,"_5":14766,"_28210":53454,"_3064":53573},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3608":918,"_31023":867,"_21483":53575,"_5":14766,"_28210":53454,"_3064":53576},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3608":919,"_31023":867,"_21483":53578,"_5":14766,"_28210":53454,"_3064":53579},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3608":920,"_31023":867,"_21483":53581,"_5":14766,"_28210":53454,"_3064":53582},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3608":921,"_31023":867,"_21483":53584,"_5":14766,"_28210":53458,"_3064":53585},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3608":922,"_31023":867,"_21483":53587,"_5":14766,"_28210":53458,"_3064":53588},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3608":923,"_31023":923,"_5":15126,"_3064":53590,"_31381":53591,"_21483":53593,"_28210":923},"Bootstrap identity and authentication",[50727,52239,53411,53409,53592],"Enrollment with PKI",[],{"_3608":924,"_31023":923,"_21483":53595,"_5":14766,"_28210":923,"_3064":53596},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3608":925,"_31023":923,"_5":31378,"_21483":53598,"_28210":53599,"_3064":53600},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3608":926,"_31023":923,"_5":31378,"_21483":53602,"_28210":53603,"_3064":53604},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3608":927,"_31023":923,"_5":31378,"_21483":53606,"_28210":53607,"_3064":53608},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3608":928,"_31023":923,"_5":31378,"_21483":53610,"_28210":53611,"_3064":53612},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3608":929,"_31023":923,"_5":31378,"_21483":53614,"_28210":53615,"_3064":53616},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3608":930,"_31023":923,"_21483":53618,"_5":14766,"_28210":923,"_3064":53619},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3608":931,"_31023":923,"_21483":53621,"_5":14766,"_28210":53599,"_3064":53622},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3608":932,"_31023":923,"_21483":53624,"_5":14766,"_28210":53599,"_3064":53625},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3608":933,"_31023":923,"_21483":53627,"_5":14766,"_28210":53603,"_3064":53628},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3608":934,"_31023":923,"_21483":53630,"_5":14766,"_28210":53603,"_3064":53631},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3608":935,"_31023":923,"_21483":53633,"_5":14766,"_28210":53603,"_3064":53634},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3608":936,"_31023":923,"_21483":53636,"_5":14766,"_28210":53607,"_3064":53637},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3608":937,"_31023":923,"_21483":53639,"_5":14766,"_28210":53607,"_3064":53640},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3608":938,"_31023":923,"_21483":53642,"_5":14766,"_28210":53611,"_3064":53643},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3608":939,"_31023":923,"_21483":53645,"_5":14766,"_28210":53611,"_3064":53646},[],"Example body:",{"_3608":940,"_31023":923,"_21483":53648,"_5":14766,"_28210":53611,"_3064":53649},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3608":941,"_31023":923,"_21483":53651,"_5":14766,"_28210":53611,"_3064":53652},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3608":942,"_31023":923,"_21483":53654,"_5":14766,"_28210":53611,"_3064":53655},[],"Continuation requires a successful HTTP response and JSON:",{"_3608":943,"_31023":923,"_21483":53657,"_5":14766,"_28210":53611,"_3064":53658},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3608":944,"_31023":923,"_21483":53660,"_5":14766,"_28210":53615,"_3064":53661},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3608":945,"_31023":923,"_21483":53663,"_5":14766,"_28210":53615,"_3064":53664},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3608":946,"_31023":946,"_5":15126,"_3064":53666,"_31381":53667,"_21483":53668,"_28210":946},"Configure and operate the DMS",[50727,52239,53411,53409,53592],[],{"_3608":947,"_31023":946,"_21483":53670,"_5":14766,"_28210":946,"_3064":53671},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3608":948,"_31023":946,"_5":31378,"_21483":53673,"_28210":53674,"_3064":50737},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3608":949,"_31023":946,"_5":31378,"_21483":53676,"_28210":53677,"_3064":53678},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3608":950,"_31023":946,"_5":31378,"_21483":53680,"_28210":53681,"_3064":53682},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3608":951,"_31023":946,"_5":31378,"_21483":53684,"_28210":53685,"_3064":53686},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3608":952,"_31023":946,"_5":31378,"_21483":53688,"_28210":53689,"_3064":53690},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3608":953,"_31023":946,"_5":31378,"_21483":53692,"_28210":53693,"_3064":53694},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3608":954,"_31023":946,"_5":31378,"_21483":53696,"_28210":53697,"_3064":53698},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3608":955,"_31023":946,"_5":31378,"_21483":53700,"_28210":53701,"_3064":53702},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3608":956,"_31023":946,"_5":31378,"_21483":53704,"_28210":53705,"_3064":53706},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3608":957,"_31023":946,"_5":31378,"_21483":53708,"_28210":53709,"_3064":53710},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3608":958,"_31023":946,"_5":31378,"_21483":53712,"_28210":53713,"_3064":53714},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3608":959,"_31023":946,"_5":31378,"_21483":53716,"_28210":53717,"_3064":53718},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3608":960,"_31023":946,"_5":31378,"_21483":53720,"_28210":53721,"_3064":53722},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3608":961,"_31023":946,"_5":31378,"_21483":53724,"_28210":53725,"_3064":53726},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3608":962,"_31023":946,"_5":31378,"_21483":53728,"_28210":53729,"_3064":53730},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3608":963,"_31023":946,"_5":31378,"_21483":53732,"_28210":53733,"_3064":53734},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3608":964,"_31023":946,"_5":31378,"_21483":53736,"_28210":53737,"_3064":53738},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3608":965,"_31023":946,"_5":31378,"_21483":53740,"_28210":53741,"_3064":53742},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3608":966,"_31023":946,"_21483":53744,"_5":14766,"_28210":946,"_3064":53745},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3608":967,"_31023":946,"_21483":53747,"_5":14766,"_28210":53674,"_3064":53748},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3608":968,"_31023":946,"_21483":53750,"_5":14766,"_28210":53674,"_3064":53751},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3608":969,"_31023":946,"_21483":53753,"_5":14766,"_28210":53681,"_3064":53754},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3608":970,"_31023":946,"_21483":53756,"_5":14766,"_28210":53685,"_3064":53757},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3608":971,"_31023":946,"_21483":53759,"_5":14766,"_28210":53689,"_3064":53760},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3608":972,"_31023":946,"_21483":53762,"_5":14766,"_28210":53693,"_3064":53763},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3608":973,"_31023":946,"_21483":53765,"_5":14766,"_28210":53697,"_3064":53766},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3608":974,"_31023":946,"_21483":53768,"_5":14766,"_28210":53705,"_3064":53769},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3608":975,"_31023":946,"_21483":53771,"_5":14766,"_28210":53705,"_3064":53772},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3608":976,"_31023":946,"_21483":53774,"_5":14766,"_28210":53709,"_3064":53775},[],"`settings.enrollment_settings` field",{"_3608":977,"_31023":946,"_21483":53777,"_5":14766,"_28210":53709,"_3064":53778},[],"Decision",{"_3608":978,"_31023":946,"_21483":53780,"_5":14766,"_28210":53709,"_3064":53781},[],"`protocol`",{"_3608":979,"_31023":946,"_21483":53783,"_5":14766,"_28210":53709,"_3064":53784},[],"`EST_RFC7030` for these operations.",{"_3608":980,"_31023":946,"_21483":53786,"_5":14766,"_28210":53709,"_3064":53787},[],"`enrollment_ca`",{"_3608":981,"_31023":946,"_21483":53789,"_5":14766,"_28210":53709,"_3064":53790},[],"ID of the signing CA.",{"_3608":982,"_31023":946,"_21483":53792,"_5":14766,"_28210":53709,"_3064":53793},[],"`verify_csr_signature`",{"_3608":983,"_31023":946,"_21483":53795,"_5":14766,"_28210":53709,"_3064":53796},[],"Keep `true` to verify CSR key possession.",{"_3608":984,"_31023":946,"_21483":53798,"_5":14766,"_28210":53709,"_3064":53799},[],"`enable_replaceable_enrollment`",{"_3608":985,"_31023":946,"_21483":53801,"_5":14766,"_28210":53709,"_3064":53802},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3608":986,"_31023":946,"_21483":53804,"_5":14766,"_28210":53709,"_3064":53805},[],"`est_rfc7030_settings.auth_mode`",{"_3608":987,"_31023":946,"_21483":53807,"_5":14766,"_28210":53709,"_3064":53808},[],"One of the four authentication modes.",{"_3608":988,"_31023":946,"_21483":53810,"_5":14766,"_28210":53709,"_3064":53811},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3608":989,"_31023":946,"_21483":53813,"_5":14766,"_28210":53713,"_3064":53814},[],"The blocks are independent:",{"_3608":990,"_31023":946,"_21483":53816,"_5":14766,"_28210":53713,"_3064":53817},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3608":991,"_31023":946,"_21483":53819,"_5":14766,"_28210":53713,"_3064":53820},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3608":992,"_31023":946,"_21483":53822,"_5":14766,"_28210":53713,"_3064":53823},[],"`auth_mode`",{"_3608":993,"_31023":946,"_21483":53825,"_5":14766,"_28210":53713,"_3064":53826},[],"Control applied in the configured operation",{"_3608":994,"_31023":946,"_21483":53828,"_5":14766,"_28210":53713,"_3064":53829},[],"`CLIENT_CERTIFICATE`",{"_3608":995,"_31023":946,"_21483":53831,"_5":14766,"_28210":53713,"_3064":53832},[],"Presented certificate validation.",{"_3608":996,"_31023":946,"_21483":53834,"_5":14766,"_28210":53713,"_3064":53835},[],"`EXTERNAL_WEBHOOK`",{"_3608":997,"_31023":946,"_21483":53837,"_5":14766,"_28210":53713,"_3064":53838},[],"Configured webhook authorization.",{"_3608":998,"_31023":946,"_21483":53840,"_5":14766,"_28210":53713,"_3064":53841},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3608":999,"_31023":946,"_21483":53843,"_5":14766,"_28210":53713,"_3064":53844},[],"Certificate validation followed by webhook approval.",{"_3608":1000,"_31023":946,"_21483":53846,"_5":14766,"_28210":53713,"_3064":53847},[],"`NO_AUTH`",{"_3608":1001,"_31023":946,"_21483":53849,"_5":14766,"_28210":53713,"_3064":53850},[],"No DMS requester authentication.",{"_3608":1002,"_31023":946,"_21483":53852,"_5":14766,"_28210":53713,"_3064":53853},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3608":1003,"_31023":946,"_21483":53855,"_5":14766,"_28210":53713,"_3064":53856},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3608":1004,"_31023":946,"_21483":53858,"_5":14766,"_28210":53713,"_3064":53859},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3608":1005,"_31023":946,"_21483":53861,"_5":14766,"_28210":53713,"_3064":53862},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3608":1006,"_31023":946,"_21483":53864,"_5":14766,"_28210":53717,"_3064":53865},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3608":1007,"_31023":946,"_21483":53867,"_5":14766,"_28210":53717,"_3064":53868},[],"`external_webhook_settings` field",{"_3608":1008,"_31023":946,"_21483":53870,"_5":14766,"_28210":53717,"_3064":53778},[],{"_3608":1009,"_31023":946,"_21483":53872,"_5":14766,"_28210":53717,"_3064":53873},[],"`url`",{"_3608":1010,"_31023":946,"_21483":53875,"_5":14766,"_28210":53717,"_3064":53876},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3608":1011,"_31023":946,"_21483":53878,"_5":14766,"_28210":53717,"_3064":53879},[],"`method`",{"_3608":1012,"_31023":946,"_21483":53881,"_5":14766,"_28210":53717,"_3064":53882},[],"`POST` or `PUT`; `POST` by default.",{"_3608":1013,"_31023":946,"_21483":53884,"_5":14766,"_28210":53717,"_3064":53885},[],"`name`",{"_3608":1014,"_31023":946,"_21483":53887,"_5":14766,"_28210":53717,"_3064":53888},[],"Label used in service logs.",{"_3608":1015,"_31023":946,"_21483":53890,"_5":14766,"_28210":53717,"_3064":53891},[],"`config.auth_mode`",{"_3608":1016,"_31023":946,"_21483":53893,"_5":14766,"_28210":53717,"_3064":53894},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3608":1017,"_31023":946,"_21483":53896,"_5":14766,"_28210":53717,"_3064":53897},[],"`config.log_level`",{"_3608":1018,"_31023":946,"_21483":53899,"_5":14766,"_28210":53717,"_3064":53900},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3608":1019,"_31023":946,"_21483":53902,"_5":14766,"_28210":53717,"_3064":53903},[],"`config.apikey_options`",{"_3608":1020,"_31023":946,"_21483":53905,"_5":14766,"_28210":53717,"_3064":53906},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3608":1021,"_31023":946,"_21483":53908,"_5":14766,"_28210":53717,"_3064":53909},[],"`config.jwt_options`",{"_3608":1022,"_31023":946,"_21483":53911,"_5":14766,"_28210":53717,"_3064":53912},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3608":1023,"_31023":946,"_21483":53914,"_5":14766,"_28210":53717,"_3064":53915},[],"`config.mtls_options`",{"_3608":1024,"_31023":946,"_21483":53917,"_5":14766,"_28210":53717,"_3064":53918},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3608":1025,"_31023":946,"_21483":53920,"_5":14766,"_28210":53717,"_3064":53921},[],"`config.insecure_skip_verify`",{"_3608":1026,"_31023":946,"_21483":53923,"_5":14766,"_28210":53717,"_3064":53924},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3608":1027,"_31023":946,"_21483":53926,"_5":14766,"_28210":53717,"_3064":53927},[],"`config.call_timeout`",{"_3608":1028,"_31023":946,"_21483":53929,"_5":14766,"_28210":53717,"_3064":53930},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3608":1029,"_31023":946,"_21483":53932,"_5":14766,"_28210":53717,"_3064":53933},[],"Rules for that configuration:",{"_3608":1030,"_31023":946,"_21483":53935,"_5":14766,"_28210":53717,"_3064":53936},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3608":1031,"_31023":946,"_21483":53938,"_5":14766,"_28210":53717,"_3064":53939},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3608":1032,"_31023":946,"_21483":53941,"_5":14766,"_28210":53717,"_3064":53942},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3608":1033,"_31023":946,"_21483":53944,"_5":14766,"_28210":53717,"_3064":53945},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3608":1034,"_31023":946,"_21483":53947,"_5":14766,"_28210":53717,"_3064":53948},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3608":1035,"_31023":946,"_21483":53950,"_5":14766,"_28210":53717,"_3064":53951},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3608":1036,"_31023":946,"_21483":53953,"_5":14766,"_28210":53717,"_3064":53954},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3608":1037,"_31023":946,"_21483":53956,"_5":14766,"_28210":53717,"_3064":53957},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3608":1038,"_31023":946,"_21483":53959,"_5":14766,"_28210":53717,"_3064":53960},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3608":1039,"_31023":946,"_21483":53962,"_5":14766,"_28210":53721,"_3064":53963},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3608":1040,"_31023":946,"_21483":53965,"_5":14766,"_28210":53725,"_3064":53966},[],"`settings.reenrollment_settings` field",{"_3608":1041,"_31023":946,"_21483":53968,"_5":14766,"_28210":53725,"_3064":51117},[],{"_3608":1042,"_31023":946,"_21483":53970,"_5":14766,"_28210":53725,"_3064":53971},[],"`reenrollment_delta`",{"_3608":1043,"_31023":946,"_21483":53973,"_5":14766,"_28210":53725,"_3064":53974},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3608":1044,"_31023":946,"_21483":53976,"_5":14766,"_28210":53725,"_3064":53977},[],"`preventive_delta`",{"_3608":1045,"_31023":946,"_21483":53979,"_5":14766,"_28210":53725,"_3064":53980},[],"Preventive operational monitoring threshold.",{"_3608":1046,"_31023":946,"_21483":53982,"_5":14766,"_28210":53725,"_3064":53983},[],"`critical_delta`",{"_3608":1047,"_31023":946,"_21483":53985,"_5":14766,"_28210":53725,"_3064":53986},[],"Critical operational monitoring threshold.",{"_3608":1048,"_31023":946,"_21483":53988,"_5":14766,"_28210":53725,"_3064":53989},[],"`enable_expired_renewal`",{"_3608":1049,"_31023":946,"_21483":53991,"_5":14766,"_28210":53725,"_3064":53992},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3608":1050,"_31023":946,"_21483":53994,"_5":14766,"_28210":53725,"_3064":53995},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3608":1051,"_31023":946,"_21483":53997,"_5":14766,"_28210":53725,"_3064":53998},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3608":1052,"_31023":946,"_21483":54000,"_5":14766,"_28210":53725,"_3064":54001},[],"`revoke_on_reenrollment`",{"_3608":1053,"_31023":946,"_21483":54003,"_5":14766,"_28210":53725,"_3064":54004},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3608":1054,"_31023":946,"_21483":54006,"_5":14766,"_28210":53725,"_3064":54007},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3608":1055,"_31023":946,"_21483":54009,"_5":14766,"_28210":53729,"_3064":54010},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3608":1056,"_31023":946,"_21483":54012,"_5":14766,"_28210":53733,"_3064":51111},[],{"_3608":1057,"_31023":946,"_21483":54014,"_5":14766,"_28210":53733,"_3064":54015},[],"Published material",{"_3608":1058,"_31023":946,"_21483":54017,"_5":14766,"_28210":53733,"_3064":54018},[],"**Include Lamassu System CA**",{"_3608":1059,"_31023":946,"_21483":54020,"_5":14766,"_28210":53733,"_3064":54021},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3608":1060,"_31023":946,"_21483":54023,"_5":14766,"_28210":53733,"_3064":54024},[],"**Include Enrollment CA**",{"_3608":1061,"_31023":946,"_21483":54026,"_5":14766,"_28210":53733,"_3064":54027},[],"Selected issuing CA certificate.",{"_3608":1062,"_31023":946,"_21483":54029,"_5":14766,"_28210":53733,"_3064":54030},[],"**Managed CAs**",{"_3608":1063,"_31023":946,"_21483":54032,"_5":14766,"_28210":53733,"_3064":54033},[],"Explicitly selected CA certificates.",{"_3608":1064,"_31023":946,"_21483":54035,"_5":14766,"_28210":53733,"_3064":54036},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3608":1065,"_31023":946,"_21483":54038,"_5":14766,"_28210":53737,"_3064":54039},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3608":1066,"_31023":946,"_21483":54041,"_5":14766,"_28210":53737,"_3064":54042},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3608":1067,"_31023":946,"_21483":54044,"_5":14766,"_28210":53737,"_3064":54045},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3608":1068,"_31023":946,"_21483":54047,"_5":14766,"_28210":53741,"_3064":54048},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3608":1069,"_31023":1069,"_5":15126,"_3064":54050,"_31381":54051,"_21483":54052,"_28210":1069},"Integrate the EST client",[50727,52239,53411,53409,53592],[],{"_3608":1070,"_31023":1069,"_21483":54054,"_5":14766,"_28210":1069,"_3064":54055},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3608":1071,"_31023":1069,"_5":31378,"_21483":54057,"_28210":54058,"_3064":50737},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3608":1072,"_31023":1069,"_5":31378,"_21483":54060,"_28210":54061,"_3064":54062},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3608":1073,"_31023":1069,"_5":31378,"_21483":54064,"_28210":54065,"_3064":54066},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3608":1074,"_31023":1069,"_5":31378,"_21483":54068,"_28210":54069,"_3064":54070},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3608":1075,"_31023":1069,"_5":31378,"_21483":54072,"_28210":54073,"_3064":54074},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3608":1076,"_31023":1069,"_5":31378,"_21483":54076,"_28210":54077,"_3064":54078},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3608":1077,"_31023":1069,"_21483":54080,"_5":14766,"_28210":1069,"_3064":54081},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3608":1078,"_31023":1069,"_21483":54083,"_5":14766,"_28210":54058,"_3064":54084},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3608":1079,"_31023":1069,"_21483":54086,"_5":14766,"_28210":54058,"_3064":54087},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3608":1080,"_31023":1069,"_21483":54089,"_5":14766,"_28210":54058,"_3064":54090},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3608":1081,"_31023":1069,"_21483":54092,"_5":14766,"_28210":54061,"_3064":54093},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3608":1082,"_31023":1069,"_21483":54095,"_5":14766,"_28210":54061,"_3064":54096},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3608":1083,"_31023":1069,"_21483":54098,"_5":14766,"_28210":54065,"_3064":54099},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3608":1084,"_31023":1069,"_21483":54101,"_5":14766,"_28210":54065,"_3064":54102},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3608":1085,"_31023":1069,"_21483":54104,"_5":14766,"_28210":54069,"_3064":54105},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3608":1086,"_31023":1069,"_21483":54107,"_5":14766,"_28210":54069,"_3064":54108},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3608":1087,"_31023":1069,"_21483":54110,"_5":14766,"_28210":54073,"_3064":54111},[],"For a root that issues directly:",{"_3608":1088,"_31023":1069,"_21483":54113,"_5":14766,"_28210":54073,"_3064":54114},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3608":1089,"_31023":1069,"_21483":54116,"_5":14766,"_28210":54073,"_3064":54117},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3608":1090,"_31023":1069,"_21483":54119,"_5":14766,"_28210":54077,"_3064":54120},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3608":1091,"_31023":1091,"_5":15126,"_3064":54122,"_31381":54123,"_21483":54124,"_28210":1091},"EST reference",[50727,52239,53411,53409,53592],[],{"_3608":1092,"_31023":1091,"_21483":54126,"_5":14766,"_28210":1091,"_3064":54127},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3608":1093,"_31023":1091,"_5":31378,"_21483":54129,"_28210":54130,"_3064":54131},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3608":1094,"_31023":1091,"_5":31378,"_21483":54133,"_28210":54134,"_3064":23280},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3608":1095,"_31023":1091,"_5":31378,"_21483":54136,"_28210":54137,"_3064":26756},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3608":1096,"_31023":1091,"_5":31378,"_21483":54139,"_28210":54140,"_3064":26763},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3608":1097,"_31023":1091,"_5":31378,"_21483":54142,"_28210":54143,"_3064":26036},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3608":1098,"_31023":1091,"_5":31378,"_21483":54145,"_28210":54146,"_3064":54147},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3608":1099,"_31023":1091,"_5":31378,"_21483":54149,"_28210":54150,"_3064":54151},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3608":1100,"_31023":1091,"_5":31378,"_21483":54153,"_28210":54154,"_3064":54155},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3608":1101,"_31023":1091,"_21483":54157,"_5":14766,"_28210":1091,"_3064":54158},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3608":1102,"_31023":1091,"_21483":54160,"_5":14766,"_28210":54130,"_3064":54161},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3608":1103,"_31023":1091,"_21483":54163,"_5":14766,"_28210":54130,"_3064":54164},[],"Operation",{"_3608":1104,"_31023":1091,"_21483":54166,"_5":14766,"_28210":54130,"_3064":54167},[],"Method",{"_3608":1105,"_31023":1091,"_21483":54169,"_5":14766,"_28210":54130,"_3064":54170},[],"Authentication and condition",{"_3608":1106,"_31023":1091,"_21483":54172,"_5":14766,"_28210":54130,"_3064":54173},[],"`/cacerts`",{"_3608":1107,"_31023":1091,"_21483":54175,"_5":14766,"_28210":54130,"_3064":54176},[],"GET",{"_3608":1108,"_31023":1091,"_21483":54178,"_5":14766,"_28210":54130,"_3064":54179},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3608":1109,"_31023":1091,"_21483":54181,"_5":14766,"_28210":54130,"_3064":54182},[],"`/simpleenroll`",{"_3608":1110,"_31023":1091,"_21483":54184,"_5":14766,"_28210":54130,"_3064":54185},[],"POST",{"_3608":1111,"_31023":1091,"_21483":54187,"_5":14766,"_28210":54130,"_3064":54188},[],"Initial authentication and DMS registration/replacement policy.",{"_3608":1112,"_31023":1091,"_21483":54190,"_5":14766,"_28210":54130,"_3064":54191},[],"`/simplereenroll`",{"_3608":1113,"_31023":1091,"_21483":54193,"_5":14766,"_28210":54130,"_3064":54185},[],{"_3608":1114,"_31023":1091,"_21483":54195,"_5":14766,"_28210":54130,"_3064":54196},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3608":1115,"_31023":1091,"_21483":54198,"_5":14766,"_28210":54130,"_3064":54199},[],"`/serverkeygen`",{"_3608":1116,"_31023":1091,"_21483":54201,"_5":14766,"_28210":54130,"_3064":54185},[],{"_3608":1117,"_31023":1091,"_21483":54203,"_5":14766,"_28210":54130,"_3064":54204},[],"Initial authentication and admission; server generation enabled.",{"_3608":1118,"_31023":1091,"_21483":54206,"_5":14766,"_28210":54130,"_3064":54207},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3608":1119,"_31023":1091,"_21483":54209,"_5":14766,"_28210":54134,"_3064":54210},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3608":1120,"_31023":1091,"_21483":54212,"_5":14766,"_28210":54134,"_3064":54213},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3608":1121,"_31023":1091,"_21483":54215,"_5":14766,"_28210":54137,"_3064":54216},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3608":1122,"_31023":1091,"_21483":54218,"_5":14766,"_28210":54137,"_3064":54219},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3608":1123,"_31023":1091,"_21483":54221,"_5":14766,"_28210":54140,"_3064":54222},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3608":1124,"_31023":1091,"_21483":54224,"_5":14766,"_28210":54140,"_3064":54225},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3608":1125,"_31023":1091,"_21483":54227,"_5":14766,"_28210":54143,"_3064":54228},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3608":1126,"_31023":1091,"_21483":54230,"_5":14766,"_28210":54143,"_3064":54231},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3608":1127,"_31023":1091,"_21483":54233,"_5":14766,"_28210":54146,"_3064":54234},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3608":1128,"_31023":1091,"_21483":54236,"_5":14766,"_28210":54146,"_3064":54237},[],"Part",{"_3608":1129,"_31023":1091,"_21483":54239,"_5":14766,"_28210":54146,"_3064":54240},[],"Content after decoding its Base64",{"_3608":1130,"_31023":1091,"_21483":54242,"_5":14766,"_28210":54146,"_3064":54243},[],"`application/pkcs8`",{"_3608":1131,"_31023":1091,"_21483":54245,"_5":14766,"_28210":54146,"_3064":54246},[],"Unencrypted DER PKCS#8 private key.",{"_3608":1132,"_31023":1091,"_21483":54248,"_5":14766,"_28210":54146,"_3064":54249},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3608":1133,"_31023":1091,"_21483":54251,"_5":14766,"_28210":54146,"_3064":54252},[],"DER PKCS#7 containing the issued certificate.",{"_3608":1134,"_31023":1091,"_21483":54254,"_5":14766,"_28210":54146,"_3064":54255},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3608":1135,"_31023":1091,"_21483":54257,"_5":14766,"_28210":54150,"_3064":54258},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3608":1136,"_31023":1091,"_21483":54260,"_5":14766,"_28210":54150,"_3064":54261},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3608":1137,"_31023":1091,"_21483":54263,"_5":14766,"_28210":54150,"_3064":54264},[],"Convert and check the result:",{"_3608":1138,"_31023":1091,"_21483":54266,"_5":14766,"_28210":54150,"_3064":54267},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3608":1139,"_31023":1091,"_21483":54269,"_5":14766,"_28210":54154,"_3064":54270},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3608":1140,"_31023":1091,"_21483":54272,"_5":14766,"_28210":54154,"_3064":54273},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3608":1141,"_31023":1141,"_5":15126,"_3064":53592,"_31381":54275,"_21483":54276,"_28210":1141},[50727,52239,53411,53409,53592],[],{"_3608":1142,"_31023":1141,"_21483":54278,"_5":14766,"_28210":1141,"_3064":54279},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3608":1143,"_31023":1141,"_5":31378,"_21483":54281,"_28210":54282,"_3064":54283},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3608":1144,"_31023":1141,"_5":31378,"_21483":54285,"_28210":54286,"_3064":54287},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3608":1145,"_31023":1141,"_5":31378,"_21483":54289,"_28210":54290,"_3064":54291},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3608":1146,"_31023":1141,"_5":31378,"_21483":54293,"_28210":54294,"_3064":54295},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3608":1147,"_31023":1141,"_21483":54297,"_5":14766,"_28210":1141,"_3064":54298},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3608":1148,"_31023":1141,"_21483":54300,"_5":14766,"_28210":54282,"_3064":54301},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3608":1149,"_31023":1141,"_21483":54303,"_5":14766,"_28210":54282,"_3064":54304},[],"The integrator installs initial EST server trust and an admission credential.",{"_3608":1150,"_31023":1141,"_21483":54306,"_5":14766,"_28210":54282,"_3064":54307},[],"The client requests an identity for its `Device ID` through EST.",{"_3608":1151,"_31023":1141,"_21483":54309,"_5":14766,"_28210":54282,"_3064":54310},[],"Certificate, device binding and key/certificate installation are checked.",{"_3608":1152,"_31023":1141,"_21483":54312,"_5":14766,"_28210":54282,"_3064":54313},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3608":1153,"_31023":1141,"_21483":54315,"_5":14766,"_28210":54282,"_3064":54316},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3608":1154,"_31023":1141,"_21483":54318,"_5":14766,"_28210":54286,"_3064":54319},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3608":1155,"_31023":1141,"_21483":54321,"_5":14766,"_28210":54286,"_3064":54322},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3608":1156,"_31023":1141,"_21483":54324,"_5":14766,"_28210":54286,"_3064":54325},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3608":1157,"_31023":1141,"_21483":54327,"_5":14766,"_28210":54286,"_3064":54328},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3608":1158,"_31023":1141,"_21483":54330,"_5":14766,"_28210":54290,"_3064":54331},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3608":1159,"_31023":1141,"_21483":54333,"_5":14766,"_28210":54290,"_3064":54334},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3608":1160,"_31023":1141,"_21483":54336,"_5":14766,"_28210":54290,"_3064":54337},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3608":1161,"_31023":1141,"_21483":54339,"_5":14766,"_28210":54290,"_3064":54340},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3608":1162,"_31023":1141,"_21483":54342,"_5":14766,"_28210":54294,"_3064":54343},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3608":1163,"_31023":1141,"_21483":54345,"_5":14766,"_28210":54294,"_3064":54346},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3608":1164,"_31023":1164,"_5":15126,"_3064":54348,"_31381":54349,"_21483":54350,"_28210":1164},"Provisioning strategies",[50727,52239,53411,53409,53592],[],{"_3608":1165,"_31023":1164,"_21483":54352,"_5":14766,"_28210":1164,"_3064":54353},[],"Choose device registration, identity authorization and key generation.",{"_3608":1166,"_31023":1164,"_5":31378,"_21483":54355,"_28210":54356,"_3064":54357},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3608":1167,"_31023":1164,"_5":31378,"_21483":54359,"_28210":54360,"_3064":54361},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3608":1168,"_31023":1164,"_5":31378,"_21483":54363,"_28210":54364,"_3064":54365},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3608":1169,"_31023":1164,"_5":31378,"_21483":54367,"_28210":54368,"_3064":54369},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3608":1170,"_31023":1164,"_5":31378,"_21483":54371,"_28210":54372,"_3064":54373},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3608":1171,"_31023":1164,"_21483":54375,"_5":14766,"_28210":1164,"_3064":54376},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3608":1172,"_31023":1164,"_21483":54378,"_5":14766,"_28210":54356,"_3064":54379},[],"Path",{"_3608":1173,"_31023":1164,"_21483":54381,"_5":14766,"_28210":54356,"_3064":54382},[],"When the device exists",{"_3608":1174,"_31023":1164,"_21483":54384,"_5":14766,"_28210":54356,"_3064":54385},[],"What to check",{"_3608":1175,"_31023":1164,"_21483":54387,"_5":14766,"_28210":54356,"_3064":54388},[],"Manual assignment",{"_3608":1176,"_31023":1164,"_21483":54390,"_5":14766,"_28210":54356,"_3064":54391},[],"An operator creates it before associating a certificate.",{"_3608":1177,"_31023":1164,"_21483":54393,"_5":14766,"_28210":54356,"_3064":54394},[],"ID, owning DMS, certificate CN and bound serial.",{"_3608":1178,"_31023":1164,"_21483":54396,"_5":14766,"_28210":54356,"_3064":54397},[],"EST with `JITP`",{"_3608":1179,"_31023":1164,"_21483":54399,"_5":14766,"_28210":54356,"_3064":54400},[],"Created for an unknown CN during `/simpleenroll`.",{"_3608":1180,"_31023":1164,"_21483":54402,"_5":14766,"_28210":54356,"_3064":54403},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3608":1181,"_31023":1164,"_21483":54405,"_5":14766,"_28210":54356,"_3064":54406},[],"EST with `PRE_REGISTRATION`",{"_3608":1182,"_31023":1164,"_21483":54408,"_5":14766,"_28210":54356,"_3064":54409},[],"Must exist before `/simpleenroll`.",{"_3608":1183,"_31023":1164,"_21483":54411,"_5":14766,"_28210":54356,"_3064":54412},[],"Approved record, same DMS and replacement conditions for your version.",{"_3608":1184,"_31023":1164,"_21483":54414,"_5":14766,"_28210":54356,"_3064":54415},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3608":1185,"_31023":1164,"_21483":54417,"_5":14766,"_28210":54356,"_3064":54418},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3608":1186,"_31023":1164,"_21483":54420,"_5":14766,"_28210":54360,"_3064":54421},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3608":1187,"_31023":1164,"_21483":54423,"_5":14766,"_28210":54360,"_3064":54424},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3608":1188,"_31023":1164,"_21483":54426,"_5":14766,"_28210":54360,"_3064":54427},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3608":1189,"_31023":1164,"_21483":54429,"_5":14766,"_28210":54364,"_3064":54430},[],"Decide initial enrollment and re-enrollment separately:",{"_3608":1190,"_31023":1164,"_21483":54432,"_5":14766,"_28210":54364,"_3064":54433},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3608":1191,"_31023":1164,"_21483":54435,"_5":14766,"_28210":54364,"_3064":54436},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3608":1192,"_31023":1164,"_21483":54438,"_5":14766,"_28210":54364,"_3064":54439},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3608":1193,"_31023":1164,"_21483":54441,"_5":14766,"_28210":54364,"_3064":54442},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3608":1194,"_31023":1164,"_21483":54444,"_5":14766,"_28210":54364,"_3064":54445},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3608":1195,"_31023":1164,"_21483":54447,"_5":14766,"_28210":54368,"_3064":51111},[],{"_3608":1196,"_31023":1164,"_21483":54449,"_5":14766,"_28210":54368,"_3064":54450},[],"Material crossing EST",{"_3608":1197,"_31023":1164,"_21483":54452,"_5":14766,"_28210":54368,"_3064":54453},[],"Device-generated key",{"_3608":1198,"_31023":1164,"_21483":54455,"_5":14766,"_28210":54368,"_3064":54456},[],"Public CSR and certificate; the key stays on the client.",{"_3608":1199,"_31023":1164,"_21483":54458,"_5":14766,"_28210":54368,"_3064":54459},[],"Existing device key",{"_3608":1200,"_31023":1164,"_21483":54461,"_5":14766,"_28210":54368,"_3064":54462},[],"CSR signed with that key and a new certificate.",{"_3608":1201,"_31023":1164,"_21483":54464,"_5":14766,"_28210":54368,"_3064":53730},[],{"_3608":1202,"_31023":1164,"_21483":54466,"_5":14766,"_28210":54368,"_3064":54467},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3608":1203,"_31023":1164,"_21483":54469,"_5":14766,"_28210":54368,"_3064":54470},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3608":1204,"_31023":1164,"_21483":54472,"_5":14766,"_28210":54372,"_3064":54473},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3608":1205,"_31023":1205,"_5":15126,"_3064":54475,"_31381":54476,"_21483":54477,"_28210":1205},"Renewal and recovery",[50727,52239,53411,53409,53592],[],{"_3608":1206,"_31023":1205,"_21483":54479,"_5":14766,"_28210":1205,"_3064":54480},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3608":1207,"_31023":1205,"_5":31378,"_21483":54482,"_28210":54483,"_3064":54484},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3608":1208,"_31023":1205,"_5":31378,"_21483":54486,"_28210":54487,"_3064":54488},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3608":1209,"_31023":1205,"_5":31378,"_21483":54490,"_28210":54491,"_3064":54492},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3608":1210,"_31023":1205,"_5":31378,"_21483":54494,"_28210":54495,"_3064":54496},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3608":1211,"_31023":1205,"_5":31378,"_21483":54498,"_28210":54499,"_3064":54500},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3608":1212,"_31023":1205,"_21483":54502,"_5":14766,"_28210":1205,"_3064":54503},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3608":1213,"_31023":1205,"_21483":54505,"_5":14766,"_28210":54483,"_3064":54506},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3608":1214,"_31023":1205,"_21483":54508,"_5":14766,"_28210":54483,"_3064":54509},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3608":1215,"_31023":1205,"_21483":54511,"_5":14766,"_28210":54483,"_3064":54512},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3608":1216,"_31023":1205,"_21483":54514,"_5":14766,"_28210":54483,"_3064":54515},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3608":1217,"_31023":1205,"_21483":54517,"_5":14766,"_28210":54487,"_3064":54518},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3608":1218,"_31023":1205,"_21483":54520,"_5":14766,"_28210":54487,"_3064":54521},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3608":1219,"_31023":1205,"_21483":54523,"_5":14766,"_28210":54491,"_3064":54524},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3608":1220,"_31023":1205,"_21483":54526,"_5":14766,"_28210":54491,"_3064":54527},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3608":1221,"_31023":1205,"_21483":54529,"_5":14766,"_28210":54491,"_3064":54530},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3608":1222,"_31023":1205,"_21483":54532,"_5":14766,"_28210":54495,"_3064":54533},[],"Situation",{"_3608":1223,"_31023":1205,"_21483":54535,"_5":14766,"_28210":54495,"_3064":54536},[],"Procedure",{"_3608":1224,"_31023":1205,"_21483":54538,"_5":14766,"_28210":54495,"_3064":54539},[],"Valid certificate, outside the window",{"_3608":1225,"_31023":1205,"_21483":54541,"_5":14766,"_28210":54495,"_3064":54542},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3608":1226,"_31023":1205,"_21483":54544,"_5":14766,"_28210":54495,"_3064":54545},[],"Expired certificate, key available",{"_3608":1227,"_31023":1205,"_21483":54547,"_5":14766,"_28210":54495,"_3064":54548},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3608":1228,"_31023":1205,"_21483":54550,"_5":14766,"_28210":54495,"_3064":54551},[],"Renewal through webhook or `NO_AUTH`",{"_3608":1229,"_31023":1205,"_21483":54553,"_5":14766,"_28210":54495,"_3064":54554},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3608":1230,"_31023":1205,"_21483":54556,"_5":14766,"_28210":54495,"_3064":54557},[],"Lost or inaccessible key",{"_3608":1231,"_31023":1205,"_21483":54559,"_5":14766,"_28210":54495,"_3064":54560},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3608":1232,"_31023":1205,"_21483":54562,"_5":14766,"_28210":54495,"_3064":54563},[],"Current identity revoked",{"_3608":1233,"_31023":1205,"_21483":54565,"_5":14766,"_28210":54495,"_3064":54566},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3608":1234,"_31023":1205,"_21483":54568,"_5":14766,"_28210":54495,"_3064":54569},[],"Device without an identity",{"_3608":1235,"_31023":1205,"_21483":54571,"_5":14766,"_28210":54495,"_3064":54572},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3608":1236,"_31023":1205,"_21483":54574,"_5":14766,"_28210":54495,"_3064":54575},[],"Retired device",{"_3608":1237,"_31023":1205,"_21483":54577,"_5":14766,"_28210":54495,"_3064":54578},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3608":1238,"_31023":1205,"_21483":54580,"_5":14766,"_28210":54495,"_3064":54581},[],"Timeout, HTTP 500 or installation failure",{"_3608":1239,"_31023":1205,"_21483":54583,"_5":14766,"_28210":54495,"_3064":54584},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3608":1240,"_31023":1205,"_21483":54586,"_5":14766,"_28210":54499,"_3064":54587},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3608":1241,"_31023":1205,"_21483":54589,"_5":14766,"_28210":54499,"_3064":54590},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3608":1242,"_31023":1242,"_5":15126,"_3064":54592,"_31381":54593,"_21483":54594,"_28210":1242},"Enrollment troubleshooting",[50727,52239,53411,53409,53592],[],{"_3608":1243,"_31023":1242,"_21483":54596,"_5":14766,"_28210":1242,"_3064":54597},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3608":1244,"_31023":1242,"_5":31378,"_21483":54599,"_28210":54600,"_3064":54601},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3608":1245,"_31023":1242,"_5":31378,"_21483":54603,"_28210":54604,"_3064":54605},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3608":1246,"_31023":1242,"_5":31378,"_21483":54607,"_28210":54608,"_3064":54155},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3608":1247,"_31023":1242,"_5":31378,"_21483":54610,"_28210":54611,"_3064":54612},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3608":1248,"_31023":1242,"_21483":54614,"_5":14766,"_28210":1242,"_3064":54615},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3608":1249,"_31023":1242,"_21483":54617,"_5":14766,"_28210":54604,"_3064":54618},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3608":1250,"_31023":1242,"_21483":54620,"_5":14766,"_28210":54604,"_3064":54621},[],"Symptom or message",{"_3608":1251,"_31023":1242,"_21483":54623,"_5":14766,"_28210":54604,"_3064":54385},[],{"_3608":1252,"_31023":1242,"_21483":54625,"_5":14766,"_28210":54604,"_3064":54626},[],"curl rejects TLS, name or issuer",{"_3608":1253,"_31023":1242,"_21483":54628,"_5":14766,"_28210":54604,"_3064":54629},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3608":1254,"_31023":1242,"_21483":54631,"_5":14766,"_28210":54604,"_3064":54632},[],"404 or missing APS",{"_3608":1255,"_31023":1242,"_21483":54634,"_5":14766,"_28210":54604,"_3064":54635},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3608":1256,"_31023":1242,"_21483":54637,"_5":14766,"_28210":54604,"_3064":54638},[],"400, CSR or format error",{"_3608":1257,"_31023":1242,"_21483":54640,"_5":14766,"_28210":54604,"_3064":54641},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3608":1258,"_31023":1242,"_21483":54643,"_5":14766,"_28210":54604,"_3064":54644},[],"Missing credential or invalid certificate",{"_3608":1259,"_31023":1242,"_21483":54646,"_5":14766,"_28210":54604,"_3064":54647},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3608":1260,"_31023":1242,"_21483":54649,"_5":14766,"_28210":54604,"_3064":54650},[],"Webhook denies, times out or responds without authorization",{"_3608":1261,"_31023":1242,"_21483":54652,"_5":14766,"_28210":54604,"_3064":54653},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3608":1262,"_31023":1242,"_21483":54655,"_5":14766,"_28210":54604,"_3064":54656},[],"`unexpected status code: <n>: redirects are not followed`",{"_3608":1263,"_31023":1242,"_21483":54658,"_5":14766,"_28210":54604,"_3064":54659},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3608":1264,"_31023":1242,"_21483":54661,"_5":14766,"_28210":54604,"_3064":54662},[],"`webhook response exceeds 1048576 bytes`",{"_3608":1265,"_31023":1242,"_21483":54664,"_5":14766,"_28210":54604,"_3064":54665},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3608":1266,"_31023":1242,"_21483":54667,"_5":14766,"_28210":54604,"_3064":54668},[],"`webhook config must not reference files`",{"_3608":1267,"_31023":1242,"_21483":54670,"_5":14766,"_28210":54604,"_3064":54671},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3608":1268,"_31023":1242,"_21483":54673,"_5":14766,"_28210":54604,"_3064":54674},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3608":1269,"_31023":1242,"_21483":54676,"_5":14766,"_28210":54604,"_3064":54677},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3608":1270,"_31023":1242,"_21483":54679,"_5":14766,"_28210":54604,"_3064":54680},[],"`webhook mTLS certificate and key are invalid: …`",{"_3608":1271,"_31023":1242,"_21483":54682,"_5":14766,"_28210":54604,"_3064":54683},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3608":1272,"_31023":1242,"_21483":54685,"_5":14766,"_28210":54604,"_3064":54686},[],"400 `struct validation error` creating or updating a DMS",{"_3608":1273,"_31023":1242,"_21483":54688,"_5":14766,"_28210":54604,"_3064":54689},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3608":1274,"_31023":1242,"_21483":54691,"_5":14766,"_28210":54604,"_3064":54692},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3608":1275,"_31023":1242,"_21483":54694,"_5":14766,"_28210":54604,"_3064":54695},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3608":1276,"_31023":1242,"_21483":54697,"_5":14766,"_28210":54604,"_3064":54698},[],"`device not preregistered`",{"_3608":1277,"_31023":1242,"_21483":54700,"_5":14766,"_28210":54604,"_3064":54701},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3608":1278,"_31023":1242,"_21483":54703,"_5":14766,"_28210":54604,"_3064":54704},[],"`forbiddenNewEnrollment`",{"_3608":1279,"_31023":1242,"_21483":54706,"_5":14766,"_28210":54604,"_3064":54707},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3608":1280,"_31023":1242,"_21483":54709,"_5":14766,"_28210":54604,"_3064":54710},[],"Different owning DMS",{"_3608":1281,"_31023":1242,"_21483":54712,"_5":14766,"_28210":54604,"_3064":54713},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3608":1282,"_31023":1242,"_21483":54715,"_5":14766,"_28210":54604,"_3064":54716},[],"`invalid RawSubject bytes`",{"_3608":1283,"_31023":1242,"_21483":54718,"_5":14766,"_28210":54604,"_3064":54719},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3608":1284,"_31023":1242,"_21483":54721,"_5":14766,"_28210":54604,"_3064":54722},[],"`invalid reenroll window`",{"_3608":1285,"_31023":1242,"_21483":54724,"_5":14766,"_28210":54604,"_3064":54725},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3608":1286,"_31023":1242,"_21483":54727,"_5":14766,"_28210":54604,"_3064":54728},[],"Current certificate revoked",{"_3608":1287,"_31023":1242,"_21483":54730,"_5":14766,"_28210":54604,"_3064":54731},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3608":1288,"_31023":1242,"_21483":54733,"_5":14766,"_28210":54604,"_3064":54734},[],"CA, profile or signing error",{"_3608":1289,"_31023":1242,"_21483":54736,"_5":14766,"_28210":54604,"_3064":54737},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3608":1290,"_31023":1242,"_21483":54739,"_5":14766,"_28210":54604,"_3064":54740},[],"HTTP 200 without a device connection",{"_3608":1291,"_31023":1242,"_21483":54742,"_5":14766,"_28210":54604,"_3064":54743},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3608":1292,"_31023":1242,"_21483":54745,"_5":14766,"_28210":54604,"_3064":54746},[],"Timeout or error after issuance",{"_3608":1293,"_31023":1242,"_21483":54748,"_5":14766,"_28210":54604,"_3064":54749},[],"New certificates, current slot and previous identity's state before retrying.",{"_3608":1294,"_31023":1242,"_21483":54751,"_5":14766,"_28210":54608,"_3064":54752},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3608":1295,"_31023":1242,"_21483":54754,"_5":14766,"_28210":54608,"_3064":54755},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3608":1296,"_31023":1242,"_21483":54757,"_5":14766,"_28210":54611,"_3064":54758},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3608":1297,"_31023":1242,"_21483":54760,"_5":14766,"_28210":54611,"_3064":54761},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3608":1298,"_31023":1242,"_21483":54763,"_5":14766,"_28210":54611,"_3064":54764},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3608":1299,"_31023":1242,"_21483":54766,"_5":14766,"_28210":54611,"_3064":54767},[],"Make one request, save headers/body and query the device and certificates.",{"_3608":1300,"_31023":1242,"_21483":54769,"_5":14766,"_28210":54611,"_3064":54770},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3608":1301,"_31023":1242,"_21483":54772,"_5":14766,"_28210":54611,"_3064":54773},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3608":1302,"_31023":1242,"_21483":54775,"_5":14766,"_28210":54611,"_3064":54776},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3608":1303,"_31023":1303,"_5":15126,"_3064":54778,"_31381":54779,"_21483":54780,"_28210":1303},"Trust distribution and updates",[50727,52239,53411,53409,53592],[],{"_3608":1304,"_31023":1303,"_21483":54782,"_5":14766,"_28210":1303,"_3064":54783},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3608":1305,"_31023":1303,"_5":31378,"_21483":54785,"_28210":54786,"_3064":54787},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3608":1306,"_31023":1303,"_5":31378,"_21483":54789,"_28210":54790,"_3064":54791},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3608":1307,"_31023":1303,"_5":31378,"_21483":54793,"_28210":54794,"_3064":54795},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3608":1308,"_31023":1303,"_5":31378,"_21483":54797,"_28210":54798,"_3064":54799},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3608":1309,"_31023":1303,"_5":31378,"_21483":54801,"_28210":54802,"_3064":54803},[],"/docs/pr-preview/pr-72/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3608":1310,"_31023":1303,"_21483":54805,"_5":14766,"_28210":1303,"_3064":54806},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3608":1311,"_31023":1303,"_21483":54808,"_5":14766,"_28210":54786,"_3064":54809},[],"Relationship",{"_3608":1312,"_31023":1303,"_21483":54811,"_5":14766,"_28210":54786,"_3064":54812},[],"Material prepared by its owner",{"_3608":1313,"_31023":1303,"_21483":54814,"_5":14766,"_28210":54786,"_3064":54815},[],"Device → EST server",{"_3608":1314,"_31023":1303,"_21483":54817,"_5":14766,"_28210":54786,"_3064":54818},[],"Previously verified server root, chain or pin and TLS name.",{"_3608":1315,"_31023":1303,"_21483":54820,"_5":14766,"_28210":54786,"_3064":54821},[],"DMS → requester",{"_3608":1316,"_31023":1303,"_21483":54823,"_5":14766,"_28210":54786,"_3064":54824},[],"CAs and rules authorizing initial or renewal credentials.",{"_3608":1317,"_31023":1303,"_21483":54826,"_5":14766,"_28210":54786,"_3064":54827},[],"Consumer → device",{"_3608":1318,"_31023":1303,"_21483":54829,"_5":14766,"_28210":54786,"_3064":54830},[],"Operational identity roots, intermediates, validation and permissions.",{"_3608":1319,"_31023":1303,"_21483":54832,"_5":14766,"_28210":54786,"_3064":54833},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3608":1320,"_31023":1303,"_21483":54835,"_5":14766,"_28210":54790,"_3064":54836},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3608":1321,"_31023":1303,"_21483":54838,"_5":14766,"_28210":54790,"_3064":54839},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3608":1322,"_31023":1303,"_21483":54841,"_5":14766,"_28210":54794,"_3064":54842},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3608":1323,"_31023":1303,"_21483":54844,"_5":14766,"_28210":54794,"_3064":54845},[],"Select policy-approved roots as anchors.",{"_3608":1324,"_31023":1303,"_21483":54847,"_5":14766,"_28210":54794,"_3064":54848},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3608":1325,"_31023":1303,"_21483":54850,"_5":14766,"_28210":54794,"_3064":54851},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3608":1326,"_31023":1303,"_21483":54853,"_5":14766,"_28210":54794,"_3064":54854},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3608":1327,"_31023":1303,"_21483":54856,"_5":14766,"_28210":54794,"_3064":54857},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3608":1328,"_31023":1303,"_21483":54859,"_5":14766,"_28210":54798,"_3064":54860},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3608":1329,"_31023":1303,"_21483":54862,"_5":14766,"_28210":54798,"_3064":54863},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3608":1330,"_31023":1303,"_21483":54865,"_5":14766,"_28210":54798,"_3064":54866},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3608":1331,"_31023":1303,"_21483":54868,"_5":14766,"_28210":54802,"_3064":54869},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3608":1332,"_31023":1332,"_5":15126,"_3064":54871,"_31381":54872,"_21483":54874,"_28210":1332},"AWS IoT Core",[50727,52239,53411,53409,54873],"Integrations",[],{"_3608":1333,"_31023":1332,"_21483":54876,"_5":14766,"_28210":1332,"_3064":54877},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3608":1334,"_31023":1332,"_5":31378,"_21483":54879,"_28210":54880,"_3064":54881},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3608":1335,"_31023":1332,"_5":31378,"_21483":54883,"_28210":54884,"_3064":54885},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3608":1336,"_31023":1332,"_5":31378,"_21483":54887,"_28210":54888,"_3064":54889},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3608":1337,"_31023":1332,"_5":31378,"_21483":54891,"_28210":54892,"_3064":54893},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3608":1338,"_31023":1332,"_5":31378,"_21483":54895,"_28210":54896,"_3064":54897},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3608":1339,"_31023":1332,"_5":31378,"_21483":54899,"_28210":54900,"_3064":54901},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3608":1340,"_31023":1332,"_5":31378,"_21483":54903,"_28210":54904,"_3064":54905},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3608":1341,"_31023":1332,"_5":31378,"_21483":54907,"_28210":54908,"_3064":54909},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3608":1342,"_31023":1332,"_5":31378,"_21483":54911,"_28210":54912,"_3064":54913},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3608":1343,"_31023":1332,"_5":31378,"_21483":54915,"_28210":54916,"_3064":54917},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3608":1344,"_31023":1332,"_5":31378,"_21483":54919,"_28210":54920,"_3064":54921},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3608":1345,"_31023":1332,"_5":31378,"_21483":54923,"_28210":54924,"_3064":54925},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3608":1346,"_31023":1332,"_5":31378,"_21483":54927,"_28210":54928,"_3064":54929},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3608":1347,"_31023":1332,"_5":31378,"_21483":54931,"_28210":54932,"_3064":54933},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3608":1348,"_31023":1332,"_5":31378,"_21483":54935,"_28210":54936,"_3064":54937},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3608":1349,"_31023":1332,"_5":31378,"_21483":54939,"_28210":54940,"_3064":54941},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3608":1350,"_31023":1332,"_5":31378,"_21483":54943,"_28210":54944,"_3064":54945},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3608":1351,"_31023":1332,"_5":31378,"_21483":54947,"_28210":54948,"_3064":54949},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3608":1352,"_31023":1332,"_5":31378,"_21483":54951,"_28210":54952,"_3064":54953},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3608":1353,"_31023":1332,"_5":31378,"_21483":54955,"_28210":54956,"_3064":54957},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3608":1354,"_31023":1332,"_5":31378,"_21483":54959,"_28210":54960,"_3064":54961},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3608":1355,"_31023":1332,"_5":31378,"_21483":54963,"_28210":54964,"_3064":54965},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3608":1356,"_31023":1332,"_5":31378,"_21483":54967,"_28210":54968,"_3064":54969},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3608":1357,"_31023":1332,"_5":31378,"_21483":54971,"_28210":54972,"_3064":54973},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3608":1358,"_31023":1332,"_5":31378,"_21483":54975,"_28210":54976,"_3064":54977},[],"/docs/pr-preview/pr-72/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3608":1359,"_31023":1332,"_21483":54979,"_5":14766,"_28210":1332,"_3064":54980},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3608":1360,"_31023":1332,"_21483":54982,"_5":14766,"_28210":1332,"_3064":54983},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3608":1361,"_31023":1332,"_21483":54985,"_5":14766,"_28210":1332,"_3064":54986},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3608":1362,"_31023":1332,"_21483":54988,"_5":14766,"_28210":54880,"_3064":54989},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3608":1363,"_31023":1332,"_21483":54991,"_5":14766,"_28210":54880,"_3064":54992},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3608":1364,"_31023":1332,"_21483":54994,"_5":14766,"_28210":54880,"_3064":54995},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3608":1365,"_31023":1332,"_21483":54997,"_5":14766,"_28210":54880,"_3064":54998},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3608":1366,"_31023":1332,"_21483":55000,"_5":14766,"_28210":54884,"_3064":55001},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3608":1367,"_31023":1332,"_21483":55003,"_5":14766,"_28210":54888,"_3064":55004},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3608":1368,"_31023":1332,"_21483":55006,"_5":14766,"_28210":54888,"_3064":55007},[],"IAM action",{"_3608":1369,"_31023":1332,"_21483":55009,"_5":14766,"_28210":54888,"_3064":51117},[],{"_3608":1370,"_31023":1332,"_21483":55011,"_5":14766,"_28210":54888,"_3064":55012},[],"`iot:GetRegistrationCode`",{"_3608":1371,"_31023":1332,"_21483":55014,"_5":14766,"_28210":54888,"_3064":55015},[],"Obtain the verification code for CA registration in the Primary Account",{"_3608":1372,"_31023":1332,"_21483":55017,"_5":14766,"_28210":54888,"_3064":55018},[],"`iot:RegisterCACertificate`",{"_3608":1373,"_31023":1332,"_21483":55020,"_5":14766,"_28210":54888,"_3064":55021},[],"Register the CA in AWS IoT",{"_3608":1374,"_31023":1332,"_21483":55023,"_5":14766,"_28210":54888,"_3064":55024},[],"`iot:DescribeCACertificate`",{"_3608":1375,"_31023":1332,"_21483":55026,"_5":14766,"_28210":54888,"_3064":55027},[],"Check the CA registration status",{"_3608":1376,"_31023":1332,"_21483":55029,"_5":14766,"_28210":54888,"_3064":55030},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3608":1377,"_31023":1332,"_21483":55032,"_5":14766,"_28210":54888,"_3064":55033},[],"Create or update Things in IoT Core",{"_3608":1378,"_31023":1332,"_21483":55035,"_5":14766,"_28210":54888,"_3064":55036},[],"`iot:RegisterThing`",{"_3608":1379,"_31023":1332,"_21483":55038,"_5":14766,"_28210":54888,"_3064":55039},[],"Provision Things through a template",{"_3608":1380,"_31023":1332,"_21483":55041,"_5":14766,"_28210":54888,"_3064":55042},[],"`iot:RegisterCertificate`",{"_3608":1381,"_31023":1332,"_21483":55044,"_5":14766,"_28210":54888,"_3064":55045},[],"Register device certificates",{"_3608":1382,"_31023":1332,"_21483":55047,"_5":14766,"_28210":54888,"_3064":55048},[],"`iot:UpdateCertificate`",{"_3608":1383,"_31023":1332,"_21483":55050,"_5":14766,"_28210":54888,"_3064":55051},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3608":1384,"_31023":1332,"_21483":55053,"_5":14766,"_28210":54888,"_3064":55054},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3608":1385,"_31023":1332,"_21483":55056,"_5":14766,"_28210":54888,"_3064":55057},[],"Create and attach IoT policies",{"_3608":1386,"_31023":1332,"_21483":55059,"_5":14766,"_28210":54888,"_3064":55060},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3608":1387,"_31023":1332,"_21483":55062,"_5":14766,"_28210":54888,"_3064":55063},[],"Manage Thing groups",{"_3608":1388,"_31023":1332,"_21483":55065,"_5":14766,"_28210":54888,"_3064":55066},[],"`iot:CreateProvisioningTemplate`",{"_3608":1389,"_31023":1332,"_21483":55068,"_5":14766,"_28210":54888,"_3064":55069},[],"Create JITP templates",{"_3608":1390,"_31023":1332,"_21483":55071,"_5":14766,"_28210":54888,"_3064":55072},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3608":1391,"_31023":1332,"_21483":55074,"_5":14766,"_28210":54888,"_3064":55075},[],"Read and write the Device Shadow",{"_3608":1392,"_31023":1332,"_21483":55077,"_5":14766,"_28210":54888,"_3064":55078},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3608":1393,"_31023":1332,"_21483":55080,"_5":14766,"_28210":54892,"_3064":55081},[],"Parameter",{"_3608":1394,"_31023":1332,"_21483":55083,"_5":14766,"_28210":54892,"_3064":55084},[],"Type",{"_3608":1395,"_31023":1332,"_21483":55086,"_5":14766,"_28210":54892,"_3064":55087},[],"Required",{"_3608":1396,"_31023":1332,"_21483":55089,"_5":14766,"_28210":54892,"_3064":55090},[],"Description",{"_3608":1397,"_31023":1332,"_21483":55092,"_5":14766,"_28210":54892,"_3064":55093},[],"`connector_id`",{"_3608":1398,"_31023":1332,"_21483":55095,"_5":14766,"_28210":54892,"_3064":25646},[],{"_3608":1399,"_31023":1332,"_21483":55097,"_5":14766,"_28210":54892,"_3064":55098},[],"Yes",{"_3608":1400,"_31023":1332,"_21483":55100,"_5":14766,"_28210":54892,"_3064":55101},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3608":1401,"_31023":1332,"_21483":55103,"_5":14766,"_28210":54892,"_3064":55104},[],"`aws_config.region`",{"_3608":1402,"_31023":1332,"_21483":55106,"_5":14766,"_28210":54892,"_3064":25646},[],{"_3608":1403,"_31023":1332,"_21483":55108,"_5":14766,"_28210":54892,"_3064":55098},[],{"_3608":1404,"_31023":1332,"_21483":55110,"_5":14766,"_28210":54892,"_3064":55111},[],"AWS region where the connector operates.",{"_3608":1405,"_31023":1332,"_21483":55113,"_5":14766,"_28210":54892,"_3064":55114},[],"`aws_config.auth_method`",{"_3608":1406,"_31023":1332,"_21483":55116,"_5":14766,"_28210":54892,"_3064":25646},[],{"_3608":1407,"_31023":1332,"_21483":55118,"_5":14766,"_28210":54892,"_3064":55098},[],{"_3608":1408,"_31023":1332,"_21483":55120,"_5":14766,"_28210":54892,"_3064":55121},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3608":1409,"_31023":1332,"_21483":55123,"_5":14766,"_28210":54892,"_3064":55124},[],"`aws_config.access_key_id`",{"_3608":1410,"_31023":1332,"_21483":55126,"_5":14766,"_28210":54892,"_3064":25646},[],{"_3608":1411,"_31023":1332,"_21483":55128,"_5":14766,"_28210":54892,"_3064":55129},[],"Only with `auth_method=static`",{"_3608":1412,"_31023":1332,"_21483":55131,"_5":14766,"_28210":54892,"_3064":55132},[],"AWS access key.",{"_3608":1413,"_31023":1332,"_21483":55134,"_5":14766,"_28210":54892,"_3064":55135},[],"`aws_config.secret_access_key`",{"_3608":1414,"_31023":1332,"_21483":55137,"_5":14766,"_28210":54892,"_3064":25646},[],{"_3608":1415,"_31023":1332,"_21483":55139,"_5":14766,"_28210":54892,"_3064":55129},[],{"_3608":1416,"_31023":1332,"_21483":55141,"_5":14766,"_28210":54892,"_3064":55142},[],"AWS secret key.",{"_3608":1417,"_31023":1332,"_21483":55144,"_5":14766,"_28210":54892,"_3064":55145},[],"`aws_config.session_token`",{"_3608":1418,"_31023":1332,"_21483":55147,"_5":14766,"_28210":54892,"_3064":25646},[],{"_3608":1419,"_31023":1332,"_21483":55149,"_5":14766,"_28210":54892,"_3064":55150},[],"No",{"_3608":1420,"_31023":1332,"_21483":55152,"_5":14766,"_28210":54892,"_3064":55153},[],"Session token (with `auth_method=static`).",{"_3608":1421,"_31023":1332,"_21483":55155,"_5":14766,"_28210":54892,"_3064":55156},[],"`aws_config.role_arn`",{"_3608":1422,"_31023":1332,"_21483":55158,"_5":14766,"_28210":54892,"_3064":25646},[],{"_3608":1423,"_31023":1332,"_21483":55160,"_5":14766,"_28210":54892,"_3064":55161},[],"Only with `auth_method=role`",{"_3608":1424,"_31023":1332,"_21483":55163,"_5":14766,"_28210":54892,"_3064":55164},[],"ARN of the role to assume.",{"_3608":1425,"_31023":1332,"_21483":55166,"_5":14766,"_28210":54892,"_3064":55167},[],"`aws_config.endpoint_url`",{"_3608":1426,"_31023":1332,"_21483":55169,"_5":14766,"_28210":54892,"_3064":25646},[],{"_3608":1427,"_31023":1332,"_21483":55171,"_5":14766,"_28210":54892,"_3064":55150},[],{"_3608":1428,"_31023":1332,"_21483":55173,"_5":14766,"_28210":54892,"_3064":55174},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3608":1429,"_31023":1332,"_21483":55176,"_5":14766,"_28210":54892,"_3064":55177},[],"`subscriber_event_bus`",{"_3608":1430,"_31023":1332,"_21483":55179,"_5":14766,"_28210":54892,"_3064":18084},[],{"_3608":1431,"_31023":1332,"_21483":55181,"_5":14766,"_28210":54892,"_3064":55098},[],{"_3608":1432,"_31023":1332,"_21483":55183,"_5":14766,"_28210":54892,"_3064":55184},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3608":1433,"_31023":1332,"_21483":55186,"_5":14766,"_28210":54892,"_3064":55187},[],"`dms_manager_client`",{"_3608":1434,"_31023":1332,"_21483":55189,"_5":14766,"_28210":54892,"_3064":25646},[],{"_3608":1435,"_31023":1332,"_21483":55191,"_5":14766,"_28210":54892,"_3064":55098},[],{"_3608":1436,"_31023":1332,"_21483":55193,"_5":14766,"_28210":54892,"_3064":55194},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3608":1437,"_31023":1332,"_21483":55196,"_5":14766,"_28210":54892,"_3064":55197},[],"`device_manager_client`",{"_3608":1438,"_31023":1332,"_21483":55199,"_5":14766,"_28210":54892,"_3064":25646},[],{"_3608":1439,"_31023":1332,"_21483":55201,"_5":14766,"_28210":54892,"_3064":55098},[],{"_3608":1440,"_31023":1332,"_21483":55203,"_5":14766,"_28210":54892,"_3064":55204},[],"HTTP URL of Lamassu's Device Manager.",{"_3608":1441,"_31023":1332,"_21483":55206,"_5":14766,"_28210":54892,"_3064":55207},[],"`ca_client`",{"_3608":1442,"_31023":1332,"_21483":55209,"_5":14766,"_28210":54892,"_3064":25646},[],{"_3608":1443,"_31023":1332,"_21483":55211,"_5":14766,"_28210":54892,"_3064":55098},[],{"_3608":1444,"_31023":1332,"_21483":55213,"_5":14766,"_28210":54892,"_3064":55214},[],"HTTP URL of Lamassu's CA service.",{"_3608":1445,"_31023":1332,"_21483":55216,"_5":14766,"_28210":54896,"_3064":55217},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3608":1446,"_31023":1332,"_21483":55219,"_5":14766,"_28210":54896,"_3064":55220},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3608":1447,"_31023":1332,"_21483":55222,"_5":14766,"_28210":54896,"_3064":55223},[],"CloudEvent type",{"_3608":1448,"_31023":1332,"_21483":55225,"_5":14766,"_28210":54896,"_3064":55226},[],"Lamassu resource",{"_3608":1449,"_31023":1332,"_21483":55228,"_5":14766,"_28210":54896,"_3064":55229},[],"AWS Resource",{"_3608":1450,"_31023":1332,"_21483":55231,"_5":14766,"_28210":54896,"_3064":55232},[],"IAM actions",{"_3608":1451,"_31023":1332,"_21483":55234,"_5":14766,"_28210":54896,"_3064":55235},[],"AWS calls and effect",{"_3608":1452,"_31023":1332,"_21483":55237,"_5":14766,"_28210":54896,"_3064":55238},[],"Where in this page",{"_3608":1453,"_31023":1332,"_21483":55240,"_5":14766,"_28210":54896,"_3064":55241},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3608":1454,"_31023":1332,"_21483":55243,"_5":14766,"_28210":54896,"_3064":55244},[],"CA",{"_3608":1455,"_31023":1332,"_21483":55246,"_5":14766,"_28210":54896,"_3064":55247},[],"`IoTCore/CACertificate`",{"_3608":1456,"_31023":1332,"_21483":55249,"_5":14766,"_28210":54896,"_3064":55250},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3608":1457,"_31023":1332,"_21483":55252,"_5":14766,"_28210":54896,"_3064":55253},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3608":1458,"_31023":1332,"_21483":55255,"_5":14766,"_28210":54896,"_3064":54909},[],{"_3608":1459,"_31023":1332,"_21483":55257,"_5":14766,"_28210":54896,"_3064":55258},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3608":1460,"_31023":1332,"_21483":55260,"_5":14766,"_28210":54896,"_3064":55261},[],"DMS",{"_3608":1461,"_31023":1332,"_21483":55263,"_5":14766,"_28210":54896,"_3064":55264},[],"`IoTCore/ProvisioningTemplate`",{"_3608":1462,"_31023":1332,"_21483":55266,"_5":14766,"_28210":54896,"_3064":55267},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3608":1463,"_31023":1332,"_21483":55269,"_5":14766,"_28210":54896,"_3064":55270},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3608":1464,"_31023":1332,"_21483":55272,"_5":14766,"_28210":54896,"_3064":54937},[],{"_3608":1465,"_31023":1332,"_21483":55274,"_5":14766,"_28210":54896,"_3064":55275},[],"`EventBindDeviceIdentityKey`",{"_3608":1466,"_31023":1332,"_21483":55277,"_5":14766,"_28210":54896,"_3064":55278},[],"Device",{"_3608":1467,"_31023":1332,"_21483":55280,"_5":14766,"_28210":54896,"_3064":55281},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3608":1468,"_31023":1332,"_21483":55283,"_5":14766,"_28210":54896,"_3064":55284},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3608":1469,"_31023":1332,"_21483":55286,"_5":14766,"_28210":54896,"_3064":55287},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3608":1470,"_31023":1332,"_21483":55289,"_5":14766,"_28210":54896,"_3064":54945},[],{"_3608":1471,"_31023":1332,"_21483":55291,"_5":14766,"_28210":54896,"_3064":55292},[],"`EventUpdateCertificateStatusKey`",{"_3608":1472,"_31023":1332,"_21483":55294,"_5":14766,"_28210":54896,"_3064":55295},[],"Certificate",{"_3608":1473,"_31023":1332,"_21483":55297,"_5":14766,"_28210":54896,"_3064":55298},[],"`IoTCore/Certificate`",{"_3608":1474,"_31023":1332,"_21483":55300,"_5":14766,"_28210":54896,"_3064":55301},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3608":1475,"_31023":1332,"_21483":55303,"_5":14766,"_28210":54896,"_3064":55304},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3608":1476,"_31023":1332,"_21483":55306,"_5":14766,"_28210":54896,"_3064":54957},[],{"_3608":1477,"_31023":1332,"_21483":55308,"_5":14766,"_28210":54896,"_3064":55309},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3608":1478,"_31023":1332,"_21483":55311,"_5":14766,"_28210":54896,"_3064":55312},[],"Certificate / Device",{"_3608":1479,"_31023":1332,"_21483":55314,"_5":14766,"_28210":54896,"_3064":55315},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3608":1480,"_31023":1332,"_21483":55317,"_5":14766,"_28210":54896,"_3064":51123},[],{"_3608":1481,"_31023":1332,"_21483":55319,"_5":14766,"_28210":54896,"_3064":55320},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3608":1482,"_31023":1332,"_21483":55322,"_5":14766,"_28210":54896,"_3064":54965},[],{"_3608":1483,"_31023":1332,"_21483":55324,"_5":14766,"_28210":54900,"_3064":55325},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3608":1484,"_31023":1332,"_21483":55327,"_5":14766,"_28210":54904,"_3064":55328},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3608":1485,"_31023":1332,"_21483":55330,"_5":14766,"_28210":54904,"_3064":55331},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3608":1486,"_31023":1332,"_21483":55333,"_5":14766,"_28210":54908,"_3064":55334},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3608":1487,"_31023":1332,"_21483":55336,"_5":14766,"_28210":54908,"_3064":55337},[],"Transition",{"_3608":1488,"_31023":1332,"_21483":55339,"_5":14766,"_28210":54908,"_3064":55340},[],"AWS calls",{"_3608":1489,"_31023":1332,"_21483":55342,"_5":14766,"_28210":54908,"_3064":55343},[],"`NotRegistered` → `Requested`",{"_3608":1490,"_31023":1332,"_21483":55345,"_5":14766,"_28210":54908,"_3064":55346},[],"none (metadata write only)",{"_3608":1491,"_31023":1332,"_21483":55348,"_5":14766,"_28210":54908,"_3064":55349},[],"`Requested` → `Registering`",{"_3608":1492,"_31023":1332,"_21483":55351,"_5":14766,"_28210":54908,"_3064":55352},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3608":1493,"_31023":1332,"_21483":55354,"_5":14766,"_28210":54908,"_3064":55355},[],"`Registering` → `Succeeded`",{"_3608":1494,"_31023":1332,"_21483":55357,"_5":14766,"_28210":54908,"_3064":55358},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3608":1495,"_31023":1332,"_21483":55360,"_5":14766,"_28210":54908,"_3064":55361},[],"`Registering` → `Failed`",{"_3608":1496,"_31023":1332,"_21483":55363,"_5":14766,"_28210":54908,"_3064":55364},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3608":1497,"_31023":1332,"_21483":55366,"_5":14766,"_28210":54908,"_3064":55367},[],"`Failed` / `Succeeded` → `Requested`",{"_3608":1498,"_31023":1332,"_21483":55369,"_5":14766,"_28210":54908,"_3064":55370},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3608":1499,"_31023":1332,"_21483":55372,"_5":14766,"_28210":54912,"_3064":55373},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3608":1500,"_31023":1332,"_21483":55375,"_5":14766,"_28210":54912,"_3064":55376},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3608":1501,"_31023":1332,"_21483":55378,"_5":14766,"_28210":54912,"_3064":55379},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3608":1502,"_31023":1332,"_21483":55381,"_5":14766,"_28210":54912,"_3064":55382},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3608":1503,"_31023":1332,"_21483":55384,"_5":14766,"_28210":54912,"_3064":55385},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3608":1504,"_31023":1332,"_21483":55387,"_5":14766,"_28210":54912,"_3064":55388},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3608":1505,"_31023":1332,"_21483":55390,"_5":14766,"_28210":54916,"_3064":55391},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3608":1506,"_31023":1332,"_21483":55393,"_5":14766,"_28210":54920,"_3064":55394},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3608":1507,"_31023":1332,"_21483":55396,"_5":14766,"_28210":54920,"_3064":55397},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3608":1508,"_31023":1332,"_21483":55399,"_5":14766,"_28210":54924,"_3064":55400},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3608":1509,"_31023":1332,"_21483":55402,"_5":14766,"_28210":54928,"_3064":55403},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3608":1510,"_31023":1332,"_21483":55405,"_5":14766,"_28210":54928,"_3064":55406},[],"Creates or updates the IoT policies configured in the DMS.",{"_3608":1511,"_31023":1332,"_21483":55408,"_5":14766,"_28210":54928,"_3064":55409},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3608":1512,"_31023":1332,"_21483":55411,"_5":14766,"_28210":54928,"_3064":55412},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3608":1513,"_31023":1332,"_21483":55414,"_5":14766,"_28210":54928,"_3064":55415},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3608":1514,"_31023":1332,"_21483":55417,"_5":14766,"_28210":54928,"_3064":55418},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3608":1515,"_31023":1332,"_21483":55420,"_5":14766,"_28210":54928,"_3064":55421},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3608":1516,"_31023":1332,"_21483":55423,"_5":14766,"_28210":54932,"_3064":55424},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3608":1517,"_31023":1332,"_21483":55426,"_5":14766,"_28210":54932,"_3064":55427},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3608":1518,"_31023":1332,"_21483":55429,"_5":14766,"_28210":54932,"_3064":55430},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3608":1519,"_31023":1332,"_21483":55432,"_5":14766,"_28210":54932,"_3064":55433},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3608":1520,"_31023":1332,"_21483":55435,"_5":14766,"_28210":54932,"_3064":55436},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3608":1521,"_31023":1332,"_21483":55438,"_5":14766,"_28210":54936,"_3064":55439},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3608":1522,"_31023":1332,"_21483":55441,"_5":14766,"_28210":54936,"_3064":55337},[],{"_3608":1523,"_31023":1332,"_21483":55443,"_5":14766,"_28210":54936,"_3064":55340},[],{"_3608":1524,"_31023":1332,"_21483":55445,"_5":14766,"_28210":54936,"_3064":55446},[],"`Unconfigured` → `None` / `Auto`",{"_3608":1525,"_31023":1332,"_21483":55448,"_5":14766,"_28210":54936,"_3064":55449},[],"none (configuration only)",{"_3608":1526,"_31023":1332,"_21483":55451,"_5":14766,"_28210":54936,"_3064":55452},[],"`None` ↔ `Auto`",{"_3608":1527,"_31023":1332,"_21483":55454,"_5":14766,"_28210":54936,"_3064":55449},[],{"_3608":1528,"_31023":1332,"_21483":55456,"_5":14766,"_28210":54936,"_3064":55457},[],"Any → `Jitp`",{"_3608":1529,"_31023":1332,"_21483":55459,"_5":14766,"_28210":54936,"_3064":55460},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3608":1530,"_31023":1332,"_21483":55462,"_5":14766,"_28210":54936,"_3064":55463},[],"`Jitp` → `None` / `Auto`",{"_3608":1531,"_31023":1332,"_21483":55465,"_5":14766,"_28210":54936,"_3064":55466},[],"none (the template stays in the AWS account)",{"_3608":1532,"_31023":1332,"_21483":55468,"_5":14766,"_28210":54940,"_3064":55469},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3608":1533,"_31023":1332,"_21483":55471,"_5":14766,"_28210":54940,"_3064":55472},[],"The full flow from the device's perspective is:",{"_3608":1534,"_31023":1332,"_21483":55474,"_5":14766,"_28210":54940,"_3064":55475},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3608":1535,"_31023":1332,"_21483":55477,"_5":14766,"_28210":54944,"_3064":55478},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3608":1536,"_31023":1332,"_21483":55480,"_5":14766,"_28210":54944,"_3064":55337},[],{"_3608":1537,"_31023":1332,"_21483":55482,"_5":14766,"_28210":54944,"_3064":55340},[],{"_3608":1538,"_31023":1332,"_21483":55484,"_5":14766,"_28210":54944,"_3064":55485},[],"`Absent` → `Provisioned`",{"_3608":1539,"_31023":1332,"_21483":55487,"_5":14766,"_28210":54944,"_3064":55488},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3608":1540,"_31023":1332,"_21483":55490,"_5":14766,"_28210":54944,"_3064":55491},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3608":1541,"_31023":1332,"_21483":55493,"_5":14766,"_28210":54944,"_3064":55494},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3608":1542,"_31023":1332,"_21483":55496,"_5":14766,"_28210":54944,"_3064":55497},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3608":1543,"_31023":1332,"_21483":55499,"_5":14766,"_28210":54948,"_3064":55500},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3608":1544,"_31023":1332,"_21483":55502,"_5":14766,"_28210":54948,"_3064":55503},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3608":1545,"_31023":1332,"_21483":55505,"_5":14766,"_28210":54948,"_3064":55506},[],"For the JITP flow to work correctly:",{"_3608":1546,"_31023":1332,"_21483":55508,"_5":14766,"_28210":54948,"_3064":55509},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3608":1547,"_31023":1332,"_21483":55511,"_5":14766,"_28210":54948,"_3064":55512},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3608":1548,"_31023":1332,"_21483":55514,"_5":14766,"_28210":54948,"_3064":55515},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3608":1549,"_31023":1332,"_21483":55517,"_5":14766,"_28210":54948,"_3064":55518},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3608":1550,"_31023":1332,"_21483":55520,"_5":14766,"_28210":54952,"_3064":55521},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3608":1551,"_31023":1332,"_21483":55523,"_5":14766,"_28210":54952,"_3064":55524},[],"Status in Lamassu",{"_3608":1552,"_31023":1332,"_21483":55526,"_5":14766,"_28210":54952,"_3064":55527},[],"Revocation reason",{"_3608":1553,"_31023":1332,"_21483":55529,"_5":14766,"_28210":54952,"_3064":55530},[],"Status in AWS IoT Core",{"_3608":1554,"_31023":1332,"_21483":55532,"_5":14766,"_28210":54952,"_3064":55533},[],"`Active`",{"_3608":1555,"_31023":1332,"_21483":55535,"_5":14766,"_28210":54952,"_3064":55536},[],"None",{"_3608":1556,"_31023":1332,"_21483":55538,"_5":14766,"_28210":54952,"_3064":55539},[],"`ACTIVE`",{"_3608":1557,"_31023":1332,"_21483":55541,"_5":14766,"_28210":54952,"_3064":55542},[],"`Revoked`",{"_3608":1558,"_31023":1332,"_21483":55544,"_5":14766,"_28210":54952,"_3064":55545},[],"`certificateHold`",{"_3608":1559,"_31023":1332,"_21483":55547,"_5":14766,"_28210":54952,"_3064":55548},[],"`INACTIVE`",{"_3608":1560,"_31023":1332,"_21483":55550,"_5":14766,"_28210":54952,"_3064":55542},[],{"_3608":1561,"_31023":1332,"_21483":55552,"_5":14766,"_28210":54952,"_3064":55553},[],"Any other reason",{"_3608":1562,"_31023":1332,"_21483":55555,"_5":14766,"_28210":54952,"_3064":55556},[],"`REVOKED`",{"_3608":1563,"_31023":1332,"_21483":55558,"_5":14766,"_28210":54952,"_3064":55559},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3608":1564,"_31023":1332,"_21483":55561,"_5":14766,"_28210":54956,"_3064":55562},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3608":1565,"_31023":1332,"_21483":55564,"_5":14766,"_28210":54956,"_3064":55337},[],{"_3608":1566,"_31023":1332,"_21483":55566,"_5":14766,"_28210":54956,"_3064":55340},[],{"_3608":1567,"_31023":1332,"_21483":55568,"_5":14766,"_28210":54956,"_3064":55569},[],"`NotSynced` → `Active`",{"_3608":1568,"_31023":1332,"_21483":55571,"_5":14766,"_28210":54956,"_3064":55048},[],{"_3608":1569,"_31023":1332,"_21483":55573,"_5":14766,"_28210":54956,"_3064":55574},[],"`Active` → `Inactive`",{"_3608":1570,"_31023":1332,"_21483":55576,"_5":14766,"_28210":54956,"_3064":55577},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3608":1571,"_31023":1332,"_21483":55579,"_5":14766,"_28210":54956,"_3064":55580},[],"`Active` → `Revoked`",{"_3608":1572,"_31023":1332,"_21483":55582,"_5":14766,"_28210":54956,"_3064":55577},[],{"_3608":1573,"_31023":1332,"_21483":55584,"_5":14766,"_28210":54956,"_3064":55585},[],"`Inactive` / `Revoked` → `Active`",{"_3608":1574,"_31023":1332,"_21483":55587,"_5":14766,"_28210":54956,"_3064":55048},[],{"_3608":1575,"_31023":1332,"_21483":55589,"_5":14766,"_28210":54956,"_3064":55590},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3608":1576,"_31023":1332,"_21483":55592,"_5":14766,"_28210":54956,"_3064":55593},[],"none (these states are not synced to AWS)",{"_3608":1577,"_31023":1332,"_21483":55595,"_5":14766,"_28210":54960,"_3064":55596},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3608":1578,"_31023":1332,"_21483":55598,"_5":14766,"_28210":54960,"_3064":55599},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3608":1579,"_31023":1332,"_21483":55601,"_5":14766,"_28210":54960,"_3064":55602},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3608":1580,"_31023":1332,"_21483":55604,"_5":14766,"_28210":54964,"_3064":55605},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3608":1581,"_31023":1332,"_21483":55607,"_5":14766,"_28210":54964,"_3064":55608},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3608":1582,"_31023":1332,"_21483":55610,"_5":14766,"_28210":54968,"_3064":55611},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3608":1583,"_31023":1332,"_21483":55613,"_5":14766,"_28210":54968,"_3064":55614},[],"There are two action types:",{"_3608":1584,"_31023":1332,"_21483":55616,"_5":14766,"_28210":54968,"_3064":55617},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3608":1585,"_31023":1332,"_21483":55619,"_5":14766,"_28210":54968,"_3064":55620},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3608":1586,"_31023":1332,"_21483":55622,"_5":14766,"_28210":54968,"_3064":55623},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3608":1587,"_31023":1332,"_21483":55625,"_5":14766,"_28210":54972,"_3064":55626},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3608":1588,"_31023":1332,"_21483":55628,"_5":14766,"_28210":54972,"_3064":55629},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3608":1589,"_31023":1332,"_21483":55631,"_5":14766,"_28210":54972,"_3064":55632},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3608":1590,"_31023":1332,"_21483":55634,"_5":14766,"_28210":54976,"_3064":55635},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3608":1591,"_31023":1332,"_21483":55637,"_5":14766,"_28210":54976,"_3064":55638},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3608":1592,"_31023":1332,"_21483":55640,"_5":14766,"_28210":54976,"_3064":55641},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3608":1593,"_31023":1332,"_21483":55643,"_5":14766,"_28210":54976,"_3064":55644},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3608":1594,"_31023":1332,"_21483":55646,"_5":14766,"_28210":54976,"_3064":55647},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3608":1595,"_31023":1332,"_21483":55649,"_5":14766,"_28210":54976,"_3064":55650},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3608":1596,"_31023":1332,"_21483":55652,"_5":14766,"_28210":54976,"_3064":55653},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3608":1597,"_31023":1332,"_21483":55655,"_5":14766,"_28210":54976,"_3064":55656},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3608":1598,"_31023":1332,"_21483":55658,"_5":14766,"_28210":54976,"_3064":55659},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3608":1599,"_31023":1332,"_21483":55661,"_5":14766,"_28210":54976,"_3064":55662},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3608":1600,"_31023":1332,"_21483":55664,"_5":14766,"_28210":54976,"_3064":55665},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3608":1601,"_31023":1332,"_21483":55667,"_5":14766,"_28210":54976,"_3064":55668},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3608":1602,"_31023":1332,"_21483":55670,"_5":14766,"_28210":54976,"_3064":55671},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3608":1603,"_31023":1332,"_21483":55673,"_5":14766,"_28210":54976,"_3064":55674},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3608":1604,"_31023":1332,"_21483":55676,"_5":14766,"_28210":54976,"_3064":55677},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3608":1605,"_31023":1332,"_21483":55679,"_5":14766,"_28210":54976,"_3064":55680},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3608":1606,"_31023":1332,"_21483":55682,"_5":14766,"_28210":54976,"_3064":55683},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3608":1607,"_31023":1332,"_21483":55685,"_5":14766,"_28210":54976,"_3064":55686},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3608":1608,"_31023":1332,"_21483":55688,"_5":14766,"_28210":54976,"_3064":55689},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3608":1609,"_31023":1332,"_21483":55691,"_5":14766,"_28210":54976,"_3064":55692},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3608":1610,"_31023":1332,"_21483":55694,"_5":14766,"_28210":54976,"_3064":55695},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3608":1611,"_31023":1332,"_21483":55697,"_5":14766,"_28210":54976,"_3064":55698},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3608":1612,"_31023":1332,"_21483":55700,"_5":14766,"_28210":54976,"_3064":55701},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3608":1613,"_31023":1332,"_21483":55703,"_5":14766,"_28210":54976,"_3064":55704},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3608":1614,"_31023":1614,"_5":15126,"_3064":53411,"_31381":55706,"_21483":55707,"_28210":1614},[50727,52239,53411],[],{"_3608":1615,"_31023":1614,"_21483":55709,"_5":14766,"_28210":1614,"_3064":55710},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3608":1616,"_31023":1614,"_5":31378,"_21483":55712,"_28210":55713,"_3064":55714},[],"/docs/pr-preview/pr-72/platform/iot-fleets/overview#start-here","Start here",{"_3608":1617,"_31023":1614,"_5":31378,"_21483":55716,"_28210":55717,"_3064":53409},[],"/docs/pr-preview/pr-72/platform/iot-fleets/overview#devices-and-identities",{"_3608":1618,"_31023":1614,"_5":31378,"_21483":55719,"_28210":55720,"_3064":53592},[],"/docs/pr-preview/pr-72/platform/iot-fleets/overview#enrollment-with-pki",{"_3608":1619,"_31023":1614,"_5":31378,"_21483":55722,"_28210":55723,"_3064":54873},[],"/docs/pr-preview/pr-72/platform/iot-fleets/overview#integrations",{"_3608":1620,"_31023":1614,"_5":31378,"_21483":55725,"_28210":55726,"_3064":55727},[],"/docs/pr-preview/pr-72/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3608":1621,"_31023":1614,"_21483":55729,"_5":14766,"_28210":1614,"_3064":55730},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3608":1622,"_31023":1614,"_21483":55732,"_5":14766,"_28210":55713,"_3064":55733},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3608":1623,"_31023":1614,"_21483":55735,"_5":14766,"_28210":55713,"_3064":55736},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3608":1624,"_31023":1614,"_21483":55738,"_5":14766,"_28210":55717,"_3064":55739},[],"Resource",{"_3608":1625,"_31023":1614,"_21483":55741,"_5":14766,"_28210":55717,"_3064":55742},[],"What it represents",{"_3608":1626,"_31023":1614,"_21483":55744,"_5":14766,"_28210":55717,"_3064":55745},[],"**Device**",{"_3608":1627,"_31023":1614,"_21483":55747,"_5":14766,"_28210":55717,"_3064":55748},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3608":1628,"_31023":1614,"_21483":55750,"_5":14766,"_28210":55717,"_3064":55751},[],"**Identity**",{"_3608":1629,"_31023":1614,"_21483":55753,"_5":14766,"_28210":55717,"_3064":55754},[],"The device's association with its certificates: an active version and a history.",{"_3608":1630,"_31023":1614,"_21483":55756,"_5":14766,"_28210":55717,"_3064":55757},[],"**DMS**",{"_3608":1631,"_31023":1614,"_21483":55759,"_5":14766,"_28210":55717,"_3064":55760},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3608":1632,"_31023":1614,"_21483":55762,"_5":14766,"_28210":55717,"_3064":55763},[],"**Fleet**",{"_3608":1633,"_31023":1614,"_21483":55765,"_5":14766,"_28210":55717,"_3064":55766},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3608":1634,"_31023":1614,"_21483":55768,"_5":14766,"_28210":55717,"_3064":55769},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3608":1635,"_31023":1614,"_21483":55771,"_5":14766,"_28210":55717,"_3064":55772},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3608":1636,"_31023":1614,"_21483":55774,"_5":14766,"_28210":55720,"_3064":55775},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3608":1637,"_31023":1614,"_21483":55777,"_5":14766,"_28210":55720,"_3064":55778},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3608":1638,"_31023":1614,"_21483":55780,"_5":14766,"_28210":55720,"_3064":55781},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3608":1639,"_31023":1614,"_21483":55783,"_5":14766,"_28210":55720,"_3064":55784},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3608":1640,"_31023":1614,"_21483":55786,"_5":14766,"_28210":55720,"_3064":55787},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3608":1641,"_31023":1614,"_21483":55789,"_5":14766,"_28210":55720,"_3064":55790},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3608":1642,"_31023":1614,"_21483":55792,"_5":14766,"_28210":55720,"_3064":55793},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3608":1643,"_31023":1614,"_21483":55795,"_5":14766,"_28210":55720,"_3064":55796},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3608":1644,"_31023":1614,"_21483":55798,"_5":14766,"_28210":55723,"_3064":55799},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3608":1645,"_31023":1614,"_21483":55801,"_5":14766,"_28210":55723,"_3064":55802},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3608":1646,"_31023":1614,"_21483":55804,"_5":14766,"_28210":55726,"_3064":55805},[],"Participant",{"_3608":1647,"_31023":1614,"_21483":55807,"_5":14766,"_28210":55726,"_3064":55808},[],"Responsibility",{"_3608":1648,"_31023":1614,"_21483":55810,"_5":14766,"_28210":55726,"_3064":55811},[],"PKI administrator",{"_3608":1649,"_31023":1614,"_21483":55813,"_5":14766,"_28210":55726,"_3064":55814},[],"CA, issuance profile, chain and revocation publication.",{"_3608":1650,"_31023":1614,"_21483":55816,"_5":14766,"_28210":55726,"_3064":55817},[],"Provisioning administrator",{"_3608":1651,"_31023":1614,"_21483":55819,"_5":14766,"_28210":55726,"_3064":55820},[],"DMS, admission, authentication per operation and inventory.",{"_3608":1652,"_31023":1614,"_21483":55822,"_5":14766,"_28210":55726,"_3064":55823},[],"Device integrator",{"_3608":1653,"_31023":1614,"_21483":55825,"_5":14766,"_28210":55726,"_3064":55826},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3608":1654,"_31023":1614,"_21483":55828,"_5":14766,"_28210":55726,"_3064":55829},[],"Consumer integrator",{"_3608":1655,"_31023":1614,"_21483":55831,"_5":14766,"_28210":55726,"_3064":55832},[],"Trusted issuers, validation and device permissions in the destination.",{"_3608":1656,"_31023":1614,"_21483":55834,"_5":14766,"_28210":55726,"_3064":55835},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3608":1657,"_31023":1657,"_5":15126,"_3064":55837,"_31381":55838,"_21483":55840,"_28210":1657},"Enroll and connect your first device",[50727,52239,53411,55839],"Getting started",[],{"_3608":1658,"_31023":1657,"_21483":55842,"_5":14766,"_28210":1657,"_3064":55843},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3608":1659,"_31023":1657,"_5":31378,"_21483":55845,"_28210":55846,"_3064":50737},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3608":1660,"_31023":1657,"_5":31378,"_21483":55848,"_28210":55849,"_3064":55850},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3608":1661,"_31023":1657,"_5":31378,"_21483":55852,"_28210":55853,"_3064":55854},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3608":1662,"_31023":1657,"_5":31378,"_21483":55856,"_28210":55857,"_3064":55858},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3608":1663,"_31023":1657,"_5":31378,"_21483":55860,"_28210":55861,"_3064":55862},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3608":1664,"_31023":1657,"_5":31378,"_21483":55864,"_28210":55865,"_3064":55866},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3608":1665,"_31023":1657,"_5":31378,"_21483":55868,"_28210":55869,"_3064":55870},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3608":1666,"_31023":1657,"_5":31378,"_21483":55872,"_28210":55873,"_3064":55874},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3608":1667,"_31023":1657,"_21483":55876,"_5":14766,"_28210":1657,"_3064":55877},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3608":1668,"_31023":1657,"_21483":55879,"_5":14766,"_28210":55846,"_3064":55880},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3608":1669,"_31023":1657,"_21483":55882,"_5":14766,"_28210":55846,"_3064":55883},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3608":1670,"_31023":1657,"_21483":55885,"_5":14766,"_28210":55846,"_3064":55886},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3608":1671,"_31023":1657,"_21483":55888,"_5":14766,"_28210":55846,"_3064":55889},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3608":1672,"_31023":1657,"_21483":55891,"_5":14766,"_28210":55846,"_3064":55892},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3608":1673,"_31023":1657,"_21483":55894,"_5":14766,"_28210":55849,"_3064":55895},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3608":1674,"_31023":1657,"_21483":55897,"_5":14766,"_28210":55849,"_3064":55898},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3608":1675,"_31023":1657,"_21483":55900,"_5":14766,"_28210":55853,"_3064":55901},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3608":1676,"_31023":1657,"_21483":55903,"_5":14766,"_28210":55853,"_3064":55904},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3608":1677,"_31023":1657,"_21483":55906,"_5":14766,"_28210":55853,"_3064":55907},[],"Setting",{"_3608":1678,"_31023":1657,"_21483":55909,"_5":14766,"_28210":55853,"_3064":55910},[],"Evaluation value",{"_3608":1679,"_31023":1657,"_21483":55912,"_5":14766,"_28210":55853,"_3064":55913},[],"Enrollment CA",{"_3608":1680,"_31023":1657,"_21483":55915,"_5":14766,"_28210":55853,"_3064":55916},[],"Issuing root from `device-root.pem`.",{"_3608":1681,"_31023":1657,"_21483":55918,"_5":14766,"_28210":55853,"_3064":53722},[],{"_3608":1682,"_31023":1657,"_21483":55920,"_5":14766,"_28210":55853,"_3064":55921},[],"The 1-hour leaf profile you just prepared.",{"_3608":1683,"_31023":1657,"_21483":55923,"_5":14766,"_28210":55853,"_3064":55924},[],"Protocol / Registration Mode",{"_3608":1684,"_31023":1657,"_21483":55926,"_5":14766,"_28210":55853,"_3064":55927},[],"`EST_RFC7030` / `JITP`.",{"_3608":1685,"_31023":1657,"_21483":55929,"_5":14766,"_28210":55853,"_3064":55930},[],"Verify CSR Signature",{"_3608":1686,"_31023":1657,"_21483":55932,"_5":14766,"_28210":55853,"_3064":55933},[],"Enabled.",{"_3608":1687,"_31023":1657,"_21483":55935,"_5":14766,"_28210":55853,"_3064":55936},[],"Enable Replaceable Enrollment",{"_3608":1688,"_31023":1657,"_21483":55938,"_5":14766,"_28210":55853,"_3064":55939},[],"Disabled; the ID must be new.",{"_3608":1689,"_31023":1657,"_21483":55941,"_5":14766,"_28210":55853,"_3064":55942},[],"Initial authentication",{"_3608":1690,"_31023":1657,"_21483":55944,"_5":14766,"_28210":55853,"_3064":55945},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3608":1691,"_31023":1657,"_21483":55947,"_5":14766,"_28210":55853,"_3064":55948},[],"Renewal authentication",{"_3608":1692,"_31023":1657,"_21483":55950,"_5":14766,"_28210":55853,"_3064":55951},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3608":1693,"_31023":1657,"_21483":55953,"_5":14766,"_28210":55853,"_3064":55954},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3608":1694,"_31023":1657,"_21483":55956,"_5":14766,"_28210":55853,"_3064":55957},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3608":1695,"_31023":1657,"_21483":55959,"_5":14766,"_28210":55853,"_3064":55960},[],"Re-enrollment Delta",{"_3608":1696,"_31023":1657,"_21483":55962,"_5":14766,"_28210":55853,"_3064":55963},[],"1 hour.",{"_3608":1697,"_31023":1657,"_21483":55965,"_5":14766,"_28210":55853,"_3064":55966},[],"Preventive / Critical Delta",{"_3608":1698,"_31023":1657,"_21483":55968,"_5":14766,"_28210":55853,"_3064":55969},[],"30 minutes / 10 minutes.",{"_3608":1699,"_31023":1657,"_21483":55971,"_5":14766,"_28210":55853,"_3064":55972},[],"Revoke on Re-enrollment",{"_3608":1700,"_31023":1657,"_21483":55974,"_5":14766,"_28210":55853,"_3064":55975},[],"Disabled to test the successor before retiring the previous identity.",{"_3608":1701,"_31023":1657,"_21483":55977,"_5":14766,"_28210":55853,"_3064":53730},[],{"_3608":1702,"_31023":1657,"_21483":55979,"_5":14766,"_28210":55853,"_3064":55980},[],"Disabled; the operational key is generated in the client.",{"_3608":1703,"_31023":1657,"_21483":55982,"_5":14766,"_28210":55853,"_3064":55983},[],"CA Distribution",{"_3608":1704,"_31023":1657,"_21483":55985,"_5":14766,"_28210":55853,"_3064":55986},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3608":1705,"_31023":1657,"_21483":55988,"_5":14766,"_28210":55853,"_3064":55989},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3608":1706,"_31023":1657,"_21483":55991,"_5":14766,"_28210":55857,"_3064":55992},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3608":1707,"_31023":1657,"_21483":55994,"_5":14766,"_28210":55857,"_3064":55995},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3608":1708,"_31023":1657,"_21483":55997,"_5":14766,"_28210":55861,"_3064":55998},[],"Generate a new key and CSR with the selected identifier:",{"_3608":1709,"_31023":1657,"_21483":56000,"_5":14766,"_28210":55861,"_3064":56001},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3608":1710,"_31023":1657,"_21483":56003,"_5":14766,"_28210":55861,"_3064":56004},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3608":1711,"_31023":1657,"_21483":56006,"_5":14766,"_28210":55865,"_3064":56007},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3608":1712,"_31023":1657,"_21483":56009,"_5":14766,"_28210":55865,"_3064":56010},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3608":1713,"_31023":1657,"_21483":56012,"_5":14766,"_28210":55869,"_3064":56013},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3608":1714,"_31023":1657,"_21483":56015,"_5":14766,"_28210":55869,"_3064":56016},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3608":1715,"_31023":1657,"_21483":56018,"_5":14766,"_28210":55869,"_3064":56019},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3608":1716,"_31023":1657,"_21483":56021,"_5":14766,"_28210":55869,"_3064":56022},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3608":1717,"_31023":1657,"_21483":56024,"_5":14766,"_28210":55869,"_3064":56025},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3608":1718,"_31023":1657,"_21483":56027,"_5":14766,"_28210":55873,"_3064":56028},[],"Check",{"_3608":1719,"_31023":1657,"_21483":56030,"_5":14766,"_28210":55873,"_3064":56031},[],"Expected result",{"_3608":1720,"_31023":1657,"_21483":56033,"_5":14766,"_28210":55873,"_3064":56034},[],"Registration",{"_3608":1721,"_31023":1657,"_21483":56036,"_5":14766,"_28210":55873,"_3064":56037},[],"ID created automatically and correct DMS.",{"_3608":1722,"_31023":1657,"_21483":56039,"_5":14766,"_28210":55873,"_3064":55295},[],{"_3608":1723,"_31023":1657,"_21483":56041,"_5":14766,"_28210":55873,"_3064":56042},[],"CN, profile, serial and key verified.",{"_3608":1724,"_31023":1657,"_21483":56044,"_5":14766,"_28210":55873,"_3064":56045},[],"Inventory",{"_3608":1725,"_31023":1657,"_21483":56047,"_5":14766,"_28210":55873,"_3064":56048},[],"Received serial visible as the current identity and in history.",{"_3608":1726,"_31023":1657,"_21483":56050,"_5":14766,"_28210":55873,"_3064":56051},[],"Consumer",{"_3608":1727,"_31023":1657,"_21483":56053,"_5":14766,"_28210":55873,"_3064":56054},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3608":1728,"_31023":1657,"_21483":56056,"_5":14766,"_28210":55873,"_3064":56057},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3608":1729,"_31023":1657,"_21483":56059,"_5":14766,"_28210":55873,"_3064":56060},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3608":1730,"_31023":1730,"_5":15126,"_3064":53427,"_31381":56062,"_21483":56063,"_28210":1730},[50727,52239,53411,55839],[],{"_3608":1731,"_31023":1730,"_21483":56065,"_5":14766,"_28210":1730,"_3064":56066},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3608":1732,"_31023":1730,"_5":31378,"_21483":56068,"_28210":56069,"_3064":50737},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3608":1733,"_31023":1730,"_5":31378,"_21483":56071,"_28210":56072,"_3064":56073},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3608":1734,"_31023":1730,"_5":31378,"_21483":56075,"_28210":56076,"_3064":56077},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3608":1735,"_31023":1730,"_5":31378,"_21483":56079,"_28210":56080,"_3064":56081},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3608":1736,"_31023":1730,"_5":31378,"_21483":56083,"_28210":56084,"_3064":56085},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3608":1737,"_31023":1730,"_5":31378,"_21483":56087,"_28210":56088,"_3064":56089},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3608":1738,"_31023":1730,"_5":31378,"_21483":56091,"_28210":56092,"_3064":56031},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3608":1739,"_31023":1730,"_5":31378,"_21483":56094,"_28210":56095,"_3064":56096},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3608":1740,"_31023":1730,"_5":31378,"_21483":56098,"_28210":56099,"_3064":56100},[],"/docs/pr-preview/pr-72/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3608":1741,"_31023":1730,"_21483":56102,"_5":14766,"_28210":1730,"_3064":56103},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3608":1742,"_31023":1730,"_21483":56105,"_5":14766,"_28210":1730,"_3064":56106},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3608":1743,"_31023":1730,"_21483":56108,"_5":14766,"_28210":56069,"_3064":56109},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3608":1744,"_31023":1730,"_21483":56111,"_5":14766,"_28210":56069,"_3064":56112},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3608":1745,"_31023":1730,"_21483":56114,"_5":14766,"_28210":56069,"_3064":56115},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3608":1746,"_31023":1730,"_21483":56117,"_5":14766,"_28210":56069,"_3064":56118},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3608":1747,"_31023":1730,"_21483":56120,"_5":14766,"_28210":56072,"_3064":56121},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3608":1748,"_31023":1730,"_21483":56123,"_5":14766,"_28210":56072,"_3064":56124},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3608":1749,"_31023":1730,"_21483":56126,"_5":14766,"_28210":56072,"_3064":56127},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3608":1750,"_31023":1730,"_21483":56129,"_5":14766,"_28210":56072,"_3064":56130},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3608":1751,"_31023":1730,"_21483":56132,"_5":14766,"_28210":56072,"_3064":56133},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3608":1752,"_31023":1730,"_21483":56135,"_5":14766,"_28210":56072,"_3064":56136},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3608":1753,"_31023":1730,"_21483":56138,"_5":14766,"_28210":56072,"_3064":56139},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3608":1754,"_31023":1730,"_21483":56141,"_5":14766,"_28210":56072,"_3064":56142},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3608":1755,"_31023":1730,"_21483":56144,"_5":14766,"_28210":56076,"_3064":56145},[],"Open **Managed Devices** and the registration action. Complete:",{"_3608":1756,"_31023":1730,"_21483":56147,"_5":14766,"_28210":56076,"_3064":56148},[],"**Device ID**: `device-001`.",{"_3608":1757,"_31023":1730,"_21483":56150,"_5":14766,"_28210":56076,"_3064":56151},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3608":1758,"_31023":1730,"_21483":56153,"_5":14766,"_28210":56076,"_3064":56154},[],"**Icon** and **Tags**: optional classification.",{"_3608":1759,"_31023":1730,"_21483":56156,"_5":14766,"_28210":56076,"_3064":56157},[],"Confirm registration.",{"_3608":1760,"_31023":1730,"_21483":56159,"_5":14766,"_28210":56080,"_3064":56160},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3608":1761,"_31023":1730,"_21483":56162,"_5":14766,"_28210":56080,"_3064":56163},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3608":1762,"_31023":1730,"_21483":56165,"_5":14766,"_28210":56084,"_3064":56166},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3608":1763,"_31023":1730,"_21483":56168,"_5":14766,"_28210":56084,"_3064":56169},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3608":1764,"_31023":1730,"_21483":56171,"_5":14766,"_28210":56088,"_3064":56172},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3608":1765,"_31023":1730,"_21483":56174,"_5":14766,"_28210":56088,"_3064":56175},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3608":1766,"_31023":1730,"_21483":56177,"_5":14766,"_28210":56092,"_3064":56028},[],{"_3608":1767,"_31023":1730,"_21483":56179,"_5":14766,"_28210":56092,"_3064":56180},[],"Result",{"_3608":1768,"_31023":1730,"_21483":56182,"_5":14766,"_28210":56092,"_3064":55278},[],{"_3608":1769,"_31023":1730,"_21483":56184,"_5":14766,"_28210":56092,"_3064":56185},[],"`device-001` appears in inventory with the expected DMS.",{"_3608":1770,"_31023":1730,"_21483":56187,"_5":14766,"_28210":56092,"_3064":56188},[],"Current identity",{"_3608":1771,"_31023":1730,"_21483":56190,"_5":14766,"_28210":56092,"_3064":56191},[],"The associated certificate matches the one you verified in PKI.",{"_3608":1772,"_31023":1730,"_21483":56193,"_5":14766,"_28210":56092,"_3064":56194},[],"History",{"_3608":1773,"_31023":1730,"_21483":56196,"_5":14766,"_28210":56092,"_3064":56197},[],"The associated issuance appears with its serial number and dates.",{"_3608":1774,"_31023":1730,"_21483":56199,"_5":14766,"_28210":56092,"_3064":56200},[],"Key and certificate",{"_3608":1775,"_31023":1730,"_21483":56202,"_5":14766,"_28210":56092,"_3064":56203},[],"You have the verified pair ready to install on the device.",{"_3608":1776,"_31023":1730,"_21483":56205,"_5":14766,"_28210":56095,"_3064":56206},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3608":1777,"_31023":1730,"_21483":56208,"_5":14766,"_28210":56095,"_3064":56209},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3608":1778,"_31023":1730,"_21483":56211,"_5":14766,"_28210":56095,"_3064":56212},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3608":1779,"_31023":1730,"_21483":56214,"_5":14766,"_28210":56095,"_3064":56215},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3608":1780,"_31023":1730,"_21483":56217,"_5":14766,"_28210":56099,"_3064":56218},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3608":1781,"_31023":1730,"_21483":56220,"_5":14766,"_28210":56099,"_3064":56221},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3608":1782,"_31023":1730,"_21483":56223,"_5":14766,"_28210":56099,"_3064":56224},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3608":1783,"_31023":1783,"_5":15126,"_3064":56226,"_31381":56227,"_21483":56228,"_28210":1783},"Lamassu IoT Platform",[50727,52239],[],{"_3608":1784,"_31023":1783,"_21483":56230,"_5":14766,"_28210":1783,"_3064":56231},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3608":1785,"_31023":1783,"_5":31378,"_21483":56233,"_28210":56234,"_3064":55714},[],"/docs/pr-preview/pr-72/platform/overview#start-here",{"_3608":1786,"_31023":1783,"_5":31378,"_21483":56236,"_28210":56237,"_3064":56238},[],"/docs/pr-preview/pr-72/platform/overview#choose-your-path","Choose your path",{"_3608":1787,"_31023":1783,"_5":31378,"_21483":56240,"_28210":56241,"_3064":56242},[],"/docs/pr-preview/pr-72/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3608":1788,"_31023":1783,"_5":31378,"_21483":56244,"_28210":56245,"_3064":56246},[],"/docs/pr-preview/pr-72/platform/overview#core-capabilities","Core capabilities",{"_3608":1789,"_31023":1783,"_5":31378,"_21483":56248,"_28210":56249,"_3064":56250},[],"/docs/pr-preview/pr-72/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3608":1790,"_31023":1783,"_5":31378,"_21483":56252,"_28210":56253,"_3064":56254},[],"/docs/pr-preview/pr-72/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3608":1791,"_31023":1783,"_5":31378,"_21483":56256,"_28210":56257,"_3064":56258},[],"/docs/pr-preview/pr-72/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3608":1792,"_31023":1783,"_5":31378,"_21483":56260,"_28210":56261,"_3064":56262},[],"/docs/pr-preview/pr-72/platform/overview#automate-device-identities","Automate device identities",{"_3608":1793,"_31023":1783,"_5":31378,"_21483":56264,"_28210":56265,"_3064":56266},[],"/docs/pr-preview/pr-72/platform/overview#publish-validation-status","Publish validation status",{"_3608":1794,"_31023":1783,"_5":31378,"_21483":56268,"_28210":56269,"_3064":56270},[],"/docs/pr-preview/pr-72/platform/overview#react-to-events","React to events",{"_3608":1795,"_31023":1783,"_5":31378,"_21483":56272,"_28210":56273,"_3064":56274},[],"/docs/pr-preview/pr-72/platform/overview#operational-reference","Operational reference",{"_3608":1796,"_31023":1783,"_21483":56276,"_5":14766,"_28210":1783,"_3064":56277},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3608":1797,"_31023":1783,"_21483":56279,"_5":14766,"_28210":56234,"_3064":56280},[],"Choose the result you need:",{"_3608":1798,"_31023":1783,"_21483":56282,"_5":14766,"_28210":56234,"_3064":56283},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3608":1799,"_31023":1783,"_21483":56285,"_5":14766,"_28210":56234,"_3064":56286},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3608":1800,"_31023":1783,"_21483":56288,"_5":14766,"_28210":56234,"_3064":56289},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3608":1801,"_31023":1783,"_21483":56291,"_5":14766,"_28210":56237,"_3064":56292},[],"Section",{"_3608":1802,"_31023":1783,"_21483":56294,"_5":14766,"_28210":56237,"_3064":56295},[],"What you manage",{"_3608":1803,"_31023":1783,"_21483":56297,"_5":14766,"_28210":56237,"_3064":56298},[],"Entry point",{"_3608":1804,"_31023":1783,"_21483":56300,"_5":14766,"_28210":56237,"_3064":56301},[],"**PKI**",{"_3608":1805,"_31023":1783,"_21483":56303,"_5":14766,"_28210":56237,"_3064":56304},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3608":1806,"_31023":1783,"_21483":56306,"_5":14766,"_28210":56237,"_3064":56307},[],"PKI overview",{"_3608":1807,"_31023":1783,"_21483":56309,"_5":14766,"_28210":56237,"_3064":56310},[],"**IoT Fleets**",{"_3608":1808,"_31023":1783,"_21483":56312,"_5":14766,"_28210":56237,"_3064":56313},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3608":1809,"_31023":1783,"_21483":56315,"_5":14766,"_28210":56237,"_3064":56316},[],"IoT Fleets overview",{"_3608":1810,"_31023":1783,"_21483":56318,"_5":14766,"_28210":56237,"_3064":56319},[],"**Administration**",{"_3608":1811,"_31023":1783,"_21483":56321,"_5":14766,"_28210":56237,"_3064":56322},[],"Operator permissions, audit and event subscriptions.",{"_3608":1812,"_31023":1783,"_21483":56324,"_5":14766,"_28210":56237,"_3064":52241},[],{"_3608":1813,"_31023":1783,"_21483":56326,"_5":14766,"_28210":56237,"_3064":56327},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3608":1814,"_31023":1783,"_21483":56329,"_5":14766,"_28210":56241,"_3064":56330},[],"An identity's journey connects four responsibilities:",{"_3608":1815,"_31023":1783,"_21483":56332,"_5":14766,"_28210":56241,"_3064":56333},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3608":1816,"_31023":1783,"_21483":56335,"_5":14766,"_28210":56241,"_3064":56336},[],"The provisioning administrator configures the DMS and initial trust.",{"_3608":1817,"_31023":1783,"_21483":56338,"_5":14766,"_28210":56241,"_3064":56339},[],"The device client requests a certificate and installs it with the matching key.",{"_3608":1818,"_31023":1783,"_21483":56341,"_5":14766,"_28210":56241,"_3064":56342},[],"The consumer validates the identity and applies its access permissions.",{"_3608":1819,"_31023":1783,"_21483":56344,"_5":14766,"_28210":56241,"_3064":56345},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3608":1820,"_31023":1783,"_21483":56347,"_5":14766,"_28210":56249,"_3064":56348},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3608":1821,"_31023":1783,"_21483":56350,"_5":14766,"_28210":56253,"_3064":56351},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3608":1822,"_31023":1783,"_21483":56353,"_5":14766,"_28210":56257,"_3064":56354},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3608":1823,"_31023":1783,"_21483":56356,"_5":14766,"_28210":56261,"_3064":56357},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3608":1824,"_31023":1783,"_21483":56359,"_5":14766,"_28210":56265,"_3064":56360},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3608":1825,"_31023":1783,"_21483":56362,"_5":14766,"_28210":56269,"_3064":56363},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3608":1826,"_31023":1783,"_21483":56365,"_5":14766,"_28210":56273,"_3064":55808},[],{"_3608":1827,"_31023":1783,"_21483":56367,"_5":14766,"_28210":56273,"_3064":56368},[],"What it prepares or checks",{"_3608":1828,"_31023":1783,"_21483":56370,"_5":14766,"_28210":56273,"_3064":55811},[],{"_3608":1829,"_31023":1783,"_21483":56372,"_5":14766,"_28210":56273,"_3064":56373},[],"Key custody, CA hierarchy, profiles and validation.",{"_3608":1830,"_31023":1783,"_21483":56375,"_5":14766,"_28210":56273,"_3064":56376},[],"Fleet administrator",{"_3608":1831,"_31023":1783,"_21483":56378,"_5":14766,"_28210":56273,"_3064":56379},[],"DMS, device admission, renewal policy and inventory.",{"_3608":1832,"_31023":1783,"_21483":56381,"_5":14766,"_28210":56273,"_3064":55823},[],{"_3608":1833,"_31023":1783,"_21483":56383,"_5":14766,"_28210":56273,"_3064":56384},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3608":1834,"_31023":1783,"_21483":56386,"_5":14766,"_28210":56273,"_3064":55829},[],{"_3608":1835,"_31023":1783,"_21483":56388,"_5":14766,"_28210":56273,"_3064":56389},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3608":1836,"_31023":1783,"_21483":56391,"_5":14766,"_28210":56273,"_3064":56392},[],"Infrastructure operator",{"_3608":1837,"_31023":1783,"_21483":56394,"_5":14766,"_28210":56273,"_3064":56395},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3608":1838,"_31023":1783,"_21483":56397,"_5":14766,"_28210":56273,"_3064":56398},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3608":1839,"_31023":1839,"_5":15126,"_3064":56400,"_31381":56401,"_21483":56404,"_28210":1839},"CA hierarchy and rotation",[50727,52239,56402,56403],"PKI","Keys, authorities and certificates",[],{"_3608":1840,"_31023":1839,"_21483":56406,"_5":14766,"_28210":1839,"_3064":56407},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3608":1841,"_31023":1839,"_5":31378,"_21483":56409,"_28210":56410,"_3064":56411},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3608":1842,"_31023":1839,"_5":31378,"_21483":56413,"_28210":56414,"_3064":56415},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3608":1843,"_31023":1839,"_5":31378,"_21483":56417,"_28210":56418,"_3064":56419},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3608":1844,"_31023":1839,"_5":31378,"_21483":56421,"_28210":56422,"_3064":56423},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3608":1845,"_31023":1839,"_5":31378,"_21483":56425,"_28210":56426,"_3064":56427},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3608":1846,"_31023":1839,"_5":31378,"_21483":56429,"_28210":56430,"_3064":56431},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3608":1847,"_31023":1839,"_5":31378,"_21483":56433,"_28210":56434,"_3064":56435},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3608":1848,"_31023":1839,"_5":31378,"_21483":56437,"_28210":56438,"_3064":56439},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3608":1849,"_31023":1839,"_5":31378,"_21483":56441,"_28210":56442,"_3064":56443},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3608":1850,"_31023":1839,"_5":31378,"_21483":56445,"_28210":56446,"_3064":56447},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3608":1851,"_31023":1839,"_5":31378,"_21483":56449,"_28210":56450,"_3064":56451},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3608":1852,"_31023":1839,"_5":31378,"_21483":56453,"_28210":56454,"_3064":56455},[],"/docs/pr-preview/pr-72/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3608":1853,"_31023":1839,"_21483":56457,"_5":14766,"_28210":1839,"_3064":56458},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3608":1854,"_31023":1839,"_21483":56460,"_5":14766,"_28210":1839,"_3064":56461},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3608":1855,"_31023":1839,"_21483":56463,"_5":14766,"_28210":56410,"_3064":56464},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3608":1856,"_31023":1839,"_21483":56466,"_5":14766,"_28210":56410,"_3064":56467},[],"environment, such as production and preproduction;",{"_3608":1857,"_31023":1839,"_21483":56469,"_5":14766,"_28210":56410,"_3064":56470},[],"owner or operating team;",{"_3608":1858,"_31023":1839,"_21483":56472,"_5":14766,"_28210":56410,"_3064":56473},[],"device family or manufacturing process;",{"_3608":1859,"_31023":1839,"_21483":56475,"_5":14766,"_28210":56410,"_3064":56476},[],"region or regulatory requirement;",{"_3608":1860,"_31023":1839,"_21483":56478,"_5":14766,"_28210":56410,"_3064":56479},[],"cryptographic engine or key policy;",{"_3608":1861,"_31023":1839,"_21483":56481,"_5":14766,"_28210":56410,"_3064":56482},[],"maintenance window and renewal cadence.",{"_3608":1862,"_31023":1839,"_21483":56484,"_5":14766,"_28210":56410,"_3064":56485},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3608":1863,"_31023":1839,"_21483":56487,"_5":14766,"_28210":56410,"_3064":56488},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3608":1864,"_31023":1839,"_21483":56490,"_5":14766,"_28210":56414,"_3064":56491},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3608":1865,"_31023":1839,"_21483":56493,"_5":14766,"_28210":56414,"_3064":56494},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3608":1866,"_31023":1839,"_21483":56496,"_5":14766,"_28210":56414,"_3064":56497},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3608":1867,"_31023":1839,"_21483":56499,"_5":14766,"_28210":56414,"_3064":56500},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3608":1868,"_31023":1839,"_21483":56502,"_5":14766,"_28210":56418,"_3064":56503},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3608":1869,"_31023":1839,"_21483":56505,"_5":14766,"_28210":56418,"_3064":56506},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3608":1870,"_31023":1839,"_21483":56508,"_5":14766,"_28210":56418,"_3064":56509},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3608":1871,"_31023":1839,"_21483":56511,"_5":14766,"_28210":56418,"_3064":56512},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3608":1872,"_31023":1839,"_21483":56514,"_5":14766,"_28210":56426,"_3064":56515},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3608":1873,"_31023":1839,"_21483":56517,"_5":14766,"_28210":56430,"_3064":56518},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3608":1874,"_31023":1839,"_21483":56520,"_5":14766,"_28210":56434,"_3064":56521},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3608":1875,"_31023":1839,"_21483":56523,"_5":14766,"_28210":56438,"_3064":56524},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3608":1876,"_31023":1839,"_21483":56526,"_5":14766,"_28210":56442,"_3064":56527},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3608":1877,"_31023":1839,"_21483":56529,"_5":14766,"_28210":56446,"_3064":56530},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3608":1878,"_31023":1839,"_21483":56532,"_5":14766,"_28210":56450,"_3064":56533},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3608":1879,"_31023":1839,"_21483":56535,"_5":14766,"_28210":56450,"_3064":56536},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3608":1880,"_31023":1839,"_21483":56538,"_5":14766,"_28210":56450,"_3064":56539},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3608":1881,"_31023":1839,"_21483":56541,"_5":14766,"_28210":56450,"_3064":56542},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3608":1882,"_31023":1839,"_21483":56544,"_5":14766,"_28210":56454,"_3064":56545},[],"The new chain ends in an anchor installed by the consumer.",{"_3608":1883,"_31023":1839,"_21483":56547,"_5":14766,"_28210":56454,"_3064":56548},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3608":1884,"_31023":1839,"_21483":56550,"_5":14766,"_28210":56454,"_3064":56551},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3608":1885,"_31023":1839,"_21483":56553,"_5":14766,"_28210":56454,"_3064":56554},[],"Re-enrollment accepts the old identity during the planned period.",{"_3608":1886,"_31023":1839,"_21483":56556,"_5":14766,"_28210":56454,"_3064":56557},[],"OCSP and CRL respond for the authorities that remain active.",{"_3608":1887,"_31023":1839,"_21483":56559,"_5":14766,"_28210":56454,"_3064":56560},[],"No DMS is left accidentally issuing from the old CA.",{"_3608":1888,"_31023":1839,"_21483":56562,"_5":14766,"_28210":56454,"_3064":56563},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3608":1889,"_31023":1889,"_5":15126,"_3064":56565,"_31381":56566,"_21483":56567,"_28210":1889},"Certification authorities",[50727,52239,56402,56403],[],{"_3608":1890,"_31023":1889,"_21483":56569,"_5":14766,"_28210":1889,"_3064":56570},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3608":1891,"_31023":1889,"_5":31378,"_21483":56572,"_28210":56573,"_3064":56574},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3608":1892,"_31023":1889,"_5":31378,"_21483":56576,"_28210":56577,"_3064":56578},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3608":1893,"_31023":1889,"_5":31378,"_21483":56580,"_28210":56581,"_3064":50737},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#before-you-begin",{"_3608":1894,"_31023":1889,"_5":31378,"_21483":56583,"_28210":56584,"_3064":56585},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3608":1895,"_31023":1889,"_5":31378,"_21483":56587,"_28210":56588,"_3064":56589},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3608":1896,"_31023":1889,"_5":31378,"_21483":56591,"_28210":56592,"_3064":56593},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3608":1897,"_31023":1889,"_5":31378,"_21483":56595,"_28210":56596,"_3064":56597},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3608":1898,"_31023":1889,"_5":31378,"_21483":56599,"_28210":56600,"_3064":56601},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3608":1899,"_31023":1889,"_5":31378,"_21483":56603,"_28210":56604,"_3064":56605},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3608":1900,"_31023":1889,"_5":31378,"_21483":56607,"_28210":56608,"_3064":56609},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3608":1901,"_31023":1889,"_5":31378,"_21483":56611,"_28210":56612,"_3064":56613},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3608":1902,"_31023":1889,"_5":31378,"_21483":56615,"_28210":56616,"_3064":56617},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3608":1903,"_31023":1889,"_5":31378,"_21483":56619,"_28210":56620,"_3064":56621},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3608":1904,"_31023":1889,"_5":31378,"_21483":56623,"_28210":56624,"_3064":56625},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3608":1905,"_31023":1889,"_5":31378,"_21483":56627,"_28210":56628,"_3064":56629},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3608":1906,"_31023":1889,"_5":31378,"_21483":56631,"_28210":56632,"_3064":56633},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3608":1907,"_31023":1889,"_5":31378,"_21483":56635,"_28210":56636,"_3064":56637},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3608":1908,"_31023":1889,"_5":31378,"_21483":56639,"_28210":56640,"_3064":56641},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3608":1909,"_31023":1889,"_5":31378,"_21483":56643,"_28210":56644,"_3064":56645},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3608":1910,"_31023":1889,"_5":31378,"_21483":56647,"_28210":56648,"_3064":56649},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3608":1911,"_31023":1889,"_5":31378,"_21483":56651,"_28210":56652,"_3064":56653},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3608":1912,"_31023":1889,"_5":31378,"_21483":56655,"_28210":56656,"_3064":56657},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3608":1913,"_31023":1889,"_5":31378,"_21483":56659,"_28210":56660,"_3064":56661},[],"/docs/pr-preview/pr-72/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3608":1914,"_31023":1889,"_21483":56663,"_5":14766,"_28210":1889,"_3064":56664},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3608":1915,"_31023":1889,"_21483":56666,"_5":14766,"_28210":1889,"_3064":56667},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3608":1916,"_31023":1889,"_21483":56669,"_5":14766,"_28210":1889,"_3064":56670},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3608":1917,"_31023":1889,"_21483":56672,"_5":14766,"_28210":56573,"_3064":56673},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3608":1918,"_31023":1889,"_21483":56675,"_5":14766,"_28210":56573,"_3064":56676},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3608":1919,"_31023":1889,"_21483":56678,"_5":14766,"_28210":56573,"_3064":56679},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3608":1920,"_31023":1889,"_21483":56681,"_5":14766,"_28210":56573,"_3064":56682},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3608":1921,"_31023":1889,"_21483":56684,"_5":14766,"_28210":56573,"_3064":56685},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3608":1922,"_31023":1889,"_21483":56687,"_5":14766,"_28210":56581,"_3064":56688},[],"Decide whether the CA will be a root or an intermediate.",{"_3608":1923,"_31023":1889,"_21483":56690,"_5":14766,"_28210":56581,"_3064":56691},[],"Choose the engine that will keep the key.",{"_3608":1924,"_31023":1889,"_21483":56693,"_5":14766,"_28210":56581,"_3064":56694},[],"Define a validity longer than that of the certificates it will issue.",{"_3608":1925,"_31023":1889,"_21483":56696,"_5":14766,"_28210":56581,"_3064":56697},[],"For an intermediate CA, make sure the parent CA is active.",{"_3608":1926,"_31023":1889,"_21483":56699,"_5":14766,"_28210":56584,"_3064":56700},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3608":1927,"_31023":1889,"_21483":56702,"_5":14766,"_28210":56588,"_3064":56703},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3608":1928,"_31023":1889,"_21483":56705,"_5":14766,"_28210":56588,"_3064":56706},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3608":1929,"_31023":1889,"_21483":56708,"_5":14766,"_28210":56592,"_3064":56709},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3608":1930,"_31023":1889,"_21483":56711,"_5":14766,"_28210":56596,"_3064":56712},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3608":1931,"_31023":1889,"_21483":56714,"_5":14766,"_28210":56596,"_3064":56715},[],"`C`: two-letter ISO 3166-1 country code.",{"_3608":1932,"_31023":1889,"_21483":56717,"_5":14766,"_28210":56596,"_3064":56718},[],"`ST`: state or province.",{"_3608":1933,"_31023":1889,"_21483":56720,"_5":14766,"_28210":56596,"_3064":56721},[],"`L`: locality.",{"_3608":1934,"_31023":1889,"_21483":56723,"_5":14766,"_28210":56596,"_3064":56724},[],"`O`: organization.",{"_3608":1935,"_31023":1889,"_21483":56726,"_5":14766,"_28210":56596,"_3064":56727},[],"`OU`: organizational unit.",{"_3608":1936,"_31023":1889,"_21483":56729,"_5":14766,"_28210":56596,"_3064":56730},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3608":1937,"_31023":1889,"_21483":56732,"_5":14766,"_28210":56600,"_3064":56733},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3608":1938,"_31023":1889,"_21483":56735,"_5":14766,"_28210":56600,"_3064":56736},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3608":1939,"_31023":1889,"_21483":56738,"_5":14766,"_28210":56604,"_3064":56739},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3608":1940,"_31023":1889,"_21483":56741,"_5":14766,"_28210":56604,"_3064":56742},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3608":1941,"_31023":1889,"_21483":56744,"_5":14766,"_28210":56608,"_3064":56745},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3608":1942,"_31023":1889,"_21483":56747,"_5":14766,"_28210":56608,"_3064":56748},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3608":1943,"_31023":1889,"_21483":56750,"_5":14766,"_28210":56612,"_3064":56751},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3608":1944,"_31023":1889,"_21483":56753,"_5":14766,"_28210":56612,"_3064":56754},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3608":1945,"_31023":1889,"_21483":56756,"_5":14766,"_28210":56612,"_3064":56757},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3608":1946,"_31023":1889,"_21483":56759,"_5":14766,"_28210":56616,"_3064":56760},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3608":1947,"_31023":1889,"_21483":56762,"_5":14766,"_28210":56620,"_3064":56763},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3608":1948,"_31023":1889,"_21483":56765,"_5":14766,"_28210":56620,"_3064":56766},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3608":1949,"_31023":1889,"_21483":56768,"_5":14766,"_28210":56624,"_3064":56769},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3608":1950,"_31023":1889,"_21483":56771,"_5":14766,"_28210":56628,"_3064":56772},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3608":1951,"_31023":1889,"_21483":56774,"_5":14766,"_28210":56628,"_3064":56775},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3608":1952,"_31023":1889,"_21483":56777,"_5":14766,"_28210":56632,"_3064":56778},[],"Open a CA from the inventory to review:",{"_3608":1953,"_31023":1889,"_21483":56780,"_5":14766,"_28210":56632,"_3064":56781},[],"Status and validity period.",{"_3608":1954,"_31023":1889,"_21483":56783,"_5":14766,"_28210":56632,"_3064":56784},[],"Certificate and chain in PEM format.",{"_3608":1955,"_31023":1889,"_21483":56786,"_5":14766,"_28210":56632,"_3064":56787},[],"Number of active, expired and revoked certificates.",{"_3608":1956,"_31023":1889,"_21483":56789,"_5":14766,"_28210":56632,"_3064":56790},[],"Certificates issued in **Issued Certificates**.",{"_3608":1957,"_31023":1889,"_21483":56792,"_5":14766,"_28210":56632,"_3064":56793},[],"The CRL linked to the authority.",{"_3608":1958,"_31023":1889,"_21483":56795,"_5":14766,"_28210":56632,"_3064":56796},[],"Metadata and the associated cryptographic engine.",{"_3608":1959,"_31023":1889,"_21483":56798,"_5":14766,"_28210":56632,"_3064":56799},[],"You can filter the inventory by name, status and CA type.",{"_3608":1960,"_31023":1889,"_21483":56801,"_5":14766,"_28210":56636,"_3064":56802},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3608":1961,"_31023":1889,"_21483":56804,"_5":14766,"_28210":56636,"_3064":56805},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3608":1962,"_31023":1889,"_21483":56807,"_5":14766,"_28210":56636,"_3064":56808},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3608":1963,"_31023":1889,"_21483":56810,"_5":14766,"_28210":56636,"_3064":56811},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3608":1964,"_31023":1889,"_21483":56813,"_5":14766,"_28210":56636,"_3064":56814},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3608":1965,"_31023":1889,"_21483":56816,"_5":14766,"_28210":56636,"_3064":56817},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3608":1966,"_31023":1889,"_21483":56819,"_5":14766,"_28210":56640,"_3064":56820},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3608":1967,"_31023":1889,"_21483":56822,"_5":14766,"_28210":56644,"_3064":56823},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3608":1968,"_31023":1889,"_21483":56825,"_5":14766,"_28210":56648,"_3064":56826},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3608":1969,"_31023":1889,"_21483":56828,"_5":14766,"_28210":56652,"_3064":56829},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3608":1970,"_31023":1889,"_21483":56831,"_5":14766,"_28210":56656,"_3064":56832},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3608":1971,"_31023":1889,"_21483":56834,"_5":14766,"_28210":56660,"_3064":56835},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3608":1972,"_31023":1889,"_21483":56837,"_5":14766,"_28210":56660,"_3064":56838},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3608":1973,"_31023":1889,"_21483":56840,"_5":14766,"_28210":56660,"_3064":56841},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3608":1974,"_31023":1889,"_21483":56843,"_5":14766,"_28210":56660,"_3064":56844},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3608":1975,"_31023":1975,"_5":15126,"_3064":56846,"_31381":56847,"_21483":56848,"_28210":1975},"Certificate profiles",[50727,52239,56402,56403],[],{"_3608":1976,"_31023":1975,"_21483":56850,"_5":14766,"_28210":1975,"_3064":56851},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3608":1977,"_31023":1975,"_5":31378,"_21483":56853,"_28210":56854,"_3064":56855},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3608":1978,"_31023":1975,"_5":31378,"_21483":56857,"_28210":56858,"_3064":56859},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#validity","Validity",{"_3608":1979,"_31023":1975,"_5":31378,"_21483":56861,"_28210":56862,"_3064":56863},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3608":1980,"_31023":1975,"_5":31378,"_21483":56865,"_28210":56866,"_3064":56867},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3608":1981,"_31023":1975,"_5":31378,"_21483":56869,"_28210":56870,"_3064":56871},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#subject","Subject",{"_3608":1982,"_31023":1975,"_5":31378,"_21483":56873,"_28210":56874,"_3064":56875},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3608":1983,"_31023":1975,"_5":31378,"_21483":56877,"_28210":56878,"_3064":56879},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3608":1984,"_31023":1975,"_5":31378,"_21483":56881,"_28210":56882,"_3064":56883},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3608":1985,"_31023":1975,"_5":31378,"_21483":56885,"_28210":56886,"_3064":56887},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3608":1986,"_31023":1975,"_5":31378,"_21483":56889,"_28210":56890,"_3064":56891},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3608":1987,"_31023":1975,"_5":31378,"_21483":56893,"_28210":56894,"_3064":56895},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3608":1988,"_31023":1975,"_5":31378,"_21483":56897,"_28210":56898,"_3064":56899},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3608":1989,"_31023":1975,"_5":31378,"_21483":56901,"_28210":56902,"_3064":56903},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3608":1990,"_31023":1975,"_5":31378,"_21483":56905,"_28210":56906,"_3064":56907},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3608":1991,"_31023":1975,"_5":31378,"_21483":56909,"_28210":56910,"_3064":56911},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#design-examples","Design examples",{"_3608":1992,"_31023":1975,"_5":31378,"_21483":56913,"_28210":56914,"_3064":56915},[],"/docs/pr-preview/pr-72/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3608":1993,"_31023":1975,"_21483":56917,"_5":14766,"_28210":1975,"_3064":56918},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3608":1994,"_31023":1975,"_21483":56920,"_5":14766,"_28210":1975,"_3064":56921},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3608":1995,"_31023":1975,"_21483":56923,"_5":14766,"_28210":56858,"_3064":56924},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3608":1996,"_31023":1975,"_21483":56926,"_5":14766,"_28210":56858,"_3064":56927},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3608":1997,"_31023":1975,"_21483":56929,"_5":14766,"_28210":56862,"_3064":56930},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3608":1998,"_31023":1975,"_21483":56932,"_5":14766,"_28210":56866,"_3064":56933},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3608":1999,"_31023":1975,"_21483":56935,"_5":14766,"_28210":56866,"_3064":56936},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3608":2000,"_31023":1975,"_21483":56938,"_5":14766,"_28210":56866,"_3064":56939},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3608":2001,"_31023":1975,"_21483":56941,"_5":14766,"_28210":56870,"_3064":56942},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3608":2002,"_31023":1975,"_21483":56944,"_5":14766,"_28210":56874,"_3064":56945},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3608":2003,"_31023":1975,"_21483":56947,"_5":14766,"_28210":56874,"_3064":56948},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3608":2004,"_31023":1975,"_21483":56950,"_5":14766,"_28210":56878,"_3064":56951},[],"The cryptographic enforcement can:",{"_3608":2005,"_31023":1975,"_21483":56953,"_5":14766,"_28210":56878,"_3064":56954},[],"allow or block RSA keys;",{"_3608":2006,"_31023":1975,"_21483":56956,"_5":14766,"_28210":56878,"_3064":56957},[],"limit the supported RSA sizes;",{"_3608":2007,"_31023":1975,"_21483":56959,"_5":14766,"_28210":56878,"_3064":56960},[],"allow or block ECDSA keys;",{"_3608":2008,"_31023":1975,"_21483":56962,"_5":14766,"_28210":56878,"_3064":56963},[],"limit the supported ECDSA sizes or curves.",{"_3608":2009,"_31023":1975,"_21483":56965,"_5":14766,"_28210":56878,"_3064":56966},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3608":2010,"_31023":1975,"_21483":56968,"_5":14766,"_28210":56882,"_3064":56969},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3608":2011,"_31023":1975,"_21483":56971,"_5":14766,"_28210":56882,"_3064":54164},[],{"_3608":2012,"_31023":1975,"_21483":56973,"_5":14766,"_28210":56882,"_3064":56974},[],"First choice",{"_3608":2013,"_31023":1975,"_21483":56976,"_5":14766,"_28210":56882,"_3064":56977},[],"Second choice",{"_3608":2014,"_31023":1975,"_21483":56979,"_5":14766,"_28210":56882,"_3064":56980},[],"If neither is supplied",{"_3608":2015,"_31023":1975,"_21483":56982,"_5":14766,"_28210":56882,"_3064":56983},[],"Direct signing with a CA",{"_3608":2016,"_31023":1975,"_21483":56985,"_5":14766,"_28210":56882,"_3064":56986},[],"`issuance_profile` embedded in the request",{"_3608":2017,"_31023":1975,"_21483":56988,"_5":14766,"_28210":56882,"_3064":56989},[],"Request `issuance_profile_id`",{"_3608":2018,"_31023":1975,"_21483":56991,"_5":14766,"_28210":56882,"_3064":56992},[],"CA default profile (`profile_id`).",{"_3608":2019,"_31023":1975,"_21483":56994,"_5":14766,"_28210":56882,"_3064":56995},[],"Issuance through a DMS",{"_3608":2020,"_31023":1975,"_21483":56997,"_5":14766,"_28210":56882,"_3064":56998},[],"`settings.issuance_profile_id`",{"_3608":2021,"_31023":1975,"_21483":57000,"_5":14766,"_28210":56882,"_3064":57001},[],"`settings.issuance_profile` embedded in the DMS",{"_3608":2022,"_31023":1975,"_21483":57003,"_5":14766,"_28210":56882,"_3064":57004},[],"Enrollment CA default profile.",{"_3608":2023,"_31023":1975,"_21483":57006,"_5":14766,"_28210":56882,"_3064":57007},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3608":2024,"_31023":1975,"_21483":57009,"_5":14766,"_28210":56882,"_3064":57010},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3608":2025,"_31023":1975,"_21483":57012,"_5":14766,"_28210":56890,"_3064":57013},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3608":2026,"_31023":1975,"_21483":57015,"_5":14766,"_28210":56894,"_3064":57016},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3608":2027,"_31023":1975,"_21483":57018,"_5":14766,"_28210":56898,"_3064":57019},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3608":2028,"_31023":1975,"_21483":57021,"_5":14766,"_28210":56902,"_3064":57022},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3608":2029,"_31023":1975,"_21483":57024,"_5":14766,"_28210":56906,"_3064":57025},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3608":2030,"_31023":1975,"_21483":57027,"_5":14766,"_28210":56906,"_3064":57028},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3608":2031,"_31023":1975,"_21483":57030,"_5":14766,"_28210":56910,"_3064":57031},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3608":2032,"_31023":1975,"_21483":57033,"_5":14766,"_28210":56910,"_3064":57034},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3608":2033,"_31023":1975,"_21483":57036,"_5":14766,"_28210":56910,"_3064":57037},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3608":2034,"_31023":1975,"_21483":57039,"_5":14766,"_28210":56910,"_3064":57040},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3608":2035,"_31023":1975,"_21483":57042,"_5":14766,"_28210":56914,"_3064":57043},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3608":2036,"_31023":1975,"_21483":57045,"_5":14766,"_28210":56914,"_3064":57046},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3608":2037,"_31023":2037,"_5":15126,"_3064":57048,"_31381":57049,"_21483":57051,"_28210":2037},"Certificate validation",[50727,52239,56402,57050],"Validation",[],{"_3608":2038,"_31023":2037,"_21483":57053,"_5":14766,"_28210":2037,"_3064":57054},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3608":2039,"_31023":2037,"_5":31378,"_21483":57056,"_28210":57057,"_3064":57058},[],"/docs/pr-preview/pr-72/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3608":2040,"_31023":2037,"_5":31378,"_21483":57060,"_28210":57061,"_3064":57062},[],"/docs/pr-preview/pr-72/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3608":2041,"_31023":2037,"_5":31378,"_21483":57064,"_28210":57065,"_3064":57066},[],"/docs/pr-preview/pr-72/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3608":2042,"_31023":2037,"_21483":57068,"_5":14766,"_28210":2037,"_3064":57069},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3608":2043,"_31023":2037,"_21483":57071,"_5":14766,"_28210":57057,"_3064":57072},[],"Verify these criteria together:",{"_3608":2044,"_31023":2037,"_21483":57074,"_5":14766,"_28210":57057,"_3064":56028},[],{"_3608":2045,"_31023":2037,"_21483":57076,"_5":14766,"_28210":57057,"_3064":57077},[],"Required result",{"_3608":2046,"_31023":2037,"_21483":57079,"_5":14766,"_28210":57057,"_3064":57080},[],"Chain and signature",{"_3608":2047,"_31023":2037,"_21483":57082,"_5":14766,"_28210":57057,"_3064":57083},[],"Valid chain to a root deliberately installed in the consumer.",{"_3608":2048,"_31023":2037,"_21483":57085,"_5":14766,"_28210":57057,"_3064":57086},[],"Dates",{"_3608":2049,"_31023":2037,"_21483":57088,"_5":14766,"_28210":57057,"_3064":57089},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3608":2050,"_31023":2037,"_21483":57091,"_5":14766,"_28210":57057,"_3064":51908},[],{"_3608":2051,"_31023":2037,"_21483":57093,"_5":14766,"_28210":57057,"_3064":57094},[],"Name, SAN or identifier matches the expected peer.",{"_3608":2052,"_31023":2037,"_21483":57096,"_5":14766,"_28210":57057,"_3064":51117},[],{"_3608":2053,"_31023":2037,"_21483":57098,"_5":14766,"_28210":57057,"_3064":57099},[],"KU, EKU and constraints permit the specific operation.",{"_3608":2054,"_31023":2037,"_21483":57101,"_5":14766,"_28210":57057,"_3064":57102},[],"Revocation",{"_3608":2055,"_31023":2037,"_21483":57104,"_5":14766,"_28210":57057,"_3064":57105},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3608":2056,"_31023":2037,"_21483":57107,"_5":14766,"_28210":57057,"_3064":57108},[],"Authorization",{"_3608":2057,"_31023":2037,"_21483":57110,"_5":14766,"_28210":57057,"_3064":57111},[],"The application permits that identity to perform the action.",{"_3608":2058,"_31023":2037,"_21483":57113,"_5":14766,"_28210":57057,"_3064":57114},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3608":2059,"_31023":2037,"_21483":57116,"_5":14766,"_28210":57061,"_3064":57117},[],"Mechanism",{"_3608":2060,"_31023":2037,"_21483":57119,"_5":14766,"_28210":57061,"_3064":57120},[],"When to use it",{"_3608":2061,"_31023":2037,"_21483":57122,"_5":14766,"_28210":57061,"_3064":57123},[],"What you must maintain",{"_3608":2062,"_31023":2037,"_21483":57125,"_5":14766,"_28210":57061,"_3064":57126},[],"OCSP",{"_3608":2063,"_31023":2037,"_21483":57128,"_5":14766,"_28210":57061,"_3064":57129},[],"Status query for a specific certificate.",{"_3608":2064,"_31023":2037,"_21483":57131,"_5":14766,"_28210":57061,"_3064":57132},[],"Responder access, signature verification and cache/freshness policy.",{"_3608":2065,"_31023":2037,"_21483":57134,"_5":14766,"_28210":57061,"_3064":57135},[],"CRL",{"_3608":2066,"_31023":2037,"_21483":57137,"_5":14766,"_28210":57061,"_3064":57138},[],"Local checks for many certificates or offline operation.",{"_3608":2067,"_31023":2037,"_21483":57140,"_5":14766,"_28210":57061,"_3064":57141},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3608":2068,"_31023":2037,"_21483":57143,"_5":14766,"_28210":57061,"_3064":57144},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3608":2069,"_31023":2037,"_21483":57146,"_5":14766,"_28210":57061,"_3064":57147},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3608":2070,"_31023":2037,"_21483":57149,"_5":14766,"_28210":57065,"_3064":57150},[],"Accept a current, authorized certificate with a known chain.",{"_3608":2071,"_31023":2037,"_21483":57152,"_5":14766,"_28210":57065,"_3064":57153},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3608":2072,"_31023":2037,"_21483":57155,"_5":14766,"_28210":57065,"_3064":57156},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3608":2073,"_31023":2037,"_21483":57158,"_5":14766,"_28210":57065,"_3064":57159},[],"Check that a new connection with that identity is rejected.",{"_3608":2074,"_31023":2037,"_21483":57161,"_5":14766,"_28210":57065,"_3064":57162},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3608":2075,"_31023":2037,"_21483":57164,"_5":14766,"_28210":57065,"_3064":57165},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3608":2076,"_31023":2037,"_21483":57167,"_5":14766,"_28210":57065,"_3064":57168},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3608":2077,"_31023":2037,"_21483":57170,"_5":14766,"_28210":57065,"_3064":57171},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3608":2078,"_31023":2037,"_21483":57173,"_5":14766,"_28210":57065,"_3064":57174},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3608":2079,"_31023":2079,"_5":15126,"_3064":57176,"_31381":57177,"_21483":57178,"_28210":2079},"Certificates",[50727,52239,56402,56403],[],{"_3608":2080,"_31023":2079,"_21483":57180,"_5":14766,"_28210":2079,"_3064":57181},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3608":2081,"_31023":2079,"_5":31378,"_21483":57183,"_28210":57184,"_3064":57185},[],"/docs/pr-preview/pr-72/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3608":2082,"_31023":2079,"_5":31378,"_21483":57187,"_28210":57188,"_3064":57189},[],"/docs/pr-preview/pr-72/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3608":2083,"_31023":2079,"_5":31378,"_21483":57191,"_28210":57192,"_3064":57193},[],"/docs/pr-preview/pr-72/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3608":2084,"_31023":2079,"_5":31378,"_21483":57195,"_28210":57196,"_3064":57197},[],"/docs/pr-preview/pr-72/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3608":2085,"_31023":2079,"_5":31378,"_21483":57199,"_28210":57200,"_3064":57201},[],"/docs/pr-preview/pr-72/platform/pki/certificates#open-the-action","Open the action",{"_3608":2086,"_31023":2079,"_5":31378,"_21483":57203,"_28210":57204,"_3064":57205},[],"/docs/pr-preview/pr-72/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3608":2087,"_31023":2079,"_5":31378,"_21483":57207,"_28210":57208,"_3064":57209},[],"/docs/pr-preview/pr-72/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3608":2088,"_31023":2079,"_5":31378,"_21483":57211,"_28210":57212,"_3064":57213},[],"/docs/pr-preview/pr-72/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3608":2089,"_31023":2079,"_5":31378,"_21483":57215,"_28210":57216,"_3064":57217},[],"/docs/pr-preview/pr-72/platform/pki/certificates#continue","Continue",{"_3608":2090,"_31023":2079,"_21483":57219,"_5":14766,"_28210":2079,"_3064":57220},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3608":2091,"_31023":2079,"_21483":57222,"_5":14766,"_28210":57184,"_3064":57223},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3608":2092,"_31023":2079,"_21483":57225,"_5":14766,"_28210":57184,"_3064":57226},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3608":2093,"_31023":2079,"_21483":57228,"_5":14766,"_28210":57184,"_3064":57229},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3608":2094,"_31023":2079,"_21483":57231,"_5":14766,"_28210":57184,"_3064":57232},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3608":2095,"_31023":2079,"_21483":57234,"_5":14766,"_28210":57184,"_3064":57235},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3608":2096,"_31023":2079,"_21483":57237,"_5":14766,"_28210":57184,"_3064":57238},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3608":2097,"_31023":2079,"_21483":57240,"_5":14766,"_28210":57184,"_3064":57241},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3608":2098,"_31023":2079,"_21483":57243,"_5":14766,"_28210":57188,"_3064":57244},[],"Download the PEM and inspect it:",{"_3608":2099,"_31023":2079,"_21483":57246,"_5":14766,"_28210":57188,"_3064":57247},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3608":2100,"_31023":2079,"_21483":57249,"_5":14766,"_28210":57192,"_3064":57250},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3608":2101,"_31023":2079,"_21483":57252,"_5":14766,"_28210":57192,"_3064":57253},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3608":2102,"_31023":2079,"_21483":57255,"_5":14766,"_28210":57192,"_3064":57256},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3608":2103,"_31023":2079,"_21483":57258,"_5":14766,"_28210":57192,"_3064":57259},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3608":2104,"_31023":2079,"_21483":57261,"_5":14766,"_28210":57192,"_3064":57262},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3608":2105,"_31023":2079,"_21483":57264,"_5":14766,"_28210":57192,"_3064":57265},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3608":2106,"_31023":2079,"_21483":57267,"_5":14766,"_28210":57192,"_3064":57268},[],"For browser key generation, follow Issue your first certificate.",{"_3608":2107,"_31023":2079,"_21483":57270,"_5":14766,"_28210":57196,"_3064":57271},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3608":2108,"_31023":2079,"_21483":57273,"_5":14766,"_28210":57200,"_3064":57274},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3608":2109,"_31023":2079,"_21483":57276,"_5":14766,"_28210":57204,"_3064":57277},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3608":2110,"_31023":2079,"_21483":57279,"_5":14766,"_28210":57208,"_3064":57280},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3608":2111,"_31023":2079,"_21483":57282,"_5":14766,"_28210":57208,"_3064":57283},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3608":2112,"_31023":2079,"_21483":57285,"_5":14766,"_28210":57208,"_3064":57286},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3608":2113,"_31023":2079,"_21483":57288,"_5":14766,"_28210":57212,"_3064":57289},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3608":2114,"_31023":2079,"_21483":57291,"_5":14766,"_28210":57212,"_3064":57292},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3608":2115,"_31023":2079,"_21483":57294,"_5":14766,"_28210":57212,"_3064":57295},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3608":2116,"_31023":2079,"_21483":57297,"_5":14766,"_28210":57216,"_3064":57298},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3608":2117,"_31023":2079,"_21483":57300,"_5":14766,"_28210":57216,"_3064":57301},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3608":2118,"_31023":2118,"_5":15126,"_3064":57303,"_31381":57304,"_21483":57306,"_28210":2118},"Certificate lifecycle",[50727,52239,56402,57305],"Concepts",[],{"_3608":2119,"_31023":2118,"_21483":57308,"_5":14766,"_28210":2118,"_3064":57309},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3608":2120,"_31023":2118,"_5":31378,"_21483":57311,"_28210":57312,"_3064":57313},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3608":2121,"_31023":2118,"_5":31378,"_21483":57315,"_28210":57316,"_3064":57317},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3608":2122,"_31023":2118,"_5":31378,"_21483":57319,"_28210":57320,"_3064":57321},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3608":2123,"_31023":2118,"_5":31378,"_21483":57323,"_28210":57324,"_3064":57325},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3608":2124,"_31023":2118,"_5":31378,"_21483":57327,"_28210":57328,"_3064":57329},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3608":2125,"_31023":2118,"_5":31378,"_21483":57331,"_28210":57332,"_3064":57333},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3608":2126,"_31023":2118,"_5":31378,"_21483":57335,"_28210":57336,"_3064":57337},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3608":2127,"_31023":2118,"_5":31378,"_21483":57339,"_28210":57340,"_3064":57341},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3608":2128,"_31023":2118,"_5":31378,"_21483":57343,"_28210":57344,"_3064":57345},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3608":2129,"_31023":2118,"_5":31378,"_21483":57347,"_28210":57348,"_3064":57349},[],"/docs/pr-preview/pr-72/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3608":2130,"_31023":2118,"_21483":57351,"_5":14766,"_28210":2118,"_3064":57352},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3608":2131,"_31023":2118,"_21483":57354,"_5":14766,"_28210":57316,"_3064":57355},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3608":2132,"_31023":2118,"_21483":57357,"_5":14766,"_28210":57320,"_3064":57358},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3608":2133,"_31023":2118,"_21483":57360,"_5":14766,"_28210":57324,"_3064":57361},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3608":2134,"_31023":2118,"_21483":57363,"_5":14766,"_28210":57328,"_3064":57364},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3608":2135,"_31023":2118,"_21483":57366,"_5":14766,"_28210":57332,"_3064":57367},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3608":2136,"_31023":2118,"_21483":57369,"_5":14766,"_28210":57336,"_3064":57370},[],"Lamassu persists four X.509 states:",{"_3608":2137,"_31023":2118,"_21483":57372,"_5":14766,"_28210":57336,"_3064":57373},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3608":2138,"_31023":2118,"_21483":57375,"_5":14766,"_28210":57336,"_3064":57376},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3608":2139,"_31023":2118,"_21483":57378,"_5":14766,"_28210":57336,"_3064":57379},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3608":2140,"_31023":2118,"_21483":57381,"_5":14766,"_28210":57336,"_3064":57382},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3608":2141,"_31023":2118,"_21483":57384,"_5":14766,"_28210":57336,"_3064":57385},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3608":2142,"_31023":2118,"_21483":57387,"_5":14766,"_28210":57340,"_3064":57388},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3608":2143,"_31023":2118,"_21483":57390,"_5":14766,"_28210":57340,"_3064":57391},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3608":2144,"_31023":2118,"_21483":57393,"_5":14766,"_28210":57340,"_3064":57394},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3608":2145,"_31023":2118,"_21483":57396,"_5":14766,"_28210":57344,"_3064":57397},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3608":2146,"_31023":2118,"_21483":57399,"_5":14766,"_28210":57344,"_3064":57400},[],"Before confirming:",{"_3608":2147,"_31023":2118,"_21483":57402,"_5":14766,"_28210":57344,"_3064":57403},[],"Identify DMSs, devices and services that trust that chain.",{"_3608":2148,"_31023":2118,"_21483":57405,"_5":14766,"_28210":57344,"_3064":57406},[],"Distribute the new chain of trust.",{"_3608":2149,"_31023":2118,"_21483":57408,"_5":14766,"_28210":57344,"_3064":57409},[],"Reissue the necessary identities.",{"_3608":2150,"_31023":2118,"_21483":57411,"_5":14766,"_28210":57344,"_3064":57412},[],"Check OCSP and CRL from a real consumer.",{"_3608":2151,"_31023":2118,"_21483":57414,"_5":14766,"_28210":57344,"_3064":57415},[],"Revoke the old CA once no legitimate traffic remains.",{"_3608":2152,"_31023":2118,"_21483":57417,"_5":14766,"_28210":57344,"_3064":57418},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3608":2153,"_31023":2118,"_21483":57420,"_5":14766,"_28210":57348,"_3064":57421},[],"Certificates entering the preventive or critical renewal window.",{"_3608":2154,"_31023":2118,"_21483":57423,"_5":14766,"_28210":57348,"_3064":57424},[],"Repeated enrollment or re-enrollment failures.",{"_3608":2155,"_31023":2118,"_21483":57426,"_5":14766,"_28210":57348,"_3064":57427},[],"Status changes and revocation reasons.",{"_3608":2156,"_31023":2118,"_21483":57429,"_5":14766,"_28210":57348,"_3064":57430},[],"OCSP and CRL publication and validity.",{"_3608":2157,"_31023":2118,"_21483":57432,"_5":14766,"_28210":57348,"_3064":57433},[],"Dependencies still presenting a replaced certificate.",{"_3608":2158,"_31023":2118,"_21483":57435,"_5":14766,"_28210":57348,"_3064":57436},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3608":2159,"_31023":2159,"_5":15126,"_3064":57438,"_31381":57439,"_21483":57440,"_28210":2159},"Trust model",[50727,52239,56402,57305],[],{"_3608":2160,"_31023":2159,"_21483":57442,"_5":14766,"_28210":2159,"_3064":57443},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3608":2161,"_31023":2159,"_5":31378,"_21483":57445,"_28210":57446,"_3064":57447},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3608":2162,"_31023":2159,"_5":31378,"_21483":57449,"_28210":57450,"_3064":57451},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3608":2163,"_31023":2159,"_5":31378,"_21483":57453,"_28210":57454,"_3064":57455},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3608":2164,"_31023":2159,"_5":31378,"_21483":57457,"_28210":57458,"_3064":57459},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3608":2165,"_31023":2159,"_5":31378,"_21483":57461,"_28210":57462,"_3064":57463},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3608":2166,"_31023":2159,"_5":31378,"_21483":57465,"_28210":57466,"_3064":57467},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3608":2167,"_31023":2159,"_5":31378,"_21483":57469,"_28210":57470,"_3064":57471},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3608":2168,"_31023":2159,"_5":31378,"_21483":57473,"_28210":57474,"_3064":57475},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3608":2169,"_31023":2159,"_5":31378,"_21483":57477,"_28210":57478,"_3064":57479},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3608":2170,"_31023":2159,"_5":31378,"_21483":57481,"_28210":57482,"_3064":57483},[],"/docs/pr-preview/pr-72/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3608":2171,"_31023":2159,"_21483":57485,"_5":14766,"_28210":2159,"_3064":57486},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3608":2172,"_31023":2159,"_21483":57488,"_5":14766,"_28210":57450,"_3064":57489},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3608":2173,"_31023":2159,"_21483":57491,"_5":14766,"_28210":57454,"_3064":57492},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3608":2174,"_31023":2159,"_21483":57494,"_5":14766,"_28210":57458,"_3064":57495},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3608":2175,"_31023":2159,"_21483":57497,"_5":14766,"_28210":57462,"_3064":57498},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3608":2176,"_31023":2159,"_21483":57500,"_5":14766,"_28210":57466,"_3064":57501},[],"The device proves it can enroll according to the DMS policy.",{"_3608":2177,"_31023":2159,"_21483":57503,"_5":14766,"_28210":57466,"_3064":57504},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3608":2178,"_31023":2159,"_21483":57506,"_5":14766,"_28210":57466,"_3064":57507},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3608":2179,"_31023":2159,"_21483":57509,"_5":14766,"_28210":57466,"_3064":57510},[],"The device installs the certificate and the chain it needs.",{"_3608":2180,"_31023":2159,"_21483":57512,"_5":14766,"_28210":57466,"_3064":57513},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3608":2181,"_31023":2159,"_21483":57515,"_5":14766,"_28210":57466,"_3064":57516},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3608":2182,"_31023":2159,"_21483":57518,"_5":14766,"_28210":57470,"_3064":57519},[],"A DMS relates three sets that are worth designing separately:",{"_3608":2183,"_31023":2159,"_21483":57521,"_5":14766,"_28210":57470,"_3064":57522},[],"**Enrollment CA:** signs the new identities.",{"_3608":2184,"_31023":2159,"_21483":57524,"_5":14766,"_28210":57470,"_3064":57525},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3608":2185,"_31023":2159,"_21483":57527,"_5":14766,"_28210":57470,"_3064":57528},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3608":2186,"_31023":2159,"_21483":57530,"_5":14766,"_28210":57470,"_3064":57531},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3608":2187,"_31023":2159,"_21483":57533,"_5":14766,"_28210":57474,"_3064":57534},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3608":2188,"_31023":2159,"_21483":57536,"_5":14766,"_28210":57474,"_3064":57537},[],"that the current date is between `Not Before` and `Not After`;",{"_3608":2189,"_31023":2159,"_21483":57539,"_5":14766,"_28210":57474,"_3064":57540},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3608":2190,"_31023":2159,"_21483":57542,"_5":14766,"_28210":57474,"_3064":57543},[],"that names, SANs and subject match the expected identity;",{"_3608":2191,"_31023":2159,"_21483":57545,"_5":14766,"_28210":57474,"_3064":57546},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3608":2192,"_31023":2159,"_21483":57548,"_5":14766,"_28210":57474,"_3064":57549},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3608":2193,"_31023":2159,"_21483":57551,"_5":14766,"_28210":57474,"_3064":57552},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3608":2194,"_31023":2159,"_21483":57554,"_5":14766,"_28210":57478,"_3064":57555},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3608":2195,"_31023":2159,"_21483":57557,"_5":14766,"_28210":57482,"_3064":57558},[],"Keep the root out of daily operations, or with very restricted access.",{"_3608":2196,"_31023":2159,"_21483":57560,"_5":14766,"_28210":57482,"_3064":57561},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3608":2197,"_31023":2159,"_21483":57563,"_5":14766,"_28210":57482,"_3064":57564},[],"Assign explicit profiles to every use case.",{"_3608":2198,"_31023":2159,"_21483":57566,"_5":14766,"_28210":57482,"_3064":57567},[],"Distribute the new trust before starting a rotation.",{"_3608":2199,"_31023":2159,"_21483":57569,"_5":14766,"_28210":57482,"_3064":57570},[],"Keep enough overlap to renew a disconnected fleet.",{"_3608":2200,"_31023":2159,"_21483":57572,"_5":14766,"_28210":57482,"_3064":57573},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3608":2201,"_31023":2159,"_21483":57575,"_5":14766,"_28210":57482,"_3064":57576},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3608":2202,"_31023":2202,"_5":15126,"_3064":57578,"_31381":57579,"_21483":57580,"_28210":2202},"Revocation lists (CRL)",[50727,52239,56402,57050],[],{"_3608":2203,"_31023":2202,"_21483":57582,"_5":14766,"_28210":2202,"_3064":57583},[],"Generate and distribute signed lists to validate certificates offline.",{"_3608":2204,"_31023":2202,"_5":31378,"_21483":57585,"_28210":57586,"_3064":57587},[],"/docs/pr-preview/pr-72/platform/pki/crl#crl-settings","CRL settings",{"_3608":2205,"_31023":2202,"_5":31378,"_21483":57589,"_28210":57590,"_3064":57591},[],"/docs/pr-preview/pr-72/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3608":2206,"_31023":2202,"_5":31378,"_21483":57593,"_28210":57594,"_3064":57595},[],"/docs/pr-preview/pr-72/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3608":2207,"_31023":2202,"_5":31378,"_21483":57597,"_28210":57598,"_3064":57599},[],"/docs/pr-preview/pr-72/platform/pki/crl#crl-contents","CRL contents",{"_3608":2208,"_31023":2202,"_5":31378,"_21483":57601,"_28210":57602,"_3064":57603},[],"/docs/pr-preview/pr-72/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3608":2209,"_31023":2202,"_5":31378,"_21483":57605,"_28210":57606,"_3064":57607},[],"/docs/pr-preview/pr-72/platform/pki/crl#crl-settings-api","CRL settings API",{"_3608":2210,"_31023":2202,"_5":31378,"_21483":57609,"_28210":57610,"_3064":57611},[],"/docs/pr-preview/pr-72/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3608":2211,"_31023":2202,"_5":31378,"_21483":57613,"_28210":57614,"_3064":57615},[],"/docs/pr-preview/pr-72/platform/pki/crl#references","References",{"_3608":2212,"_31023":2202,"_21483":57617,"_5":14766,"_28210":2202,"_3064":57618},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3608":2213,"_31023":2202,"_21483":57620,"_5":14766,"_28210":57586,"_3064":57621},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3608":2214,"_31023":2202,"_21483":57623,"_5":14766,"_28210":57586,"_3064":57624},[],"Field",{"_3608":2215,"_31023":2202,"_21483":57626,"_5":14766,"_28210":57586,"_3064":51117},[],{"_3608":2216,"_31023":2202,"_21483":57628,"_5":14766,"_28210":57586,"_3064":52359},[],{"_3608":2217,"_31023":2202,"_21483":57630,"_5":14766,"_28210":57586,"_3064":57631},[],"ID of the CA the settings belong to.",{"_3608":2218,"_31023":2202,"_21483":57633,"_5":14766,"_28210":57586,"_3064":57634},[],"`status`",{"_3608":2219,"_31023":2202,"_21483":57636,"_5":14766,"_28210":57586,"_3064":57637},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3608":2220,"_31023":2202,"_21483":57639,"_5":14766,"_28210":57586,"_3064":57640},[],"`legacy_ski`",{"_3608":2221,"_31023":2202,"_21483":57642,"_5":14766,"_28210":57586,"_3064":57643},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3608":2222,"_31023":2202,"_21483":57645,"_5":14766,"_28210":57586,"_3064":57646},[],"`latest_crl`",{"_3608":2223,"_31023":2202,"_21483":57648,"_5":14766,"_28210":57586,"_3064":57649},[],"Version, validity start and end of the last published list. Read-only.",{"_3608":2224,"_31023":2202,"_21483":57651,"_5":14766,"_28210":57586,"_3064":57652},[],"`crl_options` field",{"_3608":2225,"_31023":2202,"_21483":57654,"_5":14766,"_28210":57586,"_3064":51117},[],{"_3608":2226,"_31023":2202,"_21483":57656,"_5":14766,"_28210":57586,"_3064":57657},[],"Initial value",{"_3608":2227,"_31023":2202,"_21483":57659,"_5":14766,"_28210":57586,"_3064":57660},[],"`validity`",{"_3608":2228,"_31023":2202,"_21483":57662,"_5":14766,"_28210":57586,"_3064":57663},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3608":2229,"_31023":2202,"_21483":57665,"_5":14766,"_28210":57586,"_3064":57666},[],"7 days.",{"_3608":2230,"_31023":2202,"_21483":57668,"_5":14766,"_28210":57586,"_3064":57669},[],"`refresh_interval`",{"_3608":2231,"_31023":2202,"_21483":57671,"_5":14766,"_28210":57586,"_3064":57672},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3608":2232,"_31023":2202,"_21483":57674,"_5":14766,"_28210":57586,"_3064":57675},[],"6 days and 23 hours.",{"_3608":2233,"_31023":2202,"_21483":57677,"_5":14766,"_28210":57586,"_3064":57678},[],"`regenerate_on_revoke`",{"_3608":2234,"_31023":2202,"_21483":57680,"_5":14766,"_28210":57586,"_3064":57681},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3608":2235,"_31023":2202,"_21483":57683,"_5":14766,"_28210":57586,"_3064":57684},[],"`true`.",{"_3608":2236,"_31023":2202,"_21483":57686,"_5":14766,"_28210":57586,"_3064":57687},[],"`signer_serial_number`",{"_3608":2237,"_31023":2202,"_21483":57689,"_5":14766,"_28210":57586,"_3064":57690},[],"Serial number of the existing certificate that signs the CRL.",{"_3608":2238,"_31023":2202,"_21483":57692,"_5":14766,"_28210":57586,"_3064":57693},[],"Serial number of the CA’s current certificate.",{"_3608":2239,"_31023":2202,"_21483":57695,"_5":14766,"_28210":57586,"_3064":57696},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3608":2240,"_31023":2202,"_21483":57698,"_5":14766,"_28210":57586,"_3064":57699},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3608":2241,"_31023":2202,"_21483":57701,"_5":14766,"_28210":57586,"_3064":57702},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3608":2242,"_31023":2202,"_21483":57704,"_5":14766,"_28210":57586,"_3064":57705},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3608":2243,"_31023":2202,"_21483":57707,"_5":14766,"_28210":57586,"_3064":57708},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3608":2244,"_31023":2202,"_21483":57710,"_5":14766,"_28210":57586,"_3064":57711},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3608":2245,"_31023":2202,"_21483":57713,"_5":14766,"_28210":57586,"_3064":57714},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3608":2246,"_31023":2202,"_21483":57716,"_5":14766,"_28210":57586,"_3064":57717},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3608":2247,"_31023":2202,"_21483":57719,"_5":14766,"_28210":57586,"_3064":57720},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3608":2248,"_31023":2202,"_21483":57722,"_5":14766,"_28210":57586,"_3064":57723},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3608":2249,"_31023":2202,"_21483":57725,"_5":14766,"_28210":57586,"_3064":57726},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3608":2250,"_31023":2202,"_21483":57728,"_5":14766,"_28210":57590,"_3064":57729},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3608":2251,"_31023":2202,"_21483":57731,"_5":14766,"_28210":57590,"_3064":57732},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3608":2252,"_31023":2202,"_21483":57734,"_5":14766,"_28210":57590,"_3064":57735},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3608":2253,"_31023":2202,"_21483":57737,"_5":14766,"_28210":57590,"_3064":57738},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3608":2254,"_31023":2202,"_21483":57740,"_5":14766,"_28210":57594,"_3064":57741},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3608":2255,"_31023":2202,"_21483":57743,"_5":14766,"_28210":57594,"_3064":57744},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3608":2256,"_31023":2202,"_21483":57746,"_5":14766,"_28210":57594,"_3064":57747},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3608":2257,"_31023":2202,"_21483":57749,"_5":14766,"_28210":57594,"_3064":57750},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3608":2258,"_31023":2202,"_21483":57752,"_5":14766,"_28210":57594,"_3064":57753},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3608":2259,"_31023":2202,"_21483":57755,"_5":14766,"_28210":57594,"_3064":57756},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3608":2260,"_31023":2202,"_21483":57758,"_5":14766,"_28210":57594,"_3064":57759},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3608":2261,"_31023":2202,"_21483":57761,"_5":14766,"_28210":57594,"_3064":57762},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3608":2262,"_31023":2202,"_21483":57764,"_5":14766,"_28210":57594,"_3064":57765},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3608":2263,"_31023":2202,"_21483":57767,"_5":14766,"_28210":57598,"_3064":57768},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3608":2264,"_31023":2202,"_21483":57770,"_5":14766,"_28210":57598,"_3064":57771},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3608":2265,"_31023":2202,"_21483":57773,"_5":14766,"_28210":57602,"_3064":57774},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3608":2266,"_31023":2202,"_21483":57776,"_5":14766,"_28210":57602,"_3064":57777},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3608":2267,"_31023":2202,"_21483":57779,"_5":14766,"_28210":57602,"_3064":57780},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3608":2268,"_31023":2202,"_21483":57782,"_5":14766,"_28210":57602,"_3064":57783},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3608":2269,"_31023":2202,"_21483":57785,"_5":14766,"_28210":57602,"_3064":57786},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3608":2270,"_31023":2202,"_21483":57788,"_5":14766,"_28210":57606,"_3064":57789},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3608":2271,"_31023":2202,"_21483":57791,"_5":14766,"_28210":57606,"_3064":54167},[],{"_3608":2272,"_31023":2202,"_21483":57793,"_5":14766,"_28210":57606,"_3064":57794},[],"Relative path",{"_3608":2273,"_31023":2202,"_21483":57796,"_5":14766,"_28210":57606,"_3064":54164},[],{"_3608":2274,"_31023":2202,"_21483":57798,"_5":14766,"_28210":57606,"_3064":57799},[],"`GET`",{"_3608":2275,"_31023":2202,"_21483":57801,"_5":14766,"_28210":57606,"_3064":57802},[],"`/v1/crl-settings`",{"_3608":2276,"_31023":2202,"_21483":57804,"_5":14766,"_28210":57606,"_3064":57805},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3608":2277,"_31023":2202,"_21483":57807,"_5":14766,"_28210":57606,"_3064":57799},[],{"_3608":2278,"_31023":2202,"_21483":57809,"_5":14766,"_28210":57606,"_3064":57810},[],"`/v1/crl-settings/{ca-id}`",{"_3608":2279,"_31023":2202,"_21483":57812,"_5":14766,"_28210":57606,"_3064":57813},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3608":2280,"_31023":2202,"_21483":57815,"_5":14766,"_28210":57606,"_3064":57816},[],"`PUT`",{"_3608":2281,"_31023":2202,"_21483":57818,"_5":14766,"_28210":57606,"_3064":57810},[],{"_3608":2282,"_31023":2202,"_21483":57820,"_5":14766,"_28210":57606,"_3064":57821},[],"Replace the CRL configuration of a CA.",{"_3608":2283,"_31023":2202,"_21483":57823,"_5":14766,"_28210":57606,"_3064":57824},[],"`DELETE`",{"_3608":2284,"_31023":2202,"_21483":57826,"_5":14766,"_28210":57606,"_3064":57810},[],{"_3608":2285,"_31023":2202,"_21483":57828,"_5":14766,"_28210":57606,"_3064":57829},[],"Remove the archived CRL settings of a CA.",{"_3608":2286,"_31023":2202,"_21483":57831,"_5":14766,"_28210":57606,"_3064":57832},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3608":2287,"_31023":2202,"_21483":57834,"_5":14766,"_28210":57606,"_3064":57835},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3608":2288,"_31023":2202,"_21483":57837,"_5":14766,"_28210":57606,"_3064":57838},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3608":2289,"_31023":2202,"_21483":57840,"_5":14766,"_28210":57610,"_3064":57841},[],"Symptom",{"_3608":2290,"_31023":2202,"_21483":57843,"_5":14766,"_28210":57610,"_3064":57844},[],"Cause",{"_3608":2291,"_31023":2202,"_21483":57846,"_5":14766,"_28210":57610,"_3064":57847},[],"Action",{"_3608":2292,"_31023":2202,"_21483":57849,"_5":14766,"_28210":57610,"_3064":57850},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3608":2293,"_31023":2202,"_21483":57852,"_5":14766,"_28210":57610,"_3064":57853},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3608":2294,"_31023":2202,"_21483":57855,"_5":14766,"_28210":57610,"_3064":57856},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3608":2295,"_31023":2202,"_21483":57858,"_5":14766,"_28210":57610,"_3064":57859},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3608":2296,"_31023":2202,"_21483":57861,"_5":14766,"_28210":57610,"_3064":57862},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3608":2297,"_31023":2202,"_21483":57864,"_5":14766,"_28210":57610,"_3064":57865},[],"Delete the CA first; deleting it archives its settings.",{"_3608":2298,"_31023":2202,"_21483":57867,"_5":14766,"_28210":57610,"_3064":57868},[],"`PUT` returns 400.",{"_3608":2299,"_31023":2202,"_21483":57870,"_5":14766,"_28210":57610,"_3064":57871},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3608":2300,"_31023":2202,"_21483":57873,"_5":14766,"_28210":57610,"_3064":57874},[],"Set the serial number of a valid certificate of that CA.",{"_3608":2301,"_31023":2202,"_21483":57876,"_5":14766,"_28210":57610,"_3064":57877},[],"`PUT` returns 404.",{"_3608":2302,"_31023":2202,"_21483":57879,"_5":14766,"_28210":57610,"_3064":57880},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3608":2303,"_31023":2202,"_21483":57882,"_5":14766,"_28210":57610,"_3064":57883},[],"Check the CA ID and the signer serial number.",{"_3608":2304,"_31023":2202,"_21483":57885,"_5":14766,"_28210":57610,"_3064":57886},[],"`PUT` returns 400 from a 3.x client.",{"_3608":2305,"_31023":2202,"_21483":57888,"_5":14766,"_28210":57610,"_3064":57889},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3608":2306,"_31023":2202,"_21483":57891,"_5":14766,"_28210":57610,"_3064":57892},[],"Update the client to send the new field.",{"_3608":2307,"_31023":2202,"_21483":57894,"_5":14766,"_28210":57610,"_3064":57895},[],"The CRL does not change after revoking a certificate.",{"_3608":2308,"_31023":2202,"_21483":57897,"_5":14766,"_28210":57610,"_3064":57898},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3608":2309,"_31023":2202,"_21483":57900,"_5":14766,"_28210":57610,"_3064":57901},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3608":2310,"_31023":2202,"_21483":57903,"_5":14766,"_28210":57610,"_3064":57904},[],"A verifier rejects the CRL because of the issuer.",{"_3608":2311,"_31023":2202,"_21483":57906,"_5":14766,"_28210":57610,"_3064":57907},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3608":2312,"_31023":2202,"_21483":57909,"_5":14766,"_28210":57610,"_3064":57910},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3608":2313,"_31023":2202,"_21483":57912,"_5":14766,"_28210":57614,"_3064":57913},[],"RFC 5280: X.509 and CRL profile.",{"_3608":2314,"_31023":2202,"_21483":57915,"_5":14766,"_28210":57614,"_3064":57916},[],"OpenSSL: openssl-crl.",{"_3608":2315,"_31023":2202,"_21483":57918,"_5":14766,"_28210":57614,"_3064":57919},[],"OpenSSL: openssl-verify.",{"_3608":2316,"_31023":2202,"_21483":57921,"_5":14766,"_28210":57614,"_3064":57922},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3608":2317,"_31023":2202,"_21483":57924,"_5":14766,"_28210":57614,"_3064":57925},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3608":2318,"_31023":2318,"_5":15126,"_3064":57927,"_31381":57928,"_21483":57929,"_28210":2318},"Keys and cryptographic engines",[50727,52239,56402,56403],[],{"_3608":2319,"_31023":2318,"_21483":57931,"_5":14766,"_28210":2318,"_3064":57932},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3608":2320,"_31023":2318,"_5":31378,"_21483":57934,"_28210":57935,"_3064":57936},[],"/docs/pr-preview/pr-72/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3608":2321,"_31023":2318,"_5":31378,"_21483":57938,"_28210":57939,"_3064":57940},[],"/docs/pr-preview/pr-72/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3608":2322,"_31023":2318,"_5":31378,"_21483":57942,"_28210":57943,"_3064":57944},[],"/docs/pr-preview/pr-72/platform/pki/key-management#file-system","File System",{"_3608":2323,"_31023":2318,"_5":31378,"_21483":57946,"_28210":57947,"_3064":57948},[],"/docs/pr-preview/pr-72/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3608":2324,"_31023":2318,"_5":31378,"_21483":57950,"_28210":57951,"_3064":57952},[],"/docs/pr-preview/pr-72/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3608":2325,"_31023":2318,"_5":31378,"_21483":57954,"_28210":57955,"_3064":57956},[],"/docs/pr-preview/pr-72/platform/pki/key-management#aws-kms","AWS KMS",{"_3608":2326,"_31023":2318,"_5":31378,"_21483":57958,"_28210":57959,"_3064":57960},[],"/docs/pr-preview/pr-72/platform/pki/key-management#pkcs11","PKCS#11",{"_3608":2327,"_31023":2318,"_5":31378,"_21483":57962,"_28210":57963,"_3064":57964},[],"/docs/pr-preview/pr-72/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3608":2328,"_31023":2318,"_5":31378,"_21483":57966,"_28210":57967,"_3064":57968},[],"/docs/pr-preview/pr-72/platform/pki/key-management#key-inventory","Key inventory",{"_3608":2329,"_31023":2318,"_5":31378,"_21483":57970,"_28210":57971,"_3064":57972},[],"/docs/pr-preview/pr-72/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3608":2330,"_31023":2318,"_5":31378,"_21483":57974,"_28210":57975,"_3064":57976},[],"/docs/pr-preview/pr-72/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3608":2331,"_31023":2318,"_5":31378,"_21483":57978,"_28210":57979,"_3064":57980},[],"/docs/pr-preview/pr-72/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3608":2332,"_31023":2318,"_5":31378,"_21483":57982,"_28210":57983,"_3064":57984},[],"/docs/pr-preview/pr-72/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3608":2333,"_31023":2318,"_5":31378,"_21483":57986,"_28210":57987,"_3064":57988},[],"/docs/pr-preview/pr-72/platform/pki/key-management#view-details","View details",{"_3608":2334,"_31023":2318,"_5":31378,"_21483":57990,"_28210":57991,"_3064":57992},[],"/docs/pr-preview/pr-72/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3608":2335,"_31023":2318,"_5":31378,"_21483":57994,"_28210":57995,"_3064":57996},[],"/docs/pr-preview/pr-72/platform/pki/key-management#sign","Sign",{"_3608":2336,"_31023":2318,"_5":31378,"_21483":57998,"_28210":57999,"_3064":58000},[],"/docs/pr-preview/pr-72/platform/pki/key-management#verify","Verify",{"_3608":2337,"_31023":2318,"_5":31378,"_21483":58002,"_28210":58003,"_3064":58004},[],"/docs/pr-preview/pr-72/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3608":2338,"_31023":2318,"_5":31378,"_21483":58006,"_28210":58007,"_3064":58008},[],"/docs/pr-preview/pr-72/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3608":2339,"_31023":2318,"_5":31378,"_21483":58010,"_28210":58011,"_3064":58012},[],"/docs/pr-preview/pr-72/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3608":2340,"_31023":2318,"_21483":58014,"_5":14766,"_28210":2318,"_3064":58015},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3608":2341,"_31023":2318,"_21483":58017,"_5":14766,"_28210":2318,"_3064":58018},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3608":2342,"_31023":2318,"_21483":58020,"_5":14766,"_28210":57935,"_3064":58021},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3608":2343,"_31023":2318,"_21483":58023,"_5":14766,"_28210":57935,"_3064":58024},[],"In practice, it lets you:",{"_3608":2344,"_31023":2318,"_21483":58026,"_5":14766,"_28210":57935,"_3064":58027},[],"Generate new key pairs from Lamassu IoT.",{"_3608":2345,"_31023":2318,"_21483":58029,"_5":14766,"_28210":57935,"_3064":58030},[],"Import keys created externally.",{"_3608":2346,"_31023":2318,"_21483":58032,"_5":14766,"_28210":57935,"_3064":58033},[],"Delegate custody and cryptographic operations to external engines.",{"_3608":2347,"_31023":2318,"_21483":58035,"_5":14766,"_28210":57935,"_3064":58036},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3608":2348,"_31023":2318,"_21483":58038,"_5":14766,"_28210":57939,"_3064":58039},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3608":2349,"_31023":2318,"_21483":58041,"_5":14766,"_28210":57939,"_3064":58042},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3608":2350,"_31023":2318,"_21483":58044,"_5":14766,"_28210":57939,"_3064":58045},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3608":2351,"_31023":2318,"_21483":58047,"_5":14766,"_28210":57943,"_3064":58048},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3608":2352,"_31023":2318,"_21483":58050,"_5":14766,"_28210":57947,"_3064":58051},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3608":2353,"_31023":2318,"_21483":58053,"_5":14766,"_28210":57947,"_3064":58054},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3608":2354,"_31023":2318,"_21483":58056,"_5":14766,"_28210":57951,"_3064":58057},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3608":2355,"_31023":2318,"_21483":58059,"_5":14766,"_28210":57955,"_3064":58060},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3608":2356,"_31023":2318,"_21483":58062,"_5":14766,"_28210":57959,"_3064":58063},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3608":2357,"_31023":2318,"_21483":58065,"_5":14766,"_28210":57963,"_3064":58066},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3608":2358,"_31023":2318,"_21483":58068,"_5":14766,"_28210":57963,"_3064":58069},[],"Lamassu shows the enabled engines in the console.",{"_3608":2359,"_31023":2318,"_21483":58071,"_5":14766,"_28210":57963,"_3064":58072},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3608":2360,"_31023":2318,"_21483":58074,"_5":14766,"_28210":57963,"_3064":58075},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3608":2361,"_31023":2318,"_21483":58077,"_5":14766,"_28210":57967,"_3064":58078},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3608":2362,"_31023":2318,"_21483":58080,"_5":14766,"_28210":57967,"_3064":58081},[],"The table includes the following fields:",{"_3608":2363,"_31023":2318,"_21483":58083,"_5":14766,"_28210":57967,"_3064":58084},[],"**Name**: descriptive name of the key.",{"_3608":2364,"_31023":2318,"_21483":58086,"_5":14766,"_28210":57967,"_3064":58087},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3608":2365,"_31023":2318,"_21483":58089,"_5":14766,"_28210":57967,"_3064":58090},[],"**Strength**: visual indicator of cryptographic strength.",{"_3608":2366,"_31023":2318,"_21483":58092,"_5":14766,"_28210":57967,"_3064":58093},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3608":2367,"_31023":2318,"_21483":58095,"_5":14766,"_28210":57967,"_3064":58096},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3608":2368,"_31023":2318,"_21483":58098,"_5":14766,"_28210":57967,"_3064":58099},[],"**Aliases**: alternative names associated with the key.",{"_3608":2369,"_31023":2318,"_21483":58101,"_5":14766,"_28210":57967,"_3064":58102},[],"**Tags**: labels for classification and search.",{"_3608":2370,"_31023":2318,"_21483":58104,"_5":14766,"_28210":57967,"_3064":58105},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3608":2371,"_31023":2318,"_21483":58107,"_5":14766,"_28210":57967,"_3064":58108},[],"From this view you also reach the most common actions:",{"_3608":2372,"_31023":2318,"_21483":58110,"_5":14766,"_28210":57967,"_3064":58111},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3608":2373,"_31023":2318,"_21483":58113,"_5":14766,"_28210":57967,"_3064":58114},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3608":2374,"_31023":2318,"_21483":58116,"_5":14766,"_28210":57967,"_3064":58117},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3608":2375,"_31023":2318,"_21483":58119,"_5":14766,"_28210":57967,"_3064":58120},[],"**Delete Key** to remove the key from the system.",{"_3608":2376,"_31023":2318,"_21483":58122,"_5":14766,"_28210":57971,"_3064":58123},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3608":2377,"_31023":2318,"_21483":58125,"_5":14766,"_28210":57975,"_3064":58126},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3608":2378,"_31023":2318,"_21483":58128,"_5":14766,"_28210":57975,"_3064":58129},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3608":2379,"_31023":2318,"_21483":58131,"_5":14766,"_28210":57975,"_3064":58132},[],"**Key Name**: unique and descriptive name.",{"_3608":2380,"_31023":2318,"_21483":58134,"_5":14766,"_28210":57975,"_3064":58135},[],"**Crypto Engine**: engine that will keep the key.",{"_3608":2381,"_31023":2318,"_21483":58137,"_5":14766,"_28210":57975,"_3064":58138},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3608":2382,"_31023":2318,"_21483":58140,"_5":14766,"_28210":57975,"_3064":58141},[],"**Tags**: metadata to classify the key.",{"_3608":2383,"_31023":2318,"_21483":58143,"_5":14766,"_28210":57975,"_3064":58144},[],"**Metadata**: additional information for advanced uses.",{"_3608":2384,"_31023":2318,"_21483":58146,"_5":14766,"_28210":57979,"_3064":58147},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3608":2385,"_31023":2318,"_21483":58149,"_5":14766,"_28210":57979,"_3064":58150},[],"When you have an exportable private key and the destination engine supports import.",{"_3608":2386,"_31023":2318,"_21483":58152,"_5":14766,"_28210":57979,"_3064":58153},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3608":2387,"_31023":2318,"_21483":58155,"_5":14766,"_28210":57979,"_3064":58156},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3608":2388,"_31023":2318,"_21483":58158,"_5":14766,"_28210":57979,"_3064":58159},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3608":2389,"_31023":2318,"_21483":58161,"_5":14766,"_28210":57979,"_3064":58162},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3608":2390,"_31023":2318,"_21483":58164,"_5":14766,"_28210":57979,"_3064":58165},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3608":2391,"_31023":2318,"_21483":58167,"_5":14766,"_28210":57979,"_3064":58168},[],"**Tags**: labels for organization and search.",{"_3608":2392,"_31023":2318,"_21483":58170,"_5":14766,"_28210":57979,"_3064":58171},[],"**Metadata**: additional optional information.",{"_3608":2393,"_31023":2318,"_21483":58173,"_5":14766,"_28210":57979,"_3064":58174},[],"**Private Key (PEM)**: private key in PEM format.",{"_3608":2394,"_31023":2318,"_21483":58176,"_5":14766,"_28210":57979,"_3064":58177},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3608":2395,"_31023":2318,"_21483":58179,"_5":14766,"_28210":57983,"_3064":58180},[],"Each registered key has a detail view and several operational actions.",{"_3608":2396,"_31023":2318,"_21483":58182,"_5":14766,"_28210":57987,"_3064":58183},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3608":2397,"_31023":2318,"_21483":58185,"_5":14766,"_28210":57987,"_3064":58186},[],"The **Overview** tab shows, among others, these fields:",{"_3608":2398,"_31023":2318,"_21483":58188,"_5":14766,"_28210":57987,"_3064":58189},[],"**Key Name**: descriptive name.",{"_3608":2399,"_31023":2318,"_21483":58191,"_5":14766,"_28210":57987,"_3064":58192},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3608":2400,"_31023":2318,"_21483":58194,"_5":14766,"_28210":57987,"_3064":58195},[],"**Tags**: associated labels.",{"_3608":2401,"_31023":2318,"_21483":58197,"_5":14766,"_28210":57987,"_3064":58198},[],"**Aliases**: alternative names.",{"_3608":2402,"_31023":2318,"_21483":58200,"_5":14766,"_28210":57987,"_3064":58201},[],"**Crypto Engine**: engine where the key resides.",{"_3608":2403,"_31023":2318,"_21483":58203,"_5":14766,"_28210":57987,"_3064":58204},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3608":2404,"_31023":2318,"_21483":58206,"_5":14766,"_28210":57987,"_3064":58207},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3608":2405,"_31023":2318,"_21483":58209,"_5":14766,"_28210":57987,"_3064":58210},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3608":2406,"_31023":2318,"_21483":58212,"_5":14766,"_28210":57991,"_3064":58213},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3608":2407,"_31023":2318,"_21483":58215,"_5":14766,"_28210":57991,"_3064":58216},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3608":2408,"_31023":2318,"_21483":58218,"_5":14766,"_28210":57991,"_3064":58219},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3608":2409,"_31023":2318,"_21483":58221,"_5":14766,"_28210":57995,"_3064":58222},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3608":2410,"_31023":2318,"_21483":58224,"_5":14766,"_28210":57995,"_3064":58225},[],"Main fields:",{"_3608":2411,"_31023":2318,"_21483":58227,"_5":14766,"_28210":57995,"_3064":58228},[],"**Algorithm**: signing algorithm available for the key type.",{"_3608":2412,"_31023":2318,"_21483":58230,"_5":14766,"_28210":57995,"_3064":58231},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3608":2413,"_31023":2318,"_21483":58233,"_5":14766,"_28210":57995,"_3064":58234},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3608":2414,"_31023":2318,"_21483":58236,"_5":14766,"_28210":57995,"_3064":58237},[],"**Message**: content to sign.",{"_3608":2415,"_31023":2318,"_21483":58239,"_5":14766,"_28210":57995,"_3064":58240},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3608":2416,"_31023":2318,"_21483":58242,"_5":14766,"_28210":57999,"_3064":58243},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3608":2417,"_31023":2318,"_21483":58245,"_5":14766,"_28210":57999,"_3064":58225},[],{"_3608":2418,"_31023":2318,"_21483":58247,"_5":14766,"_28210":57999,"_3064":58248},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3608":2419,"_31023":2318,"_21483":58250,"_5":14766,"_28210":57999,"_3064":58251},[],"**Message Type**: `Raw` or `Digest`.",{"_3608":2420,"_31023":2318,"_21483":58253,"_5":14766,"_28210":57999,"_3064":58254},[],"**Payload Encoding**: encoding of the message.",{"_3608":2421,"_31023":2318,"_21483":58256,"_5":14766,"_28210":57999,"_3064":58257},[],"**Message**: original message or hash.",{"_3608":2422,"_31023":2318,"_21483":58259,"_5":14766,"_28210":57999,"_3064":58260},[],"**Signature**: signature to check.",{"_3608":2423,"_31023":2318,"_21483":58262,"_5":14766,"_28210":57999,"_3064":58263},[],"**Result**: indicator of the validation result.",{"_3608":2424,"_31023":2318,"_21483":58265,"_5":14766,"_28210":58003,"_3064":58266},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3608":2425,"_31023":2318,"_21483":58268,"_5":14766,"_28210":58003,"_3064":58269},[],"This flow is useful for:",{"_3608":2426,"_31023":2318,"_21483":58271,"_5":14766,"_28210":58003,"_3064":58272},[],"Requesting certificates from an external CA.",{"_3608":2427,"_31023":2318,"_21483":58274,"_5":14766,"_28210":58003,"_3064":58275},[],"Renewing an identity while keeping the same key.",{"_3608":2428,"_31023":2318,"_21483":58277,"_5":14766,"_28210":58003,"_3064":58278},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3608":2429,"_31023":2318,"_21483":58280,"_5":14766,"_28210":58003,"_3064":58281},[],"**Common Name (CN)**: main name of the identity.",{"_3608":2430,"_31023":2318,"_21483":58283,"_5":14766,"_28210":58003,"_3064":58284},[],"**Organization (O)**: organization or company.",{"_3608":2431,"_31023":2318,"_21483":58286,"_5":14766,"_28210":58003,"_3064":58287},[],"**Organizational Unit (OU)**: department or unit.",{"_3608":2432,"_31023":2318,"_21483":58289,"_5":14766,"_28210":58003,"_3064":58290},[],"**Country (C)**: two-letter country code.",{"_3608":2433,"_31023":2318,"_21483":58292,"_5":14766,"_28210":58003,"_3064":58293},[],"**State / Province (ST)**: state or province.",{"_3608":2434,"_31023":2318,"_21483":58295,"_5":14766,"_28210":58003,"_3064":58296},[],"**Locality (L)**: city or locality.",{"_3608":2435,"_31023":2318,"_21483":58298,"_5":14766,"_28210":58003,"_3064":58299},[],"**Email Address**: contact email.",{"_3608":2436,"_31023":2318,"_21483":58301,"_5":14766,"_28210":58003,"_3064":58302},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3608":2437,"_31023":2318,"_21483":58304,"_5":14766,"_28210":58003,"_3064":58305},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3608":2438,"_31023":2318,"_21483":58307,"_5":14766,"_28210":58007,"_3064":58308},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3608":2439,"_31023":2318,"_21483":58310,"_5":14766,"_28210":58007,"_3064":58311},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3608":2440,"_31023":2318,"_21483":58313,"_5":14766,"_28210":58011,"_3064":58314},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3608":2441,"_31023":2318,"_21483":58316,"_5":14766,"_28210":58011,"_3064":58317},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3608":2442,"_31023":2442,"_5":15126,"_3064":58319,"_31381":58320,"_21483":58321,"_28210":2442},"Online validation with OCSP",[50727,52239,56402,57050],[],{"_3608":2443,"_31023":2442,"_21483":58323,"_5":14766,"_28210":2442,"_3064":58324},[],"Query signed status and verify the responder’s response.",{"_3608":2444,"_31023":2442,"_5":31378,"_21483":58326,"_28210":58327,"_3064":58328},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3608":2445,"_31023":2442,"_5":31378,"_21483":58330,"_28210":58331,"_3064":58332},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3608":2446,"_31023":2442,"_5":31378,"_21483":58334,"_28210":58335,"_3064":58336},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3608":2447,"_31023":2442,"_5":31378,"_21483":58338,"_28210":58339,"_3064":58340},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3608":2448,"_31023":2442,"_5":31378,"_21483":58342,"_28210":58343,"_3064":58344},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3608":2449,"_31023":2442,"_5":31378,"_21483":58346,"_28210":58347,"_3064":57615},[],"/docs/pr-preview/pr-72/platform/pki/ocsp#references",{"_3608":2450,"_31023":2442,"_21483":58349,"_5":14766,"_28210":2442,"_3064":58350},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3608":2451,"_31023":2442,"_21483":58352,"_5":14766,"_28210":58327,"_3064":58353},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3608":2452,"_31023":2442,"_21483":58355,"_5":14766,"_28210":58327,"_3064":58356},[],"Record status",{"_3608":2453,"_31023":2442,"_21483":58358,"_5":14766,"_28210":58327,"_3064":58359},[],"Signed response",{"_3608":2454,"_31023":2442,"_21483":58361,"_5":14766,"_28210":58327,"_3064":55539},[],{"_3608":2455,"_31023":2442,"_21483":58363,"_5":14766,"_28210":58327,"_3064":58364},[],"`Good`.",{"_3608":2456,"_31023":2442,"_21483":58366,"_5":14766,"_28210":58327,"_3064":55556},[],{"_3608":2457,"_31023":2442,"_21483":58368,"_5":14766,"_28210":58327,"_3064":58369},[],"`Revoked`, with revocation reason and timestamp.",{"_3608":2458,"_31023":2442,"_21483":58371,"_5":14766,"_28210":58327,"_3064":58372},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3608":2459,"_31023":2442,"_21483":58374,"_5":14766,"_28210":58327,"_3064":58375},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3608":2460,"_31023":2442,"_21483":58377,"_5":14766,"_28210":58327,"_3064":58378},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3608":2461,"_31023":2442,"_21483":58380,"_5":14766,"_28210":58327,"_3064":58381},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3608":2462,"_31023":2442,"_21483":58383,"_5":14766,"_28210":58327,"_3064":58384},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3608":2463,"_31023":2442,"_21483":58386,"_5":14766,"_28210":58331,"_3064":58387},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3608":2464,"_31023":2442,"_21483":58389,"_5":14766,"_28210":58331,"_3064":58390},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3608":2465,"_31023":2442,"_21483":58392,"_5":14766,"_28210":58335,"_3064":58393},[],"The service accepts:",{"_3608":2466,"_31023":2442,"_21483":58395,"_5":14766,"_28210":58335,"_3064":54167},[],{"_3608":2467,"_31023":2442,"_21483":58397,"_5":14766,"_28210":58335,"_3064":58398},[],"VA service path",{"_3608":2468,"_31023":2442,"_21483":58400,"_5":14766,"_28210":58335,"_3064":58401},[],"Format",{"_3608":2469,"_31023":2442,"_21483":58403,"_5":14766,"_28210":58335,"_3064":58404},[],"`POST`",{"_3608":2470,"_31023":2442,"_21483":58406,"_5":14766,"_28210":58335,"_3064":58407},[],"`/ocsp`",{"_3608":2471,"_31023":2442,"_21483":58409,"_5":14766,"_28210":58335,"_3064":58410},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3608":2472,"_31023":2442,"_21483":58412,"_5":14766,"_28210":58335,"_3064":57799},[],{"_3608":2473,"_31023":2442,"_21483":58414,"_5":14766,"_28210":58335,"_3064":58415},[],"`/ocsp/{ocsp_request}`",{"_3608":2474,"_31023":2442,"_21483":58417,"_5":14766,"_28210":58335,"_3064":58418},[],"DER request encoded using padded URL Base64.",{"_3608":2475,"_31023":2442,"_21483":58420,"_5":14766,"_28210":58335,"_3064":58421},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3608":2476,"_31023":2442,"_21483":58423,"_5":14766,"_28210":58339,"_3064":58424},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3608":2477,"_31023":2442,"_21483":58426,"_5":14766,"_28210":58339,"_3064":58427},[],"Generate the request:",{"_3608":2478,"_31023":2442,"_21483":58429,"_5":14766,"_28210":58339,"_3064":58430},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3608":2479,"_31023":2442,"_21483":58432,"_5":14766,"_28210":58339,"_3064":58433},[],"Replace the example URL with the inspected endpoint:",{"_3608":2480,"_31023":2442,"_21483":58435,"_5":14766,"_28210":58339,"_3064":58436},[],"Verify the returned DER:",{"_3608":2481,"_31023":2442,"_21483":58438,"_5":14766,"_28210":58339,"_3064":58439},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3608":2482,"_31023":2442,"_21483":58441,"_5":14766,"_28210":58343,"_3064":58442},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3608":2483,"_31023":2442,"_21483":58444,"_5":14766,"_28210":58343,"_3064":58445},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3608":2484,"_31023":2442,"_21483":58447,"_5":14766,"_28210":58347,"_3064":58448},[],"RFC 6960: OCSP.",{"_3608":2485,"_31023":2442,"_21483":58450,"_5":14766,"_28210":58347,"_3064":58451},[],"OpenSSL: openssl-ocsp.",{"_3608":2486,"_31023":2442,"_21483":58453,"_5":14766,"_28210":58347,"_3064":58454},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3608":2487,"_31023":2442,"_21483":58456,"_5":14766,"_28210":58347,"_3064":57925},[],{"_3608":2488,"_31023":2488,"_5":15126,"_3064":56402,"_31381":58458,"_21483":58459,"_28210":2488},[50727,52239,56402],[],{"_3608":2489,"_31023":2488,"_21483":58461,"_5":14766,"_28210":2488,"_3064":58462},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3608":2490,"_31023":2488,"_5":31378,"_21483":58464,"_28210":58465,"_3064":55714},[],"/docs/pr-preview/pr-72/platform/pki/overview#start-here",{"_3608":2491,"_31023":2488,"_5":31378,"_21483":58467,"_28210":58468,"_3064":58469},[],"/docs/pr-preview/pr-72/platform/pki/overview#what-you-need","What you need",{"_3608":2492,"_31023":2488,"_5":31378,"_21483":58471,"_28210":58472,"_3064":56246},[],"/docs/pr-preview/pr-72/platform/pki/overview#core-capabilities",{"_3608":2493,"_31023":2488,"_5":31378,"_21483":58474,"_28210":58475,"_3064":56250},[],"/docs/pr-preview/pr-72/platform/pki/overview#build-your-trust-hierarchy",{"_3608":2494,"_31023":2488,"_5":31378,"_21483":58477,"_28210":58478,"_3064":56254},[],"/docs/pr-preview/pr-72/platform/pki/overview#protect-cryptographic-keys",{"_3608":2495,"_31023":2488,"_5":31378,"_21483":58480,"_28210":58481,"_3064":56258},[],"/docs/pr-preview/pr-72/platform/pki/overview#issue-and-control-certificates",{"_3608":2496,"_31023":2488,"_5":31378,"_21483":58483,"_28210":58484,"_3064":56266},[],"/docs/pr-preview/pr-72/platform/pki/overview#publish-validation-status",{"_3608":2497,"_31023":2488,"_5":31378,"_21483":58486,"_28210":58487,"_3064":58488},[],"/docs/pr-preview/pr-72/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3608":2498,"_31023":2488,"_5":31378,"_21483":58490,"_28210":58491,"_3064":57217},[],"/docs/pr-preview/pr-72/platform/pki/overview#continue",{"_3608":2499,"_31023":2488,"_21483":58493,"_5":14766,"_28210":2488,"_3064":58494},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3608":2500,"_31023":2488,"_21483":58496,"_5":14766,"_28210":58465,"_3064":58497},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3608":2501,"_31023":2488,"_21483":58499,"_5":14766,"_28210":58465,"_3064":58500},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3608":2502,"_31023":2488,"_21483":58502,"_5":14766,"_28210":58468,"_3064":58503},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3608":2503,"_31023":2488,"_21483":58505,"_5":14766,"_28210":58468,"_3064":58506},[],"An available cryptographic engine to keep the authority's key.",{"_3608":2504,"_31023":2488,"_21483":58508,"_5":14766,"_28210":58468,"_3064":58509},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3608":2505,"_31023":2488,"_21483":58511,"_5":14766,"_28210":58468,"_3064":58512},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3608":2506,"_31023":2488,"_21483":58514,"_5":14766,"_28210":58468,"_3064":58515},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3608":2507,"_31023":2488,"_21483":58517,"_5":14766,"_28210":58475,"_3064":58518},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3608":2508,"_31023":2488,"_21483":58520,"_5":14766,"_28210":58478,"_3064":58521},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3608":2509,"_31023":2488,"_21483":58523,"_5":14766,"_28210":58481,"_3064":58524},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3608":2510,"_31023":2488,"_21483":58526,"_5":14766,"_28210":58484,"_3064":58527},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3608":2511,"_31023":2488,"_21483":58529,"_5":14766,"_28210":58487,"_3064":58530},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3608":2512,"_31023":2488,"_21483":58532,"_5":14766,"_28210":58487,"_3064":58533},[],"its subject and extensions identify the expected client;",{"_3608":2513,"_31023":2488,"_21483":58535,"_5":14766,"_28210":58487,"_3064":58536},[],"its public key matches the client's private key;",{"_3608":2514,"_31023":2488,"_21483":58538,"_5":14766,"_28210":58487,"_3064":58539},[],"its chain reaches a root trusted by the consumer;",{"_3608":2515,"_31023":2488,"_21483":58541,"_5":14766,"_28210":58487,"_3064":58542},[],"its dates and usages allow the operation;",{"_3608":2516,"_31023":2488,"_21483":58544,"_5":14766,"_28210":58487,"_3064":58545},[],"the consumer applies revocation checks and authorization.",{"_3608":2517,"_31023":2488,"_21483":58547,"_5":14766,"_28210":58487,"_3064":58548},[],"The issuance path includes the first independent checks.",{"_3608":2518,"_31023":2488,"_21483":58550,"_5":14766,"_28210":58491,"_3064":58551},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3608":2519,"_31023":2488,"_21483":58553,"_5":14766,"_28210":58491,"_3064":58554},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3608":2520,"_31023":2488,"_21483":58556,"_5":14766,"_28210":58491,"_3064":58557},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3608":2521,"_31023":2521,"_5":15126,"_3064":58559,"_31381":58560,"_21483":58561,"_28210":2521},"Create your first CA",[50727,52239,56402,55839],[],{"_3608":2522,"_31023":2521,"_21483":58563,"_5":14766,"_28210":2521,"_3064":58564},[],"Create an evaluation root and check its certificate before issuing.",{"_3608":2523,"_31023":2521,"_5":31378,"_21483":58566,"_28210":58567,"_3064":50737},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3608":2524,"_31023":2521,"_5":31378,"_21483":58569,"_28210":58570,"_3064":58571},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3608":2525,"_31023":2521,"_5":31378,"_21483":58573,"_28210":58574,"_3064":58575},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3608":2526,"_31023":2521,"_5":31378,"_21483":58577,"_28210":58578,"_3064":58579},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3608":2527,"_31023":2521,"_5":31378,"_21483":58581,"_28210":58582,"_3064":58583},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3608":2528,"_31023":2521,"_5":31378,"_21483":58585,"_28210":58586,"_3064":58587},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3608":2529,"_31023":2521,"_5":31378,"_21483":58589,"_28210":58590,"_3064":58591},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3608":2530,"_31023":2521,"_5":31378,"_21483":58593,"_28210":58594,"_3064":56096},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3608":2531,"_31023":2521,"_5":31378,"_21483":58596,"_28210":58597,"_3064":50761},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3608":2532,"_31023":2521,"_21483":58599,"_5":14766,"_28210":2521,"_3064":58600},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3608":2533,"_31023":2521,"_21483":58602,"_5":14766,"_28210":58567,"_3064":58603},[],"Console access and permission to create keys and authorities.",{"_3608":2534,"_31023":2521,"_21483":58605,"_5":14766,"_28210":58567,"_3064":58606},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3608":2535,"_31023":2521,"_21483":58608,"_5":14766,"_28210":58567,"_3064":58609},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3608":2536,"_31023":2521,"_21483":58611,"_5":14766,"_28210":58567,"_3064":58612},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3608":2537,"_31023":2521,"_21483":58614,"_5":14766,"_28210":58570,"_3064":58615},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3608":2538,"_31023":2521,"_21483":58617,"_5":14766,"_28210":58570,"_3064":58618},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3608":2539,"_31023":2521,"_21483":58620,"_5":14766,"_28210":58574,"_3064":58621},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3608":2540,"_31023":2521,"_21483":58623,"_5":14766,"_28210":58574,"_3064":58624},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3608":2541,"_31023":2521,"_21483":58626,"_5":14766,"_28210":58578,"_3064":58627},[],"Select **Root CA** and complete:",{"_3608":2542,"_31023":2521,"_21483":58629,"_5":14766,"_28210":58578,"_3064":58630},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3608":2543,"_31023":2521,"_21483":58632,"_5":14766,"_28210":58578,"_3064":58633},[],"**Subject**: organization and country details for your evaluation.",{"_3608":2544,"_31023":2521,"_21483":58635,"_5":14766,"_28210":58578,"_3064":58636},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3608":2545,"_31023":2521,"_21483":58638,"_5":14766,"_28210":58578,"_3064":58639},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3608":2546,"_31023":2521,"_21483":58641,"_5":14766,"_28210":58578,"_3064":58642},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3608":2547,"_31023":2521,"_21483":58644,"_5":14766,"_28210":58582,"_3064":58645},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3608":2548,"_31023":2521,"_21483":58647,"_5":14766,"_28210":58586,"_3064":58648},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3608":2549,"_31023":2521,"_21483":58650,"_5":14766,"_28210":58586,"_3064":58651},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3608":2550,"_31023":2521,"_21483":58653,"_5":14766,"_28210":58590,"_3064":58654},[],"Run from the directory where you saved `ca.pem`:",{"_3608":2551,"_31023":2521,"_21483":58656,"_5":14766,"_28210":58590,"_3064":58657},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3608":2552,"_31023":2521,"_21483":58659,"_5":14766,"_28210":58590,"_3064":58660},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3608":2553,"_31023":2521,"_21483":58662,"_5":14766,"_28210":58594,"_3064":58663},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3608":2554,"_31023":2521,"_21483":58665,"_5":14766,"_28210":58594,"_3064":58666},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3608":2555,"_31023":2521,"_21483":58668,"_5":14766,"_28210":58594,"_3064":58669},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3608":2556,"_31023":2521,"_21483":58671,"_5":14766,"_28210":58594,"_3064":58672},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3608":2557,"_31023":2521,"_21483":58674,"_5":14766,"_28210":58597,"_3064":58675},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3608":2558,"_31023":2558,"_5":15126,"_3064":58677,"_31381":58678,"_21483":58679,"_28210":2558},"Issue and verify a certificate",[50727,52239,56402,55839],[],{"_3608":2559,"_31023":2558,"_21483":58681,"_5":14766,"_28210":2558,"_3064":58682},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3608":2560,"_31023":2558,"_5":31378,"_21483":58684,"_28210":58685,"_3064":50737},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3608":2561,"_31023":2558,"_5":31378,"_21483":58687,"_28210":58688,"_3064":58689},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3608":2562,"_31023":2558,"_5":31378,"_21483":58691,"_28210":58692,"_3064":58693},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3608":2563,"_31023":2558,"_5":31378,"_21483":58695,"_28210":58696,"_3064":58697},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3608":2564,"_31023":2558,"_5":31378,"_21483":58699,"_28210":58700,"_3064":58701},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3608":2565,"_31023":2558,"_5":31378,"_21483":58703,"_28210":58704,"_3064":58705},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3608":2566,"_31023":2558,"_5":31378,"_21483":58707,"_28210":58708,"_3064":58709},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3608":2567,"_31023":2558,"_5":31378,"_21483":58711,"_28210":58712,"_3064":58713},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3608":2568,"_31023":2558,"_5":31378,"_21483":58715,"_28210":58716,"_3064":58717},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3608":2569,"_31023":2558,"_5":31378,"_21483":58719,"_28210":58720,"_3064":58721},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3608":2570,"_31023":2558,"_5":31378,"_21483":58723,"_28210":58724,"_3064":56096},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3608":2571,"_31023":2558,"_5":31378,"_21483":58726,"_28210":58727,"_3064":50761},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/issue-certificate#next-step",{"_3608":2572,"_31023":2558,"_21483":58729,"_5":14766,"_28210":2558,"_3064":58730},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3608":2573,"_31023":2558,"_21483":58732,"_5":14766,"_28210":58685,"_3064":58733},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3608":2574,"_31023":2558,"_21483":58735,"_5":14766,"_28210":58685,"_3064":58736},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3608":2575,"_31023":2558,"_21483":58738,"_5":14766,"_28210":58685,"_3064":58739},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3608":2576,"_31023":2558,"_21483":58741,"_5":14766,"_28210":58685,"_3064":58742},[],"A client identifier: here we use `device-001`.",{"_3608":2577,"_31023":2558,"_21483":58744,"_5":14766,"_28210":58685,"_3064":58745},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3608":2578,"_31023":2558,"_21483":58747,"_5":14766,"_28210":58688,"_3064":58748},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3608":2579,"_31023":2558,"_21483":58750,"_5":14766,"_28210":58692,"_3064":58751},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3608":2580,"_31023":2558,"_21483":58753,"_5":14766,"_28210":58692,"_3064":58754},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3608":2581,"_31023":2558,"_21483":58756,"_5":14766,"_28210":58696,"_3064":58757},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3608":2582,"_31023":2558,"_21483":58759,"_5":14766,"_28210":58696,"_3064":58760},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3608":2583,"_31023":2558,"_21483":58762,"_5":14766,"_28210":58700,"_3064":58763},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3608":2584,"_31023":2558,"_21483":58765,"_5":14766,"_28210":58700,"_3064":58766},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3608":2585,"_31023":2558,"_21483":58768,"_5":14766,"_28210":58704,"_3064":58769},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3608":2586,"_31023":2558,"_21483":58771,"_5":14766,"_28210":58708,"_3064":58772},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3608":2587,"_31023":2558,"_21483":58774,"_5":14766,"_28210":58712,"_3064":58775},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3608":2588,"_31023":2558,"_21483":58777,"_5":14766,"_28210":58716,"_3064":58778},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3608":2589,"_31023":2558,"_21483":58780,"_5":14766,"_28210":58716,"_3064":58781},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3608":2590,"_31023":2558,"_21483":58783,"_5":14766,"_28210":58716,"_3064":58784},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3608":2591,"_31023":2558,"_21483":58786,"_5":14766,"_28210":58720,"_3064":58787},[],"In Bash, compare the two public-key digests:",{"_3608":2592,"_31023":2558,"_21483":58789,"_5":14766,"_28210":58720,"_3064":58790},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3608":2593,"_31023":2558,"_21483":58792,"_5":14766,"_28210":58720,"_3064":58793},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3608":2594,"_31023":2558,"_21483":58795,"_5":14766,"_28210":58724,"_3064":56180},[],{"_3608":2595,"_31023":2558,"_21483":58797,"_5":14766,"_28210":58724,"_3064":58798},[],"What to review",{"_3608":2596,"_31023":2558,"_21483":58800,"_5":14766,"_28210":58724,"_3064":58801},[],"The CA rejects issuance",{"_3608":2597,"_31023":2558,"_21483":58803,"_5":14766,"_28210":58724,"_3064":58804},[],"Permissions, CA state and key, algorithm and profile.",{"_3608":2598,"_31023":2558,"_21483":58806,"_5":14766,"_28210":58724,"_3064":58807},[],"Different subject or usages",{"_3608":2599,"_31023":2558,"_21483":58809,"_5":14766,"_28210":58724,"_3064":58810},[],"Applied profile and requested values.",{"_3608":2600,"_31023":2558,"_21483":58812,"_5":14766,"_28210":58724,"_3064":58813},[],"Issuer cannot be found",{"_3608":2601,"_31023":2558,"_21483":58815,"_5":14766,"_28210":58724,"_3064":58816},[],"Downloaded CA and required intermediate chain.",{"_3608":2602,"_31023":2558,"_21483":58818,"_5":14766,"_28210":58724,"_3064":58819},[],"Validity fails",{"_3608":2603,"_31023":2558,"_21483":58821,"_5":14766,"_28210":58724,"_3064":58822},[],"Certificate and CA dates, and the computer's clock.",{"_3608":2604,"_31023":2558,"_21483":58824,"_5":14766,"_28210":58724,"_3064":58825},[],"Public-key digests differ",{"_3608":2605,"_31023":2558,"_21483":58827,"_5":14766,"_28210":58724,"_3064":58828},[],"Certificate and key files from the same issuance.",{"_3608":2606,"_31023":2558,"_21483":58830,"_5":14766,"_28210":58724,"_3064":58831},[],"See PKI diagnostics to narrow an issuance failure.",{"_3608":2607,"_31023":2558,"_21483":58833,"_5":14766,"_28210":58727,"_3064":58834},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3608":2608,"_31023":2558,"_21483":58836,"_5":14766,"_28210":58727,"_3064":58837},[],"Manage certificates for inspection, status and revocation.",{"_3608":2609,"_31023":2558,"_21483":58839,"_5":14766,"_28210":58727,"_3064":58840},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3608":2610,"_31023":2558,"_21483":58842,"_5":14766,"_28210":58727,"_3064":58843},[],"Prepare EST for the device to request its next identities.",{"_3608":2611,"_31023":2558,"_21483":58845,"_5":14766,"_28210":58727,"_3064":58846},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3608":2612,"_31023":2612,"_5":15126,"_3064":58848,"_31381":58849,"_21483":58850,"_28210":2612},"PKI getting started",[50727,52239,56402,55839],[],{"_3608":2613,"_31023":2612,"_21483":58852,"_5":14766,"_28210":2612,"_3064":58853},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3608":2614,"_31023":2612,"_5":31378,"_21483":58855,"_28210":58856,"_3064":50737},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/overview#before-you-begin",{"_3608":2615,"_31023":2612,"_5":31378,"_21483":58858,"_28210":58859,"_3064":58860},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3608":2616,"_31023":2612,"_5":31378,"_21483":58862,"_28210":58863,"_3064":56031},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/overview#expected-result",{"_3608":2617,"_31023":2612,"_5":31378,"_21483":58865,"_28210":58866,"_3064":58867},[],"/docs/pr-preview/pr-72/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3608":2618,"_31023":2612,"_21483":58869,"_5":14766,"_28210":2612,"_3064":58870},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3608":2619,"_31023":2612,"_21483":58872,"_5":14766,"_28210":58856,"_3064":58873},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3608":2620,"_31023":2612,"_21483":58875,"_5":14766,"_28210":58856,"_3064":58876},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3608":2621,"_31023":2612,"_21483":58878,"_5":14766,"_28210":58856,"_3064":58879},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3608":2622,"_31023":2612,"_21483":58881,"_5":14766,"_28210":58856,"_3064":58882},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3608":2623,"_31023":2612,"_21483":58884,"_5":14766,"_28210":58856,"_3064":58885},[],"A working directory with restricted access for the downloaded key.",{"_3608":2624,"_31023":2612,"_21483":58887,"_5":14766,"_28210":58859,"_3064":58888},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3608":2625,"_31023":2612,"_21483":58890,"_5":14766,"_28210":58859,"_3064":58891},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3608":2626,"_31023":2612,"_21483":58893,"_5":14766,"_28210":58859,"_3064":58894},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3608":2627,"_31023":2612,"_21483":58896,"_5":14766,"_28210":58859,"_3064":58897},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3608":2628,"_31023":2612,"_21483":58899,"_5":14766,"_28210":58863,"_3064":58900},[],"File or resource",{"_3608":2629,"_31023":2612,"_21483":58902,"_5":14766,"_28210":58863,"_3064":56028},[],{"_3608":2630,"_31023":2612,"_21483":58904,"_5":14766,"_28210":58863,"_3064":58905},[],"Active root CA and `ca.pem`",{"_3608":2631,"_31023":2612,"_21483":58907,"_5":14766,"_28210":58863,"_3064":58908},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3608":2632,"_31023":2612,"_21483":58910,"_5":14766,"_28210":58863,"_3064":58911},[],"End-entity certificate and `device.crt`",{"_3608":2633,"_31023":2612,"_21483":58913,"_5":14766,"_28210":58863,"_3064":58914},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3608":2634,"_31023":2612,"_21483":58916,"_5":14766,"_28210":58863,"_3064":58917},[],"Private key `device.key`",{"_3608":2635,"_31023":2612,"_21483":58919,"_5":14766,"_28210":58863,"_3064":58920},[],"Its public key matches the one included in `device.crt`.",{"_3608":2636,"_31023":2612,"_21483":58922,"_5":14766,"_28210":58863,"_3064":58923},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3608":2637,"_31023":2612,"_21483":58925,"_5":14766,"_28210":58866,"_3064":58926},[],"To operate certificates, continue with Certificates and Validation.",{"_3608":2638,"_31023":2612,"_21483":58928,"_5":14766,"_28210":58866,"_3064":58929},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3608":2639,"_31023":2612,"_21483":58931,"_5":14766,"_28210":58866,"_3064":58932},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3608":2640,"_31023":2640,"_5":15126,"_3064":58934,"_31381":58935,"_21483":58936,"_28210":2640},"PKI troubleshooting",[50727,52239,56402,54977],[],{"_3608":2641,"_31023":2640,"_21483":58938,"_5":14766,"_28210":2640,"_3064":58939},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3608":2642,"_31023":2640,"_5":31378,"_21483":58941,"_28210":58942,"_3064":58943},[],"/docs/pr-preview/pr-72/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3608":2643,"_31023":2640,"_5":31378,"_21483":58945,"_28210":58946,"_3064":58947},[],"/docs/pr-preview/pr-72/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3608":2644,"_31023":2640,"_5":31378,"_21483":58949,"_28210":58950,"_3064":58951},[],"/docs/pr-preview/pr-72/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3608":2645,"_31023":2640,"_21483":58953,"_5":14766,"_28210":2640,"_3064":58954},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3608":2646,"_31023":2640,"_21483":58956,"_5":14766,"_28210":2640,"_3064":58957},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3608":2647,"_31023":2640,"_21483":58959,"_5":14766,"_28210":58942,"_3064":56028},[],{"_3608":2648,"_31023":2640,"_21483":58961,"_5":14766,"_28210":58942,"_3064":58962},[],"What to inspect",{"_3608":2649,"_31023":2640,"_21483":58964,"_5":14766,"_28210":58942,"_3064":50761},[],{"_3608":2650,"_31023":2640,"_21483":58966,"_5":14766,"_28210":58942,"_3064":55244},[],{"_3608":2651,"_31023":2640,"_21483":58968,"_5":14766,"_28210":58942,"_3064":58969},[],"Exists, is active and has usable dates.",{"_3608":2652,"_31023":2640,"_21483":58971,"_5":14766,"_28210":58942,"_3064":58972},[],"Authorities.",{"_3608":2653,"_31023":2640,"_21483":58974,"_5":14766,"_28210":58942,"_3064":58975},[],"Key",{"_3608":2654,"_31023":2640,"_21483":58977,"_5":14766,"_28210":58942,"_3064":58978},[],"The record has a usable private key and the engine can sign.",{"_3608":2655,"_31023":2640,"_21483":58980,"_5":14766,"_28210":58942,"_3064":58981},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3608":2656,"_31023":2640,"_21483":58983,"_5":14766,"_28210":58942,"_3064":58984},[],"CSR",{"_3608":2657,"_31023":2640,"_21483":58986,"_5":14766,"_28210":58942,"_3064":58987},[],"Correct PEM and verifiable signature.",{"_3608":2658,"_31023":2640,"_21483":58989,"_5":14766,"_28210":58942,"_3064":58990},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3608":2659,"_31023":2640,"_21483":58992,"_5":14766,"_28210":58942,"_3064":58993},[],"Profile",{"_3608":2660,"_31023":2640,"_21483":58995,"_5":14766,"_28210":58942,"_3064":58996},[],"Selected source, existing ID, allowed algorithm and size.",{"_3608":2661,"_31023":2640,"_21483":58998,"_5":14766,"_28210":58942,"_3064":58999},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3608":2662,"_31023":2640,"_21483":59001,"_5":14766,"_28210":58942,"_3064":56180},[],{"_3608":2663,"_31023":2640,"_21483":59003,"_5":14766,"_28210":58942,"_3064":59004},[],"Appropriate subject, SAN, usages and dates.",{"_3608":2664,"_31023":2640,"_21483":59006,"_5":14766,"_28210":58942,"_3064":59007},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3608":2665,"_31023":2640,"_21483":59009,"_5":14766,"_28210":58942,"_3064":59010},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3608":2666,"_31023":2640,"_21483":59012,"_5":14766,"_28210":58942,"_3064":59013},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3608":2667,"_31023":2640,"_21483":59015,"_5":14766,"_28210":58942,"_3064":59016},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3608":2668,"_31023":2640,"_21483":59018,"_5":14766,"_28210":58946,"_3064":59019},[],"Check each boundary independently:",{"_3608":2669,"_31023":2640,"_21483":59021,"_5":14766,"_28210":58946,"_3064":59022},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3608":2670,"_31023":2640,"_21483":59024,"_5":14766,"_28210":58946,"_3064":59025},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3608":2671,"_31023":2640,"_21483":59027,"_5":14766,"_28210":58946,"_3064":59028},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3608":2672,"_31023":2640,"_21483":59030,"_5":14766,"_28210":58946,"_3064":59031},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3608":2673,"_31023":2640,"_21483":59033,"_5":14766,"_28210":58946,"_3064":59034},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3608":2674,"_31023":2640,"_21483":59036,"_5":14766,"_28210":58946,"_3064":59037},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3608":2675,"_31023":2640,"_21483":59039,"_5":14766,"_28210":58950,"_3064":59040},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3608":2676,"_31023":2640,"_21483":59042,"_5":14766,"_28210":58950,"_3064":59043},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3608":2677,"_31023":2677,"_5":15126,"_3064":59045,"_31381":59046,"_21483":59047,"_28210":2677},"Security",[50727],[],{"_3608":2678,"_31023":2677,"_21483":59049,"_5":14766,"_28210":2677,"_3064":59050},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3608":2679,"_31023":2677,"_5":31378,"_21483":59052,"_28210":59053,"_3064":59054},[],"/docs/pr-preview/pr-72/security#report-a-vulnerability","Report a vulnerability",{"_3608":2680,"_31023":2677,"_5":31378,"_21483":59056,"_28210":59057,"_3064":59058},[],"/docs/pr-preview/pr-72/security#what-to-include-in-a-report","What to include in a report",{"_3608":2681,"_31023":2677,"_5":31378,"_21483":59060,"_28210":59061,"_3064":59062},[],"/docs/pr-preview/pr-72/security#supported-versions","Supported versions",{"_3608":2682,"_31023":2677,"_5":31378,"_21483":59064,"_28210":59065,"_3064":59066},[],"/docs/pr-preview/pr-72/security#responsible-disclosure","Responsible disclosure",{"_3608":2683,"_31023":2677,"_21483":59068,"_5":14766,"_28210":2677,"_3064":59069},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3608":2684,"_31023":2677,"_21483":59071,"_5":14766,"_28210":59053,"_3064":59072},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3608":2685,"_31023":2677,"_21483":59074,"_5":14766,"_28210":59053,"_3064":59075},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3608":2686,"_31023":2677,"_21483":59077,"_5":14766,"_28210":59053,"_3064":15404},[],{"_3608":2687,"_31023":2677,"_21483":59079,"_5":14766,"_28210":59053,"_3064":15333},[],{"_3608":2688,"_31023":2677,"_21483":59081,"_5":14766,"_28210":59053,"_3064":15391},[],{"_3608":2689,"_31023":2677,"_21483":59083,"_5":14766,"_28210":59053,"_3064":59084},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3608":2690,"_31023":2677,"_21483":59086,"_5":14766,"_28210":59053,"_3064":59087},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3608":2691,"_31023":2677,"_21483":59089,"_5":14766,"_28210":59057,"_3064":59090},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3608":2692,"_31023":2677,"_21483":59092,"_5":14766,"_28210":59057,"_3064":59093},[],"Do not include in the report:",{"_3608":2693,"_31023":2677,"_21483":59095,"_5":14766,"_28210":59057,"_3064":59096},[],"Credentials, tokens, or private keys",{"_3608":2694,"_31023":2677,"_21483":59098,"_5":14766,"_28210":59057,"_3064":59099},[],"Customer data or customer-identifiable information",{"_3608":2695,"_31023":2677,"_21483":59101,"_5":14766,"_28210":59057,"_3064":59102},[],"Confidential architecture or internal infrastructure details",{"_3608":2696,"_31023":2677,"_21483":59104,"_5":14766,"_28210":59061,"_3064":59105},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3608":2697,"_31023":2677,"_21483":59107,"_5":14766,"_28210":59061,"_3064":59108},[],"For upgrade guidance, see Upgrades.",{"_3608":2698,"_31023":2677,"_21483":59110,"_5":14766,"_28210":59065,"_3064":59111},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3608":2699,"_31023":2677,"_21483":59113,"_5":14766,"_28210":59065,"_3064":59114},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3608":2700,"_31023":2677,"_21483":59116,"_5":14766,"_28210":59065,"_3064":59117},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3608":2701,"_31023":2677,"_21483":59119,"_5":14766,"_28210":59065,"_3064":59120},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3608":2702,"_31023":2677,"_21483":59122,"_5":14766,"_28210":59065,"_3064":59123},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3608":2703,"_31023":2703,"_5":15126,"_3064":59125,"_31381":59126,"_21483":59128,"_28210":2703},"3.8.0 to 4.0.0",[50727,59127],"Upgrades",[],{"_3608":2704,"_31023":2703,"_21483":59130,"_5":14766,"_28210":2703,"_3064":59131},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3608":2705,"_31023":2703,"_5":31378,"_21483":59133,"_28210":59134,"_3064":59135},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3608":2706,"_31023":2703,"_5":31378,"_21483":59137,"_28210":59138,"_3064":59139},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3608":2707,"_31023":2703,"_5":31378,"_21483":59141,"_28210":59142,"_3064":59143},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3608":2708,"_31023":2703,"_5":31378,"_21483":59145,"_28210":59146,"_3064":59147},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3608":2709,"_31023":2703,"_5":31378,"_21483":59149,"_28210":59150,"_3064":59151},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3608":2710,"_31023":2703,"_5":31378,"_21483":59153,"_28210":59154,"_3064":59155},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3608":2711,"_31023":2703,"_5":31378,"_21483":59157,"_28210":59158,"_3064":59159},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3608":2712,"_31023":2703,"_5":31378,"_21483":59161,"_28210":59162,"_3064":59163},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3608":2713,"_31023":2703,"_5":31378,"_21483":59165,"_28210":59166,"_3064":59167},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3608":2714,"_31023":2703,"_5":31378,"_21483":59169,"_28210":59170,"_3064":59171},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3608":2715,"_31023":2703,"_5":31378,"_21483":59173,"_28210":59174,"_3064":51365},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3608":2716,"_31023":2703,"_5":31378,"_21483":59176,"_28210":59177,"_3064":59178},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3608":2717,"_31023":2703,"_5":31378,"_21483":59180,"_28210":59181,"_3064":59182},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3608":2718,"_31023":2703,"_5":31378,"_21483":59184,"_28210":59185,"_3064":59186},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3608":2719,"_31023":2703,"_5":31378,"_21483":59188,"_28210":59189,"_3064":59190},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3608":2720,"_31023":2703,"_5":31378,"_21483":59192,"_28210":59193,"_3064":59194},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3608":2721,"_31023":2703,"_5":31378,"_21483":59196,"_28210":59197,"_3064":59198},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3608":2722,"_31023":2703,"_5":31378,"_21483":59200,"_28210":59201,"_3064":59202},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3608":2723,"_31023":2703,"_5":31378,"_21483":59204,"_28210":59205,"_3064":59206},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3608":2724,"_31023":2703,"_5":31378,"_21483":59208,"_28210":59209,"_3064":59210},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3608":2725,"_31023":2703,"_5":31378,"_21483":59212,"_28210":59213,"_3064":59214},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3608":2726,"_31023":2703,"_5":31378,"_21483":59216,"_28210":59217,"_3064":59218},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3608":2727,"_31023":2703,"_5":31378,"_21483":59220,"_28210":59221,"_3064":59222},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3608":2728,"_31023":2703,"_5":31378,"_21483":59224,"_28210":59225,"_3064":59226},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3608":2729,"_31023":2703,"_5":31378,"_21483":59228,"_28210":59229,"_3064":59230},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3608":2730,"_31023":2703,"_5":31378,"_21483":59232,"_28210":59233,"_3064":59234},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3608":2731,"_31023":2703,"_5":31378,"_21483":59236,"_28210":59237,"_3064":59238},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3608":2732,"_31023":2703,"_5":31378,"_21483":59240,"_28210":59241,"_3064":59242},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3608":2733,"_31023":2703,"_5":31378,"_21483":59244,"_28210":59245,"_3064":59246},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3608":2734,"_31023":2703,"_5":31378,"_21483":59248,"_28210":59249,"_3064":59250},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3608":2735,"_31023":2703,"_5":31378,"_21483":59252,"_28210":59253,"_3064":59254},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3608":2736,"_31023":2703,"_5":31378,"_21483":59256,"_28210":59257,"_3064":59258},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3608":2737,"_31023":2703,"_5":31378,"_21483":59260,"_28210":59261,"_3064":59262},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3608":2738,"_31023":2703,"_5":31378,"_21483":59264,"_28210":59265,"_3064":59258},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3608":2739,"_31023":2703,"_5":31378,"_21483":59267,"_28210":59268,"_3064":59269},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3608":2740,"_31023":2703,"_5":31378,"_21483":59271,"_28210":59272,"_3064":59273},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3608":2741,"_31023":2703,"_5":31378,"_21483":59275,"_28210":59276,"_3064":59277},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3608":2742,"_31023":2703,"_5":31378,"_21483":59279,"_28210":59280,"_3064":59281},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3608":2743,"_31023":2703,"_5":31378,"_21483":59283,"_28210":59284,"_3064":59285},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3608":2744,"_31023":2703,"_5":31378,"_21483":59287,"_28210":59288,"_3064":59289},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3608":2745,"_31023":2703,"_5":31378,"_21483":59291,"_28210":59292,"_3064":59293},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3608":2746,"_31023":2703,"_5":31378,"_21483":59295,"_28210":59296,"_3064":59297},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3608":2747,"_31023":2703,"_5":31378,"_21483":59299,"_28210":59300,"_3064":59301},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3608":2748,"_31023":2703,"_5":31378,"_21483":59303,"_28210":59304,"_3064":54977},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3608":2749,"_31023":2703,"_5":31378,"_21483":59306,"_28210":59307,"_3064":59308},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3608":2750,"_31023":2703,"_5":31378,"_21483":59310,"_28210":59311,"_3064":59312},[],"/docs/pr-preview/pr-72/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3608":2751,"_31023":2703,"_21483":59314,"_5":14766,"_28210":2703,"_3064":59315},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3608":2752,"_31023":2703,"_21483":59317,"_5":14766,"_28210":2703,"_3064":59318},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3608":2753,"_31023":2703,"_21483":59320,"_5":14766,"_28210":2703,"_3064":59321},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3608":2754,"_31023":2703,"_21483":59323,"_5":14766,"_28210":2703,"_3064":59324},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3608":2755,"_31023":2703,"_21483":59326,"_5":14766,"_28210":2703,"_3064":59327},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3608":2756,"_31023":2703,"_21483":59329,"_5":14766,"_28210":2703,"_3064":59330},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3608":2757,"_31023":2703,"_21483":59332,"_5":14766,"_28210":2703,"_3064":59333},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3608":2758,"_31023":2703,"_21483":59335,"_5":14766,"_28210":59138,"_3064":59336},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3608":2759,"_31023":2703,"_21483":59338,"_5":14766,"_28210":59138,"_3064":59339},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3608":2760,"_31023":2703,"_21483":59341,"_5":14766,"_28210":59142,"_3064":59342},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3608":2761,"_31023":2703,"_21483":59344,"_5":14766,"_28210":59142,"_3064":59345},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3608":2762,"_31023":2703,"_21483":59347,"_5":14766,"_28210":59146,"_3064":59348},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3608":2763,"_31023":2703,"_21483":59350,"_5":14766,"_28210":59150,"_3064":59351},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3608":2764,"_31023":2703,"_21483":59353,"_5":14766,"_28210":59150,"_3064":59354},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3608":2765,"_31023":2703,"_21483":59356,"_5":14766,"_28210":59150,"_3064":59357},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3608":2766,"_31023":2703,"_21483":59359,"_5":14766,"_28210":59150,"_3064":59360},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3608":2767,"_31023":2703,"_21483":59362,"_5":14766,"_28210":59150,"_3064":59363},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3608":2768,"_31023":2703,"_21483":59365,"_5":14766,"_28210":59154,"_3064":59366},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3608":2769,"_31023":2703,"_21483":59368,"_5":14766,"_28210":59154,"_3064":59369},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3608":2770,"_31023":2703,"_21483":59371,"_5":14766,"_28210":59154,"_3064":59372},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3608":2771,"_31023":2703,"_21483":59374,"_5":14766,"_28210":59154,"_3064":59375},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3608":2772,"_31023":2703,"_21483":59377,"_5":14766,"_28210":59154,"_3064":59378},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3608":2773,"_31023":2703,"_21483":59380,"_5":14766,"_28210":59154,"_3064":59381},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3608":2774,"_31023":2703,"_21483":59383,"_5":14766,"_28210":59158,"_3064":59384},[],"Change",{"_3608":2775,"_31023":2703,"_21483":59386,"_5":14766,"_28210":59158,"_3064":59387},[],"Who is affected",{"_3608":2776,"_31023":2703,"_21483":59389,"_5":14766,"_28210":59158,"_3064":59390},[],"Severity",{"_3608":2777,"_31023":2703,"_21483":59392,"_5":14766,"_28210":59158,"_3064":57847},[],{"_3608":2778,"_31023":2703,"_21483":59394,"_5":14766,"_28210":59158,"_3064":59167},[],{"_3608":2779,"_31023":2703,"_21483":59396,"_5":14766,"_28210":59158,"_3064":59397},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3608":2780,"_31023":2703,"_21483":59399,"_5":14766,"_28210":59158,"_3064":59400},[],"High: KMS and VA start on empty volumes",{"_3608":2781,"_31023":2703,"_21483":59402,"_5":14766,"_28210":59158,"_3064":59403},[],"Copy the data into the new volumes",{"_3608":2782,"_31023":2703,"_21483":59405,"_5":14766,"_28210":59158,"_3064":59171},[],{"_3608":2783,"_31023":2703,"_21483":59407,"_5":14766,"_28210":59158,"_3064":59408},[],"Every Helm release",{"_3608":2784,"_31023":2703,"_21483":59410,"_5":14766,"_28210":59158,"_3064":59411},[],"High: `helm upgrade` fails",{"_3608":2785,"_31023":2703,"_21483":59413,"_5":14766,"_28210":59158,"_3064":59414},[],"Remove or rename legacy keys",{"_3608":2786,"_31023":2703,"_21483":59416,"_5":14766,"_28210":59158,"_3064":51365},[],{"_3608":2787,"_31023":2703,"_21483":59418,"_5":14766,"_28210":59158,"_3064":59408},[],{"_3608":2788,"_31023":2703,"_21483":59420,"_5":14766,"_28210":59158,"_3064":59421},[],"High: `helm upgrade` fails on inline credentials",{"_3608":2789,"_31023":2703,"_21483":59423,"_5":14766,"_28210":59158,"_3064":59424},[],"Create the Secrets first; see Step 2",{"_3608":2790,"_31023":2703,"_21483":59426,"_5":14766,"_28210":59158,"_3064":59178},[],{"_3608":2791,"_31023":2703,"_21483":59428,"_5":14766,"_28210":59158,"_3064":59429},[],"Every deployment",{"_3608":2792,"_31023":2703,"_21483":59431,"_5":14766,"_28210":59158,"_3064":59432},[],"High: without a bootstrap principal there is no administrator",{"_3608":2793,"_31023":2703,"_21483":59434,"_5":14766,"_28210":59158,"_3064":59435},[],"Configure `services.authz`",{"_3608":2794,"_31023":2703,"_21483":59437,"_5":14766,"_28210":59158,"_3064":59182},[],{"_3608":2795,"_31023":2703,"_21483":59439,"_5":14766,"_28210":59158,"_3064":59408},[],{"_3608":2796,"_31023":2703,"_21483":59441,"_5":14766,"_28210":59158,"_3064":59442},[],"High: `helm upgrade` fails on the old keys",{"_3608":2797,"_31023":2703,"_21483":59444,"_5":14766,"_28210":59158,"_3064":59445},[],"Move JWKS and roles into `services.authz`",{"_3608":2798,"_31023":2703,"_21483":59447,"_5":14766,"_28210":59158,"_3064":59202},[],{"_3608":2799,"_31023":2703,"_21483":59449,"_5":14766,"_28210":59158,"_3064":59450},[],"3.8.0 deployments with per-service databases",{"_3608":2800,"_31023":2703,"_21483":59452,"_5":14766,"_28210":59158,"_3064":59453},[],"High: services find no data, or a migration aborts",{"_3608":2801,"_31023":2703,"_21483":59455,"_5":14766,"_28210":59158,"_3064":59456},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3608":2802,"_31023":2703,"_21483":59458,"_5":14766,"_28210":59158,"_3064":59206},[],{"_3608":2803,"_31023":2703,"_21483":59460,"_5":14766,"_28210":59158,"_3064":59461},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3608":2804,"_31023":2703,"_21483":59463,"_5":14766,"_28210":59158,"_3064":59464},[],"High: the backend no longer starts with them",{"_3608":2805,"_31023":2703,"_21483":59466,"_5":14766,"_28210":59158,"_3064":59467},[],"Move to PostgreSQL before upgrading",{"_3608":2806,"_31023":2703,"_21483":59469,"_5":14766,"_28210":59158,"_3064":59250},[],{"_3608":2807,"_31023":2703,"_21483":59471,"_5":14766,"_28210":59158,"_3064":59472},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3608":2808,"_31023":2703,"_21483":59474,"_5":14766,"_28210":59158,"_3064":59475},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3608":2809,"_31023":2703,"_21483":59477,"_5":14766,"_28210":59158,"_3064":59478},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3608":2810,"_31023":2703,"_21483":59480,"_5":14766,"_28210":59158,"_3064":59481},[],"Webhooks with file references",{"_3608":2811,"_31023":2703,"_21483":59483,"_5":14766,"_28210":59158,"_3064":59484},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3608":2812,"_31023":2703,"_21483":59486,"_5":14766,"_28210":59158,"_3064":59487},[],"High: enrollments calling the webhook fail",{"_3608":2813,"_31023":2703,"_21483":59489,"_5":14766,"_28210":59158,"_3064":59490},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3608":2814,"_31023":2703,"_21483":59492,"_5":14766,"_28210":59158,"_3064":59186},[],{"_3608":2815,"_31023":2703,"_21483":59494,"_5":14766,"_28210":59158,"_3064":59495},[],"Releases with per-service identity overrides or mounted key material",{"_3608":2816,"_31023":2703,"_21483":59497,"_5":14766,"_28210":59158,"_3064":59498},[],"Medium: services cannot read their files",{"_3608":2817,"_31023":2703,"_21483":59500,"_5":14766,"_28210":59158,"_3064":59501},[],"Remove the overrides and fix volume ownership",{"_3608":2818,"_31023":2703,"_21483":59503,"_5":14766,"_28210":59158,"_3064":59190},[],{"_3608":2819,"_31023":2703,"_21483":59505,"_5":14766,"_28210":59158,"_3064":59506},[],"Releases that set `amqp.tls`",{"_3608":2820,"_31023":2703,"_21483":59508,"_5":14766,"_28210":59158,"_3064":59509},[],"Medium: clients connect to the wrong port",{"_3608":2821,"_31023":2703,"_21483":59511,"_5":14766,"_28210":59158,"_3064":59512},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3608":2822,"_31023":2703,"_21483":59514,"_5":14766,"_28210":59158,"_3064":59210},[],{"_3608":2823,"_31023":2703,"_21483":59516,"_5":14766,"_28210":59158,"_3064":59517},[],"Installations whose CA keys predate the KMS",{"_3608":2824,"_31023":2703,"_21483":59519,"_5":14766,"_28210":59158,"_3064":59520},[],"Medium: CA keys stay unmanaged",{"_3608":2825,"_31023":2703,"_21483":59522,"_5":14766,"_28210":59158,"_3064":59523},[],"Run the CA-to-KMS migration",{"_3608":2826,"_31023":2703,"_21483":59525,"_5":14766,"_28210":59158,"_3064":59526},[],"Receiver certificate verification",{"_3608":2827,"_31023":2703,"_21483":59528,"_5":14766,"_28210":59158,"_3064":59529},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3608":2828,"_31023":2703,"_21483":59531,"_5":14766,"_28210":59158,"_3064":59532},[],"Medium: credentials go to an unverified receiver",{"_3608":2829,"_31023":2703,"_21483":59534,"_5":14766,"_28210":59158,"_3064":59535},[],"Set `insecure_skip_verify` to `false`",{"_3608":2830,"_31023":2703,"_21483":59537,"_5":14766,"_28210":59158,"_3064":59226},[],{"_3608":2831,"_31023":2703,"_21483":59539,"_5":14766,"_28210":59158,"_3064":59540},[],"Scripts and consoles that edit DMSs through the API",{"_3608":2832,"_31023":2703,"_21483":59542,"_5":14766,"_28210":59158,"_3064":59543},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3608":2833,"_31023":2703,"_21483":59545,"_5":14766,"_28210":59158,"_3064":59546},[],"Read the DMS before editing and use the new field",{"_3608":2834,"_31023":2703,"_21483":59548,"_5":14766,"_28210":59158,"_3064":59246},[],{"_3608":2835,"_31023":2703,"_21483":59550,"_5":14766,"_28210":59158,"_3064":59551},[],"Clients that create or update CRL settings through the API",{"_3608":2836,"_31023":2703,"_21483":59553,"_5":14766,"_28210":59158,"_3064":59554},[],"Medium: requests with the old field return an error",{"_3608":2837,"_31023":2703,"_21483":59556,"_5":14766,"_28210":59158,"_3064":59557},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3608":2838,"_31023":2703,"_21483":59559,"_5":14766,"_28210":59158,"_3064":59254},[],{"_3608":2839,"_31023":2703,"_21483":59561,"_5":14766,"_28210":59158,"_3064":59562},[],"Alert subscriptions and consumers of the VA events",{"_3608":2840,"_31023":2703,"_21483":59564,"_5":14766,"_28210":59158,"_3064":59565},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3608":2841,"_31023":2703,"_21483":59567,"_5":14766,"_28210":59158,"_3064":59568},[],"Review conditions filtering on the old event payload or subject",{"_3608":2842,"_31023":2703,"_21483":59570,"_5":14766,"_28210":59158,"_3064":59258},[],{"_3608":2843,"_31023":2703,"_21483":59572,"_5":14766,"_28210":59158,"_3064":59573},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3608":2844,"_31023":2703,"_21483":59575,"_5":14766,"_28210":59158,"_3064":59576},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3608":2845,"_31023":2703,"_21483":59578,"_5":14766,"_28210":59158,"_3064":59579},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3608":2846,"_31023":2703,"_21483":59581,"_5":14766,"_28210":59158,"_3064":59242},[],{"_3608":2847,"_31023":2703,"_21483":59583,"_5":14766,"_28210":59158,"_3064":59584},[],"Consumers that read the device `events` field",{"_3608":2848,"_31023":2703,"_21483":59586,"_5":14766,"_28210":59158,"_3064":59587},[],"Medium: the field disappears",{"_3608":2849,"_31023":2703,"_21483":59589,"_5":14766,"_28210":59158,"_3064":59590},[],"Use the new event endpoints",{"_3608":2850,"_31023":2703,"_21483":59592,"_5":14766,"_28210":59158,"_3064":59269},[],{"_3608":2851,"_31023":2703,"_21483":59594,"_5":14766,"_28210":59158,"_3064":59595},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3608":2852,"_31023":2703,"_21483":59597,"_5":14766,"_28210":59158,"_3064":59598},[],"Medium: the VA migration aborts",{"_3608":2853,"_31023":2703,"_21483":59600,"_5":14766,"_28210":59158,"_3064":59601},[],"Fix the affected roles before upgrading",{"_3608":2854,"_31023":2703,"_21483":59603,"_5":14766,"_28210":59158,"_3064":59194},[],{"_3608":2855,"_31023":2703,"_21483":59605,"_5":14766,"_28210":59158,"_3064":59606},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3608":2856,"_31023":2703,"_21483":59608,"_5":14766,"_28210":59158,"_3064":59609},[],"Low to medium: validation errors or changed defaults",{"_3608":2857,"_31023":2703,"_21483":59611,"_5":14766,"_28210":59158,"_3064":59612},[],"Update the values file",{"_3608":2858,"_31023":2703,"_21483":59614,"_5":14766,"_28210":59158,"_3064":59234},[],{"_3608":2859,"_31023":2703,"_21483":59616,"_5":14766,"_28210":59158,"_3064":59617},[],"Clients that send the DMS ID in the update body",{"_3608":2860,"_31023":2703,"_21483":59619,"_5":14766,"_28210":59158,"_3064":59620},[],"Low: the ID in the URL wins",{"_3608":2861,"_31023":2703,"_21483":59622,"_5":14766,"_28210":59158,"_3064":59623},[],"Send the ID in the URL",{"_3608":2862,"_31023":2703,"_21483":59625,"_5":14766,"_28210":59158,"_3064":59262},[],{"_3608":2863,"_31023":2703,"_21483":59627,"_5":14766,"_28210":59158,"_3064":59628},[],"Clients that send an `id` when creating or importing CAs",{"_3608":2864,"_31023":2703,"_21483":59630,"_5":14766,"_28210":59158,"_3064":59631},[],"Low: the ID in the body is ignored, and the field is removed",{"_3608":2865,"_31023":2703,"_21483":59633,"_5":14766,"_28210":59158,"_3064":59634},[],"Let the backend assign the ID and use the returned one",{"_3608":2866,"_31023":2703,"_21483":59636,"_5":14766,"_28210":59158,"_3064":59258},[],{"_3608":2867,"_31023":2703,"_21483":59638,"_5":14766,"_28210":59158,"_3064":59639},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3608":2868,"_31023":2703,"_21483":59641,"_5":14766,"_28210":59158,"_3064":59642},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3608":2869,"_31023":2703,"_21483":59644,"_5":14766,"_28210":59158,"_3064":59645},[],"Use the KMS `sign` and `verify` operations",{"_3608":2870,"_31023":2703,"_21483":59647,"_5":14766,"_28210":59158,"_3064":59238},[],{"_3608":2871,"_31023":2703,"_21483":59649,"_5":14766,"_28210":59158,"_3064":59650},[],"Consumers that match on certificate `type`",{"_3608":2872,"_31023":2703,"_21483":59652,"_5":14766,"_28210":59158,"_3064":59653},[],"Low: two values are renamed",{"_3608":2873,"_31023":2703,"_21483":59655,"_5":14766,"_28210":59158,"_3064":59656},[],"Adapt consumers",{"_3608":2874,"_31023":2703,"_21483":59658,"_5":14766,"_28210":59158,"_3064":59230},[],{"_3608":2875,"_31023":2703,"_21483":59660,"_5":14766,"_28210":59158,"_3064":59661},[],"Any DMS",{"_3608":2876,"_31023":2703,"_21483":59663,"_5":14766,"_28210":59158,"_3064":59664},[],"Low: informational",{"_3608":2877,"_31023":2703,"_21483":59666,"_5":14766,"_28210":59158,"_3064":59667},[],"Read both blocks before editing",{"_3608":2878,"_31023":2703,"_21483":59669,"_5":14766,"_28210":59166,"_3064":59670},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3608":2879,"_31023":2703,"_21483":59672,"_5":14766,"_28210":59166,"_3064":59673},[],"Step 4 of the migration guide copies the data.",{"_3608":2880,"_31023":2703,"_21483":59675,"_5":14766,"_28210":59170,"_3064":59676},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3608":2881,"_31023":2703,"_21483":59678,"_5":14766,"_28210":59174,"_3064":59679},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3608":2882,"_31023":2703,"_21483":59681,"_5":14766,"_28210":59174,"_3064":59682},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3608":2883,"_31023":2703,"_21483":59684,"_5":14766,"_28210":59177,"_3064":59685},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3608":2884,"_31023":2703,"_21483":59687,"_5":14766,"_28210":59181,"_3064":59688},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3608":2885,"_31023":2703,"_21483":59690,"_5":14766,"_28210":59185,"_3064":59691},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3608":2886,"_31023":2703,"_21483":59693,"_5":14766,"_28210":59185,"_3064":59694},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3608":2887,"_31023":2703,"_21483":59696,"_5":14766,"_28210":59185,"_3064":59697},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3608":2888,"_31023":2703,"_21483":59699,"_5":14766,"_28210":59189,"_3064":59700},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3608":2889,"_31023":2703,"_21483":59702,"_5":14766,"_28210":59193,"_3064":59703},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3608":2890,"_31023":2703,"_21483":59705,"_5":14766,"_28210":59193,"_3064":59706},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3608":2891,"_31023":2703,"_21483":59708,"_5":14766,"_28210":59193,"_3064":59709},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3608":2892,"_31023":2703,"_21483":59711,"_5":14766,"_28210":59193,"_3064":59712},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3608":2893,"_31023":2703,"_21483":59714,"_5":14766,"_28210":59193,"_3064":59715},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3608":2894,"_31023":2703,"_21483":59717,"_5":14766,"_28210":59193,"_3064":59718},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3608":2895,"_31023":2703,"_21483":59720,"_5":14766,"_28210":59201,"_3064":59721},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3608":2896,"_31023":2703,"_21483":59723,"_5":14766,"_28210":59201,"_3064":59724},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3608":2897,"_31023":2703,"_21483":59726,"_5":14766,"_28210":59201,"_3064":59727},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3608":2898,"_31023":2703,"_21483":59729,"_5":14766,"_28210":59201,"_3064":59730},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3608":2899,"_31023":2703,"_21483":59732,"_5":14766,"_28210":59201,"_3064":59733},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3608":2900,"_31023":2703,"_21483":59735,"_5":14766,"_28210":59205,"_3064":59736},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3608":2901,"_31023":2703,"_21483":59738,"_5":14766,"_28210":59209,"_3064":59739},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3608":2902,"_31023":2703,"_21483":59741,"_5":14766,"_28210":59209,"_3064":59742},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3608":2903,"_31023":2703,"_21483":59744,"_5":14766,"_28210":59209,"_3064":59745},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3608":2904,"_31023":2703,"_21483":59747,"_5":14766,"_28210":59209,"_3064":59748},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3608":2905,"_31023":2703,"_21483":59750,"_5":14766,"_28210":59209,"_3064":59751},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3608":2906,"_31023":2703,"_21483":59753,"_5":14766,"_28210":59209,"_3064":59754},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3608":2907,"_31023":2703,"_21483":59756,"_5":14766,"_28210":59209,"_3064":59757},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3608":2908,"_31023":2703,"_21483":59759,"_5":14766,"_28210":59209,"_3064":59760},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3608":2909,"_31023":2703,"_21483":59762,"_5":14766,"_28210":59213,"_3064":59763},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3608":2910,"_31023":2703,"_21483":59765,"_5":14766,"_28210":59221,"_3064":59766},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3608":2911,"_31023":2703,"_21483":59768,"_5":14766,"_28210":59221,"_3064":59769},[],"Field in 3.8.0",{"_3608":2912,"_31023":2703,"_21483":59771,"_5":14766,"_28210":59221,"_3064":59772},[],"Field in 4.0.0",{"_3608":2913,"_31023":2703,"_21483":59774,"_5":14766,"_28210":59221,"_3064":59775},[],"`validate_server_cert`",{"_3608":2914,"_31023":2703,"_21483":59777,"_5":14766,"_28210":59221,"_3064":59778},[],"`insecure_skip_verify` (value negated)",{"_3608":2915,"_31023":2703,"_21483":59780,"_5":14766,"_28210":59221,"_3064":59781},[],"`oidc`",{"_3608":2916,"_31023":2703,"_21483":59783,"_5":14766,"_28210":59221,"_3064":59784},[],"`jwt_options`",{"_3608":2917,"_31023":2703,"_21483":59786,"_5":14766,"_28210":59221,"_3064":59787},[],"`apikey`",{"_3608":2918,"_31023":2703,"_21483":59789,"_5":14766,"_28210":59221,"_3064":59790},[],"`apikey_options`",{"_3608":2919,"_31023":2703,"_21483":59792,"_5":14766,"_28210":59221,"_3064":59793},[],"`mtls`",{"_3608":2920,"_31023":2703,"_21483":59795,"_5":14766,"_28210":59221,"_3064":59796},[],"`mtls_options`",{"_3608":2921,"_31023":2703,"_21483":59798,"_5":14766,"_28210":59221,"_3064":59799},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3608":2922,"_31023":2703,"_21483":59801,"_5":14766,"_28210":59221,"_3064":59802},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3608":2923,"_31023":2703,"_21483":59804,"_5":14766,"_28210":59221,"_3064":59805},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3608":2924,"_31023":2703,"_21483":59807,"_5":14766,"_28210":59225,"_3064":59808},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3608":2925,"_31023":2703,"_21483":59810,"_5":14766,"_28210":59225,"_3064":59811},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3608":2926,"_31023":2703,"_21483":59813,"_5":14766,"_28210":59225,"_3064":59814},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3608":2927,"_31023":2703,"_21483":59816,"_5":14766,"_28210":59229,"_3064":59817},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3608":2928,"_31023":2703,"_21483":59819,"_5":14766,"_28210":59233,"_3064":59820},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3608":2929,"_31023":2703,"_21483":59822,"_5":14766,"_28210":59237,"_3064":59823},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3608":2930,"_31023":2703,"_21483":59825,"_5":14766,"_28210":59241,"_3064":59826},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3608":2931,"_31023":2703,"_21483":59828,"_5":14766,"_28210":59241,"_3064":59829},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3608":2932,"_31023":2703,"_21483":59831,"_5":14766,"_28210":59241,"_3064":59832},[],"`POST /v1/devices/:id/events` creates an event.",{"_3608":2933,"_31023":2703,"_21483":59834,"_5":14766,"_28210":59241,"_3064":59835},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3608":2934,"_31023":2703,"_21483":59837,"_5":14766,"_28210":59245,"_3064":59838},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3608":2935,"_31023":2703,"_21483":59840,"_5":14766,"_28210":59249,"_3064":59841},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3608":2936,"_31023":2703,"_21483":59843,"_5":14766,"_28210":59249,"_3064":59844},[],"Route",{"_3608":2937,"_31023":2703,"_21483":59846,"_5":14766,"_28210":59249,"_3064":54164},[],{"_3608":2938,"_31023":2703,"_21483":59848,"_5":14766,"_28210":59249,"_3064":59849},[],"`GET /v1/crl-settings`",{"_3608":2939,"_31023":2703,"_21483":59851,"_5":14766,"_28210":59249,"_3064":59852},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3608":2940,"_31023":2703,"_21483":59854,"_5":14766,"_28210":59249,"_3064":59855},[],"`GET /v1/crl-settings/{ca-id}`",{"_3608":2941,"_31023":2703,"_21483":59857,"_5":14766,"_28210":59249,"_3064":59858},[],"Reads the settings of a CA.",{"_3608":2942,"_31023":2703,"_21483":59860,"_5":14766,"_28210":59249,"_3064":59861},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3608":2943,"_31023":2703,"_21483":59863,"_5":14766,"_28210":59249,"_3064":59864},[],"Replaces `crl_options`.",{"_3608":2944,"_31023":2703,"_21483":59866,"_5":14766,"_28210":59249,"_3064":59867},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3608":2945,"_31023":2703,"_21483":59869,"_5":14766,"_28210":59249,"_3064":59870},[],"Removes the archived settings of a CA.",{"_3608":2946,"_31023":2703,"_21483":59872,"_5":14766,"_28210":59249,"_3064":59873},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3608":2947,"_31023":2703,"_21483":59875,"_5":14766,"_28210":59249,"_3064":59876},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3608":2948,"_31023":2703,"_21483":59878,"_5":14766,"_28210":59249,"_3064":59879},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3608":2949,"_31023":2703,"_21483":59881,"_5":14766,"_28210":59249,"_3064":59882},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3608":2950,"_31023":2703,"_21483":59884,"_5":14766,"_28210":59249,"_3064":59885},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3608":2951,"_31023":2703,"_21483":59887,"_5":14766,"_28210":59249,"_3064":59888},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3608":2952,"_31023":2703,"_21483":59890,"_5":14766,"_28210":59249,"_3064":59891},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3608":2953,"_31023":2703,"_21483":59893,"_5":14766,"_28210":59249,"_3064":59894},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3608":2954,"_31023":2703,"_21483":59896,"_5":14766,"_28210":59249,"_3064":59897},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3608":2955,"_31023":2703,"_21483":59899,"_5":14766,"_28210":59249,"_3064":59900},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3608":2956,"_31023":2703,"_21483":59902,"_5":14766,"_28210":59249,"_3064":59903},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3608":2957,"_31023":2703,"_21483":59905,"_5":14766,"_28210":59253,"_3064":59906},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3608":2958,"_31023":2703,"_21483":59908,"_5":14766,"_28210":59257,"_3064":59909},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3608":2959,"_31023":2703,"_21483":59911,"_5":14766,"_28210":59261,"_3064":59912},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3608":2960,"_31023":2703,"_21483":59914,"_5":14766,"_28210":59265,"_3064":59915},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3608":2961,"_31023":2703,"_21483":59917,"_5":14766,"_28210":59265,"_3064":59918},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3608":2962,"_31023":2703,"_21483":59920,"_5":14766,"_28210":59268,"_3064":59921},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3608":2963,"_31023":2703,"_21483":59923,"_5":14766,"_28210":59272,"_3064":59924},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3608":2964,"_31023":2703,"_21483":59926,"_5":14766,"_28210":59276,"_3064":59927},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3608":2965,"_31023":2703,"_21483":59929,"_5":14766,"_28210":59276,"_3064":59930},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3608":2966,"_31023":2703,"_21483":59932,"_5":14766,"_28210":59276,"_3064":59933},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3608":2967,"_31023":2703,"_21483":59935,"_5":14766,"_28210":59276,"_3064":59936},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3608":2968,"_31023":2703,"_21483":59938,"_5":14766,"_28210":59276,"_3064":59939},[],"Record the names of your local-storage PVCs:",{"_3608":2969,"_31023":2703,"_21483":59941,"_5":14766,"_28210":59276,"_3064":59942},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3608":2970,"_31023":2703,"_21483":59944,"_5":14766,"_28210":59280,"_3064":59945},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3608":2971,"_31023":2703,"_21483":59947,"_5":14766,"_28210":59280,"_3064":59948},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3608":2972,"_31023":2703,"_21483":59950,"_5":14766,"_28210":59280,"_3064":59951},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3608":2973,"_31023":2703,"_21483":59953,"_5":14766,"_28210":59280,"_3064":59954},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3608":2974,"_31023":2703,"_21483":59956,"_5":14766,"_28210":59280,"_3064":59957},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3608":2975,"_31023":2703,"_21483":59959,"_5":14766,"_28210":59284,"_3064":59960},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3608":2976,"_31023":2703,"_21483":59962,"_5":14766,"_28210":59284,"_3064":59963},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3608":2977,"_31023":2703,"_21483":59965,"_5":14766,"_28210":59284,"_3064":59966},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3608":2978,"_31023":2703,"_21483":59968,"_5":14766,"_28210":59284,"_3064":59969},[],"Secret (`existingSecret`)",{"_3608":2979,"_31023":2703,"_21483":59971,"_5":14766,"_28210":59284,"_3064":59972},[],"Required data keys",{"_3608":2980,"_31023":2703,"_21483":59974,"_5":14766,"_28210":59284,"_3064":59975},[],"When",{"_3608":2981,"_31023":2703,"_21483":59977,"_5":14766,"_28210":59284,"_3064":59978},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3608":2982,"_31023":2703,"_21483":59980,"_5":14766,"_28210":59284,"_3064":59981},[],"`username`, `password`",{"_3608":2983,"_31023":2703,"_21483":59983,"_5":14766,"_28210":59284,"_3064":59984},[],"Always",{"_3608":2984,"_31023":2703,"_21483":59986,"_5":14766,"_28210":59284,"_3064":59987},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3608":2985,"_31023":2703,"_21483":59989,"_5":14766,"_28210":59284,"_3064":59981},[],{"_3608":2986,"_31023":2703,"_21483":59991,"_5":14766,"_28210":59284,"_3064":59984},[],{"_3608":2987,"_31023":2703,"_21483":59993,"_5":14766,"_28210":59284,"_3064":59994},[],"`services.alerts.smtp_server.existingSecret`",{"_3608":2988,"_31023":2703,"_21483":59996,"_5":14766,"_28210":59284,"_3064":59981},[],{"_3608":2989,"_31023":2703,"_21483":59998,"_5":14766,"_28210":59284,"_3064":59999},[],"Only when SMTP authentication is enabled",{"_3608":2990,"_31023":2703,"_21483":60001,"_5":14766,"_28210":59284,"_3064":60002},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3608":2991,"_31023":2703,"_21483":60004,"_5":14766,"_28210":59284,"_3064":60005},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3608":2992,"_31023":2703,"_21483":60007,"_5":14766,"_28210":59284,"_3064":60008},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3608":2993,"_31023":2703,"_21483":60010,"_5":14766,"_28210":59284,"_3064":60011},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3608":2994,"_31023":2703,"_21483":60013,"_5":14766,"_28210":59284,"_3064":60014},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3608":2995,"_31023":2703,"_21483":60016,"_5":14766,"_28210":59284,"_3064":60017},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3608":2996,"_31023":2703,"_21483":60019,"_5":14766,"_28210":59284,"_3064":60020},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3608":2997,"_31023":2703,"_21483":60022,"_5":14766,"_28210":59284,"_3064":60023},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3608":2998,"_31023":2703,"_21483":60025,"_5":14766,"_28210":59284,"_3064":60026},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3608":2999,"_31023":2703,"_21483":60028,"_5":14766,"_28210":59284,"_3064":60029},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3608":3000,"_31023":2703,"_21483":60031,"_5":14766,"_28210":59284,"_3064":60032},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3608":3001,"_31023":2703,"_21483":60034,"_5":14766,"_28210":59284,"_3064":60035},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3608":3002,"_31023":2703,"_21483":60037,"_5":14766,"_28210":59284,"_3064":60038},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3608":3003,"_31023":2703,"_21483":60040,"_5":14766,"_28210":59284,"_3064":60041},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3608":3004,"_31023":2703,"_21483":60043,"_5":14766,"_28210":59284,"_3064":60044},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3608":3005,"_31023":2703,"_21483":60046,"_5":14766,"_28210":59288,"_3064":60047},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3608":3006,"_31023":2703,"_21483":60049,"_5":14766,"_28210":59288,"_3064":60050},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3608":3007,"_31023":2703,"_21483":60052,"_5":14766,"_28210":59292,"_3064":60053},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3608":3008,"_31023":2703,"_21483":60055,"_5":14766,"_28210":59292,"_3064":60056},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3608":3009,"_31023":2703,"_21483":60058,"_5":14766,"_28210":59292,"_3064":60059},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3608":3010,"_31023":2703,"_21483":60061,"_5":14766,"_28210":59292,"_3064":60062},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3608":3011,"_31023":2703,"_21483":60064,"_5":14766,"_28210":59292,"_3064":60065},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3608":3012,"_31023":2703,"_21483":60067,"_5":14766,"_28210":59292,"_3064":60068},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3608":3013,"_31023":2703,"_21483":60070,"_5":14766,"_28210":59292,"_3064":60071},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3608":3014,"_31023":2703,"_21483":60073,"_5":14766,"_28210":59292,"_3064":60074},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3608":3015,"_31023":2703,"_21483":60076,"_5":14766,"_28210":59292,"_3064":60077},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3608":3016,"_31023":2703,"_21483":60079,"_5":14766,"_28210":59292,"_3064":60080},[],"**Remove the helper and restore the recorded replica counts:**",{"_3608":3017,"_31023":2703,"_21483":60082,"_5":14766,"_28210":59292,"_3064":60083},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3608":3018,"_31023":2703,"_21483":60085,"_5":14766,"_28210":59296,"_3064":60086},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3608":3019,"_31023":2703,"_21483":60088,"_5":14766,"_28210":59296,"_3064":60089},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3608":3020,"_31023":2703,"_21483":60091,"_5":14766,"_28210":59300,"_3064":60092},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3608":3021,"_31023":2703,"_21483":60094,"_5":14766,"_28210":59300,"_3064":60095},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3608":3022,"_31023":2703,"_21483":60097,"_5":14766,"_28210":59300,"_3064":60098},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3608":3023,"_31023":2703,"_21483":60100,"_5":14766,"_28210":59300,"_3064":60101},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3608":3024,"_31023":2703,"_21483":60103,"_5":14766,"_28210":59300,"_3064":60104},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3608":3025,"_31023":2703,"_21483":60106,"_5":14766,"_28210":59300,"_3064":60107},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3608":3026,"_31023":2703,"_21483":60109,"_5":14766,"_28210":59300,"_3064":60110},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3608":3027,"_31023":2703,"_21483":60112,"_5":14766,"_28210":59300,"_3064":60113},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3608":3028,"_31023":2703,"_21483":60115,"_5":14766,"_28210":59304,"_3064":60116},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3608":3029,"_31023":2703,"_21483":60118,"_5":14766,"_28210":59304,"_3064":60119},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3608":3030,"_31023":2703,"_21483":60121,"_5":14766,"_28210":59304,"_3064":60122},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3608":3031,"_31023":2703,"_21483":60124,"_5":14766,"_28210":59304,"_3064":60125},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3608":3032,"_31023":2703,"_21483":60127,"_5":14766,"_28210":59304,"_3064":60128},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3608":3033,"_31023":2703,"_21483":60130,"_5":14766,"_28210":59304,"_3064":60131},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3608":3034,"_31023":2703,"_21483":60133,"_5":14766,"_28210":59304,"_3064":60134},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3608":3035,"_31023":2703,"_21483":60136,"_5":14766,"_28210":59304,"_3064":60137},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3608":3036,"_31023":2703,"_21483":60139,"_5":14766,"_28210":59304,"_3064":60140},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3608":3037,"_31023":2703,"_21483":60142,"_5":14766,"_28210":59304,"_3064":60143},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3608":3038,"_31023":2703,"_21483":60145,"_5":14766,"_28210":59304,"_3064":60146},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3608":3039,"_31023":2703,"_21483":60148,"_5":14766,"_28210":59307,"_3064":60149},[],"After the upgrade, check in this order:",{"_3608":3040,"_31023":2703,"_21483":60151,"_5":14766,"_28210":59307,"_3064":60152},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3608":3041,"_31023":2703,"_21483":60154,"_5":14766,"_28210":59307,"_3064":60155},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3608":3042,"_31023":2703,"_21483":60157,"_5":14766,"_28210":59307,"_3064":60158},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3608":3043,"_31023":2703,"_21483":60160,"_5":14766,"_28210":59307,"_3064":60161},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3608":3044,"_31023":2703,"_21483":60163,"_5":14766,"_28210":59307,"_3064":60164},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3608":3045,"_31023":2703,"_21483":60166,"_5":14766,"_28210":59307,"_3064":60167},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3608":3046,"_31023":2703,"_21483":60169,"_5":14766,"_28210":59307,"_3064":60170},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3608":3047,"_31023":2703,"_21483":60172,"_5":14766,"_28210":59307,"_3064":60173},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3608":3048,"_31023":2703,"_21483":60175,"_5":14766,"_28210":59307,"_3064":60176},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3608":3049,"_31023":2703,"_21483":60178,"_5":14766,"_28210":59307,"_3064":60179},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3608":3050,"_31023":2703,"_21483":60181,"_5":14766,"_28210":59307,"_3064":60182},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3608":3051,"_31023":2703,"_21483":60184,"_5":14766,"_28210":59307,"_3064":60185},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3608":3052,"_31023":2703,"_21483":60187,"_5":14766,"_28210":59307,"_3064":60188},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3608":3053,"_31023":2703,"_21483":60190,"_5":14766,"_28210":59307,"_3064":60191},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3608":3054,"_31023":2703,"_21483":60193,"_5":14766,"_28210":59307,"_3064":60194},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3608":3055,"_31023":2703,"_21483":60196,"_5":14766,"_28210":59311,"_3064":60197},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3608":3056,"_31023":2703,"_21483":60199,"_5":14766,"_28210":59311,"_3064":60200},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3608":3057,"_31023":2703,"_21483":60202,"_5":14766,"_28210":59311,"_3064":60203},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3608":3058,"_31023":2703,"_21483":60205,"_5":14766,"_28210":59311,"_3064":60206},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3608":3059,"_31023":2703,"_21483":60208,"_5":14766,"_28210":59311,"_3064":60209},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60212":60213,"_60214":60215,"_60216":60217,"_60218":60219,"_18608":3099,"_72413":3099},"language","english","sortableProperties",[3064,31023,5,28210],"sortablePropertiesWithTypes",{"_3064":25646,"_31023":25646,"_5":25646,"_28210":25646},"sorts",{"_3064":60220,"_31023":63269,"_5":66317,"_28210":69365},{"_4807":60221,"_60222":60223,"_5":25646},{"_14842":7195,"_15225":6708,"_15244":7184,"_30022":16703,"_15231":4508,"_20390":6178,"_14863":3140,"_14870":3472,"_29964":7210,"_30378":7253,"_30399":5346,"_29998":4643,"_35428":5115,"_30101":7774,"_30443":5104,"_35435":30614,"_35438":6937,"_35441":3207,"_35444":4464,"_30845":10418,"_35449":24477,"_35451":7842,"_30880":23962,"_15240":6702,"_35455":3553,"_35458":7448,"_35460":6412,"_30427":3251,"_30865":3489,"_30893":5162,"_35465":7757,"_35467":3463,"_35469":4082,"_30118":3164,"_35472":3546,"_35474":7181,"_35476":5318,"_35478":3789,"_35480":9793,"_30035":7909,"_35483":4708,"_35485":3465,"_30029":3558,"_30464":7444,"_35489":4358,"_35491":7731,"_35494":4564,"_30075":4149,"_35498":5157,"_29955":4983,"_35501":6050,"_30003":3278,"_35504":6707,"_35506":3139,"_35509":6033,"_15234":9064,"_35512":7275,"_35514":28454,"_35517":7889,"_35519":4770,"_35521":4367,"_35523":5857,"_35525":6044,"_20393":5354,"_35528":5625,"_35530":4359,"_29976":4723,"_30421":16000,"_35534":5635,"_35536":6244,"_35538":5316,