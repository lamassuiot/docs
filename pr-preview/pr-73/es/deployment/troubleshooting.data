ets/integrations/aws-iot-core",{"_68":316},"platform/iot-fleets/integrations/aws-iot-core.mdx","es:platform/iot-fleets/integrations",{"_200":319},"platform/iot-fleets/integrations/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud shrink-0\" aria-hidden=\"true\"><path d=\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z\"></path></svg>","es:platform/iot-fleets",{"_200":323},"platform/iot-fleets/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cpu shrink-0\" aria-hidden=\"true\"><path d=\"M12 20v2\"></path><path d=\"M12 2v2\"></path><path d=\"M17 20v2\"></path><path d=\"M17 2v2\"></path><path d=\"M2 12h2\"></path><path d=\"M2 17h2\"></path><path d=\"M2 7h2\"></path><path d=\"M20 12h2\"></path><path d=\"M20 17h2\"></path><path d=\"M20 7h2\"></path><path d=\"M7 20v2\"></path><path d=\"M7 2v2\"></path><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"></rect><rect x=\"8\" y=\"8\" width=\"8\" height=\"8\" rx=\"1\"></rect></svg>",{"_42":326,"_49":61,"_44":211,"_55":327,"_64":-7,"_11":328,"_66":329},"es:platform/iot-fleets/overview.mdx","Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.","/docs/pr-preview/pr-73/es/platform/iot-fleets/overview",{"_68":330},"platform/iot-fleets/overview.mdx",{"_49":50,"_44":332,"_52":-7,"_54":-7,"_55":-7,"_57":-7,"_46":333,"_42":368,"_66":369,"_64":-7},"Administración",[334,354,361],{"_49":50,"_44":335,"_52":-7,"_54":-7,"_55":-7,"_57":-7,"_46":336,"_42":351,"_66":352,"_64":-7},"Control de acceso",[337,344],{"_42":338,"_49":61,"_44":339,"_55":340,"_64":-7,"_11":341,"_66":342},"es:platform/administration/access-control/index.m