.mdx","OCSP","Query signed status and verify the responder’s response.","/docs/pr-preview/pr-73/platform/pki/ocsp",{"_67":178},"platform/pki/ocsp.mdx",{"_42":180,"_49":60,"_44":181,"_54":182,"_63":-7,"_12":33,"_65":183},"en:platform/pki/crl.mdx","CRL","Generate and distribute signed lists to validate certificates offline.",{"_67":184},"platform/pki/crl.mdx",{"_42":186,"_49":86,"_63":-7,"_44":187},"en:_4","Troubleshooting",{"_42":189,"_49":60,"_44":190,"_54":191,"_63":-7,"_12":192,"_65":193},"en:platform/pki/troubleshooting.mdx","PKI troubleshooting","Diagnose certificate issuance, OCSP and CRL.","/docs/pr-preview/pr-73/platform/pki/troubleshooting",{"_67":194},"platform/pki/troubleshooting.mdx","en:platform/pki",{"_197":198},"metaFile","platform/pki/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check shrink-0\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>","index",{"_42":202,"_49":60,"_44":82,"_54":203,"_63":-7,"_12":204,"_65":205},"en:platform/pki/overview.mdx","Administer keys and authorities, define issuance and verify the resulting certificates.","/docs/pr-preview/pr-73/platform/pki/overview",{"_67":206},"platform/pki/overview.mdx",{"_49":50,"_44":208,"_51":-7,"_53":-7,"_54":-7,"_56":-7,"_46":209,"_42":318,"_65":319,"_63":321,"_200":322},"IoT Fleets",[210,212,219,226,229,235,304],{"_42":211,"_49":86,"_63":-7,"_44":87},"en:_5",{"_42":213,"_49":60,"_44":214,"_54":215,"_63":-7,"_12":216,"_65":217},"en:platform/iot-fleets/quickstarts/enroll-device.mdx","Enroll and connect your first device","Obtain an identity through EST, verify its association and use it in an mTLS connection.","