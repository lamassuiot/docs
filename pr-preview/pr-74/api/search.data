Otros modelos",[],{"_3603":72402,"_31069":72401,"_21510":119756,"_5":14782,"_28250":72401,"_3059":119757},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3603":72403,"_31069":72401,"_5":31425,"_21510":119759,"_28250":119760,"_3059":119761},[],"/docs/pr-preview/pr-74/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3603":72404,"_31069":72401,"_5":31425,"_21510":119763,"_28250":119764,"_3059":119765},[],"/docs/pr-preview/pr-74/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3603":72405,"_31069":72401,"_5":31425,"_21510":119767,"_28250":119768,"_3059":119769},[],"/docs/pr-preview/pr-74/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3603":72406,"_31069":72401,"_5":31425,"_21510":119771,"_28250":119772,"_3059":119773},[],"/docs/pr-preview/pr-74/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3603":72407,"_31069":72401,"_5":31425,"_21510":119775,"_28250":119776,"_3059":119777},[],"/docs/pr-preview/pr-74/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3603":72408,"_31069":72401,"_5":31425,"_21510":119779,"_28250":119780,"_3059":119781},[],"/docs/pr-preview/pr-74/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3603":72409,"_31069":72401,"_5":31425,"_21510":119783,"_28250":119784,"_3059":119785},[],"/docs/pr-preview/pr-74/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3603":72410,"_31069":72401,"_21510":119787,"_5":14782,"_28250":72401,"_3059":119788},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3603":72411,"_31069":72401,"_21510":119790,"_5":14782,"_28250":119760,"_3059":119791},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3603":72412,"_31069":72401,"_21510":119793,"_5":14782,"_28250":119760,"_3059":119794},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3603":72413,"_31069":72401,"_21510":119796,"_5":14782,"_28250":119760,"_3059":119797},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3603":72414,"_31069":72401,"_21510":119799,"_5":14782,"_28250":119764,"_3059":119800},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3603":72415,"_31069":72401,"_21510":119802,"_5":14782,"_28250":119764,"_3059":119803},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3603":72416,"_31069":72401,"_21510":119805,"_5":14782,"_28250":119764,"_3059":119806},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3603":72417,"_31069":72401,"_21510":119808,"_5":14782,"_28250":119768,"_3059":119809},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3603":72418,"_31069":72401,"_21510":119811,"_5":14782,"_28250":119772,"_3059":119812},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3603":72419,"_31069":72401,"_21510":119814,"_5":14782,"_28250":119776,"_3059":119815},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3603":72420,"_31069":72401,"_21510":119817,"_5":14782,"_28250":119780,"_3059":119818},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3603":72421,"_31069":72401,"_21510":119820,"_5":14782,"_28250":119784,"_3059":119821},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3603":72422,"_31069":72422,"_5":15147,"_3059":119823,"_31428":119824,"_21510":119825,"_28250":72422},"Despliega Lamassu",[50742,119752],[],{"_3603":72423,"_31069":72422,"_21510":119827,"_5":14782,"_28250":72422,"_3059":119828},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3603":72424,"_31069":72422,"_5":31425,"_21510":119830,"_28250":119831,"_3059":119832},[],"/docs/pr-preview/pr-74/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3603":72425,"_31069":72422,"_5":31425,"_21510":119834,"_28250":119835,"_3059":119836},[],"/docs/pr-preview/pr-74/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3603":72426,"_31069":72422,"_5":31425,"_21510":119838,"_28250":119839,"_3059":119840},[],"/docs/pr-preview/pr-74/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3603":72427,"_31069":72422,"_21510":119842,"_5":14782,"_28250":72422,"_3059":119843},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3603":72428,"_31069":72422,"_21510":119845,"_5":14782,"_28250":119831,"_3059":119846},[],"Modelo",{"_3603":72429,"_31069":72422,"_21510":119848,"_5":14782,"_28250":119831,"_3059":119849},[],"Recomendado para",{"_3603":72430,"_31069":72422,"_21510":119851,"_5":14782,"_28250":119831,"_3059":119852},[],"Quién opera la infraestructura",{"_3603":72431,"_31069":72422,"_21510":119854,"_5":14782,"_28250":119831,"_3059":119855},[],"Punto de partida",{"_3603":72432,"_31069":72422,"_21510":119857,"_5":14782,"_28250":119831,"_3059":50849},[],{"_3603":72433,"_31069":72422,"_21510":119859,"_5":14782,"_28250":119831,"_3059":119860},[],"Producción, entornos regulados y despliegues personalizados",{"_3603":72434,"_31069":72422,"_21510":119862,"_5":14782,"_28250":119831,"_3059":119863},[],"Tu equipo",{"_3603":72435,"_31069":72422,"_21510":119865,"_5":14782,"_28250":119831,"_3059":119866},[],"Helm o Fastlane",{"_3603":72436,"_31069":72422,"_21510":119868,"_5":14782,"_28250":119831,"_3059":50861},[],{"_3603":72437,"_31069":72422,"_21510":119870,"_5":14782,"_28250":119831,"_3059":119871},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3603":72438,"_31069":72422,"_21510":119873,"_5":14782,"_28250":119831,"_3059":119863},[],{"_3603":72439,"_31069":72422,"_21510":119875,"_5":14782,"_28250":119831,"_3059":119876},[],"Imagen preconfigurada en EC2",{"_3603":72440,"_31069":72422,"_21510":119878,"_5":14782,"_28250":119831,"_3059":50872},[],{"_3603":72441,"_31069":72422,"_21510":119880,"_5":14782,"_28250":119831,"_3059":119881},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3603":72442,"_31069":72422,"_21510":119883,"_5":14782,"_28250":119831,"_3059":50878},[],{"_3603":72443,"_31069":72422,"_21510":119885,"_5":14782,"_28250":119831,"_3059":119886},[],"Suscripción gestionada",{"_3603":72444,"_31069":72422,"_21510":119888,"_5":14782,"_28250":119831,"_3059":119889},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3603":72445,"_31069":72422,"_21510":119891,"_5":14782,"_28250":119831,"_3059":119892},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3603":72446,"_31069":72422,"_21510":119894,"_5":14782,"_28250":119831,"_3059":119895},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3603":72447,"_31069":72422,"_21510":119897,"_5":14782,"_28250":119835,"_3059":119898},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3603":72448,"_31069":72422,"_21510":119900,"_5":14782,"_28250":119839,"_3059":119901},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3603":72449,"_31069":72449,"_5":15147,"_3059":119903,"_31428":119904,"_21510":119905,"_28250":72449},"Utiliza Lamassu como SaaS",[50742,119752,119753],[],{"_3603":72450,"_31069":72449,"_21510":119907,"_5":14782,"_28250":72449,"_3059":119908},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3603":72451,"_31069":72449,"_5":31425,"_21510":119910,"_28250":119911,"_3059":119912},[],"/docs/pr-preview/pr-74/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3603":72452,"_31069":72449,"_5":31425,"_21510":119914,"_28250":119915,"_3059":119916},[],"/docs/pr-preview/pr-74/es/deployment/saas#planes","Planes",{"_3603":72453,"_31069":72449,"_5":31425,"_21510":119918,"_28250":119919,"_3059":119920},[],"/docs/pr-preview/pr-74/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3603":72454,"_31069":72449,"_21510":119922,"_5":14782,"_28250":72449,"_3059":119923},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3603":72455,"_31069":72449,"_21510":119925,"_5":14782,"_28250":119911,"_3059":119926},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3603":72456,"_31069":72449,"_21510":119928,"_5":14782,"_28250":119911,"_3059":119929},[],"Copias de seguridad automáticas.",{"_3603":72457,"_31069":72449,"_21510":119931,"_5":14782,"_28250":119911,"_3059":119932},[],"Actualizaciones de versión.",{"_3603":72458,"_31069":72449,"_21510":119934,"_5":14782,"_28250":119911,"_3059":119935},[],"Soporte técnico y SLA según el plan contratado.",{"_3603":72459,"_31069":72449,"_21510":119937,"_5":14782,"_28250":119915,"_3059":50933},[],{"_3603":72460,"_31069":72449,"_21510":119939,"_5":14782,"_28250":119915,"_3059":119940},[],"Dispositivos",{"_3603":72461,"_31069":72449,"_21510":119942,"_5":14782,"_28250":119915,"_3059":119943},[],"Soporte",{"_3603":72462,"_31069":72449,"_21510":119945,"_5":14782,"_28250":119915,"_3059":50942},[],{"_3603":72463,"_31069":72449,"_21510":119947,"_5":14782,"_28250":119915,"_3059":50945},[],{"_3603":72464,"_31069":72449,"_21510":119949,"_5":14782,"_28250":119915,"_3059":119950},[],"Hasta 1.000",{"_3603":72465,"_31069":72449,"_21510":119952,"_5":14782,"_28250":119915,"_3059":50951},[],{"_3603":72466,"_31069":72449,"_21510":119954,"_5":14782,"_28250":119915,"_3059":119955},[],"99,5 %",{"_3603":72467,"_31069":72449,"_21510":119957,"_5":14782,"_28250":119915,"_3059":50957},[],{"_3603":72468,"_31069":72449,"_21510":119959,"_5":14782,"_28250":119915,"_3059":119960},[],"Hasta 10.000",{"_3603":72469,"_31069":72449,"_21510":119962,"_5":14782,"_28250":119915,"_3059":119963},[],"Email y chat",{"_3603":72470,"_31069":72449,"_21510":119965,"_5":14782,"_28250":119915,"_3059":119966},[],"99,9 %",{"_3603":72471,"_31069":72449,"_21510":119968,"_5":14782,"_28250":119915,"_3059":50969},[],{"_3603":72472,"_31069":72449,"_21510":119970,"_5":14782,"_28250":119915,"_3059":119971},[],"Ilimitados",{"_3603":72473,"_31069":72449,"_21510":119973,"_5":14782,"_28250":119915,"_3059":119974},[],"Dedicado",{"_3603":72474,"_31069":72449,"_21510":119976,"_5":14782,"_28250":119915,"_3059":119977},[],"99,99 %",{"_3603":72475,"_31069":72449,"_21510":119979,"_5":14782,"_28250":119919,"_3059":119980},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3603":72476,"_31069":72449,"_21510":119982,"_5":14782,"_28250":119919,"_3059":119983},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3603":72477,"_31069":72477,"_5":15147,"_3059":50986,"_31428":119985,"_21510":119987,"_28250":72477},[50742,119752,119986],"Kubernetes autogestionado",[],{"_3603":72478,"_31069":72477,"_21510":119989,"_5":14782,"_28250":72477,"_3059":119990},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3603":72479,"_31069":72477,"_5":31425,"_21510":119992,"_28250":119993,"_3059":119994},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3603":72480,"_31069":72477,"_5":31425,"_21510":119996,"_28250":119997,"_3059":119998},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3603":72481,"_31069":72477,"_5":31425,"_21510":120000,"_28250":120001,"_3059":120002},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3603":72482,"_31069":72477,"_5":31425,"_21510":120004,"_28250":120005,"_3059":120006},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3603":72483,"_31069":72477,"_5":31425,"_21510":120008,"_28250":120009,"_3059":120010},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3603":72484,"_31069":72477,"_5":31425,"_21510":120012,"_28250":120013,"_3059":120014},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3603":72485,"_31069":72477,"_5":31425,"_21510":120016,"_28250":120017,"_3059":120018},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3603":72486,"_31069":72477,"_5":31425,"_21510":120020,"_28250":120021,"_3059":120022},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3603":72487,"_31069":72477,"_5":31425,"_21510":120024,"_28250":120025,"_3059":120026},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3603":72488,"_31069":72477,"_5":31425,"_21510":120028,"_28250":120029,"_3059":120030},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3603":72489,"_31069":72477,"_5":31425,"_21510":120032,"_28250":120033,"_3059":120034},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3603":72490,"_31069":72477,"_21510":120036,"_5":14782,"_28250":119993,"_3059":120037},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3603":72491,"_31069":72477,"_21510":120039,"_5":14782,"_28250":119993,"_3059":120040},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3603":72492,"_31069":72477,"_21510":120042,"_5":14782,"_28250":119997,"_3059":120043},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3603":72493,"_31069":72477,"_21510":120045,"_5":14782,"_28250":119997,"_3059":120046},[],"Fastlane instala o configura",{"_3603":72494,"_31069":72477,"_21510":120048,"_5":14782,"_28250":119997,"_3059":120049},[],"Tú sigues proporcionando",{"_3603":72495,"_31069":72477,"_21510":120051,"_5":14782,"_28250":119997,"_3059":120052},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3603":72496,"_31069":72477,"_21510":120054,"_5":14782,"_28250":119997,"_3059":120055},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3603":72497,"_31069":72477,"_21510":120057,"_5":14782,"_28250":119997,"_3059":120058},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3603":72498,"_31069":72477,"_21510":120060,"_5":14782,"_28250":119997,"_3059":120061},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3603":72499,"_31069":72477,"_21510":120063,"_5":14782,"_28250":119997,"_3059":120064},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3603":72500,"_31069":72477,"_21510":120066,"_5":14782,"_28250":119997,"_3059":120067},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3603":72501,"_31069":72477,"_21510":120069,"_5":14782,"_28250":119997,"_3059":120070},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3603":72502,"_31069":72477,"_21510":120072,"_5":14782,"_28250":119997,"_3059":120073},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3603":72503,"_31069":72477,"_21510":120075,"_5":14782,"_28250":119997,"_3059":120076},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3603":72504,"_31069":72477,"_21510":120078,"_5":14782,"_28250":120001,"_3059":120079},[],"Necesitas:",{"_3603":72505,"_31069":72477,"_21510":120081,"_5":14782,"_28250":120001,"_3059":120082},[],"un clúster Kubernetes existente",{"_3603":72506,"_31069":72477,"_21510":120084,"_5":14782,"_28250":120001,"_3059":120085},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3603":72507,"_31069":72477,"_21510":120087,"_5":14782,"_28250":120001,"_3059":51088},[],{"_3603":72508,"_31069":72477,"_21510":120089,"_5":14782,"_28250":120001,"_3059":24316},[],{"_3603":72509,"_31069":72477,"_21510":120091,"_5":14782,"_28250":120001,"_3059":120092},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3603":72510,"_31069":72477,"_21510":120094,"_5":14782,"_28250":120001,"_3059":120095},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3603":72511,"_31069":72477,"_21510":120097,"_5":14782,"_28250":120001,"_3059":120098},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3603":72512,"_31069":72477,"_21510":120100,"_5":14782,"_28250":120001,"_3059":120101},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3603":72513,"_31069":72477,"_21510":120103,"_5":14782,"_28250":120001,"_3059":120104},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3603":72514,"_31069":72477,"_21510":120106,"_5":14782,"_28250":120005,"_3059":120107},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3603":72515,"_31069":72477,"_21510":120109,"_5":14782,"_28250":120005,"_3059":120110},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3603":72516,"_31069":72477,"_21510":120112,"_5":14782,"_28250":120009,"_3059":120113},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3603":72517,"_31069":72477,"_21510":120115,"_5":14782,"_28250":120009,"_3059":120116},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3603":72518,"_31069":72477,"_21510":120118,"_5":14782,"_28250":120009,"_3059":120119},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3603":72519,"_31069":72477,"_21510":120121,"_5":14782,"_28250":120009,"_3059":120122},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3603":72520,"_31069":72477,"_21510":120124,"_5":14782,"_28250":120013,"_3059":120125},[],"Opción",{"_3603":72521,"_31069":72477,"_21510":120127,"_5":14782,"_28250":120013,"_3059":120128},[],"Valor predeterminado",{"_3603":72522,"_31069":72477,"_21510":120130,"_5":14782,"_28250":120013,"_3059":120131},[],"Propósito",{"_3603":72523,"_31069":72477,"_21510":120133,"_5":14782,"_28250":120013,"_3059":51135},[],{"_3603":72524,"_31069":72477,"_21510":120135,"_5":14782,"_28250":120013,"_3059":51138},[],{"_3603":72525,"_31069":72477,"_21510":120137,"_5":14782,"_28250":120013,"_3059":120138},[],"Muestra la ayuda",{"_3603":72526,"_31069":72477,"_21510":120140,"_5":14782,"_28250":120013,"_3059":51144},[],{"_3603":72527,"_31069":72477,"_21510":120142,"_5":14782,"_28250":120013,"_3059":120143},[],"contexto actual",{"_3603":72528,"_31069":72477,"_21510":120145,"_5":14782,"_28250":120013,"_3059":120146},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3603":72529,"_31069":72477,"_21510":120148,"_5":14782,"_28250":120013,"_3059":51153},[],{"_3603":72530,"_31069":72477,"_21510":120150,"_5":14782,"_28250":120013,"_3059":6762},[],{"_3603":72531,"_31069":72477,"_21510":120152,"_5":14782,"_28250":120013,"_3059":120153},[],"Omite prompts y genera credenciales para las dependencias",{"_3603":72532,"_31069":72477,"_21510":120155,"_5":14782,"_28250":120013,"_3059":51161},[],{"_3603":72533,"_31069":72477,"_21510":120157,"_5":14782,"_28250":120013,"_3059":51164},[],{"_3603":72534,"_31069":72477,"_21510":120159,"_5":14782,"_28250":120013,"_3059":120160},[],"Namespace de la instalación",{"_3603":72535,"_31069":72477,"_21510":120162,"_5":14782,"_28250":120013,"_3059":51170},[],{"_3603":72536,"_31069":72477,"_21510":120164,"_5":14782,"_28250":120013,"_3059":51173},[],{"_3603":72537,"_31069":72477,"_21510":120166,"_5":14782,"_28250":120013,"_3059":120167},[],"Dominio usado por la UI, OIDC y el certificado",{"_3603":72538,"_31069":72477,"_21510":120169,"_5":14782,"_28250":120013,"_3059":51179},[],{"_3603":72539,"_31069":72477,"_21510":120171,"_5":14782,"_28250":120013,"_3059":15494},[],{"_3603":72540,"_31069":72477,"_21510":120173,"_5":14782,"_28250":120013,"_3059":120174},[],"Versión del chart de Lamassu",{"_3603":72541,"_31069":72477,"_21510":120176,"_5":14782,"_28250":120013,"_3059":51187},[],{"_3603":72542,"_31069":72477,"_21510":120178,"_5":14782,"_28250":120013,"_3059":51190},[],{"_3603":72543,"_31069":72477,"_21510":120180,"_5":14782,"_28250":120013,"_3059":120181},[],"Puerto del listener HTTPS",{"_3603":72544,"_31069":72477,"_21510":120183,"_5":14782,"_28250":120013,"_3059":51196},[],{"_3603":72545,"_31069":72477,"_21510":120185,"_5":14782,"_28250":120013,"_3059":51199},[],{"_3603":72546,"_31069":72477,"_21510":120187,"_5":14782,"_28250":120013,"_3059":120188},[],"Puerto del listener HTTP",{"_3603":72547,"_31069":72477,"_21510":120190,"_5":14782,"_28250":120013,"_3059":51205},[],{"_3603":72548,"_31069":72477,"_21510":120192,"_5":14782,"_28250":120013,"_3059":51138},[],{"_3603":72549,"_31069":72477,"_21510":120194,"_5":14782,"_28250":120013,"_3059":120195},[],"Certificado PEM para TLS downstream",{"_3603":72550,"_31069":72477,"_21510":120197,"_5":14782,"_28250":120013,"_3059":51213},[],{"_3603":72551,"_31069":72477,"_21510":120199,"_5":14782,"_28250":120013,"_3059":51138},[],{"_3603":72552,"_31069":72477,"_21510":120201,"_5":14782,"_28250":120013,"_3059":120202},[],"Clave privada PEM para TLS downstream",{"_3603":72553,"_31069":72477,"_21510":120204,"_5":14782,"_28250":120013,"_3059":51221},[],{"_3603":72554,"_31069":72477,"_21510":120206,"_5":14782,"_28250":120013,"_3059":120207},[],"chart del repositorio",{"_3603":72555,"_31069":72477,"_21510":120209,"_5":14782,"_28250":120013,"_3059":120210},[],"Usa un chart local de Lamassu sin empaquetar",{"_3603":72556,"_31069":72477,"_21510":120212,"_5":14782,"_28250":120013,"_3059":51230},[],{"_3603":72557,"_31069":72477,"_21510":120214,"_5":14782,"_28250":120013,"_3059":120215},[],"detección automática",{"_3603":72558,"_31069":72477,"_21510":120217,"_5":14782,"_28250":120013,"_3059":120218},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3603":72559,"_31069":72477,"_21510":120220,"_5":14782,"_28250":120013,"_3059":51238},[],{"_3603":72560,"_31069":72477,"_21510":120222,"_5":14782,"_28250":120013,"_3059":6762},[],{"_3603":72561,"_31069":72477,"_21510":120224,"_5":14782,"_28250":120013,"_3059":120225},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3603":72562,"_31069":72477,"_21510":120227,"_5":14782,"_28250":120013,"_3059":51246},[],{"_3603":72563,"_31069":72477,"_21510":120229,"_5":14782,"_28250":120013,"_3059":6762},[],{"_3603":72564,"_31069":72477,"_21510":120231,"_5":14782,"_28250":120013,"_3059":120232},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3603":72565,"_31069":72477,"_21510":120234,"_5":14782,"_28250":120013,"_3059":51254},[],{"_3603":72566,"_31069":72477,"_21510":120236,"_5":14782,"_28250":120013,"_3059":6762},[],{"_3603":72567,"_31069":72477,"_21510":120238,"_5":14782,"_28250":120013,"_3059":120239},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3603":72568,"_31069":72477,"_21510":120241,"_5":14782,"_28250":120013,"_3059":51262},[],{"_3603":72569,"_31069":72477,"_21510":120243,"_5":14782,"_28250":120013,"_3059":6762},[],{"_3603":72570,"_31069":72477,"_21510":120245,"_5":14782,"_28250":120013,"_3059":120246},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3603":72571,"_31069":72477,"_21510":120248,"_5":14782,"_28250":120013,"_3059":51270},[],{"_3603":72572,"_31069":72477,"_21510":120250,"_5":14782,"_28250":120013,"_3059":51273},[],{"_3603":72573,"_31069":72477,"_21510":120252,"_5":14782,"_28250":120013,"_3059":120253},[],"Usa otro chart local de SoftHSM",{"_3603":72574,"_31069":72477,"_21510":120255,"_5":14782,"_28250":120013,"_3059":120256},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3603":72575,"_31069":72477,"_21510":120258,"_5":14782,"_28250":120017,"_3059":120259},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3603":72576,"_31069":72477,"_21510":120261,"_5":14782,"_28250":120017,"_3059":120262},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3603":72577,"_31069":72477,"_21510":120264,"_5":14782,"_28250":120017,"_3059":120265},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3603":72578,"_31069":72477,"_21510":120267,"_5":14782,"_28250":120017,"_3059":120268},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3603":72579,"_31069":72477,"_21510":120270,"_5":14782,"_28250":120017,"_3059":120271},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3603":72580,"_31069":72477,"_21510":120273,"_5":14782,"_28250":120017,"_3059":120274},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3603":72581,"_31069":72477,"_21510":120276,"_5":14782,"_28250":120021,"_3059":51300},[],{"_3603":72582,"_31069":72477,"_21510":120278,"_5":14782,"_28250":120021,"_3059":120279},[],"valida las herramientas locales y el clúster seleccionado",{"_3603":72583,"_31069":72477,"_21510":120281,"_5":14782,"_28250":120021,"_3059":120282},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3603":72584,"_31069":72477,"_21510":120284,"_5":14782,"_28250":120021,"_3059":120285},[],"crea el namespace",{"_3603":72585,"_31069":72477,"_21510":120287,"_5":14782,"_28250":120021,"_3059":120288},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3603":72586,"_31069":72477,"_21510":120290,"_5":14782,"_28250":120021,"_3059":120291},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3603":72587,"_31069":72477,"_21510":120293,"_5":14782,"_28250":120021,"_3059":120294},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3603":72588,"_31069":72477,"_21510":120296,"_5":14782,"_28250":120021,"_3059":120297},[],"instala RabbitMQ",{"_3603":72589,"_31069":72477,"_21510":120299,"_5":14782,"_28250":120021,"_3059":120300},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3603":72590,"_31069":72477,"_21510":120302,"_5":14782,"_28250":120021,"_3059":120303},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3603":72591,"_31069":72477,"_21510":120305,"_5":14782,"_28250":120021,"_3059":120306},[],"carga datos de ejemplo opcionalmente",{"_3603":72592,"_31069":72477,"_21510":120308,"_5":14782,"_28250":120021,"_3059":120309},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3603":72593,"_31069":72477,"_21510":120311,"_5":14782,"_28250":120025,"_3059":120312},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3603":72594,"_31069":72477,"_21510":120314,"_5":14782,"_28250":120025,"_3059":120315},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3603":72595,"_31069":72477,"_21510":120317,"_5":14782,"_28250":120029,"_3059":120318},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3603":72596,"_31069":72477,"_21510":120320,"_5":14782,"_28250":120029,"_3059":120321},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3603":72597,"_31069":72477,"_21510":120323,"_5":14782,"_28250":120029,"_3059":120324},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3603":72598,"_31069":72477,"_21510":120326,"_5":14782,"_28250":120029,"_3059":120327},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3603":72599,"_31069":72477,"_21510":120329,"_5":14782,"_28250":120033,"_3059":120330},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3603":72600,"_31069":72600,"_5":15147,"_3059":120332,"_31428":120333,"_21510":120334,"_28250":72600},"Instala con Helm",[50742,119752,119986],[],{"_3603":72601,"_31069":72600,"_21510":120336,"_5":14782,"_28250":72600,"_3059":120337},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3603":72602,"_31069":72600,"_5":31425,"_21510":120339,"_28250":120340,"_3059":120341},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3603":72603,"_31069":72600,"_5":31425,"_21510":120343,"_28250":120344,"_3059":120002},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3603":72604,"_31069":72600,"_5":31425,"_21510":120346,"_28250":120347,"_3059":120348},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3603":72605,"_31069":72600,"_5":31425,"_21510":120350,"_28250":120351,"_3059":120352},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3603":72606,"_31069":72600,"_5":31425,"_21510":120354,"_28250":120355,"_3059":120356},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3603":72607,"_31069":72600,"_5":31425,"_21510":120358,"_28250":120359,"_3059":120360},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3603":72608,"_31069":72600,"_5":31425,"_21510":120362,"_28250":120363,"_3059":120364},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3603":72609,"_31069":72600,"_5":31425,"_21510":120366,"_28250":120367,"_3059":120368},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3603":72610,"_31069":72600,"_5":31425,"_21510":120370,"_28250":120371,"_3059":120372},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3603":72611,"_31069":72600,"_5":31425,"_21510":120374,"_28250":120375,"_3059":120376},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3603":72612,"_31069":72600,"_5":31425,"_21510":120378,"_28250":120379,"_3059":120380},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3603":72613,"_31069":72600,"_5":31425,"_21510":120382,"_28250":120383,"_3059":120384},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3603":72614,"_31069":72600,"_21510":120386,"_5":14782,"_28250":120340,"_3059":120387},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3603":72615,"_31069":72600,"_21510":120389,"_5":14782,"_28250":120344,"_3059":120390},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3603":72616,"_31069":72600,"_21510":120392,"_5":14782,"_28250":120344,"_3059":120393},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3603":72617,"_31069":72600,"_21510":120395,"_5":14782,"_28250":120344,"_3059":120396},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3603":72618,"_31069":72600,"_21510":120398,"_5":14782,"_28250":120344,"_3059":120399},[],"un broker RabbitMQ accesible y sus credenciales",{"_3603":72619,"_31069":72600,"_21510":120401,"_5":14782,"_28250":120344,"_3059":120402},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3603":72620,"_31069":72600,"_21510":120404,"_5":14782,"_28250":120344,"_3059":120405},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3603":72621,"_31069":72600,"_21510":120407,"_5":14782,"_28250":120344,"_3059":120408},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3603":72622,"_31069":72600,"_21510":120410,"_5":14782,"_28250":120344,"_3059":120411},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3603":72623,"_31069":72600,"_21510":120413,"_5":14782,"_28250":120344,"_3059":120414},[],"una StorageClass y un diseño de tráfico externo",{"_3603":72624,"_31069":72600,"_21510":120416,"_5":14782,"_28250":120344,"_3059":120417},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3603":72625,"_31069":72600,"_21510":120419,"_5":14782,"_28250":120344,"_3059":120420},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3603":72626,"_31069":72600,"_21510":120422,"_5":14782,"_28250":120344,"_3059":120423},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3603":72627,"_31069":72600,"_21510":120425,"_5":14782,"_28250":120347,"_3059":120426},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3603":72628,"_31069":72600,"_21510":120428,"_5":14782,"_28250":120347,"_3059":120429},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3603":72629,"_31069":72600,"_21510":120431,"_5":14782,"_28250":120347,"_3059":120432},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3603":72630,"_31069":72600,"_21510":120434,"_5":14782,"_28250":120351,"_3059":120435},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3603":72631,"_31069":72600,"_21510":120437,"_5":14782,"_28250":120351,"_3059":120438},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3603":72632,"_31069":72600,"_21510":120440,"_5":14782,"_28250":120351,"_3059":120441},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3603":72633,"_31069":72600,"_21510":120443,"_5":14782,"_28250":120351,"_3059":120444},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3603":72634,"_31069":72600,"_21510":120446,"_5":14782,"_28250":120355,"_3059":120447},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3603":72635,"_31069":72600,"_21510":120449,"_5":14782,"_28250":120355,"_3059":120450},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3603":72636,"_31069":72600,"_21510":120452,"_5":14782,"_28250":120355,"_3059":120453},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3603":72637,"_31069":72600,"_21510":120455,"_5":14782,"_28250":120355,"_3059":120456},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3603":72638,"_31069":72600,"_21510":120458,"_5":14782,"_28250":120355,"_3059":120459},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3603":72639,"_31069":72600,"_21510":120461,"_5":14782,"_28250":120355,"_3059":120462},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3603":72640,"_31069":72600,"_21510":120464,"_5":14782,"_28250":120355,"_3059":120465},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3603":72641,"_31069":72600,"_21510":120467,"_5":14782,"_28250":120355,"_3059":120468},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3603":72642,"_31069":72600,"_21510":120470,"_5":14782,"_28250":120359,"_3059":120471},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3603":72643,"_31069":72600,"_21510":120473,"_5":14782,"_28250":120363,"_3059":120474},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3603":72644,"_31069":72600,"_21510":120476,"_5":14782,"_28250":120363,"_3059":120477},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3603":72645,"_31069":72600,"_21510":120479,"_5":14782,"_28250":120363,"_3059":120480},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3603":72646,"_31069":72600,"_21510":120482,"_5":14782,"_28250":120363,"_3059":120483},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3603":72647,"_31069":72600,"_21510":120485,"_5":14782,"_28250":120363,"_3059":120486},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3603":72648,"_31069":72600,"_21510":120488,"_5":14782,"_28250":120363,"_3059":120489},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3603":72649,"_31069":72600,"_21510":120491,"_5":14782,"_28250":120363,"_3059":120492},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3603":72650,"_31069":72600,"_21510":120494,"_5":14782,"_28250":120367,"_3059":120495},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3603":72651,"_31069":72600,"_21510":120497,"_5":14782,"_28250":120367,"_3059":120498},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3603":72652,"_31069":72600,"_21510":120500,"_5":14782,"_28250":120367,"_3059":120501},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3603":72653,"_31069":72600,"_21510":120503,"_5":14782,"_28250":120367,"_3059":120504},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3603":72654,"_31069":72600,"_21510":120506,"_5":14782,"_28250":120371,"_3059":120507},[],"Para instalar un checkout local:",{"_3603":72655,"_31069":72600,"_21510":120509,"_5":14782,"_28250":120375,"_3059":120510},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3603":72656,"_31069":72600,"_21510":120512,"_5":14782,"_28250":120375,"_3059":120513},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3603":72657,"_31069":72600,"_21510":120515,"_5":14782,"_28250":120379,"_3059":120516},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3603":72658,"_31069":72600,"_21510":120518,"_5":14782,"_28250":120379,"_3059":120519},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3603":72659,"_31069":72600,"_21510":120521,"_5":14782,"_28250":120379,"_3059":120522},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3603":72660,"_31069":72600,"_21510":120524,"_5":14782,"_28250":120379,"_3059":120525},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3603":72661,"_31069":72600,"_21510":120527,"_5":14782,"_28250":120379,"_3059":120528},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3603":72662,"_31069":72600,"_21510":120530,"_5":14782,"_28250":120383,"_3059":120531},[],"Antes de pasar a producción, revisa:",{"_3603":72663,"_31069":72600,"_21510":120533,"_5":14782,"_28250":120383,"_3059":120534},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3603":72664,"_31069":72600,"_21510":120536,"_5":14782,"_28250":120383,"_3059":120537},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3603":72665,"_31069":72600,"_21510":120539,"_5":14782,"_28250":120383,"_3059":120540},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3603":72666,"_31069":72600,"_21510":120542,"_5":14782,"_28250":120383,"_3059":120543},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3603":72667,"_31069":72600,"_21510":120545,"_5":14782,"_28250":120383,"_3059":120546},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3603":72668,"_31069":72600,"_21510":120548,"_5":14782,"_28250":120383,"_3059":120549},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3603":72669,"_31069":72600,"_21510":120551,"_5":14782,"_28250":120383,"_3059":120552},[],"SMTP, observabilidad y entrega de alertas",{"_3603":72670,"_31069":72600,"_21510":120554,"_5":14782,"_28250":120383,"_3059":120555},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3603":72671,"_31069":72600,"_21510":120557,"_5":14782,"_28250":120383,"_3059":120558},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3603":72672,"_31069":72672,"_5":15147,"_3059":120560,"_31428":120561,"_21510":120562,"_28250":72672},"Expón el Gateway",[50742,119752,119986],[],{"_3603":72673,"_31069":72672,"_21510":120564,"_5":14782,"_28250":72672,"_3059":120565},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3603":72674,"_31069":72672,"_5":31425,"_21510":120567,"_28250":120568,"_3059":120569},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3603":72675,"_31069":72672,"_5":31425,"_21510":120571,"_28250":120572,"_3059":120573},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3603":72676,"_31069":72672,"_5":31425,"_21510":120575,"_28250":120576,"_3059":120577},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3603":72677,"_31069":72672,"_5":31425,"_21510":120579,"_28250":120580,"_3059":51605},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/networking#k3s",{"_3603":72678,"_31069":72672,"_5":31425,"_21510":120582,"_28250":120583,"_3059":120584},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3603":72679,"_31069":72672,"_5":31425,"_21510":120586,"_28250":120587,"_3059":120588},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3603":72680,"_31069":72672,"_5":31425,"_21510":120590,"_28250":120591,"_3059":120592},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3603":72681,"_31069":72672,"_5":31425,"_21510":120594,"_28250":120595,"_3059":120596},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3603":72682,"_31069":72672,"_5":31425,"_21510":120598,"_28250":120599,"_3059":120600},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3603":72683,"_31069":72672,"_5":31425,"_21510":120602,"_28250":120603,"_3059":120604},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3603":72684,"_31069":72672,"_5":31425,"_21510":120606,"_28250":120607,"_3059":120608},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3603":72685,"_31069":72672,"_21510":120610,"_5":14782,"_28250":120568,"_3059":120611},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3603":72686,"_31069":72672,"_21510":120613,"_5":14782,"_28250":120568,"_3059":120614},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3603":72687,"_31069":72672,"_21510":120616,"_5":14782,"_28250":120572,"_3059":120617},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3603":72688,"_31069":72672,"_21510":120619,"_5":14782,"_28250":120572,"_3059":120620},[],"Defínelo únicamente cuando:",{"_3603":72689,"_31069":72672,"_21510":120622,"_5":14782,"_28250":120572,"_3059":120623},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3603":72690,"_31069":72672,"_21510":120625,"_5":14782,"_28250":120572,"_3059":120626},[],"esa dirección está asignada a este Gateway",{"_3603":72691,"_31069":72672,"_21510":120628,"_5":14782,"_28250":120572,"_3059":120629},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3603":72692,"_31069":72672,"_21510":120631,"_5":14782,"_28250":120572,"_3059":120632},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3603":72693,"_31069":72672,"_21510":120634,"_5":14782,"_28250":120572,"_3059":120635},[],"No confundas estos valores:",{"_3603":72694,"_31069":72672,"_21510":120637,"_5":14782,"_28250":120572,"_3059":120638},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3603":72695,"_31069":72672,"_21510":120640,"_5":14782,"_28250":120572,"_3059":120641},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3603":72696,"_31069":72672,"_21510":120643,"_5":14782,"_28250":120572,"_3059":120644},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3603":72697,"_31069":72672,"_21510":120646,"_5":14782,"_28250":120576,"_3059":120647},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3603":72698,"_31069":72672,"_21510":120649,"_5":14782,"_28250":120576,"_3059":120650},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3603":72699,"_31069":72672,"_21510":120652,"_5":14782,"_28250":120580,"_3059":120653},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3603":72700,"_31069":72672,"_21510":120655,"_5":14782,"_28250":120580,"_3059":120656},[],"Para el diseño recomendado:",{"_3603":72701,"_31069":72672,"_21510":120658,"_5":14782,"_28250":120580,"_3059":120659},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3603":72702,"_31069":72672,"_21510":120661,"_5":14782,"_28250":120580,"_3059":120662},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3603":72703,"_31069":72672,"_21510":120664,"_5":14782,"_28250":120580,"_3059":120665},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3603":72704,"_31069":72672,"_21510":120667,"_5":14782,"_28250":120580,"_3059":120668},[],"Apunta DNS a la dirección accesible de la VM.",{"_3603":72705,"_31069":72672,"_21510":120670,"_5":14782,"_28250":120580,"_3059":120671},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3603":72706,"_31069":72672,"_21510":120673,"_5":14782,"_28250":120583,"_3059":120674},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3603":72707,"_31069":72672,"_21510":120676,"_5":14782,"_28250":120587,"_3059":120677},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3603":72708,"_31069":72672,"_21510":120679,"_5":14782,"_28250":120587,"_3059":120680},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3603":72709,"_31069":72672,"_21510":120682,"_5":14782,"_28250":120591,"_3059":120683},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3603":72710,"_31069":72672,"_21510":120685,"_5":14782,"_28250":120591,"_3059":120686},[],"Requisito",{"_3603":72711,"_31069":72672,"_21510":120688,"_5":14782,"_28250":120591,"_3059":120689},[],"Diseño recomendado",{"_3603":72712,"_31069":72672,"_21510":120691,"_5":14782,"_28250":120591,"_3059":120692},[],"Consecuencia",{"_3603":72713,"_31069":72672,"_21510":120694,"_5":14782,"_28250":120591,"_3059":120695},[],"Varias URL o servicios de Lamassu",{"_3603":72714,"_31069":72672,"_21510":120697,"_5":14782,"_28250":120591,"_3059":120698},[],"Un Gateway con varias rutas",{"_3603":72715,"_31069":72672,"_21510":120700,"_5":14782,"_28250":120591,"_3059":120701},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3603":72716,"_31069":72672,"_21510":120703,"_5":14782,"_28250":120591,"_3059":120704},[],"Gateways independientes e IP externas distintas",{"_3603":72717,"_31069":72672,"_21510":120706,"_5":14782,"_28250":120591,"_3059":120707},[],"Una VIP por Gateway",{"_3603":72718,"_31069":72672,"_21510":120709,"_5":14782,"_28250":120591,"_3059":120710},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3603":72719,"_31069":72672,"_21510":120712,"_5":14782,"_28250":120591,"_3059":120713},[],"Gateways independientes, un nodo y una IP",{"_3603":72720,"_31069":72672,"_21510":120715,"_5":14782,"_28250":120591,"_3059":120716},[],"Puertos externos diferentes",{"_3603":72721,"_31069":72672,"_21510":120718,"_5":14782,"_28250":120591,"_3059":120719},[],"Los clientes deben indicar puertos no estándar",{"_3603":72722,"_31069":72672,"_21510":120721,"_5":14782,"_28250":120591,"_3059":120722},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3603":72723,"_31069":72672,"_21510":120724,"_5":14782,"_28250":120591,"_3059":120725},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3603":72724,"_31069":72672,"_21510":120727,"_5":14782,"_28250":120591,"_3059":120728},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3603":72725,"_31069":72672,"_21510":120730,"_5":14782,"_28250":120591,"_3059":120731},[],"Recursos Gateway separados pero proxy compartido",{"_3603":72726,"_31069":72672,"_21510":120733,"_5":14782,"_28250":120591,"_3059":120734},[],"Modo merged Gateway de Envoy",{"_3603":72727,"_31069":72672,"_21510":120736,"_5":14782,"_28250":120591,"_3059":120737},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3603":72728,"_31069":72672,"_21510":120739,"_5":14782,"_28250":120591,"_3059":120740},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3603":72729,"_31069":72672,"_21510":120742,"_5":14782,"_28250":120591,"_3059":120743},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3603":72730,"_31069":72672,"_21510":120745,"_5":14782,"_28250":120591,"_3059":120746},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3603":72731,"_31069":72672,"_21510":120748,"_5":14782,"_28250":120591,"_3059":120749},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3603":72732,"_31069":72672,"_21510":120751,"_5":14782,"_28250":120595,"_3059":120752},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3603":72733,"_31069":72672,"_21510":120754,"_5":14782,"_28250":120599,"_3059":120755},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3603":72734,"_31069":72672,"_21510":120757,"_5":14782,"_28250":120599,"_3059":120758},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3603":72735,"_31069":72672,"_21510":120760,"_5":14782,"_28250":120599,"_3059":120761},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3603":72736,"_31069":72672,"_21510":120763,"_5":14782,"_28250":120599,"_3059":120764},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3603":72737,"_31069":72672,"_21510":120766,"_5":14782,"_28250":120599,"_3059":120767},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3603":72738,"_31069":72672,"_21510":120769,"_5":14782,"_28250":120603,"_3059":120770},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3603":72739,"_31069":72672,"_21510":120772,"_5":14782,"_28250":120603,"_3059":120773},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3603":72740,"_31069":72672,"_21510":120775,"_5":14782,"_28250":120607,"_3059":120776},[],"Comprueba, en orden:",{"_3603":72741,"_31069":72672,"_21510":120778,"_5":14782,"_28250":120607,"_3059":120779},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3603":72742,"_31069":72672,"_21510":120781,"_5":14782,"_28250":120607,"_3059":120782},[],"Su estado contiene la dirección esperada.",{"_3603":72743,"_31069":72672,"_21510":120784,"_5":14782,"_28250":120607,"_3059":120785},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3603":72744,"_31069":72672,"_21510":120787,"_5":14782,"_28250":120607,"_3059":120788},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3603":72745,"_31069":72672,"_21510":120790,"_5":14782,"_28250":120607,"_3059":120791},[],"DNS resuelve al endpoint accesible externamente.",{"_3603":72746,"_31069":72672,"_21510":120793,"_5":14782,"_28250":120607,"_3059":120794},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3603":72747,"_31069":72672,"_21510":120796,"_5":14782,"_28250":120607,"_3059":120797},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3603":72748,"_31069":72748,"_5":15147,"_3059":50849,"_31428":120799,"_21510":120800,"_28250":72748},[50742,119752,119986],[],{"_3603":72749,"_31069":72748,"_21510":120802,"_5":14782,"_28250":72748,"_3059":120803},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3603":72750,"_31069":72748,"_5":31425,"_21510":120805,"_28250":120806,"_3059":120807},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3603":72751,"_31069":72748,"_5":31425,"_21510":120809,"_28250":120810,"_3059":120811},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3603":72752,"_31069":72748,"_5":31425,"_21510":120813,"_28250":120814,"_3059":120815},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3603":72753,"_31069":72748,"_5":31425,"_21510":120817,"_28250":120818,"_3059":120819},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3603":72754,"_31069":72748,"_5":31425,"_21510":120821,"_28250":120822,"_3059":120823},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3603":72755,"_31069":72748,"_5":31425,"_21510":120825,"_28250":120826,"_3059":120827},[],"/docs/pr-preview/pr-74/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3603":72756,"_31069":72748,"_21510":120829,"_5":14782,"_28250":120806,"_3059":120830},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3603":72757,"_31069":72748,"_21510":120832,"_5":14782,"_28250":120810,"_3059":120833},[],"Flujo",{"_3603":72758,"_31069":72748,"_21510":120835,"_5":14782,"_28250":120810,"_3059":120836},[],"Úsalo para",{"_3603":72759,"_31069":72748,"_21510":120838,"_5":14782,"_28250":120810,"_3059":120839},[],"Qué instala",{"_3603":72760,"_31069":72748,"_21510":120841,"_5":14782,"_28250":120810,"_3059":51867},[],{"_3603":72761,"_31069":72748,"_21510":120843,"_5":14782,"_28250":120810,"_3059":120844},[],"Producción y entornos controlados",{"_3603":72762,"_31069":72748,"_21510":120846,"_5":14782,"_28250":120810,"_3059":120847},[],"Servicios de Lamassu y recursos de Gateway API",{"_3603":72763,"_31069":72748,"_21510":120849,"_5":14782,"_28250":120810,"_3059":50986},[],{"_3603":72764,"_31069":72748,"_21510":120851,"_5":14782,"_28250":120810,"_3059":120852},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3603":72765,"_31069":72748,"_21510":120854,"_5":14782,"_28250":120810,"_3059":120855},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3603":72766,"_31069":72748,"_21510":120857,"_5":14782,"_28250":120814,"_3059":120858},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3603":72767,"_31069":72748,"_21510":120860,"_5":14782,"_28250":120814,"_3059":120861},[],"Área",{"_3603":72768,"_31069":72748,"_21510":120863,"_5":14782,"_28250":120814,"_3059":120864},[],"El chart de Lamassu proporciona",{"_3603":72769,"_31069":72748,"_21510":120866,"_5":14782,"_28250":120814,"_3059":120867},[],"Tú proporcionas",{"_3603":72770,"_31069":72748,"_21510":120869,"_5":14782,"_28250":120814,"_3059":120870},[],"Aplicaciones Lamassu",{"_3603":72771,"_31069":72748,"_21510":120872,"_5":14782,"_28250":120814,"_3059":120873},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3603":72772,"_31069":72748,"_21510":120875,"_5":14782,"_28250":120814,"_3059":120876},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3603":72773,"_31069":72748,"_21510":120878,"_5":14782,"_28250":120814,"_3059":120879},[],"Datos PostgreSQL",{"_3603":72774,"_31069":72748,"_21510":120881,"_5":14782,"_28250":120814,"_3059":120882},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3603":72775,"_31069":72748,"_21510":120884,"_5":14782,"_28250":120814,"_3059":120885},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3603":72776,"_31069":72748,"_21510":120887,"_5":14782,"_28250":120814,"_3059":120888},[],"Mensajería",{"_3603":72777,"_31069":72748,"_21510":120890,"_5":14782,"_28250":120814,"_3059":120891},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3603":72778,"_31069":72748,"_21510":120893,"_5":14782,"_28250":120814,"_3059":120894},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3603":72779,"_31069":72748,"_21510":120896,"_5":14782,"_28250":120814,"_3059":120897},[],"Identidad",{"_3603":72780,"_31069":72748,"_21510":120899,"_5":14782,"_28250":120814,"_3059":120900},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3603":72781,"_31069":72748,"_21510":120902,"_5":14782,"_28250":120814,"_3059":120903},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3603":72782,"_31069":72748,"_21510":120905,"_5":14782,"_28250":120814,"_3059":120906},[],"Enrutamiento externo",{"_3603":72783,"_31069":72748,"_21510":120908,"_5":14782,"_28250":120814,"_3059":120909},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3603":72784,"_31069":72748,"_21510":120911,"_5":14782,"_28250":120814,"_3059":120912},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3603":72785,"_31069":72748,"_21510":120914,"_5":14782,"_28250":120814,"_3059":51941},[],{"_3603":72786,"_31069":72748,"_21510":120916,"_5":14782,"_28250":120814,"_3059":120917},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3603":72787,"_31069":72748,"_21510":120919,"_5":14782,"_28250":120814,"_3059":120920},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3603":72788,"_31069":72748,"_21510":120922,"_5":14782,"_28250":120814,"_3059":120923},[],"Datos persistentes de la aplicación",{"_3603":72789,"_31069":72748,"_21510":120925,"_5":14782,"_28250":120814,"_3059":120926},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3603":72790,"_31069":72748,"_21510":120928,"_5":14782,"_28250":120814,"_3059":120929},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3603":72791,"_31069":72748,"_21510":120931,"_5":14782,"_28250":120814,"_3059":120932},[],"Integraciones opcionales",{"_3603":72792,"_31069":72748,"_21510":120934,"_5":14782,"_28250":120814,"_3059":120935},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3603":72793,"_31069":72748,"_21510":120937,"_5":14782,"_28250":120814,"_3059":120938},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3603":72794,"_31069":72748,"_21510":120940,"_5":14782,"_28250":120814,"_3059":120941},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3603":72795,"_31069":72748,"_21510":120943,"_5":14782,"_28250":120814,"_3059":120944},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3603":72796,"_31069":72748,"_21510":120946,"_5":14782,"_28250":120818,"_3059":120947},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3603":72797,"_31069":72748,"_21510":120949,"_5":14782,"_28250":120818,"_3059":120950},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3603":72798,"_31069":72748,"_21510":120952,"_5":14782,"_28250":120822,"_3059":120953},[],"Kubernetes 1.24 o posterior",{"_3603":72799,"_31069":72748,"_21510":120955,"_5":14782,"_28250":120822,"_3059":120956},[],"Helm 3.2 o posterior",{"_3603":72800,"_31069":72748,"_21510":120958,"_5":14782,"_28250":120822,"_3059":120959},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3603":72801,"_31069":72748,"_21510":120961,"_5":14782,"_28250":120822,"_3059":120962},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3603":72802,"_31069":72748,"_21510":120964,"_5":14782,"_28250":120822,"_3059":120965},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3603":72803,"_31069":72748,"_21510":120967,"_5":14782,"_28250":120822,"_3059":120968},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3603":72804,"_31069":72748,"_21510":120970,"_5":14782,"_28250":120822,"_3059":120971},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3603":72805,"_31069":72748,"_21510":120973,"_5":14782,"_28250":120826,"_3059":120974},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3603":72806,"_31069":72748,"_21510":120976,"_5":14782,"_28250":120826,"_3059":120977},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3603":72807,"_31069":72748,"_21510":120979,"_5":14782,"_28250":120826,"_3059":120980},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3603":72808,"_31069":72748,"_21510":120982,"_5":14782,"_28250":120826,"_3059":120983},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3603":72809,"_31069":72809,"_5":15147,"_3059":120985,"_31428":120986,"_21510":120988,"_28250":72809},"Resolución de problemas de despliegue",[50742,119752,120987],"Operación",[],{"_3603":72810,"_31069":72809,"_21510":120990,"_5":14782,"_28250":72809,"_3059":120991},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3603":72811,"_31069":72809,"_5":31425,"_21510":120993,"_28250":120994,"_3059":120995},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3603":72812,"_31069":72809,"_5":31425,"_21510":120997,"_28250":120998,"_3059":120999},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3603":72813,"_31069":72809,"_5":31425,"_21510":121001,"_28250":121002,"_3059":121003},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3603":72814,"_31069":72809,"_5":31425,"_21510":121005,"_28250":121006,"_3059":121007},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3603":72815,"_31069":72809,"_5":31425,"_21510":121009,"_28250":121010,"_3059":121011},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3603":72816,"_31069":72809,"_5":31425,"_21510":121013,"_28250":121014,"_3059":121015},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3603":72817,"_31069":72809,"_5":31425,"_21510":121017,"_28250":121018,"_3059":121019},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3603":72818,"_31069":72809,"_5":31425,"_21510":121021,"_28250":121022,"_3059":121023},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3603":72819,"_31069":72809,"_5":31425,"_21510":121025,"_28250":121026,"_3059":121027},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3603":72820,"_31069":72809,"_5":31425,"_21510":121029,"_28250":121030,"_3059":121031},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3603":72821,"_31069":72809,"_5":31425,"_21510":121033,"_28250":121034,"_3059":121035},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3603":72822,"_31069":72809,"_5":31425,"_21510":121037,"_28250":121038,"_3059":121039},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3603":72823,"_31069":72809,"_5":31425,"_21510":121041,"_28250":121042,"_3059":121043},[],"/docs/pr-preview/pr-74/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3603":72824,"_31069":72809,"_21510":121045,"_5":14782,"_28250":72809,"_3059":121046},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3603":72825,"_31069":72809,"_21510":121048,"_5":14782,"_28250":120998,"_3059":121049},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3603":72826,"_31069":72809,"_21510":121051,"_5":14782,"_28250":121002,"_3059":121052},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3603":72827,"_31069":72809,"_21510":121054,"_5":14782,"_28250":121006,"_3059":121055},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3603":72828,"_31069":72809,"_21510":121057,"_5":14782,"_28250":121010,"_3059":121058},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3603":72829,"_31069":72809,"_21510":121060,"_5":14782,"_28250":121014,"_3059":121061},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3603":72830,"_31069":72809,"_21510":121063,"_5":14782,"_28250":121018,"_3059":121064},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3603":72831,"_31069":72809,"_21510":121066,"_5":14782,"_28250":121018,"_3059":121067},[],"Ejecuta también la prueba de conectividad del chart:",{"_3603":72832,"_31069":72809,"_21510":121069,"_5":14782,"_28250":121018,"_3059":121070},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3603":72833,"_31069":72809,"_21510":121072,"_5":14782,"_28250":121018,"_3059":121073},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3603":72834,"_31069":72809,"_21510":121075,"_5":14782,"_28250":121022,"_3059":121076},[],"Si recibes un 401:",{"_3603":72835,"_31069":72809,"_21510":121078,"_5":14782,"_28250":121022,"_3059":121079},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3603":72836,"_31069":72809,"_21510":121081,"_5":14782,"_28250":121022,"_3059":121082},[],"verifica emisor, audiencia y expiración del token;",{"_3603":72837,"_31069":72809,"_21510":121084,"_5":14782,"_28250":121022,"_3059":121085},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3603":72838,"_31069":72809,"_21510":121087,"_5":14782,"_28250":121022,"_3059":121088},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3603":72839,"_31069":72809,"_21510":121090,"_5":14782,"_28250":121022,"_3059":121091},[],"Si el login termina pero las APIs devuelven 403:",{"_3603":72840,"_31069":72809,"_21510":121093,"_5":14782,"_28250":121022,"_3059":121094},[],"inspecciona los claims reales del token;",{"_3603":72841,"_31069":72809,"_21510":121096,"_5":14782,"_28250":121022,"_3059":121097},[],"confirma que coinciden con un principal activo;",{"_3603":72842,"_31069":72809,"_21510":121099,"_5":14782,"_28250":121022,"_3059":121100},[],"revisa las políticas concedidas al principal;",{"_3603":72843,"_31069":72809,"_21510":121102,"_5":14782,"_28250":121022,"_3059":121103},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3603":72844,"_31069":72809,"_21510":121105,"_5":14782,"_28250":121022,"_3059":121106},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3603":72845,"_31069":72809,"_21510":121108,"_5":14782,"_28250":121026,"_3059":121109},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3603":72846,"_31069":72809,"_21510":121111,"_5":14782,"_28250":121026,"_3059":121112},[],"Localiza el pod y Service de authz.",{"_3603":72847,"_31069":72809,"_21510":121114,"_5":14782,"_28250":121026,"_3059":121115},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3603":72848,"_31069":72809,"_21510":121117,"_5":14782,"_28250":121026,"_3059":121118},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3603":72849,"_31069":72809,"_21510":121120,"_5":14782,"_28250":121026,"_3059":121121},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3603":72850,"_31069":72809,"_21510":121123,"_5":14782,"_28250":121026,"_3059":121124},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3603":72851,"_31069":72809,"_21510":121126,"_5":14782,"_28250":121030,"_3059":121127},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3603":72852,"_31069":72809,"_21510":121129,"_5":14782,"_28250":121034,"_3059":121130},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3603":72853,"_31069":72809,"_21510":121132,"_5":14782,"_28250":121034,"_3059":121133},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3603":72854,"_31069":72809,"_21510":121135,"_5":14782,"_28250":121034,"_3059":121136},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3603":72855,"_31069":72809,"_21510":121138,"_5":14782,"_28250":121034,"_3059":121139},[],"volumen persistente sin enlazar;",{"_3603":72856,"_31069":72809,"_21510":121141,"_5":14782,"_28250":121034,"_3059":121142},[],"imagen inaccesible o política de pull incorrecta;",{"_3603":72857,"_31069":72809,"_21510":121144,"_5":14782,"_28250":121034,"_3059":121145},[],"configuración inválida del motor criptográfico;",{"_3603":72858,"_31069":72809,"_21510":121147,"_5":14782,"_28250":121034,"_3059":121148},[],"límites de CPU o memoria demasiado bajos;",{"_3603":72859,"_31069":72809,"_21510":121150,"_5":14782,"_28250":121034,"_3059":121151},[],"migración previa incompleta.",{"_3603":72860,"_31069":72809,"_21510":121153,"_5":14782,"_28250":121034,"_3059":121154},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3603":72861,"_31069":72809,"_21510":121156,"_5":14782,"_28250":121034,"_3059":121157},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3603":72862,"_31069":72809,"_21510":121159,"_5":14782,"_28250":121034,"_3059":121160},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3603":72863,"_31069":72809,"_21510":121162,"_5":14782,"_28250":121038,"_3059":121163},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3603":72864,"_31069":72809,"_21510":121165,"_5":14782,"_28250":121038,"_3059":121166},[],"verifica que esté habilitado en el servicio emisor;",{"_3603":72865,"_31069":72809,"_21510":121168,"_5":14782,"_28250":121038,"_3059":121169},[],"comprueba conectividad y credenciales AMQP;",{"_3603":72866,"_31069":72809,"_21510":121171,"_5":14782,"_28250":121038,"_3059":121172},[],"revisa exchange, routing key, colas y consumidores;",{"_3603":72867,"_31069":72809,"_21510":121174,"_5":14782,"_28250":121038,"_3059":121175},[],"inspecciona dead-letter queues;",{"_3603":72868,"_31069":72809,"_21510":121177,"_5":14782,"_28250":121038,"_3059":121178},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3603":72869,"_31069":72809,"_21510":121180,"_5":14782,"_28250":121038,"_3059":121181},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3603":72870,"_31069":72809,"_21510":121183,"_5":14782,"_28250":121038,"_3059":121184},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3603":72871,"_31069":72809,"_21510":121186,"_5":14782,"_28250":121038,"_3059":121187},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3603":72872,"_31069":72809,"_21510":121189,"_5":14782,"_28250":121038,"_3059":121190},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3603":72873,"_31069":72809,"_21510":121192,"_5":14782,"_28250":121038,"_3059":121193},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3603":72874,"_31069":72809,"_21510":121195,"_5":14782,"_28250":121038,"_3059":121196},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3603":72875,"_31069":72809,"_21510":121198,"_5":14782,"_28250":121038,"_3059":121199},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3603":72876,"_31069":72809,"_21510":121201,"_5":14782,"_28250":121042,"_3059":121202},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3603":72877,"_31069":72809,"_21510":121204,"_5":14782,"_28250":121042,"_3059":121205},[],"Antes de cerrar una incidencia, guarda:",{"_3603":72878,"_31069":72809,"_21510":121207,"_5":14782,"_28250":121042,"_3059":121208},[],"causa confirmada;",{"_3603":72879,"_31069":72809,"_21510":121210,"_5":14782,"_28250":121042,"_3059":121211},[],"alcance temporal y recursos afectados;",{"_3603":72880,"_31069":72809,"_21510":121213,"_5":14782,"_28250":121042,"_3059":121214},[],"comandos o consultas utilizados;",{"_3603":72881,"_31069":72809,"_21510":121216,"_5":14782,"_28250":121042,"_3059":121217},[],"cambio aplicado y forma de revertirlo;",{"_3603":72882,"_31069":72809,"_21510":121219,"_5":14782,"_28250":121042,"_3059":121220},[],"validación desde un consumidor;",{"_3603":72883,"_31069":72809,"_21510":121222,"_5":14782,"_28250":121042,"_3059":121223},[],"acción preventiva y propietario.",{"_3603":72884,"_31069":72884,"_5":15147,"_3059":121225,"_31428":121226,"_21510":121230,"_28250":72884},"Modelo de datos",[50742,121227,121228,121229],"Plataforma","Administración","Control de acceso",[],{"_3603":72885,"_31069":72884,"_21510":121232,"_5":14782,"_28250":72884,"_3059":121233},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3603":72886,"_31069":72884,"_5":31425,"_21510":121235,"_28250":121236,"_3059":121237},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3603":72887,"_31069":72884,"_5":31425,"_21510":121239,"_28250":121240,"_3059":121241},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3603":72888,"_31069":72884,"_21510":121243,"_5":14782,"_28250":72884,"_3059":121244},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3603":72889,"_31069":72884,"_21510":121246,"_5":14782,"_28250":121236,"_3059":121247},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3603":72890,"_31069":72884,"_21510":121249,"_5":14782,"_28250":121236,"_3059":121250},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3603":72891,"_31069":72884,"_21510":121252,"_5":14782,"_28250":121236,"_3059":121253},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3603":72892,"_31069":72884,"_21510":121255,"_5":14782,"_28250":121240,"_3059":121256},[],"Entidad (`schema_name.entity_type`)",{"_3603":72893,"_31069":72884,"_21510":121258,"_5":14782,"_28250":121240,"_3059":121259},[],"Tabla (`table_name`)",{"_3603":72894,"_31069":72884,"_21510":121261,"_5":14782,"_28250":121240,"_3059":121262},[],"Clave (`primary_key`)",{"_3603":72895,"_31069":72884,"_21510":121264,"_5":14782,"_28250":121240,"_3059":52292},[],{"_3603":72896,"_31069":72884,"_21510":121266,"_5":14782,"_28250":121240,"_3059":52295},[],{"_3603":72897,"_31069":72884,"_21510":121268,"_5":14782,"_28250":121240,"_3059":52298},[],{"_3603":72898,"_31069":72884,"_21510":121270,"_5":14782,"_28250":121240,"_3059":52301},[],{"_3603":72899,"_31069":72884,"_21510":121272,"_5":14782,"_28250":121240,"_3059":52304},[],{"_3603":72900,"_31069":72884,"_21510":121274,"_5":14782,"_28250":121240,"_3059":52307},[],{"_3603":72901,"_31069":72884,"_21510":121276,"_5":14782,"_28250":121240,"_3059":52310},[],{"_3603":72902,"_31069":72884,"_21510":121278,"_5":14782,"_28250":121240,"_3059":52313},[],{"_3603":72903,"_31069":72884,"_21510":121280,"_5":14782,"_28250":121240,"_3059":52307},[],{"_3603":72904,"_31069":72884,"_21510":121282,"_5":14782,"_28250":121240,"_3059":52318},[],{"_3603":72905,"_31069":72884,"_21510":121284,"_5":14782,"_28250":121240,"_3059":52321},[],{"_3603":72906,"_31069":72884,"_21510":121286,"_5":14782,"_28250":121240,"_3059":52324},[],{"_3603":72907,"_31069":72884,"_21510":121288,"_5":14782,"_28250":121240,"_3059":52327},[],{"_3603":72908,"_31069":72884,"_21510":121290,"_5":14782,"_28250":121240,"_3059":52330},[],{"_3603":72909,"_31069":72884,"_21510":121292,"_5":14782,"_28250":121240,"_3059":52307},[],{"_3603":72910,"_31069":72884,"_21510":121294,"_5":14782,"_28250":121240,"_3059":52335},[],{"_3603":72911,"_31069":72884,"_21510":121296,"_5":14782,"_28250":121240,"_3059":52338},[],{"_3603":72912,"_31069":72884,"_21510":121298,"_5":14782,"_28250":121240,"_3059":52307},[],{"_3603":72913,"_31069":72884,"_21510":121300,"_5":14782,"_28250":121240,"_3059":52343},[],{"_3603":72914,"_31069":72884,"_21510":121302,"_5":14782,"_28250":121240,"_3059":52346},[],{"_3603":72915,"_31069":72884,"_21510":121304,"_5":14782,"_28250":121240,"_3059":52307},[],{"_3603":72916,"_31069":72884,"_21510":121306,"_5":14782,"_28250":121240,"_3059":52351},[],{"_3603":72917,"_31069":72884,"_21510":121308,"_5":14782,"_28250":121240,"_3059":52354},[],{"_3603":72918,"_31069":72884,"_21510":121310,"_5":14782,"_28250":121240,"_3059":52307},[],{"_3603":72919,"_31069":72884,"_21510":121312,"_5":14782,"_28250":121240,"_3059":52359},[],{"_3603":72920,"_31069":72884,"_21510":121314,"_5":14782,"_28250":121240,"_3059":52362},[],{"_3603":72921,"_31069":72884,"_21510":121316,"_5":14782,"_28250":121240,"_3059":52365},[],{"_3603":72922,"_31069":72884,"_21510":121318,"_5":14782,"_28250":121240,"_3059":52368},[],{"_3603":72923,"_31069":72884,"_21510":121320,"_5":14782,"_28250":121240,"_3059":52371},[],{"_3603":72924,"_31069":72884,"_21510":121322,"_5":14782,"_28250":121240,"_3059":52374},[],{"_3603":72925,"_31069":72884,"_21510":121324,"_5":14782,"_28250":121240,"_3059":121325},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3603":72926,"_31069":72884,"_21510":121327,"_5":14782,"_28250":121240,"_3059":121328},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3603":72927,"_31069":72884,"_21510":121330,"_5":14782,"_28250":121240,"_3059":121331},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3603":72928,"_31069":72928,"_5":15147,"_3059":121333,"_31428":121334,"_21510":121335,"_28250":72928},"Visión general del control de acceso",[50742,121227,121228,121229],[],{"_3603":72929,"_31069":72928,"_21510":121337,"_5":14782,"_28250":72928,"_3059":121338},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3603":72930,"_31069":72928,"_5":31425,"_21510":121340,"_28250":121341,"_3059":121342},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3603":72931,"_31069":72928,"_5":31425,"_21510":121344,"_28250":121345,"_3059":121346},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3603":72932,"_31069":72928,"_5":31425,"_21510":121348,"_28250":121349,"_3059":121350},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3603":72933,"_31069":72928,"_5":31425,"_21510":121352,"_28250":121353,"_3059":121354},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3603":72934,"_31069":72928,"_5":31425,"_21510":121356,"_28250":121357,"_3059":121358},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3603":72935,"_31069":72928,"_5":31425,"_21510":121360,"_28250":121361,"_3059":121362},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3603":72936,"_31069":72928,"_5":31425,"_21510":121364,"_28250":121365,"_3059":121366},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3603":72937,"_31069":72928,"_5":31425,"_21510":121368,"_28250":121369,"_3059":121370},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3603":72938,"_31069":72928,"_5":31425,"_21510":121372,"_28250":121373,"_3059":121374},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3603":72939,"_31069":72928,"_5":31425,"_21510":121376,"_28250":121377,"_3059":121378},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3603":72940,"_31069":72928,"_5":31425,"_21510":121380,"_28250":121381,"_3059":121382},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3603":72941,"_31069":72928,"_5":31425,"_21510":121384,"_28250":121385,"_3059":121386},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3603":72942,"_31069":72928,"_5":31425,"_21510":121388,"_28250":121389,"_3059":121390},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3603":72943,"_31069":72928,"_5":31425,"_21510":121392,"_28250":121393,"_3059":121394},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3603":72944,"_31069":72928,"_5":31425,"_21510":121396,"_28250":121397,"_3059":121398},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3603":72945,"_31069":72928,"_5":31425,"_21510":121400,"_28250":121401,"_3059":120368},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3603":72946,"_31069":72928,"_5":31425,"_21510":121403,"_28250":121404,"_3059":121405},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3603":72947,"_31069":72928,"_5":31425,"_21510":121407,"_28250":121408,"_3059":121409},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3603":72948,"_31069":72928,"_5":31425,"_21510":121411,"_28250":121412,"_3059":121413},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3603":72949,"_31069":72928,"_5":31425,"_21510":121415,"_28250":121416,"_3059":121417},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3603":72950,"_31069":72928,"_5":31425,"_21510":121419,"_28250":121420,"_3059":121421},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3603":72951,"_31069":72928,"_5":31425,"_21510":121423,"_28250":121424,"_3059":121425},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3603":72952,"_31069":72928,"_5":31425,"_21510":121427,"_28250":121428,"_3059":121429},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3603":72953,"_31069":72928,"_5":31425,"_21510":121431,"_28250":121432,"_3059":121433},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3603":72954,"_31069":72928,"_5":31425,"_21510":121435,"_28250":121436,"_3059":121437},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3603":72955,"_31069":72928,"_5":31425,"_21510":121439,"_28250":121440,"_3059":121441},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3603":72956,"_31069":72928,"_5":31425,"_21510":121443,"_28250":121444,"_3059":121445},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3603":72957,"_31069":72928,"_5":31425,"_21510":121447,"_28250":121448,"_3059":121449},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3603":72958,"_31069":72928,"_5":31425,"_21510":121451,"_28250":121452,"_3059":121453},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3603":72959,"_31069":72928,"_5":31425,"_21510":121455,"_28250":121456,"_3059":121457},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3603":72960,"_31069":72928,"_5":31425,"_21510":121459,"_28250":121460,"_3059":121461},[],"/docs/pr-preview/pr-74/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3603":72961,"_31069":72928,"_21510":121463,"_5":14782,"_28250":72928,"_3059":121464},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3603":72962,"_31069":72928,"_21510":121466,"_5":14782,"_28250":72928,"_3059":121467},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3603":72963,"_31069":72928,"_21510":121469,"_5":14782,"_28250":72928,"_3059":121470},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3603":72964,"_31069":72928,"_21510":121472,"_5":14782,"_28250":121341,"_3059":121473},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3603":72965,"_31069":72928,"_21510":121475,"_5":14782,"_28250":121341,"_3059":121476},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3603":72966,"_31069":72928,"_21510":121478,"_5":14782,"_28250":121341,"_3059":121479},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3603":72967,"_31069":72928,"_21510":121481,"_5":14782,"_28250":121341,"_3059":121482},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3603":72968,"_31069":72928,"_21510":121484,"_5":14782,"_28250":121341,"_3059":121485},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3603":72969,"_31069":72928,"_21510":121487,"_5":14782,"_28250":121341,"_3059":121488},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3603":72970,"_31069":72928,"_21510":121490,"_5":14782,"_28250":121345,"_3059":121491},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3603":72971,"_31069":72928,"_21510":121493,"_5":14782,"_28250":121345,"_3059":121494},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3603":72972,"_31069":72928,"_21510":121496,"_5":14782,"_28250":121349,"_3059":121497},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3603":72973,"_31069":72928,"_21510":121499,"_5":14782,"_28250":121349,"_3059":121500},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3603":72974,"_31069":72928,"_21510":121502,"_5":14782,"_28250":121349,"_3059":121503},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3603":72975,"_31069":72928,"_21510":121505,"_5":14782,"_28250":121349,"_3059":121506},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3603":72976,"_31069":72928,"_21510":121508,"_5":14782,"_28250":121349,"_3059":121509},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3603":72977,"_31069":72928,"_21510":121511,"_5":14782,"_28250":121349,"_3059":121512},[],"Carga por separado las políticas concedidas a cada principal.",{"_3603":72978,"_31069":72928,"_21510":121514,"_5":14782,"_28250":121349,"_3059":121515},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3603":72979,"_31069":72928,"_21510":121517,"_5":14782,"_28250":121349,"_3059":121518},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3603":72980,"_31069":72928,"_21510":121520,"_5":14782,"_28250":121349,"_3059":121521},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3603":72981,"_31069":72928,"_21510":121523,"_5":14782,"_28250":121349,"_3059":121524},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3603":72982,"_31069":72928,"_21510":121526,"_5":14782,"_28250":121349,"_3059":121527},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3603":72983,"_31069":72928,"_21510":121529,"_5":14782,"_28250":121349,"_3059":121530},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3603":72984,"_31069":72928,"_21510":121532,"_5":14782,"_28250":121353,"_3059":121533},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3603":72985,"_31069":72928,"_21510":121535,"_5":14782,"_28250":121353,"_3059":121536},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3603":72986,"_31069":72928,"_21510":121538,"_5":14782,"_28250":121353,"_3059":121539},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3603":72987,"_31069":72928,"_21510":121541,"_5":14782,"_28250":121353,"_3059":121542},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3603":72988,"_31069":72928,"_21510":121544,"_5":14782,"_28250":121353,"_3059":121545},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3603":72989,"_31069":72928,"_21510":121547,"_5":14782,"_28250":121353,"_3059":121548},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3603":72990,"_31069":72928,"_21510":121550,"_5":14782,"_28250":121353,"_3059":121551},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3603":72991,"_31069":72928,"_21510":121553,"_5":14782,"_28250":121353,"_3059":121554},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3603":72992,"_31069":72928,"_21510":121556,"_5":14782,"_28250":121353,"_3059":121557},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3603":72993,"_31069":72928,"_21510":121559,"_5":14782,"_28250":121353,"_3059":121560},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3603":72994,"_31069":72928,"_21510":121562,"_5":14782,"_28250":121357,"_3059":121563},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3603":72995,"_31069":72928,"_21510":121565,"_5":14782,"_28250":121357,"_3059":121566},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3603":72996,"_31069":72928,"_21510":121568,"_5":14782,"_28250":121357,"_3059":121569},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3603":72997,"_31069":72928,"_21510":121571,"_5":14782,"_28250":121357,"_3059":121572},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3603":72998,"_31069":72928,"_21510":121574,"_5":14782,"_28250":121357,"_3059":121575},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3603":72999,"_31069":72928,"_21510":121577,"_5":14782,"_28250":121357,"_3059":121578},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3603":73000,"_31069":72928,"_21510":121580,"_5":14782,"_28250":121357,"_3059":121581},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3603":73001,"_31069":72928,"_21510":121583,"_5":14782,"_28250":121357,"_3059":121584},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3603":73002,"_31069":72928,"_21510":121586,"_5":14782,"_28250":121357,"_3059":121587},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3603":73003,"_31069":72928,"_21510":121589,"_5":14782,"_28250":121357,"_3059":121590},[],"Las acciones se dividen en dos grupos:",{"_3603":73004,"_31069":72928,"_21510":121592,"_5":14782,"_28250":121357,"_3059":121593},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3603":73005,"_31069":72928,"_21510":121595,"_5":14782,"_28250":121357,"_3059":121596},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3603":73006,"_31069":72928,"_21510":121598,"_5":14782,"_28250":121357,"_3059":121599},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3603":73007,"_31069":72928,"_21510":121601,"_5":14782,"_28250":121361,"_3059":121602},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3603":73008,"_31069":72928,"_21510":121604,"_5":14782,"_28250":121361,"_3059":121605},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3603":73009,"_31069":72928,"_21510":121607,"_5":14782,"_28250":121361,"_3059":121608},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3603":73010,"_31069":72928,"_21510":121610,"_5":14782,"_28250":121365,"_3059":121611},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3603":73011,"_31069":72928,"_21510":121613,"_5":14782,"_28250":121365,"_3059":121614},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3603":73012,"_31069":72928,"_21510":121616,"_5":14782,"_28250":121365,"_3059":121617},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3603":73013,"_31069":72928,"_21510":121619,"_5":14782,"_28250":121365,"_3059":121620},[],"Los operadores implementados son:",{"_3603":73014,"_31069":72928,"_21510":121622,"_5":14782,"_28250":121365,"_3059":121623},[],"`equals`, para igualdad exacta;",{"_3603":73015,"_31069":72928,"_21510":121625,"_5":14782,"_28250":121365,"_3059":121626},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3603":73016,"_31069":72928,"_21510":121628,"_5":14782,"_28250":121365,"_3059":121629},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3603":73017,"_31069":72928,"_21510":121631,"_5":14782,"_28250":121365,"_3059":121632},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3603":73018,"_31069":72928,"_21510":121634,"_5":14782,"_28250":121369,"_3059":121635},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3603":73019,"_31069":72928,"_21510":121637,"_5":14782,"_28250":121369,"_3059":121638},[],"Los modos disponibles son:",{"_3603":73020,"_31069":72928,"_21510":121640,"_5":14782,"_28250":121369,"_3059":121641},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3603":73021,"_31069":72928,"_21510":121643,"_5":14782,"_28250":121369,"_3059":121644},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3603":73022,"_31069":72928,"_21510":121646,"_5":14782,"_28250":121369,"_3059":121647},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3603":73023,"_31069":72928,"_21510":121649,"_5":14782,"_28250":121369,"_3059":121650},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3603":73024,"_31069":72928,"_21510":121652,"_5":14782,"_28250":121369,"_3059":121653},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3603":73025,"_31069":72928,"_21510":121655,"_5":14782,"_28250":121369,"_3059":121656},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3603":73026,"_31069":72928,"_21510":121658,"_5":14782,"_28250":121373,"_3059":121659},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3603":73027,"_31069":72928,"_21510":121661,"_5":14782,"_28250":121373,"_3059":121662},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3603":73028,"_31069":72928,"_21510":121664,"_5":14782,"_28250":121373,"_3059":121665},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3603":73029,"_31069":72928,"_21510":121667,"_5":14782,"_28250":121373,"_3059":121668},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3603":73030,"_31069":72928,"_21510":121670,"_5":14782,"_28250":121381,"_3059":121671},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3603":73031,"_31069":72928,"_21510":121673,"_5":14782,"_28250":121381,"_3059":121674},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3603":73032,"_31069":72928,"_21510":121676,"_5":14782,"_28250":121385,"_3059":121677},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3603":73033,"_31069":72928,"_21510":121679,"_5":14782,"_28250":121385,"_3059":121680},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3603":73034,"_31069":72928,"_21510":121682,"_5":14782,"_28250":121385,"_3059":121683},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3603":73035,"_31069":72928,"_21510":121685,"_5":14782,"_28250":121385,"_3059":121686},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3603":73036,"_31069":72928,"_21510":121688,"_5":14782,"_28250":121385,"_3059":121689},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3603":73037,"_31069":72928,"_21510":121691,"_5":14782,"_28250":121389,"_3059":121692},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3603":73038,"_31069":72928,"_21510":121694,"_5":14782,"_28250":121389,"_3059":121695},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3603":73039,"_31069":72928,"_21510":121697,"_5":14782,"_28250":121389,"_3059":121698},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3603":73040,"_31069":72928,"_21510":121700,"_5":14782,"_28250":121393,"_3059":121701},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3603":73041,"_31069":72928,"_21510":121703,"_5":14782,"_28250":121393,"_3059":121704},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3603":73042,"_31069":72928,"_21510":121706,"_5":14782,"_28250":121393,"_3059":121707},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3603":73043,"_31069":72928,"_21510":121709,"_5":14782,"_28250":121393,"_3059":121710},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3603":73044,"_31069":72928,"_21510":121712,"_5":14782,"_28250":121393,"_3059":121713},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3603":73045,"_31069":72928,"_21510":121715,"_5":14782,"_28250":121393,"_3059":121716},[],"Ten en cuenta que:",{"_3603":73046,"_31069":72928,"_21510":121718,"_5":14782,"_28250":121393,"_3059":121719},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3603":73047,"_31069":72928,"_21510":121721,"_5":14782,"_28250":121393,"_3059":121722},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3603":73048,"_31069":72928,"_21510":121724,"_5":14782,"_28250":121393,"_3059":121725},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3603":73049,"_31069":72928,"_21510":121727,"_5":14782,"_28250":121397,"_3059":121728},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3603":73050,"_31069":72928,"_21510":121730,"_5":14782,"_28250":121397,"_3059":121731},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3603":73051,"_31069":72928,"_21510":121733,"_5":14782,"_28250":121397,"_3059":121734},[],"acceso completo y de solo lectura a KMS;",{"_3603":73052,"_31069":72928,"_21510":121736,"_5":14782,"_28250":121397,"_3059":121737},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3603":73053,"_31069":72928,"_21510":121739,"_5":14782,"_28250":121397,"_3059":121740},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3603":73054,"_31069":72928,"_21510":121742,"_5":14782,"_28250":121397,"_3059":121743},[],"acceso a la interfaz;",{"_3603":73055,"_31069":72928,"_21510":121745,"_5":14782,"_28250":121397,"_3059":121746},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3603":73056,"_31069":72928,"_21510":121748,"_5":14782,"_28250":121397,"_3059":121749},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3603":73057,"_31069":72928,"_21510":121751,"_5":14782,"_28250":121397,"_3059":121752},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3603":73058,"_31069":72928,"_21510":121754,"_5":14782,"_28250":121397,"_3059":121755},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3603":73059,"_31069":72928,"_21510":121757,"_5":14782,"_28250":121397,"_3059":121758},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3603":73060,"_31069":72928,"_21510":121760,"_5":14782,"_28250":121401,"_3059":121761},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3603":73061,"_31069":72928,"_21510":121763,"_5":14782,"_28250":121401,"_3059":121764},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3603":73062,"_31069":72928,"_21510":121766,"_5":14782,"_28250":121401,"_3059":121767},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3603":73063,"_31069":72928,"_21510":121769,"_5":14782,"_28250":121404,"_3059":121770},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3603":73064,"_31069":72928,"_21510":121772,"_5":14782,"_28250":121408,"_3059":121773},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3603":73065,"_31069":72928,"_21510":121775,"_5":14782,"_28250":121408,"_3059":121776},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3603":73066,"_31069":72928,"_21510":121778,"_5":14782,"_28250":121412,"_3059":121779},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3603":73067,"_31069":72928,"_21510":121781,"_5":14782,"_28250":121416,"_3059":121782},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3603":73068,"_31069":72928,"_21510":121784,"_5":14782,"_28250":121420,"_3059":121785},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3603":73069,"_31069":72928,"_21510":121787,"_5":14782,"_28250":121424,"_3059":121788},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3603":73070,"_31069":72928,"_21510":121790,"_5":14782,"_28250":121424,"_3059":121791},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3603":73071,"_31069":72928,"_21510":121793,"_5":14782,"_28250":121428,"_3059":121794},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3603":73072,"_31069":72928,"_21510":121796,"_5":14782,"_28250":121428,"_3059":121797},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3603":73073,"_31069":72928,"_21510":121799,"_5":14782,"_28250":121428,"_3059":121800},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3603":73074,"_31069":72928,"_21510":121802,"_5":14782,"_28250":121428,"_3059":121803},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3603":73075,"_31069":72928,"_21510":121805,"_5":14782,"_28250":121428,"_3059":121806},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3603":73076,"_31069":72928,"_21510":121808,"_5":14782,"_28250":121428,"_3059":121809},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3603":73077,"_31069":72928,"_21510":121811,"_5":14782,"_28250":121428,"_3059":121812},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3603":73078,"_31069":72928,"_21510":121814,"_5":14782,"_28250":121428,"_3059":121815},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3603":73079,"_31069":72928,"_21510":121817,"_5":14782,"_28250":121432,"_3059":121818},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3603":73080,"_31069":72928,"_21510":121820,"_5":14782,"_28250":121432,"_3059":121821},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3603":73081,"_31069":72928,"_21510":121823,"_5":14782,"_28250":121432,"_3059":121824},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3603":73082,"_31069":72928,"_21510":121826,"_5":14782,"_28250":121436,"_3059":121827},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3603":73083,"_31069":72928,"_21510":121829,"_5":14782,"_28250":121436,"_3059":121830},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3603":73084,"_31069":72928,"_21510":121832,"_5":14782,"_28250":121436,"_3059":121833},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3603":73085,"_31069":72928,"_21510":121835,"_5":14782,"_28250":121436,"_3059":121836},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3603":73086,"_31069":72928,"_21510":121838,"_5":14782,"_28250":121436,"_3059":121839},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3603":73087,"_31069":72928,"_21510":121841,"_5":14782,"_28250":121436,"_3059":121842},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3603":73088,"_31069":72928,"_21510":121844,"_5":14782,"_28250":121436,"_3059":121845},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3603":73089,"_31069":72928,"_21510":121847,"_5":14782,"_28250":121436,"_3059":121848},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3603":73090,"_31069":72928,"_21510":121850,"_5":14782,"_28250":121444,"_3059":121851},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3603":73091,"_31069":72928,"_21510":121853,"_5":14782,"_28250":121448,"_3059":121854},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3603":73092,"_31069":72928,"_21510":121856,"_5":14782,"_28250":121448,"_3059":121857},[],"que exista un principal activo del tipo correcto;",{"_3603":73093,"_31069":72928,"_21510":121859,"_5":14782,"_28250":121448,"_3059":121860},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3603":73094,"_31069":72928,"_21510":121862,"_5":14782,"_28250":121448,"_3059":121863},[],"que todas las condiciones del principal se cumplan;",{"_3603":73095,"_31069":72928,"_21510":121865,"_5":14782,"_28250":121448,"_3059":121866},[],"que el principal tenga concedida la política esperada;",{"_3603":73096,"_31069":72928,"_21510":121868,"_5":14782,"_28250":121448,"_3059":121869},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3603":73097,"_31069":72928,"_21510":121871,"_5":14782,"_28250":121448,"_3059":121872},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3603":73098,"_31069":72928,"_21510":121874,"_5":14782,"_28250":121448,"_3059":121875},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3603":73099,"_31069":72928,"_21510":121877,"_5":14782,"_28250":121448,"_3059":121878},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3603":73100,"_31069":72928,"_21510":121880,"_5":14782,"_28250":121452,"_3059":121881},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3603":73101,"_31069":72928,"_21510":121883,"_5":14782,"_28250":121456,"_3059":121884},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3603":73102,"_31069":72928,"_21510":121886,"_5":14782,"_28250":121460,"_3059":121887},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3603":73103,"_31069":72928,"_21510":121889,"_5":14782,"_28250":121460,"_3059":121890},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3603":73104,"_31069":73104,"_5":15147,"_3059":121892,"_31428":121893,"_21510":121894,"_28250":73104},"Alertas y suscripciones",[50742,121227,121228],[],{"_3603":73105,"_31069":73104,"_21510":121896,"_5":14782,"_28250":73104,"_3059":121897},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3603":73106,"_31069":73104,"_5":31425,"_21510":121899,"_28250":121900,"_3059":121901},[],"/docs/pr-preview/pr-74/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3603":73107,"_31069":73104,"_5":31425,"_21510":121903,"_28250":121904,"_3059":121905},[],"/docs/pr-preview/pr-74/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3603":73108,"_31069":73104,"_5":31425,"_21510":121907,"_28250":121908,"_3059":121909},[],"/docs/pr-preview/pr-74/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3603":73109,"_31069":73104,"_5":31425,"_21510":121911,"_28250":121912,"_3059":121913},[],"/docs/pr-preview/pr-74/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3603":73110,"_31069":73104,"_5":31425,"_21510":121915,"_28250":121916,"_3059":121917},[],"/docs/pr-preview/pr-74/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3603":73111,"_31069":73104,"_5":31425,"_21510":121919,"_28250":121920,"_3059":121921},[],"/docs/pr-preview/pr-74/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3603":73112,"_31069":73104,"_5":31425,"_21510":121923,"_28250":121924,"_3059":121925},[],"/docs/pr-preview/pr-74/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3603":73113,"_31069":73104,"_5":31425,"_21510":121927,"_28250":121928,"_3059":121929},[],"/docs/pr-preview/pr-74/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3603":73114,"_31069":73104,"_5":31425,"_21510":121931,"_28250":121932,"_3059":121933},[],"/docs/pr-preview/pr-74/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3603":73115,"_31069":73104,"_5":31425,"_21510":121935,"_28250":121936,"_3059":121937},[],"/docs/pr-preview/pr-74/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3603":73116,"_31069":73104,"_5":31425,"_21510":121939,"_28250":121940,"_3059":121941},[],"/docs/pr-preview/pr-74/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3603":73117,"_31069":73104,"_21510":121943,"_5":14782,"_28250":73104,"_3059":121944},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3603":73118,"_31069":73104,"_21510":121946,"_5":14782,"_28250":121900,"_3059":121947},[],"Un servicio publica un evento de dominio.",{"_3603":73119,"_31069":73104,"_21510":121949,"_5":14782,"_28250":121900,"_3059":121950},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3603":73120,"_31069":73104,"_21510":121952,"_5":14782,"_28250":121900,"_3059":121953},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3603":73121,"_31069":73104,"_21510":121955,"_5":14782,"_28250":121900,"_3059":121956},[],"Lamassu entrega el evento al canal configurado.",{"_3603":73122,"_31069":73104,"_21510":121958,"_5":14782,"_28250":121900,"_3059":121959},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3603":73123,"_31069":73104,"_21510":121961,"_5":14782,"_28250":121904,"_3059":121962},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3603":73124,"_31069":73104,"_21510":121964,"_5":14782,"_28250":121904,"_3059":121965},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3603":73125,"_31069":73104,"_21510":121967,"_5":14782,"_28250":121904,"_3059":121968},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3603":73126,"_31069":73104,"_21510":121970,"_5":14782,"_28250":121904,"_3059":121971},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3603":73127,"_31069":73104,"_21510":121973,"_5":14782,"_28250":121904,"_3059":121974},[],"`apikey_options` necesita `header` y `key`.",{"_3603":73128,"_31069":73104,"_21510":121976,"_5":14782,"_28250":121904,"_3059":121977},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3603":73129,"_31069":73104,"_21510":121979,"_5":14782,"_28250":121904,"_3059":121980},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3603":73130,"_31069":73104,"_21510":121982,"_5":14782,"_28250":121904,"_3059":121983},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3603":73131,"_31069":73104,"_21510":121985,"_5":14782,"_28250":121912,"_3059":121986},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3603":73132,"_31069":73104,"_21510":121988,"_5":14782,"_28250":121916,"_3059":121989},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3603":73133,"_31069":73104,"_21510":121991,"_5":14782,"_28250":121920,"_3059":121992},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3603":73134,"_31069":73104,"_21510":121994,"_5":14782,"_28250":121920,"_3059":121995},[],"**None** notifica todas las instancias del evento.",{"_3603":73135,"_31069":73104,"_21510":121997,"_5":14782,"_28250":121920,"_3059":121998},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3603":73136,"_31069":73104,"_21510":122000,"_5":14782,"_28250":121920,"_3059":122001},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3603":73137,"_31069":73104,"_21510":122003,"_5":14782,"_28250":121920,"_3059":122004},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3603":73138,"_31069":73104,"_21510":122006,"_5":14782,"_28250":121920,"_3059":122007},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3603":73139,"_31069":73104,"_21510":122009,"_5":14782,"_28250":121920,"_3059":122010},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3603":73140,"_31069":73104,"_21510":122012,"_5":14782,"_28250":121924,"_3059":122013},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3603":73141,"_31069":73104,"_21510":122015,"_5":14782,"_28250":121928,"_3059":122016},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3603":73142,"_31069":73104,"_21510":122018,"_5":14782,"_28250":121928,"_3059":122019},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3603":73143,"_31069":73104,"_21510":122021,"_5":14782,"_28250":121928,"_3059":122022},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3603":73144,"_31069":73104,"_21510":122024,"_5":14782,"_28250":121928,"_3059":122025},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3603":73145,"_31069":73104,"_21510":122027,"_5":14782,"_28250":121928,"_3059":122028},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3603":73146,"_31069":73104,"_21510":122030,"_5":14782,"_28250":121928,"_3059":122031},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3603":73147,"_31069":73104,"_21510":122033,"_5":14782,"_28250":121928,"_3059":122034},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3603":73148,"_31069":73104,"_21510":122036,"_5":14782,"_28250":121928,"_3059":122037},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3603":73149,"_31069":73104,"_21510":122039,"_5":14782,"_28250":121932,"_3059":122040},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3603":73150,"_31069":73104,"_21510":122042,"_5":14782,"_28250":121932,"_3059":122043},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3603":73151,"_31069":73104,"_21510":122045,"_5":14782,"_28250":121932,"_3059":122046},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3603":73152,"_31069":73104,"_21510":122048,"_5":14782,"_28250":121932,"_3059":122049},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3603":73153,"_31069":73104,"_21510":122051,"_5":14782,"_28250":121932,"_3059":122052},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3603":73154,"_31069":73104,"_21510":122054,"_5":14782,"_28250":121932,"_3059":122055},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3603":73155,"_31069":73104,"_21510":122057,"_5":14782,"_28250":121932,"_3059":122058},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3603":73156,"_31069":73104,"_21510":122060,"_5":14782,"_28250":121932,"_3059":122061},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3603":73157,"_31069":73104,"_21510":122063,"_5":14782,"_28250":121936,"_3059":122064},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3603":73158,"_31069":73104,"_21510":122066,"_5":14782,"_28250":121936,"_3059":122067},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3603":73159,"_31069":73104,"_21510":122069,"_5":14782,"_28250":121940,"_3059":122070},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3603":73160,"_31069":73104,"_21510":122072,"_5":14782,"_28250":121940,"_3059":122073},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3603":73161,"_31069":73104,"_21510":122075,"_5":14782,"_28250":121940,"_3059":122076},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3603":73162,"_31069":73104,"_21510":122078,"_5":14782,"_28250":121940,"_3059":122079},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3603":73163,"_31069":73104,"_21510":122081,"_5":14782,"_28250":121940,"_3059":122082},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3603":73164,"_31069":73104,"_21510":122084,"_5":14782,"_28250":121940,"_3059":122085},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3603":73165,"_31069":73104,"_21510":122087,"_5":14782,"_28250":121940,"_3059":122088},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3603":73166,"_31069":73104,"_21510":122090,"_5":14782,"_28250":121940,"_3059":122091},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3603":73167,"_31069":73104,"_21510":122093,"_5":14782,"_28250":121940,"_3059":122094},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3603":73168,"_31069":73104,"_21510":122096,"_5":14782,"_28250":121940,"_3059":122097},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3603":73169,"_31069":73169,"_5":15147,"_3059":122099,"_31428":122100,"_21510":122101,"_28250":73169},"Registros de auditoría",[50742,121227,121228],[],{"_3603":73170,"_31069":73169,"_21510":122103,"_5":14782,"_28250":73169,"_3059":122104},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3603":73171,"_31069":73169,"_5":31425,"_21510":122106,"_28250":122107,"_3059":122108},[],"/docs/pr-preview/pr-74/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3603":73172,"_31069":73169,"_5":31425,"_21510":122110,"_28250":122111,"_3059":122112},[],"/docs/pr-preview/pr-74/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3603":73173,"_31069":73169,"_5":31425,"_21510":122114,"_28250":122115,"_3059":122116},[],"/docs/pr-preview/pr-74/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3603":73174,"_31069":73169,"_5":31425,"_21510":122118,"_28250":122119,"_3059":122120},[],"/docs/pr-preview/pr-74/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3603":73175,"_31069":73169,"_5":31425,"_21510":122122,"_28250":122123,"_3059":122124},[],"/docs/pr-preview/pr-74/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3603":73176,"_31069":73169,"_5":31425,"_21510":122126,"_28250":122127,"_3059":122128},[],"/docs/pr-preview/pr-74/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3603":73177,"_31069":73169,"_5":31425,"_21510":122130,"_28250":122131,"_3059":122132},[],"/docs/pr-preview/pr-74/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3603":73178,"_31069":73169,"_5":31425,"_21510":122134,"_28250":122135,"_3059":122136},[],"/docs/pr-preview/pr-74/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3603":73179,"_31069":73169,"_5":31425,"_21510":122138,"_28250":122139,"_3059":122140},[],"/docs/pr-preview/pr-74/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3603":73180,"_31069":73169,"_5":31425,"_21510":122142,"_28250":122143,"_3059":122144},[],"/docs/pr-preview/pr-74/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3603":73181,"_31069":73169,"_5":31425,"_21510":122146,"_28250":122147,"_3059":122148},[],"/docs/pr-preview/pr-74/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3603":73182,"_31069":73169,"_21510":122150,"_5":14782,"_28250":73169,"_3059":122151},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3603":73183,"_31069":73169,"_21510":122153,"_5":14782,"_28250":122107,"_3059":122154},[],"El cuerpo de auditoría incluye:",{"_3603":73184,"_31069":73169,"_21510":122156,"_5":14782,"_28250":122107,"_3059":122157},[],"input: datos recibidos por la operación;",{"_3603":73185,"_31069":73169,"_21510":122159,"_5":14782,"_28250":122107,"_3059":122160},[],"has\\_error: indica si el servicio devolvió un error;",{"_3603":73186,"_31069":73169,"_21510":122162,"_5":14782,"_28250":122107,"_3059":122163},[],"output: resultado producido o mensaje de error;",{"_3603":73187,"_31069":73169,"_21510":122165,"_5":14782,"_28250":122107,"_3059":122166},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3603":73188,"_31069":73169,"_21510":122168,"_5":14782,"_28250":122107,"_3059":122169},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3603":73189,"_31069":73169,"_21510":122171,"_5":14782,"_28250":122107,"_3059":122172},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3603":73190,"_31069":73169,"_21510":122174,"_5":14782,"_28250":122111,"_3059":122175},[],"El backend aplica auditoría a mutaciones de:",{"_3603":73191,"_31069":73169,"_21510":122177,"_5":14782,"_28250":122111,"_3059":122178},[],"autoridades, certificados y perfiles de emisión;",{"_3603":73192,"_31069":73169,"_21510":122180,"_5":14782,"_28250":122111,"_3059":122181},[],"claves y motores KMS;",{"_3603":73193,"_31069":73169,"_21510":122183,"_5":14782,"_28250":122111,"_3059":122184},[],"dispositivos e identidades;",{"_3603":73194,"_31069":73169,"_21510":122186,"_5":14782,"_28250":122111,"_3059":122187},[],"DMS y operaciones de enrolamiento;",{"_3603":73195,"_31069":73169,"_21510":122189,"_5":14782,"_28250":122111,"_3059":122190},[],"funciones de validación y CRL;",{"_3603":73196,"_31069":73169,"_21510":122192,"_5":14782,"_28250":122111,"_3059":122193},[],"principales, políticas y concesiones de autorización.",{"_3603":73197,"_31069":73169,"_21510":122195,"_5":14782,"_28250":122111,"_3059":122196},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3603":73198,"_31069":73169,"_21510":122198,"_5":14782,"_28250":122115,"_3059":122199},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3603":73199,"_31069":73169,"_21510":122201,"_5":14782,"_28250":122115,"_3059":122202},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3603":73200,"_31069":73169,"_21510":122204,"_5":14782,"_28250":122115,"_3059":122205},[],"Diseña el consumidor para:",{"_3603":73201,"_31069":73169,"_21510":122207,"_5":14782,"_28250":122115,"_3059":122208},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3603":73202,"_31069":73169,"_21510":122210,"_5":14782,"_28250":122115,"_3059":122211},[],"conservar el CloudEvent completo sin modificar;",{"_3603":73203,"_31069":73169,"_21510":122213,"_5":14782,"_28250":122115,"_3059":122214},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3603":73204,"_31069":73169,"_21510":122216,"_5":14782,"_28250":122115,"_3059":122217},[],"cifrar en tránsito y en reposo;",{"_3603":73205,"_31069":73169,"_21510":122219,"_5":14782,"_28250":122115,"_3059":122220},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3603":73206,"_31069":73169,"_21510":122222,"_5":14782,"_28250":122115,"_3059":122223},[],"aplicar una política explícita de retención y legal hold;",{"_3603":73207,"_31069":73169,"_21510":122225,"_5":14782,"_28250":122115,"_3059":122226},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3603":73208,"_31069":73169,"_21510":122228,"_5":14782,"_28250":122119,"_3059":122229},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3603":73209,"_31069":73169,"_21510":122231,"_5":14782,"_28250":122119,"_3059":122232},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3603":73210,"_31069":73169,"_21510":122234,"_5":14782,"_28250":122127,"_3059":122235},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3603":73211,"_31069":73169,"_21510":122237,"_5":14782,"_28250":122131,"_3059":122238},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3603":73212,"_31069":73169,"_21510":122240,"_5":14782,"_28250":122135,"_3059":122241},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3603":73213,"_31069":73169,"_21510":122243,"_5":14782,"_28250":122139,"_3059":122244},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3603":73214,"_31069":73169,"_21510":122246,"_5":14782,"_28250":122143,"_3059":122247},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3603":73215,"_31069":73169,"_21510":122249,"_5":14782,"_28250":122147,"_3059":122250},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3603":73216,"_31069":73169,"_21510":122252,"_5":14782,"_28250":122147,"_3059":122253},[],"aparece un evento de auditoría correcto;",{"_3603":73217,"_31069":73169,"_21510":122255,"_5":14782,"_28250":122147,"_3059":122256},[],"el principal coincide con la identidad utilizada;",{"_3603":73218,"_31069":73169,"_21510":122258,"_5":14782,"_28250":122147,"_3059":122259},[],"el consumidor lo persiste una sola vez;",{"_3603":73219,"_31069":73169,"_21510":122261,"_5":14782,"_28250":122147,"_3059":122262},[],"puede recuperarse por recurso, actor y periodo;",{"_3603":73220,"_31069":73169,"_21510":122264,"_5":14782,"_28250":122147,"_3059":122265},[],"una interrupción del consumidor produce una alerta.",{"_3603":73221,"_31069":73169,"_21510":122267,"_5":14782,"_28250":122147,"_3059":122268},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3603":73222,"_31069":73222,"_5":15147,"_3059":122270,"_31428":122271,"_21510":122272,"_28250":73222},"Arquitectura de la plataforma",[50742,121227],[],{"_3603":73223,"_31069":73222,"_21510":122274,"_5":14782,"_28250":73222,"_3059":122275},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3603":73224,"_31069":73222,"_5":31425,"_21510":122277,"_28250":122278,"_3059":122279},[],"/docs/pr-preview/pr-74/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3603":73225,"_31069":73222,"_5":31425,"_21510":122281,"_28250":122282,"_3059":122283},[],"/docs/pr-preview/pr-74/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3603":73226,"_31069":73222,"_5":31425,"_21510":122285,"_28250":122286,"_3059":122287},[],"/docs/pr-preview/pr-74/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3603":73227,"_31069":73222,"_5":31425,"_21510":122289,"_28250":122290,"_3059":122291},[],"/docs/pr-preview/pr-74/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3603":73228,"_31069":73222,"_5":31425,"_21510":122293,"_28250":122294,"_3059":122295},[],"/docs/pr-preview/pr-74/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3603":73229,"_31069":73222,"_21510":122297,"_5":14782,"_28250":73222,"_3059":122298},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3603":73230,"_31069":73222,"_21510":122300,"_5":14782,"_28250":73222,"_3059":122301},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3603":73231,"_31069":73222,"_21510":122303,"_5":14782,"_28250":122278,"_3059":122304},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3603":73232,"_31069":73222,"_21510":122306,"_5":14782,"_28250":122282,"_3059":122307},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3603":73233,"_31069":73222,"_21510":122309,"_5":14782,"_28250":122286,"_3059":122310},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3603":73234,"_31069":73222,"_21510":122312,"_5":14782,"_28250":122290,"_3059":122313},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3603":73235,"_31069":73222,"_21510":122315,"_5":14782,"_28250":122294,"_3059":122316},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3603":73236,"_31069":73236,"_5":15147,"_3059":122318,"_31428":122319,"_21510":122320,"_28250":73236},"Cómo funciona Lamassu",[50742,121227],[],{"_3603":73237,"_31069":73236,"_21510":122322,"_5":14782,"_28250":73236,"_3059":122323},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3603":73238,"_31069":73236,"_5":31425,"_21510":122325,"_28250":122326,"_3059":122327},[],"/docs/pr-preview/pr-74/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3603":73239,"_31069":73236,"_5":31425,"_21510":122329,"_28250":122330,"_3059":122331},[],"/docs/pr-preview/pr-74/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3603":73240,"_31069":73236,"_21510":122333,"_5":14782,"_28250":73236,"_3059":122334},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3603":73241,"_31069":73236,"_21510":122336,"_5":14782,"_28250":122326,"_3059":122337},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3603":73242,"_31069":73236,"_21510":122339,"_5":14782,"_28250":122326,"_3059":122340},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3603":73243,"_31069":73236,"_21510":122342,"_5":14782,"_28250":122326,"_3059":122343},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3603":73244,"_31069":73236,"_21510":122345,"_5":14782,"_28250":122326,"_3059":122346},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3603":73245,"_31069":73236,"_21510":122348,"_5":14782,"_28250":122326,"_3059":122349},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3603":73246,"_31069":73236,"_21510":122351,"_5":14782,"_28250":122330,"_3059":122352},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3603":73247,"_31069":73236,"_21510":122354,"_5":14782,"_28250":122330,"_3059":122355},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3603":73248,"_31069":73236,"_21510":122357,"_5":14782,"_28250":122330,"_3059":122358},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3603":73249,"_31069":73236,"_21510":122360,"_5":14782,"_28250":122330,"_3059":122361},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3603":73250,"_31069":73236,"_21510":122363,"_5":14782,"_28250":122330,"_3059":122364},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3603":73251,"_31069":73236,"_21510":122366,"_5":14782,"_28250":122330,"_3059":122367},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3603":73252,"_31069":73236,"_21510":122369,"_5":14782,"_28250":122330,"_3059":122370},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3603":73253,"_31069":73253,"_5":15147,"_3059":122372,"_31428":122373,"_21510":122374,"_28250":73253},"Dispositivos e identidades",[50742,121227,53426,122372],[],{"_3603":73254,"_31069":73253,"_21510":122376,"_5":14782,"_28250":73253,"_3059":122377},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3603":73255,"_31069":73253,"_5":31425,"_21510":122379,"_28250":122380,"_3059":122381},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3603":73256,"_31069":73253,"_5":31425,"_21510":122383,"_28250":122384,"_3059":122385},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3603":73257,"_31069":73253,"_5":31425,"_21510":122387,"_28250":122388,"_3059":122389},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3603":73258,"_31069":73253,"_5":31425,"_21510":122391,"_28250":122392,"_3059":122393},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3603":73259,"_31069":73253,"_5":31425,"_21510":122395,"_28250":122396,"_3059":122397},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3603":73260,"_31069":73253,"_5":31425,"_21510":122399,"_28250":122400,"_3059":122401},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3603":73261,"_31069":73253,"_5":31425,"_21510":122403,"_28250":122404,"_3059":122405},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3603":73262,"_31069":73253,"_5":31425,"_21510":122407,"_28250":122408,"_3059":122409},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3603":73263,"_31069":73253,"_5":31425,"_21510":122411,"_28250":122412,"_3059":122413},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3603":73264,"_31069":73253,"_5":31425,"_21510":122415,"_28250":122416,"_3059":122417},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3603":73265,"_31069":73253,"_5":31425,"_21510":122419,"_28250":122420,"_3059":122421},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3603":73266,"_31069":73253,"_21510":122423,"_5":14782,"_28250":73253,"_3059":122424},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3603":73267,"_31069":73253,"_21510":122426,"_5":14782,"_28250":73253,"_3059":122427},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3603":73268,"_31069":73253,"_21510":122429,"_5":14782,"_28250":122380,"_3059":122430},[],"Vista operativa",{"_3603":73269,"_31069":73253,"_21510":122432,"_5":14782,"_28250":122380,"_3059":122433},[],"Interpretación",{"_3603":73270,"_31069":73253,"_21510":122435,"_5":14782,"_28250":122380,"_3059":53489},[],{"_3603":73271,"_31069":73253,"_21510":122437,"_5":14782,"_28250":122380,"_3059":122438},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3603":73272,"_31069":73253,"_21510":122440,"_5":14782,"_28250":122380,"_3059":53495},[],{"_3603":73273,"_31069":73253,"_21510":122442,"_5":14782,"_28250":122380,"_3059":122443},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3603":73274,"_31069":73253,"_21510":122445,"_5":14782,"_28250":122380,"_3059":53501},[],{"_3603":73275,"_31069":73253,"_21510":122447,"_5":14782,"_28250":122380,"_3059":122448},[],"La identidad está en la ventana operativa de renovación.",{"_3603":73276,"_31069":73253,"_21510":122450,"_5":14782,"_28250":122380,"_3059":53507},[],{"_3603":73277,"_31069":73253,"_21510":122452,"_5":14782,"_28250":122380,"_3059":122453},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3603":73278,"_31069":73253,"_21510":122455,"_5":14782,"_28250":122380,"_3059":53513},[],{"_3603":73279,"_31069":73253,"_21510":122457,"_5":14782,"_28250":122380,"_3059":122458},[],"La identidad ha vencido.",{"_3603":73280,"_31069":73253,"_21510":122460,"_5":14782,"_28250":122380,"_3059":53519},[],{"_3603":73281,"_31069":73253,"_21510":122462,"_5":14782,"_28250":122380,"_3059":122463},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3603":73282,"_31069":73253,"_21510":122465,"_5":14782,"_28250":122380,"_3059":53525},[],{"_3603":73283,"_31069":73253,"_21510":122467,"_5":14782,"_28250":122380,"_3059":122468},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3603":73284,"_31069":73253,"_21510":122470,"_5":14782,"_28250":122380,"_3059":122471},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3603":73285,"_31069":73253,"_21510":122473,"_5":14782,"_28250":122384,"_3059":122474},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3603":73286,"_31069":73253,"_21510":122476,"_5":14782,"_28250":122384,"_3059":122477},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3603":73287,"_31069":73253,"_21510":122479,"_5":14782,"_28250":122384,"_3059":122480},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3603":73288,"_31069":73253,"_21510":122482,"_5":14782,"_28250":122384,"_3059":122483},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3603":73289,"_31069":73253,"_21510":122485,"_5":14782,"_28250":122388,"_3059":122486},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3603":73290,"_31069":73253,"_21510":122488,"_5":14782,"_28250":122392,"_3059":122489},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3603":73291,"_31069":73253,"_21510":122491,"_5":14782,"_28250":122396,"_3059":122492},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3603":73292,"_31069":73253,"_21510":122494,"_5":14782,"_28250":122400,"_3059":122495},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3603":73293,"_31069":73253,"_21510":122497,"_5":14782,"_28250":122404,"_3059":122498},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3603":73294,"_31069":73253,"_21510":122500,"_5":14782,"_28250":122404,"_3059":122501},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3603":73295,"_31069":73253,"_21510":122503,"_5":14782,"_28250":122408,"_3059":122504},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3603":73296,"_31069":73253,"_21510":122506,"_5":14782,"_28250":122408,"_3059":122507},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3603":73297,"_31069":73253,"_21510":122509,"_5":14782,"_28250":122408,"_3059":122510},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3603":73298,"_31069":73253,"_21510":122512,"_5":14782,"_28250":122408,"_3059":122513},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3603":73299,"_31069":73253,"_21510":122515,"_5":14782,"_28250":122408,"_3059":122516},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3603":73300,"_31069":73253,"_21510":122518,"_5":14782,"_28250":122408,"_3059":122519},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3603":73301,"_31069":73253,"_21510":122521,"_5":14782,"_28250":122412,"_3059":122522},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3603":73302,"_31069":73253,"_21510":122524,"_5":14782,"_28250":122412,"_3059":122525},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3603":73303,"_31069":73253,"_21510":122527,"_5":14782,"_28250":122412,"_3059":122528},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3603":73304,"_31069":73253,"_21510":122530,"_5":14782,"_28250":122416,"_3059":122531},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3603":73305,"_31069":73253,"_21510":122533,"_5":14782,"_28250":122416,"_3059":122534},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3603":73306,"_31069":73253,"_21510":122536,"_5":14782,"_28250":122416,"_3059":122537},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3603":73307,"_31069":73253,"_21510":122539,"_5":14782,"_28250":122416,"_3059":122540},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3603":73308,"_31069":73253,"_21510":122542,"_5":14782,"_28250":122420,"_3059":122543},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3603":73309,"_31069":73253,"_21510":122545,"_5":14782,"_28250":122420,"_3059":122546},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3603":73310,"_31069":73310,"_5":15147,"_3059":122548,"_31428":122549,"_21510":122551,"_28250":73310},"Identidad inicial y autenticación",[50742,121227,53426,122372,122550],"Enrolamiento con PKI",[],{"_3603":73311,"_31069":73310,"_21510":122553,"_5":14782,"_28250":73310,"_3059":122554},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3603":73312,"_31069":73310,"_5":31425,"_21510":122556,"_28250":122557,"_3059":122558},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3603":73313,"_31069":73310,"_5":31425,"_21510":122560,"_28250":122561,"_3059":122562},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3603":73314,"_31069":73310,"_5":31425,"_21510":122564,"_28250":122565,"_3059":122566},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3603":73315,"_31069":73310,"_5":31425,"_21510":122568,"_28250":122569,"_3059":122570},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3603":73316,"_31069":73310,"_5":31425,"_21510":122572,"_28250":122573,"_3059":122574},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3603":73317,"_31069":73310,"_21510":122576,"_5":14782,"_28250":73310,"_3059":122577},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3603":73318,"_31069":73310,"_21510":122579,"_5":14782,"_28250":122557,"_3059":122580},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3603":73319,"_31069":73310,"_21510":122582,"_5":14782,"_28250":122557,"_3059":122583},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3603":73320,"_31069":73310,"_21510":122585,"_5":14782,"_28250":122561,"_3059":122586},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3603":73321,"_31069":73310,"_21510":122588,"_5":14782,"_28250":122561,"_3059":122589},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3603":73322,"_31069":73310,"_21510":122591,"_5":14782,"_28250":122561,"_3059":122592},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3603":73323,"_31069":73310,"_21510":122594,"_5":14782,"_28250":122565,"_3059":122595},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3603":73324,"_31069":73310,"_21510":122597,"_5":14782,"_28250":122565,"_3059":122598},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3603":73325,"_31069":73310,"_21510":122600,"_5":14782,"_28250":122569,"_3059":122601},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3603":73326,"_31069":73310,"_21510":122603,"_5":14782,"_28250":122569,"_3059":122604},[],"Ejemplo de cuerpo:",{"_3603":73327,"_31069":73310,"_21510":122606,"_5":14782,"_28250":122569,"_3059":122607},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3603":73328,"_31069":73310,"_21510":122609,"_5":14782,"_28250":122569,"_3059":122610},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3603":73329,"_31069":73310,"_21510":122612,"_5":14782,"_28250":122569,"_3059":122613},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3603":73330,"_31069":73310,"_21510":122615,"_5":14782,"_28250":122569,"_3059":122616},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3603":73331,"_31069":73310,"_21510":122618,"_5":14782,"_28250":122573,"_3059":122619},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3603":73332,"_31069":73310,"_21510":122621,"_5":14782,"_28250":122573,"_3059":122622},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3603":73333,"_31069":73333,"_5":15147,"_3059":122624,"_31428":122625,"_21510":122626,"_28250":73333},"Configura y opera el DMS",[50742,121227,53426,122372,122550],[],{"_3603":73334,"_31069":73333,"_21510":122628,"_5":14782,"_28250":73333,"_3059":122629},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3603":73335,"_31069":73333,"_5":31425,"_21510":122631,"_28250":122632,"_3059":119761},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3603":73336,"_31069":73333,"_5":31425,"_21510":122634,"_28250":122635,"_3059":122636},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3603":73337,"_31069":73333,"_5":31425,"_21510":122638,"_28250":122639,"_3059":122640},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3603":73338,"_31069":73333,"_5":31425,"_21510":122642,"_28250":122643,"_3059":122644},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3603":73339,"_31069":73333,"_5":31425,"_21510":122646,"_28250":122647,"_3059":122648},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3603":73340,"_31069":73333,"_5":31425,"_21510":122650,"_28250":122651,"_3059":122652},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3603":73341,"_31069":73333,"_5":31425,"_21510":122654,"_28250":122655,"_3059":122656},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3603":73342,"_31069":73333,"_5":31425,"_21510":122658,"_28250":122659,"_3059":122660},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3603":73343,"_31069":73333,"_5":31425,"_21510":122662,"_28250":122663,"_3059":53724},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3603":73344,"_31069":73333,"_5":31425,"_21510":122665,"_28250":122666,"_3059":53728},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3603":73345,"_31069":73333,"_5":31425,"_21510":122668,"_28250":122669,"_3059":122670},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3603":73346,"_31069":73333,"_5":31425,"_21510":122672,"_28250":122673,"_3059":122674},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3603":73347,"_31069":73333,"_5":31425,"_21510":122676,"_28250":122677,"_3059":122678},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3603":73348,"_31069":73333,"_5":31425,"_21510":122680,"_28250":122681,"_3059":122682},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3603":73349,"_31069":73333,"_5":31425,"_21510":122684,"_28250":122685,"_3059":53748},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3603":73350,"_31069":73333,"_5":31425,"_21510":122687,"_28250":122688,"_3059":122689},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3603":73351,"_31069":73333,"_5":31425,"_21510":122691,"_28250":122692,"_3059":122693},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3603":73352,"_31069":73333,"_5":31425,"_21510":122695,"_28250":122696,"_3059":122697},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3603":73353,"_31069":73333,"_21510":122699,"_5":14782,"_28250":73333,"_3059":122700},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3603":73354,"_31069":73333,"_21510":122702,"_5":14782,"_28250":122632,"_3059":122703},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3603":73355,"_31069":73333,"_21510":122705,"_5":14782,"_28250":122632,"_3059":122706},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3603":73356,"_31069":73333,"_21510":122708,"_5":14782,"_28250":122639,"_3059":122709},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3603":73357,"_31069":73333,"_21510":122711,"_5":14782,"_28250":122643,"_3059":122712},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3603":73358,"_31069":73333,"_21510":122714,"_5":14782,"_28250":122647,"_3059":122715},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3603":73359,"_31069":73333,"_21510":122717,"_5":14782,"_28250":122651,"_3059":122718},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3603":73360,"_31069":73333,"_21510":122720,"_5":14782,"_28250":122655,"_3059":122721},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3603":73361,"_31069":73333,"_21510":122723,"_5":14782,"_28250":122663,"_3059":122724},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3603":73362,"_31069":73333,"_21510":122726,"_5":14782,"_28250":122663,"_3059":122727},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3603":73363,"_31069":73333,"_21510":122729,"_5":14782,"_28250":122666,"_3059":122730},[],"Campo de `settings.enrollment_settings`",{"_3603":73364,"_31069":73333,"_21510":122732,"_5":14782,"_28250":122666,"_3059":122733},[],"Decisión",{"_3603":73365,"_31069":73333,"_21510":122735,"_5":14782,"_28250":122666,"_3059":53799},[],{"_3603":73366,"_31069":73333,"_21510":122737,"_5":14782,"_28250":122666,"_3059":122738},[],"`EST_RFC7030` para estas operaciones.",{"_3603":73367,"_31069":73333,"_21510":122740,"_5":14782,"_28250":122666,"_3059":53805},[],{"_3603":73368,"_31069":73333,"_21510":122742,"_5":14782,"_28250":122666,"_3059":122743},[],"ID de la CA que firmará.",{"_3603":73369,"_31069":73333,"_21510":122745,"_5":14782,"_28250":122666,"_3059":53811},[],{"_3603":73370,"_31069":73333,"_21510":122747,"_5":14782,"_28250":122666,"_3059":122748},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3603":73371,"_31069":73333,"_21510":122750,"_5":14782,"_28250":122666,"_3059":53817},[],{"_3603":73372,"_31069":73333,"_21510":122752,"_5":14782,"_28250":122666,"_3059":122753},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3603":73373,"_31069":73333,"_21510":122755,"_5":14782,"_28250":122666,"_3059":53823},[],{"_3603":73374,"_31069":73333,"_21510":122757,"_5":14782,"_28250":122666,"_3059":122758},[],"Uno de los cuatro modos de autenticación.",{"_3603":73375,"_31069":73333,"_21510":122760,"_5":14782,"_28250":122666,"_3059":122761},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3603":73376,"_31069":73333,"_21510":122763,"_5":14782,"_28250":122669,"_3059":122764},[],"Los bloques son independientes:",{"_3603":73377,"_31069":73333,"_21510":122766,"_5":14782,"_28250":122669,"_3059":122767},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3603":73378,"_31069":73333,"_21510":122769,"_5":14782,"_28250":122669,"_3059":122770},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3603":73379,"_31069":73333,"_21510":122772,"_5":14782,"_28250":122669,"_3059":53841},[],{"_3603":73380,"_31069":73333,"_21510":122774,"_5":14782,"_28250":122669,"_3059":122775},[],"Control aplicado en la operación configurada",{"_3603":73381,"_31069":73333,"_21510":122777,"_5":14782,"_28250":122669,"_3059":53847},[],{"_3603":73382,"_31069":73333,"_21510":122779,"_5":14782,"_28250":122669,"_3059":122780},[],"Validación del certificado presentado.",{"_3603":73383,"_31069":73333,"_21510":122782,"_5":14782,"_28250":122669,"_3059":53853},[],{"_3603":73384,"_31069":73333,"_21510":122784,"_5":14782,"_28250":122669,"_3059":122785},[],"Autorización del webhook configurado.",{"_3603":73385,"_31069":73333,"_21510":122787,"_5":14782,"_28250":122669,"_3059":53859},[],{"_3603":73386,"_31069":73333,"_21510":122789,"_5":14782,"_28250":122669,"_3059":122790},[],"Validación del certificado y, después, aprobación del webhook.",{"_3603":73387,"_31069":73333,"_21510":122792,"_5":14782,"_28250":122669,"_3059":53865},[],{"_3603":73388,"_31069":73333,"_21510":122794,"_5":14782,"_28250":122669,"_3059":122795},[],"Sin autenticación del solicitante por el DMS.",{"_3603":73389,"_31069":73333,"_21510":122797,"_5":14782,"_28250":122669,"_3059":122798},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3603":73390,"_31069":73333,"_21510":122800,"_5":14782,"_28250":122669,"_3059":122801},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3603":73391,"_31069":73333,"_21510":122803,"_5":14782,"_28250":122669,"_3059":122804},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3603":73392,"_31069":73333,"_21510":122806,"_5":14782,"_28250":122669,"_3059":122807},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3603":73393,"_31069":73333,"_21510":122809,"_5":14782,"_28250":122673,"_3059":122810},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3603":73394,"_31069":73333,"_21510":122812,"_5":14782,"_28250":122673,"_3059":122813},[],"Campo de `external_webhook_settings`",{"_3603":73395,"_31069":73333,"_21510":122815,"_5":14782,"_28250":122673,"_3059":122733},[],{"_3603":73396,"_31069":73333,"_21510":122817,"_5":14782,"_28250":122673,"_3059":53891},[],{"_3603":73397,"_31069":73333,"_21510":122819,"_5":14782,"_28250":122673,"_3059":122820},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3603":73398,"_31069":73333,"_21510":122822,"_5":14782,"_28250":122673,"_3059":53897},[],{"_3603":73399,"_31069":73333,"_21510":122824,"_5":14782,"_28250":122673,"_3059":122825},[],"`POST` o `PUT`; `POST` por defecto.",{"_3603":73400,"_31069":73333,"_21510":122827,"_5":14782,"_28250":122673,"_3059":53903},[],{"_3603":73401,"_31069":73333,"_21510":122829,"_5":14782,"_28250":122673,"_3059":122830},[],"Etiqueta usada en los logs del servicio.",{"_3603":73402,"_31069":73333,"_21510":122832,"_5":14782,"_28250":122673,"_3059":53909},[],{"_3603":73403,"_31069":73333,"_21510":122834,"_5":14782,"_28250":122673,"_3059":122835},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3603":73404,"_31069":73333,"_21510":122837,"_5":14782,"_28250":122673,"_3059":53915},[],{"_3603":73405,"_31069":73333,"_21510":122839,"_5":14782,"_28250":122673,"_3059":122840},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3603":73406,"_31069":73333,"_21510":122842,"_5":14782,"_28250":122673,"_3059":53921},[],{"_3603":73407,"_31069":73333,"_21510":122844,"_5":14782,"_28250":122673,"_3059":122845},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3603":73408,"_31069":73333,"_21510":122847,"_5":14782,"_28250":122673,"_3059":53927},[],{"_3603":73409,"_31069":73333,"_21510":122849,"_5":14782,"_28250":122673,"_3059":122850},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3603":73410,"_31069":73333,"_21510":122852,"_5":14782,"_28250":122673,"_3059":53933},[],{"_3603":73411,"_31069":73333,"_21510":122854,"_5":14782,"_28250":122673,"_3059":122855},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3603":73412,"_31069":73333,"_21510":122857,"_5":14782,"_28250":122673,"_3059":53939},[],{"_3603":73413,"_31069":73333,"_21510":122859,"_5":14782,"_28250":122673,"_3059":122860},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3603":73414,"_31069":73333,"_21510":122862,"_5":14782,"_28250":122673,"_3059":53945},[],{"_3603":73415,"_31069":73333,"_21510":122864,"_5":14782,"_28250":122673,"_3059":122865},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3603":73416,"_31069":73333,"_21510":122867,"_5":14782,"_28250":122673,"_3059":122868},[],"Reglas de esa configuración:",{"_3603":73417,"_31069":73333,"_21510":122870,"_5":14782,"_28250":122673,"_3059":122871},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3603":73418,"_31069":73333,"_21510":122873,"_5":14782,"_28250":122673,"_3059":122874},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3603":73419,"_31069":73333,"_21510":122876,"_5":14782,"_28250":122673,"_3059":122877},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3603":73420,"_31069":73333,"_21510":122879,"_5":14782,"_28250":122673,"_3059":122880},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3603":73421,"_31069":73333,"_21510":122882,"_5":14782,"_28250":122673,"_3059":122883},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3603":73422,"_31069":73333,"_21510":122885,"_5":14782,"_28250":122673,"_3059":122886},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3603":73423,"_31069":73333,"_21510":122888,"_5":14782,"_28250":122673,"_3059":122889},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3603":73424,"_31069":73333,"_21510":122891,"_5":14782,"_28250":122673,"_3059":122892},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3603":73425,"_31069":73333,"_21510":122894,"_5":14782,"_28250":122673,"_3059":122895},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3603":73426,"_31069":73333,"_21510":122897,"_5":14782,"_28250":122677,"_3059":122898},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3603":73427,"_31069":73333,"_21510":122900,"_5":14782,"_28250":122681,"_3059":122901},[],"Campo de `settings.reenrollment_settings`",{"_3603":73428,"_31069":73333,"_21510":122903,"_5":14782,"_28250":122681,"_3059":122904},[],"Función",{"_3603":73429,"_31069":73333,"_21510":122906,"_5":14782,"_28250":122681,"_3059":53989},[],{"_3603":73430,"_31069":73333,"_21510":122908,"_5":14782,"_28250":122681,"_3059":122909},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3603":73431,"_31069":73333,"_21510":122911,"_5":14782,"_28250":122681,"_3059":53995},[],{"_3603":73432,"_31069":73333,"_21510":122913,"_5":14782,"_28250":122681,"_3059":122914},[],"Umbral operativo preventivo de monitorización.",{"_3603":73433,"_31069":73333,"_21510":122916,"_5":14782,"_28250":122681,"_3059":54001},[],{"_3603":73434,"_31069":73333,"_21510":122918,"_5":14782,"_28250":122681,"_3059":122919},[],"Umbral operativo crítico de monitorización.",{"_3603":73435,"_31069":73333,"_21510":122921,"_5":14782,"_28250":122681,"_3059":54007},[],{"_3603":73436,"_31069":73333,"_21510":122923,"_5":14782,"_28250":122681,"_3059":122924},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3603":73437,"_31069":73333,"_21510":122926,"_5":14782,"_28250":122681,"_3059":54013},[],{"_3603":73438,"_31069":73333,"_21510":122928,"_5":14782,"_28250":122681,"_3059":122929},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3603":73439,"_31069":73333,"_21510":122931,"_5":14782,"_28250":122681,"_3059":54019},[],{"_3603":73440,"_31069":73333,"_21510":122933,"_5":14782,"_28250":122681,"_3059":122934},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3603":73441,"_31069":73333,"_21510":122936,"_5":14782,"_28250":122681,"_3059":122937},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3603":73442,"_31069":73333,"_21510":122939,"_5":14782,"_28250":122685,"_3059":122940},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3603":73443,"_31069":73333,"_21510":122942,"_5":14782,"_28250":122688,"_3059":120125},[],{"_3603":73444,"_31069":73333,"_21510":122944,"_5":14782,"_28250":122688,"_3059":122945},[],"Qué publica",{"_3603":73445,"_31069":73333,"_21510":122947,"_5":14782,"_28250":122688,"_3059":54036},[],{"_3603":73446,"_31069":73333,"_21510":122949,"_5":14782,"_28250":122688,"_3059":122950},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3603":73447,"_31069":73333,"_21510":122952,"_5":14782,"_28250":122688,"_3059":54042},[],{"_3603":73448,"_31069":73333,"_21510":122954,"_5":14782,"_28250":122688,"_3059":122955},[],"Certificado de la CA emisora seleccionada.",{"_3603":73449,"_31069":73333,"_21510":122957,"_5":14782,"_28250":122688,"_3059":54048},[],{"_3603":73450,"_31069":73333,"_21510":122959,"_5":14782,"_28250":122688,"_3059":122960},[],"Certificados de las CAs elegidas explícitamente.",{"_3603":73451,"_31069":73333,"_21510":122962,"_5":14782,"_28250":122688,"_3059":122963},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3603":73452,"_31069":73333,"_21510":122965,"_5":14782,"_28250":122692,"_3059":122966},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3603":73453,"_31069":73333,"_21510":122968,"_5":14782,"_28250":122692,"_3059":122969},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3603":73454,"_31069":73333,"_21510":122971,"_5":14782,"_28250":122692,"_3059":122972},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3603":73455,"_31069":73333,"_21510":122974,"_5":14782,"_28250":122696,"_3059":122975},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3603":73456,"_31069":73456,"_5":15147,"_3059":122977,"_31428":122978,"_21510":122979,"_28250":73456},"Integra el cliente EST",[50742,121227,53426,122372,122550],[],{"_3603":73457,"_31069":73456,"_21510":122981,"_5":14782,"_28250":73456,"_3059":122982},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3603":73458,"_31069":73456,"_5":31425,"_21510":122984,"_28250":122985,"_3059":119761},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3603":73459,"_31069":73456,"_5":31425,"_21510":122987,"_28250":122988,"_3059":122989},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3603":73460,"_31069":73456,"_5":31425,"_21510":122991,"_28250":122992,"_3059":122993},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3603":73461,"_31069":73456,"_5":31425,"_21510":122995,"_28250":122996,"_3059":122997},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3603":73462,"_31069":73456,"_5":31425,"_21510":122999,"_28250":123000,"_3059":123001},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3603":73463,"_31069":73456,"_5":31425,"_21510":123003,"_28250":123004,"_3059":123005},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3603":73464,"_31069":73456,"_21510":123007,"_5":14782,"_28250":73456,"_3059":123008},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3603":73465,"_31069":73456,"_21510":123010,"_5":14782,"_28250":122985,"_3059":123011},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3603":73466,"_31069":73456,"_21510":123013,"_5":14782,"_28250":122985,"_3059":123014},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3603":73467,"_31069":73456,"_21510":123016,"_5":14782,"_28250":122985,"_3059":123017},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3603":73468,"_31069":73456,"_21510":123019,"_5":14782,"_28250":122988,"_3059":123020},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3603":73469,"_31069":73456,"_21510":123022,"_5":14782,"_28250":122988,"_3059":123023},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3603":73470,"_31069":73456,"_21510":123025,"_5":14782,"_28250":122992,"_3059":123026},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3603":73471,"_31069":73456,"_21510":123028,"_5":14782,"_28250":122992,"_3059":123029},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3603":73472,"_31069":73456,"_21510":123031,"_5":14782,"_28250":122996,"_3059":123032},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3603":73473,"_31069":73456,"_21510":123034,"_5":14782,"_28250":122996,"_3059":123035},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3603":73474,"_31069":73456,"_21510":123037,"_5":14782,"_28250":123000,"_3059":123038},[],"Para el caso de una raíz que emite directamente:",{"_3603":73475,"_31069":73456,"_21510":123040,"_5":14782,"_28250":123000,"_3059":123041},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3603":73476,"_31069":73456,"_21510":123043,"_5":14782,"_28250":123000,"_3059":123044},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3603":73477,"_31069":73456,"_21510":123046,"_5":14782,"_28250":123004,"_3059":123047},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3603":73478,"_31069":73478,"_5":15147,"_3059":123049,"_31428":123050,"_21510":123051,"_28250":73478},"Referencia EST",[50742,121227,53426,122372,122550],[],{"_3603":73479,"_31069":73478,"_21510":123053,"_5":14782,"_28250":73478,"_3059":123054},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3603":73480,"_31069":73478,"_5":31425,"_21510":123056,"_28250":123057,"_3059":123058},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3603":73481,"_31069":73478,"_5":31425,"_21510":123060,"_28250":123061,"_3059":23312},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3603":73482,"_31069":73478,"_5":31425,"_21510":123063,"_28250":123064,"_3059":26806},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3603":73483,"_31069":73478,"_5":31425,"_21510":123066,"_28250":123067,"_3059":26813},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3603":73484,"_31069":73478,"_5":31425,"_21510":123069,"_28250":123070,"_3059":26075},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3603":73485,"_31069":73478,"_5":31425,"_21510":123072,"_28250":123073,"_3059":123074},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3603":73486,"_31069":73478,"_5":31425,"_21510":123076,"_28250":123077,"_3059":123078},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3603":73487,"_31069":73478,"_5":31425,"_21510":123080,"_28250":123081,"_3059":123082},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3603":73488,"_31069":73478,"_21510":123084,"_5":14782,"_28250":73478,"_3059":123085},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3603":73489,"_31069":73478,"_21510":123087,"_5":14782,"_28250":123057,"_3059":123088},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3603":73490,"_31069":73478,"_21510":123090,"_5":14782,"_28250":123057,"_3059":120987},[],{"_3603":73491,"_31069":73478,"_21510":123092,"_5":14782,"_28250":123057,"_3059":123093},[],"Método",{"_3603":73492,"_31069":73478,"_21510":123095,"_5":14782,"_28250":123057,"_3059":123096},[],"Autenticación y condición",{"_3603":73493,"_31069":73478,"_21510":123098,"_5":14782,"_28250":123057,"_3059":54191},[],{"_3603":73494,"_31069":73478,"_21510":123100,"_5":14782,"_28250":123057,"_3059":54194},[],{"_3603":73495,"_31069":73478,"_21510":123102,"_5":14782,"_28250":123057,"_3059":123103},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3603":73496,"_31069":73478,"_21510":123105,"_5":14782,"_28250":123057,"_3059":54200},[],{"_3603":73497,"_31069":73478,"_21510":123107,"_5":14782,"_28250":123057,"_3059":54203},[],{"_3603":73498,"_31069":73478,"_21510":123109,"_5":14782,"_28250":123057,"_3059":123110},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3603":73499,"_31069":73478,"_21510":123112,"_5":14782,"_28250":123057,"_3059":54209},[],{"_3603":73500,"_31069":73478,"_21510":123114,"_5":14782,"_28250":123057,"_3059":54203},[],{"_3603":73501,"_31069":73478,"_21510":123116,"_5":14782,"_28250":123057,"_3059":123117},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3603":73502,"_31069":73478,"_21510":123119,"_5":14782,"_28250":123057,"_3059":54217},[],{"_3603":73503,"_31069":73478,"_21510":123121,"_5":14782,"_28250":123057,"_3059":54203},[],{"_3603":73504,"_31069":73478,"_21510":123123,"_5":14782,"_28250":123057,"_3059":123124},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3603":73505,"_31069":73478,"_21510":123126,"_5":14782,"_28250":123057,"_3059":123127},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3603":73506,"_31069":73478,"_21510":123129,"_5":14782,"_28250":123061,"_3059":123130},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3603":73507,"_31069":73478,"_21510":123132,"_5":14782,"_28250":123061,"_3059":123133},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3603":73508,"_31069":73478,"_21510":123135,"_5":14782,"_28250":123064,"_3059":123136},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3603":73509,"_31069":73478,"_21510":123138,"_5":14782,"_28250":123064,"_3059":123139},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3603":73510,"_31069":73478,"_21510":123141,"_5":14782,"_28250":123067,"_3059":123142},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3603":73511,"_31069":73478,"_21510":123144,"_5":14782,"_28250":123067,"_3059":123145},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3603":73512,"_31069":73478,"_21510":123147,"_5":14782,"_28250":123070,"_3059":123148},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3603":73513,"_31069":73478,"_21510":123150,"_5":14782,"_28250":123070,"_3059":123151},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3603":73514,"_31069":73478,"_21510":123153,"_5":14782,"_28250":123073,"_3059":123154},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3603":73515,"_31069":73478,"_21510":123156,"_5":14782,"_28250":123073,"_3059":123157},[],"Parte",{"_3603":73516,"_31069":73478,"_21510":123159,"_5":14782,"_28250":123073,"_3059":123160},[],"Contenido tras decodificar su Base64",{"_3603":73517,"_31069":73478,"_21510":123162,"_5":14782,"_28250":123073,"_3059":54261},[],{"_3603":73518,"_31069":73478,"_21510":123164,"_5":14782,"_28250":123073,"_3059":123165},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3603":73519,"_31069":73478,"_21510":123167,"_5":14782,"_28250":123073,"_3059":54267},[],{"_3603":73520,"_31069":73478,"_21510":123169,"_5":14782,"_28250":123073,"_3059":123170},[],"PKCS#7 DER con el certificado emitido.",{"_3603":73521,"_31069":73478,"_21510":123172,"_5":14782,"_28250":123073,"_3059":123173},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3603":73522,"_31069":73478,"_21510":123175,"_5":14782,"_28250":123077,"_3059":123176},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3603":73523,"_31069":73478,"_21510":123178,"_5":14782,"_28250":123077,"_3059":123179},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3603":73524,"_31069":73478,"_21510":123181,"_5":14782,"_28250":123077,"_3059":123182},[],"Convierte y comprueba el resultado:",{"_3603":73525,"_31069":73478,"_21510":123184,"_5":14782,"_28250":123077,"_3059":123185},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3603":73526,"_31069":73478,"_21510":123187,"_5":14782,"_28250":123081,"_3059":123188},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3603":73527,"_31069":73478,"_21510":123190,"_5":14782,"_28250":123081,"_3059":123191},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3603":73528,"_31069":73528,"_5":15147,"_3059":122550,"_31428":123193,"_21510":123194,"_28250":73528},[50742,121227,53426,122372,122550],[],{"_3603":73529,"_31069":73528,"_21510":123196,"_5":14782,"_28250":73528,"_3059":123197},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3603":73530,"_31069":73528,"_5":31425,"_21510":123199,"_28250":123200,"_3059":123201},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3603":73531,"_31069":73528,"_5":31425,"_21510":123203,"_28250":123204,"_3059":123205},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3603":73532,"_31069":73528,"_5":31425,"_21510":123207,"_28250":123208,"_3059":123209},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3603":73533,"_31069":73528,"_5":31425,"_21510":123211,"_28250":123212,"_3059":123213},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3603":73534,"_31069":73528,"_21510":123215,"_5":14782,"_28250":73528,"_3059":123216},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3603":73535,"_31069":73528,"_21510":123218,"_5":14782,"_28250":123200,"_3059":123219},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3603":73536,"_31069":73528,"_21510":123221,"_5":14782,"_28250":123200,"_3059":123222},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3603":73537,"_31069":73528,"_21510":123224,"_5":14782,"_28250":123200,"_3059":123225},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3603":73538,"_31069":73528,"_21510":123227,"_5":14782,"_28250":123200,"_3059":123228},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3603":73539,"_31069":73528,"_21510":123230,"_5":14782,"_28250":123200,"_3059":123231},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3603":73540,"_31069":73528,"_21510":123233,"_5":14782,"_28250":123200,"_3059":123234},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3603":73541,"_31069":73528,"_21510":123236,"_5":14782,"_28250":123204,"_3059":123237},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3603":73542,"_31069":73528,"_21510":123239,"_5":14782,"_28250":123204,"_3059":123240},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3603":73543,"_31069":73528,"_21510":123242,"_5":14782,"_28250":123204,"_3059":123243},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3603":73544,"_31069":73528,"_21510":123245,"_5":14782,"_28250":123204,"_3059":123246},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3603":73545,"_31069":73528,"_21510":123248,"_5":14782,"_28250":123208,"_3059":123249},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3603":73546,"_31069":73528,"_21510":123251,"_5":14782,"_28250":123208,"_3059":123252},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3603":73547,"_31069":73528,"_21510":123254,"_5":14782,"_28250":123208,"_3059":123255},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3603":73548,"_31069":73528,"_21510":123257,"_5":14782,"_28250":123208,"_3059":123258},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3603":73549,"_31069":73528,"_21510":123260,"_5":14782,"_28250":123212,"_3059":123261},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3603":73550,"_31069":73528,"_21510":123263,"_5":14782,"_28250":123212,"_3059":123264},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3603":73551,"_31069":73551,"_5":15147,"_3059":123266,"_31428":123267,"_21510":123268,"_28250":73551},"Estrategias de aprovisionamiento",[50742,121227,53426,122372,122550],[],{"_3603":73552,"_31069":73551,"_21510":123270,"_5":14782,"_28250":73551,"_3059":123271},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3603":73553,"_31069":73551,"_5":31425,"_21510":123273,"_28250":123274,"_3059":123275},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3603":73554,"_31069":73551,"_5":31425,"_21510":123277,"_28250":123278,"_3059":123279},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3603":73555,"_31069":73551,"_5":31425,"_21510":123281,"_28250":123282,"_3059":123283},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3603":73556,"_31069":73551,"_5":31425,"_21510":123285,"_28250":123286,"_3059":123287},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3603":73557,"_31069":73551,"_5":31425,"_21510":123289,"_28250":123290,"_3059":123291},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3603":73558,"_31069":73551,"_21510":123293,"_5":14782,"_28250":73551,"_3059":123294},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3603":73559,"_31069":73551,"_21510":123296,"_5":14782,"_28250":123274,"_3059":123297},[],"Recorrido",{"_3603":73560,"_31069":73551,"_21510":123299,"_5":14782,"_28250":123274,"_3059":123300},[],"Cuándo existe el dispositivo",{"_3603":73561,"_31069":73551,"_21510":123302,"_5":14782,"_28250":123274,"_3059":123303},[],"Qué compruebas",{"_3603":73562,"_31069":73551,"_21510":123305,"_5":14782,"_28250":123274,"_3059":123306},[],"Asignación manual",{"_3603":73563,"_31069":73551,"_21510":123308,"_5":14782,"_28250":123274,"_3059":123309},[],"El operador lo crea antes de asociar un certificado.",{"_3603":73564,"_31069":73551,"_21510":123311,"_5":14782,"_28250":123274,"_3059":123312},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3603":73565,"_31069":73551,"_21510":123314,"_5":14782,"_28250":123274,"_3059":123315},[],"EST con `JITP`",{"_3603":73566,"_31069":73551,"_21510":123317,"_5":14782,"_28250":123274,"_3059":123318},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3603":73567,"_31069":73551,"_21510":123320,"_5":14782,"_28250":123274,"_3059":123321},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3603":73568,"_31069":73551,"_21510":123323,"_5":14782,"_28250":123274,"_3059":123324},[],"EST con `PRE_REGISTRATION`",{"_3603":73569,"_31069":73551,"_21510":123326,"_5":14782,"_28250":123274,"_3059":123327},[],"Debe existir antes de `/simpleenroll`.",{"_3603":73570,"_31069":73551,"_21510":123329,"_5":14782,"_28250":123274,"_3059":123330},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3603":73571,"_31069":73551,"_21510":123332,"_5":14782,"_28250":123274,"_3059":123333},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3603":73572,"_31069":73551,"_21510":123335,"_5":14782,"_28250":123274,"_3059":123336},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3603":73573,"_31069":73551,"_21510":123338,"_5":14782,"_28250":123278,"_3059":123339},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3603":73574,"_31069":73551,"_21510":123341,"_5":14782,"_28250":123278,"_3059":123342},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3603":73575,"_31069":73551,"_21510":123344,"_5":14782,"_28250":123278,"_3059":123345},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3603":73576,"_31069":73551,"_21510":123347,"_5":14782,"_28250":123282,"_3059":123348},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3603":73577,"_31069":73551,"_21510":123350,"_5":14782,"_28250":123282,"_3059":123351},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3603":73578,"_31069":73551,"_21510":123353,"_5":14782,"_28250":123282,"_3059":123354},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3603":73579,"_31069":73551,"_21510":123356,"_5":14782,"_28250":123282,"_3059":123357},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3603":73580,"_31069":73551,"_21510":123359,"_5":14782,"_28250":123282,"_3059":123360},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3603":73581,"_31069":73551,"_21510":123362,"_5":14782,"_28250":123282,"_3059":123363},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3603":73582,"_31069":73551,"_21510":123365,"_5":14782,"_28250":123286,"_3059":120125},[],{"_3603":73583,"_31069":73551,"_21510":123367,"_5":14782,"_28250":123286,"_3059":123368},[],"Material que atraviesa EST",{"_3603":73584,"_31069":73551,"_21510":123370,"_5":14782,"_28250":123286,"_3059":123371},[],"Clave generada por el dispositivo",{"_3603":73585,"_31069":73551,"_21510":123373,"_5":14782,"_28250":123286,"_3059":123374},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3603":73586,"_31069":73551,"_21510":123376,"_5":14782,"_28250":123286,"_3059":123377},[],"Clave ya disponible en el dispositivo",{"_3603":73587,"_31069":73551,"_21510":123379,"_5":14782,"_28250":123286,"_3059":123380},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3603":73588,"_31069":73551,"_21510":123382,"_5":14782,"_28250":123286,"_3059":53748},[],{"_3603":73589,"_31069":73551,"_21510":123384,"_5":14782,"_28250":123286,"_3059":123385},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3603":73590,"_31069":73551,"_21510":123387,"_5":14782,"_28250":123286,"_3059":123388},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3603":73591,"_31069":73551,"_21510":123390,"_5":14782,"_28250":123290,"_3059":123391},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3603":73592,"_31069":73592,"_5":15147,"_3059":123393,"_31428":123394,"_21510":123395,"_28250":73592},"Renovación y recuperación",[50742,121227,53426,122372,122550],[],{"_3603":73593,"_31069":73592,"_21510":123397,"_5":14782,"_28250":73592,"_3059":123398},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3603":73594,"_31069":73592,"_5":31425,"_21510":123400,"_28250":123401,"_3059":123402},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3603":73595,"_31069":73592,"_5":31425,"_21510":123404,"_28250":123405,"_3059":123406},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3603":73596,"_31069":73592,"_5":31425,"_21510":123408,"_28250":123409,"_3059":123410},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3603":73597,"_31069":73592,"_5":31425,"_21510":123412,"_28250":123413,"_3059":123414},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3603":73598,"_31069":73592,"_5":31425,"_21510":123416,"_28250":123417,"_3059":123418},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3603":73599,"_31069":73592,"_21510":123420,"_5":14782,"_28250":73592,"_3059":123421},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3603":73600,"_31069":73592,"_21510":123423,"_5":14782,"_28250":123401,"_3059":123424},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3603":73601,"_31069":73592,"_21510":123426,"_5":14782,"_28250":123401,"_3059":123427},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3603":73602,"_31069":73592,"_21510":123429,"_5":14782,"_28250":123401,"_3059":123430},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3603":73603,"_31069":73592,"_21510":123432,"_5":14782,"_28250":123401,"_3059":123433},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3603":73604,"_31069":73592,"_21510":123435,"_5":14782,"_28250":123405,"_3059":123436},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3603":73605,"_31069":73592,"_21510":123438,"_5":14782,"_28250":123405,"_3059":123439},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3603":73606,"_31069":73592,"_21510":123441,"_5":14782,"_28250":123409,"_3059":123442},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3603":73607,"_31069":73592,"_21510":123444,"_5":14782,"_28250":123409,"_3059":123445},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3603":73608,"_31069":73592,"_21510":123447,"_5":14782,"_28250":123409,"_3059":123448},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3603":73609,"_31069":73592,"_21510":123450,"_5":14782,"_28250":123413,"_3059":123451},[],"Situación",{"_3603":73610,"_31069":73592,"_21510":123453,"_5":14782,"_28250":123413,"_3059":123454},[],"Procedimiento",{"_3603":73611,"_31069":73592,"_21510":123456,"_5":14782,"_28250":123413,"_3059":123457},[],"Certificado vigente, fuera de ventana",{"_3603":73612,"_31069":73592,"_21510":123459,"_5":14782,"_28250":123413,"_3059":123460},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3603":73613,"_31069":73592,"_21510":123462,"_5":14782,"_28250":123413,"_3059":123463},[],"Certificado vencido, clave disponible",{"_3603":73614,"_31069":73592,"_21510":123465,"_5":14782,"_28250":123413,"_3059":123466},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3603":73615,"_31069":73592,"_21510":123468,"_5":14782,"_28250":123413,"_3059":123469},[],"Renovación por webhook o `NO_AUTH`",{"_3603":73616,"_31069":73592,"_21510":123471,"_5":14782,"_28250":123413,"_3059":123472},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3603":73617,"_31069":73592,"_21510":123474,"_5":14782,"_28250":123413,"_3059":123475},[],"Clave perdida o inaccesible",{"_3603":73618,"_31069":73592,"_21510":123477,"_5":14782,"_28250":123413,"_3059":123478},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3603":73619,"_31069":73592,"_21510":123480,"_5":14782,"_28250":123413,"_3059":123481},[],"Identidad actual revocada",{"_3603":73620,"_31069":73592,"_21510":123483,"_5":14782,"_28250":123413,"_3059":123484},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3603":73621,"_31069":73592,"_21510":123486,"_5":14782,"_28250":123413,"_3059":123487},[],"Dispositivo sin identidad",{"_3603":73622,"_31069":73592,"_21510":123489,"_5":14782,"_28250":123413,"_3059":123490},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3603":73623,"_31069":73592,"_21510":123492,"_5":14782,"_28250":123413,"_3059":123493},[],"Dispositivo retirado",{"_3603":73624,"_31069":73592,"_21510":123495,"_5":14782,"_28250":123413,"_3059":123496},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3603":73625,"_31069":73592,"_21510":123498,"_5":14782,"_28250":123413,"_3059":123499},[],"Timeout, HTTP 500 o fallo de instalación",{"_3603":73626,"_31069":73592,"_21510":123501,"_5":14782,"_28250":123413,"_3059":123502},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3603":73627,"_31069":73592,"_21510":123504,"_5":14782,"_28250":123417,"_3059":123505},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3603":73628,"_31069":73592,"_21510":123507,"_5":14782,"_28250":123417,"_3059":123508},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3603":73629,"_31069":73629,"_5":15147,"_3059":123510,"_31428":123511,"_21510":123512,"_28250":73629},"Diagnóstico de enrolamiento",[50742,121227,53426,122372,122550],[],{"_3603":73630,"_31069":73629,"_21510":123514,"_5":14782,"_28250":73629,"_3059":123515},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3603":73631,"_31069":73629,"_5":31425,"_21510":123517,"_28250":123518,"_3059":123519},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3603":73632,"_31069":73629,"_5":31425,"_21510":123521,"_28250":123522,"_3059":123523},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3603":73633,"_31069":73629,"_5":31425,"_21510":123525,"_28250":123526,"_3059":123082},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3603":73634,"_31069":73629,"_5":31425,"_21510":123528,"_28250":123529,"_3059":123530},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3603":73635,"_31069":73629,"_21510":123532,"_5":14782,"_28250":73629,"_3059":123533},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3603":73636,"_31069":73629,"_21510":123535,"_5":14782,"_28250":123522,"_3059":123536},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3603":73637,"_31069":73629,"_21510":123538,"_5":14782,"_28250":123522,"_3059":123539},[],"Síntoma o mensaje",{"_3603":73638,"_31069":73629,"_21510":123541,"_5":14782,"_28250":123522,"_3059":123542},[],"Qué revisar",{"_3603":73639,"_31069":73629,"_21510":123544,"_5":14782,"_28250":123522,"_3059":123545},[],"curl rechaza TLS, nombre o emisor",{"_3603":73640,"_31069":73629,"_21510":123547,"_5":14782,"_28250":123522,"_3059":123548},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3603":73641,"_31069":73629,"_21510":123550,"_5":14782,"_28250":123522,"_3059":123551},[],"404 o APS ausente",{"_3603":73642,"_31069":73629,"_21510":123553,"_5":14782,"_28250":123522,"_3059":123554},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3603":73643,"_31069":73629,"_21510":123556,"_5":14782,"_28250":123522,"_3059":123557},[],"400, error de CSR o formato",{"_3603":73644,"_31069":73629,"_21510":123559,"_5":14782,"_28250":123522,"_3059":123560},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3603":73645,"_31069":73629,"_21510":123562,"_5":14782,"_28250":123522,"_3059":123563},[],"Credencial ausente o certificado no válido",{"_3603":73646,"_31069":73629,"_21510":123565,"_5":14782,"_28250":123522,"_3059":123566},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3603":73647,"_31069":73629,"_21510":123568,"_5":14782,"_28250":123522,"_3059":123569},[],"Webhook deniega, expira o responde sin autorización",{"_3603":73648,"_31069":73629,"_21510":123571,"_5":14782,"_28250":123522,"_3059":123572},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3603":73649,"_31069":73629,"_21510":123574,"_5":14782,"_28250":123522,"_3059":54674},[],{"_3603":73650,"_31069":73629,"_21510":123576,"_5":14782,"_28250":123522,"_3059":123577},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3603":73651,"_31069":73629,"_21510":123579,"_5":14782,"_28250":123522,"_3059":54680},[],{"_3603":73652,"_31069":73629,"_21510":123581,"_5":14782,"_28250":123522,"_3059":123582},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3603":73653,"_31069":73629,"_21510":123584,"_5":14782,"_28250":123522,"_3059":54686},[],{"_3603":73654,"_31069":73629,"_21510":123586,"_5":14782,"_28250":123522,"_3059":123587},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3603":73655,"_31069":73629,"_21510":123589,"_5":14782,"_28250":123522,"_3059":54692},[],{"_3603":73656,"_31069":73629,"_21510":123591,"_5":14782,"_28250":123522,"_3059":123592},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3603":73657,"_31069":73629,"_21510":123594,"_5":14782,"_28250":123522,"_3059":54698},[],{"_3603":73658,"_31069":73629,"_21510":123596,"_5":14782,"_28250":123522,"_3059":123597},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3603":73659,"_31069":73629,"_21510":123599,"_5":14782,"_28250":123522,"_3059":123600},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3603":73660,"_31069":73629,"_21510":123602,"_5":14782,"_28250":123522,"_3059":123603},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3603":73661,"_31069":73629,"_21510":123605,"_5":14782,"_28250":123522,"_3059":123606},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3603":73662,"_31069":73629,"_21510":123608,"_5":14782,"_28250":123522,"_3059":123609},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3603":73663,"_31069":73629,"_21510":123611,"_5":14782,"_28250":123522,"_3059":54716},[],{"_3603":73664,"_31069":73629,"_21510":123613,"_5":14782,"_28250":123522,"_3059":123614},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3603":73665,"_31069":73629,"_21510":123616,"_5":14782,"_28250":123522,"_3059":54722},[],{"_3603":73666,"_31069":73629,"_21510":123618,"_5":14782,"_28250":123522,"_3059":123619},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3603":73667,"_31069":73629,"_21510":123621,"_5":14782,"_28250":123522,"_3059":123622},[],"DMS propietario distinto",{"_3603":73668,"_31069":73629,"_21510":123624,"_5":14782,"_28250":123522,"_3059":123625},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3603":73669,"_31069":73629,"_21510":123627,"_5":14782,"_28250":123522,"_3059":54734},[],{"_3603":73670,"_31069":73629,"_21510":123629,"_5":14782,"_28250":123522,"_3059":123630},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3603":73671,"_31069":73629,"_21510":123632,"_5":14782,"_28250":123522,"_3059":54740},[],{"_3603":73672,"_31069":73629,"_21510":123634,"_5":14782,"_28250":123522,"_3059":123635},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3603":73673,"_31069":73629,"_21510":123637,"_5":14782,"_28250":123522,"_3059":123638},[],"Certificado actual revocado",{"_3603":73674,"_31069":73629,"_21510":123640,"_5":14782,"_28250":123522,"_3059":123641},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3603":73675,"_31069":73629,"_21510":123643,"_5":14782,"_28250":123522,"_3059":123644},[],"Error de CA, perfil o firma",{"_3603":73676,"_31069":73629,"_21510":123646,"_5":14782,"_28250":123522,"_3059":123647},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3603":73677,"_31069":73629,"_21510":123649,"_5":14782,"_28250":123522,"_3059":123650},[],"HTTP 200 sin conexión del dispositivo",{"_3603":73678,"_31069":73629,"_21510":123652,"_5":14782,"_28250":123522,"_3059":123653},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3603":73679,"_31069":73629,"_21510":123655,"_5":14782,"_28250":123522,"_3059":123656},[],"Timeout o error después de emitir",{"_3603":73680,"_31069":73629,"_21510":123658,"_5":14782,"_28250":123522,"_3059":123659},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3603":73681,"_31069":73629,"_21510":123661,"_5":14782,"_28250":123526,"_3059":123662},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3603":73682,"_31069":73629,"_21510":123664,"_5":14782,"_28250":123526,"_3059":123665},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3603":73683,"_31069":73629,"_21510":123667,"_5":14782,"_28250":123529,"_3059":123668},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3603":73684,"_31069":73629,"_21510":123670,"_5":14782,"_28250":123529,"_3059":123671},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3603":73685,"_31069":73629,"_21510":123673,"_5":14782,"_28250":123529,"_3059":123674},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3603":73686,"_31069":73629,"_21510":123676,"_5":14782,"_28250":123529,"_3059":123677},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3603":73687,"_31069":73629,"_21510":123679,"_5":14782,"_28250":123529,"_3059":123680},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3603":73688,"_31069":73629,"_21510":123682,"_5":14782,"_28250":123529,"_3059":123683},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3603":73689,"_31069":73629,"_21510":123685,"_5":14782,"_28250":123529,"_3059":123686},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3603":73690,"_31069":73690,"_5":15147,"_3059":123688,"_31428":123689,"_21510":123690,"_28250":73690},"Distribución y actualización de confianza",[50742,121227,53426,122372,122550],[],{"_3603":73691,"_31069":73690,"_21510":123692,"_5":14782,"_28250":73690,"_3059":123693},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3603":73692,"_31069":73690,"_5":31425,"_21510":123695,"_28250":123696,"_3059":123697},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3603":73693,"_31069":73690,"_5":31425,"_21510":123699,"_28250":123700,"_3059":123701},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3603":73694,"_31069":73690,"_5":31425,"_21510":123703,"_28250":123704,"_3059":123705},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3603":73695,"_31069":73690,"_5":31425,"_21510":123707,"_28250":123708,"_3059":123709},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3603":73696,"_31069":73690,"_5":31425,"_21510":123711,"_28250":123712,"_3059":123713},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3603":73697,"_31069":73690,"_21510":123715,"_5":14782,"_28250":73690,"_3059":123716},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3603":73698,"_31069":73690,"_21510":123718,"_5":14782,"_28250":123696,"_3059":123719},[],"Relación",{"_3603":73699,"_31069":73690,"_21510":123721,"_5":14782,"_28250":123696,"_3059":123722},[],"Material que prepara el responsable",{"_3603":73700,"_31069":73690,"_21510":123724,"_5":14782,"_28250":123696,"_3059":123725},[],"Dispositivo → servidor EST",{"_3603":73701,"_31069":73690,"_21510":123727,"_5":14782,"_28250":123696,"_3059":123728},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3603":73702,"_31069":73690,"_21510":123730,"_5":14782,"_28250":123696,"_3059":123731},[],"DMS → solicitante",{"_3603":73703,"_31069":73690,"_21510":123733,"_5":14782,"_28250":123696,"_3059":123734},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3603":73704,"_31069":73690,"_21510":123736,"_5":14782,"_28250":123696,"_3059":123737},[],"Consumidor → dispositivo",{"_3603":73705,"_31069":73690,"_21510":123739,"_5":14782,"_28250":123696,"_3059":123740},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3603":73706,"_31069":73690,"_21510":123742,"_5":14782,"_28250":123696,"_3059":123743},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3603":73707,"_31069":73690,"_21510":123745,"_5":14782,"_28250":123700,"_3059":123746},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3603":73708,"_31069":73690,"_21510":123748,"_5":14782,"_28250":123700,"_3059":123749},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3603":73709,"_31069":73690,"_21510":123751,"_5":14782,"_28250":123704,"_3059":123752},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3603":73710,"_31069":73690,"_21510":123754,"_5":14782,"_28250":123704,"_3059":123755},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3603":73711,"_31069":73690,"_21510":123757,"_5":14782,"_28250":123704,"_3059":123758},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3603":73712,"_31069":73690,"_21510":123760,"_5":14782,"_28250":123704,"_3059":123761},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3603":73713,"_31069":73690,"_21510":123763,"_5":14782,"_28250":123704,"_3059":123764},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3603":73714,"_31069":73690,"_21510":123766,"_5":14782,"_28250":123704,"_3059":123767},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3603":73715,"_31069":73690,"_21510":123769,"_5":14782,"_28250":123708,"_3059":123770},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3603":73716,"_31069":73690,"_21510":123772,"_5":14782,"_28250":123708,"_3059":123773},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3603":73717,"_31069":73690,"_21510":123775,"_5":14782,"_28250":123708,"_3059":123776},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3603":73718,"_31069":73690,"_21510":123778,"_5":14782,"_28250":123712,"_3059":123779},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3603":73719,"_31069":73719,"_5":15147,"_3059":54889,"_31428":123781,"_21510":123783,"_28250":73719},[50742,121227,53426,122372,123782],"Integraciones",[],{"_3603":73720,"_31069":73719,"_21510":123785,"_5":14782,"_28250":73719,"_3059":123786},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3603":73721,"_31069":73719,"_5":31425,"_21510":123788,"_28250":123789,"_3059":123790},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3603":73722,"_31069":73719,"_5":31425,"_21510":123792,"_28250":123793,"_3059":123794},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3603":73723,"_31069":73719,"_5":31425,"_21510":123796,"_28250":123797,"_3059":123798},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3603":73724,"_31069":73719,"_5":31425,"_21510":123800,"_28250":123801,"_3059":123802},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3603":73725,"_31069":73719,"_5":31425,"_21510":123804,"_28250":123805,"_3059":123806},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3603":73726,"_31069":73719,"_5":31425,"_21510":123808,"_28250":123809,"_3059":123810},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3603":73727,"_31069":73719,"_5":31425,"_21510":123812,"_28250":123813,"_3059":123814},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3603":73728,"_31069":73719,"_5":31425,"_21510":123816,"_28250":123817,"_3059":123818},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3603":73729,"_31069":73719,"_5":31425,"_21510":123820,"_28250":123821,"_3059":54931},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3603":73730,"_31069":73719,"_5":31425,"_21510":123823,"_28250":123824,"_3059":54935},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3603":73731,"_31069":73719,"_5":31425,"_21510":123826,"_28250":123827,"_3059":123828},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3603":73732,"_31069":73719,"_5":31425,"_21510":123830,"_28250":123831,"_3059":123832},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3603":73733,"_31069":73719,"_5":31425,"_21510":123834,"_28250":123835,"_3059":123836},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3603":73734,"_31069":73719,"_5":31425,"_21510":123838,"_28250":123839,"_3059":123840},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3603":73735,"_31069":73719,"_5":31425,"_21510":123842,"_28250":123843,"_3059":123844},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3603":73736,"_31069":73719,"_5":31425,"_21510":123846,"_28250":123847,"_3059":123848},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3603":73737,"_31069":73719,"_5":31425,"_21510":123850,"_28250":123851,"_3059":123852},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3603":73738,"_31069":73719,"_5":31425,"_21510":123854,"_28250":123855,"_3059":123856},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3603":73739,"_31069":73719,"_5":31425,"_21510":123858,"_28250":123859,"_3059":123860},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3603":73740,"_31069":73719,"_5":31425,"_21510":123862,"_28250":123863,"_3059":123864},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3603":73741,"_31069":73719,"_5":31425,"_21510":123866,"_28250":123867,"_3059":123868},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3603":73742,"_31069":73719,"_5":31425,"_21510":123870,"_28250":123871,"_3059":123872},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3603":73743,"_31069":73719,"_5":31425,"_21510":123874,"_28250":123875,"_3059":123876},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3603":73744,"_31069":73719,"_5":31425,"_21510":123878,"_28250":123879,"_3059":123880},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3603":73745,"_31069":73719,"_5":31425,"_21510":123882,"_28250":123883,"_3059":123884},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3603":73746,"_31069":73719,"_21510":123886,"_5":14782,"_28250":73719,"_3059":123887},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3603":73747,"_31069":73719,"_21510":123889,"_5":14782,"_28250":73719,"_3059":123890},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3603":73748,"_31069":73719,"_21510":123892,"_5":14782,"_28250":73719,"_3059":123893},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3603":73749,"_31069":73719,"_21510":123895,"_5":14782,"_28250":123789,"_3059":123896},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3603":73750,"_31069":73719,"_21510":123898,"_5":14782,"_28250":123789,"_3059":123899},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3603":73751,"_31069":73719,"_21510":123901,"_5":14782,"_28250":123789,"_3059":123902},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3603":73752,"_31069":73719,"_21510":123904,"_5":14782,"_28250":123789,"_3059":123905},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3603":73753,"_31069":73719,"_21510":123907,"_5":14782,"_28250":123793,"_3059":123908},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3603":73754,"_31069":73719,"_21510":123910,"_5":14782,"_28250":123797,"_3059":123911},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3603":73755,"_31069":73719,"_21510":123913,"_5":14782,"_28250":123797,"_3059":123914},[],"Acción IAM",{"_3603":73756,"_31069":73719,"_21510":123916,"_5":14782,"_28250":123797,"_3059":120131},[],{"_3603":73757,"_31069":73719,"_21510":123918,"_5":14782,"_28250":123797,"_3059":55030},[],{"_3603":73758,"_31069":73719,"_21510":123920,"_5":14782,"_28250":123797,"_3059":123921},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3603":73759,"_31069":73719,"_21510":123923,"_5":14782,"_28250":123797,"_3059":55036},[],{"_3603":73760,"_31069":73719,"_21510":123925,"_5":14782,"_28250":123797,"_3059":123926},[],"Registrar la CA en AWS IoT",{"_3603":73761,"_31069":73719,"_21510":123928,"_5":14782,"_28250":123797,"_3059":55042},[],{"_3603":73762,"_31069":73719,"_21510":123930,"_5":14782,"_28250":123797,"_3059":123931},[],"Consultar el estado del registro de la CA",{"_3603":73763,"_31069":73719,"_21510":123933,"_5":14782,"_28250":123797,"_3059":55048},[],{"_3603":73764,"_31069":73719,"_21510":123935,"_5":14782,"_28250":123797,"_3059":123936},[],"Crear o actualizar Things en IoT Core",{"_3603":73765,"_31069":73719,"_21510":123938,"_5":14782,"_28250":123797,"_3059":55054},[],{"_3603":73766,"_31069":73719,"_21510":123940,"_5":14782,"_28250":123797,"_3059":123941},[],"Aprovisionar Things mediante plantilla",{"_3603":73767,"_31069":73719,"_21510":123943,"_5":14782,"_28250":123797,"_3059":55060},[],{"_3603":73768,"_31069":73719,"_21510":123945,"_5":14782,"_28250":123797,"_3059":123946},[],"Registrar certificados de dispositivo",{"_3603":73769,"_31069":73719,"_21510":123948,"_5":14782,"_28250":123797,"_3059":55066},[],{"_3603":73770,"_31069":73719,"_21510":123950,"_5":14782,"_28250":123797,"_3059":123951},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3603":73771,"_31069":73719,"_21510":123953,"_5":14782,"_28250":123797,"_3059":55072},[],{"_3603":73772,"_31069":73719,"_21510":123955,"_5":14782,"_28250":123797,"_3059":123956},[],"Crear y adjuntar políticas IoT",{"_3603":73773,"_31069":73719,"_21510":123958,"_5":14782,"_28250":123797,"_3059":55078},[],{"_3603":73774,"_31069":73719,"_21510":123960,"_5":14782,"_28250":123797,"_3059":123961},[],"Gestionar grupos de Things",{"_3603":73775,"_31069":73719,"_21510":123963,"_5":14782,"_28250":123797,"_3059":55084},[],{"_3603":73776,"_31069":73719,"_21510":123965,"_5":14782,"_28250":123797,"_3059":123966},[],"Crear plantillas JITP",{"_3603":73777,"_31069":73719,"_21510":123968,"_5":14782,"_28250":123797,"_3059":55090},[],{"_3603":73778,"_31069":73719,"_21510":123970,"_5":14782,"_28250":123797,"_3059":123971},[],"Leer y escribir el Device Shadow",{"_3603":73779,"_31069":73719,"_21510":123973,"_5":14782,"_28250":123797,"_3059":123974},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3603":73780,"_31069":73719,"_21510":123976,"_5":14782,"_28250":123801,"_3059":123977},[],"Parámetro",{"_3603":73781,"_31069":73719,"_21510":123979,"_5":14782,"_28250":123801,"_3059":123980},[],"Tipo",{"_3603":73782,"_31069":73719,"_21510":123982,"_5":14782,"_28250":123801,"_3059":123983},[],"Requerido",{"_3603":73783,"_31069":73719,"_21510":123985,"_5":14782,"_28250":123801,"_3059":123986},[],"Descripción",{"_3603":73784,"_31069":73719,"_21510":123988,"_5":14782,"_28250":123801,"_3059":55111},[],{"_3603":73785,"_31069":73719,"_21510":123990,"_5":14782,"_28250":123801,"_3059":25685},[],{"_3603":73786,"_31069":73719,"_21510":123992,"_5":14782,"_28250":123801,"_3059":123993},[],"Sí",{"_3603":73787,"_31069":73719,"_21510":123995,"_5":14782,"_28250":123801,"_3059":123996},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3603":73788,"_31069":73719,"_21510":123998,"_5":14782,"_28250":123801,"_3059":55122},[],{"_3603":73789,"_31069":73719,"_21510":124000,"_5":14782,"_28250":123801,"_3059":25685},[],{"_3603":73790,"_31069":73719,"_21510":124002,"_5":14782,"_28250":123801,"_3059":123993},[],{"_3603":73791,"_31069":73719,"_21510":124004,"_5":14782,"_28250":123801,"_3059":124005},[],"Región AWS donde opera el conector.",{"_3603":73792,"_31069":73719,"_21510":124007,"_5":14782,"_28250":123801,"_3059":55132},[],{"_3603":73793,"_31069":73719,"_21510":124009,"_5":14782,"_28250":123801,"_3059":25685},[],{"_3603":73794,"_31069":73719,"_21510":124011,"_5":14782,"_28250":123801,"_3059":123993},[],{"_3603":73795,"_31069":73719,"_21510":124013,"_5":14782,"_28250":123801,"_3059":124014},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3603":73796,"_31069":73719,"_21510":124016,"_5":14782,"_28250":123801,"_3059":55142},[],{"_3603":73797,"_31069":73719,"_21510":124018,"_5":14782,"_28250":123801,"_3059":25685},[],{"_3603":73798,"_31069":73719,"_21510":124020,"_5":14782,"_28250":123801,"_3059":124021},[],"Solo con `auth_method=static`",{"_3603":73799,"_31069":73719,"_21510":124023,"_5":14782,"_28250":123801,"_3059":124024},[],"Clave de acceso AWS.",{"_3603":73800,"_31069":73719,"_21510":124026,"_5":14782,"_28250":123801,"_3059":55153},[],{"_3603":73801,"_31069":73719,"_21510":124028,"_5":14782,"_28250":123801,"_3059":25685},[],{"_3603":73802,"_31069":73719,"_21510":124030,"_5":14782,"_28250":123801,"_3059":124021},[],{"_3603":73803,"_31069":73719,"_21510":124032,"_5":14782,"_28250":123801,"_3059":124033},[],"Clave secreta AWS.",{"_3603":73804,"_31069":73719,"_21510":124035,"_5":14782,"_28250":123801,"_3059":55163},[],{"_3603":73805,"_31069":73719,"_21510":124037,"_5":14782,"_28250":123801,"_3059":25685},[],{"_3603":73806,"_31069":73719,"_21510":124039,"_5":14782,"_28250":123801,"_3059":55168},[],{"_3603":73807,"_31069":73719,"_21510":124041,"_5":14782,"_28250":123801,"_3059":124042},[],"Token de sesión (con `auth_method=static`).",{"_3603":73808,"_31069":73719,"_21510":124044,"_5":14782,"_28250":123801,"_3059":55174},[],{"_3603":73809,"_31069":73719,"_21510":124046,"_5":14782,"_28250":123801,"_3059":25685},[],{"_3603":73810,"_31069":73719,"_21510":124048,"_5":14782,"_28250":123801,"_3059":124049},[],"Solo con `auth_method=role`",{"_3603":73811,"_31069":73719,"_21510":124051,"_5":14782,"_28250":123801,"_3059":124052},[],"ARN del rol a asumir.",{"_3603":73812,"_31069":73719,"_21510":124054,"_5":14782,"_28250":123801,"_3059":55185},[],{"_3603":73813,"_31069":73719,"_21510":124056,"_5":14782,"_28250":123801,"_3059":25685},[],{"_3603":73814,"_31069":73719,"_21510":124058,"_5":14782,"_28250":123801,"_3059":55168},[],{"_3603":73815,"_31069":73719,"_21510":124060,"_5":14782,"_28250":123801,"_3059":124061},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3603":73816,"_31069":73719,"_21510":124063,"_5":14782,"_28250":123801,"_3059":55195},[],{"_3603":73817,"_31069":73719,"_21510":124065,"_5":14782,"_28250":123801,"_3059":92476},[],{"_3603":73818,"_31069":73719,"_21510":124067,"_5":14782,"_28250":123801,"_3059":123993},[],{"_3603":73819,"_31069":73719,"_21510":124069,"_5":14782,"_28250":123801,"_3059":124070},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3603":73820,"_31069":73719,"_21510":124072,"_5":14782,"_28250":123801,"_3059":55205},[],{"_3603":73821,"_31069":73719,"_21510":124074,"_5":14782,"_28250":123801,"_3059":25685},[],{"_3603":73822,"_31069":73719,"_21510":124076,"_5":14782,"_28250":123801,"_3059":123993},[],{"_3603":73823,"_31069":73719,"_21510":124078,"_5":14782,"_28250":123801,"_3059":124079},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3603":73824,"_31069":73719,"_21510":124081,"_5":14782,"_28250":123801,"_3059":55215},[],{"_3603":73825,"_31069":73719,"_21510":124083,"_5":14782,"_28250":123801,"_3059":25685},[],{"_3603":73826,"_31069":73719,"_21510":124085,"_5":14782,"_28250":123801,"_3059":123993},[],{"_3603":73827,"_31069":73719,"_21510":124087,"_5":14782,"_28250":123801,"_3059":124088},[],"URL HTTP del Device Manager de Lamassu.",{"_3603":73828,"_31069":73719,"_21510":124090,"_5":14782,"_28250":123801,"_3059":55225},[],{"_3603":73829,"_31069":73719,"_21510":124092,"_5":14782,"_28250":123801,"_3059":25685},[],{"_3603":73830,"_31069":73719,"_21510":124094,"_5":14782,"_28250":123801,"_3059":123993},[],{"_3603":73831,"_31069":73719,"_21510":124096,"_5":14782,"_28250":123801,"_3059":124097},[],"URL HTTP del servicio de CA de Lamassu.",{"_3603":73832,"_31069":73719,"_21510":124099,"_5":14782,"_28250":123805,"_3059":124100},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3603":73833,"_31069":73719,"_21510":124102,"_5":14782,"_28250":123805,"_3059":124103},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3603":73834,"_31069":73719,"_21510":124105,"_5":14782,"_28250":123805,"_3059":124106},[],"Tipo de CloudEvent",{"_3603":73835,"_31069":73719,"_21510":124108,"_5":14782,"_28250":123805,"_3059":124109},[],"Recurso en Lamassu",{"_3603":73836,"_31069":73719,"_21510":124111,"_5":14782,"_28250":123805,"_3059":124112},[],"Recurso AWS",{"_3603":73837,"_31069":73719,"_21510":124114,"_5":14782,"_28250":123805,"_3059":124115},[],"Acciones IAM",{"_3603":73838,"_31069":73719,"_21510":124117,"_5":14782,"_28250":123805,"_3059":124118},[],"Llamadas AWS y efecto",{"_3603":73839,"_31069":73719,"_21510":124120,"_5":14782,"_28250":123805,"_3059":124121},[],"Dónde en esta página",{"_3603":73840,"_31069":73719,"_21510":124123,"_5":14782,"_28250":123805,"_3059":55259},[],{"_3603":73841,"_31069":73719,"_21510":124125,"_5":14782,"_28250":123805,"_3059":55262},[],{"_3603":73842,"_31069":73719,"_21510":124127,"_5":14782,"_28250":123805,"_3059":55265},[],{"_3603":73843,"_31069":73719,"_21510":124129,"_5":14782,"_28250":123805,"_3059":55268},[],{"_3603":73844,"_31069":73719,"_21510":124131,"_5":14782,"_28250":123805,"_3059":124132},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3603":73845,"_31069":73719,"_21510":124134,"_5":14782,"_28250":123805,"_3059":123818},[],{"_3603":73846,"_31069":73719,"_21510":124136,"_5":14782,"_28250":123805,"_3059":55276},[],{"_3603":73847,"_31069":73719,"_21510":124138,"_5":14782,"_28250":123805,"_3059":55279},[],{"_3603":73848,"_31069":73719,"_21510":124140,"_5":14782,"_28250":123805,"_3059":55282},[],{"_3603":73849,"_31069":73719,"_21510":124142,"_5":14782,"_28250":123805,"_3059":55285},[],{"_3603":73850,"_31069":73719,"_21510":124144,"_5":14782,"_28250":123805,"_3059":124145},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3603":73851,"_31069":73719,"_21510":124147,"_5":14782,"_28250":123805,"_3059":123844},[],{"_3603":73852,"_31069":73719,"_21510":124149,"_5":14782,"_28250":123805,"_3059":55293},[],{"_3603":73853,"_31069":73719,"_21510":124151,"_5":14782,"_28250":123805,"_3059":124152},[],"Dispositivo",{"_3603":73854,"_31069":73719,"_21510":124154,"_5":14782,"_28250":123805,"_3059":55299},[],{"_3603":73855,"_31069":73719,"_21510":124156,"_5":14782,"_28250":123805,"_3059":55302},[],{"_3603":73856,"_31069":73719,"_21510":124158,"_5":14782,"_28250":123805,"_3059":124159},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3603":73857,"_31069":73719,"_21510":124161,"_5":14782,"_28250":123805,"_3059":123852},[],{"_3603":73858,"_31069":73719,"_21510":124163,"_5":14782,"_28250":123805,"_3059":55310},[],{"_3603":73859,"_31069":73719,"_21510":124165,"_5":14782,"_28250":123805,"_3059":124166},[],"Certificado",{"_3603":73860,"_31069":73719,"_21510":124168,"_5":14782,"_28250":123805,"_3059":55316},[],{"_3603":73861,"_31069":73719,"_21510":124170,"_5":14782,"_28250":123805,"_3059":124171},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3603":73862,"_31069":73719,"_21510":124173,"_5":14782,"_28250":123805,"_3059":124174},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3603":73863,"_31069":73719,"_21510":124176,"_5":14782,"_28250":123805,"_3059":123864},[],{"_3603":73864,"_31069":73719,"_21510":124178,"_5":14782,"_28250":123805,"_3059":55327},[],{"_3603":73865,"_31069":73719,"_21510":124180,"_5":14782,"_28250":123805,"_3059":124181},[],"Certificado / Dispositivo",{"_3603":73866,"_31069":73719,"_21510":124183,"_5":14782,"_28250":123805,"_3059":55333},[],{"_3603":73867,"_31069":73719,"_21510":124185,"_5":14782,"_28250":123805,"_3059":51138},[],{"_3603":73868,"_31069":73719,"_21510":124187,"_5":14782,"_28250":123805,"_3059":124188},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3603":73869,"_31069":73719,"_21510":124190,"_5":14782,"_28250":123805,"_3059":123872},[],{"_3603":73870,"_31069":73719,"_21510":124192,"_5":14782,"_28250":123809,"_3059":124193},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3603":73871,"_31069":73719,"_21510":124195,"_5":14782,"_28250":123813,"_3059":124196},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3603":73872,"_31069":73719,"_21510":124198,"_5":14782,"_28250":123813,"_3059":124199},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3603":73873,"_31069":73719,"_21510":124201,"_5":14782,"_28250":123817,"_3059":124202},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3603":73874,"_31069":73719,"_21510":124204,"_5":14782,"_28250":123817,"_3059":124205},[],"Transición",{"_3603":73875,"_31069":73719,"_21510":124207,"_5":14782,"_28250":123817,"_3059":124208},[],"Llamadas AWS",{"_3603":73876,"_31069":73719,"_21510":124210,"_5":14782,"_28250":123817,"_3059":124211},[],"`NoRegistrada` → `Solicitada`",{"_3603":73877,"_31069":73719,"_21510":124213,"_5":14782,"_28250":123817,"_3059":124214},[],"ninguna (solo escritura de metadatos)",{"_3603":73878,"_31069":73719,"_21510":124216,"_5":14782,"_28250":123817,"_3059":124217},[],"`Solicitada` → `Registrando`",{"_3603":73879,"_31069":73719,"_21510":124219,"_5":14782,"_28250":123817,"_3059":124220},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3603":73880,"_31069":73719,"_21510":124222,"_5":14782,"_28250":123817,"_3059":124223},[],"`Registrando` → `Completada`",{"_3603":73881,"_31069":73719,"_21510":124225,"_5":14782,"_28250":123817,"_3059":124226},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3603":73882,"_31069":73719,"_21510":124228,"_5":14782,"_28250":123817,"_3059":124229},[],"`Registrando` → `Fallida`",{"_3603":73883,"_31069":73719,"_21510":124231,"_5":14782,"_28250":123817,"_3059":124232},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3603":73884,"_31069":73719,"_21510":124234,"_5":14782,"_28250":123817,"_3059":124235},[],"`Fallida` / `Completada` → `Solicitada`",{"_3603":73885,"_31069":73719,"_21510":124237,"_5":14782,"_28250":123817,"_3059":124238},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3603":73886,"_31069":73719,"_21510":124240,"_5":14782,"_28250":123821,"_3059":124241},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3603":73887,"_31069":73719,"_21510":124243,"_5":14782,"_28250":123821,"_3059":124244},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3603":73888,"_31069":73719,"_21510":124246,"_5":14782,"_28250":123821,"_3059":124247},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3603":73889,"_31069":73719,"_21510":124249,"_5":14782,"_28250":123821,"_3059":124250},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3603":73890,"_31069":73719,"_21510":124252,"_5":14782,"_28250":123821,"_3059":124253},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3603":73891,"_31069":73719,"_21510":124255,"_5":14782,"_28250":123821,"_3059":124256},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3603":73892,"_31069":73719,"_21510":124258,"_5":14782,"_28250":123824,"_3059":124259},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3603":73893,"_31069":73719,"_21510":124261,"_5":14782,"_28250":123827,"_3059":124262},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3603":73894,"_31069":73719,"_21510":124264,"_5":14782,"_28250":123827,"_3059":124265},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3603":73895,"_31069":73719,"_21510":124267,"_5":14782,"_28250":123831,"_3059":124268},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3603":73896,"_31069":73719,"_21510":124270,"_5":14782,"_28250":123835,"_3059":124271},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3603":73897,"_31069":73719,"_21510":124273,"_5":14782,"_28250":123835,"_3059":124274},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3603":73898,"_31069":73719,"_21510":124276,"_5":14782,"_28250":123835,"_3059":124277},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3603":73899,"_31069":73719,"_21510":124279,"_5":14782,"_28250":123835,"_3059":124280},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3603":73900,"_31069":73719,"_21510":124282,"_5":14782,"_28250":123835,"_3059":124283},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3603":73901,"_31069":73719,"_21510":124285,"_5":14782,"_28250":123835,"_3059":124286},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3603":73902,"_31069":73719,"_21510":124288,"_5":14782,"_28250":123839,"_3059":124289},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3603":73903,"_31069":73719,"_21510":124291,"_5":14782,"_28250":123839,"_3059":124292},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3603":73904,"_31069":73719,"_21510":124294,"_5":14782,"_28250":123839,"_3059":124295},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3603":73905,"_31069":73719,"_21510":124297,"_5":14782,"_28250":123839,"_3059":124298},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3603":73906,"_31069":73719,"_21510":124300,"_5":14782,"_28250":123839,"_3059":124301},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3603":73907,"_31069":73719,"_21510":124303,"_5":14782,"_28250":123843,"_3059":124304},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3603":73908,"_31069":73719,"_21510":124306,"_5":14782,"_28250":123843,"_3059":124205},[],{"_3603":73909,"_31069":73719,"_21510":124308,"_5":14782,"_28250":123843,"_3059":124208},[],{"_3603":73910,"_31069":73719,"_21510":124310,"_5":14782,"_28250":123843,"_3059":124311},[],"`SinConfigurar` → `None` / `Auto`",{"_3603":73911,"_31069":73719,"_21510":124313,"_5":14782,"_28250":123843,"_3059":124314},[],"ninguna (solo configuración)",{"_3603":73912,"_31069":73719,"_21510":124316,"_5":14782,"_28250":123843,"_3059":55470},[],{"_3603":73913,"_31069":73719,"_21510":124318,"_5":14782,"_28250":123843,"_3059":124314},[],{"_3603":73914,"_31069":73719,"_21510":124320,"_5":14782,"_28250":123843,"_3059":124321},[],"Cualquiera → `Jitp`",{"_3603":73915,"_31069":73719,"_21510":124323,"_5":14782,"_28250":123843,"_3059":124324},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3603":73916,"_31069":73719,"_21510":124326,"_5":14782,"_28250":123843,"_3059":55481},[],{"_3603":73917,"_31069":73719,"_21510":124328,"_5":14782,"_28250":123843,"_3059":124329},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3603":73918,"_31069":73719,"_21510":124331,"_5":14782,"_28250":123847,"_3059":124332},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3603":73919,"_31069":73719,"_21510":124334,"_5":14782,"_28250":123847,"_3059":124335},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3603":73920,"_31069":73719,"_21510":124337,"_5":14782,"_28250":123847,"_3059":124338},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3603":73921,"_31069":73719,"_21510":124340,"_5":14782,"_28250":123851,"_3059":124341},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3603":73922,"_31069":73719,"_21510":124343,"_5":14782,"_28250":123851,"_3059":124205},[],{"_3603":73923,"_31069":73719,"_21510":124345,"_5":14782,"_28250":123851,"_3059":124208},[],{"_3603":73924,"_31069":73719,"_21510":124347,"_5":14782,"_28250":123851,"_3059":124348},[],"`Ausente` → `Aprovisionado`",{"_3603":73925,"_31069":73719,"_21510":124350,"_5":14782,"_28250":123851,"_3059":124351},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3603":73926,"_31069":73719,"_21510":124353,"_5":14782,"_28250":123851,"_3059":124354},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3603":73927,"_31069":73719,"_21510":124356,"_5":14782,"_28250":123851,"_3059":124357},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3603":73928,"_31069":73719,"_21510":124359,"_5":14782,"_28250":123851,"_3059":124360},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3603":73929,"_31069":73719,"_21510":124362,"_5":14782,"_28250":123855,"_3059":124363},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3603":73930,"_31069":73719,"_21510":124365,"_5":14782,"_28250":123855,"_3059":124366},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3603":73931,"_31069":73719,"_21510":124368,"_5":14782,"_28250":123855,"_3059":124369},[],"Para que el flujo JITP funcione correctamente:",{"_3603":73932,"_31069":73719,"_21510":124371,"_5":14782,"_28250":123855,"_3059":124372},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3603":73933,"_31069":73719,"_21510":124374,"_5":14782,"_28250":123855,"_3059":124375},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3603":73934,"_31069":73719,"_21510":124377,"_5":14782,"_28250":123855,"_3059":124378},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3603":73935,"_31069":73719,"_21510":124380,"_5":14782,"_28250":123855,"_3059":124381},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3603":73936,"_31069":73719,"_21510":124383,"_5":14782,"_28250":123859,"_3059":124384},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3603":73937,"_31069":73719,"_21510":124386,"_5":14782,"_28250":123859,"_3059":124387},[],"Estado en Lamassu",{"_3603":73938,"_31069":73719,"_21510":124389,"_5":14782,"_28250":123859,"_3059":124390},[],"Razón de revocación",{"_3603":73939,"_31069":73719,"_21510":124392,"_5":14782,"_28250":123859,"_3059":124393},[],"Estado en AWS IoT Core",{"_3603":73940,"_31069":73719,"_21510":124395,"_5":14782,"_28250":123859,"_3059":55551},[],{"_3603":73941,"_31069":73719,"_21510":124397,"_5":14782,"_28250":123859,"_3059":124398},[],"Ninguna",{"_3603":73942,"_31069":73719,"_21510":124400,"_5":14782,"_28250":123859,"_3059":55557},[],{"_3603":73943,"_31069":73719,"_21510":124402,"_5":14782,"_28250":123859,"_3059":55560},[],{"_3603":73944,"_31069":73719,"_21510":124404,"_5":14782,"_28250":123859,"_3059":55563},[],{"_3603":73945,"_31069":73719,"_21510":124406,"_5":14782,"_28250":123859,"_3059":55566},[],{"_3603":73946,"_31069":73719,"_21510":124408,"_5":14782,"_28250":123859,"_3059":55560},[],{"_3603":73947,"_31069":73719,"_21510":124410,"_5":14782,"_28250":123859,"_3059":124411},[],"Cualquier otra razón",{"_3603":73948,"_31069":73719,"_21510":124413,"_5":14782,"_28250":123859,"_3059":55574},[],{"_3603":73949,"_31069":73719,"_21510":124415,"_5":14782,"_28250":123859,"_3059":124416},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3603":73950,"_31069":73719,"_21510":124418,"_5":14782,"_28250":123863,"_3059":124419},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3603":73951,"_31069":73719,"_21510":124421,"_5":14782,"_28250":123863,"_3059":124205},[],{"_3603":73952,"_31069":73719,"_21510":124423,"_5":14782,"_28250":123863,"_3059":124208},[],{"_3603":73953,"_31069":73719,"_21510":124425,"_5":14782,"_28250":123863,"_3059":124426},[],"`NoSincronizado` → `Active`",{"_3603":73954,"_31069":73719,"_21510":124428,"_5":14782,"_28250":123863,"_3059":55066},[],{"_3603":73955,"_31069":73719,"_21510":124430,"_5":14782,"_28250":123863,"_3059":55592},[],{"_3603":73956,"_31069":73719,"_21510":124432,"_5":14782,"_28250":123863,"_3059":124433},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3603":73957,"_31069":73719,"_21510":124435,"_5":14782,"_28250":123863,"_3059":55598},[],{"_3603":73958,"_31069":73719,"_21510":124437,"_5":14782,"_28250":123863,"_3059":124433},[],{"_3603":73959,"_31069":73719,"_21510":124439,"_5":14782,"_28250":123863,"_3059":55603},[],{"_3603":73960,"_31069":73719,"_21510":124441,"_5":14782,"_28250":123863,"_3059":55066},[],{"_3603":73961,"_31069":73719,"_21510":124443,"_5":14782,"_28250":123863,"_3059":55608},[],{"_3603":73962,"_31069":73719,"_21510":124445,"_5":14782,"_28250":123863,"_3059":124446},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3603":73963,"_31069":73719,"_21510":124448,"_5":14782,"_28250":123867,"_3059":124449},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3603":73964,"_31069":73719,"_21510":124451,"_5":14782,"_28250":123867,"_3059":124452},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3603":73965,"_31069":73719,"_21510":124454,"_5":14782,"_28250":123867,"_3059":124455},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3603":73966,"_31069":73719,"_21510":124457,"_5":14782,"_28250":123871,"_3059":124458},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3603":73967,"_31069":73719,"_21510":124460,"_5":14782,"_28250":123871,"_3059":124461},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3603":73968,"_31069":73719,"_21510":124463,"_5":14782,"_28250":123875,"_3059":124464},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3603":73969,"_31069":73719,"_21510":124466,"_5":14782,"_28250":123875,"_3059":124467},[],"Existen dos tipos de acciones:",{"_3603":73970,"_31069":73719,"_21510":124469,"_5":14782,"_28250":123875,"_3059":124470},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3603":73971,"_31069":73719,"_21510":124472,"_5":14782,"_28250":123875,"_3059":124473},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3603":73972,"_31069":73719,"_21510":124475,"_5":14782,"_28250":123875,"_3059":124476},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3603":73973,"_31069":73719,"_21510":124478,"_5":14782,"_28250":123879,"_3059":124479},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3603":73974,"_31069":73719,"_21510":124481,"_5":14782,"_28250":123879,"_3059":124482},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3603":73975,"_31069":73719,"_21510":124484,"_5":14782,"_28250":123879,"_3059":124485},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3603":73976,"_31069":73719,"_21510":124487,"_5":14782,"_28250":123883,"_3059":124488},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3603":73977,"_31069":73719,"_21510":124490,"_5":14782,"_28250":123883,"_3059":124491},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3603":73978,"_31069":73719,"_21510":124493,"_5":14782,"_28250":123883,"_3059":124494},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3603":73979,"_31069":73719,"_21510":124496,"_5":14782,"_28250":123883,"_3059":124497},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3603":73980,"_31069":73719,"_21510":124499,"_5":14782,"_28250":123883,"_3059":124500},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3603":73981,"_31069":73719,"_21510":124502,"_5":14782,"_28250":123883,"_3059":124503},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3603":73982,"_31069":73719,"_21510":124505,"_5":14782,"_28250":123883,"_3059":124506},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3603":73983,"_31069":73719,"_21510":124508,"_5":14782,"_28250":123883,"_3059":124509},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3603":73984,"_31069":73719,"_21510":124511,"_5":14782,"_28250":123883,"_3059":124512},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3603":73985,"_31069":73719,"_21510":124514,"_5":14782,"_28250":123883,"_3059":124515},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3603":73986,"_31069":73719,"_21510":124517,"_5":14782,"_28250":123883,"_3059":124518},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3603":73987,"_31069":73719,"_21510":124520,"_5":14782,"_28250":123883,"_3059":124521},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3603":73988,"_31069":73719,"_21510":124523,"_5":14782,"_28250":123883,"_3059":124524},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3603":73989,"_31069":73719,"_21510":124526,"_5":14782,"_28250":123883,"_3059":124527},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3603":73990,"_31069":73719,"_21510":124529,"_5":14782,"_28250":123883,"_3059":124530},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3603":73991,"_31069":73719,"_21510":124532,"_5":14782,"_28250":123883,"_3059":124533},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3603":73992,"_31069":73719,"_21510":124535,"_5":14782,"_28250":123883,"_3059":124536},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3603":73993,"_31069":73719,"_21510":124538,"_5":14782,"_28250":123883,"_3059":124539},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3603":73994,"_31069":73719,"_21510":124541,"_5":14782,"_28250":123883,"_3059":124542},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3603":73995,"_31069":73719,"_21510":124544,"_5":14782,"_28250":123883,"_3059":124545},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3603":73996,"_31069":73719,"_21510":124547,"_5":14782,"_28250":123883,"_3059":124548},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3603":73997,"_31069":73719,"_21510":124550,"_5":14782,"_28250":123883,"_3059":124551},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3603":73998,"_31069":73719,"_21510":124553,"_5":14782,"_28250":123883,"_3059":124554},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3603":73999,"_31069":73719,"_21510":124556,"_5":14782,"_28250":123883,"_3059":124557},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3603":74000,"_31069":74000,"_5":15147,"_3059":53426,"_31428":124559,"_21510":124560,"_28250":74000},[50742,121227,53426],[],{"_3603":74001,"_31069":74000,"_21510":124562,"_5":14782,"_28250":74000,"_3059":124563},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3603":74002,"_31069":74000,"_5":31425,"_21510":124565,"_28250":124566,"_3059":124567},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3603":74003,"_31069":74000,"_5":31425,"_21510":124569,"_28250":124570,"_3059":122372},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3603":74004,"_31069":74000,"_5":31425,"_21510":124572,"_28250":124573,"_3059":122550},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3603":74005,"_31069":74000,"_5":31425,"_21510":124575,"_28250":124576,"_3059":123782},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/overview#integraciones",{"_3603":74006,"_31069":74000,"_5":31425,"_21510":124578,"_28250":124579,"_3059":124580},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3603":74007,"_31069":74000,"_21510":124582,"_5":14782,"_28250":74000,"_3059":124583},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3603":74008,"_31069":74000,"_21510":124585,"_5":14782,"_28250":124566,"_3059":124586},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3603":74009,"_31069":74000,"_21510":124588,"_5":14782,"_28250":124566,"_3059":124589},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3603":74010,"_31069":74000,"_21510":124591,"_5":14782,"_28250":124570,"_3059":124592},[],"Recurso",{"_3603":74011,"_31069":74000,"_21510":124594,"_5":14782,"_28250":124570,"_3059":124595},[],"Qué representa",{"_3603":74012,"_31069":74000,"_21510":124597,"_5":14782,"_28250":124570,"_3059":124598},[],"**Dispositivo**",{"_3603":74013,"_31069":74000,"_21510":124600,"_5":14782,"_28250":124570,"_3059":124601},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3603":74014,"_31069":74000,"_21510":124603,"_5":14782,"_28250":124570,"_3059":124604},[],"**Identidad**",{"_3603":74015,"_31069":74000,"_21510":124606,"_5":14782,"_28250":124570,"_3059":124607},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3603":74016,"_31069":74000,"_21510":124609,"_5":14782,"_28250":124570,"_3059":55775},[],{"_3603":74017,"_31069":74000,"_21510":124611,"_5":14782,"_28250":124570,"_3059":124612},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3603":74018,"_31069":74000,"_21510":124614,"_5":14782,"_28250":124570,"_3059":124615},[],"**Flota**",{"_3603":74019,"_31069":74000,"_21510":124617,"_5":14782,"_28250":124570,"_3059":124618},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3603":74020,"_31069":74000,"_21510":124620,"_5":14782,"_28250":124570,"_3059":124621},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3603":74021,"_31069":74000,"_21510":124623,"_5":14782,"_28250":124570,"_3059":124624},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3603":74022,"_31069":74000,"_21510":124626,"_5":14782,"_28250":124573,"_3059":124627},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3603":74023,"_31069":74000,"_21510":124629,"_5":14782,"_28250":124573,"_3059":124630},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3603":74024,"_31069":74000,"_21510":124632,"_5":14782,"_28250":124573,"_3059":124633},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3603":74025,"_31069":74000,"_21510":124635,"_5":14782,"_28250":124573,"_3059":124636},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3603":74026,"_31069":74000,"_21510":124638,"_5":14782,"_28250":124573,"_3059":124639},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3603":74027,"_31069":74000,"_21510":124641,"_5":14782,"_28250":124573,"_3059":124642},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3603":74028,"_31069":74000,"_21510":124644,"_5":14782,"_28250":124573,"_3059":124645},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3603":74029,"_31069":74000,"_21510":124647,"_5":14782,"_28250":124573,"_3059":124648},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3603":74030,"_31069":74000,"_21510":124650,"_5":14782,"_28250":124576,"_3059":124651},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3603":74031,"_31069":74000,"_21510":124653,"_5":14782,"_28250":124576,"_3059":124654},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3603":74032,"_31069":74000,"_21510":124656,"_5":14782,"_28250":124579,"_3059":124657},[],"Participante",{"_3603":74033,"_31069":74000,"_21510":124659,"_5":14782,"_28250":124579,"_3059":124660},[],"Responsabilidad",{"_3603":74034,"_31069":74000,"_21510":124662,"_5":14782,"_28250":124579,"_3059":124663},[],"Administrador PKI",{"_3603":74035,"_31069":74000,"_21510":124665,"_5":14782,"_28250":124579,"_3059":124666},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3603":74036,"_31069":74000,"_21510":124668,"_5":14782,"_28250":124579,"_3059":124669},[],"Administrador del aprovisionamiento",{"_3603":74037,"_31069":74000,"_21510":124671,"_5":14782,"_28250":124579,"_3059":124672},[],"DMS, admisión, autenticación por operación e inventario.",{"_3603":74038,"_31069":74000,"_21510":124674,"_5":14782,"_28250":124579,"_3059":124675},[],"Integrador del dispositivo",{"_3603":74039,"_31069":74000,"_21510":124677,"_5":14782,"_28250":124579,"_3059":124678},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3603":74040,"_31069":74000,"_21510":124680,"_5":14782,"_28250":124579,"_3059":124681},[],"Integrador del consumidor",{"_3603":74041,"_31069":74000,"_21510":124683,"_5":14782,"_28250":124579,"_3059":124684},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3603":74042,"_31069":74000,"_21510":124686,"_5":14782,"_28250":124579,"_3059":124687},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3603":74043,"_31069":74043,"_5":15147,"_3059":124689,"_31428":124690,"_21510":124692,"_28250":74043},"Enrola y conecta tu primer dispositivo",[50742,121227,53426,124691],"Primeros pasos",[],{"_3603":74044,"_31069":74043,"_21510":124694,"_5":14782,"_28250":74043,"_3059":124695},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3603":74045,"_31069":74043,"_5":31425,"_21510":124697,"_28250":124698,"_3059":119761},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3603":74046,"_31069":74043,"_5":31425,"_21510":124700,"_28250":124701,"_3059":124702},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3603":74047,"_31069":74043,"_5":31425,"_21510":124704,"_28250":124705,"_3059":124706},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3603":74048,"_31069":74043,"_5":31425,"_21510":124708,"_28250":124709,"_3059":124710},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3603":74049,"_31069":74043,"_5":31425,"_21510":124712,"_28250":124713,"_3059":124714},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3603":74050,"_31069":74043,"_5":31425,"_21510":124716,"_28250":124717,"_3059":124718},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3603":74051,"_31069":74043,"_5":31425,"_21510":124720,"_28250":124721,"_3059":124722},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3603":74052,"_31069":74043,"_5":31425,"_21510":124724,"_28250":124725,"_3059":124726},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3603":74053,"_31069":74043,"_21510":124728,"_5":14782,"_28250":74043,"_3059":124729},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3603":74054,"_31069":74043,"_21510":124731,"_5":14782,"_28250":124698,"_3059":124732},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3603":74055,"_31069":74043,"_21510":124734,"_5":14782,"_28250":124698,"_3059":124735},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3603":74056,"_31069":74043,"_21510":124737,"_5":14782,"_28250":124698,"_3059":124738},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3603":74057,"_31069":74043,"_21510":124740,"_5":14782,"_28250":124698,"_3059":124741},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3603":74058,"_31069":74043,"_21510":124743,"_5":14782,"_28250":124698,"_3059":124744},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3603":74059,"_31069":74043,"_21510":124746,"_5":14782,"_28250":124701,"_3059":124747},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3603":74060,"_31069":74043,"_21510":124749,"_5":14782,"_28250":124701,"_3059":124750},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3603":74061,"_31069":74043,"_21510":124752,"_5":14782,"_28250":124705,"_3059":124753},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3603":74062,"_31069":74043,"_21510":124755,"_5":14782,"_28250":124705,"_3059":124756},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3603":74063,"_31069":74043,"_21510":124758,"_5":14782,"_28250":124705,"_3059":124759},[],"Ajuste",{"_3603":74064,"_31069":74043,"_21510":124761,"_5":14782,"_28250":124705,"_3059":124762},[],"Valor de evaluación",{"_3603":74065,"_31069":74043,"_21510":124764,"_5":14782,"_28250":124705,"_3059":55931},[],{"_3603":74066,"_31069":74043,"_21510":124766,"_5":14782,"_28250":124705,"_3059":124767},[],"Raíz emisora de `device-root.pem`.",{"_3603":74067,"_31069":74043,"_21510":124769,"_5":14782,"_28250":124705,"_3059":122678},[],{"_3603":74068,"_31069":74043,"_21510":124771,"_5":14782,"_28250":124705,"_3059":124772},[],"Perfil final de 1 hora que acabas de preparar.",{"_3603":74069,"_31069":74043,"_21510":124774,"_5":14782,"_28250":124705,"_3059":55942},[],{"_3603":74070,"_31069":74043,"_21510":124776,"_5":14782,"_28250":124705,"_3059":55945},[],{"_3603":74071,"_31069":74043,"_21510":124778,"_5":14782,"_28250":124705,"_3059":55948},[],{"_3603":74072,"_31069":74043,"_21510":124780,"_5":14782,"_28250":124705,"_3059":124781},[],"Habilitado.",{"_3603":74073,"_31069":74043,"_21510":124783,"_5":14782,"_28250":124705,"_3059":55954},[],{"_3603":74074,"_31069":74043,"_21510":124785,"_5":14782,"_28250":124705,"_3059":124786},[],"Deshabilitado; el ID debe ser nuevo.",{"_3603":74075,"_31069":74043,"_21510":124788,"_5":14782,"_28250":124705,"_3059":124789},[],"Autenticación inicial",{"_3603":74076,"_31069":74043,"_21510":124791,"_5":14782,"_28250":124705,"_3059":124792},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3603":74077,"_31069":74043,"_21510":124794,"_5":14782,"_28250":124705,"_3059":124795},[],"Autenticación de renovación",{"_3603":74078,"_31069":74043,"_21510":124797,"_5":14782,"_28250":124705,"_3059":124798},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3603":74079,"_31069":74043,"_21510":124800,"_5":14782,"_28250":124705,"_3059":55972},[],{"_3603":74080,"_31069":74043,"_21510":124802,"_5":14782,"_28250":124705,"_3059":124803},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3603":74081,"_31069":74043,"_21510":124805,"_5":14782,"_28250":124705,"_3059":55978},[],{"_3603":74082,"_31069":74043,"_21510":124807,"_5":14782,"_28250":124705,"_3059":124808},[],"1 hora.",{"_3603":74083,"_31069":74043,"_21510":124810,"_5":14782,"_28250":124705,"_3059":55984},[],{"_3603":74084,"_31069":74043,"_21510":124812,"_5":14782,"_28250":124705,"_3059":124813},[],"30 minutos / 10 minutos.",{"_3603":74085,"_31069":74043,"_21510":124815,"_5":14782,"_28250":124705,"_3059":55990},[],{"_3603":74086,"_31069":74043,"_21510":124817,"_5":14782,"_28250":124705,"_3059":124818},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3603":74087,"_31069":74043,"_21510":124820,"_5":14782,"_28250":124705,"_3059":53748},[],{"_3603":74088,"_31069":74043,"_21510":124822,"_5":14782,"_28250":124705,"_3059":124823},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3603":74089,"_31069":74043,"_21510":124825,"_5":14782,"_28250":124705,"_3059":56001},[],{"_3603":74090,"_31069":74043,"_21510":124827,"_5":14782,"_28250":124705,"_3059":124828},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3603":74091,"_31069":74043,"_21510":124830,"_5":14782,"_28250":124705,"_3059":124831},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3603":74092,"_31069":74043,"_21510":124833,"_5":14782,"_28250":124709,"_3059":124834},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3603":74093,"_31069":74043,"_21510":124836,"_5":14782,"_28250":124709,"_3059":124837},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3603":74094,"_31069":74043,"_21510":124839,"_5":14782,"_28250":124713,"_3059":124840},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3603":74095,"_31069":74043,"_21510":124842,"_5":14782,"_28250":124713,"_3059":124843},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3603":74096,"_31069":74043,"_21510":124845,"_5":14782,"_28250":124713,"_3059":124846},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3603":74097,"_31069":74043,"_21510":124848,"_5":14782,"_28250":124717,"_3059":124849},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3603":74098,"_31069":74043,"_21510":124851,"_5":14782,"_28250":124717,"_3059":124852},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3603":74099,"_31069":74043,"_21510":124854,"_5":14782,"_28250":124721,"_3059":124855},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3603":74100,"_31069":74043,"_21510":124857,"_5":14782,"_28250":124721,"_3059":124858},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3603":74101,"_31069":74043,"_21510":124860,"_5":14782,"_28250":124721,"_3059":124861},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3603":74102,"_31069":74043,"_21510":124863,"_5":14782,"_28250":124721,"_3059":124864},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3603":74103,"_31069":74043,"_21510":124866,"_5":14782,"_28250":124721,"_3059":124867},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3603":74104,"_31069":74043,"_21510":124869,"_5":14782,"_28250":124725,"_3059":124870},[],"Comprobación",{"_3603":74105,"_31069":74043,"_21510":124872,"_5":14782,"_28250":124725,"_3059":124873},[],"Resultado esperado",{"_3603":74106,"_31069":74043,"_21510":124875,"_5":14782,"_28250":124725,"_3059":124876},[],"Registro",{"_3603":74107,"_31069":74043,"_21510":124878,"_5":14782,"_28250":124725,"_3059":124879},[],"ID creado automáticamente y DMS correcto.",{"_3603":74108,"_31069":74043,"_21510":124881,"_5":14782,"_28250":124725,"_3059":124166},[],{"_3603":74109,"_31069":74043,"_21510":124883,"_5":14782,"_28250":124725,"_3059":124884},[],"CN, perfil, serie y clave verificados.",{"_3603":74110,"_31069":74043,"_21510":124886,"_5":14782,"_28250":124725,"_3059":124887},[],"Inventario",{"_3603":74111,"_31069":74043,"_21510":124889,"_5":14782,"_28250":124725,"_3059":124890},[],"Serie recibida visible como identidad actual y en el historial.",{"_3603":74112,"_31069":74043,"_21510":124892,"_5":14782,"_28250":124725,"_3059":124893},[],"Consumidor",{"_3603":74113,"_31069":74043,"_21510":124895,"_5":14782,"_28250":124725,"_3059":124896},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3603":74114,"_31069":74043,"_21510":124898,"_5":14782,"_28250":124725,"_3059":124899},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3603":74115,"_31069":74043,"_21510":124901,"_5":14782,"_28250":124725,"_3059":124902},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3603":74116,"_31069":74116,"_5":15147,"_3059":122389,"_31428":124904,"_21510":124905,"_28250":74116},[50742,121227,53426,124691],[],{"_3603":74117,"_31069":74116,"_21510":124907,"_5":14782,"_28250":74116,"_3059":124908},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3603":74118,"_31069":74116,"_5":31425,"_21510":124910,"_28250":124911,"_3059":119761},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3603":74119,"_31069":74116,"_5":31425,"_21510":124913,"_28250":124914,"_3059":124915},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3603":74120,"_31069":74116,"_5":31425,"_21510":124917,"_28250":124918,"_3059":124919},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3603":74121,"_31069":74116,"_5":31425,"_21510":124921,"_28250":124922,"_3059":124923},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3603":74122,"_31069":74116,"_5":31425,"_21510":124925,"_28250":124926,"_3059":124927},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3603":74123,"_31069":74116,"_5":31425,"_21510":124929,"_28250":124930,"_3059":124931},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3603":74124,"_31069":74116,"_5":31425,"_21510":124933,"_28250":124934,"_3059":124873},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3603":74125,"_31069":74116,"_5":31425,"_21510":124936,"_28250":124937,"_3059":124938},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3603":74126,"_31069":74116,"_5":31425,"_21510":124940,"_28250":124941,"_3059":124942},[],"/docs/pr-preview/pr-74/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3603":74127,"_31069":74116,"_21510":124944,"_5":14782,"_28250":74116,"_3059":124945},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3603":74128,"_31069":74116,"_21510":124947,"_5":14782,"_28250":74116,"_3059":124948},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3603":74129,"_31069":74116,"_21510":124950,"_5":14782,"_28250":124911,"_3059":124951},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3603":74130,"_31069":74116,"_21510":124953,"_5":14782,"_28250":124911,"_3059":124954},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3603":74131,"_31069":74116,"_21510":124956,"_5":14782,"_28250":124911,"_3059":124957},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3603":74132,"_31069":74116,"_21510":124959,"_5":14782,"_28250":124911,"_3059":124960},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3603":74133,"_31069":74116,"_21510":124962,"_5":14782,"_28250":124914,"_3059":124963},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3603":74134,"_31069":74116,"_21510":124965,"_5":14782,"_28250":124914,"_3059":124966},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3603":74135,"_31069":74116,"_21510":124968,"_5":14782,"_28250":124914,"_3059":124969},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3603":74136,"_31069":74116,"_21510":124971,"_5":14782,"_28250":124914,"_3059":124972},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3603":74137,"_31069":74116,"_21510":124974,"_5":14782,"_28250":124914,"_3059":124975},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3603":74138,"_31069":74116,"_21510":124977,"_5":14782,"_28250":124914,"_3059":124978},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3603":74139,"_31069":74116,"_21510":124980,"_5":14782,"_28250":124914,"_3059":124981},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3603":74140,"_31069":74116,"_21510":124983,"_5":14782,"_28250":124914,"_3059":124984},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3603":74141,"_31069":74116,"_21510":124986,"_5":14782,"_28250":124918,"_3059":124987},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3603":74142,"_31069":74116,"_21510":124989,"_5":14782,"_28250":124918,"_3059":56166},[],{"_3603":74143,"_31069":74116,"_21510":124991,"_5":14782,"_28250":124918,"_3059":124992},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3603":74144,"_31069":74116,"_21510":124994,"_5":14782,"_28250":124918,"_3059":124995},[],"**Icon** y **Tags**: clasificación opcional.",{"_3603":74145,"_31069":74116,"_21510":124997,"_5":14782,"_28250":124918,"_3059":124998},[],"Confirma el registro.",{"_3603":74146,"_31069":74116,"_21510":125000,"_5":14782,"_28250":124922,"_3059":125001},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3603":74147,"_31069":74116,"_21510":125003,"_5":14782,"_28250":124922,"_3059":125004},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3603":74148,"_31069":74116,"_21510":125006,"_5":14782,"_28250":124926,"_3059":125007},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3603":74149,"_31069":74116,"_21510":125009,"_5":14782,"_28250":124926,"_3059":125010},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3603":74150,"_31069":74116,"_21510":125012,"_5":14782,"_28250":124930,"_3059":125013},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3603":74151,"_31069":74116,"_21510":125015,"_5":14782,"_28250":124930,"_3059":125016},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3603":74152,"_31069":74116,"_21510":125018,"_5":14782,"_28250":124934,"_3059":124870},[],{"_3603":74153,"_31069":74116,"_21510":125020,"_5":14782,"_28250":124934,"_3059":125021},[],"Resultado",{"_3603":74154,"_31069":74116,"_21510":125023,"_5":14782,"_28250":124934,"_3059":124152},[],{"_3603":74155,"_31069":74116,"_21510":125025,"_5":14782,"_28250":124934,"_3059":125026},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3603":74156,"_31069":74116,"_21510":125028,"_5":14782,"_28250":124934,"_3059":125029},[],"Identidad actual",{"_3603":74157,"_31069":74116,"_21510":125031,"_5":14782,"_28250":124934,"_3059":125032},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3603":74158,"_31069":74116,"_21510":125034,"_5":14782,"_28250":124934,"_3059":125035},[],"Historial",{"_3603":74159,"_31069":74116,"_21510":125037,"_5":14782,"_28250":124934,"_3059":125038},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3603":74160,"_31069":74116,"_21510":125040,"_5":14782,"_28250":124934,"_3059":125041},[],"Clave y certificado",{"_3603":74161,"_31069":74116,"_21510":125043,"_5":14782,"_28250":124934,"_3059":125044},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3603":74162,"_31069":74116,"_21510":125046,"_5":14782,"_28250":124937,"_3059":125047},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3603":74163,"_31069":74116,"_21510":125049,"_5":14782,"_28250":124937,"_3059":125050},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3603":74164,"_31069":74116,"_21510":125052,"_5":14782,"_28250":124937,"_3059":125053},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3603":74165,"_31069":74116,"_21510":125055,"_5":14782,"_28250":124937,"_3059":125056},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3603":74166,"_31069":74116,"_21510":125058,"_5":14782,"_28250":124941,"_3059":125059},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3603":74167,"_31069":74116,"_21510":125061,"_5":14782,"_28250":124941,"_3059":125062},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3603":74168,"_31069":74116,"_21510":125064,"_5":14782,"_28250":124941,"_3059":125065},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3603":74169,"_31069":74169,"_5":15147,"_3059":125067,"_31428":125068,"_21510":125069,"_28250":74169},"Plataforma Lamassu IoT",[50742,121227],[],{"_3603":74170,"_31069":74169,"_21510":125071,"_5":14782,"_28250":74169,"_3059":125072},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3603":74171,"_31069":74169,"_5":31425,"_21510":125074,"_28250":125075,"_3059":124567},[],"/docs/pr-preview/pr-74/es/platform/overview#empieza-aquí",{"_3603":74172,"_31069":74169,"_5":31425,"_21510":125077,"_28250":125078,"_3059":125079},[],"/docs/pr-preview/pr-74/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3603":74173,"_31069":74169,"_5":31425,"_21510":125081,"_28250":125082,"_3059":125083},[],"/docs/pr-preview/pr-74/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3603":74174,"_31069":74169,"_5":31425,"_21510":125085,"_28250":125086,"_3059":125087},[],"/docs/pr-preview/pr-74/es/platform/overview#capacidades-principales","Capacidades principales",{"_3603":74175,"_31069":74169,"_5":31425,"_21510":125089,"_28250":125090,"_3059":125091},[],"/docs/pr-preview/pr-74/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3603":74176,"_31069":74169,"_5":31425,"_21510":125093,"_28250":125094,"_3059":125095},[],"/docs/pr-preview/pr-74/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3603":74177,"_31069":74169,"_5":31425,"_21510":125097,"_28250":125098,"_3059":125099},[],"/docs/pr-preview/pr-74/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3603":74178,"_31069":74169,"_5":31425,"_21510":125101,"_28250":125102,"_3059":125103},[],"/docs/pr-preview/pr-74/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3603":74179,"_31069":74169,"_5":31425,"_21510":125105,"_28250":125106,"_3059":125107},[],"/docs/pr-preview/pr-74/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3603":74180,"_31069":74169,"_5":31425,"_21510":125109,"_28250":125110,"_3059":125111},[],"/docs/pr-preview/pr-74/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3603":74181,"_31069":74169,"_5":31425,"_21510":125113,"_28250":125114,"_3059":125115},[],"/docs/pr-preview/pr-74/es/platform/overview#referencia-operativa","Referencia operativa",{"_3603":74182,"_31069":74169,"_21510":125117,"_5":14782,"_28250":74169,"_3059":125118},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3603":74183,"_31069":74169,"_21510":125120,"_5":14782,"_28250":125075,"_3059":125121},[],"Elige el resultado que necesitas obtener:",{"_3603":74184,"_31069":74169,"_21510":125123,"_5":14782,"_28250":125075,"_3059":125124},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3603":74185,"_31069":74169,"_21510":125126,"_5":14782,"_28250":125075,"_3059":125127},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3603":74186,"_31069":74169,"_21510":125129,"_5":14782,"_28250":125075,"_3059":125130},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3603":74187,"_31069":74169,"_21510":125132,"_5":14782,"_28250":125078,"_3059":125133},[],"Bloque",{"_3603":74188,"_31069":74169,"_21510":125135,"_5":14782,"_28250":125078,"_3059":125136},[],"Qué gestionas",{"_3603":74189,"_31069":74169,"_21510":125138,"_5":14782,"_28250":125078,"_3059":125139},[],"Punto de entrada",{"_3603":74190,"_31069":74169,"_21510":125141,"_5":14782,"_28250":125078,"_3059":56319},[],{"_3603":74191,"_31069":74169,"_21510":125143,"_5":14782,"_28250":125078,"_3059":125144},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3603":74192,"_31069":74169,"_21510":125146,"_5":14782,"_28250":125078,"_3059":125147},[],"Visión general de PKI",{"_3603":74193,"_31069":74169,"_21510":125149,"_5":14782,"_28250":125078,"_3059":56328},[],{"_3603":74194,"_31069":74169,"_21510":125151,"_5":14782,"_28250":125078,"_3059":125152},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3603":74195,"_31069":74169,"_21510":125154,"_5":14782,"_28250":125078,"_3059":125155},[],"Visión general de IoT Fleets",{"_3603":74196,"_31069":74169,"_21510":125157,"_5":14782,"_28250":125078,"_3059":125158},[],"**Administración**",{"_3603":74197,"_31069":74169,"_21510":125160,"_5":14782,"_28250":125078,"_3059":125161},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3603":74198,"_31069":74169,"_21510":125163,"_5":14782,"_28250":125078,"_3059":121229},[],{"_3603":74199,"_31069":74169,"_21510":125165,"_5":14782,"_28250":125078,"_3059":125166},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3603":74200,"_31069":74169,"_21510":125168,"_5":14782,"_28250":125082,"_3059":125169},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3603":74201,"_31069":74169,"_21510":125171,"_5":14782,"_28250":125082,"_3059":125172},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3603":74202,"_31069":74169,"_21510":125174,"_5":14782,"_28250":125082,"_3059":125175},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3603":74203,"_31069":74169,"_21510":125177,"_5":14782,"_28250":125082,"_3059":125178},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3603":74204,"_31069":74169,"_21510":125180,"_5":14782,"_28250":125082,"_3059":125181},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3603":74205,"_31069":74169,"_21510":125183,"_5":14782,"_28250":125082,"_3059":125184},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3603":74206,"_31069":74169,"_21510":125186,"_5":14782,"_28250":125090,"_3059":125187},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3603":74207,"_31069":74169,"_21510":125189,"_5":14782,"_28250":125094,"_3059":125190},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3603":74208,"_31069":74169,"_21510":125192,"_5":14782,"_28250":125098,"_3059":125193},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3603":74209,"_31069":74169,"_21510":125195,"_5":14782,"_28250":125102,"_3059":125196},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3603":74210,"_31069":74169,"_21510":125198,"_5":14782,"_28250":125106,"_3059":125199},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3603":74211,"_31069":74169,"_21510":125201,"_5":14782,"_28250":125110,"_3059":125202},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3603":74212,"_31069":74169,"_21510":125204,"_5":14782,"_28250":125114,"_3059":124660},[],{"_3603":74213,"_31069":74169,"_21510":125206,"_5":14782,"_28250":125114,"_3059":125207},[],"Qué prepara o comprueba",{"_3603":74214,"_31069":74169,"_21510":125209,"_5":14782,"_28250":125114,"_3059":124663},[],{"_3603":74215,"_31069":74169,"_21510":125211,"_5":14782,"_28250":125114,"_3059":125212},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3603":74216,"_31069":74169,"_21510":125214,"_5":14782,"_28250":125114,"_3059":125215},[],"Administrador de la flota",{"_3603":74217,"_31069":74169,"_21510":125217,"_5":14782,"_28250":125114,"_3059":125218},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3603":74218,"_31069":74169,"_21510":125220,"_5":14782,"_28250":125114,"_3059":124675},[],{"_3603":74219,"_31069":74169,"_21510":125222,"_5":14782,"_28250":125114,"_3059":125223},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3603":74220,"_31069":74169,"_21510":125225,"_5":14782,"_28250":125114,"_3059":124681},[],{"_3603":74221,"_31069":74169,"_21510":125227,"_5":14782,"_28250":125114,"_3059":125228},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3603":74222,"_31069":74169,"_21510":125230,"_5":14782,"_28250":125114,"_3059":125231},[],"Operador de infraestructura",{"_3603":74223,"_31069":74169,"_21510":125233,"_5":14782,"_28250":125114,"_3059":125234},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3603":74224,"_31069":74169,"_21510":125236,"_5":14782,"_28250":125114,"_3059":125237},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3603":74225,"_31069":74225,"_5":15147,"_3059":125239,"_31428":125240,"_21510":125242,"_28250":74225},"Jerarquía y rotación de CAs",[50742,121227,56420,125241],"Claves, autoridades y certificados",[],{"_3603":74226,"_31069":74225,"_21510":125244,"_5":14782,"_28250":74225,"_3059":125245},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3603":74227,"_31069":74225,"_5":31425,"_21510":125247,"_28250":125248,"_3059":125249},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3603":74228,"_31069":74225,"_5":31425,"_21510":125251,"_28250":125252,"_3059":125253},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3603":74229,"_31069":74225,"_5":31425,"_21510":125255,"_28250":125256,"_3059":125257},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3603":74230,"_31069":74225,"_5":31425,"_21510":125259,"_28250":125260,"_3059":125261},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3603":74231,"_31069":74225,"_5":31425,"_21510":125263,"_28250":125264,"_3059":125265},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3603":74232,"_31069":74225,"_5":31425,"_21510":125267,"_28250":125268,"_3059":125269},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3603":74233,"_31069":74225,"_5":31425,"_21510":125271,"_28250":125272,"_3059":125273},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3603":74234,"_31069":74225,"_5":31425,"_21510":125275,"_28250":125276,"_3059":125277},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3603":74235,"_31069":74225,"_5":31425,"_21510":125279,"_28250":125280,"_3059":125281},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3603":74236,"_31069":74225,"_5":31425,"_21510":125283,"_28250":125284,"_3059":125285},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3603":74237,"_31069":74225,"_5":31425,"_21510":125287,"_28250":125288,"_3059":125289},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3603":74238,"_31069":74225,"_5":31425,"_21510":125291,"_28250":125292,"_3059":125293},[],"/docs/pr-preview/pr-74/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3603":74239,"_31069":74225,"_21510":125295,"_5":14782,"_28250":74225,"_3059":125296},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3603":74240,"_31069":74225,"_21510":125298,"_5":14782,"_28250":74225,"_3059":125299},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3603":74241,"_31069":74225,"_21510":125301,"_5":14782,"_28250":125248,"_3059":125302},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3603":74242,"_31069":74225,"_21510":125304,"_5":14782,"_28250":125248,"_3059":125305},[],"entorno, como producción y preproducción;",{"_3603":74243,"_31069":74225,"_21510":125307,"_5":14782,"_28250":125248,"_3059":125308},[],"propietario o equipo operador;",{"_3603":74244,"_31069":74225,"_21510":125310,"_5":14782,"_28250":125248,"_3059":125311},[],"familia de dispositivos o proceso de fabricación;",{"_3603":74245,"_31069":74225,"_21510":125313,"_5":14782,"_28250":125248,"_3059":125314},[],"región o requisito regulatorio;",{"_3603":74246,"_31069":74225,"_21510":125316,"_5":14782,"_28250":125248,"_3059":125317},[],"motor criptográfico o política de clave;",{"_3603":74247,"_31069":74225,"_21510":125319,"_5":14782,"_28250":125248,"_3059":125320},[],"ventana de mantenimiento y ritmo de renovación.",{"_3603":74248,"_31069":74225,"_21510":125322,"_5":14782,"_28250":125248,"_3059":125323},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3603":74249,"_31069":74225,"_21510":125325,"_5":14782,"_28250":125248,"_3059":125326},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3603":74250,"_31069":74225,"_21510":125328,"_5":14782,"_28250":125252,"_3059":125329},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3603":74251,"_31069":74225,"_21510":125331,"_5":14782,"_28250":125252,"_3059":125332},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3603":74252,"_31069":74225,"_21510":125334,"_5":14782,"_28250":125252,"_3059":125335},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3603":74253,"_31069":74225,"_21510":125337,"_5":14782,"_28250":125252,"_3059":125338},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3603":74254,"_31069":74225,"_21510":125340,"_5":14782,"_28250":125256,"_3059":125341},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3603":74255,"_31069":74225,"_21510":125343,"_5":14782,"_28250":125256,"_3059":125344},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3603":74256,"_31069":74225,"_21510":125346,"_5":14782,"_28250":125256,"_3059":125347},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3603":74257,"_31069":74225,"_21510":125349,"_5":14782,"_28250":125256,"_3059":125350},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3603":74258,"_31069":74225,"_21510":125352,"_5":14782,"_28250":125264,"_3059":125353},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3603":74259,"_31069":74225,"_21510":125355,"_5":14782,"_28250":125268,"_3059":125356},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3603":74260,"_31069":74225,"_21510":125358,"_5":14782,"_28250":125272,"_3059":125359},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3603":74261,"_31069":74225,"_21510":125361,"_5":14782,"_28250":125276,"_3059":125362},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3603":74262,"_31069":74225,"_21510":125364,"_5":14782,"_28250":125280,"_3059":125365},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3603":74263,"_31069":74225,"_21510":125367,"_5":14782,"_28250":125284,"_3059":125368},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3603":74264,"_31069":74225,"_21510":125370,"_5":14782,"_28250":125288,"_3059":125371},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3603":74265,"_31069":74225,"_21510":125373,"_5":14782,"_28250":125288,"_3059":125374},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3603":74266,"_31069":74225,"_21510":125376,"_5":14782,"_28250":125288,"_3059":125377},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3603":74267,"_31069":74225,"_21510":125379,"_5":14782,"_28250":125288,"_3059":125380},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3603":74268,"_31069":74225,"_21510":125382,"_5":14782,"_28250":125292,"_3059":125383},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3603":74269,"_31069":74225,"_21510":125385,"_5":14782,"_28250":125292,"_3059":125386},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3603":74270,"_31069":74225,"_21510":125388,"_5":14782,"_28250":125292,"_3059":125389},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3603":74271,"_31069":74225,"_21510":125391,"_5":14782,"_28250":125292,"_3059":125392},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3603":74272,"_31069":74225,"_21510":125394,"_5":14782,"_28250":125292,"_3059":125395},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3603":74273,"_31069":74225,"_21510":125397,"_5":14782,"_28250":125292,"_3059":125398},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3603":74274,"_31069":74225,"_21510":125400,"_5":14782,"_28250":125292,"_3059":125401},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3603":74275,"_31069":74275,"_5":15147,"_3059":125403,"_31428":125404,"_21510":125405,"_28250":74275},"Autoridades de certificación",[50742,121227,56420,125241],[],{"_3603":74276,"_31069":74275,"_21510":125407,"_5":14782,"_28250":74275,"_3059":125408},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3603":74277,"_31069":74275,"_5":31425,"_21510":125410,"_28250":125411,"_3059":125412},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3603":74278,"_31069":74275,"_5":31425,"_21510":125414,"_28250":125415,"_3059":125416},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3603":74279,"_31069":74275,"_5":31425,"_21510":125418,"_28250":125419,"_3059":119761},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3603":74280,"_31069":74275,"_5":31425,"_21510":125421,"_28250":125422,"_3059":125423},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3603":74281,"_31069":74275,"_5":31425,"_21510":125425,"_28250":125426,"_3059":125427},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3603":74282,"_31069":74275,"_5":31425,"_21510":125429,"_28250":125430,"_3059":125431},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3603":74283,"_31069":74275,"_5":31425,"_21510":125433,"_28250":125434,"_3059":125435},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3603":74284,"_31069":74275,"_5":31425,"_21510":125437,"_28250":125438,"_3059":125439},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3603":74285,"_31069":74275,"_5":31425,"_21510":125441,"_28250":125442,"_3059":125443},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3603":74286,"_31069":74275,"_5":31425,"_21510":125445,"_28250":125446,"_3059":125447},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3603":74287,"_31069":74275,"_5":31425,"_21510":125449,"_28250":125450,"_3059":125451},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3603":74288,"_31069":74275,"_5":31425,"_21510":125453,"_28250":125454,"_3059":125455},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3603":74289,"_31069":74275,"_5":31425,"_21510":125457,"_28250":125458,"_3059":125459},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3603":74290,"_31069":74275,"_5":31425,"_21510":125461,"_28250":125462,"_3059":125463},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3603":74291,"_31069":74275,"_5":31425,"_21510":125465,"_28250":125466,"_3059":125467},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3603":74292,"_31069":74275,"_5":31425,"_21510":125469,"_28250":125470,"_3059":125471},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3603":74293,"_31069":74275,"_5":31425,"_21510":125473,"_28250":125474,"_3059":125475},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3603":74294,"_31069":74275,"_5":31425,"_21510":125477,"_28250":125478,"_3059":125479},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3603":74295,"_31069":74275,"_5":31425,"_21510":125481,"_28250":125482,"_3059":125483},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3603":74296,"_31069":74275,"_5":31425,"_21510":125485,"_28250":125486,"_3059":125487},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3603":74297,"_31069":74275,"_5":31425,"_21510":125489,"_28250":125490,"_3059":125491},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3603":74298,"_31069":74275,"_5":31425,"_21510":125493,"_28250":125494,"_3059":125495},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3603":74299,"_31069":74275,"_5":31425,"_21510":125497,"_28250":125498,"_3059":125499},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3603":74300,"_31069":74275,"_21510":125501,"_5":14782,"_28250":74275,"_3059":125502},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3603":74301,"_31069":74275,"_21510":125504,"_5":14782,"_28250":74275,"_3059":125505},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3603":74302,"_31069":74275,"_21510":125507,"_5":14782,"_28250":74275,"_3059":125508},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3603":74303,"_31069":74275,"_21510":125510,"_5":14782,"_28250":125411,"_3059":125511},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3603":74304,"_31069":74275,"_21510":125513,"_5":14782,"_28250":125411,"_3059":125514},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3603":74305,"_31069":74275,"_21510":125516,"_5":14782,"_28250":125411,"_3059":125517},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3603":74306,"_31069":74275,"_21510":125519,"_5":14782,"_28250":125411,"_3059":125520},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3603":74307,"_31069":74275,"_21510":125522,"_5":14782,"_28250":125411,"_3059":125523},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3603":74308,"_31069":74275,"_21510":125525,"_5":14782,"_28250":125419,"_3059":125526},[],"Decide si la CA será raíz o intermedia.",{"_3603":74309,"_31069":74275,"_21510":125528,"_5":14782,"_28250":125419,"_3059":125529},[],"Elige el motor que custodiará la clave.",{"_3603":74310,"_31069":74275,"_21510":125531,"_5":14782,"_28250":125419,"_3059":125532},[],"Define una validez superior a la de los certificados que emitirá.",{"_3603":74311,"_31069":74275,"_21510":125534,"_5":14782,"_28250":125419,"_3059":125535},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3603":74312,"_31069":74275,"_21510":125537,"_5":14782,"_28250":125422,"_3059":125538},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3603":74313,"_31069":74275,"_21510":125540,"_5":14782,"_28250":125426,"_3059":125541},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3603":74314,"_31069":74275,"_21510":125543,"_5":14782,"_28250":125426,"_3059":125544},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3603":74315,"_31069":74275,"_21510":125546,"_5":14782,"_28250":125430,"_3059":125547},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3603":74316,"_31069":74275,"_21510":125549,"_5":14782,"_28250":125434,"_3059":125550},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3603":74317,"_31069":74275,"_21510":125552,"_5":14782,"_28250":125434,"_3059":125553},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3603":74318,"_31069":74275,"_21510":125555,"_5":14782,"_28250":125434,"_3059":125556},[],"`ST`: estado o provincia.",{"_3603":74319,"_31069":74275,"_21510":125558,"_5":14782,"_28250":125434,"_3059":125559},[],"`L`: localidad.",{"_3603":74320,"_31069":74275,"_21510":125561,"_5":14782,"_28250":125434,"_3059":125562},[],"`O`: organización.",{"_3603":74321,"_31069":74275,"_21510":125564,"_5":14782,"_28250":125434,"_3059":125565},[],"`OU`: unidad organizativa.",{"_3603":74322,"_31069":74275,"_21510":125567,"_5":14782,"_28250":125434,"_3059":125568},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3603":74323,"_31069":74275,"_21510":125570,"_5":14782,"_28250":125438,"_3059":125571},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3603":74324,"_31069":74275,"_21510":125573,"_5":14782,"_28250":125438,"_3059":125574},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3603":74325,"_31069":74275,"_21510":125576,"_5":14782,"_28250":125442,"_3059":125577},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3603":74326,"_31069":74275,"_21510":125579,"_5":14782,"_28250":125442,"_3059":125580},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3603":74327,"_31069":74275,"_21510":125582,"_5":14782,"_28250":125446,"_3059":125583},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3603":74328,"_31069":74275,"_21510":125585,"_5":14782,"_28250":125446,"_3059":125586},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3603":74329,"_31069":74275,"_21510":125588,"_5":14782,"_28250":125450,"_3059":125589},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3603":74330,"_31069":74275,"_21510":125591,"_5":14782,"_28250":125450,"_3059":125592},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3603":74331,"_31069":74275,"_21510":125594,"_5":14782,"_28250":125450,"_3059":125595},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3603":74332,"_31069":74275,"_21510":125597,"_5":14782,"_28250":125454,"_3059":125598},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3603":74333,"_31069":74275,"_21510":125600,"_5":14782,"_28250":125458,"_3059":125601},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3603":74334,"_31069":74275,"_21510":125603,"_5":14782,"_28250":125458,"_3059":125604},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3603":74335,"_31069":74275,"_21510":125606,"_5":14782,"_28250":125462,"_3059":125607},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3603":74336,"_31069":74275,"_21510":125609,"_5":14782,"_28250":125466,"_3059":125610},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3603":74337,"_31069":74275,"_21510":125612,"_5":14782,"_28250":125466,"_3059":125613},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3603":74338,"_31069":74275,"_21510":125615,"_5":14782,"_28250":125470,"_3059":125616},[],"Abre una CA desde el inventario para consultar:",{"_3603":74339,"_31069":74275,"_21510":125618,"_5":14782,"_28250":125470,"_3059":125619},[],"Estado y periodo de validez.",{"_3603":74340,"_31069":74275,"_21510":125621,"_5":14782,"_28250":125470,"_3059":125622},[],"Certificado y cadena en formato PEM.",{"_3603":74341,"_31069":74275,"_21510":125624,"_5":14782,"_28250":125470,"_3059":125625},[],"Número de certificados activos, expirados y revocados.",{"_3603":74342,"_31069":74275,"_21510":125627,"_5":14782,"_28250":125470,"_3059":125628},[],"Certificados emitidos en **Issued Certificates**.",{"_3603":74343,"_31069":74275,"_21510":125630,"_5":14782,"_28250":125470,"_3059":125631},[],"CRL vinculada a la autoridad.",{"_3603":74344,"_31069":74275,"_21510":125633,"_5":14782,"_28250":125470,"_3059":125634},[],"Metadatos y motor criptográfico asociado.",{"_3603":74345,"_31069":74275,"_21510":125636,"_5":14782,"_28250":125470,"_3059":125637},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3603":74346,"_31069":74275,"_21510":125639,"_5":14782,"_28250":125474,"_3059":125640},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3603":74347,"_31069":74275,"_21510":125642,"_5":14782,"_28250":125474,"_3059":125643},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3603":74348,"_31069":74275,"_21510":125645,"_5":14782,"_28250":125474,"_3059":125646},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3603":74349,"_31069":74275,"_21510":125648,"_5":14782,"_28250":125474,"_3059":125649},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3603":74350,"_31069":74275,"_21510":125651,"_5":14782,"_28250":125474,"_3059":125652},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3603":74351,"_31069":74275,"_21510":125654,"_5":14782,"_28250":125474,"_3059":125655},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3603":74352,"_31069":74275,"_21510":125657,"_5":14782,"_28250":125478,"_3059":125658},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3603":74353,"_31069":74275,"_21510":125660,"_5":14782,"_28250":125482,"_3059":125661},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3603":74354,"_31069":74275,"_21510":125663,"_5":14782,"_28250":125486,"_3059":125664},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3603":74355,"_31069":74275,"_21510":125666,"_5":14782,"_28250":125490,"_3059":125667},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3603":74356,"_31069":74275,"_21510":125669,"_5":14782,"_28250":125494,"_3059":125670},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3603":74357,"_31069":74275,"_21510":125672,"_5":14782,"_28250":125498,"_3059":125673},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3603":74358,"_31069":74275,"_21510":125675,"_5":14782,"_28250":125498,"_3059":125676},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3603":74359,"_31069":74275,"_21510":125678,"_5":14782,"_28250":125498,"_3059":125679},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3603":74360,"_31069":74275,"_21510":125681,"_5":14782,"_28250":125498,"_3059":125682},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3603":74361,"_31069":74361,"_5":15147,"_3059":125684,"_31428":125685,"_21510":125686,"_28250":74361},"Perfiles de certificado",[50742,121227,56420,125241],[],{"_3603":74362,"_31069":74361,"_21510":125688,"_5":14782,"_28250":74361,"_3059":125689},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3603":74363,"_31069":74361,"_5":31425,"_21510":125691,"_28250":125692,"_3059":125693},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3603":74364,"_31069":74361,"_5":31425,"_21510":125695,"_28250":125696,"_3059":125697},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#validez","Validez",{"_3603":74365,"_31069":74361,"_5":31425,"_21510":125699,"_28250":125700,"_3059":125701},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3603":74366,"_31069":74361,"_5":31425,"_21510":125703,"_28250":125704,"_3059":125705},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3603":74367,"_31069":74361,"_5":31425,"_21510":125707,"_28250":125708,"_3059":125709},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3603":74368,"_31069":74361,"_5":31425,"_21510":125711,"_28250":125712,"_3059":125713},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3603":74369,"_31069":74361,"_5":31425,"_21510":125715,"_28250":125716,"_3059":125717},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3603":74370,"_31069":74361,"_5":31425,"_21510":125719,"_28250":125720,"_3059":125721},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3603":74371,"_31069":74361,"_5":31425,"_21510":125723,"_28250":125724,"_3059":125725},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3603":74372,"_31069":74361,"_5":31425,"_21510":125727,"_28250":125728,"_3059":125729},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3603":74373,"_31069":74361,"_5":31425,"_21510":125731,"_28250":125732,"_3059":125733},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3603":74374,"_31069":74361,"_5":31425,"_21510":125735,"_28250":125736,"_3059":125737},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3603":74375,"_31069":74361,"_5":31425,"_21510":125739,"_28250":125740,"_3059":125741},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3603":74376,"_31069":74361,"_5":31425,"_21510":125743,"_28250":125744,"_3059":125745},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3603":74377,"_31069":74361,"_5":31425,"_21510":125747,"_28250":125748,"_3059":125749},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3603":74378,"_31069":74361,"_5":31425,"_21510":125751,"_28250":125752,"_3059":125753},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3603":74379,"_31069":74361,"_21510":125755,"_5":14782,"_28250":74361,"_3059":125756},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3603":74380,"_31069":74361,"_21510":125758,"_5":14782,"_28250":74361,"_3059":125759},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3603":74381,"_31069":74361,"_21510":125761,"_5":14782,"_28250":125696,"_3059":125762},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3603":74382,"_31069":74361,"_21510":125764,"_5":14782,"_28250":125696,"_3059":125765},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3603":74383,"_31069":74361,"_21510":125767,"_5":14782,"_28250":125700,"_3059":125768},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3603":74384,"_31069":74361,"_21510":125770,"_5":14782,"_28250":125704,"_3059":125771},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3603":74385,"_31069":74361,"_21510":125773,"_5":14782,"_28250":125704,"_3059":125774},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3603":74386,"_31069":74361,"_21510":125776,"_5":14782,"_28250":125704,"_3059":125777},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3603":74387,"_31069":74361,"_21510":125779,"_5":14782,"_28250":125708,"_3059":125780},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3603":74388,"_31069":74361,"_21510":125782,"_5":14782,"_28250":125712,"_3059":125783},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3603":74389,"_31069":74361,"_21510":125785,"_5":14782,"_28250":125712,"_3059":125786},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3603":74390,"_31069":74361,"_21510":125788,"_5":14782,"_28250":125716,"_3059":125789},[],"La aplicación criptográfica puede:",{"_3603":74391,"_31069":74361,"_21510":125791,"_5":14782,"_28250":125716,"_3059":125792},[],"permitir o bloquear claves RSA;",{"_3603":74392,"_31069":74361,"_21510":125794,"_5":14782,"_28250":125716,"_3059":125795},[],"limitar los tamaños RSA admitidos;",{"_3603":74393,"_31069":74361,"_21510":125797,"_5":14782,"_28250":125716,"_3059":125798},[],"permitir o bloquear claves ECDSA;",{"_3603":74394,"_31069":74361,"_21510":125800,"_5":14782,"_28250":125716,"_3059":125801},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3603":74395,"_31069":74361,"_21510":125803,"_5":14782,"_28250":125716,"_3059":125804},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3603":74396,"_31069":74361,"_21510":125806,"_5":14782,"_28250":125720,"_3059":125807},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3603":74397,"_31069":74361,"_21510":125809,"_5":14782,"_28250":125720,"_3059":120987},[],{"_3603":74398,"_31069":74361,"_21510":125811,"_5":14782,"_28250":125720,"_3059":125812},[],"Primera opción",{"_3603":74399,"_31069":74361,"_21510":125814,"_5":14782,"_28250":125720,"_3059":125815},[],"Segunda opción",{"_3603":74400,"_31069":74361,"_21510":125817,"_5":14782,"_28250":125720,"_3059":125818},[],"Si no hay ninguna",{"_3603":74401,"_31069":74361,"_21510":125820,"_5":14782,"_28250":125720,"_3059":125821},[],"Firma directa con una CA",{"_3603":74402,"_31069":74361,"_21510":125823,"_5":14782,"_28250":125720,"_3059":125824},[],"`issuance_profile` incluido en la solicitud",{"_3603":74403,"_31069":74361,"_21510":125826,"_5":14782,"_28250":125720,"_3059":125827},[],"`issuance_profile_id` de la solicitud",{"_3603":74404,"_31069":74361,"_21510":125829,"_5":14782,"_28250":125720,"_3059":125830},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3603":74405,"_31069":74361,"_21510":125832,"_5":14782,"_28250":125720,"_3059":125833},[],"Emisión mediante DMS",{"_3603":74406,"_31069":74361,"_21510":125835,"_5":14782,"_28250":125720,"_3059":57016},[],{"_3603":74407,"_31069":74361,"_21510":125837,"_5":14782,"_28250":125720,"_3059":125838},[],"`settings.issuance_profile` incluido en el DMS",{"_3603":74408,"_31069":74361,"_21510":125840,"_5":14782,"_28250":125720,"_3059":125841},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3603":74409,"_31069":74361,"_21510":125843,"_5":14782,"_28250":125720,"_3059":125844},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3603":74410,"_31069":74361,"_21510":125846,"_5":14782,"_28250":125720,"_3059":125847},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3603":74411,"_31069":74361,"_21510":125849,"_5":14782,"_28250":125728,"_3059":125850},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3603":74412,"_31069":74361,"_21510":125852,"_5":14782,"_28250":125732,"_3059":125853},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3603":74413,"_31069":74361,"_21510":125855,"_5":14782,"_28250":125736,"_3059":125856},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3603":74414,"_31069":74361,"_21510":125858,"_5":14782,"_28250":125740,"_3059":125859},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3603":74415,"_31069":74361,"_21510":125861,"_5":14782,"_28250":125744,"_3059":125862},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3603":74416,"_31069":74361,"_21510":125864,"_5":14782,"_28250":125744,"_3059":125865},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3603":74417,"_31069":74361,"_21510":125867,"_5":14782,"_28250":125748,"_3059":125868},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3603":74418,"_31069":74361,"_21510":125870,"_5":14782,"_28250":125748,"_3059":125871},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3603":74419,"_31069":74361,"_21510":125873,"_5":14782,"_28250":125748,"_3059":125874},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3603":74420,"_31069":74361,"_21510":125876,"_5":14782,"_28250":125748,"_3059":125877},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3603":74421,"_31069":74361,"_21510":125879,"_5":14782,"_28250":125752,"_3059":125880},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3603":74422,"_31069":74361,"_21510":125882,"_5":14782,"_28250":125752,"_3059":125883},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3603":74423,"_31069":74423,"_5":15147,"_3059":125885,"_31428":125886,"_21510":125888,"_28250":74423},"Validación de certificados",[50742,121227,56420,125887],"Validación",[],{"_3603":74424,"_31069":74423,"_21510":125890,"_5":14782,"_28250":74423,"_3059":125891},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3603":74425,"_31069":74423,"_5":31425,"_21510":125893,"_28250":125894,"_3059":125895},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3603":74426,"_31069":74423,"_5":31425,"_21510":125897,"_28250":125898,"_3059":125899},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3603":74427,"_31069":74423,"_5":31425,"_21510":125901,"_28250":125902,"_3059":125903},[],"/docs/pr-preview/pr-74/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3603":74428,"_31069":74423,"_21510":125905,"_5":14782,"_28250":74423,"_3059":125906},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3603":74429,"_31069":74423,"_21510":125908,"_5":14782,"_28250":125894,"_3059":125909},[],"Verifica estos criterios juntos:",{"_3603":74430,"_31069":74423,"_21510":125911,"_5":14782,"_28250":125894,"_3059":124870},[],{"_3603":74431,"_31069":74423,"_21510":125913,"_5":14782,"_28250":125894,"_3059":125914},[],"Resultado necesario",{"_3603":74432,"_31069":74423,"_21510":125916,"_5":14782,"_28250":125894,"_3059":125917},[],"Cadena y firma",{"_3603":74433,"_31069":74423,"_21510":125919,"_5":14782,"_28250":125894,"_3059":125920},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3603":74434,"_31069":74423,"_21510":125922,"_5":14782,"_28250":125894,"_3059":125923},[],"Fechas",{"_3603":74435,"_31069":74423,"_21510":125925,"_5":14782,"_28250":125894,"_3059":125926},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3603":74436,"_31069":74423,"_21510":125928,"_5":14782,"_28250":125894,"_3059":120897},[],{"_3603":74437,"_31069":74423,"_21510":125930,"_5":14782,"_28250":125894,"_3059":125931},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3603":74438,"_31069":74423,"_21510":125933,"_5":14782,"_28250":125894,"_3059":125934},[],"Uso",{"_3603":74439,"_31069":74423,"_21510":125936,"_5":14782,"_28250":125894,"_3059":125937},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3603":74440,"_31069":74423,"_21510":125939,"_5":14782,"_28250":125894,"_3059":125940},[],"Revocación",{"_3603":74441,"_31069":74423,"_21510":125942,"_5":14782,"_28250":125894,"_3059":125943},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3603":74442,"_31069":74423,"_21510":125945,"_5":14782,"_28250":125894,"_3059":125946},[],"Autorización",{"_3603":74443,"_31069":74423,"_21510":125948,"_5":14782,"_28250":125894,"_3059":125949},[],"La aplicación permite la acción a esa identidad.",{"_3603":74444,"_31069":74423,"_21510":125951,"_5":14782,"_28250":125894,"_3059":125952},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3603":74445,"_31069":74423,"_21510":125954,"_5":14782,"_28250":125898,"_3059":125955},[],"Mecanismo",{"_3603":74446,"_31069":74423,"_21510":125957,"_5":14782,"_28250":125898,"_3059":125958},[],"Cuándo utilizarlo",{"_3603":74447,"_31069":74423,"_21510":125960,"_5":14782,"_28250":125898,"_3059":125961},[],"Qué debes mantener",{"_3603":74448,"_31069":74423,"_21510":125963,"_5":14782,"_28250":125898,"_3059":57144},[],{"_3603":74449,"_31069":74423,"_21510":125965,"_5":14782,"_28250":125898,"_3059":125966},[],"Consulta del estado de un certificado concreto.",{"_3603":74450,"_31069":74423,"_21510":125968,"_5":14782,"_28250":125898,"_3059":125969},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3603":74451,"_31069":74423,"_21510":125971,"_5":14782,"_28250":125898,"_3059":57153},[],{"_3603":74452,"_31069":74423,"_21510":125973,"_5":14782,"_28250":125898,"_3059":125974},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3603":74453,"_31069":74423,"_21510":125976,"_5":14782,"_28250":125898,"_3059":125977},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3603":74454,"_31069":74423,"_21510":125979,"_5":14782,"_28250":125898,"_3059":125980},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3603":74455,"_31069":74423,"_21510":125982,"_5":14782,"_28250":125898,"_3059":125983},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3603":74456,"_31069":74423,"_21510":125985,"_5":14782,"_28250":125902,"_3059":125986},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3603":74457,"_31069":74423,"_21510":125988,"_5":14782,"_28250":125902,"_3059":125989},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3603":74458,"_31069":74423,"_21510":125991,"_5":14782,"_28250":125902,"_3059":125992},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3603":74459,"_31069":74423,"_21510":125994,"_5":14782,"_28250":125902,"_3059":125995},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3603":74460,"_31069":74423,"_21510":125997,"_5":14782,"_28250":125902,"_3059":125998},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3603":74461,"_31069":74423,"_21510":126000,"_5":14782,"_28250":125902,"_3059":126001},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3603":74462,"_31069":74423,"_21510":126003,"_5":14782,"_28250":125902,"_3059":126004},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3603":74463,"_31069":74423,"_21510":126006,"_5":14782,"_28250":125902,"_3059":126007},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3603":74464,"_31069":74423,"_21510":126009,"_5":14782,"_28250":125902,"_3059":126010},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3603":74465,"_31069":74465,"_5":15147,"_3059":126012,"_31428":126013,"_21510":126014,"_28250":74465},"Certificados",[50742,121227,56420,125241],[],{"_3603":74466,"_31069":74465,"_21510":126016,"_5":14782,"_28250":74465,"_3059":126017},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3603":74467,"_31069":74465,"_5":31425,"_21510":126019,"_28250":126020,"_3059":126021},[],"/docs/pr-preview/pr-74/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3603":74468,"_31069":74465,"_5":31425,"_21510":126023,"_28250":126024,"_3059":126025},[],"/docs/pr-preview/pr-74/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3603":74469,"_31069":74465,"_5":31425,"_21510":126027,"_28250":126028,"_3059":126029},[],"/docs/pr-preview/pr-74/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3603":74470,"_31069":74465,"_5":31425,"_21510":126031,"_28250":126032,"_3059":126033},[],"/docs/pr-preview/pr-74/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3603":74471,"_31069":74465,"_5":31425,"_21510":126035,"_28250":126036,"_3059":126037},[],"/docs/pr-preview/pr-74/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3603":74472,"_31069":74465,"_5":31425,"_21510":126039,"_28250":126040,"_3059":126041},[],"/docs/pr-preview/pr-74/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3603":74473,"_31069":74465,"_5":31425,"_21510":126043,"_28250":126044,"_3059":126045},[],"/docs/pr-preview/pr-74/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3603":74474,"_31069":74465,"_5":31425,"_21510":126047,"_28250":126048,"_3059":126049},[],"/docs/pr-preview/pr-74/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3603":74475,"_31069":74465,"_5":31425,"_21510":126051,"_28250":126052,"_3059":126053},[],"/docs/pr-preview/pr-74/es/platform/pki/certificates#continúa","Continúa",{"_3603":74476,"_31069":74465,"_21510":126055,"_5":14782,"_28250":74465,"_3059":126056},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3603":74477,"_31069":74465,"_21510":126058,"_5":14782,"_28250":126020,"_3059":126059},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3603":74478,"_31069":74465,"_21510":126061,"_5":14782,"_28250":126020,"_3059":126062},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3603":74479,"_31069":74465,"_21510":126064,"_5":14782,"_28250":126020,"_3059":126065},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3603":74480,"_31069":74465,"_21510":126067,"_5":14782,"_28250":126020,"_3059":126068},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3603":74481,"_31069":74465,"_21510":126070,"_5":14782,"_28250":126020,"_3059":126071},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3603":74482,"_31069":74465,"_21510":126073,"_5":14782,"_28250":126020,"_3059":126074},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3603":74483,"_31069":74465,"_21510":126076,"_5":14782,"_28250":126020,"_3059":126077},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3603":74484,"_31069":74465,"_21510":126079,"_5":14782,"_28250":126024,"_3059":126080},[],"Descarga el PEM e inspecciónalo:",{"_3603":74485,"_31069":74465,"_21510":126082,"_5":14782,"_28250":126024,"_3059":126083},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3603":74486,"_31069":74465,"_21510":126085,"_5":14782,"_28250":126028,"_3059":126086},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3603":74487,"_31069":74465,"_21510":126088,"_5":14782,"_28250":126028,"_3059":126089},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3603":74488,"_31069":74465,"_21510":126091,"_5":14782,"_28250":126028,"_3059":126092},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3603":74489,"_31069":74465,"_21510":126094,"_5":14782,"_28250":126028,"_3059":126095},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3603":74490,"_31069":74465,"_21510":126097,"_5":14782,"_28250":126028,"_3059":126098},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3603":74491,"_31069":74465,"_21510":126100,"_5":14782,"_28250":126028,"_3059":126101},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3603":74492,"_31069":74465,"_21510":126103,"_5":14782,"_28250":126028,"_3059":126104},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3603":74493,"_31069":74465,"_21510":126106,"_5":14782,"_28250":126032,"_3059":126107},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3603":74494,"_31069":74465,"_21510":126109,"_5":14782,"_28250":126036,"_3059":126110},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3603":74495,"_31069":74465,"_21510":126112,"_5":14782,"_28250":126040,"_3059":126113},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3603":74496,"_31069":74465,"_21510":126115,"_5":14782,"_28250":126044,"_3059":126116},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3603":74497,"_31069":74465,"_21510":126118,"_5":14782,"_28250":126044,"_3059":126119},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3603":74498,"_31069":74465,"_21510":126121,"_5":14782,"_28250":126044,"_3059":126122},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3603":74499,"_31069":74465,"_21510":126124,"_5":14782,"_28250":126048,"_3059":126125},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3603":74500,"_31069":74465,"_21510":126127,"_5":14782,"_28250":126048,"_3059":126128},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3603":74501,"_31069":74465,"_21510":126130,"_5":14782,"_28250":126048,"_3059":126131},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3603":74502,"_31069":74465,"_21510":126133,"_5":14782,"_28250":126052,"_3059":126134},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3603":74503,"_31069":74465,"_21510":126136,"_5":14782,"_28250":126052,"_3059":126137},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3603":74504,"_31069":74504,"_5":15147,"_3059":126139,"_31428":126140,"_21510":126142,"_28250":74504},"Ciclo de vida de un certificado",[50742,121227,56420,126141],"Conceptos",[],{"_3603":74505,"_31069":74504,"_21510":126144,"_5":14782,"_28250":74504,"_3059":126145},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3603":74506,"_31069":74504,"_5":31425,"_21510":126147,"_28250":126148,"_3059":126149},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3603":74507,"_31069":74504,"_5":31425,"_21510":126151,"_28250":126152,"_3059":126153},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3603":74508,"_31069":74504,"_5":31425,"_21510":126155,"_28250":126156,"_3059":126157},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3603":74509,"_31069":74504,"_5":31425,"_21510":126159,"_28250":126160,"_3059":126161},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3603":74510,"_31069":74504,"_5":31425,"_21510":126163,"_28250":126164,"_3059":126165},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3603":74511,"_31069":74504,"_5":31425,"_21510":126167,"_28250":126168,"_3059":126169},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3603":74512,"_31069":74504,"_5":31425,"_21510":126171,"_28250":126172,"_3059":123864},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3603":74513,"_31069":74504,"_5":31425,"_21510":126174,"_28250":126175,"_3059":126176},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3603":74514,"_31069":74504,"_5":31425,"_21510":126178,"_28250":126179,"_3059":126180},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3603":74515,"_31069":74504,"_5":31425,"_21510":126182,"_28250":126183,"_3059":126184},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3603":74516,"_31069":74504,"_21510":126186,"_5":14782,"_28250":74504,"_3059":126187},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3603":74517,"_31069":74504,"_21510":126189,"_5":14782,"_28250":126152,"_3059":126190},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3603":74518,"_31069":74504,"_21510":126192,"_5":14782,"_28250":126156,"_3059":126193},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3603":74519,"_31069":74504,"_21510":126195,"_5":14782,"_28250":126160,"_3059":126196},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3603":74520,"_31069":74504,"_21510":126198,"_5":14782,"_28250":126164,"_3059":126199},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3603":74521,"_31069":74504,"_21510":126201,"_5":14782,"_28250":126168,"_3059":126202},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3603":74522,"_31069":74504,"_21510":126204,"_5":14782,"_28250":126172,"_3059":126205},[],"Lamassu persiste cuatro estados X.509:",{"_3603":74523,"_31069":74504,"_21510":126207,"_5":14782,"_28250":126172,"_3059":126208},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3603":74524,"_31069":74504,"_21510":126210,"_5":14782,"_28250":126172,"_3059":126211},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3603":74525,"_31069":74504,"_21510":126213,"_5":14782,"_28250":126172,"_3059":126214},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3603":74526,"_31069":74504,"_21510":126216,"_5":14782,"_28250":126172,"_3059":126217},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3603":74527,"_31069":74504,"_21510":126219,"_5":14782,"_28250":126172,"_3059":126220},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3603":74528,"_31069":74504,"_21510":126222,"_5":14782,"_28250":126175,"_3059":126223},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3603":74529,"_31069":74504,"_21510":126225,"_5":14782,"_28250":126175,"_3059":126226},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3603":74530,"_31069":74504,"_21510":126228,"_5":14782,"_28250":126175,"_3059":126229},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3603":74531,"_31069":74504,"_21510":126231,"_5":14782,"_28250":126179,"_3059":126232},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3603":74532,"_31069":74504,"_21510":126234,"_5":14782,"_28250":126179,"_3059":126235},[],"Antes de confirmar:",{"_3603":74533,"_31069":74504,"_21510":126237,"_5":14782,"_28250":126179,"_3059":126238},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3603":74534,"_31069":74504,"_21510":126240,"_5":14782,"_28250":126179,"_3059":126241},[],"Distribuye la nueva cadena de confianza.",{"_3603":74535,"_31069":74504,"_21510":126243,"_5":14782,"_28250":126179,"_3059":126244},[],"Reemite las identidades necesarias.",{"_3603":74536,"_31069":74504,"_21510":126246,"_5":14782,"_28250":126179,"_3059":126247},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3603":74537,"_31069":74504,"_21510":126249,"_5":14782,"_28250":126179,"_3059":126250},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3603":74538,"_31069":74504,"_21510":126252,"_5":14782,"_28250":126179,"_3059":126253},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3603":74539,"_31069":74504,"_21510":126255,"_5":14782,"_28250":126183,"_3059":126256},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3603":74540,"_31069":74504,"_21510":126258,"_5":14782,"_28250":126183,"_3059":126259},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3603":74541,"_31069":74504,"_21510":126261,"_5":14782,"_28250":126183,"_3059":126262},[],"Cambios de estado y razones de revocación.",{"_3603":74542,"_31069":74504,"_21510":126264,"_5":14782,"_28250":126183,"_3059":126265},[],"Publicación y vigencia de OCSP y CRLs.",{"_3603":74543,"_31069":74504,"_21510":126267,"_5":14782,"_28250":126183,"_3059":126268},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3603":74544,"_31069":74504,"_21510":126270,"_5":14782,"_28250":126183,"_3059":126271},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3603":74545,"_31069":74545,"_5":15147,"_3059":126273,"_31428":126274,"_21510":126275,"_28250":74545},"Modelo de confianza",[50742,121227,56420,126141],[],{"_3603":74546,"_31069":74545,"_21510":126277,"_5":14782,"_28250":74545,"_3059":126278},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3603":74547,"_31069":74545,"_5":31425,"_21510":126280,"_28250":126281,"_3059":126282},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3603":74548,"_31069":74545,"_5":31425,"_21510":126284,"_28250":126285,"_3059":126286},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3603":74549,"_31069":74545,"_5":31425,"_21510":126288,"_28250":126289,"_3059":126290},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3603":74550,"_31069":74545,"_5":31425,"_21510":126292,"_28250":126293,"_3059":126294},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3603":74551,"_31069":74545,"_5":31425,"_21510":126296,"_28250":126297,"_3059":126298},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3603":74552,"_31069":74545,"_5":31425,"_21510":126300,"_28250":126301,"_3059":126302},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3603":74553,"_31069":74545,"_5":31425,"_21510":126304,"_28250":126305,"_3059":126306},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3603":74554,"_31069":74545,"_5":31425,"_21510":126308,"_28250":126309,"_3059":126310},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3603":74555,"_31069":74545,"_5":31425,"_21510":126312,"_28250":126313,"_3059":126314},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3603":74556,"_31069":74545,"_5":31425,"_21510":126316,"_28250":126317,"_3059":126318},[],"/docs/pr-preview/pr-74/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3603":74557,"_31069":74545,"_21510":126320,"_5":14782,"_28250":74545,"_3059":126321},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3603":74558,"_31069":74545,"_21510":126323,"_5":14782,"_28250":126285,"_3059":126324},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3603":74559,"_31069":74545,"_21510":126326,"_5":14782,"_28250":126289,"_3059":126327},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3603":74560,"_31069":74545,"_21510":126329,"_5":14782,"_28250":126293,"_3059":126330},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3603":74561,"_31069":74545,"_21510":126332,"_5":14782,"_28250":126297,"_3059":126333},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3603":74562,"_31069":74545,"_21510":126335,"_5":14782,"_28250":126301,"_3059":126336},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3603":74563,"_31069":74545,"_21510":126338,"_5":14782,"_28250":126301,"_3059":126339},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3603":74564,"_31069":74545,"_21510":126341,"_5":14782,"_28250":126301,"_3059":126342},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3603":74565,"_31069":74545,"_21510":126344,"_5":14782,"_28250":126301,"_3059":126345},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3603":74566,"_31069":74545,"_21510":126347,"_5":14782,"_28250":126301,"_3059":126348},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3603":74567,"_31069":74545,"_21510":126350,"_5":14782,"_28250":126301,"_3059":126351},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3603":74568,"_31069":74545,"_21510":126353,"_5":14782,"_28250":126305,"_3059":126354},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3603":74569,"_31069":74545,"_21510":126356,"_5":14782,"_28250":126305,"_3059":126357},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3603":74570,"_31069":74545,"_21510":126359,"_5":14782,"_28250":126305,"_3059":126360},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3603":74571,"_31069":74545,"_21510":126362,"_5":14782,"_28250":126305,"_3059":126363},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3603":74572,"_31069":74545,"_21510":126365,"_5":14782,"_28250":126305,"_3059":126366},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3603":74573,"_31069":74545,"_21510":126368,"_5":14782,"_28250":126309,"_3059":126369},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3603":74574,"_31069":74545,"_21510":126371,"_5":14782,"_28250":126309,"_3059":126372},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3603":74575,"_31069":74545,"_21510":126374,"_5":14782,"_28250":126309,"_3059":126375},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3603":74576,"_31069":74545,"_21510":126377,"_5":14782,"_28250":126309,"_3059":126378},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3603":74577,"_31069":74545,"_21510":126380,"_5":14782,"_28250":126309,"_3059":126381},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3603":74578,"_31069":74545,"_21510":126383,"_5":14782,"_28250":126309,"_3059":126384},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3603":74579,"_31069":74545,"_21510":126386,"_5":14782,"_28250":126309,"_3059":126387},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3603":74580,"_31069":74545,"_21510":126389,"_5":14782,"_28250":126313,"_3059":126390},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3603":74581,"_31069":74545,"_21510":126392,"_5":14782,"_28250":126317,"_3059":126393},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3603":74582,"_31069":74545,"_21510":126395,"_5":14782,"_28250":126317,"_3059":126396},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3603":74583,"_31069":74545,"_21510":126398,"_5":14782,"_28250":126317,"_3059":126399},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3603":74584,"_31069":74545,"_21510":126401,"_5":14782,"_28250":126317,"_3059":126402},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3603":74585,"_31069":74545,"_21510":126404,"_5":14782,"_28250":126317,"_3059":126405},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3603":74586,"_31069":74545,"_21510":126407,"_5":14782,"_28250":126317,"_3059":126408},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3603":74587,"_31069":74545,"_21510":126410,"_5":14782,"_28250":126317,"_3059":126411},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3603":74588,"_31069":74588,"_5":15147,"_3059":126413,"_31428":126414,"_21510":126415,"_28250":74588},"Listas de revocación (CRL)",[50742,121227,56420,125887],[],{"_3603":74589,"_31069":74588,"_21510":126417,"_5":14782,"_28250":74588,"_3059":126418},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3603":74590,"_31069":74588,"_5":31425,"_21510":126420,"_28250":126421,"_3059":126422},[],"/docs/pr-preview/pr-74/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3603":74591,"_31069":74588,"_5":31425,"_21510":126424,"_28250":126425,"_3059":126426},[],"/docs/pr-preview/pr-74/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3603":74592,"_31069":74588,"_5":31425,"_21510":126428,"_28250":126429,"_3059":126430},[],"/docs/pr-preview/pr-74/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3603":74593,"_31069":74588,"_5":31425,"_21510":126432,"_28250":126433,"_3059":126434},[],"/docs/pr-preview/pr-74/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3603":74594,"_31069":74588,"_5":31425,"_21510":126436,"_28250":126437,"_3059":126438},[],"/docs/pr-preview/pr-74/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3603":74595,"_31069":74588,"_5":31425,"_21510":126440,"_28250":126441,"_3059":126442},[],"/docs/pr-preview/pr-74/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3603":74596,"_31069":74588,"_5":31425,"_21510":126444,"_28250":126445,"_3059":126446},[],"/docs/pr-preview/pr-74/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3603":74597,"_31069":74588,"_5":31425,"_21510":126448,"_28250":126449,"_3059":126450},[],"/docs/pr-preview/pr-74/es/platform/pki/crl#referencias","Referencias",{"_3603":74598,"_31069":74588,"_21510":126452,"_5":14782,"_28250":74588,"_3059":126453},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3603":74599,"_31069":74588,"_21510":126455,"_5":14782,"_28250":126421,"_3059":126456},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3603":74600,"_31069":74588,"_21510":126458,"_5":14782,"_28250":126421,"_3059":126459},[],"Campo",{"_3603":74601,"_31069":74588,"_21510":126461,"_5":14782,"_28250":126421,"_3059":122904},[],{"_3603":74602,"_31069":74588,"_21510":126463,"_5":14782,"_28250":126421,"_3059":52374},[],{"_3603":74603,"_31069":74588,"_21510":126465,"_5":14782,"_28250":126421,"_3059":126466},[],"ID de la CA a la que pertenecen los ajustes.",{"_3603":74604,"_31069":74588,"_21510":126468,"_5":14782,"_28250":126421,"_3059":57652},[],{"_3603":74605,"_31069":74588,"_21510":126470,"_5":14782,"_28250":126421,"_3059":126471},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3603":74606,"_31069":74588,"_21510":126473,"_5":14782,"_28250":126421,"_3059":57658},[],{"_3603":74607,"_31069":74588,"_21510":126475,"_5":14782,"_28250":126421,"_3059":126476},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3603":74608,"_31069":74588,"_21510":126478,"_5":14782,"_28250":126421,"_3059":57664},[],{"_3603":74609,"_31069":74588,"_21510":126480,"_5":14782,"_28250":126421,"_3059":126481},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3603":74610,"_31069":74588,"_21510":126483,"_5":14782,"_28250":126421,"_3059":126484},[],"Campo de `crl_options`",{"_3603":74611,"_31069":74588,"_21510":126486,"_5":14782,"_28250":126421,"_3059":122904},[],{"_3603":74612,"_31069":74588,"_21510":126488,"_5":14782,"_28250":126421,"_3059":126489},[],"Valor inicial",{"_3603":74613,"_31069":74588,"_21510":126491,"_5":14782,"_28250":126421,"_3059":57678},[],{"_3603":74614,"_31069":74588,"_21510":126493,"_5":14782,"_28250":126421,"_3059":126494},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3603":74615,"_31069":74588,"_21510":126496,"_5":14782,"_28250":126421,"_3059":126497},[],"7 días.",{"_3603":74616,"_31069":74588,"_21510":126499,"_5":14782,"_28250":126421,"_3059":57687},[],{"_3603":74617,"_31069":74588,"_21510":126501,"_5":14782,"_28250":126421,"_3059":126502},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3603":74618,"_31069":74588,"_21510":126504,"_5":14782,"_28250":126421,"_3059":126505},[],"6 días y 23 horas.",{"_3603":74619,"_31069":74588,"_21510":126507,"_5":14782,"_28250":126421,"_3059":57696},[],{"_3603":74620,"_31069":74588,"_21510":126509,"_5":14782,"_28250":126421,"_3059":126510},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3603":74621,"_31069":74588,"_21510":126512,"_5":14782,"_28250":126421,"_3059":57702},[],{"_3603":74622,"_31069":74588,"_21510":126514,"_5":14782,"_28250":126421,"_3059":57705},[],{"_3603":74623,"_31069":74588,"_21510":126516,"_5":14782,"_28250":126421,"_3059":126517},[],"Número de serie del certificado existente que firma la CRL.",{"_3603":74624,"_31069":74588,"_21510":126519,"_5":14782,"_28250":126421,"_3059":126520},[],"Número de serie del certificado actual de la CA.",{"_3603":74625,"_31069":74588,"_21510":126522,"_5":14782,"_28250":126421,"_3059":126523},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3603":74626,"_31069":74588,"_21510":126525,"_5":14782,"_28250":126421,"_3059":126526},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3603":74627,"_31069":74588,"_21510":126528,"_5":14782,"_28250":126421,"_3059":126529},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3603":74628,"_31069":74588,"_21510":126531,"_5":14782,"_28250":126421,"_3059":126532},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3603":74629,"_31069":74588,"_21510":126534,"_5":14782,"_28250":126421,"_3059":126535},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3603":74630,"_31069":74588,"_21510":126537,"_5":14782,"_28250":126421,"_3059":126538},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3603":74631,"_31069":74588,"_21510":126540,"_5":14782,"_28250":126421,"_3059":126541},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3603":74632,"_31069":74588,"_21510":126543,"_5":14782,"_28250":126421,"_3059":126544},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3603":74633,"_31069":74588,"_21510":126546,"_5":14782,"_28250":126421,"_3059":126547},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3603":74634,"_31069":74588,"_21510":126549,"_5":14782,"_28250":126421,"_3059":126550},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3603":74635,"_31069":74588,"_21510":126552,"_5":14782,"_28250":126421,"_3059":126553},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3603":74636,"_31069":74588,"_21510":126555,"_5":14782,"_28250":126425,"_3059":126556},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3603":74637,"_31069":74588,"_21510":126558,"_5":14782,"_28250":126425,"_3059":126559},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3603":74638,"_31069":74588,"_21510":126561,"_5":14782,"_28250":126425,"_3059":126562},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3603":74639,"_31069":74588,"_21510":126564,"_5":14782,"_28250":126425,"_3059":126565},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3603":74640,"_31069":74588,"_21510":126567,"_5":14782,"_28250":126429,"_3059":126568},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3603":74641,"_31069":74588,"_21510":126570,"_5":14782,"_28250":126429,"_3059":126571},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3603":74642,"_31069":74588,"_21510":126573,"_5":14782,"_28250":126429,"_3059":126574},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3603":74643,"_31069":74588,"_21510":126576,"_5":14782,"_28250":126429,"_3059":126577},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3603":74644,"_31069":74588,"_21510":126579,"_5":14782,"_28250":126429,"_3059":126580},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3603":74645,"_31069":74588,"_21510":126582,"_5":14782,"_28250":126429,"_3059":126583},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3603":74646,"_31069":74588,"_21510":126585,"_5":14782,"_28250":126429,"_3059":126586},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3603":74647,"_31069":74588,"_21510":126588,"_5":14782,"_28250":126429,"_3059":126589},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3603":74648,"_31069":74588,"_21510":126591,"_5":14782,"_28250":126429,"_3059":126592},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3603":74649,"_31069":74588,"_21510":126594,"_5":14782,"_28250":126433,"_3059":126595},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3603":74650,"_31069":74588,"_21510":126597,"_5":14782,"_28250":126433,"_3059":126598},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3603":74651,"_31069":74588,"_21510":126600,"_5":14782,"_28250":126437,"_3059":126601},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3603":74652,"_31069":74588,"_21510":126603,"_5":14782,"_28250":126437,"_3059":126604},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3603":74653,"_31069":74588,"_21510":126606,"_5":14782,"_28250":126437,"_3059":126607},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3603":74654,"_31069":74588,"_21510":126609,"_5":14782,"_28250":126437,"_3059":126610},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3603":74655,"_31069":74588,"_21510":126612,"_5":14782,"_28250":126437,"_3059":126613},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3603":74656,"_31069":74588,"_21510":126615,"_5":14782,"_28250":126441,"_3059":126616},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3603":74657,"_31069":74588,"_21510":126618,"_5":14782,"_28250":126441,"_3059":123093},[],{"_3603":74658,"_31069":74588,"_21510":126620,"_5":14782,"_28250":126441,"_3059":126621},[],"Path relativo",{"_3603":74659,"_31069":74588,"_21510":126623,"_5":14782,"_28250":126441,"_3059":120987},[],{"_3603":74660,"_31069":74588,"_21510":126625,"_5":14782,"_28250":126441,"_3059":57817},[],{"_3603":74661,"_31069":74588,"_21510":126627,"_5":14782,"_28250":126441,"_3059":57820},[],{"_3603":74662,"_31069":74588,"_21510":126629,"_5":14782,"_28250":126441,"_3059":126630},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3603":74663,"_31069":74588,"_21510":126632,"_5":14782,"_28250":126441,"_3059":57817},[],{"_3603":74664,"_31069":74588,"_21510":126634,"_5":14782,"_28250":126441,"_3059":57828},[],{"_3603":74665,"_31069":74588,"_21510":126636,"_5":14782,"_28250":126441,"_3059":126637},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3603":74666,"_31069":74588,"_21510":126639,"_5":14782,"_28250":126441,"_3059":57834},[],{"_3603":74667,"_31069":74588,"_21510":126641,"_5":14782,"_28250":126441,"_3059":57828},[],{"_3603":74668,"_31069":74588,"_21510":126643,"_5":14782,"_28250":126441,"_3059":126644},[],"Sustituir la configuración de CRL de una CA.",{"_3603":74669,"_31069":74588,"_21510":126646,"_5":14782,"_28250":126441,"_3059":57842},[],{"_3603":74670,"_31069":74588,"_21510":126648,"_5":14782,"_28250":126441,"_3059":57828},[],{"_3603":74671,"_31069":74588,"_21510":126650,"_5":14782,"_28250":126441,"_3059":126651},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3603":74672,"_31069":74588,"_21510":126653,"_5":14782,"_28250":126441,"_3059":126654},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3603":74673,"_31069":74588,"_21510":126656,"_5":14782,"_28250":126441,"_3059":126657},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3603":74674,"_31069":74588,"_21510":126659,"_5":14782,"_28250":126441,"_3059":126660},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3603":74675,"_31069":74588,"_21510":126662,"_5":14782,"_28250":126445,"_3059":126663},[],"Síntoma",{"_3603":74676,"_31069":74588,"_21510":126665,"_5":14782,"_28250":126445,"_3059":126666},[],"Causa",{"_3603":74677,"_31069":74588,"_21510":126668,"_5":14782,"_28250":126445,"_3059":126669},[],"Acción",{"_3603":74678,"_31069":74588,"_21510":126671,"_5":14782,"_28250":126445,"_3059":126672},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3603":74679,"_31069":74588,"_21510":126674,"_5":14782,"_28250":126445,"_3059":126675},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3603":74680,"_31069":74588,"_21510":126677,"_5":14782,"_28250":126445,"_3059":126678},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3603":74681,"_31069":74588,"_21510":126680,"_5":14782,"_28250":126445,"_3059":126681},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3603":74682,"_31069":74588,"_21510":126683,"_5":14782,"_28250":126445,"_3059":126684},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3603":74683,"_31069":74588,"_21510":126686,"_5":14782,"_28250":126445,"_3059":126687},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3603":74684,"_31069":74588,"_21510":126689,"_5":14782,"_28250":126445,"_3059":126690},[],"`PUT` devuelve 400.",{"_3603":74685,"_31069":74588,"_21510":126692,"_5":14782,"_28250":126445,"_3059":126693},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3603":74686,"_31069":74588,"_21510":126695,"_5":14782,"_28250":126445,"_3059":126696},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3603":74687,"_31069":74588,"_21510":126698,"_5":14782,"_28250":126445,"_3059":126699},[],"`PUT` devuelve 404.",{"_3603":74688,"_31069":74588,"_21510":126701,"_5":14782,"_28250":126445,"_3059":126702},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3603":74689,"_31069":74588,"_21510":126704,"_5":14782,"_28250":126445,"_3059":126705},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3603":74690,"_31069":74588,"_21510":126707,"_5":14782,"_28250":126445,"_3059":126708},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3603":74691,"_31069":74588,"_21510":126710,"_5":14782,"_28250":126445,"_3059":126711},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3603":74692,"_31069":74588,"_21510":126713,"_5":14782,"_28250":126445,"_3059":126714},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3603":74693,"_31069":74588,"_21510":126716,"_5":14782,"_28250":126445,"_3059":126717},[],"La CRL no cambia tras revocar un certificado.",{"_3603":74694,"_31069":74588,"_21510":126719,"_5":14782,"_28250":126445,"_3059":126720},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3603":74695,"_31069":74588,"_21510":126722,"_5":14782,"_28250":126445,"_3059":126723},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3603":74696,"_31069":74588,"_21510":126725,"_5":14782,"_28250":126445,"_3059":126726},[],"Un verificador rechaza la CRL por el emisor.",{"_3603":74697,"_31069":74588,"_21510":126728,"_5":14782,"_28250":126445,"_3059":126729},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3603":74698,"_31069":74588,"_21510":126731,"_5":14782,"_28250":126445,"_3059":126732},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3603":74699,"_31069":74588,"_21510":126734,"_5":14782,"_28250":126449,"_3059":126735},[],"RFC 5280: perfil X.509 y CRL.",{"_3603":74700,"_31069":74588,"_21510":126737,"_5":14782,"_28250":126449,"_3059":57934},[],{"_3603":74701,"_31069":74588,"_21510":126739,"_5":14782,"_28250":126449,"_3059":57937},[],{"_3603":74702,"_31069":74588,"_21510":126741,"_5":14782,"_28250":126449,"_3059":126742},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3603":74703,"_31069":74588,"_21510":126744,"_5":14782,"_28250":126449,"_3059":126745},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3603":74704,"_31069":74704,"_5":15147,"_3059":126747,"_31428":126748,"_21510":126749,"_28250":74704},"Claves y motores criptográficos",[50742,121227,56420,125241],[],{"_3603":74705,"_31069":74704,"_21510":126751,"_5":14782,"_28250":74704,"_3059":126752},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3603":74706,"_31069":74704,"_5":31425,"_21510":126754,"_28250":126755,"_3059":126756},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3603":74707,"_31069":74704,"_5":31425,"_21510":126758,"_28250":126759,"_3059":126760},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3603":74708,"_31069":74704,"_5":31425,"_21510":126762,"_28250":126763,"_3059":57962},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#file-system",{"_3603":74709,"_31069":74704,"_5":31425,"_21510":126765,"_28250":126766,"_3059":57966},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#hashicorp-vault",{"_3603":74710,"_31069":74704,"_5":31425,"_21510":126768,"_28250":126769,"_3059":57970},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#aws-secrets-manager",{"_3603":74711,"_31069":74704,"_5":31425,"_21510":126771,"_28250":126772,"_3059":57974},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#aws-kms",{"_3603":74712,"_31069":74704,"_5":31425,"_21510":126774,"_28250":126775,"_3059":57978},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#pkcs11",{"_3603":74713,"_31069":74704,"_5":31425,"_21510":126777,"_28250":126778,"_3059":57982},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#azure-key-vault",{"_3603":74714,"_31069":74704,"_5":31425,"_21510":126780,"_28250":126781,"_3059":126782},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3603":74715,"_31069":74704,"_5":31425,"_21510":126784,"_28250":126785,"_3059":126786},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3603":74716,"_31069":74704,"_5":31425,"_21510":126788,"_28250":126789,"_3059":126790},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3603":74717,"_31069":74704,"_5":31425,"_21510":126792,"_28250":126793,"_3059":126794},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3603":74718,"_31069":74704,"_5":31425,"_21510":126796,"_28250":126797,"_3059":126798},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3603":74719,"_31069":74704,"_5":31425,"_21510":126800,"_28250":126801,"_3059":126802},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3603":74720,"_31069":74704,"_5":31425,"_21510":126804,"_28250":126805,"_3059":126806},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3603":74721,"_31069":74704,"_5":31425,"_21510":126808,"_28250":126809,"_3059":58014},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#sign",{"_3603":74722,"_31069":74704,"_5":31425,"_21510":126811,"_28250":126812,"_3059":58018},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#verify",{"_3603":74723,"_31069":74704,"_5":31425,"_21510":126814,"_28250":126815,"_3059":126816},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3603":74724,"_31069":74704,"_5":31425,"_21510":126818,"_28250":126819,"_3059":126820},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3603":74725,"_31069":74704,"_5":31425,"_21510":126822,"_28250":126823,"_3059":126824},[],"/docs/pr-preview/pr-74/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3603":74726,"_31069":74704,"_21510":126826,"_5":14782,"_28250":74704,"_3059":126827},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3603":74727,"_31069":74704,"_21510":126829,"_5":14782,"_28250":74704,"_3059":126830},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3603":74728,"_31069":74704,"_21510":126832,"_5":14782,"_28250":126755,"_3059":126833},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3603":74729,"_31069":74704,"_21510":126835,"_5":14782,"_28250":126755,"_3059":126836},[],"En la práctica, permite:",{"_3603":74730,"_31069":74704,"_21510":126838,"_5":14782,"_28250":126755,"_3059":126839},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3603":74731,"_31069":74704,"_21510":126841,"_5":14782,"_28250":126755,"_3059":126842},[],"Importar claves creadas externamente.",{"_3603":74732,"_31069":74704,"_21510":126844,"_5":14782,"_28250":126755,"_3059":126845},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3603":74733,"_31069":74704,"_21510":126847,"_5":14782,"_28250":126755,"_3059":126848},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3603":74734,"_31069":74704,"_21510":126850,"_5":14782,"_28250":126759,"_3059":126851},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3603":74735,"_31069":74704,"_21510":126853,"_5":14782,"_28250":126759,"_3059":126854},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3603":74736,"_31069":74704,"_21510":126856,"_5":14782,"_28250":126759,"_3059":126857},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3603":74737,"_31069":74704,"_21510":126859,"_5":14782,"_28250":126763,"_3059":126860},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3603":74738,"_31069":74704,"_21510":126862,"_5":14782,"_28250":126766,"_3059":126863},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3603":74739,"_31069":74704,"_21510":126865,"_5":14782,"_28250":126766,"_3059":126866},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3603":74740,"_31069":74704,"_21510":126868,"_5":14782,"_28250":126769,"_3059":126869},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3603":74741,"_31069":74704,"_21510":126871,"_5":14782,"_28250":126772,"_3059":126872},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3603":74742,"_31069":74704,"_21510":126874,"_5":14782,"_28250":126775,"_3059":126875},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3603":74743,"_31069":74704,"_21510":126877,"_5":14782,"_28250":126778,"_3059":126878},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3603":74744,"_31069":74704,"_21510":126880,"_5":14782,"_28250":126778,"_3059":126881},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3603":74745,"_31069":74704,"_21510":126883,"_5":14782,"_28250":126778,"_3059":126884},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3603":74746,"_31069":74704,"_21510":126886,"_5":14782,"_28250":126778,"_3059":126887},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3603":74747,"_31069":74704,"_21510":126889,"_5":14782,"_28250":126781,"_3059":126890},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3603":74748,"_31069":74704,"_21510":126892,"_5":14782,"_28250":126781,"_3059":126893},[],"La tabla incluye los siguientes campos:",{"_3603":74749,"_31069":74704,"_21510":126895,"_5":14782,"_28250":126781,"_3059":126896},[],"**Name**: nombre descriptivo de la clave.",{"_3603":74750,"_31069":74704,"_21510":126898,"_5":14782,"_28250":126781,"_3059":126899},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3603":74751,"_31069":74704,"_21510":126901,"_5":14782,"_28250":126781,"_3059":126902},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3603":74752,"_31069":74704,"_21510":126904,"_5":14782,"_28250":126781,"_3059":126905},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3603":74753,"_31069":74704,"_21510":126907,"_5":14782,"_28250":126781,"_3059":126908},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3603":74754,"_31069":74704,"_21510":126910,"_5":14782,"_28250":126781,"_3059":126911},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3603":74755,"_31069":74704,"_21510":126913,"_5":14782,"_28250":126781,"_3059":126914},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3603":74756,"_31069":74704,"_21510":126916,"_5":14782,"_28250":126781,"_3059":126917},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3603":74757,"_31069":74704,"_21510":126919,"_5":14782,"_28250":126781,"_3059":126920},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3603":74758,"_31069":74704,"_21510":126922,"_5":14782,"_28250":126781,"_3059":126923},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3603":74759,"_31069":74704,"_21510":126925,"_5":14782,"_28250":126781,"_3059":126926},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3603":74760,"_31069":74704,"_21510":126928,"_5":14782,"_28250":126781,"_3059":126929},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3603":74761,"_31069":74704,"_21510":126931,"_5":14782,"_28250":126781,"_3059":126932},[],"**Delete Key** para eliminar la clave del sistema.",{"_3603":74762,"_31069":74704,"_21510":126934,"_5":14782,"_28250":126785,"_3059":126935},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3603":74763,"_31069":74704,"_21510":126937,"_5":14782,"_28250":126789,"_3059":126938},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3603":74764,"_31069":74704,"_21510":126940,"_5":14782,"_28250":126789,"_3059":126941},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3603":74765,"_31069":74704,"_21510":126943,"_5":14782,"_28250":126789,"_3059":126944},[],"**Key Name**: nombre único y descriptivo.",{"_3603":74766,"_31069":74704,"_21510":126946,"_5":14782,"_28250":126789,"_3059":126947},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3603":74767,"_31069":74704,"_21510":126949,"_5":14782,"_28250":126789,"_3059":126950},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3603":74768,"_31069":74704,"_21510":126952,"_5":14782,"_28250":126789,"_3059":126953},[],"**Tags**: metadatos para clasificar la clave.",{"_3603":74769,"_31069":74704,"_21510":126955,"_5":14782,"_28250":126789,"_3059":126956},[],"**Metadata**: información adicional para usos avanzados.",{"_3603":74770,"_31069":74704,"_21510":126958,"_5":14782,"_28250":126793,"_3059":126959},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3603":74771,"_31069":74704,"_21510":126961,"_5":14782,"_28250":126793,"_3059":126962},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3603":74772,"_31069":74704,"_21510":126964,"_5":14782,"_28250":126793,"_3059":126965},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3603":74773,"_31069":74704,"_21510":126967,"_5":14782,"_28250":126793,"_3059":126968},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3603":74774,"_31069":74704,"_21510":126970,"_5":14782,"_28250":126793,"_3059":126971},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3603":74775,"_31069":74704,"_21510":126973,"_5":14782,"_28250":126793,"_3059":126974},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3603":74776,"_31069":74704,"_21510":126976,"_5":14782,"_28250":126793,"_3059":126977},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3603":74777,"_31069":74704,"_21510":126979,"_5":14782,"_28250":126793,"_3059":126980},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3603":74778,"_31069":74704,"_21510":126982,"_5":14782,"_28250":126793,"_3059":126983},[],"**Metadata**: información adicional opcional.",{"_3603":74779,"_31069":74704,"_21510":126985,"_5":14782,"_28250":126793,"_3059":126986},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3603":74780,"_31069":74704,"_21510":126988,"_5":14782,"_28250":126793,"_3059":126989},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3603":74781,"_31069":74704,"_21510":126991,"_5":14782,"_28250":126797,"_3059":126992},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3603":74782,"_31069":74704,"_21510":126994,"_5":14782,"_28250":126801,"_3059":126995},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3603":74783,"_31069":74704,"_21510":126997,"_5":14782,"_28250":126801,"_3059":126998},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3603":74784,"_31069":74704,"_21510":127000,"_5":14782,"_28250":126801,"_3059":127001},[],"**Key Name**: nombre descriptivo.",{"_3603":74785,"_31069":74704,"_21510":127003,"_5":14782,"_28250":126801,"_3059":127004},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3603":74786,"_31069":74704,"_21510":127006,"_5":14782,"_28250":126801,"_3059":127007},[],"**Tags**: etiquetas asociadas.",{"_3603":74787,"_31069":74704,"_21510":127009,"_5":14782,"_28250":126801,"_3059":127010},[],"**Aliases**: nombres alternativos.",{"_3603":74788,"_31069":74704,"_21510":127012,"_5":14782,"_28250":126801,"_3059":127013},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3603":74789,"_31069":74704,"_21510":127015,"_5":14782,"_28250":126801,"_3059":127016},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3603":74790,"_31069":74704,"_21510":127018,"_5":14782,"_28250":126801,"_3059":127019},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3603":74791,"_31069":74704,"_21510":127021,"_5":14782,"_28250":126801,"_3059":127022},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3603":74792,"_31069":74704,"_21510":127024,"_5":14782,"_28250":126805,"_3059":127025},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3603":74793,"_31069":74704,"_21510":127027,"_5":14782,"_28250":126805,"_3059":127028},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3603":74794,"_31069":74704,"_21510":127030,"_5":14782,"_28250":126805,"_3059":127031},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3603":74795,"_31069":74704,"_21510":127033,"_5":14782,"_28250":126809,"_3059":127034},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3603":74796,"_31069":74704,"_21510":127036,"_5":14782,"_28250":126809,"_3059":127037},[],"Campos principales:",{"_3603":74797,"_31069":74704,"_21510":127039,"_5":14782,"_28250":126809,"_3059":127040},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3603":74798,"_31069":74704,"_21510":127042,"_5":14782,"_28250":126809,"_3059":127043},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3603":74799,"_31069":74704,"_21510":127045,"_5":14782,"_28250":126809,"_3059":127046},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3603":74800,"_31069":74704,"_21510":127048,"_5":14782,"_28250":126809,"_3059":127049},[],"**Message**: contenido que se va a firmar.",{"_3603":74801,"_31069":74704,"_21510":127051,"_5":14782,"_28250":126809,"_3059":127052},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3603":74802,"_31069":74704,"_21510":127054,"_5":14782,"_28250":126812,"_3059":127055},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3603":74803,"_31069":74704,"_21510":127057,"_5":14782,"_28250":126812,"_3059":127037},[],{"_3603":74804,"_31069":74704,"_21510":127059,"_5":14782,"_28250":126812,"_3059":127060},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3603":74805,"_31069":74704,"_21510":127062,"_5":14782,"_28250":126812,"_3059":127063},[],"**Message Type**: `Raw` o `Digest`.",{"_3603":74806,"_31069":74704,"_21510":127065,"_5":14782,"_28250":126812,"_3059":127066},[],"**Payload Encoding**: codificación del mensaje.",{"_3603":74807,"_31069":74704,"_21510":127068,"_5":14782,"_28250":126812,"_3059":127069},[],"**Message**: mensaje original o hash.",{"_3603":74808,"_31069":74704,"_21510":127071,"_5":14782,"_28250":126812,"_3059":127072},[],"**Signature**: firma que se desea comprobar.",{"_3603":74809,"_31069":74704,"_21510":127074,"_5":14782,"_28250":126812,"_3059":127075},[],"**Result**: indicador del resultado de la validación.",{"_3603":74810,"_31069":74704,"_21510":127077,"_5":14782,"_28250":126815,"_3059":127078},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3603":74811,"_31069":74704,"_21510":127080,"_5":14782,"_28250":126815,"_3059":127081},[],"Este flujo es útil para:",{"_3603":74812,"_31069":74704,"_21510":127083,"_5":14782,"_28250":126815,"_3059":127084},[],"Solicitar certificados a una CA externa.",{"_3603":74813,"_31069":74704,"_21510":127086,"_5":14782,"_28250":126815,"_3059":127087},[],"Renovar una identidad manteniendo la misma clave.",{"_3603":74814,"_31069":74704,"_21510":127089,"_5":14782,"_28250":126815,"_3059":127090},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3603":74815,"_31069":74704,"_21510":127092,"_5":14782,"_28250":126815,"_3059":127093},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3603":74816,"_31069":74704,"_21510":127095,"_5":14782,"_28250":126815,"_3059":127096},[],"**Organization (O)**: organización o empresa.",{"_3603":74817,"_31069":74704,"_21510":127098,"_5":14782,"_28250":126815,"_3059":127099},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3603":74818,"_31069":74704,"_21510":127101,"_5":14782,"_28250":126815,"_3059":127102},[],"**Country (C)**: código de país de dos letras.",{"_3603":74819,"_31069":74704,"_21510":127104,"_5":14782,"_28250":126815,"_3059":127105},[],"**State / Province (ST)**: estado o provincia.",{"_3603":74820,"_31069":74704,"_21510":127107,"_5":14782,"_28250":126815,"_3059":127108},[],"**Locality (L)**: ciudad o localidad.",{"_3603":74821,"_31069":74704,"_21510":127110,"_5":14782,"_28250":126815,"_3059":127111},[],"**Email Address**: correo de contacto.",{"_3603":74822,"_31069":74704,"_21510":127113,"_5":14782,"_28250":126815,"_3059":127114},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3603":74823,"_31069":74704,"_21510":127116,"_5":14782,"_28250":126815,"_3059":127117},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3603":74824,"_31069":74704,"_21510":127119,"_5":14782,"_28250":126819,"_3059":127120},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3603":74825,"_31069":74704,"_21510":127122,"_5":14782,"_28250":126819,"_3059":127123},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3603":74826,"_31069":74704,"_21510":127125,"_5":14782,"_28250":126823,"_3059":127126},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3603":74827,"_31069":74704,"_21510":127128,"_5":14782,"_28250":126823,"_3059":127129},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3603":74828,"_31069":74828,"_5":15147,"_3059":127131,"_31428":127132,"_21510":127133,"_28250":74828},"Validación online con OCSP",[50742,121227,56420,125887],[],{"_3603":74829,"_31069":74828,"_21510":127135,"_5":14782,"_28250":74828,"_3059":127136},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3603":74830,"_31069":74828,"_5":31425,"_21510":127138,"_28250":127139,"_3059":127140},[],"/docs/pr-preview/pr-74/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3603":74831,"_31069":74828,"_5":31425,"_21510":127142,"_28250":127143,"_3059":127144},[],"/docs/pr-preview/pr-74/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3603":74832,"_31069":74828,"_5":31425,"_21510":127146,"_28250":127147,"_3059":127148},[],"/docs/pr-preview/pr-74/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3603":74833,"_31069":74828,"_5":31425,"_21510":127150,"_28250":127151,"_3059":127152},[],"/docs/pr-preview/pr-74/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3603":74834,"_31069":74828,"_5":31425,"_21510":127154,"_28250":127155,"_3059":127156},[],"/docs/pr-preview/pr-74/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3603":74835,"_31069":74828,"_5":31425,"_21510":127158,"_28250":127159,"_3059":126450},[],"/docs/pr-preview/pr-74/es/platform/pki/ocsp#referencias",{"_3603":74836,"_31069":74828,"_21510":127161,"_5":14782,"_28250":74828,"_3059":127162},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3603":74837,"_31069":74828,"_21510":127164,"_5":14782,"_28250":127139,"_3059":127165},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3603":74838,"_31069":74828,"_21510":127167,"_5":14782,"_28250":127139,"_3059":127168},[],"Estado del registro",{"_3603":74839,"_31069":74828,"_21510":127170,"_5":14782,"_28250":127139,"_3059":127171},[],"Respuesta firmada",{"_3603":74840,"_31069":74828,"_21510":127173,"_5":14782,"_28250":127139,"_3059":55557},[],{"_3603":74841,"_31069":74828,"_21510":127175,"_5":14782,"_28250":127139,"_3059":58382},[],{"_3603":74842,"_31069":74828,"_21510":127177,"_5":14782,"_28250":127139,"_3059":55574},[],{"_3603":74843,"_31069":74828,"_21510":127179,"_5":14782,"_28250":127139,"_3059":127180},[],"`Revoked`, con razón y fecha de revocación.",{"_3603":74844,"_31069":74828,"_21510":127182,"_5":14782,"_28250":127139,"_3059":127183},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3603":74845,"_31069":74828,"_21510":127185,"_5":14782,"_28250":127139,"_3059":127186},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3603":74846,"_31069":74828,"_21510":127188,"_5":14782,"_28250":127139,"_3059":127189},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3603":74847,"_31069":74828,"_21510":127191,"_5":14782,"_28250":127139,"_3059":127192},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3603":74848,"_31069":74828,"_21510":127194,"_5":14782,"_28250":127139,"_3059":127195},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3603":74849,"_31069":74828,"_21510":127197,"_5":14782,"_28250":127143,"_3059":127198},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3603":74850,"_31069":74828,"_21510":127200,"_5":14782,"_28250":127143,"_3059":127201},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3603":74851,"_31069":74828,"_21510":127203,"_5":14782,"_28250":127147,"_3059":127204},[],"El servicio acepta:",{"_3603":74852,"_31069":74828,"_21510":127206,"_5":14782,"_28250":127147,"_3059":123093},[],{"_3603":74853,"_31069":74828,"_21510":127208,"_5":14782,"_28250":127147,"_3059":127209},[],"Ruta del servicio VA",{"_3603":74854,"_31069":74828,"_21510":127211,"_5":14782,"_28250":127147,"_3059":127212},[],"Formato",{"_3603":74855,"_31069":74828,"_21510":127214,"_5":14782,"_28250":127147,"_3059":58422},[],{"_3603":74856,"_31069":74828,"_21510":127216,"_5":14782,"_28250":127147,"_3059":58425},[],{"_3603":74857,"_31069":74828,"_21510":127218,"_5":14782,"_28250":127147,"_3059":127219},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3603":74858,"_31069":74828,"_21510":127221,"_5":14782,"_28250":127147,"_3059":57817},[],{"_3603":74859,"_31069":74828,"_21510":127223,"_5":14782,"_28250":127147,"_3059":58433},[],{"_3603":74860,"_31069":74828,"_21510":127225,"_5":14782,"_28250":127147,"_3059":127226},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3603":74861,"_31069":74828,"_21510":127228,"_5":14782,"_28250":127147,"_3059":127229},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3603":74862,"_31069":74828,"_21510":127231,"_5":14782,"_28250":127151,"_3059":127232},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3603":74863,"_31069":74828,"_21510":127234,"_5":14782,"_28250":127151,"_3059":127235},[],"Genera la solicitud:",{"_3603":74864,"_31069":74828,"_21510":127237,"_5":14782,"_28250":127151,"_3059":127238},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3603":74865,"_31069":74828,"_21510":127240,"_5":14782,"_28250":127151,"_3059":127241},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3603":74866,"_31069":74828,"_21510":127243,"_5":14782,"_28250":127151,"_3059":127244},[],"Verifica el DER recibido:",{"_3603":74867,"_31069":74828,"_21510":127246,"_5":14782,"_28250":127151,"_3059":127247},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3603":74868,"_31069":74828,"_21510":127249,"_5":14782,"_28250":127155,"_3059":127250},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3603":74869,"_31069":74828,"_21510":127252,"_5":14782,"_28250":127155,"_3059":127253},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3603":74870,"_31069":74828,"_21510":127255,"_5":14782,"_28250":127159,"_3059":58466},[],{"_3603":74871,"_31069":74828,"_21510":127257,"_5":14782,"_28250":127159,"_3059":58469},[],{"_3603":74872,"_31069":74828,"_21510":127259,"_5":14782,"_28250":127159,"_3059":127260},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3603":74873,"_31069":74828,"_21510":127262,"_5":14782,"_28250":127159,"_3059":126745},[],{"_3603":74874,"_31069":74874,"_5":15147,"_3059":56420,"_31428":127264,"_21510":127265,"_28250":74874},[50742,121227,56420],[],{"_3603":74875,"_31069":74874,"_21510":127267,"_5":14782,"_28250":74874,"_3059":127268},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3603":74876,"_31069":74874,"_5":31425,"_21510":127270,"_28250":127271,"_3059":124567},[],"/docs/pr-preview/pr-74/es/platform/pki/overview#empieza-aquí",{"_3603":74877,"_31069":74874,"_5":31425,"_21510":127273,"_28250":127274,"_3059":127275},[],"/docs/pr-preview/pr-74/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3603":74878,"_31069":74874,"_5":31425,"_21510":127277,"_28250":127278,"_3059":125087},[],"/docs/pr-preview/pr-74/es/platform/pki/overview#capacidades-principales",{"_3603":74879,"_31069":74874,"_5":31425,"_21510":127280,"_28250":127281,"_3059":125091},[],"/docs/pr-preview/pr-74/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3603":74880,"_31069":74874,"_5":31425,"_21510":127283,"_28250":127284,"_3059":125095},[],"/docs/pr-preview/pr-74/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3603":74881,"_31069":74874,"_5":31425,"_21510":127286,"_28250":127287,"_3059":125099},[],"/docs/pr-preview/pr-74/es/platform/pki/overview#emite-y-controla-certificados",{"_3603":74882,"_31069":74874,"_5":31425,"_21510":127289,"_28250":127290,"_3059":125107},[],"/docs/pr-preview/pr-74/es/platform/pki/overview#publica-el-estado-de-validación",{"_3603":74883,"_31069":74874,"_5":31425,"_21510":127292,"_28250":127293,"_3059":127294},[],"/docs/pr-preview/pr-74/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3603":74884,"_31069":74874,"_5":31425,"_21510":127296,"_28250":127297,"_3059":126053},[],"/docs/pr-preview/pr-74/es/platform/pki/overview#continúa",{"_3603":74885,"_31069":74874,"_21510":127299,"_5":14782,"_28250":74874,"_3059":127300},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3603":74886,"_31069":74874,"_21510":127302,"_5":14782,"_28250":127271,"_3059":127303},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3603":74887,"_31069":74874,"_21510":127305,"_5":14782,"_28250":127271,"_3059":127306},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3603":74888,"_31069":74874,"_21510":127308,"_5":14782,"_28250":127274,"_3059":127309},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3603":74889,"_31069":74874,"_21510":127311,"_5":14782,"_28250":127274,"_3059":127312},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3603":74890,"_31069":74874,"_21510":127314,"_5":14782,"_28250":127274,"_3059":127315},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3603":74891,"_31069":74874,"_21510":127317,"_5":14782,"_28250":127274,"_3059":127318},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3603":74892,"_31069":74874,"_21510":127320,"_5":14782,"_28250":127274,"_3059":127321},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3603":74893,"_31069":74874,"_21510":127323,"_5":14782,"_28250":127281,"_3059":127324},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3603":74894,"_31069":74874,"_21510":127326,"_5":14782,"_28250":127284,"_3059":127327},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3603":74895,"_31069":74874,"_21510":127329,"_5":14782,"_28250":127287,"_3059":127330},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3603":74896,"_31069":74874,"_21510":127332,"_5":14782,"_28250":127290,"_3059":127333},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3603":74897,"_31069":74874,"_21510":127335,"_5":14782,"_28250":127293,"_3059":127336},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3603":74898,"_31069":74874,"_21510":127338,"_5":14782,"_28250":127293,"_3059":127339},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3603":74899,"_31069":74874,"_21510":127341,"_5":14782,"_28250":127293,"_3059":127342},[],"su clave pública corresponda a la clave privada del cliente;",{"_3603":74900,"_31069":74874,"_21510":127344,"_5":14782,"_28250":127293,"_3059":127345},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3603":74901,"_31069":74874,"_21510":127347,"_5":14782,"_28250":127293,"_3059":127348},[],"sus fechas y usos permitan la operación;",{"_3603":74902,"_31069":74874,"_21510":127350,"_5":14782,"_28250":127293,"_3059":127351},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3603":74903,"_31069":74874,"_21510":127353,"_5":14782,"_28250":127293,"_3059":127354},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3603":74904,"_31069":74874,"_21510":127356,"_5":14782,"_28250":127297,"_3059":127357},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3603":74905,"_31069":74874,"_21510":127359,"_5":14782,"_28250":127297,"_3059":127360},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3603":74906,"_31069":74874,"_21510":127362,"_5":14782,"_28250":127297,"_3059":127363},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3603":74907,"_31069":74907,"_5":15147,"_3059":127365,"_31428":127366,"_21510":127367,"_28250":74907},"Crea tu primera CA",[50742,121227,56420,124691],[],{"_3603":74908,"_31069":74907,"_21510":127369,"_5":14782,"_28250":74907,"_3059":127370},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3603":74909,"_31069":74907,"_5":31425,"_21510":127372,"_28250":127373,"_3059":119761},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3603":74910,"_31069":74907,"_5":31425,"_21510":127375,"_28250":127376,"_3059":127377},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3603":74911,"_31069":74907,"_5":31425,"_21510":127379,"_28250":127380,"_3059":127381},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3603":74912,"_31069":74907,"_5":31425,"_21510":127383,"_28250":127384,"_3059":127385},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3603":74913,"_31069":74907,"_5":31425,"_21510":127387,"_28250":127388,"_3059":127389},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3603":74914,"_31069":74907,"_5":31425,"_21510":127391,"_28250":127392,"_3059":127393},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3603":74915,"_31069":74907,"_5":31425,"_21510":127395,"_28250":127396,"_3059":127397},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3603":74916,"_31069":74907,"_5":31425,"_21510":127399,"_28250":127400,"_3059":124938},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3603":74917,"_31069":74907,"_5":31425,"_21510":127402,"_28250":127403,"_3059":119785},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3603":74918,"_31069":74907,"_21510":127405,"_5":14782,"_28250":74907,"_3059":127406},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3603":74919,"_31069":74907,"_21510":127408,"_5":14782,"_28250":127373,"_3059":127409},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3603":74920,"_31069":74907,"_21510":127411,"_5":14782,"_28250":127373,"_3059":127412},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3603":74921,"_31069":74907,"_21510":127414,"_5":14782,"_28250":127373,"_3059":127415},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3603":74922,"_31069":74907,"_21510":127417,"_5":14782,"_28250":127373,"_3059":127418},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3603":74923,"_31069":74907,"_21510":127420,"_5":14782,"_28250":127376,"_3059":127421},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3603":74924,"_31069":74907,"_21510":127423,"_5":14782,"_28250":127376,"_3059":127424},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3603":74925,"_31069":74907,"_21510":127426,"_5":14782,"_28250":127380,"_3059":127427},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3603":74926,"_31069":74907,"_21510":127429,"_5":14782,"_28250":127380,"_3059":127430},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3603":74927,"_31069":74907,"_21510":127432,"_5":14782,"_28250":127384,"_3059":127433},[],"Selecciona **Root CA** y completa:",{"_3603":74928,"_31069":74907,"_21510":127435,"_5":14782,"_28250":127384,"_3059":58648},[],{"_3603":74929,"_31069":74907,"_21510":127437,"_5":14782,"_28250":127384,"_3059":127438},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3603":74930,"_31069":74907,"_21510":127440,"_5":14782,"_28250":127384,"_3059":127441},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3603":74931,"_31069":74907,"_21510":127443,"_5":14782,"_28250":127384,"_3059":127444},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3603":74932,"_31069":74907,"_21510":127446,"_5":14782,"_28250":127384,"_3059":127447},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3603":74933,"_31069":74907,"_21510":127449,"_5":14782,"_28250":127388,"_3059":127450},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3603":74934,"_31069":74907,"_21510":127452,"_5":14782,"_28250":127392,"_3059":127453},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3603":74935,"_31069":74907,"_21510":127455,"_5":14782,"_28250":127392,"_3059":127456},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3603":74936,"_31069":74907,"_21510":127458,"_5":14782,"_28250":127396,"_3059":127459},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3603":74937,"_31069":74907,"_21510":127461,"_5":14782,"_28250":127396,"_3059":127462},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3603":74938,"_31069":74907,"_21510":127464,"_5":14782,"_28250":127396,"_3059":127465},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3603":74939,"_31069":74907,"_21510":127467,"_5":14782,"_28250":127400,"_3059":127468},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3603":74940,"_31069":74907,"_21510":127470,"_5":14782,"_28250":127400,"_3059":127471},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3603":74941,"_31069":74907,"_21510":127473,"_5":14782,"_28250":127400,"_3059":127474},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3603":74942,"_31069":74907,"_21510":127476,"_5":14782,"_28250":127400,"_3059":127477},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3603":74943,"_31069":74907,"_21510":127479,"_5":14782,"_28250":127403,"_3059":127480},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3603":74944,"_31069":74944,"_5":15147,"_3059":127482,"_31428":127483,"_21510":127484,"_28250":74944},"Emite y verifica un certificado",[50742,121227,56420,124691],[],{"_3603":74945,"_31069":74944,"_21510":127486,"_5":14782,"_28250":74944,"_3059":127487},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3603":74946,"_31069":74944,"_5":31425,"_21510":127489,"_28250":127490,"_3059":119761},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3603":74947,"_31069":74944,"_5":31425,"_21510":127492,"_28250":127493,"_3059":127494},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3603":74948,"_31069":74944,"_5":31425,"_21510":127496,"_28250":127497,"_3059":127498},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3603":74949,"_31069":74944,"_5":31425,"_21510":127500,"_28250":127501,"_3059":127502},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3603":74950,"_31069":74944,"_5":31425,"_21510":127504,"_28250":127505,"_3059":127506},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3603":74951,"_31069":74944,"_5":31425,"_21510":127508,"_28250":127509,"_3059":127510},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3603":74952,"_31069":74944,"_5":31425,"_21510":127512,"_28250":127513,"_3059":127514},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3603":74953,"_31069":74944,"_5":31425,"_21510":127516,"_28250":127517,"_3059":127518},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3603":74954,"_31069":74944,"_5":31425,"_21510":127520,"_28250":127521,"_3059":127522},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3603":74955,"_31069":74944,"_5":31425,"_21510":127524,"_28250":127525,"_3059":127526},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3603":74956,"_31069":74944,"_5":31425,"_21510":127528,"_28250":127529,"_3059":124938},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3603":74957,"_31069":74944,"_5":31425,"_21510":127531,"_28250":127532,"_3059":119785},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3603":74958,"_31069":74944,"_21510":127534,"_5":14782,"_28250":74944,"_3059":127535},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3603":74959,"_31069":74944,"_21510":127537,"_5":14782,"_28250":127490,"_3059":127538},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3603":74960,"_31069":74944,"_21510":127540,"_5":14782,"_28250":127490,"_3059":127541},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3603":74961,"_31069":74944,"_21510":127543,"_5":14782,"_28250":127490,"_3059":127544},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3603":74962,"_31069":74944,"_21510":127546,"_5":14782,"_28250":127490,"_3059":127547},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3603":74963,"_31069":74944,"_21510":127549,"_5":14782,"_28250":127490,"_3059":127550},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3603":74964,"_31069":74944,"_21510":127552,"_5":14782,"_28250":127493,"_3059":127553},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3603":74965,"_31069":74944,"_21510":127555,"_5":14782,"_28250":127497,"_3059":127556},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3603":74966,"_31069":74944,"_21510":127558,"_5":14782,"_28250":127497,"_3059":127559},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3603":74967,"_31069":74944,"_21510":127561,"_5":14782,"_28250":127501,"_3059":127562},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3603":74968,"_31069":74944,"_21510":127564,"_5":14782,"_28250":127501,"_3059":127565},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3603":74969,"_31069":74944,"_21510":127567,"_5":14782,"_28250":127505,"_3059":127568},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3603":74970,"_31069":74944,"_21510":127570,"_5":14782,"_28250":127505,"_3059":127571},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3603":74971,"_31069":74944,"_21510":127573,"_5":14782,"_28250":127509,"_3059":127574},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3603":74972,"_31069":74944,"_21510":127576,"_5":14782,"_28250":127513,"_3059":127577},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3603":74973,"_31069":74944,"_21510":127579,"_5":14782,"_28250":127517,"_3059":127580},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3603":74974,"_31069":74944,"_21510":127582,"_5":14782,"_28250":127521,"_3059":127583},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3603":74975,"_31069":74944,"_21510":127585,"_5":14782,"_28250":127521,"_3059":127586},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3603":74976,"_31069":74944,"_21510":127588,"_5":14782,"_28250":127521,"_3059":127589},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3603":74977,"_31069":74944,"_21510":127591,"_5":14782,"_28250":127525,"_3059":127592},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3603":74978,"_31069":74944,"_21510":127594,"_5":14782,"_28250":127525,"_3059":127595},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3603":74979,"_31069":74944,"_21510":127597,"_5":14782,"_28250":127525,"_3059":127598},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3603":74980,"_31069":74944,"_21510":127600,"_5":14782,"_28250":127529,"_3059":125021},[],{"_3603":74981,"_31069":74944,"_21510":127602,"_5":14782,"_28250":127529,"_3059":123542},[],{"_3603":74982,"_31069":74944,"_21510":127604,"_5":14782,"_28250":127529,"_3059":127605},[],"La CA rechaza la emisión",{"_3603":74983,"_31069":74944,"_21510":127607,"_5":14782,"_28250":127529,"_3059":127608},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3603":74984,"_31069":74944,"_21510":127610,"_5":14782,"_28250":127529,"_3059":127611},[],"Sujeto o usos diferentes",{"_3603":74985,"_31069":74944,"_21510":127613,"_5":14782,"_28250":127529,"_3059":127614},[],"Perfil aplicado y valores solicitados.",{"_3603":74986,"_31069":74944,"_21510":127616,"_5":14782,"_28250":127529,"_3059":127617},[],"No se encuentra el emisor",{"_3603":74987,"_31069":74944,"_21510":127619,"_5":14782,"_28250":127529,"_3059":127620},[],"CA descargada y cadena intermedia necesaria.",{"_3603":74988,"_31069":74944,"_21510":127622,"_5":14782,"_28250":127529,"_3059":127623},[],"Falla la vigencia",{"_3603":74989,"_31069":74944,"_21510":127625,"_5":14782,"_28250":127529,"_3059":127626},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3603":74990,"_31069":74944,"_21510":127628,"_5":14782,"_28250":127529,"_3059":127629},[],"Los resúmenes de clave difieren",{"_3603":74991,"_31069":74944,"_21510":127631,"_5":14782,"_28250":127529,"_3059":127632},[],"Archivos de certificado y clave de la misma emisión.",{"_3603":74992,"_31069":74944,"_21510":127634,"_5":14782,"_28250":127529,"_3059":127635},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3603":74993,"_31069":74944,"_21510":127637,"_5":14782,"_28250":127532,"_3059":127638},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3603":74994,"_31069":74944,"_21510":127640,"_5":14782,"_28250":127532,"_3059":127641},[],"Gestionar certificados para inspección, estado y revocación.",{"_3603":74995,"_31069":74944,"_21510":127643,"_5":14782,"_28250":127532,"_3059":127644},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3603":74996,"_31069":74944,"_21510":127646,"_5":14782,"_28250":127532,"_3059":127647},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3603":74997,"_31069":74944,"_21510":127649,"_5":14782,"_28250":127532,"_3059":127650},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3603":74998,"_31069":74998,"_5":15147,"_3059":127652,"_31428":127653,"_21510":127654,"_28250":74998},"Primeros pasos de PKI",[50742,121227,56420,124691],[],{"_3603":74999,"_31069":74998,"_21510":127656,"_5":14782,"_28250":74998,"_3059":127657},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3603":75000,"_31069":74998,"_5":31425,"_21510":127659,"_28250":127660,"_3059":119761},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3603":75001,"_31069":74998,"_5":31425,"_21510":127662,"_28250":127663,"_3059":127664},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3603":75002,"_31069":74998,"_5":31425,"_21510":127666,"_28250":127667,"_3059":124873},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3603":75003,"_31069":74998,"_5":31425,"_21510":127669,"_28250":127670,"_3059":127671},[],"/docs/pr-preview/pr-74/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3603":75004,"_31069":74998,"_21510":127673,"_5":14782,"_28250":74998,"_3059":127674},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3603":75005,"_31069":74998,"_21510":127676,"_5":14782,"_28250":127660,"_3059":127677},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3603":75006,"_31069":74998,"_21510":127679,"_5":14782,"_28250":127660,"_3059":127680},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3603":75007,"_31069":74998,"_21510":127682,"_5":14782,"_28250":127660,"_3059":127683},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3603":75008,"_31069":74998,"_21510":127685,"_5":14782,"_28250":127660,"_3059":127686},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3603":75009,"_31069":74998,"_21510":127688,"_5":14782,"_28250":127660,"_3059":127689},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3603":75010,"_31069":74998,"_21510":127691,"_5":14782,"_28250":127663,"_3059":127692},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3603":75011,"_31069":74998,"_21510":127694,"_5":14782,"_28250":127663,"_3059":127695},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3603":75012,"_31069":74998,"_21510":127697,"_5":14782,"_28250":127663,"_3059":127698},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3603":75013,"_31069":74998,"_21510":127700,"_5":14782,"_28250":127663,"_3059":127701},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3603":75014,"_31069":74998,"_21510":127703,"_5":14782,"_28250":127667,"_3059":127704},[],"Archivo o recurso",{"_3603":75015,"_31069":74998,"_21510":127706,"_5":14782,"_28250":127667,"_3059":124870},[],{"_3603":75016,"_31069":74998,"_21510":127708,"_5":14782,"_28250":127667,"_3059":127709},[],"CA raíz activa y `ca.pem`",{"_3603":75017,"_31069":74998,"_21510":127711,"_5":14782,"_28250":127667,"_3059":127712},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3603":75018,"_31069":74998,"_21510":127714,"_5":14782,"_28250":127667,"_3059":127715},[],"Certificado final y `device.crt`",{"_3603":75019,"_31069":74998,"_21510":127717,"_5":14782,"_28250":127667,"_3059":127718},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3603":75020,"_31069":74998,"_21510":127720,"_5":14782,"_28250":127667,"_3059":127721},[],"Clave privada `device.key`",{"_3603":75021,"_31069":74998,"_21510":127723,"_5":14782,"_28250":127667,"_3059":127724},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3603":75022,"_31069":74998,"_21510":127726,"_5":14782,"_28250":127667,"_3059":127727},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3603":75023,"_31069":74998,"_21510":127729,"_5":14782,"_28250":127670,"_3059":127730},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3603":75024,"_31069":74998,"_21510":127732,"_5":14782,"_28250":127670,"_3059":127733},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3603":75025,"_31069":74998,"_21510":127735,"_5":14782,"_28250":127670,"_3059":127736},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3603":75026,"_31069":75026,"_5":15147,"_3059":127738,"_31428":127739,"_21510":127741,"_28250":75026},"Resolución de problemas PKI",[50742,121227,56420,127740],"Resolución de problemas",[],{"_3603":75027,"_31069":75026,"_21510":127743,"_5":14782,"_28250":75026,"_3059":127744},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3603":75028,"_31069":75026,"_5":31425,"_21510":127746,"_28250":127747,"_3059":127748},[],"/docs/pr-preview/pr-74/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3603":75029,"_31069":75026,"_5":31425,"_21510":127750,"_28250":127751,"_3059":127752},[],"/docs/pr-preview/pr-74/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3603":75030,"_31069":75026,"_5":31425,"_21510":127754,"_28250":127755,"_3059":127756},[],"/docs/pr-preview/pr-74/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3603":75031,"_31069":75026,"_21510":127758,"_5":14782,"_28250":75026,"_3059":127759},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3603":75032,"_31069":75026,"_21510":127761,"_5":14782,"_28250":75026,"_3059":127762},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3603":75033,"_31069":75026,"_21510":127764,"_5":14782,"_28250":127747,"_3059":124870},[],{"_3603":75034,"_31069":75026,"_21510":127766,"_5":14782,"_28250":127747,"_3059":123542},[],{"_3603":75035,"_31069":75026,"_21510":127768,"_5":14782,"_28250":127747,"_3059":119785},[],{"_3603":75036,"_31069":75026,"_21510":127770,"_5":14782,"_28250":127747,"_3059":55262},[],{"_3603":75037,"_31069":75026,"_21510":127772,"_5":14782,"_28250":127747,"_3059":127773},[],"Existe, está activa y sus fechas son utilizables.",{"_3603":75038,"_31069":75026,"_21510":127775,"_5":14782,"_28250":127747,"_3059":127776},[],"Autoridades.",{"_3603":75039,"_31069":75026,"_21510":127778,"_5":14782,"_28250":127747,"_3059":127779},[],"Clave",{"_3603":75040,"_31069":75026,"_21510":127781,"_5":14782,"_28250":127747,"_3059":127782},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3603":75041,"_31069":75026,"_21510":127784,"_5":14782,"_28250":127747,"_3059":127785},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3603":75042,"_31069":75026,"_21510":127787,"_5":14782,"_28250":127747,"_3059":59002},[],{"_3603":75043,"_31069":75026,"_21510":127789,"_5":14782,"_28250":127747,"_3059":127790},[],"PEM correcto y firma verificable.",{"_3603":75044,"_31069":75026,"_21510":127792,"_5":14782,"_28250":127747,"_3059":59008},[],{"_3603":75045,"_31069":75026,"_21510":127794,"_5":14782,"_28250":127747,"_3059":127795},[],"Perfil",{"_3603":75046,"_31069":75026,"_21510":127797,"_5":14782,"_28250":127747,"_3059":127798},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3603":75047,"_31069":75026,"_21510":127800,"_5":14782,"_28250":127747,"_3059":127801},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3603":75048,"_31069":75026,"_21510":127803,"_5":14782,"_28250":127747,"_3059":125021},[],{"_3603":75049,"_31069":75026,"_21510":127805,"_5":14782,"_28250":127747,"_3059":127806},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3603":75050,"_31069":75026,"_21510":127808,"_5":14782,"_28250":127747,"_3059":127809},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3603":75051,"_31069":75026,"_21510":127811,"_5":14782,"_28250":127747,"_3059":127812},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3603":75052,"_31069":75026,"_21510":127814,"_5":14782,"_28250":127747,"_3059":127815},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3603":75053,"_31069":75026,"_21510":127817,"_5":14782,"_28250":127747,"_3059":127818},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3603":75054,"_31069":75026,"_21510":127820,"_5":14782,"_28250":127751,"_3059":127821},[],"Revisa cada frontera por separado:",{"_3603":75055,"_31069":75026,"_21510":127823,"_5":14782,"_28250":127751,"_3059":127824},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3603":75056,"_31069":75026,"_21510":127826,"_5":14782,"_28250":127751,"_3059":127827},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3603":75057,"_31069":75026,"_21510":127829,"_5":14782,"_28250":127751,"_3059":127830},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3603":75058,"_31069":75026,"_21510":127832,"_5":14782,"_28250":127751,"_3059":127833},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3603":75059,"_31069":75026,"_21510":127835,"_5":14782,"_28250":127751,"_3059":127836},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3603":75060,"_31069":75026,"_21510":127838,"_5":14782,"_28250":127751,"_3059":127839},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3603":75061,"_31069":75026,"_21510":127841,"_5":14782,"_28250":127755,"_3059":127842},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3603":75062,"_31069":75026,"_21510":127844,"_5":14782,"_28250":127755,"_3059":127845},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3603":75063,"_31069":75063,"_5":15147,"_3059":127847,"_31428":127848,"_21510":127849,"_28250":75063},"Seguridad",[50742],[],{"_3603":75064,"_31069":75063,"_21510":127851,"_5":14782,"_28250":75063,"_3059":127852},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3603":75065,"_31069":75063,"_5":31425,"_21510":127854,"_28250":127855,"_3059":127856},[],"/docs/pr-preview/pr-74/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3603":75066,"_31069":75063,"_5":31425,"_21510":127858,"_28250":127859,"_3059":127860},[],"/docs/pr-preview/pr-74/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3603":75067,"_31069":75063,"_5":31425,"_21510":127862,"_28250":127863,"_3059":127864},[],"/docs/pr-preview/pr-74/es/security#versiones-soportadas","Versiones soportadas",{"_3603":75068,"_31069":75063,"_5":31425,"_21510":127866,"_28250":127867,"_3059":127868},[],"/docs/pr-preview/pr-74/es/security#divulgación-responsable","Divulgación responsable",{"_3603":75069,"_31069":75063,"_21510":127870,"_5":14782,"_28250":75063,"_3059":127871},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3603":75070,"_31069":75063,"_21510":127873,"_5":14782,"_28250":127855,"_3059":127874},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3603":75071,"_31069":75063,"_21510":127876,"_5":14782,"_28250":127855,"_3059":127877},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3603":75072,"_31069":75063,"_21510":127879,"_5":14782,"_28250":127855,"_3059":15421},[],{"_3603":75073,"_31069":75063,"_21510":127881,"_5":14782,"_28250":127855,"_3059":15350},[],{"_3603":75074,"_31069":75063,"_21510":127883,"_5":14782,"_28250":127855,"_3059":15408},[],{"_3603":75075,"_31069":75063,"_21510":127885,"_5":14782,"_28250":127855,"_3059":127886},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3603":75076,"_31069":75063,"_21510":127888,"_5":14782,"_28250":127855,"_3059":127889},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3603":75077,"_31069":75063,"_21510":127891,"_5":14782,"_28250":127859,"_3059":127892},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3603":75078,"_31069":75063,"_21510":127894,"_5":14782,"_28250":127859,"_3059":127895},[],"No incluyas en el reporte:",{"_3603":75079,"_31069":75063,"_21510":127897,"_5":14782,"_28250":127859,"_3059":127898},[],"Credenciales, tokens o claves privadas",{"_3603":75080,"_31069":75063,"_21510":127900,"_5":14782,"_28250":127859,"_3059":127901},[],"Datos de clientes o información identificable de clientes",{"_3603":75081,"_31069":75063,"_21510":127903,"_5":14782,"_28250":127859,"_3059":127904},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3603":75082,"_31069":75063,"_21510":127906,"_5":14782,"_28250":127863,"_3059":127907},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3603":75083,"_31069":75063,"_21510":127909,"_5":14782,"_28250":127863,"_3059":127910},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3603":75084,"_31069":75063,"_21510":127912,"_5":14782,"_28250":127867,"_3059":127913},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3603":75085,"_31069":75063,"_21510":127915,"_5":14782,"_28250":127867,"_3059":127916},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3603":75086,"_31069":75063,"_21510":127918,"_5":14782,"_28250":127867,"_3059":127919},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3603":75087,"_31069":75063,"_21510":127921,"_5":14782,"_28250":127867,"_3059":127922},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3603":75088,"_31069":75063,"_21510":127924,"_5":14782,"_28250":127867,"_3059":127925},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3603":75089,"_31069":75089,"_5":15147,"_3059":127927,"_31428":127928,"_21510":127930,"_28250":75089},"3.8.0 a 4.0.0",[50742,127929],"Actualizaciones",[],{"_3603":75090,"_31069":75089,"_21510":127932,"_5":14782,"_28250":75089,"_3059":127933},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3603":75091,"_31069":75089,"_5":31425,"_21510":127935,"_28250":127936,"_3059":127937},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3603":75092,"_31069":75089,"_5":31425,"_21510":127939,"_28250":127940,"_3059":127941},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3603":75093,"_31069":75089,"_5":31425,"_21510":127943,"_28250":127944,"_3059":127945},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3603":75094,"_31069":75089,"_5":31425,"_21510":127947,"_28250":127948,"_3059":127949},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3603":75095,"_31069":75089,"_5":31425,"_21510":127951,"_28250":127952,"_3059":127953},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3603":75096,"_31069":75089,"_5":31425,"_21510":127955,"_28250":127956,"_3059":127957},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3603":75097,"_31069":75089,"_5":31425,"_21510":127959,"_28250":127960,"_3059":59177},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3603":75098,"_31069":75089,"_5":31425,"_21510":127962,"_28250":127963,"_3059":127964},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3603":75099,"_31069":75089,"_5":31425,"_21510":127966,"_28250":127967,"_3059":127968},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3603":75100,"_31069":75089,"_5":31425,"_21510":127970,"_28250":127971,"_3059":127972},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3603":75101,"_31069":75089,"_5":31425,"_21510":127974,"_28250":127975,"_3059":120356},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3603":75102,"_31069":75089,"_5":31425,"_21510":127977,"_28250":127978,"_3059":127979},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3603":75103,"_31069":75089,"_5":31425,"_21510":127981,"_28250":127982,"_3059":127983},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3603":75104,"_31069":75089,"_5":31425,"_21510":127985,"_28250":127986,"_3059":127987},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3603":75105,"_31069":75089,"_5":31425,"_21510":127989,"_28250":127990,"_3059":127991},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3603":75106,"_31069":75089,"_5":31425,"_21510":127993,"_28250":127994,"_3059":127995},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3603":75107,"_31069":75089,"_5":31425,"_21510":127997,"_28250":127998,"_3059":127999},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3603":75108,"_31069":75089,"_5":31425,"_21510":128001,"_28250":128002,"_3059":128003},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3603":75109,"_31069":75089,"_5":31425,"_21510":128005,"_28250":128006,"_3059":128007},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3603":75110,"_31069":75089,"_5":31425,"_21510":128009,"_28250":128010,"_3059":128011},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3603":75111,"_31069":75089,"_5":31425,"_21510":128013,"_28250":128014,"_3059":128015},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3603":75112,"_31069":75089,"_5":31425,"_21510":128017,"_28250":128018,"_3059":128019},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3603":75113,"_31069":75089,"_5":31425,"_21510":128021,"_28250":128022,"_3059":128023},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3603":75114,"_31069":75089,"_5":31425,"_21510":128025,"_28250":128026,"_3059":128027},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3603":75115,"_31069":75089,"_5":31425,"_21510":128029,"_28250":128030,"_3059":128031},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3603":75116,"_31069":75089,"_5":31425,"_21510":128033,"_28250":128034,"_3059":128035},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3603":75117,"_31069":75089,"_5":31425,"_21510":128037,"_28250":128038,"_3059":128039},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3603":75118,"_31069":75089,"_5":31425,"_21510":128041,"_28250":128042,"_3059":128043},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3603":75119,"_31069":75089,"_5":31425,"_21510":128045,"_28250":128046,"_3059":128047},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3603":75120,"_31069":75089,"_5":31425,"_21510":128049,"_28250":128050,"_3059":128051},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3603":75121,"_31069":75089,"_5":31425,"_21510":128053,"_28250":128054,"_3059":128055},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3603":75122,"_31069":75089,"_5":31425,"_21510":128057,"_28250":128058,"_3059":128059},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3603":75123,"_31069":75089,"_5":31425,"_21510":128061,"_28250":128062,"_3059":128063},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3603":75124,"_31069":75089,"_5":31425,"_21510":128065,"_28250":128066,"_3059":128067},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3603":75125,"_31069":75089,"_5":31425,"_21510":128069,"_28250":128070,"_3059":128071},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3603":75126,"_31069":75089,"_5":31425,"_21510":128073,"_28250":128074,"_3059":128075},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3603":75127,"_31069":75089,"_5":31425,"_21510":128077,"_28250":128078,"_3059":128079},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3603":75128,"_31069":75089,"_5":31425,"_21510":128081,"_28250":128082,"_3059":128083},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3603":75129,"_31069":75089,"_5":31425,"_21510":128085,"_28250":128086,"_3059":128087},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3603":75130,"_31069":75089,"_5":31425,"_21510":128089,"_28250":128090,"_3059":128091},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3603":75131,"_31069":75089,"_5":31425,"_21510":128093,"_28250":128094,"_3059":128095},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3603":75132,"_31069":75089,"_5":31425,"_21510":128097,"_28250":128098,"_3059":128099},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3603":75133,"_31069":75089,"_5":31425,"_21510":128101,"_28250":128102,"_3059":123884},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3603":75134,"_31069":75089,"_5":31425,"_21510":128104,"_28250":128105,"_3059":128106},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3603":75135,"_31069":75089,"_5":31425,"_21510":128108,"_28250":128109,"_3059":128110},[],"/docs/pr-preview/pr-74/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3603":75136,"_31069":75089,"_21510":128112,"_5":14782,"_28250":75089,"_3059":128113},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3603":75137,"_31069":75089,"_21510":128115,"_5":14782,"_28250":75089,"_3059":128116},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3603":75138,"_31069":75089,"_21510":128118,"_5":14782,"_28250":75089,"_3059":128119},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3603":75139,"_31069":75089,"_21510":128121,"_5":14782,"_28250":75089,"_3059":128122},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3603":75140,"_31069":75089,"_21510":128124,"_5":14782,"_28250":75089,"_3059":128125},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3603":75141,"_31069":75089,"_21510":128127,"_5":14782,"_28250":75089,"_3059":128128},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3603":75142,"_31069":75089,"_21510":128130,"_5":14782,"_28250":75089,"_3059":128131},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3603":75143,"_31069":75089,"_21510":128133,"_5":14782,"_28250":127940,"_3059":128134},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3603":75144,"_31069":75089,"_21510":128136,"_5":14782,"_28250":127940,"_3059":128137},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3603":75145,"_31069":75089,"_21510":128139,"_5":14782,"_28250":127944,"_3059":128140},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3603":75146,"_31069":75089,"_21510":128142,"_5":14782,"_28250":127944,"_3059":128143},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3603":75147,"_31069":75089,"_21510":128145,"_5":14782,"_28250":127948,"_3059":128146},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3603":75148,"_31069":75089,"_21510":128148,"_5":14782,"_28250":127952,"_3059":128149},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3603":75149,"_31069":75089,"_21510":128151,"_5":14782,"_28250":127952,"_3059":128152},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3603":75150,"_31069":75089,"_21510":128154,"_5":14782,"_28250":127952,"_3059":128155},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3603":75151,"_31069":75089,"_21510":128157,"_5":14782,"_28250":127952,"_3059":128158},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3603":75152,"_31069":75089,"_21510":128160,"_5":14782,"_28250":127952,"_3059":128161},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3603":75153,"_31069":75089,"_21510":128163,"_5":14782,"_28250":127956,"_3059":128164},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3603":75154,"_31069":75089,"_21510":128166,"_5":14782,"_28250":127956,"_3059":128167},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3603":75155,"_31069":75089,"_21510":128169,"_5":14782,"_28250":127956,"_3059":128170},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3603":75156,"_31069":75089,"_21510":128172,"_5":14782,"_28250":127956,"_3059":128173},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3603":75157,"_31069":75089,"_21510":128175,"_5":14782,"_28250":127956,"_3059":128176},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3603":75158,"_31069":75089,"_21510":128178,"_5":14782,"_28250":127956,"_3059":128179},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3603":75159,"_31069":75089,"_21510":128181,"_5":14782,"_28250":127960,"_3059":128182},[],"Cambio",{"_3603":75160,"_31069":75089,"_21510":128184,"_5":14782,"_28250":127960,"_3059":128185},[],"A quién afecta",{"_3603":75161,"_31069":75089,"_21510":128187,"_5":14782,"_28250":127960,"_3059":128188},[],"Gravedad",{"_3603":75162,"_31069":75089,"_21510":128190,"_5":14782,"_28250":127960,"_3059":126669},[],{"_3603":75163,"_31069":75089,"_21510":128192,"_5":14782,"_28250":127960,"_3059":127968},[],{"_3603":75164,"_31069":75089,"_21510":128194,"_5":14782,"_28250":127960,"_3059":128195},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3603":75165,"_31069":75089,"_21510":128197,"_5":14782,"_28250":127960,"_3059":128198},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3603":75166,"_31069":75089,"_21510":128200,"_5":14782,"_28250":127960,"_3059":128201},[],"Copiar los datos a los volúmenes nuevos",{"_3603":75167,"_31069":75089,"_21510":128203,"_5":14782,"_28250":127960,"_3059":127972},[],{"_3603":75168,"_31069":75089,"_21510":128205,"_5":14782,"_28250":127960,"_3059":128206},[],"Todas las releases de Helm",{"_3603":75169,"_31069":75089,"_21510":128208,"_5":14782,"_28250":127960,"_3059":128209},[],"Alta: `helm upgrade` falla",{"_3603":75170,"_31069":75089,"_21510":128211,"_5":14782,"_28250":127960,"_3059":128212},[],"Eliminar o renombrar las claves heredadas",{"_3603":75171,"_31069":75089,"_21510":128214,"_5":14782,"_28250":127960,"_3059":120356},[],{"_3603":75172,"_31069":75089,"_21510":128216,"_5":14782,"_28250":127960,"_3059":128206},[],{"_3603":75173,"_31069":75089,"_21510":128218,"_5":14782,"_28250":127960,"_3059":128219},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3603":75174,"_31069":75089,"_21510":128221,"_5":14782,"_28250":127960,"_3059":128222},[],"Crear primero los Secrets; consulta el paso 2",{"_3603":75175,"_31069":75089,"_21510":128224,"_5":14782,"_28250":127960,"_3059":127979},[],{"_3603":75176,"_31069":75089,"_21510":128226,"_5":14782,"_28250":127960,"_3059":128227},[],"Todos los despliegues",{"_3603":75177,"_31069":75089,"_21510":128229,"_5":14782,"_28250":127960,"_3059":128230},[],"Alta: sin principal de bootstrap no hay administrador",{"_3603":75178,"_31069":75089,"_21510":128232,"_5":14782,"_28250":127960,"_3059":128233},[],"Configurar `services.authz`",{"_3603":75179,"_31069":75089,"_21510":128235,"_5":14782,"_28250":127960,"_3059":127983},[],{"_3603":75180,"_31069":75089,"_21510":128237,"_5":14782,"_28250":127960,"_3059":128206},[],{"_3603":75181,"_31069":75089,"_21510":128239,"_5":14782,"_28250":127960,"_3059":128240},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3603":75182,"_31069":75089,"_21510":128242,"_5":14782,"_28250":127960,"_3059":128243},[],"Mover JWKS y roles a `services.authz`",{"_3603":75183,"_31069":75089,"_21510":128245,"_5":14782,"_28250":127960,"_3059":128003},[],{"_3603":75184,"_31069":75089,"_21510":128247,"_5":14782,"_28250":127960,"_3059":128248},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3603":75185,"_31069":75089,"_21510":128250,"_5":14782,"_28250":127960,"_3059":128251},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3603":75186,"_31069":75089,"_21510":128253,"_5":14782,"_28250":127960,"_3059":128254},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3603":75187,"_31069":75089,"_21510":128256,"_5":14782,"_28250":127960,"_3059":128007},[],{"_3603":75188,"_31069":75089,"_21510":128258,"_5":14782,"_28250":127960,"_3059":128259},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3603":75189,"_31069":75089,"_21510":128261,"_5":14782,"_28250":127960,"_3059":128262},[],"Alta: el backend ya no arranca con ellos",{"_3603":75190,"_31069":75089,"_21510":128264,"_5":14782,"_28250":127960,"_3059":128265},[],"Pasar a PostgreSQL antes de actualizar",{"_3603":75191,"_31069":75089,"_21510":128267,"_5":14782,"_28250":127960,"_3059":128051},[],{"_3603":75192,"_31069":75089,"_21510":128269,"_5":14782,"_28250":127960,"_3059":128270},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3603":75193,"_31069":75089,"_21510":128272,"_5":14782,"_28250":127960,"_3059":128273},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3603":75194,"_31069":75089,"_21510":128275,"_5":14782,"_28250":127960,"_3059":128276},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3603":75195,"_31069":75089,"_21510":128278,"_5":14782,"_28250":127960,"_3059":128279},[],"Webhooks con referencias a archivos",{"_3603":75196,"_31069":75089,"_21510":128281,"_5":14782,"_28250":127960,"_3059":128282},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3603":75197,"_31069":75089,"_21510":128284,"_5":14782,"_28250":127960,"_3059":128285},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3603":75198,"_31069":75089,"_21510":128287,"_5":14782,"_28250":127960,"_3059":128288},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3603":75199,"_31069":75089,"_21510":128290,"_5":14782,"_28250":127960,"_3059":127987},[],{"_3603":75200,"_31069":75089,"_21510":128292,"_5":14782,"_28250":127960,"_3059":128293},[],"Releases con identidades por servicio o material de claves montado",{"_3603":75201,"_31069":75089,"_21510":128295,"_5":14782,"_28250":127960,"_3059":128296},[],"Media: los servicios no pueden leer sus archivos",{"_3603":75202,"_31069":75089,"_21510":128298,"_5":14782,"_28250":127960,"_3059":128299},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3603":75203,"_31069":75089,"_21510":128301,"_5":14782,"_28250":127960,"_3059":127991},[],{"_3603":75204,"_31069":75089,"_21510":128303,"_5":14782,"_28250":127960,"_3059":128304},[],"Releases que definen `amqp.tls`",{"_3603":75205,"_31069":75089,"_21510":128306,"_5":14782,"_28250":127960,"_3059":128307},[],"Media: los clientes se conectan al puerto equivocado",{"_3603":75206,"_31069":75089,"_21510":128309,"_5":14782,"_28250":127960,"_3059":128310},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3603":75207,"_31069":75089,"_21510":128312,"_5":14782,"_28250":127960,"_3059":128011},[],{"_3603":75208,"_31069":75089,"_21510":128314,"_5":14782,"_28250":127960,"_3059":128315},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3603":75209,"_31069":75089,"_21510":128317,"_5":14782,"_28250":127960,"_3059":128318},[],"Media: las claves de CA quedan sin gestionar",{"_3603":75210,"_31069":75089,"_21510":128320,"_5":14782,"_28250":127960,"_3059":128321},[],"Ejecutar la migración de CA a KMS",{"_3603":75211,"_31069":75089,"_21510":128323,"_5":14782,"_28250":127960,"_3059":128324},[],"Verificación del certificado del receptor",{"_3603":75212,"_31069":75089,"_21510":128326,"_5":14782,"_28250":127960,"_3059":128327},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3603":75213,"_31069":75089,"_21510":128329,"_5":14782,"_28250":127960,"_3059":128330},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3603":75214,"_31069":75089,"_21510":128332,"_5":14782,"_28250":127960,"_3059":128333},[],"Poner `insecure_skip_verify` a `false`",{"_3603":75215,"_31069":75089,"_21510":128335,"_5":14782,"_28250":127960,"_3059":128027},[],{"_3603":75216,"_31069":75089,"_21510":128337,"_5":14782,"_28250":127960,"_3059":128338},[],"Scripts y consolas que editan DMS por API",{"_3603":75217,"_31069":75089,"_21510":128340,"_5":14782,"_28250":127960,"_3059":128341},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3603":75218,"_31069":75089,"_21510":128343,"_5":14782,"_28250":127960,"_3059":128344},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3603":75219,"_31069":75089,"_21510":128346,"_5":14782,"_28250":127960,"_3059":128047},[],{"_3603":75220,"_31069":75089,"_21510":128348,"_5":14782,"_28250":127960,"_3059":128349},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3603":75221,"_31069":75089,"_21510":128351,"_5":14782,"_28250":127960,"_3059":128352},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3603":75222,"_31069":75089,"_21510":128354,"_5":14782,"_28250":127960,"_3059":128355},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3603":75223,"_31069":75089,"_21510":128357,"_5":14782,"_28250":127960,"_3059":128055},[],{"_3603":75224,"_31069":75089,"_21510":128359,"_5":14782,"_28250":127960,"_3059":128360},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3603":75225,"_31069":75089,"_21510":128362,"_5":14782,"_28250":127960,"_3059":128363},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3603":75226,"_31069":75089,"_21510":128365,"_5":14782,"_28250":127960,"_3059":128366},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3603":75227,"_31069":75089,"_21510":128368,"_5":14782,"_28250":127960,"_3059":128043},[],{"_3603":75228,"_31069":75089,"_21510":128370,"_5":14782,"_28250":127960,"_3059":128371},[],"Consumidores que leen el campo `events` del dispositivo",{"_3603":75229,"_31069":75089,"_21510":128373,"_5":14782,"_28250":127960,"_3059":128374},[],"Media: el campo desaparece",{"_3603":75230,"_31069":75089,"_21510":128376,"_5":14782,"_28250":127960,"_3059":128377},[],"Usar los nuevos endpoints de eventos",{"_3603":75231,"_31069":75089,"_21510":128379,"_5":14782,"_28250":127960,"_3059":128067},[],{"_3603":75232,"_31069":75089,"_21510":128381,"_5":14782,"_28250":127960,"_3059":128382},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3603":75233,"_31069":75089,"_21510":128384,"_5":14782,"_28250":127960,"_3059":128385},[],"Media: la migración de la VA aborta",{"_3603":75234,"_31069":75089,"_21510":128387,"_5":14782,"_28250":127960,"_3059":128388},[],"Corregir los roles afectados antes de actualizar",{"_3603":75235,"_31069":75089,"_21510":128390,"_5":14782,"_28250":127960,"_3059":127995},[],{"_3603":75236,"_31069":75089,"_21510":128392,"_5":14782,"_28250":127960,"_3059":128393},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3603":75237,"_31069":75089,"_21510":128395,"_5":14782,"_28250":127960,"_3059":128396},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3603":75238,"_31069":75089,"_21510":128398,"_5":14782,"_28250":127960,"_3059":128399},[],"Actualizar el archivo de values",{"_3603":75239,"_31069":75089,"_21510":128401,"_5":14782,"_28250":127960,"_3059":128035},[],{"_3603":75240,"_31069":75089,"_21510":128403,"_5":14782,"_28250":127960,"_3059":128404},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3603":75241,"_31069":75089,"_21510":128406,"_5":14782,"_28250":127960,"_3059":128407},[],"Baja: prevalece el ID de la URL",{"_3603":75242,"_31069":75089,"_21510":128409,"_5":14782,"_28250":127960,"_3059":128410},[],"Enviar el ID en la URL",{"_3603":75243,"_31069":75089,"_21510":128412,"_5":14782,"_28250":127960,"_3059":128059},[],{"_3603":75244,"_31069":75089,"_21510":128414,"_5":14782,"_28250":127960,"_3059":128415},[],"Clientes que envían un `id` al crear o importar CAs",{"_3603":75245,"_31069":75089,"_21510":128417,"_5":14782,"_28250":127960,"_3059":128418},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3603":75246,"_31069":75089,"_21510":128420,"_5":14782,"_28250":127960,"_3059":128421},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3603":75247,"_31069":75089,"_21510":128423,"_5":14782,"_28250":127960,"_3059":128063},[],{"_3603":75248,"_31069":75089,"_21510":128425,"_5":14782,"_28250":127960,"_3059":128426},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3603":75249,"_31069":75089,"_21510":128428,"_5":14782,"_28250":127960,"_3059":128429},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3603":75250,"_31069":75089,"_21510":128431,"_5":14782,"_28250":127960,"_3059":128432},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3603":75251,"_31069":75089,"_21510":128434,"_5":14782,"_28250":127960,"_3059":128039},[],{"_3603":75252,"_31069":75089,"_21510":128436,"_5":14782,"_28250":127960,"_3059":128437},[],"Consumidores que comparan el `type` del certificado",{"_3603":75253,"_31069":75089,"_21510":128439,"_5":14782,"_28250":127960,"_3059":128440},[],"Baja: dos valores cambian de nombre",{"_3603":75254,"_31069":75089,"_21510":128442,"_5":14782,"_28250":127960,"_3059":128443},[],"Adaptar los consumidores",{"_3603":75255,"_31069":75089,"_21510":128445,"_5":14782,"_28250":127960,"_3059":128031},[],{"_3603":75256,"_31069":75089,"_21510":128447,"_5":14782,"_28250":127960,"_3059":128448},[],"Cualquier DMS",{"_3603":75257,"_31069":75089,"_21510":128450,"_5":14782,"_28250":127960,"_3059":128451},[],"Baja: solo informativo",{"_3603":75258,"_31069":75089,"_21510":128453,"_5":14782,"_28250":127960,"_3059":128454},[],"Revisar ambos bloques antes de editar",{"_3603":75259,"_31069":75089,"_21510":128456,"_5":14782,"_28250":127967,"_3059":128457},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3603":75260,"_31069":75089,"_21510":128459,"_5":14782,"_28250":127967,"_3059":128460},[],"El paso 4 de la guía de migración copia los datos.",{"_3603":75261,"_31069":75089,"_21510":128462,"_5":14782,"_28250":127971,"_3059":128463},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3603":75262,"_31069":75089,"_21510":128465,"_5":14782,"_28250":127975,"_3059":128466},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3603":75263,"_31069":75089,"_21510":128468,"_5":14782,"_28250":127975,"_3059":128469},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3603":75264,"_31069":75089,"_21510":128471,"_5":14782,"_28250":127978,"_3059":128472},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3603":75265,"_31069":75089,"_21510":128474,"_5":14782,"_28250":127982,"_3059":128475},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3603":75266,"_31069":75089,"_21510":128477,"_5":14782,"_28250":127986,"_3059":128478},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3603":75267,"_31069":75089,"_21510":128480,"_5":14782,"_28250":127986,"_3059":128481},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3603":75268,"_31069":75089,"_21510":128483,"_5":14782,"_28250":127986,"_3059":128484},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3603":75269,"_31069":75089,"_21510":128486,"_5":14782,"_28250":127990,"_3059":128487},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3603":75270,"_31069":75089,"_21510":128489,"_5":14782,"_28250":127994,"_3059":128490},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3603":75271,"_31069":75089,"_21510":128492,"_5":14782,"_28250":127994,"_3059":128493},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3603":75272,"_31069":75089,"_21510":128495,"_5":14782,"_28250":127994,"_3059":128496},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3603":75273,"_31069":75089,"_21510":128498,"_5":14782,"_28250":127994,"_3059":128499},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3603":75274,"_31069":75089,"_21510":128501,"_5":14782,"_28250":127994,"_3059":128502},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3603":75275,"_31069":75089,"_21510":128504,"_5":14782,"_28250":127994,"_3059":128505},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3603":75276,"_31069":75089,"_21510":128507,"_5":14782,"_28250":128002,"_3059":128508},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3603":75277,"_31069":75089,"_21510":128510,"_5":14782,"_28250":128002,"_3059":128511},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3603":75278,"_31069":75089,"_21510":128513,"_5":14782,"_28250":128002,"_3059":128514},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3603":75279,"_31069":75089,"_21510":128516,"_5":14782,"_28250":128002,"_3059":128517},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3603":75280,"_31069":75089,"_21510":128519,"_5":14782,"_28250":128002,"_3059":128520},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3603":75281,"_31069":75089,"_21510":128522,"_5":14782,"_28250":128006,"_3059":128523},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3603":75282,"_31069":75089,"_21510":128525,"_5":14782,"_28250":128010,"_3059":128526},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3603":75283,"_31069":75089,"_21510":128528,"_5":14782,"_28250":128010,"_3059":128529},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3603":75284,"_31069":75089,"_21510":128531,"_5":14782,"_28250":128010,"_3059":128532},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3603":75285,"_31069":75089,"_21510":128534,"_5":14782,"_28250":128010,"_3059":128535},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3603":75286,"_31069":75089,"_21510":128537,"_5":14782,"_28250":128010,"_3059":128538},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3603":75287,"_31069":75089,"_21510":128540,"_5":14782,"_28250":128010,"_3059":128541},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3603":75288,"_31069":75089,"_21510":128543,"_5":14782,"_28250":128010,"_3059":128544},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3603":75289,"_31069":75089,"_21510":128546,"_5":14782,"_28250":128010,"_3059":128547},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3603":75290,"_31069":75089,"_21510":128549,"_5":14782,"_28250":128014,"_3059":128550},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3603":75291,"_31069":75089,"_21510":128552,"_5":14782,"_28250":128022,"_3059":128553},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3603":75292,"_31069":75089,"_21510":128555,"_5":14782,"_28250":128022,"_3059":128556},[],"Campo en 3.8.0",{"_3603":75293,"_31069":75089,"_21510":128558,"_5":14782,"_28250":128022,"_3059":128559},[],"Campo en 4.0.0",{"_3603":75294,"_31069":75089,"_21510":128561,"_5":14782,"_28250":128022,"_3059":59779},[],{"_3603":75295,"_31069":75089,"_21510":128563,"_5":14782,"_28250":128022,"_3059":128564},[],"`insecure_skip_verify` (con el valor negado)",{"_3603":75296,"_31069":75089,"_21510":128566,"_5":14782,"_28250":128022,"_3059":59785},[],{"_3603":75297,"_31069":75089,"_21510":128568,"_5":14782,"_28250":128022,"_3059":59788},[],{"_3603":75298,"_31069":75089,"_21510":128570,"_5":14782,"_28250":128022,"_3059":59791},[],{"_3603":75299,"_31069":75089,"_21510":128572,"_5":14782,"_28250":128022,"_3059":59794},[],{"_3603":75300,"_31069":75089,"_21510":128574,"_5":14782,"_28250":128022,"_3059":59797},[],{"_3603":75301,"_31069":75089,"_21510":128576,"_5":14782,"_28250":128022,"_3059":59800},[],{"_3603":75302,"_31069":75089,"_21510":128578,"_5":14782,"_28250":128022,"_3059":128579},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3603":75303,"_31069":75089,"_21510":128581,"_5":14782,"_28250":128022,"_3059":128582},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3603":75304,"_31069":75089,"_21510":128584,"_5":14782,"_28250":128022,"_3059":128585},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3603":75305,"_31069":75089,"_21510":128587,"_5":14782,"_28250":128026,"_3059":128588},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3603":75306,"_31069":75089,"_21510":128590,"_5":14782,"_28250":128026,"_3059":128591},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3603":75307,"_31069":75089,"_21510":128593,"_5":14782,"_28250":128026,"_3059":128594},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3603":75308,"_31069":75089,"_21510":128596,"_5":14782,"_28250":128030,"_3059":128597},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3603":75309,"_31069":75089,"_21510":128599,"_5":14782,"_28250":128034,"_3059":128600},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3603":75310,"_31069":75089,"_21510":128602,"_5":14782,"_28250":128038,"_3059":128603},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3603":75311,"_31069":75089,"_21510":128605,"_5":14782,"_28250":128042,"_3059":128606},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3603":75312,"_31069":75089,"_21510":128608,"_5":14782,"_28250":128042,"_3059":128609},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3603":75313,"_31069":75089,"_21510":128611,"_5":14782,"_28250":128042,"_3059":128612},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3603":75314,"_31069":75089,"_21510":128614,"_5":14782,"_28250":128042,"_3059":128615},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3603":75315,"_31069":75089,"_21510":128617,"_5":14782,"_28250":128046,"_3059":128618},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3603":75316,"_31069":75089,"_21510":128620,"_5":14782,"_28250":128050,"_3059":128621},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3603":75317,"_31069":75089,"_21510":128623,"_5":14782,"_28250":128050,"_3059":128624},[],"Ruta",{"_3603":75318,"_31069":75089,"_21510":128626,"_5":14782,"_28250":128050,"_3059":120987},[],{"_3603":75319,"_31069":75089,"_21510":128628,"_5":14782,"_28250":128050,"_3059":59853},[],{"_3603":75320,"_31069":75089,"_21510":128630,"_5":14782,"_28250":128050,"_3059":128631},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3603":75321,"_31069":75089,"_21510":128633,"_5":14782,"_28250":128050,"_3059":59859},[],{"_3603":75322,"_31069":75089,"_21510":128635,"_5":14782,"_28250":128050,"_3059":128636},[],"Lee los ajustes de una CA.",{"_3603":75323,"_31069":75089,"_21510":128638,"_5":14782,"_28250":128050,"_3059":59865},[],{"_3603":75324,"_31069":75089,"_21510":128640,"_5":14782,"_28250":128050,"_3059":128641},[],"Sustituye los `crl_options`.",{"_3603":75325,"_31069":75089,"_21510":128643,"_5":14782,"_28250":128050,"_3059":59871},[],{"_3603":75326,"_31069":75089,"_21510":128645,"_5":14782,"_28250":128050,"_3059":128646},[],"Elimina los ajustes archivados de una CA.",{"_3603":75327,"_31069":75089,"_21510":128648,"_5":14782,"_28250":128050,"_3059":128649},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3603":75328,"_31069":75089,"_21510":128651,"_5":14782,"_28250":128050,"_3059":128652},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3603":75329,"_31069":75089,"_21510":128654,"_5":14782,"_28250":128050,"_3059":128655},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3603":75330,"_31069":75089,"_21510":128657,"_5":14782,"_28250":128050,"_3059":128658},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3603":75331,"_31069":75089,"_21510":128660,"_5":14782,"_28250":128050,"_3059":128661},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3603":75332,"_31069":75089,"_21510":128663,"_5":14782,"_28250":128050,"_3059":128664},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3603":75333,"_31069":75089,"_21510":128666,"_5":14782,"_28250":128050,"_3059":128667},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3603":75334,"_31069":75089,"_21510":128669,"_5":14782,"_28250":128050,"_3059":128670},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3603":75335,"_31069":75089,"_21510":128672,"_5":14782,"_28250":128050,"_3059":128673},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3603":75336,"_31069":75089,"_21510":128675,"_5":14782,"_28250":128050,"_3059":128676},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3603":75337,"_31069":75089,"_21510":128678,"_5":14782,"_28250":128050,"_3059":128679},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3603":75338,"_31069":75089,"_21510":128681,"_5":14782,"_28250":128054,"_3059":128682},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3603":75339,"_31069":75089,"_21510":128684,"_5":14782,"_28250":128058,"_3059":128685},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3603":75340,"_31069":75089,"_21510":128687,"_5":14782,"_28250":128062,"_3059":128688},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3603":75341,"_31069":75089,"_21510":128690,"_5":14782,"_28250":128062,"_3059":128691},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3603":75342,"_31069":75089,"_21510":128693,"_5":14782,"_28250":128066,"_3059":128694},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3603":75343,"_31069":75089,"_21510":128696,"_5":14782,"_28250":128070,"_3059":128697},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3603":75344,"_31069":75089,"_21510":128699,"_5":14782,"_28250":128074,"_3059":128700},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3603":75345,"_31069":75089,"_21510":128702,"_5":14782,"_28250":128074,"_3059":128703},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3603":75346,"_31069":75089,"_21510":128705,"_5":14782,"_28250":128074,"_3059":128706},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3603":75347,"_31069":75089,"_21510":128708,"_5":14782,"_28250":128074,"_3059":128709},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3603":75348,"_31069":75089,"_21510":128711,"_5":14782,"_28250":128074,"_3059":128712},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3603":75349,"_31069":75089,"_21510":128714,"_5":14782,"_28250":128074,"_3059":128715},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3603":75350,"_31069":75089,"_21510":128717,"_5":14782,"_28250":128078,"_3059":128718},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3603":75351,"_31069":75089,"_21510":128720,"_5":14782,"_28250":128078,"_3059":128721},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3603":75352,"_31069":75089,"_21510":128723,"_5":14782,"_28250":128078,"_3059":128724},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3603":75353,"_31069":75089,"_21510":128726,"_5":14782,"_28250":128078,"_3059":128727},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3603":75354,"_31069":75089,"_21510":128729,"_5":14782,"_28250":128078,"_3059":128730},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3603":75355,"_31069":75089,"_21510":128732,"_5":14782,"_28250":128082,"_3059":128733},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3603":75356,"_31069":75089,"_21510":128735,"_5":14782,"_28250":128082,"_3059":128736},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3603":75357,"_31069":75089,"_21510":128738,"_5":14782,"_28250":128082,"_3059":128739},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3603":75358,"_31069":75089,"_21510":128741,"_5":14782,"_28250":128082,"_3059":59970},[],{"_3603":75359,"_31069":75089,"_21510":128743,"_5":14782,"_28250":128082,"_3059":128744},[],"Claves de datos obligatorias",{"_3603":75360,"_31069":75089,"_21510":128746,"_5":14782,"_28250":128082,"_3059":128747},[],"Cuándo",{"_3603":75361,"_31069":75089,"_21510":128749,"_5":14782,"_28250":128082,"_3059":128750},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3603":75362,"_31069":75089,"_21510":128752,"_5":14782,"_28250":128082,"_3059":59982},[],{"_3603":75363,"_31069":75089,"_21510":128754,"_5":14782,"_28250":128082,"_3059":128755},[],"Siempre",{"_3603":75364,"_31069":75089,"_21510":128757,"_5":14782,"_28250":128082,"_3059":128758},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3603":75365,"_31069":75089,"_21510":128760,"_5":14782,"_28250":128082,"_3059":59982},[],{"_3603":75366,"_31069":75089,"_21510":128762,"_5":14782,"_28250":128082,"_3059":128755},[],{"_3603":75367,"_31069":75089,"_21510":128764,"_5":14782,"_28250":128082,"_3059":59995},[],{"_3603":75368,"_31069":75089,"_21510":128766,"_5":14782,"_28250":128082,"_3059":59982},[],{"_3603":75369,"_31069":75089,"_21510":128768,"_5":14782,"_28250":128082,"_3059":128769},[],"Solo cuando hay autenticación SMTP",{"_3603":75370,"_31069":75089,"_21510":128771,"_5":14782,"_28250":128082,"_3059":128772},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3603":75371,"_31069":75089,"_21510":128774,"_5":14782,"_28250":128082,"_3059":128775},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3603":75372,"_31069":75089,"_21510":128777,"_5":14782,"_28250":128082,"_3059":128778},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3603":75373,"_31069":75089,"_21510":128780,"_5":14782,"_28250":128082,"_3059":128781},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3603":75374,"_31069":75089,"_21510":128783,"_5":14782,"_28250":128082,"_3059":128784},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3603":75375,"_31069":75089,"_21510":128786,"_5":14782,"_28250":128082,"_3059":128787},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3603":75376,"_31069":75089,"_21510":128789,"_5":14782,"_28250":128082,"_3059":128790},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3603":75377,"_31069":75089,"_21510":128792,"_5":14782,"_28250":128082,"_3059":128793},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3603":75378,"_31069":75089,"_21510":128795,"_5":14782,"_28250":128082,"_3059":128796},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3603":75379,"_31069":75089,"_21510":128798,"_5":14782,"_28250":128082,"_3059":128799},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3603":75380,"_31069":75089,"_21510":128801,"_5":14782,"_28250":128082,"_3059":128802},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3603":75381,"_31069":75089,"_21510":128804,"_5":14782,"_28250":128082,"_3059":128805},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3603":75382,"_31069":75089,"_21510":128807,"_5":14782,"_28250":128082,"_3059":128808},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3603":75383,"_31069":75089,"_21510":128810,"_5":14782,"_28250":128082,"_3059":128811},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3603":75384,"_31069":75089,"_21510":128813,"_5":14782,"_28250":128082,"_3059":128814},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3603":75385,"_31069":75089,"_21510":128816,"_5":14782,"_28250":128086,"_3059":128817},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3603":75386,"_31069":75089,"_21510":128819,"_5":14782,"_28250":128086,"_3059":128820},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3603":75387,"_31069":75089,"_21510":128822,"_5":14782,"_28250":128090,"_3059":128823},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3603":75388,"_31069":75089,"_21510":128825,"_5":14782,"_28250":128090,"_3059":128826},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3603":75389,"_31069":75089,"_21510":128828,"_5":14782,"_28250":128090,"_3059":128829},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3603":75390,"_31069":75089,"_21510":128831,"_5":14782,"_28250":128090,"_3059":128832},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3603":75391,"_31069":75089,"_21510":128834,"_5":14782,"_28250":128090,"_3059":128835},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3603":75392,"_31069":75089,"_21510":128837,"_5":14782,"_28250":128090,"_3059":128838},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3603":75393,"_31069":75089,"_21510":128840,"_5":14782,"_28250":128090,"_3059":128841},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3603":75394,"_31069":75089,"_21510":128843,"_5":14782,"_28250":128090,"_3059":128844},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3603":75395,"_31069":75089,"_21510":128846,"_5":14782,"_28250":128090,"_3059":128847},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3603":75396,"_31069":75089,"_21510":128849,"_5":14782,"_28250":128090,"_3059":128850},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3603":75397,"_31069":75089,"_21510":128852,"_5":14782,"_28250":128090,"_3059":128853},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3603":75398,"_31069":75089,"_21510":128855,"_5":14782,"_28250":128094,"_3059":128856},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3603":75399,"_31069":75089,"_21510":128858,"_5":14782,"_28250":128094,"_3059":128859},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3603":75400,"_31069":75089,"_21510":128861,"_5":14782,"_28250":128098,"_3059":128862},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3603":75401,"_31069":75089,"_21510":128864,"_5":14782,"_28250":128098,"_3059":128865},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3603":75402,"_31069":75089,"_21510":128867,"_5":14782,"_28250":128098,"_3059":128868},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3603":75403,"_31069":75089,"_21510":128870,"_5":14782,"_28250":128098,"_3059":128871},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3603":75404,"_31069":75089,"_21510":128873,"_5":14782,"_28250":128098,"_3059":128874},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3603":75405,"_31069":75089,"_21510":128876,"_5":14782,"_28250":128098,"_3059":128877},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3603":75406,"_31069":75089,"_21510":128879,"_5":14782,"_28250":128098,"_3059":128880},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3603":75407,"_31069":75089,"_21510":128882,"_5":14782,"_28250":128098,"_3059":128883},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3603":75408,"_31069":75089,"_21510":128885,"_5":14782,"_28250":128102,"_3059":128886},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3603":75409,"_31069":75089,"_21510":128888,"_5":14782,"_28250":128102,"_3059":128889},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3603":75410,"_31069":75089,"_21510":128891,"_5":14782,"_28250":128102,"_3059":128892},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3603":75411,"_31069":75089,"_21510":128894,"_5":14782,"_28250":128102,"_3059":128895},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3603":75412,"_31069":75089,"_21510":128897,"_5":14782,"_28250":128102,"_3059":128898},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3603":75413,"_31069":75089,"_21510":128900,"_5":14782,"_28250":128102,"_3059":128901},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3603":75414,"_31069":75089,"_21510":128903,"_5":14782,"_28250":128102,"_3059":128904},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3603":75415,"_31069":75089,"_21510":128906,"_5":14782,"_28250":128102,"_3059":128907},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3603":75416,"_31069":75089,"_21510":128909,"_5":14782,"_28250":128102,"_3059":128910},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3603":75417,"_31069":75089,"_21510":128912,"_5":14782,"_28250":128102,"_3059":128913},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3603":75418,"_31069":75089,"_21510":128915,"_5":14782,"_28250":128102,"_3059":128916},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3603":75419,"_31069":75089,"_21510":128918,"_5":14782,"_28250":128105,"_3059":128919},[],"Tras la actualización, comprueba en este orden:",{"_3603":75420,"_31069":75089,"_21510":128921,"_5":14782,"_28250":128105,"_3059":128922},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3603":75421,"_31069":75089,"_21510":128924,"_5":14782,"_28250":128105,"_3059":128925},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3603":75422,"_31069":75089,"_21510":128927,"_5":14782,"_28250":128105,"_3059":128928},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3603":75423,"_31069":75089,"_21510":128930,"_5":14782,"_28250":128105,"_3059":128931},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3603":75424,"_31069":75089,"_21510":128933,"_5":14782,"_28250":128105,"_3059":128934},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3603":75425,"_31069":75089,"_21510":128936,"_5":14782,"_28250":128105,"_3059":128937},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3603":75426,"_31069":75089,"_21510":128939,"_5":14782,"_28250":128105,"_3059":128940},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3603":75427,"_31069":75089,"_21510":128942,"_5":14782,"_28250":128105,"_3059":128943},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3603":75428,"_31069":75089,"_21510":128945,"_5":14782,"_28250":128105,"_3059":128946},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3603":75429,"_31069":75089,"_21510":128948,"_5":14782,"_28250":128105,"_3059":128949},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3603":75430,"_31069":75089,"_21510":128951,"_5":14782,"_28250":128105,"_3059":128952},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3603":75431,"_31069":75089,"_21510":128954,"_5":14782,"_28250":128105,"_3059":128955},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3603":75432,"_31069":75089,"_21510":128957,"_5":14782,"_28250":128105,"_3059":128958},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3603":75433,"_31069":75089,"_21510":128960,"_5":14782,"_28250":128105,"_3059":128961},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3603":75434,"_31069":75089,"_21510":128963,"_5":14782,"_28250":128105,"_3059":128964},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3603":75435,"_31069":75089,"_21510":128966,"_5":14782,"_28250":128109,"_3059":128967},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3603":75436,"_31069":75089,"_21510":128969,"_5":14782,"_28250":128109,"_3059":128970},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3603":75437,"_31069":75089,"_21510":128972,"_5":14782,"_28250":128109,"_3059":128973},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3603":75438,"_31069":75089,"_21510":128975,"_5":14782,"_28250":128109,"_3059":128976},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3603":75439,"_31069":75089,"_21510":128978,"_5":14782,"_28250":128109,"_3059":128979},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60213":128981,"_60215":128982,"_60217":128983,"_60219":128984,"_18635":3094,"_72394":3094},"spanish",[3059,31069,5,28250],{"_3059":25685,"_31069":25685,"_5":25685,"_28250":25685},{"_3059":128985,"_31069":132027,"_5":135069,"_28250":138111},{"_4801":128986,"_60223":128987,"_5":25685},{"_14863":7191,"_15242":7737,"_15261":7168,"_30068":7249,"_15248":4187,"_20417":3350,"_14884":4146,"_14891":7212,"_30010":5342,"_30424":4210,"_30445":7309,"_30044":3836,"_35469":6829,"_30147":20903,"_30489":10163,"_35476":5422,"_35479":4121,"_35482":3501,"_35485":3348,"_30891":13815,"_35490":4879,"_35492":26081,"_30926":11937,"_15257":19014,"_35496":7766,"_35499":10771,"_35501":10404,"_30473":19980,"_30911":4704,"_30939":10493,"_35506":5115,"_35508":12678,"_35510":6210,"_30164":8995,"_35513":3453,"_35515":7173,"_35517":3438,"_35519":6561,"_35521":3461,"_30081":14830,"_35524":3418,"_35526":10305,"_30075":3170,"_30510":10704,"_35530":27842,"_35532":14572,"_35535":4545,"_30121":4699,"_35539":8435,"_30001":6173,"_35542":16259,"_30049":7237,"_35545":3168,"_35547":7211,"_35550":11654,"_15251":19070,"_35553":9341,"_35555":23508,"_35558":25051,"_35560":6846,"_35562":3169,"_35564":10660,"_35566":9105,"_20420":3452,"_35569":10798,"_35571":3813,"_30022":8203,"_30467":6186,"_35575":10465,"_35577":4291,"_35579":7618,"_30956":3460,"_35582":3771,"_31134":7161,"_35585":6699,"_31049":3685,"_30526":13289,"_35589":3123,"_35591":3368,"_30059":3286,"_35594":7167,"_35596":14664,"_35598":3671,"_30972":21077,"_30141":3484,"_29521":15300,"_35603":7555,"_35605":26809