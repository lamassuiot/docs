:60130,"_41493":60133,"_41495":60136,"_41497":60139,"_41499":60142,"_41501":60145,"_41503":60148,"_41505":60151,"_41507":60154,"_41509":60157,"_41511":60160,"_41513":60163,"_41515":60166,"_41517":60169,"_41519":60172,"_41521":60175,"_41523":60178,"_41525":60181,"_41527":60184,"_41529":60187,"_41531":60190,"_41533":60193,"_41535":60196,"_41538":60199,"_41540":60202,"_41542":60205,"_41544":60208},{"_3603":15,"_31069":15,"_5":15147,"_3059":50740,"_31428":50741,"_21510":50745,"_28250":15},"Deploy from AWS Marketplace",[50742,50743,50744],"Docs","Deployment","Other models",[],{"_3603":16,"_31069":15,"_21510":50747,"_5":14782,"_28250":15,"_3059":50748},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3603":17,"_31069":15,"_5":31425,"_21510":50750,"_28250":50751,"_3059":50752},[],"/docs/pr-preview/pr-74/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3603":18,"_31069":15,"_5":31425,"_21510":50754,"_28250":50755,"_3059":50756},[],"/docs/pr-preview/pr-74/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3603":19,"_31069":15,"_5":31425,"_21510":50758,"_28250":50759,"_3059":50760},[],"/docs/pr-preview/pr-74/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3603":20,"_31069":15,"_5":31425,"_21510":50762,"_28250":50763,"_3059":50764},[],"/docs/pr-preview/pr-74/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3603":21,"_31069":15,"_5":31425,"_21510":50766,"_28250":50767,"_3059":50768},[],"/docs/pr-preview/pr-74/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3603":22,"_31069":15,"_5":31425,"_21510":50770,"_28250":50771,"_3059":50772},[],"/docs/pr-preview/pr-74/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3603":23,"_31069":15,"_5":31425,"_21510":50774,"_28250":50775,"_3059":50776},[],"/docs/pr-preview/pr-74/deployment/aws-marketplace#next-step","Next step",{"_3603":24,"_31069":15,"_21510":50778,"_5":14782,"_28250":15,"_3059":50779},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3603":25,"_31069":15,"_21510":50781,"_5":14782,"_28250":50751,"_3059":50782},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3603":26,"_31069":15,"_21510":50784,"_5":14782,"_28250":50751,"_3059":50785},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3603":27,"_31069":15,"_21510":50787,"_5":14782,"_28250":50751,"_3059":50788},[],"A security group allowing the necessary endpoints.",{"_3603":28,"_31069":15,"_21510":50790,"_5":14782,"_28250":50755,"_3059":50791},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3603":29,"_31069":15,"_21510":50793,"_5":14782,"_28250":50755,"_3059":50794},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3603":30,"_31069":15,"_21510":50796,"_5":14782,"_28250":50755,"_3059":50797},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3603":31,"_31069":15,"_21510":50799,"_5":14782,"_28250":50759,"_3059":50800},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3603":32,"_31069":15,"_21510":50802,"_5":14782,"_28250":50763,"_3059":50803},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3603":33,"_31069":15,"_21510":50805,"_5":14782,"_28250":50767,"_3059":50806},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3603":34,"_31069":15,"_21510":50808,"_5":14782,"_28250":50771,"_3059":50809},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3603":35,"_31069":15,"_21510":50811,"_5":14782,"_28250":50775,"_3059":50812},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3603":36,"_31069":36,"_5":15147,"_3059":50814,"_31428":50815,"_21510":50816,"_28250":36},"Deploy Lamassu",[50742,50743],[],{"_3603":37,"_31069":36,"_21510":50818,"_5":14782,"_28250":36,"_3059":50819},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3603":38,"_31069":36,"_5":31425,"_21510":50821,"_28250":50822,"_3059":50823},[],"/docs/pr-preview/pr-74/deployment/overview#choose-a-model","Choose a model",{"_3603":39,"_31069":36,"_5":31425,"_21510":50825,"_28250":50826,"_3059":50827},[],"/docs/pr-preview/pr-74/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3603":40,"_31069":36,"_5":31425,"_21510":50829,"_28250":50830,"_3059":50831},[],"/docs/pr-preview/pr-74/deployment/overview#after-deployment","After deployment",{"_3603":41,"_31069":36,"_21510":50833,"_5":14782,"_28250":36,"_3059":50834},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3603":42,"_31069":36,"_21510":50836,"_5":14782,"_28250":50822,"_3059":50837},[],"Model",{"_3603":43,"_31069":36,"_21510":50839,"_5":14782,"_28250":50822,"_3059":50840},[],"Recommended for",{"_3603":44,"_31069":36,"_21510":50842,"_5":14782,"_28250":50822,"_3059":50843},[],"Who operates the infrastructure",{"_3603":45,"_31069":36,"_21510":50845,"_5":14782,"_28250":50822,"_3059":50846},[],"Starting point",{"_3603":46,"_31069":36,"_21510":50848,"_5":14782,"_28250":50822,"_3059":50849},[],"Kubernetes self-managed",{"_3603":47,"_31069":36,"_21510":50851,"_5":14782,"_28250":50822,"_3059":50852},[],"Production, regulated environments and custom deployments",{"_3603":48,"_31069":36,"_21510":50854,"_5":14782,"_28250":50822,"_3059":50855},[],"Your team",{"_3603":49,"_31069":36,"_21510":50857,"_5":14782,"_28250":50822,"_3059":50858},[],"Helm or Fastlane",{"_3603":50,"_31069":36,"_21510":50860,"_5":14782,"_28250":50822,"_3059":50861},[],"AWS Marketplace",{"_3603":51,"_31069":36,"_21510":50863,"_5":14782,"_28250":50822,"_3059":50864},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3603":52,"_31069":36,"_21510":50866,"_5":14782,"_28250":50822,"_3059":50855},[],{"_3603":53,"_31069":36,"_21510":50868,"_5":14782,"_28250":50822,"_3059":50869},[],"Preconfigured image on EC2",{"_3603":54,"_31069":36,"_21510":50871,"_5":14782,"_28250":50822,"_3059":50872},[],"SaaS",{"_3603":55,"_31069":36,"_21510":50874,"_5":14782,"_28250":50822,"_3059":50875},[],"Teams that want to use the platform without operating it",{"_3603":56,"_31069":36,"_21510":50877,"_5":14782,"_28250":50822,"_3059":50878},[],"Lamassu",{"_3603":57,"_31069":36,"_21510":50880,"_5":14782,"_28250":50822,"_3059":50881},[],"Managed subscription",{"_3603":58,"_31069":36,"_21510":50883,"_5":14782,"_28250":50822,"_3059":50884},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3603":59,"_31069":36,"_21510":50886,"_5":14782,"_28250":50822,"_3059":50887},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3603":60,"_31069":36,"_21510":50889,"_5":14782,"_28250":50822,"_3059":50890},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3603":61,"_31069":36,"_21510":50892,"_5":14782,"_28250":50826,"_3059":50893},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3603":62,"_31069":36,"_21510":50895,"_5":14782,"_28250":50830,"_3059":50896},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3603":63,"_31069":63,"_5":15147,"_3059":50898,"_31428":50899,"_21510":50900,"_28250":63},"Use Lamassu as SaaS",[50742,50743,50744],[],{"_3603":64,"_31069":63,"_21510":50902,"_5":14782,"_28250":63,"_3059":50903},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3603":65,"_31069":63,"_5":31425,"_21510":50905,"_28250":50906,"_3059":50907},[],"/docs/pr-preview/pr-74/deployment/saas#what-the-service-manages","What the service manages",{"_3603":66,"_31069":63,"_5":31425,"_21510":50909,"_28250":50910,"_3059":50911},[],"/docs/pr-preview/pr-74/deployment/saas#plans","Plans",{"_3603":67,"_31069":63,"_5":31425,"_21510":50913,"_28250":50914,"_3059":50915},[],"/docs/pr-preview/pr-74/deployment/saas#request-access","Request access",{"_3603":68,"_31069":63,"_21510":50917,"_5":14782,"_28250":63,"_3059":50918},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3603":69,"_31069":63,"_21510":50920,"_5":14782,"_28250":50906,"_3059":50921},[],"Platform availability and maintenance.",{"_3603":70,"_31069":63,"_21510":50923,"_5":14782,"_28250":50906,"_3059":50924},[],"Automatic backups.",{"_3603":71,"_31069":63,"_21510":50926,"_5":14782,"_28250":50906,"_3059":50927},[],"Version upgrades.",{"_3603":72,"_31069":63,"_21510":50929,"_5":14782,"_28250":50906,"_3059":50930},[],"Technical support and SLA according to your plan.",{"_3603":73,"_31069":63,"_21510":50932,"_5":14782,"_28250":50910,"_3059":50933},[],"Plan",{"_3603":74,"_31069":63,"_21510":50935,"_5":14782,"_28250":50910,"_3059":50936},[],"Devices",{"_3603":75,"_31069":63,"_21510":50938,"_5":14782,"_28250":50910,"_3059":50939},[],"Support",{"_3603":76,"_31069":63,"_21510":50941,"_5":14782,"_28250":50910,"_3059":50942},[],"SLA",{"_3603":77,"_31069":63,"_21510":50944,"_5":14782,"_28250":50910,"_3059":50945},[],"Starter",{"_3603":78,"_31069":63,"_21510":50947,"_5":14782,"_28250":50910,"_3059":50948},[],"Up to 1,000",{"_3603":79,"_31069":63,"_21510":50950,"_5":14782,"_28250":50910,"_3059":50951},[],"Email",{"_3603":80,"_31069":63,"_21510":50953,"_5":14782,"_28250":50910,"_3059":50954},[],"99.5 %",{"_3603":81,"_31069":63,"_21510":50956,"_5":14782,"_28250":50910,"_3059":50957},[],"Professional",{"_3603":82,"_31069":63,"_21510":50959,"_5":14782,"_28250":50910,"_3059":50960},[],"Up to 10,000",{"_3603":83,"_31069":63,"_21510":50962,"_5":14782,"_28250":50910,"_3059":50963},[],"Email and chat",{"_3603":84,"_31069":63,"_21510":50965,"_5":14782,"_28250":50910,"_3059":50966},[],"99.9 %",{"_3603":85,"_31069":63,"_21510":50968,"_5":14782,"_28250":50910,"_3059":50969},[],"Enterprise",{"_3603":86,"_31069":63,"_21510":50971,"_5":14782,"_28250":50910,"_3059":50972},[],"Unlimited",{"_3603":87,"_31069":63,"_21510":50974,"_5":14782,"_28250":50910,"_3059":50975},[],"Dedicated",{"_3603":88,"_31069":63,"_21510":50977,"_5":14782,"_28250":50910,"_3059":50978},[],"99.99 %",{"_3603":89,"_31069":63,"_21510":50980,"_5":14782,"_28250":50914,"_3059":50981},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3603":90,"_31069":63,"_21510":50983,"_5":14782,"_28250":50914,"_3059":50984},[],"When you receive your instance's credentials, continue with Get started.",{"_3603":91,"_31069":91,"_5":15147,"_3059":50986,"_31428":50987,"_21510":50988,"_28250":91},"Fastlane",[50742,50743,50849],[],{"_3603":92,"_31069":91,"_21510":50990,"_5":14782,"_28250":91,"_3059":50991},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3603":93,"_31069":91,"_5":31425,"_21510":50993,"_28250":50994,"_3059":50995},[],"/docs/pr-preview/pr-74/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3603":94,"_31069":91,"_5":31425,"_21510":50997,"_28250":50998,"_3059":50999},[],"/docs/pr-preview/pr-74/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3603":95,"_31069":91,"_5":31425,"_21510":51001,"_28250":51002,"_3059":50752},[],"/docs/pr-preview/pr-74/deployment/self-hosted/fastlane#before-you-begin",{"_3603":96,"_31069":91,"_5":31425,"_21510":51004,"_28250":51005,"_3059":51006},[],"/docs/pr-preview/pr-74/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3603":97,"_31069":91,"_5":31425,"_21510":51008,"_28250":51009,"_3059":51010},[],"/docs/pr-preview/pr-74/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3603":98,"_31069":91,"_5":31425,"_21510":51012,"_28250":51013,"_3059":51014},[],"/docs/pr-preview/pr-74/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3603":99,"_31069":91,"_5":31425,"_21510":51016,"_28250":51017,"_3059":51018},[],"/docs/pr-preview/pr-74/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3603":100,"_31069":91,"_5":31425,"_21510":51020,"_28250":51021,"_3059":51022},[],"/docs/pr-preview/pr-74/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3603":101,"_31069":91,"_5":31425,"_21510":51024,"_28250":51025,"_3059":51026},[],"/docs/pr-preview/pr-74/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3603":102,"_31069":91,"_5":31425,"_21510":51028,"_28250":51029,"_3059":51030},[],"/docs/pr-preview/pr-74/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3603":103,"_31069":91,"_5":31425,"_21510":51032,"_28250":51033,"_3059":51034},[],"/docs/pr-preview/pr-74/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3603":104,"_31069":91,"_21510":51036,"_5":14782,"_28250":50994,"_3059":51037},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3603":105,"_31069":91,"_21510":51039,"_5":14782,"_28250":50994,"_3059":51040},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3603":106,"_31069":91,"_21510":51042,"_5":14782,"_28250":50998,"_3059":51043},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3603":107,"_31069":91,"_21510":51045,"_5":14782,"_28250":50998,"_3059":51046},[],"Fastlane installs or configures",{"_3603":108,"_31069":91,"_21510":51048,"_5":14782,"_28250":50998,"_3059":51049},[],"You still provide",{"_3603":109,"_31069":91,"_21510":51051,"_5":14782,"_28250":50998,"_3059":51052},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3603":110,"_31069":91,"_21510":51054,"_5":14782,"_28250":50998,"_3059":51055},[],"The Kubernetes cluster, nodes and persistent storage",{"_3603":111,"_31069":91,"_21510":51057,"_5":14782,"_28250":50998,"_3059":51058},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3603":112,"_31069":91,"_21510":51060,"_5":14782,"_28250":50998,"_3059":51061},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3603":113,"_31069":91,"_21510":51063,"_5":14782,"_28250":50998,"_3059":51064},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3603":114,"_31069":91,"_21510":51066,"_5":14782,"_28250":50998,"_3059":51067},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3603":115,"_31069":91,"_21510":51069,"_5":14782,"_28250":50998,"_3059":51070},[],"Optional observability and lab HSM components",{"_3603":116,"_31069":91,"_21510":51072,"_5":14782,"_28250":50998,"_3059":51073},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3603":117,"_31069":91,"_21510":51075,"_5":14782,"_28250":50998,"_3059":51076},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3603":118,"_31069":91,"_21510":51078,"_5":14782,"_28250":51002,"_3059":51079},[],"You need:",{"_3603":119,"_31069":91,"_21510":51081,"_5":14782,"_28250":51002,"_3059":51082},[],"an existing Kubernetes cluster",{"_3603":120,"_31069":91,"_21510":51084,"_5":14782,"_28250":51002,"_3059":51085},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3603":121,"_31069":91,"_21510":51087,"_5":14782,"_28250":51002,"_3059":51088},[],"`yq`",{"_3603":122,"_31069":91,"_21510":51090,"_5":14782,"_28250":51002,"_3059":24316},[],{"_3603":123,"_31069":91,"_21510":51092,"_5":14782,"_28250":51002,"_3059":51093},[],"`jq` only when using `--sample-data` or `--development`",{"_3603":124,"_31069":91,"_21510":51095,"_5":14782,"_28250":51002,"_3059":51096},[],"`ssh-keygen` only when using `--with-hsm`",{"_3603":125,"_31069":91,"_21510":51098,"_5":14782,"_28250":51002,"_3059":51099},[],"free external ports 80 and 443 on a single-node K3s host",{"_3603":126,"_31069":91,"_21510":51101,"_5":14782,"_28250":51002,"_3059":51102},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3603":127,"_31069":91,"_21510":51104,"_5":14782,"_28250":51002,"_3059":51105},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3603":128,"_31069":91,"_21510":51107,"_5":14782,"_28250":51005,"_3059":51108},[],"Run the script from a clone of the Helm repository:",{"_3603":129,"_31069":91,"_21510":51110,"_5":14782,"_28250":51005,"_3059":51111},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3603":130,"_31069":91,"_21510":51113,"_5":14782,"_28250":51009,"_3059":51114},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3603":131,"_31069":91,"_21510":51116,"_5":14782,"_28250":51009,"_3059":51117},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3603":132,"_31069":91,"_21510":51119,"_5":14782,"_28250":51009,"_3059":51120},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3603":133,"_31069":91,"_21510":51122,"_5":14782,"_28250":51009,"_3059":51123},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3603":134,"_31069":91,"_21510":51125,"_5":14782,"_28250":51013,"_3059":51126},[],"Option",{"_3603":135,"_31069":91,"_21510":51128,"_5":14782,"_28250":51013,"_3059":51129},[],"Default",{"_3603":136,"_31069":91,"_21510":51131,"_5":14782,"_28250":51013,"_3059":51132},[],"Purpose",{"_3603":137,"_31069":91,"_21510":51134,"_5":14782,"_28250":51013,"_3059":51135},[],"`-h`, `--help`",{"_3603":138,"_31069":91,"_21510":51137,"_5":14782,"_28250":51013,"_3059":51138},[],"—",{"_3603":139,"_31069":91,"_21510":51140,"_5":14782,"_28250":51013,"_3059":51141},[],"Show help",{"_3603":140,"_31069":91,"_21510":51143,"_5":14782,"_28250":51013,"_3059":51144},[],"`-c`, `--context`",{"_3603":141,"_31069":91,"_21510":51146,"_5":14782,"_28250":51013,"_3059":51147},[],"current context",{"_3603":142,"_31069":91,"_21510":51149,"_5":14782,"_28250":51013,"_3059":51150},[],"Select the kubeconfig context for kubectl and Helm",{"_3603":143,"_31069":91,"_21510":51152,"_5":14782,"_28250":51013,"_3059":51153},[],"`-n`, `--non-interactive`",{"_3603":144,"_31069":91,"_21510":51155,"_5":14782,"_28250":51013,"_3059":6762},[],{"_3603":145,"_31069":91,"_21510":51157,"_5":14782,"_28250":51013,"_3059":51158},[],"Skip prompts and generate dependency credentials",{"_3603":146,"_31069":91,"_21510":51160,"_5":14782,"_28250":51013,"_3059":51161},[],"`-ns`, `--namespace`",{"_3603":147,"_31069":91,"_21510":51163,"_5":14782,"_28250":51013,"_3059":51164},[],"`lamassu-dev`",{"_3603":148,"_31069":91,"_21510":51166,"_5":14782,"_28250":51013,"_3059":51167},[],"Namespace for the installation",{"_3603":149,"_31069":91,"_21510":51169,"_5":14782,"_28250":51013,"_3059":51170},[],"`-d`, `--domain`",{"_3603":150,"_31069":91,"_21510":51172,"_5":14782,"_28250":51013,"_3059":51173},[],"`dev.lamassu.io`",{"_3603":151,"_31069":91,"_21510":51175,"_5":14782,"_28250":51013,"_3059":51176},[],"Domain used by the UI, OIDC and certificate",{"_3603":152,"_31069":91,"_21510":51178,"_5":14782,"_28250":51013,"_3059":51179},[],"`-v`, `--version`",{"_3603":153,"_31069":91,"_21510":51181,"_5":14782,"_28250":51013,"_3059":15494},[],{"_3603":154,"_31069":91,"_21510":51183,"_5":14782,"_28250":51013,"_3059":51184},[],"Lamassu chart version",{"_3603":155,"_31069":91,"_21510":51186,"_5":14782,"_28250":51013,"_3059":51187},[],"`--https-port`",{"_3603":156,"_31069":91,"_21510":51189,"_5":14782,"_28250":51013,"_3059":51190},[],"`443`",{"_3603":157,"_31069":91,"_21510":51192,"_5":14782,"_28250":51013,"_3059":51193},[],"Gateway HTTPS listener port",{"_3603":158,"_31069":91,"_21510":51195,"_5":14782,"_28250":51013,"_3059":51196},[],"`--http-port`",{"_3603":159,"_31069":91,"_21510":51198,"_5":14782,"_28250":51013,"_3059":51199},[],"`80`",{"_3603":160,"_31069":91,"_21510":51201,"_5":14782,"_28250":51013,"_3059":51202},[],"Gateway HTTP listener port",{"_3603":161,"_31069":91,"_21510":51204,"_5":14782,"_28250":51013,"_3059":51205},[],"`--tls-crt`",{"_3603":162,"_31069":91,"_21510":51207,"_5":14782,"_28250":51013,"_3059":51138},[],{"_3603":163,"_31069":91,"_21510":51209,"_5":14782,"_28250":51013,"_3059":51210},[],"PEM certificate for downstream TLS",{"_3603":164,"_31069":91,"_21510":51212,"_5":14782,"_28250":51013,"_3059":51213},[],"`--tls-key`",{"_3603":165,"_31069":91,"_21510":51215,"_5":14782,"_28250":51013,"_3059":51138},[],{"_3603":166,"_31069":91,"_21510":51217,"_5":14782,"_28250":51013,"_3059":51218},[],"PEM private key for downstream TLS",{"_3603":167,"_31069":91,"_21510":51220,"_5":14782,"_28250":51013,"_3059":51221},[],"`-l`, `--local-chart-path`",{"_3603":168,"_31069":91,"_21510":51223,"_5":14782,"_28250":51013,"_3059":51224},[],"repository chart",{"_3603":169,"_31069":91,"_21510":51226,"_5":14782,"_28250":51013,"_3059":51227},[],"Use an unpacked local Lamassu chart",{"_3603":170,"_31069":91,"_21510":51229,"_5":14782,"_28250":51013,"_3059":51230},[],"`-ip`, `--gateway-ip`",{"_3603":171,"_31069":91,"_21510":51232,"_5":14782,"_28250":51013,"_3059":9025},[],{"_3603":172,"_31069":91,"_21510":51234,"_5":14782,"_28250":51013,"_3059":51235},[],"Override the address written to `gateway.addresses`",{"_3603":173,"_31069":91,"_21510":51237,"_5":14782,"_28250":51013,"_3059":51238},[],"`--otel`",{"_3603":174,"_31069":91,"_21510":51240,"_5":14782,"_28250":51013,"_3059":6762},[],{"_3603":175,"_31069":91,"_21510":51242,"_5":14782,"_28250":51013,"_3059":51243},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3603":176,"_31069":91,"_21510":51245,"_5":14782,"_28250":51013,"_3059":51246},[],"`--development`",{"_3603":177,"_31069":91,"_21510":51248,"_5":14782,"_28250":51013,"_3059":6762},[],{"_3603":178,"_31069":91,"_21510":51250,"_5":14782,"_28250":51013,"_3059":51251},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3603":179,"_31069":91,"_21510":51253,"_5":14782,"_28250":51013,"_3059":51254},[],"`--sample-data`",{"_3603":180,"_31069":91,"_21510":51256,"_5":14782,"_28250":51013,"_3059":6762},[],{"_3603":181,"_31069":91,"_21510":51258,"_5":14782,"_28250":51013,"_3059":51259},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3603":182,"_31069":91,"_21510":51261,"_5":14782,"_28250":51013,"_3059":51262},[],"`--with-hsm`",{"_3603":183,"_31069":91,"_21510":51264,"_5":14782,"_28250":51013,"_3059":6762},[],{"_3603":184,"_31069":91,"_21510":51266,"_5":14782,"_28250":51013,"_3059":51267},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3603":185,"_31069":91,"_21510":51269,"_5":14782,"_28250":51013,"_3059":51270},[],"`--softhsm-chart-path`",{"_3603":186,"_31069":91,"_21510":51272,"_5":14782,"_28250":51013,"_3059":51273},[],"`./charts/softhsm`",{"_3603":187,"_31069":91,"_21510":51275,"_5":14782,"_28250":51013,"_3059":51276},[],"Use a different local SoftHSM chart",{"_3603":188,"_31069":91,"_21510":51278,"_5":14782,"_28250":51013,"_3059":51279},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3603":189,"_31069":91,"_21510":51281,"_5":14782,"_28250":51017,"_3059":51282},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3603":190,"_31069":91,"_21510":51284,"_5":14782,"_28250":51017,"_3059":51285},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3603":191,"_31069":91,"_21510":51287,"_5":14782,"_28250":51017,"_3059":51288},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3603":192,"_31069":91,"_21510":51290,"_5":14782,"_28250":51017,"_3059":51291},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3603":193,"_31069":91,"_21510":51293,"_5":14782,"_28250":51017,"_3059":51294},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3603":194,"_31069":91,"_21510":51296,"_5":14782,"_28250":51017,"_3059":51297},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3603":195,"_31069":91,"_21510":51299,"_5":14782,"_28250":51021,"_3059":51300},[],"Fastlane:",{"_3603":196,"_31069":91,"_21510":51302,"_5":14782,"_28250":51021,"_3059":51303},[],"validates local tools and the selected cluster",{"_3603":197,"_31069":91,"_21510":51305,"_5":14782,"_28250":51021,"_3059":51306},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3603":198,"_31069":91,"_21510":51308,"_5":14782,"_28250":51021,"_3059":51309},[],"creates the namespace",{"_3603":199,"_31069":91,"_21510":51311,"_5":14782,"_28250":51021,"_3059":51312},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3603":200,"_31069":91,"_21510":51314,"_5":14782,"_28250":51021,"_3059":51315},[],"installs PostgreSQL and creates the required databases",{"_3603":201,"_31069":91,"_21510":51317,"_5":14782,"_28250":51021,"_3059":51318},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3603":202,"_31069":91,"_21510":51320,"_5":14782,"_28250":51021,"_3059":51321},[],"installs RabbitMQ",{"_3603":203,"_31069":91,"_21510":51323,"_5":14782,"_28250":51021,"_3059":51324},[],"optionally installs observability and lab HSM components",{"_3603":204,"_31069":91,"_21510":51326,"_5":14782,"_28250":51021,"_3059":51327},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3603":205,"_31069":91,"_21510":51329,"_5":14782,"_28250":51021,"_3059":51330},[],"optionally loads sample data",{"_3603":206,"_31069":91,"_21510":51332,"_5":14782,"_28250":51021,"_3059":51333},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3603":207,"_31069":91,"_21510":51335,"_5":14782,"_28250":51025,"_3059":51336},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3603":208,"_31069":91,"_21510":51338,"_5":14782,"_28250":51025,"_3059":51339},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3603":209,"_31069":91,"_21510":51341,"_5":14782,"_28250":51029,"_3059":51342},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3603":210,"_31069":91,"_21510":51344,"_5":14782,"_28250":51029,"_3059":51345},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3603":211,"_31069":91,"_21510":51347,"_5":14782,"_28250":51029,"_3059":51348},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3603":212,"_31069":91,"_21510":51350,"_5":14782,"_28250":51029,"_3059":51351},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3603":213,"_31069":91,"_21510":51353,"_5":14782,"_28250":51033,"_3059":51354},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3603":214,"_31069":214,"_5":15147,"_3059":51356,"_31428":51357,"_21510":51358,"_28250":214},"Install with Helm",[50742,50743,50849],[],{"_3603":215,"_31069":214,"_21510":51360,"_5":14782,"_28250":214,"_3059":51361},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3603":216,"_31069":214,"_5":31425,"_21510":51363,"_28250":51364,"_3059":51365},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3603":217,"_31069":214,"_5":31425,"_21510":51367,"_28250":51368,"_3059":50752},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#before-you-begin",{"_3603":218,"_31069":214,"_5":31425,"_21510":51370,"_28250":51371,"_3059":51372},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3603":219,"_31069":214,"_5":31425,"_21510":51374,"_28250":51375,"_3059":51376},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3603":220,"_31069":214,"_5":31425,"_21510":51378,"_28250":51379,"_3059":51380},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3603":221,"_31069":214,"_5":31425,"_21510":51382,"_28250":51383,"_3059":51384},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3603":222,"_31069":214,"_5":31425,"_21510":51386,"_28250":51387,"_3059":51388},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3603":223,"_31069":214,"_5":31425,"_21510":51390,"_28250":51391,"_3059":51392},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3603":224,"_31069":214,"_5":31425,"_21510":51394,"_28250":51395,"_3059":51396},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3603":225,"_31069":214,"_5":31425,"_21510":51398,"_28250":51399,"_3059":51400},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3603":226,"_31069":214,"_5":31425,"_21510":51402,"_28250":51403,"_3059":51404},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3603":227,"_31069":214,"_5":31425,"_21510":51406,"_28250":51407,"_3059":51408},[],"/docs/pr-preview/pr-74/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3603":228,"_31069":214,"_21510":51410,"_5":14782,"_28250":51364,"_3059":51411},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3603":229,"_31069":214,"_21510":51413,"_5":14782,"_28250":51368,"_3059":51414},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3603":230,"_31069":214,"_21510":51416,"_5":14782,"_28250":51368,"_3059":51417},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3603":231,"_31069":214,"_21510":51419,"_5":14782,"_28250":51368,"_3059":51420},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3603":232,"_31069":214,"_21510":51422,"_5":14782,"_28250":51368,"_3059":51423},[],"a reachable RabbitMQ broker and credentials",{"_3603":233,"_31069":214,"_21510":51425,"_5":14782,"_28250":51368,"_3059":51426},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3603":234,"_31069":214,"_21510":51428,"_5":14782,"_28250":51368,"_3059":51429},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3603":235,"_31069":214,"_21510":51431,"_5":14782,"_28250":51368,"_3059":51432},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3603":236,"_31069":214,"_21510":51434,"_5":14782,"_28250":51368,"_3059":51435},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3603":237,"_31069":214,"_21510":51437,"_5":14782,"_28250":51368,"_3059":51438},[],"a StorageClass and an external traffic design",{"_3603":238,"_31069":214,"_21510":51440,"_5":14782,"_28250":51368,"_3059":51441},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3603":239,"_31069":214,"_21510":51443,"_5":14782,"_28250":51368,"_3059":51444},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3603":240,"_31069":214,"_21510":51446,"_5":14782,"_28250":51368,"_3059":51447},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3603":241,"_31069":214,"_21510":51449,"_5":14782,"_28250":51371,"_3059":51450},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3603":242,"_31069":214,"_21510":51452,"_5":14782,"_28250":51371,"_3059":51453},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3603":243,"_31069":214,"_21510":51455,"_5":14782,"_28250":51371,"_3059":51456},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3603":244,"_31069":214,"_21510":51458,"_5":14782,"_28250":51375,"_3059":51459},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3603":245,"_31069":214,"_21510":51461,"_5":14782,"_28250":51375,"_3059":51462},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3603":246,"_31069":214,"_21510":51464,"_5":14782,"_28250":51375,"_3059":51465},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3603":247,"_31069":214,"_21510":51467,"_5":14782,"_28250":51375,"_3059":51468},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3603":248,"_31069":214,"_21510":51470,"_5":14782,"_28250":51379,"_3059":51471},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3603":249,"_31069":214,"_21510":51473,"_5":14782,"_28250":51379,"_3059":51474},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3603":250,"_31069":214,"_21510":51476,"_5":14782,"_28250":51379,"_3059":51477},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3603":251,"_31069":214,"_21510":51479,"_5":14782,"_28250":51379,"_3059":51480},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3603":252,"_31069":214,"_21510":51482,"_5":14782,"_28250":51379,"_3059":51483},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3603":253,"_31069":214,"_21510":51485,"_5":14782,"_28250":51379,"_3059":51486},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3603":254,"_31069":214,"_21510":51488,"_5":14782,"_28250":51379,"_3059":51489},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3603":255,"_31069":214,"_21510":51491,"_5":14782,"_28250":51379,"_3059":51492},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3603":256,"_31069":214,"_21510":51494,"_5":14782,"_28250":51383,"_3059":51495},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3603":257,"_31069":214,"_21510":51497,"_5":14782,"_28250":51387,"_3059":51498},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3603":258,"_31069":214,"_21510":51500,"_5":14782,"_28250":51387,"_3059":51501},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3603":259,"_31069":214,"_21510":51503,"_5":14782,"_28250":51387,"_3059":51504},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3603":260,"_31069":214,"_21510":51506,"_5":14782,"_28250":51387,"_3059":51507},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3603":261,"_31069":214,"_21510":51509,"_5":14782,"_28250":51387,"_3059":51510},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3603":262,"_31069":214,"_21510":51512,"_5":14782,"_28250":51387,"_3059":51513},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3603":263,"_31069":214,"_21510":51515,"_5":14782,"_28250":51387,"_3059":51516},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3603":264,"_31069":214,"_21510":51518,"_5":14782,"_28250":51391,"_3059":51519},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3603":265,"_31069":214,"_21510":51521,"_5":14782,"_28250":51391,"_3059":51522},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3603":266,"_31069":214,"_21510":51524,"_5":14782,"_28250":51391,"_3059":51525},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3603":267,"_31069":214,"_21510":51527,"_5":14782,"_28250":51391,"_3059":51528},[],"See Access control for the principal and policy model.",{"_3603":268,"_31069":214,"_21510":51530,"_5":14782,"_28250":51395,"_3059":51531},[],"To install a local checkout instead:",{"_3603":269,"_31069":214,"_21510":51533,"_5":14782,"_28250":51399,"_3059":51534},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3603":270,"_31069":214,"_21510":51536,"_5":14782,"_28250":51399,"_3059":51537},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3603":271,"_31069":214,"_21510":51539,"_5":14782,"_28250":51403,"_3059":51540},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3603":272,"_31069":214,"_21510":51542,"_5":14782,"_28250":51403,"_3059":51543},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3603":273,"_31069":214,"_21510":51545,"_5":14782,"_28250":51403,"_3059":51546},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3603":274,"_31069":214,"_21510":51548,"_5":14782,"_28250":51403,"_3059":51549},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3603":275,"_31069":214,"_21510":51551,"_5":14782,"_28250":51403,"_3059":51552},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3603":276,"_31069":214,"_21510":51554,"_5":14782,"_28250":51407,"_3059":51555},[],"Before going live, review:",{"_3603":277,"_31069":214,"_21510":51557,"_5":14782,"_28250":51407,"_3059":51558},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3603":278,"_31069":214,"_21510":51560,"_5":14782,"_28250":51407,"_3059":51561},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3603":279,"_31069":214,"_21510":51563,"_5":14782,"_28250":51407,"_3059":51564},[],"shared VA storage before increasing VA replicas",{"_3603":280,"_31069":214,"_21510":51566,"_5":14782,"_28250":51407,"_3059":51567},[],"managed OIDC roles and removal of evaluation credentials",{"_3603":281,"_31069":214,"_21510":51569,"_5":14782,"_28250":51407,"_3059":51570},[],"a trusted TLS issuer or externally managed certificate",{"_3603":282,"_31069":214,"_21510":51572,"_5":14782,"_28250":51407,"_3059":51573},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3603":283,"_31069":214,"_21510":51575,"_5":14782,"_28250":51407,"_3059":51576},[],"SMTP, observability and alert delivery",{"_3603":284,"_31069":214,"_21510":51578,"_5":14782,"_28250":51407,"_3059":51579},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3603":285,"_31069":214,"_21510":51581,"_5":14782,"_28250":51407,"_3059":51582},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3603":286,"_31069":286,"_5":15147,"_3059":51584,"_31428":51585,"_21510":51586,"_28250":286},"Expose the Gateway",[50742,50743,50849],[],{"_3603":287,"_31069":286,"_21510":51588,"_5":14782,"_28250":286,"_3059":51589},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3603":288,"_31069":286,"_5":31425,"_21510":51591,"_28250":51592,"_3059":51593},[],"/docs/pr-preview/pr-74/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3603":289,"_31069":286,"_5":31425,"_21510":51595,"_28250":51596,"_3059":51597},[],"/docs/pr-preview/pr-74/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3603":290,"_31069":286,"_5":31425,"_21510":51599,"_28250":51600,"_3059":51601},[],"/docs/pr-preview/pr-74/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3603":291,"_31069":286,"_5":31425,"_21510":51603,"_28250":51604,"_3059":51605},[],"/docs/pr-preview/pr-74/deployment/self-hosted/networking#k3s","K3s",{"_3603":292,"_31069":286,"_5":31425,"_21510":51607,"_28250":51608,"_3059":51609},[],"/docs/pr-preview/pr-74/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3603":293,"_31069":286,"_5":31425,"_21510":51611,"_28250":51612,"_3059":51613},[],"/docs/pr-preview/pr-74/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3603":294,"_31069":286,"_5":31425,"_21510":51615,"_28250":51616,"_3059":51617},[],"/docs/pr-preview/pr-74/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3603":295,"_31069":286,"_5":31425,"_21510":51619,"_28250":51620,"_3059":51621},[],"/docs/pr-preview/pr-74/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3603":296,"_31069":286,"_5":31425,"_21510":51623,"_28250":51624,"_3059":51625},[],"/docs/pr-preview/pr-74/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3603":297,"_31069":286,"_5":31425,"_21510":51627,"_28250":51628,"_3059":51629},[],"/docs/pr-preview/pr-74/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3603":298,"_31069":286,"_5":31425,"_21510":51631,"_28250":51632,"_3059":51633},[],"/docs/pr-preview/pr-74/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3603":299,"_31069":286,"_21510":51635,"_5":14782,"_28250":51592,"_3059":51636},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3603":300,"_31069":286,"_21510":51638,"_5":14782,"_28250":51592,"_3059":51639},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3603":301,"_31069":286,"_21510":51641,"_5":14782,"_28250":51596,"_3059":51642},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3603":302,"_31069":286,"_21510":51644,"_5":14782,"_28250":51596,"_3059":51645},[],"Set it only when:",{"_3603":303,"_31069":286,"_21510":51647,"_5":14782,"_28250":51596,"_3059":51648},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3603":304,"_31069":286,"_21510":51650,"_5":14782,"_28250":51596,"_3059":51651},[],"that address is allocated to this Gateway",{"_3603":305,"_31069":286,"_21510":51653,"_5":14782,"_28250":51596,"_3059":51654},[],"the surrounding network already routes traffic for it to the cluster",{"_3603":306,"_31069":286,"_21510":51656,"_5":14782,"_28250":51596,"_3059":51657},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3603":307,"_31069":286,"_21510":51659,"_5":14782,"_28250":51596,"_3059":51660},[],"Keep these two settings separate:",{"_3603":308,"_31069":286,"_21510":51662,"_5":14782,"_28250":51596,"_3059":51663},[],"`gateway.addresses` requests an address for the Gateway.",{"_3603":309,"_31069":286,"_21510":51665,"_5":14782,"_28250":51596,"_3059":51666},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3603":310,"_31069":286,"_21510":51668,"_5":14782,"_28250":51596,"_3059":51669},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3603":311,"_31069":286,"_21510":51671,"_5":14782,"_28250":51600,"_3059":51672},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3603":312,"_31069":286,"_21510":51674,"_5":14782,"_28250":51600,"_3059":51675},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3603":313,"_31069":286,"_21510":51677,"_5":14782,"_28250":51604,"_3059":51678},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3603":314,"_31069":286,"_21510":51680,"_5":14782,"_28250":51604,"_3059":51681},[],"For the recommended design:",{"_3603":315,"_31069":286,"_21510":51683,"_5":14782,"_28250":51604,"_3059":51684},[],"Use only one externally exposed Lamassu Gateway.",{"_3603":316,"_31069":286,"_21510":51686,"_5":14782,"_28250":51604,"_3059":51687},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3603":317,"_31069":286,"_21510":51689,"_5":14782,"_28250":51604,"_3059":51690},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3603":318,"_31069":286,"_21510":51692,"_5":14782,"_28250":51604,"_3059":51693},[],"Point DNS at the VM's reachable address.",{"_3603":319,"_31069":286,"_21510":51695,"_5":14782,"_28250":51604,"_3059":51696},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3603":320,"_31069":286,"_21510":51698,"_5":14782,"_28250":51608,"_3059":51699},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3603":321,"_31069":286,"_21510":51701,"_5":14782,"_28250":51612,"_3059":51702},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3603":322,"_31069":286,"_21510":51704,"_5":14782,"_28250":51612,"_3059":51705},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3603":323,"_31069":286,"_21510":51707,"_5":14782,"_28250":51616,"_3059":51708},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3603":324,"_31069":286,"_21510":51710,"_5":14782,"_28250":51616,"_3059":51711},[],"Requirement",{"_3603":325,"_31069":286,"_21510":51713,"_5":14782,"_28250":51616,"_3059":51714},[],"Recommended design",{"_3603":326,"_31069":286,"_21510":51716,"_5":14782,"_28250":51616,"_3059":51717},[],"Consequence",{"_3603":327,"_31069":286,"_21510":51719,"_5":14782,"_28250":51616,"_3059":51720},[],"Several Lamassu URLs or services",{"_3603":328,"_31069":286,"_21510":51722,"_5":14782,"_28250":51616,"_3059":51723},[],"One Gateway with multiple routes",{"_3603":329,"_31069":286,"_21510":51725,"_5":14782,"_28250":51616,"_3059":51726},[],"One IP and one proxy fleet; this is the chart default",{"_3603":330,"_31069":286,"_21510":51728,"_5":14782,"_28250":51616,"_3059":51729},[],"Independent Gateways and separate external IPs",{"_3603":331,"_31069":286,"_21510":51731,"_5":14782,"_28250":51616,"_3059":51732},[],"One VIP per Gateway",{"_3603":332,"_31069":286,"_21510":51734,"_5":14782,"_28250":51616,"_3059":51735},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3603":333,"_31069":286,"_21510":51737,"_5":14782,"_28250":51616,"_3059":51738},[],"Independent Gateways on one node and one IP",{"_3603":334,"_31069":286,"_21510":51740,"_5":14782,"_28250":51616,"_3059":51741},[],"Use different external ports",{"_3603":335,"_31069":286,"_21510":51743,"_5":14782,"_28250":51616,"_3059":51744},[],"Clients must include non-standard ports",{"_3603":336,"_31069":286,"_21510":51746,"_5":14782,"_28250":51616,"_3059":51747},[],"Separate TLS/mTLS termination behind one IP",{"_3603":337,"_31069":286,"_21510":51749,"_5":14782,"_28250":51616,"_3059":51750},[],"Front-door SNI routing to internal Gateways",{"_3603":338,"_31069":286,"_21510":51752,"_5":14782,"_28250":51616,"_3059":51753},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3603":339,"_31069":286,"_21510":51755,"_5":14782,"_28250":51616,"_3059":51756},[],"Separate Gateway resources but shared proxy infrastructure",{"_3603":340,"_31069":286,"_21510":51758,"_5":14782,"_28250":51616,"_3059":51759},[],"Envoy merged-Gateway mode",{"_3603":341,"_31069":286,"_21510":51761,"_5":14782,"_28250":51616,"_3059":51762},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3603":342,"_31069":286,"_21510":51764,"_5":14782,"_28250":51616,"_3059":51765},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3603":343,"_31069":286,"_21510":51767,"_5":14782,"_28250":51616,"_3059":51768},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3603":344,"_31069":286,"_21510":51770,"_5":14782,"_28250":51616,"_3059":51771},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3603":345,"_31069":286,"_21510":51773,"_5":14782,"_28250":51616,"_3059":51774},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3603":346,"_31069":286,"_21510":51776,"_5":14782,"_28250":51620,"_3059":51777},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3603":347,"_31069":286,"_21510":51779,"_5":14782,"_28250":51624,"_3059":51780},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3603":348,"_31069":286,"_21510":51782,"_5":14782,"_28250":51624,"_3059":51783},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3603":349,"_31069":286,"_21510":51785,"_5":14782,"_28250":51624,"_3059":51786},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3603":350,"_31069":286,"_21510":51788,"_5":14782,"_28250":51624,"_3059":51789},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3603":351,"_31069":286,"_21510":51791,"_5":14782,"_28250":51624,"_3059":51792},[],"If none of those are possible, use different external ports or change the external network design.",{"_3603":352,"_31069":286,"_21510":51794,"_5":14782,"_28250":51628,"_3059":51795},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3603":353,"_31069":286,"_21510":51797,"_5":14782,"_28250":51628,"_3059":51798},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3603":354,"_31069":286,"_21510":51800,"_5":14782,"_28250":51632,"_3059":51801},[],"Check, in order:",{"_3603":355,"_31069":286,"_21510":51803,"_5":14782,"_28250":51632,"_3059":51804},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3603":356,"_31069":286,"_21510":51806,"_5":14782,"_28250":51632,"_3059":51807},[],"Its status contains the expected address.",{"_3603":357,"_31069":286,"_21510":51809,"_5":14782,"_28250":51632,"_3059":51810},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3603":358,"_31069":286,"_21510":51812,"_5":14782,"_28250":51632,"_3059":51813},[],"Port 443 reaches that address from the client network.",{"_3603":359,"_31069":286,"_21510":51815,"_5":14782,"_28250":51632,"_3059":51816},[],"DNS resolves to the externally reachable endpoint.",{"_3603":360,"_31069":286,"_21510":51818,"_5":14782,"_28250":51632,"_3059":51819},[],"The certificate contains the DNS name or IP used by the client.",{"_3603":361,"_31069":286,"_21510":51821,"_5":14782,"_28250":51632,"_3059":51822},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3603":362,"_31069":362,"_5":15147,"_3059":50849,"_31428":51824,"_21510":51825,"_28250":362},[50742,50743,50849],[],{"_3603":363,"_31069":362,"_21510":51827,"_5":14782,"_28250":362,"_3059":51828},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3603":364,"_31069":362,"_5":31425,"_21510":51830,"_28250":51831,"_3059":51832},[],"/docs/pr-preview/pr-74/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3603":365,"_31069":362,"_5":31425,"_21510":51834,"_28250":51835,"_3059":51836},[],"/docs/pr-preview/pr-74/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3603":366,"_31069":362,"_5":31425,"_21510":51838,"_28250":51839,"_3059":51840},[],"/docs/pr-preview/pr-74/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3603":367,"_31069":362,"_5":31425,"_21510":51842,"_28250":51843,"_3059":51844},[],"/docs/pr-preview/pr-74/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3603":368,"_31069":362,"_5":31425,"_21510":51846,"_28250":51847,"_3059":51848},[],"/docs/pr-preview/pr-74/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3603":369,"_31069":362,"_5":31425,"_21510":51850,"_28250":51851,"_3059":51852},[],"/docs/pr-preview/pr-74/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3603":370,"_31069":362,"_21510":51854,"_5":14782,"_28250":51831,"_3059":51855},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3603":371,"_31069":362,"_21510":51857,"_5":14782,"_28250":51835,"_3059":51858},[],"Workflow",{"_3603":372,"_31069":362,"_21510":51860,"_5":14782,"_28250":51835,"_3059":51861},[],"Use it for",{"_3603":373,"_31069":362,"_21510":51863,"_5":14782,"_28250":51835,"_3059":51864},[],"What it installs",{"_3603":374,"_31069":362,"_21510":51866,"_5":14782,"_28250":51835,"_3059":51867},[],"Helm",{"_3603":375,"_31069":362,"_21510":51869,"_5":14782,"_28250":51835,"_3059":51870},[],"Production and controlled environments",{"_3603":376,"_31069":362,"_21510":51872,"_5":14782,"_28250":51835,"_3059":51873},[],"Lamassu services and Gateway API resources",{"_3603":377,"_31069":362,"_21510":51875,"_5":14782,"_28250":51835,"_3059":50986},[],{"_3603":378,"_31069":362,"_21510":51877,"_5":14782,"_28250":51835,"_3059":51878},[],"Evaluation, demos, CI and small lab clusters",{"_3603":379,"_31069":362,"_21510":51880,"_5":14782,"_28250":51835,"_3059":51881},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3603":380,"_31069":362,"_21510":51883,"_5":14782,"_28250":51839,"_3059":51884},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3603":381,"_31069":362,"_21510":51886,"_5":14782,"_28250":51839,"_3059":51887},[],"Area",{"_3603":382,"_31069":362,"_21510":51889,"_5":14782,"_28250":51839,"_3059":51890},[],"The Lamassu chart provides",{"_3603":383,"_31069":362,"_21510":51892,"_5":14782,"_28250":51839,"_3059":51893},[],"You provide",{"_3603":384,"_31069":362,"_21510":51895,"_5":14782,"_28250":51839,"_3059":51896},[],"Lamassu applications",{"_3603":385,"_31069":362,"_21510":51898,"_5":14782,"_28250":51839,"_3059":51899},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3603":386,"_31069":362,"_21510":51901,"_5":14782,"_28250":51839,"_3059":51902},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3603":387,"_31069":362,"_21510":51904,"_5":14782,"_28250":51839,"_3059":51905},[],"PostgreSQL data",{"_3603":388,"_31069":362,"_21510":51907,"_5":14782,"_28250":51839,"_3059":51908},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3603":389,"_31069":362,"_21510":51910,"_5":14782,"_28250":51839,"_3059":51911},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3603":390,"_31069":362,"_21510":51913,"_5":14782,"_28250":51839,"_3059":51914},[],"Messaging",{"_3603":391,"_31069":362,"_21510":51916,"_5":14782,"_28250":51839,"_3059":51917},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3603":392,"_31069":362,"_21510":51919,"_5":14782,"_28250":51839,"_3059":51920},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3603":393,"_31069":362,"_21510":51922,"_5":14782,"_28250":51839,"_3059":51923},[],"Identity",{"_3603":394,"_31069":362,"_21510":51925,"_5":14782,"_28250":51839,"_3059":51926},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3603":395,"_31069":362,"_21510":51928,"_5":14782,"_28250":51839,"_3059":51929},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3603":396,"_31069":362,"_21510":51931,"_5":14782,"_28250":51839,"_3059":51932},[],"External routing",{"_3603":397,"_31069":362,"_21510":51934,"_5":14782,"_28250":51839,"_3059":51935},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3603":398,"_31069":362,"_21510":51937,"_5":14782,"_28250":51839,"_3059":51938},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3603":399,"_31069":362,"_21510":51940,"_5":14782,"_28250":51839,"_3059":51941},[],"TLS",{"_3603":400,"_31069":362,"_21510":51943,"_5":14782,"_28250":51839,"_3059":51944},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3603":401,"_31069":362,"_21510":51946,"_5":14782,"_28250":51839,"_3059":51947},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3603":402,"_31069":362,"_21510":51949,"_5":14782,"_28250":51839,"_3059":51950},[],"Persistent application data",{"_3603":403,"_31069":362,"_21510":51952,"_5":14782,"_28250":51839,"_3059":51953},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3603":404,"_31069":362,"_21510":51955,"_5":14782,"_28250":51839,"_3059":51956},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3603":405,"_31069":362,"_21510":51958,"_5":14782,"_28250":51839,"_3059":51959},[],"Optional integrations",{"_3603":406,"_31069":362,"_21510":51961,"_5":14782,"_28250":51839,"_3059":51962},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3603":407,"_31069":362,"_21510":51964,"_5":14782,"_28250":51839,"_3059":51965},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3603":408,"_31069":362,"_21510":51967,"_5":14782,"_28250":51839,"_3059":51968},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3603":409,"_31069":362,"_21510":51970,"_5":14782,"_28250":51839,"_3059":51971},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3603":410,"_31069":362,"_21510":51973,"_5":14782,"_28250":51843,"_3059":51974},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3603":411,"_31069":362,"_21510":51976,"_5":14782,"_28250":51843,"_3059":51977},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3603":412,"_31069":362,"_21510":51979,"_5":14782,"_28250":51847,"_3059":51980},[],"Kubernetes 1.24 or newer",{"_3603":413,"_31069":362,"_21510":51982,"_5":14782,"_28250":51847,"_3059":51983},[],"Helm 3.2 or newer",{"_3603":414,"_31069":362,"_21510":51985,"_5":14782,"_28250":51847,"_3059":51986},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3603":415,"_31069":362,"_21510":51988,"_5":14782,"_28250":51847,"_3059":51989},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3603":416,"_31069":362,"_21510":51991,"_5":14782,"_28250":51847,"_3059":51992},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3603":417,"_31069":362,"_21510":51994,"_5":14782,"_28250":51847,"_3059":51995},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3603":418,"_31069":362,"_21510":51997,"_5":14782,"_28250":51847,"_3059":51998},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3603":419,"_31069":362,"_21510":52000,"_5":14782,"_28250":51851,"_3059":52001},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3603":420,"_31069":362,"_21510":52003,"_5":14782,"_28250":51851,"_3059":52004},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3603":421,"_31069":362,"_21510":52006,"_5":14782,"_28250":51851,"_3059":52007},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3603":422,"_31069":362,"_21510":52009,"_5":14782,"_28250":51851,"_3059":52010},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3603":423,"_31069":423,"_5":15147,"_3059":52012,"_31428":52013,"_21510":52015,"_28250":423},"Deployment troubleshooting",[50742,50743,52014],"Operations",[],{"_3603":424,"_31069":423,"_21510":52017,"_5":14782,"_28250":423,"_3059":52018},[],"Diagnose access, service health and infrastructure dependencies.",{"_3603":425,"_31069":423,"_5":31425,"_21510":52020,"_28250":52021,"_3059":52022},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3603":426,"_31069":423,"_5":31425,"_21510":52024,"_28250":52025,"_3059":52026},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3603":427,"_31069":423,"_5":31425,"_21510":52028,"_28250":52029,"_3059":52030},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3603":428,"_31069":423,"_5":31425,"_21510":52032,"_28250":52033,"_3059":52034},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3603":429,"_31069":423,"_5":31425,"_21510":52036,"_28250":52037,"_3059":52038},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3603":430,"_31069":423,"_5":31425,"_21510":52040,"_28250":52041,"_3059":52042},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3603":431,"_31069":423,"_5":31425,"_21510":52044,"_28250":52045,"_3059":52046},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3603":432,"_31069":423,"_5":31425,"_21510":52048,"_28250":52049,"_3059":52050},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3603":433,"_31069":423,"_5":31425,"_21510":52052,"_28250":52053,"_3059":52054},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3603":434,"_31069":423,"_5":31425,"_21510":52056,"_28250":52057,"_3059":52058},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3603":435,"_31069":423,"_5":31425,"_21510":52060,"_28250":52061,"_3059":52062},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3603":436,"_31069":423,"_5":31425,"_21510":52064,"_28250":52065,"_3059":52066},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3603":437,"_31069":423,"_5":31425,"_21510":52068,"_28250":52069,"_3059":52070},[],"/docs/pr-preview/pr-74/deployment/troubleshooting#observability","Observability",{"_3603":438,"_31069":423,"_21510":52072,"_5":14782,"_28250":423,"_3059":52073},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3603":439,"_31069":423,"_21510":52075,"_5":14782,"_28250":52025,"_3059":52076},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3603":440,"_31069":423,"_21510":52078,"_5":14782,"_28250":52029,"_3059":52079},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3603":441,"_31069":423,"_21510":52081,"_5":14782,"_28250":52033,"_3059":52082},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3603":442,"_31069":423,"_21510":52084,"_5":14782,"_28250":52037,"_3059":52085},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3603":443,"_31069":423,"_21510":52087,"_5":14782,"_28250":52041,"_3059":52088},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3603":444,"_31069":423,"_21510":52090,"_5":14782,"_28250":52045,"_3059":52091},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3603":445,"_31069":423,"_21510":52093,"_5":14782,"_28250":52045,"_3059":52094},[],"Also run the chart's connectivity test:",{"_3603":446,"_31069":423,"_21510":52096,"_5":14782,"_28250":52045,"_3059":52097},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3603":447,"_31069":423,"_21510":52099,"_5":14782,"_28250":52045,"_3059":52100},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3603":448,"_31069":423,"_21510":52102,"_5":14782,"_28250":52049,"_3059":52103},[],"If you receive a 401:",{"_3603":449,"_31069":423,"_21510":52105,"_5":14782,"_28250":52049,"_3059":52106},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3603":450,"_31069":423,"_21510":52108,"_5":14782,"_28250":52049,"_3059":52109},[],"verify issuer, audience and expiration of the token;",{"_3603":451,"_31069":423,"_21510":52111,"_5":14782,"_28250":52049,"_3059":52112},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3603":452,"_31069":423,"_21510":52114,"_5":14782,"_28250":52049,"_3059":52115},[],"check that the provider's public and internal routes point to the same realm.",{"_3603":453,"_31069":423,"_21510":52117,"_5":14782,"_28250":52049,"_3059":52118},[],"If login succeeds but the APIs return 403:",{"_3603":454,"_31069":423,"_21510":52120,"_5":14782,"_28250":52049,"_3059":52121},[],"inspect the token's real claims;",{"_3603":455,"_31069":423,"_21510":52123,"_5":14782,"_28250":52049,"_3059":52124},[],"confirm they match an active principal;",{"_3603":456,"_31069":423,"_21510":52126,"_5":14782,"_28250":52049,"_3059":52127},[],"review the policies granted to that principal;",{"_3603":457,"_31069":423,"_21510":52129,"_5":14782,"_28250":52049,"_3059":52130},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3603":458,"_31069":423,"_21510":52132,"_5":14782,"_28250":52049,"_3059":52133},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3603":459,"_31069":423,"_21510":52135,"_5":14782,"_28250":52053,"_3059":52136},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3603":460,"_31069":423,"_21510":52138,"_5":14782,"_28250":52053,"_3059":52139},[],"Locate the authz pod and Service.",{"_3603":461,"_31069":423,"_21510":52141,"_5":14782,"_28250":52053,"_3059":52142},[],"Check /health, logs and its database connection.",{"_3603":462,"_31069":423,"_21510":52144,"_5":14782,"_28250":52053,"_3059":52145},[],"Verify the DNS and port configured in externalAuthorization.",{"_3603":463,"_31069":423,"_21510":52147,"_5":14782,"_28250":52053,"_3059":52148},[],"Check the check route is /v1/ext\\_authz/check.",{"_3603":464,"_31069":423,"_21510":52150,"_5":14782,"_28250":52053,"_3059":52151},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3603":465,"_31069":423,"_21510":52153,"_5":14782,"_28250":52057,"_3059":52154},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3603":466,"_31069":423,"_21510":52156,"_5":14782,"_28250":52061,"_3059":52157},[],"Review kubectl describe pod first. Common causes are:",{"_3603":467,"_31069":423,"_21510":52159,"_5":14782,"_28250":52061,"_3059":52160},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3603":468,"_31069":423,"_21510":52162,"_5":14782,"_28250":52061,"_3059":52163},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3603":469,"_31069":423,"_21510":52165,"_5":14782,"_28250":52061,"_3059":52166},[],"unbound persistent volume;",{"_3603":470,"_31069":423,"_21510":52168,"_5":14782,"_28250":52061,"_3059":52169},[],"inaccessible image or incorrect pull policy;",{"_3603":471,"_31069":423,"_21510":52171,"_5":14782,"_28250":52061,"_3059":52172},[],"invalid cryptographic engine configuration;",{"_3603":472,"_31069":423,"_21510":52174,"_5":14782,"_28250":52061,"_3059":52175},[],"CPU or memory limits set too low;",{"_3603":473,"_31069":423,"_21510":52177,"_5":14782,"_28250":52061,"_3059":52178},[],"an incomplete prior migration.",{"_3603":474,"_31069":423,"_21510":52180,"_5":14782,"_28250":52061,"_3059":52181},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3603":475,"_31069":423,"_21510":52183,"_5":14782,"_28250":52061,"_3059":52184},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3603":476,"_31069":423,"_21510":52186,"_5":14782,"_28250":52061,"_3059":52187},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3603":477,"_31069":423,"_21510":52189,"_5":14782,"_28250":52065,"_3059":52190},[],"Domain and audit events depend on the bus publisher:",{"_3603":478,"_31069":423,"_21510":52192,"_5":14782,"_28250":52065,"_3059":52193},[],"verify it is enabled in the emitting service;",{"_3603":479,"_31069":423,"_21510":52195,"_5":14782,"_28250":52065,"_3059":52196},[],"check AMQP connectivity and credentials;",{"_3603":480,"_31069":423,"_21510":52198,"_5":14782,"_28250":52065,"_3059":52199},[],"review exchange, routing key, queues and consumers;",{"_3603":481,"_31069":423,"_21510":52201,"_5":14782,"_28250":52065,"_3059":52202},[],"inspect dead-letter queues;",{"_3603":482,"_31069":423,"_21510":52204,"_5":14782,"_28250":52065,"_3059":52205},[],"alert on orphan durable queues and backlog growth.",{"_3603":483,"_31069":423,"_21510":52207,"_5":14782,"_28250":52065,"_3059":52208},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3603":484,"_31069":423,"_21510":52210,"_5":14782,"_28250":52065,"_3059":52211},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3603":485,"_31069":423,"_21510":52213,"_5":14782,"_28250":52065,"_3059":52214},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3603":486,"_31069":423,"_21510":52216,"_5":14782,"_28250":52065,"_3059":52217},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3603":487,"_31069":423,"_21510":52219,"_5":14782,"_28250":52065,"_3059":52220},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3603":488,"_31069":423,"_21510":52222,"_5":14782,"_28250":52065,"_3059":52223},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3603":489,"_31069":423,"_21510":52225,"_5":14782,"_28250":52065,"_3059":52226},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3603":490,"_31069":423,"_21510":52228,"_5":14782,"_28250":52069,"_3059":52229},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3603":491,"_31069":423,"_21510":52231,"_5":14782,"_28250":52069,"_3059":52232},[],"Before closing an incident, record:",{"_3603":492,"_31069":423,"_21510":52234,"_5":14782,"_28250":52069,"_3059":52235},[],"the confirmed cause;",{"_3603":493,"_31069":423,"_21510":52237,"_5":14782,"_28250":52069,"_3059":52238},[],"the time scope and affected resources;",{"_3603":494,"_31069":423,"_21510":52240,"_5":14782,"_28250":52069,"_3059":52241},[],"the commands or queries used;",{"_3603":495,"_31069":423,"_21510":52243,"_5":14782,"_28250":52069,"_3059":52244},[],"the applied change and how to revert it;",{"_3603":496,"_31069":423,"_21510":52246,"_5":14782,"_28250":52069,"_3059":52247},[],"validation from a consumer;",{"_3603":497,"_31069":423,"_21510":52249,"_5":14782,"_28250":52069,"_3059":52250},[],"the preventive action and its owner.",{"_3603":498,"_31069":498,"_5":15147,"_3059":52252,"_31428":52253,"_21510":52257,"_28250":498},"Data model",[50742,52254,52255,52256],"Platform","Administration","Access control",[],{"_3603":499,"_31069":498,"_21510":52259,"_5":14782,"_28250":498,"_3059":52260},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3603":500,"_31069":498,"_5":31425,"_21510":52262,"_28250":52263,"_3059":52264},[],"/docs/pr-preview/pr-74/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3603":501,"_31069":498,"_5":31425,"_21510":52266,"_28250":52267,"_3059":52268},[],"/docs/pr-preview/pr-74/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3603":502,"_31069":498,"_21510":52270,"_5":14782,"_28250":498,"_3059":52271},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3603":503,"_31069":498,"_21510":52273,"_5":14782,"_28250":52263,"_3059":52274},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3603":504,"_31069":498,"_21510":52276,"_5":14782,"_28250":52263,"_3059":52277},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3603":505,"_31069":498,"_21510":52279,"_5":14782,"_28250":52263,"_3059":52280},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3603":506,"_31069":498,"_21510":52282,"_5":14782,"_28250":52267,"_3059":52283},[],"Entity (`schema_name.entity_type`)",{"_3603":507,"_31069":498,"_21510":52285,"_5":14782,"_28250":52267,"_3059":52286},[],"Table (`table_name`)",{"_3603":508,"_31069":498,"_21510":52288,"_5":14782,"_28250":52267,"_3059":52289},[],"Key (`primary_key`)",{"_3603":509,"_31069":498,"_21510":52291,"_5":14782,"_28250":52267,"_3059":52292},[],"`alerts.event`",{"_3603":510,"_31069":498,"_21510":52294,"_5":14782,"_28250":52267,"_3059":52295},[],"`events`",{"_3603":511,"_31069":498,"_21510":52297,"_5":14782,"_28250":52267,"_3059":52298},[],"`event_type`",{"_3603":512,"_31069":498,"_21510":52300,"_5":14782,"_28250":52267,"_3059":52301},[],"`alerts.subscription`",{"_3603":513,"_31069":498,"_21510":52303,"_5":14782,"_28250":52267,"_3059":52304},[],"`subscriptions`",{"_3603":514,"_31069":498,"_21510":52306,"_5":14782,"_28250":52267,"_3059":52307},[],"`id`",{"_3603":515,"_31069":498,"_21510":52309,"_5":14782,"_28250":52267,"_3059":52310},[],"`ca.ca_certificate`",{"_3603":516,"_31069":498,"_21510":52312,"_5":14782,"_28250":52267,"_3059":52313},[],"`ca_certificates`",{"_3603":517,"_31069":498,"_21510":52315,"_5":14782,"_28250":52267,"_3059":52307},[],{"_3603":518,"_31069":498,"_21510":52317,"_5":14782,"_28250":52267,"_3059":52318},[],"`ca.certificate`",{"_3603":519,"_31069":498,"_21510":52320,"_5":14782,"_28250":52267,"_3059":52321},[],"`certificates`",{"_3603":520,"_31069":498,"_21510":52323,"_5":14782,"_28250":52267,"_3059":52324},[],"`serial_number`",{"_3603":521,"_31069":498,"_21510":52326,"_5":14782,"_28250":52267,"_3059":52327},[],"`ca.issuance_profile`",{"_3603":522,"_31069":498,"_21510":52329,"_5":14782,"_28250":52267,"_3059":52330},[],"`issuance_profiles`",{"_3603":523,"_31069":498,"_21510":52332,"_5":14782,"_28250":52267,"_3059":52307},[],{"_3603":524,"_31069":498,"_21510":52334,"_5":14782,"_28250":52267,"_3059":52335},[],"`devicemanager.device_group`",{"_3603":525,"_31069":498,"_21510":52337,"_5":14782,"_28250":52267,"_3059":52338},[],"`device_groups`",{"_3603":526,"_31069":498,"_21510":52340,"_5":14782,"_28250":52267,"_3059":52307},[],{"_3603":527,"_31069":498,"_21510":52342,"_5":14782,"_28250":52267,"_3059":52343},[],"`devicemanager.device`",{"_3603":528,"_31069":498,"_21510":52345,"_5":14782,"_28250":52267,"_3059":52346},[],"`devices`",{"_3603":529,"_31069":498,"_21510":52348,"_5":14782,"_28250":52267,"_3059":52307},[],{"_3603":530,"_31069":498,"_21510":52350,"_5":14782,"_28250":52267,"_3059":52351},[],"`dmsmanager.dms`",{"_3603":531,"_31069":498,"_21510":52353,"_5":14782,"_28250":52267,"_3059":52354},[],"`dms`",{"_3603":532,"_31069":498,"_21510":52356,"_5":14782,"_28250":52267,"_3059":52307},[],{"_3603":533,"_31069":498,"_21510":52358,"_5":14782,"_28250":52267,"_3059":52359},[],"`kms.kms_key`",{"_3603":534,"_31069":498,"_21510":52361,"_5":14782,"_28250":52267,"_3059":52362},[],"`kms_keys`",{"_3603":535,"_31069":498,"_21510":52364,"_5":14782,"_28250":52267,"_3059":52365},[],"`key_id`, `engine_id`",{"_3603":536,"_31069":498,"_21510":52367,"_5":14782,"_28250":52267,"_3059":52368},[],"`va.crl_settings`",{"_3603":537,"_31069":498,"_21510":52370,"_5":14782,"_28250":52267,"_3059":52371},[],"`crl_settings`",{"_3603":538,"_31069":498,"_21510":52373,"_5":14782,"_28250":52267,"_3059":52374},[],"`ca_id`",{"_3603":539,"_31069":498,"_21510":52376,"_5":14782,"_28250":52267,"_3059":52377},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3603":540,"_31069":498,"_21510":52379,"_5":14782,"_28250":52267,"_3059":52380},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3603":541,"_31069":498,"_21510":52382,"_5":14782,"_28250":52267,"_3059":52383},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3603":542,"_31069":542,"_5":15147,"_3059":52385,"_31428":52386,"_21510":52387,"_28250":542},"Access control overview",[50742,52254,52255,52256],[],{"_3603":543,"_31069":542,"_21510":52389,"_5":14782,"_28250":542,"_3059":52390},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3603":544,"_31069":542,"_5":31425,"_21510":52392,"_28250":52393,"_3059":52394},[],"/docs/pr-preview/pr-74/platform/administration/access-control#essential-concepts","Essential concepts",{"_3603":545,"_31069":542,"_5":31425,"_21510":52396,"_28250":52397,"_3059":52398},[],"/docs/pr-preview/pr-74/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3603":546,"_31069":542,"_5":31425,"_21510":52400,"_28250":52401,"_3059":52402},[],"/docs/pr-preview/pr-74/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3603":547,"_31069":542,"_5":31425,"_21510":52404,"_28250":52405,"_3059":52406},[],"/docs/pr-preview/pr-74/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3603":548,"_31069":542,"_5":31425,"_21510":52408,"_28250":52409,"_3059":52410},[],"/docs/pr-preview/pr-74/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3603":549,"_31069":542,"_5":31425,"_21510":52412,"_28250":52413,"_3059":52414},[],"/docs/pr-preview/pr-74/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3603":550,"_31069":542,"_5":31425,"_21510":52416,"_28250":52417,"_3059":52418},[],"/docs/pr-preview/pr-74/platform/administration/access-control#oidc-principals","OIDC principals",{"_3603":551,"_31069":542,"_5":31425,"_21510":52420,"_28250":52421,"_3059":52422},[],"/docs/pr-preview/pr-74/platform/administration/access-control#x509-principals","X.509 principals",{"_3603":552,"_31069":542,"_5":31425,"_21510":52424,"_28250":52425,"_3059":52426},[],"/docs/pr-preview/pr-74/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3603":553,"_31069":542,"_5":31425,"_21510":52428,"_28250":52429,"_3059":52430},[],"/docs/pr-preview/pr-74/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3603":554,"_31069":542,"_5":31425,"_21510":52432,"_28250":52433,"_3059":52434},[],"/docs/pr-preview/pr-74/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3603":555,"_31069":542,"_5":31425,"_21510":52436,"_28250":52437,"_3059":52438},[],"/docs/pr-preview/pr-74/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3603":556,"_31069":542,"_5":31425,"_21510":52440,"_28250":52441,"_3059":52442},[],"/docs/pr-preview/pr-74/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3603":557,"_31069":542,"_5":31425,"_21510":52444,"_28250":52445,"_3059":52446},[],"/docs/pr-preview/pr-74/platform/administration/access-control#http-rules","HTTP rules",{"_3603":558,"_31069":542,"_5":31425,"_21510":52448,"_28250":52449,"_3059":52450},[],"/docs/pr-preview/pr-74/platform/administration/access-control#included-policies","Included policies",{"_3603":559,"_31069":542,"_5":31425,"_21510":52452,"_28250":52453,"_3059":51392},[],"/docs/pr-preview/pr-74/platform/administration/access-control#provision-the-first-administrator",{"_3603":560,"_31069":542,"_5":31425,"_21510":52455,"_28250":52456,"_3059":52457},[],"/docs/pr-preview/pr-74/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3603":561,"_31069":542,"_5":31425,"_21510":52459,"_28250":52460,"_3059":52461},[],"/docs/pr-preview/pr-74/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3603":562,"_31069":542,"_5":31425,"_21510":52463,"_28250":52464,"_3059":52465},[],"/docs/pr-preview/pr-74/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3603":563,"_31069":542,"_5":31425,"_21510":52467,"_28250":52468,"_3059":52469},[],"/docs/pr-preview/pr-74/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3603":564,"_31069":542,"_5":31425,"_21510":52471,"_28250":52472,"_3059":52473},[],"/docs/pr-preview/pr-74/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3603":565,"_31069":542,"_5":31425,"_21510":52475,"_28250":52476,"_3059":52477},[],"/docs/pr-preview/pr-74/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3603":566,"_31069":542,"_5":31425,"_21510":52479,"_28250":52480,"_3059":52481},[],"/docs/pr-preview/pr-74/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3603":567,"_31069":542,"_5":31425,"_21510":52483,"_28250":52484,"_3059":52485},[],"/docs/pr-preview/pr-74/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3603":568,"_31069":542,"_5":31425,"_21510":52487,"_28250":52488,"_3059":52489},[],"/docs/pr-preview/pr-74/platform/administration/access-control#operational-checklist","Operational checklist",{"_3603":569,"_31069":542,"_5":31425,"_21510":52491,"_28250":52492,"_3059":52493},[],"/docs/pr-preview/pr-74/platform/administration/access-control#diagnostics","Diagnostics",{"_3603":570,"_31069":542,"_5":31425,"_21510":52495,"_28250":52496,"_3059":52497},[],"/docs/pr-preview/pr-74/platform/administration/access-control#the-response-is-401","The response is 401",{"_3603":571,"_31069":542,"_5":31425,"_21510":52499,"_28250":52500,"_3059":52501},[],"/docs/pr-preview/pr-74/platform/administration/access-control#the-response-is-403","The response is 403",{"_3603":572,"_31069":542,"_5":31425,"_21510":52503,"_28250":52504,"_3059":52505},[],"/docs/pr-preview/pr-74/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3603":573,"_31069":542,"_5":31425,"_21510":52507,"_28250":52508,"_3059":52509},[],"/docs/pr-preview/pr-74/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3603":574,"_31069":542,"_5":31425,"_21510":52511,"_28250":52512,"_3059":52513},[],"/docs/pr-preview/pr-74/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3603":575,"_31069":542,"_21510":52515,"_5":14782,"_28250":542,"_3059":52516},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3603":576,"_31069":542,"_21510":52518,"_5":14782,"_28250":542,"_3059":52519},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3603":577,"_31069":542,"_21510":52521,"_5":14782,"_28250":542,"_3059":52522},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3603":578,"_31069":542,"_21510":52524,"_5":14782,"_28250":52393,"_3059":52525},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3603":579,"_31069":542,"_21510":52527,"_5":14782,"_28250":52393,"_3059":52528},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3603":580,"_31069":542,"_21510":52530,"_5":14782,"_28250":52393,"_3059":52531},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3603":581,"_31069":542,"_21510":52533,"_5":14782,"_28250":52393,"_3059":52534},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3603":582,"_31069":542,"_21510":52536,"_5":14782,"_28250":52393,"_3059":52537},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3603":583,"_31069":542,"_21510":52539,"_5":14782,"_28250":52393,"_3059":52540},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3603":584,"_31069":542,"_21510":52542,"_5":14782,"_28250":52397,"_3059":52543},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3603":585,"_31069":542,"_21510":52545,"_5":14782,"_28250":52397,"_3059":52546},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3603":586,"_31069":542,"_21510":52548,"_5":14782,"_28250":52401,"_3059":52549},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3603":587,"_31069":542,"_21510":52551,"_5":14782,"_28250":52401,"_3059":52552},[],"The decision is made **before forwarding the request to the service**:",{"_3603":588,"_31069":542,"_21510":52554,"_5":14782,"_28250":52401,"_3059":52555},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3603":589,"_31069":542,"_21510":52557,"_5":14782,"_28250":52401,"_3059":52558},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3603":590,"_31069":542,"_21510":52560,"_5":14782,"_28250":52401,"_3059":52561},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3603":591,"_31069":542,"_21510":52563,"_5":14782,"_28250":52401,"_3059":52564},[],"It separately loads the policies granted to each principal.",{"_3603":592,"_31069":542,"_21510":52566,"_5":14782,"_28250":52401,"_3059":52567},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3603":593,"_31069":542,"_21510":52569,"_5":14782,"_28250":52401,"_3059":52570},[],"`authz` looks for an HTTP rule granting that action.",{"_3603":594,"_31069":542,"_21510":52572,"_5":14782,"_28250":52401,"_3059":52573},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3603":595,"_31069":542,"_21510":52575,"_5":14782,"_28250":52401,"_3059":52576},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3603":596,"_31069":542,"_21510":52578,"_5":14782,"_28250":52401,"_3059":52579},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3603":597,"_31069":542,"_21510":52581,"_5":14782,"_28250":52401,"_3059":52582},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3603":598,"_31069":542,"_21510":52584,"_5":14782,"_28250":52405,"_3059":52585},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3603":599,"_31069":542,"_21510":52587,"_5":14782,"_28250":52405,"_3059":52588},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3603":600,"_31069":542,"_21510":52590,"_5":14782,"_28250":52405,"_3059":52591},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3603":601,"_31069":542,"_21510":52593,"_5":14782,"_28250":52405,"_3059":52594},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3603":602,"_31069":542,"_21510":52596,"_5":14782,"_28250":52405,"_3059":52597},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3603":603,"_31069":542,"_21510":52599,"_5":14782,"_28250":52405,"_3059":52600},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3603":604,"_31069":542,"_21510":52602,"_5":14782,"_28250":52405,"_3059":52603},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3603":605,"_31069":542,"_21510":52605,"_5":14782,"_28250":52405,"_3059":52606},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3603":606,"_31069":542,"_21510":52608,"_5":14782,"_28250":52405,"_3059":52609},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3603":607,"_31069":542,"_21510":52611,"_5":14782,"_28250":52405,"_3059":52612},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3603":608,"_31069":542,"_21510":52614,"_5":14782,"_28250":52409,"_3059":52615},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3603":609,"_31069":542,"_21510":52617,"_5":14782,"_28250":52409,"_3059":52618},[],"The decision is made with the domain operation context:",{"_3603":610,"_31069":542,"_21510":52620,"_5":14782,"_28250":52409,"_3059":52621},[],"The middleware extracts the credential and resolves the matching principals.",{"_3603":611,"_31069":542,"_21510":52623,"_5":14782,"_28250":52409,"_3059":52624},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3603":612,"_31069":542,"_21510":52626,"_5":14782,"_28250":52409,"_3059":52627},[],"`authz` gathers the entity rules of the granted policies.",{"_3603":613,"_31069":542,"_21510":52629,"_5":14782,"_28250":52409,"_3059":52630},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3603":614,"_31069":542,"_21510":52632,"_5":14782,"_28250":52409,"_3059":52633},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3603":615,"_31069":542,"_21510":52635,"_5":14782,"_28250":52409,"_3059":52636},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3603":616,"_31069":542,"_21510":52638,"_5":14782,"_28250":52409,"_3059":52639},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3603":617,"_31069":542,"_21510":52641,"_5":14782,"_28250":52409,"_3059":52642},[],"Actions fall into two groups:",{"_3603":618,"_31069":542,"_21510":52644,"_5":14782,"_28250":52409,"_3059":52645},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3603":619,"_31069":542,"_21510":52647,"_5":14782,"_28250":52409,"_3059":52648},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3603":620,"_31069":542,"_21510":52650,"_5":14782,"_28250":52409,"_3059":52651},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3603":621,"_31069":542,"_21510":52653,"_5":14782,"_28250":52413,"_3059":52654},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3603":622,"_31069":542,"_21510":52656,"_5":14782,"_28250":52413,"_3059":52657},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3603":623,"_31069":542,"_21510":52659,"_5":14782,"_28250":52413,"_3059":52660},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3603":624,"_31069":542,"_21510":52662,"_5":14782,"_28250":52417,"_3059":52663},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3603":625,"_31069":542,"_21510":52665,"_5":14782,"_28250":52417,"_3059":52666},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3603":626,"_31069":542,"_21510":52668,"_5":14782,"_28250":52417,"_3059":52669},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3603":627,"_31069":542,"_21510":52671,"_5":14782,"_28250":52417,"_3059":52672},[],"The implemented operators are:",{"_3603":628,"_31069":542,"_21510":52674,"_5":14782,"_28250":52417,"_3059":52675},[],"`equals`, for exact equality;",{"_3603":629,"_31069":542,"_21510":52677,"_5":14782,"_28250":52417,"_3059":52678},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3603":630,"_31069":542,"_21510":52680,"_5":14782,"_28250":52417,"_3059":52681},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3603":631,"_31069":542,"_21510":52683,"_5":14782,"_28250":52417,"_3059":52684},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3603":632,"_31069":542,"_21510":52686,"_5":14782,"_28250":52421,"_3059":52687},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3603":633,"_31069":542,"_21510":52689,"_5":14782,"_28250":52421,"_3059":52690},[],"The available modes are:",{"_3603":634,"_31069":542,"_21510":52692,"_5":14782,"_28250":52421,"_3059":52693},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3603":635,"_31069":542,"_21510":52695,"_5":14782,"_28250":52421,"_3059":52696},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3603":636,"_31069":542,"_21510":52698,"_5":14782,"_28250":52421,"_3059":52699},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3603":637,"_31069":542,"_21510":52701,"_5":14782,"_28250":52421,"_3059":52702},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3603":638,"_31069":542,"_21510":52704,"_5":14782,"_28250":52421,"_3059":52705},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3603":639,"_31069":542,"_21510":52707,"_5":14782,"_28250":52421,"_3059":52708},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3603":640,"_31069":542,"_21510":52710,"_5":14782,"_28250":52425,"_3059":52711},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3603":641,"_31069":542,"_21510":52713,"_5":14782,"_28250":52425,"_3059":52714},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3603":642,"_31069":542,"_21510":52716,"_5":14782,"_28250":52425,"_3059":52717},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3603":643,"_31069":542,"_21510":52719,"_5":14782,"_28250":52425,"_3059":52720},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3603":644,"_31069":542,"_21510":52722,"_5":14782,"_28250":52433,"_3059":52723},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3603":645,"_31069":542,"_21510":52725,"_5":14782,"_28250":52433,"_3059":52726},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3603":646,"_31069":542,"_21510":52728,"_5":14782,"_28250":52437,"_3059":52729},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3603":647,"_31069":542,"_21510":52731,"_5":14782,"_28250":52437,"_3059":52732},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3603":648,"_31069":542,"_21510":52734,"_5":14782,"_28250":52437,"_3059":52735},[],"The data model shows how the resources used in entity rules are connected.",{"_3603":649,"_31069":542,"_21510":52737,"_5":14782,"_28250":52437,"_3059":52738},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3603":650,"_31069":542,"_21510":52740,"_5":14782,"_28250":52437,"_3059":52741},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3603":651,"_31069":542,"_21510":52743,"_5":14782,"_28250":52441,"_3059":52744},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3603":652,"_31069":542,"_21510":52746,"_5":14782,"_28250":52441,"_3059":52747},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3603":653,"_31069":542,"_21510":52749,"_5":14782,"_28250":52441,"_3059":52750},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3603":654,"_31069":542,"_21510":52752,"_5":14782,"_28250":52445,"_3059":52753},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3603":655,"_31069":542,"_21510":52755,"_5":14782,"_28250":52445,"_3059":52756},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3603":656,"_31069":542,"_21510":52758,"_5":14782,"_28250":52445,"_3059":52759},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3603":657,"_31069":542,"_21510":52761,"_5":14782,"_28250":52445,"_3059":52762},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3603":658,"_31069":542,"_21510":52764,"_5":14782,"_28250":52445,"_3059":52765},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3603":659,"_31069":542,"_21510":52767,"_5":14782,"_28250":52445,"_3059":52768},[],"Note that:",{"_3603":660,"_31069":542,"_21510":52770,"_5":14782,"_28250":52445,"_3059":52771},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3603":661,"_31069":542,"_21510":52773,"_5":14782,"_28250":52445,"_3059":52774},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3603":662,"_31069":542,"_21510":52776,"_5":14782,"_28250":52445,"_3059":52777},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3603":663,"_31069":542,"_21510":52779,"_5":14782,"_28250":52449,"_3059":52780},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3603":664,"_31069":542,"_21510":52782,"_5":14782,"_28250":52449,"_3059":52783},[],"full and read-only access to certificates and authorities;",{"_3603":665,"_31069":542,"_21510":52785,"_5":14782,"_28250":52449,"_3059":52786},[],"full and read-only access to the KMS;",{"_3603":666,"_31069":542,"_21510":52788,"_5":14782,"_28250":52449,"_3059":52789},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3603":667,"_31069":542,"_21510":52791,"_5":14782,"_28250":52449,"_3059":52792},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3603":668,"_31069":542,"_21510":52794,"_5":14782,"_28250":52449,"_3059":52795},[],"console access;",{"_3603":669,"_31069":542,"_21510":52797,"_5":14782,"_28250":52449,"_3059":52798},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3603":670,"_31069":542,"_21510":52800,"_5":14782,"_28250":52449,"_3059":52801},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3603":671,"_31069":542,"_21510":52803,"_5":14782,"_28250":52449,"_3059":52804},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3603":672,"_31069":542,"_21510":52806,"_5":14782,"_28250":52449,"_3059":52807},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3603":673,"_31069":542,"_21510":52809,"_5":14782,"_28250":52449,"_3059":52810},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3603":674,"_31069":542,"_21510":52812,"_5":14782,"_28250":52453,"_3059":52813},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3603":675,"_31069":542,"_21510":52815,"_5":14782,"_28250":52453,"_3059":52816},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3603":676,"_31069":542,"_21510":52818,"_5":14782,"_28250":52453,"_3059":52819},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3603":677,"_31069":542,"_21510":52821,"_5":14782,"_28250":52456,"_3059":52822},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3603":678,"_31069":542,"_21510":52824,"_5":14782,"_28250":52460,"_3059":52825},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3603":679,"_31069":542,"_21510":52827,"_5":14782,"_28250":52460,"_3059":52828},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3603":680,"_31069":542,"_21510":52830,"_5":14782,"_28250":52464,"_3059":52831},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3603":681,"_31069":542,"_21510":52833,"_5":14782,"_28250":52468,"_3059":52834},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3603":682,"_31069":542,"_21510":52836,"_5":14782,"_28250":52472,"_3059":52837},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3603":683,"_31069":542,"_21510":52839,"_5":14782,"_28250":52476,"_3059":52840},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3603":684,"_31069":542,"_21510":52842,"_5":14782,"_28250":52476,"_3059":52843},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3603":685,"_31069":542,"_21510":52845,"_5":14782,"_28250":52480,"_3059":52846},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3603":686,"_31069":542,"_21510":52848,"_5":14782,"_28250":52480,"_3059":52849},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3603":687,"_31069":542,"_21510":52851,"_5":14782,"_28250":52480,"_3059":52852},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3603":688,"_31069":542,"_21510":52854,"_5":14782,"_28250":52480,"_3059":52855},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3603":689,"_31069":542,"_21510":52857,"_5":14782,"_28250":52480,"_3059":52858},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3603":690,"_31069":542,"_21510":52860,"_5":14782,"_28250":52480,"_3059":52861},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3603":691,"_31069":542,"_21510":52863,"_5":14782,"_28250":52480,"_3059":52864},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3603":692,"_31069":542,"_21510":52866,"_5":14782,"_28250":52480,"_3059":52867},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3603":693,"_31069":542,"_21510":52869,"_5":14782,"_28250":52484,"_3059":52870},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3603":694,"_31069":542,"_21510":52872,"_5":14782,"_28250":52484,"_3059":52873},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3603":695,"_31069":542,"_21510":52875,"_5":14782,"_28250":52484,"_3059":52876},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3603":696,"_31069":542,"_21510":52878,"_5":14782,"_28250":52488,"_3059":52879},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3603":697,"_31069":542,"_21510":52881,"_5":14782,"_28250":52488,"_3059":52882},[],"Use groups or stable roles for people and independent identities for automations.",{"_3603":698,"_31069":542,"_21510":52884,"_5":14782,"_28250":52488,"_3059":52885},[],"Keep at least two recovery administrators and test their access periodically.",{"_3603":699,"_31069":542,"_21510":52887,"_5":14782,"_28250":52488,"_3059":52888},[],"Review active principals, their matches and their grants after IdP changes.",{"_3603":700,"_31069":542,"_21510":52890,"_5":14782,"_28250":52488,"_3059":52891},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3603":701,"_31069":542,"_21510":52893,"_5":14782,"_28250":52488,"_3059":52894},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3603":702,"_31069":542,"_21510":52896,"_5":14782,"_28250":52488,"_3059":52897},[],"Always test one allowed and one denied operation for each role.",{"_3603":703,"_31069":542,"_21510":52899,"_5":14782,"_28250":52488,"_3059":52900},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3603":704,"_31069":542,"_21510":52902,"_5":14782,"_28250":52496,"_3059":52903},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3603":705,"_31069":542,"_21510":52905,"_5":14782,"_28250":52500,"_3059":52906},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3603":706,"_31069":542,"_21510":52908,"_5":14782,"_28250":52500,"_3059":52909},[],"that an active principal of the correct type exists;",{"_3603":707,"_31069":542,"_21510":52911,"_5":14782,"_28250":52500,"_3059":52912},[],"that the claim paths and values match the real token exactly;",{"_3603":708,"_31069":542,"_21510":52914,"_5":14782,"_28250":52500,"_3059":52915},[],"that all of the principal's conditions hold;",{"_3603":709,"_31069":542,"_21510":52917,"_5":14782,"_28250":52500,"_3059":52918},[],"that the principal has the expected policy granted;",{"_3603":710,"_31069":542,"_21510":52920,"_5":14782,"_28250":52500,"_3059":52921},[],"that the policy includes the action and the requested resource type or route;",{"_3603":711,"_31069":542,"_21510":52923,"_5":14782,"_28250":52500,"_3059":52924},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3603":712,"_31069":542,"_21510":52926,"_5":14782,"_28250":52500,"_3059":52927},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3603":713,"_31069":542,"_21510":52929,"_5":14782,"_28250":52500,"_3059":52930},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3603":714,"_31069":542,"_21510":52932,"_5":14782,"_28250":52504,"_3059":52933},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3603":715,"_31069":542,"_21510":52935,"_5":14782,"_28250":52508,"_3059":52936},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3603":716,"_31069":542,"_21510":52938,"_5":14782,"_28250":52512,"_3059":52939},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3603":717,"_31069":542,"_21510":52941,"_5":14782,"_28250":52512,"_3059":52942},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3603":718,"_31069":718,"_5":15147,"_3059":52944,"_31428":52945,"_21510":52946,"_28250":718},"Alerts and subscriptions",[50742,52254,52255],[],{"_3603":719,"_31069":718,"_21510":52948,"_5":14782,"_28250":718,"_3059":52949},[],"Send PKI events to people and external systems.",{"_3603":720,"_31069":718,"_5":31425,"_21510":52951,"_28250":52952,"_3059":52953},[],"/docs/pr-preview/pr-74/platform/administration/alerts#how-it-works","How it works",{"_3603":721,"_31069":718,"_5":31425,"_21510":52955,"_28250":52956,"_3059":52957},[],"/docs/pr-preview/pr-74/platform/administration/alerts#available-channels","Available channels",{"_3603":722,"_31069":718,"_5":31425,"_21510":52959,"_28250":52960,"_3059":52961},[],"/docs/pr-preview/pr-74/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3603":723,"_31069":718,"_5":31425,"_21510":52963,"_28250":52964,"_3059":52965},[],"/docs/pr-preview/pr-74/platform/administration/alerts#choose-the-event","Choose the event",{"_3603":724,"_31069":718,"_5":31425,"_21510":52967,"_28250":52968,"_3059":52969},[],"/docs/pr-preview/pr-74/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3603":725,"_31069":718,"_5":31425,"_21510":52971,"_28250":52972,"_3059":52973},[],"/docs/pr-preview/pr-74/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3603":726,"_31069":718,"_5":31425,"_21510":52975,"_28250":52976,"_3059":52977},[],"/docs/pr-preview/pr-74/platform/administration/alerts#review-and-activate","Review and activate",{"_3603":727,"_31069":718,"_5":31425,"_21510":52979,"_28250":52980,"_3059":52981},[],"/docs/pr-preview/pr-74/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3603":728,"_31069":718,"_5":31425,"_21510":52983,"_28250":52984,"_3059":52985},[],"/docs/pr-preview/pr-74/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3603":729,"_31069":718,"_5":31425,"_21510":52987,"_28250":52988,"_3059":52989},[],"/docs/pr-preview/pr-74/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3603":730,"_31069":718,"_5":31425,"_21510":52991,"_28250":52992,"_3059":52993},[],"/docs/pr-preview/pr-74/platform/administration/alerts#event-families","Event families",{"_3603":731,"_31069":718,"_21510":52995,"_5":14782,"_28250":718,"_3059":52996},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3603":732,"_31069":718,"_21510":52998,"_5":14782,"_28250":52952,"_3059":52999},[],"A service publishes a domain event.",{"_3603":733,"_31069":718,"_21510":53001,"_5":14782,"_28250":52952,"_3059":53002},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3603":734,"_31069":718,"_21510":53004,"_5":14782,"_28250":52952,"_3059":53005},[],"Each subscription's filter decides whether it should be notified.",{"_3603":735,"_31069":718,"_21510":53007,"_5":14782,"_28250":52952,"_3059":53008},[],"Lamassu delivers the event to the configured channel.",{"_3603":736,"_31069":718,"_21510":53010,"_5":14782,"_28250":52952,"_3059":53011},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3603":737,"_31069":718,"_21510":53013,"_5":14782,"_28250":52956,"_3059":53014},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3603":738,"_31069":718,"_21510":53016,"_5":14782,"_28250":52956,"_3059":53017},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3603":739,"_31069":718,"_21510":53019,"_5":14782,"_28250":52956,"_3059":53020},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3603":740,"_31069":718,"_21510":53022,"_5":14782,"_28250":52956,"_3059":53023},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3603":741,"_31069":718,"_21510":53025,"_5":14782,"_28250":52956,"_3059":53026},[],"`apikey_options` requires `header` and `key`.",{"_3603":742,"_31069":718,"_21510":53028,"_5":14782,"_28250":52956,"_3059":53029},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3603":743,"_31069":718,"_21510":53031,"_5":14782,"_28250":52956,"_3059":53032},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3603":744,"_31069":718,"_21510":53034,"_5":14782,"_28250":52956,"_3059":53035},[],"The alerts API reference documents the full `http_client` schema.",{"_3603":745,"_31069":718,"_21510":53037,"_5":14782,"_28250":52964,"_3059":53038},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3603":746,"_31069":718,"_21510":53040,"_5":14782,"_28250":52968,"_3059":53041},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3603":747,"_31069":718,"_21510":53043,"_5":14782,"_28250":52972,"_3059":53044},[],"Add a filter if you don't want to receive every instance of the event.",{"_3603":748,"_31069":718,"_21510":53046,"_5":14782,"_28250":52972,"_3059":53047},[],"**None** notifies all instances of the event.",{"_3603":749,"_31069":718,"_21510":53049,"_5":14782,"_28250":52972,"_3059":53050},[],"**JSON Path** evaluates one or more specific fields.",{"_3603":750,"_31069":718,"_21510":53052,"_5":14782,"_28250":52972,"_3059":53053},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3603":751,"_31069":718,"_21510":53055,"_5":14782,"_28250":52972,"_3059":53056},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3603":752,"_31069":718,"_21510":53058,"_5":14782,"_28250":52972,"_3059":53059},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3603":753,"_31069":718,"_21510":53061,"_5":14782,"_28250":52972,"_3059":53062},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3603":754,"_31069":718,"_21510":53064,"_5":14782,"_28250":52976,"_3059":53065},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3603":755,"_31069":718,"_21510":53067,"_5":14782,"_28250":52980,"_3059":53068},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3603":756,"_31069":718,"_21510":53070,"_5":14782,"_28250":52980,"_3059":53071},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3603":757,"_31069":718,"_21510":53073,"_5":14782,"_28250":52980,"_3059":53074},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3603":758,"_31069":718,"_21510":53076,"_5":14782,"_28250":52980,"_3059":53077},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3603":759,"_31069":718,"_21510":53079,"_5":14782,"_28250":52980,"_3059":53080},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3603":760,"_31069":718,"_21510":53082,"_5":14782,"_28250":52980,"_3059":53083},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3603":761,"_31069":718,"_21510":53085,"_5":14782,"_28250":52980,"_3059":53086},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3603":762,"_31069":718,"_21510":53088,"_5":14782,"_28250":52980,"_3059":53089},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3603":763,"_31069":718,"_21510":53091,"_5":14782,"_28250":52984,"_3059":53092},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3603":764,"_31069":718,"_21510":53094,"_5":14782,"_28250":52984,"_3059":53095},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3603":765,"_31069":718,"_21510":53097,"_5":14782,"_28250":52984,"_3059":53098},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3603":766,"_31069":718,"_21510":53100,"_5":14782,"_28250":52984,"_3059":53101},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3603":767,"_31069":718,"_21510":53103,"_5":14782,"_28250":52984,"_3059":53104},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3603":768,"_31069":718,"_21510":53106,"_5":14782,"_28250":52984,"_3059":53107},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3603":769,"_31069":718,"_21510":53109,"_5":14782,"_28250":52984,"_3059":53110},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3603":770,"_31069":718,"_21510":53112,"_5":14782,"_28250":52984,"_3059":53113},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3603":771,"_31069":718,"_21510":53115,"_5":14782,"_28250":52988,"_3059":53116},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3603":772,"_31069":718,"_21510":53118,"_5":14782,"_28250":52988,"_3059":53119},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3603":773,"_31069":718,"_21510":53121,"_5":14782,"_28250":52992,"_3059":53122},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3603":774,"_31069":718,"_21510":53124,"_5":14782,"_28250":52992,"_3059":53125},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3603":775,"_31069":718,"_21510":53127,"_5":14782,"_28250":52992,"_3059":53128},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3603":776,"_31069":718,"_21510":53130,"_5":14782,"_28250":52992,"_3059":53131},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3603":777,"_31069":718,"_21510":53133,"_5":14782,"_28250":52992,"_3059":53134},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3603":778,"_31069":718,"_21510":53136,"_5":14782,"_28250":52992,"_3059":53137},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3603":779,"_31069":718,"_21510":53139,"_5":14782,"_28250":52992,"_3059":53140},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3603":780,"_31069":718,"_21510":53142,"_5":14782,"_28250":52992,"_3059":53143},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3603":781,"_31069":718,"_21510":53145,"_5":14782,"_28250":52992,"_3059":53146},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3603":782,"_31069":718,"_21510":53148,"_5":14782,"_28250":52992,"_3059":53149},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3603":783,"_31069":783,"_5":15147,"_3059":53151,"_31428":53152,"_21510":53153,"_28250":783},"Audit logs",[50742,52254,52255],[],{"_3603":784,"_31069":783,"_21510":53155,"_5":14782,"_28250":783,"_3059":53156},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3603":785,"_31069":783,"_5":31425,"_21510":53158,"_28250":53159,"_3059":53160},[],"/docs/pr-preview/pr-74/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3603":786,"_31069":783,"_5":31425,"_21510":53162,"_28250":53163,"_3059":53164},[],"/docs/pr-preview/pr-74/platform/administration/audit-logs#coverage","Coverage",{"_3603":787,"_31069":783,"_5":31425,"_21510":53166,"_28250":53167,"_3059":53168},[],"/docs/pr-preview/pr-74/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3603":788,"_31069":783,"_5":31425,"_21510":53170,"_28250":53171,"_3059":53172},[],"/docs/pr-preview/pr-74/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3603":789,"_31069":783,"_5":31425,"_21510":53174,"_28250":53175,"_3059":53176},[],"/docs/pr-preview/pr-74/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3603":790,"_31069":783,"_5":31425,"_21510":53178,"_28250":53179,"_3059":53180},[],"/docs/pr-preview/pr-74/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3603":791,"_31069":783,"_5":31425,"_21510":53182,"_28250":53183,"_3059":53184},[],"/docs/pr-preview/pr-74/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3603":792,"_31069":783,"_5":31425,"_21510":53186,"_28250":53187,"_3059":53188},[],"/docs/pr-preview/pr-74/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3603":793,"_31069":783,"_5":31425,"_21510":53190,"_28250":53191,"_3059":53192},[],"/docs/pr-preview/pr-74/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3603":794,"_31069":783,"_5":31425,"_21510":53194,"_28250":53195,"_3059":53196},[],"/docs/pr-preview/pr-74/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3603":795,"_31069":783,"_5":31425,"_21510":53198,"_28250":53199,"_3059":53200},[],"/docs/pr-preview/pr-74/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3603":796,"_31069":783,"_21510":53202,"_5":14782,"_28250":783,"_3059":53203},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3603":797,"_31069":783,"_21510":53205,"_5":14782,"_28250":53159,"_3059":53206},[],"The audit body includes:",{"_3603":798,"_31069":783,"_21510":53208,"_5":14782,"_28250":53159,"_3059":53209},[],"input: data received by the operation;",{"_3603":799,"_31069":783,"_21510":53211,"_5":14782,"_28250":53159,"_3059":53212},[],"has\\_error: whether the service returned an error;",{"_3603":800,"_31069":783,"_21510":53214,"_5":14782,"_28250":53159,"_3059":53215},[],"output: produced result or error message;",{"_3603":801,"_31069":783,"_21510":53217,"_5":14782,"_28250":53159,"_3059":53218},[],"principals: identifiers of the principals that matched the request.",{"_3603":802,"_31069":783,"_21510":53220,"_5":14782,"_28250":53159,"_3059":53221},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3603":803,"_31069":783,"_21510":53223,"_5":14782,"_28250":53159,"_3059":53224},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3603":804,"_31069":783,"_21510":53226,"_5":14782,"_28250":53163,"_3059":53227},[],"The backend applies auditing to mutations of:",{"_3603":805,"_31069":783,"_21510":53229,"_5":14782,"_28250":53163,"_3059":53230},[],"authorities, certificates and issuance profiles;",{"_3603":806,"_31069":783,"_21510":53232,"_5":14782,"_28250":53163,"_3059":53233},[],"keys and KMS engines;",{"_3603":807,"_31069":783,"_21510":53235,"_5":14782,"_28250":53163,"_3059":53236},[],"devices and identities;",{"_3603":808,"_31069":783,"_21510":53238,"_5":14782,"_28250":53163,"_3059":53239},[],"DMSs and enrollment operations;",{"_3603":809,"_31069":783,"_21510":53241,"_5":14782,"_28250":53163,"_3059":53242},[],"validation functions and CRL;",{"_3603":810,"_31069":783,"_21510":53244,"_5":14782,"_28250":53163,"_3059":53245},[],"principals, policies and authorization grants.",{"_3603":811,"_31069":783,"_21510":53247,"_5":14782,"_28250":53163,"_3059":53248},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3603":812,"_31069":783,"_21510":53250,"_5":14782,"_28250":53167,"_3059":53251},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3603":813,"_31069":783,"_21510":53253,"_5":14782,"_28250":53167,"_3059":53254},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3603":814,"_31069":783,"_21510":53256,"_5":14782,"_28250":53167,"_3059":53257},[],"Design the consumer to:",{"_3603":815,"_31069":783,"_21510":53259,"_5":14782,"_28250":53167,"_3059":53260},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3603":816,"_31069":783,"_21510":53262,"_5":14782,"_28250":53167,"_3059":53263},[],"keep the complete CloudEvent unmodified;",{"_3603":817,"_31069":783,"_21510":53265,"_5":14782,"_28250":53167,"_3059":53266},[],"record the ingestion time and detect duplicates by ID;",{"_3603":818,"_31069":783,"_21510":53268,"_5":14782,"_28250":53167,"_3059":53269},[],"encrypt in transit and at rest;",{"_3603":819,"_31069":783,"_21510":53271,"_5":14782,"_28250":53167,"_3059":53272},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3603":820,"_31069":783,"_21510":53274,"_5":14782,"_28250":53167,"_3059":53275},[],"apply an explicit retention and legal hold policy;",{"_3603":821,"_31069":783,"_21510":53277,"_5":14782,"_28250":53167,"_3059":53278},[],"alert if it stops consuming or the pending queue grows.",{"_3603":822,"_31069":783,"_21510":53280,"_5":14782,"_28250":53171,"_3059":53281},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3603":823,"_31069":783,"_21510":53283,"_5":14782,"_28250":53171,"_3059":53284},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3603":824,"_31069":783,"_21510":53286,"_5":14782,"_28250":53179,"_3059":53287},[],"Start from the reported time and normalize every source to UTC.",{"_3603":825,"_31069":783,"_21510":53289,"_5":14782,"_28250":53183,"_3059":53290},[],"Filter by event type, service source and resource identifier.",{"_3603":826,"_31069":783,"_21510":53292,"_5":14782,"_28250":53187,"_3059":53293},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3603":827,"_31069":783,"_21510":53295,"_5":14782,"_28250":53191,"_3059":53296},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3603":828,"_31069":783,"_21510":53298,"_5":14782,"_28250":53195,"_3059":53299},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3603":829,"_31069":783,"_21510":53301,"_5":14782,"_28250":53199,"_3059":53302},[],"Generate a controlled mutation in a test environment and check that:",{"_3603":830,"_31069":783,"_21510":53304,"_5":14782,"_28250":53199,"_3059":53305},[],"a successful audit event appears;",{"_3603":831,"_31069":783,"_21510":53307,"_5":14782,"_28250":53199,"_3059":53308},[],"the principal matches the identity used;",{"_3603":832,"_31069":783,"_21510":53310,"_5":14782,"_28250":53199,"_3059":53311},[],"the consumer persists it exactly once;",{"_3603":833,"_31069":783,"_21510":53313,"_5":14782,"_28250":53199,"_3059":53314},[],"it can be retrieved by resource, actor and period;",{"_3603":834,"_31069":783,"_21510":53316,"_5":14782,"_28250":53199,"_3059":53317},[],"a consumer outage raises an alert.",{"_3603":835,"_31069":783,"_21510":53319,"_5":14782,"_28250":53199,"_3059":53320},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3603":836,"_31069":836,"_5":15147,"_3059":53322,"_31428":53323,"_21510":53324,"_28250":836},"Platform architecture",[50742,52254],[],{"_3603":837,"_31069":836,"_21510":53326,"_5":14782,"_28250":836,"_3059":53327},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3603":838,"_31069":836,"_5":31425,"_21510":53329,"_28250":53330,"_3059":53331},[],"/docs/pr-preview/pr-74/platform/concepts/architecture#control-plane","Control plane",{"_3603":839,"_31069":836,"_5":31425,"_21510":53333,"_28250":53334,"_3059":53335},[],"/docs/pr-preview/pr-74/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3603":840,"_31069":836,"_5":31425,"_21510":53337,"_28250":53338,"_3059":53339},[],"/docs/pr-preview/pr-74/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3603":841,"_31069":836,"_5":31425,"_21510":53341,"_28250":53342,"_3059":53343},[],"/docs/pr-preview/pr-74/platform/concepts/architecture#status-and-validation","Status and validation",{"_3603":842,"_31069":836,"_5":31425,"_21510":53345,"_28250":53346,"_3059":53347},[],"/docs/pr-preview/pr-74/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3603":843,"_31069":836,"_21510":53349,"_5":14782,"_28250":836,"_3059":53350},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3603":844,"_31069":836,"_21510":53352,"_5":14782,"_28250":836,"_3059":53353},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3603":845,"_31069":836,"_21510":53355,"_5":14782,"_28250":53330,"_3059":53356},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3603":846,"_31069":836,"_21510":53358,"_5":14782,"_28250":53334,"_3059":53359},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3603":847,"_31069":836,"_21510":53361,"_5":14782,"_28250":53338,"_3059":53362},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3603":848,"_31069":836,"_21510":53364,"_5":14782,"_28250":53342,"_3059":53365},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3603":849,"_31069":836,"_21510":53367,"_5":14782,"_28250":53346,"_3059":53368},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3603":850,"_31069":850,"_5":15147,"_3059":53370,"_31428":53371,"_21510":53372,"_28250":850},"How Lamassu works",[50742,52254],[],{"_3603":851,"_31069":850,"_21510":53374,"_5":14782,"_28250":850,"_3059":53375},[],"The mental model of trust, keys, certificates and devices.",{"_3603":852,"_31069":850,"_5":31425,"_21510":53377,"_28250":53378,"_3059":53379},[],"/docs/pr-preview/pr-74/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3603":853,"_31069":850,"_5":31425,"_21510":53381,"_28250":53382,"_3059":53383},[],"/docs/pr-preview/pr-74/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3603":854,"_31069":850,"_21510":53385,"_5":14782,"_28250":850,"_3059":53386},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3603":855,"_31069":850,"_21510":53388,"_5":14782,"_28250":53378,"_3059":53389},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3603":856,"_31069":850,"_21510":53391,"_5":14782,"_28250":53378,"_3059":53392},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3603":857,"_31069":850,"_21510":53394,"_5":14782,"_28250":53378,"_3059":53395},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3603":858,"_31069":850,"_21510":53397,"_5":14782,"_28250":53378,"_3059":53398},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3603":859,"_31069":850,"_21510":53400,"_5":14782,"_28250":53378,"_3059":53401},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3603":860,"_31069":850,"_21510":53403,"_5":14782,"_28250":53382,"_3059":53404},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3603":861,"_31069":850,"_21510":53406,"_5":14782,"_28250":53382,"_3059":53407},[],"A DMS relates that CA to an enrollment policy.",{"_3603":862,"_31069":850,"_21510":53409,"_5":14782,"_28250":53382,"_3059":53410},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3603":863,"_31069":850,"_21510":53412,"_5":14782,"_28250":53382,"_3059":53413},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3603":864,"_31069":850,"_21510":53415,"_5":14782,"_28250":53382,"_3059":53416},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3603":865,"_31069":850,"_21510":53418,"_5":14782,"_28250":53382,"_3059":53419},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3603":866,"_31069":850,"_21510":53421,"_5":14782,"_28250":53382,"_3059":53422},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3603":867,"_31069":867,"_5":15147,"_3059":53424,"_31428":53425,"_21510":53427,"_28250":867},"Devices and identities",[50742,52254,53426,53424],"IoT Fleets",[],{"_3603":868,"_31069":867,"_21510":53429,"_5":14782,"_28250":867,"_3059":53430},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3603":869,"_31069":867,"_5":31425,"_21510":53432,"_28250":53433,"_3059":53434},[],"/docs/pr-preview/pr-74/platform/iot-fleets/device-management#device-states","Device states",{"_3603":870,"_31069":867,"_5":31425,"_21510":53436,"_28250":53437,"_3059":53438},[],"/docs/pr-preview/pr-74/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3603":871,"_31069":867,"_5":31425,"_21510":53440,"_28250":53441,"_3059":53442},[],"/docs/pr-preview/pr-74/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3603":872,"_31069":867,"_5":31425,"_21510":53444,"_28250":53445,"_3059":53446},[],"/docs/pr-preview/pr-74/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3603":873,"_31069":867,"_5":31425,"_21510":53448,"_28250":53449,"_3059":53450},[],"/docs/pr-preview/pr-74/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3603":874,"_31069":867,"_5":31425,"_21510":53452,"_28250":53453,"_3059":53454},[],"/docs/pr-preview/pr-74/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3603":875,"_31069":867,"_5":31425,"_21510":53456,"_28250":53457,"_3059":53458},[],"/docs/pr-preview/pr-74/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3603":876,"_31069":867,"_5":31425,"_21510":53460,"_28250":53461,"_3059":53462},[],"/docs/pr-preview/pr-74/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3603":877,"_31069":867,"_5":31425,"_21510":53464,"_28250":53465,"_3059":53466},[],"/docs/pr-preview/pr-74/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3603":878,"_31069":867,"_5":31425,"_21510":53468,"_28250":53469,"_3059":53470},[],"/docs/pr-preview/pr-74/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3603":879,"_31069":867,"_5":31425,"_21510":53472,"_28250":53473,"_3059":53474},[],"/docs/pr-preview/pr-74/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3603":880,"_31069":867,"_21510":53476,"_5":14782,"_28250":867,"_3059":53477},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3603":881,"_31069":867,"_21510":53479,"_5":14782,"_28250":867,"_3059":53480},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3603":882,"_31069":867,"_21510":53482,"_5":14782,"_28250":53433,"_3059":53483},[],"Operational view",{"_3603":883,"_31069":867,"_21510":53485,"_5":14782,"_28250":53433,"_3059":53486},[],"Meaning",{"_3603":884,"_31069":867,"_21510":53488,"_5":14782,"_28250":53433,"_3059":53489},[],"**No Identity**",{"_3603":885,"_31069":867,"_21510":53491,"_5":14782,"_28250":53433,"_3059":53492},[],"A record exists without an associated identity.",{"_3603":886,"_31069":867,"_21510":53494,"_5":14782,"_28250":53433,"_3059":53495},[],"**Active**",{"_3603":887,"_31069":867,"_21510":53497,"_5":14782,"_28250":53433,"_3059":53498},[],"The slot is active; also check certificate dates, status and usages.",{"_3603":888,"_31069":867,"_21510":53500,"_5":14782,"_28250":53433,"_3059":53501},[],"**Renewal Pending**",{"_3603":889,"_31069":867,"_21510":53503,"_5":14782,"_28250":53433,"_3059":53504},[],"The identity is in the operational renewal window.",{"_3603":890,"_31069":867,"_21510":53506,"_5":14782,"_28250":53433,"_3059":53507},[],"**Expiring Soon**",{"_3603":891,"_31069":867,"_21510":53509,"_5":14782,"_28250":53433,"_3059":53510},[],"Expiration is approaching according to configured thresholds.",{"_3603":892,"_31069":867,"_21510":53512,"_5":14782,"_28250":53433,"_3059":53513},[],"**Expired**",{"_3603":893,"_31069":867,"_21510":53515,"_5":14782,"_28250":53433,"_3059":53516},[],"The identity has expired.",{"_3603":894,"_31069":867,"_21510":53518,"_5":14782,"_28250":53433,"_3059":53519},[],"**Revoked**",{"_3603":895,"_31069":867,"_21510":53521,"_5":14782,"_28250":53433,"_3059":53522},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3603":896,"_31069":867,"_21510":53524,"_5":14782,"_28250":53433,"_3059":53525},[],"**Decommissioned**",{"_3603":897,"_31069":867,"_21510":53527,"_5":14782,"_28250":53433,"_3059":53528},[],"The record is retired and ordinary updates do not restore operation.",{"_3603":898,"_31069":867,"_21510":53530,"_5":14782,"_28250":53433,"_3059":53531},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3603":899,"_31069":867,"_21510":53533,"_5":14782,"_28250":53437,"_3059":53534},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3603":900,"_31069":867,"_21510":53536,"_5":14782,"_28250":53437,"_3059":53537},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3603":901,"_31069":867,"_21510":53539,"_5":14782,"_28250":53437,"_3059":53540},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3603":902,"_31069":867,"_21510":53542,"_5":14782,"_28250":53437,"_3059":53543},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3603":903,"_31069":867,"_21510":53545,"_5":14782,"_28250":53441,"_3059":53546},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3603":904,"_31069":867,"_21510":53548,"_5":14782,"_28250":53445,"_3059":53549},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3603":905,"_31069":867,"_21510":53551,"_5":14782,"_28250":53449,"_3059":53552},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3603":906,"_31069":867,"_21510":53554,"_5":14782,"_28250":53453,"_3059":53555},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3603":907,"_31069":867,"_21510":53557,"_5":14782,"_28250":53457,"_3059":53558},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3603":908,"_31069":867,"_21510":53560,"_5":14782,"_28250":53457,"_3059":53561},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3603":909,"_31069":867,"_21510":53563,"_5":14782,"_28250":53461,"_3059":53564},[],"From **No Identity**, use **Assign Identity**:",{"_3603":910,"_31069":867,"_21510":53566,"_5":14782,"_28250":53461,"_3059":53567},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3603":911,"_31069":867,"_21510":53569,"_5":14782,"_28250":53461,"_3059":53570},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3603":912,"_31069":867,"_21510":53572,"_5":14782,"_28250":53461,"_3059":53573},[],"Confirm and read the serial, active version and history again.",{"_3603":913,"_31069":867,"_21510":53575,"_5":14782,"_28250":53461,"_3059":53576},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3603":914,"_31069":867,"_21510":53578,"_5":14782,"_28250":53461,"_3059":53579},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3603":915,"_31069":867,"_21510":53581,"_5":14782,"_28250":53465,"_3059":53582},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3603":916,"_31069":867,"_21510":53584,"_5":14782,"_28250":53465,"_3059":53585},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3603":917,"_31069":867,"_21510":53587,"_5":14782,"_28250":53465,"_3059":53588},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3603":918,"_31069":867,"_21510":53590,"_5":14782,"_28250":53469,"_3059":53591},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3603":919,"_31069":867,"_21510":53593,"_5":14782,"_28250":53469,"_3059":53594},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3603":920,"_31069":867,"_21510":53596,"_5":14782,"_28250":53469,"_3059":53597},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3603":921,"_31069":867,"_21510":53599,"_5":14782,"_28250":53469,"_3059":53600},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3603":922,"_31069":867,"_21510":53602,"_5":14782,"_28250":53473,"_3059":53603},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3603":923,"_31069":867,"_21510":53605,"_5":14782,"_28250":53473,"_3059":53606},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3603":924,"_31069":924,"_5":15147,"_3059":53608,"_31428":53609,"_21510":53611,"_28250":924},"Bootstrap identity and authentication",[50742,52254,53426,53424,53610],"Enrollment with PKI",[],{"_3603":925,"_31069":924,"_21510":53613,"_5":14782,"_28250":924,"_3059":53614},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3603":926,"_31069":924,"_5":31425,"_21510":53616,"_28250":53617,"_3059":53618},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3603":927,"_31069":924,"_5":31425,"_21510":53620,"_28250":53621,"_3059":53622},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3603":928,"_31069":924,"_5":31425,"_21510":53624,"_28250":53625,"_3059":53626},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3603":929,"_31069":924,"_5":31425,"_21510":53628,"_28250":53629,"_3059":53630},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3603":930,"_31069":924,"_5":31425,"_21510":53632,"_28250":53633,"_3059":53634},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3603":931,"_31069":924,"_21510":53636,"_5":14782,"_28250":924,"_3059":53637},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3603":932,"_31069":924,"_21510":53639,"_5":14782,"_28250":53617,"_3059":53640},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3603":933,"_31069":924,"_21510":53642,"_5":14782,"_28250":53617,"_3059":53643},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3603":934,"_31069":924,"_21510":53645,"_5":14782,"_28250":53621,"_3059":53646},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3603":935,"_31069":924,"_21510":53648,"_5":14782,"_28250":53621,"_3059":53649},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3603":936,"_31069":924,"_21510":53651,"_5":14782,"_28250":53621,"_3059":53652},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3603":937,"_31069":924,"_21510":53654,"_5":14782,"_28250":53625,"_3059":53655},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3603":938,"_31069":924,"_21510":53657,"_5":14782,"_28250":53625,"_3059":53658},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3603":939,"_31069":924,"_21510":53660,"_5":14782,"_28250":53629,"_3059":53661},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3603":940,"_31069":924,"_21510":53663,"_5":14782,"_28250":53629,"_3059":53664},[],"Example body:",{"_3603":941,"_31069":924,"_21510":53666,"_5":14782,"_28250":53629,"_3059":53667},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3603":942,"_31069":924,"_21510":53669,"_5":14782,"_28250":53629,"_3059":53670},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3603":943,"_31069":924,"_21510":53672,"_5":14782,"_28250":53629,"_3059":53673},[],"Continuation requires a successful HTTP response and JSON:",{"_3603":944,"_31069":924,"_21510":53675,"_5":14782,"_28250":53629,"_3059":53676},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3603":945,"_31069":924,"_21510":53678,"_5":14782,"_28250":53633,"_3059":53679},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3603":946,"_31069":924,"_21510":53681,"_5":14782,"_28250":53633,"_3059":53682},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3603":947,"_31069":947,"_5":15147,"_3059":53684,"_31428":53685,"_21510":53686,"_28250":947},"Configure and operate the DMS",[50742,52254,53426,53424,53610],[],{"_3603":948,"_31069":947,"_21510":53688,"_5":14782,"_28250":947,"_3059":53689},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3603":949,"_31069":947,"_5":31425,"_21510":53691,"_28250":53692,"_3059":50752},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3603":950,"_31069":947,"_5":31425,"_21510":53694,"_28250":53695,"_3059":53696},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3603":951,"_31069":947,"_5":31425,"_21510":53698,"_28250":53699,"_3059":53700},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3603":952,"_31069":947,"_5":31425,"_21510":53702,"_28250":53703,"_3059":53704},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3603":953,"_31069":947,"_5":31425,"_21510":53706,"_28250":53707,"_3059":53708},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3603":954,"_31069":947,"_5":31425,"_21510":53710,"_28250":53711,"_3059":53712},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3603":955,"_31069":947,"_5":31425,"_21510":53714,"_28250":53715,"_3059":53716},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3603":956,"_31069":947,"_5":31425,"_21510":53718,"_28250":53719,"_3059":53720},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3603":957,"_31069":947,"_5":31425,"_21510":53722,"_28250":53723,"_3059":53724},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3603":958,"_31069":947,"_5":31425,"_21510":53726,"_28250":53727,"_3059":53728},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3603":959,"_31069":947,"_5":31425,"_21510":53730,"_28250":53731,"_3059":53732},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3603":960,"_31069":947,"_5":31425,"_21510":53734,"_28250":53735,"_3059":53736},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3603":961,"_31069":947,"_5":31425,"_21510":53738,"_28250":53739,"_3059":53740},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3603":962,"_31069":947,"_5":31425,"_21510":53742,"_28250":53743,"_3059":53744},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3603":963,"_31069":947,"_5":31425,"_21510":53746,"_28250":53747,"_3059":53748},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3603":964,"_31069":947,"_5":31425,"_21510":53750,"_28250":53751,"_3059":53752},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3603":965,"_31069":947,"_5":31425,"_21510":53754,"_28250":53755,"_3059":53756},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3603":966,"_31069":947,"_5":31425,"_21510":53758,"_28250":53759,"_3059":53760},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3603":967,"_31069":947,"_21510":53762,"_5":14782,"_28250":947,"_3059":53763},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3603":968,"_31069":947,"_21510":53765,"_5":14782,"_28250":53692,"_3059":53766},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3603":969,"_31069":947,"_21510":53768,"_5":14782,"_28250":53692,"_3059":53769},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3603":970,"_31069":947,"_21510":53771,"_5":14782,"_28250":53699,"_3059":53772},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3603":971,"_31069":947,"_21510":53774,"_5":14782,"_28250":53703,"_3059":53775},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3603":972,"_31069":947,"_21510":53777,"_5":14782,"_28250":53707,"_3059":53778},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3603":973,"_31069":947,"_21510":53780,"_5":14782,"_28250":53711,"_3059":53781},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3603":974,"_31069":947,"_21510":53783,"_5":14782,"_28250":53715,"_3059":53784},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3603":975,"_31069":947,"_21510":53786,"_5":14782,"_28250":53723,"_3059":53787},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3603":976,"_31069":947,"_21510":53789,"_5":14782,"_28250":53723,"_3059":53790},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3603":977,"_31069":947,"_21510":53792,"_5":14782,"_28250":53727,"_3059":53793},[],"`settings.enrollment_settings` field",{"_3603":978,"_31069":947,"_21510":53795,"_5":14782,"_28250":53727,"_3059":53796},[],"Decision",{"_3603":979,"_31069":947,"_21510":53798,"_5":14782,"_28250":53727,"_3059":53799},[],"`protocol`",{"_3603":980,"_31069":947,"_21510":53801,"_5":14782,"_28250":53727,"_3059":53802},[],"`EST_RFC7030` for these operations.",{"_3603":981,"_31069":947,"_21510":53804,"_5":14782,"_28250":53727,"_3059":53805},[],"`enrollment_ca`",{"_3603":982,"_31069":947,"_21510":53807,"_5":14782,"_28250":53727,"_3059":53808},[],"ID of the signing CA.",{"_3603":983,"_31069":947,"_21510":53810,"_5":14782,"_28250":53727,"_3059":53811},[],"`verify_csr_signature`",{"_3603":984,"_31069":947,"_21510":53813,"_5":14782,"_28250":53727,"_3059":53814},[],"Keep `true` to verify CSR key possession.",{"_3603":985,"_31069":947,"_21510":53816,"_5":14782,"_28250":53727,"_3059":53817},[],"`enable_replaceable_enrollment`",{"_3603":986,"_31069":947,"_21510":53819,"_5":14782,"_28250":53727,"_3059":53820},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3603":987,"_31069":947,"_21510":53822,"_5":14782,"_28250":53727,"_3059":53823},[],"`est_rfc7030_settings.auth_mode`",{"_3603":988,"_31069":947,"_21510":53825,"_5":14782,"_28250":53727,"_3059":53826},[],"One of the four authentication modes.",{"_3603":989,"_31069":947,"_21510":53828,"_5":14782,"_28250":53727,"_3059":53829},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3603":990,"_31069":947,"_21510":53831,"_5":14782,"_28250":53731,"_3059":53832},[],"The blocks are independent:",{"_3603":991,"_31069":947,"_21510":53834,"_5":14782,"_28250":53731,"_3059":53835},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3603":992,"_31069":947,"_21510":53837,"_5":14782,"_28250":53731,"_3059":53838},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3603":993,"_31069":947,"_21510":53840,"_5":14782,"_28250":53731,"_3059":53841},[],"`auth_mode`",{"_3603":994,"_31069":947,"_21510":53843,"_5":14782,"_28250":53731,"_3059":53844},[],"Control applied in the configured operation",{"_3603":995,"_31069":947,"_21510":53846,"_5":14782,"_28250":53731,"_3059":53847},[],"`CLIENT_CERTIFICATE`",{"_3603":996,"_31069":947,"_21510":53849,"_5":14782,"_28250":53731,"_3059":53850},[],"Presented certificate validation.",{"_3603":997,"_31069":947,"_21510":53852,"_5":14782,"_28250":53731,"_3059":53853},[],"`EXTERNAL_WEBHOOK`",{"_3603":998,"_31069":947,"_21510":53855,"_5":14782,"_28250":53731,"_3059":53856},[],"Configured webhook authorization.",{"_3603":999,"_31069":947,"_21510":53858,"_5":14782,"_28250":53731,"_3059":53859},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3603":1000,"_31069":947,"_21510":53861,"_5":14782,"_28250":53731,"_3059":53862},[],"Certificate validation followed by webhook approval.",{"_3603":1001,"_31069":947,"_21510":53864,"_5":14782,"_28250":53731,"_3059":53865},[],"`NO_AUTH`",{"_3603":1002,"_31069":947,"_21510":53867,"_5":14782,"_28250":53731,"_3059":53868},[],"No DMS requester authentication.",{"_3603":1003,"_31069":947,"_21510":53870,"_5":14782,"_28250":53731,"_3059":53871},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3603":1004,"_31069":947,"_21510":53873,"_5":14782,"_28250":53731,"_3059":53874},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3603":1005,"_31069":947,"_21510":53876,"_5":14782,"_28250":53731,"_3059":53877},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3603":1006,"_31069":947,"_21510":53879,"_5":14782,"_28250":53731,"_3059":53880},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3603":1007,"_31069":947,"_21510":53882,"_5":14782,"_28250":53735,"_3059":53883},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3603":1008,"_31069":947,"_21510":53885,"_5":14782,"_28250":53735,"_3059":53886},[],"`external_webhook_settings` field",{"_3603":1009,"_31069":947,"_21510":53888,"_5":14782,"_28250":53735,"_3059":53796},[],{"_3603":1010,"_31069":947,"_21510":53890,"_5":14782,"_28250":53735,"_3059":53891},[],"`url`",{"_3603":1011,"_31069":947,"_21510":53893,"_5":14782,"_28250":53735,"_3059":53894},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3603":1012,"_31069":947,"_21510":53896,"_5":14782,"_28250":53735,"_3059":53897},[],"`method`",{"_3603":1013,"_31069":947,"_21510":53899,"_5":14782,"_28250":53735,"_3059":53900},[],"`POST` or `PUT`; `POST` by default.",{"_3603":1014,"_31069":947,"_21510":53902,"_5":14782,"_28250":53735,"_3059":53903},[],"`name`",{"_3603":1015,"_31069":947,"_21510":53905,"_5":14782,"_28250":53735,"_3059":53906},[],"Label used in service logs.",{"_3603":1016,"_31069":947,"_21510":53908,"_5":14782,"_28250":53735,"_3059":53909},[],"`config.auth_mode`",{"_3603":1017,"_31069":947,"_21510":53911,"_5":14782,"_28250":53735,"_3059":53912},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3603":1018,"_31069":947,"_21510":53914,"_5":14782,"_28250":53735,"_3059":53915},[],"`config.log_level`",{"_3603":1019,"_31069":947,"_21510":53917,"_5":14782,"_28250":53735,"_3059":53918},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3603":1020,"_31069":947,"_21510":53920,"_5":14782,"_28250":53735,"_3059":53921},[],"`config.apikey_options`",{"_3603":1021,"_31069":947,"_21510":53923,"_5":14782,"_28250":53735,"_3059":53924},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3603":1022,"_31069":947,"_21510":53926,"_5":14782,"_28250":53735,"_3059":53927},[],"`config.jwt_options`",{"_3603":1023,"_31069":947,"_21510":53929,"_5":14782,"_28250":53735,"_3059":53930},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3603":1024,"_31069":947,"_21510":53932,"_5":14782,"_28250":53735,"_3059":53933},[],"`config.mtls_options`",{"_3603":1025,"_31069":947,"_21510":53935,"_5":14782,"_28250":53735,"_3059":53936},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3603":1026,"_31069":947,"_21510":53938,"_5":14782,"_28250":53735,"_3059":53939},[],"`config.insecure_skip_verify`",{"_3603":1027,"_31069":947,"_21510":53941,"_5":14782,"_28250":53735,"_3059":53942},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3603":1028,"_31069":947,"_21510":53944,"_5":14782,"_28250":53735,"_3059":53945},[],"`config.call_timeout`",{"_3603":1029,"_31069":947,"_21510":53947,"_5":14782,"_28250":53735,"_3059":53948},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3603":1030,"_31069":947,"_21510":53950,"_5":14782,"_28250":53735,"_3059":53951},[],"Rules for that configuration:",{"_3603":1031,"_31069":947,"_21510":53953,"_5":14782,"_28250":53735,"_3059":53954},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3603":1032,"_31069":947,"_21510":53956,"_5":14782,"_28250":53735,"_3059":53957},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3603":1033,"_31069":947,"_21510":53959,"_5":14782,"_28250":53735,"_3059":53960},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3603":1034,"_31069":947,"_21510":53962,"_5":14782,"_28250":53735,"_3059":53963},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3603":1035,"_31069":947,"_21510":53965,"_5":14782,"_28250":53735,"_3059":53966},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3603":1036,"_31069":947,"_21510":53968,"_5":14782,"_28250":53735,"_3059":53969},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3603":1037,"_31069":947,"_21510":53971,"_5":14782,"_28250":53735,"_3059":53972},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3603":1038,"_31069":947,"_21510":53974,"_5":14782,"_28250":53735,"_3059":53975},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3603":1039,"_31069":947,"_21510":53977,"_5":14782,"_28250":53735,"_3059":53978},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3603":1040,"_31069":947,"_21510":53980,"_5":14782,"_28250":53739,"_3059":53981},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3603":1041,"_31069":947,"_21510":53983,"_5":14782,"_28250":53743,"_3059":53984},[],"`settings.reenrollment_settings` field",{"_3603":1042,"_31069":947,"_21510":53986,"_5":14782,"_28250":53743,"_3059":51132},[],{"_3603":1043,"_31069":947,"_21510":53988,"_5":14782,"_28250":53743,"_3059":53989},[],"`reenrollment_delta`",{"_3603":1044,"_31069":947,"_21510":53991,"_5":14782,"_28250":53743,"_3059":53992},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3603":1045,"_31069":947,"_21510":53994,"_5":14782,"_28250":53743,"_3059":53995},[],"`preventive_delta`",{"_3603":1046,"_31069":947,"_21510":53997,"_5":14782,"_28250":53743,"_3059":53998},[],"Preventive operational monitoring threshold.",{"_3603":1047,"_31069":947,"_21510":54000,"_5":14782,"_28250":53743,"_3059":54001},[],"`critical_delta`",{"_3603":1048,"_31069":947,"_21510":54003,"_5":14782,"_28250":53743,"_3059":54004},[],"Critical operational monitoring threshold.",{"_3603":1049,"_31069":947,"_21510":54006,"_5":14782,"_28250":53743,"_3059":54007},[],"`enable_expired_renewal`",{"_3603":1050,"_31069":947,"_21510":54009,"_5":14782,"_28250":53743,"_3059":54010},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3603":1051,"_31069":947,"_21510":54012,"_5":14782,"_28250":53743,"_3059":54013},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3603":1052,"_31069":947,"_21510":54015,"_5":14782,"_28250":53743,"_3059":54016},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3603":1053,"_31069":947,"_21510":54018,"_5":14782,"_28250":53743,"_3059":54019},[],"`revoke_on_reenrollment`",{"_3603":1054,"_31069":947,"_21510":54021,"_5":14782,"_28250":53743,"_3059":54022},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3603":1055,"_31069":947,"_21510":54024,"_5":14782,"_28250":53743,"_3059":54025},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3603":1056,"_31069":947,"_21510":54027,"_5":14782,"_28250":53747,"_3059":54028},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3603":1057,"_31069":947,"_21510":54030,"_5":14782,"_28250":53751,"_3059":51126},[],{"_3603":1058,"_31069":947,"_21510":54032,"_5":14782,"_28250":53751,"_3059":54033},[],"Published material",{"_3603":1059,"_31069":947,"_21510":54035,"_5":14782,"_28250":53751,"_3059":54036},[],"**Include Lamassu System CA**",{"_3603":1060,"_31069":947,"_21510":54038,"_5":14782,"_28250":53751,"_3059":54039},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3603":1061,"_31069":947,"_21510":54041,"_5":14782,"_28250":53751,"_3059":54042},[],"**Include Enrollment CA**",{"_3603":1062,"_31069":947,"_21510":54044,"_5":14782,"_28250":53751,"_3059":54045},[],"Selected issuing CA certificate.",{"_3603":1063,"_31069":947,"_21510":54047,"_5":14782,"_28250":53751,"_3059":54048},[],"**Managed CAs**",{"_3603":1064,"_31069":947,"_21510":54050,"_5":14782,"_28250":53751,"_3059":54051},[],"Explicitly selected CA certificates.",{"_3603":1065,"_31069":947,"_21510":54053,"_5":14782,"_28250":53751,"_3059":54054},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3603":1066,"_31069":947,"_21510":54056,"_5":14782,"_28250":53755,"_3059":54057},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3603":1067,"_31069":947,"_21510":54059,"_5":14782,"_28250":53755,"_3059":54060},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3603":1068,"_31069":947,"_21510":54062,"_5":14782,"_28250":53755,"_3059":54063},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3603":1069,"_31069":947,"_21510":54065,"_5":14782,"_28250":53759,"_3059":54066},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3603":1070,"_31069":1070,"_5":15147,"_3059":54068,"_31428":54069,"_21510":54070,"_28250":1070},"Integrate the EST client",[50742,52254,53426,53424,53610],[],{"_3603":1071,"_31069":1070,"_21510":54072,"_5":14782,"_28250":1070,"_3059":54073},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3603":1072,"_31069":1070,"_5":31425,"_21510":54075,"_28250":54076,"_3059":50752},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3603":1073,"_31069":1070,"_5":31425,"_21510":54078,"_28250":54079,"_3059":54080},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3603":1074,"_31069":1070,"_5":31425,"_21510":54082,"_28250":54083,"_3059":54084},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3603":1075,"_31069":1070,"_5":31425,"_21510":54086,"_28250":54087,"_3059":54088},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3603":1076,"_31069":1070,"_5":31425,"_21510":54090,"_28250":54091,"_3059":54092},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3603":1077,"_31069":1070,"_5":31425,"_21510":54094,"_28250":54095,"_3059":54096},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3603":1078,"_31069":1070,"_21510":54098,"_5":14782,"_28250":1070,"_3059":54099},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3603":1079,"_31069":1070,"_21510":54101,"_5":14782,"_28250":54076,"_3059":54102},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3603":1080,"_31069":1070,"_21510":54104,"_5":14782,"_28250":54076,"_3059":54105},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3603":1081,"_31069":1070,"_21510":54107,"_5":14782,"_28250":54076,"_3059":54108},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3603":1082,"_31069":1070,"_21510":54110,"_5":14782,"_28250":54079,"_3059":54111},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3603":1083,"_31069":1070,"_21510":54113,"_5":14782,"_28250":54079,"_3059":54114},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3603":1084,"_31069":1070,"_21510":54116,"_5":14782,"_28250":54083,"_3059":54117},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3603":1085,"_31069":1070,"_21510":54119,"_5":14782,"_28250":54083,"_3059":54120},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3603":1086,"_31069":1070,"_21510":54122,"_5":14782,"_28250":54087,"_3059":54123},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3603":1087,"_31069":1070,"_21510":54125,"_5":14782,"_28250":54087,"_3059":54126},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3603":1088,"_31069":1070,"_21510":54128,"_5":14782,"_28250":54091,"_3059":54129},[],"For a root that issues directly:",{"_3603":1089,"_31069":1070,"_21510":54131,"_5":14782,"_28250":54091,"_3059":54132},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3603":1090,"_31069":1070,"_21510":54134,"_5":14782,"_28250":54091,"_3059":54135},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3603":1091,"_31069":1070,"_21510":54137,"_5":14782,"_28250":54095,"_3059":54138},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3603":1092,"_31069":1092,"_5":15147,"_3059":54140,"_31428":54141,"_21510":54142,"_28250":1092},"EST reference",[50742,52254,53426,53424,53610],[],{"_3603":1093,"_31069":1092,"_21510":54144,"_5":14782,"_28250":1092,"_3059":54145},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3603":1094,"_31069":1092,"_5":31425,"_21510":54147,"_28250":54148,"_3059":54149},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3603":1095,"_31069":1092,"_5":31425,"_21510":54151,"_28250":54152,"_3059":23312},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3603":1096,"_31069":1092,"_5":31425,"_21510":54154,"_28250":54155,"_3059":26806},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3603":1097,"_31069":1092,"_5":31425,"_21510":54157,"_28250":54158,"_3059":26813},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3603":1098,"_31069":1092,"_5":31425,"_21510":54160,"_28250":54161,"_3059":26075},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3603":1099,"_31069":1092,"_5":31425,"_21510":54163,"_28250":54164,"_3059":54165},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3603":1100,"_31069":1092,"_5":31425,"_21510":54167,"_28250":54168,"_3059":54169},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3603":1101,"_31069":1092,"_5":31425,"_21510":54171,"_28250":54172,"_3059":54173},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3603":1102,"_31069":1092,"_21510":54175,"_5":14782,"_28250":1092,"_3059":54176},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3603":1103,"_31069":1092,"_21510":54178,"_5":14782,"_28250":54148,"_3059":54179},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3603":1104,"_31069":1092,"_21510":54181,"_5":14782,"_28250":54148,"_3059":54182},[],"Operation",{"_3603":1105,"_31069":1092,"_21510":54184,"_5":14782,"_28250":54148,"_3059":54185},[],"Method",{"_3603":1106,"_31069":1092,"_21510":54187,"_5":14782,"_28250":54148,"_3059":54188},[],"Authentication and condition",{"_3603":1107,"_31069":1092,"_21510":54190,"_5":14782,"_28250":54148,"_3059":54191},[],"`/cacerts`",{"_3603":1108,"_31069":1092,"_21510":54193,"_5":14782,"_28250":54148,"_3059":54194},[],"GET",{"_3603":1109,"_31069":1092,"_21510":54196,"_5":14782,"_28250":54148,"_3059":54197},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3603":1110,"_31069":1092,"_21510":54199,"_5":14782,"_28250":54148,"_3059":54200},[],"`/simpleenroll`",{"_3603":1111,"_31069":1092,"_21510":54202,"_5":14782,"_28250":54148,"_3059":54203},[],"POST",{"_3603":1112,"_31069":1092,"_21510":54205,"_5":14782,"_28250":54148,"_3059":54206},[],"Initial authentication and DMS registration/replacement policy.",{"_3603":1113,"_31069":1092,"_21510":54208,"_5":14782,"_28250":54148,"_3059":54209},[],"`/simplereenroll`",{"_3603":1114,"_31069":1092,"_21510":54211,"_5":14782,"_28250":54148,"_3059":54203},[],{"_3603":1115,"_31069":1092,"_21510":54213,"_5":14782,"_28250":54148,"_3059":54214},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3603":1116,"_31069":1092,"_21510":54216,"_5":14782,"_28250":54148,"_3059":54217},[],"`/serverkeygen`",{"_3603":1117,"_31069":1092,"_21510":54219,"_5":14782,"_28250":54148,"_3059":54203},[],{"_3603":1118,"_31069":1092,"_21510":54221,"_5":14782,"_28250":54148,"_3059":54222},[],"Initial authentication and admission; server generation enabled.",{"_3603":1119,"_31069":1092,"_21510":54224,"_5":14782,"_28250":54148,"_3059":54225},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3603":1120,"_31069":1092,"_21510":54227,"_5":14782,"_28250":54152,"_3059":54228},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3603":1121,"_31069":1092,"_21510":54230,"_5":14782,"_28250":54152,"_3059":54231},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3603":1122,"_31069":1092,"_21510":54233,"_5":14782,"_28250":54155,"_3059":54234},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3603":1123,"_31069":1092,"_21510":54236,"_5":14782,"_28250":54155,"_3059":54237},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3603":1124,"_31069":1092,"_21510":54239,"_5":14782,"_28250":54158,"_3059":54240},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3603":1125,"_31069":1092,"_21510":54242,"_5":14782,"_28250":54158,"_3059":54243},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3603":1126,"_31069":1092,"_21510":54245,"_5":14782,"_28250":54161,"_3059":54246},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3603":1127,"_31069":1092,"_21510":54248,"_5":14782,"_28250":54161,"_3059":54249},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3603":1128,"_31069":1092,"_21510":54251,"_5":14782,"_28250":54164,"_3059":54252},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3603":1129,"_31069":1092,"_21510":54254,"_5":14782,"_28250":54164,"_3059":54255},[],"Part",{"_3603":1130,"_31069":1092,"_21510":54257,"_5":14782,"_28250":54164,"_3059":54258},[],"Content after decoding its Base64",{"_3603":1131,"_31069":1092,"_21510":54260,"_5":14782,"_28250":54164,"_3059":54261},[],"`application/pkcs8`",{"_3603":1132,"_31069":1092,"_21510":54263,"_5":14782,"_28250":54164,"_3059":54264},[],"Unencrypted DER PKCS#8 private key.",{"_3603":1133,"_31069":1092,"_21510":54266,"_5":14782,"_28250":54164,"_3059":54267},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3603":1134,"_31069":1092,"_21510":54269,"_5":14782,"_28250":54164,"_3059":54270},[],"DER PKCS#7 containing the issued certificate.",{"_3603":1135,"_31069":1092,"_21510":54272,"_5":14782,"_28250":54164,"_3059":54273},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3603":1136,"_31069":1092,"_21510":54275,"_5":14782,"_28250":54168,"_3059":54276},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3603":1137,"_31069":1092,"_21510":54278,"_5":14782,"_28250":54168,"_3059":54279},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3603":1138,"_31069":1092,"_21510":54281,"_5":14782,"_28250":54168,"_3059":54282},[],"Convert and check the result:",{"_3603":1139,"_31069":1092,"_21510":54284,"_5":14782,"_28250":54168,"_3059":54285},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3603":1140,"_31069":1092,"_21510":54287,"_5":14782,"_28250":54172,"_3059":54288},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3603":1141,"_31069":1092,"_21510":54290,"_5":14782,"_28250":54172,"_3059":54291},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3603":1142,"_31069":1142,"_5":15147,"_3059":53610,"_31428":54293,"_21510":54294,"_28250":1142},[50742,52254,53426,53424,53610],[],{"_3603":1143,"_31069":1142,"_21510":54296,"_5":14782,"_28250":1142,"_3059":54297},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3603":1144,"_31069":1142,"_5":31425,"_21510":54299,"_28250":54300,"_3059":54301},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3603":1145,"_31069":1142,"_5":31425,"_21510":54303,"_28250":54304,"_3059":54305},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3603":1146,"_31069":1142,"_5":31425,"_21510":54307,"_28250":54308,"_3059":54309},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3603":1147,"_31069":1142,"_5":31425,"_21510":54311,"_28250":54312,"_3059":54313},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3603":1148,"_31069":1142,"_21510":54315,"_5":14782,"_28250":1142,"_3059":54316},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3603":1149,"_31069":1142,"_21510":54318,"_5":14782,"_28250":54300,"_3059":54319},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3603":1150,"_31069":1142,"_21510":54321,"_5":14782,"_28250":54300,"_3059":54322},[],"The integrator installs initial EST server trust and an admission credential.",{"_3603":1151,"_31069":1142,"_21510":54324,"_5":14782,"_28250":54300,"_3059":54325},[],"The client requests an identity for its `Device ID` through EST.",{"_3603":1152,"_31069":1142,"_21510":54327,"_5":14782,"_28250":54300,"_3059":54328},[],"Certificate, device binding and key/certificate installation are checked.",{"_3603":1153,"_31069":1142,"_21510":54330,"_5":14782,"_28250":54300,"_3059":54331},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3603":1154,"_31069":1142,"_21510":54333,"_5":14782,"_28250":54300,"_3059":54334},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3603":1155,"_31069":1142,"_21510":54336,"_5":14782,"_28250":54304,"_3059":54337},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3603":1156,"_31069":1142,"_21510":54339,"_5":14782,"_28250":54304,"_3059":54340},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3603":1157,"_31069":1142,"_21510":54342,"_5":14782,"_28250":54304,"_3059":54343},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3603":1158,"_31069":1142,"_21510":54345,"_5":14782,"_28250":54304,"_3059":54346},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3603":1159,"_31069":1142,"_21510":54348,"_5":14782,"_28250":54308,"_3059":54349},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3603":1160,"_31069":1142,"_21510":54351,"_5":14782,"_28250":54308,"_3059":54352},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3603":1161,"_31069":1142,"_21510":54354,"_5":14782,"_28250":54308,"_3059":54355},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3603":1162,"_31069":1142,"_21510":54357,"_5":14782,"_28250":54308,"_3059":54358},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3603":1163,"_31069":1142,"_21510":54360,"_5":14782,"_28250":54312,"_3059":54361},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3603":1164,"_31069":1142,"_21510":54363,"_5":14782,"_28250":54312,"_3059":54364},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3603":1165,"_31069":1165,"_5":15147,"_3059":54366,"_31428":54367,"_21510":54368,"_28250":1165},"Provisioning strategies",[50742,52254,53426,53424,53610],[],{"_3603":1166,"_31069":1165,"_21510":54370,"_5":14782,"_28250":1165,"_3059":54371},[],"Choose device registration, identity authorization and key generation.",{"_3603":1167,"_31069":1165,"_5":31425,"_21510":54373,"_28250":54374,"_3059":54375},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3603":1168,"_31069":1165,"_5":31425,"_21510":54377,"_28250":54378,"_3059":54379},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3603":1169,"_31069":1165,"_5":31425,"_21510":54381,"_28250":54382,"_3059":54383},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3603":1170,"_31069":1165,"_5":31425,"_21510":54385,"_28250":54386,"_3059":54387},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3603":1171,"_31069":1165,"_5":31425,"_21510":54389,"_28250":54390,"_3059":54391},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3603":1172,"_31069":1165,"_21510":54393,"_5":14782,"_28250":1165,"_3059":54394},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3603":1173,"_31069":1165,"_21510":54396,"_5":14782,"_28250":54374,"_3059":54397},[],"Path",{"_3603":1174,"_31069":1165,"_21510":54399,"_5":14782,"_28250":54374,"_3059":54400},[],"When the device exists",{"_3603":1175,"_31069":1165,"_21510":54402,"_5":14782,"_28250":54374,"_3059":54403},[],"What to check",{"_3603":1176,"_31069":1165,"_21510":54405,"_5":14782,"_28250":54374,"_3059":54406},[],"Manual assignment",{"_3603":1177,"_31069":1165,"_21510":54408,"_5":14782,"_28250":54374,"_3059":54409},[],"An operator creates it before associating a certificate.",{"_3603":1178,"_31069":1165,"_21510":54411,"_5":14782,"_28250":54374,"_3059":54412},[],"ID, owning DMS, certificate CN and bound serial.",{"_3603":1179,"_31069":1165,"_21510":54414,"_5":14782,"_28250":54374,"_3059":54415},[],"EST with `JITP`",{"_3603":1180,"_31069":1165,"_21510":54417,"_5":14782,"_28250":54374,"_3059":54418},[],"Created for an unknown CN during `/simpleenroll`.",{"_3603":1181,"_31069":1165,"_21510":54420,"_5":14782,"_28250":54374,"_3059":54421},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3603":1182,"_31069":1165,"_21510":54423,"_5":14782,"_28250":54374,"_3059":54424},[],"EST with `PRE_REGISTRATION`",{"_3603":1183,"_31069":1165,"_21510":54426,"_5":14782,"_28250":54374,"_3059":54427},[],"Must exist before `/simpleenroll`.",{"_3603":1184,"_31069":1165,"_21510":54429,"_5":14782,"_28250":54374,"_3059":54430},[],"Approved record, same DMS and replacement conditions for your version.",{"_3603":1185,"_31069":1165,"_21510":54432,"_5":14782,"_28250":54374,"_3059":54433},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3603":1186,"_31069":1165,"_21510":54435,"_5":14782,"_28250":54374,"_3059":54436},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3603":1187,"_31069":1165,"_21510":54438,"_5":14782,"_28250":54378,"_3059":54439},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3603":1188,"_31069":1165,"_21510":54441,"_5":14782,"_28250":54378,"_3059":54442},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3603":1189,"_31069":1165,"_21510":54444,"_5":14782,"_28250":54378,"_3059":54445},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3603":1190,"_31069":1165,"_21510":54447,"_5":14782,"_28250":54382,"_3059":54448},[],"Decide initial enrollment and re-enrollment separately:",{"_3603":1191,"_31069":1165,"_21510":54450,"_5":14782,"_28250":54382,"_3059":54451},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3603":1192,"_31069":1165,"_21510":54453,"_5":14782,"_28250":54382,"_3059":54454},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3603":1193,"_31069":1165,"_21510":54456,"_5":14782,"_28250":54382,"_3059":54457},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3603":1194,"_31069":1165,"_21510":54459,"_5":14782,"_28250":54382,"_3059":54460},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3603":1195,"_31069":1165,"_21510":54462,"_5":14782,"_28250":54382,"_3059":54463},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3603":1196,"_31069":1165,"_21510":54465,"_5":14782,"_28250":54386,"_3059":51126},[],{"_3603":1197,"_31069":1165,"_21510":54467,"_5":14782,"_28250":54386,"_3059":54468},[],"Material crossing EST",{"_3603":1198,"_31069":1165,"_21510":54470,"_5":14782,"_28250":54386,"_3059":54471},[],"Device-generated key",{"_3603":1199,"_31069":1165,"_21510":54473,"_5":14782,"_28250":54386,"_3059":54474},[],"Public CSR and certificate; the key stays on the client.",{"_3603":1200,"_31069":1165,"_21510":54476,"_5":14782,"_28250":54386,"_3059":54477},[],"Existing device key",{"_3603":1201,"_31069":1165,"_21510":54479,"_5":14782,"_28250":54386,"_3059":54480},[],"CSR signed with that key and a new certificate.",{"_3603":1202,"_31069":1165,"_21510":54482,"_5":14782,"_28250":54386,"_3059":53748},[],{"_3603":1203,"_31069":1165,"_21510":54484,"_5":14782,"_28250":54386,"_3059":54485},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3603":1204,"_31069":1165,"_21510":54487,"_5":14782,"_28250":54386,"_3059":54488},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3603":1205,"_31069":1165,"_21510":54490,"_5":14782,"_28250":54390,"_3059":54491},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3603":1206,"_31069":1206,"_5":15147,"_3059":54493,"_31428":54494,"_21510":54495,"_28250":1206},"Renewal and recovery",[50742,52254,53426,53424,53610],[],{"_3603":1207,"_31069":1206,"_21510":54497,"_5":14782,"_28250":1206,"_3059":54498},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3603":1208,"_31069":1206,"_5":31425,"_21510":54500,"_28250":54501,"_3059":54502},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3603":1209,"_31069":1206,"_5":31425,"_21510":54504,"_28250":54505,"_3059":54506},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3603":1210,"_31069":1206,"_5":31425,"_21510":54508,"_28250":54509,"_3059":54510},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3603":1211,"_31069":1206,"_5":31425,"_21510":54512,"_28250":54513,"_3059":54514},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3603":1212,"_31069":1206,"_5":31425,"_21510":54516,"_28250":54517,"_3059":54518},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3603":1213,"_31069":1206,"_21510":54520,"_5":14782,"_28250":1206,"_3059":54521},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3603":1214,"_31069":1206,"_21510":54523,"_5":14782,"_28250":54501,"_3059":54524},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3603":1215,"_31069":1206,"_21510":54526,"_5":14782,"_28250":54501,"_3059":54527},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3603":1216,"_31069":1206,"_21510":54529,"_5":14782,"_28250":54501,"_3059":54530},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3603":1217,"_31069":1206,"_21510":54532,"_5":14782,"_28250":54501,"_3059":54533},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3603":1218,"_31069":1206,"_21510":54535,"_5":14782,"_28250":54505,"_3059":54536},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3603":1219,"_31069":1206,"_21510":54538,"_5":14782,"_28250":54505,"_3059":54539},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3603":1220,"_31069":1206,"_21510":54541,"_5":14782,"_28250":54509,"_3059":54542},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3603":1221,"_31069":1206,"_21510":54544,"_5":14782,"_28250":54509,"_3059":54545},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3603":1222,"_31069":1206,"_21510":54547,"_5":14782,"_28250":54509,"_3059":54548},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3603":1223,"_31069":1206,"_21510":54550,"_5":14782,"_28250":54513,"_3059":54551},[],"Situation",{"_3603":1224,"_31069":1206,"_21510":54553,"_5":14782,"_28250":54513,"_3059":54554},[],"Procedure",{"_3603":1225,"_31069":1206,"_21510":54556,"_5":14782,"_28250":54513,"_3059":54557},[],"Valid certificate, outside the window",{"_3603":1226,"_31069":1206,"_21510":54559,"_5":14782,"_28250":54513,"_3059":54560},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3603":1227,"_31069":1206,"_21510":54562,"_5":14782,"_28250":54513,"_3059":54563},[],"Expired certificate, key available",{"_3603":1228,"_31069":1206,"_21510":54565,"_5":14782,"_28250":54513,"_3059":54566},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3603":1229,"_31069":1206,"_21510":54568,"_5":14782,"_28250":54513,"_3059":54569},[],"Renewal through webhook or `NO_AUTH`",{"_3603":1230,"_31069":1206,"_21510":54571,"_5":14782,"_28250":54513,"_3059":54572},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3603":1231,"_31069":1206,"_21510":54574,"_5":14782,"_28250":54513,"_3059":54575},[],"Lost or inaccessible key",{"_3603":1232,"_31069":1206,"_21510":54577,"_5":14782,"_28250":54513,"_3059":54578},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3603":1233,"_31069":1206,"_21510":54580,"_5":14782,"_28250":54513,"_3059":54581},[],"Current identity revoked",{"_3603":1234,"_31069":1206,"_21510":54583,"_5":14782,"_28250":54513,"_3059":54584},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3603":1235,"_31069":1206,"_21510":54586,"_5":14782,"_28250":54513,"_3059":54587},[],"Device without an identity",{"_3603":1236,"_31069":1206,"_21510":54589,"_5":14782,"_28250":54513,"_3059":54590},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3603":1237,"_31069":1206,"_21510":54592,"_5":14782,"_28250":54513,"_3059":54593},[],"Retired device",{"_3603":1238,"_31069":1206,"_21510":54595,"_5":14782,"_28250":54513,"_3059":54596},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3603":1239,"_31069":1206,"_21510":54598,"_5":14782,"_28250":54513,"_3059":54599},[],"Timeout, HTTP 500 or installation failure",{"_3603":1240,"_31069":1206,"_21510":54601,"_5":14782,"_28250":54513,"_3059":54602},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3603":1241,"_31069":1206,"_21510":54604,"_5":14782,"_28250":54517,"_3059":54605},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3603":1242,"_31069":1206,"_21510":54607,"_5":14782,"_28250":54517,"_3059":54608},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3603":1243,"_31069":1243,"_5":15147,"_3059":54610,"_31428":54611,"_21510":54612,"_28250":1243},"Enrollment troubleshooting",[50742,52254,53426,53424,53610],[],{"_3603":1244,"_31069":1243,"_21510":54614,"_5":14782,"_28250":1243,"_3059":54615},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3603":1245,"_31069":1243,"_5":31425,"_21510":54617,"_28250":54618,"_3059":54619},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3603":1246,"_31069":1243,"_5":31425,"_21510":54621,"_28250":54622,"_3059":54623},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3603":1247,"_31069":1243,"_5":31425,"_21510":54625,"_28250":54626,"_3059":54173},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3603":1248,"_31069":1243,"_5":31425,"_21510":54628,"_28250":54629,"_3059":54630},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3603":1249,"_31069":1243,"_21510":54632,"_5":14782,"_28250":1243,"_3059":54633},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3603":1250,"_31069":1243,"_21510":54635,"_5":14782,"_28250":54622,"_3059":54636},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3603":1251,"_31069":1243,"_21510":54638,"_5":14782,"_28250":54622,"_3059":54639},[],"Symptom or message",{"_3603":1252,"_31069":1243,"_21510":54641,"_5":14782,"_28250":54622,"_3059":54403},[],{"_3603":1253,"_31069":1243,"_21510":54643,"_5":14782,"_28250":54622,"_3059":54644},[],"curl rejects TLS, name or issuer",{"_3603":1254,"_31069":1243,"_21510":54646,"_5":14782,"_28250":54622,"_3059":54647},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3603":1255,"_31069":1243,"_21510":54649,"_5":14782,"_28250":54622,"_3059":54650},[],"404 or missing APS",{"_3603":1256,"_31069":1243,"_21510":54652,"_5":14782,"_28250":54622,"_3059":54653},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3603":1257,"_31069":1243,"_21510":54655,"_5":14782,"_28250":54622,"_3059":54656},[],"400, CSR or format error",{"_3603":1258,"_31069":1243,"_21510":54658,"_5":14782,"_28250":54622,"_3059":54659},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3603":1259,"_31069":1243,"_21510":54661,"_5":14782,"_28250":54622,"_3059":54662},[],"Missing credential or invalid certificate",{"_3603":1260,"_31069":1243,"_21510":54664,"_5":14782,"_28250":54622,"_3059":54665},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3603":1261,"_31069":1243,"_21510":54667,"_5":14782,"_28250":54622,"_3059":54668},[],"Webhook denies, times out or responds without authorization",{"_3603":1262,"_31069":1243,"_21510":54670,"_5":14782,"_28250":54622,"_3059":54671},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3603":1263,"_31069":1243,"_21510":54673,"_5":14782,"_28250":54622,"_3059":54674},[],"`unexpected status code: <n>: redirects are not followed`",{"_3603":1264,"_31069":1243,"_21510":54676,"_5":14782,"_28250":54622,"_3059":54677},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3603":1265,"_31069":1243,"_21510":54679,"_5":14782,"_28250":54622,"_3059":54680},[],"`webhook response exceeds 1048576 bytes`",{"_3603":1266,"_31069":1243,"_21510":54682,"_5":14782,"_28250":54622,"_3059":54683},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3603":1267,"_31069":1243,"_21510":54685,"_5":14782,"_28250":54622,"_3059":54686},[],"`webhook config must not reference files`",{"_3603":1268,"_31069":1243,"_21510":54688,"_5":14782,"_28250":54622,"_3059":54689},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3603":1269,"_31069":1243,"_21510":54691,"_5":14782,"_28250":54622,"_3059":54692},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3603":1270,"_31069":1243,"_21510":54694,"_5":14782,"_28250":54622,"_3059":54695},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3603":1271,"_31069":1243,"_21510":54697,"_5":14782,"_28250":54622,"_3059":54698},[],"`webhook mTLS certificate and key are invalid: …`",{"_3603":1272,"_31069":1243,"_21510":54700,"_5":14782,"_28250":54622,"_3059":54701},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3603":1273,"_31069":1243,"_21510":54703,"_5":14782,"_28250":54622,"_3059":54704},[],"400 `struct validation error` creating or updating a DMS",{"_3603":1274,"_31069":1243,"_21510":54706,"_5":14782,"_28250":54622,"_3059":54707},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3603":1275,"_31069":1243,"_21510":54709,"_5":14782,"_28250":54622,"_3059":54710},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3603":1276,"_31069":1243,"_21510":54712,"_5":14782,"_28250":54622,"_3059":54713},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3603":1277,"_31069":1243,"_21510":54715,"_5":14782,"_28250":54622,"_3059":54716},[],"`device not preregistered`",{"_3603":1278,"_31069":1243,"_21510":54718,"_5":14782,"_28250":54622,"_3059":54719},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3603":1279,"_31069":1243,"_21510":54721,"_5":14782,"_28250":54622,"_3059":54722},[],"`forbiddenNewEnrollment`",{"_3603":1280,"_31069":1243,"_21510":54724,"_5":14782,"_28250":54622,"_3059":54725},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3603":1281,"_31069":1243,"_21510":54727,"_5":14782,"_28250":54622,"_3059":54728},[],"Different owning DMS",{"_3603":1282,"_31069":1243,"_21510":54730,"_5":14782,"_28250":54622,"_3059":54731},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3603":1283,"_31069":1243,"_21510":54733,"_5":14782,"_28250":54622,"_3059":54734},[],"`invalid RawSubject bytes`",{"_3603":1284,"_31069":1243,"_21510":54736,"_5":14782,"_28250":54622,"_3059":54737},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3603":1285,"_31069":1243,"_21510":54739,"_5":14782,"_28250":54622,"_3059":54740},[],"`invalid reenroll window`",{"_3603":1286,"_31069":1243,"_21510":54742,"_5":14782,"_28250":54622,"_3059":54743},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3603":1287,"_31069":1243,"_21510":54745,"_5":14782,"_28250":54622,"_3059":54746},[],"Current certificate revoked",{"_3603":1288,"_31069":1243,"_21510":54748,"_5":14782,"_28250":54622,"_3059":54749},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3603":1289,"_31069":1243,"_21510":54751,"_5":14782,"_28250":54622,"_3059":54752},[],"CA, profile or signing error",{"_3603":1290,"_31069":1243,"_21510":54754,"_5":14782,"_28250":54622,"_3059":54755},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3603":1291,"_31069":1243,"_21510":54757,"_5":14782,"_28250":54622,"_3059":54758},[],"HTTP 200 without a device connection",{"_3603":1292,"_31069":1243,"_21510":54760,"_5":14782,"_28250":54622,"_3059":54761},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3603":1293,"_31069":1243,"_21510":54763,"_5":14782,"_28250":54622,"_3059":54764},[],"Timeout or error after issuance",{"_3603":1294,"_31069":1243,"_21510":54766,"_5":14782,"_28250":54622,"_3059":54767},[],"New certificates, current slot and previous identity's state before retrying.",{"_3603":1295,"_31069":1243,"_21510":54769,"_5":14782,"_28250":54626,"_3059":54770},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3603":1296,"_31069":1243,"_21510":54772,"_5":14782,"_28250":54626,"_3059":54773},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3603":1297,"_31069":1243,"_21510":54775,"_5":14782,"_28250":54629,"_3059":54776},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3603":1298,"_31069":1243,"_21510":54778,"_5":14782,"_28250":54629,"_3059":54779},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3603":1299,"_31069":1243,"_21510":54781,"_5":14782,"_28250":54629,"_3059":54782},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3603":1300,"_31069":1243,"_21510":54784,"_5":14782,"_28250":54629,"_3059":54785},[],"Make one request, save headers/body and query the device and certificates.",{"_3603":1301,"_31069":1243,"_21510":54787,"_5":14782,"_28250":54629,"_3059":54788},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3603":1302,"_31069":1243,"_21510":54790,"_5":14782,"_28250":54629,"_3059":54791},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3603":1303,"_31069":1243,"_21510":54793,"_5":14782,"_28250":54629,"_3059":54794},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3603":1304,"_31069":1304,"_5":15147,"_3059":54796,"_31428":54797,"_21510":54798,"_28250":1304},"Trust distribution and updates",[50742,52254,53426,53424,53610],[],{"_3603":1305,"_31069":1304,"_21510":54800,"_5":14782,"_28250":1304,"_3059":54801},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3603":1306,"_31069":1304,"_5":31425,"_21510":54803,"_28250":54804,"_3059":54805},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3603":1307,"_31069":1304,"_5":31425,"_21510":54807,"_28250":54808,"_3059":54809},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3603":1308,"_31069":1304,"_5":31425,"_21510":54811,"_28250":54812,"_3059":54813},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3603":1309,"_31069":1304,"_5":31425,"_21510":54815,"_28250":54816,"_3059":54817},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3603":1310,"_31069":1304,"_5":31425,"_21510":54819,"_28250":54820,"_3059":54821},[],"/docs/pr-preview/pr-74/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3603":1311,"_31069":1304,"_21510":54823,"_5":14782,"_28250":1304,"_3059":54824},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3603":1312,"_31069":1304,"_21510":54826,"_5":14782,"_28250":54804,"_3059":54827},[],"Relationship",{"_3603":1313,"_31069":1304,"_21510":54829,"_5":14782,"_28250":54804,"_3059":54830},[],"Material prepared by its owner",{"_3603":1314,"_31069":1304,"_21510":54832,"_5":14782,"_28250":54804,"_3059":54833},[],"Device → EST server",{"_3603":1315,"_31069":1304,"_21510":54835,"_5":14782,"_28250":54804,"_3059":54836},[],"Previously verified server root, chain or pin and TLS name.",{"_3603":1316,"_31069":1304,"_21510":54838,"_5":14782,"_28250":54804,"_3059":54839},[],"DMS → requester",{"_3603":1317,"_31069":1304,"_21510":54841,"_5":14782,"_28250":54804,"_3059":54842},[],"CAs and rules authorizing initial or renewal credentials.",{"_3603":1318,"_31069":1304,"_21510":54844,"_5":14782,"_28250":54804,"_3059":54845},[],"Consumer → device",{"_3603":1319,"_31069":1304,"_21510":54847,"_5":14782,"_28250":54804,"_3059":54848},[],"Operational identity roots, intermediates, validation and permissions.",{"_3603":1320,"_31069":1304,"_21510":54850,"_5":14782,"_28250":54804,"_3059":54851},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3603":1321,"_31069":1304,"_21510":54853,"_5":14782,"_28250":54808,"_3059":54854},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3603":1322,"_31069":1304,"_21510":54856,"_5":14782,"_28250":54808,"_3059":54857},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3603":1323,"_31069":1304,"_21510":54859,"_5":14782,"_28250":54812,"_3059":54860},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3603":1324,"_31069":1304,"_21510":54862,"_5":14782,"_28250":54812,"_3059":54863},[],"Select policy-approved roots as anchors.",{"_3603":1325,"_31069":1304,"_21510":54865,"_5":14782,"_28250":54812,"_3059":54866},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3603":1326,"_31069":1304,"_21510":54868,"_5":14782,"_28250":54812,"_3059":54869},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3603":1327,"_31069":1304,"_21510":54871,"_5":14782,"_28250":54812,"_3059":54872},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3603":1328,"_31069":1304,"_21510":54874,"_5":14782,"_28250":54812,"_3059":54875},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3603":1329,"_31069":1304,"_21510":54877,"_5":14782,"_28250":54816,"_3059":54878},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3603":1330,"_31069":1304,"_21510":54880,"_5":14782,"_28250":54816,"_3059":54881},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3603":1331,"_31069":1304,"_21510":54883,"_5":14782,"_28250":54816,"_3059":54884},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3603":1332,"_31069":1304,"_21510":54886,"_5":14782,"_28250":54820,"_3059":54887},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3603":1333,"_31069":1333,"_5":15147,"_3059":54889,"_31428":54890,"_21510":54892,"_28250":1333},"AWS IoT Core",[50742,52254,53426,53424,54891],"Integrations",[],{"_3603":1334,"_31069":1333,"_21510":54894,"_5":14782,"_28250":1333,"_3059":54895},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3603":1335,"_31069":1333,"_5":31425,"_21510":54897,"_28250":54898,"_3059":54899},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3603":1336,"_31069":1333,"_5":31425,"_21510":54901,"_28250":54902,"_3059":54903},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3603":1337,"_31069":1333,"_5":31425,"_21510":54905,"_28250":54906,"_3059":54907},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3603":1338,"_31069":1333,"_5":31425,"_21510":54909,"_28250":54910,"_3059":54911},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3603":1339,"_31069":1333,"_5":31425,"_21510":54913,"_28250":54914,"_3059":54915},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3603":1340,"_31069":1333,"_5":31425,"_21510":54917,"_28250":54918,"_3059":54919},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3603":1341,"_31069":1333,"_5":31425,"_21510":54921,"_28250":54922,"_3059":54923},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3603":1342,"_31069":1333,"_5":31425,"_21510":54925,"_28250":54926,"_3059":54927},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3603":1343,"_31069":1333,"_5":31425,"_21510":54929,"_28250":54930,"_3059":54931},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3603":1344,"_31069":1333,"_5":31425,"_21510":54933,"_28250":54934,"_3059":54935},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3603":1345,"_31069":1333,"_5":31425,"_21510":54937,"_28250":54938,"_3059":54939},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3603":1346,"_31069":1333,"_5":31425,"_21510":54941,"_28250":54942,"_3059":54943},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3603":1347,"_31069":1333,"_5":31425,"_21510":54945,"_28250":54946,"_3059":54947},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3603":1348,"_31069":1333,"_5":31425,"_21510":54949,"_28250":54950,"_3059":54951},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3603":1349,"_31069":1333,"_5":31425,"_21510":54953,"_28250":54954,"_3059":54955},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3603":1350,"_31069":1333,"_5":31425,"_21510":54957,"_28250":54958,"_3059":54959},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3603":1351,"_31069":1333,"_5":31425,"_21510":54961,"_28250":54962,"_3059":54963},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3603":1352,"_31069":1333,"_5":31425,"_21510":54965,"_28250":54966,"_3059":54967},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3603":1353,"_31069":1333,"_5":31425,"_21510":54969,"_28250":54970,"_3059":54971},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3603":1354,"_31069":1333,"_5":31425,"_21510":54973,"_28250":54974,"_3059":54975},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3603":1355,"_31069":1333,"_5":31425,"_21510":54977,"_28250":54978,"_3059":54979},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3603":1356,"_31069":1333,"_5":31425,"_21510":54981,"_28250":54982,"_3059":54983},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3603":1357,"_31069":1333,"_5":31425,"_21510":54985,"_28250":54986,"_3059":54987},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3603":1358,"_31069":1333,"_5":31425,"_21510":54989,"_28250":54990,"_3059":54991},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3603":1359,"_31069":1333,"_5":31425,"_21510":54993,"_28250":54994,"_3059":54995},[],"/docs/pr-preview/pr-74/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3603":1360,"_31069":1333,"_21510":54997,"_5":14782,"_28250":1333,"_3059":54998},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3603":1361,"_31069":1333,"_21510":55000,"_5":14782,"_28250":1333,"_3059":55001},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3603":1362,"_31069":1333,"_21510":55003,"_5":14782,"_28250":1333,"_3059":55004},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3603":1363,"_31069":1333,"_21510":55006,"_5":14782,"_28250":54898,"_3059":55007},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3603":1364,"_31069":1333,"_21510":55009,"_5":14782,"_28250":54898,"_3059":55010},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3603":1365,"_31069":1333,"_21510":55012,"_5":14782,"_28250":54898,"_3059":55013},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3603":1366,"_31069":1333,"_21510":55015,"_5":14782,"_28250":54898,"_3059":55016},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3603":1367,"_31069":1333,"_21510":55018,"_5":14782,"_28250":54902,"_3059":55019},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3603":1368,"_31069":1333,"_21510":55021,"_5":14782,"_28250":54906,"_3059":55022},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3603":1369,"_31069":1333,"_21510":55024,"_5":14782,"_28250":54906,"_3059":55025},[],"IAM action",{"_3603":1370,"_31069":1333,"_21510":55027,"_5":14782,"_28250":54906,"_3059":51132},[],{"_3603":1371,"_31069":1333,"_21510":55029,"_5":14782,"_28250":54906,"_3059":55030},[],"`iot:GetRegistrationCode`",{"_3603":1372,"_31069":1333,"_21510":55032,"_5":14782,"_28250":54906,"_3059":55033},[],"Obtain the verification code for CA registration in the Primary Account",{"_3603":1373,"_31069":1333,"_21510":55035,"_5":14782,"_28250":54906,"_3059":55036},[],"`iot:RegisterCACertificate`",{"_3603":1374,"_31069":1333,"_21510":55038,"_5":14782,"_28250":54906,"_3059":55039},[],"Register the CA in AWS IoT",{"_3603":1375,"_31069":1333,"_21510":55041,"_5":14782,"_28250":54906,"_3059":55042},[],"`iot:DescribeCACertificate`",{"_3603":1376,"_31069":1333,"_21510":55044,"_5":14782,"_28250":54906,"_3059":55045},[],"Check the CA registration status",{"_3603":1377,"_31069":1333,"_21510":55047,"_5":14782,"_28250":54906,"_3059":55048},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3603":1378,"_31069":1333,"_21510":55050,"_5":14782,"_28250":54906,"_3059":55051},[],"Create or update Things in IoT Core",{"_3603":1379,"_31069":1333,"_21510":55053,"_5":14782,"_28250":54906,"_3059":55054},[],"`iot:RegisterThing`",{"_3603":1380,"_31069":1333,"_21510":55056,"_5":14782,"_28250":54906,"_3059":55057},[],"Provision Things through a template",{"_3603":1381,"_31069":1333,"_21510":55059,"_5":14782,"_28250":54906,"_3059":55060},[],"`iot:RegisterCertificate`",{"_3603":1382,"_31069":1333,"_21510":55062,"_5":14782,"_28250":54906,"_3059":55063},[],"Register device certificates",{"_3603":1383,"_31069":1333,"_21510":55065,"_5":14782,"_28250":54906,"_3059":55066},[],"`iot:UpdateCertificate`",{"_3603":1384,"_31069":1333,"_21510":55068,"_5":14782,"_28250":54906,"_3059":55069},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3603":1385,"_31069":1333,"_21510":55071,"_5":14782,"_28250":54906,"_3059":55072},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3603":1386,"_31069":1333,"_21510":55074,"_5":14782,"_28250":54906,"_3059":55075},[],"Create and attach IoT policies",{"_3603":1387,"_31069":1333,"_21510":55077,"_5":14782,"_28250":54906,"_3059":55078},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3603":1388,"_31069":1333,"_21510":55080,"_5":14782,"_28250":54906,"_3059":55081},[],"Manage Thing groups",{"_3603":1389,"_31069":1333,"_21510":55083,"_5":14782,"_28250":54906,"_3059":55084},[],"`iot:CreateProvisioningTemplate`",{"_3603":1390,"_31069":1333,"_21510":55086,"_5":14782,"_28250":54906,"_3059":55087},[],"Create JITP templates",{"_3603":1391,"_31069":1333,"_21510":55089,"_5":14782,"_28250":54906,"_3059":55090},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3603":1392,"_31069":1333,"_21510":55092,"_5":14782,"_28250":54906,"_3059":55093},[],"Read and write the Device Shadow",{"_3603":1393,"_31069":1333,"_21510":55095,"_5":14782,"_28250":54906,"_3059":55096},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3603":1394,"_31069":1333,"_21510":55098,"_5":14782,"_28250":54910,"_3059":55099},[],"Parameter",{"_3603":1395,"_31069":1333,"_21510":55101,"_5":14782,"_28250":54910,"_3059":55102},[],"Type",{"_3603":1396,"_31069":1333,"_21510":55104,"_5":14782,"_28250":54910,"_3059":55105},[],"Required",{"_3603":1397,"_31069":1333,"_21510":55107,"_5":14782,"_28250":54910,"_3059":55108},[],"Description",{"_3603":1398,"_31069":1333,"_21510":55110,"_5":14782,"_28250":54910,"_3059":55111},[],"`connector_id`",{"_3603":1399,"_31069":1333,"_21510":55113,"_5":14782,"_28250":54910,"_3059":25685},[],{"_3603":1400,"_31069":1333,"_21510":55115,"_5":14782,"_28250":54910,"_3059":55116},[],"Yes",{"_3603":1401,"_31069":1333,"_21510":55118,"_5":14782,"_28250":54910,"_3059":55119},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3603":1402,"_31069":1333,"_21510":55121,"_5":14782,"_28250":54910,"_3059":55122},[],"`aws_config.region`",{"_3603":1403,"_31069":1333,"_21510":55124,"_5":14782,"_28250":54910,"_3059":25685},[],{"_3603":1404,"_31069":1333,"_21510":55126,"_5":14782,"_28250":54910,"_3059":55116},[],{"_3603":1405,"_31069":1333,"_21510":55128,"_5":14782,"_28250":54910,"_3059":55129},[],"AWS region where the connector operates.",{"_3603":1406,"_31069":1333,"_21510":55131,"_5":14782,"_28250":54910,"_3059":55132},[],"`aws_config.auth_method`",{"_3603":1407,"_31069":1333,"_21510":55134,"_5":14782,"_28250":54910,"_3059":25685},[],{"_3603":1408,"_31069":1333,"_21510":55136,"_5":14782,"_28250":54910,"_3059":55116},[],{"_3603":1409,"_31069":1333,"_21510":55138,"_5":14782,"_28250":54910,"_3059":55139},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3603":1410,"_31069":1333,"_21510":55141,"_5":14782,"_28250":54910,"_3059":55142},[],"`aws_config.access_key_id`",{"_3603":1411,"_31069":1333,"_21510":55144,"_5":14782,"_28250":54910,"_3059":25685},[],{"_3603":1412,"_31069":1333,"_21510":55146,"_5":14782,"_28250":54910,"_3059":55147},[],"Only with `auth_method=static`",{"_3603":1413,"_31069":1333,"_21510":55149,"_5":14782,"_28250":54910,"_3059":55150},[],"AWS access key.",{"_3603":1414,"_31069":1333,"_21510":55152,"_5":14782,"_28250":54910,"_3059":55153},[],"`aws_config.secret_access_key`",{"_3603":1415,"_31069":1333,"_21510":55155,"_5":14782,"_28250":54910,"_3059":25685},[],{"_3603":1416,"_31069":1333,"_21510":55157,"_5":14782,"_28250":54910,"_3059":55147},[],{"_3603":1417,"_31069":1333,"_21510":55159,"_5":14782,"_28250":54910,"_3059":55160},[],"AWS secret key.",{"_3603":1418,"_31069":1333,"_21510":55162,"_5":14782,"_28250":54910,"_3059":55163},[],"`aws_config.session_token`",{"_3603":1419,"_31069":1333,"_21510":55165,"_5":14782,"_28250":54910,"_3059":25685},[],{"_3603":1420,"_31069":1333,"_21510":55167,"_5":14782,"_28250":54910,"_3059":55168},[],"No",{"_3603":1421,"_31069":1333,"_21510":55170,"_5":14782,"_28250":54910,"_3059":55171},[],"Session token (with `auth_method=static`).",{"_3603":1422,"_31069":1333,"_21510":55173,"_5":14782,"_28250":54910,"_3059":55174},[],"`aws_config.role_arn`",{"_3603":1423,"_31069":1333,"_21510":55176,"_5":14782,"_28250":54910,"_3059":25685},[],{"_3603":1424,"_31069":1333,"_21510":55178,"_5":14782,"_28250":54910,"_3059":55179},[],"Only with `auth_method=role`",{"_3603":1425,"_31069":1333,"_21510":55181,"_5":14782,"_28250":54910,"_3059":55182},[],"ARN of the role to assume.",{"_3603":1426,"_31069":1333,"_21510":55184,"_5":14782,"_28250":54910,"_3059":55185},[],"`aws_config.endpoint_url`",{"_3603":1427,"_31069":1333,"_21510":55187,"_5":14782,"_28250":54910,"_3059":25685},[],{"_3603":1428,"_31069":1333,"_21510":55189,"_5":14782,"_28250":54910,"_3059":55168},[],{"_3603":1429,"_31069":1333,"_21510":55191,"_5":14782,"_28250":54910,"_3059":55192},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3603":1430,"_31069":1333,"_21510":55194,"_5":14782,"_28250":54910,"_3059":55195},[],"`subscriber_event_bus`",{"_3603":1431,"_31069":1333,"_21510":55197,"_5":14782,"_28250":54910,"_3059":18111},[],{"_3603":1432,"_31069":1333,"_21510":55199,"_5":14782,"_28250":54910,"_3059":55116},[],{"_3603":1433,"_31069":1333,"_21510":55201,"_5":14782,"_28250":54910,"_3059":55202},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3603":1434,"_31069":1333,"_21510":55204,"_5":14782,"_28250":54910,"_3059":55205},[],"`dms_manager_client`",{"_3603":1435,"_31069":1333,"_21510":55207,"_5":14782,"_28250":54910,"_3059":25685},[],{"_3603":1436,"_31069":1333,"_21510":55209,"_5":14782,"_28250":54910,"_3059":55116},[],{"_3603":1437,"_31069":1333,"_21510":55211,"_5":14782,"_28250":54910,"_3059":55212},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3603":1438,"_31069":1333,"_21510":55214,"_5":14782,"_28250":54910,"_3059":55215},[],"`device_manager_client`",{"_3603":1439,"_31069":1333,"_21510":55217,"_5":14782,"_28250":54910,"_3059":25685},[],{"_3603":1440,"_31069":1333,"_21510":55219,"_5":14782,"_28250":54910,"_3059":55116},[],{"_3603":1441,"_31069":1333,"_21510":55221,"_5":14782,"_28250":54910,"_3059":55222},[],"HTTP URL of Lamassu's Device Manager.",{"_3603":1442,"_31069":1333,"_21510":55224,"_5":14782,"_28250":54910,"_3059":55225},[],"`ca_client`",{"_3603":1443,"_31069":1333,"_21510":55227,"_5":14782,"_28250":54910,"_3059":25685},[],{"_3603":1444,"_31069":1333,"_21510":55229,"_5":14782,"_28250":54910,"_3059":55116},[],{"_3603":1445,"_31069":1333,"_21510":55231,"_5":14782,"_28250":54910,"_3059":55232},[],"HTTP URL of Lamassu's CA service.",{"_3603":1446,"_31069":1333,"_21510":55234,"_5":14782,"_28250":54914,"_3059":55235},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3603":1447,"_31069":1333,"_21510":55237,"_5":14782,"_28250":54914,"_3059":55238},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3603":1448,"_31069":1333,"_21510":55240,"_5":14782,"_28250":54914,"_3059":55241},[],"CloudEvent type",{"_3603":1449,"_31069":1333,"_21510":55243,"_5":14782,"_28250":54914,"_3059":55244},[],"Lamassu resource",{"_3603":1450,"_31069":1333,"_21510":55246,"_5":14782,"_28250":54914,"_3059":55247},[],"AWS Resource",{"_3603":1451,"_31069":1333,"_21510":55249,"_5":14782,"_28250":54914,"_3059":55250},[],"IAM actions",{"_3603":1452,"_31069":1333,"_21510":55252,"_5":14782,"_28250":54914,"_3059":55253},[],"AWS calls and effect",{"_3603":1453,"_31069":1333,"_21510":55255,"_5":14782,"_28250":54914,"_3059":55256},[],"Where in this page",{"_3603":1454,"_31069":1333,"_21510":55258,"_5":14782,"_28250":54914,"_3059":55259},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3603":1455,"_31069":1333,"_21510":55261,"_5":14782,"_28250":54914,"_3059":55262},[],"CA",{"_3603":1456,"_31069":1333,"_21510":55264,"_5":14782,"_28250":54914,"_3059":55265},[],"`IoTCore/CACertificate`",{"_3603":1457,"_31069":1333,"_21510":55267,"_5":14782,"_28250":54914,"_3059":55268},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3603":1458,"_31069":1333,"_21510":55270,"_5":14782,"_28250":54914,"_3059":55271},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3603":1459,"_31069":1333,"_21510":55273,"_5":14782,"_28250":54914,"_3059":54927},[],{"_3603":1460,"_31069":1333,"_21510":55275,"_5":14782,"_28250":54914,"_3059":55276},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3603":1461,"_31069":1333,"_21510":55278,"_5":14782,"_28250":54914,"_3059":55279},[],"DMS",{"_3603":1462,"_31069":1333,"_21510":55281,"_5":14782,"_28250":54914,"_3059":55282},[],"`IoTCore/ProvisioningTemplate`",{"_3603":1463,"_31069":1333,"_21510":55284,"_5":14782,"_28250":54914,"_3059":55285},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3603":1464,"_31069":1333,"_21510":55287,"_5":14782,"_28250":54914,"_3059":55288},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3603":1465,"_31069":1333,"_21510":55290,"_5":14782,"_28250":54914,"_3059":54955},[],{"_3603":1466,"_31069":1333,"_21510":55292,"_5":14782,"_28250":54914,"_3059":55293},[],"`EventBindDeviceIdentityKey`",{"_3603":1467,"_31069":1333,"_21510":55295,"_5":14782,"_28250":54914,"_3059":55296},[],"Device",{"_3603":1468,"_31069":1333,"_21510":55298,"_5":14782,"_28250":54914,"_3059":55299},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3603":1469,"_31069":1333,"_21510":55301,"_5":14782,"_28250":54914,"_3059":55302},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3603":1470,"_31069":1333,"_21510":55304,"_5":14782,"_28250":54914,"_3059":55305},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3603":1471,"_31069":1333,"_21510":55307,"_5":14782,"_28250":54914,"_3059":54963},[],{"_3603":1472,"_31069":1333,"_21510":55309,"_5":14782,"_28250":54914,"_3059":55310},[],"`EventUpdateCertificateStatusKey`",{"_3603":1473,"_31069":1333,"_21510":55312,"_5":14782,"_28250":54914,"_3059":55313},[],"Certificate",{"_3603":1474,"_31069":1333,"_21510":55315,"_5":14782,"_28250":54914,"_3059":55316},[],"`IoTCore/Certificate`",{"_3603":1475,"_31069":1333,"_21510":55318,"_5":14782,"_28250":54914,"_3059":55319},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3603":1476,"_31069":1333,"_21510":55321,"_5":14782,"_28250":54914,"_3059":55322},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3603":1477,"_31069":1333,"_21510":55324,"_5":14782,"_28250":54914,"_3059":54975},[],{"_3603":1478,"_31069":1333,"_21510":55326,"_5":14782,"_28250":54914,"_3059":55327},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3603":1479,"_31069":1333,"_21510":55329,"_5":14782,"_28250":54914,"_3059":55330},[],"Certificate / Device",{"_3603":1480,"_31069":1333,"_21510":55332,"_5":14782,"_28250":54914,"_3059":55333},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3603":1481,"_31069":1333,"_21510":55335,"_5":14782,"_28250":54914,"_3059":51138},[],{"_3603":1482,"_31069":1333,"_21510":55337,"_5":14782,"_28250":54914,"_3059":55338},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3603":1483,"_31069":1333,"_21510":55340,"_5":14782,"_28250":54914,"_3059":54983},[],{"_3603":1484,"_31069":1333,"_21510":55342,"_5":14782,"_28250":54918,"_3059":55343},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3603":1485,"_31069":1333,"_21510":55345,"_5":14782,"_28250":54922,"_3059":55346},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3603":1486,"_31069":1333,"_21510":55348,"_5":14782,"_28250":54922,"_3059":55349},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3603":1487,"_31069":1333,"_21510":55351,"_5":14782,"_28250":54926,"_3059":55352},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3603":1488,"_31069":1333,"_21510":55354,"_5":14782,"_28250":54926,"_3059":55355},[],"Transition",{"_3603":1489,"_31069":1333,"_21510":55357,"_5":14782,"_28250":54926,"_3059":55358},[],"AWS calls",{"_3603":1490,"_31069":1333,"_21510":55360,"_5":14782,"_28250":54926,"_3059":55361},[],"`NotRegistered` → `Requested`",{"_3603":1491,"_31069":1333,"_21510":55363,"_5":14782,"_28250":54926,"_3059":55364},[],"none (metadata write only)",{"_3603":1492,"_31069":1333,"_21510":55366,"_5":14782,"_28250":54926,"_3059":55367},[],"`Requested` → `Registering`",{"_3603":1493,"_31069":1333,"_21510":55369,"_5":14782,"_28250":54926,"_3059":55370},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3603":1494,"_31069":1333,"_21510":55372,"_5":14782,"_28250":54926,"_3059":55373},[],"`Registering` → `Succeeded`",{"_3603":1495,"_31069":1333,"_21510":55375,"_5":14782,"_28250":54926,"_3059":55376},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3603":1496,"_31069":1333,"_21510":55378,"_5":14782,"_28250":54926,"_3059":55379},[],"`Registering` → `Failed`",{"_3603":1497,"_31069":1333,"_21510":55381,"_5":14782,"_28250":54926,"_3059":55382},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3603":1498,"_31069":1333,"_21510":55384,"_5":14782,"_28250":54926,"_3059":55385},[],"`Failed` / `Succeeded` → `Requested`",{"_3603":1499,"_31069":1333,"_21510":55387,"_5":14782,"_28250":54926,"_3059":55388},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3603":1500,"_31069":1333,"_21510":55390,"_5":14782,"_28250":54930,"_3059":55391},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3603":1501,"_31069":1333,"_21510":55393,"_5":14782,"_28250":54930,"_3059":55394},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3603":1502,"_31069":1333,"_21510":55396,"_5":14782,"_28250":54930,"_3059":55397},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3603":1503,"_31069":1333,"_21510":55399,"_5":14782,"_28250":54930,"_3059":55400},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3603":1504,"_31069":1333,"_21510":55402,"_5":14782,"_28250":54930,"_3059":55403},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3603":1505,"_31069":1333,"_21510":55405,"_5":14782,"_28250":54930,"_3059":55406},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3603":1506,"_31069":1333,"_21510":55408,"_5":14782,"_28250":54934,"_3059":55409},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3603":1507,"_31069":1333,"_21510":55411,"_5":14782,"_28250":54938,"_3059":55412},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3603":1508,"_31069":1333,"_21510":55414,"_5":14782,"_28250":54938,"_3059":55415},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3603":1509,"_31069":1333,"_21510":55417,"_5":14782,"_28250":54942,"_3059":55418},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3603":1510,"_31069":1333,"_21510":55420,"_5":14782,"_28250":54946,"_3059":55421},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3603":1511,"_31069":1333,"_21510":55423,"_5":14782,"_28250":54946,"_3059":55424},[],"Creates or updates the IoT policies configured in the DMS.",{"_3603":1512,"_31069":1333,"_21510":55426,"_5":14782,"_28250":54946,"_3059":55427},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3603":1513,"_31069":1333,"_21510":55429,"_5":14782,"_28250":54946,"_3059":55430},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3603":1514,"_31069":1333,"_21510":55432,"_5":14782,"_28250":54946,"_3059":55433},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3603":1515,"_31069":1333,"_21510":55435,"_5":14782,"_28250":54946,"_3059":55436},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3603":1516,"_31069":1333,"_21510":55438,"_5":14782,"_28250":54946,"_3059":55439},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3603":1517,"_31069":1333,"_21510":55441,"_5":14782,"_28250":54950,"_3059":55442},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3603":1518,"_31069":1333,"_21510":55444,"_5":14782,"_28250":54950,"_3059":55445},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3603":1519,"_31069":1333,"_21510":55447,"_5":14782,"_28250":54950,"_3059":55448},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3603":1520,"_31069":1333,"_21510":55450,"_5":14782,"_28250":54950,"_3059":55451},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3603":1521,"_31069":1333,"_21510":55453,"_5":14782,"_28250":54950,"_3059":55454},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3603":1522,"_31069":1333,"_21510":55456,"_5":14782,"_28250":54954,"_3059":55457},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3603":1523,"_31069":1333,"_21510":55459,"_5":14782,"_28250":54954,"_3059":55355},[],{"_3603":1524,"_31069":1333,"_21510":55461,"_5":14782,"_28250":54954,"_3059":55358},[],{"_3603":1525,"_31069":1333,"_21510":55463,"_5":14782,"_28250":54954,"_3059":55464},[],"`Unconfigured` → `None` / `Auto`",{"_3603":1526,"_31069":1333,"_21510":55466,"_5":14782,"_28250":54954,"_3059":55467},[],"none (configuration only)",{"_3603":1527,"_31069":1333,"_21510":55469,"_5":14782,"_28250":54954,"_3059":55470},[],"`None` ↔ `Auto`",{"_3603":1528,"_31069":1333,"_21510":55472,"_5":14782,"_28250":54954,"_3059":55467},[],{"_3603":1529,"_31069":1333,"_21510":55474,"_5":14782,"_28250":54954,"_3059":55475},[],"Any → `Jitp`",{"_3603":1530,"_31069":1333,"_21510":55477,"_5":14782,"_28250":54954,"_3059":55478},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3603":1531,"_31069":1333,"_21510":55480,"_5":14782,"_28250":54954,"_3059":55481},[],"`Jitp` → `None` / `Auto`",{"_3603":1532,"_31069":1333,"_21510":55483,"_5":14782,"_28250":54954,"_3059":55484},[],"none (the template stays in the AWS account)",{"_3603":1533,"_31069":1333,"_21510":55486,"_5":14782,"_28250":54958,"_3059":55487},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3603":1534,"_31069":1333,"_21510":55489,"_5":14782,"_28250":54958,"_3059":55490},[],"The full flow from the device's perspective is:",{"_3603":1535,"_31069":1333,"_21510":55492,"_5":14782,"_28250":54958,"_3059":55493},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3603":1536,"_31069":1333,"_21510":55495,"_5":14782,"_28250":54962,"_3059":55496},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3603":1537,"_31069":1333,"_21510":55498,"_5":14782,"_28250":54962,"_3059":55355},[],{"_3603":1538,"_31069":1333,"_21510":55500,"_5":14782,"_28250":54962,"_3059":55358},[],{"_3603":1539,"_31069":1333,"_21510":55502,"_5":14782,"_28250":54962,"_3059":55503},[],"`Absent` → `Provisioned`",{"_3603":1540,"_31069":1333,"_21510":55505,"_5":14782,"_28250":54962,"_3059":55506},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3603":1541,"_31069":1333,"_21510":55508,"_5":14782,"_28250":54962,"_3059":55509},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3603":1542,"_31069":1333,"_21510":55511,"_5":14782,"_28250":54962,"_3059":55512},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3603":1543,"_31069":1333,"_21510":55514,"_5":14782,"_28250":54962,"_3059":55515},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3603":1544,"_31069":1333,"_21510":55517,"_5":14782,"_28250":54966,"_3059":55518},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3603":1545,"_31069":1333,"_21510":55520,"_5":14782,"_28250":54966,"_3059":55521},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3603":1546,"_31069":1333,"_21510":55523,"_5":14782,"_28250":54966,"_3059":55524},[],"For the JITP flow to work correctly:",{"_3603":1547,"_31069":1333,"_21510":55526,"_5":14782,"_28250":54966,"_3059":55527},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3603":1548,"_31069":1333,"_21510":55529,"_5":14782,"_28250":54966,"_3059":55530},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3603":1549,"_31069":1333,"_21510":55532,"_5":14782,"_28250":54966,"_3059":55533},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3603":1550,"_31069":1333,"_21510":55535,"_5":14782,"_28250":54966,"_3059":55536},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3603":1551,"_31069":1333,"_21510":55538,"_5":14782,"_28250":54970,"_3059":55539},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3603":1552,"_31069":1333,"_21510":55541,"_5":14782,"_28250":54970,"_3059":55542},[],"Status in Lamassu",{"_3603":1553,"_31069":1333,"_21510":55544,"_5":14782,"_28250":54970,"_3059":55545},[],"Revocation reason",{"_3603":1554,"_31069":1333,"_21510":55547,"_5":14782,"_28250":54970,"_3059":55548},[],"Status in AWS IoT Core",{"_3603":1555,"_31069":1333,"_21510":55550,"_5":14782,"_28250":54970,"_3059":55551},[],"`Active`",{"_3603":1556,"_31069":1333,"_21510":55553,"_5":14782,"_28250":54970,"_3059":55554},[],"None",{"_3603":1557,"_31069":1333,"_21510":55556,"_5":14782,"_28250":54970,"_3059":55557},[],"`ACTIVE`",{"_3603":1558,"_31069":1333,"_21510":55559,"_5":14782,"_28250":54970,"_3059":55560},[],"`Revoked`",{"_3603":1559,"_31069":1333,"_21510":55562,"_5":14782,"_28250":54970,"_3059":55563},[],"`certificateHold`",{"_3603":1560,"_31069":1333,"_21510":55565,"_5":14782,"_28250":54970,"_3059":55566},[],"`INACTIVE`",{"_3603":1561,"_31069":1333,"_21510":55568,"_5":14782,"_28250":54970,"_3059":55560},[],{"_3603":1562,"_31069":1333,"_21510":55570,"_5":14782,"_28250":54970,"_3059":55571},[],"Any other reason",{"_3603":1563,"_31069":1333,"_21510":55573,"_5":14782,"_28250":54970,"_3059":55574},[],"`REVOKED`",{"_3603":1564,"_31069":1333,"_21510":55576,"_5":14782,"_28250":54970,"_3059":55577},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3603":1565,"_31069":1333,"_21510":55579,"_5":14782,"_28250":54974,"_3059":55580},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3603":1566,"_31069":1333,"_21510":55582,"_5":14782,"_28250":54974,"_3059":55355},[],{"_3603":1567,"_31069":1333,"_21510":55584,"_5":14782,"_28250":54974,"_3059":55358},[],{"_3603":1568,"_31069":1333,"_21510":55586,"_5":14782,"_28250":54974,"_3059":55587},[],"`NotSynced` → `Active`",{"_3603":1569,"_31069":1333,"_21510":55589,"_5":14782,"_28250":54974,"_3059":55066},[],{"_3603":1570,"_31069":1333,"_21510":55591,"_5":14782,"_28250":54974,"_3059":55592},[],"`Active` → `Inactive`",{"_3603":1571,"_31069":1333,"_21510":55594,"_5":14782,"_28250":54974,"_3059":55595},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3603":1572,"_31069":1333,"_21510":55597,"_5":14782,"_28250":54974,"_3059":55598},[],"`Active` → `Revoked`",{"_3603":1573,"_31069":1333,"_21510":55600,"_5":14782,"_28250":54974,"_3059":55595},[],{"_3603":1574,"_31069":1333,"_21510":55602,"_5":14782,"_28250":54974,"_3059":55603},[],"`Inactive` / `Revoked` → `Active`",{"_3603":1575,"_31069":1333,"_21510":55605,"_5":14782,"_28250":54974,"_3059":55066},[],{"_3603":1576,"_31069":1333,"_21510":55607,"_5":14782,"_28250":54974,"_3059":55608},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3603":1577,"_31069":1333,"_21510":55610,"_5":14782,"_28250":54974,"_3059":55611},[],"none (these states are not synced to AWS)",{"_3603":1578,"_31069":1333,"_21510":55613,"_5":14782,"_28250":54978,"_3059":55614},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3603":1579,"_31069":1333,"_21510":55616,"_5":14782,"_28250":54978,"_3059":55617},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3603":1580,"_31069":1333,"_21510":55619,"_5":14782,"_28250":54978,"_3059":55620},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3603":1581,"_31069":1333,"_21510":55622,"_5":14782,"_28250":54982,"_3059":55623},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3603":1582,"_31069":1333,"_21510":55625,"_5":14782,"_28250":54982,"_3059":55626},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3603":1583,"_31069":1333,"_21510":55628,"_5":14782,"_28250":54986,"_3059":55629},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3603":1584,"_31069":1333,"_21510":55631,"_5":14782,"_28250":54986,"_3059":55632},[],"There are two action types:",{"_3603":1585,"_31069":1333,"_21510":55634,"_5":14782,"_28250":54986,"_3059":55635},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3603":1586,"_31069":1333,"_21510":55637,"_5":14782,"_28250":54986,"_3059":55638},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3603":1587,"_31069":1333,"_21510":55640,"_5":14782,"_28250":54986,"_3059":55641},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3603":1588,"_31069":1333,"_21510":55643,"_5":14782,"_28250":54990,"_3059":55644},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3603":1589,"_31069":1333,"_21510":55646,"_5":14782,"_28250":54990,"_3059":55647},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3603":1590,"_31069":1333,"_21510":55649,"_5":14782,"_28250":54990,"_3059":55650},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3603":1591,"_31069":1333,"_21510":55652,"_5":14782,"_28250":54994,"_3059":55653},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3603":1592,"_31069":1333,"_21510":55655,"_5":14782,"_28250":54994,"_3059":55656},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3603":1593,"_31069":1333,"_21510":55658,"_5":14782,"_28250":54994,"_3059":55659},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3603":1594,"_31069":1333,"_21510":55661,"_5":14782,"_28250":54994,"_3059":55662},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3603":1595,"_31069":1333,"_21510":55664,"_5":14782,"_28250":54994,"_3059":55665},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3603":1596,"_31069":1333,"_21510":55667,"_5":14782,"_28250":54994,"_3059":55668},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3603":1597,"_31069":1333,"_21510":55670,"_5":14782,"_28250":54994,"_3059":55671},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3603":1598,"_31069":1333,"_21510":55673,"_5":14782,"_28250":54994,"_3059":55674},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3603":1599,"_31069":1333,"_21510":55676,"_5":14782,"_28250":54994,"_3059":55677},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3603":1600,"_31069":1333,"_21510":55679,"_5":14782,"_28250":54994,"_3059":55680},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3603":1601,"_31069":1333,"_21510":55682,"_5":14782,"_28250":54994,"_3059":55683},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3603":1602,"_31069":1333,"_21510":55685,"_5":14782,"_28250":54994,"_3059":55686},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3603":1603,"_31069":1333,"_21510":55688,"_5":14782,"_28250":54994,"_3059":55689},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3603":1604,"_31069":1333,"_21510":55691,"_5":14782,"_28250":54994,"_3059":55692},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3603":1605,"_31069":1333,"_21510":55694,"_5":14782,"_28250":54994,"_3059":55695},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3603":1606,"_31069":1333,"_21510":55697,"_5":14782,"_28250":54994,"_3059":55698},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3603":1607,"_31069":1333,"_21510":55700,"_5":14782,"_28250":54994,"_3059":55701},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3603":1608,"_31069":1333,"_21510":55703,"_5":14782,"_28250":54994,"_3059":55704},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3603":1609,"_31069":1333,"_21510":55706,"_5":14782,"_28250":54994,"_3059":55707},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3603":1610,"_31069":1333,"_21510":55709,"_5":14782,"_28250":54994,"_3059":55710},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3603":1611,"_31069":1333,"_21510":55712,"_5":14782,"_28250":54994,"_3059":55713},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3603":1612,"_31069":1333,"_21510":55715,"_5":14782,"_28250":54994,"_3059":55716},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3603":1613,"_31069":1333,"_21510":55718,"_5":14782,"_28250":54994,"_3059":55719},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3603":1614,"_31069":1333,"_21510":55721,"_5":14782,"_28250":54994,"_3059":55722},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3603":1615,"_31069":1615,"_5":15147,"_3059":53426,"_31428":55724,"_21510":55725,"_28250":1615},[50742,52254,53426],[],{"_3603":1616,"_31069":1615,"_21510":55727,"_5":14782,"_28250":1615,"_3059":55728},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3603":1617,"_31069":1615,"_5":31425,"_21510":55730,"_28250":55731,"_3059":55732},[],"/docs/pr-preview/pr-74/platform/iot-fleets/overview#start-here","Start here",{"_3603":1618,"_31069":1615,"_5":31425,"_21510":55734,"_28250":55735,"_3059":53424},[],"/docs/pr-preview/pr-74/platform/iot-fleets/overview#devices-and-identities",{"_3603":1619,"_31069":1615,"_5":31425,"_21510":55737,"_28250":55738,"_3059":53610},[],"/docs/pr-preview/pr-74/platform/iot-fleets/overview#enrollment-with-pki",{"_3603":1620,"_31069":1615,"_5":31425,"_21510":55740,"_28250":55741,"_3059":54891},[],"/docs/pr-preview/pr-74/platform/iot-fleets/overview#integrations",{"_3603":1621,"_31069":1615,"_5":31425,"_21510":55743,"_28250":55744,"_3059":55745},[],"/docs/pr-preview/pr-74/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3603":1622,"_31069":1615,"_21510":55747,"_5":14782,"_28250":1615,"_3059":55748},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3603":1623,"_31069":1615,"_21510":55750,"_5":14782,"_28250":55731,"_3059":55751},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3603":1624,"_31069":1615,"_21510":55753,"_5":14782,"_28250":55731,"_3059":55754},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3603":1625,"_31069":1615,"_21510":55756,"_5":14782,"_28250":55735,"_3059":55757},[],"Resource",{"_3603":1626,"_31069":1615,"_21510":55759,"_5":14782,"_28250":55735,"_3059":55760},[],"What it represents",{"_3603":1627,"_31069":1615,"_21510":55762,"_5":14782,"_28250":55735,"_3059":55763},[],"**Device**",{"_3603":1628,"_31069":1615,"_21510":55765,"_5":14782,"_28250":55735,"_3059":55766},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3603":1629,"_31069":1615,"_21510":55768,"_5":14782,"_28250":55735,"_3059":55769},[],"**Identity**",{"_3603":1630,"_31069":1615,"_21510":55771,"_5":14782,"_28250":55735,"_3059":55772},[],"The device's association with its certificates: an active version and a history.",{"_3603":1631,"_31069":1615,"_21510":55774,"_5":14782,"_28250":55735,"_3059":55775},[],"**DMS**",{"_3603":1632,"_31069":1615,"_21510":55777,"_5":14782,"_28250":55735,"_3059":55778},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3603":1633,"_31069":1615,"_21510":55780,"_5":14782,"_28250":55735,"_3059":55781},[],"**Fleet**",{"_3603":1634,"_31069":1615,"_21510":55783,"_5":14782,"_28250":55735,"_3059":55784},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3603":1635,"_31069":1615,"_21510":55786,"_5":14782,"_28250":55735,"_3059":55787},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3603":1636,"_31069":1615,"_21510":55789,"_5":14782,"_28250":55735,"_3059":55790},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3603":1637,"_31069":1615,"_21510":55792,"_5":14782,"_28250":55738,"_3059":55793},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3603":1638,"_31069":1615,"_21510":55795,"_5":14782,"_28250":55738,"_3059":55796},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3603":1639,"_31069":1615,"_21510":55798,"_5":14782,"_28250":55738,"_3059":55799},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3603":1640,"_31069":1615,"_21510":55801,"_5":14782,"_28250":55738,"_3059":55802},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3603":1641,"_31069":1615,"_21510":55804,"_5":14782,"_28250":55738,"_3059":55805},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3603":1642,"_31069":1615,"_21510":55807,"_5":14782,"_28250":55738,"_3059":55808},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3603":1643,"_31069":1615,"_21510":55810,"_5":14782,"_28250":55738,"_3059":55811},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3603":1644,"_31069":1615,"_21510":55813,"_5":14782,"_28250":55738,"_3059":55814},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3603":1645,"_31069":1615,"_21510":55816,"_5":14782,"_28250":55741,"_3059":55817},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3603":1646,"_31069":1615,"_21510":55819,"_5":14782,"_28250":55741,"_3059":55820},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3603":1647,"_31069":1615,"_21510":55822,"_5":14782,"_28250":55744,"_3059":55823},[],"Participant",{"_3603":1648,"_31069":1615,"_21510":55825,"_5":14782,"_28250":55744,"_3059":55826},[],"Responsibility",{"_3603":1649,"_31069":1615,"_21510":55828,"_5":14782,"_28250":55744,"_3059":55829},[],"PKI administrator",{"_3603":1650,"_31069":1615,"_21510":55831,"_5":14782,"_28250":55744,"_3059":55832},[],"CA, issuance profile, chain and revocation publication.",{"_3603":1651,"_31069":1615,"_21510":55834,"_5":14782,"_28250":55744,"_3059":55835},[],"Provisioning administrator",{"_3603":1652,"_31069":1615,"_21510":55837,"_5":14782,"_28250":55744,"_3059":55838},[],"DMS, admission, authentication per operation and inventory.",{"_3603":1653,"_31069":1615,"_21510":55840,"_5":14782,"_28250":55744,"_3059":55841},[],"Device integrator",{"_3603":1654,"_31069":1615,"_21510":55843,"_5":14782,"_28250":55744,"_3059":55844},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3603":1655,"_31069":1615,"_21510":55846,"_5":14782,"_28250":55744,"_3059":55847},[],"Consumer integrator",{"_3603":1656,"_31069":1615,"_21510":55849,"_5":14782,"_28250":55744,"_3059":55850},[],"Trusted issuers, validation and device permissions in the destination.",{"_3603":1657,"_31069":1615,"_21510":55852,"_5":14782,"_28250":55744,"_3059":55853},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3603":1658,"_31069":1658,"_5":15147,"_3059":55855,"_31428":55856,"_21510":55858,"_28250":1658},"Enroll and connect your first device",[50742,52254,53426,55857],"Getting started",[],{"_3603":1659,"_31069":1658,"_21510":55860,"_5":14782,"_28250":1658,"_3059":55861},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3603":1660,"_31069":1658,"_5":31425,"_21510":55863,"_28250":55864,"_3059":50752},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3603":1661,"_31069":1658,"_5":31425,"_21510":55866,"_28250":55867,"_3059":55868},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3603":1662,"_31069":1658,"_5":31425,"_21510":55870,"_28250":55871,"_3059":55872},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3603":1663,"_31069":1658,"_5":31425,"_21510":55874,"_28250":55875,"_3059":55876},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3603":1664,"_31069":1658,"_5":31425,"_21510":55878,"_28250":55879,"_3059":55880},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3603":1665,"_31069":1658,"_5":31425,"_21510":55882,"_28250":55883,"_3059":55884},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3603":1666,"_31069":1658,"_5":31425,"_21510":55886,"_28250":55887,"_3059":55888},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3603":1667,"_31069":1658,"_5":31425,"_21510":55890,"_28250":55891,"_3059":55892},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3603":1668,"_31069":1658,"_21510":55894,"_5":14782,"_28250":1658,"_3059":55895},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3603":1669,"_31069":1658,"_21510":55897,"_5":14782,"_28250":55864,"_3059":55898},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3603":1670,"_31069":1658,"_21510":55900,"_5":14782,"_28250":55864,"_3059":55901},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3603":1671,"_31069":1658,"_21510":55903,"_5":14782,"_28250":55864,"_3059":55904},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3603":1672,"_31069":1658,"_21510":55906,"_5":14782,"_28250":55864,"_3059":55907},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3603":1673,"_31069":1658,"_21510":55909,"_5":14782,"_28250":55864,"_3059":55910},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3603":1674,"_31069":1658,"_21510":55912,"_5":14782,"_28250":55867,"_3059":55913},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3603":1675,"_31069":1658,"_21510":55915,"_5":14782,"_28250":55867,"_3059":55916},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3603":1676,"_31069":1658,"_21510":55918,"_5":14782,"_28250":55871,"_3059":55919},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3603":1677,"_31069":1658,"_21510":55921,"_5":14782,"_28250":55871,"_3059":55922},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3603":1678,"_31069":1658,"_21510":55924,"_5":14782,"_28250":55871,"_3059":55925},[],"Setting",{"_3603":1679,"_31069":1658,"_21510":55927,"_5":14782,"_28250":55871,"_3059":55928},[],"Evaluation value",{"_3603":1680,"_31069":1658,"_21510":55930,"_5":14782,"_28250":55871,"_3059":55931},[],"Enrollment CA",{"_3603":1681,"_31069":1658,"_21510":55933,"_5":14782,"_28250":55871,"_3059":55934},[],"Issuing root from `device-root.pem`.",{"_3603":1682,"_31069":1658,"_21510":55936,"_5":14782,"_28250":55871,"_3059":53740},[],{"_3603":1683,"_31069":1658,"_21510":55938,"_5":14782,"_28250":55871,"_3059":55939},[],"The 1-hour leaf profile you just prepared.",{"_3603":1684,"_31069":1658,"_21510":55941,"_5":14782,"_28250":55871,"_3059":55942},[],"Protocol / Registration Mode",{"_3603":1685,"_31069":1658,"_21510":55944,"_5":14782,"_28250":55871,"_3059":55945},[],"`EST_RFC7030` / `JITP`.",{"_3603":1686,"_31069":1658,"_21510":55947,"_5":14782,"_28250":55871,"_3059":55948},[],"Verify CSR Signature",{"_3603":1687,"_31069":1658,"_21510":55950,"_5":14782,"_28250":55871,"_3059":55951},[],"Enabled.",{"_3603":1688,"_31069":1658,"_21510":55953,"_5":14782,"_28250":55871,"_3059":55954},[],"Enable Replaceable Enrollment",{"_3603":1689,"_31069":1658,"_21510":55956,"_5":14782,"_28250":55871,"_3059":55957},[],"Disabled; the ID must be new.",{"_3603":1690,"_31069":1658,"_21510":55959,"_5":14782,"_28250":55871,"_3059":55960},[],"Initial authentication",{"_3603":1691,"_31069":1658,"_21510":55962,"_5":14782,"_28250":55871,"_3059":55963},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3603":1692,"_31069":1658,"_21510":55965,"_5":14782,"_28250":55871,"_3059":55966},[],"Renewal authentication",{"_3603":1693,"_31069":1658,"_21510":55968,"_5":14782,"_28250":55871,"_3059":55969},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3603":1694,"_31069":1658,"_21510":55971,"_5":14782,"_28250":55871,"_3059":55972},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3603":1695,"_31069":1658,"_21510":55974,"_5":14782,"_28250":55871,"_3059":55975},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3603":1696,"_31069":1658,"_21510":55977,"_5":14782,"_28250":55871,"_3059":55978},[],"Re-enrollment Delta",{"_3603":1697,"_31069":1658,"_21510":55980,"_5":14782,"_28250":55871,"_3059":55981},[],"1 hour.",{"_3603":1698,"_31069":1658,"_21510":55983,"_5":14782,"_28250":55871,"_3059":55984},[],"Preventive / Critical Delta",{"_3603":1699,"_31069":1658,"_21510":55986,"_5":14782,"_28250":55871,"_3059":55987},[],"30 minutes / 10 minutes.",{"_3603":1700,"_31069":1658,"_21510":55989,"_5":14782,"_28250":55871,"_3059":55990},[],"Revoke on Re-enrollment",{"_3603":1701,"_31069":1658,"_21510":55992,"_5":14782,"_28250":55871,"_3059":55993},[],"Disabled to test the successor before retiring the previous identity.",{"_3603":1702,"_31069":1658,"_21510":55995,"_5":14782,"_28250":55871,"_3059":53748},[],{"_3603":1703,"_31069":1658,"_21510":55997,"_5":14782,"_28250":55871,"_3059":55998},[],"Disabled; the operational key is generated in the client.",{"_3603":1704,"_31069":1658,"_21510":56000,"_5":14782,"_28250":55871,"_3059":56001},[],"CA Distribution",{"_3603":1705,"_31069":1658,"_21510":56003,"_5":14782,"_28250":55871,"_3059":56004},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3603":1706,"_31069":1658,"_21510":56006,"_5":14782,"_28250":55871,"_3059":56007},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3603":1707,"_31069":1658,"_21510":56009,"_5":14782,"_28250":55875,"_3059":56010},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3603":1708,"_31069":1658,"_21510":56012,"_5":14782,"_28250":55875,"_3059":56013},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3603":1709,"_31069":1658,"_21510":56015,"_5":14782,"_28250":55879,"_3059":56016},[],"Generate a new key and CSR with the selected identifier:",{"_3603":1710,"_31069":1658,"_21510":56018,"_5":14782,"_28250":55879,"_3059":56019},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3603":1711,"_31069":1658,"_21510":56021,"_5":14782,"_28250":55879,"_3059":56022},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3603":1712,"_31069":1658,"_21510":56024,"_5":14782,"_28250":55883,"_3059":56025},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3603":1713,"_31069":1658,"_21510":56027,"_5":14782,"_28250":55883,"_3059":56028},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3603":1714,"_31069":1658,"_21510":56030,"_5":14782,"_28250":55887,"_3059":56031},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3603":1715,"_31069":1658,"_21510":56033,"_5":14782,"_28250":55887,"_3059":56034},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3603":1716,"_31069":1658,"_21510":56036,"_5":14782,"_28250":55887,"_3059":56037},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3603":1717,"_31069":1658,"_21510":56039,"_5":14782,"_28250":55887,"_3059":56040},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3603":1718,"_31069":1658,"_21510":56042,"_5":14782,"_28250":55887,"_3059":56043},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3603":1719,"_31069":1658,"_21510":56045,"_5":14782,"_28250":55891,"_3059":56046},[],"Check",{"_3603":1720,"_31069":1658,"_21510":56048,"_5":14782,"_28250":55891,"_3059":56049},[],"Expected result",{"_3603":1721,"_31069":1658,"_21510":56051,"_5":14782,"_28250":55891,"_3059":56052},[],"Registration",{"_3603":1722,"_31069":1658,"_21510":56054,"_5":14782,"_28250":55891,"_3059":56055},[],"ID created automatically and correct DMS.",{"_3603":1723,"_31069":1658,"_21510":56057,"_5":14782,"_28250":55891,"_3059":55313},[],{"_3603":1724,"_31069":1658,"_21510":56059,"_5":14782,"_28250":55891,"_3059":56060},[],"CN, profile, serial and key verified.",{"_3603":1725,"_31069":1658,"_21510":56062,"_5":14782,"_28250":55891,"_3059":56063},[],"Inventory",{"_3603":1726,"_31069":1658,"_21510":56065,"_5":14782,"_28250":55891,"_3059":56066},[],"Received serial visible as the current identity and in history.",{"_3603":1727,"_31069":1658,"_21510":56068,"_5":14782,"_28250":55891,"_3059":56069},[],"Consumer",{"_3603":1728,"_31069":1658,"_21510":56071,"_5":14782,"_28250":55891,"_3059":56072},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3603":1729,"_31069":1658,"_21510":56074,"_5":14782,"_28250":55891,"_3059":56075},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3603":1730,"_31069":1658,"_21510":56077,"_5":14782,"_28250":55891,"_3059":56078},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3603":1731,"_31069":1731,"_5":15147,"_3059":53442,"_31428":56080,"_21510":56081,"_28250":1731},[50742,52254,53426,55857],[],{"_3603":1732,"_31069":1731,"_21510":56083,"_5":14782,"_28250":1731,"_3059":56084},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3603":1733,"_31069":1731,"_5":31425,"_21510":56086,"_28250":56087,"_3059":50752},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3603":1734,"_31069":1731,"_5":31425,"_21510":56089,"_28250":56090,"_3059":56091},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3603":1735,"_31069":1731,"_5":31425,"_21510":56093,"_28250":56094,"_3059":56095},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3603":1736,"_31069":1731,"_5":31425,"_21510":56097,"_28250":56098,"_3059":56099},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3603":1737,"_31069":1731,"_5":31425,"_21510":56101,"_28250":56102,"_3059":56103},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3603":1738,"_31069":1731,"_5":31425,"_21510":56105,"_28250":56106,"_3059":56107},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3603":1739,"_31069":1731,"_5":31425,"_21510":56109,"_28250":56110,"_3059":56049},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3603":1740,"_31069":1731,"_5":31425,"_21510":56112,"_28250":56113,"_3059":56114},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3603":1741,"_31069":1731,"_5":31425,"_21510":56116,"_28250":56117,"_3059":56118},[],"/docs/pr-preview/pr-74/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3603":1742,"_31069":1731,"_21510":56120,"_5":14782,"_28250":1731,"_3059":56121},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3603":1743,"_31069":1731,"_21510":56123,"_5":14782,"_28250":1731,"_3059":56124},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3603":1744,"_31069":1731,"_21510":56126,"_5":14782,"_28250":56087,"_3059":56127},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3603":1745,"_31069":1731,"_21510":56129,"_5":14782,"_28250":56087,"_3059":56130},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3603":1746,"_31069":1731,"_21510":56132,"_5":14782,"_28250":56087,"_3059":56133},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3603":1747,"_31069":1731,"_21510":56135,"_5":14782,"_28250":56087,"_3059":56136},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3603":1748,"_31069":1731,"_21510":56138,"_5":14782,"_28250":56090,"_3059":56139},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3603":1749,"_31069":1731,"_21510":56141,"_5":14782,"_28250":56090,"_3059":56142},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3603":1750,"_31069":1731,"_21510":56144,"_5":14782,"_28250":56090,"_3059":56145},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3603":1751,"_31069":1731,"_21510":56147,"_5":14782,"_28250":56090,"_3059":56148},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3603":1752,"_31069":1731,"_21510":56150,"_5":14782,"_28250":56090,"_3059":56151},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3603":1753,"_31069":1731,"_21510":56153,"_5":14782,"_28250":56090,"_3059":56154},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3603":1754,"_31069":1731,"_21510":56156,"_5":14782,"_28250":56090,"_3059":56157},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3603":1755,"_31069":1731,"_21510":56159,"_5":14782,"_28250":56090,"_3059":56160},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3603":1756,"_31069":1731,"_21510":56162,"_5":14782,"_28250":56094,"_3059":56163},[],"Open **Managed Devices** and the registration action. Complete:",{"_3603":1757,"_31069":1731,"_21510":56165,"_5":14782,"_28250":56094,"_3059":56166},[],"**Device ID**: `device-001`.",{"_3603":1758,"_31069":1731,"_21510":56168,"_5":14782,"_28250":56094,"_3059":56169},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3603":1759,"_31069":1731,"_21510":56171,"_5":14782,"_28250":56094,"_3059":56172},[],"**Icon** and **Tags**: optional classification.",{"_3603":1760,"_31069":1731,"_21510":56174,"_5":14782,"_28250":56094,"_3059":56175},[],"Confirm registration.",{"_3603":1761,"_31069":1731,"_21510":56177,"_5":14782,"_28250":56098,"_3059":56178},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3603":1762,"_31069":1731,"_21510":56180,"_5":14782,"_28250":56098,"_3059":56181},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3603":1763,"_31069":1731,"_21510":56183,"_5":14782,"_28250":56102,"_3059":56184},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3603":1764,"_31069":1731,"_21510":56186,"_5":14782,"_28250":56102,"_3059":56187},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3603":1765,"_31069":1731,"_21510":56189,"_5":14782,"_28250":56106,"_3059":56190},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3603":1766,"_31069":1731,"_21510":56192,"_5":14782,"_28250":56106,"_3059":56193},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3603":1767,"_31069":1731,"_21510":56195,"_5":14782,"_28250":56110,"_3059":56046},[],{"_3603":1768,"_31069":1731,"_21510":56197,"_5":14782,"_28250":56110,"_3059":56198},[],"Result",{"_3603":1769,"_31069":1731,"_21510":56200,"_5":14782,"_28250":56110,"_3059":55296},[],{"_3603":1770,"_31069":1731,"_21510":56202,"_5":14782,"_28250":56110,"_3059":56203},[],"`device-001` appears in inventory with the expected DMS.",{"_3603":1771,"_31069":1731,"_21510":56205,"_5":14782,"_28250":56110,"_3059":56206},[],"Current identity",{"_3603":1772,"_31069":1731,"_21510":56208,"_5":14782,"_28250":56110,"_3059":56209},[],"The associated certificate matches the one you verified in PKI.",{"_3603":1773,"_31069":1731,"_21510":56211,"_5":14782,"_28250":56110,"_3059":56212},[],"History",{"_3603":1774,"_31069":1731,"_21510":56214,"_5":14782,"_28250":56110,"_3059":56215},[],"The associated issuance appears with its serial number and dates.",{"_3603":1775,"_31069":1731,"_21510":56217,"_5":14782,"_28250":56110,"_3059":56218},[],"Key and certificate",{"_3603":1776,"_31069":1731,"_21510":56220,"_5":14782,"_28250":56110,"_3059":56221},[],"You have the verified pair ready to install on the device.",{"_3603":1777,"_31069":1731,"_21510":56223,"_5":14782,"_28250":56113,"_3059":56224},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3603":1778,"_31069":1731,"_21510":56226,"_5":14782,"_28250":56113,"_3059":56227},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3603":1779,"_31069":1731,"_21510":56229,"_5":14782,"_28250":56113,"_3059":56230},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3603":1780,"_31069":1731,"_21510":56232,"_5":14782,"_28250":56113,"_3059":56233},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3603":1781,"_31069":1731,"_21510":56235,"_5":14782,"_28250":56117,"_3059":56236},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3603":1782,"_31069":1731,"_21510":56238,"_5":14782,"_28250":56117,"_3059":56239},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3603":1783,"_31069":1731,"_21510":56241,"_5":14782,"_28250":56117,"_3059":56242},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3603":1784,"_31069":1784,"_5":15147,"_3059":56244,"_31428":56245,"_21510":56246,"_28250":1784},"Lamassu IoT Platform",[50742,52254],[],{"_3603":1785,"_31069":1784,"_21510":56248,"_5":14782,"_28250":1784,"_3059":56249},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3603":1786,"_31069":1784,"_5":31425,"_21510":56251,"_28250":56252,"_3059":55732},[],"/docs/pr-preview/pr-74/platform/overview#start-here",{"_3603":1787,"_31069":1784,"_5":31425,"_21510":56254,"_28250":56255,"_3059":56256},[],"/docs/pr-preview/pr-74/platform/overview#choose-your-path","Choose your path",{"_3603":1788,"_31069":1784,"_5":31425,"_21510":56258,"_28250":56259,"_3059":56260},[],"/docs/pr-preview/pr-74/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3603":1789,"_31069":1784,"_5":31425,"_21510":56262,"_28250":56263,"_3059":56264},[],"/docs/pr-preview/pr-74/platform/overview#core-capabilities","Core capabilities",{"_3603":1790,"_31069":1784,"_5":31425,"_21510":56266,"_28250":56267,"_3059":56268},[],"/docs/pr-preview/pr-74/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3603":1791,"_31069":1784,"_5":31425,"_21510":56270,"_28250":56271,"_3059":56272},[],"/docs/pr-preview/pr-74/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3603":1792,"_31069":1784,"_5":31425,"_21510":56274,"_28250":56275,"_3059":56276},[],"/docs/pr-preview/pr-74/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3603":1793,"_31069":1784,"_5":31425,"_21510":56278,"_28250":56279,"_3059":56280},[],"/docs/pr-preview/pr-74/platform/overview#automate-device-identities","Automate device identities",{"_3603":1794,"_31069":1784,"_5":31425,"_21510":56282,"_28250":56283,"_3059":56284},[],"/docs/pr-preview/pr-74/platform/overview#publish-validation-status","Publish validation status",{"_3603":1795,"_31069":1784,"_5":31425,"_21510":56286,"_28250":56287,"_3059":56288},[],"/docs/pr-preview/pr-74/platform/overview#react-to-events","React to events",{"_3603":1796,"_31069":1784,"_5":31425,"_21510":56290,"_28250":56291,"_3059":56292},[],"/docs/pr-preview/pr-74/platform/overview#operational-reference","Operational reference",{"_3603":1797,"_31069":1784,"_21510":56294,"_5":14782,"_28250":1784,"_3059":56295},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3603":1798,"_31069":1784,"_21510":56297,"_5":14782,"_28250":56252,"_3059":56298},[],"Choose the result you need:",{"_3603":1799,"_31069":1784,"_21510":56300,"_5":14782,"_28250":56252,"_3059":56301},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3603":1800,"_31069":1784,"_21510":56303,"_5":14782,"_28250":56252,"_3059":56304},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3603":1801,"_31069":1784,"_21510":56306,"_5":14782,"_28250":56252,"_3059":56307},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3603":1802,"_31069":1784,"_21510":56309,"_5":14782,"_28250":56255,"_3059":56310},[],"Section",{"_3603":1803,"_31069":1784,"_21510":56312,"_5":14782,"_28250":56255,"_3059":56313},[],"What you manage",{"_3603":1804,"_31069":1784,"_21510":56315,"_5":14782,"_28250":56255,"_3059":56316},[],"Entry point",{"_3603":1805,"_31069":1784,"_21510":56318,"_5":14782,"_28250":56255,"_3059":56319},[],"**PKI**",{"_3603":1806,"_31069":1784,"_21510":56321,"_5":14782,"_28250":56255,"_3059":56322},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3603":1807,"_31069":1784,"_21510":56324,"_5":14782,"_28250":56255,"_3059":56325},[],"PKI overview",{"_3603":1808,"_31069":1784,"_21510":56327,"_5":14782,"_28250":56255,"_3059":56328},[],"**IoT Fleets**",{"_3603":1809,"_31069":1784,"_21510":56330,"_5":14782,"_28250":56255,"_3059":56331},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3603":1810,"_31069":1784,"_21510":56333,"_5":14782,"_28250":56255,"_3059":56334},[],"IoT Fleets overview",{"_3603":1811,"_31069":1784,"_21510":56336,"_5":14782,"_28250":56255,"_3059":56337},[],"**Administration**",{"_3603":1812,"_31069":1784,"_21510":56339,"_5":14782,"_28250":56255,"_3059":56340},[],"Operator permissions, audit and event subscriptions.",{"_3603":1813,"_31069":1784,"_21510":56342,"_5":14782,"_28250":56255,"_3059":52256},[],{"_3603":1814,"_31069":1784,"_21510":56344,"_5":14782,"_28250":56255,"_3059":56345},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3603":1815,"_31069":1784,"_21510":56347,"_5":14782,"_28250":56259,"_3059":56348},[],"An identity's journey connects four responsibilities:",{"_3603":1816,"_31069":1784,"_21510":56350,"_5":14782,"_28250":56259,"_3059":56351},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3603":1817,"_31069":1784,"_21510":56353,"_5":14782,"_28250":56259,"_3059":56354},[],"The provisioning administrator configures the DMS and initial trust.",{"_3603":1818,"_31069":1784,"_21510":56356,"_5":14782,"_28250":56259,"_3059":56357},[],"The device client requests a certificate and installs it with the matching key.",{"_3603":1819,"_31069":1784,"_21510":56359,"_5":14782,"_28250":56259,"_3059":56360},[],"The consumer validates the identity and applies its access permissions.",{"_3603":1820,"_31069":1784,"_21510":56362,"_5":14782,"_28250":56259,"_3059":56363},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3603":1821,"_31069":1784,"_21510":56365,"_5":14782,"_28250":56267,"_3059":56366},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3603":1822,"_31069":1784,"_21510":56368,"_5":14782,"_28250":56271,"_3059":56369},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3603":1823,"_31069":1784,"_21510":56371,"_5":14782,"_28250":56275,"_3059":56372},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3603":1824,"_31069":1784,"_21510":56374,"_5":14782,"_28250":56279,"_3059":56375},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3603":1825,"_31069":1784,"_21510":56377,"_5":14782,"_28250":56283,"_3059":56378},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3603":1826,"_31069":1784,"_21510":56380,"_5":14782,"_28250":56287,"_3059":56381},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3603":1827,"_31069":1784,"_21510":56383,"_5":14782,"_28250":56291,"_3059":55826},[],{"_3603":1828,"_31069":1784,"_21510":56385,"_5":14782,"_28250":56291,"_3059":56386},[],"What it prepares or checks",{"_3603":1829,"_31069":1784,"_21510":56388,"_5":14782,"_28250":56291,"_3059":55829},[],{"_3603":1830,"_31069":1784,"_21510":56390,"_5":14782,"_28250":56291,"_3059":56391},[],"Key custody, CA hierarchy, profiles and validation.",{"_3603":1831,"_31069":1784,"_21510":56393,"_5":14782,"_28250":56291,"_3059":56394},[],"Fleet administrator",{"_3603":1832,"_31069":1784,"_21510":56396,"_5":14782,"_28250":56291,"_3059":56397},[],"DMS, device admission, renewal policy and inventory.",{"_3603":1833,"_31069":1784,"_21510":56399,"_5":14782,"_28250":56291,"_3059":55841},[],{"_3603":1834,"_31069":1784,"_21510":56401,"_5":14782,"_28250":56291,"_3059":56402},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3603":1835,"_31069":1784,"_21510":56404,"_5":14782,"_28250":56291,"_3059":55847},[],{"_3603":1836,"_31069":1784,"_21510":56406,"_5":14782,"_28250":56291,"_3059":56407},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3603":1837,"_31069":1784,"_21510":56409,"_5":14782,"_28250":56291,"_3059":56410},[],"Infrastructure operator",{"_3603":1838,"_31069":1784,"_21510":56412,"_5":14782,"_28250":56291,"_3059":56413},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3603":1839,"_31069":1784,"_21510":56415,"_5":14782,"_28250":56291,"_3059":56416},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3603":1840,"_31069":1840,"_5":15147,"_3059":56418,"_31428":56419,"_21510":56422,"_28250":1840},"CA hierarchy and rotation",[50742,52254,56420,56421],"PKI","Keys, authorities and certificates",[],{"_3603":1841,"_31069":1840,"_21510":56424,"_5":14782,"_28250":1840,"_3059":56425},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3603":1842,"_31069":1840,"_5":31425,"_21510":56427,"_28250":56428,"_3059":56429},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3603":1843,"_31069":1840,"_5":31425,"_21510":56431,"_28250":56432,"_3059":56433},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3603":1844,"_31069":1840,"_5":31425,"_21510":56435,"_28250":56436,"_3059":56437},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3603":1845,"_31069":1840,"_5":31425,"_21510":56439,"_28250":56440,"_3059":56441},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3603":1846,"_31069":1840,"_5":31425,"_21510":56443,"_28250":56444,"_3059":56445},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3603":1847,"_31069":1840,"_5":31425,"_21510":56447,"_28250":56448,"_3059":56449},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3603":1848,"_31069":1840,"_5":31425,"_21510":56451,"_28250":56452,"_3059":56453},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3603":1849,"_31069":1840,"_5":31425,"_21510":56455,"_28250":56456,"_3059":56457},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3603":1850,"_31069":1840,"_5":31425,"_21510":56459,"_28250":56460,"_3059":56461},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3603":1851,"_31069":1840,"_5":31425,"_21510":56463,"_28250":56464,"_3059":56465},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3603":1852,"_31069":1840,"_5":31425,"_21510":56467,"_28250":56468,"_3059":56469},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3603":1853,"_31069":1840,"_5":31425,"_21510":56471,"_28250":56472,"_3059":56473},[],"/docs/pr-preview/pr-74/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3603":1854,"_31069":1840,"_21510":56475,"_5":14782,"_28250":1840,"_3059":56476},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3603":1855,"_31069":1840,"_21510":56478,"_5":14782,"_28250":1840,"_3059":56479},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3603":1856,"_31069":1840,"_21510":56481,"_5":14782,"_28250":56428,"_3059":56482},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3603":1857,"_31069":1840,"_21510":56484,"_5":14782,"_28250":56428,"_3059":56485},[],"environment, such as production and preproduction;",{"_3603":1858,"_31069":1840,"_21510":56487,"_5":14782,"_28250":56428,"_3059":56488},[],"owner or operating team;",{"_3603":1859,"_31069":1840,"_21510":56490,"_5":14782,"_28250":56428,"_3059":56491},[],"device family or manufacturing process;",{"_3603":1860,"_31069":1840,"_21510":56493,"_5":14782,"_28250":56428,"_3059":56494},[],"region or regulatory requirement;",{"_3603":1861,"_31069":1840,"_21510":56496,"_5":14782,"_28250":56428,"_3059":56497},[],"cryptographic engine or key policy;",{"_3603":1862,"_31069":1840,"_21510":56499,"_5":14782,"_28250":56428,"_3059":56500},[],"maintenance window and renewal cadence.",{"_3603":1863,"_31069":1840,"_21510":56502,"_5":14782,"_28250":56428,"_3059":56503},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3603":1864,"_31069":1840,"_21510":56505,"_5":14782,"_28250":56428,"_3059":56506},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3603":1865,"_31069":1840,"_21510":56508,"_5":14782,"_28250":56432,"_3059":56509},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3603":1866,"_31069":1840,"_21510":56511,"_5":14782,"_28250":56432,"_3059":56512},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3603":1867,"_31069":1840,"_21510":56514,"_5":14782,"_28250":56432,"_3059":56515},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3603":1868,"_31069":1840,"_21510":56517,"_5":14782,"_28250":56432,"_3059":56518},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3603":1869,"_31069":1840,"_21510":56520,"_5":14782,"_28250":56436,"_3059":56521},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3603":1870,"_31069":1840,"_21510":56523,"_5":14782,"_28250":56436,"_3059":56524},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3603":1871,"_31069":1840,"_21510":56526,"_5":14782,"_28250":56436,"_3059":56527},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3603":1872,"_31069":1840,"_21510":56529,"_5":14782,"_28250":56436,"_3059":56530},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3603":1873,"_31069":1840,"_21510":56532,"_5":14782,"_28250":56444,"_3059":56533},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3603":1874,"_31069":1840,"_21510":56535,"_5":14782,"_28250":56448,"_3059":56536},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3603":1875,"_31069":1840,"_21510":56538,"_5":14782,"_28250":56452,"_3059":56539},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3603":1876,"_31069":1840,"_21510":56541,"_5":14782,"_28250":56456,"_3059":56542},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3603":1877,"_31069":1840,"_21510":56544,"_5":14782,"_28250":56460,"_3059":56545},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3603":1878,"_31069":1840,"_21510":56547,"_5":14782,"_28250":56464,"_3059":56548},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3603":1879,"_31069":1840,"_21510":56550,"_5":14782,"_28250":56468,"_3059":56551},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3603":1880,"_31069":1840,"_21510":56553,"_5":14782,"_28250":56468,"_3059":56554},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3603":1881,"_31069":1840,"_21510":56556,"_5":14782,"_28250":56468,"_3059":56557},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3603":1882,"_31069":1840,"_21510":56559,"_5":14782,"_28250":56468,"_3059":56560},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3603":1883,"_31069":1840,"_21510":56562,"_5":14782,"_28250":56472,"_3059":56563},[],"The new chain ends in an anchor installed by the consumer.",{"_3603":1884,"_31069":1840,"_21510":56565,"_5":14782,"_28250":56472,"_3059":56566},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3603":1885,"_31069":1840,"_21510":56568,"_5":14782,"_28250":56472,"_3059":56569},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3603":1886,"_31069":1840,"_21510":56571,"_5":14782,"_28250":56472,"_3059":56572},[],"Re-enrollment accepts the old identity during the planned period.",{"_3603":1887,"_31069":1840,"_21510":56574,"_5":14782,"_28250":56472,"_3059":56575},[],"OCSP and CRL respond for the authorities that remain active.",{"_3603":1888,"_31069":1840,"_21510":56577,"_5":14782,"_28250":56472,"_3059":56578},[],"No DMS is left accidentally issuing from the old CA.",{"_3603":1889,"_31069":1840,"_21510":56580,"_5":14782,"_28250":56472,"_3059":56581},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3603":1890,"_31069":1890,"_5":15147,"_3059":56583,"_31428":56584,"_21510":56585,"_28250":1890},"Certification authorities",[50742,52254,56420,56421],[],{"_3603":1891,"_31069":1890,"_21510":56587,"_5":14782,"_28250":1890,"_3059":56588},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3603":1892,"_31069":1890,"_5":31425,"_21510":56590,"_28250":56591,"_3059":56592},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3603":1893,"_31069":1890,"_5":31425,"_21510":56594,"_28250":56595,"_3059":56596},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3603":1894,"_31069":1890,"_5":31425,"_21510":56598,"_28250":56599,"_3059":50752},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#before-you-begin",{"_3603":1895,"_31069":1890,"_5":31425,"_21510":56601,"_28250":56602,"_3059":56603},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3603":1896,"_31069":1890,"_5":31425,"_21510":56605,"_28250":56606,"_3059":56607},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3603":1897,"_31069":1890,"_5":31425,"_21510":56609,"_28250":56610,"_3059":56611},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3603":1898,"_31069":1890,"_5":31425,"_21510":56613,"_28250":56614,"_3059":56615},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3603":1899,"_31069":1890,"_5":31425,"_21510":56617,"_28250":56618,"_3059":56619},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3603":1900,"_31069":1890,"_5":31425,"_21510":56621,"_28250":56622,"_3059":56623},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3603":1901,"_31069":1890,"_5":31425,"_21510":56625,"_28250":56626,"_3059":56627},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3603":1902,"_31069":1890,"_5":31425,"_21510":56629,"_28250":56630,"_3059":56631},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3603":1903,"_31069":1890,"_5":31425,"_21510":56633,"_28250":56634,"_3059":56635},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3603":1904,"_31069":1890,"_5":31425,"_21510":56637,"_28250":56638,"_3059":56639},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3603":1905,"_31069":1890,"_5":31425,"_21510":56641,"_28250":56642,"_3059":56643},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3603":1906,"_31069":1890,"_5":31425,"_21510":56645,"_28250":56646,"_3059":56647},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3603":1907,"_31069":1890,"_5":31425,"_21510":56649,"_28250":56650,"_3059":56651},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3603":1908,"_31069":1890,"_5":31425,"_21510":56653,"_28250":56654,"_3059":56655},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3603":1909,"_31069":1890,"_5":31425,"_21510":56657,"_28250":56658,"_3059":56659},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3603":1910,"_31069":1890,"_5":31425,"_21510":56661,"_28250":56662,"_3059":56663},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3603":1911,"_31069":1890,"_5":31425,"_21510":56665,"_28250":56666,"_3059":56667},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3603":1912,"_31069":1890,"_5":31425,"_21510":56669,"_28250":56670,"_3059":56671},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3603":1913,"_31069":1890,"_5":31425,"_21510":56673,"_28250":56674,"_3059":56675},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3603":1914,"_31069":1890,"_5":31425,"_21510":56677,"_28250":56678,"_3059":56679},[],"/docs/pr-preview/pr-74/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3603":1915,"_31069":1890,"_21510":56681,"_5":14782,"_28250":1890,"_3059":56682},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3603":1916,"_31069":1890,"_21510":56684,"_5":14782,"_28250":1890,"_3059":56685},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3603":1917,"_31069":1890,"_21510":56687,"_5":14782,"_28250":1890,"_3059":56688},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3603":1918,"_31069":1890,"_21510":56690,"_5":14782,"_28250":56591,"_3059":56691},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3603":1919,"_31069":1890,"_21510":56693,"_5":14782,"_28250":56591,"_3059":56694},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3603":1920,"_31069":1890,"_21510":56696,"_5":14782,"_28250":56591,"_3059":56697},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3603":1921,"_31069":1890,"_21510":56699,"_5":14782,"_28250":56591,"_3059":56700},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3603":1922,"_31069":1890,"_21510":56702,"_5":14782,"_28250":56591,"_3059":56703},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3603":1923,"_31069":1890,"_21510":56705,"_5":14782,"_28250":56599,"_3059":56706},[],"Decide whether the CA will be a root or an intermediate.",{"_3603":1924,"_31069":1890,"_21510":56708,"_5":14782,"_28250":56599,"_3059":56709},[],"Choose the engine that will keep the key.",{"_3603":1925,"_31069":1890,"_21510":56711,"_5":14782,"_28250":56599,"_3059":56712},[],"Define a validity longer than that of the certificates it will issue.",{"_3603":1926,"_31069":1890,"_21510":56714,"_5":14782,"_28250":56599,"_3059":56715},[],"For an intermediate CA, make sure the parent CA is active.",{"_3603":1927,"_31069":1890,"_21510":56717,"_5":14782,"_28250":56602,"_3059":56718},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3603":1928,"_31069":1890,"_21510":56720,"_5":14782,"_28250":56606,"_3059":56721},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3603":1929,"_31069":1890,"_21510":56723,"_5":14782,"_28250":56606,"_3059":56724},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3603":1930,"_31069":1890,"_21510":56726,"_5":14782,"_28250":56610,"_3059":56727},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3603":1931,"_31069":1890,"_21510":56729,"_5":14782,"_28250":56614,"_3059":56730},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3603":1932,"_31069":1890,"_21510":56732,"_5":14782,"_28250":56614,"_3059":56733},[],"`C`: two-letter ISO 3166-1 country code.",{"_3603":1933,"_31069":1890,"_21510":56735,"_5":14782,"_28250":56614,"_3059":56736},[],"`ST`: state or province.",{"_3603":1934,"_31069":1890,"_21510":56738,"_5":14782,"_28250":56614,"_3059":56739},[],"`L`: locality.",{"_3603":1935,"_31069":1890,"_21510":56741,"_5":14782,"_28250":56614,"_3059":56742},[],"`O`: organization.",{"_3603":1936,"_31069":1890,"_21510":56744,"_5":14782,"_28250":56614,"_3059":56745},[],"`OU`: organizational unit.",{"_3603":1937,"_31069":1890,"_21510":56747,"_5":14782,"_28250":56614,"_3059":56748},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3603":1938,"_31069":1890,"_21510":56750,"_5":14782,"_28250":56618,"_3059":56751},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3603":1939,"_31069":1890,"_21510":56753,"_5":14782,"_28250":56618,"_3059":56754},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3603":1940,"_31069":1890,"_21510":56756,"_5":14782,"_28250":56622,"_3059":56757},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3603":1941,"_31069":1890,"_21510":56759,"_5":14782,"_28250":56622,"_3059":56760},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3603":1942,"_31069":1890,"_21510":56762,"_5":14782,"_28250":56626,"_3059":56763},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3603":1943,"_31069":1890,"_21510":56765,"_5":14782,"_28250":56626,"_3059":56766},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3603":1944,"_31069":1890,"_21510":56768,"_5":14782,"_28250":56630,"_3059":56769},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3603":1945,"_31069":1890,"_21510":56771,"_5":14782,"_28250":56630,"_3059":56772},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3603":1946,"_31069":1890,"_21510":56774,"_5":14782,"_28250":56630,"_3059":56775},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3603":1947,"_31069":1890,"_21510":56777,"_5":14782,"_28250":56634,"_3059":56778},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3603":1948,"_31069":1890,"_21510":56780,"_5":14782,"_28250":56638,"_3059":56781},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3603":1949,"_31069":1890,"_21510":56783,"_5":14782,"_28250":56638,"_3059":56784},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3603":1950,"_31069":1890,"_21510":56786,"_5":14782,"_28250":56642,"_3059":56787},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3603":1951,"_31069":1890,"_21510":56789,"_5":14782,"_28250":56646,"_3059":56790},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3603":1952,"_31069":1890,"_21510":56792,"_5":14782,"_28250":56646,"_3059":56793},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3603":1953,"_31069":1890,"_21510":56795,"_5":14782,"_28250":56650,"_3059":56796},[],"Open a CA from the inventory to review:",{"_3603":1954,"_31069":1890,"_21510":56798,"_5":14782,"_28250":56650,"_3059":56799},[],"Status and validity period.",{"_3603":1955,"_31069":1890,"_21510":56801,"_5":14782,"_28250":56650,"_3059":56802},[],"Certificate and chain in PEM format.",{"_3603":1956,"_31069":1890,"_21510":56804,"_5":14782,"_28250":56650,"_3059":56805},[],"Number of active, expired and revoked certificates.",{"_3603":1957,"_31069":1890,"_21510":56807,"_5":14782,"_28250":56650,"_3059":56808},[],"Certificates issued in **Issued Certificates**.",{"_3603":1958,"_31069":1890,"_21510":56810,"_5":14782,"_28250":56650,"_3059":56811},[],"The CRL linked to the authority.",{"_3603":1959,"_31069":1890,"_21510":56813,"_5":14782,"_28250":56650,"_3059":56814},[],"Metadata and the associated cryptographic engine.",{"_3603":1960,"_31069":1890,"_21510":56816,"_5":14782,"_28250":56650,"_3059":56817},[],"You can filter the inventory by name, status and CA type.",{"_3603":1961,"_31069":1890,"_21510":56819,"_5":14782,"_28250":56654,"_3059":56820},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3603":1962,"_31069":1890,"_21510":56822,"_5":14782,"_28250":56654,"_3059":56823},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3603":1963,"_31069":1890,"_21510":56825,"_5":14782,"_28250":56654,"_3059":56826},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3603":1964,"_31069":1890,"_21510":56828,"_5":14782,"_28250":56654,"_3059":56829},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3603":1965,"_31069":1890,"_21510":56831,"_5":14782,"_28250":56654,"_3059":56832},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3603":1966,"_31069":1890,"_21510":56834,"_5":14782,"_28250":56654,"_3059":56835},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3603":1967,"_31069":1890,"_21510":56837,"_5":14782,"_28250":56658,"_3059":56838},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3603":1968,"_31069":1890,"_21510":56840,"_5":14782,"_28250":56662,"_3059":56841},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3603":1969,"_31069":1890,"_21510":56843,"_5":14782,"_28250":56666,"_3059":56844},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3603":1970,"_31069":1890,"_21510":56846,"_5":14782,"_28250":56670,"_3059":56847},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3603":1971,"_31069":1890,"_21510":56849,"_5":14782,"_28250":56674,"_3059":56850},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3603":1972,"_31069":1890,"_21510":56852,"_5":14782,"_28250":56678,"_3059":56853},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3603":1973,"_31069":1890,"_21510":56855,"_5":14782,"_28250":56678,"_3059":56856},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3603":1974,"_31069":1890,"_21510":56858,"_5":14782,"_28250":56678,"_3059":56859},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3603":1975,"_31069":1890,"_21510":56861,"_5":14782,"_28250":56678,"_3059":56862},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3603":1976,"_31069":1976,"_5":15147,"_3059":56864,"_31428":56865,"_21510":56866,"_28250":1976},"Certificate profiles",[50742,52254,56420,56421],[],{"_3603":1977,"_31069":1976,"_21510":56868,"_5":14782,"_28250":1976,"_3059":56869},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3603":1978,"_31069":1976,"_5":31425,"_21510":56871,"_28250":56872,"_3059":56873},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3603":1979,"_31069":1976,"_5":31425,"_21510":56875,"_28250":56876,"_3059":56877},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#validity","Validity",{"_3603":1980,"_31069":1976,"_5":31425,"_21510":56879,"_28250":56880,"_3059":56881},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3603":1981,"_31069":1976,"_5":31425,"_21510":56883,"_28250":56884,"_3059":56885},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3603":1982,"_31069":1976,"_5":31425,"_21510":56887,"_28250":56888,"_3059":56889},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#subject","Subject",{"_3603":1983,"_31069":1976,"_5":31425,"_21510":56891,"_28250":56892,"_3059":56893},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3603":1984,"_31069":1976,"_5":31425,"_21510":56895,"_28250":56896,"_3059":56897},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3603":1985,"_31069":1976,"_5":31425,"_21510":56899,"_28250":56900,"_3059":56901},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3603":1986,"_31069":1976,"_5":31425,"_21510":56903,"_28250":56904,"_3059":56905},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3603":1987,"_31069":1976,"_5":31425,"_21510":56907,"_28250":56908,"_3059":56909},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3603":1988,"_31069":1976,"_5":31425,"_21510":56911,"_28250":56912,"_3059":56913},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3603":1989,"_31069":1976,"_5":31425,"_21510":56915,"_28250":56916,"_3059":56917},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3603":1990,"_31069":1976,"_5":31425,"_21510":56919,"_28250":56920,"_3059":56921},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3603":1991,"_31069":1976,"_5":31425,"_21510":56923,"_28250":56924,"_3059":56925},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3603":1992,"_31069":1976,"_5":31425,"_21510":56927,"_28250":56928,"_3059":56929},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#design-examples","Design examples",{"_3603":1993,"_31069":1976,"_5":31425,"_21510":56931,"_28250":56932,"_3059":56933},[],"/docs/pr-preview/pr-74/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3603":1994,"_31069":1976,"_21510":56935,"_5":14782,"_28250":1976,"_3059":56936},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3603":1995,"_31069":1976,"_21510":56938,"_5":14782,"_28250":1976,"_3059":56939},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3603":1996,"_31069":1976,"_21510":56941,"_5":14782,"_28250":56876,"_3059":56942},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3603":1997,"_31069":1976,"_21510":56944,"_5":14782,"_28250":56876,"_3059":56945},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3603":1998,"_31069":1976,"_21510":56947,"_5":14782,"_28250":56880,"_3059":56948},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3603":1999,"_31069":1976,"_21510":56950,"_5":14782,"_28250":56884,"_3059":56951},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3603":2000,"_31069":1976,"_21510":56953,"_5":14782,"_28250":56884,"_3059":56954},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3603":2001,"_31069":1976,"_21510":56956,"_5":14782,"_28250":56884,"_3059":56957},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3603":2002,"_31069":1976,"_21510":56959,"_5":14782,"_28250":56888,"_3059":56960},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3603":2003,"_31069":1976,"_21510":56962,"_5":14782,"_28250":56892,"_3059":56963},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3603":2004,"_31069":1976,"_21510":56965,"_5":14782,"_28250":56892,"_3059":56966},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3603":2005,"_31069":1976,"_21510":56968,"_5":14782,"_28250":56896,"_3059":56969},[],"The cryptographic enforcement can:",{"_3603":2006,"_31069":1976,"_21510":56971,"_5":14782,"_28250":56896,"_3059":56972},[],"allow or block RSA keys;",{"_3603":2007,"_31069":1976,"_21510":56974,"_5":14782,"_28250":56896,"_3059":56975},[],"limit the supported RSA sizes;",{"_3603":2008,"_31069":1976,"_21510":56977,"_5":14782,"_28250":56896,"_3059":56978},[],"allow or block ECDSA keys;",{"_3603":2009,"_31069":1976,"_21510":56980,"_5":14782,"_28250":56896,"_3059":56981},[],"limit the supported ECDSA sizes or curves.",{"_3603":2010,"_31069":1976,"_21510":56983,"_5":14782,"_28250":56896,"_3059":56984},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3603":2011,"_31069":1976,"_21510":56986,"_5":14782,"_28250":56900,"_3059":56987},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3603":2012,"_31069":1976,"_21510":56989,"_5":14782,"_28250":56900,"_3059":54182},[],{"_3603":2013,"_31069":1976,"_21510":56991,"_5":14782,"_28250":56900,"_3059":56992},[],"First choice",{"_3603":2014,"_31069":1976,"_21510":56994,"_5":14782,"_28250":56900,"_3059":56995},[],"Second choice",{"_3603":2015,"_31069":1976,"_21510":56997,"_5":14782,"_28250":56900,"_3059":56998},[],"If neither is supplied",{"_3603":2016,"_31069":1976,"_21510":57000,"_5":14782,"_28250":56900,"_3059":57001},[],"Direct signing with a CA",{"_3603":2017,"_31069":1976,"_21510":57003,"_5":14782,"_28250":56900,"_3059":57004},[],"`issuance_profile` embedded in the request",{"_3603":2018,"_31069":1976,"_21510":57006,"_5":14782,"_28250":56900,"_3059":57007},[],"Request `issuance_profile_id`",{"_3603":2019,"_31069":1976,"_21510":57009,"_5":14782,"_28250":56900,"_3059":57010},[],"CA default profile (`profile_id`).",{"_3603":2020,"_31069":1976,"_21510":57012,"_5":14782,"_28250":56900,"_3059":57013},[],"Issuance through a DMS",{"_3603":2021,"_31069":1976,"_21510":57015,"_5":14782,"_28250":56900,"_3059":57016},[],"`settings.issuance_profile_id`",{"_3603":2022,"_31069":1976,"_21510":57018,"_5":14782,"_28250":56900,"_3059":57019},[],"`settings.issuance_profile` embedded in the DMS",{"_3603":2023,"_31069":1976,"_21510":57021,"_5":14782,"_28250":56900,"_3059":57022},[],"Enrollment CA default profile.",{"_3603":2024,"_31069":1976,"_21510":57024,"_5":14782,"_28250":56900,"_3059":57025},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3603":2025,"_31069":1976,"_21510":57027,"_5":14782,"_28250":56900,"_3059":57028},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3603":2026,"_31069":1976,"_21510":57030,"_5":14782,"_28250":56908,"_3059":57031},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3603":2027,"_31069":1976,"_21510":57033,"_5":14782,"_28250":56912,"_3059":57034},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3603":2028,"_31069":1976,"_21510":57036,"_5":14782,"_28250":56916,"_3059":57037},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3603":2029,"_31069":1976,"_21510":57039,"_5":14782,"_28250":56920,"_3059":57040},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3603":2030,"_31069":1976,"_21510":57042,"_5":14782,"_28250":56924,"_3059":57043},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3603":2031,"_31069":1976,"_21510":57045,"_5":14782,"_28250":56924,"_3059":57046},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3603":2032,"_31069":1976,"_21510":57048,"_5":14782,"_28250":56928,"_3059":57049},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3603":2033,"_31069":1976,"_21510":57051,"_5":14782,"_28250":56928,"_3059":57052},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3603":2034,"_31069":1976,"_21510":57054,"_5":14782,"_28250":56928,"_3059":57055},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3603":2035,"_31069":1976,"_21510":57057,"_5":14782,"_28250":56928,"_3059":57058},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3603":2036,"_31069":1976,"_21510":57060,"_5":14782,"_28250":56932,"_3059":57061},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3603":2037,"_31069":1976,"_21510":57063,"_5":14782,"_28250":56932,"_3059":57064},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3603":2038,"_31069":2038,"_5":15147,"_3059":57066,"_31428":57067,"_21510":57069,"_28250":2038},"Certificate validation",[50742,52254,56420,57068],"Validation",[],{"_3603":2039,"_31069":2038,"_21510":57071,"_5":14782,"_28250":2038,"_3059":57072},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3603":2040,"_31069":2038,"_5":31425,"_21510":57074,"_28250":57075,"_3059":57076},[],"/docs/pr-preview/pr-74/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3603":2041,"_31069":2038,"_5":31425,"_21510":57078,"_28250":57079,"_3059":57080},[],"/docs/pr-preview/pr-74/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3603":2042,"_31069":2038,"_5":31425,"_21510":57082,"_28250":57083,"_3059":57084},[],"/docs/pr-preview/pr-74/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3603":2043,"_31069":2038,"_21510":57086,"_5":14782,"_28250":2038,"_3059":57087},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3603":2044,"_31069":2038,"_21510":57089,"_5":14782,"_28250":57075,"_3059":57090},[],"Verify these criteria together:",{"_3603":2045,"_31069":2038,"_21510":57092,"_5":14782,"_28250":57075,"_3059":56046},[],{"_3603":2046,"_31069":2038,"_21510":57094,"_5":14782,"_28250":57075,"_3059":57095},[],"Required result",{"_3603":2047,"_31069":2038,"_21510":57097,"_5":14782,"_28250":57075,"_3059":57098},[],"Chain and signature",{"_3603":2048,"_31069":2038,"_21510":57100,"_5":14782,"_28250":57075,"_3059":57101},[],"Valid chain to a root deliberately installed in the consumer.",{"_3603":2049,"_31069":2038,"_21510":57103,"_5":14782,"_28250":57075,"_3059":57104},[],"Dates",{"_3603":2050,"_31069":2038,"_21510":57106,"_5":14782,"_28250":57075,"_3059":57107},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3603":2051,"_31069":2038,"_21510":57109,"_5":14782,"_28250":57075,"_3059":51923},[],{"_3603":2052,"_31069":2038,"_21510":57111,"_5":14782,"_28250":57075,"_3059":57112},[],"Name, SAN or identifier matches the expected peer.",{"_3603":2053,"_31069":2038,"_21510":57114,"_5":14782,"_28250":57075,"_3059":51132},[],{"_3603":2054,"_31069":2038,"_21510":57116,"_5":14782,"_28250":57075,"_3059":57117},[],"KU, EKU and constraints permit the specific operation.",{"_3603":2055,"_31069":2038,"_21510":57119,"_5":14782,"_28250":57075,"_3059":57120},[],"Revocation",{"_3603":2056,"_31069":2038,"_21510":57122,"_5":14782,"_28250":57075,"_3059":57123},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3603":2057,"_31069":2038,"_21510":57125,"_5":14782,"_28250":57075,"_3059":57126},[],"Authorization",{"_3603":2058,"_31069":2038,"_21510":57128,"_5":14782,"_28250":57075,"_3059":57129},[],"The application permits that identity to perform the action.",{"_3603":2059,"_31069":2038,"_21510":57131,"_5":14782,"_28250":57075,"_3059":57132},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3603":2060,"_31069":2038,"_21510":57134,"_5":14782,"_28250":57079,"_3059":57135},[],"Mechanism",{"_3603":2061,"_31069":2038,"_21510":57137,"_5":14782,"_28250":57079,"_3059":57138},[],"When to use it",{"_3603":2062,"_31069":2038,"_21510":57140,"_5":14782,"_28250":57079,"_3059":57141},[],"What you must maintain",{"_3603":2063,"_31069":2038,"_21510":57143,"_5":14782,"_28250":57079,"_3059":57144},[],"OCSP",{"_3603":2064,"_31069":2038,"_21510":57146,"_5":14782,"_28250":57079,"_3059":57147},[],"Status query for a specific certificate.",{"_3603":2065,"_31069":2038,"_21510":57149,"_5":14782,"_28250":57079,"_3059":57150},[],"Responder access, signature verification and cache/freshness policy.",{"_3603":2066,"_31069":2038,"_21510":57152,"_5":14782,"_28250":57079,"_3059":57153},[],"CRL",{"_3603":2067,"_31069":2038,"_21510":57155,"_5":14782,"_28250":57079,"_3059":57156},[],"Local checks for many certificates or offline operation.",{"_3603":2068,"_31069":2038,"_21510":57158,"_5":14782,"_28250":57079,"_3059":57159},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3603":2069,"_31069":2038,"_21510":57161,"_5":14782,"_28250":57079,"_3059":57162},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3603":2070,"_31069":2038,"_21510":57164,"_5":14782,"_28250":57079,"_3059":57165},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3603":2071,"_31069":2038,"_21510":57167,"_5":14782,"_28250":57083,"_3059":57168},[],"Accept a current, authorized certificate with a known chain.",{"_3603":2072,"_31069":2038,"_21510":57170,"_5":14782,"_28250":57083,"_3059":57171},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3603":2073,"_31069":2038,"_21510":57173,"_5":14782,"_28250":57083,"_3059":57174},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3603":2074,"_31069":2038,"_21510":57176,"_5":14782,"_28250":57083,"_3059":57177},[],"Check that a new connection with that identity is rejected.",{"_3603":2075,"_31069":2038,"_21510":57179,"_5":14782,"_28250":57083,"_3059":57180},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3603":2076,"_31069":2038,"_21510":57182,"_5":14782,"_28250":57083,"_3059":57183},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3603":2077,"_31069":2038,"_21510":57185,"_5":14782,"_28250":57083,"_3059":57186},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3603":2078,"_31069":2038,"_21510":57188,"_5":14782,"_28250":57083,"_3059":57189},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3603":2079,"_31069":2038,"_21510":57191,"_5":14782,"_28250":57083,"_3059":57192},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3603":2080,"_31069":2080,"_5":15147,"_3059":57194,"_31428":57195,"_21510":57196,"_28250":2080},"Certificates",[50742,52254,56420,56421],[],{"_3603":2081,"_31069":2080,"_21510":57198,"_5":14782,"_28250":2080,"_3059":57199},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3603":2082,"_31069":2080,"_5":31425,"_21510":57201,"_28250":57202,"_3059":57203},[],"/docs/pr-preview/pr-74/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3603":2083,"_31069":2080,"_5":31425,"_21510":57205,"_28250":57206,"_3059":57207},[],"/docs/pr-preview/pr-74/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3603":2084,"_31069":2080,"_5":31425,"_21510":57209,"_28250":57210,"_3059":57211},[],"/docs/pr-preview/pr-74/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3603":2085,"_31069":2080,"_5":31425,"_21510":57213,"_28250":57214,"_3059":57215},[],"/docs/pr-preview/pr-74/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3603":2086,"_31069":2080,"_5":31425,"_21510":57217,"_28250":57218,"_3059":57219},[],"/docs/pr-preview/pr-74/platform/pki/certificates#open-the-action","Open the action",{"_3603":2087,"_31069":2080,"_5":31425,"_21510":57221,"_28250":57222,"_3059":57223},[],"/docs/pr-preview/pr-74/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3603":2088,"_31069":2080,"_5":31425,"_21510":57225,"_28250":57226,"_3059":57227},[],"/docs/pr-preview/pr-74/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3603":2089,"_31069":2080,"_5":31425,"_21510":57229,"_28250":57230,"_3059":57231},[],"/docs/pr-preview/pr-74/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3603":2090,"_31069":2080,"_5":31425,"_21510":57233,"_28250":57234,"_3059":57235},[],"/docs/pr-preview/pr-74/platform/pki/certificates#continue","Continue",{"_3603":2091,"_31069":2080,"_21510":57237,"_5":14782,"_28250":2080,"_3059":57238},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3603":2092,"_31069":2080,"_21510":57240,"_5":14782,"_28250":57202,"_3059":57241},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3603":2093,"_31069":2080,"_21510":57243,"_5":14782,"_28250":57202,"_3059":57244},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3603":2094,"_31069":2080,"_21510":57246,"_5":14782,"_28250":57202,"_3059":57247},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3603":2095,"_31069":2080,"_21510":57249,"_5":14782,"_28250":57202,"_3059":57250},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3603":2096,"_31069":2080,"_21510":57252,"_5":14782,"_28250":57202,"_3059":57253},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3603":2097,"_31069":2080,"_21510":57255,"_5":14782,"_28250":57202,"_3059":57256},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3603":2098,"_31069":2080,"_21510":57258,"_5":14782,"_28250":57202,"_3059":57259},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3603":2099,"_31069":2080,"_21510":57261,"_5":14782,"_28250":57206,"_3059":57262},[],"Download the PEM and inspect it:",{"_3603":2100,"_31069":2080,"_21510":57264,"_5":14782,"_28250":57206,"_3059":57265},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3603":2101,"_31069":2080,"_21510":57267,"_5":14782,"_28250":57210,"_3059":57268},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3603":2102,"_31069":2080,"_21510":57270,"_5":14782,"_28250":57210,"_3059":57271},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3603":2103,"_31069":2080,"_21510":57273,"_5":14782,"_28250":57210,"_3059":57274},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3603":2104,"_31069":2080,"_21510":57276,"_5":14782,"_28250":57210,"_3059":57277},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3603":2105,"_31069":2080,"_21510":57279,"_5":14782,"_28250":57210,"_3059":57280},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3603":2106,"_31069":2080,"_21510":57282,"_5":14782,"_28250":57210,"_3059":57283},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3603":2107,"_31069":2080,"_21510":57285,"_5":14782,"_28250":57210,"_3059":57286},[],"For browser key generation, follow Issue your first certificate.",{"_3603":2108,"_31069":2080,"_21510":57288,"_5":14782,"_28250":57214,"_3059":57289},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3603":2109,"_31069":2080,"_21510":57291,"_5":14782,"_28250":57218,"_3059":57292},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3603":2110,"_31069":2080,"_21510":57294,"_5":14782,"_28250":57222,"_3059":57295},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3603":2111,"_31069":2080,"_21510":57297,"_5":14782,"_28250":57226,"_3059":57298},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3603":2112,"_31069":2080,"_21510":57300,"_5":14782,"_28250":57226,"_3059":57301},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3603":2113,"_31069":2080,"_21510":57303,"_5":14782,"_28250":57226,"_3059":57304},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3603":2114,"_31069":2080,"_21510":57306,"_5":14782,"_28250":57230,"_3059":57307},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3603":2115,"_31069":2080,"_21510":57309,"_5":14782,"_28250":57230,"_3059":57310},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3603":2116,"_31069":2080,"_21510":57312,"_5":14782,"_28250":57230,"_3059":57313},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3603":2117,"_31069":2080,"_21510":57315,"_5":14782,"_28250":57234,"_3059":57316},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3603":2118,"_31069":2080,"_21510":57318,"_5":14782,"_28250":57234,"_3059":57319},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3603":2119,"_31069":2119,"_5":15147,"_3059":57321,"_31428":57322,"_21510":57324,"_28250":2119},"Certificate lifecycle",[50742,52254,56420,57323],"Concepts",[],{"_3603":2120,"_31069":2119,"_21510":57326,"_5":14782,"_28250":2119,"_3059":57327},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3603":2121,"_31069":2119,"_5":31425,"_21510":57329,"_28250":57330,"_3059":57331},[],"/docs/pr-preview/pr-74/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3603":2122,"_31069":2119,"_5":31425,"_21510":57333,"_28250":57334,"_3059":57335},[],"/docs/pr-preview/pr-74/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3603":2123,"_31069":2119,"_5":31425,"_21510":57337,"_28250":57338,"_3059":57339},[],"/docs/pr-preview/pr-74/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3603":2124,"_31069":2119,"_5":31425,"_21510":57341,"_28250":57342,"_3059":57343},[],"/docs/pr-preview/pr-74/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3603":2125,"_31069":2119,"_5":31425,"_21510":57345,"_28250":57346,"_3059":57347},[],"/docs/pr-preview/pr-74/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3603":2126,"_31069":2119,"_5":31425,"_21510":57349,"_28250":57350,"_3059":57351},[],"/docs/pr-preview/pr-74/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3603":2127,"_31069":2119,"_5":31425,"_21510":57353,"_28250":57354,"_3059":57355},[],"/docs/pr-preview/pr-74/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3603":2128,"_31069":2119,"_5":31425,"_21510":57357,"_28250":57358,"_3059":57359},[],"/docs/pr-preview/pr-74/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3603":2129,"_31069":2119,"_5":31425,"_21510":57361,"_28250":57362,"_3059":57363},[],"/docs/pr-preview/pr-74/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3603":2130,"_31069":2119,"_5":31425,"_21510":57365,"_28250":57366,"_3059":57367},[],"/docs/pr-preview/pr-74/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3603":2131,"_31069":2119,"_21510":57369,"_5":14782,"_28250":2119,"_3059":57370},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3603":2132,"_31069":2119,"_21510":57372,"_5":14782,"_28250":57334,"_3059":57373},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3603":2133,"_31069":2119,"_21510":57375,"_5":14782,"_28250":57338,"_3059":57376},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3603":2134,"_31069":2119,"_21510":57378,"_5":14782,"_28250":57342,"_3059":57379},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3603":2135,"_31069":2119,"_21510":57381,"_5":14782,"_28250":57346,"_3059":57382},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3603":2136,"_31069":2119,"_21510":57384,"_5":14782,"_28250":57350,"_3059":57385},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3603":2137,"_31069":2119,"_21510":57387,"_5":14782,"_28250":57354,"_3059":57388},[],"Lamassu persists four X.509 states:",{"_3603":2138,"_31069":2119,"_21510":57390,"_5":14782,"_28250":57354,"_3059":57391},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3603":2139,"_31069":2119,"_21510":57393,"_5":14782,"_28250":57354,"_3059":57394},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3603":2140,"_31069":2119,"_21510":57396,"_5":14782,"_28250":57354,"_3059":57397},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3603":2141,"_31069":2119,"_21510":57399,"_5":14782,"_28250":57354,"_3059":57400},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3603":2142,"_31069":2119,"_21510":57402,"_5":14782,"_28250":57354,"_3059":57403},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3603":2143,"_31069":2119,"_21510":57405,"_5":14782,"_28250":57358,"_3059":57406},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3603":2144,"_31069":2119,"_21510":57408,"_5":14782,"_28250":57358,"_3059":57409},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3603":2145,"_31069":2119,"_21510":57411,"_5":14782,"_28250":57358,"_3059":57412},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3603":2146,"_31069":2119,"_21510":57414,"_5":14782,"_28250":57362,"_3059":57415},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3603":2147,"_31069":2119,"_21510":57417,"_5":14782,"_28250":57362,"_3059":57418},[],"Before confirming:",{"_3603":2148,"_31069":2119,"_21510":57420,"_5":14782,"_28250":57362,"_3059":57421},[],"Identify DMSs, devices and services that trust that chain.",{"_3603":2149,"_31069":2119,"_21510":57423,"_5":14782,"_28250":57362,"_3059":57424},[],"Distribute the new chain of trust.",{"_3603":2150,"_31069":2119,"_21510":57426,"_5":14782,"_28250":57362,"_3059":57427},[],"Reissue the necessary identities.",{"_3603":2151,"_31069":2119,"_21510":57429,"_5":14782,"_28250":57362,"_3059":57430},[],"Check OCSP and CRL from a real consumer.",{"_3603":2152,"_31069":2119,"_21510":57432,"_5":14782,"_28250":57362,"_3059":57433},[],"Revoke the old CA once no legitimate traffic remains.",{"_3603":2153,"_31069":2119,"_21510":57435,"_5":14782,"_28250":57362,"_3059":57436},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3603":2154,"_31069":2119,"_21510":57438,"_5":14782,"_28250":57366,"_3059":57439},[],"Certificates entering the preventive or critical renewal window.",{"_3603":2155,"_31069":2119,"_21510":57441,"_5":14782,"_28250":57366,"_3059":57442},[],"Repeated enrollment or re-enrollment failures.",{"_3603":2156,"_31069":2119,"_21510":57444,"_5":14782,"_28250":57366,"_3059":57445},[],"Status changes and revocation reasons.",{"_3603":2157,"_31069":2119,"_21510":57447,"_5":14782,"_28250":57366,"_3059":57448},[],"OCSP and CRL publication and validity.",{"_3603":2158,"_31069":2119,"_21510":57450,"_5":14782,"_28250":57366,"_3059":57451},[],"Dependencies still presenting a replaced certificate.",{"_3603":2159,"_31069":2119,"_21510":57453,"_5":14782,"_28250":57366,"_3059":57454},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3603":2160,"_31069":2160,"_5":15147,"_3059":57456,"_31428":57457,"_21510":57458,"_28250":2160},"Trust model",[50742,52254,56420,57323],[],{"_3603":2161,"_31069":2160,"_21510":57460,"_5":14782,"_28250":2160,"_3059":57461},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3603":2162,"_31069":2160,"_5":31425,"_21510":57463,"_28250":57464,"_3059":57465},[],"/docs/pr-preview/pr-74/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3603":2163,"_31069":2160,"_5":31425,"_21510":57467,"_28250":57468,"_3059":57469},[],"/docs/pr-preview/pr-74/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3603":2164,"_31069":2160,"_5":31425,"_21510":57471,"_28250":57472,"_3059":57473},[],"/docs/pr-preview/pr-74/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3603":2165,"_31069":2160,"_5":31425,"_21510":57475,"_28250":57476,"_3059":57477},[],"/docs/pr-preview/pr-74/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3603":2166,"_31069":2160,"_5":31425,"_21510":57479,"_28250":57480,"_3059":57481},[],"/docs/pr-preview/pr-74/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3603":2167,"_31069":2160,"_5":31425,"_21510":57483,"_28250":57484,"_3059":57485},[],"/docs/pr-preview/pr-74/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3603":2168,"_31069":2160,"_5":31425,"_21510":57487,"_28250":57488,"_3059":57489},[],"/docs/pr-preview/pr-74/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3603":2169,"_31069":2160,"_5":31425,"_21510":57491,"_28250":57492,"_3059":57493},[],"/docs/pr-preview/pr-74/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3603":2170,"_31069":2160,"_5":31425,"_21510":57495,"_28250":57496,"_3059":57497},[],"/docs/pr-preview/pr-74/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3603":2171,"_31069":2160,"_5":31425,"_21510":57499,"_28250":57500,"_3059":57501},[],"/docs/pr-preview/pr-74/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3603":2172,"_31069":2160,"_21510":57503,"_5":14782,"_28250":2160,"_3059":57504},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3603":2173,"_31069":2160,"_21510":57506,"_5":14782,"_28250":57468,"_3059":57507},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3603":2174,"_31069":2160,"_21510":57509,"_5":14782,"_28250":57472,"_3059":57510},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3603":2175,"_31069":2160,"_21510":57512,"_5":14782,"_28250":57476,"_3059":57513},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3603":2176,"_31069":2160,"_21510":57515,"_5":14782,"_28250":57480,"_3059":57516},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3603":2177,"_31069":2160,"_21510":57518,"_5":14782,"_28250":57484,"_3059":57519},[],"The device proves it can enroll according to the DMS policy.",{"_3603":2178,"_31069":2160,"_21510":57521,"_5":14782,"_28250":57484,"_3059":57522},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3603":2179,"_31069":2160,"_21510":57524,"_5":14782,"_28250":57484,"_3059":57525},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3603":2180,"_31069":2160,"_21510":57527,"_5":14782,"_28250":57484,"_3059":57528},[],"The device installs the certificate and the chain it needs.",{"_3603":2181,"_31069":2160,"_21510":57530,"_5":14782,"_28250":57484,"_3059":57531},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3603":2182,"_31069":2160,"_21510":57533,"_5":14782,"_28250":57484,"_3059":57534},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3603":2183,"_31069":2160,"_21510":57536,"_5":14782,"_28250":57488,"_3059":57537},[],"A DMS relates three sets that are worth designing separately:",{"_3603":2184,"_31069":2160,"_21510":57539,"_5":14782,"_28250":57488,"_3059":57540},[],"**Enrollment CA:** signs the new identities.",{"_3603":2185,"_31069":2160,"_21510":57542,"_5":14782,"_28250":57488,"_3059":57543},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3603":2186,"_31069":2160,"_21510":57545,"_5":14782,"_28250":57488,"_3059":57546},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3603":2187,"_31069":2160,"_21510":57548,"_5":14782,"_28250":57488,"_3059":57549},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3603":2188,"_31069":2160,"_21510":57551,"_5":14782,"_28250":57492,"_3059":57552},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3603":2189,"_31069":2160,"_21510":57554,"_5":14782,"_28250":57492,"_3059":57555},[],"that the current date is between `Not Before` and `Not After`;",{"_3603":2190,"_31069":2160,"_21510":57557,"_5":14782,"_28250":57492,"_3059":57558},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3603":2191,"_31069":2160,"_21510":57560,"_5":14782,"_28250":57492,"_3059":57561},[],"that names, SANs and subject match the expected identity;",{"_3603":2192,"_31069":2160,"_21510":57563,"_5":14782,"_28250":57492,"_3059":57564},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3603":2193,"_31069":2160,"_21510":57566,"_5":14782,"_28250":57492,"_3059":57567},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3603":2194,"_31069":2160,"_21510":57569,"_5":14782,"_28250":57492,"_3059":57570},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3603":2195,"_31069":2160,"_21510":57572,"_5":14782,"_28250":57496,"_3059":57573},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3603":2196,"_31069":2160,"_21510":57575,"_5":14782,"_28250":57500,"_3059":57576},[],"Keep the root out of daily operations, or with very restricted access.",{"_3603":2197,"_31069":2160,"_21510":57578,"_5":14782,"_28250":57500,"_3059":57579},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3603":2198,"_31069":2160,"_21510":57581,"_5":14782,"_28250":57500,"_3059":57582},[],"Assign explicit profiles to every use case.",{"_3603":2199,"_31069":2160,"_21510":57584,"_5":14782,"_28250":57500,"_3059":57585},[],"Distribute the new trust before starting a rotation.",{"_3603":2200,"_31069":2160,"_21510":57587,"_5":14782,"_28250":57500,"_3059":57588},[],"Keep enough overlap to renew a disconnected fleet.",{"_3603":2201,"_31069":2160,"_21510":57590,"_5":14782,"_28250":57500,"_3059":57591},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3603":2202,"_31069":2160,"_21510":57593,"_5":14782,"_28250":57500,"_3059":57594},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3603":2203,"_31069":2203,"_5":15147,"_3059":57596,"_31428":57597,"_21510":57598,"_28250":2203},"Revocation lists (CRL)",[50742,52254,56420,57068],[],{"_3603":2204,"_31069":2203,"_21510":57600,"_5":14782,"_28250":2203,"_3059":57601},[],"Generate and distribute signed lists to validate certificates offline.",{"_3603":2205,"_31069":2203,"_5":31425,"_21510":57603,"_28250":57604,"_3059":57605},[],"/docs/pr-preview/pr-74/platform/pki/crl#crl-settings","CRL settings",{"_3603":2206,"_31069":2203,"_5":31425,"_21510":57607,"_28250":57608,"_3059":57609},[],"/docs/pr-preview/pr-74/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3603":2207,"_31069":2203,"_5":31425,"_21510":57611,"_28250":57612,"_3059":57613},[],"/docs/pr-preview/pr-74/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3603":2208,"_31069":2203,"_5":31425,"_21510":57615,"_28250":57616,"_3059":57617},[],"/docs/pr-preview/pr-74/platform/pki/crl#crl-contents","CRL contents",{"_3603":2209,"_31069":2203,"_5":31425,"_21510":57619,"_28250":57620,"_3059":57621},[],"/docs/pr-preview/pr-74/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3603":2210,"_31069":2203,"_5":31425,"_21510":57623,"_28250":57624,"_3059":57625},[],"/docs/pr-preview/pr-74/platform/pki/crl#crl-settings-api","CRL settings API",{"_3603":2211,"_31069":2203,"_5":31425,"_21510":57627,"_28250":57628,"_3059":57629},[],"/docs/pr-preview/pr-74/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3603":2212,"_31069":2203,"_5":31425,"_21510":57631,"_28250":57632,"_3059":57633},[],"/docs/pr-preview/pr-74/platform/pki/crl#references","References",{"_3603":2213,"_31069":2203,"_21510":57635,"_5":14782,"_28250":2203,"_3059":57636},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3603":2214,"_31069":2203,"_21510":57638,"_5":14782,"_28250":57604,"_3059":57639},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3603":2215,"_31069":2203,"_21510":57641,"_5":14782,"_28250":57604,"_3059":57642},[],"Field",{"_3603":2216,"_31069":2203,"_21510":57644,"_5":14782,"_28250":57604,"_3059":51132},[],{"_3603":2217,"_31069":2203,"_21510":57646,"_5":14782,"_28250":57604,"_3059":52374},[],{"_3603":2218,"_31069":2203,"_21510":57648,"_5":14782,"_28250":57604,"_3059":57649},[],"ID of the CA the settings belong to.",{"_3603":2219,"_31069":2203,"_21510":57651,"_5":14782,"_28250":57604,"_3059":57652},[],"`status`",{"_3603":2220,"_31069":2203,"_21510":57654,"_5":14782,"_28250":57604,"_3059":57655},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3603":2221,"_31069":2203,"_21510":57657,"_5":14782,"_28250":57604,"_3059":57658},[],"`legacy_ski`",{"_3603":2222,"_31069":2203,"_21510":57660,"_5":14782,"_28250":57604,"_3059":57661},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3603":2223,"_31069":2203,"_21510":57663,"_5":14782,"_28250":57604,"_3059":57664},[],"`latest_crl`",{"_3603":2224,"_31069":2203,"_21510":57666,"_5":14782,"_28250":57604,"_3059":57667},[],"Version, validity start and end of the last published list. Read-only.",{"_3603":2225,"_31069":2203,"_21510":57669,"_5":14782,"_28250":57604,"_3059":57670},[],"`crl_options` field",{"_3603":2226,"_31069":2203,"_21510":57672,"_5":14782,"_28250":57604,"_3059":51132},[],{"_3603":2227,"_31069":2203,"_21510":57674,"_5":14782,"_28250":57604,"_3059":57675},[],"Initial value",{"_3603":2228,"_31069":2203,"_21510":57677,"_5":14782,"_28250":57604,"_3059":57678},[],"`validity`",{"_3603":2229,"_31069":2203,"_21510":57680,"_5":14782,"_28250":57604,"_3059":57681},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3603":2230,"_31069":2203,"_21510":57683,"_5":14782,"_28250":57604,"_3059":57684},[],"7 days.",{"_3603":2231,"_31069":2203,"_21510":57686,"_5":14782,"_28250":57604,"_3059":57687},[],"`refresh_interval`",{"_3603":2232,"_31069":2203,"_21510":57689,"_5":14782,"_28250":57604,"_3059":57690},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3603":2233,"_31069":2203,"_21510":57692,"_5":14782,"_28250":57604,"_3059":57693},[],"6 days and 23 hours.",{"_3603":2234,"_31069":2203,"_21510":57695,"_5":14782,"_28250":57604,"_3059":57696},[],"`regenerate_on_revoke`",{"_3603":2235,"_31069":2203,"_21510":57698,"_5":14782,"_28250":57604,"_3059":57699},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3603":2236,"_31069":2203,"_21510":57701,"_5":14782,"_28250":57604,"_3059":57702},[],"`true`.",{"_3603":2237,"_31069":2203,"_21510":57704,"_5":14782,"_28250":57604,"_3059":57705},[],"`signer_serial_number`",{"_3603":2238,"_31069":2203,"_21510":57707,"_5":14782,"_28250":57604,"_3059":57708},[],"Serial number of the existing certificate that signs the CRL.",{"_3603":2239,"_31069":2203,"_21510":57710,"_5":14782,"_28250":57604,"_3059":57711},[],"Serial number of the CA’s current certificate.",{"_3603":2240,"_31069":2203,"_21510":57713,"_5":14782,"_28250":57604,"_3059":57714},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3603":2241,"_31069":2203,"_21510":57716,"_5":14782,"_28250":57604,"_3059":57717},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3603":2242,"_31069":2203,"_21510":57719,"_5":14782,"_28250":57604,"_3059":57720},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3603":2243,"_31069":2203,"_21510":57722,"_5":14782,"_28250":57604,"_3059":57723},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3603":2244,"_31069":2203,"_21510":57725,"_5":14782,"_28250":57604,"_3059":57726},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3603":2245,"_31069":2203,"_21510":57728,"_5":14782,"_28250":57604,"_3059":57729},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3603":2246,"_31069":2203,"_21510":57731,"_5":14782,"_28250":57604,"_3059":57732},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3603":2247,"_31069":2203,"_21510":57734,"_5":14782,"_28250":57604,"_3059":57735},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3603":2248,"_31069":2203,"_21510":57737,"_5":14782,"_28250":57604,"_3059":57738},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3603":2249,"_31069":2203,"_21510":57740,"_5":14782,"_28250":57604,"_3059":57741},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3603":2250,"_31069":2203,"_21510":57743,"_5":14782,"_28250":57604,"_3059":57744},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3603":2251,"_31069":2203,"_21510":57746,"_5":14782,"_28250":57608,"_3059":57747},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3603":2252,"_31069":2203,"_21510":57749,"_5":14782,"_28250":57608,"_3059":57750},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3603":2253,"_31069":2203,"_21510":57752,"_5":14782,"_28250":57608,"_3059":57753},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3603":2254,"_31069":2203,"_21510":57755,"_5":14782,"_28250":57608,"_3059":57756},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3603":2255,"_31069":2203,"_21510":57758,"_5":14782,"_28250":57612,"_3059":57759},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3603":2256,"_31069":2203,"_21510":57761,"_5":14782,"_28250":57612,"_3059":57762},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3603":2257,"_31069":2203,"_21510":57764,"_5":14782,"_28250":57612,"_3059":57765},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3603":2258,"_31069":2203,"_21510":57767,"_5":14782,"_28250":57612,"_3059":57768},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3603":2259,"_31069":2203,"_21510":57770,"_5":14782,"_28250":57612,"_3059":57771},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3603":2260,"_31069":2203,"_21510":57773,"_5":14782,"_28250":57612,"_3059":57774},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3603":2261,"_31069":2203,"_21510":57776,"_5":14782,"_28250":57612,"_3059":57777},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3603":2262,"_31069":2203,"_21510":57779,"_5":14782,"_28250":57612,"_3059":57780},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3603":2263,"_31069":2203,"_21510":57782,"_5":14782,"_28250":57612,"_3059":57783},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3603":2264,"_31069":2203,"_21510":57785,"_5":14782,"_28250":57616,"_3059":57786},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3603":2265,"_31069":2203,"_21510":57788,"_5":14782,"_28250":57616,"_3059":57789},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3603":2266,"_31069":2203,"_21510":57791,"_5":14782,"_28250":57620,"_3059":57792},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3603":2267,"_31069":2203,"_21510":57794,"_5":14782,"_28250":57620,"_3059":57795},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3603":2268,"_31069":2203,"_21510":57797,"_5":14782,"_28250":57620,"_3059":57798},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3603":2269,"_31069":2203,"_21510":57800,"_5":14782,"_28250":57620,"_3059":57801},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3603":2270,"_31069":2203,"_21510":57803,"_5":14782,"_28250":57620,"_3059":57804},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3603":2271,"_31069":2203,"_21510":57806,"_5":14782,"_28250":57624,"_3059":57807},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3603":2272,"_31069":2203,"_21510":57809,"_5":14782,"_28250":57624,"_3059":54185},[],{"_3603":2273,"_31069":2203,"_21510":57811,"_5":14782,"_28250":57624,"_3059":57812},[],"Relative path",{"_3603":2274,"_31069":2203,"_21510":57814,"_5":14782,"_28250":57624,"_3059":54182},[],{"_3603":2275,"_31069":2203,"_21510":57816,"_5":14782,"_28250":57624,"_3059":57817},[],"`GET`",{"_3603":2276,"_31069":2203,"_21510":57819,"_5":14782,"_28250":57624,"_3059":57820},[],"`/v1/crl-settings`",{"_3603":2277,"_31069":2203,"_21510":57822,"_5":14782,"_28250":57624,"_3059":57823},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3603":2278,"_31069":2203,"_21510":57825,"_5":14782,"_28250":57624,"_3059":57817},[],{"_3603":2279,"_31069":2203,"_21510":57827,"_5":14782,"_28250":57624,"_3059":57828},[],"`/v1/crl-settings/{ca-id}`",{"_3603":2280,"_31069":2203,"_21510":57830,"_5":14782,"_28250":57624,"_3059":57831},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3603":2281,"_31069":2203,"_21510":57833,"_5":14782,"_28250":57624,"_3059":57834},[],"`PUT`",{"_3603":2282,"_31069":2203,"_21510":57836,"_5":14782,"_28250":57624,"_3059":57828},[],{"_3603":2283,"_31069":2203,"_21510":57838,"_5":14782,"_28250":57624,"_3059":57839},[],"Replace the CRL configuration of a CA.",{"_3603":2284,"_31069":2203,"_21510":57841,"_5":14782,"_28250":57624,"_3059":57842},[],"`DELETE`",{"_3603":2285,"_31069":2203,"_21510":57844,"_5":14782,"_28250":57624,"_3059":57828},[],{"_3603":2286,"_31069":2203,"_21510":57846,"_5":14782,"_28250":57624,"_3059":57847},[],"Remove the archived CRL settings of a CA.",{"_3603":2287,"_31069":2203,"_21510":57849,"_5":14782,"_28250":57624,"_3059":57850},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3603":2288,"_31069":2203,"_21510":57852,"_5":14782,"_28250":57624,"_3059":57853},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3603":2289,"_31069":2203,"_21510":57855,"_5":14782,"_28250":57624,"_3059":57856},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3603":2290,"_31069":2203,"_21510":57858,"_5":14782,"_28250":57628,"_3059":57859},[],"Symptom",{"_3603":2291,"_31069":2203,"_21510":57861,"_5":14782,"_28250":57628,"_3059":57862},[],"Cause",{"_3603":2292,"_31069":2203,"_21510":57864,"_5":14782,"_28250":57628,"_3059":57865},[],"Action",{"_3603":2293,"_31069":2203,"_21510":57867,"_5":14782,"_28250":57628,"_3059":57868},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3603":2294,"_31069":2203,"_21510":57870,"_5":14782,"_28250":57628,"_3059":57871},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3603":2295,"_31069":2203,"_21510":57873,"_5":14782,"_28250":57628,"_3059":57874},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3603":2296,"_31069":2203,"_21510":57876,"_5":14782,"_28250":57628,"_3059":57877},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3603":2297,"_31069":2203,"_21510":57879,"_5":14782,"_28250":57628,"_3059":57880},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3603":2298,"_31069":2203,"_21510":57882,"_5":14782,"_28250":57628,"_3059":57883},[],"Delete the CA first; deleting it archives its settings.",{"_3603":2299,"_31069":2203,"_21510":57885,"_5":14782,"_28250":57628,"_3059":57886},[],"`PUT` returns 400.",{"_3603":2300,"_31069":2203,"_21510":57888,"_5":14782,"_28250":57628,"_3059":57889},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3603":2301,"_31069":2203,"_21510":57891,"_5":14782,"_28250":57628,"_3059":57892},[],"Set the serial number of a valid certificate of that CA.",{"_3603":2302,"_31069":2203,"_21510":57894,"_5":14782,"_28250":57628,"_3059":57895},[],"`PUT` returns 404.",{"_3603":2303,"_31069":2203,"_21510":57897,"_5":14782,"_28250":57628,"_3059":57898},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3603":2304,"_31069":2203,"_21510":57900,"_5":14782,"_28250":57628,"_3059":57901},[],"Check the CA ID and the signer serial number.",{"_3603":2305,"_31069":2203,"_21510":57903,"_5":14782,"_28250":57628,"_3059":57904},[],"`PUT` returns 400 from a 3.x client.",{"_3603":2306,"_31069":2203,"_21510":57906,"_5":14782,"_28250":57628,"_3059":57907},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3603":2307,"_31069":2203,"_21510":57909,"_5":14782,"_28250":57628,"_3059":57910},[],"Update the client to send the new field.",{"_3603":2308,"_31069":2203,"_21510":57912,"_5":14782,"_28250":57628,"_3059":57913},[],"The CRL does not change after revoking a certificate.",{"_3603":2309,"_31069":2203,"_21510":57915,"_5":14782,"_28250":57628,"_3059":57916},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3603":2310,"_31069":2203,"_21510":57918,"_5":14782,"_28250":57628,"_3059":57919},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3603":2311,"_31069":2203,"_21510":57921,"_5":14782,"_28250":57628,"_3059":57922},[],"A verifier rejects the CRL because of the issuer.",{"_3603":2312,"_31069":2203,"_21510":57924,"_5":14782,"_28250":57628,"_3059":57925},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3603":2313,"_31069":2203,"_21510":57927,"_5":14782,"_28250":57628,"_3059":57928},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3603":2314,"_31069":2203,"_21510":57930,"_5":14782,"_28250":57632,"_3059":57931},[],"RFC 5280: X.509 and CRL profile.",{"_3603":2315,"_31069":2203,"_21510":57933,"_5":14782,"_28250":57632,"_3059":57934},[],"OpenSSL: openssl-crl.",{"_3603":2316,"_31069":2203,"_21510":57936,"_5":14782,"_28250":57632,"_3059":57937},[],"OpenSSL: openssl-verify.",{"_3603":2317,"_31069":2203,"_21510":57939,"_5":14782,"_28250":57632,"_3059":57940},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3603":2318,"_31069":2203,"_21510":57942,"_5":14782,"_28250":57632,"_3059":57943},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3603":2319,"_31069":2319,"_5":15147,"_3059":57945,"_31428":57946,"_21510":57947,"_28250":2319},"Keys and cryptographic engines",[50742,52254,56420,56421],[],{"_3603":2320,"_31069":2319,"_21510":57949,"_5":14782,"_28250":2319,"_3059":57950},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3603":2321,"_31069":2319,"_5":31425,"_21510":57952,"_28250":57953,"_3059":57954},[],"/docs/pr-preview/pr-74/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3603":2322,"_31069":2319,"_5":31425,"_21510":57956,"_28250":57957,"_3059":57958},[],"/docs/pr-preview/pr-74/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3603":2323,"_31069":2319,"_5":31425,"_21510":57960,"_28250":57961,"_3059":57962},[],"/docs/pr-preview/pr-74/platform/pki/key-management#file-system","File System",{"_3603":2324,"_31069":2319,"_5":31425,"_21510":57964,"_28250":57965,"_3059":57966},[],"/docs/pr-preview/pr-74/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3603":2325,"_31069":2319,"_5":31425,"_21510":57968,"_28250":57969,"_3059":57970},[],"/docs/pr-preview/pr-74/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3603":2326,"_31069":2319,"_5":31425,"_21510":57972,"_28250":57973,"_3059":57974},[],"/docs/pr-preview/pr-74/platform/pki/key-management#aws-kms","AWS KMS",{"_3603":2327,"_31069":2319,"_5":31425,"_21510":57976,"_28250":57977,"_3059":57978},[],"/docs/pr-preview/pr-74/platform/pki/key-management#pkcs11","PKCS#11",{"_3603":2328,"_31069":2319,"_5":31425,"_21510":57980,"_28250":57981,"_3059":57982},[],"/docs/pr-preview/pr-74/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3603":2329,"_31069":2319,"_5":31425,"_21510":57984,"_28250":57985,"_3059":57986},[],"/docs/pr-preview/pr-74/platform/pki/key-management#key-inventory","Key inventory",{"_3603":2330,"_31069":2319,"_5":31425,"_21510":57988,"_28250":57989,"_3059":57990},[],"/docs/pr-preview/pr-74/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3603":2331,"_31069":2319,"_5":31425,"_21510":57992,"_28250":57993,"_3059":57994},[],"/docs/pr-preview/pr-74/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3603":2332,"_31069":2319,"_5":31425,"_21510":57996,"_28250":57997,"_3059":57998},[],"/docs/pr-preview/pr-74/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3603":2333,"_31069":2319,"_5":31425,"_21510":58000,"_28250":58001,"_3059":58002},[],"/docs/pr-preview/pr-74/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3603":2334,"_31069":2319,"_5":31425,"_21510":58004,"_28250":58005,"_3059":58006},[],"/docs/pr-preview/pr-74/platform/pki/key-management#view-details","View details",{"_3603":2335,"_31069":2319,"_5":31425,"_21510":58008,"_28250":58009,"_3059":58010},[],"/docs/pr-preview/pr-74/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3603":2336,"_31069":2319,"_5":31425,"_21510":58012,"_28250":58013,"_3059":58014},[],"/docs/pr-preview/pr-74/platform/pki/key-management#sign","Sign",{"_3603":2337,"_31069":2319,"_5":31425,"_21510":58016,"_28250":58017,"_3059":58018},[],"/docs/pr-preview/pr-74/platform/pki/key-management#verify","Verify",{"_3603":2338,"_31069":2319,"_5":31425,"_21510":58020,"_28250":58021,"_3059":58022},[],"/docs/pr-preview/pr-74/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3603":2339,"_31069":2319,"_5":31425,"_21510":58024,"_28250":58025,"_3059":58026},[],"/docs/pr-preview/pr-74/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3603":2340,"_31069":2319,"_5":31425,"_21510":58028,"_28250":58029,"_3059":58030},[],"/docs/pr-preview/pr-74/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3603":2341,"_31069":2319,"_21510":58032,"_5":14782,"_28250":2319,"_3059":58033},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3603":2342,"_31069":2319,"_21510":58035,"_5":14782,"_28250":2319,"_3059":58036},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3603":2343,"_31069":2319,"_21510":58038,"_5":14782,"_28250":57953,"_3059":58039},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3603":2344,"_31069":2319,"_21510":58041,"_5":14782,"_28250":57953,"_3059":58042},[],"In practice, it lets you:",{"_3603":2345,"_31069":2319,"_21510":58044,"_5":14782,"_28250":57953,"_3059":58045},[],"Generate new key pairs from Lamassu IoT.",{"_3603":2346,"_31069":2319,"_21510":58047,"_5":14782,"_28250":57953,"_3059":58048},[],"Import keys created externally.",{"_3603":2347,"_31069":2319,"_21510":58050,"_5":14782,"_28250":57953,"_3059":58051},[],"Delegate custody and cryptographic operations to external engines.",{"_3603":2348,"_31069":2319,"_21510":58053,"_5":14782,"_28250":57953,"_3059":58054},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3603":2349,"_31069":2319,"_21510":58056,"_5":14782,"_28250":57957,"_3059":58057},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3603":2350,"_31069":2319,"_21510":58059,"_5":14782,"_28250":57957,"_3059":58060},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3603":2351,"_31069":2319,"_21510":58062,"_5":14782,"_28250":57957,"_3059":58063},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3603":2352,"_31069":2319,"_21510":58065,"_5":14782,"_28250":57961,"_3059":58066},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3603":2353,"_31069":2319,"_21510":58068,"_5":14782,"_28250":57965,"_3059":58069},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3603":2354,"_31069":2319,"_21510":58071,"_5":14782,"_28250":57965,"_3059":58072},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3603":2355,"_31069":2319,"_21510":58074,"_5":14782,"_28250":57969,"_3059":58075},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3603":2356,"_31069":2319,"_21510":58077,"_5":14782,"_28250":57973,"_3059":58078},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3603":2357,"_31069":2319,"_21510":58080,"_5":14782,"_28250":57977,"_3059":58081},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3603":2358,"_31069":2319,"_21510":58083,"_5":14782,"_28250":57981,"_3059":58084},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3603":2359,"_31069":2319,"_21510":58086,"_5":14782,"_28250":57981,"_3059":58087},[],"Lamassu shows the enabled engines in the console.",{"_3603":2360,"_31069":2319,"_21510":58089,"_5":14782,"_28250":57981,"_3059":58090},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3603":2361,"_31069":2319,"_21510":58092,"_5":14782,"_28250":57981,"_3059":58093},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3603":2362,"_31069":2319,"_21510":58095,"_5":14782,"_28250":57985,"_3059":58096},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3603":2363,"_31069":2319,"_21510":58098,"_5":14782,"_28250":57985,"_3059":58099},[],"The table includes the following fields:",{"_3603":2364,"_31069":2319,"_21510":58101,"_5":14782,"_28250":57985,"_3059":58102},[],"**Name**: descriptive name of the key.",{"_3603":2365,"_31069":2319,"_21510":58104,"_5":14782,"_28250":57985,"_3059":58105},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3603":2366,"_31069":2319,"_21510":58107,"_5":14782,"_28250":57985,"_3059":58108},[],"**Strength**: visual indicator of cryptographic strength.",{"_3603":2367,"_31069":2319,"_21510":58110,"_5":14782,"_28250":57985,"_3059":58111},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3603":2368,"_31069":2319,"_21510":58113,"_5":14782,"_28250":57985,"_3059":58114},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3603":2369,"_31069":2319,"_21510":58116,"_5":14782,"_28250":57985,"_3059":58117},[],"**Aliases**: alternative names associated with the key.",{"_3603":2370,"_31069":2319,"_21510":58119,"_5":14782,"_28250":57985,"_3059":58120},[],"**Tags**: labels for classification and search.",{"_3603":2371,"_31069":2319,"_21510":58122,"_5":14782,"_28250":57985,"_3059":58123},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3603":2372,"_31069":2319,"_21510":58125,"_5":14782,"_28250":57985,"_3059":58126},[],"From this view you also reach the most common actions:",{"_3603":2373,"_31069":2319,"_21510":58128,"_5":14782,"_28250":57985,"_3059":58129},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3603":2374,"_31069":2319,"_21510":58131,"_5":14782,"_28250":57985,"_3059":58132},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3603":2375,"_31069":2319,"_21510":58134,"_5":14782,"_28250":57985,"_3059":58135},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3603":2376,"_31069":2319,"_21510":58137,"_5":14782,"_28250":57985,"_3059":58138},[],"**Delete Key** to remove the key from the system.",{"_3603":2377,"_31069":2319,"_21510":58140,"_5":14782,"_28250":57989,"_3059":58141},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3603":2378,"_31069":2319,"_21510":58143,"_5":14782,"_28250":57993,"_3059":58144},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3603":2379,"_31069":2319,"_21510":58146,"_5":14782,"_28250":57993,"_3059":58147},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3603":2380,"_31069":2319,"_21510":58149,"_5":14782,"_28250":57993,"_3059":58150},[],"**Key Name**: unique and descriptive name.",{"_3603":2381,"_31069":2319,"_21510":58152,"_5":14782,"_28250":57993,"_3059":58153},[],"**Crypto Engine**: engine that will keep the key.",{"_3603":2382,"_31069":2319,"_21510":58155,"_5":14782,"_28250":57993,"_3059":58156},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3603":2383,"_31069":2319,"_21510":58158,"_5":14782,"_28250":57993,"_3059":58159},[],"**Tags**: metadata to classify the key.",{"_3603":2384,"_31069":2319,"_21510":58161,"_5":14782,"_28250":57993,"_3059":58162},[],"**Metadata**: additional information for advanced uses.",{"_3603":2385,"_31069":2319,"_21510":58164,"_5":14782,"_28250":57997,"_3059":58165},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3603":2386,"_31069":2319,"_21510":58167,"_5":14782,"_28250":57997,"_3059":58168},[],"When you have an exportable private key and the destination engine supports import.",{"_3603":2387,"_31069":2319,"_21510":58170,"_5":14782,"_28250":57997,"_3059":58171},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3603":2388,"_31069":2319,"_21510":58173,"_5":14782,"_28250":57997,"_3059":58174},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3603":2389,"_31069":2319,"_21510":58176,"_5":14782,"_28250":57997,"_3059":58177},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3603":2390,"_31069":2319,"_21510":58179,"_5":14782,"_28250":57997,"_3059":58180},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3603":2391,"_31069":2319,"_21510":58182,"_5":14782,"_28250":57997,"_3059":58183},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3603":2392,"_31069":2319,"_21510":58185,"_5":14782,"_28250":57997,"_3059":58186},[],"**Tags**: labels for organization and search.",{"_3603":2393,"_31069":2319,"_21510":58188,"_5":14782,"_28250":57997,"_3059":58189},[],"**Metadata**: additional optional information.",{"_3603":2394,"_31069":2319,"_21510":58191,"_5":14782,"_28250":57997,"_3059":58192},[],"**Private Key (PEM)**: private key in PEM format.",{"_3603":2395,"_31069":2319,"_21510":58194,"_5":14782,"_28250":57997,"_3059":58195},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3603":2396,"_31069":2319,"_21510":58197,"_5":14782,"_28250":58001,"_3059":58198},[],"Each registered key has a detail view and several operational actions.",{"_3603":2397,"_31069":2319,"_21510":58200,"_5":14782,"_28250":58005,"_3059":58201},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3603":2398,"_31069":2319,"_21510":58203,"_5":14782,"_28250":58005,"_3059":58204},[],"The **Overview** tab shows, among others, these fields:",{"_3603":2399,"_31069":2319,"_21510":58206,"_5":14782,"_28250":58005,"_3059":58207},[],"**Key Name**: descriptive name.",{"_3603":2400,"_31069":2319,"_21510":58209,"_5":14782,"_28250":58005,"_3059":58210},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3603":2401,"_31069":2319,"_21510":58212,"_5":14782,"_28250":58005,"_3059":58213},[],"**Tags**: associated labels.",{"_3603":2402,"_31069":2319,"_21510":58215,"_5":14782,"_28250":58005,"_3059":58216},[],"**Aliases**: alternative names.",{"_3603":2403,"_31069":2319,"_21510":58218,"_5":14782,"_28250":58005,"_3059":58219},[],"**Crypto Engine**: engine where the key resides.",{"_3603":2404,"_31069":2319,"_21510":58221,"_5":14782,"_28250":58005,"_3059":58222},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3603":2405,"_31069":2319,"_21510":58224,"_5":14782,"_28250":58005,"_3059":58225},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3603":2406,"_31069":2319,"_21510":58227,"_5":14782,"_28250":58005,"_3059":58228},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3603":2407,"_31069":2319,"_21510":58230,"_5":14782,"_28250":58009,"_3059":58231},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3603":2408,"_31069":2319,"_21510":58233,"_5":14782,"_28250":58009,"_3059":58234},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3603":2409,"_31069":2319,"_21510":58236,"_5":14782,"_28250":58009,"_3059":58237},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3603":2410,"_31069":2319,"_21510":58239,"_5":14782,"_28250":58013,"_3059":58240},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3603":2411,"_31069":2319,"_21510":58242,"_5":14782,"_28250":58013,"_3059":58243},[],"Main fields:",{"_3603":2412,"_31069":2319,"_21510":58245,"_5":14782,"_28250":58013,"_3059":58246},[],"**Algorithm**: signing algorithm available for the key type.",{"_3603":2413,"_31069":2319,"_21510":58248,"_5":14782,"_28250":58013,"_3059":58249},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3603":2414,"_31069":2319,"_21510":58251,"_5":14782,"_28250":58013,"_3059":58252},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3603":2415,"_31069":2319,"_21510":58254,"_5":14782,"_28250":58013,"_3059":58255},[],"**Message**: content to sign.",{"_3603":2416,"_31069":2319,"_21510":58257,"_5":14782,"_28250":58013,"_3059":58258},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3603":2417,"_31069":2319,"_21510":58260,"_5":14782,"_28250":58017,"_3059":58261},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3603":2418,"_31069":2319,"_21510":58263,"_5":14782,"_28250":58017,"_3059":58243},[],{"_3603":2419,"_31069":2319,"_21510":58265,"_5":14782,"_28250":58017,"_3059":58266},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3603":2420,"_31069":2319,"_21510":58268,"_5":14782,"_28250":58017,"_3059":58269},[],"**Message Type**: `Raw` or `Digest`.",{"_3603":2421,"_31069":2319,"_21510":58271,"_5":14782,"_28250":58017,"_3059":58272},[],"**Payload Encoding**: encoding of the message.",{"_3603":2422,"_31069":2319,"_21510":58274,"_5":14782,"_28250":58017,"_3059":58275},[],"**Message**: original message or hash.",{"_3603":2423,"_31069":2319,"_21510":58277,"_5":14782,"_28250":58017,"_3059":58278},[],"**Signature**: signature to check.",{"_3603":2424,"_31069":2319,"_21510":58280,"_5":14782,"_28250":58017,"_3059":58281},[],"**Result**: indicator of the validation result.",{"_3603":2425,"_31069":2319,"_21510":58283,"_5":14782,"_28250":58021,"_3059":58284},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3603":2426,"_31069":2319,"_21510":58286,"_5":14782,"_28250":58021,"_3059":58287},[],"This flow is useful for:",{"_3603":2427,"_31069":2319,"_21510":58289,"_5":14782,"_28250":58021,"_3059":58290},[],"Requesting certificates from an external CA.",{"_3603":2428,"_31069":2319,"_21510":58292,"_5":14782,"_28250":58021,"_3059":58293},[],"Renewing an identity while keeping the same key.",{"_3603":2429,"_31069":2319,"_21510":58295,"_5":14782,"_28250":58021,"_3059":58296},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3603":2430,"_31069":2319,"_21510":58298,"_5":14782,"_28250":58021,"_3059":58299},[],"**Common Name (CN)**: main name of the identity.",{"_3603":2431,"_31069":2319,"_21510":58301,"_5":14782,"_28250":58021,"_3059":58302},[],"**Organization (O)**: organization or company.",{"_3603":2432,"_31069":2319,"_21510":58304,"_5":14782,"_28250":58021,"_3059":58305},[],"**Organizational Unit (OU)**: department or unit.",{"_3603":2433,"_31069":2319,"_21510":58307,"_5":14782,"_28250":58021,"_3059":58308},[],"**Country (C)**: two-letter country code.",{"_3603":2434,"_31069":2319,"_21510":58310,"_5":14782,"_28250":58021,"_3059":58311},[],"**State / Province (ST)**: state or province.",{"_3603":2435,"_31069":2319,"_21510":58313,"_5":14782,"_28250":58021,"_3059":58314},[],"**Locality (L)**: city or locality.",{"_3603":2436,"_31069":2319,"_21510":58316,"_5":14782,"_28250":58021,"_3059":58317},[],"**Email Address**: contact email.",{"_3603":2437,"_31069":2319,"_21510":58319,"_5":14782,"_28250":58021,"_3059":58320},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3603":2438,"_31069":2319,"_21510":58322,"_5":14782,"_28250":58021,"_3059":58323},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3603":2439,"_31069":2319,"_21510":58325,"_5":14782,"_28250":58025,"_3059":58326},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3603":2440,"_31069":2319,"_21510":58328,"_5":14782,"_28250":58025,"_3059":58329},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3603":2441,"_31069":2319,"_21510":58331,"_5":14782,"_28250":58029,"_3059":58332},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3603":2442,"_31069":2319,"_21510":58334,"_5":14782,"_28250":58029,"_3059":58335},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3603":2443,"_31069":2443,"_5":15147,"_3059":58337,"_31428":58338,"_21510":58339,"_28250":2443},"Online validation with OCSP",[50742,52254,56420,57068],[],{"_3603":2444,"_31069":2443,"_21510":58341,"_5":14782,"_28250":2443,"_3059":58342},[],"Query signed status and verify the responder’s response.",{"_3603":2445,"_31069":2443,"_5":31425,"_21510":58344,"_28250":58345,"_3059":58346},[],"/docs/pr-preview/pr-74/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3603":2446,"_31069":2443,"_5":31425,"_21510":58348,"_28250":58349,"_3059":58350},[],"/docs/pr-preview/pr-74/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3603":2447,"_31069":2443,"_5":31425,"_21510":58352,"_28250":58353,"_3059":58354},[],"/docs/pr-preview/pr-74/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3603":2448,"_31069":2443,"_5":31425,"_21510":58356,"_28250":58357,"_3059":58358},[],"/docs/pr-preview/pr-74/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3603":2449,"_31069":2443,"_5":31425,"_21510":58360,"_28250":58361,"_3059":58362},[],"/docs/pr-preview/pr-74/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3603":2450,"_31069":2443,"_5":31425,"_21510":58364,"_28250":58365,"_3059":57633},[],"/docs/pr-preview/pr-74/platform/pki/ocsp#references",{"_3603":2451,"_31069":2443,"_21510":58367,"_5":14782,"_28250":2443,"_3059":58368},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3603":2452,"_31069":2443,"_21510":58370,"_5":14782,"_28250":58345,"_3059":58371},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3603":2453,"_31069":2443,"_21510":58373,"_5":14782,"_28250":58345,"_3059":58374},[],"Record status",{"_3603":2454,"_31069":2443,"_21510":58376,"_5":14782,"_28250":58345,"_3059":58377},[],"Signed response",{"_3603":2455,"_31069":2443,"_21510":58379,"_5":14782,"_28250":58345,"_3059":55557},[],{"_3603":2456,"_31069":2443,"_21510":58381,"_5":14782,"_28250":58345,"_3059":58382},[],"`Good`.",{"_3603":2457,"_31069":2443,"_21510":58384,"_5":14782,"_28250":58345,"_3059":55574},[],{"_3603":2458,"_31069":2443,"_21510":58386,"_5":14782,"_28250":58345,"_3059":58387},[],"`Revoked`, with revocation reason and timestamp.",{"_3603":2459,"_31069":2443,"_21510":58389,"_5":14782,"_28250":58345,"_3059":58390},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3603":2460,"_31069":2443,"_21510":58392,"_5":14782,"_28250":58345,"_3059":58393},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3603":2461,"_31069":2443,"_21510":58395,"_5":14782,"_28250":58345,"_3059":58396},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3603":2462,"_31069":2443,"_21510":58398,"_5":14782,"_28250":58345,"_3059":58399},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3603":2463,"_31069":2443,"_21510":58401,"_5":14782,"_28250":58345,"_3059":58402},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3603":2464,"_31069":2443,"_21510":58404,"_5":14782,"_28250":58349,"_3059":58405},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3603":2465,"_31069":2443,"_21510":58407,"_5":14782,"_28250":58349,"_3059":58408},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3603":2466,"_31069":2443,"_21510":58410,"_5":14782,"_28250":58353,"_3059":58411},[],"The service accepts:",{"_3603":2467,"_31069":2443,"_21510":58413,"_5":14782,"_28250":58353,"_3059":54185},[],{"_3603":2468,"_31069":2443,"_21510":58415,"_5":14782,"_28250":58353,"_3059":58416},[],"VA service path",{"_3603":2469,"_31069":2443,"_21510":58418,"_5":14782,"_28250":58353,"_3059":58419},[],"Format",{"_3603":2470,"_31069":2443,"_21510":58421,"_5":14782,"_28250":58353,"_3059":58422},[],"`POST`",{"_3603":2471,"_31069":2443,"_21510":58424,"_5":14782,"_28250":58353,"_3059":58425},[],"`/ocsp`",{"_3603":2472,"_31069":2443,"_21510":58427,"_5":14782,"_28250":58353,"_3059":58428},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3603":2473,"_31069":2443,"_21510":58430,"_5":14782,"_28250":58353,"_3059":57817},[],{"_3603":2474,"_31069":2443,"_21510":58432,"_5":14782,"_28250":58353,"_3059":58433},[],"`/ocsp/{ocsp_request}`",{"_3603":2475,"_31069":2443,"_21510":58435,"_5":14782,"_28250":58353,"_3059":58436},[],"DER request encoded using padded URL Base64.",{"_3603":2476,"_31069":2443,"_21510":58438,"_5":14782,"_28250":58353,"_3059":58439},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3603":2477,"_31069":2443,"_21510":58441,"_5":14782,"_28250":58357,"_3059":58442},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3603":2478,"_31069":2443,"_21510":58444,"_5":14782,"_28250":58357,"_3059":58445},[],"Generate the request:",{"_3603":2479,"_31069":2443,"_21510":58447,"_5":14782,"_28250":58357,"_3059":58448},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3603":2480,"_31069":2443,"_21510":58450,"_5":14782,"_28250":58357,"_3059":58451},[],"Replace the example URL with the inspected endpoint:",{"_3603":2481,"_31069":2443,"_21510":58453,"_5":14782,"_28250":58357,"_3059":58454},[],"Verify the returned DER:",{"_3603":2482,"_31069":2443,"_21510":58456,"_5":14782,"_28250":58357,"_3059":58457},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3603":2483,"_31069":2443,"_21510":58459,"_5":14782,"_28250":58361,"_3059":58460},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3603":2484,"_31069":2443,"_21510":58462,"_5":14782,"_28250":58361,"_3059":58463},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3603":2485,"_31069":2443,"_21510":58465,"_5":14782,"_28250":58365,"_3059":58466},[],"RFC 6960: OCSP.",{"_3603":2486,"_31069":2443,"_21510":58468,"_5":14782,"_28250":58365,"_3059":58469},[],"OpenSSL: openssl-ocsp.",{"_3603":2487,"_31069":2443,"_21510":58471,"_5":14782,"_28250":58365,"_3059":58472},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3603":2488,"_31069":2443,"_21510":58474,"_5":14782,"_28250":58365,"_3059":57943},[],{"_3603":2489,"_31069":2489,"_5":15147,"_3059":56420,"_31428":58476,"_21510":58477,"_28250":2489},[50742,52254,56420],[],{"_3603":2490,"_31069":2489,"_21510":58479,"_5":14782,"_28250":2489,"_3059":58480},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3603":2491,"_31069":2489,"_5":31425,"_21510":58482,"_28250":58483,"_3059":55732},[],"/docs/pr-preview/pr-74/platform/pki/overview#start-here",{"_3603":2492,"_31069":2489,"_5":31425,"_21510":58485,"_28250":58486,"_3059":58487},[],"/docs/pr-preview/pr-74/platform/pki/overview#what-you-need","What you need",{"_3603":2493,"_31069":2489,"_5":31425,"_21510":58489,"_28250":58490,"_3059":56264},[],"/docs/pr-preview/pr-74/platform/pki/overview#core-capabilities",{"_3603":2494,"_31069":2489,"_5":31425,"_21510":58492,"_28250":58493,"_3059":56268},[],"/docs/pr-preview/pr-74/platform/pki/overview#build-your-trust-hierarchy",{"_3603":2495,"_31069":2489,"_5":31425,"_21510":58495,"_28250":58496,"_3059":56272},[],"/docs/pr-preview/pr-74/platform/pki/overview#protect-cryptographic-keys",{"_3603":2496,"_31069":2489,"_5":31425,"_21510":58498,"_28250":58499,"_3059":56276},[],"/docs/pr-preview/pr-74/platform/pki/overview#issue-and-control-certificates",{"_3603":2497,"_31069":2489,"_5":31425,"_21510":58501,"_28250":58502,"_3059":56284},[],"/docs/pr-preview/pr-74/platform/pki/overview#publish-validation-status",{"_3603":2498,"_31069":2489,"_5":31425,"_21510":58504,"_28250":58505,"_3059":58506},[],"/docs/pr-preview/pr-74/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3603":2499,"_31069":2489,"_5":31425,"_21510":58508,"_28250":58509,"_3059":57235},[],"/docs/pr-preview/pr-74/platform/pki/overview#continue",{"_3603":2500,"_31069":2489,"_21510":58511,"_5":14782,"_28250":2489,"_3059":58512},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3603":2501,"_31069":2489,"_21510":58514,"_5":14782,"_28250":58483,"_3059":58515},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3603":2502,"_31069":2489,"_21510":58517,"_5":14782,"_28250":58483,"_3059":58518},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3603":2503,"_31069":2489,"_21510":58520,"_5":14782,"_28250":58486,"_3059":58521},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3603":2504,"_31069":2489,"_21510":58523,"_5":14782,"_28250":58486,"_3059":58524},[],"An available cryptographic engine to keep the authority's key.",{"_3603":2505,"_31069":2489,"_21510":58526,"_5":14782,"_28250":58486,"_3059":58527},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3603":2506,"_31069":2489,"_21510":58529,"_5":14782,"_28250":58486,"_3059":58530},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3603":2507,"_31069":2489,"_21510":58532,"_5":14782,"_28250":58486,"_3059":58533},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3603":2508,"_31069":2489,"_21510":58535,"_5":14782,"_28250":58493,"_3059":58536},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3603":2509,"_31069":2489,"_21510":58538,"_5":14782,"_28250":58496,"_3059":58539},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3603":2510,"_31069":2489,"_21510":58541,"_5":14782,"_28250":58499,"_3059":58542},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3603":2511,"_31069":2489,"_21510":58544,"_5":14782,"_28250":58502,"_3059":58545},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3603":2512,"_31069":2489,"_21510":58547,"_5":14782,"_28250":58505,"_3059":58548},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3603":2513,"_31069":2489,"_21510":58550,"_5":14782,"_28250":58505,"_3059":58551},[],"its subject and extensions identify the expected client;",{"_3603":2514,"_31069":2489,"_21510":58553,"_5":14782,"_28250":58505,"_3059":58554},[],"its public key matches the client's private key;",{"_3603":2515,"_31069":2489,"_21510":58556,"_5":14782,"_28250":58505,"_3059":58557},[],"its chain reaches a root trusted by the consumer;",{"_3603":2516,"_31069":2489,"_21510":58559,"_5":14782,"_28250":58505,"_3059":58560},[],"its dates and usages allow the operation;",{"_3603":2517,"_31069":2489,"_21510":58562,"_5":14782,"_28250":58505,"_3059":58563},[],"the consumer applies revocation checks and authorization.",{"_3603":2518,"_31069":2489,"_21510":58565,"_5":14782,"_28250":58505,"_3059":58566},[],"The issuance path includes the first independent checks.",{"_3603":2519,"_31069":2489,"_21510":58568,"_5":14782,"_28250":58509,"_3059":58569},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3603":2520,"_31069":2489,"_21510":58571,"_5":14782,"_28250":58509,"_3059":58572},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3603":2521,"_31069":2489,"_21510":58574,"_5":14782,"_28250":58509,"_3059":58575},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3603":2522,"_31069":2522,"_5":15147,"_3059":58577,"_31428":58578,"_21510":58579,"_28250":2522},"Create your first CA",[50742,52254,56420,55857],[],{"_3603":2523,"_31069":2522,"_21510":58581,"_5":14782,"_28250":2522,"_3059":58582},[],"Create an evaluation root and check its certificate before issuing.",{"_3603":2524,"_31069":2522,"_5":31425,"_21510":58584,"_28250":58585,"_3059":50752},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3603":2525,"_31069":2522,"_5":31425,"_21510":58587,"_28250":58588,"_3059":58589},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3603":2526,"_31069":2522,"_5":31425,"_21510":58591,"_28250":58592,"_3059":58593},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3603":2527,"_31069":2522,"_5":31425,"_21510":58595,"_28250":58596,"_3059":58597},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3603":2528,"_31069":2522,"_5":31425,"_21510":58599,"_28250":58600,"_3059":58601},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3603":2529,"_31069":2522,"_5":31425,"_21510":58603,"_28250":58604,"_3059":58605},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3603":2530,"_31069":2522,"_5":31425,"_21510":58607,"_28250":58608,"_3059":58609},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3603":2531,"_31069":2522,"_5":31425,"_21510":58611,"_28250":58612,"_3059":56114},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3603":2532,"_31069":2522,"_5":31425,"_21510":58614,"_28250":58615,"_3059":50776},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3603":2533,"_31069":2522,"_21510":58617,"_5":14782,"_28250":2522,"_3059":58618},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3603":2534,"_31069":2522,"_21510":58620,"_5":14782,"_28250":58585,"_3059":58621},[],"Console access and permission to create keys and authorities.",{"_3603":2535,"_31069":2522,"_21510":58623,"_5":14782,"_28250":58585,"_3059":58624},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3603":2536,"_31069":2522,"_21510":58626,"_5":14782,"_28250":58585,"_3059":58627},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3603":2537,"_31069":2522,"_21510":58629,"_5":14782,"_28250":58585,"_3059":58630},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3603":2538,"_31069":2522,"_21510":58632,"_5":14782,"_28250":58588,"_3059":58633},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3603":2539,"_31069":2522,"_21510":58635,"_5":14782,"_28250":58588,"_3059":58636},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3603":2540,"_31069":2522,"_21510":58638,"_5":14782,"_28250":58592,"_3059":58639},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3603":2541,"_31069":2522,"_21510":58641,"_5":14782,"_28250":58592,"_3059":58642},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3603":2542,"_31069":2522,"_21510":58644,"_5":14782,"_28250":58596,"_3059":58645},[],"Select **Root CA** and complete:",{"_3603":2543,"_31069":2522,"_21510":58647,"_5":14782,"_28250":58596,"_3059":58648},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3603":2544,"_31069":2522,"_21510":58650,"_5":14782,"_28250":58596,"_3059":58651},[],"**Subject**: organization and country details for your evaluation.",{"_3603":2545,"_31069":2522,"_21510":58653,"_5":14782,"_28250":58596,"_3059":58654},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3603":2546,"_31069":2522,"_21510":58656,"_5":14782,"_28250":58596,"_3059":58657},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3603":2547,"_31069":2522,"_21510":58659,"_5":14782,"_28250":58596,"_3059":58660},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3603":2548,"_31069":2522,"_21510":58662,"_5":14782,"_28250":58600,"_3059":58663},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3603":2549,"_31069":2522,"_21510":58665,"_5":14782,"_28250":58604,"_3059":58666},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3603":2550,"_31069":2522,"_21510":58668,"_5":14782,"_28250":58604,"_3059":58669},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3603":2551,"_31069":2522,"_21510":58671,"_5":14782,"_28250":58608,"_3059":58672},[],"Run from the directory where you saved `ca.pem`:",{"_3603":2552,"_31069":2522,"_21510":58674,"_5":14782,"_28250":58608,"_3059":58675},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3603":2553,"_31069":2522,"_21510":58677,"_5":14782,"_28250":58608,"_3059":58678},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3603":2554,"_31069":2522,"_21510":58680,"_5":14782,"_28250":58612,"_3059":58681},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3603":2555,"_31069":2522,"_21510":58683,"_5":14782,"_28250":58612,"_3059":58684},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3603":2556,"_31069":2522,"_21510":58686,"_5":14782,"_28250":58612,"_3059":58687},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3603":2557,"_31069":2522,"_21510":58689,"_5":14782,"_28250":58612,"_3059":58690},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3603":2558,"_31069":2522,"_21510":58692,"_5":14782,"_28250":58615,"_3059":58693},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3603":2559,"_31069":2559,"_5":15147,"_3059":58695,"_31428":58696,"_21510":58697,"_28250":2559},"Issue and verify a certificate",[50742,52254,56420,55857],[],{"_3603":2560,"_31069":2559,"_21510":58699,"_5":14782,"_28250":2559,"_3059":58700},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3603":2561,"_31069":2559,"_5":31425,"_21510":58702,"_28250":58703,"_3059":50752},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3603":2562,"_31069":2559,"_5":31425,"_21510":58705,"_28250":58706,"_3059":58707},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3603":2563,"_31069":2559,"_5":31425,"_21510":58709,"_28250":58710,"_3059":58711},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3603":2564,"_31069":2559,"_5":31425,"_21510":58713,"_28250":58714,"_3059":58715},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3603":2565,"_31069":2559,"_5":31425,"_21510":58717,"_28250":58718,"_3059":58719},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3603":2566,"_31069":2559,"_5":31425,"_21510":58721,"_28250":58722,"_3059":58723},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3603":2567,"_31069":2559,"_5":31425,"_21510":58725,"_28250":58726,"_3059":58727},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3603":2568,"_31069":2559,"_5":31425,"_21510":58729,"_28250":58730,"_3059":58731},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3603":2569,"_31069":2559,"_5":31425,"_21510":58733,"_28250":58734,"_3059":58735},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3603":2570,"_31069":2559,"_5":31425,"_21510":58737,"_28250":58738,"_3059":58739},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3603":2571,"_31069":2559,"_5":31425,"_21510":58741,"_28250":58742,"_3059":56114},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3603":2572,"_31069":2559,"_5":31425,"_21510":58744,"_28250":58745,"_3059":50776},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/issue-certificate#next-step",{"_3603":2573,"_31069":2559,"_21510":58747,"_5":14782,"_28250":2559,"_3059":58748},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3603":2574,"_31069":2559,"_21510":58750,"_5":14782,"_28250":58703,"_3059":58751},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3603":2575,"_31069":2559,"_21510":58753,"_5":14782,"_28250":58703,"_3059":58754},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3603":2576,"_31069":2559,"_21510":58756,"_5":14782,"_28250":58703,"_3059":58757},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3603":2577,"_31069":2559,"_21510":58759,"_5":14782,"_28250":58703,"_3059":58760},[],"A client identifier: here we use `device-001`.",{"_3603":2578,"_31069":2559,"_21510":58762,"_5":14782,"_28250":58703,"_3059":58763},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3603":2579,"_31069":2559,"_21510":58765,"_5":14782,"_28250":58706,"_3059":58766},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3603":2580,"_31069":2559,"_21510":58768,"_5":14782,"_28250":58710,"_3059":58769},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3603":2581,"_31069":2559,"_21510":58771,"_5":14782,"_28250":58710,"_3059":58772},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3603":2582,"_31069":2559,"_21510":58774,"_5":14782,"_28250":58714,"_3059":58775},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3603":2583,"_31069":2559,"_21510":58777,"_5":14782,"_28250":58714,"_3059":58778},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3603":2584,"_31069":2559,"_21510":58780,"_5":14782,"_28250":58718,"_3059":58781},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3603":2585,"_31069":2559,"_21510":58783,"_5":14782,"_28250":58718,"_3059":58784},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3603":2586,"_31069":2559,"_21510":58786,"_5":14782,"_28250":58722,"_3059":58787},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3603":2587,"_31069":2559,"_21510":58789,"_5":14782,"_28250":58726,"_3059":58790},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3603":2588,"_31069":2559,"_21510":58792,"_5":14782,"_28250":58730,"_3059":58793},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3603":2589,"_31069":2559,"_21510":58795,"_5":14782,"_28250":58734,"_3059":58796},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3603":2590,"_31069":2559,"_21510":58798,"_5":14782,"_28250":58734,"_3059":58799},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3603":2591,"_31069":2559,"_21510":58801,"_5":14782,"_28250":58734,"_3059":58802},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3603":2592,"_31069":2559,"_21510":58804,"_5":14782,"_28250":58738,"_3059":58805},[],"In Bash, compare the two public-key digests:",{"_3603":2593,"_31069":2559,"_21510":58807,"_5":14782,"_28250":58738,"_3059":58808},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3603":2594,"_31069":2559,"_21510":58810,"_5":14782,"_28250":58738,"_3059":58811},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3603":2595,"_31069":2559,"_21510":58813,"_5":14782,"_28250":58742,"_3059":56198},[],{"_3603":2596,"_31069":2559,"_21510":58815,"_5":14782,"_28250":58742,"_3059":58816},[],"What to review",{"_3603":2597,"_31069":2559,"_21510":58818,"_5":14782,"_28250":58742,"_3059":58819},[],"The CA rejects issuance",{"_3603":2598,"_31069":2559,"_21510":58821,"_5":14782,"_28250":58742,"_3059":58822},[],"Permissions, CA state and key, algorithm and profile.",{"_3603":2599,"_31069":2559,"_21510":58824,"_5":14782,"_28250":58742,"_3059":58825},[],"Different subject or usages",{"_3603":2600,"_31069":2559,"_21510":58827,"_5":14782,"_28250":58742,"_3059":58828},[],"Applied profile and requested values.",{"_3603":2601,"_31069":2559,"_21510":58830,"_5":14782,"_28250":58742,"_3059":58831},[],"Issuer cannot be found",{"_3603":2602,"_31069":2559,"_21510":58833,"_5":14782,"_28250":58742,"_3059":58834},[],"Downloaded CA and required intermediate chain.",{"_3603":2603,"_31069":2559,"_21510":58836,"_5":14782,"_28250":58742,"_3059":58837},[],"Validity fails",{"_3603":2604,"_31069":2559,"_21510":58839,"_5":14782,"_28250":58742,"_3059":58840},[],"Certificate and CA dates, and the computer's clock.",{"_3603":2605,"_31069":2559,"_21510":58842,"_5":14782,"_28250":58742,"_3059":58843},[],"Public-key digests differ",{"_3603":2606,"_31069":2559,"_21510":58845,"_5":14782,"_28250":58742,"_3059":58846},[],"Certificate and key files from the same issuance.",{"_3603":2607,"_31069":2559,"_21510":58848,"_5":14782,"_28250":58742,"_3059":58849},[],"See PKI diagnostics to narrow an issuance failure.",{"_3603":2608,"_31069":2559,"_21510":58851,"_5":14782,"_28250":58745,"_3059":58852},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3603":2609,"_31069":2559,"_21510":58854,"_5":14782,"_28250":58745,"_3059":58855},[],"Manage certificates for inspection, status and revocation.",{"_3603":2610,"_31069":2559,"_21510":58857,"_5":14782,"_28250":58745,"_3059":58858},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3603":2611,"_31069":2559,"_21510":58860,"_5":14782,"_28250":58745,"_3059":58861},[],"Prepare EST for the device to request its next identities.",{"_3603":2612,"_31069":2559,"_21510":58863,"_5":14782,"_28250":58745,"_3059":58864},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3603":2613,"_31069":2613,"_5":15147,"_3059":58866,"_31428":58867,"_21510":58868,"_28250":2613},"PKI getting started",[50742,52254,56420,55857],[],{"_3603":2614,"_31069":2613,"_21510":58870,"_5":14782,"_28250":2613,"_3059":58871},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3603":2615,"_31069":2613,"_5":31425,"_21510":58873,"_28250":58874,"_3059":50752},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/overview#before-you-begin",{"_3603":2616,"_31069":2613,"_5":31425,"_21510":58876,"_28250":58877,"_3059":58878},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3603":2617,"_31069":2613,"_5":31425,"_21510":58880,"_28250":58881,"_3059":56049},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/overview#expected-result",{"_3603":2618,"_31069":2613,"_5":31425,"_21510":58883,"_28250":58884,"_3059":58885},[],"/docs/pr-preview/pr-74/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3603":2619,"_31069":2613,"_21510":58887,"_5":14782,"_28250":2613,"_3059":58888},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3603":2620,"_31069":2613,"_21510":58890,"_5":14782,"_28250":58874,"_3059":58891},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3603":2621,"_31069":2613,"_21510":58893,"_5":14782,"_28250":58874,"_3059":58894},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3603":2622,"_31069":2613,"_21510":58896,"_5":14782,"_28250":58874,"_3059":58897},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3603":2623,"_31069":2613,"_21510":58899,"_5":14782,"_28250":58874,"_3059":58900},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3603":2624,"_31069":2613,"_21510":58902,"_5":14782,"_28250":58874,"_3059":58903},[],"A working directory with restricted access for the downloaded key.",{"_3603":2625,"_31069":2613,"_21510":58905,"_5":14782,"_28250":58877,"_3059":58906},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3603":2626,"_31069":2613,"_21510":58908,"_5":14782,"_28250":58877,"_3059":58909},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3603":2627,"_31069":2613,"_21510":58911,"_5":14782,"_28250":58877,"_3059":58912},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3603":2628,"_31069":2613,"_21510":58914,"_5":14782,"_28250":58877,"_3059":58915},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3603":2629,"_31069":2613,"_21510":58917,"_5":14782,"_28250":58881,"_3059":58918},[],"File or resource",{"_3603":2630,"_31069":2613,"_21510":58920,"_5":14782,"_28250":58881,"_3059":56046},[],{"_3603":2631,"_31069":2613,"_21510":58922,"_5":14782,"_28250":58881,"_3059":58923},[],"Active root CA and `ca.pem`",{"_3603":2632,"_31069":2613,"_21510":58925,"_5":14782,"_28250":58881,"_3059":58926},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3603":2633,"_31069":2613,"_21510":58928,"_5":14782,"_28250":58881,"_3059":58929},[],"End-entity certificate and `device.crt`",{"_3603":2634,"_31069":2613,"_21510":58931,"_5":14782,"_28250":58881,"_3059":58932},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3603":2635,"_31069":2613,"_21510":58934,"_5":14782,"_28250":58881,"_3059":58935},[],"Private key `device.key`",{"_3603":2636,"_31069":2613,"_21510":58937,"_5":14782,"_28250":58881,"_3059":58938},[],"Its public key matches the one included in `device.crt`.",{"_3603":2637,"_31069":2613,"_21510":58940,"_5":14782,"_28250":58881,"_3059":58941},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3603":2638,"_31069":2613,"_21510":58943,"_5":14782,"_28250":58884,"_3059":58944},[],"To operate certificates, continue with Certificates and Validation.",{"_3603":2639,"_31069":2613,"_21510":58946,"_5":14782,"_28250":58884,"_3059":58947},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3603":2640,"_31069":2613,"_21510":58949,"_5":14782,"_28250":58884,"_3059":58950},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3603":2641,"_31069":2641,"_5":15147,"_3059":58952,"_31428":58953,"_21510":58954,"_28250":2641},"PKI troubleshooting",[50742,52254,56420,54995],[],{"_3603":2642,"_31069":2641,"_21510":58956,"_5":14782,"_28250":2641,"_3059":58957},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3603":2643,"_31069":2641,"_5":31425,"_21510":58959,"_28250":58960,"_3059":58961},[],"/docs/pr-preview/pr-74/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3603":2644,"_31069":2641,"_5":31425,"_21510":58963,"_28250":58964,"_3059":58965},[],"/docs/pr-preview/pr-74/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3603":2645,"_31069":2641,"_5":31425,"_21510":58967,"_28250":58968,"_3059":58969},[],"/docs/pr-preview/pr-74/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3603":2646,"_31069":2641,"_21510":58971,"_5":14782,"_28250":2641,"_3059":58972},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3603":2647,"_31069":2641,"_21510":58974,"_5":14782,"_28250":2641,"_3059":58975},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3603":2648,"_31069":2641,"_21510":58977,"_5":14782,"_28250":58960,"_3059":56046},[],{"_3603":2649,"_31069":2641,"_21510":58979,"_5":14782,"_28250":58960,"_3059":58980},[],"What to inspect",{"_3603":2650,"_31069":2641,"_21510":58982,"_5":14782,"_28250":58960,"_3059":50776},[],{"_3603":2651,"_31069":2641,"_21510":58984,"_5":14782,"_28250":58960,"_3059":55262},[],{"_3603":2652,"_31069":2641,"_21510":58986,"_5":14782,"_28250":58960,"_3059":58987},[],"Exists, is active and has usable dates.",{"_3603":2653,"_31069":2641,"_21510":58989,"_5":14782,"_28250":58960,"_3059":58990},[],"Authorities.",{"_3603":2654,"_31069":2641,"_21510":58992,"_5":14782,"_28250":58960,"_3059":58993},[],"Key",{"_3603":2655,"_31069":2641,"_21510":58995,"_5":14782,"_28250":58960,"_3059":58996},[],"The record has a usable private key and the engine can sign.",{"_3603":2656,"_31069":2641,"_21510":58998,"_5":14782,"_28250":58960,"_3059":58999},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3603":2657,"_31069":2641,"_21510":59001,"_5":14782,"_28250":58960,"_3059":59002},[],"CSR",{"_3603":2658,"_31069":2641,"_21510":59004,"_5":14782,"_28250":58960,"_3059":59005},[],"Correct PEM and verifiable signature.",{"_3603":2659,"_31069":2641,"_21510":59007,"_5":14782,"_28250":58960,"_3059":59008},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3603":2660,"_31069":2641,"_21510":59010,"_5":14782,"_28250":58960,"_3059":59011},[],"Profile",{"_3603":2661,"_31069":2641,"_21510":59013,"_5":14782,"_28250":58960,"_3059":59014},[],"Selected source, existing ID, allowed algorithm and size.",{"_3603":2662,"_31069":2641,"_21510":59016,"_5":14782,"_28250":58960,"_3059":59017},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3603":2663,"_31069":2641,"_21510":59019,"_5":14782,"_28250":58960,"_3059":56198},[],{"_3603":2664,"_31069":2641,"_21510":59021,"_5":14782,"_28250":58960,"_3059":59022},[],"Appropriate subject, SAN, usages and dates.",{"_3603":2665,"_31069":2641,"_21510":59024,"_5":14782,"_28250":58960,"_3059":59025},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3603":2666,"_31069":2641,"_21510":59027,"_5":14782,"_28250":58960,"_3059":59028},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3603":2667,"_31069":2641,"_21510":59030,"_5":14782,"_28250":58960,"_3059":59031},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3603":2668,"_31069":2641,"_21510":59033,"_5":14782,"_28250":58960,"_3059":59034},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3603":2669,"_31069":2641,"_21510":59036,"_5":14782,"_28250":58964,"_3059":59037},[],"Check each boundary independently:",{"_3603":2670,"_31069":2641,"_21510":59039,"_5":14782,"_28250":58964,"_3059":59040},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3603":2671,"_31069":2641,"_21510":59042,"_5":14782,"_28250":58964,"_3059":59043},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3603":2672,"_31069":2641,"_21510":59045,"_5":14782,"_28250":58964,"_3059":59046},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3603":2673,"_31069":2641,"_21510":59048,"_5":14782,"_28250":58964,"_3059":59049},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3603":2674,"_31069":2641,"_21510":59051,"_5":14782,"_28250":58964,"_3059":59052},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3603":2675,"_31069":2641,"_21510":59054,"_5":14782,"_28250":58964,"_3059":59055},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3603":2676,"_31069":2641,"_21510":59057,"_5":14782,"_28250":58968,"_3059":59058},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3603":2677,"_31069":2641,"_21510":59060,"_5":14782,"_28250":58968,"_3059":59061},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3603":2678,"_31069":2678,"_5":15147,"_3059":59063,"_31428":59064,"_21510":59065,"_28250":2678},"Security",[50742],[],{"_3603":2679,"_31069":2678,"_21510":59067,"_5":14782,"_28250":2678,"_3059":59068},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3603":2680,"_31069":2678,"_5":31425,"_21510":59070,"_28250":59071,"_3059":59072},[],"/docs/pr-preview/pr-74/security#report-a-vulnerability","Report a vulnerability",{"_3603":2681,"_31069":2678,"_5":31425,"_21510":59074,"_28250":59075,"_3059":59076},[],"/docs/pr-preview/pr-74/security#what-to-include-in-a-report","What to include in a report",{"_3603":2682,"_31069":2678,"_5":31425,"_21510":59078,"_28250":59079,"_3059":59080},[],"/docs/pr-preview/pr-74/security#supported-versions","Supported versions",{"_3603":2683,"_31069":2678,"_5":31425,"_21510":59082,"_28250":59083,"_3059":59084},[],"/docs/pr-preview/pr-74/security#responsible-disclosure","Responsible disclosure",{"_3603":2684,"_31069":2678,"_21510":59086,"_5":14782,"_28250":2678,"_3059":59087},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3603":2685,"_31069":2678,"_21510":59089,"_5":14782,"_28250":59071,"_3059":59090},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3603":2686,"_31069":2678,"_21510":59092,"_5":14782,"_28250":59071,"_3059":59093},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3603":2687,"_31069":2678,"_21510":59095,"_5":14782,"_28250":59071,"_3059":15421},[],{"_3603":2688,"_31069":2678,"_21510":59097,"_5":14782,"_28250":59071,"_3059":15350},[],{"_3603":2689,"_31069":2678,"_21510":59099,"_5":14782,"_28250":59071,"_3059":15408},[],{"_3603":2690,"_31069":2678,"_21510":59101,"_5":14782,"_28250":59071,"_3059":59102},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3603":2691,"_31069":2678,"_21510":59104,"_5":14782,"_28250":59071,"_3059":59105},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3603":2692,"_31069":2678,"_21510":59107,"_5":14782,"_28250":59075,"_3059":59108},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3603":2693,"_31069":2678,"_21510":59110,"_5":14782,"_28250":59075,"_3059":59111},[],"Do not include in the report:",{"_3603":2694,"_31069":2678,"_21510":59113,"_5":14782,"_28250":59075,"_3059":59114},[],"Credentials, tokens, or private keys",{"_3603":2695,"_31069":2678,"_21510":59116,"_5":14782,"_28250":59075,"_3059":59117},[],"Customer data or customer-identifiable information",{"_3603":2696,"_31069":2678,"_21510":59119,"_5":14782,"_28250":59075,"_3059":59120},[],"Confidential architecture or internal infrastructure details",{"_3603":2697,"_31069":2678,"_21510":59122,"_5":14782,"_28250":59079,"_3059":59123},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3603":2698,"_31069":2678,"_21510":59125,"_5":14782,"_28250":59079,"_3059":59126},[],"For upgrade guidance, see Upgrades.",{"_3603":2699,"_31069":2678,"_21510":59128,"_5":14782,"_28250":59083,"_3059":59129},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3603":2700,"_31069":2678,"_21510":59131,"_5":14782,"_28250":59083,"_3059":59132},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3603":2701,"_31069":2678,"_21510":59134,"_5":14782,"_28250":59083,"_3059":59135},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3603":2702,"_31069":2678,"_21510":59137,"_5":14782,"_28250":59083,"_3059":59138},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3603":2703,"_31069":2678,"_21510":59140,"_5":14782,"_28250":59083,"_3059":59141},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3603":2704,"_31069":2704,"_5":15147,"_3059":59143,"_31428":59144,"_21510":59146,"_28250":2704},"3.8.0 to 4.0.0",[50742,59145],"Upgrades",[],{"_3603":2705,"_31069":2704,"_21510":59148,"_5":14782,"_28250":2704,"_3059":59149},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3603":2706,"_31069":2704,"_5":31425,"_21510":59151,"_28250":59152,"_3059":59153},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3603":2707,"_31069":2704,"_5":31425,"_21510":59155,"_28250":59156,"_3059":59157},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3603":2708,"_31069":2704,"_5":31425,"_21510":59159,"_28250":59160,"_3059":59161},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3603":2709,"_31069":2704,"_5":31425,"_21510":59163,"_28250":59164,"_3059":59165},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3603":2710,"_31069":2704,"_5":31425,"_21510":59167,"_28250":59168,"_3059":59169},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3603":2711,"_31069":2704,"_5":31425,"_21510":59171,"_28250":59172,"_3059":59173},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3603":2712,"_31069":2704,"_5":31425,"_21510":59175,"_28250":59176,"_3059":59177},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3603":2713,"_31069":2704,"_5":31425,"_21510":59179,"_28250":59180,"_3059":59181},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3603":2714,"_31069":2704,"_5":31425,"_21510":59183,"_28250":59184,"_3059":59185},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3603":2715,"_31069":2704,"_5":31425,"_21510":59187,"_28250":59188,"_3059":59189},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3603":2716,"_31069":2704,"_5":31425,"_21510":59191,"_28250":59192,"_3059":51380},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3603":2717,"_31069":2704,"_5":31425,"_21510":59194,"_28250":59195,"_3059":59196},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3603":2718,"_31069":2704,"_5":31425,"_21510":59198,"_28250":59199,"_3059":59200},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3603":2719,"_31069":2704,"_5":31425,"_21510":59202,"_28250":59203,"_3059":59204},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3603":2720,"_31069":2704,"_5":31425,"_21510":59206,"_28250":59207,"_3059":59208},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3603":2721,"_31069":2704,"_5":31425,"_21510":59210,"_28250":59211,"_3059":59212},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3603":2722,"_31069":2704,"_5":31425,"_21510":59214,"_28250":59215,"_3059":59216},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3603":2723,"_31069":2704,"_5":31425,"_21510":59218,"_28250":59219,"_3059":59220},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3603":2724,"_31069":2704,"_5":31425,"_21510":59222,"_28250":59223,"_3059":59224},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3603":2725,"_31069":2704,"_5":31425,"_21510":59226,"_28250":59227,"_3059":59228},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3603":2726,"_31069":2704,"_5":31425,"_21510":59230,"_28250":59231,"_3059":59232},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3603":2727,"_31069":2704,"_5":31425,"_21510":59234,"_28250":59235,"_3059":59236},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3603":2728,"_31069":2704,"_5":31425,"_21510":59238,"_28250":59239,"_3059":59240},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3603":2729,"_31069":2704,"_5":31425,"_21510":59242,"_28250":59243,"_3059":59244},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3603":2730,"_31069":2704,"_5":31425,"_21510":59246,"_28250":59247,"_3059":59248},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3603":2731,"_31069":2704,"_5":31425,"_21510":59250,"_28250":59251,"_3059":59252},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3603":2732,"_31069":2704,"_5":31425,"_21510":59254,"_28250":59255,"_3059":59256},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3603":2733,"_31069":2704,"_5":31425,"_21510":59258,"_28250":59259,"_3059":59260},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3603":2734,"_31069":2704,"_5":31425,"_21510":59262,"_28250":59263,"_3059":59264},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3603":2735,"_31069":2704,"_5":31425,"_21510":59266,"_28250":59267,"_3059":59268},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3603":2736,"_31069":2704,"_5":31425,"_21510":59270,"_28250":59271,"_3059":59272},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3603":2737,"_31069":2704,"_5":31425,"_21510":59274,"_28250":59275,"_3059":59276},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3603":2738,"_31069":2704,"_5":31425,"_21510":59278,"_28250":59279,"_3059":59280},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3603":2739,"_31069":2704,"_5":31425,"_21510":59282,"_28250":59283,"_3059":59284},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3603":2740,"_31069":2704,"_5":31425,"_21510":59286,"_28250":59287,"_3059":59288},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3603":2741,"_31069":2704,"_5":31425,"_21510":59290,"_28250":59291,"_3059":59292},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3603":2742,"_31069":2704,"_5":31425,"_21510":59294,"_28250":59295,"_3059":59296},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3603":2743,"_31069":2704,"_5":31425,"_21510":59298,"_28250":59299,"_3059":59300},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3603":2744,"_31069":2704,"_5":31425,"_21510":59302,"_28250":59303,"_3059":59304},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3603":2745,"_31069":2704,"_5":31425,"_21510":59306,"_28250":59307,"_3059":59308},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3603":2746,"_31069":2704,"_5":31425,"_21510":59310,"_28250":59311,"_3059":59312},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3603":2747,"_31069":2704,"_5":31425,"_21510":59314,"_28250":59315,"_3059":59316},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3603":2748,"_31069":2704,"_5":31425,"_21510":59318,"_28250":59319,"_3059":54995},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3603":2749,"_31069":2704,"_5":31425,"_21510":59321,"_28250":59322,"_3059":59323},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3603":2750,"_31069":2704,"_5":31425,"_21510":59325,"_28250":59326,"_3059":59327},[],"/docs/pr-preview/pr-74/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3603":2751,"_31069":2704,"_21510":59329,"_5":14782,"_28250":2704,"_3059":59330},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3603":2752,"_31069":2704,"_21510":59332,"_5":14782,"_28250":2704,"_3059":59333},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3603":2753,"_31069":2704,"_21510":59335,"_5":14782,"_28250":2704,"_3059":59336},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3603":2754,"_31069":2704,"_21510":59338,"_5":14782,"_28250":2704,"_3059":59339},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3603":2755,"_31069":2704,"_21510":59341,"_5":14782,"_28250":2704,"_3059":59342},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3603":2756,"_31069":2704,"_21510":59344,"_5":14782,"_28250":2704,"_3059":59345},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3603":2757,"_31069":2704,"_21510":59347,"_5":14782,"_28250":2704,"_3059":59348},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3603":2758,"_31069":2704,"_21510":59350,"_5":14782,"_28250":59156,"_3059":59351},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3603":2759,"_31069":2704,"_21510":59353,"_5":14782,"_28250":59156,"_3059":59354},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3603":2760,"_31069":2704,"_21510":59356,"_5":14782,"_28250":59160,"_3059":59357},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3603":2761,"_31069":2704,"_21510":59359,"_5":14782,"_28250":59160,"_3059":59360},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3603":2762,"_31069":2704,"_21510":59362,"_5":14782,"_28250":59164,"_3059":59363},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3603":2763,"_31069":2704,"_21510":59365,"_5":14782,"_28250":59168,"_3059":59366},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3603":2764,"_31069":2704,"_21510":59368,"_5":14782,"_28250":59168,"_3059":59369},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3603":2765,"_31069":2704,"_21510":59371,"_5":14782,"_28250":59168,"_3059":59372},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3603":2766,"_31069":2704,"_21510":59374,"_5":14782,"_28250":59168,"_3059":59375},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3603":2767,"_31069":2704,"_21510":59377,"_5":14782,"_28250":59168,"_3059":59378},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3603":2768,"_31069":2704,"_21510":59380,"_5":14782,"_28250":59172,"_3059":59381},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3603":2769,"_31069":2704,"_21510":59383,"_5":14782,"_28250":59172,"_3059":59384},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3603":2770,"_31069":2704,"_21510":59386,"_5":14782,"_28250":59172,"_3059":59387},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3603":2771,"_31069":2704,"_21510":59389,"_5":14782,"_28250":59172,"_3059":59390},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3603":2772,"_31069":2704,"_21510":59392,"_5":14782,"_28250":59172,"_3059":59393},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3603":2773,"_31069":2704,"_21510":59395,"_5":14782,"_28250":59172,"_3059":59396},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3603":2774,"_31069":2704,"_21510":59398,"_5":14782,"_28250":59176,"_3059":59399},[],"Change",{"_3603":2775,"_31069":2704,"_21510":59401,"_5":14782,"_28250":59176,"_3059":59402},[],"Who is affected",{"_3603":2776,"_31069":2704,"_21510":59404,"_5":14782,"_28250":59176,"_3059":59405},[],"Severity",{"_3603":2777,"_31069":2704,"_21510":59407,"_5":14782,"_28250":59176,"_3059":57865},[],{"_3603":2778,"_31069":2704,"_21510":59409,"_5":14782,"_28250":59176,"_3059":59185},[],{"_3603":2779,"_31069":2704,"_21510":59411,"_5":14782,"_28250":59176,"_3059":59412},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3603":2780,"_31069":2704,"_21510":59414,"_5":14782,"_28250":59176,"_3059":59415},[],"High: KMS and VA start on empty volumes",{"_3603":2781,"_31069":2704,"_21510":59417,"_5":14782,"_28250":59176,"_3059":59418},[],"Copy the data into the new volumes",{"_3603":2782,"_31069":2704,"_21510":59420,"_5":14782,"_28250":59176,"_3059":59189},[],{"_3603":2783,"_31069":2704,"_21510":59422,"_5":14782,"_28250":59176,"_3059":59423},[],"Every Helm release",{"_3603":2784,"_31069":2704,"_21510":59425,"_5":14782,"_28250":59176,"_3059":59426},[],"High: `helm upgrade` fails",{"_3603":2785,"_31069":2704,"_21510":59428,"_5":14782,"_28250":59176,"_3059":59429},[],"Remove or rename legacy keys",{"_3603":2786,"_31069":2704,"_21510":59431,"_5":14782,"_28250":59176,"_3059":51380},[],{"_3603":2787,"_31069":2704,"_21510":59433,"_5":14782,"_28250":59176,"_3059":59423},[],{"_3603":2788,"_31069":2704,"_21510":59435,"_5":14782,"_28250":59176,"_3059":59436},[],"High: `helm upgrade` fails on inline credentials",{"_3603":2789,"_31069":2704,"_21510":59438,"_5":14782,"_28250":59176,"_3059":59439},[],"Create the Secrets first; see Step 2",{"_3603":2790,"_31069":2704,"_21510":59441,"_5":14782,"_28250":59176,"_3059":59196},[],{"_3603":2791,"_31069":2704,"_21510":59443,"_5":14782,"_28250":59176,"_3059":59444},[],"Every deployment",{"_3603":2792,"_31069":2704,"_21510":59446,"_5":14782,"_28250":59176,"_3059":59447},[],"High: without a bootstrap principal there is no administrator",{"_3603":2793,"_31069":2704,"_21510":59449,"_5":14782,"_28250":59176,"_3059":59450},[],"Configure `services.authz`",{"_3603":2794,"_31069":2704,"_21510":59452,"_5":14782,"_28250":59176,"_3059":59200},[],{"_3603":2795,"_31069":2704,"_21510":59454,"_5":14782,"_28250":59176,"_3059":59423},[],{"_3603":2796,"_31069":2704,"_21510":59456,"_5":14782,"_28250":59176,"_3059":59457},[],"High: `helm upgrade` fails on the old keys",{"_3603":2797,"_31069":2704,"_21510":59459,"_5":14782,"_28250":59176,"_3059":59460},[],"Move JWKS and roles into `services.authz`",{"_3603":2798,"_31069":2704,"_21510":59462,"_5":14782,"_28250":59176,"_3059":59220},[],{"_3603":2799,"_31069":2704,"_21510":59464,"_5":14782,"_28250":59176,"_3059":59465},[],"3.8.0 deployments with per-service databases",{"_3603":2800,"_31069":2704,"_21510":59467,"_5":14782,"_28250":59176,"_3059":59468},[],"High: services find no data, or a migration aborts",{"_3603":2801,"_31069":2704,"_21510":59470,"_5":14782,"_28250":59176,"_3059":59471},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3603":2802,"_31069":2704,"_21510":59473,"_5":14782,"_28250":59176,"_3059":59224},[],{"_3603":2803,"_31069":2704,"_21510":59475,"_5":14782,"_28250":59176,"_3059":59476},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3603":2804,"_31069":2704,"_21510":59478,"_5":14782,"_28250":59176,"_3059":59479},[],"High: the backend no longer starts with them",{"_3603":2805,"_31069":2704,"_21510":59481,"_5":14782,"_28250":59176,"_3059":59482},[],"Move to PostgreSQL before upgrading",{"_3603":2806,"_31069":2704,"_21510":59484,"_5":14782,"_28250":59176,"_3059":59268},[],{"_3603":2807,"_31069":2704,"_21510":59486,"_5":14782,"_28250":59176,"_3059":59487},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3603":2808,"_31069":2704,"_21510":59489,"_5":14782,"_28250":59176,"_3059":59490},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3603":2809,"_31069":2704,"_21510":59492,"_5":14782,"_28250":59176,"_3059":59493},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3603":2810,"_31069":2704,"_21510":59495,"_5":14782,"_28250":59176,"_3059":59496},[],"Webhooks with file references",{"_3603":2811,"_31069":2704,"_21510":59498,"_5":14782,"_28250":59176,"_3059":59499},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3603":2812,"_31069":2704,"_21510":59501,"_5":14782,"_28250":59176,"_3059":59502},[],"High: enrollments calling the webhook fail",{"_3603":2813,"_31069":2704,"_21510":59504,"_5":14782,"_28250":59176,"_3059":59505},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3603":2814,"_31069":2704,"_21510":59507,"_5":14782,"_28250":59176,"_3059":59204},[],{"_3603":2815,"_31069":2704,"_21510":59509,"_5":14782,"_28250":59176,"_3059":59510},[],"Releases with per-service identity overrides or mounted key material",{"_3603":2816,"_31069":2704,"_21510":59512,"_5":14782,"_28250":59176,"_3059":59513},[],"Medium: services cannot read their files",{"_3603":2817,"_31069":2704,"_21510":59515,"_5":14782,"_28250":59176,"_3059":59516},[],"Remove the overrides and fix volume ownership",{"_3603":2818,"_31069":2704,"_21510":59518,"_5":14782,"_28250":59176,"_3059":59208},[],{"_3603":2819,"_31069":2704,"_21510":59520,"_5":14782,"_28250":59176,"_3059":59521},[],"Releases that set `amqp.tls`",{"_3603":2820,"_31069":2704,"_21510":59523,"_5":14782,"_28250":59176,"_3059":59524},[],"Medium: clients connect to the wrong port",{"_3603":2821,"_31069":2704,"_21510":59526,"_5":14782,"_28250":59176,"_3059":59527},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3603":2822,"_31069":2704,"_21510":59529,"_5":14782,"_28250":59176,"_3059":59228},[],{"_3603":2823,"_31069":2704,"_21510":59531,"_5":14782,"_28250":59176,"_3059":59532},[],"Installations whose CA keys predate the KMS",{"_3603":2824,"_31069":2704,"_21510":59534,"_5":14782,"_28250":59176,"_3059":59535},[],"Medium: CA keys stay unmanaged",{"_3603":2825,"_31069":2704,"_21510":59537,"_5":14782,"_28250":59176,"_3059":59538},[],"Run the CA-to-KMS migration",{"_3603":2826,"_31069":2704,"_21510":59540,"_5":14782,"_28250":59176,"_3059":59541},[],"Receiver certificate verification",{"_3603":2827,"_31069":2704,"_21510":59543,"_5":14782,"_28250":59176,"_3059":59544},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3603":2828,"_31069":2704,"_21510":59546,"_5":14782,"_28250":59176,"_3059":59547},[],"Medium: credentials go to an unverified receiver",{"_3603":2829,"_31069":2704,"_21510":59549,"_5":14782,"_28250":59176,"_3059":59550},[],"Set `insecure_skip_verify` to `false`",{"_3603":2830,"_31069":2704,"_21510":59552,"_5":14782,"_28250":59176,"_3059":59244},[],{"_3603":2831,"_31069":2704,"_21510":59554,"_5":14782,"_28250":59176,"_3059":59555},[],"Scripts and consoles that edit DMSs through the API",{"_3603":2832,"_31069":2704,"_21510":59557,"_5":14782,"_28250":59176,"_3059":59558},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3603":2833,"_31069":2704,"_21510":59560,"_5":14782,"_28250":59176,"_3059":59561},[],"Read the DMS before editing and use the new field",{"_3603":2834,"_31069":2704,"_21510":59563,"_5":14782,"_28250":59176,"_3059":59264},[],{"_3603":2835,"_31069":2704,"_21510":59565,"_5":14782,"_28250":59176,"_3059":59566},[],"Clients that create or update CRL settings through the API",{"_3603":2836,"_31069":2704,"_21510":59568,"_5":14782,"_28250":59176,"_3059":59569},[],"Medium: requests with the old field return an error",{"_3603":2837,"_31069":2704,"_21510":59571,"_5":14782,"_28250":59176,"_3059":59572},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3603":2838,"_31069":2704,"_21510":59574,"_5":14782,"_28250":59176,"_3059":59272},[],{"_3603":2839,"_31069":2704,"_21510":59576,"_5":14782,"_28250":59176,"_3059":59577},[],"Alert subscriptions and consumers of the VA events",{"_3603":2840,"_31069":2704,"_21510":59579,"_5":14782,"_28250":59176,"_3059":59580},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3603":2841,"_31069":2704,"_21510":59582,"_5":14782,"_28250":59176,"_3059":59583},[],"Review conditions filtering on the old event payload or subject",{"_3603":2842,"_31069":2704,"_21510":59585,"_5":14782,"_28250":59176,"_3059":59260},[],{"_3603":2843,"_31069":2704,"_21510":59587,"_5":14782,"_28250":59176,"_3059":59588},[],"Consumers that read the device `events` field",{"_3603":2844,"_31069":2704,"_21510":59590,"_5":14782,"_28250":59176,"_3059":59591},[],"Medium: the field disappears",{"_3603":2845,"_31069":2704,"_21510":59593,"_5":14782,"_28250":59176,"_3059":59594},[],"Use the new event endpoints",{"_3603":2846,"_31069":2704,"_21510":59596,"_5":14782,"_28250":59176,"_3059":59284},[],{"_3603":2847,"_31069":2704,"_21510":59598,"_5":14782,"_28250":59176,"_3059":59599},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3603":2848,"_31069":2704,"_21510":59601,"_5":14782,"_28250":59176,"_3059":59602},[],"Medium: the VA migration aborts",{"_3603":2849,"_31069":2704,"_21510":59604,"_5":14782,"_28250":59176,"_3059":59605},[],"Fix the affected roles before upgrading",{"_3603":2850,"_31069":2704,"_21510":59607,"_5":14782,"_28250":59176,"_3059":59212},[],{"_3603":2851,"_31069":2704,"_21510":59609,"_5":14782,"_28250":59176,"_3059":59610},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3603":2852,"_31069":2704,"_21510":59612,"_5":14782,"_28250":59176,"_3059":59613},[],"Low to medium: validation errors or changed defaults",{"_3603":2853,"_31069":2704,"_21510":59615,"_5":14782,"_28250":59176,"_3059":59616},[],"Update the values file",{"_3603":2854,"_31069":2704,"_21510":59618,"_5":14782,"_28250":59176,"_3059":59252},[],{"_3603":2855,"_31069":2704,"_21510":59620,"_5":14782,"_28250":59176,"_3059":59621},[],"Clients that send the DMS ID in the update body",{"_3603":2856,"_31069":2704,"_21510":59623,"_5":14782,"_28250":59176,"_3059":59624},[],"Low: the ID in the URL wins",{"_3603":2857,"_31069":2704,"_21510":59626,"_5":14782,"_28250":59176,"_3059":59627},[],"Send the ID in the URL",{"_3603":2858,"_31069":2704,"_21510":59629,"_5":14782,"_28250":59176,"_3059":59276},[],{"_3603":2859,"_31069":2704,"_21510":59631,"_5":14782,"_28250":59176,"_3059":59632},[],"Clients that send an `id` when creating or importing CAs",{"_3603":2860,"_31069":2704,"_21510":59634,"_5":14782,"_28250":59176,"_3059":59635},[],"Low: the ID in the body is ignored, and the field is removed",{"_3603":2861,"_31069":2704,"_21510":59637,"_5":14782,"_28250":59176,"_3059":59638},[],"Let the backend assign the ID and use the returned one",{"_3603":2862,"_31069":2704,"_21510":59640,"_5":14782,"_28250":59176,"_3059":59280},[],{"_3603":2863,"_31069":2704,"_21510":59642,"_5":14782,"_28250":59176,"_3059":59643},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3603":2864,"_31069":2704,"_21510":59645,"_5":14782,"_28250":59176,"_3059":59646},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3603":2865,"_31069":2704,"_21510":59648,"_5":14782,"_28250":59176,"_3059":59649},[],"Use the KMS `sign` and `verify` operations",{"_3603":2866,"_31069":2704,"_21510":59651,"_5":14782,"_28250":59176,"_3059":59256},[],{"_3603":2867,"_31069":2704,"_21510":59653,"_5":14782,"_28250":59176,"_3059":59654},[],"Consumers that match on certificate `type`",{"_3603":2868,"_31069":2704,"_21510":59656,"_5":14782,"_28250":59176,"_3059":59657},[],"Low: two values are renamed",{"_3603":2869,"_31069":2704,"_21510":59659,"_5":14782,"_28250":59176,"_3059":59660},[],"Adapt consumers",{"_3603":2870,"_31069":2704,"_21510":59662,"_5":14782,"_28250":59176,"_3059":59248},[],{"_3603":2871,"_31069":2704,"_21510":59664,"_5":14782,"_28250":59176,"_3059":59665},[],"Any DMS",{"_3603":2872,"_31069":2704,"_21510":59667,"_5":14782,"_28250":59176,"_3059":59668},[],"Low: informational",{"_3603":2873,"_31069":2704,"_21510":59670,"_5":14782,"_28250":59176,"_3059":59671},[],"Read both blocks before editing",{"_3603":2874,"_31069":2704,"_21510":59673,"_5":14782,"_28250":59184,"_3059":59674},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3603":2875,"_31069":2704,"_21510":59676,"_5":14782,"_28250":59184,"_3059":59677},[],"Step 4 of the migration guide copies the data.",{"_3603":2876,"_31069":2704,"_21510":59679,"_5":14782,"_28250":59188,"_3059":59680},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3603":2877,"_31069":2704,"_21510":59682,"_5":14782,"_28250":59192,"_3059":59683},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3603":2878,"_31069":2704,"_21510":59685,"_5":14782,"_28250":59192,"_3059":59686},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3603":2879,"_31069":2704,"_21510":59688,"_5":14782,"_28250":59195,"_3059":59689},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3603":2880,"_31069":2704,"_21510":59691,"_5":14782,"_28250":59199,"_3059":59692},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3603":2881,"_31069":2704,"_21510":59694,"_5":14782,"_28250":59203,"_3059":59695},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3603":2882,"_31069":2704,"_21510":59697,"_5":14782,"_28250":59203,"_3059":59698},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3603":2883,"_31069":2704,"_21510":59700,"_5":14782,"_28250":59203,"_3059":59701},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3603":2884,"_31069":2704,"_21510":59703,"_5":14782,"_28250":59207,"_3059":59704},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3603":2885,"_31069":2704,"_21510":59706,"_5":14782,"_28250":59211,"_3059":59707},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3603":2886,"_31069":2704,"_21510":59709,"_5":14782,"_28250":59211,"_3059":59710},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3603":2887,"_31069":2704,"_21510":59712,"_5":14782,"_28250":59211,"_3059":59713},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3603":2888,"_31069":2704,"_21510":59715,"_5":14782,"_28250":59211,"_3059":59716},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3603":2889,"_31069":2704,"_21510":59718,"_5":14782,"_28250":59211,"_3059":59719},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3603":2890,"_31069":2704,"_21510":59721,"_5":14782,"_28250":59211,"_3059":59722},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3603":2891,"_31069":2704,"_21510":59724,"_5":14782,"_28250":59219,"_3059":59725},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3603":2892,"_31069":2704,"_21510":59727,"_5":14782,"_28250":59219,"_3059":59728},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3603":2893,"_31069":2704,"_21510":59730,"_5":14782,"_28250":59219,"_3059":59731},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3603":2894,"_31069":2704,"_21510":59733,"_5":14782,"_28250":59219,"_3059":59734},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3603":2895,"_31069":2704,"_21510":59736,"_5":14782,"_28250":59219,"_3059":59737},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3603":2896,"_31069":2704,"_21510":59739,"_5":14782,"_28250":59223,"_3059":59740},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3603":2897,"_31069":2704,"_21510":59742,"_5":14782,"_28250":59227,"_3059":59743},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3603":2898,"_31069":2704,"_21510":59745,"_5":14782,"_28250":59227,"_3059":59746},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3603":2899,"_31069":2704,"_21510":59748,"_5":14782,"_28250":59227,"_3059":59749},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3603":2900,"_31069":2704,"_21510":59751,"_5":14782,"_28250":59227,"_3059":59752},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3603":2901,"_31069":2704,"_21510":59754,"_5":14782,"_28250":59227,"_3059":59755},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3603":2902,"_31069":2704,"_21510":59757,"_5":14782,"_28250":59227,"_3059":59758},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3603":2903,"_31069":2704,"_21510":59760,"_5":14782,"_28250":59227,"_3059":59761},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3603":2904,"_31069":2704,"_21510":59763,"_5":14782,"_28250":59227,"_3059":59764},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3603":2905,"_31069":2704,"_21510":59766,"_5":14782,"_28250":59231,"_3059":59767},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3603":2906,"_31069":2704,"_21510":59769,"_5":14782,"_28250":59239,"_3059":59770},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3603":2907,"_31069":2704,"_21510":59772,"_5":14782,"_28250":59239,"_3059":59773},[],"Field in 3.8.0",{"_3603":2908,"_31069":2704,"_21510":59775,"_5":14782,"_28250":59239,"_3059":59776},[],"Field in 4.0.0",{"_3603":2909,"_31069":2704,"_21510":59778,"_5":14782,"_28250":59239,"_3059":59779},[],"`validate_server_cert`",{"_3603":2910,"_31069":2704,"_21510":59781,"_5":14782,"_28250":59239,"_3059":59782},[],"`insecure_skip_verify` (value negated)",{"_3603":2911,"_31069":2704,"_21510":59784,"_5":14782,"_28250":59239,"_3059":59785},[],"`oidc`",{"_3603":2912,"_31069":2704,"_21510":59787,"_5":14782,"_28250":59239,"_3059":59788},[],"`jwt_options`",{"_3603":2913,"_31069":2704,"_21510":59790,"_5":14782,"_28250":59239,"_3059":59791},[],"`apikey`",{"_3603":2914,"_31069":2704,"_21510":59793,"_5":14782,"_28250":59239,"_3059":59794},[],"`apikey_options`",{"_3603":2915,"_31069":2704,"_21510":59796,"_5":14782,"_28250":59239,"_3059":59797},[],"`mtls`",{"_3603":2916,"_31069":2704,"_21510":59799,"_5":14782,"_28250":59239,"_3059":59800},[],"`mtls_options`",{"_3603":2917,"_31069":2704,"_21510":59802,"_5":14782,"_28250":59239,"_3059":59803},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3603":2918,"_31069":2704,"_21510":59805,"_5":14782,"_28250":59239,"_3059":59806},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3603":2919,"_31069":2704,"_21510":59808,"_5":14782,"_28250":59239,"_3059":59809},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3603":2920,"_31069":2704,"_21510":59811,"_5":14782,"_28250":59243,"_3059":59812},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3603":2921,"_31069":2704,"_21510":59814,"_5":14782,"_28250":59243,"_3059":59815},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3603":2922,"_31069":2704,"_21510":59817,"_5":14782,"_28250":59243,"_3059":59818},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3603":2923,"_31069":2704,"_21510":59820,"_5":14782,"_28250":59247,"_3059":59821},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3603":2924,"_31069":2704,"_21510":59823,"_5":14782,"_28250":59251,"_3059":59824},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3603":2925,"_31069":2704,"_21510":59826,"_5":14782,"_28250":59255,"_3059":59827},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3603":2926,"_31069":2704,"_21510":59829,"_5":14782,"_28250":59259,"_3059":59830},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3603":2927,"_31069":2704,"_21510":59832,"_5":14782,"_28250":59259,"_3059":59833},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3603":2928,"_31069":2704,"_21510":59835,"_5":14782,"_28250":59259,"_3059":59836},[],"`POST /v1/devices/:id/events` creates an event.",{"_3603":2929,"_31069":2704,"_21510":59838,"_5":14782,"_28250":59259,"_3059":59839},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3603":2930,"_31069":2704,"_21510":59841,"_5":14782,"_28250":59263,"_3059":59842},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3603":2931,"_31069":2704,"_21510":59844,"_5":14782,"_28250":59267,"_3059":59845},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3603":2932,"_31069":2704,"_21510":59847,"_5":14782,"_28250":59267,"_3059":59848},[],"Route",{"_3603":2933,"_31069":2704,"_21510":59850,"_5":14782,"_28250":59267,"_3059":54182},[],{"_3603":2934,"_31069":2704,"_21510":59852,"_5":14782,"_28250":59267,"_3059":59853},[],"`GET /v1/crl-settings`",{"_3603":2935,"_31069":2704,"_21510":59855,"_5":14782,"_28250":59267,"_3059":59856},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3603":2936,"_31069":2704,"_21510":59858,"_5":14782,"_28250":59267,"_3059":59859},[],"`GET /v1/crl-settings/{ca-id}`",{"_3603":2937,"_31069":2704,"_21510":59861,"_5":14782,"_28250":59267,"_3059":59862},[],"Reads the settings of a CA.",{"_3603":2938,"_31069":2704,"_21510":59864,"_5":14782,"_28250":59267,"_3059":59865},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3603":2939,"_31069":2704,"_21510":59867,"_5":14782,"_28250":59267,"_3059":59868},[],"Replaces `crl_options`.",{"_3603":2940,"_31069":2704,"_21510":59870,"_5":14782,"_28250":59267,"_3059":59871},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3603":2941,"_31069":2704,"_21510":59873,"_5":14782,"_28250":59267,"_3059":59874},[],"Removes the archived settings of a CA.",{"_3603":2942,"_31069":2704,"_21510":59876,"_5":14782,"_28250":59267,"_3059":59877},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3603":2943,"_31069":2704,"_21510":59879,"_5":14782,"_28250":59267,"_3059":59880},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3603":2944,"_31069":2704,"_21510":59882,"_5":14782,"_28250":59267,"_3059":59883},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3603":2945,"_31069":2704,"_21510":59885,"_5":14782,"_28250":59267,"_3059":59886},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3603":2946,"_31069":2704,"_21510":59888,"_5":14782,"_28250":59267,"_3059":59889},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3603":2947,"_31069":2704,"_21510":59891,"_5":14782,"_28250":59267,"_3059":59892},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3603":2948,"_31069":2704,"_21510":59894,"_5":14782,"_28250":59267,"_3059":59895},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3603":2949,"_31069":2704,"_21510":59897,"_5":14782,"_28250":59267,"_3059":59898},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3603":2950,"_31069":2704,"_21510":59900,"_5":14782,"_28250":59267,"_3059":59901},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3603":2951,"_31069":2704,"_21510":59903,"_5":14782,"_28250":59267,"_3059":59904},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3603":2952,"_31069":2704,"_21510":59906,"_5":14782,"_28250":59267,"_3059":59907},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3603":2953,"_31069":2704,"_21510":59909,"_5":14782,"_28250":59271,"_3059":59910},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3603":2954,"_31069":2704,"_21510":59912,"_5":14782,"_28250":59275,"_3059":59913},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3603":2955,"_31069":2704,"_21510":59915,"_5":14782,"_28250":59279,"_3059":59916},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3603":2956,"_31069":2704,"_21510":59918,"_5":14782,"_28250":59279,"_3059":59919},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3603":2957,"_31069":2704,"_21510":59921,"_5":14782,"_28250":59283,"_3059":59922},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3603":2958,"_31069":2704,"_21510":59924,"_5":14782,"_28250":59287,"_3059":59925},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3603":2959,"_31069":2704,"_21510":59927,"_5":14782,"_28250":59291,"_3059":59928},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3603":2960,"_31069":2704,"_21510":59930,"_5":14782,"_28250":59291,"_3059":59931},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3603":2961,"_31069":2704,"_21510":59933,"_5":14782,"_28250":59291,"_3059":59934},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3603":2962,"_31069":2704,"_21510":59936,"_5":14782,"_28250":59291,"_3059":59937},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3603":2963,"_31069":2704,"_21510":59939,"_5":14782,"_28250":59291,"_3059":59940},[],"Record the names of your local-storage PVCs:",{"_3603":2964,"_31069":2704,"_21510":59942,"_5":14782,"_28250":59291,"_3059":59943},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3603":2965,"_31069":2704,"_21510":59945,"_5":14782,"_28250":59295,"_3059":59946},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3603":2966,"_31069":2704,"_21510":59948,"_5":14782,"_28250":59295,"_3059":59949},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3603":2967,"_31069":2704,"_21510":59951,"_5":14782,"_28250":59295,"_3059":59952},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3603":2968,"_31069":2704,"_21510":59954,"_5":14782,"_28250":59295,"_3059":59955},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3603":2969,"_31069":2704,"_21510":59957,"_5":14782,"_28250":59295,"_3059":59958},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3603":2970,"_31069":2704,"_21510":59960,"_5":14782,"_28250":59299,"_3059":59961},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3603":2971,"_31069":2704,"_21510":59963,"_5":14782,"_28250":59299,"_3059":59964},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3603":2972,"_31069":2704,"_21510":59966,"_5":14782,"_28250":59299,"_3059":59967},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3603":2973,"_31069":2704,"_21510":59969,"_5":14782,"_28250":59299,"_3059":59970},[],"Secret (`existingSecret`)",{"_3603":2974,"_31069":2704,"_21510":59972,"_5":14782,"_28250":59299,"_3059":59973},[],"Required data keys",{"_3603":2975,"_31069":2704,"_21510":59975,"_5":14782,"_28250":59299,"_3059":59976},[],"When",{"_3603":2976,"_31069":2704,"_21510":59978,"_5":14782,"_28250":59299,"_3059":59979},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3603":2977,"_31069":2704,"_21510":59981,"_5":14782,"_28250":59299,"_3059":59982},[],"`username`, `password`",{"_3603":2978,"_31069":2704,"_21510":59984,"_5":14782,"_28250":59299,"_3059":59985},[],"Always",{"_3603":2979,"_31069":2704,"_21510":59987,"_5":14782,"_28250":59299,"_3059":59988},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3603":2980,"_31069":2704,"_21510":59990,"_5":14782,"_28250":59299,"_3059":59982},[],{"_3603":2981,"_31069":2704,"_21510":59992,"_5":14782,"_28250":59299,"_3059":59985},[],{"_3603":2982,"_31069":2704,"_21510":59994,"_5":14782,"_28250":59299,"_3059":59995},[],"`services.alerts.smtp_server.existingSecret`",{"_3603":2983,"_31069":2704,"_21510":59997,"_5":14782,"_28250":59299,"_3059":59982},[],{"_3603":2984,"_31069":2704,"_21510":59999,"_5":14782,"_28250":59299,"_3059":60000},[],"Only when SMTP authentication is enabled",{"_3603":2985,"_31069":2704,"_21510":60002,"_5":14782,"_28250":59299,"_3059":60003},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3603":2986,"_31069":2704,"_21510":60005,"_5":14782,"_28250":59299,"_3059":60006},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3603":2987,"_31069":2704,"_21510":60008,"_5":14782,"_28250":59299,"_3059":60009},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3603":2988,"_31069":2704,"_21510":60011,"_5":14782,"_28250":59299,"_3059":60012},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3603":2989,"_31069":2704,"_21510":60014,"_5":14782,"_28250":59299,"_3059":60015},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3603":2990,"_31069":2704,"_21510":60017,"_5":14782,"_28250":59299,"_3059":60018},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3603":2991,"_31069":2704,"_21510":60020,"_5":14782,"_28250":59299,"_3059":60021},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3603":2992,"_31069":2704,"_21510":60023,"_5":14782,"_28250":59299,"_3059":60024},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3603":2993,"_31069":2704,"_21510":60026,"_5":14782,"_28250":59299,"_3059":60027},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3603":2994,"_31069":2704,"_21510":60029,"_5":14782,"_28250":59299,"_3059":60030},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3603":2995,"_31069":2704,"_21510":60032,"_5":14782,"_28250":59299,"_3059":60033},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3603":2996,"_31069":2704,"_21510":60035,"_5":14782,"_28250":59299,"_3059":60036},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3603":2997,"_31069":2704,"_21510":60038,"_5":14782,"_28250":59299,"_3059":60039},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3603":2998,"_31069":2704,"_21510":60041,"_5":14782,"_28250":59299,"_3059":60042},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3603":2999,"_31069":2704,"_21510":60044,"_5":14782,"_28250":59299,"_3059":60045},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3603":3000,"_31069":2704,"_21510":60047,"_5":14782,"_28250":59303,"_3059":60048},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3603":3001,"_31069":2704,"_21510":60050,"_5":14782,"_28250":59303,"_3059":60051},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3603":3002,"_31069":2704,"_21510":60053,"_5":14782,"_28250":59307,"_3059":60054},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3603":3003,"_31069":2704,"_21510":60056,"_5":14782,"_28250":59307,"_3059":60057},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3603":3004,"_31069":2704,"_21510":60059,"_5":14782,"_28250":59307,"_3059":60060},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3603":3005,"_31069":2704,"_21510":60062,"_5":14782,"_28250":59307,"_3059":60063},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3603":3006,"_31069":2704,"_21510":60065,"_5":14782,"_28250":59307,"_3059":60066},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3603":3007,"_31069":2704,"_21510":60068,"_5":14782,"_28250":59307,"_3059":60069},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3603":3008,"_31069":2704,"_21510":60071,"_5":14782,"_28250":59307,"_3059":60072},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3603":3009,"_31069":2704,"_21510":60074,"_5":14782,"_28250":59307,"_3059":60075},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3603":3010,"_31069":2704,"_21510":60077,"_5":14782,"_28250":59307,"_3059":60078},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3603":3011,"_31069":2704,"_21510":60080,"_5":14782,"_28250":59307,"_3059":60081},[],"**Remove the helper and restore the recorded replica counts:**",{"_3603":3012,"_31069":2704,"_21510":60083,"_5":14782,"_28250":59307,"_3059":60084},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3603":3013,"_31069":2704,"_21510":60086,"_5":14782,"_28250":59311,"_3059":60087},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3603":3014,"_31069":2704,"_21510":60089,"_5":14782,"_28250":59311,"_3059":60090},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3603":3015,"_31069":2704,"_21510":60092,"_5":14782,"_28250":59315,"_3059":60093},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3603":3016,"_31069":2704,"_21510":60095,"_5":14782,"_28250":59315,"_3059":60096},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3603":3017,"_31069":2704,"_21510":60098,"_5":14782,"_28250":59315,"_3059":60099},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3603":3018,"_31069":2704,"_21510":60101,"_5":14782,"_28250":59315,"_3059":60102},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3603":3019,"_31069":2704,"_21510":60104,"_5":14782,"_28250":59315,"_3059":60105},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3603":3020,"_31069":2704,"_21510":60107,"_5":14782,"_28250":59315,"_3059":60108},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3603":3021,"_31069":2704,"_21510":60110,"_5":14782,"_28250":59315,"_3059":60111},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3603":3022,"_31069":2704,"_21510":60113,"_5":14782,"_28250":59315,"_3059":60114},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3603":3023,"_31069":2704,"_21510":60116,"_5":14782,"_28250":59319,"_3059":60117},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3603":3024,"_31069":2704,"_21510":60119,"_5":14782,"_28250":59319,"_3059":60120},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3603":3025,"_31069":2704,"_21510":60122,"_5":14782,"_28250":59319,"_3059":60123},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3603":3026,"_31069":2704,"_21510":60125,"_5":14782,"_28250":59319,"_3059":60126},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3603":3027,"_31069":2704,"_21510":60128,"_5":14782,"_28250":59319,"_3059":60129},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3603":3028,"_31069":2704,"_21510":60131,"_5":14782,"_28250":59319,"_3059":60132},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3603":3029,"_31069":2704,"_21510":60134,"_5":14782,"_28250":59319,"_3059":60135},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3603":3030,"_31069":2704,"_21510":60137,"_5":14782,"_28250":59319,"_3059":60138},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3603":3031,"_31069":2704,"_21510":60140,"_5":14782,"_28250":59319,"_3059":60141},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3603":3032,"_31069":2704,"_21510":60143,"_5":14782,"_28250":59319,"_3059":60144},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3603":3033,"_31069":2704,"_21510":60146,"_5":14782,"_28250":59319,"_3059":60147},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3603":3034,"_31069":2704,"_21510":60149,"_5":14782,"_28250":59322,"_3059":60150},[],"After the upgrade, check in this order:",{"_3603":3035,"_31069":2704,"_21510":60152,"_5":14782,"_28250":59322,"_3059":60153},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3603":3036,"_31069":2704,"_21510":60155,"_5":14782,"_28250":59322,"_3059":60156},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3603":3037,"_31069":2704,"_21510":60158,"_5":14782,"_28250":59322,"_3059":60159},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3603":3038,"_31069":2704,"_21510":60161,"_5":14782,"_28250":59322,"_3059":60162},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3603":3039,"_31069":2704,"_21510":60164,"_5":14782,"_28250":59322,"_3059":60165},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3603":3040,"_31069":2704,"_21510":60167,"_5":14782,"_28250":59322,"_3059":60168},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3603":3041,"_31069":2704,"_21510":60170,"_5":14782,"_28250":59322,"_3059":60171},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3603":3042,"_31069":2704,"_21510":60173,"_5":14782,"_28250":59322,"_3059":60174},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3603":3043,"_31069":2704,"_21510":60176,"_5":14782,"_28250":59322,"_3059":60177},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3603":3044,"_31069":2704,"_21510":60179,"_5":14782,"_28250":59322,"_3059":60180},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3603":3045,"_31069":2704,"_21510":60182,"_5":14782,"_28250":59322,"_3059":60183},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3603":3046,"_31069":2704,"_21510":60185,"_5":14782,"_28250":59322,"_3059":60186},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3603":3047,"_31069":2704,"_21510":60188,"_5":14782,"_28250":59322,"_3059":60189},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3603":3048,"_31069":2704,"_21510":60191,"_5":14782,"_28250":59322,"_3059":60192},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3603":3049,"_31069":2704,"_21510":60194,"_5":14782,"_28250":59322,"_3059":60195},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3603":3050,"_31069":2704,"_21510":60197,"_5":14782,"_28250":59326,"_3059":60198},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3603":3051,"_31069":2704,"_21510":60200,"_5":14782,"_28250":59326,"_3059":60201},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3603":3052,"_31069":2704,"_21510":60203,"_5":14782,"_28250":59326,"_3059":60204},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3603":3053,"_31069":2704,"_21510":60206,"_5":14782,"_28250":59326,"_3059":60207},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3603":3054,"_31069":2704,"_21510":60209,"_5":14782,"_28250":59326,"_3059":60210},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60213":60214,"_60215":60216,"_60217":60218,"_60219":60220,"_18635":3094,"_72394":3094},"language","english","sortableProperties",[3059,31069,5,28250],"sortablePropertiesWithTypes",{"_3059":25685,"_31069":25685,"_5":25685,"_28250":25685},"sorts",{"_3059":60221,"_31069":63265,"_5":66308,"_28250":69351},{"_4801":60222,"_60223":60224,"_5":25685},{"_14863":4272,"_15242":11092,"_15261":7179,"_30068":8094,"_15248":3866,"_20417":4831,"_14884":7865,"_14891":6987,"_30010":5337,"_30424":4218,"_30445":17162,"_30044":4637,"_35469":5108,"_30147":7769,"_30489":5097,"_35476":30660,"_35479":7739,"_35482":26692,"_35485":5897,"_30891":11301,"_35490":5002,"_35492":6176,"_30926":6168,"_15257":3349,"_35496":6819,"_35499":7443,"_35501":6407,"_30473":3555,"_30911":3558,"_30939":5154,"_35506":10405,"_35508":8695,"_35510":6198,"_30164":3159,"_35513":7298,"_35515":7176,"_35517":5309,"_35519":3784,"_35521":8858,"_30081":6770,"_35524":7503,"_35526":7861,"_30075":12678,"_30510":20920,"_35530":3309,"_35532":7439,"_35535":10970,"_30121":15299,"_35539":5127,"_30001":4170,"_35542":6045,"_30049":3477,"_35545":4554,"_35547":3465,"_35550":7884,"_15251":9052,"_35553":7269,"_35555":10493,"_35558":3557,"_35560":4206,"_35562":11659,"_35564":7909,"_35566":10404,"_20420":5345,"_35569":3380,"_35571":6143,"_30022":4910,"_30467":5346,"_35575":7738,"_35577":4353,"_35579":4888,"_30956":6505,"_35582":3362,"_31134":6239,"_35585":5616,"_31049":12655,"_30526":8226,"_35589":3531,"_35591":4320,"_30059":6585,"_35594":3124,"_35596":17175,"_35598":19007,"_30972":29369,"_30141":12691,"_29521":4938,"_35603":6516,"_35605":6017,"_35607":6710,"_30190":3774,"_35611":7295,"_30461":21421,"_35615":21652,"_35617":4461,"_35619":14706,"_35621":5210,"_35623":6179,"_35625":5217,"_30179":4329,"_30429":6373,"_35629":3901,"_35631":21945,"_35633":5112,"_35636":3514,"_35638":4330,"_35640":9340,"_35642":17291,"_35644":10426,"_35646":9104,"_35648":21459,"_35651":16226,"_35653":