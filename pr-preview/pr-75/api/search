atform/pki/certificate-authorities#elige-el-tipo-de-ca","content":"Elige el tipo de CA"},"1883":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-7","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-identidad","content":"Define la identidad"},"1884":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-8","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#configura-validez-y-usos","content":"Configura validez y usos"},"1885":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-9","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#crea-y-verifica","content":"Crea y verifica"},"1886":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-10","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","content":"Utiliza una clave del KMS"},"1887":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-11","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#importa-una-ca-externa","content":"Importa una CA externa"},"1888":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-12","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#selecciona-el-motor","content":"Selecciona el motor"},"1889":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-13","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#carga-el-material","content":"Carga el material"},"1890":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-14","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","content":"Define la emisión predeterminada"},"1891":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-15","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#verifica-la-importación","content":"Verifica la importación"},"1892":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-16","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Inspecciona una autoridad"},"1893":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-17","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#emite-certificados","content":"Emite certificados"},"1894":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-18","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#revoca-una-ca","content":"Revoca una CA"},"1895":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-19","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#evalúa-el-impacto","content":"Evalúa el impacto"},"1896":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-20","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inicia-la-revocación","content":"Inicia la revocación"},"1897":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-21","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#confirma-la-identidad","content":"Confirma la identidad"},"1898":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-22","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#comprueba-la-publicación","content":"Comprueba la publicación"},"1899":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-23","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elimina-una-ca","content":"Elimina una CA"},"1900":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-24","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","content":"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa."},"1901":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-25","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","content":"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado."},"1902":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-26","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","content":"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena."},"1903":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-27","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-un-flujo","content":"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves."},"1904":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-28","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-un-flujo","content":"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma."},"1905":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-29","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-un-flujo","content":"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir."},"1906":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-30","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-un-flujo","content":"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir."},"1907":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-31","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-un-flujo","content":"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo."},"1908":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-32","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#antes-de-empezar","content":"Decide si la CA será raíz o intermedia."},"1909":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-33","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#antes-de-empezar","content":"Elige el motor que custodiará la clave."},"1910":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-34","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#antes-de-empezar","content":"Define una validez superior a la de los certificados que emitirá."},"1911":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-35","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#antes-de-empezar","content":"Para una CA intermedia, asegúrate de que la CA padre esté activa."},"1912":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-36","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#abre-el-asistente","content":"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo."},"1913":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-37","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#configura-la-clave","content":"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor."},"1914":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-38","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#configura-la-clave","content":"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo."},"1915":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-39","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","content":"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora."},"1916":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-40","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-identidad","content":"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:"},"1917":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-41","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-identidad","content":"`C`: código de país ISO 3166-1 de dos letras."},"1918":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-42","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-identidad","content":"`ST`: estado o provincia."},"1919":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-43","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-identidad","content":"`L`: localidad."},"1920":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-44","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-identidad","content":"`O`: organización."},"1921":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-45","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-identidad","content":"`OU`: unidad organizativa."},"1922":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-46","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-identidad","content":"El identificador interno de la CA se genera automáticamente y no se puede modificar."},"1923":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-47","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#configura-validez-y-usos","content":"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida."},"1924":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-48","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#configura-validez-y-usos","content":"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores."},"1925":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-49","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#crea-y-verifica","content":"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar."},"1926":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-50","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#crea-y-verifica","content":"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades."},"1927":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-51","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","content":"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil."},"1928":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-52","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","content":"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta."},"1929":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-53","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#importa-una-ca-externa","content":"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA."},"1930":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-54","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#importa-una-ca-externa","content":"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo."},"1931":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-55","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#importa-una-ca-externa","content":"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado."},"1932":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-56","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#importa-una-ca-externa","content":"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves."},"1933":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-57","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#selecciona-el-motor","content":"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS."},"1934":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-58","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#carga-el-material","content":"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos."},"1935":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-59","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#carga-el-material","content":"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente."},"1936":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-60","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","content":"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles."},"1937":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-61","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#verifica-la-importación","content":"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar."},"1938":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-62","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#verifica-la-importación","content":"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL)."},"1939":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-63","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#verifica-la-importación","content":"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado."},"1940":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-64","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Abre una CA desde el inventario para consultar:"},"1941":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-65","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Estado y periodo de validez."},"1942":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-66","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Certificado y cadena en formato PEM."},"1943":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-67","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Número de certificados activos, expirados y revocados."},"1944":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-68","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Certificados emitidos en **Issued Certificates**."},"1945":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-69","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"CRL vinculada a la autoridad."},"1946":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-70","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Metadatos y motor criptográfico asociado."},"1947":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-71","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Puedes filtrar el inventario por nombre, estado y tipo de CA."},"1948":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-72","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#emite-certificados","content":"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados."},"1949":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-73","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#emite-certificados","content":"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar."},"1950":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-74","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#emite-certificados","content":"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada."},"1951":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-75","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#emite-certificados","content":"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación."},"1952":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-76","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#emite-certificados","content":"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos."},"1953":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-77","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#emite-certificados","content":"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla."},"1954":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-78","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#revoca-una-ca","content":"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada."},"1955":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-79","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#evalúa-el-impacto","content":"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario."},"1956":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-80","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inicia-la-revocación","content":"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`."},"1957":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-81","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#confirma-la-identidad","content":"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**."},"1958":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-82","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#comprueba-la-publicación","content":"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre."},"1959":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-83","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elimina-una-ca","content":"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita."},"1960":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-84","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elimina-una-ca","content":"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala."},"1961":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-85","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elimina-una-ca","content":"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada."},"1962":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-86","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elimina-una-ca","content":"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien."},"1963":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities-87","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elimina-una-ca","content":"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL)."},"1964":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"page","content":"Perfiles de certificado","breadcrumbs":["Docs","Plataforma","PKI","Claves, autoridades y certificados"],"tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles"},"1965":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-0","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","content":"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas."},"1966":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-1","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#qué-controla-un-perfil","content":"Qué controla un perfil"},"1967":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-2","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#validez","content":"Validez"},"1968":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-3","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","content":"Certificado de CA o certificado final"},"1969":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-4","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","content":"Key Usage y Extended Key Usage"},"1970":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-5","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#sujeto","content":"Sujeto"},"1971":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-6","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#extensiones-de-la-csr","content":"Extensiones de la CSR"},"1972":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-7","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"Restricciones criptográficas"},"1973":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-8","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Precedencia del perfil"},"1974":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-9","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#crea-un-perfil","content":"Crea un perfil"},"1975":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-10","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#define-un-único-propósito","content":"Define un único propósito"},"1976":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-11","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#elige-la-validez","content":"Elige la validez"},"1977":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-12","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","content":"Fija usos y sujeto"},"1978":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-13","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restringe-las-claves","content":"Restringe las claves"},"1979":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-14","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#asócialo-y-prueba","content":"Asócialo y prueba"},"1980":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-15","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#ejemplos-de-diseño","content":"Ejemplos de diseño"},"1981":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-16","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#cambios-y-eliminación","content":"Cambios y eliminación"},"1982":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-17","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","content":"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta."},"1983":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-18","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","content":"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos."},"1984":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-19","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#validez","content":"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada."},"1985":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-20","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#validez","content":"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable."},"1986":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-21","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","content":"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil."},"1987":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-22","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","content":"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`."},"1988":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-23","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","content":"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil."},"1989":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-24","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","content":"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas."},"1990":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-25","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#sujeto","content":"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado."},"1991":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-26","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#extensiones-de-la-csr","content":"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR."},"1992":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-27","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#extensiones-de-la-csr","content":"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR."},"1993":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-28","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"La aplicación criptográfica puede:"},"1994":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-29","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"permitir o bloquear claves RSA;"},"1995":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-30","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"limitar los tamaños RSA admitidos;"},"1996":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-31","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"permitir o bloquear claves ECDSA;"},"1997":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-32","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"limitar los tamaños o curvas ECDSA admitidos."},"1998":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-33","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza."},"1999":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-34","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA."},"2000":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-35","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Operación"},"2001":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-36","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Primera opción"},"2002":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-37","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Segunda opción"},"2003":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-38","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Si no hay ninguna"},"2004":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-39","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Firma directa con una CA"},"2005":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-40","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"`issuance_profile` incluido en la solicitud"},"2006":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-41","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"`issuance_profile_id` de la solicitud"},"2007":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-42","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Perfil predeterminado de la CA (`profile_id`)."},"2008":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-43","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Emisión mediante DMS"},"2009":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-44","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"`settings.issuance_profile_id`"},"2010":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-45","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"`settings.issuance_profile` incluido en el DMS"},"2011":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-46","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Perfil predeterminado de la CA de enrolamiento."},"2012":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-47","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR."},"2013":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-48","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS."},"2014":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-49","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#define-un-único-propósito","content":"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos."},"2015":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-50","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#elige-la-validez","content":"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA."},"2016":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-51","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","content":"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita."},"2017":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-52","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restringe-las-claves","content":"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos."},"2018":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-53","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#asócialo-y-prueba","content":"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`."},"2019":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-54","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#asócialo-y-prueba","content":"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto."},"2020":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-55","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#ejemplos-de-diseño","content":"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo."},"2021":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-56","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#ejemplos-de-diseño","content":"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes."},"2022":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-57","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#ejemplos-de-diseño","content":"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes."},"2023":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-58","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#ejemplos-de-diseño","content":"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor."},"2024":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-59","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#cambios-y-eliminación","content":"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa."},"2025":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles-60","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#cambios-y-eliminación","content":"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior."},"2026":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","type":"page","content":"Validación de certificados","breadcrumbs":["Docs","Plataforma","PKI","Validación"],"tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation"},"2027":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-0","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","content":"Comprueba cadena, identidad, usos y revocación desde el consumidor."},"2028":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-1","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Antes de consultar el estado"},"2029":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-2","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Elige un mecanismo"},"2030":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-3","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Comprueba el comportamiento del consumidor"},"2031":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-4","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","content":"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación."},"2032":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-5","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Verifica estos criterios juntos:"},"2033":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-6","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Comprobación"},"2034":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-7","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Resultado necesario"},"2035":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-8","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Cadena y firma"},"2036":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-9","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Cadena válida hasta una raíz instalada deliberadamente en el consumidor."},"2037":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-10","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Fechas"},"2038":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-11","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena."},"2039":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-12","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Identidad"},"2040":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-13","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Nombre, SAN o identificador corresponden al interlocutor esperado."},"2041":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-14","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Uso"},"2042":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-15","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"KU, EKU y restricciones permiten la operación concreta."},"2043":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-16","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Revocación"},"2044":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-17","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados."},"2045":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-18","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Autorización"},"2046":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-19","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"La aplicación permite la acción a esa identidad."},"2047":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-20","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios."},"2048":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-21","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Mecanismo"},"2049":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-22","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Cuándo utilizarlo"},"2050":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-23","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Qué debes mantener"},"2051":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-24","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"OCSP"},"2052":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-25","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Consulta del estado de un certificado concreto."},"2053":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-26","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Acceso al respondedor, verificación de la firma y política de caché/vigencia."},"2054":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-27","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"CRL"},"2055":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-28","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Consulta local de muchos certificados o funcionamiento offline."},"2056":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-29","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas."},"2057":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-30","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla."},"2058":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-31","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación."},"2059":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-32","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Acepta un certificado vigente, autorizado y con cadena conocida."},"2060":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-33","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Rechaza otro con raíz desconocida o uso incompatible."},"2061":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-34","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL."},"2062":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-35","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Comprueba que una conexión nueva con esa identidad se rechaza."},"2063":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-36","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política."},"2064":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-37","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente."},"2065":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-38","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena."},"2066":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-39","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />"},"2067":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation-40","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />"},"2068":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","type":"page","content":"Certificados","breadcrumbs":["Docs","Plataforma","PKI","Claves, autoridades y certificados"],"tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificates"},"2069":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-0","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates","content":"Consulta, descarga y revoca los certificados emitidos por Lamassu."},"2070":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-1","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#busca-un-certificado","content":"Busca un certificado"},"2071":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-2","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#descarga-el-certificado","content":"Descarga el certificado"},"2072":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-3","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Emite desde una CSR existente"},"2073":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-4","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#revoca-un-certificado","content":"Revoca un certificado"},"2074":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-5","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#abre-la-acción","content":"Abre la acción"},"2075":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-6","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#elige-una-razón","content":"Elige una razón"},"2076":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-7","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#confirma-y-verifica","content":"Confirma y verifica"},"2077":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-8","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#reactiva-una-suspensión","content":"Reactiva una suspensión"},"2078":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-9","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#continúa","content":"Continúa"},"2079":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-10","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates","content":"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor."},"2080":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-11","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#busca-un-certificado","content":"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:"},"2081":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-12","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#busca-un-certificado","content":"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**."},"2082":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-13","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#busca-un-certificado","content":"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos."},"2083":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-14","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#busca-un-certificado","content":"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu."},"2084":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-15","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#busca-un-certificado","content":"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos."},"2085":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-16","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#busca-un-certificado","content":"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0."},"2086":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-17","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#busca-un-certificado","content":"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas."},"2087":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-18","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#descarga-el-certificado","content":"Descarga el PEM e inspecciónalo:"},"2088":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-19","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#descarga-el-certificado","content":"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado."},"2089":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-20","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado."},"2090":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-21","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada."},"2091":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-22","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**."},"2092":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-23","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven."},"2093":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-24","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen."},"2094":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-25","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración."},"2095":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-26","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Para generar la clave en el navegador, sigue Emite tu primer certificado."},"2096":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-27","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#revoca-un-certificado","content":"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria."},"2097":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-28","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#abre-la-acción","content":"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado."},"2098":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-29","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#elige-una-razón","content":"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida."},"2099":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-30","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#confirma-y-verifica","content":"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor."},"2100":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-31","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#confirma-y-verifica","content":"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos."},"2101":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-32","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#confirma-y-verifica","content":"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias."},"2102":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-33","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#reactiva-una-suspensión","content":"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu."},"2103":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-34","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#reactiva-una-suspensión","content":"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia."},"2104":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-35","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#reactiva-una-suspensión","content":"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA."},"2105":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-36","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#continúa","content":"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />"},"2106":{"id":"/docs/pr-preview/pr-75/es/platform/pki/certificates-37","page_id":"/docs/pr-preview/pr-75/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/certificates#continúa","content":"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />"},"2107":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","type":"page","content":"Ciclo de vida de un certificado","breadcrumbs":["Docs","Plataforma","PKI","Conceptos"],"tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle"},"2108":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-0","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","content":"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu."},"2109":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-1","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","content":"El recorrido completo"},"2110":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-2","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#solicitud","content":"Solicitud"},"2111":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-3","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#emisión","content":"Emisión"},"2112":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-4","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","content":"Uso y supervisión"},"2113":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-5","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","content":"Renovación o re-enrolamiento"},"2114":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-6","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","content":"Revocación o retirada"},"2115":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-7","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"Estados del certificado"},"2116":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-8","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"Renovación y revocación no son equivalentes"},"2117":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-9","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Efecto de revocar una CA"},"2118":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-10","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Qué debes observar"},"2119":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-11","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","content":"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado."},"2120":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-12","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#solicitud","content":"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó."},"2121":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-13","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#emisión","content":"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas."},"2122":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-14","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","content":"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido."},"2123":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-15","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","content":"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST."},"2124":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-16","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","content":"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado."},"2125":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-17","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"Lamassu persiste cuatro estados X.509:"},"2126":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-18","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal."},"2127":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-19","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente."},"2128":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-20","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal."},"2129":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-21","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva."},"2130":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-22","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509."},"2131":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-23","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad."},"2132":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-24","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación."},"2133":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-25","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento."},"2134":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-26","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones."},"2135":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-27","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Antes de confirmar:"},"2136":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-28","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Identifica DMS, dispositivos y servicios que confían en esa cadena."},"2137":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-29","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Distribuye la nueva cadena de confianza."},"2138":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-30","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Reemite las identidades necesarias."},"2139":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-31","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Comprueba OCSP y CRL desde un consumidor real."},"2140":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-32","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Revoca la CA antigua cuando ya no exista tráfico legítimo."},"2141":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-33","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos."},"2142":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-34","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Certificados que entran en la ventana preventiva o crítica de renovación."},"2143":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-35","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Errores repetidos de enrolamiento o re-enrolamiento."},"2144":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-36","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Cambios de estado y razones de revocación."},"2145":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-37","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Publicación y vigencia de OCSP y CRLs."},"2146":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-38","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Dependencias que todavía presentan un certificado sustituido."},"2147":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle-39","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría."},"2148":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","type":"page","content":"Modelo de confianza","breadcrumbs":["Docs","Plataforma","PKI","Conceptos"],"tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model"},"2149":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-0","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","content":"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente."},"2150":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-1","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","content":"Las cuatro decisiones de confianza"},"2151":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-2","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-puede-emitir","content":"Quién puede emitir"},"2152":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-3","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#qué-puede-emitirse","content":"Qué puede emitirse"},"2153":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-4","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","content":"Quién puede solicitarlo"},"2154":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-5","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","content":"Quién acepta el resultado"},"2155":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-6","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"Flujo de una identidad"},"2156":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-7","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"CAs de enrolamiento, validación y distribución"},"2157":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-8","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"Validación y revocación"},"2158":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-9","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#límites-de-custodia","content":"Límites de custodia"},"2159":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-10","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Patrón recomendado"},"2160":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-11","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","content":"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente."},"2161":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-12","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-puede-emitir","content":"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión."},"2162":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-13","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#qué-puede-emitirse","content":"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión."},"2163":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-14","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","content":"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva."},"2164":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-15","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","content":"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces."},"2165":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-16","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El dispositivo demuestra que puede enrolarse según la política del DMS."},"2166":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-17","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento."},"2167":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-18","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada."},"2168":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-19","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El dispositivo instala el certificado y la cadena que necesita."},"2169":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-20","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación."},"2170":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-21","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable."},"2171":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-22","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"Un DMS relaciona tres conjuntos que conviene diseñar por separado:"},"2172":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-23","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"**CA de enrolamiento:** firma las nuevas identidades."},"2173":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-24","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales."},"2174":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-25","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes."},"2175":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-26","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento."},"2176":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-27","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:"},"2177":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-28","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"que la fecha actual está entre `Not Before` y `Not After`;"},"2178":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-29","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"que `Key Usage` y `Extended Key Usage` permiten la operación;"},"2179":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-30","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"que nombres, SANs y sujeto coinciden con la identidad esperada;"},"2180":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-31","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"que el certificado no aparece revocado mediante OCSP o una CRL."},"2181":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-32","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios."},"2182":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-33","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción."},"2183":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-34","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#límites-de-custodia","content":"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones."},"2184":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-35","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido."},"2185":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-36","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Emite desde CAs intermedias separadas por entorno o dominio de riesgo."},"2186":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-37","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Asigna perfiles explícitos a cada caso de uso."},"2187":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-38","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Distribuye la nueva confianza antes de comenzar una rotación."},"2188":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-39","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Mantén solapamiento suficiente para renovar una flota desconectada."},"2189":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-40","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Valida desde el sistema consumidor, no solo desde la consola de Lamassu."},"2190":{"id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model-41","page_id":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo."},"2191":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","type":"page","content":"Listas de revocación (CRL)","breadcrumbs":["Docs","Plataforma","PKI","Validación"],"tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/crl"},"2192":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-0","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl","content":"Genera y distribuye listas firmadas para validar certificados sin conexión."},"2193":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-1","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Ajustes de CRL"},"2194":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-2","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/crl#cas-que-comparten-clave","content":"CAs que comparten clave"},"2195":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-3","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","content":"Regeneración periódica y automática"},"2196":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-4","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/crl#contenido-de-la-crl","content":"Contenido de la CRL"},"2197":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-5","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/crl#endpoint-público-de-descarga","content":"Endpoint público de descarga"},"2198":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-6","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"API de gestión de los ajustes de CRL"},"2199":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-7","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Errores frecuentes de los ajustes de CRL"},"2200":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-8","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/crl#referencias","content":"Referencias"},"2201":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-9","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl","content":"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia."},"2202":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-10","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible."},"2203":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-11","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Campo"},"2204":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-12","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Función"},"2205":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-13","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"`ca_id`"},"2206":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-14","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"ID de la CA a la que pertenecen los ajustes."},"2207":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-15","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"`status`"},"2208":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-16","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera."},"2209":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-17","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"`legacy_ski`"},"2210":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-18","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos."},"2211":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-19","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"`latest_crl`"},"2212":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-20","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Versión, inicio y fin de validez de la última lista publicada. Solo lectura."},"2213":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-21","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Campo de `crl_options`"},"2214":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-22","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Función"},"2215":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-23","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Valor inicial"},"2216":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-24","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"`validity`"},"2217":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-25","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Tiempo desde `thisUpdate` hasta `nextUpdate`."},"2218":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-26","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"7 días."},"2219":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-27","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"`refresh_interval`"},"2220":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-28","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática)."},"2221":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-29","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"6 días y 23 horas."},"2222":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-30","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"`regenerate_on_revoke`"},"2223":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-31","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`."},"2224":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-32","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"`true`."},"2225":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-33","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"`signer_serial_number`"},"2226":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-34","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Número de serie del certificado existente que firma la CRL."},"2227":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-35","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Número de serie del certificado actual de la CA."},"2228":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-36","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza."},"2229":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-37","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`."},"2230":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-38","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual."},"2231":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-39","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior."},"2232":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-40","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:"},"2233":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-41","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API."},"2234":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-42","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración."},"2235":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-43","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA."},"2236":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-44","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido."},"2237":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-45","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave."},"2238":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-46","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","content":"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose."},"2239":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-47","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#cas-que-comparten-clave","content":"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA."},"2240":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-48","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#cas-que-comparten-clave","content":"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo."},"2241":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-49","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#cas-que-comparten-clave","content":"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos."},"2242":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-50","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#cas-que-comparten-clave","content":"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs."},"2243":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-51","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","content":"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:"},"2244":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-52","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","content":"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse."},"2245":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-53","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","content":"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer."},"2246":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-54","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","content":"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job."},"2247":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-55","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","content":"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo."},"2248":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-56","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","content":"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen."},"2249":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-57","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","content":"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL."},"2250":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-58","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","content":"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado."},"2251":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-59","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","content":"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente."},"2252":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-60","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#contenido-de-la-crl","content":"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido."},"2253":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-61","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#contenido-de-la-crl","content":"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria."},"2254":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-62","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#endpoint-público-de-descarga","content":"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:"},"2255":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-63","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#endpoint-público-de-descarga","content":"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:"},"2256":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-64","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#endpoint-público-de-descarga","content":"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:"},"2257":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-65","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#endpoint-público-de-descarga","content":"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija."},"2258":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-66","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#endpoint-público-de-descarga","content":"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie."},"2259":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-67","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL."},"2260":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-68","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"Método"},"2261":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-69","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"Path relativo"},"2262":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-70","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"Operación"},"2263":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-71","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"`GET`"},"2264":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-72","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"`/v1/crl-settings`"},"2265":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-73","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`."},"2266":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-74","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"`GET`"},"2267":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-75","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"`/v1/crl-settings/{ca-id}`"},"2268":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-76","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"Consultar los `crl_options` y `latest_crl` de una CA."},"2269":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-77","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"`PUT`"},"2270":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-78","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"`/v1/crl-settings/{ca-id}`"},"2271":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-79","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"Sustituir la configuración de CRL de una CA."},"2272":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-80","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"`DELETE`"},"2273":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-81","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"`/v1/crl-settings/{ca-id}`"},"2274":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-82","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"Eliminar los ajustes de CRL archivados de una CA."},"2275":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-83","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL."},"2276":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-84","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse."},"2277":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-85","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","content":"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente."},"2278":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-86","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Síntoma"},"2279":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-87","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Causa"},"2280":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-88","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Acción"},"2281":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-89","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"`PUT /v1/crl-settings/{ca-id}` devuelve 409."},"2282":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-90","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización."},"2283":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-91","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose."},"2284":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-92","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"`DELETE /v1/crl-settings/{ca-id}` devuelve 409."},"2285":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-93","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado."},"2286":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-94","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Elimina primero la CA; su eliminación archiva los ajustes."},"2287":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-95","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"`PUT` devuelve 400."},"2288":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-96","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA."},"2289":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-97","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Asigna el número de serie de un certificado válido de esa CA."},"2290":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-98","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"`PUT` devuelve 404."},"2291":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-99","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`."},"2292":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-100","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Revisa el ID de CA y el número de serie del firmante."},"2293":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-101","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"`PUT` devuelve 400 desde un cliente de 3.x."},"2294":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-102","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio."},"2295":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-103","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Actualiza el cliente para enviar el campo nuevo."},"2296":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-104","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"La CRL no cambia tras revocar un certificado."},"2297":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-105","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido."},"2298":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-106","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante."},"2299":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-107","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Un verificador rechaza la CRL por el emisor."},"2300":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-108","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización."},"2301":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-109","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","content":"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`."},"2302":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-110","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#referencias","content":"RFC 5280: perfil X.509 y CRL."},"2303":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-111","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#referencias","content":"OpenSSL: openssl-crl."},"2304":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-112","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#referencias","content":"OpenSSL: openssl-verify."},"2305":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-113","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#referencias","content":"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />"},"2306":{"id":"/docs/pr-preview/pr-75/es/platform/pki/crl-114","page_id":"/docs/pr-preview/pr-75/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/crl#referencias","content":"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />"},"2307":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"page","content":"Claves y motores criptográficos","breadcrumbs":["Docs","Plataforma","PKI","Claves, autoridades y certificados"],"tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management"},"2308":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-0","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management","content":"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto."},"2309":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-1","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Qué resuelve el KMS"},"2310":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-2","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#motores-criptográficos","content":"Motores criptográficos"},"2311":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-3","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#file-system","content":"File System"},"2312":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-4","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#hashicorp-vault","content":"HashiCorp Vault"},"2313":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-5","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#aws-secrets-manager","content":"AWS Secrets Manager"},"2314":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-6","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#aws-kms","content":"AWS KMS"},"2315":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-7","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#pkcs11","content":"PKCS#11"},"2316":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-8","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#azure-key-vault","content":"Azure Key Vault"},"2317":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-9","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","content":"Inventario de claves"},"2318":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-10","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#crear-o-importar-claves","content":"Crear o importar claves"},"2319":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-11","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"Generar un nuevo par de claves"},"2320":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-12","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#importar-un-par-existente","content":"Importar un par existente"},"2321":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-13","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#operaciones-sobre-una-clave","content":"Operaciones sobre una clave"},"2322":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-14","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#ver-detalles","content":"Ver detalles"},"2323":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-15","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#firmar-y-verificar","content":"Firmar y verificar"},"2324":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-16","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#sign","content":"Sign"},"2325":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-17","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#verify","content":"Verify"},"2326":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-18","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#generar-un-csr","content":"Generar un CSR"},"2327":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-19","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#firma-local-con-pkcs11","content":"Firma local con PKCS#11"},"2328":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-20","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#antes-de-eliminar-una-clave","content":"Antes de eliminar una clave"},"2329":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-21","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management","content":"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI."},"2330":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-22","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management","content":"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema."},"2331":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-23","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#qué-resuelve-el-kms","content":"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto."},"2332":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-24","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#qué-resuelve-el-kms","content":"En la práctica, permite:"},"2333":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-25","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Generar nuevos pares de claves desde Lamassu IoT."},"2334":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-26","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Importar claves creadas externamente."},"2335":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-27","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Delegar la custodia y las operaciones criptográficas en motores externos."},"2336":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-28","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación."},"2337":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-29","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#motores-criptográficos","content":"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada."},"2338":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-30","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#motores-criptográficos","content":"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios."},"2339":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-31","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#motores-criptográficos","content":"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración."},"2340":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-32","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#file-system","content":"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos."},"2341":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-33","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#hashicorp-vault","content":"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue."},"2342":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-34","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#hashicorp-vault","content":"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue."},"2343":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-35","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#aws-secrets-manager","content":"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM."},"2344":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-36","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#aws-kms","content":"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas."},"2345":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-37","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#pkcs11","content":"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware."},"2346":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-38","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#azure-key-vault","content":"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias."},"2347":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-39","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#azure-key-vault","content":"Lamassu muestra en la consola el listado de motores habilitados."},"2348":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-40","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#azure-key-vault","content":"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar."},"2349":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-41","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#azure-key-vault","content":"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA."},"2350":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-42","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","content":"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas."},"2351":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-43","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","content":"La tabla incluye los siguientes campos:"},"2352":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-44","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","content":"**Name**: nombre descriptivo de la clave."},"2353":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-45","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","content":"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256."},"2354":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-46","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","content":"**Strength**: indicador visual de fortaleza criptográfica."},"2355":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-47","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","content":"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública."},"2356":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-48","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","content":"**Crypto Engine**: motor criptográfico que custodia la clave."},"2357":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-49","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","content":"**Aliases**: nombres alternativos asociados a la clave."},"2358":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-50","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","content":"**Tags**: etiquetas para clasificación y búsqueda."},"2359":{"id":"/docs/pr-preview/pr-75/es/platform/pki/key-management-51","page_id":"/docs/pr-preview/pr-75/es/platform/pki/key-management","tags":[],"t