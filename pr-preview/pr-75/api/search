/audit-logs-9","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#compare-intent-and-result","content":"Compare intent and result"},"780":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-10","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#follow-the-effect","content":"Follow the effect"},"781":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-11","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#periodic-verification","content":"Periodic verification"},"782":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-12","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs","content":"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error."},"783":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-13","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#what-an-event-contains","content":"The audit body includes:"},"784":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-14","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#what-an-event-contains","content":"input: data received by the operation;"},"785":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-15","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#what-an-event-contains","content":"has\\_error: whether the service returned an error;"},"786":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-16","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#what-an-event-contains","content":"output: produced result or error message;"},"787":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-17","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#what-an-event-contains","content":"principals: identifiers of the principals that matched the request."},"788":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-18","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#what-an-event-contains","content":"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type."},"789":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-19","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#what-an-event-contains","content":"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes."},"790":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-20","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#coverage","content":"The backend applies auditing to mutations of:"},"791":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-21","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#coverage","content":"authorities, certificates and issuance profiles;"},"792":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-22","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#coverage","content":"keys and KMS engines;"},"793":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-23","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#coverage","content":"devices and identities;"},"794":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-24","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#coverage","content":"DMSs and enrollment operations;"},"795":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-25","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#coverage","content":"validation functions and CRL;"},"796":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-26","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#coverage","content":"principals, policies and authorization grants."},"797":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-27","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#coverage","content":"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation."},"798":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-28","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","content":"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file."},"799":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-29","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","content":"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization."},"800":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-30","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","content":"Design the consumer to:"},"801":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-31","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","content":"subscribe to the audit.# types and also to operation types ending in .error;"},"802":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-32","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","content":"keep the complete CloudEvent unmodified;"},"803":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-33","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","content":"record the ingestion time and detect duplicates by ID;"},"804":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-34","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","content":"encrypt in transit and at rest;"},"805":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-35","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","content":"restrict reading and deletion to a role separate from the PKI operator;"},"806":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-36","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","content":"apply an explicit retention and legal hold policy;"},"807":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-37","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","content":"alert if it stops consuming or the pending queue grows."},"808":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-38","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#sensitive-data","content":"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform."},"809":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-39","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#sensitive-data","content":"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution."},"810":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-40","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#bound-the-interval","content":"Start from the reported time and normalize every source to UTC."},"811":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-41","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#identify-the-operation","content":"Filter by event type, service source and resource identifier."},"812":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-42","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#attribute-the-principal","content":"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment."},"813":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-43","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#compare-intent-and-result","content":"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed."},"814":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-44","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#follow-the-effect","content":"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations."},"815":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-45","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#periodic-verification","content":"Generate a controlled mutation in a test environment and check that:"},"816":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-46","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#periodic-verification","content":"a successful audit event appears;"},"817":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-47","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#periodic-verification","content":"the principal matches the identity used;"},"818":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-48","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#periodic-verification","content":"the consumer persists it exactly once;"},"819":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-49","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#periodic-verification","content":"it can be retrieved by resource, actor and period;"},"820":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-50","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#periodic-verification","content":"a consumer outage raises an alert."},"821":{"id":"/docs/pr-preview/pr-75/platform/administration/audit-logs-51","page_id":"/docs/pr-preview/pr-75/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/audit-logs#periodic-verification","content":"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved."},"822":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","type":"page","content":"Platform architecture","breadcrumbs":["Docs","Platform"],"tags":[],"url":"/docs/pr-preview/pr-75/platform/concepts/architecture"},"823":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-0","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/architecture","content":"Lamassu components and how control, keys, issuance and devices relate."},"824":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-1","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/concepts/architecture#control-plane","content":"Control plane"},"825":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-2","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/concepts/architecture#key-custody-and-cryptographic-operations","content":"Key custody and cryptographic operations"},"826":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-3","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/concepts/architecture#issuance-and-enrollment","content":"Issuance and enrollment"},"827":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-4","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/concepts/architecture#status-and-validation","content":"Status and validation"},"828":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-5","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/concepts/architecture#platform-dependencies","content":"Platform dependencies"},"829":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-6","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/architecture","content":"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load."},"830":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-7","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/architecture","content":"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies."},"831":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-8","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/architecture#control-plane","content":"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform."},"832":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-9","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/architecture#key-custody-and-cryptographic-operations","content":"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation."},"833":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-10","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/architecture#issuance-and-enrollment","content":"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity."},"834":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-11","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/architecture#status-and-validation","content":"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate."},"835":{"id":"/docs/pr-preview/pr-75/platform/concepts/architecture-12","page_id":"/docs/pr-preview/pr-75/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/architecture#platform-dependencies","content":"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes."},"836":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","type":"page","content":"How Lamassu works","breadcrumbs":["Docs","Platform"],"tags":[],"url":"/docs/pr-preview/pr-75/platform/concepts/overview"},"837":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-0","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview","content":"The mental model of trust, keys, certificates and devices."},"838":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-1","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/concepts/overview#the-model-in-five-pieces","content":"The model in five pieces"},"839":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-2","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/concepts/overview#from-onboarding-to-operation","content":"From onboarding to operation"},"840":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-3","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview","content":"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle."},"841":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-4","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#the-model-in-five-pieces","content":"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services."},"842":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-5","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#the-model-in-five-pieces","content":"**Certification Authority (CA).** Signs certificates and establishes the chain of trust."},"843":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-6","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#the-model-in-five-pieces","content":"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed."},"844":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-7","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#the-model-in-five-pieces","content":"**Device.** Keeps its private key and presents the certificate to prove its identity."},"845":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-8","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#the-model-in-five-pieces","content":"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL."},"846":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-9","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#from-onboarding-to-operation","content":"An administrator configures a cryptographic engine and creates or imports a CA."},"847":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-10","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#from-onboarding-to-operation","content":"A DMS relates that CA to an enrollment policy."},"848":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-11","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#from-onboarding-to-operation","content":"The device generates a key and requests a certificate through EST, or an operator assigns it an identity."},"849":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-12","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#from-onboarding-to-operation","content":"Lamassu keeps the inventory, history and status of the identity."},"850":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-13","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#from-onboarding-to-operation","content":"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid."},"851":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-14","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#from-onboarding-to-operation","content":"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />"},"852":{"id":"/docs/pr-preview/pr-75/platform/concepts/overview-15","page_id":"/docs/pr-preview/pr-75/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/concepts/overview#from-onboarding-to-operation","content":"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />"},"853":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"page","content":"Devices and identities","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities"],"tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management"},"854":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-0","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","content":"Register, inspect and retire devices while checking their current identity and history."},"855":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-1","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"Device states"},"856":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-2","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#inspect-a-device","content":"Inspect a device"},"857":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-3","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#register-a-device-manually","content":"Register a device manually"},"858":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-4","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#create-the-device","content":"Create the device"},"859":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-5","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#define-its-membership","content":"Define its membership"},"860":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-6","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#classify-the-device","content":"Classify the device"},"861":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-7","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#verify-the-registration","content":"Verify the registration"},"862":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-8","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Assign an identity manually"},"863":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-9","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#revoke-the-current-identity","content":"Revoke the current identity"},"864":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-10","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#decommission-a-device","content":"Decommission a device"},"865":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-11","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#automate-enrollment","content":"Automate enrollment"},"866":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-12","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","content":"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create."},"867":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-13","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","content":"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device."},"868":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-14","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"Operational view"},"869":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-15","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"Meaning"},"870":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-16","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"**No Identity**"},"871":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-17","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"A record exists without an associated identity."},"872":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-18","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"**Active**"},"873":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-19","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"The slot is active; also check certificate dates, status and usages."},"874":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-20","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"**Renewal Pending**"},"875":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-21","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"The identity is in the operational renewal window."},"876":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-22","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"**Expiring Soon**"},"877":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-23","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"Expiration is approaching according to configured thresholds."},"878":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-24","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"**Expired**"},"879":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-25","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"The identity has expired."},"880":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-26","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"**Revoked**"},"881":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-27","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released."},"882":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-28","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"**Decommissioned**"},"883":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-29","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"The record is retired and ordinary updates do not restore operation."},"884":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-30","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","content":"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance."},"885":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-31","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#inspect-a-device","content":"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial."},"886":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-32","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#inspect-a-device","content":"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version."},"887":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-33","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#inspect-a-device","content":"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates."},"888":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-34","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#inspect-a-device","content":"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment."},"889":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-35","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#register-a-device-manually","content":"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS."},"890":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-36","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#create-the-device","content":"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet."},"891":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-37","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#define-its-membership","content":"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS."},"892":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-38","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#classify-the-device","content":"Add model, environment or location tags and an icon according to your inventory."},"893":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-39","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#verify-the-registration","content":"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment."},"894":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-40","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#verify-the-registration","content":"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies."},"895":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-41","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#assign-an-identity-manually","content":"From **No Identity**, use **Assign Identity**:"},"896":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-42","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`."},"897":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-43","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#assign-an-identity-manually","content":"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first."},"898":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-44","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Confirm and read the serial, active version and history again."},"899":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-45","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Install the key/certificate pair and required intermediates on the device and test usage."},"900":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-46","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it."},"901":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-47","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#revoke-the-current-identity","content":"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide."},"902":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-48","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#revoke-the-current-identity","content":"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes."},"903":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-49","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#revoke-the-current-identity","content":"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent."},"904":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-50","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#decommission-a-device","content":"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer."},"905":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-51","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#decommission-a-device","content":"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial."},"906":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-52","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#decommission-a-device","content":"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control."},"907":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-53","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#decommission-a-device","content":"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change."},"908":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-54","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#automate-enrollment","content":"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />"},"909":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management-55","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#automate-enrollment","content":"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"910":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","type":"page","content":"Bootstrap identity and authentication","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity"},"911":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-0","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","content":"Prepare server trust and admission proofs for enroll and reenroll."},"912":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-1","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Initial server trust"},"913":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-2","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Bootstrap credential"},"914":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-3","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"Modes per operation"},"915":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-4","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Webhook contract"},"916":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-5","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"Revocation and checks"},"917":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-6","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","content":"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID."},"918":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-7","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`."},"919":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-8","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies."},"920":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-9","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service."},"921":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-10","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device."},"922":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-11","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity."},"923":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-12","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears."},"924":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-13","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication."},"925":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-14","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide."},"926":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-15","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Example body:"},"927":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-16","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy."},"928":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-17","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client."},"929":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-18","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Continuation requires a successful HTTP response and JSON:"},"930":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-19","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification."},"931":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-20","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source."},"932":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity-21","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client."},"933":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms","type":"page","content":"Configure and operate the DMS","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms"},"934":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms-0","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms","content":"Define registration, authentication per operation, issuance, renewal and distributed trust."},"935":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms-1","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#before-you-begin","content":"Before you begin"},"936":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms-2","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#configure-a-dms","content":"