platform/administration/access-control/data-model#schema-entities","content":"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />"},"528":{"id":"/docs/pr-preview/pr-75/platform/administration/access-control","page_id":"/docs/pr-preview/pr-75/platform/administration/access-control","type":"page","content":"Access control overview","breadcrumbs":["Docs","Platform","Administration","Access control"],"tags":[],"url":"/docs/pr-preview/pr-75/platform/administration/access-control"},"529":{"id":"/docs/pr-preview/pr-75/platform/administration/access-control-0","page_id":"/docs/pr-preview/pr-75/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/administration/access-control","content":"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization."},"530":{"id":"/docs/pr-preview/pr-75/platform/administration/access-control-1","page_id":"/docs/pr-preview/pr-75/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/administration/access-control#essential-concepts","content":"Essential concepts"},"531":{"id":"/docs/pr-preview/pr-75/platform/administration/access-control-2","page_id":"/docs/pr-preview/pr-75/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/administration/access-control#two-decision-systems","content":"Two decision systems"},"532":{"id":"/docs/pr-preview/pr-75/platform/administration/access-control-3","page_id":"/docs/pr-preview/pr-75/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/administration/access-control#integrated-or-external-http-services","content":"Integrated or external HTTP services"},"533":{"id":"/docs/pr-preview/pr-75/platform/administration/access-control-4","page_id":"/docs/pr-preview/pr-75/platfo