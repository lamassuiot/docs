 for your evaluation."},"2534":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-22","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","content":"**CA Certificate Expiration**: for example, one year from creation."},"2535":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-23","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","content":"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime."},"2536":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-24","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","content":"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs."},"2537":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-25","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","content":"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API."},"2538":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-26","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","content":"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**."},"2539":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-27","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","content":"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`."},"2540":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-28","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","content":"Run from the directory where you saved `ca.pem`:"},"2541":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-29","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","content":"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`."},"2542":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-30","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","content":"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options."},"2543":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-31","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"If creation fails, check permissions, engine availability and the selected algorithm."},"2544":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-32","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"If OpenSSL cannot read the file, copy the complete PEM block again."},"2545":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-33","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct."},"2546":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-34","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"PKI diagnostics covers issuance checks and cryptographic dependencies."},"2547":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority-35","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#next-step","content":"Continue with Issue and verify a certificate, using this authority and `ca.pem`."},"2548":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate","type":"page","content":"Issue and verify a certificate","breadcrumbs":["Docs","Platform","PKI","Getting started"],"tags":[],"url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate"},"2549":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate-0","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate","content":"Issue a client certificate and check content, chain and key correspondence."},"2550":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate-1","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#before-you-begin","content":"Before you begin"},"2551":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate-2","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#start-the-issuance","content":"Start the issuance"},"2552":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate-3","page_id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#choose-the-method","content":"Choose the method"},"2553":{"id":"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate-4","page_id":"/docs/pr-preview/pr-75/platform/