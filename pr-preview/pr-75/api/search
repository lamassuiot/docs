t-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","content":"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration."},"1717":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","type":"page","content":"Register a device manually","breadcrumbs":["Docs","Platform","IoT Fleets","Getting started"],"tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device"},"1718":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-0","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","content":"Prepare a DMS, register a device and associate a verified certificate with its identity."},"1719":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-1","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#before-you-begin","content":"Before you begin"},"1720":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-2","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","content":"Prepare the DMS"},"1721":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-3","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#register-the-device","content":"Register the device"},"1722":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-4","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","content":"Check the initial status"},"1723":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-5","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#assign-an-identity","content":"Assign an identity"},"1724":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-6","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#verify-the-device","content":"Verify the device"},"1725":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-7","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#expected-result","content":"Expected result"},"1726":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-8","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","content":"If the result fails"},"1727":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-9","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","content":"Automate the next device"},"1728":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-10","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","content":"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history."},"1729":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-11","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","content":"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration."},"1730":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-12","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#before-you-begin","content":"An accessible instance and permission to administer DMSs, devices and certificate associations."},"1731":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-13","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#before-you-begin","content":"An active CA with an available key. If one does not exist yet, follow Create your first CA."},"1732":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-14","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#before-you-begin","content":"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both."},"1733":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-15","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#before-you-begin","content":"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`."},"1734":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-16","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","content":"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:"},"1735":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-17","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","content":"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`."},"1736":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-18","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","content":"In **Enrollment CA**, select the CA that issued `device.crt`."},"1737":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-19","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","content":"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration."},"1738":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-20","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","content":"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it."},"1739":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-21","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","content":"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier."},"1740":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-22","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","content":"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory."},"1741":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-23","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","content":"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol."},"1742":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-24","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#register-the-device","content":"Open **Managed Devices** and the registration action. Complete:"},"1743":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-25","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#register-the-device","content":"**Device ID**: `device-001`."},"1744":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-26","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#register-the-device","content":"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role."},"1745":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-27","page_id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#register-the-device","content":"**Icon** and **Tags**: optional classification."},"1746":{"id":"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device-28","page_id":"/