/es/platform/iot-fleets/integrations/aws-iot-core-8","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","content":"Estados del registro de la CA"},"1329":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-9","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Primary Account"},"1330":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-10","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","content":"Secondary Account (SNI-only)"},"1331":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-11","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","content":"Configuración del DMS"},"1332":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-12","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","content":"Modo `none`"},"1333":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-13","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"Modo `auto`"},"1334":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-14","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","content":"Modo `jitp`"},"1335":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-15","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","content":"Estados del modo de registro del DMS"},"1336":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-16","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"Aprovisionamiento de dispositivos (modo automático)"},"1337":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-17","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","content":"Ciclo de vida del Thing"},"1338":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-18","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Aprovisionamiento de dispositivos (modo JITP)"},"1339":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-19","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Sincronización del estado del certificado"},"1340":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-20","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","content":"Estados del certificado"},"1341":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-21","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Desconexión forzada al revocar"},"1342":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-22","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","content":"Device Shadow y automatización"},"1343":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-23","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"Qué escribe el conector en el shadow"},"1344":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-24","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","content":"Políticas de AWS IoT"},"1345":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-25","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"Solución de problemas"},"1346":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-26","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","content":"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió."},"1347":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-27","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","content":"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP)."},"1348":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-28","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","content":"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento."},"1349":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-29","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","content":"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP."},"1350":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-30","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","content":"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo."},"1351":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-31","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","content":"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo."},"1352":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-32","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","content":"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones."},"1353":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-33","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","content":"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue."},"1354":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-34","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","content":"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:"},"1355":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-35","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","content":"Acción IAM"},"1356":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-36","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","content":"Propósito"},"1357":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-37","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","content":"`iot:GetRegistrationCode`"},"1358":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-38","page_id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","content":"Obtener el código de verificación para el registro de CA en Primary Account"},"1359":{"id":"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core-39","page_