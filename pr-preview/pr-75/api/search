ed/networking-5","page_id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","content":"Bare metal con MetalLB o kube-vip"},"279":{"id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking-6","page_id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","content":"Proxy externo, NAT o VPN"},"280":{"id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking-7","page_id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","content":"¿Qué ocurre si necesitas tres Gateways?"},"281":{"id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking-8","page_id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","content":"Certificados de cliente y cabeceras de identidad"},"282":{"id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking-9","page_id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#guía-de-decisión","content":"Guía de decisión"},"283":{"id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking-10","page_id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking","type":"heading","tags":[],"url":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#proxy-de-salida","content":"Proxy de salida"},"284":{"id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking-11","page_id":"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking","type":"headin